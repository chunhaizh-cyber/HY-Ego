namespace 海中鱼巣::本能路线阶段二测试内部 {

struct 隔离根清理 final {
    std::filesystem::path 根;
    ~隔离根清理() {
        std::error_code 错误;
        std::filesystem::remove_all(根, 错误);
    }
};

int 失败(const char* 编号, const char* 步骤) noexcept {
    std::cout << "[INSTINCT-STAGE2][" << 编号 << "] 失败："
              << 步骤 << "\n";
    return 1;
}

void 通过(const char* 编号, const char* 说明) {
    std::cout << "[INSTINCT-STAGE2][" << 编号 << "] PASS："
              << 说明 << "\n";
}

std::uint64_t 当前UTC纳秒() noexcept {
    const auto 值 = std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::system_clock::now().time_since_epoch()).count();
    return 值 > 0 ? static_cast<std::uint64_t>(值) : 1ULL;
}

struct 会话_v1 final {
    std::unique_ptr<普通应用上下文> 上下文;
    L2场景身份 根场景{};
    L2存在身份 自我{};
    本能根运行锚点_v1 本能根;
    本能根运行初始化状态_v1 本能根状态 =
        本能根运行初始化状态_v1::内部不一致;
    std::optional<L2任务事实> P00任务;
    std::optional<L2任务轮次事实> P00任务轮次;
    std::uint64_t P00事实截止 = 0;
};

bool 验证P00入口拒绝零载荷(const 普通应用上下文& 上下文) noexcept;
bool 验证P00任务轮次闭环(会话_v1& 会话) noexcept;
bool 验证P01工作包唯一结果消息(会话_v1& 会话) noexcept;

std::optional<会话_v1> 建立或恢复会话(
    const 普通应用配置& 配置, std::uint64_t 启动UTC纳秒) {
    const auto 会话失败 = [](const char* 阶段) -> std::optional<会话_v1> {
        std::cout << "[INSTINCT-STAGE2][会话] " << 阶段 << "\n";
        return std::nullopt;
    };
    auto 装配 = 构造普通应用上下文(配置);
    if (!装配.成功()) {
        std::cout << "[INSTINCT-STAGE2][会话] 普通应用装配状态="
                  << static_cast<unsigned>(装配.状态) << "\n";
        return std::nullopt;
    }
    auto 上下文 = std::move(装配.上下文);

    const auto 世界根 = 初始化并发布系统世界树根(
        *上下文, 系统世界树根初始化请求{});
    if (!世界根.成功() || !世界根.已发布根)
        return 会话失败("系统世界树根");
    const auto& 根 = *世界根.已发布根;
    const 自我世界树根消费请求 消费请求{
        自我世界树根消费合同版本, 根.选择, 根.首次建立请求,
        根.树, 根.根场景, 根.正式树读回.根标记};
    const auto 自我世界树根 = 消费并发布自我世界树根(
        *上下文, 消费请求);
    if (!自我世界树根.成功() || !自我世界树根.已发布材料)
        return 会话失败("自我世界树根消费");

    真实自我形成提供者 自我形成者(上下文->取得L2结构聚合服务());
    真实自我形成请求 自我请求;
    自我请求.根消费材料 = *自我世界树根.已发布材料;
    const auto 自我形成 = 自我形成者.形成(自我请求);
    if (!自我形成.成功() || !自我形成.已形成自我)
        return 会话失败("真实自我形成");

    四本体根生产初始化提供者 四本体根者(
        上下文->取得L2概念结构聚合服务());
    const auto 四本体根 = 四本体根者.初始化(四本体根生产初始化请求{});
    if (!四本体根.成功() || !四本体根.已发布材料)
        return 会话失败("四本体根");

    方法登记根生产初始化提供者 方法登记根者(
        上下文->取得L2方法结构聚合服务());
    const auto 方法登记根 = 方法登记根者.初始化(
        方法登记根生产初始化请求{});
    if (!方法登记根.成功() || !方法登记根.已发布材料)
        return 会话失败("方法登记根");

    const auto 自我 = 自我形成.已形成自我->自我存在.身份;
    本能根运行初始化提供者 本能根者(
        上下文->取得L2存在结构服务(),
        上下文->取得L2特征结构服务(),
        上下文->取得L2状态结构服务(),
        上下文->取得L2需求结构服务());
    const auto 本能根 = 本能根者.初始化并读取本能根运行锚点_v1({
        本能根运行初始化合同版本_v1, 自我, 启动UTC纳秒});
    if (!本能根.成功() || !本能根.锚点) {
        std::cout << "[INSTINCT-STAGE2][会话] 本能根状态="
                  << static_cast<unsigned>(本能根.状态) << "\n";
        return std::nullopt;
    }

    if (!验证P00入口拒绝零载荷(*上下文))
        return 会话失败("P00任务当前轮次入口拒绝");

    return 会话_v1{std::move(上下文), 根.根场景,
        自我, *本能根.锚点, 本能根.状态};
}

std::optional<std::uint64_t> 当前代次(const 普通应用上下文& 上下文) {
    return 上下文.取得L2状态结构服务().读取中性当前事实代次_v1();
}

std::optional<L2特征值事实> 读取当前值(
    const 普通应用上下文& 上下文, L2特征实例身份 实例) {
    const auto G = 当前代次(上下文);
    if (!G) return std::nullopt;
    const auto 读取 = 上下文.取得L2特征结构服务().读取特征当前值(
        {{L2结构合同版本, *G}, 实例});
    if (!读取.成功() || 读取.结果头.事实截止代次 != *G || !读取.当前值)
        return std::nullopt;
    return *读取.当前值;
}

L2特征当前值变化记录请求_v1 形成变化请求(
    const 会话_v1& 会话, const L2特征值事实& 旧值,
    std::int64_t 新值, std::uint64_t 身份基数,
    std::uint64_t 截止, std::uint64_t UTC纳秒) {
    L2特征当前值变化记录请求_v1 请求;
    请求.请求头 = {L2结构合同版本, 截止};
    请求.组合幂等身份 = {身份基数 + 0};
    请求.特征参与者幂等身份 = {身份基数 + 1};
    请求.状态参与者幂等身份 = {身份基数 + 2};
    请求.动态参与者幂等身份 = {身份基数 + 3};
    请求.特征实例 = 会话.本能根.安全根特征实例;
    请求.预期旧当前值 = 旧值;
    请求.新值材料 = L2原始值材料{新值};
    请求.变化UTC纳秒 = static_cast<std::int64_t>(UTC纳秒);
    请求.主体存在 = 会话.自我;
    请求.共同场景 = 会话.根场景;
    请求.来源存在 = 会话.自我;
    return 请求;
}

L2特征当前值变化记录读取结果_v1 独立读回(
    const 普通应用上下文& 上下文,
    const L2特征当前值变化记录结果_v1& 写入) {
    const auto Gread = 当前代次(上下文);
    if (!Gread || !写入.当前值 || !写入.当前选择 || !写入.前状态
        || !写入.后状态 || !写入.状态迁移动能)
        return {};
    return 上下文.取得L2状态动态原子发布服务()
        .读取特征当前值变化记录_v1({
            L2特征当前值变化记录合同版本_v1,
            {L2结构合同版本, *Gread}, 写入.当前值->特征实例,
            写入.当前值->值稳定编码, 写入.当前选择->身份,
            写入.前状态->身份, 写入.后状态->身份,
            写入.状态迁移动能->身份,
            写入.动作致变动态
                ? std::optional<L2动态身份>{写入.动作致变动态->身份}
                : std::nullopt,
            写入.本次正式读回截止});
}

bool 值等于(const L2特征值事实& 事实, std::int64_t 期望) noexcept {
    const auto* 值 = std::get_if<std::int64_t>(&事实.类型化不可变材料);
    return 值 && *值 == 期望;
}

bool 验证P00入口拒绝零载荷(const 普通应用上下文& 上下文) noexcept {
    L2按任务读取当前任务与轮次请求 请求{
        L2按任务读取当前任务与轮次合同版本,
        {L2结构合同版本, 0}, L2任务身份{稳定编码{}}};
    const auto 结果 = 上下文.取得L2任务结构服务()
        .按任务读取当前任务与轮次(请求);
    return 结果.结果头.状态 == L2结构状态::入口拒绝
        && 结果.状态 == L2按任务读取当前任务与轮次状态::入口拒绝
        && !结果.任务 && !结果.当前任务轮次
        && 结果.本次正式读回截止 == 0;
}

L2任务初次筹办首次需求裁决材料 形成P00首次裁决材料(
    const 需求当前满足裁决快照& 裁决) {
    L2任务初次筹办首次需求裁决材料 材料;
    材料.裁决规则版本 = 裁决.规则版本;
    材料.裁决请求身份 = 裁决.裁决请求身份;
    材料.需求事实 = 裁决.需求事实;
    材料.当前成员关系 = 裁决.当前成员关系;
    材料.所属列表项 = 裁决.所属列表项;
    材料.当前特征实例 = 裁决.当前特征实例;
    材料.当前特征值 = 裁决.当前特征值;
    材料.目标合同 = 裁决.目标合同;
    材料.比较注册 = 裁决.比较注册;
    材料.比较算法版本 = 裁决.比较算法版本;
    材料.具名关系 = 裁决.具名关系;
    材料.允许关系位 = 裁决.允许关系位;
    材料.首次共同事实截止G0 = 裁决.事实截止代次;
    return 材料;
}

bool 验证P00任务轮次闭环(会话_v1& 会话) noexcept {
    const auto P00失败 = [](const char* 步骤) noexcept {
        std::cout << "[INSTINCT-STAGE2][P00-DIAG] " << 步骤 << "\n";
        return false;
    };
    auto& 上下文 = *会话.上下文;
    auto& 任务服务 = 上下文.取得L2任务结构服务();
    const auto G0 = 当前代次(上下文);
    if (!G0) return P00失败("读取 G0");
    运行期只读查询组合器 查询(
        上下文.取得L2需求结构服务(), 任务服务,
        上下文.取得L2状态结构服务(), 上下文.取得L2特征结构服务(),
        上下文.取得L2存在结构服务(), 上下文.取得L2场景结构服务(),
        上下文.取得L2动态结构服务());
    const auto 裁决 = 查询.裁决需求当前满足({
        运行期只读查询合同版本, 0x5000'0000'0000'0001ULL,
        会话.本能根.安全根需求, *G0});
    if (裁决.状态 != 需求当前满足裁决状态::未满足
        || !裁决.成功() || !裁决.裁决)
        return P00失败("安全根需求未满足裁决");
    const auto 首次裁决 = 形成P00首次裁决材料(*裁决.裁决);
    if (!L2任务初次筹办首次需求裁决材料完整(首次裁决))
        return P00失败("首次裁决材料完整性");

    L2新增任务轮次与正式存在引用请求 请求;
    请求.请求头 = {L2结构合同版本, *G0};
    请求.幂等身份 = L2结构幂等身份{0x5000'0000'0000'0010ULL};
    请求.首次需求裁决 = 首次裁决;
    请求.正式存在 = 会话.自我;
    const auto 首次 = 任务服务.新增任务轮次与正式存在引用(请求);
    if (!首次.成功() || 首次.结果头.状态 != L2结构状态::已提交
        || !首次.任务 || !首次.任务身份来源 || !首次.来源需求关系
        || !首次.正式存在关系 || !首次.任务轮次)
        return P00失败("首次提交与五项载荷");
    const auto G1 = 首次.结果头.事实截止代次;
    if (G1 <= *G0
        || 首次.任务->生命周期.创建事实代次 != G1
        || 首次.任务身份来源->任务节点生命周期.创建事实代次 != G1
        || 首次.任务身份来源->族归属关系生命周期.创建事实代次 != G1
        || 首次.来源需求关系->生命周期.创建事实代次 != G1
        || 首次.正式存在关系->生命周期.创建事实代次 != G1
        || 首次.任务轮次->生命周期.创建事实代次 != G1
        || 首次.来源需求关系->来源需求 != 会话.本能根.安全根需求
        || 首次.正式存在关系->正式存在 != 会话.自我
        || 首次.任务轮次->轮次序号 != 1)
        return P00失败("首次提交同 G1 互证");

    const auto 重复 = 任务服务.新增任务轮次与正式存在引用(请求);
    if (!重复.成功() || 重复.结果头.状态 != L2结构状态::精确重复
        || 重复.结果头.事实截止代次 != G1
        || 重复.任务 != 首次.任务
        || 重复.任务身份来源 != 首次.任务身份来源
        || 重复.来源需求关系 != 首次.来源需求关系
        || 重复.正式存在关系 != 首次.正式存在关系
        || 重复.任务轮次 != 首次.任务轮次) {
        std::cout << "[INSTINCT-STAGE2][P00-DIAG] 重复状态/截止/载荷="
                  << static_cast<unsigned>(重复.结果头.状态) << "/"
                  << 重复.结果头.事实截止代次 << "/"
                  << static_cast<bool>(重复.任务)
                  << static_cast<bool>(重复.任务身份来源)
                  << static_cast<bool>(重复.来源需求关系)
                  << static_cast<bool>(重复.正式存在关系)
                  << static_cast<bool>(重复.任务轮次) << "\n";
        return P00失败("精确重复与载荷一致");
    }
    const auto 重复后G = 当前代次(上下文);
    if (!重复后G || *重复后G != G1) return P00失败("精确重复零新代次");

    const auto 按键 = 任务服务.按建立幂等身份读取任务轮次核心({
        L2按建立幂等身份读取任务轮次核心合同版本,
        {L2结构合同版本, G1}, 请求.幂等身份});
    if (!按键.成功() || 按键.本次正式读回截止 != G1
        || 按键.任务 != 首次.任务
        || 按键.任务身份来源 != 首次.任务身份来源
        || 按键.来源需求关系 != 首次.来源需求关系
        || 按键.正式存在关系 != 首次.正式存在关系
        || 按键.任务轮次 != 首次.任务轮次)
        return P00失败("按建立键完整读回");

    const auto 按任务 = 任务服务.按任务读取当前任务与轮次({
        L2按任务读取当前任务与轮次合同版本,
        {L2结构合同版本, G1}, 首次.任务->身份});
    if (!按任务.成功() || 按任务.本次正式读回截止 != G1
        || 按任务.任务 != 首次.任务
        || 按任务.当前任务轮次 != 首次.任务轮次) {
        std::cout << "[INSTINCT-STAGE2][P00-DIAG] 按任务状态/公共状态/截止/载荷="
                  << static_cast<unsigned>(按任务.状态) << "/"
                  << static_cast<unsigned>(按任务.结果头.状态) << "/"
                  << 按任务.本次正式读回截止 << "/"
                  << static_cast<bool>(按任务.任务)
                  << static_cast<bool>(按任务.当前任务轮次) << "\n";
        return P00失败("按任务同 G1 读回");
    }

    const auto 服务根裁决 = 查询.裁决需求当前满足({
        运行期只读查询合同版本, 0x5000'0000'0000'0002ULL,
        会话.本能根.服务根需求, G1});
    if (服务根裁决.状态 != 需求当前满足裁决状态::未满足
        || !服务根裁决.成功() || !服务根裁决.裁决)
        return P00失败("服务根需求未满足裁决");
    auto 冲突请求 = 请求;
    冲突请求.请求头.期望事实代次 = G1;
    冲突请求.首次需求裁决 = 形成P00首次裁决材料(*服务根裁决.裁决);
    const auto 同键异义 = 任务服务.新增任务轮次与正式存在引用(冲突请求);
    if (同键异义.结果头.状态 != L2结构状态::幂等冲突
        || 同键异义.任务 || 同键异义.任务身份来源
        || 同键异义.来源需求关系 || 同键异义.正式存在关系
        || 同键异义.任务轮次 || 同键异义.结果头.事实截止代次 != 0)
        return P00失败("同键异义零载荷");

    auto 坏E请求 = 请求;
    坏E请求.请求头.期望事实代次 = G1;
    坏E请求.幂等身份 = L2结构幂等身份{0x5000'0000'0000'0013ULL};
    坏E请求.正式存在 = L2存在身份{
        稳定编码{0x5000'0000'0000'0014ULL}};
    const auto E未找到 = 任务服务.新增任务轮次与正式存在引用(坏E请求);
    if (E未找到.结果头.状态 != L2结构状态::未找到
        || E未找到.任务 || E未找到.任务身份来源 || E未找到.来源需求关系
        || E未找到.正式存在关系 || E未找到.任务轮次
        || E未找到.结果头.事实截止代次 != 0)
        return P00失败("E 未找到零载荷");

    const auto 未知键 = 任务服务.按建立幂等身份读取任务轮次核心({
        L2按建立幂等身份读取任务轮次核心合同版本,
        {L2结构合同版本, G1},
        L2结构幂等身份{0x5000'0000'0000'0011ULL}});
    if (未知键.结果头.状态 != L2结构状态::未找到
        || 未知键.任务 || 未知键.任务身份来源 || 未知键.来源需求关系
        || 未知键.正式存在关系 || 未知键.任务轮次
        || 未知键.本次正式读回截止 != 0)
        return P00失败("未知建立键零载荷");
    const auto 未知任务 = 任务服务.按任务读取当前任务与轮次({
        L2按任务读取当前任务与轮次合同版本,
        {L2结构合同版本, G1},
        L2任务身份{稳定编码{0x5000'0000'0000'0012ULL}}});
    if (未知任务.状态 != L2按任务读取当前任务与轮次状态::任务未找到
        || 未知任务.任务 || 未知任务.当前任务轮次
        || 未知任务.本次正式读回截止 != 0)
        return P00失败("未知任务零载荷");
    const auto 旧代次 = 任务服务.按建立幂等身份读取任务轮次核心({
        L2按建立幂等身份读取任务轮次核心合同版本,
        {L2结构合同版本, *G0}, 请求.幂等身份});
    if (旧代次.结果头.状态 != L2结构状态::事实代次漂移
        || 旧代次.任务 || 旧代次.任务身份来源 || 旧代次.来源需求关系
        || 旧代次.正式存在关系 || 旧代次.任务轮次
        || 旧代次.本次正式读回截止 != 0)
        return P00失败("旧代次漂移零载荷");
    会话.P00任务 = *首次.任务;
    会话.P00任务轮次 = *首次.任务轮次;
    会话.P00事实截止 = G1;
    return true;
}

class 两次容量等待结果端口 final : public 任务筹办结果提交端口 {
public:
    任务筹办提交结果 提交任务筹办结果(
        const 任务筹办结果消息& 消息) noexcept override {
        try {
            已见消息.push_back(消息);
            if (已见消息.size() <= 2) {
                return {任务筹办提交状态::资源等待,
                    任务筹办提交拒绝原因::队列已满};
            }
            return {任务筹办提交状态::已接收,
                任务筹办提交拒绝原因::无};
        } catch (...) {
            return {任务筹办提交状态::内部错误,
                任务筹办提交拒绝原因::内部状态冲突};
        }
    }

    std::vector<任务筹办结果消息> 已见消息;
};

bool 验证P01工作包唯一结果消息(会话_v1& 会话) noexcept {
    if (!会话.P00任务 || !会话.P00任务轮次 || 会话.P00事实截止 == 0)
        return false;
    constexpr std::uint64_t 身份域 = 0x494E'5354'5030'3100ULL;
    下一筹办工作包 工作包;
    工作包.任务 = 会话.P00任务->身份;
    工作包.旧路径 = L2任务方法路径身份{稳定编码{身份域 + 1}};
    工作包.旧实例 = L2实例方法身份{稳定编码{身份域 + 2}};
    工作包.旧执行轮次 = 1;
    工作包.旧实际结果 = L2任务实际结果身份{稳定编码{身份域 + 3}};
    工作包.正式目标裁决证据 =
        L2任务目标裁决证据身份{稳定编码{身份域 + 4}};
    工作包.正式待重筹办状态 =
        L2任务治理状态身份{稳定编码{身份域 + 5}};
    工作包.原共同事实截止 = 会话.P00事实截止;
    工作包.迁移后事实代次 = 会话.P00事实截止;
    工作包.旧筹办轮次 = 1;
    工作包.新筹办轮次 = 2;
    工作包.运行代次 = 身份域 + 6;
    工作包.原重筹办意图幂等键 = 身份域 + 7;

    任务筹办推进请求 请求;
    请求.请求头 = {L2结构合同版本, 会话.P00事实截止};
    请求.工作包 = 工作包;
    请求.最大扫描用途事实数 = 64;
    请求.最大粗召回方法数 = 64;
    请求.最大概念支持扫描事实数 = 64;
    请求.最大概念支持关系数 = 64;
    请求.最大概念祖先关系数 = 64;
    请求.最大主体状态数 = 64;
    请求.最大场景成员数 = 64;
    请求.最大方法条件数 = 64;
    请求.最大来源需求成员数 = 64;

    任务筹办工作包消息 消息;
    消息.工作包身份 = {工作包.原重筹办意图幂等键};
    消息.任务 = 工作包.任务;
    消息.任务轮次 = 会话.P00任务轮次->身份;
    消息.筹办轮次 = 工作包.新筹办轮次;
    消息.来源事实截止G0 = 会话.P00事实截止;
    消息.请求 = 请求;
    if (!任务筹办工作包消息完整(消息)) return false;

    任务管理线程 占位管理线程(1);
    两次容量等待结果端口 结果端口;
    任务工作线程 工作线程(1, 占位管理线程, 结果端口,
        会话.上下文->取得任务筹办当前就绪与执行冻结提供者());
    const auto 启动 = 工作线程.启动();
    if (!启动.成功) return false;
    const auto 提交 = 工作线程.提交任务筹办工作包(消息);
    if (!提交.成功()) return false;
    const auto 停止 = 工作线程.停止接收并排空();
    const auto 收口 = 工作线程.收口等待();
    if (!停止.成功 || !收口.成功) return false;
    const auto 快照 = 工作线程.读取快照();
    if (快照.已消费筹办工作包数量 != 1
        || 快照.筹办提供者调用数量 != 1
        || 快照.已确认筹办结果数量 != 1
        || 快照.当前处理中工作包 || 快照.待上交筹办结果
        || 结果端口.已见消息.size() != 3)
        return false;
    const auto& 首次消息 = 结果端口.已见消息.front();
    return 任务筹办结果消息匹配工作包(首次消息, 消息)
        && 任务筹办结果消息相同(首次消息, 结果端口.已见消息[1])
        && 任务筹办结果消息相同(首次消息, 结果端口.已见消息[2]);
}

static_assert(static_cast<unsigned>(L2按任务读取当前任务与轮次状态::已读取)
    == 1U);
static_assert(static_cast<unsigned>(L2按任务读取当前任务与轮次状态::许可拒绝)
    == 9U);
static_assert(static_cast<unsigned>(L2按任务读取当前任务与轮次状态::内部不一致)
    == 14U);

} // namespace 海中鱼巣::本能路线阶段二测试内部

namespace 海中鱼巣 {

int 运行本能路线阶段二端到端测试() noexcept {
    using namespace 本能路线阶段二测试内部;
    try {
        const auto 隔离根 = std::filesystem::path{L"D:\\TEMP"}
            / L"海中鱼巣" / L"INSTINCT-STAGE2-CURRENT-VALUE-ATOMIC-RECORD"
            / (std::to_wstring(GetCurrentProcessId()) + L"-"
                + std::to_wstring(GetTickCount64()));
        隔离根清理 清理{隔离根};
        std::error_code 错误;
        std::filesystem::create_directories(隔离根 / L"l1", 错误);
        if (错误) return 失败("S0", "建立 L1 隔离根");
        错误.clear();
        std::filesystem::create_directories(隔离根 / L"material", 错误);
        if (错误) return 失败("S0", "建立材料隔离根");

        普通应用配置 配置;
        配置.L1事实基座持久存储 = {
            L1事实基座持久恢复合同版本_v1, 隔离根 / L"l1"};
        配置.不可变材料存储 = {
            L2结构合同版本, {隔离根 / L"material"}};
        配置.等待合同登记 = 形成普通应用任务筹办等待合同登记();
        if (!配置.有效()) return 失败("S0", "隔离配置有效性");

        auto 会话 = 建立或恢复会话(配置, 当前UTC纳秒());
        if (!会话) return 失败("V01", "普通应用与本能根首次装配");
        auto& 上下文 = *会话->上下文;
        auto& 原子服务 = 上下文.取得L2状态动态原子发布服务();
        if (&原子服务 != &上下文.取得L2状态动态原子发布服务())
            return 失败("V01", "普通应用 getter 非唯一实例");
        通过("V01", "普通应用唯一构造和 getter");
        if (!验证P00任务轮次闭环(*会话))
            return 失败("P00", "任务轮次首次提交、精确重复与同代双读回");
        通过("P00", "任务轮次首次提交、精确重复、按建立键与按任务同代读回");
        if (!验证P01工作包唯一结果消息(*会话))
            return 失败("P01", "工作包单次 provider 与同一结果消息重投");
        通过("P01", "每包一次 provider；两次队列满后重投同一消息并获接收");

        const auto G根需求 = 当前代次(上下文);
        const auto 核对根需求 = [&](L2需求身份 身份) {
            if (!G根需求) return false;
            const auto 读取 = 上下文.取得L2需求结构服务().读取需求完整(
                {{L2结构合同版本, *G根需求},
                    L2读取类别::当前, 身份, 0});
            return 读取.成功() && 读取.需求
                && 读取.结果头.事实截止代次 == *G根需求
                && 读取.需求->所属存在 == 会话->自我
                && 读取.需求->目标宿主存在 == 会话->自我;
        };
        if (!核对根需求(会话->本能根.安全根需求)
            || !核对根需求(会话->本能根.服务根需求))
            return 失败("V01A", "根需求所属存在与目标宿主同一自我");
        通过("V01A", "同一自我可同时承担需求所属存在与目标宿主");

        const auto 初值 = 读取当前值(上下文, 会话->本能根.安全根特征实例);
        const auto G初 = 当前代次(上下文);
        if (!初值 || !G初 || !值等于(*初值, 本能根初始值_v1))
            return 失败("V02", "读取 legacy 初值");

        constexpr std::uint64_t 身份域 = 0x494E'5354'0202'0000ULL;
        auto 请求1 = 形成变化请求(*会话, *初值, 本能根初始值_v1 - 1,
            身份域 + 0x100, *G初, 当前UTC纳秒());
        const auto 写入1 = 原子服务.发布特征当前值变化与中性记录_v1(请求1);
        if (!写入1.成功()
            || 写入1.状态 != L2特征当前值变化记录状态_v1::已提交
            || !写入1.legacy基线兼容 || 写入1.已退出旧选择
            || 写入1.动作致变动态)
            return 失败("V02", "legacy 第一次原子变化");
        通过("V02", "legacy 基线、新状态和迁移动能一次形成");
        通过("V06", "无来源方法时没有动作致变动态");

        auto G = 当前代次(上下文);
        if (!G || !写入1.当前选择 || !写入1.后状态)
            return 失败("V03", "第一次变化结果缺项");
        const auto 值1 = 读取当前值(上下文, 会话->本能根.安全根特征实例);
        if (!值1 || !G) return 失败("V03", "第二次变化前读取");
        auto 请求2 = 形成变化请求(*会话, *值1, 本能根初始值_v1 - 2,
            身份域 + 0x200, *G, 当前UTC纳秒() + 1);
        const auto 写入2 = 原子服务.发布特征当前值变化与中性记录_v1(请求2);
        if (!写入2.成功()
            || 写入2.状态 != L2特征当前值变化记录状态_v1::已提交
            || 写入2.legacy基线兼容 || !写入2.已退出旧选择
            || 写入2.已退出旧选择->身份 != 写入1.当前选择->身份)
            return 失败("V03", "关系式前态迁移");
        通过("V03", "关系式前态退出并建立唯一新当前选择");

        const auto 读回2 = 独立读回(上下文, 写入2);
        if (!读回2.成功() || !读回2.当前值
            || !值等于(*读回2.当前值, 本能根初始值_v1 - 2)
            || 读回2.前状态 != 写入2.前状态
            || 读回2.后状态 != 写入2.后状态
            || 读回2.当前选择 != 写入2.当前选择
            || 读回2.状态迁移动能 != 写入2.状态迁移动能)
            return 失败("V14", "第二次变化独立历史读回");
        通过("V14", "写结果与独立历史读回一致");

        const auto 值2 = 读取当前值(上下文, 会话->本能根.安全根特征实例);
        G = 当前代次(上下文);
        if (!值2 || !G) return 失败("V15", "第三次变化前读取");
        auto 请求3 = 形成变化请求(*会话, *值2, 本能根初始值_v1 - 3,
            身份域 + 0x300, *G, 当前UTC纳秒() + 2);
        const auto 写入3 = 原子服务.发布特征当前值变化与中性记录_v1(请求3);
        if (!写入3.成功() || 写入3.legacy基线兼容
            || !写入3.已退出旧选择)
            return 失败("V15", "关系式前态连续迁移");

        const auto 当前3 = 读取当前值(上下文, 会话->本能根.安全根特征实例);
        G = 当前代次(上下文);
        if (!当前3 || !G || !值等于(*当前3, 本能根初始值_v1 - 3))
            return 失败("V15", "第三状态成为唯一当前值");
        for (const auto* 写入 : {&写入1, &写入2, &写入3})
            if (!独立读回(上下文, *写入).成功())
                return 失败("V15", "连续迁移历史材料稳定可读");
        通过("V15", "三状态连续迁移、末态唯一当前、历史稳定可读");

        auto 无变化请求 = 形成变化请求(*会话, *当前3,
            本能根初始值_v1 - 3, 身份域 + 0x400, *G, 当前UTC纳秒() + 3);
        const auto 无变化前代次 = *G;
        const auto 无变化 = 原子服务.发布特征当前值变化与中性记录_v1(
            无变化请求);
        const auto 无变化后代次 = 当前代次(上下文);
        if (!无变化.成功()
            || 无变化.状态 != L2特征当前值变化记录状态_v1::无变化
            || !无变化后代次 || *无变化后代次 != 无变化前代次)
            return 失败("V04", "相同值零写");
        通过("V04", "无变化不新增值、状态、动态或事实代次");

        const auto 重放2 = 原子服务.发布特征当前值变化与中性记录_v1(请求2);
        if (!重放2.成功()
            || 重放2.状态 != L2特征当前值变化记录状态_v1::精确重复
            || 重放2.本次正式读回截止 != 写入2.本次正式读回截止)
            return 失败("V07", "原请求精确重放");
        通过("V07", "精确重复返回首次 G1 且零新代次");

        auto 冲突请求 = 请求2;
        冲突请求.新值材料 = L2原始值材料{本能根初始值_v1 - 20};
        const auto 冲突 = 原子服务.发布特征当前值变化与中性记录_v1(冲突请求);
        if (冲突.状态 != L2特征当前值变化记录状态_v1::幂等冲突)
            return 失败("V08", "同组合键异请求未冲突");
        通过("V08", "同组合键异请求结构化幂等冲突");

        auto 旧G新键 = 请求2;
        旧G新键.组合幂等身份 = {身份域 + 0x901};
        旧G新键.特征参与者幂等身份 = {身份域 + 0x902};
        旧G新键.状态参与者幂等身份 = {身份域 + 0x903};
        旧G新键.动态参与者幂等身份 = {身份域 + 0x904};
        const auto 旧G结果 = 原子服务.发布特征当前值变化与中性记录_v1(旧G新键);
        if (旧G结果.状态 != L2特征当前值变化记录状态_v1::当前性漂移)
            return 失败("V09", "新键旧 G0 未漂移");
        通过("V09", "新键旧 G0 当前性漂移且零写");

        auto 错旧值 = 旧G新键;
        错旧值.组合幂等身份 = {身份域 + 0xA01};
        错旧值.特征参与者幂等身份 = {身份域 + 0xA02};
        错旧值.状态参与者幂等身份 = {身份域 + 0xA03};
        错旧值.动态参与者幂等身份 = {身份域 + 0xA04};
        错旧值.预期旧当前值.类型化不可变材料 =
            L2原始值材料{本能根初始值_v1 - 99};
        const auto 错旧值结果 = 原子服务.发布特征当前值变化与中性记录_v1(错旧值);
        if (错旧值结果.状态 != L2特征当前值变化记录状态_v1::当前性漂移)
            return 失败("V10", "旧值字段错配未阻断");
        通过("V10", "旧值字段错配结构化阻断且零写");

        G = 当前代次(上下文);
        const auto 当前检查 = 读取当前值(上下文, 会话->本能根.安全根特征实例);
        if (!G || !当前检查) return 失败("V11", "坏上下文前读取");
        auto 坏上下文 = 形成变化请求(*会话, *当前检查,
            本能根初始值_v1 - 4, 身份域 + 0xB00, *G, 当前UTC纳秒() + 4);
        坏上下文.共同场景 = L2场景身份{稳定编码{身份域 + 0xBFF}};
        const auto 坏上下文结果 = 原子服务.发布特征当前值变化与中性记录_v1(
            坏上下文);
        if (坏上下文结果.状态 != L2特征当前值变化记录状态_v1::材料不足
            && 坏上下文结果.状态 != L2特征当前值变化记录状态_v1::引用冲突)
            return 失败("V11", "坏场景上下文未阻断");
        通过("V11", "坏上下文/前状态上下文错配阻断");

        auto 缺引用 = 形成变化请求(*会话, *当前检查,
            本能根初始值_v1 - 4, 身份域 + 0xC00, *G, 当前UTC纳秒() + 5);
        缺引用.来源存在 = L2存在身份{稳定编码{身份域 + 0xCFF}};
        const auto 缺引用结果 = 原子服务.发布特征当前值变化与中性记录_v1(缺引用);
        if (缺引用结果.状态 != L2特征当前值变化记录状态_v1::材料不足
            && 缺引用结果.状态 != L2特征当前值变化记录状态_v1::引用冲突)
            return 失败("V12", "缺失 owner 引用未阻断");
        通过("V12", "三 owner 任一正式引用缺失即阻断");

        if (!写入1.状态迁移动能 || !写入1.后状态
            || 写入1.状态迁移动能->有序状态组[1].状态
                != 写入1.后状态->身份
            || !当前检查 || !值等于(*当前检查, 本能根初始值_v1 - 3)
            || 写入1.后状态->特征值 == 当前检查->类型化不可变材料)
            return 失败("V17", "历史动态后状态替代当前值");
        通过("V17", "历史动态只作记录，当前值仍取特征实例当前槽");

#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
        原子服务.ARCH_注入迁移提交后首次读回失败一次();
        G = 当前代次(上下文);
        const auto 故障前值 = 读取当前值(
            上下文, 会话->本能根.安全根特征实例);
        if (!G || !故障前值) return 失败("V13", "故障注入前读取");
        auto 故障请求 = 形成变化请求(*会话, *故障前值,
            本能根初始值_v1 - 4, 身份域 + 0xD00, *G, 当前UTC纳秒() + 6);
        const auto 已可能 = 原子服务.发布特征当前值变化与中性记录_v1(故障请求);
        if (已可能.状态 != L2特征当前值变化记录状态_v1::已可能发布
            || 已可能.成功() || 已可能.本次正式读回截止 == 0)
            return 失败("V13", "提交后首次读回失败形状");
        const auto 故障重放 = 原子服务.发布特征当前值变化与中性记录_v1(故障请求);
        if (!故障重放.成功()
            || 故障重放.状态 != L2特征当前值变化记录状态_v1::精确重复
            || 故障重放.本次正式读回截止 != 已可能.本次正式读回截止)
            return 失败("V13", "原请求重放未收束");
        通过("V13", "已可能发布只由原请求重放收束");
#else
        std::cout << "[INSTINCT-STAGE2][V13] NOT_RUN：验证宏未启用\n";
#endif

        std::cout << "[INSTINCT-STAGE2][V05] NOT_RUN：本专项未建立生产方法动作 fixture；"
                     "无来源被动变化路径已覆盖\n";

        const auto 重启前当前 = 读取当前值(
            上下文, 会话->本能根.安全根特征实例);
        if (!重启前当前) return 失败("V16", "重启前当前值");
        const auto 重启前锚点 = 会话->本能根;
        const auto 重启前自我 = 会话->自我;
        const auto 重启前根场景 = 会话->根场景;
        const auto 重启前本能根状态 = 会话->本能根状态;
        const auto 期望重启值 = *重启前当前;
        会话.reset();

        auto 重启装配 = 构造普通应用上下文(配置);
        if (!重启装配.成功() || !重启装配.上下文)
            return 失败("V16", "持久恢复后第二次普通应用完整构造");
        auto 重启上下文 = std::move(重启装配.上下文);
        本能根运行初始化提供者 重启本能根者(
            重启上下文->取得L2存在结构服务(),
            重启上下文->取得L2特征结构服务(),
            重启上下文->取得L2状态结构服务(),
            重启上下文->取得L2需求结构服务());
        const auto 重启本能根 =
            重启本能根者.初始化并读取本能根运行锚点_v1({
                本能根运行初始化合同版本_v1,
                重启前自我, 当前UTC纳秒() + 100});
        if (!重启本能根.成功()
            || 重启本能根.状态 != 本能根运行初始化状态_v1::已恢复
            || !重启本能根.锚点) {
            std::cout << "[INSTINCT-STAGE2][V16] 本能根恢复状态="
                      << static_cast<unsigned>(重启本能根.状态) << "\n";
            return 失败("V16", "第二上下文未正式恢复本能根锚点");
        }
        auto 期望锚点 = 重启前锚点;
        期望锚点.事实截止代次 = 重启本能根.锚点->事实截止代次;
        if (*重启本能根.锚点 != 期望锚点)
            return 失败("V16", "恢复锚点稳定身份组漂移");
        会话_v1 重启会话{std::move(重启上下文), 重启前根场景,
            重启前自我, *重启本能根.锚点, 重启本能根.状态};
        const auto 重启后当前 = 读取当前值(
            *重启会话.上下文, 重启会话.本能根.安全根特征实例);
        if (!重启后当前
            || 重启后当前->值稳定编码 != 期望重启值.值稳定编码
            || 重启后当前->类型化不可变材料
                != 期望重启值.类型化不可变材料)
            return 失败("V16", "恢复未消费中性选择当前值");
        通过("V16", "第二上下文恢复固定登记与本能根，并消费中性当前选择");
        if (重启前本能根状态 != 本能根运行初始化状态_v1::已形成
            || 重启会话.本能根状态 != 本能根运行初始化状态_v1::已恢复)
            return 失败("V16A", "首次未找到建立与第二次正式恢复状态");
        通过("V16A", "隔离空库首次形成、持久恢复后只读收敛");
        std::cout << "[INSTINCT-STAGE2][V16A] NOT_RUN：许可/资源/内部故障、"
                     "首次账缺项和持久账同键异义需要专属 L1 恢复故障 fixture\n";

        std::cout << "[INSTINCT-STAGE2] V01、V01A、V02-V17、V16A 可运行项全部通过\n";
        return 0;
    } catch (const std::exception& 异常) {
        std::cout << "[INSTINCT-STAGE2] 未分类异常：" << 异常.what() << "\n";
        return 1;
    } catch (...) {
        return 失败("UNCLASSIFIED", "未知异常");
    }
}

} // namespace 海中鱼巣
