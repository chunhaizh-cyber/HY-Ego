module;

#include "../领域/统计服务.h"
#include "SQL数据库适配.h"

#include <cstdint>
#include <functional>
#include <string>

export module 海中鱼巣.适配.审计.数据库启动;

export namespace 海中鱼巣 {

enum class 数据库审计要求 : std::uint8_t {
    最佳努力 = 0,
    必须往返一致 = 1
};

struct 数据库启动审计端口 {
    std::function<缓存命名空间()> 定义结构统计命名空间;
    std::function<结构统计快照(缓存命名空间)> 读取结构统计快照;
    std::function<数据库操作结果(const 结构统计快照&, std::wstring)> 写入结构统计审计;
    std::function<数据库查询结果(std::size_t)> 读取最近结构统计审计;

    bool 完整() const noexcept {
        return 定义结构统计命名空间
            && 读取结构统计快照
            && 写入结构统计审计
            && 读取最近结构统计审计;
    }
};

enum class 数据库启动审计状态 : std::uint8_t {
    往返一致 = 0,
    端口无效 = 1,
    命名空间失败 = 2,
    快照失败 = 3,
    写入失败 = 4,
    读回失败 = 5,
    字段不一致 = 6
};

struct 数据库启动审计结果 {
    数据库启动审计状态 状态 = 数据库启动审计状态::端口无效;
    结构统计快照 快照;
    数据库操作结果 写入;
    数据库查询结果 读回;
    bool 往返一致 = false;

    bool 成功() const noexcept {
        return 状态 == 数据库启动审计状态::往返一致 && 往返一致;
    }
};

数据库启动审计结果 执行启动结构审计(
    const 数据库启动审计端口& 端口,
    数据库审计要求) {
    数据库启动审计结果 结果;
    if (!端口.完整()) {
        return 结果;
    }
    const auto 命名空间 = 端口.定义结构统计命名空间();
    if (命名空间.类型 != 缓存类型::结构统计
        || 命名空间.来源 != 来源结构类型::结构仓库集合
        || 命名空间.来源版本 == 0
        || 命名空间.规则版本 == 0
        || 命名空间.值类型 != 缓存值类型::结构数量
        || 命名空间.失效条件 == 缓存失效条件::未设置) {
        结果.状态 = 数据库启动审计状态::命名空间失败;
        return 结果;
    }
    结果.快照 = 端口.读取结构统计快照(命名空间);
    结果.写入 = 端口.写入结构统计审计(结果.快照, L"程序启动结构统计");
    if (!结果.写入.成功) {
        结果.状态 = 数据库启动审计状态::写入失败;
        return 结果;
    }
    结果.读回 = 端口.读取最近结构统计审计(1);
    if (!结果.读回.操作.成功 || 结果.读回.记录组.size() != 1) {
        结果.状态 = 数据库启动审计状态::读回失败;
        return 结果;
    }
    const auto& 记录 = 结果.读回.记录组.front();
    结果.往返一致 =
        记录.审计编号 == 结果.写入.审计编号
        && 记录.节点数 == 结果.快照.节点数
        && 记录.关系数 == 结果.快照.关系数
        && 记录.索引数 == 结果.快照.索引数;
    结果.状态 = 结果.往返一致
        ? 数据库启动审计状态::往返一致
        : 数据库启动审计状态::字段不一致;
    return 结果;
}

}
