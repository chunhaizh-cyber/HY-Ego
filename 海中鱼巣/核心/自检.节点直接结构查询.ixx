namespace 海中鱼巣::节点直接结构查询自检内部 {

bool 允许精确索引查询自检关系(
    节点类型,
    节点类型,
    std::int64_t) noexcept {
    return true;
}

完整正式关系准入表 形成精确索引查询自检关系准入表() {
    完整正式关系准入表 表;
    for (std::size_t 序号 = 0; 序号 < 表.规则组.size(); ++序号) {
        表.规则组[序号] = {
            static_cast<关系类型>(序号),
            0x5031'4132'5100'0001ULL + 序号,
            1,
            true,
            true,
            true,
            &允许精确索引查询自检关系};
    }
    return 表;
}

class 精确索引查询空操作持久端口 final : public 节点直接持久证据写入端口 {
public:
    节点直接持久端口结果 准备(const 节点直接持久准备请求&) override {
        return {节点直接持久端口状态::资源失败, 0};
    }

    节点直接持久端口结果 标记已发布(
        const 节点直接持久发布见证请求&) override {
        return {节点直接持久端口状态::资源失败, 0};
    }

    节点直接持久端口结果 标记已撤销未发布(
        const 节点直接持久撤销见证请求&) override {
        return {节点直接持久端口状态::资源失败, 0};
    }
};

class 精确索引查询许可竞争参与者 final : public 节点直接身份结构写入事务参与者 {
public:
    精确索引查询许可竞争参与者(
        std::atomic_bool& 已进入准备,
        std::atomic_bool& 允许退出准备) noexcept
        : 已进入准备_(已进入准备),
          允许退出准备_(允许退出准备) {
    }

private:
    节点直接身份结构写入结果 准备提交(
        const 节点直接身份结构提交准备只读视图&) override {
        已进入准备_.store(true, std::memory_order_release);
        while (!允许退出准备_.load(std::memory_order_acquire)) {
            std::this_thread::yield();
        }
        return {节点直接身份结构写入状态::已提交, 0, 0, 0};
    }

    节点直接身份结构写入结果 确认待发布() override {
        return {节点直接身份结构写入状态::候选已确认, 0, 0, 0};
    }

    void 完成发布() noexcept override {
    }

    节点直接身份结构写入结果 完成撤销() override {
        return {节点直接身份结构写入状态::候选已撤销, 0, 0, 0};
    }

    std::atomic_bool& 已进入准备_;
    std::atomic_bool& 允许退出准备_;
};

struct 精确索引查询隔离夹具 {
    explicit 精确索引查询隔离夹具(
        std::uint64_t 仓库基数,
        节点直接身份结构事务域启动模式 启动模式 =
            节点直接身份结构事务域启动模式::等待恢复)
        : 节点(仓库基数),
          关系(节点, 形成精确索引查询自检关系准入表(), 仓库基数 + 1),
          索引(节点, 关系),
          事务域(启动模式),
          执行器(&事务域, &节点, &关系, &索引,
              &类型合同, &类型化值, &幂等, &持久),
          查询(事务域, 节点, 关系, 索引, 类型合同, 类型化值) {
    }

    节点直接身份仓库 节点;
    正式关系仓库 关系;
    可重建索引仓库 索引;
    节点直接身份结构事务域 事务域;
    节点直接类型合同仓库 类型合同;
    节点直接类型化值仓库 类型化值;
    节点直接事务幂等仓库 幂等;
    精确索引查询空操作持久端口 持久;
    节点直接身份结构写入执行器 执行器;
    节点直接结构查询服务 查询;
};

struct 精确索引查询已发布夹具 {
    索引物理键 节点索引键;
    索引物理键 关系索引键;
    节点句柄 节点目标;
    关系句柄 关系目标;
    std::uint64_t 已发布代次 = 0;
};

bool 索引记录相同(const 可重建索引记录& 左, const 可重建索引记录& 右) noexcept {
    return 左.物理键 == 右.物理键 && 左.目标种类 == 右.目标种类
        && 左.节点 == 右.节点 && 左.关系 == 右.关系;
}

bool 仓读取成功(
    const 可重建索引精确读取结果& 结果,
    const 可重建索引记录& 预期) noexcept {
    return 结果.状态 == 可重建索引精确读取状态::已读取
        && 结果.当前记录.has_value() && 索引记录相同(*结果.当前记录, 预期);
}

bool 服务节点读取成功(
    const 节点直接索引读取结果& 结果,
    const 索引物理键& 键,
    const 节点直接身份记录& 节点,
    std::uint64_t 代次) noexcept {
    return 结果.头.状态 == 节点直接结构服务状态::成功
        && 结果.头.事实截止代次 == 代次 && 结果.索引组.size() == 1
        && 结果.索引组.front().键 == 键 && 结果.索引组.front().当前
        && 结果.索引组.front().节点目标 == std::optional<节点稳定身份见证>{{
            节点.稳定主键, 节点.类型, 节点.版本号}}
        && !结果.索引组.front().关系目标.has_value();
}

bool 服务关系读取成功(
    const 节点直接索引读取结果& 结果,
    const 索引物理键& 键,
    const 正式关系记录& 关系,
    const 节点直接身份记录& 源,
    const 节点直接身份记录& 目标,
    std::uint64_t 代次) noexcept {
    const 关系稳定身份见证 预期{
        关系.稳定主键,
        关系.类型,
        关系.版本号,
        {源.稳定主键, 源.类型, 源.版本号},
        {目标.稳定主键, 目标.类型, 目标.版本号},
        关系.顺序号};
    return 结果.头.状态 == 节点直接结构服务状态::成功
        && 结果.头.事实截止代次 == 代次 && 结果.索引组.size() == 1
        && 结果.索引组.front().键 == 键 && 结果.索引组.front().当前
        && !结果.索引组.front().节点目标.has_value()
        && 结果.索引组.front().关系目标 == std::optional<关系稳定身份见证>{预期};
}

struct 权威摘要 {
    std::uint64_t 发布代次 = 0;
    std::uint64_t 节点仓库编号 = 0;
    std::uint64_t 下个节点编号 = 0;
    std::uint64_t 下个创建序号 = 0;
    std::size_t 节点高水位 = 0;
    std::size_t 节点历史 = 0;
    std::size_t 节点记录 = 0;
    std::size_t 关系高水位 = 0;
    std::size_t 关系历史 = 0;
    std::size_t 关系记录 = 0;
    std::size_t 索引记录 = 0;
    std::size_t 合同高水位 = 0;
    std::size_t 合同历史 = 0;
    std::size_t 合同记录 = 0;
    std::size_t 值高水位 = 0;
    std::size_t 值历史 = 0;
    std::size_t 值记录 = 0;
    std::size_t 幂等记录 = 0;
    std::size_t 持久侧账 = 0;
    friend bool operator==(const 权威摘要&, const 权威摘要&) = default;
};

权威摘要 读取权威摘要(const 精确索引查询隔离夹具& 夹具) {
    auto& 可写事务域 = const_cast<节点直接身份结构事务域&>(夹具.事务域);
    const auto 许可 = 可写事务域.取得读取许可();
    const auto 节点 = 夹具.节点.导出权威状态();
    const auto 关系 = 夹具.关系.导出权威状态();
    const auto 索引 = 夹具.索引.导出可丢弃加速材料();
    const auto 合同 = 夹具.类型合同.导出权威状态();
    const auto 值 = 夹具.类型化值.导出权威状态();
    const auto 幂等 = 夹具.幂等.导出恢复材料();
    return {
        许可.有效() ? 许可.读取已发布代次() : 0,
        节点.仓库编号,
        节点.下个节点编号,
        节点.下个创建序号,
        节点.每域高水位.size(),
        节点.历史占用.size(),
        节点.记录组.size(),
        关系.每域高水位.size(),
        关系.历史占用.size(),
        关系.记录组.size(),
        索引.记录组.size(),
        合同.每域高水位.size(),
        合同.历史占用.size(),
        合同.记录组.size(),
        值.每域高水位.size(),
        值.历史占用.size(),
        值.记录组.size(),
        幂等.记录组.size(),
        幂等.持久证据侧账组.size()};
}

std::optional<精确索引查询已发布夹具> 形成已发布双目标索引夹具(
    精确索引查询隔离夹具& 夹具) {
    const 索引物理键 节点索引键{0x5031'4132'5100ULL, 1, 1, 1, 1};
    const 索引物理键 关系索引键{0x5031'4132'5100ULL, 2, 1, 1, 2};
    const 节点稳定身份见证 场景{{
        static_cast<std::uint64_t>(节点稳定主键命名域::场景身份), 1},
        节点类型::场景, 1};
    const 节点稳定身份见证 文章{{
        static_cast<std::uint64_t>(节点稳定主键命名域::文章身份), 1},
        节点类型::文章, 1};
    const 关系稳定身份见证 父子{{
        static_cast<std::uint64_t>(关系稳定主键命名域::正式关系), 1},
        关系类型::普通父子, 1, 场景, 文章, 1};

    节点直接恢复结构事务请求 请求;
    请求.合同版本 = 1;
    请求.材料格式版本 = 2;
    请求.安装实例身份 = {0x5031'4132'5100ULL, 1};
    请求.恢复事实截止代次 = 1;
    请求.高水位组 = {
        {节点直接恢复占用种类::节点, 场景.稳定主键.命名域, 1},
        {节点直接恢复占用种类::节点, 文章.稳定主键.命名域, 1},
        {节点直接恢复占用种类::关系, 父子.稳定主键.命名域, 1}};
    请求.历史占用组 = {
        {节点直接恢复占用种类::节点, 场景.稳定主键.命名域, 1, 节点类型::场景},
        {节点直接恢复占用种类::节点, 文章.稳定主键.命名域, 1, 节点类型::文章},
        {节点直接恢复占用种类::关系, 父子.稳定主键.命名域, 1, 节点类型::未分类}};
    请求.节点历史组 = {{场景, true}, {文章, true}};
    请求.关系历史组 = {{父子, true}};
    请求.索引历史组 = {
        {节点索引键, true, 文章, std::nullopt},
        {关系索引键, true, std::nullopt, 父子}};

    const auto 恢复 = 夹具.执行器.执行节点直接恢复事务({请求});
    if (恢复.状态 != 节点直接恢复数据操作状态::已恢复
        || 恢复.事实截止代次 != 1) return std::nullopt;

    std::uint64_t 代次 = 0;
    {
        auto 许可 = 夹具.事务域.取得读取许可();
        if (!许可.有效()) return std::nullopt;
        代次 = 许可.读取已发布代次();
    }
    if (代次 != 1) return std::nullopt;
    const auto 节点仓读回 = 夹具.索引.读取索引物理键结构化(节点索引键);
    const auto 关系仓读回 = 夹具.索引.读取索引物理键结构化(关系索引键);
    if (节点仓读回.状态 != 可重建索引精确读取状态::已读取
        || 关系仓读回.状态 != 可重建索引精确读取状态::已读取
        || !节点仓读回.当前记录 || !关系仓读回.当前记录
        || 节点仓读回.当前记录->目标种类 != 索引目标种类::节点
        || 关系仓读回.当前记录->目标种类 != 索引目标种类::关系
        || !句柄有效(节点仓读回.当前记录->节点)
        || !句柄有效(关系仓读回.当前记录->关系)) return std::nullopt;

    const auto 文章句柄 = 节点仓读回.当前记录->节点;
    const auto 父子句柄 = 关系仓读回.当前记录->关系;
    const auto 节点记录 = 夹具.节点.读取节点(文章句柄);
    const auto 关系记录 = 夹具.关系.读取关系(父子句柄);
    const auto 源记录 = 关系记录
        ? 夹具.节点.读取节点(关系记录->源节点) : std::nullopt;
    const auto 目标记录 = 关系记录
        ? 夹具.节点.读取节点(关系记录->目标节点) : std::nullopt;
    if (!节点记录 || !关系记录 || !源记录 || !目标记录
        || 节点记录->稳定主键 != 文章.稳定主键
        || 节点记录->类型 != 文章.类型 || 节点记录->版本号 != 文章.身份版本
        || 关系记录->稳定主键 != 父子.稳定主键
        || 关系记录->类型 != 父子.类型 || 关系记录->版本号 != 父子.关系版本
        || 关系记录->顺序号 != 父子.角色或顺序
        || 源记录->稳定主键 != 场景.稳定主键
        || 源记录->类型 != 场景.类型 || 源记录->版本号 != 场景.身份版本
        || 目标记录->稳定主键 != 文章.稳定主键
        || 目标记录->类型 != 文章.类型 || 目标记录->版本号 != 文章.身份版本
        || !服务节点读取成功(夹具.查询.读取当前索引(节点索引键),
            节点索引键, *节点记录, 代次)
        || !服务关系读取成功(夹具.查询.读取当前索引(关系索引键),
            关系索引键, *关系记录, *源记录, *目标记录, 代次)) {
        return std::nullopt;
    }
    return 精确索引查询已发布夹具{
        节点索引键, 关系索引键, 文章句柄, 父子句柄, 代次};
}

bool 内部不一致且空(const 可重建索引精确读取结果& 结果) noexcept {
    return 结果.状态 == 可重建索引精确读取状态::内部不一致
        && !结果.当前记录.has_value();
}

bool 内部不一致且空(const 节点直接索引读取结果& 结果) noexcept {
    return 结果.头.状态 == 节点直接结构服务状态::内部不一致
        && 结果.头.事实截止代次 == 0 && 结果.索引组.empty();
}

bool 资源失败且空(const 可重建索引精确读取结果& 结果) noexcept {
    return 结果.状态 == 可重建索引精确读取状态::资源失败
        && !结果.当前记录.has_value();
}

bool 资源失败且空(const 节点直接索引读取结果& 结果) noexcept {
    return 结果.头.状态 == 节点直接结构服务状态::资源失败
        && 结果.头.事实截止代次 == 0 && 结果.索引组.empty();
}

} // namespace 海中鱼巣::节点直接结构查询自检内部

export namespace 海中鱼巣 {

struct 节点直接结构查询自检报告 {
    bool 总通过 = false;
    std::size_t 验收数量 = 0;
    std::size_t 失败数量 = 0;
};

节点直接结构查询自检报告 运行节点直接结构查询自检() {
    using namespace 节点直接结构查询自检内部;
    std::vector<bool> 验收;
    精确索引查询隔离夹具 夹具(0x5031'4132'5101ULL);
    const auto 已发布 = 形成已发布双目标索引夹具(夹具);
    验收.push_back(已发布.has_value());
    if (!已发布) return {false, 验收.size(), 1};
    const 可重建索引记录 节点索引{
        已发布->节点索引键, 索引目标种类::节点, 已发布->节点目标, {}};
    const 可重建索引记录 关系索引{
        已发布->关系索引键, 索引目标种类::关系, {}, 已发布->关系目标};
    const auto 节点记录 = 夹具.节点.读取节点(已发布->节点目标);
    const auto 关系记录 = 夹具.关系.读取关系(已发布->关系目标);
    const auto 源记录 = 关系记录 ? 夹具.节点.读取节点(关系记录->源节点) : std::nullopt;
    验收.push_back(节点记录.has_value() && 关系记录.has_value() && 源记录.has_value());

    const 索引物理键 非法键{};
    const 索引物理键 未命中键{0x5031'4132'5100ULL, 3, 1, 1, 3};
    const auto 非法仓 = 夹具.索引.读取索引物理键结构化(非法键);
    const auto 非法服务 = 夹具.查询.读取当前索引(非法键);
    验收.push_back(非法仓.状态 == 可重建索引精确读取状态::入口拒绝
        && 非法服务.头.状态 == 节点直接结构服务状态::入口拒绝
        && 非法服务.头.事实截止代次 == 0 && 非法服务.索引组.empty());
    const auto 未命中仓 = 夹具.索引.读取索引物理键结构化(未命中键);
    const auto 未命中服务 = 夹具.查询.读取当前索引(未命中键);
    验收.push_back(未命中仓.状态 == 可重建索引精确读取状态::未找到
        && 未命中服务.头.状态 == 节点直接结构服务状态::未找到
        && 未命中服务.头.事实截止代次 == 已发布->已发布代次
        && 未命中服务.索引组.empty());
    精确索引查询隔离夹具 零代次夹具(
        0x5031'4132'5111ULL,
        节点直接身份结构事务域启动模式::兼容既有直接开放);
    const auto 零代次 = 零代次夹具.查询.读取当前索引(未命中键);
    验收.push_back(零代次.头.状态 == 节点直接结构服务状态::未找到
        && 零代次.头.事实截止代次 == 0 && 零代次.索引组.empty());

    const 索引物理键 未发布键{0x5031'4132'5100ULL, 4, 1, 1, 4};
    auto 未发布候选 = 夹具.索引.结构化创建索引候选(
        {未发布键, 索引目标种类::节点, 已发布->节点目标, {}}, 0xA2'01);
    const auto 未发布仓 = 夹具.索引.读取索引物理键结构化(未发布键);
    const auto 未发布服务 = 夹具.查询.读取当前索引(未发布键);
    const bool 未发布已撤销 = 未发布候选.候选
        && 夹具.索引.撤销候选(*未发布候选.候选, 0xA2'01)
            == 可重建索引操作状态::已撤销;
    验收.push_back(
        未发布候选.状态 == 可重建索引操作状态::已创建候选
        && 未发布仓.状态 == 可重建索引精确读取状态::未找到
        && 未发布服务.头.状态 == 节点直接结构服务状态::未找到
        && 未发布服务.头.事实截止代次 == 已发布->已发布代次
        && 未发布服务.索引组.empty() && 未发布已撤销);

    精确索引查询隔离夹具 移除夹具(0x5031'4132'5131ULL);
    const auto 移除已发布 = 形成已发布双目标索引夹具(移除夹具);
    bool 移除后未找到 = false;
    if (移除已发布) {
        const auto 移除节点记录 = 移除夹具.节点.读取节点(移除已发布->节点目标);
        if (移除节点记录) {
            auto 移除候选 = 移除夹具.索引.结构化移除索引候选(
                移除已发布->节点索引键,
                {移除节点记录->稳定主键, 移除节点记录->类型, 移除节点记录->版本号},
                0xA2'02);
            if (移除候选.候选
                && 移除夹具.索引.确认候选(*移除候选.候选, 0xA2'02)
                    == 可重建索引操作状态::已确认待发布) {
                移除夹具.索引.完成发布(*移除候选.候选, 0xA2'02);
                const auto 移除仓读回 = 移除夹具.索引.读取索引物理键结构化(
                    移除已发布->节点索引键);
                const auto 移除服务读回 = 移除夹具.查询.读取当前索引(
                    移除已发布->节点索引键);
                移除后未找到 =
                    移除仓读回.状态 == 可重建索引精确读取状态::未找到
                    && 移除服务读回.头.状态 == 节点直接结构服务状态::未找到
                    && 移除服务读回.头.事实截止代次 == 移除已发布->已发布代次
                    && 移除服务读回.索引组.empty();
            }
        }
    }
    验收.push_back(移除后未找到);

    std::atomic_bool 已进入准备{false};
    std::atomic_bool 允许退出准备{false};
    精确索引查询许可竞争参与者 竞争参与者(已进入准备, 允许退出准备);
    std::array<节点直接身份结构写入事务参与者*, 1> 竞争参与者组{&竞争参与者};
    节点直接身份结构写入结果 竞争事务结果;
    std::thread 竞争线程([&] {
        竞争事务结果 = 夹具.执行器.执行仅参与者事务(竞争参与者组);
    });
    for (std::size_t 尝试 = 0;
         尝试 < 100'000 && !已进入准备.load(std::memory_order_acquire);
         ++尝试) {
        std::this_thread::yield();
    }
    const bool 已取得独占许可 = 已进入准备.load(std::memory_order_acquire);
    const auto 竞争读取 = 已取得独占许可
        ? 夹具.查询.读取当前索引(已发布->节点索引键)
        : 节点直接索引读取结果{};
    允许退出准备.store(true, std::memory_order_release);
    竞争线程.join();
    验收.push_back(已取得独占许可
        && 竞争读取.头.状态 == 节点直接结构服务状态::许可拒绝
        && 竞争读取.头.事实截止代次 == 0 && 竞争读取.索引组.empty()
        && 竞争事务结果.状态 == 节点直接身份结构写入状态::已提交);
    const auto 基线摘要 = 读取权威摘要(夹具);

#if defined(HY_EGO_ENABLE_STRUCTURE_COMMIT_FAULT_SELF_TEST)
    for (const auto 模式 : {
        可重建索引精确读取内部损坏测试种类::已发布候选事务序号非零,
        可重建索引精确读取内部损坏测试种类::记录键错配,
        可重建索引精确读取内部损坏测试种类::反向绑定缺失,
        可重建索引精确读取内部损坏测试种类::反向绑定重复,
        可重建索引精确读取内部损坏测试种类::目标权威不可读}) {
        const bool 已设置 = 夹具.索引.测试_令下次结构化精确读取模拟内部损坏(模式);
        const auto 首次 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
        const auto 再次 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
        验收.push_back(已设置 && 内部不一致且空(首次)
            && 仓读取成功(再次, 节点索引) && 读取权威摘要(夹具) == 基线摘要);
    }
    const auto 测试服务模式 = [&](节点直接当前索引读取内部损坏测试种类 模式,
                                   const 索引物理键& 键,
                                   bool 是节点) {
        const bool 已设置 = 夹具.查询.测试_令下次当前索引读取模拟内部损坏(模式);
        const auto 首次 = 夹具.查询.读取当前索引(键);
        const auto 再次 = 夹具.查询.读取当前索引(键);
        const bool 已恢复 = 是节点
            ? 服务节点读取成功(再次, 键, *节点记录, 已发布->已发布代次)
            : 服务关系读取成功(再次, 键, *关系记录, *源记录,
                *节点记录, 已发布->已发布代次);
        return 已设置 && 内部不一致且空(首次) && 已恢复
            && 读取权威摘要(夹具) == 基线摘要;
    };
    验收.push_back(测试服务模式(
        节点直接当前索引读取内部损坏测试种类::节点目标权威读回缺失,
        已发布->节点索引键, true));
    验收.push_back(测试服务模式(
        节点直接当前索引读取内部损坏测试种类::关系目标权威读回缺失,
        已发布->关系索引键, false));
    验收.push_back(测试服务模式(
        节点直接当前索引读取内部损坏测试种类::关系端点见证不可形成,
        已发布->关系索引键, false));

    夹具.索引.测试_令下次结构化精确读取抛出资源异常();
    const auto 仓资源 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
    const auto 仓资源恢复 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
    验收.push_back(资源失败且空(仓资源) && 仓读取成功(仓资源恢复, 节点索引)
        && 读取权威摘要(夹具) == 基线摘要);
    夹具.索引.测试_令下次结构化精确读取抛出其它异常();
    const auto 仓其它 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
    const auto 仓其它恢复 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
    验收.push_back(内部不一致且空(仓其它) && 仓读取成功(仓其它恢复, 节点索引)
        && 读取权威摘要(夹具) == 基线摘要);

    夹具.查询.测试_令下次当前索引读取抛出资源异常();
    const auto 服务资源 = 夹具.查询.读取当前索引(已发布->节点索引键);
    const auto 服务资源恢复 = 夹具.查询.读取当前索引(已发布->节点索引键);
    验收.push_back(资源失败且空(服务资源)
        && 服务节点读取成功(服务资源恢复, 已发布->节点索引键,
            *节点记录, 已发布->已发布代次) && 读取权威摘要(夹具) == 基线摘要);
    夹具.查询.测试_令下次当前索引读取抛出其它异常();
    const auto 服务其它 = 夹具.查询.读取当前索引(已发布->节点索引键);
    const auto 服务其它恢复 = 夹具.查询.读取当前索引(已发布->节点索引键);
    验收.push_back(内部不一致且空(服务其它)
        && 服务节点读取成功(服务其它恢复, 已发布->节点索引键,
            *节点记录, 已发布->已发布代次) && 读取权威摘要(夹具) == 基线摘要);
    const auto 非法仓模式 = static_cast<可重建索引精确读取内部损坏测试种类>(0);
    const auto 非法服务模式 = static_cast<节点直接当前索引读取内部损坏测试种类>(0);
    验收.push_back(!夹具.索引.测试_令下次结构化精确读取模拟内部损坏(非法仓模式)
        && 仓读取成功(夹具.索引.读取索引物理键结构化(已发布->节点索引键), 节点索引));
    验收.push_back(!夹具.查询.测试_令下次当前索引读取模拟内部损坏(非法服务模式)
        && 服务节点读取成功(夹具.查询.读取当前索引(已发布->节点索引键),
            已发布->节点索引键, *节点记录, 已发布->已发布代次));

    夹具.索引.测试_令下次结构化精确读取模拟内部损坏(
        可重建索引精确读取内部损坏测试种类::记录键错配);
    const auto 仓非法不消费 = 夹具.索引.读取索引物理键结构化(非法键);
    const auto 仓合法命中 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
    const auto 仓再恢复 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
    验收.push_back(仓非法不消费.状态 == 可重建索引精确读取状态::入口拒绝
        && 内部不一致且空(仓合法命中) && 仓读取成功(仓再恢复, 节点索引));
    夹具.查询.测试_令下次当前索引读取模拟内部损坏(
        节点直接当前索引读取内部损坏测试种类::节点目标权威读回缺失);
    const auto 服务非法不消费 = 夹具.查询.读取当前索引(非法键);
    const auto 服务合法命中 = 夹具.查询.读取当前索引(已发布->节点索引键);
    const auto 服务再恢复 = 夹具.查询.读取当前索引(已发布->节点索引键);
    验收.push_back(服务非法不消费.头.状态 == 节点直接结构服务状态::入口拒绝
        && 内部不一致且空(服务合法命中)
        && 服务节点读取成功(服务再恢复, 已发布->节点索引键,
            *节点记录, 已发布->已发布代次));
    精确索引查询隔离夹具 隔离夹具(0x5031'4132'5121ULL);
    const auto 隔离已发布 = 形成已发布双目标索引夹具(隔离夹具);
    夹具.索引.测试_令下次结构化精确读取抛出其它异常();
    const auto 另一实例 = 隔离已发布
        ? 隔离夹具.索引.读取索引物理键结构化(隔离已发布->节点索引键)
        : 可重建索引精确读取结果{};
    const auto 本实例 = 夹具.索引.读取索引物理键结构化(已发布->节点索引键);
    验收.push_back(隔离已发布.has_value()
        && 另一实例.状态 == 可重建索引精确读取状态::已读取
        && 内部不一致且空(本实例));
#endif

    auto 深拷贝 = 夹具.查询.读取当前索引(已发布->节点索引键);
    if (!深拷贝.索引组.empty()) 深拷贝.索引组.front().键 = 未命中键;
    const auto 深拷贝后 = 夹具.查询.读取当前索引(已发布->节点索引键);
    验收.push_back(服务节点读取成功(深拷贝后, 已发布->节点索引键,
        *节点记录, 已发布->已发布代次));
    const auto 包装成功 = 夹具.索引.读取索引物理键(已发布->节点索引键);
    const auto 包装未命中 = 夹具.索引.读取索引物理键(未命中键);
    验收.push_back(包装成功.has_value() && 索引记录相同(*包装成功, 节点索引)
        && !包装未命中.has_value());
    验收.push_back(读取权威摘要(夹具) == 基线摘要);
    节点直接结构查询自检报告 报告;
    报告.验收数量 = 验收.size();
    报告.失败数量 = static_cast<std::size_t>(
        std::count(验收.begin(), 验收.end(), false));
#if defined(HY_EGO_ENABLE_STRUCTURE_COMMIT_FAULT_SELF_TEST)
    constexpr std::size_t 最低验收数量 = 20;
#else
    constexpr std::size_t 最低验收数量 = 11;
#endif
    报告.总通过 = 报告.验收数量 >= 最低验收数量 && 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
