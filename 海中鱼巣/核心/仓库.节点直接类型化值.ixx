// 文件规则：本模块只承载节点直接类型化值的当前记录、不可变历史及候选生命周期。
module;

#include "节点直接结构合同.数据.h"

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <limits>
#include <mutex>
#include <optional>
#include <shared_mutex>
#include <tuple>
#include <utility>
#include <vector>
#include <unordered_map>

export module 海中鱼巣.核心.仓库.节点直接类型化值;

export namespace 海中鱼巣 {

class 节点直接类型化值仓库;

class 节点直接类型化值候选 final {
public:
    节点直接类型化值候选(节点直接类型化值候选&& 其它) noexcept
        : 仓库_(其它.仓库_), 事务序号_(其它.事务序号_), 值记录身份_(其它.值记录身份_),
          是退役_(其它.是退役_), 阶段_(其它.阶段_) {
        其它.仓库_ = nullptr;
        其它.事务序号_ = 0;
        其它.阶段_ = 节点直接仓候选阶段::已移动;
    }
    节点直接类型化值候选(const 节点直接类型化值候选&) = delete;
    节点直接类型化值候选& operator=(const 节点直接类型化值候选&) = delete;
    节点直接仓候选阶段 读取阶段() const noexcept { return 阶段_; }
    std::optional<类型化值读回> 读取候选值() const;

private:
    friend class 节点直接类型化值仓库;
    节点直接类型化值候选(
        节点直接类型化值仓库* 仓库,
        std::uint64_t 事务序号,
        类型化值记录稳定身份 值记录身份,
        bool 是退役) noexcept
        : 仓库_(仓库), 事务序号_(事务序号), 值记录身份_(值记录身份), 是退役_(是退役) {}

    节点直接类型化值仓库* 仓库_ = nullptr;
    std::uint64_t 事务序号_ = 0;
    类型化值记录稳定身份 值记录身份_;
    bool 是退役_ = false;
    节点直接仓候选阶段 阶段_ = 节点直接仓候选阶段::持有;
};

struct 节点直接类型化值候选结果 {
    节点直接仓候选操作状态 状态 = 节点直接仓候选操作状态::入口拒绝;
    std::optional<节点直接类型化值候选> 候选;
};

class 节点直接类型化值仓库 final {
public:
    std::vector<类型化值读回> 读取所属身份当前值组(节点稳定主键 所属身份) const {
        std::vector<类型化值读回> 结果;
        if (!稳定主键有效(所属身份)) return 结果;
        std::shared_lock 锁(仓库锁_);
        for (const auto& 条目值 : 记录组_) {
            if (条目值.已发布 && 条目值.记录.当前
                && 条目值.记录.所属身份.稳定主键 == 所属身份) {
                结果.push_back(条目值.记录);
            }
        }
        std::sort(结果.begin(), 结果.end(), [](const auto& 左, const auto& 右) {
            if (左.类型合同身份.命名域 != 右.类型合同身份.命名域)
                return 左.类型合同身份.命名域 < 右.类型合同身份.命名域;
            if (左.类型合同身份.键值 != 右.类型合同身份.键值)
                return 左.类型合同身份.键值 < 右.类型合同身份.键值;
            if (左.类型合同版本 != 右.类型合同版本)
                return 左.类型合同版本 < 右.类型合同版本;
            if (左.值记录身份.命名域 != 右.值记录身份.命名域)
                return 左.值记录身份.命名域 < 右.值记录身份.命名域;
            return 左.值记录身份.键值 < 右.值记录身份.键值;
        });
        return 结果;
    }

    节点直接类型化值候选结果 结构化发布值未发布候选(
        const 类型化值读回& 计划值,
        std::uint64_t 事务序号) {
        节点直接类型化值候选结果 结果;
        if (事务序号 == 0 || !值完整_(计划值) || !计划值.当前) return 结果;
        std::unique_lock 锁(仓库锁_);
        const auto 同身份 = 查找身份_(计划值.值记录身份);
        if (同身份 != 记录组_.end()) {
            结果.状态 = 同身份->记录 == 计划值
                ? 节点直接仓候选操作状态::精确同义
                : 节点直接仓候选操作状态::内部不一致;
            return 结果;
        }
        const auto 命名域 = 计划值.值记录身份.命名域;
        const auto 高水位位置 = 每域高水位_.find(命名域);
        const auto 当前高水位 = 高水位位置 == 每域高水位_.end() ? 0 : 高水位位置->second;
        if (当前高水位 == std::numeric_limits<std::uint64_t>::max()
            || 计划值.值记录身份.键值 != 当前高水位 + 1) {
            结果.状态 = 节点直接仓候选操作状态::版本漂移;
            return 结果;
        }
        const auto 当前 = 查找当前_(计划值);
        if (当前 == 记录组_.end()) {
            if (计划值.值记录版本 != 1 || 计划值.前一值记录版本.has_value()) {
                结果.状态 = 节点直接仓候选操作状态::版本漂移;
                return 结果;
            }
        } else {
            if (当前->记录.值记录版本 == std::numeric_limits<std::uint64_t>::max()
                || 计划值.值记录版本 != 当前->记录.值记录版本 + 1
                || !计划值.前一值记录版本.has_value()
                || *计划值.前一值记录版本 != 当前->记录.值记录版本) {
                结果.状态 = 节点直接仓候选操作状态::版本漂移;
                return 结果;
            }
        }
        try {
            记录组_.push_back({计划值, false, 事务序号, false});
            每域高水位_[命名域] = 计划值.值记录身份.键值;
            结果.候选.emplace(节点直接类型化值候选{
                this, 事务序号, 计划值.值记录身份, false});
            结果.状态 = 节点直接仓候选操作状态::已形成候选;
        } catch (...) {
            const auto 新位置 = 查找身份_(计划值.值记录身份);
            if (新位置 != 记录组_.end() && !新位置->已发布 && 新位置->事务序号 == 事务序号) {
                记录组_.erase(新位置);
            }
            if (当前高水位 == 0) 每域高水位_.erase(命名域);
            else 每域高水位_[命名域] = 当前高水位;
            结果.状态 = 节点直接仓候选操作状态::资源失败;
        }
        return 结果;
    }

    节点直接类型化值候选结果 结构化退役值未发布候选(
        const 类型化值读回& 预期当前,
        std::uint64_t 退役发布代次,
        std::uint64_t 事务序号) {
        节点直接类型化值候选结果 结果;
        if (事务序号 == 0 || 退役发布代次 == 0 || !值完整_(预期当前) || !预期当前.当前) return 结果;
        std::unique_lock 锁(仓库锁_);
        const auto 位置 = 查找身份_(预期当前.值记录身份);
        if (位置 == 记录组_.end() || !位置->已发布 || !(位置->记录 == 预期当前)) {
            结果.状态 = 节点直接仓候选操作状态::版本漂移;
            return 结果;
        }
        if (位置->待退役) {
            结果.状态 = 位置->事务序号 == 事务序号
                ? 节点直接仓候选操作状态::精确同义
                : 节点直接仓候选操作状态::内部不一致;
            return 结果;
        }
        位置->待退役 = true;
        位置->事务序号 = 事务序号;
        位置->候选退役代次 = 退役发布代次;
        结果.候选.emplace(节点直接类型化值候选{
            this, 事务序号, 预期当前.值记录身份, true});
        结果.状态 = 节点直接仓候选操作状态::已形成候选;
        return 结果;
    }

    节点直接仓候选操作状态 确认候选(
        节点直接类型化值候选& 候选,
        std::uint64_t 事务序号) {
        std::unique_lock 锁(仓库锁_);
        if (!候选匹配_(候选, 事务序号, 节点直接仓候选阶段::持有))
            return 节点直接仓候选操作状态::入口拒绝;
        const auto 位置 = 查找身份_(候选.值记录身份_);
        if (位置 == 记录组_.end() || 位置->事务序号 != 事务序号
            || (候选.是退役_ ? (!位置->已发布 || !位置->待退役) : 位置->已发布)) {
            return 节点直接仓候选操作状态::内部不一致;
        }
        候选.阶段_ = 节点直接仓候选阶段::已确认待发布;
        return 节点直接仓候选操作状态::已确认待发布;
    }

    节点直接仓候选操作状态 撤销候选(
        节点直接类型化值候选& 候选,
        std::uint64_t 事务序号) {
        std::unique_lock 锁(仓库锁_);
        if (候选.仓库_ != this || 候选.事务序号_ != 事务序号 || 事务序号 == 0
            || (候选.阶段_ != 节点直接仓候选阶段::持有
                && 候选.阶段_ != 节点直接仓候选阶段::已确认待发布)) {
            return 节点直接仓候选操作状态::入口拒绝;
        }
        const auto 位置 = 查找身份_(候选.值记录身份_);
        if (位置 == 记录组_.end() || 位置->事务序号 != 事务序号)
            return 节点直接仓候选操作状态::内部不一致;
        if (候选.是退役_) {
            if (!位置->已发布 || !位置->待退役) return 节点直接仓候选操作状态::内部不一致;
            位置->待退役 = false;
            位置->事务序号 = 0;
            位置->候选退役代次 = 0;
        } else {
            if (位置->已发布) return 节点直接仓候选操作状态::内部不一致;
            const auto 命名域 = 候选.值记录身份_.命名域;
            const auto 高水位位置 = 每域高水位_.find(命名域);
            if (高水位位置 == 每域高水位_.end()
                || 高水位位置->second != 候选.值记录身份_.键值) {
                return 节点直接仓候选操作状态::内部不一致;
            }
            记录组_.erase(位置);
            if (候选.值记录身份_.键值 == 1) 每域高水位_.erase(命名域);
            else 高水位位置->second = 候选.值记录身份_.键值 - 1;
        }
        候选.阶段_ = 节点直接仓候选阶段::已撤销;
        return 节点直接仓候选操作状态::已撤销;
    }

    节点直接仓候选操作状态 完成发布(
        节点直接类型化值候选& 候选,
        std::uint64_t 事务序号) noexcept {
        try {
            std::unique_lock 锁(仓库锁_);
            if (!候选匹配_(候选, 事务序号, 节点直接仓候选阶段::已确认待发布))
                return 节点直接仓候选操作状态::入口拒绝;
            auto 位置 = 查找身份_(候选.值记录身份_);
            if (位置 == 记录组_.end() || 位置->事务序号 != 事务序号)
                return 节点直接仓候选操作状态::内部不一致;
            if (候选.是退役_) {
                if (!位置->已发布 || !位置->待退役 || 位置->候选退役代次 == 0)
                    return 节点直接仓候选操作状态::内部不一致;
                位置->记录.当前 = false;
                位置->记录.当前状态发布代次 = 位置->候选退役代次;
                位置->待退役 = false;
                位置->事务序号 = 0;
                位置->候选退役代次 = 0;
            } else {
                if (位置->已发布) return 节点直接仓候选操作状态::内部不一致;
                const auto 新记录 = 位置->记录;
                for (auto& 条目值 : 记录组_) {
                    if (&条目值 == &*位置 || !条目值.已发布 || !条目值.记录.当前) continue;
                    if (同合同键_(条目值.记录, 新记录)) {
                        条目值.记录.当前 = false;
                        条目值.记录.当前状态发布代次 = 新记录.当前状态发布代次;
                    }
                }
                位置->已发布 = true;
                位置->事务序号 = 0;
                历史占用_.push_back({候选.值记录身份_});
            }
            候选.阶段_ = 节点直接仓候选阶段::已发布;
            return 节点直接仓候选操作状态::已发布;
        } catch (...) {
            return 节点直接仓候选操作状态::内部不一致;
        }
    }

    std::uint64_t 读取命名域高水位(std::uint64_t 命名域) const noexcept {
        try {
            std::shared_lock 锁(仓库锁_);
            const auto 位置 = 每域高水位_.find(命名域);
            return 位置 == 每域高水位_.end() ? 0 : 位置->second;
        } catch (...) { return 0; }
    }

    节点直接类型化值仓库权威材料 导出权威状态() const {
        std::shared_lock 锁(仓库锁_);
        节点直接类型化值仓库权威材料 材料;
        for (const auto& [命名域, 高水位] : 每域高水位_) 材料.每域高水位.push_back({命名域, 高水位});
        材料.历史占用 = 历史占用_;
        for (const auto& 条目 : 记录组_) if (条目.已发布) 材料.记录组.push_back(条目.记录);
        std::sort(材料.每域高水位.begin(), 材料.每域高水位.end(), [](const auto& 左, const auto& 右) {
            return 左.命名域 < 右.命名域;
        });
        std::sort(材料.历史占用.begin(), 材料.历史占用.end(), [](const auto& 左, const auto& 右) {
            return 左.身份.命名域 != 右.身份.命名域 ? 左.身份.命名域 < 右.身份.命名域
                : 左.身份.键值 < 右.身份.键值;
        });
        std::sort(材料.记录组.begin(), 材料.记录组.end(), [](const auto& 左, const auto& 右) {
            return 左.值记录身份.命名域 != 右.值记录身份.命名域
                ? 左.值记录身份.命名域 < 右.值记录身份.命名域
                : 左.值记录身份.键值 < 右.值记录身份.键值;
        });
        return 材料;
    }

private:
    struct 条目 {
        类型化值读回 记录;
        bool 已发布 = false;
        std::uint64_t 事务序号 = 0;
        bool 待退役 = false;
        std::uint64_t 候选退役代次 = 0;
    };
    using 位置类型 = std::vector<条目>::iterator;
    using 只读位置类型 = std::vector<条目>::const_iterator;

    static bool 来源完整_(const 类型化值来源见证& 来源) noexcept {
        if (const auto* 节点 = std::get_if<节点稳定身份见证>(&来源)) return 节点稳定身份见证完整(*节点);
        const auto* 服务 = std::get_if<服务稳定身份>(&来源);
        return 服务 != nullptr && 服务稳定身份完整(*服务);
    }
    static bool 材料完整_(const 类型化值材料& 材料) noexcept {
        if (const auto* 区间 = std::get_if<I64区间材料>(&材料)) return 区间->下界 <= 区间->上界;
        if (const auto* 身份组 = std::get_if<稳定身份有序组材料>(&材料)) {
            return std::all_of(身份组->项目组.begin(), 身份组->项目组.end(), 节点稳定身份见证完整);
        }
        if (const auto* 引用 = std::get_if<独立材料引用>(&材料)) {
            return 稳定主键有效(引用->材料身份) && 引用->格式版本 != 0 && 引用->字节数 != 0
                && std::any_of(引用->SHA256.begin(), 引用->SHA256.end(), [](std::uint8_t 值) { return 值 != 0; });
        }
        return true;
    }
    static bool 值完整_(const 类型化值读回& 值) noexcept {
        return 节点稳定身份见证完整(值.所属身份)
            && 类型合同稳定身份完整(值.类型合同身份)
            && 值.类型合同版本 != 0
            && 类型化值记录稳定身份完整(值.值记录身份)
            && 值.值记录版本 != 0
            && 来源完整_(值.来源) && 材料完整_(值.材料)
            && 值.首次发布代次 != 0
            && 值.当前状态发布代次 >= 值.首次发布代次;
    }
    static bool 同合同键_(const 类型化值读回& 左, const 类型化值读回& 右) noexcept {
        return 左.所属身份.稳定主键 == 右.所属身份.稳定主键
            && 左.类型合同身份 == 右.类型合同身份
            && 左.类型合同版本 == 右.类型合同版本;
    }
    位置类型 查找身份_(类型化值记录稳定身份 身份) {
        return std::find_if(记录组_.begin(), 记录组_.end(), [&](const 条目& 值) { return 值.记录.值记录身份 == 身份; });
    }
    只读位置类型 查找身份_(类型化值记录稳定身份 身份) const {
        return std::find_if(记录组_.cbegin(), 记录组_.cend(), [&](const 条目& 值) { return 值.记录.值记录身份 == 身份; });
    }
    位置类型 查找当前_(const 类型化值读回& 计划值) {
        return std::find_if(记录组_.begin(), 记录组_.end(), [&](const 条目& 值) {
            return 值.已发布 && 值.记录.当前 && 同合同键_(值.记录, 计划值);
        });
    }
    bool 候选匹配_(const 节点直接类型化值候选& 候选, std::uint64_t 事务序号,
        节点直接仓候选阶段 阶段) const noexcept {
        return 事务序号 != 0 && 候选.仓库_ == this && 候选.事务序号_ == 事务序号 && 候选.阶段_ == 阶段;
    }
    friend class 节点直接类型化值候选;
    mutable std::shared_mutex 仓库锁_;
    std::vector<条目> 记录组_;
    std::unordered_map<std::uint64_t, std::uint64_t> 每域高水位_;
    std::vector<类型化值记录稳定身份历史占用> 历史占用_;
};

std::optional<类型化值读回> 节点直接类型化值候选::读取候选值() const {
    if (仓库_ == nullptr || 事务序号_ == 0
        || (阶段_ != 节点直接仓候选阶段::持有
            && 阶段_ != 节点直接仓候选阶段::已确认待发布)) return std::nullopt;
    std::shared_lock 锁(仓库_->仓库锁_);
    const auto 位置 = 仓库_->查找身份_(值记录身份_);
    if (位置 == 仓库_->记录组_.end() || 位置->事务序号 != 事务序号_) return std::nullopt;
    auto 值 = 位置->记录;
    if (是退役_) {
        值.当前 = false;
        值.当前状态发布代次 = 位置->候选退役代次;
    }
    return 值;
}

} // namespace 海中鱼巣
