module;

#include <cstddef>
#include <cstdint>
#include <algorithm>
#include <atomic>
#include <chrono>
#include <optional>
#include <thread>
#include <variant>
#include <utility>
#include <vector>

export module 海中鱼巣.核心.自检.L1事实基座;

import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.核心.仓库.L1事实基座;

export namespace 海中鱼巣 {

struct L1事实基座自检报告 final {
    std::vector<bool> 验收;
    std::size_t 失败数量 = 0;
    bool 总通过 = false;
};

// 诊断责任：向上送出；全部失败经结构化自检报告交给统一自检边界。
L1事实基座自检报告 运行L1事实基座自检() {
    std::vector<bool> 验收;
    auto 记 = [&](bool 通过) {
        验收.push_back(通过);
    };

    L1事实基座服务 服务;

    L1完整快照读取请求 错误快照请求;
    错误快照请求.合同版本 = L1事实基座合同版本 + 1;
    L1事实代次读取请求 错误代次请求;
    错误代次请求.合同版本 = L1事实基座合同版本 + 1;
    记(服务.尝试读取完整快照(错误快照请求).状态 == L1读取状态::入口拒绝
        && 服务.尝试读取当前事实代次(错误代次请求).状态 == L1读取状态::入口拒绝);
    const auto 空快照 = 服务.尝试读取完整快照({});
    const auto 空代次 = 服务.尝试读取当前事实代次({});
    记(空快照.状态 == L1读取状态::成功 && 空快照.快照
        && 空快照.快照->事实代次 == 0 && 空快照.快照->当前节点.empty()
        && 空快照.快照->当前关系.empty() && 空快照.快照->当前值.empty()
        && 空快照.快照->永久占用编码.empty()
        && 空代次 == L1事实代次读取结果{L1读取状态::未找到, 0});

    记(服务.读取当前节点({}).状态 == L1读取状态::入口拒绝);
    记(服务.读取当前关系({}).状态 == L1读取状态::入口拒绝);
    记(服务.读取当前值({}).状态 == L1读取状态::入口拒绝);
    记(服务.读取当前属性({L1事实基座合同版本, {}, {1}}).状态 == L1读取状态::入口拒绝);
    记(服务.读取历史事实({}).状态 == L1读取状态::入口拒绝);
    记(服务.读取审计({}).状态 == L1读取状态::入口拒绝);
    记(服务.导出恢复材料({1}).状态 == L1恢复材料导出状态::入口拒绝);

    L1写集请求 写集;
    写集.幂等键 = {0x0690'2700'0000'0001ULL};
    写集.期望事实代次 = 0;
    写集.节点 = {{ {1}, 节点种类::属性类型, 值表示种类::I64 }, { {2}, 节点种类::普通, std::nullopt }};
    写集.值 = {{ {3}, 写集本地键{2}, 写集本地键{1}, std::int64_t{42}, 写集本地键{2} }};
    写集.属性槽变更 = {{ 写集本地键{2}, 写集本地键{1}, 写集本地键{3} }};
    const auto 首次 = 服务.提交写集(写集, 0x1501C001U);
    记(首次.状态 == L1写入状态::成功 && 首次.事实代次 == 1 && 首次.新编码映射.size() == 3);
    const auto 非阻塞快照 = 服务.尝试读取完整快照({});
    const auto 非阻塞代次 = 服务.尝试读取当前事实代次({});
    记(非阻塞快照.状态 == L1读取状态::成功 && 非阻塞快照.快照
        && 非阻塞快照.快照->事实代次 == 首次.事实代次
        && 非阻塞代次 == L1事实代次读取结果{L1读取状态::成功, 首次.事实代次}
        && std::is_sorted(非阻塞快照.快照->当前节点.begin(),
            非阻塞快照.快照->当前节点.end(), [](const auto& 左, const auto& 右) {
                return 左.编码 < 右.编码;
            })
        && std::is_sorted(非阻塞快照.快照->当前值.begin(),
            非阻塞快照.快照->当前值.end(), [](const auto& 左, const auto& 右) {
                return 左.编码 < 右.编码;
            }));
    const auto 重复非阻塞快照 = 服务.尝试读取完整快照({});
    记(重复非阻塞快照.状态 == 非阻塞快照.状态
        && 重复非阻塞快照.快照 == 非阻塞快照.快照
        && 服务.尝试读取当前事实代次({}) == 非阻塞代次);

    L1完整快照结果 并发快照一;
    L1完整快照结果 并发快照二;
    std::thread 并发读者一([&] { 并发快照一 = 服务.尝试读取完整快照({}); });
    std::thread 并发读者二([&] { 并发快照二 = 服务.尝试读取完整快照({}); });
    并发读者一.join();
    并发读者二.join();
    记(并发快照一.状态 == 非阻塞快照.状态
        && 并发快照一.快照 == 非阻塞快照.快照
        && 并发快照二.状态 == 非阻塞快照.状态
        && 并发快照二.快照 == 非阻塞快照.快照);

#ifdef _DEBUG
    L1事实基座仓库 竞争仓库;
    std::atomic<bool> 已持有独占许可 = false;
    std::atomic<bool> 释放独占许可 = false;
    std::thread 独占持有者([&] {
        竞争仓库.自检_持有独占许可(已持有独占许可, 释放独占许可);
    });
    已持有独占许可.wait(false, std::memory_order_acquire);
    const auto 竞争开始 = std::chrono::steady_clock::now();
    const auto 竞争快照 = 竞争仓库.尝试读取完整快照();
    const auto 竞争代次 = 竞争仓库.尝试读取当前事实代次();
    const auto 竞争耗时 = std::chrono::steady_clock::now() - 竞争开始;
    释放独占许可.store(true, std::memory_order_release);
    释放独占许可.notify_one();
    独占持有者.join();
    记(竞争快照.状态 == L1读取状态::许可拒绝 && !竞争快照.快照
        && 竞争代次 == L1事实代次读取结果{L1读取状态::许可拒绝, 0}
        && 竞争耗时 < std::chrono::milliseconds{100}
        && 竞争仓库.尝试读取完整快照().状态 == L1读取状态::成功);

    L1事实基座仓库 损坏读取仓库;
    损坏读取仓库.自检_破坏当前状态用于恢复导出();
    记(损坏读取仓库.尝试读取完整快照().状态 == L1读取状态::内部不一致
        && 损坏读取仓库.尝试读取当前事实代次()
            == L1事实代次读取结果{L1读取状态::内部不一致, 0});

    L1事实基座仓库 资源故障仓库;
    资源故障仓库.自检_使下一次非阻塞快照资源失败();
    记(资源故障仓库.尝试读取完整快照().状态 == L1读取状态::资源失败
        && 资源故障仓库.尝试读取完整快照().状态 == L1读取状态::成功);
    资源故障仓库.自检_使下一次非阻塞快照内部异常();
    记(资源故障仓库.尝试读取完整快照().状态 == L1读取状态::内部不一致
        && 资源故障仓库.尝试读取完整快照().状态 == L1读取状态::成功);
#else
    记(true);
    记(true);
    记(true);
    记(true);
#endif
    const auto 重复 = 服务.提交写集(写集, 0x1501C001U);
    记(重复.状态 == L1写入状态::精确重复 && 重复.新编码映射 == 首次.新编码映射);
    auto 编码 = [&](写集本地键 键) { for (const auto& [本地, 稳定] : 首次.新编码映射) if (本地 == 键) return 稳定; return 稳定编码{}; };
    const auto 节点 = 编码({2}); const auto 值 = 编码({3}); const auto 属性类型 = 编码({1});
    记(有效(节点) && 有效(值) && 有效(属性类型));
    const auto 当前节点 = 服务.读取当前节点({L1事实基座合同版本, 节点});
    const auto 当前值 = 服务.读取当前值({L1事实基座合同版本, 值});
    记(当前节点.状态 == L1读取状态::成功 && 当前值.状态 == L1读取状态::成功);
    const auto 属性 = 服务.读取当前属性({L1事实基座合同版本, 节点, 属性类型});
    记(属性.状态 == L1读取状态::成功 && 属性.属性.has_value() && 属性.属性->当前值 == 值);
    const auto 快照 = 服务.读取完整快照({});
    记(快照.状态 == L1读取状态::成功 && 快照.快照.has_value() && 快照.快照->事实代次 == 1);
    const auto 历史当前 = 服务.读取历史事实({L1事实基座合同版本, 节点});
    记(历史当前.状态 == L1读取状态::成功 && 历史当前.历史.has_value() && 历史当前.历史->当前有效);
    const auto 审计 = 服务.读取审计({L1事实基座合同版本, 写集.幂等键});
    记(审计.状态 == L1读取状态::成功 && 审计.幂等键 == 写集.幂等键
        && 审计.记录组.size() == 1
        && std::all_of(审计.记录组.begin(), 审计.记录组.end(), [&](const auto& 记录) {
            return 记录.幂等键 == 审计.幂等键;
        }));

    auto 材料相等 = [](const 原始值材料& 左, const 原始值材料& 右) {
        if (左.index() != 右.index()) return false;
        switch (左.index()) {
        case 0: return std::get<std::int64_t>(左) == std::get<std::int64_t>(右);
        case 1: {
            const auto& 左组 = std::get<std::vector<std::int64_t>>(左);
            const auto& 右组 = std::get<std::vector<std::int64_t>>(右);
            return 左组.size() == 右组.size()
                && std::equal(左组.begin(), 左组.end(), 右组.begin());
        }
        case 2: {
            const auto& 左组 = std::get<std::vector<std::uint64_t>>(左);
            const auto& 右组 = std::get<std::vector<std::uint64_t>>(右);
            return 左组.size() == 右组.size()
                && std::equal(左组.begin(), 左组.end(), 右组.begin());
        }
        case 3: return std::get<独立材料引用>(左).编码 == std::get<独立材料引用>(右).编码;
        default: return false;
        }
    };
    auto 节点相等 = [](const 节点事实& 左, const 节点事实& 右) {
        if (左.编码 != 右.编码 || 左.种类 != 右.种类
            || 左.属性类型表示 != 右.属性类型表示
            || 左.创建事实代次 != 右.创建事实代次
            || 左.退出事实代次 != 右.退出事实代次
            || 左.当前属性.size() != 右.当前属性.size()) return false;
        for (std::size_t i = 0; i < 左.当前属性.size(); ++i) {
            if (!(左.当前属性[i] == 右.当前属性[i])) return false;
        }
        return true;
    };
    auto 关系相等 = [](const 关系事实& 左, const 关系事实& 右) {
        return 左.编码 == 右.编码 && 左.源节点 == 右.源节点
            && 左.目标节点 == 右.目标节点 && 左.关系类型节点 == 右.关系类型节点
            && 左.角色或顺序 == 右.角色或顺序
            && 左.创建事实代次 == 右.创建事实代次
            && 左.退出事实代次 == 右.退出事实代次;
    };
    auto 值相等 = [&](const 值事实& 左, const 值事实& 右) {
        return 左.编码 == 右.编码 && 左.所属节点 == 右.所属节点
            && 左.属性类型节点 == 右.属性类型节点 && 材料相等(左.材料, 右.材料)
            && 左.来源节点 == 右.来源节点 && 左.创建事实代次 == 右.创建事实代次
            && 左.退出事实代次 == 右.退出事实代次;
    };
    auto 快照相等 = [&](const std::optional<L1完整快照>& 左,
                       const std::optional<L1完整快照>& 右) {
        if (左.has_value() != 右.has_value()) return false;
        if (!左) return true;
        const auto& A = *左;
        const auto& B = *右;
        if (A.事实代次 != B.事实代次 || A.当前节点.size() != B.当前节点.size()
            || A.当前关系.size() != B.当前关系.size() || A.当前值.size() != B.当前值.size()
            || A.永久占用编码 != B.永久占用编码) return false;
        for (std::size_t i = 0; i < A.当前节点.size(); ++i)
            if (!节点相等(A.当前节点[i], B.当前节点[i])) return false;
        for (std::size_t i = 0; i < A.当前关系.size(); ++i)
            if (!关系相等(A.当前关系[i], B.当前关系[i])) return false;
        for (std::size_t i = 0; i < A.当前值.size(); ++i)
            if (!值相等(A.当前值[i], B.当前值[i])) return false;
        return true;
    };

    const auto 提交前快照 = 服务.读取完整快照({});
    L1写集请求 错误表示;
    错误表示.幂等键 = {0x0690'2700'0000'0003ULL};
    错误表示.期望事实代次 = 1;
    错误表示.节点 = {{ {10}, 节点种类::属性类型, 值表示种类::I64 }, { {11}, 节点种类::普通, std::nullopt }};
    错误表示.值 = {{ {12}, 写集本地键{11}, 写集本地键{10}, std::vector<std::int64_t>{7}, 写集本地键{11} }};
    const auto 错误表示结果 = 服务.提交写集(错误表示, 0x15000F02U);
    记(错误表示结果.状态 == L1写入状态::入口拒绝
        && 快照相等(服务.读取完整快照({}).快照, 提交前快照.快照));

    L1写集请求 悬空关系;
    悬空关系.幂等键 = {0x0690'2700'0000'0004ULL};
    悬空关系.期望事实代次 = 1;
    悬空关系.节点 = {{ {20}, 节点种类::普通, std::nullopt }, { {21}, 节点种类::普通, std::nullopt }};
    悬空关系.关系 = {{ {22}, 写集本地键{20}, 稳定编码{999999}, 写集本地键{20}, 1 }};
    记(服务.提交写集(悬空关系, 0x15000F03U).状态 == L1写入状态::入口拒绝
        && 快照相等(服务.读取完整快照({}).快照, 提交前快照.快照));

    L1写集请求 退出;
    退出.幂等键 = {0x0690'2700'0000'0002ULL};
    退出.期望事实代次 = 1;
    退出.退出事实 = {值};
    const auto 退出结果 = 服务.提交写集(退出, 0x15000F04U);
    记(退出结果.状态 == L1写入状态::成功 && 退出结果.事实代次 == 2);
    记(服务.读取当前值({L1事实基座合同版本, 值}).状态 == L1读取状态::已退出);
    const auto 历史 = 服务.读取历史事实({L1事实基座合同版本, 值});
    记(历史.状态 == L1读取状态::成功 && 历史.历史.has_value() && !历史.历史->当前有效);
    记(服务.读取完整快照({}).快照.has_value() && 服务.读取完整快照({}).快照->事实代次 == 2);
    const auto 退出后非阻塞快照 = 服务.尝试读取完整快照({});
    记(退出后非阻塞快照.状态 == L1读取状态::成功 && 退出后非阻塞快照.快照
        && 退出后非阻塞快照.快照->事实代次 == 2
        && std::none_of(退出后非阻塞快照.快照->当前值.begin(),
            退出后非阻塞快照.快照->当前值.end(), [&](const auto& 当前) {
                return 当前.编码 == 值;
            })
        && 服务.尝试读取当前事实代次({})
            == L1事实代次读取结果{L1读取状态::成功, 2});

    const auto 当前快照 = 服务.读取完整快照({});
    const auto 导出 = 服务.导出恢复材料({});
    L1恢复材料 材料 = 导出.材料.value_or(L1恢复材料{});
    记(导出.状态 == L1恢复材料导出状态::成功 && 导出.事实代次 == 2
        && !导出.当前隔离 && 导出.材料 && 导出.材料->当前快照.事实代次 == 2
        && 导出.材料->幂等账.size() == 2 && 导出.材料->审计记录.size() == 2);
    const auto 建立 = 服务.建立恢复候选({L1事实基座合同版本, 材料,
        当前快照.快照 ? 当前快照.快照->事实代次 : 0});
    const auto 候选期间导出 = 服务.导出恢复材料({});
    记(候选期间导出.状态 == L1恢复材料导出状态::成功
        && 候选期间导出.材料 && *候选期间导出.材料 == 材料);
    记(建立.状态 == L1恢复状态::候选已建立 && 建立.事实代次 == 2);
    const auto 撤销 = 服务.撤销恢复候选({});
    记(撤销.状态 == L1恢复状态::候选已撤销 && 撤销.事实代次 == 2
        && 服务.读取完整快照({}).快照->事实代次 == 2);
    const auto 再建 = 服务.建立恢复候选({L1事实基座合同版本, 材料, 2});
    const auto 发布 = 服务.确认恢复候选({});
    记(再建.状态 == L1恢复状态::候选已建立 && 再建.事实代次 == 2
        && 发布.状态 == L1恢复状态::恢复已发布 && 发布.事实代次 == 3);
    const auto 漂移材料 = 服务.读取完整快照({});
    const auto 漂移 = 服务.建立恢复候选({L1事实基座合同版本, 材料, 2});
    const auto 无候选 = 服务.撤销恢复候选({});
    记(漂移.状态 == L1恢复状态::事实代次漂移 && 漂移.事实代次 == 3
        && 无候选.状态 == L1恢复状态::无候选 && 无候选.事实代次 == 3);

    L1恢复材料 损坏材料 = 材料;
    损坏材料.当前快照.事实代次 = 3;
    if (!损坏材料.当前快照.当前节点.empty()) {
        损坏材料.当前快照.当前节点.front().种类 = 节点种类::属性类型;
        损坏材料.当前快照.当前节点.front().属性类型表示.reset();
    }
    const auto 损坏 = 服务.建立恢复候选({L1事实基座合同版本, 损坏材料, 3});
    记(损坏.状态 == L1恢复状态::材料不完整 && 损坏.事实代次 == 3
        && 服务.读取完整快照({}).状态 == L1读取状态::成功);

    const auto 版本前 = 服务.读取完整快照({});
    L1写集请求 错误版本写入;
    错误版本写入.合同版本 = 1;
    错误版本写入.期望事实代次 = 3;
    错误版本写入.幂等键 = {0x0690'2700'0000'0005ULL};
    错误版本写入.节点 = {{{30}, 节点种类::普通, std::nullopt}};
    记(服务.提交写集(错误版本写入).状态 == L1写入状态::入口拒绝
        && 快照相等(服务.读取完整快照({}).快照, 版本前.快照));
    const L1事实读取请求 错误节点{1, 节点};
    const L1事实读取请求 错误关系{1, 节点};
    const L1事实读取请求 错误值{1, 值};
    const L1属性读取请求 错误属性{1, 节点, 属性类型};
    const L1事实读取请求 错误历史{1, 节点};
    const L1审计读取请求 错误审计{1, 写集.幂等键};
    const L1完整快照读取请求 错误快照{1};
    记(服务.读取当前节点(错误节点).状态 == L1读取状态::入口拒绝);
    记(服务.读取当前关系(错误关系).状态 == L1读取状态::入口拒绝);
    记(服务.读取当前值(错误值).状态 == L1读取状态::入口拒绝);
    记(服务.读取当前属性(错误属性).状态 == L1读取状态::入口拒绝);
    记(服务.读取历史事实(错误历史).状态 == L1读取状态::入口拒绝);
    记(服务.读取审计(错误审计).状态 == L1读取状态::入口拒绝);
    记(服务.读取完整快照(错误快照).状态 == L1读取状态::入口拒绝);
    记(服务.建立恢复候选({1, 材料, 3}).状态 == L1恢复状态::入口拒绝);
    记(服务.确认恢复候选({1}).状态 == L1恢复状态::入口拒绝);
    记(服务.撤销恢复候选({1}).状态 == L1恢复状态::入口拒绝);

    L1事实基座服务 矩阵服务;
    L1写集请求 矩阵初始;
    矩阵初始.幂等键 = {0x0690'2700'0100'0001ULL};
    矩阵初始.期望事实代次 = 0;
    矩阵初始.节点 = {
        {{1}, 节点种类::属性类型, 值表示种类::I64},
        {{2}, 节点种类::普通, std::nullopt},
        {{3}, 节点种类::普通, std::nullopt},
        {{4}, 节点种类::普通, std::nullopt},
        {{5}, 节点种类::属性类型, 值表示种类::I64},
        {{6}, 节点种类::普通, std::nullopt}};
    矩阵初始.关系 = {
        {{7}, 写集本地键{2}, 写集本地键{4}, 写集本地键{3}, 1},
        {{8}, 写集本地键{2}, 写集本地键{6}, 写集本地键{3}, 2}};
    矩阵初始.值 = {
        {{9}, 写集本地键{2}, 写集本地键{1}, std::int64_t{1}, 写集本地键{2}},
        {{10}, 写集本地键{2}, 写集本地键{5}, std::int64_t{10}, 写集本地键{2}}};
    矩阵初始.属性槽变更 = {
        {写集本地键{2}, 写集本地键{1}, 写集本地键{9}},
        {写集本地键{2}, 写集本地键{5}, 写集本地键{10}}};
    const auto 矩阵首次 = 矩阵服务.提交写集(矩阵初始, 0x1501C006U);
    auto 矩阵编码 = [](const L1写入结果& 结果, 写集本地键 键) {
        for (const auto& [本地, 稳定] : 结果.新编码映射) if (本地 == 键) return 稳定;
        return 稳定编码{};
    };
    const auto 矩阵旧关系 = 矩阵编码(矩阵首次, {7});
    const auto 矩阵旧值 = 矩阵编码(矩阵首次, {9});
    L1写集请求 矩阵关系替换;
    矩阵关系替换.幂等键 = {0x0690'2700'0100'0002ULL};
    矩阵关系替换.期望事实代次 = 1;
    矩阵关系替换.关系 = {{ {11}, 稳定编码{矩阵编码(矩阵首次, {2}).值},
        稳定编码{矩阵编码(矩阵首次, {4}).值}, 稳定编码{矩阵编码(矩阵首次, {3}).值}, 3 }};
    矩阵关系替换.退出事实 = {矩阵旧关系};
    const auto 矩阵关系结果 = 矩阵服务.提交写集(矩阵关系替换, 0x1501C007U);
    const auto 矩阵新关系 = 矩阵编码(矩阵关系结果, {11});
    L1写集请求 矩阵值替换;
    矩阵值替换.幂等键 = {0x0690'2700'0100'0003ULL};
    矩阵值替换.期望事实代次 = 2;
    矩阵值替换.值 = {{ {12}, 稳定编码{矩阵编码(矩阵首次, {2}).值},
        稳定编码{矩阵编码(矩阵首次, {1}).值}, std::int64_t{2},
        稳定编码{矩阵编码(矩阵首次, {2}).值} }};
    矩阵值替换.属性槽变更 = {{ 稳定编码{矩阵编码(矩阵首次, {2}).值},
        稳定编码{矩阵编码(矩阵首次, {1}).值}, 写集本地键{12} }};
    矩阵值替换.退出事实 = {矩阵旧值};
    const auto 矩阵值结果 = 矩阵服务.提交写集(矩阵值替换, 0x1501C008U);
    const auto 矩阵新值 = 矩阵编码(矩阵值结果, {12});
    记(矩阵首次.状态 == L1写入状态::成功 && 矩阵首次.事实代次 == 1
        && 矩阵关系结果.状态 == L1写入状态::成功 && 矩阵关系结果.事实代次 == 2
        && 矩阵值结果.状态 == L1写入状态::成功 && 矩阵值结果.事实代次 == 3
        && 有效(矩阵旧关系) && 有效(矩阵新关系) && 有效(矩阵旧值) && 有效(矩阵新值)
        && 矩阵旧关系 != 矩阵新关系 && 矩阵旧值 != 矩阵新值);
    const auto 矩阵关系重复 = 矩阵服务.提交写集(矩阵关系替换, 0x1501C007U);
    L1写集请求 矩阵关系冲突 = 矩阵关系替换;
    矩阵关系冲突.关系.front().角色或顺序 = 4;
    const auto 关系冲突前 = 矩阵服务.读取完整快照({});
    const auto 矩阵关系冲突结果 = 矩阵服务.提交写集(矩阵关系冲突, 0x1501C007U);
    const auto 关系冲突后 = 矩阵服务.读取完整快照({});
    记(矩阵关系重复.状态 == L1写入状态::精确重复
        && 矩阵关系重复.新编码映射 == 矩阵关系结果.新编码映射
        && 矩阵关系冲突结果.状态 == L1写入状态::幂等冲突
        && 快照相等(关系冲突前.快照, 关系冲突后.快照));
    const auto 矩阵值重复 = 矩阵服务.提交写集(矩阵值替换, 0x1501C008U);
    L1写集请求 矩阵值冲突 = 矩阵值替换;
    std::get<std::int64_t>(矩阵值冲突.值.front().材料) = 3;
    const auto 值冲突前 = 矩阵服务.读取完整快照({});
    const auto 矩阵值冲突结果 = 矩阵服务.提交写集(矩阵值冲突, 0x1501C008U);
    const auto 值冲突后 = 矩阵服务.读取完整快照({});
    记(矩阵值重复.状态 == L1写入状态::精确重复
        && 矩阵值重复.新编码映射 == 矩阵值结果.新编码映射
        && 矩阵值冲突结果.状态 == L1写入状态::幂等冲突
        && 快照相等(值冲突前.快照, 值冲突后.快照));
    记(矩阵服务.读取当前属性({L1事实基座合同版本,
        矩阵编码(矩阵首次, {2}), 矩阵编码(矩阵首次, {1})}).状态 == L1读取状态::成功
        && 矩阵服务.读取历史事实({L1事实基座合同版本, 矩阵旧关系}).历史.has_value()
        && !矩阵服务.读取历史事实({L1事实基座合同版本, 矩阵旧关系}).历史->当前有效
        && 矩阵服务.读取历史事实({L1事实基座合同版本, 矩阵旧值}).历史.has_value()
        && !矩阵服务.读取历史事实({L1事实基座合同版本, 矩阵旧值}).历史->当前有效);

    const auto 矩阵导出 = 矩阵服务.导出恢复材料({});
    L1恢复材料 矩阵材料 = 矩阵导出.材料.value_or(L1恢复材料{});
    auto 检查材料缺陷 = [&](auto 修改) {
        auto 坏材料 = 矩阵材料;
        修改(坏材料);
        const auto 前 = 矩阵服务.读取完整快照({});
        const auto 结果 = 矩阵服务.建立恢复候选({L1事实基座合同版本, 坏材料, 3});
        const auto 后 = 矩阵服务.读取完整快照({});
        return 结果.状态 == L1恢复状态::材料不完整 && 结果.事实代次 == 3
            && 快照相等(前.快照, 后.快照);
    };
    记(矩阵导出.状态 == L1恢复材料导出状态::成功
        && 矩阵材料.当前快照.事实代次 == 3
        && 矩阵服务.建立恢复候选({L1事实基座合同版本, 矩阵材料, 3}).状态 == L1恢复状态::候选已建立);
    记(矩阵服务.撤销恢复候选({}).状态 == L1恢复状态::候选已撤销);
    记(检查材料缺陷([](auto& 材料) { 材料.历史关系.front().退出事实代次.reset(); })
        && 检查材料缺陷([](auto& 材料) { 材料.当前快照.永久占用编码.pop_back(); })
        && 检查材料缺陷([](auto& 材料) { 材料.当前快照.当前节点.at(1).当前属性.front().当前值 = 稳定编码{999999}; })
        && 检查材料缺陷([](auto& 材料) { 材料.当前快照.当前关系.front().源节点 = 稳定编码{999999}; })
        && 检查材料缺陷([](auto& 材料) { 材料.当前快照.当前值.front().材料 = std::vector<std::int64_t>{1, 2}; })
        && 检查材料缺陷([](auto& 材料) { std::reverse(材料.幂等账.front().首次规范化写集.节点.begin(), 材料.幂等账.front().首次规范化写集.节点.end()); })
        && 检查材料缺陷([](auto& 材料) { 材料.幂等账.front().首次新编码映射.front().second = 稳定编码{999999}; })
        && 检查材料缺陷([](auto& 材料) { 材料.审计记录.front().幂等键 = {999999}; })
        && 检查材料缺陷([](auto& 材料) { 材料.审计记录.front().事件序号 = 9; })
        && 检查材料缺陷([](auto& 材料) { 材料.审计记录.front().事件 = L1审计事件::精确重复; }));

    const auto SHA空 = L1确定性编码内部::哈希({});
    const auto SHAabc = L1确定性编码内部::哈希({'a','b','c'});
    const std::array<std::uint8_t, 32> SHA空期望 = {0xe3,0xb0,0xc4,0x42,0x98,0xfc,0x1c,0x14,
        0x9a,0xfb,0xf4,0xc8,0x99,0x6f,0xb9,0x24,0x27,0xae,0x41,0xe4,0x64,0x9b,0x93,0x4c,
        0xa4,0x95,0x99,0x1b,0x78,0x52,0xb8,0x55};
    const std::array<std::uint8_t, 32> SHAabc期望 = {0xba,0x78,0x16,0xbf,0x8f,0x01,0xcf,0xea,
        0x41,0x41,0x40,0xde,0x5d,0xae,0x22,0x23,0xb0,0x03,0x61,0xa3,0x96,0x17,0x7a,0x9c,
        0xb4,0x10,0xff,0x61,0xf2,0x00,0x15,0xad};
    记(std::equal(SHA空.字节.begin(), SHA空.字节.end(), SHA空期望.begin())
        && std::equal(SHAabc.字节.begin(), SHAabc.字节.end(), SHAabc期望.begin()));

    L1事实基座仓库 双摘要仓库;
    L1写集请求 双摘要写集;
    双摘要写集.期望事实代次 = 0;
    双摘要写集.幂等键 = {0x0690'2700'0200'0001ULL};
    双摘要写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    准备L1写集v2(双摘要写集, 0x15000F08U);
    L1执行证据材料 双摘要材料;
    双摘要材料.执行证据模式 = L1执行证据模式::空仓纯G0;
    双摘要材料.业务操作标签 = 0x15000F08U;
    双摘要材料.幂等键 = 双摘要写集.幂等键;
    完成L1执行证据(双摘要写集, 双摘要材料);
    const auto 未命中探测 = 双摘要仓库.探测幂等({L1事实基座合同版本,
        L1幂等摘要合同版本, 双摘要写集.幂等键, 双摘要写集.请求意图摘要});
    const auto 双摘要首次 = 双摘要仓库.提交(双摘要写集);
    const auto 同义探测 = 双摘要仓库.探测幂等({L1事实基座合同版本,
        L1幂等摘要合同版本, 双摘要写集.幂等键, 双摘要写集.请求意图摘要});
    记(未命中探测.状态 == L1幂等探测状态::未找到
        && 双摘要首次.状态 == L1写入状态::成功
        && 双摘要首次.发布后读回.状态 == L1通用发布后读回状态::成功
        && 双摘要首次.发布后读回.项目组.size() == 1
        && 同义探测.状态 == L1幂等探测状态::同义已发布
        && 同义探测.首次结果 && 完整(同义探测.首次结果->确定性结果摘要));
    auto 执行证据变化 = 双摘要写集;
    执行证据变化.执行证据摘要.字节[0] ^= 0xff;
    const auto 执行证据重试 = 双摘要仓库.提交(执行证据变化);
    auto 异义探测请求 = L1幂等探测请求{L1事实基座合同版本,
        L1幂等摘要合同版本, 双摘要写集.幂等键, 双摘要写集.请求意图摘要};
    异义探测请求.请求意图摘要.字节[0] ^= 0xff;
    const auto 异义探测 = 双摘要仓库.探测幂等(异义探测请求);
    记(执行证据重试.状态 == L1写入状态::精确重复
        && 执行证据重试.发布后读回 == 双摘要首次.发布后读回
        && 异义探测.状态 == L1幂等探测状态::异义冲突 && !异义探测.首次结果);
    auto 空摘要请求 = 双摘要写集;
    空摘要请求.幂等键 = {0x0690'2700'0200'0002ULL};
    空摘要请求.请求意图摘要 = {};
    auto 空计划请求 = 双摘要写集;
    空计划请求.幂等键 = {0x0690'2700'0200'0003ULL};
    空计划请求.发布后读回计划.项目组.clear();
    记(双摘要仓库.提交(空摘要请求).状态 == L1写入状态::入口拒绝
        && 双摘要仓库.提交(空计划请求).状态 == L1写入状态::入口拒绝);

#ifdef _DEBUG
    L1事实基座服务 导出损坏服务;
    导出损坏服务.自检_破坏当前状态用于恢复导出();
    记(导出损坏服务.导出恢复材料({}).状态 == L1恢复材料导出状态::内部不一致
        && !导出损坏服务.导出恢复材料({}).材料);
    L1事实基座服务 隔离矛盾服务;
    隔离矛盾服务.自检_制造隔离见证矛盾用于恢复导出();
    记(隔离矛盾服务.导出恢复材料({}).状态 == L1恢复材料导出状态::内部不一致
        && !隔离矛盾服务.导出恢复材料({}).材料);

    L1事实基座仓库 隔离仓库;
    L1写集请求 隔离写集;
    隔离写集.期望事实代次 = 0;
    隔离写集.幂等键 = {0x0690'2700'0300'0001ULL};
    隔离写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    准备L1写集v2(隔离写集, 0x15000F09U);
    L1执行证据材料 隔离材料;
    隔离材料.执行证据模式 = L1执行证据模式::空仓纯G0;
    隔离材料.业务操作标签 = 0x15000F09U;
    隔离材料.幂等键 = 隔离写集.幂等键;
    完成L1执行证据(隔离写集, 隔离材料);
    隔离仓库.自检_使下一次提交后权威读回不一致();
    const auto 隔离结果 = 隔离仓库.提交(隔离写集);
    const auto 隔离探测 = 隔离仓库.探测幂等({L1事实基座合同版本,
        L1幂等摘要合同版本, 隔离写集.幂等键, 隔离写集.请求意图摘要});
    const auto 隔离审计 = 隔离仓库.读取审计(隔离写集.幂等键);
    const auto 隔离导出 = 隔离仓库.导出恢复材料();
    记(隔离结果.状态 == L1写入状态::内部不一致 && 隔离结果.事实代次 == 1
        && 隔离结果.失败见证身份 && 隔离探测.状态 == L1幂等探测状态::已隔离
        && 隔离探测.首次结果 && 隔离探测.首次结果->发布后失败见证
        && 隔离审计.状态 == L1读取状态::成功 && 隔离审计.记录组.size() == 2
        && 隔离审计.记录组.back().事件 == L1审计事件::发布后读回失败隔离
        && 隔离导出.状态 == L1恢复材料导出状态::成功
        && 隔离导出.当前隔离 && 隔离导出.材料
        && 隔离导出.材料->当前隔离见证身份 == 隔离结果.失败见证身份
        && 隔离仓库.读取完整快照().状态 == L1读取状态::内部不一致
        && 隔离仓库.尝试读取完整快照().状态 == L1读取状态::内部不一致
        && 隔离仓库.尝试读取当前事实代次()
            == L1事实代次读取结果{L1读取状态::内部不一致, 0});
#else
    记(true);
#endif

#ifdef _DEBUG
    L1事实基座仓库 故障仓库;
    故障仓库.自检_破坏下一次建立前当前状态不变量();
    记(故障仓库.建立恢复候选({}, 0).状态 == L1恢复状态::内部不一致);
    记(故障仓库.读取完整快照().状态 == L1读取状态::内部不一致);

    L1事实基座仓库 候选故障仓库;
    候选故障仓库.自检_破坏下一次候选构造结果();
    记(候选故障仓库.建立恢复候选({}, 0).状态 == L1恢复状态::内部不一致);
    记(候选故障仓库.读取完整快照().状态 == L1读取状态::内部不一致);

    L1事实基座仓库 读回故障仓库;
    读回故障仓库.自检_使下一次发布后权威读回不一致();
    记(读回故障仓库.建立恢复候选({}, 0).状态 == L1恢复状态::候选已建立
        && 读回故障仓库.确认恢复候选().状态 == L1恢复状态::内部不一致);
#endif

    std::size_t 失败 = 0; for (const bool 通过 : 验收) if (!通过) ++失败;
    return {std::move(验收), 失败, 失败 == 0};
}

} // namespace 海中鱼巣
