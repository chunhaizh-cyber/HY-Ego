namespace {

using namespace 海中鱼巣;

// 诊断责任：无适用错误分支；纯值状态映射。
L1中性读取状态 映射中性读取状态(L1读取状态 状态) noexcept {
    switch (状态) {
    case L1读取状态::成功: return L1中性读取状态::成功;
    case L1读取状态::入口拒绝: return L1中性读取状态::入口拒绝;
    case L1读取状态::未找到: return L1中性读取状态::未找到;
    case L1读取状态::已退出: return L1中性读取状态::已退出;
    case L1读取状态::属性未设置: return L1中性读取状态::属性未设置;
    case L1读取状态::资源失败: return L1中性读取状态::资源失败;
    case L1读取状态::许可拒绝: return L1中性读取状态::许可拒绝;
    case L1读取状态::事实代次漂移:
    case L1读取状态::内部不一致: return L1中性读取状态::内部不一致;
    }
    return L1中性读取状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射。
std::optional<L1中性值表示种类> 转换中性值表示种类(
    const std::optional<值表示种类>& 值) noexcept {
    if (!值) return std::nullopt;
    return static_cast<L1中性值表示种类>(static_cast<std::uint8_t>(*值));
}

// 诊断责任：向上送出；分配异常由公开服务调用边界处理。
L1中性原始值材料 转换中性材料(const 原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1中性原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, 独立材料引用>)
            return L1中性独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：向上送出；分配异常由公开服务调用边界处理。
L1中性节点事实 转换中性节点(const 节点事实& 事实) {
    L1中性节点事实 结果{事实.编码, 事实.种类,
        转换中性值表示种类(事实.属性类型表示), 事实.创建事实代次,
        事实.退出事实代次, {}};
    结果.当前属性.reserve(事实.当前属性.size());
    for (const auto& 槽 : 事实.当前属性)
        结果.当前属性.push_back({槽.属性类型节点, 槽.当前值});
    return 结果;
}

// 诊断责任：无适用错误分支；纯值关系投影。
L1中性关系事实 转换中性关系(const 关系事实& 事实) noexcept {
    return {事实.编码, 事实.源节点, 事实.目标节点, 事实.关系类型节点,
        事实.角色或顺序, 事实.创建事实代次, 事实.退出事实代次};
}

// 诊断责任：向上送出；分配异常由公开服务调用边界处理。
L1中性值事实 转换中性值(const 值事实& 事实) {
    return {事实.编码, 事实.所属节点, 事实.属性类型节点,
        转换中性材料(事实.材料), 事实.来源节点,
        事实.创建事实代次, 事实.退出事实代次};
}

// 诊断责任：向上送出；分配异常由公开服务调用边界处理。
L1中性事实副本 转换中性事实(const L1事实副本& 事实) {
    return std::visit([](const auto& 值) -> L1中性事实副本 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, 节点事实>) return 转换中性节点(值);
        else if constexpr (std::is_same_v<类型, 关系事实>) return 转换中性关系(值);
        else return 转换中性值(值);
    }, 事实);
}

// 诊断责任：无适用错误分支；纯值生命周期代次投影。
std::uint64_t 中性事实适用代次(const L1事实副本& 事实) noexcept {
    return std::visit([](const auto& 值) {
        return 值.退出事实代次.value_or(值.创建事实代次);
    }, 事实);
}

struct L1事实基座实例状态 final {
    L1事实基座仓库 仓库;
    std::mutex 端口锁;
    std::unordered_set<std::uint64_t> 活动端口所有者;
};

} // namespace

export namespace 海中鱼巣 {

class L1所有者范围签发器;
class L1所有者范围写端口;
class L1事实基座运行包;

class L1事实基座服务 final {
public:
    L1事实基座服务() = delete;
    L1事实基座服务(const L1事实基座服务&) = delete;
    L1事实基座服务& operator=(const L1事实基座服务&) = delete;

    // 诊断责任：向上送出；仓库许可与锁外转换失败均保留中性结构化状态。
    L1中性一致当前读取结果 尝试读取中性一致当前投影(
        const L1中性一致当前读取请求& 请求) const {
        const auto 失败 = [&](L1中性一致当前读取状态 状态,
            std::uint64_t 读取代次 = 0) {
            L1中性一致当前读取结果 结果;
            结果.状态 = 状态;
            结果.期望事实代次 = 请求.期望事实代次;
            结果.读取事实代次 = 读取代次;
            return 结果;
        };
        try {
            const auto 读取 = 仓库_.尝试读取一致当前内部投影(请求);
            if (读取.状态 != L1中性一致当前读取状态::成功) {
                const bool 六组空 = 读取.节点.empty() && 读取.关系.empty()
                    && 读取.值.empty() && 读取.属性值.empty()
                    && 读取.源关系组.empty() && 读取.目标关系组.empty();
                const bool 代次正确 = 读取.状态
                    == L1中性一致当前读取状态::事实代次漂移
                    ? 读取.读取事实代次 != 0 : 读取.读取事实代次 == 0;
                if (!六组空 || !代次正确)
                    return 失败(L1中性一致当前读取状态::内部不一致);
                return 失败(读取.状态, 读取.读取事实代次);
            }
            if (读取.读取事实代次 == 0
                || 读取.读取事实代次 != 请求.期望事实代次
                || 读取.节点.size() != 请求.节点.size()
                || 读取.关系.size() != 请求.关系.size()
                || 读取.值.size() != 请求.值.size()
                || 读取.属性值.size() != 请求.属性值.size()
                || 读取.源关系组.size() != 请求.源关系组.size()
                || 读取.目标关系组.size() != 请求.目标关系组.size())
                return 失败(L1中性一致当前读取状态::内部不一致);

            L1中性一致当前读取结果 结果;
            结果.状态 = L1中性一致当前读取状态::成功;
            结果.期望事实代次 = 请求.期望事实代次;
            结果.读取事实代次 = 读取.读取事实代次;
            结果.节点.reserve(读取.节点.size());
            结果.关系.reserve(读取.关系.size());
            结果.值.reserve(读取.值.size());
            结果.属性值.reserve(读取.属性值.size());
            结果.源关系组.reserve(读取.源关系组.size());
            结果.目标关系组.reserve(读取.目标关系组.size());

            for (const auto& 项 : 读取.节点) {
                L1中性一致节点读取结果项 输出{项.查询编码, 项.状态,
                    std::nullopt};
                if (项.状态 == L1中性一致当前读取项目状态::成功) {
                    const auto* 事实 = 项.事实
                        ? std::get_if<节点事实>(&*项.事实) : nullptr;
                    if (!事实)
                        return 失败(L1中性一致当前读取状态::内部不一致);
                    输出.事实 = 转换中性节点(*事实);
                } else if (项.事实)
                    return 失败(L1中性一致当前读取状态::内部不一致);
                结果.节点.push_back(std::move(输出));
            }
            for (const auto& 项 : 读取.关系) {
                L1中性一致关系读取结果项 输出{项.查询编码, 项.状态,
                    std::nullopt};
                if (项.状态 == L1中性一致当前读取项目状态::成功) {
                    const auto* 事实 = 项.事实
                        ? std::get_if<关系事实>(&*项.事实) : nullptr;
                    if (!事实)
                        return 失败(L1中性一致当前读取状态::内部不一致);
                    输出.事实 = 转换中性关系(*事实);
                } else if (项.事实)
                    return 失败(L1中性一致当前读取状态::内部不一致);
                结果.关系.push_back(std::move(输出));
            }
            for (const auto& 项 : 读取.值) {
                L1中性一致值读取结果项 输出{项.查询编码, 项.状态,
                    std::nullopt};
                if (项.状态 == L1中性一致当前读取项目状态::成功) {
                    const auto* 事实 = 项.事实
                        ? std::get_if<值事实>(&*项.事实) : nullptr;
                    if (!事实)
                        return 失败(L1中性一致当前读取状态::内部不一致);
                    输出.事实 = 转换中性值(*事实);
                } else if (项.事实)
                    return 失败(L1中性一致当前读取状态::内部不一致);
                结果.值.push_back(std::move(输出));
            }
            for (const auto& 项 : 读取.属性值) {
                L1中性一致属性值读取结果项 输出{项.节点, 项.属性类型,
                    项.状态, std::nullopt};
                if (项.状态 == L1中性一致当前读取项目状态::成功) {
                    if (!项.投影)
                        return 失败(L1中性一致当前读取状态::内部不一致);
                    输出.投影 = L1中性一致属性值投影{
                        {项.投影->属性槽值.属性类型节点,
                            项.投影->属性槽值.当前值},
                        转换中性值(项.投影->当前值事实)};
                } else if (项.投影)
                    return 失败(L1中性一致当前读取状态::内部不一致);
                结果.属性值.push_back(std::move(输出));
            }
            for (const auto& 项 : 读取.源关系组) {
                L1中性一致源关系组读取结果项 输出{
                    项.源节点, 项.关系类型节点, {}};
                输出.成员.reserve(项.成员.size());
                for (const auto& 成员 : 项.成员)
                    输出.成员.push_back({转换中性关系(成员.关系),
                        转换中性节点(成员.对端节点)});
                结果.源关系组.push_back(std::move(输出));
            }
            for (const auto& 项 : 读取.目标关系组) {
                L1中性一致目标关系组读取结果项 输出{
                    项.目标节点, 项.关系类型节点, {}};
                输出.成员.reserve(项.成员.size());
                for (const auto& 成员 : 项.成员)
                    输出.成员.push_back({转换中性关系(成员.关系),
                        转换中性节点(成员.对端节点)});
                结果.目标关系组.push_back(std::move(输出));
            }
            return 结果;
        } catch (const std::bad_alloc&) {
            return 失败(L1中性一致当前读取状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L1中性一致当前读取状态::资源失败);
        } catch (...) {
            return 失败(L1中性一致当前读取状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；中性结构化状态完整保留提交结果。
    L1中性写入结果 提交中性写集(const L1中性写集请求& 请求) {
        if (请求.合同版本 != L1中性CRUD合同版本)
            return {L1中性写入状态::入口拒绝, L1中性CRUD合同版本,
                请求.幂等键, 0, false, L1中性重试边界::修正请求后可重试, {}};
        return 仓库_.提交中性写集(请求);
    }

    // 诊断责任：向上送出；ARCH-L2 组合 provider 的唯一双参与者入口。
    L1跨所有者原子事务结果 提交跨所有者原子事务(
        const L1跨所有者原子事务请求& 请求) {
        return 仓库_.提交跨所有者原子事务(请求);
    }

    // 诊断责任：向上送出；类型矛盾映射为内部不一致。
    L1中性节点读取结果 读取中性当前节点(const L1中性事实读取请求& 请求) const {
        L1中性节点读取结果 结果{L1中性读取状态::入口拒绝,
            L1中性CRUD合同版本, 请求.编码, 0, std::nullopt};
        if (请求.合同版本 != L1中性CRUD合同版本) return 结果;
        try {
            const auto 读取 = 仓库_.读取当前节点(请求.编码);
            结果.状态 = 映射中性读取状态(读取.状态);
            结果.读取事实代次 = 读取.读取事实代次;
            if (读取.状态 == L1读取状态::成功 && 读取.事实) {
                if (const auto* 事实 = std::get_if<节点事实>(&*读取.事实))
                    结果.事实 = 转换中性节点(*事实);
                else 结果.状态 = L1中性读取状态::内部不一致;
            } else if (读取.状态 == L1读取状态::成功)
                结果.状态 = L1中性读取状态::内部不一致;
            return 结果;
        } catch (const std::bad_alloc&) {
            结果.状态 = L1中性读取状态::资源失败; return 结果;
        } catch (...) {
            结果.状态 = L1中性读取状态::内部不一致; return 结果;
        }
    }

    // 诊断责任：向上送出；类型矛盾映射为内部不一致。
    L1中性关系读取结果 读取中性当前关系(const L1中性事实读取请求& 请求) const {
        L1中性关系读取结果 结果{L1中性读取状态::入口拒绝,
            L1中性CRUD合同版本, 请求.编码, 0, std::nullopt};
        if (请求.合同版本 != L1中性CRUD合同版本) return 结果;
        try {
            const auto 读取 = 仓库_.读取当前关系(请求.编码);
            结果.状态 = 映射中性读取状态(读取.状态);
            结果.读取事实代次 = 读取.读取事实代次;
            if (读取.状态 == L1读取状态::成功 && 读取.事实) {
                if (const auto* 事实 = std::get_if<关系事实>(&*读取.事实))
                    结果.事实 = 转换中性关系(*事实);
                else 结果.状态 = L1中性读取状态::内部不一致;
            } else if (读取.状态 == L1读取状态::成功)
                结果.状态 = L1中性读取状态::内部不一致;
            return 结果;
        } catch (const std::bad_alloc&) {
            结果.状态 = L1中性读取状态::资源失败; return 结果;
        } catch (...) {
            结果.状态 = L1中性读取状态::内部不一致; return 结果;
        }
    }

    // 诊断责任：向上送出；条件查询的结构化状态和权威关系副本原样返回。
    L1中性源关系读取结果 读取中性当前源关系组(
        const L1中性源关系读取请求& 请求) const {
        L1中性源关系读取结果 结果{L1中性读取状态::入口拒绝,
            L1中性CRUD合同版本, 请求.源节点, 请求.关系类型节点, 0, {}};
        if (请求.合同版本 != L1中性CRUD合同版本
            || !有效(请求.源节点) || !有效(请求.关系类型节点)) return 结果;
        try {
            return 仓库_.读取中性当前源关系组(请求);
        } catch (const std::bad_alloc&) {
            结果.状态 = L1中性读取状态::资源失败;
            return 结果;
        } catch (...) {
            结果.状态 = L1中性读取状态::内部不一致;
            return 结果;
        }
    }

    // 诊断责任：向上送出；条件查询的结构化状态和权威关系副本原样返回。
    L1中性目标关系读取结果 读取中性当前目标关系组(
        const L1中性目标关系读取请求& 请求) const {
        L1中性目标关系读取结果 结果{L1中性读取状态::入口拒绝,
            L1中性CRUD合同版本, 请求.目标节点, 请求.关系类型节点, 0, {}};
        if (请求.合同版本 != L1中性CRUD合同版本
            || !有效(请求.目标节点) || !有效(请求.关系类型节点)) return 结果;
        try {
            return 仓库_.读取中性当前目标关系组(请求);
        } catch (const std::bad_alloc&) {
            结果.状态 = L1中性读取状态::资源失败;
            return 结果;
        } catch (...) {
            结果.状态 = L1中性读取状态::内部不一致;
            return 结果;
        }
    }

    // 诊断责任：向上送出；条件查询异常保留为中性历史关系组状态。
    L1中性历史关系组读取结果 读取中性历史关系组(
        const L1中性历史关系组读取请求& 请求) const {
        const auto 失败 = [&](L1中性历史关系组读取状态 状态) {
            return L1中性历史关系组读取结果{状态, L1中性CRUD合同版本,
                请求.方向, 请求.端点节点, 请求.关系类型节点,
                请求.历史截止事实代次, 0, {}};
        };
        const bool 方向有效 = 请求.方向 == L1中性关系端点方向::源
            || 请求.方向 == L1中性关系端点方向::目标;
        if (请求.合同版本 != L1中性CRUD合同版本 || !方向有效
            || !有效(请求.端点节点) || !有效(请求.关系类型节点)
            || 请求.历史截止事实代次 == 0)
            return 失败(L1中性历史关系组读取状态::入口拒绝);
        try {
            return 仓库_.读取中性历史关系组(请求);
        } catch (const std::bad_alloc&) {
            return 失败(L1中性历史关系组读取状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L1中性历史关系组读取状态::资源失败);
        } catch (...) {
            return 失败(L1中性历史关系组读取状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；历史属性值组异常保留为中性结构化状态。
    L1中性历史属性值组读取结果 读取中性历史属性值组(
        const L1中性历史属性值组读取请求& 请求) const {
        const auto 失败 = [&](L1中性历史属性值组读取状态 状态) {
            return L1中性历史属性值组读取结果{状态, L1中性CRUD合同版本,
                请求.所属节点, 请求.历史截止事实代次, 0, {}};
        };
        if (请求.合同版本 != L1中性CRUD合同版本 || !有效(请求.所属节点)
            || 请求.历史截止事实代次 == 0)
            return 失败(L1中性历史属性值组读取状态::入口拒绝);
        try {
            return 仓库_.读取中性历史属性值组(请求);
        } catch (const std::bad_alloc&) {
            return 失败(L1中性历史属性值组读取状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L1中性历史属性值组读取状态::资源失败);
        } catch (...) {
            return 失败(L1中性历史属性值组读取状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；类型矛盾映射为内部不一致。
    L1中性值读取结果 读取中性当前值(const L1中性事实读取请求& 请求) const {
        L1中性值读取结果 结果{L1中性读取状态::入口拒绝,
            L1中性CRUD合同版本, 请求.编码, 0, std::nullopt};
        if (请求.合同版本 != L1中性CRUD合同版本) return 结果;
        try {
            const auto 读取 = 仓库_.读取当前值(请求.编码);
            结果.状态 = 映射中性读取状态(读取.状态);
            结果.读取事实代次 = 读取.读取事实代次;
            if (读取.状态 == L1读取状态::成功 && 读取.事实) {
                if (const auto* 事实 = std::get_if<值事实>(&*读取.事实))
                    结果.事实 = 转换中性值(*事实);
                else 结果.状态 = L1中性读取状态::内部不一致;
            } else if (读取.状态 == L1读取状态::成功)
                结果.状态 = L1中性读取状态::内部不一致;
            return 结果;
        } catch (const std::bad_alloc&) {
            结果.状态 = L1中性读取状态::资源失败; return 结果;
        } catch (...) {
            结果.状态 = L1中性读取状态::内部不一致; return 结果;
        }
    }

    // 诊断责任：向上送出；属性不存在保留为具名中性状态。
    L1中性属性读取结果 读取中性当前属性(const L1中性属性读取请求& 请求) const {
        L1中性属性读取结果 结果{L1中性读取状态::入口拒绝,
            L1中性CRUD合同版本, 请求.节点, 请求.属性类型, 0, std::nullopt};
        if (请求.合同版本 != L1中性CRUD合同版本) return 结果;
        try {
            const auto 读取 = 仓库_.读取当前属性(请求.节点, 请求.属性类型);
            结果.状态 = 映射中性读取状态(读取.状态);
            结果.读取事实代次 = 读取.读取事实代次;
            if (读取.状态 == L1读取状态::成功 && 读取.属性)
                结果.当前值 = 读取.属性->当前值;
            else if (读取.状态 == L1读取状态::成功)
                结果.状态 = L1中性读取状态::内部不一致;
            return 结果;
        } catch (...) {
            结果.状态 = L1中性读取状态::内部不一致; return 结果;
        }
    }

    // 诊断责任：向上送出；历史入口只返回一条完整中性事实。
    L1中性历史读取结果 读取中性历史事实(const L1中性事实读取请求& 请求) const {
        L1中性历史读取结果 结果{L1中性读取状态::入口拒绝,
            L1中性CRUD合同版本, 请求.编码, 0, std::nullopt};
        if (请求.合同版本 != L1中性CRUD合同版本) return 结果;
        try {
            const auto 读取 = 仓库_.读取历史事实(请求.编码);
            结果.状态 = 映射中性读取状态(读取.状态);
            if (读取.状态 == L1读取状态::成功 && 读取.历史) {
                结果.读取事实代次 = 中性事实适用代次(读取.历史->事实);
                结果.事实 = 转换中性事实(读取.历史->事实);
            } else if (读取.状态 == L1读取状态::成功)
                结果.状态 = L1中性读取状态::内部不一致;
            return 结果;
        } catch (const std::bad_alloc&) {
            结果.状态 = L1中性读取状态::资源失败; return 结果;
        } catch (...) {
            结果.状态 = L1中性读取状态::内部不一致; return 结果;
        }
    }

    // 诊断责任：向上送出；竞争和隔离均保留为中性结构化状态。
    L1中性事实代次读取结果 读取中性当前事实代次(
        const L1中性事实代次读取请求& 请求) const {
        if (请求.合同版本 != L1中性CRUD合同版本)
            return {L1中性读取状态::入口拒绝, L1中性CRUD合同版本, 0};
        const auto 读取 = 仓库_.尝试读取当前事实代次();
        return {映射中性读取状态(读取.状态), L1中性CRUD合同版本,
            读取.事实截止代次};
    }

    L1所有者范围当前读取结果 读取所有者范围当前节点(
        const L1所有者范围事实读取请求& 请求) const {
        return 仓库_.读取所有者范围当前节点(请求);
    }

    L1所有者范围当前读取结果 读取所有者范围当前关系(
        const L1所有者范围事实读取请求& 请求) const {
        return 仓库_.读取所有者范围当前关系(请求);
    }

    L1所有者范围当前读取结果 读取所有者范围当前值(
        const L1所有者范围事实读取请求& 请求) const {
        return 仓库_.读取所有者范围当前值(请求);
    }

    L1所有者范围来源当前值组读取结果
    按来源读取所有者范围全部当前值(
        const L1所有者范围来源当前值组读取请求& 请求) const {
        return 仓库_.按来源读取所有者范围全部当前值(请求);
    }

    L1所有者范围属性类型当前值组读取结果
    按属性类型读取所有者范围全部当前值(
        const L1所有者范围属性类型当前值组读取请求& 请求) const {
        return 仓库_.按属性类型读取所有者范围全部当前值(请求);
    }

    L1所有者范围源关系组读取结果 读取所有者范围当前源关系组(
        const L1所有者范围源关系组读取请求& 请求) const {
        return 仓库_.读取所有者范围当前源关系组(请求);
    }

    L1所有者范围目标关系组读取结果 读取所有者范围当前目标关系组(
        const L1所有者范围目标关系组读取请求& 请求) const {
        return 仓库_.读取所有者范围当前目标关系组(请求);
    }

    L1所有者范围历史关系组读取结果 读取所有者范围历史关系组(
        const L1所有者范围历史关系组读取请求& 请求) const {
        return 仓库_.读取所有者范围历史关系组(请求);
    }

    L1所有者范围历史属性值组读取结果 读取所有者范围历史属性值组(
        const L1所有者范围历史属性值组读取请求& 请求) const {
        return 仓库_.读取所有者范围历史属性值组(请求);
    }

    L1所有者范围历史读取结果 读取所有者范围历史事实(
        const L1所有者范围事实读取请求& 请求) const {
        return 仓库_.读取所有者范围历史事实(请求);
    }

    L1所有者范围一致当前读取结果 尝试读取所有者范围一致当前投影(
        const L1所有者范围一致当前读取请求& 请求) const {
        return 仓库_.尝试读取所有者范围一致当前投影(请求);
    }

    L1所有者范围一致关系类型闭包读取结果
    尝试读取所有者范围一致关系类型闭包投影(
        const L1所有者范围一致关系类型闭包读取请求& 请求) const {
        return 仓库_.尝试读取所有者范围一致关系类型闭包投影(请求);
    }

    L1结构所有者当前读取结果 读取当前结构所有者(
        const L1结构所有者读取请求& 请求) const {
        return 仓库_.读取当前结构所有者(请求);
    }

    L1结构所有者历史读取结果 读取历史结构所有者(
        const L1结构所有者读取请求& 请求) const {
        return 仓库_.读取历史结构所有者(请求);
    }

private:
    explicit L1事实基座服务(L1事实基座仓库& 仓库) noexcept : 仓库_(仓库) {}

    friend class L1事实基座运行包;
    friend class L1所有者范围写端口;
    L1事实基座仓库& 仓库_;
};

class L1所有者范围写端口 final {
public:
    L1所有者范围写端口() = delete;
    L1所有者范围写端口(const L1所有者范围写端口&) = delete;
    L1所有者范围写端口& operator=(const L1所有者范围写端口&) = delete;

    L1所有者范围写端口(L1所有者范围写端口&& 来源) noexcept
        : 状态_(std::move(来源.状态_)), 所有者_(来源.所有者_), 持有租约_(来源.持有租约_) {
        来源.所有者_ = {};
        来源.持有租约_ = false;
    }

    L1所有者范围写端口& operator=(L1所有者范围写端口&& 来源) noexcept {
        if (this == &来源) return *this;
        释放租约();
        状态_ = std::move(来源.状态_);
        所有者_ = 来源.所有者_;
        持有租约_ = 来源.持有租约_;
        来源.所有者_ = {};
        来源.持有租约_ = false;
        return *this;
    }

    ~L1所有者范围写端口() { 释放租约(); }

    L1结构所有者身份 所有者身份() const noexcept { return 所有者_; }

    bool 有效() const noexcept {
        const auto 状态 = 状态_.lock();
        if (!状态 || !持有租约_ || !海中鱼巣::有效(所有者_)) return false;
        try {
            std::lock_guard<std::mutex> 锁(状态->端口锁);
            return 状态->活动端口所有者.contains(所有者_.编码.值);
        } catch (...) {
            return false;
        }
    }

    bool 绑定于(const L1事实基座服务& 服务) const noexcept {
        const auto 状态 = 状态_.lock();
        return 状态 && 有效() && &状态->仓库 == &服务.仓库_;
    }

    L1所有者范围写入结果 提交所有者范围中性写集(
        const L1所有者范围写集请求& 请求) {
        const auto 状态 = 状态_.lock();
        if (!状态 || !有效())
            return {L1所有者范围写入状态::许可拒绝,
                L1所有者范围CRUD合同版本, 所有者_, 请求.写入幂等身份,
                0, false, L1所有者范围重试边界::修正请求后可重试, {}};
        return 状态->仓库.提交所有者范围中性写集(所有者_, 请求);
    }

    L1跨所有者原子事务结果 提交跨所有者原子事务(
        const L1跨所有者原子事务请求& 请求,
        const L1所有者范围写端口& 另一参与者) {
        const auto 状态 = 状态_.lock();
        const auto 另一状态 = 另一参与者.状态_.lock();
        if (!状态 || !另一状态 || 状态.get() != 另一状态.get()
            || !有效() || !另一参与者.有效())
            return {L1跨所有者原子事务状态::许可拒绝,
                L1跨所有者原子事务合同版本, 0, false,
                L1所有者范围重试边界::修正请求后可重试, {}, {}};
        return 状态->仓库.提交跨所有者原子事务(请求);
    }

    // 诊断责任：向上送出；失效 capability 映射许可拒绝，其它仓库状态透明返回。
    L1所有者范围首次写入读取结果 读取首次写入材料(
        const L1所有者范围首次写入读取请求& 请求) const {
        L1所有者范围首次写入读取结果 结果;
        结果.所有者 = 所有者_;
        结果.写入幂等身份 = 请求.写入幂等身份;
        if (请求.合同版本 != L1所有者范围首次写入读取合同版本
            || !海中鱼巣::有效(请求.写入幂等身份))
            return 结果;

        const auto 状态 = 状态_.lock();
        if (!状态 || !持有租约_ || !海中鱼巣::有效(所有者_)) {
            结果.状态 = L1所有者范围读取状态::许可拒绝;
            return 结果;
        }
        try {
            {
                std::lock_guard<std::mutex> 锁(状态->端口锁);
                if (!状态->活动端口所有者.contains(所有者_.编码.值)) {
                    结果.状态 = L1所有者范围读取状态::许可拒绝;
                    return 结果;
                }
            }
            return 状态->仓库.读取所有者范围首次写入材料(所有者_, 请求);
        } catch (...) {
            结果.状态 = L1所有者范围读取状态::内部不一致;
            return 结果;
        }
    }

private:
    L1所有者范围写端口(std::weak_ptr<L1事实基座实例状态> 状态,
        L1结构所有者身份 所有者) noexcept
        : 状态_(std::move(状态)), 所有者_(所有者), 持有租约_(true) {}

    void 释放租约() noexcept {
        if (!持有租约_) return;
        if (const auto 状态 = 状态_.lock()) {
            try {
                std::lock_guard<std::mutex> 锁(状态->端口锁);
                状态->活动端口所有者.erase(所有者_.编码.值);
            } catch (...) {}
        }
        持有租约_ = false;
        所有者_ = {};
        状态_.reset();
    }

    friend class L1所有者范围签发器;
    std::weak_ptr<L1事实基座实例状态> 状态_;
    L1结构所有者身份 所有者_;
    bool 持有租约_ = false;
};

struct L1所有者范围交付 final {
    L1所有者范围建立结果 建立结果;
    std::optional<L1所有者范围写端口> 写入端口;
};

class L1所有者范围签发器 final {
public:
    L1所有者范围签发器() = delete;
    L1所有者范围签发器(const L1所有者范围签发器&) = delete;
    L1所有者范围签发器& operator=(const L1所有者范围签发器&) = delete;

    L1所有者范围交付 建立所有者范围(
        const L1所有者范围建立请求& 请求) {
        L1所有者范围交付 交付;
        const auto 状态 = 状态_.lock();
        if (!状态) {
            交付.建立结果 = {L1所有者范围管理状态::许可拒绝,
                L1所有者范围CRUD合同版本, 请求.建立幂等身份,
                std::nullopt, 0, false,
                L1所有者范围重试边界::修正请求后可重试};
            return 交付;
        }
        交付.建立结果 = 状态->仓库.建立所有者范围(请求);
        const bool 可交付 = 交付.建立结果.状态 == L1所有者范围管理状态::成功
            || 交付.建立结果.状态 == L1所有者范围管理状态::精确重复;
        if (!可交付 || !交付.建立结果.所有者事实
            || 交付.建立结果.所有者事实->退出事实代次)
            return 交付;
        const auto 所有者 = 交付.建立结果.所有者事实->所有者;
        const auto 当前 = 状态->仓库.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || !当前.所有者事实
            || 当前.所有者事实->所有者 != 所有者
            || 当前.所有者事实->退出事实代次)
            return 交付;
        try {
            std::lock_guard<std::mutex> 锁(状态->端口锁);
            if (!状态->活动端口所有者.insert(所有者.编码.值).second)
                return 交付;
            交付.写入端口 = L1所有者范围写端口{状态, 所有者};
            return 交付;
        } catch (...) {
            std::lock_guard<std::mutex> 锁(状态->端口锁);
            状态->活动端口所有者.erase(所有者.编码.值);
            return 交付;
        }
    }

    L1所有者范围退出结果 退出所有者范围(
        const L1所有者范围退出请求& 请求) {
        const auto 状态 = 状态_.lock();
        if (!状态)
            return {L1所有者范围管理状态::许可拒绝,
                L1所有者范围CRUD合同版本, 请求.建立幂等身份,
                std::nullopt, 0, false,
                L1所有者范围重试边界::修正请求后可重试};
        {
            std::lock_guard<std::mutex> 锁(状态->端口锁);
            if (状态->活动端口所有者.contains(请求.所有者.编码.值))
                return {L1所有者范围管理状态::引用冲突,
                    L1所有者范围CRUD合同版本, 请求.建立幂等身份,
                    std::nullopt, 0, false,
                    L1所有者范围重试边界::修正请求后可重试};
        }
        return 状态->仓库.退出所有者范围(请求);
    }

private:
    explicit L1所有者范围签发器(
        std::weak_ptr<L1事实基座实例状态> 状态) noexcept
        : 状态_(std::move(状态)) {}

    friend class L1事实基座运行包;
    std::weak_ptr<L1事实基座实例状态> 状态_;
};

class L1事实基座运行包 final {
public:
    L1事实基座运行包() = delete;
    L1事实基座运行包(const L1事实基座运行包&) = delete;
    L1事实基座运行包& operator=(const L1事实基座运行包&) = delete;
    L1事实基座运行包(L1事实基座运行包&&) noexcept = default;
    L1事实基座运行包& operator=(L1事实基座运行包&&) noexcept = default;

    L1事实基座服务& 读取服务() noexcept { return *服务_; }
    const L1事实基座服务& 读取服务() const noexcept { return *服务_; }
    L1所有者范围签发器& 所有者范围签发器() noexcept { return *签发器_; }

private:
    explicit L1事实基座运行包(std::shared_ptr<L1事实基座实例状态> 状态)
        : 状态_(std::move(状态)),
          服务_(new L1事实基座服务(状态_->仓库)),
          签发器_(new L1所有者范围签发器(状态_)) {}

    friend L1事实基座运行包 建立L1事实基座运行包();
    std::shared_ptr<L1事实基座实例状态> 状态_;
    std::unique_ptr<L1事实基座服务> 服务_;
    std::unique_ptr<L1所有者范围签发器> 签发器_;
};

L1事实基座运行包 建立L1事实基座运行包() {
    return L1事实基座运行包{std::make_shared<L1事实基座实例状态>()};
}

} // namespace 海中鱼巣
