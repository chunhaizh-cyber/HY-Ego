module;

#include <algorithm>
#include <atomic>
#include <cstddef>
#include <cstdint>
#include <optional>
#include <thread>
#include <variant>
#include <vector>

export module 海中鱼巣.核心.自检.L1可重建索引;

import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.核心.索引.L1事实基座;

export namespace 海中鱼巣 {

struct L1可重建索引自检报告 final {
    std::vector<bool> 验收;
    std::size_t 失败数量 = 0;
    bool 总通过 = false;
};

L1可重建索引自检报告 运行L1可重建索引自检() {
    L1事实基座服务 L1;
    L1事实可重建索引 索引(L1);
    std::vector<bool> 验收;
    auto 记 = [&](bool 通过) { 验收.push_back(通过); };
    auto 查询 = [&](L1结构索引键 键) {
        return 索引.查询并回读当前事实({L1可重建索引合同版本,
            L1可重建索引规则版本, std::move(键)});
    };
    auto 找编码 = [](const L1写入结果& 结果, 写集本地键 键) {
        for (const auto& [本地, 编码] : 结果.新编码映射) if (本地 == 键) return 编码;
        return 稳定编码{};
    };
    auto 快照相同 = [](const std::optional<L1完整快照>& 左,
                       const std::optional<L1完整快照>& 右) {
        if (左.has_value() != 右.has_value()) return false;
        if (!左) return true;
        if (左->事实代次 != 右->事实代次 || 左->当前节点.size() != 右->当前节点.size()
            || 左->当前关系.size() != 右->当前关系.size() || 左->当前值.size() != 右->当前值.size()
            || 左->永久占用编码 != 右->永久占用编码) return false;
        auto 编码组 = [](const auto& 组) {
            std::vector<std::uint64_t> 结果;
            for (const auto& 值 : 组) 结果.push_back(值.编码.值);
            return 结果;
        };
        return 编码组(左->当前节点) == 编码组(右->当前节点)
            && 编码组(左->当前关系) == 编码组(右->当前关系)
            && 编码组(左->当前值) == 编码组(右->当前值);
    };

    记(查询(L1节点种类索引键{节点种类::普通}).状态 == L1索引读取状态::索引不可用);
    记(查询(L1关系源索引键{{1}, {2}}).状态 == L1索引读取状态::索引不可用);
    记(查询(L1关系目标索引键{{1}, {2}}).状态 == L1索引读取状态::索引不可用);
    记(查询(L1当前属性值索引键{{1}, {2}}).状态 == L1索引读取状态::索引不可用);

    const auto 空快照结果 = L1.读取完整快照({});
    const auto 空重建 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 0, *空快照结果.快照});
    记(空重建.状态 == L1索引维护状态::重建已发布
        && 查询(L1节点种类索引键{节点种类::普通}).状态 == L1索引读取状态::确定未命中);

    L1写集请求 写集;
    写集.幂等键 = {0x0690'3300'0000'0001ULL};
    写集.期望事实代次 = 0;
    写集.节点 = {
        {{1}, 节点种类::属性类型, 值表示种类::I64},
        {{2}, 节点种类::属性类型, 值表示种类::I64},
        {{3}, 节点种类::普通, std::nullopt},
        {{4}, 节点种类::普通, std::nullopt},
        {{5}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{6}, 写集本地键{3}, 写集本地键{4}, 写集本地键{5}, 1},
        {{7}, 写集本地键{3}, 写集本地键{5}, 写集本地键{5}, 2}};
    写集.值 = {
        {{8}, 写集本地键{3}, 写集本地键{1}, std::int64_t{11}, 写集本地键{3}},
        {{9}, 写集本地键{3}, 写集本地键{2}, std::int64_t{22}, 写集本地键{3}}};
    写集.属性槽变更 = {
        {写集本地键{3}, 写集本地键{1}, 写集本地键{8}},
        {写集本地键{3}, 写集本地键{2}, 写集本地键{9}}};
    const auto 写入 = L1.提交写集(写集, 0x15001001U);
    const auto 宿主 = 找编码(写入, {3});
    const auto 目标 = 找编码(写入, {4});
    const auto 关系类型 = 找编码(写入, {5});
    const auto 属性类型一 = 找编码(写入, {1});
    const auto 快照一 = L1.读取完整快照({});
    const auto 重建一 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 1, *快照一.快照});
    记(写入.状态 == L1写入状态::成功 && 写入.事实代次 == 1
        && 重建一.状态 == L1索引维护状态::重建已发布);

    const auto 节点命中 = 查询(L1节点种类索引键{节点种类::普通});
    const auto 源命中 = 查询(L1关系源索引键{宿主, 关系类型});
    const auto 目标命中 = 查询(L1关系目标索引键{目标, 关系类型});
    const auto 值命中 = 查询(L1当前属性值索引键{宿主, 属性类型一});
    auto 同代次且有序 = [](const L1索引读取结果& 结果, std::uint64_t 代次) {
        if (结果.状态 != L1索引读取状态::命中 || 结果.来源事实代次 != 代次) return false;
        std::uint64_t 前编码 = 0;
        for (const auto& 事实 : 结果.当前事实) {
            const auto 编码 = std::visit([](const auto& 值) { return 值.编码.值; }, 事实);
            const auto 创建代次 = std::visit([](const auto& 值) { return 值.创建事实代次; }, 事实);
            if (编码 <= 前编码 || 创建代次 > 代次) return false;
            前编码 = 编码;
        }
        return true;
    };
    记(同代次且有序(节点命中, 1) && 节点命中.当前事实.size() == 3);
    记(同代次且有序(源命中, 1) && 源命中.当前事实.size() == 2);
    记(同代次且有序(目标命中, 1) && 目标命中.当前事实.size() == 1);
    记(同代次且有序(值命中, 1) && 值命中.当前事实.size() == 1);
    记(查询(L1关系源索引键{{0xffff}, 关系类型}).状态 == L1索引读取状态::确定未命中);
    记(查询(L1关系源索引键{{}, 关系类型}).状态 == L1索引读取状态::入口拒绝);

    const auto 重复 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 1, *快照一.快照});
    记(重复.状态 == L1索引维护状态::精确重复
        && 重复.索引视图序号 == 重建一.索引视图序号);
    const auto 清空前快照 = L1.读取完整快照({});
    const auto 清空 = 索引.清空({});
    const auto 再清空 = 索引.清空({});
    记(清空.状态 == L1索引维护状态::已清空
        && 再清空.状态 == L1索引维护状态::精确重复
        && 查询(L1节点种类索引键{节点种类::普通}).状态 == L1索引读取状态::索引不可用
        && 快照相同(L1.读取完整快照({}).快照, 清空前快照.快照));
    const auto 清空后重建 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 1, *快照一.快照});
    const auto 错失效 = 索引.失效({L1可重建索引合同版本,
        L1可重建索引规则版本, 0});
    const auto 对失效 = 索引.失效({L1可重建索引合同版本,
        L1可重建索引规则版本, 1});
    记(清空后重建.状态 == L1索引维护状态::重建已发布
        && 错失效.状态 == L1索引维护状态::索引视图漂移
        && 对失效.状态 == L1索引维护状态::已失效);

    (void)索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 1, *快照一.快照});
    L1写集请求 新代次写集;
    新代次写集.幂等键 = {0x0690'3300'0000'0002ULL};
    新代次写集.期望事实代次 = 1;
    新代次写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    const auto 新代次 = L1.提交写集(新代次写集, 0x15001002U);
    const auto 旧视图读取 = 查询(L1节点种类索引键{节点种类::普通});
    记(新代次.状态 == L1写入状态::成功 && 新代次.事实代次 == 2
        && 旧视图读取.状态 == L1索引读取状态::索引不可用
        && 查询(L1节点种类索引键{节点种类::普通}).状态 == L1索引读取状态::索引不可用);

    const auto 快照二 = L1.读取完整快照({});
    const auto 重建二 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 2, *快照二.快照});
    auto 漂移快照 = *快照二.快照;
    漂移快照.当前节点.pop_back();
    记(重建二.状态 == L1索引维护状态::重建已发布
        && 索引.从指定快照确定重建({2, L1可重建索引规则版本, 2, *快照二.快照}).状态 == L1索引维护状态::入口拒绝
        && 索引.从指定快照确定重建({L1可重建索引合同版本, 2, 2, *快照二.快照}).状态 == L1索引维护状态::入口拒绝
        && 索引.从指定快照确定重建({L1可重建索引合同版本, L1可重建索引规则版本, 1, *快照二.快照}).状态 == L1索引维护状态::入口拒绝
        && 索引.从指定快照确定重建({L1可重建索引合同版本, L1可重建索引规则版本, 2, 漂移快照}).状态 == L1索引维护状态::事实代次漂移
        && 查询(L1节点种类索引键{节点种类::普通}).状态 == L1索引读取状态::命中);

#ifdef _DEBUG
    索引.自检_损坏下一次重建候选();
    const auto 损坏 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 2, *快照二.快照});
    记(损坏.状态 == L1索引维护状态::内部不一致
        && 查询(L1节点种类索引键{节点种类::普通}).状态 == L1索引读取状态::命中);

#else
    记(true);
#endif

    (void)索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 2, *快照二.快照});
    std::atomic_bool 并发开始 = false;
    std::atomic_bool 并发通过 = true;
    std::thread 读线程([&] {
        while (!并发开始.load()) std::this_thread::yield();
        for (int i = 0; i < 1024; ++i) {
            const auto 结果 = 查询(L1节点种类索引键{节点种类::普通});
            if (结果.状态 != L1索引读取状态::命中
                && 结果.状态 != L1索引读取状态::确定未命中
                && 结果.状态 != L1索引读取状态::索引不可用) 并发通过.store(false);
            if (结果.状态 == L1索引读取状态::命中 && !同代次且有序(结果, 2))
                并发通过.store(false);
        }
    });
    std::thread 重建线程([&] {
        while (!并发开始.load()) std::this_thread::yield();
        for (int i = 0; i < 1024; ++i) {
            const auto 结果 = 索引.从指定快照确定重建({L1可重建索引合同版本,
                L1可重建索引规则版本, 2, *快照二.快照});
            if (结果.状态 != L1索引维护状态::重建已发布
                && 结果.状态 != L1索引维护状态::精确重复
                && 结果.状态 != L1索引维护状态::索引视图漂移) 并发通过.store(false);
        }
    });
    std::thread 清空线程([&] {
        while (!并发开始.load()) std::this_thread::yield();
        for (int i = 0; i < 512; ++i) {
            const auto 结果 = 索引.清空({});
            if (结果.状态 != L1索引维护状态::已清空
                && 结果.状态 != L1索引维护状态::精确重复) 并发通过.store(false);
            std::this_thread::yield();
        }
    });
    std::thread 失效线程([&] {
        while (!并发开始.load()) std::this_thread::yield();
        for (int i = 0; i < 512; ++i) {
            const auto 结果 = 索引.失效({L1可重建索引合同版本,
                L1可重建索引规则版本, 2});
            if (结果.状态 != L1索引维护状态::已失效
                && 结果.状态 != L1索引维护状态::精确重复
                && 结果.状态 != L1索引维护状态::索引视图漂移) 并发通过.store(false);
            std::this_thread::yield();
        }
    });
    并发开始.store(true);
    读线程.join();
    重建线程.join();
    清空线程.join();
    失效线程.join();
    const auto 并发后重建 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 2, *快照二.快照});
    const auto 并发后读取 = 查询(L1节点种类索引键{节点种类::普通});
    const auto 后发生清空 = 索引.清空({});
    const auto 清空后不可用 = 查询(L1节点种类索引键{节点种类::普通});
    const auto 并发清空后重建 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 2, *快照二.快照});
    const auto 清空后读取 = 查询(L1节点种类索引键{节点种类::普通});
    const auto 后发生失效 = 索引.失效({L1可重建索引合同版本,
        L1可重建索引规则版本, 2});
    const auto 失效后不可用 = 查询(L1节点种类索引键{节点种类::普通});
    const auto 最终重建 = 索引.从指定快照确定重建({L1可重建索引合同版本,
        L1可重建索引规则版本, 2, *快照二.快照});
    const auto 最终读取 = 查询(L1节点种类索引键{节点种类::普通});
    记(并发通过.load()
        && (并发后重建.状态 == L1索引维护状态::重建已发布
            || 并发后重建.状态 == L1索引维护状态::精确重复)
        && 同代次且有序(并发后读取, 2)
        && 后发生清空.状态 == L1索引维护状态::已清空
        && 清空后不可用.状态 == L1索引读取状态::索引不可用
        && 并发清空后重建.状态 == L1索引维护状态::重建已发布
        && 同代次且有序(清空后读取, 2)
        && 后发生失效.状态 == L1索引维护状态::已失效
        && 失效后不可用.状态 == L1索引读取状态::索引不可用
        && 最终重建.状态 == L1索引维护状态::重建已发布
        && 同代次且有序(最终读取, 2)
        && 快照相同(L1.读取完整快照({}).快照, 快照二.快照));

    const auto 失败数量 = static_cast<std::size_t>(std::count(验收.begin(), 验收.end(), false));
    return {验收, 失败数量, 失败数量 == 0};
}

} // namespace 海中鱼巣
