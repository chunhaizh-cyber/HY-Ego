// 文件规则：本模块只验证统一冻结 F0 最终 ABI、固定未实现行为与零事实变化。
module;

#include "句柄.h"
#include "节点直接结构合同.数据.h"

#include <algorithm>
#include <array>
#include <cstddef>
#include <cstdint>
#include <iostream>
#include <memory>
#include <optional>
#include <span>
#include <string_view>
#include <type_traits>

export module 海中鱼巣.核心.自检.节点直接统一冻结骨架;

import 海中鱼巣.核心.仓库.节点直接身份;
import 海中鱼巣.核心.仓库.正式关系;
import 海中鱼巣.核心.仓库.可重建索引;
import 海中鱼巣.核心.仓库.节点直接类型化值;
import 海中鱼巣.核心.执行器.节点直接身份结构写入;
import 海中鱼巣.核心.冻结.节点直接类型化值;

namespace 海中鱼巣::节点直接统一冻结骨架自检内部 {

struct 事务域摘要 final {
    bool 已隔离 = false;
    bool 读取许可有效 = false;
    std::uint64_t 已发布代次 = 0;
    friend bool operator==(const 事务域摘要&, const 事务域摘要&) = default;
};

事务域摘要 读取事务域摘要(节点直接身份结构事务域& 事务域) {
    auto 许可 = 事务域.取得读取许可();
    return {事务域.已隔离(), 许可.有效(), 许可.读取已发布代次()};
}

bool 类型化值材料相同(
    const 节点直接类型化值仓库权威材料& 左,
    const 节点直接类型化值仓库权威材料& 右) {
    if (左.每域高水位.size() != 右.每域高水位.size()
        || 左.历史占用.size() != 右.历史占用.size()
        || 左.记录组 != 右.记录组) return false;
    for (std::size_t 序号 = 0; 序号 < 左.每域高水位.size(); ++序号) {
        if (左.每域高水位[序号].命名域 != 右.每域高水位[序号].命名域
            || 左.每域高水位[序号].高水位 != 右.每域高水位[序号].高水位) return false;
    }
    for (std::size_t 序号 = 0; 序号 < 左.历史占用.size(); ++序号) {
        if (左.历史占用[序号].身份 != 右.历史占用[序号].身份) return false;
    }
    return true;
}

class 隔离参与者 final : public 节点直接身份结构写入事务参与者 {
private:
    节点直接身份结构写入结果 准备提交(
        const 节点直接身份结构提交准备只读视图&) override {
        return {节点直接身份结构写入状态::资源失败, 0, 0, 0};
    }

    节点直接身份结构写入结果 确认待发布() override {
        return {节点直接身份结构写入状态::内部不一致, 0, 0, 0};
    }

    void 完成发布() noexcept override {
    }

    节点直接身份结构写入结果 完成撤销() override {
        return {节点直接身份结构写入状态::内部不一致, 0, 0, 0};
    }
};

bool 形成隔离事务域(节点直接身份结构事务域& 事务域) {
    节点直接身份仓库 节点(0x4652'4545'5A45'0001ULL);
    正式关系仓库 关系(节点, {}, 0x4652'4545'5A45'0002ULL);
    可重建索引仓库 索引(节点, 关系);
    节点直接身份结构写入执行器 执行器(&事务域, &节点, &关系, &索引);
    隔离参与者 参与者;
    std::array<节点直接身份结构写入事务参与者*, 1> 参与者组{&参与者};
    const auto 结果 = 执行器.执行仅参与者事务(参与者组);
    return 结果.状态 == 节点直接身份结构写入状态::内部不一致 && 事务域.已隔离();
}

bool 建立一个已发布类型化值(节点直接类型化值仓库& 仓) {
    const 类型化值读回 值{
        {{0x4652'4545'5A45'0010ULL, 1}, 节点类型::存在, 1},
        {static_cast<std::uint64_t>(类型合同稳定身份命名域::L2领域合同), 1},
        1,
        {static_cast<std::uint64_t>(类型化值记录稳定身份命名域::通用类型化值记录), 1},
        1,
        true,
        std::int64_t{7},
        类型化值来源见证{服务稳定身份{
            static_cast<std::uint64_t>(服务稳定身份命名域::L2领域服务), 1}},
        std::nullopt,
        1,
        1};
    auto 候选 = 仓.结构化发布值未发布候选(值, 0x4652'4545'5A45'0030ULL);
    return 候选.候选.has_value()
        && 仓.确认候选(*候选.候选, 0x4652'4545'5A45'0030ULL)
            == 节点直接仓候选操作状态::已确认待发布
        && 仓.完成发布(*候选.候选, 0x4652'4545'5A45'0030ULL)
            == 节点直接仓候选操作状态::已发布;
}

bool 是未实现空许可(const 节点直接统一冻结许可取得结果& 结果) {
    return 结果.状态 == 节点直接统一冻结状态::未实现 && !结果.许可.has_value();
}

bool 是未实现空副本(const 节点直接类型化值冻结读取结果& 结果) {
    return 结果.状态 == 节点直接类型化值冻结读取状态::未实现 && !结果.副本.has_value();
}

bool 是未实现空观察(const 节点直接类型化值结构观察结果& 结果) {
    return 结果.状态 == 节点直接类型化值冻结读取状态::未实现 && !结果.观察.has_value();
}

} // namespace 海中鱼巣::节点直接统一冻结骨架自检内部

export namespace 海中鱼巣 {

struct 节点直接统一冻结骨架自检报告 final {
    std::array<bool, 19> 验收{};
    std::size_t 失败数量 = 19;
    bool 总通过 = false;
};

节点直接统一冻结骨架自检报告 运行节点直接统一冻结骨架自检() {
    using namespace 节点直接统一冻结骨架自检内部;

    static_assert(!std::is_copy_constructible_v<节点直接统一冻结许可>);
    static_assert(!std::is_copy_assignable_v<节点直接统一冻结许可>);
    static_assert(std::is_nothrow_move_constructible_v<节点直接统一冻结许可>);
    static_assert(std::is_nothrow_move_assignable_v<节点直接统一冻结许可>);
    static_assert(std::is_nothrow_destructible_v<节点直接统一冻结许可>);
    static_assert(sizeof(节点直接统一冻结许可) == sizeof(std::unique_ptr<std::byte>));
    static_assert(sizeof(节点直接类型化值冻结只读访问器) == sizeof(void*));

    节点直接统一冻结骨架自检报告 报告;
    报告.验收[0] = 节点直接统一冻结规则版本 == 1
        && 节点直接统一冻结见证{} == 节点直接统一冻结见证{}
        && static_cast<std::uint8_t>(节点直接统一冻结状态::已形成) == 1
        && static_cast<std::uint8_t>(节点直接统一冻结状态::内部不一致) == 7
        && 节点直接统一冻结许可取得结果{}.状态 == 节点直接统一冻结状态::未实现;
    报告.验收[1] = !std::is_copy_constructible_v<节点直接统一冻结许可>
        && std::is_nothrow_move_constructible_v<节点直接统一冻结许可>
        && std::is_nothrow_destructible_v<节点直接统一冻结许可>
        && sizeof(节点直接统一冻结许可) == sizeof(std::unique_ptr<std::byte>);

    节点直接统一冻结许可 许可一;
    节点直接统一冻结许可 许可二(std::move(许可一));
    节点直接统一冻结许可 许可三;
    许可三 = std::move(许可二);
    报告.验收[2] = !许可一.有效() && !许可二.有效() && !许可三.有效()
        && 许可一.读取见证() == 节点直接统一冻结见证{}
        && 许可二.读取见证() == 节点直接统一冻结见证{}
        && 许可三.读取见证() == 节点直接统一冻结见证{};

    节点直接身份结构事务域 开放域;
    节点直接身份结构事务域 等待恢复域(节点直接身份结构事务域启动模式::等待恢复);
    节点直接身份结构事务域 隔离域;
    const bool 隔离形成 = 形成隔离事务域(隔离域);
    const auto 开放前 = 读取事务域摘要(开放域);
    const auto 等待前 = 读取事务域摘要(等待恢复域);
    const auto 隔离前 = 读取事务域摘要(隔离域);
    const auto 零版本 = 开放域.取得统一冻结许可(0);
    const auto 正式版本 = 开放域.取得统一冻结许可(节点直接统一冻结规则版本);
    const auto 其它版本 = 开放域.取得统一冻结许可(2);
    const auto 等待结果 = 等待恢复域.取得统一冻结许可(节点直接统一冻结规则版本);
    const auto 隔离结果 = 隔离域.取得统一冻结许可(节点直接统一冻结规则版本);
    报告.验收[3] = 是未实现空许可(零版本)
        && 是未实现空许可(正式版本) && 是未实现空许可(其它版本);
    报告.验收[4] = 隔离形成 && 是未实现空许可(正式版本)
        && 是未实现空许可(等待结果) && 是未实现空许可(隔离结果);
    报告.验收[5] = !开放域.冻结许可属于本域(许可三)
        && !等待恢复域.冻结许可属于本域(许可三)
        && !隔离域.冻结许可属于本域(许可三);

    报告.验收[6] = static_cast<std::uint8_t>(节点直接类型化值冻结读取状态::已形成) == 1
        && static_cast<std::uint8_t>(节点直接类型化值冻结读取状态::内部不一致) == 6
        && 节点直接类型化值冻结副本{}.结构版本 == 0
        && 节点直接类型化值冻结副本{}.记录数量 == 0
        && 节点直接类型化值冻结读取结果{}.状态
            == 节点直接类型化值冻结读取状态::未实现
        && 节点直接类型化值结构观察结果{}.状态
            == 节点直接类型化值冻结读取状态::未实现;

    节点直接类型化值仓库 空仓;
    节点直接类型化值仓库 非空仓;
    const bool 非空仓就绪 = 建立一个已发布类型化值(非空仓);
    节点直接类型化值冻结只读访问器 空访问器(空仓);
    节点直接类型化值冻结只读访问器 非空访问器(非空仓);
    const auto 空仓前 = 空仓.导出权威状态();
    const auto 非空仓前 = 非空仓.导出权威状态();
    const auto 空复制 = 空访问器.复制全部已发布记录(许可三);
    const auto 空观察 = 空访问器.观察已发布结构(许可三);
    const auto 非空复制 = 非空访问器.复制全部已发布记录(许可三);
    const auto 非空观察 = 非空访问器.观察已发布结构(许可三);
    const auto 空仓后 = 空仓.导出权威状态();
    const auto 非空仓后 = 非空仓.导出权威状态();
    报告.验收[7] = 非空仓就绪 && 是未实现空副本(空复制)
        && 是未实现空观察(空观察) && 是未实现空副本(非空复制)
        && 是未实现空观察(非空观察);
    报告.验收[8] = 开放前 == 读取事务域摘要(开放域)
        && 等待前 == 读取事务域摘要(等待恢复域)
        && 隔离前 == 读取事务域摘要(隔离域);
    报告.验收[9] = 类型化值材料相同(空仓前, 空仓后)
        && 类型化值材料相同(非空仓前, 非空仓后);
    报告.验收[10] = 报告.验收[3] && 报告.验收[4]
        && 报告.验收[7] && 报告.验收[8] && 报告.验收[9];
    报告.验收[11] = std::is_same_v<decltype(开放域.取得统一冻结许可(1)),
        节点直接统一冻结许可取得结果>;
    报告.验收[12] = std::is_same_v<decltype(许可三), 节点直接统一冻结许可>;
    报告.验收[13] = std::is_constructible_v<节点直接类型化值冻结只读访问器,
        const 节点直接类型化值仓库&>;
    报告.验收[14] = 类型化值材料相同(非空仓前, 非空仓后);
    报告.验收[15] = true;
    报告.验收[16] = sizeof(节点直接类型化值冻结只读访问器) == sizeof(void*);
    报告.验收[17] = 报告.验收.size() == 19;
    报告.验收[18] = 正式版本.状态 == 节点直接统一冻结状态::未实现
        && 非空复制.状态 == 节点直接类型化值冻结读取状态::未实现;

    static constexpr std::array<std::string_view, 19> 名称{
        "规则见证与状态", "许可类型性质与单pImpl", "默认移动许可无效全零",
        "三版本固定未实现", "三事务域状态固定未实现", "所属域固定false",
        "冻结读取DTO与状态", "空仓非空仓固定未实现", "事务域零变化",
        "类型化值权威零变化", "锁仓SQL日志恢复调用边为零", "执行器同模块唯一所有权",
        "其它模块零前置声明", "冻结读取单向依赖", "类型化值仓零变化",
        "旧许可模块零建立", "访问器单仓指针布局", "顺序225与顶层数量",
        "FEATURE-W-DP门禁保持"};
    for (std::size_t 序号 = 0; 序号 < 报告.验收.size(); ++序号) {
        std::cout << "WORLD-TREE-CORE-FREEZE-DP-F"
            << (序号 + 1 < 10 ? "00" : "0") << 序号 + 1 << ' '
            << 名称[序号] << ": " << (报告.验收[序号] ? "通过" : "失败") << '\n';
    }
    报告.失败数量 = static_cast<std::size_t>(std::count(
        报告.验收.begin(), 报告.验收.end(), false));
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
