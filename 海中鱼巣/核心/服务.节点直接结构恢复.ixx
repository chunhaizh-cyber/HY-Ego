// 文件规则：本模块只读取安装实例持久材料、完成端口级分流并显式映射恢复结果。
module;

#include "节点直接类型化结构事务.数据.h"

export module 海中鱼巣.核心.服务.节点直接结构恢复;

import 海中鱼巣.核心.端口.节点直接持久证据;
import 海中鱼巣.核心.数据操作.节点直接类型化结构;

export namespace 海中鱼巣 {

class 节点直接结构恢复服务 final {
public:
    节点直接结构恢复服务(
        节点直接恢复材料读取端口& 材料,
        节点直接类型化结构数据操作& 数据操作) noexcept
        : 材料_(材料), 数据操作_(数据操作) {}

    节点直接结构恢复结果 恢复安装实例(
        const 节点直接安装实例恢复请求& 请求) const {
        if (请求.合同版本 != 1 || !节点直接事务幂等身份完整(请求.安装实例身份))
            return {};
        const auto 材料 = 材料_.读取安装实例(请求.安装实例身份);
        switch (材料.安装状态) {
        case 节点直接安装实例证据状态::确认从未发布:
            return 映射治理结果_(数据操作_.初始化确认空域治理代次(请求.安装实例身份));
        case 节点直接安装实例证据状态::存在事务证据:
            return 映射恢复结果_(数据操作_.恢复(请求.安装实例身份, 材料));
        case 节点直接安装实例证据状态::未登记:
            return {};
        case 节点直接安装实例证据状态::资源失败:
            return {节点直接结构恢复判定::资源失败, 0, std::nullopt};
        case 节点直接安装实例证据状态::损坏:
            return {节点直接结构恢复判定::内部不一致, 0, std::nullopt};
        }
        return {节点直接结构恢复判定::内部不一致, 0, std::nullopt};
    }

private:
    static 节点直接类型化结构提交结果 映射提交结果_(
        const 节点直接类型化结构数据操作结果& 下层) {
        节点直接类型化结构提交结果 结果;
        switch (下层.状态) {
        case 节点直接类型化结构数据操作状态::已提交: 结果.状态 = 节点直接类型化结构提交状态::已提交; break;
        case 节点直接类型化结构数据操作状态::幂等读回: 结果.状态 = 节点直接类型化结构提交状态::幂等读回; break;
        case 节点直接类型化结构数据操作状态::入口拒绝: 结果.状态 = 节点直接类型化结构提交状态::入口拒绝; break;
        case 节点直接类型化结构数据操作状态::幂等冲突: 结果.状态 = 节点直接类型化结构提交状态::幂等冲突; break;
        case 节点直接类型化结构数据操作状态::版本漂移: 结果.状态 = 节点直接类型化结构提交状态::版本漂移; break;
        case 节点直接类型化结构数据操作状态::许可拒绝: 结果.状态 = 节点直接类型化结构提交状态::许可拒绝; break;
        case 节点直接类型化结构数据操作状态::资源失败: 结果.状态 = 节点直接类型化结构提交状态::资源失败; break;
        case 节点直接类型化结构数据操作状态::内部不一致: 结果.状态 = 节点直接类型化结构提交状态::内部不一致; break;
        }
        结果.发布代次 = 下层.发布代次;
        结果.持久状态 = 下层.持久状态;
        结果.节点组 = 下层.节点组;
        结果.关系组 = 下层.关系组;
        结果.类型化值组 = 下层.类型化值组;
        结果.索引组 = 下层.索引组;
        return 结果;
    }

    static 节点直接结构恢复结果 映射治理结果_(
        const 节点直接类型化结构数据操作结果& 下层) {
        节点直接结构恢复结果 结果;
        switch (下层.状态) {
        case 节点直接类型化结构数据操作状态::已提交: 结果.判定 = 节点直接结构恢复判定::已初始化确认空域; break;
        case 节点直接类型化结构数据操作状态::幂等读回: 结果.判定 = 节点直接结构恢复判定::精确同义; break;
        case 节点直接类型化结构数据操作状态::版本漂移: 结果.判定 = 节点直接结构恢复判定::版本漂移; break;
        case 节点直接类型化结构数据操作状态::资源失败: 结果.判定 = 节点直接结构恢复判定::资源失败; break;
        case 节点直接类型化结构数据操作状态::入口拒绝:
        case 节点直接类型化结构数据操作状态::幂等冲突:
        case 节点直接类型化结构数据操作状态::许可拒绝:
        case 节点直接类型化结构数据操作状态::内部不一致:
            结果.判定 = 节点直接结构恢复判定::内部不一致; break;
        }
        结果.事实截止代次 = 下层.发布代次;
        结果.提交结果 = 映射提交结果_(下层);
        return 结果;
    }

    static 节点直接结构恢复结果 映射恢复结果_(
        const 节点直接恢复数据操作结果& 下层) {
        节点直接结构恢复结果 结果;
        switch (下层.状态) {
        case 节点直接恢复数据操作状态::已恢复: 结果.判定 = 节点直接结构恢复判定::已恢复; break;
        case 节点直接恢复数据操作状态::精确同义: 结果.判定 = 节点直接结构恢复判定::精确同义; break;
        case 节点直接恢复数据操作状态::已初始化确认空域: 结果.判定 = 节点直接结构恢复判定::已初始化确认空域; break;
        case 节点直接恢复数据操作状态::材料不完整: 结果.判定 = 节点直接结构恢复判定::材料不完整; break;
        case 节点直接恢复数据操作状态::格式不支持: 结果.判定 = 节点直接结构恢复判定::格式不支持; break;
        case 节点直接恢复数据操作状态::身份冲突: 结果.判定 = 节点直接结构恢复判定::身份冲突; break;
        case 节点直接恢复数据操作状态::版本漂移: 结果.判定 = 节点直接结构恢复判定::版本漂移; break;
        case 节点直接恢复数据操作状态::关系矛盾: 结果.判定 = 节点直接结构恢复判定::关系矛盾; break;
        case 节点直接恢复数据操作状态::资源失败: 结果.判定 = 节点直接结构恢复判定::资源失败; break;
        case 节点直接恢复数据操作状态::发布未知: 结果.判定 = 节点直接结构恢复判定::发布未知; break;
        case 节点直接恢复数据操作状态::内部不一致: 结果.判定 = 节点直接结构恢复判定::内部不一致; break;
        case 节点直接恢复数据操作状态::已恢复治理空域: 结果.判定 = 节点直接结构恢复判定::已恢复治理空域; break;
        }
        结果.事实截止代次 = 下层.事实截止代次;
        if (下层.提交结果) 结果.提交结果 = 映射提交结果_(*下层.提交结果);
        return 结果;
    }

    节点直接恢复材料读取端口& 材料_;
    节点直接类型化结构数据操作& 数据操作_;
};

} // namespace 海中鱼巣
