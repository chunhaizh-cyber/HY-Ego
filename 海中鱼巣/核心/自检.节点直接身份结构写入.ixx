        && 恢复节点仓.完成发布恢复候选(*节点恢复候选.候选, 0xA220)
            == 节点直接恢复仓操作状态::已发布;
    const auto 恢复后材料 = 恢复节点仓.导出权威状态();

    证据.验收 = {
        治理.状态 == 节点直接类型化结构数据操作状态::已提交
            && 治理.发布代次 == 1,
