    const bool 恢复发布前不可见 = 恢复节点仓.有效节点数量() == 0;
    const bool 节点恢复已发布 = 节点恢复候选.候选
        && 恢复节点仓.确认恢复候选(*节点恢复候选.候选, 0xA220)
