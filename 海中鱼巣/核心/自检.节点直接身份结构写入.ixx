namespace 海中鱼巣::节点直接身份结构写入自检内部 {

bool 允许自检关系(
    节点类型,
    节点类型,
    std::int64_t) noexcept {
    return true;
}

完整正式关系准入表 形成完整准入表() {
    完整正式关系准入表 表;
    for (std::size_t 序号 = 0; 序号 < 表.规则组.size(); ++序号) {
        表.规则组[序号] = {
            static_cast<关系类型>(序号),
            0x4E54'5031'0000'0001ULL + 序号,
            1,
            true,
            true,
            true,
            &允许自检关系};
    }
    return 表;
}

节点稳定主键 形成稳定主键(
    节点稳定主键命名域 命名域,
    std::uint64_t 键值) noexcept {
    return {static_cast<std::uint64_t>(命名域), 键值};
}

struct 隔离夹具 {
    explicit 隔离夹具(std::uint64_t 仓库基数)
        : 节点(仓库基数),
          关系(节点, 形成完整准入表(), 仓库基数 + 1),
          索引(节点, 关系),
          执行器(&事务域, &节点, &关系, &索引) {
    }

    节点直接身份仓库 节点;
    正式关系仓库 关系;
    可重建索引仓库 索引;
    节点直接身份结构事务域 事务域;
    节点直接身份结构写入执行器 执行器;
};

enum class 参与者故障点 : std::uint8_t {
    无,
    准备,
    确认,
    撤销
};

template <int 类型标识>
class 强类型自检参与者 final : public 节点直接身份结构写入事务参与者 {
public:
    强类型自检参与者(
        std::vector<int>* 顺序,
        参与者故障点 故障点) noexcept
        : 顺序_(顺序), 故障点_(故障点) {
    }

    void 绑定候选(
        节点句柄 节点,
        节点类型 类型,
        节点稳定主键 稳定主键) noexcept {
        节点_ = 节点;
        类型_ = 类型;
        稳定主键_ = 稳定主键;
    }

    bool 已发布() const noexcept { return 已发布_; }
    bool 已撤销() const noexcept { return 已撤销_; }

private:
    节点直接身份结构写入结果 准备提交(
        const 节点直接身份结构提交准备只读视图& 视图) override {
        顺序_->push_back(类型标识 * 10 + 1);
        const auto 候选类型 = 视图.读取候选节点类型(节点_);
        const auto 候选主键 = 视图.读取候选节点稳定主键(节点_);
        if (故障点_ == 参与者故障点::准备
            || !视图.节点是本会话候选(节点_)
            || !候选类型.has_value() || *候选类型 != 类型_
            || !候选主键.has_value()
            || 候选主键->命名域 != 稳定主键_.命名域
            || 候选主键->键值 != 稳定主键_.键值) {
            return {节点直接身份结构写入状态::内部不一致, 0, 0, 0};
        }
        return {节点直接身份结构写入状态::候选已确认, 0, 0, 0};
    }

    节点直接身份结构写入结果 确认待发布() override {
        顺序_->push_back(类型标识 * 10 + 2);
        if (故障点_ == 参与者故障点::确认) {
            return {节点直接身份结构写入状态::内部不一致, 0, 0, 0};
        }
        return {节点直接身份结构写入状态::候选已确认, 0, 0, 0};
    }

    void 完成发布() noexcept override {
        顺序_->push_back(类型标识 * 10 + 3);
        已发布_ = true;
    }

    节点直接身份结构写入结果 完成撤销() override {
        顺序_->push_back(类型标识 * 10 + 4);
        已撤销_ = true;
        if (故障点_ == 参与者故障点::撤销) {
            return {节点直接身份结构写入状态::内部不一致, 0, 0, 0};
        }
        return {节点直接身份结构写入状态::候选已撤销, 0, 0, 0};
    }

    std::vector<int>* 顺序_ = nullptr;
    参与者故障点 故障点_ = 参与者故障点::无;
    节点句柄 节点_;
    节点类型 类型_ = 节点类型::未分类;
    节点稳定主键 稳定主键_;
    bool 已发布_ = false;
    bool 已撤销_ = false;
};

class 内存持久证据端口 final : public 节点直接持久证据写入端口 {
public:
    节点直接持久端口结果 准备(const 节点直接持久准备请求& 请求) override {
        ++准备次数;
        if (准备返回状态 != 节点直接持久端口状态::已准备)
            return {准备返回状态, 准备返回状态 == 节点直接持久端口状态::精确同义 ? 1ULL : 0ULL};
        if (!节点直接事务幂等身份完整(请求.安装实例身份)
            || !节点直接事务幂等身份完整(请求.事务身份)
            || 请求.材料格式版本 != 2 || 请求.写集材料.empty()) return {};
        最后准备 = 请求;
        return {节点直接持久端口状态::已准备, 1};
    }

    节点直接持久端口结果 标记已发布(
        const 节点直接持久发布见证请求& 请求) override {
        ++发布次数;
        if (发布返回状态 != 节点直接持久端口状态::已见证)
            return {发布返回状态, 请求.尝试序号};
        if (请求.尝试序号 != 1 || 请求.发布代次 == 0 || !最后准备
            || 最后准备->安装实例身份 != 请求.安装实例身份
            || 最后准备->事务身份 != 请求.事务身份) return {};
        已见证组.push_back({请求.事务身份, 请求.尝试序号, 最后准备->材料格式版本,
            请求.请求意图摘要, 请求.执行证据摘要, 最后准备->写集材料,
            节点直接持久端口状态::已见证, 请求.发布代次, 请求.结果摘要});
        return {节点直接持久端口状态::已见证, 1};
    }

    节点直接持久端口结果 标记已撤销未发布(
        const 节点直接持久撤销见证请求& 请求) override {
        ++撤销次数;
        if (撤销返回状态 != 节点直接持久端口状态::已撤销未发布)
            return {撤销返回状态, 请求.尝试序号};
        return 请求.尝试序号 == 1
            ? 节点直接持久端口结果{节点直接持久端口状态::已撤销未发布, 1}
            : 节点直接持久端口结果{};
    }

    std::size_t 准备次数 = 0;
    std::size_t 发布次数 = 0;
    std::size_t 撤销次数 = 0;
    节点直接持久端口状态 准备返回状态 = 节点直接持久端口状态::已准备;
    节点直接持久端口状态 发布返回状态 = 节点直接持久端口状态::已见证;
    节点直接持久端口状态 撤销返回状态 = 节点直接持久端口状态::已撤销未发布;
    std::optional<节点直接持久准备请求> 最后准备;
    std::vector<节点直接持久事务证据> 已见证组;
};

enum class 类型化参与者故障点 : std::uint8_t {
    无,
    第一写前返回入口拒绝,
    第一写前返回版本漂移,
    第一写前返回许可拒绝,
    第一写前返回资源失败,
    第一写前抛异常,
    准备返回资源失败,
    准备抛异常,
    确认返回版本漂移,
    撤销返回失败,
    发布抛异常
};

class 类型化事务自检参与者 final : public 节点直接类型化结构事务参与者 {
public:
    类型化事务自检参与者(
        std::vector<int>& 顺序,
        int 标识,
        节点直接写集局部身份 预期局部身份,
        类型化参与者故障点 故障点 = 类型化参与者故障点::无) noexcept
        : 顺序_(&顺序), 标识_(标识), 预期局部身份_(预期局部身份), 故障点_(故障点) {}

    std::size_t 调用次数() const noexcept { return 调用次数_; }
    bool 第一写前视图准确() const noexcept { return 第一写前视图准确_; }
    bool 视图准确() const noexcept { return 视图准确_; }
    bool 见证准确() const noexcept { return 见证准确_; }
    bool 已撤销() const noexcept { return 已撤销_; }
    bool 已发布() const noexcept { return 已发布_; }
    bool 私有候选存在() const noexcept { return 私有候选存在_; }

private:
    节点直接类型化结构事务参与者结果 第一写前复核(
        const 节点直接类型化结构第一写前复核只读视图& 视图) override {
        ++调用次数_;
        顺序_->push_back(标识_ * 10);
        私有候选存在_ = true;
        const auto& 请求 = 视图.读取请求();
        第一写前视图准确_ = 视图.读取事务序号() != 0
            && 视图.读取当前事实截止代次() == 请求.预期事实截止代次
            && 视图.读取目标发布代次() == 请求.预期事实截止代次 + 1
            && 请求.幂等身份 == 预期幂等身份_;
        if (故障点_ == 类型化参与者故障点::第一写前抛异常) throw 1;
        if (故障点_ == 类型化参与者故障点::第一写前返回入口拒绝)
            return {节点直接类型化结构事务参与者状态::入口拒绝};
        if (故障点_ == 类型化参与者故障点::第一写前返回版本漂移)
            return {节点直接类型化结构事务参与者状态::版本漂移};
        if (故障点_ == 类型化参与者故障点::第一写前返回许可拒绝)
            return {节点直接类型化结构事务参与者状态::许可拒绝};
        if (故障点_ == 类型化参与者故障点::第一写前返回资源失败)
            return {节点直接类型化结构事务参与者状态::资源失败};
        return {节点直接类型化结构事务参与者状态::第一写前已复核};
    }

    节点直接类型化结构事务参与者结果 准备提交(
        const 节点直接类型化结构提交准备只读视图& 视图) override {
        ++调用次数_;
        顺序_->push_back(标识_ * 10 + 1);
        私有候选存在_ = true;
        const auto& 请求 = 视图.读取请求();
        视图准确_ = 视图.读取事务序号() != 0
            && 视图.读取当前事实截止代次() == 请求.预期事实截止代次
            && 视图.读取目标发布代次() == 请求.预期事实截止代次 + 1
            && 请求.幂等身份 == 预期幂等身份_;
        const auto 见证 = 视图.读取计划身份见证(预期局部身份_);
        const auto& 读回 = 视图.读取候选读回();
        见证准确_ = 见证 && std::holds_alternative<节点稳定身份见证>(*见证)
            && 读回.节点组.size() == 1
            && std::get<节点稳定身份见证>(*见证) == 读回.节点组.front();
        if (故障点_ == 类型化参与者故障点::准备抛异常) throw 1;
        if (故障点_ == 类型化参与者故障点::准备返回资源失败)
            return {节点直接类型化结构事务参与者状态::资源失败};
        return {节点直接类型化结构事务参与者状态::已准备};
    }

    节点直接类型化结构事务参与者结果 确认待发布() override {
        ++调用次数_;
        顺序_->push_back(标识_ * 10 + 2);
        if (故障点_ == 类型化参与者故障点::确认返回版本漂移)
            return {节点直接类型化结构事务参与者状态::版本漂移};
        return {节点直接类型化结构事务参与者状态::已确认待发布};
    }

    节点直接类型化结构事务参与者结果 完成撤销() override {
        ++调用次数_;
        顺序_->push_back(标识_ * 10 + 4);
        已撤销_ = true;
        私有候选存在_ = false;
        return {故障点_ == 类型化参与者故障点::撤销返回失败
            ? 节点直接类型化结构事务参与者状态::内部不一致
            : 节点直接类型化结构事务参与者状态::已撤销};
    }

    节点直接类型化结构事务参与者结果 完成发布() override {
        ++调用次数_;
        顺序_->push_back(标识_ * 10 + 3);
        if (故障点_ == 类型化参与者故障点::发布抛异常) throw 1;
        已发布_ = true;
        私有候选存在_ = false;
        return {节点直接类型化结构事务参与者状态::已完成发布};
    }

public:
    节点直接事务幂等身份 预期幂等身份_{};

private:
    std::vector<int>* 顺序_ = nullptr;
    int 标识_ = 0;
    节点直接写集局部身份 预期局部身份_{};
    类型化参与者故障点 故障点_ = 类型化参与者故障点::无;
    std::size_t 调用次数_ = 0;
    bool 第一写前视图准确_ = false;
    bool 视图准确_ = false;
    bool 见证准确_ = false;
    bool 已撤销_ = false;
    bool 已发布_ = false;
    bool 私有候选存在_ = false;
};

struct 类型化参与者隔离夹具 {
    explicit 类型化参与者隔离夹具(std::uint64_t 基数)
        : 节点(基数), 关系(节点, 形成完整准入表(), 基数 + 1), 索引(节点, 关系),
          执行器(&事务域, &节点, &关系, &索引, &合同, &值, &幂等, &持久), 数据操作(执行器),
          安装实例{基数 + 10, 1} {
        初始化 = 数据操作.初始化确认空域治理代次(安装实例);
    }

    节点直接类型化结构数据操作请求 形成节点请求(std::uint64_t 序号) const {
        节点直接类型化结构数据操作请求 请求;
        请求.安装实例身份 = 安装实例;
        请求.幂等身份 = {安装实例.命名域, 序号};
        请求.请求意图摘要[0] = static_cast<std::uint8_t>(序号);
        请求.执行证据摘要[0] = static_cast<std::uint8_t>(序号 + 1);
        请求.预期事实截止代次 = 1;
        请求.写项组 = {节点直接节点创建项{
            局部身份, 节点稳定主键命名域::文章身份, 节点类型::文章}};
        请求.读回规格.项目组 = {{
            节点直接发布后读回对象种类::当前节点, 局部身份, 1}};
        return 请求;
    }

    节点直接身份仓库 节点;
    正式关系仓库 关系;
    可重建索引仓库 索引;
    节点直接类型合同仓库 合同;
    节点直接类型化值仓库 值;
    节点直接事务幂等仓库 幂等;
    节点直接身份结构事务域 事务域;
    内存持久证据端口 持久;
    节点直接身份结构写入执行器 执行器;
    节点直接类型化结构数据操作 数据操作;
    节点直接事务幂等身份 安装实例;
    节点直接类型化结构数据操作结果 初始化;
    const 节点直接写集局部身份 局部身份{节点直接写集局部身份种类::节点, 1};
};

bool 类型化结果逐字段相等(
    const 节点直接类型化结构数据操作结果& 左,
    const 节点直接类型化结构数据操作结果& 右) {
    return 左.状态 == 右.状态 && 左.发布代次 == 右.发布代次
        && 左.持久状态 == 右.持久状态 && 左.节点组 == 右.节点组
        && 左.关系组 == 右.关系组 && 左.类型化值组 == 右.类型化值组
        && 左.索引组 == 右.索引组;
}

std::array<bool, 11> 验证类型化事务参与者桥接() {
    std::array<bool, 11> 验收{};
    类型化参与者隔离夹具 旧入口夹具(0xF100);
    类型化参与者隔离夹具 空组夹具(0xF100);
    auto 旧请求 = 旧入口夹具.形成节点请求(1);
    auto 空组请求 = 空组夹具.形成节点请求(1);
    const auto 旧结果 = 旧入口夹具.数据操作.提交(旧请求);
    const std::span<节点直接类型化结构事务参与者* const> 空组;
    const auto 空组结果 = 空组夹具.数据操作.提交带参与者事务(空组请求, 空组);

    类型化参与者隔离夹具 成功夹具(0xF200);
    auto 成功请求 = 成功夹具.形成节点请求(1);
    std::vector<int> 成功顺序;
    类型化事务自检参与者 参与者一(成功顺序, 1, 成功夹具.局部身份);
    类型化事务自检参与者 参与者二(成功顺序, 2, 成功夹具.局部身份);
    参与者一.预期幂等身份_ = 成功请求.幂等身份;
    参与者二.预期幂等身份_ = 成功请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 2> 成功参与者组{&参与者一, &参与者二};
    const auto 成功结果 = 成功夹具.数据操作.提交带参与者事务(成功请求, 成功参与者组);
    std::vector<int> 同义顺序;
    类型化事务自检参与者 同义参与者(同义顺序, 3, 成功夹具.局部身份);
    同义参与者.预期幂等身份_ = 成功请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 1> 同义组{&同义参与者};
    const auto 同义结果 = 成功夹具.数据操作.提交带参与者事务(成功请求, 同义组);

    类型化参与者隔离夹具 无效夹具(0xF300);
    auto 无效请求 = 无效夹具.形成节点请求(1);
    std::vector<int> 无效顺序;
    类型化事务自检参与者 无效参与者(无效顺序, 1, 无效夹具.局部身份);
    std::array<节点直接类型化结构事务参与者*, 1> 空指针组{nullptr};
    const auto 空指针结果 = 无效夹具.数据操作.提交带参与者事务(无效请求, 空指针组);
    std::array<节点直接类型化结构事务参与者*, 2> 重复组{&无效参与者, &无效参与者};
    const auto 重复结果 = 无效夹具.数据操作.提交带参与者事务(无效请求, 重复组);

    类型化参与者隔离夹具 失败夹具(0xF400);
    auto 失败请求 = 失败夹具.形成节点请求(1);
    std::vector<int> 失败顺序;
    类型化事务自检参与者 失败前项(失败顺序, 1, 失败夹具.局部身份);
    类型化事务自检参与者 失败项(
        失败顺序, 2, 失败夹具.局部身份, 类型化参与者故障点::准备返回资源失败);
    失败前项.预期幂等身份_ = 失败请求.幂等身份;
    失败项.预期幂等身份_ = 失败请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 2> 失败组{&失败前项, &失败项};
    const auto 准备失败结果 = 失败夹具.数据操作.提交带参与者事务(失败请求, 失败组);

    类型化参与者隔离夹具 第一写前失败夹具(0xF450);
    auto 第一写前失败请求 = 第一写前失败夹具.形成节点请求(1);
    std::vector<int> 第一写前失败顺序;
    类型化事务自检参与者 第一写前失败前项(
        第一写前失败顺序, 1, 第一写前失败夹具.局部身份);
    类型化事务自检参与者 第一写前失败项(
        第一写前失败顺序, 2, 第一写前失败夹具.局部身份,
        类型化参与者故障点::第一写前返回资源失败);
    类型化事务自检参与者 第一写前未调用项(
        第一写前失败顺序, 3, 第一写前失败夹具.局部身份);
    第一写前失败前项.预期幂等身份_ = 第一写前失败请求.幂等身份;
    第一写前失败项.预期幂等身份_ = 第一写前失败请求.幂等身份;
    第一写前未调用项.预期幂等身份_ = 第一写前失败请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 3> 第一写前失败组{
        &第一写前失败前项, &第一写前失败项, &第一写前未调用项};
    const auto 第一写前失败结果 = 第一写前失败夹具.数据操作.提交带参与者事务(
        第一写前失败请求, 第一写前失败组);

    类型化参与者隔离夹具 准备首项失败夹具(0xF470);
    auto 准备首项失败请求 = 准备首项失败夹具.形成节点请求(1);
    std::vector<int> 准备首项失败顺序;
    类型化事务自检参与者 准备首项失败项(
        准备首项失败顺序, 1, 准备首项失败夹具.局部身份,
        类型化参与者故障点::准备返回资源失败);
    类型化事务自检参与者 准备后项二(
        准备首项失败顺序, 2, 准备首项失败夹具.局部身份);
    类型化事务自检参与者 准备后项三(
        准备首项失败顺序, 3, 准备首项失败夹具.局部身份);
    准备首项失败项.预期幂等身份_ = 准备首项失败请求.幂等身份;
    准备后项二.预期幂等身份_ = 准备首项失败请求.幂等身份;
    准备后项三.预期幂等身份_ = 准备首项失败请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 3> 准备首项失败组{
        &准备首项失败项, &准备后项二, &准备后项三};
    const auto 准备首项失败结果 = 准备首项失败夹具.数据操作.提交带参与者事务(
        准备首项失败请求, 准备首项失败组);

    const auto 验证第一写前故障映射 = [](
        std::uint64_t 基数,
        类型化参与者故障点 故障点,
        节点直接类型化结构数据操作状态 预期状态) {
        类型化参与者隔离夹具 夹具(基数);
        auto 请求 = 夹具.形成节点请求(1);
        std::vector<int> 顺序;
        类型化事务自检参与者 参与者(顺序, 1, 夹具.局部身份, 故障点);
        参与者.预期幂等身份_ = 请求.幂等身份;
        std::array<节点直接类型化结构事务参与者*, 1> 参与者组{&参与者};
        const auto 结果 = 夹具.数据操作.提交带参与者事务(请求, 参与者组);
        return 结果.状态 == 预期状态 && 结果.发布代次 == 0
            && 结果.节点组.empty() && 顺序 == std::vector<int>({10, 14})
            && 参与者.已撤销() && !参与者.私有候选存在();
    };
    const bool 第一写前故障映射完整 =
        验证第一写前故障映射(0xF481, 类型化参与者故障点::第一写前返回入口拒绝,
            节点直接类型化结构数据操作状态::入口拒绝)
        && 验证第一写前故障映射(0xF482, 类型化参与者故障点::第一写前返回版本漂移,
            节点直接类型化结构数据操作状态::版本漂移)
        && 验证第一写前故障映射(0xF483, 类型化参与者故障点::第一写前返回许可拒绝,
            节点直接类型化结构数据操作状态::许可拒绝)
        && 验证第一写前故障映射(0xF484, 类型化参与者故障点::第一写前返回资源失败,
            节点直接类型化结构数据操作状态::资源失败)
        && 验证第一写前故障映射(0xF485, 类型化参与者故障点::第一写前抛异常,
            节点直接类型化结构数据操作状态::内部不一致);
    const auto 验证第一写前失败位置 = [](
        std::uint64_t 基数, std::size_t 失败位置, const std::vector<int>& 预期顺序) {
        类型化参与者隔离夹具 夹具(基数);
        auto 请求 = 夹具.形成节点请求(1);
        std::vector<int> 顺序;
        const auto 故障 = [&](std::size_t 位置) {
            return 失败位置 == 位置
                ? 类型化参与者故障点::第一写前返回资源失败
                : 类型化参与者故障点::无;
        };
        类型化事务自检参与者 一(顺序, 1, 夹具.局部身份, 故障(1));
        类型化事务自检参与者 二(顺序, 2, 夹具.局部身份, 故障(2));
        类型化事务自检参与者 三(顺序, 3, 夹具.局部身份, 故障(3));
        一.预期幂等身份_ = 请求.幂等身份;
        二.预期幂等身份_ = 请求.幂等身份;
        三.预期幂等身份_ = 请求.幂等身份;
        std::array<节点直接类型化结构事务参与者*, 3> 组{&一, &二, &三};
        const auto 结果 = 夹具.数据操作.提交带参与者事务(请求, 组);
        const std::array<bool, 3> 应撤销{失败位置 >= 1, 失败位置 >= 2, 失败位置 >= 3};
        return 结果.状态 == 节点直接类型化结构数据操作状态::资源失败
            && 顺序 == 预期顺序
            && 一.已撤销() == 应撤销[0] && 二.已撤销() == 应撤销[1]
            && 三.已撤销() == 应撤销[2];
    };
    const bool 第一末项失败覆盖 =
        验证第一写前失败位置(0xF486, 1, {10, 14})
        && 验证第一写前失败位置(0xF487, 3, {10, 20, 30, 34, 24, 14});

    类型化参与者隔离夹具 撤销失败夹具(0xF500);
    auto 撤销失败请求 = 撤销失败夹具.形成节点请求(1);
    std::vector<int> 撤销失败顺序;
    类型化事务自检参与者 撤销失败项(
        撤销失败顺序, 1, 撤销失败夹具.局部身份, 类型化参与者故障点::撤销返回失败);
    类型化事务自检参与者 后续准备失败项(
        撤销失败顺序, 2, 撤销失败夹具.局部身份, 类型化参与者故障点::准备抛异常);
    撤销失败项.预期幂等身份_ = 撤销失败请求.幂等身份;
    后续准备失败项.预期幂等身份_ = 撤销失败请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 2> 撤销失败组{&撤销失败项, &后续准备失败项};
    const auto 撤销失败结果 = 撤销失败夹具.数据操作.提交带参与者事务(
        撤销失败请求, 撤销失败组);
    auto 隔离后请求 = 撤销失败夹具.形成节点请求(2);
    隔离后请求.预期事实截止代次 = 1;
    const auto 隔离后结果 = 撤销失败夹具.数据操作.提交(隔离后请求);

    类型化参与者隔离夹具 发布失败夹具(0xF600);
    auto 发布失败请求 = 发布失败夹具.形成节点请求(1);
    std::vector<int> 发布失败顺序;
    类型化事务自检参与者 发布失败项(
        发布失败顺序, 1, 发布失败夹具.局部身份, 类型化参与者故障点::发布抛异常);
    发布失败项.预期幂等身份_ = 发布失败请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 1> 发布失败组{&发布失败项};
    const auto 发布失败结果 = 发布失败夹具.数据操作.提交带参与者事务(
        发布失败请求, 发布失败组);

    验收 = {
        类型化结果逐字段相等(旧结果, 空组结果)
            && 同义结果.状态 == 节点直接类型化结构数据操作状态::幂等读回
            && 同义参与者.调用次数() == 0,
        空指针结果.状态 == 节点直接类型化结构数据操作状态::入口拒绝
            && 无效夹具.持久.准备次数 == 1,
        重复结果.状态 == 节点直接类型化结构数据操作状态::入口拒绝
            && 无效夹具.持久.准备次数 == 1,
        参与者一.第一写前视图准确() && 参与者二.第一写前视图准确()
            && 参与者一.视图准确() && 参与者二.视图准确()
            && static_cast<std::uint8_t>(节点直接类型化结构事务参与者状态::第一写前已复核) == 10,
        参与者一.见证准确() && 参与者二.见证准确(),
        成功顺序.size() == 8 && 成功顺序[0] == 10 && 成功顺序[1] == 20
            && 成功顺序[2] == 11 && 成功顺序[3] == 21,
        成功顺序 == std::vector<int>({10, 20, 11, 21, 12, 22, 13, 23}),
        准备失败结果.状态 == 节点直接类型化结构数据操作状态::资源失败
            && 失败顺序 == std::vector<int>({10, 20, 11, 21, 24, 14})
            && 失败前项.已撤销() && 失败项.已撤销()
            && !失败夹具.幂等.读取持久证据侧账(失败请求.幂等身份)
            && 第一写前失败结果.状态 == 节点直接类型化结构数据操作状态::资源失败
            && 第一写前失败顺序 == std::vector<int>({10, 20, 24, 14})
            && 第一写前失败前项.已撤销() && 第一写前失败项.已撤销()
            && 第一写前未调用项.调用次数() == 0
            && 第一写前失败结果.发布代次 == 0
            && 第一写前失败结果.节点组.empty()
            && 第一写前失败夹具.事务域.取得读取许可().读取已发布代次() == 1
            && 准备首项失败结果.状态 == 节点直接类型化结构数据操作状态::资源失败
            && 准备首项失败顺序 == std::vector<int>({10, 20, 30, 11, 34, 24, 14})
            && 准备首项失败项.已撤销() && 准备后项二.已撤销()
            && 准备后项三.已撤销() && 第一写前故障映射完整
            && 第一末项失败覆盖,
        撤销失败结果.状态 == 节点直接类型化结构数据操作状态::内部不一致
            && 撤销失败夹具.幂等.读取持久证据侧账(撤销失败请求.幂等身份).has_value()
            && 隔离后结果.状态 == 节点直接类型化结构数据操作状态::许可拒绝,
        发布失败结果.状态 == 节点直接类型化结构数据操作状态::内部不一致
            && 发布失败结果.发布代次 == 0,
        成功结果.状态 == 节点直接类型化结构数据操作状态::已提交
            && 参与者一.已发布() && 参与者二.已发布()
            && 成功结果.发布代次 == 2};
    return 验收;
}

bool 验证索引占用先于第一写前复核() {
    类型化参与者隔离夹具 夹具(0xF700);
    const 索引物理键 键{0xF700, 1, 1, 1, 0xF701};
    auto 建立请求 = 夹具.形成节点请求(1);
    建立请求.写项组.push_back(节点直接索引创建项{
        键, 节点直接节点端点引用{夹具.局部身份}});
    建立请求.读回规格.项目组.push_back({
        节点直接发布后读回对象种类::当前索引, 键, 0});
    const auto 建立结果 = 夹具.数据操作.提交(建立请求);
    if (建立结果.状态 != 节点直接类型化结构数据操作状态::已提交
        || 建立结果.节点组.size() != 1 || 建立结果.索引组.size() != 1) return false;

    auto 局部冲突请求 = 夹具.形成节点请求(2);
    局部冲突请求.预期事实截止代次 = 2;
    局部冲突请求.写项组.push_back(节点直接索引创建项{
        键, 节点直接节点端点引用{夹具.局部身份}});
    局部冲突请求.读回规格.项目组.push_back({
        节点直接发布后读回对象种类::当前索引, 键, 0});
    std::vector<int> 局部顺序;
    类型化事务自检参与者 局部参与者(局部顺序, 1, 夹具.局部身份);
    局部参与者.预期幂等身份_ = 局部冲突请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 1> 局部组{&局部参与者};
    const auto 局部冲突结果 = 夹具.数据操作.提交带参与者事务(局部冲突请求, 局部组);

    节点直接类型化结构数据操作请求 外部同义请求;
    外部同义请求.安装实例身份 = 夹具.安装实例;
    外部同义请求.幂等身份 = {夹具.安装实例.命名域, 3};
    外部同义请求.请求意图摘要[0] = 3;
    外部同义请求.执行证据摘要[0] = 4;
    外部同义请求.预期事实截止代次 = 2;
    外部同义请求.写项组 = {节点直接索引创建项{
        键, 节点直接节点端点引用{建立结果.节点组.front()}}};
    外部同义请求.读回规格.项目组 = {{
        节点直接发布后读回对象种类::当前索引, 键, 0}};
    std::vector<int> 外部顺序;
    类型化事务自检参与者 外部参与者(外部顺序, 2, 夹具.局部身份);
    外部参与者.预期幂等身份_ = 外部同义请求.幂等身份;
    std::array<节点直接类型化结构事务参与者*, 1> 外部组{&外部参与者};
    const auto 外部同义结果 = 夹具.数据操作.提交带参与者事务(外部同义请求, 外部组);

    return 局部冲突结果.状态 == 节点直接类型化结构数据操作状态::入口拒绝
        && 外部同义结果.状态 == 节点直接类型化结构数据操作状态::入口拒绝
        && 局部参与者.调用次数() == 0 && 外部参与者.调用次数() == 0
        && 夹具.事务域.取得读取许可().读取已发布代次() == 2;
}

struct P1A2节点关系事务证据 { std::array<bool, 32> 验收{}; };

P1A2节点关系事务证据 验证P1A2节点关系事务() {
    P1A2节点关系事务证据 证据;
    节点直接身份仓库 节点(0xA201);
    正式关系仓库 关系(节点, 形成完整准入表(), 0xA202);
    可重建索引仓库 索引(节点, 关系);
    节点直接类型合同仓库 合同;
    节点直接类型化值仓库 值;
    节点直接事务幂等仓库 幂等;
    节点直接身份结构事务域 事务域;
    内存持久证据端口 持久;
    节点直接身份结构写入执行器 执行器(
        &事务域, &节点, &关系, &索引, &合同, &值, &幂等, &持久);
    节点直接类型化结构数据操作 数据操作(执行器);
    const 节点直接事务幂等身份 安装实例{0xA200, 1};
    节点直接类型化结构提交服务 服务(安装实例, 数据操作);

    const auto 治理 = 数据操作.初始化确认空域治理代次(安装实例);
    节点直接类型化结构事务请求 请求;
    请求.幂等身份 = {0xA210, 1};
    请求.请求意图摘要[0] = 0x11;
    请求.执行证据摘要[0] = 0x22;
    请求.预期事实截止代次 = 1;
    const 节点直接写集局部身份 场景局部{节点直接写集局部身份种类::节点, 1};
    const 节点直接写集局部身份 文章局部{节点直接写集局部身份种类::节点, 2};
