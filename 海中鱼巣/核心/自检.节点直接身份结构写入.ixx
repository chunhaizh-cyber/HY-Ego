            && 关系失效提交.发布代次 == 7 && 关系失效提交.关系组.size() == 1
            && 关系失效提交.关系组[0].关系版本 == 2,
        关系失效同义.状态 == 节点直接类型化结构提交状态::幂等读回
            && 关系失效同义.关系组 == 关系失效提交.关系组,
        失效后关系.状态 == 稳定关系当前读取状态::当前已失效
            && 失效后关系.记录 && 失效后关系.记录->版本号 == 2
            && 索引换代前持久次数完整,
        索引换代提交.状态 == 节点直接类型化结构提交状态::已提交
            && 索引换代提交.发布代次 == 8 && 索引换代提交.索引组.size() == 2
            && !索引换代提交.索引组[0].当前
            && 索引换代提交.索引组[0].键 == 文章索引键
            && 索引换代提交.索引组[0].节点目标 == std::optional{值所属身份}
            && 索引换代提交.索引组[1].当前
            && 索引换代提交.索引组[1].键 == 文章索引键二
            && 索引换代提交.索引组[1].节点目标 == std::optional{值所属身份}
            && !旧索引当前 && 新索引当前.has_value()
            && 索引换代同义.状态 == 节点直接类型化结构提交状态::幂等读回
            && 索引换代同义.发布代次 == 8
            && 索引换代同义.索引组 == 索引换代提交.索引组,
        节点删除提交.状态 == 节点直接类型化结构提交状态::已提交
            && 节点删除提交.发布代次 == 9
            && 节点删除提交.索引组.size() == 1
            && !节点删除提交.索引组[0].当前
            && 节点删除提交.索引组[0].键 == 文章索引键二
            && 节点删除提交.索引组[0].节点目标 == std::optional{值所属身份}
            && 节点删除同义.状态 == 节点直接类型化结构提交状态::幂等读回
            && 节点删除同义.发布代次 == 9
            && 删除后节点.状态 == 稳定主键当前身份状态::历史占用
            && !删除后索引.has_value()
            && 持久.准备次数 == 9 && 持久.发布次数 == 9 && 持久.撤销次数 == 0,
        节点恢复候选.状态 == 节点直接恢复仓操作状态::已形成候选
            && 恢复发布前不可见 && 节点恢复已发布
            && 恢复投影.size() == 节点恢复材料.记录组.size()
            && 恢复后材料.下个节点编号 == 节点恢复材料.下个节点编号
            && 恢复后材料.下个创建序号 == 节点恢复材料.下个创建序号
            && 恢复后材料.每域高水位.size() == 节点恢复材料.每域高水位.size()
            && 恢复后材料.历史占用.size() == 节点恢复材料.历史占用.size()
            && 恢复后材料.记录组.size() == 节点恢复材料.记录组.size()};
    return 证据;
}

class 仅参与者事务自检参与者 final : public 节点直接身份结构写入事务参与者 {
public:
    仅参与者事务自检参与者(
        std::vector<int>* 顺序,
        int 标识,
        节点直接身份结构写入状态 准备状态,
        节点直接身份结构写入状态 确认状态 =
            节点直接身份结构写入状态::候选已确认,
        bool 撤销失败 = false) noexcept
        : 顺序_(顺序),
          标识_(标识),
          准备状态_(准备状态),
          确认状态_(确认状态),
          撤销失败_(撤销失败) {
    }

    bool 已发布() const noexcept { return 已发布_; }
    bool 已撤销() const noexcept { return 已撤销_; }
    bool 发布前不可见() const noexcept { return 发布前不可见_; }

private:
    节点直接身份结构写入结果 准备提交(
        const 节点直接身份结构提交准备只读视图&) override {
        顺序_->push_back(标识_ * 10 + 1);
        return {准备状态_, 0, 0, 0};
    }

    节点直接身份结构写入结果 确认待发布() override {
        顺序_->push_back(标识_ * 10 + 2);
        发布前不可见_ = 发布前不可见_ && !已发布_;
        return {确认状态_, 0, 0, 0};
    }

    void 完成发布() noexcept override {
        顺序_->push_back(标识_ * 10 + 3);
        已发布_ = true;
    }

    节点直接身份结构写入结果 完成撤销() override {
        顺序_->push_back(标识_ * 10 + 4);
        已撤销_ = true;
        return {撤销失败_ ? 节点直接身份结构写入状态::内部不一致
                           : 节点直接身份结构写入状态::候选已撤销,
            0, 0, 0};
    }

    std::vector<int>* 顺序_ = nullptr;
    int 标识_ = 0;
    节点直接身份结构写入状态 准备状态_ =
        节点直接身份结构写入状态::内部不一致;
    节点直接身份结构写入状态 确认状态_ =
        节点直接身份结构写入状态::内部不一致;
    bool 撤销失败_ = false;
    bool 已发布_ = false;
    bool 已撤销_ = false;
    bool 发布前不可见_ = true;
};

template <typename 类型>
concept 含主信息字段 = requires(const 类型& 值) { 值.主信息; };

template <typename 类型>
concept 含仓库字段 = requires(const 类型& 值) { 值.仓库; };

template <typename 类型>
concept 含令牌字段 = requires(const 类型& 值) { 值.令牌; };

template <typename 类型>
concept 含可变账字段 = requires(类型& 值) { 值.可变账; };

static_assert(!std::is_same_v<强类型自检参与者<1>, 强类型自检参与者<2>>);
static_assert(!std::is_default_constructible_v<节点直接身份结构提交准备只读视图>);
static_assert(!std::is_copy_constructible_v<节点直接身份结构提交准备只读视图>);
static_assert(!含主信息字段<节点直接身份结构提交准备只读视图>);
static_assert(!含仓库字段<节点直接身份结构提交准备只读视图>);
static_assert(!含令牌字段<节点直接身份结构提交准备只读视图>);
static_assert(!含可变账字段<节点直接身份结构提交准备只读视图>);
static_assert(!含主信息字段<节点直接身份记录>);
static_assert(!含主信息字段<冻结节点直接身份记录>);
static_assert(std::is_aggregate_v<节点直接身份记录>);
static_assert(std::is_aggregate_v<正式关系记录>);
static_assert(std::is_aggregate_v<可重建索引记录>);

bool 验证稳定主键与幂等冲突() {
    隔离夹具 夹具(0x3391);
    const auto 主键一 = 形成稳定主键(节点稳定主键命名域::文章身份, 1);
    const auto 主键二 = 形成稳定主键(节点稳定主键命名域::文章身份, 2);
    节点句柄 撤销节点;
    const auto 撤销结果 = 夹具.执行器.执行([&](节点直接身份结构写入会话& 会话) {
        const auto 创建 = 会话.创建节点候选(节点类型::文章, 主键一);
        if (创建.值.has_value()) {
            撤销节点 = *创建.值;
            (void)会话.读取节点(撤销节点);
        }
        会话.请求撤销();
    });

    节点句柄 当前节点;
    节点直接身份记录 当前记录;
    const auto 提交结果 = 夹具.执行器.执行([&](节点直接身份结构写入会话& 会话) {
        const auto 创建 = 会话.创建节点候选(节点类型::文章, 主键二);
        if (创建.值.has_value()) {
            当前节点 = *创建.值;
            const auto 记录 = 会话.读取节点(当前节点);
            if (记录.has_value()) 当前记录 = *记录;
        }
        会话.请求提交();
    });

    节点直接身份结构写入状态 幂等状态 = 节点直接身份结构写入状态::内部不一致;
    const auto 幂等结果 = 夹具.执行器.执行([&](节点直接身份结构写入会话& 会话) {
        const auto 创建 = 会话.创建节点候选(节点类型::文章, 主键二);
        幂等状态 = 创建.操作.状态;
        会话.请求提交();
    });

    节点直接身份结构写入状态 历史复用状态 = 节点直接身份结构写入状态::内部不一致;
    (void)夹具.执行器.执行([&](节点直接身份结构写入会话& 会话) {
        历史复用状态 = 会话.创建节点候选(节点类型::文章, 主键一).操作.状态;
        会话.请求撤销();
    });

    节点直接身份结构写入状态 异义状态 = 节点直接身份结构写入状态::内部不一致;
    (void)夹具.执行器.执行([&](节点直接身份结构写入会话& 会话) {
        异义状态 = 会话.创建节点候选(节点类型::段落, 主键二).操作.状态;
        会话.请求撤销();
    });

    节点直接身份结构写入状态 未知域状态 = 节点直接身份结构写入状态::内部不一致;
    (void)夹具.执行器.执行([&](节点直接身份结构写入会话& 会话) {
        未知域状态 = 会话.创建节点候选(
            节点类型::文章, {0x4E53'4B59'FFFF'FFFFULL, 1}).操作.状态;
        会话.请求撤销();
    });

    const auto 历史读回 = 夹具.节点.读取稳定主键当前身份(主键一);
    const auto 当前读回 = 夹具.节点.读取稳定主键当前身份(主键二);
    return 稳定主键有效(主键一)
        && 主键一 != 主键二
        && 节点稳定主键命名域ABI版本 == 1
        && static_cast<std::uint32_t>(节点类型::文章) == 16
        && static_cast<std::uint32_t>(节点类型::子句) == 19
        && static_cast<std::uint32_t>(关系类型::状态事实角色) == 19
        && static_cast<std::uint32_t>(关系类型::方法生命周期) == 23
        && 撤销结果.状态 == 节点直接身份结构写入状态::候选已撤销
        && !夹具.节点.读取节点(撤销节点).has_value()
        && 提交结果.状态 == 节点直接身份结构写入状态::已提交
        && 幂等状态 == 节点直接身份结构写入状态::幂等读回
        && 幂等结果.状态 == 节点直接身份结构写入状态::幂等读回
        && 历史复用状态 == 节点直接身份结构写入状态::身份冲突
        && 异义状态 == 节点直接身份结构写入状态::入口拒绝
        && 未知域状态 == 节点直接身份结构写入状态::入口拒绝
        && 夹具.节点.读取命名域高水位(节点稳定主键命名域::文章身份) == 2
        && 历史读回.状态 == 稳定主键当前身份状态::历史占用
        && 当前读回.状态 == 稳定主键当前身份状态::当前有效
        && 当前记录.节点编号 == 当前节点.节点编号
        && 当前记录.稳定主键 == 主键二
        && 当前记录.类型 == 节点类型::文章
        && 当前记录.版本号 == 1
        && 当前记录.状态 == 记录状态::有效
        && 当前记录.创建序号 != 0
        && 夹具.节点.有效节点数量() == 1;
}

struct 主路径证据 {
    bool 节点关系索引通过 = false;
    bool 双参与者通过 = false;
    bool 读取隔离通过 = false;
    bool 冻结通过 = false;
    bool 索引可重建通过 = false;
};

主路径证据 运行主路径() {
    隔离夹具 夹具(0x3392);
    std::vector<int> 参与顺序;
    强类型自检参与者<1> 参与者甲(&参与顺序, 参与者故障点::无);
    强类型自检参与者<2> 参与者乙(&参与顺序, 参与者故障点::无);
    std::array<节点直接身份结构写入事务参与者*, 2> 参与者组{&参与者甲, &参与者乙};
    const auto 主键甲 = 形成稳定主键(节点稳定主键命名域::文章身份, 1);
    const auto 主键乙 = 形成稳定主键(节点稳定主键命名域::文章身份, 2);
    节点句柄 节点甲;
    节点句柄 节点乙;
    std::vector<关系句柄> 关系组;
    const 索引物理键 物理键{0x3392, 1, 1, 1, 1};
    可重建索引记录 索引记录;
    bool 写中普通读取不可见 = false;
    bool 写中读取许可不可得 = false;
    bool 全部形成 = true;

    const auto 执行结果 = 夹具.执行器.执行(
        [&](节点直接身份结构写入会话& 会话) {
            const auto 创建甲 = 会话.创建节点候选(节点类型::文章, 主键甲);
            const auto 创建乙 = 会话.创建节点候选(节点类型::文章, 主键乙);
            全部形成 = 创建甲.成功() && 创建乙.成功();
            if (!全部形成) {
                会话.请求撤销();
                return;
            }
            节点甲 = *创建甲.值;
            节点乙 = *创建乙.值;
            参与者甲.绑定候选(节点甲, 节点类型::文章, 主键甲);
            参与者乙.绑定候选(节点乙, 节点类型::文章, 主键乙);
            全部形成 = 会话.读取节点(节点甲).has_value()
                && 会话.读取节点(节点乙).has_value();
            写中普通读取不可见 = !夹具.节点.读取节点(节点甲).has_value();
            auto 写中读取许可 = 夹具.事务域.取得读取许可();
            写中读取许可不可得 = !写中读取许可.有效();
            for (std::uint32_t 数值 = 0; 数值 < 正式关系类型ABI数量; ++数值) {
                const 关系稳定主键 关系计划键{
                    static_cast<std::uint64_t>(关系稳定主键命名域::正式关系),
                    夹具.关系.读取命名域高水位(关系稳定主键命名域::正式关系) + 1};
                const auto 创建关系 = 会话.创建关系候选(
                    static_cast<关系类型>(数值), 节点甲, 节点乙, 数值, 关系计划键);
                if (!创建关系.成功()) {
                    全部形成 = false;
                    break;
                }
                关系组.push_back(*创建关系.值);
                全部形成 = 会话.读取关系(关系组.back()).has_value() && 全部形成;
            }
            索引记录 = {物理键, 索引目标种类::节点, 节点甲, {}};
            const auto 创建索引 = 会话.创建索引候选(索引记录);
            全部形成 = 创建索引.成功()
                && 会话.读取索引物理键(物理键).has_value()
                && 全部形成;
            if (全部形成) 会话.请求提交(); else 会话.请求撤销();
        },
        std::span<节点直接身份结构写入事务参与者* const>(参与者组));

    auto 发布后读取许可 = 夹具.事务域.取得读取许可();
    const auto 发布关系列表 = 夹具.关系.读取全部关系审计();
    const auto 未知写前数量 = 发布关系列表.size();
    const auto 未知结果 = 夹具.关系.结构化创建关系未发布候选(
        static_cast<关系类型>(24), 节点甲, 节点乙, 0,
        {static_cast<std::uint64_t>(关系稳定主键命名域::正式关系),
            夹具.关系.读取命名域高水位(关系稳定主键命名域::正式关系) + 1},
        0x3392);
    const auto 未知写后数量 = 夹具.关系.读取全部关系审计().size();
    const bool 清空成功 = 夹具.索引.清空可重建索引(0x3392);
    const bool 清空后无命中 = !夹具.索引.读取索引物理键(物理键).has_value();
    const bool 重建成功 = 夹具.索引.从权威记录重建({索引记录}, 0x3392);
    const bool 重建后命中 = 夹具.索引.读取索引物理键(物理键).has_value();
    const auto 冻结 = 冻结节点直接身份结构(夹具.节点, 夹具.关系, 夹具.索引);

    主路径证据 证据;
    证据.节点关系索引通过 = 执行结果.状态 == 节点直接身份结构写入状态::已提交
        && 全部形成
        && 夹具.节点.有效节点数量() == 2
        && 发布关系列表.size() == 正式关系类型ABI数量
        && 未知结果.状态 == 正式关系操作状态::入口拒绝_未知关系类型
        && 未知写前数量 == 未知写后数量
        && 重建后命中;
    证据.双参与者通过 = 参与者甲.已发布() && 参与者乙.已发布()
        && 参与顺序 == std::vector<int>({11, 21, 12, 22, 13, 23});
    证据.读取隔离通过 = 写中普通读取不可见
        && 写中读取许可不可得
        && 发布后读取许可.有效()
        && 夹具.节点.读取节点(节点甲).has_value();
    证据.冻结通过 = 冻结.节点.记录组.size() == 2
        && 冻结.关系.有效失效与历史记录组.size() == 正式关系类型ABI数量
        && 冻结.索引.可从权威结构重建
        && 冻结.索引.记录组.size() == 1
        && 冻结.节点.记录组.front().稳定主键.命名域 != 0;
    证据.索引可重建通过 = 清空成功 && 清空后无命中 && 重建成功 && 重建后命中
        && 夹具.节点.有效节点数量() == 2
        && 夹具.关系.读取全部关系审计().size() == 正式关系类型ABI数量;
    return 证据;
}

bool 形成单事务完整写集(
    隔离夹具& 夹具,
    节点直接身份结构写入会话& 会话,
    节点句柄& 节点甲,
    节点句柄& 节点乙,
    强类型自检参与者<1>& 参与者甲,
    强类型自检参与者<2>& 参与者乙) {
    const auto 主键甲 = 形成稳定主键(节点稳定主键命名域::文章身份, 1);
    const auto 主键乙 = 形成稳定主键(节点稳定主键命名域::文章身份, 2);
    const auto 创建甲 = 会话.创建节点候选(节点类型::文章, 主键甲);
    const auto 创建乙 = 会话.创建节点候选(节点类型::文章, 主键乙);
    if (!创建甲.成功() || !创建乙.成功()) return false;
    节点甲 = *创建甲.值;
    节点乙 = *创建乙.值;
    参与者甲.绑定候选(节点甲, 节点类型::文章, 主键甲);
    参与者乙.绑定候选(节点乙, 节点类型::文章, 主键乙);
    if (!会话.读取节点(节点甲).has_value() || !会话.读取节点(节点乙).has_value()) return false;
    const 关系稳定主键 关系计划键{
        static_cast<std::uint64_t>(关系稳定主键命名域::正式关系),
        夹具.关系.读取命名域高水位(关系稳定主键命名域::正式关系) + 1};
    const auto 关系 = 会话.创建关系候选(
        关系类型::普通父子, 节点甲, 节点乙, 0, 关系计划键);
    if (!关系.成功() || !会话.读取关系(*关系.值).has_value()) return false;
    const 索引物理键 键{0x3393, 1, 1, 1, 1};
    const auto 索引 = 会话.创建索引候选({键, 索引目标种类::节点, 节点甲, {}});
    if (!索引.成功() || !会话.读取索引物理键(键).has_value()) return false;
    return true;
}

bool 验证逆序撤销() {
    auto 运行故障 = [](参与者故障点 乙故障, const std::vector<int>& 预期顺序) {
        隔离夹具 夹具(乙故障 == 参与者故障点::准备 ? 0x3393 : 0x3394);
        std::vector<int> 顺序;
        强类型自检参与者<1> 参与者甲(&顺序, 参与者故障点::无);
        强类型自检参与者<2> 参与者乙(&顺序, 乙故障);
        std::array<节点直接身份结构写入事务参与者*, 2> 参与者组{&参与者甲, &参与者乙};
        节点句柄 节点甲;
        节点句柄 节点乙;
        bool 写集完整 = false;
        const auto 结果 = 夹具.执行器.执行(
            [&](节点直接身份结构写入会话& 会话) {
                写集完整 = 形成单事务完整写集(
                    夹具, 会话, 节点甲, 节点乙, 参与者甲, 参与者乙);
                if (写集完整) 会话.请求提交(); else 会话.请求撤销();
            },
            std::span<节点直接身份结构写入事务参与者* const>(参与者组));
        return 写集完整
            && 结果.状态 == 节点直接身份结构写入状态::内部不一致
            && 参与者甲.已撤销() && 参与者乙.已撤销()
            && 顺序 == 预期顺序
            && 夹具.节点.有效节点数量() == 0
            && 夹具.关系.读取全部关系审计().empty()
            && 夹具.索引.导出可丢弃加速材料().记录组.empty()
            && !夹具.事务域.已隔离();
    };
    return 运行故障(参与者故障点::准备, {11, 21, 24, 14})
        && 运行故障(参与者故障点::确认, {11, 21, 12, 22, 24, 14});
}

bool 验证撤销失败隔离() {
    隔离夹具 夹具(0x3395);
    std::vector<int> 顺序;
    强类型自检参与者<1> 参与者(&顺序, 参与者故障点::撤销);
    节点句柄 节点;
    const auto 结果 = 夹具.执行器.执行(
        [&](节点直接身份结构写入会话& 会话) {
            const auto 主键 = 形成稳定主键(节点稳定主键命名域::文章身份, 1);
            const auto 创建 = 会话.创建节点候选(节点类型::文章, 主键);
            if (创建.值.has_value()) {
                节点 = *创建.值;
                参与者.绑定候选(节点, 节点类型::文章, 主键);
                (void)会话.读取节点(节点);
            }
            会话.请求撤销();
        },
        参与者);
    const auto 后继结果 = 夹具.执行器.执行(
        [](节点直接身份结构写入会话& 会话) { 会话.请求撤销(); });
    auto 读取许可 = 夹具.事务域.取得读取许可();
    return 结果.状态 == 节点直接身份结构写入状态::内部不一致
        && 参与者.已撤销()
        && 夹具.事务域.已隔离()
        && 后继结果.状态 == 节点直接身份结构写入状态::许可拒绝
        && !读取许可.有效()
        && !夹具.节点.读取节点(节点).has_value();
}

bool 验证视图与值式边界() {
    return !std::is_default_constructible_v<节点直接身份结构提交准备只读视图>
        && !std::is_copy_constructible_v<节点直接身份结构提交准备只读视图>
        && !含主信息字段<节点直接身份结构提交准备只读视图>
        && !含仓库字段<节点直接身份结构提交准备只读视图>
        && !含令牌字段<节点直接身份结构提交准备只读视图>
        && !含可变账字段<节点直接身份结构提交准备只读视图>
        && !含主信息字段<节点直接身份记录>
        && !含主信息字段<冻结节点直接身份记录>;
}

struct 世界树P1A1证据 {
    std::array<bool, 15> 验收{};
};

bool 发布三个关系自检节点(
    隔离夹具& 夹具,
    std::array<节点句柄, 3>& 节点组,
    std::array<节点稳定身份见证, 3>& 见证组) {
    const auto 结果 = 夹具.执行器.执行([&](节点直接身份结构写入会话& 会话) {
        bool 全部成功 = true;
        for (std::size_t 序号 = 0; 序号 < 节点组.size(); ++序号) {
            const auto 稳定主键 = 形成稳定主键(
                节点稳定主键命名域::文章身份, static_cast<std::uint64_t>(序号 + 1));
            const auto 创建 = 会话.创建节点候选(节点类型::文章, 稳定主键);
            if (!创建.值.has_value()) {
                全部成功 = false;
                break;
            }
            节点组[序号] = *创建.值;
            if (!会话.读取节点(节点组[序号]).has_value()) {
                全部成功 = false;
                break;
            }
        }
        if (全部成功) 会话.请求提交(); else 会话.请求撤销();
    });
    if (结果.状态 != 节点直接身份结构写入状态::已提交) return false;
    for (std::size_t 序号 = 0; 序号 < 节点组.size(); ++序号) {
        const auto 记录 = 夹具.节点.读取节点(节点组[序号]);
        if (!记录.has_value()) return false;
        见证组[序号] = {记录->稳定主键, 记录->类型, 记录->版本号};
    }
    return true;
}

世界树P1A1证据 验证世界树P1A1记录仓() {
    世界树P1A1证据 证据;

    隔离夹具 关系夹具(0xA1A100);
    std::array<节点句柄, 3> 节点组{};
    std::array<节点稳定身份见证, 3> 见证组{};
    const bool 节点就绪 = 发布三个关系自检节点(关系夹具, 节点组, 见证组);
    const auto 命名域值 = static_cast<std::uint64_t>(关系稳定主键命名域::正式关系);
    const 关系稳定主键 稳定键一{命名域值, 1};
    const 关系稳定主键 稳定键二{命名域值, 2};
    auto 关系一 = 节点就绪
        ? 关系夹具.关系.结构化创建关系未发布候选(
            关系类型::状态事实角色, 节点组[0], 节点组[1], 20, 稳定键一, 0xA1A101)
        : 正式关系写入结果{};
    const bool 关系一候选可见 = 关系一.候选.has_value()
        && 关系一.候选->读取写后记录().稳定主键 == 稳定键一
        && 关系夹具.关系.读取稳定主键当前关系(稳定键一).状态
            == 稳定关系当前读取状态::未占用
        && 关系夹具.关系.读取稳定主键当前关系(稳定键一, 0xA1A101).状态
            == 稳定关系当前读取状态::当前有效
        && 关系夹具.关系.读取有效源关系组(
            节点组[0], 关系类型::状态事实角色).关系组.empty()
        && 关系夹具.关系.读取有效源关系组(
            节点组[0], 关系类型::状态事实角色, 0xA1A101).关系组.size() == 1;
    bool 关系一已发布 = false;
    if (关系一.候选.has_value()
        && 关系夹具.关系.确认候选(*关系一.候选, 0xA1A101)
            == 正式关系操作状态::已确认待发布) {
        关系夹具.关系.完成发布(*关系一.候选, 0xA1A101);
        关系一已发布 = 关系一.候选->读取阶段() == 正式关系候选阶段::已发布;
    }

    auto 撤销关系二 = 节点就绪
        ? 关系夹具.关系.结构化创建关系未发布候选(
            关系类型::状态事实角色, 节点组[0], 节点组[2], 10, 稳定键二, 0xA1A102)
        : 正式关系写入结果{};
    const bool 关系二撤销 = 撤销关系二.候选.has_value()
        && 关系夹具.关系.撤销候选(*撤销关系二.候选, 0xA1A102)
            == 正式关系操作状态::已撤销
        && 关系夹具.关系.读取命名域高水位(关系稳定主键命名域::正式关系) == 1;
    auto 关系二 = 节点就绪
        ? 关系夹具.关系.结构化创建关系未发布候选(
            关系类型::状态事实角色, 节点组[0], 节点组[2], 10, 稳定键二, 0xA1A103)
        : 正式关系写入结果{};
    bool 关系二已发布 = false;
    if (关系二.候选.has_value()
        && 关系夹具.关系.确认候选(*关系二.候选, 0xA1A103)
            == 正式关系操作状态::已确认待发布) {
        关系夹具.关系.完成发布(*关系二.候选, 0xA1A103);
        关系二已发布 = 关系二.候选->读取阶段() == 正式关系候选阶段::已发布;
    }
    const auto 源组 = 关系夹具.关系.读取有效源关系组(
        节点组[0], 关系类型::状态事实角色);
    const auto 目标组 = 关系夹具.关系.读取有效目标关系组(
        节点组[2], 关系类型::状态事实角色);
    const auto 相关组 = 关系夹具.关系.读取有效相关关系组(节点组[0]);
    const auto 空组 = 关系夹具.关系.读取有效源关系组(
        节点组[2], 关系类型::状态事实角色);
    const auto 无效组 = 关系夹具.关系.读取有效源关系组(
        节点句柄{}, 关系类型::状态事实角色);
    const auto 零事务读取 = 关系夹具.关系.读取稳定主键当前关系(稳定键一, 0);
    const auto 无效端点 = 关系夹具.关系.结构化创建关系未发布候选(
        关系类型::状态事实角色, 节点组[0], 节点句柄{}, 30,
        {命名域值, 3}, 0xA1A104);
    const auto 权威关系材料 = 关系夹具.关系.导出权威状态();

    节点直接类型合同仓库 合同仓;
    const 类型合同读回 合同一{
        {static_cast<std::uint64_t>(类型合同稳定身份命名域::L2领域合同), 1},
        {static_cast<std::uint64_t>(类型合同命名域::L2领域), 1},
        1,
        类型化值表示种类::I64标量,
        I64标量值域{-100, 100},
        {static_cast<std::uint64_t>(服务稳定身份命名域::L2领域服务), 1},
        类型合同生命周期状态::当前可写,
        {},
        1,
        1};
    auto 合同候选一 = 合同仓.结构化发布合同未发布候选(合同一, 0xA1A201);
    const bool 合同候选可见 = 合同候选一.候选.has_value()
        && 合同候选一.候选->读取候选合同() == std::optional<类型合同读回>{合同一}
        && !合同仓.读取精确合同(合同一.合同身份, 合同一.合同版本).has_value();
    const auto 合同同义 = 合同仓.结构化发布合同未发布候选(合同一, 0xA1A201);
    auto 合同异义值 = 合同一;
    合同异义值.生命周期 = 类型合同生命周期状态::停止新写;
    const auto 合同异义 = 合同仓.结构化发布合同未发布候选(合同异义值, 0xA1A201);
    bool 合同已发布 = false;
    if (合同候选一.候选.has_value()
        && 合同仓.确认候选(*合同候选一.候选, 0xA1A201)
            == 节点直接仓候选操作状态::已确认待发布) {
        合同已发布 = 合同仓.完成发布(*合同候选一.候选, 0xA1A201)
            == 节点直接仓候选操作状态::已发布;
    }
    auto 合同二 = 合同一;
    合同二.合同身份.键值 = 2;
    auto 合同候选二 = 合同仓.结构化发布合同未发布候选(合同二, 0xA1A202);
    const bool 合同撤销 = 合同候选二.候选.has_value()
        && 合同仓.撤销候选(*合同候选二.候选, 0xA1A202)
            == 节点直接仓候选操作状态::已撤销
        && !合同仓.读取精确合同(合同二.合同身份, 合同二.合同版本).has_value();

    节点直接类型化值仓库 值仓;
    const 服务稳定身份 来源服务{
        static_cast<std::uint64_t>(服务稳定身份命名域::L2领域服务), 1};
    const 类型化值读回 值一{
        见证组[0], 合同一.合同身份, 1,
        {static_cast<std::uint64_t>(类型化值记录稳定身份命名域::通用类型化值记录), 1},
        1, true, std::int64_t{7}, 类型化值来源见证{来源服务}, std::nullopt, 1, 1};
    auto 值候选一 = 节点就绪
        ? 值仓.结构化发布值未发布候选(值一, 0xA1A301)
        : 节点直接类型化值候选结果{};
    const bool 值一候选可见 = 值候选一.候选.has_value()
        && 值候选一.候选->读取候选值() == std::optional<类型化值读回>{值一}
        && 值仓.读取所属身份当前值组(值一.所属身份.稳定主键).empty();
    bool 值一已发布 = false;
    if (值候选一.候选.has_value()
        && 值仓.确认候选(*值候选一.候选, 0xA1A301)
            == 节点直接仓候选操作状态::已确认待发布) {
        值一已发布 = 值仓.完成发布(*值候选一.候选, 0xA1A301)
            == 节点直接仓候选操作状态::已发布;
    }
    auto 值二 = 值一;
    值二.值记录身份.键值 = 2;
    值二.值记录版本 = 2;
    值二.材料 = std::int64_t{8};
    值二.前一值记录版本 = 1;
    值二.当前状态发布代次 = 2;
    auto 值候选二 = 值仓.结构化发布值未发布候选(值二, 0xA1A302);
    const bool 换代发布前仍为旧值 = 值候选二.候选.has_value()
        && 值仓.读取所属身份当前值组(值一.所属身份.稳定主键)
            == std::vector<类型化值读回>{值一};
    bool 值二已发布 = false;
    if (值候选二.候选.has_value()
        && 值仓.确认候选(*值候选二.候选, 0xA1A302)
            == 节点直接仓候选操作状态::已确认待发布) {
        值二已发布 = 值仓.完成发布(*值候选二.候选, 0xA1A302)
            == 节点直接仓候选操作状态::已发布;
    }
    const auto 换代后当前值 = 值仓.读取所属身份当前值组(值一.所属身份.稳定主键);
    auto 退役候选 = 值仓.结构化退役值未发布候选(值二, 3, 0xA1A303);
    const bool 退役撤销恢复 = 退役候选.候选.has_value()
        && 值仓.撤销候选(*退役候选.候选, 0xA1A303)
            == 节点直接仓候选操作状态::已撤销
        && 值仓.读取所属身份当前值组(值一.所属身份.稳定主键)
            == std::vector<类型化值读回>{值二};
    auto 退役发布候选 = 值仓.结构化退役值未发布候选(值二, 3, 0xA1A304);
    bool 退役已发布 = false;
    if (退役发布候选.候选.has_value()
        && 值仓.确认候选(*退役发布候选.候选, 0xA1A304)
            == 节点直接仓候选操作状态::已确认待发布) {
        退役已发布 = 值仓.完成发布(*退役发布候选.候选, 0xA1A304)
            == 节点直接仓候选操作状态::已发布;
    }

    节点直接事务幂等仓库 幂等仓;
    节点直接事务幂等记录 幂等记录;
    幂等记录.幂等身份 = {
        static_cast<std::uint64_t>(节点直接事务命名域::安装实例初始化), 1};
    幂等记录.请求意图摘要[0] = 1;
    幂等记录.执行证据摘要[0] = 2;
    幂等记录.写集材料 = {1, 2, 3};
    幂等记录.发布代次 = 1;
    幂等记录.结果摘要[0] = 3;
    幂等记录.节点组 = {见证组[0]};
    auto 幂等候选 = 节点就绪
        ? 幂等仓.结构化建立记录未发布候选(幂等记录, 0xA1A401)
        : 节点直接事务幂等候选结果{};
    const bool 幂等候选可见 = 幂等候选.候选.has_value()
        && 幂等候选.候选->读取候选记录() == std::optional<节点直接事务幂等记录>{幂等记录}
        && !幂等仓.读取(幂等记录.幂等身份).has_value();
    const auto 幂等同义 = 幂等仓.结构化建立记录未发布候选(幂等记录, 0xA1A401);
    auto 幂等异义值 = 幂等记录;
    幂等异义值.写集材料.push_back(4);
    const auto 幂等异义 = 幂等仓.结构化建立记录未发布候选(幂等异义值, 0xA1A401);
    bool 幂等已发布 = false;
    if (幂等候选.候选.has_value()
        && 幂等仓.确认候选(*幂等候选.候选, 0xA1A401)
            == 节点直接仓候选操作状态::已确认待发布) {
        幂等已发布 = 幂等仓.完成发布(*幂等候选.候选, 0xA1A401)
            == 节点直接仓候选操作状态::已发布;
    }
    const auto 发布后幂等记录 = 幂等仓.读取(幂等记录.幂等身份);
    const bool 侧账单调 = 幂等仓.读取持久证据状态(幂等记录.幂等身份)
            == 持久证据状态::不适用
        && 幂等仓.建立临时持久证据侧账(幂等记录.幂等身份, 1)
        && 幂等仓.读取持久证据状态(幂等记录.幂等身份)
            == 持久证据状态::待持久化
        && 幂等仓.单调记录持久证据状态(幂等记录.幂等身份, 持久证据状态::持久化结果未知)
        && 幂等仓.单调记录持久证据状态(幂等记录.幂等身份, 持久证据状态::已与内存代次一致)
        && !幂等仓.单调记录持久证据状态(幂等记录.幂等身份, 持久证据状态::待持久化)
        && 幂等仓.读取持久证据状态(幂等记录.幂等身份)
            == 持久证据状态::已与内存代次一致;


    证据.验收 = {
        关系稳定主键命名域ABI版本 == 1 && 类型合同稳定身份ABI版本 == 1
            && 类型合同命名空间ABI版本 == 1,
        节点就绪 && 关系一候选可见 && 关系一已发布,
        关系二撤销 && 关系二已发布
            && 关系夹具.关系.读取命名域高水位(关系稳定主键命名域::正式关系) == 2,
        源组.状态 == 稳定关系组读取状态::已读取 && 源组.关系组.size() == 2
            && 源组.关系组[0].稳定主键 == 稳定键一
            && 源组.关系组[1].稳定主键 == 稳定键二
            && 目标组.状态 == 稳定关系组读取状态::已读取 && 目标组.关系组.size() == 1
            && 相关组.状态 == 稳定关系组读取状态::已读取 && 相关组.关系组.size() == 2,
        空组.状态 == 稳定关系组读取状态::已读取 && 空组.关系组.empty()
            && 无效组.状态 == 稳定关系组读取状态::入口拒绝
            && 零事务读取.状态 == 稳定关系当前读取状态::内部不一致
            && 无效端点.状态 == 正式关系操作状态::入口拒绝_无效端点,
        权威关系材料.每域高水位.size() == 1
            && 权威关系材料.历史占用.size() == 2
            && 权威关系材料.记录组.size() == 2
            && 权威关系材料.记录组[0].稳定主键 == 稳定键一
            && 权威关系材料.记录组[1].稳定主键 == 稳定键二,
        合同候选可见 && 合同已发布
            && 合同仓.读取精确合同(合同一.合同身份, 1) == std::optional<类型合同读回>{合同一},
        合同同义.状态 == 节点直接仓候选操作状态::精确同义
            && 合同异义.状态 == 节点直接仓候选操作状态::内部不一致 && 合同撤销,
        值一候选可见 && 值一已发布,
        换代发布前仍为旧值 && 值二已发布 && 换代后当前值 == std::vector<类型化值读回>{值二},
        退役撤销恢复 && 退役已发布
            && 值仓.读取所属身份当前值组(值一.所属身份.稳定主键).empty(),
        std::holds_alternative<服务稳定身份>(值一.来源)
            && std::get<服务稳定身份>(值一.来源) == 来源服务,
        幂等候选可见 && 幂等已发布 && 发布后幂等记录.has_value()
            && 发布后幂等记录->状态 == 节点直接事务幂等记录状态::已发布,
        幂等同义.状态 == 节点直接仓候选操作状态::精确同义
            && 幂等异义.状态 == 节点直接仓候选操作状态::内部不一致
            && 侧账单调 && 发布后幂等记录->写集材料 == 幂等记录.写集材料,
        索引物理键完整({1, 1, 1, 1, 1})
            && std::is_aggregate_v<索引物理键>
            && std::is_aggregate_v<类型合同读回>
            && std::is_aggregate_v<类型化值读回>};
    return 证据;
}

bool 验证新域隔离() {
    隔离夹具 未接入夹具(0x3396);
    return 未接入夹具.节点.有效节点数量() == 0
        && 未接入夹具.关系.读取全部关系审计().empty()
        && 未接入夹具.索引.导出可丢弃加速材料().记录组.empty()
        && !未接入夹具.事务域.已隔离();
}

struct 仅参与者事务证据 {
    std::array<bool, 12> 验收{};
};

bool 验证六仓批量恢复事务() {
    节点直接身份仓库 节点(0xA330);
    正式关系仓库 关系(节点, 形成完整准入表(), 0xA331);
    可重建索引仓库 索引(节点, 关系);
    节点直接类型合同仓库 合同;
    节点直接类型化值仓库 值;
    节点直接事务幂等仓库 幂等;
    内存持久证据端口 持久;
    节点直接身份结构事务域 事务域(节点直接身份结构事务域启动模式::等待恢复);
    节点直接身份结构写入执行器 执行器(
        &事务域, &节点, &关系, &索引, &合同, &值, &幂等, &持久);

    const 节点稳定身份见证 文章{{
        static_cast<std::uint64_t>(节点稳定主键命名域::文章身份), 1}, 节点类型::文章, 1};
    const 节点稳定身份见证 场景{{
        static_cast<std::uint64_t>(节点稳定主键命名域::场景身份), 1}, 节点类型::场景, 1};
    const 关系稳定身份见证 父子{{
        static_cast<std::uint64_t>(关系稳定主键命名域::正式关系), 1},
        关系类型::普通父子, 1, 场景, 文章, 7};
    const 索引物理键 键{0xA330, 1, 1, 1, 1};
    const 节点直接事务幂等身份 安装{0xA330, 1};
    const 节点直接事务幂等身份 事务{0xA330, 2};

    节点直接恢复结构事务请求 请求;
    请求.安装实例身份 = 安装;
    请求.恢复事实截止代次 = 1;
    请求.高水位组 = {
        {节点直接恢复占用种类::节点, 文章.稳定主键.命名域, 1},
        {节点直接恢复占用种类::节点, 场景.稳定主键.命名域, 1},
        {节点直接恢复占用种类::关系, 父子.稳定主键.命名域, 1}};
    请求.历史占用组 = {
        {节点直接恢复占用种类::节点, 文章.稳定主键.命名域, 1, 节点类型::文章},
        {节点直接恢复占用种类::节点, 场景.稳定主键.命名域, 1, 节点类型::场景},
        {节点直接恢复占用种类::关系, 父子.稳定主键.命名域, 1, 节点类型::未分类}};
    请求.节点历史组 = {{文章, true}, {场景, true}};
    请求.关系历史组 = {{父子, true}};
    请求.索引历史组 = {{键, true, 文章, std::nullopt}};
    节点直接事务幂等记录 记录;
    记录.安装实例身份 = 安装;
    记录.幂等身份 = 事务;
    记录.请求意图摘要.fill(1);
    记录.执行证据摘要.fill(2);
    记录.写集材料 = {2};
    记录.状态 = 节点直接事务幂等记录状态::已发布;
    记录.发布代次 = 1;
    记录.结果摘要.fill(3);
    记录.节点组 = {文章, 场景};
    记录.关系组 = {父子};
    记录.索引组 = {{键, true, 文章, std::nullopt}};
    请求.幂等历史组 = {记录};
    请求.持久证据状态组 = {{事务, 1, 持久证据状态::已与内存代次一致}};

    const auto 恢复 = 执行器.执行节点直接恢复事务({请求});
    const auto 读取许可 = 事务域.取得读取许可();
    const auto 文章当前 = 节点.读取稳定主键当前身份(文章.稳定主键);
    const auto 场景当前 = 节点.读取稳定主键当前身份(场景.稳定主键);
    const auto 关系当前 = 关系.读取稳定主键当前关系(父子.稳定主键);
    const auto 索引当前 = 索引.读取索引物理键(键);
    const auto 幂等当前 = 幂等.读取(事务);
    return 恢复.状态 == 节点直接恢复数据操作状态::已恢复
        && 恢复.事实截止代次 == 1 && 读取许可.有效()
        && 读取许可.读取已发布代次() == 1
        && 文章当前.状态 == 稳定主键当前身份状态::当前有效
        && 场景当前.状态 == 稳定主键当前身份状态::当前有效
        && 关系当前.状态 == 稳定关系当前读取状态::当前有效
        && 索引当前.has_value() && 幂等当前.has_value()
        && 幂等.读取持久证据状态(事务) == 持久证据状态::已与内存代次一致;
}

std::array<bool, 2> 验证格式二材料经数据操作恢复() {
    const 节点直接事务幂等身份 安装{0xA340, 1};
    内存持久证据端口 来源持久;
    节点直接身份仓库 来源节点(0xA341);
    正式关系仓库 来源关系(来源节点, 形成完整准入表(), 0xA342);
    可重建索引仓库 来源索引(来源节点, 来源关系);
    节点直接类型合同仓库 来源合同;
    节点直接类型化值仓库 来源值;
    节点直接事务幂等仓库 来源幂等;
    节点直接身份结构事务域 来源事务域;
    节点直接身份结构写入执行器 来源执行器(
        &来源事务域, &来源节点, &来源关系, &来源索引,
        &来源合同, &来源值, &来源幂等, &来源持久);
    节点直接类型化结构数据操作 来源数据操作(来源执行器);
    const auto 治理 = 来源数据操作.初始化确认空域治理代次(安装);
    节点直接类型化结构数据操作请求 请求;
    请求.安装实例身份 = 安装;
    请求.幂等身份 = {0xA340, 2};
    请求.请求意图摘要[0] = 0x34;
    请求.执行证据摘要[0] = 0x56;
    请求.预期事实截止代次 = 1;
    const 节点直接写集局部身份 局部{节点直接写集局部身份种类::节点, 1};
    请求.写项组 = {节点直接节点创建项{
        局部, 节点稳定主键命名域::文章身份, 节点类型::文章}};
    请求.读回规格.项目组 = {{节点直接发布后读回对象种类::当前节点, 局部, 1}};
    const auto 提交 = 来源数据操作.提交(请求);
    const 索引物理键 恢复索引键{0xA340, 1, 1, 1, 0xA341};
    节点直接类型化结构数据操作请求 索引请求;
    索引请求.安装实例身份 = 安装;
    索引请求.幂等身份 = {0xA340, 3};
    索引请求.请求意图摘要[0] = 0x78;
    索引请求.执行证据摘要[0] = 0x9A;
    索引请求.预期事实截止代次 = 2;
    if (!提交.节点组.empty()) {
        索引请求.写项组 = {节点直接索引创建项{恢复索引键, 提交.节点组.front()}};
        索引请求.读回规格.项目组 = {{
            节点直接发布后读回对象种类::当前索引, 恢复索引键, 0}};
    }
    const auto 索引提交 = 来源数据操作.提交(索引请求);

    auto 执行恢复 = [&](std::vector<节点直接持久事务证据> 材料组) {
        节点直接身份仓库 节点(0xA343);
        正式关系仓库 关系(节点, 形成完整准入表(), 0xA344);
        可重建索引仓库 索引(节点, 关系);
        节点直接类型合同仓库 合同;
        节点直接类型化值仓库 值;
        节点直接事务幂等仓库 幂等;
        内存持久证据端口 持久;
        节点直接身份结构事务域 事务域(节点直接身份结构事务域启动模式::等待恢复);
        节点直接身份结构写入执行器 执行器(
            &事务域, &节点, &关系, &索引, &合同, &值, &幂等, &持久);
        节点直接类型化结构数据操作 数据操作(执行器);
        const auto 恢复 = 数据操作.恢复(安装,
            {节点直接安装实例证据状态::存在事务证据, std::move(材料组)});
        const auto 当前 = 节点.读取稳定主键当前身份({
            static_cast<std::uint64_t>(节点稳定主键命名域::文章身份), 1});
        return std::pair{恢复, 当前.状态 == 稳定主键当前身份状态::当前有效
            && 索引.读取索引物理键(恢复索引键).has_value()};
    };

    const auto 正常 = 执行恢复(来源持久.已见证组);
    auto 旧格式材料 = 来源持久.已见证组;
    if (!旧格式材料.empty() && 旧格式材料.front().写集材料.size() >= 4)
        旧格式材料.front().写集材料[3] = 1;
    const auto 旧格式 = 执行恢复(std::move(旧格式材料));
    auto 截断材料 = 来源持久.已见证组;
    if (!截断材料.empty()) 截断材料.back().写集材料.pop_back();
    const auto 截断 = 执行恢复(std::move(截断材料));
    auto 尾随材料 = 来源持久.已见证组;
    if (!尾随材料.empty()) 尾随材料.back().写集材料.push_back(0);
    const auto 尾随 = 执行恢复(std::move(尾随材料));
    auto 代次断序材料 = 来源持久.已见证组;
    if (!代次断序材料.empty()) 代次断序材料.back().发布代次 = 4;
    const auto 代次断序 = 执行恢复(std::move(代次断序材料));
    auto 索引非零版本材料 = 来源持久.已见证组;
    if (!索引非零版本材料.empty() && 索引非零版本材料.back().写集材料.size() >= 37)
        索引非零版本材料.back().写集材料[索引非零版本材料.back().写集材料.size() - 30] = 1;
    const auto 索引非零版本 = 执行恢复(std::move(索引非零版本材料));
    return {
        治理.状态 == 节点直接类型化结构数据操作状态::已提交
            && 提交.状态 == 节点直接类型化结构数据操作状态::已提交
            && 索引提交.状态 == 节点直接类型化结构数据操作状态::已提交
            && 来源持久.已见证组.size() == 3
            && 正常.first.状态 == 节点直接恢复数据操作状态::已恢复
            && 正常.first.事实截止代次 == 3 && 正常.second,
        旧格式.first.状态 == 节点直接恢复数据操作状态::格式不支持 && !旧格式.second
            && 截断.first.状态 == 节点直接恢复数据操作状态::格式不支持 && !截断.second
            && 尾随.first.状态 == 节点直接恢复数据操作状态::格式不支持 && !尾随.second
            && 代次断序.first.状态 == 节点直接恢复数据操作状态::版本漂移 && !代次断序.second
            && 索引非零版本.first.状态 == 节点直接恢复数据操作状态::格式不支持
            && !索引非零版本.second};
}

仅参与者事务证据 验证仅参与者事务() {
    仅参与者事务证据 证据;

    隔离夹具 入口夹具(0x3811);
    const std::span<节点直接身份结构写入事务参与者* const> 空参与者组;
    const auto 空组结果 = 入口夹具.执行器.执行仅参与者事务(空参与者组);

    std::vector<int> 入口顺序;
    仅参与者事务自检参与者 入口参与者(
        &入口顺序, 1, 节点直接身份结构写入状态::已提交);
    std::array<节点直接身份结构写入事务参与者*, 1> 空指针组{nullptr};
    std::array<节点直接身份结构写入事务参与者*, 2> 重复组{
        &入口参与者, &入口参与者};
    const auto 空指针结果 = 入口夹具.执行器.执行仅参与者事务(空指针组);
    const auto 重复结果 = 入口夹具.执行器.执行仅参与者事务(重复组);
    const auto 普通空写集结果 = 入口夹具.执行器.执行(
        [](节点直接身份结构写入会话& 会话) { 会话.请求提交(); });

    隔离夹具 单参与者夹具(0x3812);
    std::vector<int> 单参与者顺序;
    仅参与者事务自检参与者 单参与者(
        &单参与者顺序, 1, 节点直接身份结构写入状态::已提交);
    std::array<节点直接身份结构写入事务参与者*, 1> 单参与者组{&单参与者};
    const auto 单参与者结果 =
        单参与者夹具.执行器.执行仅参与者事务(单参与者组);

    隔离夹具 双参与者夹具(0x3813);
    std::vector<int> 双参与者顺序;
    仅参与者事务自检参与者 双参与者甲(
        &双参与者顺序, 1, 节点直接身份结构写入状态::已提交);
    仅参与者事务自检参与者 双参与者乙(
        &双参与者顺序, 2, 节点直接身份结构写入状态::已提交);
    std::array<节点直接身份结构写入事务参与者*, 2> 双参与者组{
        &双参与者甲, &双参与者乙};
    const auto 双参与者结果 =
        双参与者夹具.执行器.执行仅参与者事务(双参与者组);

    隔离夹具 全幂等夹具(0x3814);
    std::vector<int> 全幂等顺序;
    仅参与者事务自检参与者 全幂等甲(
        &全幂等顺序, 1, 节点直接身份结构写入状态::幂等读回);
    仅参与者事务自检参与者 全幂等乙(
        &全幂等顺序, 2, 节点直接身份结构写入状态::幂等读回);
    std::array<节点直接身份结构写入事务参与者*, 2> 全幂等组{&全幂等甲, &全幂等乙};
    const auto 全幂等结果 = 全幂等夹具.执行器.执行仅参与者事务(全幂等组);

    隔离夹具 混合夹具(0x3815);
    std::vector<int> 混合顺序;
    仅参与者事务自检参与者 混合幂等(
        &混合顺序, 1, 节点直接身份结构写入状态::幂等读回);
    仅参与者事务自检参与者 混合新候选(
        &混合顺序, 2, 节点直接身份结构写入状态::已提交);
    std::array<节点直接身份结构写入事务参与者*, 2> 混合组{
        &混合幂等, &混合新候选};
    const auto 混合结果 = 混合夹具.执行器.执行仅参与者事务(混合组);

    auto 验证故障逆序撤销 = [](
        节点直接身份结构写入状态 第二准备状态,
        节点直接身份结构写入状态 第二确认状态,
        const std::vector<int>& 预期顺序,
        std::uint64_t 仓库基数) {
        隔离夹具 夹具(仓库基数);
        std::vector<int> 顺序;
        仅参与者事务自检参与者 参与者甲(
            &顺序, 1, 节点直接身份结构写入状态::已提交);
        仅参与者事务自检参与者 参与者乙(
            &顺序, 2, 第二准备状态, 第二确认状态);
        std::array<节点直接身份结构写入事务参与者*, 2> 参与者组{
            &参与者甲, &参与者乙};
        const auto 结果 = 夹具.执行器.执行仅参与者事务(参与者组);
        return 结果.状态 == 节点直接身份结构写入状态::内部不一致
            && 参与者甲.已撤销() && 参与者乙.已撤销()
            && 顺序 == 预期顺序 && !夹具.事务域.已隔离();
    };
    const bool 故障逆序撤销通过 = 验证故障逆序撤销(
        节点直接身份结构写入状态::内部不一致,
        节点直接身份结构写入状态::候选已确认,
        {11, 21, 24, 14},
        0x3816)
        && 验证故障逆序撤销(
            节点直接身份结构写入状态::已提交,
            节点直接身份结构写入状态::内部不一致,
            {11, 21, 12, 22, 24, 14},
            0x3817);

    隔离夹具 分类夹具(0x3818);
    std::vector<int> 资源顺序;
    仅参与者事务自检参与者 资源参与者(
        &资源顺序, 1, 节点直接身份结构写入状态::资源失败);
    std::array<节点直接身份结构写入事务参与者*, 1> 资源组{&资源参与者};
    const auto 资源结果 = 分类夹具.执行器.执行仅参与者事务(资源组);

    std::vector<int> 内部顺序;
    仅参与者事务自检参与者 内部参与者(
        &内部顺序, 1, 节点直接身份结构写入状态::候选已确认);
    std::array<节点直接身份结构写入事务参与者*, 1> 内部组{&内部参与者};
    const auto 内部结果 = 分类夹具.执行器.执行仅参与者事务(内部组);

    隔离夹具 隔离夹具实例(0x3819);
    std::vector<int> 隔离顺序;
    仅参与者事务自检参与者 隔离参与者(
        &隔离顺序, 1, 节点直接身份结构写入状态::资源失败,
        节点直接身份结构写入状态::候选已确认, true);
    std::array<节点直接身份结构写入事务参与者*, 1> 隔离组{&隔离参与者};
    const auto 隔离结果 = 隔离夹具实例.执行器.执行仅参与者事务(隔离组);
    std::vector<int> 后继顺序;
    仅参与者事务自检参与者 后继参与者(
        &后继顺序, 1, 节点直接身份结构写入状态::已提交);
    std::array<节点直接身份结构写入事务参与者*, 1> 后继组{&后继参与者};
    const auto 后继结果 = 隔离夹具实例.执行器.执行仅参与者事务(后继组);

    证据.验收 = {
        空组结果.状态 == 节点直接身份结构写入状态::入口拒绝,
        空指针结果.状态 == 节点直接身份结构写入状态::入口拒绝,
        重复结果.状态 == 节点直接身份结构写入状态::入口拒绝,
        普通空写集结果.状态 == 节点直接身份结构写入状态::内部不一致,
        单参与者结果.状态 == 节点直接身份结构写入状态::已提交
            && 单参与者.已发布(),
        双参与者结果.状态 == 节点直接身份结构写入状态::已提交
            && 双参与者顺序 == std::vector<int>({11, 21, 12, 22, 13, 23}),
        全幂等结果.状态 == 节点直接身份结构写入状态::幂等读回,
        混合结果.状态 == 节点直接身份结构写入状态::已提交,
        故障逆序撤销通过,
        单参与者.发布前不可见() && 单参与者.已发布(),
        资源结果.状态 == 节点直接身份结构写入状态::资源失败
            && 内部结果.状态 == 节点直接身份结构写入状态::内部不一致
            && 隔离结果.状态 == 节点直接身份结构写入状态::内部不一致
            && 隔离夹具实例.事务域.已隔离()
            && 后继结果.状态 == 节点直接身份结构写入状态::许可拒绝,
        单参与者结果.结构编号 == 0
            && 单参与者结果.请求版本 == 0
            && 单参与者结果.当前版本 == 0
            && 单参与者夹具.节点.有效节点数量() == 0
            && 单参与者夹具.关系.读取全部关系审计().empty()
            && 单参与者夹具.索引.导出可丢弃加速材料().记录组.empty()};
    return 证据;
}

class 两级投影许可占用参与者 final : public 节点直接身份结构写入事务参与者 {
public:
    两级投影许可占用参与者(std::atomic_bool& 已进入, std::atomic_bool& 可退出) noexcept
        : 已进入_(已进入), 可退出_(可退出) {}
private:
    节点直接身份结构写入结果 准备提交(
        const 节点直接身份结构提交准备只读视图&) override {
        已进入_.store(true, std::memory_order_release);
        while (!可退出_.load(std::memory_order_acquire)) std::this_thread::yield();
        return {节点直接身份结构写入状态::候选已确认, 0, 0, 0};
    }
    节点直接身份结构写入结果 确认待发布() override {
        return {节点直接身份结构写入状态::候选已确认, 0, 0, 0};
    }
    void 完成发布() noexcept override {}
    节点直接身份结构写入结果 完成撤销() override {
        return {节点直接身份结构写入状态::候选已撤销, 0, 0, 0};
    }
    std::atomic_bool& 已进入_;
    std::atomic_bool& 可退出_;
};

bool 验证P1A2G两级关系值投影() {
    节点直接身份仓库 节点(0xA2A1);
    正式关系仓库 关系(节点, 形成完整准入表(), 0xA2A2);
    可重建索引仓库 索引(节点, 关系);
    节点直接类型合同仓库 合同;
    节点直接类型化值仓库 值;
    节点直接事务幂等仓库 幂等;
    节点直接身份结构事务域 事务域;
    内存持久证据端口 持久;
    节点直接身份结构写入执行器 执行器(
        &事务域, &节点, &关系, &索引, &合同, &值, &幂等, &持久);
    节点直接类型化结构数据操作 数据操作(执行器);
    const 节点直接事务幂等身份 安装{0xA2A0, 1};
    节点直接类型化结构提交服务 提交服务(安装, 数据操作);
    节点直接结构查询服务 查询(事务域, 节点, 关系, 索引, 合同, 值);
    if (数据操作.初始化确认空域治理代次(安装).状态
        != 节点直接类型化结构数据操作状态::已提交) return false;

    const 节点直接写集局部身份 根一{节点直接写集局部身份种类::节点, 1};
    const 节点直接写集局部身份 根二{节点直接写集局部身份种类::节点, 2};
    const 节点直接写集局部身份 中间一{节点直接写集局部身份种类::节点, 3};
    const 节点直接写集局部身份 中间二{节点直接写集局部身份种类::节点, 4};
    const 节点直接写集局部身份 零值目标{节点直接写集局部身份种类::节点, 5};
    const 节点直接写集局部身份 多值目标{节点直接写集局部身份种类::节点, 6};
    const 节点直接写集局部身份 旁路源{节点直接写集局部身份种类::节点, 7};
    const std::array<节点直接写集局部身份, 6> 关系局部{{
        {节点直接写集局部身份种类::关系, 1},
        {节点直接写集局部身份种类::关系, 2},
        {节点直接写集局部身份种类::关系, 3},
        {节点直接写集局部身份种类::关系, 4},
        {节点直接写集局部身份种类::关系, 5},
        {节点直接写集局部身份种类::关系, 6}}};
    节点直接类型化结构事务请求 结构请求;
    结构请求.幂等身份 = {0xA2A0, 2};
    结构请求.请求意图摘要[0] = 1;
    结构请求.执行证据摘要[0] = 2;
    结构请求.预期事实截止代次 = 1;
    结构请求.写项组 = {
        节点直接节点创建项{根一, 节点稳定主键命名域::场景身份, 节点类型::场景},
        节点直接节点创建项{根二, 节点稳定主键命名域::场景身份, 节点类型::场景},
        节点直接节点创建项{中间一, 节点稳定主键命名域::文章身份, 节点类型::文章},
        节点直接节点创建项{中间二, 节点稳定主键命名域::文章身份, 节点类型::文章},
        节点直接节点创建项{零值目标, 节点稳定主键命名域::文章身份, 节点类型::文章},
        节点直接节点创建项{多值目标, 节点稳定主键命名域::文章身份, 节点类型::文章},
        节点直接节点创建项{旁路源, 节点稳定主键命名域::文章身份, 节点类型::文章},
        节点直接关系创建项{关系局部[0], 关系类型::引用, 根一, 中间二, 10},
        节点直接关系创建项{关系局部[1], 关系类型::引用, 根二, 中间一, 10},
        节点直接关系创建项{关系局部[2], 关系类型::引用, 中间一, 零值目标, 20},
        节点直接关系创建项{关系局部[3], 关系类型::引用, 中间二, 多值目标, 20},
        节点直接关系创建项{关系局部[4], 关系类型::引用, 中间一, 中间一, 30},
        节点直接关系创建项{关系局部[5], 关系类型::引用, 旁路源, 中间一, 40}};
    for (const auto& 局部 : std::array{根一, 根二, 中间一, 中间二, 零值目标, 多值目标, 旁路源}) {
        结构请求.读回规格.项目组.push_back(
            {节点直接发布后读回对象种类::当前节点, 局部, 1});
    }
    for (const auto& 局部 : 关系局部) {
        结构请求.读回规格.项目组.push_back(
            {节点直接发布后读回对象种类::当前关系, 局部, 1});
    }
    const auto 结构提交 = 提交服务.提交(结构请求);
    if (结构提交.状态 != 节点直接类型化结构提交状态::已提交
        || 结构提交.节点组.size() != 7 || 结构提交.关系组.size() != 6) return false;

    const 类型合同稳定身份 合同一{
        static_cast<std::uint64_t>(类型合同稳定身份命名域::L2领域合同), 1};
    const 类型合同稳定身份 合同二{
        static_cast<std::uint64_t>(类型合同稳定身份命名域::L2领域合同), 2};
    const 服务稳定身份 来源服务{
        static_cast<std::uint64_t>(服务稳定身份命名域::L2领域服务), 0xA2A1};
    节点直接类型化结构事务请求 合同请求;
    合同请求.幂等身份 = {0xA2A0, 3};
    合同请求.请求意图摘要[0] = 3;
    合同请求.执行证据摘要[0] = 4;
    合同请求.预期事实截止代次 = 2;
    合同请求.写项组 = {
        节点直接类型合同发布项{合同一,
            {static_cast<std::uint64_t>(类型合同命名域::L2领域), 0xA2A1}, 1,
            类型化值表示种类::I64标量, I64标量值域{-100, 100}, 来源服务,
            类型合同生命周期状态::当前可写, {}},
        节点直接类型合同发布项{合同二,
            {static_cast<std::uint64_t>(类型合同命名域::L2领域), 0xA2A2}, 1,
            类型化值表示种类::I64标量, I64标量值域{-100, 100}, 来源服务,
            类型合同生命周期状态::当前可写, {}}};
    if (提交服务.提交(合同请求).状态 != 节点直接类型化结构提交状态::已提交) return false;

    const 节点直接写集局部身份 值一{节点直接写集局部身份种类::类型化值记录, 1};
    const 节点直接写集局部身份 值二{节点直接写集局部身份种类::类型化值记录, 2};
    节点直接类型化结构事务请求 值请求;
    值请求.幂等身份 = {0xA2A0, 4};
    值请求.请求意图摘要[0] = 5;
    值请求.执行证据摘要[0] = 6;
    值请求.预期事实截止代次 = 3;
    值请求.写项组 = {
        节点直接类型化值发布项{结构提交.节点组[5], 合同二, 1, 值二,
            std::nullopt, std::int64_t{22}, 来源服务},
        节点直接类型化值发布项{结构提交.节点组[5], 合同一, 1, 值一,
            std::nullopt, std::int64_t{11}, 来源服务}};
    值请求.读回规格.项目组 = {
        {节点直接发布后读回对象种类::当前类型化值, 值二, 1},
        {节点直接发布后读回对象种类::当前类型化值, 值一, 1}};
    const auto 值提交 = 提交服务.提交(值请求);
    if (值提交.状态 != 节点直接类型化结构提交状态::已提交
        || 值提交.类型化值组.size() != 2) return false;

    节点直接类型化结构事务请求 历史创建请求;
    历史创建请求.幂等身份 = {0xA2A0, 5};
    历史创建请求.请求意图摘要[0] = 7;
    历史创建请求.执行证据摘要[0] = 8;
    历史创建请求.预期事实截止代次 = 4;
    const 节点直接写集局部身份 历史局部{节点直接写集局部身份种类::节点, 1};
    历史创建请求.写项组 = {节点直接节点创建项{
        历史局部, 节点稳定主键命名域::子句身份, 节点类型::子句}};
    历史创建请求.读回规格.项目组 = {{
        节点直接发布后读回对象种类::当前节点, 历史局部, 1}};
    const auto 历史创建 = 提交服务.提交(历史创建请求);
    if (历史创建.状态 != 节点直接类型化结构提交状态::已提交
        || 历史创建.节点组.size() != 1) return false;
    节点直接类型化结构事务请求 历史删除请求;
    历史删除请求.幂等身份 = {0xA2A0, 6};
    历史删除请求.请求意图摘要[0] = 9;
    历史删除请求.执行证据摘要[0] = 10;
    历史删除请求.预期事实截止代次 = 5;
    历史删除请求.写项组 = {节点直接节点删除项{历史创建.节点组[0]}};
    if (提交服务.提交(历史删除请求).状态 != 节点直接类型化结构提交状态::已提交) return false;

    const std::array<节点直接写集局部身份, 4> 反向关系局部{{
        {节点直接写集局部身份种类::关系, 1},
        {节点直接写集局部身份种类::关系, 2},
        {节点直接写集局部身份种类::关系, 3},
        {节点直接写集局部身份种类::关系, 4}}};
    节点直接类型化结构事务请求 反向关系请求;
    反向关系请求.幂等身份 = {0xA2A0, 7};
    反向关系请求.请求意图摘要[0] = 11;
    反向关系请求.执行证据摘要[0] = 12;
    反向关系请求.预期事实截止代次 = 6;
    反向关系请求.写项组 = {
        节点直接关系创建项{反向关系局部[0], 关系类型::状态事实角色,
            结构提交.节点组[5], 结构提交.节点组[0], 1},
        节点直接关系创建项{反向关系局部[1], 关系类型::状态事实角色,
            结构提交.节点组[5], 结构提交.节点组[1], 2},
        节点直接关系创建项{反向关系局部[2], 关系类型::动态事实角色,
            结构提交.节点组[4], 结构提交.节点组[0], 1},
        节点直接关系创建项{反向关系局部[3], 关系类型::动态事实角色,
            结构提交.节点组[4], 结构提交.节点组[1], 3}};
    for (const auto& 局部 : 反向关系局部) {
        反向关系请求.读回规格.项目组.push_back(
            {节点直接发布后读回对象种类::当前关系, 局部, 1});
    }
    const auto 反向关系提交 = 提交服务.提交(反向关系请求);
    if (反向关系提交.状态 != 节点直接类型化结构提交状态::已提交
        || 反向关系提交.关系组.size() != 4) return false;

    节点直接两级关系值投影请求 请求;
    请求.必须节点组 = {结构提交.节点组[6], 结构提交.节点组[5],
        结构提交.节点组[4], 结构提交.节点组[3], 结构提交.节点组[2],
        结构提交.节点组[1], 结构提交.节点组[0]};
    请求.根节点组 = {结构提交.节点组[1], 结构提交.节点组[0]};
    请求.关系种类 = 关系类型::引用;
    请求.第一跳角色 = 10;
    请求.类型化值目标角色 = 20;

    const auto 代次前 = 查询.读取当前事实代次();
    const auto 节点数前 = 节点.有效节点数量();
    const auto 关系数前 = 关系.读取全部关系审计().size();
    const auto 索引数前 = 索引.导出可丢弃加速材料().记录组.size();
    const auto 合同数前 = 合同.导出权威状态().记录组.size();
    const auto 值数前 = 值.导出权威状态().记录组.size();
    const auto 幂等数前 = 幂等.导出恢复材料().记录组.size();
    const auto 持久准备数前 = 持久.准备次数;
    const auto 持久发布数前 = 持久.发布次数;
    const auto 持久撤销数前 = 持久.撤销次数;
    const auto 持久见证数前 = 持久.已见证组.size();

    const auto 空请求 = 查询.读取两级关系与目标当前类型化值({});
    const auto 正常 = 查询.读取两级关系与目标当前类型化值(请求);
    auto 重复请求 = 请求;
    重复请求.必须节点组.push_back(重复请求.必须节点组.front());
    const auto 重复 = 查询.读取两级关系与目标当前类型化值(重复请求);
    auto 非子集请求 = 请求;
    非子集请求.根节点组 = {历史创建.节点组[0]};
    const auto 非子集 = 查询.读取两级关系与目标当前类型化值(非子集请求);
    auto 未知关系请求 = 请求;
    未知关系请求.关系种类 = static_cast<关系类型>(正式关系类型ABI数量);
    const auto 未知关系 = 查询.读取两级关系与目标当前类型化值(未知关系请求);
    auto 未找到请求 = 请求;
    未找到请求.必须节点组 = {{{
        static_cast<std::uint64_t>(节点稳定主键命名域::文章身份), 999},
        节点类型::文章, 1}};
    未找到请求.根节点组.clear();
    const auto 未找到 = 查询.读取两级关系与目标当前类型化值(未找到请求);
    auto 历史请求 = 请求;
    历史请求.必须节点组 = {历史创建.节点组[0]};
    历史请求.根节点组.clear();
    const auto 历史 = 查询.读取两级关系与目标当前类型化值(历史请求);
    auto 漂移请求 = 请求;
    漂移请求.必须节点组 = {结构提交.节点组[0]};
    ++漂移请求.必须节点组[0].身份版本;
    漂移请求.根节点组.clear();
    const auto 漂移 = 查询.读取两级关系与目标当前类型化值(漂移请求);

    节点直接目标角色源投影请求 反向请求;
    反向请求.必须节点组 = {结构提交.节点组[1], 结构提交.节点组[0]};
    反向请求.筛选组 = {
        {结构提交.节点组[1], 关系类型::动态事实角色, 3},
        {结构提交.节点组[0], 关系类型::状态事实角色, 1},
        {结构提交.节点组[1], 关系类型::状态事实角色, 2},
        {结构提交.节点组[0], 关系类型::动态事实角色, 1}};
    const auto 反向正常 = 查询.读取目标角色命中源的当前关系与类型化值(反向请求);
    auto 零命中请求 = 反向请求;
    零命中请求.筛选组 = {{结构提交.节点组[0], 关系类型::状态事实角色, -1}};
    const auto 零命中 = 查询.读取目标角色命中源的当前关系与类型化值(零命中请求);
    auto 非法合同请求 = 反向请求;
    ++非法合同请求.合同版本;
    const auto 非法合同 = 查询.读取目标角色命中源的当前关系与类型化值(非法合同请求);
    auto 非法见证请求 = 反向请求;
    非法见证请求.必须节点组[0] = {};
    const auto 非法见证 = 查询.读取目标角色命中源的当前关系与类型化值(非法见证请求);
    auto 重复节点请求 = 反向请求;
    重复节点请求.必须节点组.push_back(重复节点请求.必须节点组.front());
    const auto 重复节点 = 查询.读取目标角色命中源的当前关系与类型化值(重复节点请求);
    auto 筛选目标非子集请求 = 反向请求;
    筛选目标非子集请求.筛选组[0].目标 = 结构提交.节点组[2];
    const auto 筛选目标非子集 = 查询.读取目标角色命中源的当前关系与类型化值(筛选目标非子集请求);
    auto 非法类型请求 = 反向请求;
    非法类型请求.筛选组[0].关系种类 = 关系类型::引用;
    const auto 非法类型 = 查询.读取目标角色命中源的当前关系与类型化值(非法类型请求);
    auto 重复筛选请求 = 反向请求;
    重复筛选请求.筛选组.push_back(重复筛选请求.筛选组.front());
    const auto 重复筛选 = 查询.读取目标角色命中源的当前关系与类型化值(重复筛选请求);
    auto 反向未找到请求 = 反向请求;
    反向未找到请求.必须节点组 = {{{
        static_cast<std::uint64_t>(节点稳定主键命名域::文章身份), 999},
        节点类型::文章, 1}};
    反向未找到请求.筛选组 = {{反向未找到请求.必须节点组[0], 关系类型::状态事实角色, 1}};
    const auto 反向未找到 = 查询.读取目标角色命中源的当前关系与类型化值(反向未找到请求);
    auto 反向历史请求 = 反向请求;
    反向历史请求.必须节点组 = {历史创建.节点组[0]};
    反向历史请求.筛选组 = {{历史创建.节点组[0], 关系类型::状态事实角色, 1}};
    const auto 反向历史 = 查询.读取目标角色命中源的当前关系与类型化值(反向历史请求);
    auto 反向漂移请求 = 反向请求;
    反向漂移请求.必须节点组 = {结构提交.节点组[0]};
    ++反向漂移请求.必须节点组[0].身份版本;
    反向漂移请求.筛选组 = {{反向漂移请求.必须节点组[0], 关系类型::状态事实角色, 1}};
    const auto 反向漂移 = 查询.读取目标角色命中源的当前关系与类型化值(反向漂移请求);

    bool 完整性防御通过 = true;
    bool 资源注入通过 = true;
    bool 反向资源注入通过 = true;
#if defined(HY_EGO_ENABLE_STRUCTURE_COMMIT_FAULT_SELF_TEST)
    类型化值读回 坏区间 = 值提交.类型化值组[0];
    坏区间.材料 = I64区间材料{2, 1};
    类型化值读回 坏身份组 = 值提交.类型化值组[0];
    坏身份组.材料 = 稳定身份有序组材料{{节点稳定身份见证{}}};
    类型化值读回 坏材料 = 值提交.类型化值组[0];
    坏材料.材料 = 独立材料引用{};
    完整性防御通过 = !自检验证两级投影类型化值完整性(坏区间)
        && !自检验证两级投影类型化值完整性(坏身份组)
        && !自检验证两级投影类型化值完整性(坏材料);

    自检注入下一次两级投影资源失败(查询);
    const auto 注入拒绝不消费 = 查询.读取两级关系与目标当前类型化值(重复请求);
    const auto 资源失败 = 查询.读取两级关系与目标当前类型化值(请求);
    const auto 注入后恢复 = 查询.读取两级关系与目标当前类型化值(请求);
    资源注入通过 = 注入拒绝不消费.头.状态 == 节点直接结构服务状态::入口拒绝
        && 资源失败.头.状态 == 节点直接结构服务状态::资源失败
        && 资源失败.必须节点组.empty() && 资源失败.第一跳关系组.empty()
        && 资源失败.中间节点相关关系组.empty() && 资源失败.目标值组.empty()
        && 注入后恢复.头.状态 == 节点直接结构服务状态::成功;

    自检注入下一次目标角色源投影资源失败(查询);
    const auto 反向注入拒绝不消费 = 查询.读取目标角色命中源的当前关系与类型化值(重复节点请求);
    const auto 反向资源失败 = 查询.读取目标角色命中源的当前关系与类型化值(反向请求);
    const auto 反向注入后恢复 = 查询.读取目标角色命中源的当前关系与类型化值(反向请求);
    反向资源注入通过 = 反向注入拒绝不消费.头.状态 == 节点直接结构服务状态::入口拒绝
        && 反向资源失败.头.状态 == 节点直接结构服务状态::资源失败
        && 反向资源失败.必须节点组.empty() && 反向资源失败.源组.empty()
        && !反向资源失败.未满足节点
        && 反向注入后恢复.头.状态 == 节点直接结构服务状态::成功;
#endif

    std::atomic_bool 已进入{false};
    std::atomic_bool 可退出{false};
    两级投影许可占用参与者 占用参与者(已进入, 可退出);
    std::array<节点直接身份结构写入事务参与者*, 1> 占用组{&占用参与者};
    std::thread 占用线程([&] { 执行器.执行仅参与者事务(占用组); });
    while (!已进入.load(std::memory_order_acquire)) std::this_thread::yield();
    const auto 许可竞争 = 查询.读取两级关系与目标当前类型化值(请求);
    const auto 反向许可竞争 = 查询.读取目标角色命中源的当前关系与类型化值(反向请求);
    可退出.store(true, std::memory_order_release);
    占用线程.join();

    const auto 代次后 = 查询.读取当前事实代次();
    const bool 六仓代次不变 = 代次前.头.事实截止代次 == 代次后.头.事实截止代次
        && 节点数前 == 节点.有效节点数量()
        && 关系数前 == 关系.读取全部关系审计().size()
        && 索引数前 == 索引.导出可丢弃加速材料().记录组.size()
        && 合同数前 == 合同.导出权威状态().记录组.size()
        && 值数前 == 值.导出权威状态().记录组.size()
        && 幂等数前 == 幂等.导出恢复材料().记录组.size()
        && 持久准备数前 == 持久.准备次数 && 持久发布数前 == 持久.发布次数
        && 持久撤销数前 == 持久.撤销次数 && 持久见证数前 == 持久.已见证组.size();
    const auto 非成功空载荷 = [](const 节点直接两级关系值投影结果& 结果) {
        return 结果.必须节点组.empty() && 结果.第一跳关系组.empty()
            && 结果.中间节点相关关系组.empty() && 结果.目标值组.empty();
    };
    const auto 零值位置 = std::find_if(正常.目标值组.begin(), 正常.目标值组.end(),
        [&](const auto& 项) { return 项.目标关系.目标端 == 结构提交.节点组[4]; });
    const auto 多值位置 = std::find_if(正常.目标值组.begin(), 正常.目标值组.end(),
        [&](const auto& 项) { return 项.目标关系.目标端 == 结构提交.节点组[5]; });
    const auto 反向非成功空载荷 = [](const 节点直接目标角色源投影结果& 结果) {
        return 结果.头.事实截止代次 == 0 && 结果.必须节点组.empty()
            && 结果.源组.empty() && !结果.未满足节点;
    };
    const bool 反向排序与内容通过 = 反向正常.头.状态 == 节点直接结构服务状态::成功
        && 反向正常.头.事实截止代次 == 代次前.头.事实截止代次
        && 反向正常.必须节点组
            == std::vector<节点稳定身份见证>{结构提交.节点组[0], 结构提交.节点组[1]}
        && 反向正常.源组.size() == 2
        && 反向正常.源组[0].关系种类 == 关系类型::状态事实角色
        && 反向正常.源组[0].源 == 结构提交.节点组[5]
        && 反向正常.源组[0].当前关系组.size() == 2
        && 反向正常.源组[0].当前类型化值组.size() == 2
        && 反向正常.源组[0].当前类型化值组[0].类型合同身份 == 合同一
        && 反向正常.源组[0].当前类型化值组[1].类型合同身份 == 合同二
        && 反向正常.源组[1].关系种类 == 关系类型::动态事实角色
        && 反向正常.源组[1].源 == 结构提交.节点组[4]
        && 反向正常.源组[1].当前关系组.size() == 2
        && 反向正常.源组[1].当前类型化值组.empty();
    return 空请求.头.状态 == 节点直接结构服务状态::成功
        && 空请求.头.事实截止代次 != 0 && 空请求.必须节点组.empty()
        && 正常.头.状态 == 节点直接结构服务状态::成功
        && 正常.头.事实截止代次 == 代次前.头.事实截止代次
        && 正常.必须节点组.size() == 7 && 正常.第一跳关系组.size() == 2
        && 正常.中间节点相关关系组.size() == 6 && 正常.目标值组.size() == 2
        && 零值位置 != 正常.目标值组.end() && 零值位置->当前值组.empty()
        && 多值位置 != 正常.目标值组.end() && 多值位置->当前值组.size() == 2
        && 多值位置->当前值组[0].类型合同身份 == 合同一
        && 多值位置->当前值组[1].类型合同身份 == 合同二
        && 重复.头.状态 == 节点直接结构服务状态::入口拒绝 && 非成功空载荷(重复)
        && 非子集.头.状态 == 节点直接结构服务状态::入口拒绝 && 非成功空载荷(非子集)
        && 未知关系.头.状态 == 节点直接结构服务状态::入口拒绝 && 非成功空载荷(未知关系)
        && 未找到.头.状态 == 节点直接结构服务状态::未找到
        && 未找到.未满足节点 == 未找到请求.必须节点组[0] && 非成功空载荷(未找到)
        && 历史.头.状态 == 节点直接结构服务状态::未找到
        && 历史.未满足节点 == 历史创建.节点组[0] && 非成功空载荷(历史)
        && 漂移.头.状态 == 节点直接结构服务状态::版本漂移
        && 漂移.未满足节点 == 漂移请求.必须节点组[0] && 非成功空载荷(漂移)
        && 反向排序与内容通过
        && 零命中.头.状态 == 节点直接结构服务状态::成功
        && 零命中.头.事实截止代次 == 代次前.头.事实截止代次
        && 零命中.必须节点组
            == std::vector<节点稳定身份见证>{结构提交.节点组[0], 结构提交.节点组[1]}
        && 零命中.源组.empty()
        && 非法合同.头.状态 == 节点直接结构服务状态::入口拒绝 && 反向非成功空载荷(非法合同)
        && 非法见证.头.状态 == 节点直接结构服务状态::入口拒绝 && 反向非成功空载荷(非法见证)
        && 重复节点.头.状态 == 节点直接结构服务状态::入口拒绝 && 反向非成功空载荷(重复节点)
        && 筛选目标非子集.头.状态 == 节点直接结构服务状态::入口拒绝 && 反向非成功空载荷(筛选目标非子集)
        && 非法类型.头.状态 == 节点直接结构服务状态::入口拒绝 && 反向非成功空载荷(非法类型)
        && 重复筛选.头.状态 == 节点直接结构服务状态::入口拒绝 && 反向非成功空载荷(重复筛选)
        && 反向未找到.头.状态 == 节点直接结构服务状态::未找到
        && 反向未找到.头.事实截止代次 == 代次前.头.事实截止代次
        && 反向未找到.未满足节点 == 反向未找到请求.必须节点组[0]
        && 反向未找到.必须节点组.empty() && 反向未找到.源组.empty()
        && 反向历史.头.状态 == 节点直接结构服务状态::未找到
        && 反向历史.未满足节点 == 历史创建.节点组[0]
        && 反向历史.必须节点组.empty() && 反向历史.源组.empty()
        && 反向漂移.头.状态 == 节点直接结构服务状态::版本漂移
        && 反向漂移.未满足节点 == 反向漂移请求.必须节点组[0]
        && 反向漂移.必须节点组.empty() && 反向漂移.源组.empty()
        && 完整性防御通过 && 资源注入通过 && 反向资源注入通过
        && 许可竞争.头.状态 == 节点直接结构服务状态::许可拒绝
        && 非成功空载荷(许可竞争)
        && 反向许可竞争.头.状态 == 节点直接结构服务状态::许可拒绝
        && 反向非成功空载荷(反向许可竞争) && 六仓代次不变;
}

struct P1BL1M隔离夹具 {
    explicit P1BL1M隔离夹具(std::uint64_t 基数)
        : 节点(基数), 关系(节点, 形成完整准入表(), 基数 + 1), 索引(节点, 关系),
          执行器(&事务域, &节点, &关系, &索引, &合同, &值, &幂等, &持久),
          数据操作(执行器), 安装{基数 + 0x20, 1}, 服务(安装, 数据操作) {
        初始化 = 数据操作.初始化确认空域治理代次(安装);
        节点直接类型化结构事务请求 请求;
        请求.幂等身份 = {基数 + 0x30, 1};
        请求.请求意图摘要[0] = 0x31;
        请求.执行证据摘要[0] = 0x32;
        请求.预期事实截止代次 = 1;
        for (std::uint64_t 序号 = 1; 序号 <= 5; ++序号) {
            const 节点直接写集局部身份 局部{节点直接写集局部身份种类::节点, 序号};
            请求.写项组.push_back(节点直接节点创建项{
                局部, 节点稳定主键命名域::文章身份, 节点类型::文章});
            请求.读回规格.项目组.push_back({
                节点直接发布后读回对象种类::当前节点, 局部, 1});
        }
        目标提交 = 服务.提交(请求);
        目标组 = 目标提交.节点组;
    }

    节点直接类型化结构事务请求 形成请求(std::uint64_t 序号) const {
        节点直接类型化结构事务请求 请求;
        请求.幂等身份 = {安装.命名域 + 1, 序号};
        请求.请求意图摘要[0] = static_cast<std::uint8_t>(0x40 + 序号);
        请求.执行证据摘要[0] = static_cast<std::uint8_t>(0x60 + 序号);
        请求.预期事实截止代次 = 2 + (序号 - 1);
        const 节点直接写集局部身份 节点局部{节点直接写集局部身份种类::节点, 1};
        const 节点直接写集局部身份 值局部{节点直接写集局部身份种类::类型化值记录, 1};
        const 类型合同稳定身份 合同身份{
            static_cast<std::uint64_t>(类型合同稳定身份命名域::L2领域合同), 1};
        const 节点直接类型合同发布项 合同项{
            合同身份,
            {static_cast<std::uint64_t>(类型合同命名域::L2领域), 1},
            1,
            类型化值表示种类::I64标量,
            I64标量值域{-100, 100},
            {static_cast<std::uint64_t>(服务稳定身份命名域::L2领域服务), 1},
            类型合同生命周期状态::当前可写,
            {}};
        请求.写项组.push_back(合同项);
        请求.写项组.push_back(节点直接节点创建项{
            节点局部, 节点稳定主键命名域::状态身份, 节点类型::状态});
        请求.写项组.push_back(节点直接类型化值发布项{
            节点直接节点端点引用{节点局部}, 合同身份, 1, 值局部,
            std::nullopt, std::int64_t{7},
            节点直接类型化值来源{节点直接节点端点引用{目标组[0]}}});
        for (std::uint64_t 关系序号 = 1; 关系序号 <= 5; ++关系序号) {
            const 节点直接写集局部身份 关系局部{
                节点直接写集局部身份种类::关系, 关系序号};
            请求.写项组.push_back(节点直接关系创建项{
                关系局部, 关系类型::状态事实角色,
                节点直接节点端点引用{节点局部},
                节点直接节点端点引用{目标组[关系序号 - 1]},
                static_cast<std::int64_t>(关系序号)});
        }
        请求.读回规格.项目组.push_back({
            节点直接发布后读回对象种类::当前节点, 节点局部, 1});
        请求.读回规格.项目组.push_back({
            节点直接发布后读回对象种类::当前类型化值, 值局部, 1});
        for (std::uint64_t 关系序号 = 1; 关系序号 <= 5; ++关系序号) {
            请求.读回规格.项目组.push_back({
                节点直接发布后读回对象种类::当前关系,
                节点直接写集局部身份{节点直接写集局部身份种类::关系, 关系序号}, 1});
        }
        return 请求;
    }

    节点直接身份仓库 节点;
    正式关系仓库 关系;
    可重建索引仓库 索引;
    节点直接类型合同仓库 合同;
    节点直接类型化值仓库 值;
    节点直接事务幂等仓库 幂等;
    节点直接身份结构事务域 事务域;
    内存持久证据端口 持久;
    节点直接身份结构写入执行器 执行器;
    节点直接类型化结构数据操作 数据操作;
    节点直接事务幂等身份 安装;
    节点直接类型化结构提交服务 服务;
    节点直接类型化结构数据操作结果 初始化;
    节点直接类型化结构提交结果 目标提交;
    std::vector<节点稳定身份见证> 目标组;
};

std::array<bool, 24> 验证P1B_L1M固定混合原子写集() {
    std::array<bool, 24> 验收{};
    P1BL1M隔离夹具 成功夹具(0xB1A100);
    auto 首次请求 = 成功夹具.形成请求(1);
    const auto 首次 = 成功夹具.服务.提交(首次请求);
    auto 第二请求 = 成功夹具.形成请求(2);
    const auto 第二 = 成功夹具.服务.提交(第二请求);
    const auto 同义 = 成功夹具.服务.提交(第二请求);
    auto 异义请求 = 第二请求;
    异义请求.请求意图摘要[1] = 1;
    const auto 异义 = 成功夹具.服务.提交(异义请求);

    P1BL1M隔离夹具 形状夹具(0xB1A200);
    const auto 形状准备前 = 形状夹具.持久.准备次数;
    auto 写少 = 形状夹具.形成请求(1); 写少.写项组.pop_back();
    const auto 写少结果 = 形状夹具.服务.提交(写少);
    auto 写乱 = 形状夹具.形成请求(2); std::swap(写乱.写项组[1], 写乱.写项组[2]);
    写乱.预期事实截止代次 = 2;
    const auto 写乱结果 = 形状夹具.服务.提交(写乱);
    auto 读少 = 形状夹具.形成请求(3); 读少.读回规格.项目组.pop_back();
    读少.预期事实截止代次 = 2;
    const auto 读少结果 = 形状夹具.服务.提交(读少);
    auto 读错 = 形状夹具.形成请求(4); 读错.读回规格.项目组[0].预期版本 = 2;
    读错.预期事实截止代次 = 2;
    const auto 读错结果 = 形状夹具.服务.提交(读错);

    auto 运行静态非法 = [](std::uint64_t 基数, auto 修改) {
        P1BL1M隔离夹具 夹具(基数);
        auto 请求 = 夹具.形成请求(1);
        修改(请求);
        const auto 前 = 夹具.持久.准备次数;
        const auto 结果 = 夹具.服务.提交(请求);
        return 结果.状态 == 节点直接类型化结构提交状态::入口拒绝
            && 夹具.持久.准备次数 == 前 && !夹具.事务域.已隔离();
    };
    const bool 合同异义拒绝 = [&] {
        P1BL1M隔离夹具 夹具(0xB1A300);
        const auto 首次结果 = 夹具.服务.提交(夹具.形成请求(1));
        auto 请求 = 夹具.形成请求(2);
        std::get<节点直接类型合同发布项>(请求.写项组[0]).值域 = I64标量值域{-99, 99};
        const auto 前 = 夹具.持久.准备次数;
        const auto 结果 = 夹具.服务.提交(请求);
        return 首次结果.状态 == 节点直接类型化结构提交状态::已提交
            && 结果.状态 == 节点直接类型化结构提交状态::入口拒绝
            && 夹具.持久.准备次数 == 前;
    }();
    const bool 值所属非法 = 运行静态非法(0xB1A400, [](auto& 请求) {
        auto& 值 = std::get<节点直接类型化值发布项>(请求.写项组[2]);
        值.所属身份 = 节点直接写集局部身份{节点直接写集局部身份种类::节点, 99};
    });
    const bool 值前版本非法 = 运行静态非法(0xB1A500, [](auto& 请求) {
        std::get<节点直接类型化值发布项>(请求.写项组[2]).预期当前值记录版本 = 1;
    });
    const bool 值材料非法 = 运行静态非法(0xB1A600, [](auto& 请求) {
        std::get<节点直接类型化值发布项>(请求.写项组[2]).材料 = std::int64_t{999};
    });
    const bool 值来源非法 = 运行静态非法(0xB1A700, [](auto& 请求) {
        std::get<节点直接类型化值发布项>(请求.写项组[2]).来源 =
            节点直接节点端点引用{节点稳定身份见证{}};
    });
    const bool 关系源非法 = 运行静态非法(0xB1A800, [](auto& 请求) {
        std::get<节点直接关系创建项>(请求.写项组[3]).源端 =
            节点直接写集局部身份{节点直接写集局部身份种类::节点, 99};
    });
    const bool 关系目标非法 = 运行静态非法(0xB1A900, [](auto& 请求) {
        std::get<节点直接关系创建项>(请求.写项组[3]).目标端 = 节点稳定身份见证{};
    });

    P1BL1M隔离夹具 代次夹具(0xB1AA00);
    auto 漂移请求 = 代次夹具.形成请求(1); 漂移请求.预期事实截止代次 = 1;
    const auto 漂移 = 代次夹具.服务.提交(漂移请求);

    P1BL1M隔离夹具 许可夹具(0xB1AB00);
    auto 占用读取许可 = 许可夹具.事务域.取得读取许可();
    const auto 许可拒绝 = 许可夹具.服务.提交(许可夹具.形成请求(1));

    auto 运行故障 = [](std::uint64_t 基数, 节点直接混合原子写自检阶段 阶段,
        std::uint8_t 对象) {
        P1BL1M隔离夹具 夹具(基数);
        auto 请求 = 夹具.形成请求(1);
        自检设置下一次混合原子写故障(夹具.执行器, {阶段, 对象});
        const auto 结果 = 夹具.服务.提交(请求);
        return std::tuple{结果.状态, 夹具.事务域.已隔离(),
            夹具.幂等.读取持久证据侧账(请求.幂等身份).has_value(),
            夹具.持久.撤销次数};
    };
    auto 故障范围通过 = [&](节点直接混合原子写自检阶段 阶段,
        std::uint8_t 起点, std::uint8_t 终点, 节点直接类型化结构提交状态 预期,
        bool 预期隔离) {
        for (std::uint8_t 对象 = 起点; 对象 <= 终点; ++对象) {
            const auto [状态, 已隔离值, 侧账保留, 撤销次数] = 运行故障(
                0xB1B000 + static_cast<std::uint64_t>(阶段) * 0x100 + 对象 * 0x10,
                阶段, 对象);
            if (状态 != 预期 || 已隔离值 != 预期隔离) return false;
        }
        return true;
    };
    const bool 合同故障 = 故障范围通过(节点直接混合原子写自检阶段::候选建立后,
            1, 1, 节点直接类型化结构提交状态::资源失败, false)
        && 故障范围通过(节点直接混合原子写自检阶段::候选确认前,
            1, 1, 节点直接类型化结构提交状态::内部不一致, false);
    const bool 节点故障 = 故障范围通过(节点直接混合原子写自检阶段::候选建立后,
            2, 2, 节点直接类型化结构提交状态::资源失败, false)
        && 故障范围通过(节点直接混合原子写自检阶段::候选确认前,
            2, 2, 节点直接类型化结构提交状态::内部不一致, false);
    const bool 值故障 = 故障范围通过(节点直接混合原子写自检阶段::候选建立后,
            3, 3, 节点直接类型化结构提交状态::资源失败, false)
        && 故障范围通过(节点直接混合原子写自检阶段::候选确认前,
            3, 3, 节点直接类型化结构提交状态::内部不一致, false);
    const bool 关系故障 = 故障范围通过(节点直接混合原子写自检阶段::候选建立后,
            4, 8, 节点直接类型化结构提交状态::资源失败, false)
        && 故障范围通过(节点直接混合原子写自检阶段::候选确认前,
            4, 8, 节点直接类型化结构提交状态::内部不一致, false);
    const bool 幂等故障 = 故障范围通过(节点直接混合原子写自检阶段::候选建立后,
            9, 9, 节点直接类型化结构提交状态::资源失败, false)
        && 故障范围通过(节点直接混合原子写自检阶段::候选确认前,
            9, 9, 节点直接类型化结构提交状态::内部不一致, false);
    const bool 撤销故障 = 故障范围通过(节点直接混合原子写自检阶段::候选撤销前,
        1, 9, 节点直接类型化结构提交状态::内部不一致, true);
    const bool 发布故障 = 故障范围通过(节点直接混合原子写自检阶段::候选发布前,
        1, 10, 节点直接类型化结构提交状态::内部不一致, true);
    const bool 读回故障 = 故障范围通过(节点直接混合原子写自检阶段::发布后读回前,
        1, 8, 节点直接类型化结构提交状态::内部不一致, true);

    P1BL1M隔离夹具 持久准备夹具(0xB1C100);
    持久准备夹具.持久.准备返回状态 = 节点直接持久端口状态::资源失败;
    const auto 持久准备失败 = 持久准备夹具.服务.提交(持久准备夹具.形成请求(1));
    P1BL1M隔离夹具 持久发布夹具(0xB1C200);
    持久发布夹具.持久.发布返回状态 = 节点直接持久端口状态::资源失败;
    const auto 持久发布未知 = 持久发布夹具.服务.提交(持久发布夹具.形成请求(1));
    P1BL1M隔离夹具 持久撤销夹具(0xB1C300);
    持久撤销夹具.持久.撤销返回状态 = 节点直接持久端口状态::冲突;
    自检设置下一次混合原子写故障(持久撤销夹具.执行器,
        {节点直接混合原子写自检阶段::候选建立后, 2});
    const auto 持久撤销失败 = 持久撤销夹具.服务.提交(持久撤销夹具.形成请求(1));

    验收 = {
        首次.状态 == 节点直接类型化结构提交状态::已提交,
        首次.发布代次 == 3 && 首次.节点组.size() == 1
            && 首次.类型化值组.size() == 1 && 首次.关系组.size() == 5,
        第二.状态 == 节点直接类型化结构提交状态::已提交
            && 第二.发布代次 == 4 && 成功夹具.合同.导出权威状态().记录组.size() == 1,
        同义.状态 == 节点直接类型化结构提交状态::幂等读回
            && 第二.发布代次 == 同义.发布代次
            && 第二.持久状态 == 同义.持久状态
            && 第二.节点组 == 同义.节点组 && 第二.关系组 == 同义.关系组
            && 第二.类型化值组 == 同义.类型化值组 && 第二.索引组 == 同义.索引组,
        异义.状态 == 节点直接类型化结构提交状态::幂等冲突,
        写少结果.状态 == 节点直接类型化结构提交状态::入口拒绝
            && 写乱结果.状态 == 节点直接类型化结构提交状态::入口拒绝
            && 形状夹具.持久.准备次数 == 形状准备前,
        读少结果.状态 == 节点直接类型化结构提交状态::入口拒绝
            && 读错结果.状态 == 节点直接类型化结构提交状态::入口拒绝,
        合同异义拒绝,
        值所属非法 && 值前版本非法,
        值材料非法 && 值来源非法,
        关系源非法 && 关系目标非法,
        漂移.状态 == 节点直接类型化结构提交状态::版本漂移,
        许可拒绝.状态 == 节点直接类型化结构提交状态::许可拒绝,
        合同故障,
        节点故障,
        值故障,
        关系故障,
        幂等故障,
        合同故障 && 节点故障 && 值故障 && 关系故障 && 幂等故障,
        撤销故障,
        发布故障,
        读回故障,
        持久准备失败.状态 == 节点直接类型化结构提交状态::资源失败
            && 持久发布未知.状态 == 节点直接类型化结构提交状态::已提交
            && 持久发布未知.持久状态 == 持久证据状态::持久化结果未知
            && 持久撤销失败.状态 == 节点直接类型化结构提交状态::内部不一致
            && 持久撤销夹具.事务域.已隔离(),
        节点直接结构服务合同版本 == 1 && 正式关系类型ABI数量 == 24};
    return 验收;
}

} // namespace 海中鱼巣::节点直接身份结构写入自检内部

export namespace 海中鱼巣 {

struct 节点直接身份结构写入自检报告 {
    std::array<bool, 113> 验收{};
    bool 总通过 = false;
    std::size_t 失败数量 = 113;
};

节点直接身份结构写入自检报告 运行节点直接身份结构写入自检() {
    using namespace 节点直接身份结构写入自检内部;
    节点直接身份结构写入自检报告 报告;
    const bool 稳定主键与幂等冲突通过 = 验证稳定主键与幂等冲突();
    const auto 主路径 = 运行主路径();
    const bool 逆序撤销通过 = 验证逆序撤销();
    const bool 撤销失败隔离通过 = 验证撤销失败隔离();
    const bool 视图与值式边界通过 = 验证视图与值式边界();
    const bool 新域隔离通过 = 验证新域隔离();
    const auto 仅参与者事务 = 验证仅参与者事务();
    const auto 世界树P1A1 = 验证世界树P1A1记录仓();
    const auto 世界树P1A2 = 验证P1A2节点关系事务();
    const bool 六仓恢复事务 = 验证六仓批量恢复事务();
    const auto 格式二恢复 = 验证格式二材料经数据操作恢复();
    const bool 世界树P1A2G = 验证P1A2G两级关系值投影();
    const auto 类型化参与者桥接 = 验证类型化事务参与者桥接();
    const bool 第一写前索引占用预扫描 = 验证索引占用先于第一写前复核();
    const auto 固定混合原子写集 = 验证P1B_L1M固定混合原子写集();

    报告.验收 = {
        稳定主键与幂等冲突通过,
        稳定主键与幂等冲突通过,
        稳定主键与幂等冲突通过,
        视图与值式边界通过,
        主路径.节点关系索引通过 && 主路径.索引可重建通过,
        视图与值式边界通过,
        主路径.双参与者通过,
        逆序撤销通过,
        撤销失败隔离通过,
        主路径.读取隔离通过,
        主路径.冻结通过,
        视图与值式边界通过,
        稳定主键与幂等冲突通过 && 主路径.节点关系索引通过
            && 逆序撤销通过 && 撤销失败隔离通过 && 世界树P1A2G,
        正式关系类型ABI数量 == 24 && 节点稳定主键命名域ABI版本 == 1,
        新域隔离通过,
        仅参与者事务.验收[0],
        仅参与者事务.验收[1],
        仅参与者事务.验收[2],
        仅参与者事务.验收[3],
        仅参与者事务.验收[4],
        仅参与者事务.验收[5],
        仅参与者事务.验收[6],
        仅参与者事务.验收[7],
        仅参与者事务.验收[8],
        仅参与者事务.验收[9],
        仅参与者事务.验收[10],
        仅参与者事务.验收[11],
        世界树P1A1.验收[0],
        世界树P1A1.验收[1],
        世界树P1A1.验收[2],
        世界树P1A1.验收[3],
        世界树P1A1.验收[4],
        世界树P1A1.验收[5],
        世界树P1A1.验收[6],
        世界树P1A1.验收[7],
        世界树P1A1.验收[8],
        世界树P1A1.验收[9],
        世界树P1A1.验收[10],
        世界树P1A1.验收[11],
        世界树P1A1.验收[12],
        世界树P1A1.验收[13],
        世界树P1A1.验收[14],
        世界树P1A2.验收[0],
        世界树P1A2.验收[1],
        世界树P1A2.验收[2],
        世界树P1A2.验收[3],
        世界树P1A2.验收[4],
        世界树P1A2.验收[5],
