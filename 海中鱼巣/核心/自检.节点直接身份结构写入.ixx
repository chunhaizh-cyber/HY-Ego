    const auto 删除后索引 = 索引.读取索引物理键(文章索引键二);
    const auto 节点恢复材料 = 节点.导出权威状态();
    节点直接身份仓库 恢复节点仓(节点恢复材料.仓库编号);
    auto 节点恢复候选 = 恢复节点仓.结构化建立恢复未发布候选(节点恢复材料, 0xA220);
    const auto 恢复投影 = 节点恢复候选.候选
