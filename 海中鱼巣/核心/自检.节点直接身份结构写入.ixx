        初始值提交.类型化值组.size() == 1
            && std::get<std::int64_t>(初始值提交.类型化值组[0].材料) == 5
            && 初始值提交.类型化值组[0].值记录版本 == 1,
        初始值同义.状态 == 节点直接类型化结构提交状态::幂等读回
            && 初始值同义.类型化值组 == 初始值提交.类型化值组,
