        无效请求.请求意图摘要[0] = 摘要字节;
        无效请求.执行证据摘要[0] = static_cast<std::uint8_t>(摘要字节 + 1);
        无效请求.预期事实截止代次 = 3;
        return 无效请求;
    };
    auto 重复局部身份请求 = 形成无效请求(4, 0x81);
    重复局部身份请求.写项组 = {
