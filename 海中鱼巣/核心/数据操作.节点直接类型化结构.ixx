// 文件规则：本模块只把服务请求逐字段形成固定事务规格，并拥有恢复材料解码。
module;

#include "节点直接类型化结构事务.数据.h"

#include <algorithm>
#include <limits>

export module 海中鱼巣.核心.数据操作.节点直接类型化结构;

import 海中鱼巣.核心.执行器.节点直接身份结构写入;
import 海中鱼巣.核心.端口.节点直接持久证据;

export namespace 海中鱼巣 {

class 节点直接类型化结构数据操作 final {
public:
    inline explicit 节点直接类型化结构数据操作(
        节点直接身份结构写入执行器& 执行器) noexcept : 执行器_(执行器) {}

    节点直接幂等探测数据操作结果 探测节点直接类型化结构幂等(
        节点直接事务幂等身份 幂等身份,
        const std::array<std::uint8_t, 32>& 请求意图摘要) const {
        return 执行器_.探测节点直接类型化结构幂等(幂等身份, 请求意图摘要);
    }

    节点直接类型化结构数据操作结果 提交(
        const 节点直接类型化结构数据操作请求& 请求) const {
        return 执行器_.执行节点直接类型化结构事务({请求});
    }

    节点直接持久见证数据操作结果 执行持久发布见证重试(
        节点直接事务幂等身份 幂等身份) const {
        return 执行器_.执行持久发布见证重试(幂等身份);
    }

    节点直接类型化结构数据操作结果 初始化确认空域治理代次(
        节点直接事务幂等身份 安装实例身份) const {
        return 执行器_.初始化确认空域治理代次(安装实例身份);
    }

    节点直接恢复数据操作结果 恢复(
        节点直接事务幂等身份 安装实例身份,
        const 节点直接恢复材料读取结果& 材料) const {
        节点直接恢复数据操作结果 结果;
        if (!节点直接事务幂等身份完整(安装实例身份)
            || 材料.安装状态 != 节点直接安装实例证据状态::存在事务证据
            || 材料.事务组.empty()) return 结果;

        std::vector<节点直接持久事务证据> 尝试组;
        try { 尝试组 = 材料.事务组; }
        catch (...) { 结果.状态 = 节点直接恢复数据操作状态::资源失败; return 结果; }
        std::sort(尝试组.begin(), 尝试组.end(), [](const auto& 左, const auto& 右) {
            if (左.事务身份.命名域 != 右.事务身份.命名域)
                return 左.事务身份.命名域 < 右.事务身份.命名域;
            if (左.事务身份.键值 != 右.事务身份.键值)
                return 左.事务身份.键值 < 右.事务身份.键值;
            return 左.尝试序号 < 右.尝试序号;
        });

        bool 存在发布见证 = false;
        std::vector<const 节点直接持久事务证据*> 已见证组;
        for (std::size_t 起点 = 0; 起点 < 尝试组.size();) {
            const auto 身份 = 尝试组[起点].事务身份;
            if (!节点直接事务幂等身份完整(身份)) {
                结果.状态 = 节点直接恢复数据操作状态::材料不完整;
                return 结果;
            }
            std::uint64_t 期望尝试序号 = 1;
            bool 本事务已见证 = false;
            std::size_t 终点 = 起点;
            for (; 终点 < 尝试组.size() && 尝试组[终点].事务身份 == 身份; ++终点) {
                const auto& 尝试 = 尝试组[终点];
                if (尝试.尝试序号 != 期望尝试序号
                    || 期望尝试序号 == std::numeric_limits<std::uint64_t>::max()) {
                    结果.状态 = 节点直接恢复数据操作状态::发布未知;
                    return 结果;
                }
                ++期望尝试序号;
                if (本事务已见证) {
                    结果.状态 = 节点直接恢复数据操作状态::发布未知;
                    return 结果;
                }
                if (尝试.状态 == 节点直接持久端口状态::已见证) {
                    if (!尝试.发布代次 || !尝试.结果摘要
                        || 尝试.材料格式版本 != 2 || 尝试.写集材料.empty()) {
                        结果.状态 = 节点直接恢复数据操作状态::格式不支持;
                        return 结果;
                    }
                    本事务已见证 = true;
                    存在发布见证 = true;
                    已见证组.push_back(&尝试);
                } else if (尝试.状态 != 节点直接持久端口状态::已撤销未发布) {
                    结果.状态 = 节点直接恢复数据操作状态::发布未知;
                    return 结果;
                }
            }
            起点 = 终点;
        }

        if (!存在发布见证) {
            const auto 治理 = 初始化确认空域治理代次(安装实例身份);
            结果.状态 = 治理.状态 == 节点直接类型化结构数据操作状态::已提交
                ? 节点直接恢复数据操作状态::已初始化确认空域
                : 治理.状态 == 节点直接类型化结构数据操作状态::幂等读回
                    ? 节点直接恢复数据操作状态::精确同义
                    : 治理.状态 == 节点直接类型化结构数据操作状态::资源失败
                        ? 节点直接恢复数据操作状态::资源失败
                        : 节点直接恢复数据操作状态::内部不一致;
            结果.事实截止代次 = 治理.发布代次;
            结果.提交结果 = 治理;
            return 结果;
        }

        std::sort(已见证组.begin(), 已见证组.end(), [](const auto* 左, const auto* 右) {
            if (*左->发布代次 != *右->发布代次) return *左->发布代次 < *右->发布代次;
            if (左->事务身份.命名域 != 右->事务身份.命名域)
                return 左->事务身份.命名域 < 右->事务身份.命名域;
            if (左->事务身份.键值 != 右->事务身份.键值)
                return 左->事务身份.键值 < 右->事务身份.键值;
            return 左->尝试序号 < 右->尝试序号;
        });
        for (std::size_t 序号 = 0; 序号 < 已见证组.size(); ++序号) {
            if (*已见证组[序号]->发布代次 != 序号 + 1) {
                结果.状态 = 节点直接恢复数据操作状态::版本漂移;
                return 结果;
            }
        }

        节点直接恢复结构事务请求 聚合;
        聚合.安装实例身份 = 安装实例身份;
        聚合.恢复事实截止代次 = 已见证组.size();
        try {
            auto 查找当前值 = [&](const 节点直接类型化值退役项& 退役) {
                return std::find_if(聚合.类型化值历史组.begin(), 聚合.类型化值历史组.end(),
                    [&](const auto& 值) {
                        return 值.当前 && 值.所属身份 == 退役.所属身份
                            && 值.类型合同身份 == 退役.类型合同身份
                            && 值.类型合同版本 == 退役.类型合同版本
                            && 值.值记录身份 == 退役.值记录身份
                            && 值.值记录版本 == 退役.预期值记录版本;
                    });
            };
            for (const auto* 见证 : 已见证组) {
                auto 解码 = 解码恢复写集(见证->写集材料);
                if (解码.状态 != 节点直接材料转换状态::成功 || !解码.请求) {
                    结果.状态 = 解码.状态 == 节点直接材料转换状态::资源失败
                        ? 节点直接恢复数据操作状态::资源失败
                        : 节点直接恢复数据操作状态::格式不支持;
                    return 结果;
                }
                auto& 单次 = *解码.请求;
                if (单次.安装实例身份 != 安装实例身份
                    || 单次.恢复事实截止代次 != *见证->发布代次
                    || 单次.幂等历史组.size() != 1
                    || 单次.幂等历史组.front().幂等身份 != 见证->事务身份
                    || 单次.幂等历史组.front().请求意图摘要 != 见证->请求意图摘要
                    || 单次.幂等历史组.front().执行证据摘要 != 见证->执行证据摘要
                    || 单次.幂等历史组.front().写集材料 != 见证->写集材料
                    || !见证->结果摘要) {
                    结果.状态 = 节点直接恢复数据操作状态::材料不完整;
                    return 结果;
                }

                for (const auto& 新节点 : 单次.节点历史组) {
                    if (!新节点.当前有效) {
                        auto 前态 = std::find_if(聚合.节点历史组.begin(), 聚合.节点历史组.end(),
                            [&](const auto& 值) { return 值.当前有效
                                && 值.身份.稳定主键 == 新节点.身份.稳定主键
                                && 值.身份.类型 == 新节点.身份.类型
                                && 值.身份.身份版本 + 1 == 新节点.身份.身份版本; });
                        if (前态 == 聚合.节点历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        前态->当前有效 = false;
                    }
                    聚合.节点历史组.push_back(新节点);
                }
                for (const auto& 新关系 : 单次.关系历史组) {
                    if (!新关系.当前有效) {
                        auto 前态 = std::find_if(聚合.关系历史组.begin(), 聚合.关系历史组.end(),
                            [&](const auto& 值) { return 值.当前有效
                                && 值.身份.稳定主键 == 新关系.身份.稳定主键
                                && 值.身份.关系版本 + 1 == 新关系.身份.关系版本; });
                        if (前态 == 聚合.关系历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        前态->当前有效 = false;
                    }
                    聚合.关系历史组.push_back(新关系);
                }
                for (auto 新值 : 单次.类型化值历史组) {
                    if (新值.前一值记录版本) {
                        auto 前态 = std::find_if(聚合.类型化值历史组.begin(), 聚合.类型化值历史组.end(),
                            [&](const auto& 值) { return 值.当前
                                && 值.所属身份 == 新值.所属身份
                                && 值.类型合同身份 == 新值.类型合同身份
                                && 值.类型合同版本 == 新值.类型合同版本
                                && 值.值记录版本 == *新值.前一值记录版本; });
                        if (前态 == 聚合.类型化值历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        前态->当前 = false;
                        前态->当前状态发布代次 = 单次.恢复事实截止代次;
                    } else {
                        const auto 既有 = std::find_if(聚合.类型化值历史组.begin(), 聚合.类型化值历史组.end(),
                            [&](const auto& 值) { return 值.当前 && 值.所属身份 == 新值.所属身份
                                && 值.类型合同身份 == 新值.类型合同身份
                                && 值.类型合同版本 == 新值.类型合同版本; });
                        if (既有 != 聚合.类型化值历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::身份冲突; return 结果; }
                    }
                    聚合.类型化值历史组.push_back(std::move(新值));
                }
                for (const auto& 退役 : 解码.类型化值退役组) {
                    auto 前态 = 查找当前值(退役);
                    if (前态 == 聚合.类型化值历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                    前态->当前 = false;
                    前态->当前状态发布代次 = 单次.恢复事实截止代次;
                }
                for (const auto& 新索引 : 单次.索引历史组) {
                    auto 前态 = std::find_if(聚合.索引历史组.begin(), 聚合.索引历史组.end(),
                        [&](const auto& 值) { return 值.当前 && 值.键 == 新索引.键; });
                    if (新索引.当前) {
                        if (前态 != 聚合.索引历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::身份冲突; return 结果; }
                    } else {
                        if (前态 == 聚合.索引历史组.end()
                            || 前态->节点目标 != 新索引.节点目标) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        前态->当前 = false;
                    }
                    聚合.索引历史组.push_back(新索引);
                }

                聚合.类型合同历史组.insert(聚合.类型合同历史组.end(),
                    单次.类型合同历史组.begin(), 单次.类型合同历史组.end());
                聚合.高水位组.insert(聚合.高水位组.end(), 单次.高水位组.begin(), 单次.高水位组.end());
                聚合.历史占用组.insert(聚合.历史占用组.end(), 单次.历史占用组.begin(), 单次.历史占用组.end());

                auto 记录 = std::move(单次.幂等历史组.front());
                for (const auto& 读回 : 解码.读回规格.项目组) {
                    if (读回.种类 == 节点直接发布后读回对象种类::当前节点) {
                        const auto& 键 = std::get<节点稳定主键>(读回.身份);
                        const auto 位置 = std::find_if(聚合.节点历史组.begin(), 聚合.节点历史组.end(),
                            [&](const auto& 值) { return 值.当前有效 && 值.身份.稳定主键 == 键 && 值.身份.身份版本 == 读回.预期版本; });
                        if (位置 == 聚合.节点历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        记录.节点组.push_back(位置->身份);
                    } else if (读回.种类 == 节点直接发布后读回对象种类::当前关系
                        || 读回.种类 == 节点直接发布后读回对象种类::已失效关系) {
                        const auto& 键 = std::get<关系稳定主键>(读回.身份);
                        const bool 当前 = 读回.种类 == 节点直接发布后读回对象种类::当前关系;
                        const auto 位置 = std::find_if(聚合.关系历史组.begin(), 聚合.关系历史组.end(),
                            [&](const auto& 值) { return 值.当前有效 == 当前 && 值.身份.稳定主键 == 键 && 值.身份.关系版本 == 读回.预期版本; });
                        if (位置 == 聚合.关系历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        记录.关系组.push_back(位置->身份);
                    } else if (读回.种类 == 节点直接发布后读回对象种类::当前类型化值) {
                        const auto& 键 = std::get<类型化值记录稳定身份>(读回.身份);
                        const auto 位置 = std::find_if(聚合.类型化值历史组.begin(), 聚合.类型化值历史组.end(),
                            [&](const auto& 值) { return 值.当前 && 值.值记录身份 == 键 && 值.值记录版本 == 读回.预期版本; });
                        if (位置 == 聚合.类型化值历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        记录.类型化值组.push_back(*位置);
                    } else {
                        const auto& 键 = std::get<索引物理键>(读回.身份);
                        const bool 当前 = 读回.种类 == 节点直接发布后读回对象种类::当前索引;
                        const auto 位置 = std::find_if(单次.索引历史组.begin(), 单次.索引历史组.end(),
                            [&](const auto& 值) { return 值.当前 == 当前 && 值.键 == 键; });
                        if (位置 == 单次.索引历史组.end()) { 结果.状态 = 节点直接恢复数据操作状态::版本漂移; return 结果; }
                        记录.索引组.push_back(*位置);
                    }
                }
                记录.结果摘要 = *见证->结果摘要;
                聚合.幂等历史组.push_back(std::move(记录));
                聚合.持久证据状态组.push_back({见证->事务身份, 见证->尝试序号,
                    持久证据状态::已与内存代次一致});
            }

            std::sort(聚合.高水位组.begin(), 聚合.高水位组.end(), [](const auto& 左, const auto& 右) {
                if (左.种类 != 右.种类) return static_cast<std::uint8_t>(左.种类) < static_cast<std::uint8_t>(右.种类);
                if (左.命名域 != 右.命名域) return 左.命名域 < 右.命名域;
                return 左.高水位 < 右.高水位;
            });
            std::vector<节点直接恢复命名域高水位> 合并高水位;
            for (const auto& 项 : 聚合.高水位组) {
                if (!合并高水位.empty() && 合并高水位.back().种类 == 项.种类
                    && 合并高水位.back().命名域 == 项.命名域) 合并高水位.back().高水位 = std::max(合并高水位.back().高水位, 项.高水位);
                else 合并高水位.push_back(项);
            }
            聚合.高水位组 = std::move(合并高水位);
            std::sort(聚合.历史占用组.begin(), 聚合.历史占用组.end(), [](const auto& 左, const auto& 右) {
                if (左.种类 != 右.种类) return static_cast<std::uint8_t>(左.种类) < static_cast<std::uint8_t>(右.种类);
                if (左.命名域 != 右.命名域) return 左.命名域 < 右.命名域;
                return 左.键值 < 右.键值;
            });
            聚合.历史占用组.erase(std::unique(聚合.历史占用组.begin(), 聚合.历史占用组.end(),
                [](const auto& 左, const auto& 右) { return 左.种类 == 右.种类 && 左.命名域 == 右.命名域
                    && 左.键值 == 右.键值 && 左.节点类型见证 == 右.节点类型见证; }), 聚合.历史占用组.end());
        } catch (...) {
            结果.状态 = 节点直接恢复数据操作状态::资源失败;
            return 结果;
        }
        结果 = 执行器_.执行节点直接恢复事务({std::move(聚合)});
        return 结果;
    }

private:
    static 节点直接恢复解码结果 解码恢复写集(
        std::span<const std::uint8_t> 材料) {
        struct 读取器 {
            std::span<const std::uint8_t> 材料;
            std::size_t 位置 = 0;
            bool 读取(std::uint64_t& 值, std::size_t 字节数) {
                if (字节数 > 8 || 位置 > 材料.size() || 材料.size() - 位置 < 字节数) return false;
                值 = 0;
                for (std::size_t 序号 = 0; 序号 < 字节数; ++序号) 值 = (值 << 8) | 材料[位置++];
                return true;
            }
            bool 读取字节(std::uint8_t& 值) {
                std::uint64_t 临时 = 0; if (!读取(临时, 1)) return false; 值 = static_cast<std::uint8_t>(临时); return true;
            }
            bool 完成() const noexcept { return 位置 == 材料.size(); }
        } 读{材料};
        节点直接恢复结构事务请求 请求;
        节点直接发布后读回规格 读回规格;
        std::vector<节点直接类型化值退役项> 类型化值退役组;
        std::vector<节点直接计划身份映射项> 映射组;
