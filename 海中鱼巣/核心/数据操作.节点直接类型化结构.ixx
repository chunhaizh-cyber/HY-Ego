            else if(标签==7){索引物理键 键;节点稳定身份见证 目标;if(!读索引键(键)||!读端点(目标))return {节点直接材料转换状态::损坏,std::nullopt};请求.索引历史组.push_back({键,true,目标,std::nullopt});}
            else if(标签==8){索引物理键 键;节点稳定身份见证 目标;if(!读索引键(键)||!读节点见证(目标))return {节点直接材料转换状态::损坏,std::nullopt};请求.索引历史组.push_back({键,false,目标,std::nullopt});}
            else if(标签==9){节点稳定身份见证 节点;if(!读节点见证(节点)||节点.身份版本==std::numeric_limits<std::uint32_t>::max())return {节点直接材料转换状态::损坏,std::nullopt};++节点.身份版本;请求.节点历史组.push_back({节点,false});}
            else return {节点直接材料转换状态::损坏,std::nullopt};
        }
        if(!读无符号(8,数量)||数量>1'048'576)return {节点直接材料转换状态::损坏,std::nullopt};
        for(std::uint64_t i=0;i<数量;++i){
            节点直接发布后读回项 项;std::uint8_t 种类=0,身份标签=0;
            if(!读.读取字节(种类)||!读无符号(8,项.预期版本)||!读.读取字节(身份标签))
                return {节点直接材料转换状态::损坏,std::nullopt};
            项.种类=static_cast<节点直接发布后读回对象种类>(种类);
            if(身份标签==1){节点直接写集局部身份 局部;if(!读局部身份(局部))return {节点直接材料转换状态::损坏,std::nullopt};const auto 映射=映射局部(局部);if(!映射)return {节点直接材料转换状态::损坏,std::nullopt};if(局部.种类==节点直接写集局部身份种类::节点)项.身份=节点稳定主键{映射->稳定身份命名域,映射->计划键};else if(局部.种类==节点直接写集局部身份种类::关系)项.身份=关系稳定主键{映射->稳定身份命名域,映射->计划键};else if(局部.种类==节点直接写集局部身份种类::类型化值记录)项.身份=类型化值记录稳定身份{映射->稳定身份命名域,映射->计划键};else return {节点直接材料转换状态::损坏,std::nullopt};}
            else if(身份标签==2){节点稳定主键 身份;if(!读无符号(8,身份.命名域)||!读无符号(8,身份.键值))return {节点直接材料转换状态::损坏,std::nullopt};项.身份=身份;}
            else if(身份标签==3){关系稳定主键 身份;if(!读无符号(8,身份.命名域)||!读无符号(8,身份.键值))return {节点直接材料转换状态::损坏,std::nullopt};项.身份=身份;}
            else if(身份标签==4){类型化值记录稳定身份 身份;if(!读无符号(8,身份.命名域)||!读无符号(8,身份.键值))return {节点直接材料转换状态::损坏,std::nullopt};项.身份=身份;}
            else if(身份标签==5){索引物理键 身份;if(!读索引键(身份))return {节点直接材料转换状态::损坏,std::nullopt};项.身份=身份;}
            else return {节点直接材料转换状态::损坏,std::nullopt};
            const bool 是索引=项.种类==节点直接发布后读回对象种类::当前索引||项.种类==节点直接发布后读回对象种类::已移除索引;
            const bool 身份匹配=std::visit([&](const auto& 身份){using 类型=std::decay_t<decltype(身份)>;if constexpr(std::is_same_v<类型,节点稳定主键>)return 项.种类==节点直接发布后读回对象种类::当前节点&&稳定主键有效(身份);else if constexpr(std::is_same_v<类型,关系稳定主键>)return (项.种类==节点直接发布后读回对象种类::当前关系||项.种类==节点直接发布后读回对象种类::已失效关系)&&关系稳定主键完整(身份);else if constexpr(std::is_same_v<类型,类型化值记录稳定身份>)return 项.种类==节点直接发布后读回对象种类::当前类型化值&&类型化值记录稳定身份完整(身份);else if constexpr(std::is_same_v<类型,索引物理键>)return 是索引&&索引物理键完整(身份);else return false;},项.身份);
            if(!身份匹配||(是索引&&项.预期版本!=0)||(!是索引&&项.预期版本==0))return {节点直接材料转换状态::损坏,std::nullopt};
            读回规格.项目组.push_back(std::move(项));
        }
        if(!读.完成())return {节点直接材料转换状态::损坏,std::nullopt};
        请求.合同版本=1;请求.材料格式版本=2;请求.恢复事实截止代次=预计代次;
        节点直接事务幂等记录 记录;
        记录.安装实例身份=请求.安装实例身份;记录.幂等身份=幂等身份;
        记录.请求意图摘要=请求摘要;记录.执行证据摘要=执行摘要;
        记录.材料格式版本=2;记录.写集规则版本=2;
        try { 记录.写集材料.assign(材料.begin(),材料.end()); }
        catch (...) { return {节点直接材料转换状态::资源失败,std::nullopt}; }
        记录.状态=节点直接事务幂等记录状态::已发布;记录.发布代次=预计代次;
        请求.幂等历史组.push_back(std::move(记录));
        return {节点直接材料转换状态::成功,std::move(请求),std::move(读回规格),std::move(类型化值退役组)};
    }

    节点直接身份结构写入执行器& 执行器_;
};

} // namespace 海中鱼巣
