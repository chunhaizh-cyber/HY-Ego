// 文件规则：本模块只拥有业务中性提交服务 DTO 映射和正式诊断边界。
module;

#include "节点直接类型化结构事务.数据.h"

export module 海中鱼巣.核心.服务.节点直接类型化结构提交;

import 海中鱼巣.核心.数据操作.节点直接类型化结构;

export namespace 海中鱼巣 {

class 节点直接类型化结构提交服务 final {
public:
    节点直接类型化结构提交服务(
        节点直接事务幂等身份 安装实例身份,
        节点直接类型化结构数据操作& 数据操作) noexcept
        : 安装实例身份_(安装实例身份), 数据操作_(数据操作) {}

    节点直接类型化结构幂等探测结果 探测幂等(
        节点直接事务幂等身份 幂等身份,
        const std::array<std::uint8_t, 32>& 请求意图摘要) const {
        const auto 下层 = 数据操作_.探测节点直接类型化结构幂等(幂等身份, 请求意图摘要);
        节点直接类型化结构幂等探测结果 结果;
        switch (下层.状态) {
        case 节点直接幂等探测数据操作状态::未找到: 结果.状态 = 节点直接类型化结构幂等探测状态::未找到; break;
        case 节点直接幂等探测数据操作状态::同义已发布: 结果.状态 = 节点直接类型化结构幂等探测状态::同义已发布; break;
        case 节点直接幂等探测数据操作状态::异义冲突: 结果.状态 = 节点直接类型化结构幂等探测状态::异义冲突; break;
        case 节点直接幂等探测数据操作状态::待发布或隔离: 结果.状态 = 节点直接类型化结构幂等探测状态::待发布或隔离; break;
        case 节点直接幂等探测数据操作状态::许可拒绝: 结果.状态 = 节点直接类型化结构幂等探测状态::许可拒绝; break;
        case 节点直接幂等探测数据操作状态::内部不一致: 结果.状态 = 节点直接类型化结构幂等探测状态::内部不一致; break;
        }
        if (下层.原结果) 结果.原结果 = 映射结果_(*下层.原结果);
        return 结果;
    }

    节点直接类型化结构提交结果 提交(
        const 节点直接类型化结构事务请求& 请求) const {
        节点直接类型化结构数据操作请求 下层;
        下层.合同版本 = 请求.合同版本;
        下层.写集规则版本 = 请求.写集规则版本;
        下层.安装实例身份 = 安装实例身份_;
        下层.幂等身份 = 请求.幂等身份;
        下层.请求意图摘要 = 请求.请求意图摘要;
        下层.执行证据摘要 = 请求.执行证据摘要;
        下层.预期事实截止代次 = 请求.预期事实截止代次;
        下层.写项组 = 请求.写项组;
        下层.读回规格 = 请求.读回规格;
        return 映射结果_(数据操作_.提交(下层));
    }

    节点直接持久见证重试结果 重试持久发布见证(
        节点直接事务幂等身份 幂等身份) const {
        const auto 下层 = 数据操作_.执行持久发布见证重试(幂等身份);
        节点直接持久见证重试结果 结果;
        结果.持久状态 = 下层.持久状态;
        switch (下层.状态) {
        case 节点直接持久见证数据操作状态::已与内存代次一致: 结果.状态 = 节点直接持久见证重试状态::已与内存代次一致; break;
        case 节点直接持久见证数据操作状态::无需重试: 结果.状态 = 节点直接持久见证重试状态::无需重试; break;
        case 节点直接持久见证数据操作状态::未找到: 结果.状态 = 节点直接持久见证重试状态::未找到; break;
        case 节点直接持久见证数据操作状态::许可拒绝: 结果.状态 = 节点直接持久见证重试状态::许可拒绝; break;
        case 节点直接持久见证数据操作状态::资源失败: 结果.状态 = 节点直接持久见证重试状态::资源失败; break;
        case 节点直接持久见证数据操作状态::持久证据损坏: 结果.状态 = 节点直接持久见证重试状态::持久证据损坏; break;
        case 节点直接持久见证数据操作状态::内部不一致: 结果.状态 = 节点直接持久见证重试状态::内部不一致; break;
        }
        return 结果;
    }

private:
    static 节点直接类型化结构提交结果 映射结果_(
        const 节点直接类型化结构数据操作结果& 下层) {
        节点直接类型化结构提交结果 结果;
        switch (下层.状态) {
        case 节点直接类型化结构数据操作状态::已提交: 结果.状态 = 节点直接类型化结构提交状态::已提交; break;
        case 节点直接类型化结构数据操作状态::幂等读回: 结果.状态 = 节点直接类型化结构提交状态::幂等读回; break;
        case 节点直接类型化结构数据操作状态::入口拒绝: 结果.状态 = 节点直接类型化结构提交状态::入口拒绝; break;
        case 节点直接类型化结构数据操作状态::幂等冲突: 结果.状态 = 节点直接类型化结构提交状态::幂等冲突; break;
        case 节点直接类型化结构数据操作状态::版本漂移: 结果.状态 = 节点直接类型化结构提交状态::版本漂移; break;
        case 节点直接类型化结构数据操作状态::许可拒绝: 结果.状态 = 节点直接类型化结构提交状态::许可拒绝; break;
        case 节点直接类型化结构数据操作状态::资源失败: 结果.状态 = 节点直接类型化结构提交状态::资源失败; break;
        case 节点直接类型化结构数据操作状态::内部不一致: 结果.状态 = 节点直接类型化结构提交状态::内部不一致; break;
        }
        结果.发布代次 = 下层.发布代次;
        结果.持久状态 = 下层.持久状态;
        结果.节点组 = 下层.节点组;
        结果.关系组 = 下层.关系组;
        结果.类型化值组 = 下层.类型化值组;
        结果.索引组 = 下层.索引组;
        return 结果;
    }

    节点直接事务幂等身份 安装实例身份_;
    节点直接类型化结构数据操作& 数据操作_;
};

} // namespace 海中鱼巣
