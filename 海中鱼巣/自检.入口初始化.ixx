export module 海中鱼巣.自检.入口初始化;

import 海中鱼巣.自检.运行器;
import 海中鱼巣.装配.普通应用;
import 海中鱼巣.领域.初始化.系统;

export namespace 海中鱼巣 {

enum class 入口初始化自检环境构造状态 : std::uint8_t {
    已构造 = 0,
    装配失败 = 1
};

struct 入口初始化自检初始计数 {
    std::size_t 节点数量 = 0;
    std::size_t 关系数量 = 0;
    std::size_t 索引数量 = 0;
};

using 入口初始化自检观察回调 =
    std::function<void(std::string_view, std::uintptr_t, 入口初始化自检初始计数)>;

struct 入口初始化自检运行配置 {
    std::optional<std::string> 强制失败编号;
    入口初始化自检观察回调 观察回调;
};

struct 入口初始化自检环境构造结果 {
    入口初始化自检环境构造状态 状态 = 入口初始化自检环境构造状态::装配失败;
    std::unique_ptr<普通应用上下文> 上下文;
    入口初始化自检初始计数 初始计数;

    bool 成功() const noexcept {
        return 状态 == 入口初始化自检环境构造状态::已构造 && 上下文 != nullptr;
    }
};

入口初始化自检环境构造结果 构造入口初始化自检环境(
    const 入口初始化自检运行配置& 配置,
    std::string_view 自检编号) {
    auto 装配 = 构造普通应用上下文(普通应用配置{});
    if (!装配.成功()) {
        return {};
    }
    入口初始化自检初始计数 计数{
        static_cast<std::size_t>(装配.上下文->节点.有效节点数量()),
        static_cast<std::size_t>(装配.上下文->关系.有效关系数量()),
        static_cast<std::size_t>(装配.上下文->索引.有效主键数量())
    };
    if (配置.观察回调) {
        配置.观察回调(
            自检编号,
            reinterpret_cast<std::uintptr_t>(装配.上下文.get()),
            计数);
    }
    return {入口初始化自检环境构造状态::已构造, std::move(装配.上下文), 计数};
}

自检单元结果 运行概念图四根创建自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S01";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto 类型匹配 = [&](const 概念根初始化项& 根, 节点类型 类型) {
            const auto 记录 = 上下文.节点.读取节点(根.根节点);
            return 记录.has_value() && 记录->类型 == 类型;
        };
        通过 = 结果.成功()
            && 类型匹配(结果.概念图.存在根, 节点类型::存在)
            && 类型匹配(结果.概念图.动态根, 节点类型::动态)
            && 类型匹配(结果.概念图.关系根, 节点类型::二次特征)
            && 类型匹配(结果.概念图.因果根, 节点类型::因果引用);
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "概念图四根创建", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行概念图四根唯一自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S02";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto& 概念图 = 结果.概念图;
        通过 = 结果.成功() && 上下文.概念图.读取全部概念根().size() == 4
            && 概念图.存在根.稳定非名称键 != 概念图.动态根.稳定非名称键
            && 概念图.存在根.稳定非名称键 != 概念图.关系根.稳定非名称键
            && 概念图.存在根.稳定非名称键 != 概念图.因果根.稳定非名称键
            && 概念图.动态根.稳定非名称键 != 概念图.关系根.稳定非名称键
            && 概念图.动态根.稳定非名称键 != 概念图.因果根.稳定非名称键
            && 概念图.关系根.稳定非名称键 != 概念图.因果根.稳定非名称键;
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "概念图四根唯一", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行概念图非名称身份自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S03";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto 别名 = 结果.成功()
            ? 上下文.语素.创建概念入口并保留收口材料(
                L"实体", 结果.概念图.存在根.根节点, 结果.概念图.存在根.根节点)
            : 语素概念入口创建结果{};
        const auto 读回 = 上下文.概念图.读取概念根(概念根类别::存在);
        通过 = 结果.成功() && 别名.成功() && 别名.主键 == 0
            && 读回.has_value()
            && 读回->根节点 == 结果.概念图.存在根.根节点
            && 读回->稳定非名称键 == 结果.概念图.存在根.稳定非名称键;
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "概念图非名称身份", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行概念图根名绑定自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S04";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto 绑定可读 = [&](const 概念根初始化项& 根) {
            const auto 绑定 = 上下文.语素.读取入口绑定目标组(根.名称语素入口.语素入口);
            const auto 追溯 = 上下文.语素.读取入口概念追溯组(根.名称语素入口.语素入口);
            return std::find(绑定.begin(), 绑定.end(), 根.根节点) != 绑定.end()
                && std::find(追溯.begin(), 追溯.end(), 根.根节点) != 追溯.end();
        };
        通过 = 结果.成功()
            && 结果.概念图.存在根.预置名称 == L"存在"
            && 结果.概念图.动态根.预置名称 == L"动态"
            && 结果.概念图.关系根.预置名称 == L"关系"
            && 结果.概念图.因果根.预置名称 == L"因果"
            && 绑定可读(结果.概念图.存在根) && 绑定可读(结果.概念图.动态根)
            && 绑定可读(结果.概念图.关系根) && 绑定可读(结果.概念图.因果根);
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "概念图根名绑定", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行概念图重复初始化结构不变自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S05";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 首次 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto 前节点 = 上下文.节点.有效节点数量();
        const auto 前关系 = 上下文.关系.有效关系数量();
        const auto 前索引 = 上下文.索引.有效主键数量();
        const auto 再次 = 上下文.概念图初始化.初始化四个根();
        通过 = 首次.成功() && 再次.成功()
            && 再次.存在根.根节点 == 首次.概念图.存在根.根节点
            && 再次.动态根.根节点 == 首次.概念图.动态根.根节点
            && 再次.关系根.根节点 == 首次.概念图.关系根.根节点
            && 再次.因果根.根节点 == 首次.概念图.因果根.根节点
            && 前节点 == 上下文.节点.有效节点数量()
            && 前关系 == 上下文.关系.有效关系数量()
            && 前索引 == 上下文.索引.有效主键数量();
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "概念图重复初始化结构不变", 通过, 1, 通过 ? 0U : 1U};
}

