            [配置] { auto 结果 = 运行概念图四根创建自检(配置); 海中鱼巣记录入口初始化自检调试日志(L"入口初始化", L"S01", 结果.总通过 ? L"通过" : L"失败"); return 结果; })
        && 运行器.登记自检(20, "ENTRY-ONLY-S02", "概念图四根唯一",
            [配置] { auto 结果 = 运行概念图四根唯一自检(配置); 海中鱼巣记录入口初始化自检调试日志(L"入口初始化", L"S02", 结果.总通过 ? L"通过" : L"失败"); return 结果; })
        && 运行器.登记自检(30, "ENTRY-ONLY-S03", "概念图非名称身份",
            [配置] { auto 结果 = 运行概念图非名称身份自检(配置); 海中鱼巣记录入口初始化自检调试日志(L"入口初始化", L"S03", 结果.总通过 ? L"通过" : L"失败"); return 结果; })
        && 运行器.登记自检(40, "ENTRY-ONLY-S04", "概念图根名绑定",
