        const auto 第二实例 = 上下文.存在.创建实际存在();
        const auto 支持 = 上下文.概念图.确保存在实例根支持(第二实例);
        通过 = 结果.成功() && 支持 == std::optional<节点句柄>{结果.概念图.存在根.根节点}
            && 上下文.概念图.读取支持概念的实例(结果.概念图.存在根.根节点).size() == 2;
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "多存在实例根支持", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行存在根支持拒绝自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S08";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto 已删除 = 上下文.存在.创建实际存在();
        const bool 已删除准备 = 上下文.节点.删除节点(已删除);
        const auto 前节点 = 上下文.节点.有效节点数量();
        const auto 前关系 = 上下文.关系.有效关系数量();
        const auto 前索引 = 上下文.索引.有效主键数量();
        const auto 根拒绝 = 上下文.概念图.确保存在实例根支持(结果.概念图.存在根.根节点);
        const auto 类型拒绝 = 上下文.概念图.确保存在实例根支持(结果.概念图.动态根.根节点);
        const auto 删除拒绝 = 上下文.概念图.确保存在实例根支持(已删除);
        通过 = 结果.成功() && 已删除准备
            && !根拒绝.has_value() && !类型拒绝.has_value() && !删除拒绝.has_value()
            && 前节点 == 上下文.节点.有效节点数量()
            && 前关系 == 上下文.关系.有效关系数量()
            && 前索引 == 上下文.索引.有效主键数量();
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "存在根支持拒绝", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行自我线程进入与初始化自检(const 入口初始化自检运行配置& 配置) {
