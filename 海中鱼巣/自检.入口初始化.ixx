自检单元结果 运行多存在实例根支持自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S07";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
