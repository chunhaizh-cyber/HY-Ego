        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        通过 = 结果.成功() && 上下文.自我线程实例.线程已进入()
            && 上下文.自我线程实例.当前状态() == 自我线程状态::运行中
            && 上下文.节点.有效节点数量() > 环境.初始计数.节点数量
            && 上下文.关系.有效关系数量() > 环境.初始计数.关系数量
            && 上下文.索引.有效主键数量() > 环境.初始计数.索引数量;
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "自我线程进入与初始化", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行语素与世界树快照读回自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S10";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto& 快照 = 结果.自我初始化.value();
        const auto 坐标 = 结果.成功()
            ? 上下文.世界树初始化.读取自我相对坐标(快照.世界树.自我存在节点)
            : std::optional<世界树相对坐标>{};
        通过 = 结果.成功() && 快照.初始化代次 == 1 && 快照.语素.成功()
            && 快照.语素.通用节点名称.文本 == L"节点"
            && 快照.语素.世界名称.文本 == L"世界"
            && 快照.语素.场景名称.文本 == L"场景"
            && 快照.语素.自我名称.文本 == L"自我"
            && 快照.世界树.成功() && 坐标.has_value()
            && 坐标->横向 == 0.0 && 坐标->纵向 == 0.0 && 坐标->垂向 == 0.0;
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "语素与世界树快照读回", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行根需求稳定语义与特征定义自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S11";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        const 普通应用配置 固定配置;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {固定配置.方法登记根稳定键, 固定配置.根需求参数});
        const auto& 根 = 结果.自我初始化->根需求;
        const auto 安全索引 = 上下文.索引.按主键查节点(固定配置.根需求参数.安全值语素稳定键);
        const auto 服务索引 = 上下文.索引.按主键查节点(固定配置.根需求参数.服务值语素稳定键);
        通过 = 结果.成功() && 根.成功()
            && 安全索引 == std::optional<节点句柄>{根.安全根需求.语素入口结果.语素入口}
            && 服务索引 == std::optional<节点句柄>{根.服务根需求.语素入口结果.语素入口};
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "根需求稳定语义与特征定义", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行安全与服务根需求完整读回自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S12";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 结果 = 初始化普通系统(端口, {普通应用配置{}.方法登记根稳定键, 普通应用配置{}.根需求参数});
        const auto& 根 = 结果.自我初始化->根需求;
        const auto 完整 = [&](const 单根需求初始化结果& 单根, std::int64_t 当前, std::int64_t 目标) {
            const auto 承接 = 上下文.需求.读取需求承接材料(单根.根需求);
            return 单根.成功() && 承接.has_value()
                && 上下文.需求.读取需求目标特征(单根.根需求)
                    == std::optional<节点句柄>{单根.特征定义}
                && 上下文.特征.读取宿主特征槽位(
                    结果.自我初始化->世界树.自我存在节点, 单根.特征定义)
                    == std::optional<节点句柄>{单根.实例特征槽位}
                && 上下文.特征.读取I64特征值(单根.实例特征槽位, 单根.当前特征值)
                    == std::optional<std::int64_t>{当前}
                && 上下文.状态.读取状态值(单根.目标状态)
                    == std::optional<std::int64_t>{目标};
        };
        通过 = 结果.成功() && 完整(根.安全根需求, 1, 10)
            && 完整(根.服务根需求, 1, 10)
            && 根.安全根需求.根需求 != 根.服务根需求.根需求;
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "安全与服务根需求完整读回", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行自我线程重复启动结构不变自检(const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S13";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        const 普通应用配置 固定配置;
        系统初始化端口 端口{
            [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
            [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
            [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
            [&]() { return 上下文.自我线程实例.读取初始化快照(); },
            [&]() { return 上下文.概念图初始化.初始化四个根(); },
            [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
        };
        const auto 首次 = 初始化普通系统(端口, {固定配置.方法登记根稳定键, 固定配置.根需求参数});
        const auto 前节点 = 上下文.节点.有效节点数量();
        const auto 前关系 = 上下文.关系.有效关系数量();
        const auto 前索引 = 上下文.索引.有效主键数量();
        const auto 再次 = 上下文.自我线程实例.启动(固定配置.根需求参数);
        通过 = 首次.成功() && 再次.成功 && 再次.复用初始化结果
            && 再次.拒绝原因 == 自我线程拒绝原因::重复启动
            && 上下文.自我线程实例.当前状态() == 自我线程状态::运行中
            && 前节点 == 上下文.节点.有效节点数量()
            && 前关系 == 上下文.关系.有效关系数量()
            && 前索引 == 上下文.索引.有效主键数量();
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "自我线程重复启动结构不变", 通过, 1, 通过 ? 0U : 1U};
}

自检单元结果 运行自我线程无效参数拒绝与生命周期自检(
    const 入口初始化自检运行配置& 配置) {
    constexpr std::string_view 编号 = "ENTRY-ONLY-S14";
    auto 环境 = 构造入口初始化自检环境(配置, 编号);
    bool 通过 = 环境.成功();
    if (通过) {
        auto& 上下文 = *环境.上下文;
        const 普通应用配置 固定配置;
        const auto 零键 = 上下文.自我线程实例.启动({
            0, 固定配置.根需求参数.服务值语素稳定键, 1, 10, 1, 10});
        const auto 重复键 = 上下文.自我线程实例.启动({
            固定配置.根需求参数.安全值语素稳定键,
            固定配置.根需求参数.安全值语素稳定键, 1, 10, 1, 10});
        通过 = !零键.成功 && 零键.拒绝原因 == 自我线程拒绝原因::参数无效
            && !重复键.成功 && 重复键.拒绝原因 == 自我线程拒绝原因::参数无效
            && !上下文.自我线程实例.线程已进入()
            && 上下文.自我线程实例.当前状态() == 自我线程状态::未启动
            && 上下文.自我线程实例.线程可收口()
            && 上下文.节点.有效节点数量() == 环境.初始计数.节点数量
            && 上下文.关系.有效关系数量() == 环境.初始计数.关系数量
            && 上下文.索引.有效主键数量() == 环境.初始计数.索引数量;
    }
    通过 = 通过 && 配置.强制失败编号 != 编号;
    return {std::string(编号), "自我线程无效参数拒绝与生命周期", 通过, 1, 通过 ? 0U : 1U};
}

bool 登记入口初始化自检单元(
    自检运行器& 运行器,
    const 入口初始化自检运行配置& 配置) {
