                && 极值迁移2.比较.拒绝原因 == 比较拒绝原因::差异不可表示
                && 零载荷(极值迁移2);
            auto 错身份2 = 构造迁移请求(0, 17);
            auto 错槽2 = 构造迁移请求(5, 17); 错槽2.后当前.实例槽 = 错槽2.后当前.定义.特征定义;
            auto 错场景2 = 构造迁移请求(6, 17);
            错场景2.后当前.宿主.当前场景.初始场景 = 错场景2.后当前.宿主.存在;
            报告.验收[36] = 零载荷(迁移比较.比较I64状态迁移(错身份2))
                && 零载荷(迁移比较.比较I64状态迁移(错槽2))
                && 零载荷(迁移比较.比较I64状态迁移(错场景2));
            报告.验收[37] = 增加2.比较.左输入回执 && 增加2.比较.右输入回执
                && 增加2.比较.实际左角色 == 特征比较角色::前状态
                && 增加2.比较.实际右角色 == 特征比较角色::后当前事实
                && 增加2.比较.实际方向 == 特征比较方向::右减左;
            报告.验收[38] = 目标合同2.合同
                && 迁移比较.读取I64目标判断比较合同({特征比较合同版本,
                    特征比较规则版本, 目标合同2.合同->注册身份,
                    目标合同2.合同->配置值, 目标合同2.合同->特征定义, 1}).状态
                    == 特征比较状态::已比较;
        }
    } catch (...) {
    }
    for (const bool 通过 : 报告.验收) if (!通过) ++报告.失败数量;
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
