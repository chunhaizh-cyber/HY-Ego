module;

#include <array>
#include <atomic>
#include <cstdint>
#include <limits>
#include <thread>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.自检.特征比较;

import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1场景结构;
import 海中鱼巣.领域.服务.L1特征定义;
import 海中鱼巣.领域.服务.L1实际存在;
import 海中鱼巣.领域.组合.L1实际存在场景;
import 海中鱼巣.领域.服务.L1实例特征;
import 海中鱼巣.领域.服务.L1状态;
import 海中鱼巣.领域.服务.特征比较;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

struct 特征比较自检报告 final {
    bool 总通过 = false;
    std::array<bool, 39> 验收{};
    std::size_t 失败数量 = 0;
};

特征比较自检报告 运行特征比较自检() {
    特征比较自检报告 报告;
    try {
        L1事实基座服务 L1;
        世界登记服务 世界(L1);
        L1场景结构服务 场景(L1, 世界);
        L1特征定义服务 定义(L1);
        L1实例特征服务 实例(L1, 场景, 定义);
        特征比较服务 比较(L1);

        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0x1001};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        初始场景创建请求 场景请求;
        场景请求.幂等身份 = {0x1002};
        场景请求.世界根 = {世界结果.登记 ? 世界结果.登记->世界根场景 : 稳定编码{}, 节点种类::普通};
        场景请求.期望事实代次 = 世界结果.登记 ? 世界结果.登记->已验证事实代次 : 0;
        const auto 场景结果 = 场景.创建初始场景(场景请求);
        特征定义登记请求 定义登记请求;
        定义登记请求.幂等身份 = {0x3001};
        定义登记请求.期望事实代次 = 场景结果.事实 ? 场景结果.事实->事实截止代次 : 0;
        const auto 定义登记 = 定义.建立登记(定义登记请求);
        I64特征定义建立请求 I64请求;
        I64请求.幂等身份 = {0x4001};
        I64请求.期望事实代次 = 定义登记.登记 ? 定义登记.登记->事实截止代次 : 0;
        I64请求.下界 = (std::numeric_limits<std::int64_t>::min)(); I64请求.上界 = 10;
        const auto I64结果 = 定义.建立I64特征定义(I64请求);
        实例特征登记请求 实例登记请求;
        实例登记请求.幂等身份 = {0x5001};
        实例登记请求.期望事实代次 = I64结果.事实 ? I64结果.事实->事实截止代次 : 0;
        const auto 实例登记 = 实例.建立登记(实例登记请求);

        初始场景读取请求 宿主读取;
        if (场景结果.事实) {
            宿主读取.世界根 = 场景结果.事实->世界根;
            宿主读取.初始场景 = 场景结果.事实->初始场景.编码;
            宿主读取.场景标记值 = 场景结果.事实->场景标记.编码;
            宿主读取.直接父关系 = 场景结果.事实->直接父关系.编码;
        }
        I64特征定义读取请求 定义读取;
        if (I64结果.事实) {
            定义读取.特征定义 = I64结果.事实->特征定义;
            定义读取.定义标记值 = I64结果.定义标记值;
            定义读取.下界值 = I64结果.下界值;
            定义读取.上界值 = I64结果.上界值;
        }
        初始场景I64实例特征建立请求 实例请求;
        实例请求.幂等身份 = {0x6001};
        实例请求.期望事实代次 = 实例登记.登记 ? 实例登记.登记->事实截止代次 : 0;
        实例请求.宿主 = 宿主读取; 实例请求.定义 = 定义读取;
        实例请求.初始值 = 3;
        实例请求.来源节点 = I64结果.事实 ? I64结果.事实->来源服务 : 稳定编码{};
        const auto 实例结果 = 实例.建立初始场景I64实例特征(实例请求);
        报告.验收[0] = 世界结果.登记 && 场景结果.事实 && 定义登记.登记
            && I64结果.事实 && 实例登记.登记 && 实例结果.事实
            && 实例结果.事实->事实截止代次 == 6;

        特征比较登记请求 比较登记请求;
        比较登记请求.幂等身份 = {0x8001}; 比较登记请求.期望事实代次 = 6;
        const auto 比较登记 = 比较.建立登记(比较登记请求);
        const auto 比较登记重复 = 比较.建立登记(比较登记请求);
        auto 比较登记冲突请求 = 比较登记请求; 比较登记冲突请求.期望事实代次 = 5;
        const auto 比较登记冲突 = 比较.建立登记(比较登记冲突请求);
        报告.验收[1] = 比较登记.状态 == 特征比较状态::已比较 && 比较登记.登记
            && 比较登记.登记->事实截止代次 == 7;
        报告.验收[2] = 比较登记重复.状态 == 特征比较状态::已比较
            && 比较登记冲突.状态 == 特征比较状态::入口拒绝
            && 比较.读取当前登记().状态 == 特征比较状态::已比较;
        特征比较服务 未登记比较(L1);
        特征比较请求 空请求; 空请求.请求身份 = 1;
        报告.验收[3] = 未登记比较.比较特征(空请求).状态 == 特征比较状态::入口拒绝;

        I64目标判断比较合同登记请求 合同请求;
        合同请求.幂等身份 = {0x9001}; 合同请求.期望事实代次 = 7;
        if (定义登记.登记) 合同请求.定义登记 = *定义登记.登记;
        合同请求.特征定义 = 定义读取;
        if (实例登记.登记) 合同请求.实例登记 = *实例登记.登记;
        const auto 合同结果 = 比较.登记I64目标判断比较合同(合同请求);
        const auto 合同重复 = 比较.登记I64目标判断比较合同(合同请求);
        auto 合同冲突请求 = 合同请求; 合同冲突请求.幂等身份 = {0x9002};
        const auto 合同冲突 = 比较.登记I64目标判断比较合同(合同冲突请求);
        报告.验收[4] = 合同结果.状态 == 特征比较状态::已比较 && 合同结果.合同
            && 合同结果.合同->事实截止代次 == 8;
        报告.验收[5] = 合同重复.状态 == 特征比较状态::已比较
            && 合同冲突.状态 == 特征比较状态::入口拒绝;
        I64目标判断比较合同读取请求 合同读取;
        if (合同结果.合同) {
            合同读取.注册身份 = 合同结果.合同->注册身份;
            合同读取.配置值 = 合同结果.合同->配置值;
            合同读取.特征定义 = 合同结果.合同->特征定义;
        }
        报告.验收[6] = 比较.读取I64目标判断比较合同(合同读取).状态 == 特征比较状态::已比较;

        const auto 快照八 = L1.读取完整快照({});
        std::size_t 登记普通节点数 = 0;
        std::size_t 登记属性类型数 = 0;
        std::size_t 合同关系数 = 0;
        bool 合同关系目标均为节点 = true;
        bool P2值未作关系目标 = true;
        bool 配置材料正确 = false;
        if (快照八.快照 && 合同结果.合同 && 比较登记.登记) {
            for (const auto& 节点 : 快照八.快照->当前节点) if (节点.创建事实代次 == 7) {
                if (节点.种类 == 节点种类::普通) ++登记普通节点数;
                if (节点.种类 == 节点种类::属性类型 && 节点.属性类型表示
                    && *节点.属性类型表示 == 值表示种类::I64组) ++登记属性类型数;
            }
            for (const auto& 关系 : 快照八.快照->当前关系) if (关系.创建事实代次 == 8) {
                ++合同关系数;
                bool 找到目标 = false;
                for (const auto& 节点 : 快照八.快照->当前节点)
                    if (节点.编码 == 关系.目标节点) 找到目标 = true;
                合同关系目标均为节点 = 合同关系目标均为节点 && 找到目标;
                P2值未作关系目标 = P2值未作关系目标
                    && 关系.目标节点 != 合同结果.合同->定义标记值
                    && 关系.目标节点 != 合同结果.合同->下界值
                    && 关系.目标节点 != 合同结果.合同->上界值;
            }
            for (const auto& 值 : 快照八.快照->当前值)
                if (值.编码 == 合同结果.合同->配置值) {
                    const auto* 材料 = std::get_if<std::vector<std::int64_t>>(&值.材料);
                    配置材料正确 = 材料 && 材料->size() == 20 && (*材料)[17] == 1
                        && (*材料)[18] == (std::numeric_limits<std::int64_t>::min)()
                        && (*材料)[19] == 10;
                }
        }
        报告.验收[18] = 登记普通节点数 == 5 && 登记属性类型数 == 1;
        报告.验收[19] = 合同关系数 == 8 && 合同关系目标均为节点
            && P2值未作关系目标 && 配置材料正确;
        auto 查创建代次 = [&](稳定编码 编码) {
            if (!快照八.快照) return std::uint64_t{0};
            for (const auto& 值 : 快照八.快照->当前值)
                if (值.编码 == 编码) return 值.创建事实代次;
            return std::uint64_t{0};
        };
        特征比较请求 请求;
        请求.请求身份 = 1; 请求.特征定义 = 定义读取.特征定义;
        请求.预期算法族 = 特征比较算法族::标量有序比较与安全差异;
        请求.预期算法版本 = 1; 请求.预期事实截止代次 = 8;
        if (实例结果.事实) {
            请求.左.实例槽 = 实例结果.事实->实例槽;
            请求.左.当前值 = 实例结果.事实->当前值;
            请求.左.来源节点 = 实例结果.事实->来源节点;
        }
        请求.左.定义关系 = 实例结果.定义关系;
        请求.左.创建事实代次 = 查创建代次(请求.左.当前值);
        请求.左.预计值 = 3; 请求.右.目标值 = 定义读取.上界值;
        请求.右.来源节点 = I64结果.事实 ? I64结果.事实->来源服务 : 稳定编码{};
        请求.右.创建事实代次 = 查创建代次(请求.右.目标值); 请求.右.预计值 = 10;
        if (比较登记.登记) {
            请求.单位 = 比较登记.登记->无单位; 请求.维度 = 比较登记.登记->标量维度;
            请求.分量角色 = 比较登记.登记->标量分量角色;
        }
        请求.要求结果位 = 7;
        const auto 小于 = 比较.比较特征(请求);
        报告.验收[7] = 小于.状态 == 特征比较状态::已比较
            && 小于.排序三态 && *小于.排序三态 == -1
            && 小于.具名关系 && *小于.具名关系 == 特征比较具名关系::当前低于目标
            && 小于.差异材料 && 小于.差异材料->值 == 7;
        auto 位1 = 请求; 位1.要求结果位 = 1;
        auto 位2 = 请求; 位2.要求结果位 = 2;
        auto 位4 = 请求; 位4.要求结果位 = 4;
        const auto 结果1 = 比较.比较特征(位1); const auto 结果2 = 比较.比较特征(位2);
        const auto 结果4 = 比较.比较特征(位4);
        报告.验收[8] = 结果1.排序三态 && !结果1.具名关系 && !结果1.差异材料
            && !结果2.排序三态 && 结果2.具名关系 && !结果2.差异材料
            && !结果4.排序三态 && !结果4.具名关系 && 结果4.差异材料;

        auto 错单位 = 请求; 错单位.单位 = 请求.维度;
        auto 错算法 = 请求; 错算法.预期算法版本 = 2;
        auto 错代次 = 请求; --错代次.预期事实截止代次;
        auto 错创建 = 请求; ++错创建.左.创建事实代次;
        报告.验收[9] = 比较.比较特征(错单位).拒绝原因 == 比较拒绝原因::单位不匹配;
        报告.验收[10] = 比较.比较特征(错算法).拒绝原因 == 比较拒绝原因::算法版本不匹配;
        报告.验收[11] = 比较.比较特征(错代次).拒绝原因 == 比较拒绝原因::输入版本失效
            && 比较.比较特征(错创建).拒绝原因 == 比较拒绝原因::输入版本失效;
        auto 错目标 = 请求; 错目标.右.目标值 = 定义读取.下界值;
        auto 错来源 = 请求; 错来源.右.来源节点 = 请求.单位;
        auto 错目标代次 = 请求; ++错目标代次.右.创建事实代次;
        const auto 错目标结果 = 比较.比较特征(错目标);
        const auto 错来源结果 = 比较.比较特征(错来源);
        const auto 错目标代次结果 = 比较.比较特征(错目标代次);
        报告.验收[20] = 错目标结果.状态 == 特征比较状态::版本漂移
            && !错目标结果.排序三态 && !错目标结果.具名关系 && !错目标结果.差异材料;
        报告.验收[21] = 错来源结果.状态 == 特征比较状态::版本漂移
            && 错目标代次结果.状态 == 特征比较状态::版本漂移
            && !错来源结果.排序三态 && !错来源结果.具名关系 && !错来源结果.差异材料;
        报告.验收[22] = 未登记比较.比较特征(请求).状态 == 特征比较状态::未注册;

        I64实例特征读取请求 当前读取;
        当前读取.宿主 = 宿主读取; 当前读取.定义 = 定义读取;
        当前读取.实例槽 = 请求.左.实例槽; 当前读取.当前值 = 请求.左.当前值;
        当前读取.来源节点 = 请求.左.来源节点;
        当前读取.宿主关系 = 实例结果.宿主关系; 当前读取.定义关系 = 实例结果.定义关系;
        I64实例特征当前值换代请求 换代请求;
        换代请求.幂等身份 = {0x7001}; 换代请求.期望事实代次 = 8;
        换代请求.当前事实 = 当前读取; 换代请求.新值 = 10;
        换代请求.新来源节点 = 请求.左.来源节点;
        const auto 换代 = 实例.换代I64实例特征当前值(换代请求);
        auto 等于请求 = 请求; 等于请求.请求身份 = 2; 等于请求.预期事实截止代次 = 9;
        if (换代.事实) {
            等于请求.左.当前值 = 换代.事实->当前值;
            等于请求.左.来源节点 = 换代.事实->来源节点;
        }
        等于请求.左.创建事实代次 = 9; 等于请求.左.预计值 = 10;
        const auto 等于 = 比较.比较特征(等于请求);
        报告.验收[12] = 换代.状态 == 实例特征状态::已提交
            && 等于.状态 == 特征比较状态::已比较
            && 等于.排序三态 && *等于.排序三态 == 0
            && 等于.具名关系 && *等于.具名关系 == 特征比较具名关系::当前达到目标;

        const auto 并发前 = L1.读取完整快照({});
        std::atomic<std::uint32_t> 并发失败 = 0;
        std::vector<std::thread> 线程;
        for (int i = 0; i < 4; ++i) 线程.emplace_back([&] {
            for (int j = 0; j < 40; ++j) {
                const auto 结果 = 比较.比较特征(等于请求);
                if (结果.状态 != 特征比较状态::已比较 || !结果.排序三态 || *结果.排序三态 != 0)
                    ++并发失败;
            }
        });
        for (auto& 当前 : 线程) 当前.join();
        const auto 并发后 = L1.读取完整快照({});
        报告.验收[13] = 并发失败 == 0;
        报告.验收[14] = 并发前.快照 && 并发后.快照
            && 并发前.快照->事实代次 == 并发后.快照->事实代次
            && 并发前.快照->当前节点.size() == 并发后.快照->当前节点.size()
            && 并发前.快照->当前关系.size() == 并发后.快照->当前关系.size()
            && 并发前.快照->当前值.size() == 并发后.快照->当前值.size();
        报告.验收[15] = 小于.左输入回执 && 小于.右输入回执
            && 小于.事实截止代次 == 8 && 小于.算法版本 == 1;
        auto 错角色 = 等于请求; 错角色.左角色 = 特征比较角色::目标状态;
        auto 错位 = 等于请求; 错位.要求结果位 = 0;
        报告.验收[16] = 比较.比较特征(错角色).状态 == 特征比较状态::入口拒绝
            && 比较.比较特征(错位).拒绝原因 == 比较拒绝原因::要求结果组合不支持;
        报告.验收[17] = 比较.读取I64目标判断比较合同(合同读取).状态 == 特征比较状态::已比较;

        auto 直接换值 = [&](稳定编码 旧值, std::int64_t 新材料,
            std::uint64_t 期望代次, std::uint64_t 幂等键值) -> std::optional<稳定编码> {
            if (!实例登记.登记) return std::nullopt;
            L1写集请求 写集;
            写集.期望事实代次 = 期望代次;
            写集.幂等键 = {幂等键值};
            写集.值 = {{{1}, 事实引用{等于请求.左.实例槽},
                事实引用{实例登记.登记->当前I64值属性类型}, 新材料,
                事实引用{等于请求.左.来源节点}}};
            写集.属性槽变更 = {{事实引用{等于请求.左.实例槽},
                事实引用{实例登记.登记->当前I64值属性类型}, 写集本地键{1}}};
            写集.退出事实 = {旧值};
            const auto 结果 = L1.提交写集(写集, 0x15000E01U);
            if (结果.状态 != L1写入状态::成功 || 结果.新编码映射.size() != 1) return std::nullopt;
            return 结果.新编码映射[0].second;
        };
        const auto 越界值 = 直接换值(等于请求.左.当前值, 11, 9, 0x0A00'0000'0000'0001ULL);
