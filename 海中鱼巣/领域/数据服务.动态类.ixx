module;

#include <algorithm>
#include <cstdint>
#include <exception>
#include <limits>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.数据服务.动态类;

export import 海中鱼巣.领域.数据服务.状态类;

namespace 海中鱼巣::动态类数据内部 {

inline constexpr L1所有者范围写集本地键 动态结点本地键{1};
inline constexpr L1所有者范围写集本地键 发生时间值本地键{2};
inline constexpr std::uint32_t 状态关系本地键起点 = 0x0001'0000U;
inline constexpr std::uint32_t 特征关系本地键起点 = 0x0002'0000U;
inline constexpr std::size_t 最大成员数量 = 0x0000'FFFFU;

std::optional<稳定编码> 查找唯一编码(
    const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键 != 本地键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

} // namespace 海中鱼巣::动态类数据内部

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 动态类数据合同版本 = 1;

enum class 动态类数据状态 : std::uint8_t {
    已创建 = 1,
    精确重复 = 2,
    已读取 = 3,
    已退出 = 4,
    入口拒绝 = 5,
    未找到 = 6,
    目标已退出 = 7,
    状态未找到 = 8,
    状态已退出 = 9,
    状态读取失败 = 10,
    特征未找到 = 11,
    特征已退出 = 12,
    特征读取失败 = 13,
    成员时间无序 = 14,
    结构类型未找到 = 15,
    结构类型已退出 = 16,
    事实代次漂移 = 17,
    幂等冲突 = 18,
    引用冲突 = 19,
    数量预算不足 = 20,
    历史材料已清理 = 21,
    资源失败 = 22,
    内部不一致 = 23
};

enum class 动态类状态位置 : std::uint8_t {
    任意 = 1,
    前状态 = 2,
    后状态 = 3
};

struct 动态类状态成员 final {
    std::uint32_t 顺序 = 0;
    稳定编码 成员关系{};
    稳定编码 状态结点{};
    friend bool operator==(const 动态类状态成员&,
        const 动态类状态成员&) = default;
};

struct 动态类变化特征成员 final {
    std::uint32_t 顺序 = 0;
    稳定编码 成员关系{};
    稳定编码 特征结点{};
    friend bool operator==(const 动态类变化特征成员&,
        const 动态类变化特征成员&) = default;
};

// 本类只承载实例动态；发生时间及成员状态时间均为绝对 UTC 纳秒。
struct 动态类结点 final {
    稳定编码 结点{};
    稳定编码 发生时间值事实{};
    std::int64_t 发生时间 = 0;
    std::vector<动态类状态成员> 有序状态组;
    std::vector<动态类变化特征成员> 变化特征组;
    std::uint64_t 创建事实代次 = 0;
    std::optional<std::uint64_t> 退出事实代次;
    friend bool operator==(const 动态类结点&, const 动态类结点&) = default;
};

struct 动态类新增请求 final {
    std::uint32_t 合同版本 = 动态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    std::vector<稳定编码> 有序状态结点组;
    std::vector<稳定编码> 变化特征结点组;
    friend bool operator==(const 动态类新增请求&,
        const 动态类新增请求&) = default;
};

struct 动态类删除请求 final {
    std::uint32_t 合同版本 = 动态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 动态结点{};
    friend bool operator==(const 动态类删除请求&,
        const 动态类删除请求&) = default;
};

struct 动态类查询请求 final {
    std::uint32_t 合同版本 = 动态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 动态结点{};
    friend bool operator==(const 动态类查询请求&,
        const 动态类查询请求&) = default;
};

struct 动态类状态查询请求 final {
    std::uint32_t 合同版本 = 动态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 状态结点{};
    动态类状态位置 位置 = 动态类状态位置::任意;
    std::uint64_t 最大结果数量 = 0;
    friend bool operator==(const 动态类状态查询请求&,
        const 动态类状态查询请求&) = default;
};

struct 动态类特征查询请求 final {
    std::uint32_t 合同版本 = 动态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 特征结点{};
    std::uint64_t 最大结果数量 = 0;
    friend bool operator==(const 动态类特征查询请求&,
        const 动态类特征查询请求&) = default;
};

struct 动态类结点结果 final {
    动态类数据状态 状态 = 动态类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 动态类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<动态类结点> 动态结点;

    bool 成功() const noexcept {
        return (状态 == 动态类数据状态::已创建
                || 状态 == 动态类数据状态::精确重复
                || 状态 == 动态类数据状态::已读取
                || 状态 == 动态类数据状态::已退出)
            && 合同版本 == 动态类数据合同版本
            && 事实代次 != 0 && 动态结点.has_value();
    }
};

struct 动态类组查询结果 final {
    动态类数据状态 状态 = 动态类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 动态类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::vector<动态类结点> 动态组;

    bool 成功() const noexcept {
        return 状态 == 动态类数据状态::已读取
            && 合同版本 == 动态类数据合同版本
            && 事实代次 != 0;
    }
};

class 动态类数据服务 final {
public:
    动态类数据服务() = delete;
    动态类数据服务(const 动态类数据服务&) = delete;
    动态类数据服务& operator=(const 动态类数据服务&) = delete;
    动态类数据服务(动态类数据服务&&) = delete;
    动态类数据服务& operator=(动态类数据服务&&) = delete;

    // 属性类型与两类关系类型由同一动态 owner 预先建立。
    // 抽象动态及其相对时间不进入本服务。
    动态类数据服务(const L1事实基座服务& 第一层服务,
        const 特征类数据服务& 特征服务,
        const 状态类数据服务& 状态服务,
        L1所有者范围写端口&& 写入端口,
        稳定编码 发生时间属性类型,
        稳定编码 状态成员关系类型,
        稳定编码 变化特征关系类型)
        : 第一层服务_(第一层服务), 特征服务_(特征服务),
          状态服务_(状态服务), 写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()),
          发生时间属性类型_(发生时间属性类型),
          状态成员关系类型_(状态成员关系类型),
          变化特征关系类型_(变化特征关系类型) {
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !有效(所有者_) || !有效(发生时间属性类型_)
            || !有效(状态成员关系类型_) || !有效(变化特征关系类型_)
            || 发生时间属性类型_ == 状态成员关系类型_
            || 发生时间属性类型_ == 变化特征关系类型_
            || 状态成员关系类型_ == 变化特征关系类型_)
            throw std::invalid_argument("invalid dynamic data configuration");
        const auto 所有者读取 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者读取.状态 != L1所有者范围读取状态::成功
            || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
            || !所有者读取.所有者事实
            || 所有者读取.所有者事实->所有者 != 所有者_
            || 所有者读取.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 所有者读取.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid dynamic data owner");
        if (!类型结点有效(发生时间属性类型_,
                节点种类::属性类型, L1所有者范围值表示种类::I64)
            || !类型结点有效(状态成员关系类型_,
                节点种类::普通, std::nullopt)
            || !类型结点有效(变化特征关系类型_,
                节点种类::普通, std::nullopt))
            throw std::invalid_argument("invalid dynamic data types");
    }

    动态类结点结果 新增动态(const 动态类新增请求& 请求) {
        if (!新增请求有效(请求)) return 失败(动态类数据状态::入口拒绝);
        try {
            const auto 特征编码组 = 规范化特征组(请求.变化特征结点组);
            if (!特征编码组) return 失败(动态类数据状态::入口拒绝);
            if (const auto 重放 = 尝试重放新增(请求, *特征编码组))
                return *重放;
            auto 状态组 = 读取状态组(请求.有序状态结点组,
                请求.期望事实代次);
            if (!状态组.成功) return 失败(状态组.状态, 状态组.事实代次);
            auto 特征组 = 读取特征组(*特征编码组, 请求.期望事实代次);
            if (!特征组.成功) return 失败(特征组.状态, 特征组.事实代次);
            const auto 写集 = 形成新增写集(请求, *特征编码组,
                状态组.值.back().时间);
            return 提交新增(写集, 请求.幂等身份,
                动态类数据状态::已创建);
        } catch (const std::bad_alloc&) {
            return 失败(动态类数据状态::资源失败);
        } catch (...) {
            return 失败(动态类数据状态::内部不一致);
        }
    }

    动态类结点结果 删除动态(const 动态类删除请求& 请求) {
        if (!删除请求有效(请求)) return 失败(动态类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放删除(请求)) return *重放;
            const auto 当前 = 读取当前动态(请求.动态结点,
                请求.期望事实代次);
            if (!当前.成功() || 当前.状态 != 动态类数据状态::已读取)
                return 当前;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.退出事实 = {当前.动态结点->结点,
                当前.动态结点->发生时间值事实};
            for (const auto& 成员 : 当前.动态结点->有序状态组)
                写集.退出事实.push_back(成员.成员关系);
            for (const auto& 成员 : 当前.动态结点->变化特征组)
                写集.退出事实.push_back(成员.成员关系);
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 映射 = 映射写入状态(写入.状态,
                动态类数据状态::已退出);
            if (映射 != 动态类数据状态::已退出
                && 映射 != 动态类数据状态::精确重复)
                return 失败(映射, 写入.事实代次);
            if (!写入结果头完整(写入, 请求.幂等身份)
                || !写入.新编码映射.empty())
                return 失败(动态类数据状态::内部不一致,
                    写入.事实代次);
            return 读取已退出动态(请求.动态结点,
                写入.事实代次, 映射);
        } catch (const std::bad_alloc&) {
            return 失败(动态类数据状态::资源失败);
        } catch (...) {
            return 失败(动态类数据状态::内部不一致);
        }
    }

    动态类结点结果 查询动态(const 动态类查询请求& 请求) const {
        if (!查询请求有效(请求)) return 失败(动态类数据状态::入口拒绝);
        try {
            return 读取当前动态(请求.动态结点, 请求.期望事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(动态类数据状态::资源失败);
        } catch (...) {
            return 失败(动态类数据状态::内部不一致);
        }
    }

    动态类组查询结果 按状态查询动态(
        const 动态类状态查询请求& 请求) const {
        if (请求.合同版本 != 动态类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.状态结点)
            || 请求.最大结果数量 == 0
            || (请求.位置 != 动态类状态位置::任意
                && 请求.位置 != 动态类状态位置::前状态
                && 请求.位置 != 动态类状态位置::后状态))
            return 组失败(动态类数据状态::入口拒绝);
        return 按关系目标查询(请求.状态结点, 状态成员关系类型_,
            请求.期望事实代次, 请求.最大结果数量,
            [&](const 动态类结点& 动态) noexcept {
                if (请求.位置 == 动态类状态位置::前状态)
                    return 动态.有序状态组.front().状态结点
                        == 请求.状态结点;
                if (请求.位置 == 动态类状态位置::后状态)
                    return 动态.有序状态组.back().状态结点
                        == 请求.状态结点;
                return std::any_of(动态.有序状态组.begin(),
                    动态.有序状态组.end(), [&](const auto& 成员) noexcept {
                        return 成员.状态结点 == 请求.状态结点;
                    });
            });
    }

    动态类组查询结果 按变化特征查询动态(
        const 动态类特征查询请求& 请求) const {
        if (请求.合同版本 != 动态类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.特征结点)
            || 请求.最大结果数量 == 0)
            return 组失败(动态类数据状态::入口拒绝);
        return 按关系目标查询(请求.特征结点, 变化特征关系类型_,
            请求.期望事实代次, 请求.最大结果数量,
            [&](const 动态类结点& 动态) noexcept {
                return std::any_of(动态.变化特征组.begin(),
                    动态.变化特征组.end(), [&](const auto& 成员) noexcept {
                        return 成员.特征结点 == 请求.特征结点;
                    });
            });
    }

private:
    struct 状态组读取结果 final {
        bool 成功 = false;
        动态类数据状态 状态 = 动态类数据状态::状态读取失败;
        std::uint64_t 事实代次 = 0;
        std::vector<状态类结点> 值;
    };

    struct 特征组读取结果 final {
        bool 成功 = false;
        动态类数据状态 状态 = 动态类数据状态::特征读取失败;
        std::uint64_t 事实代次 = 0;
        std::vector<特征类结点> 值;
    };

    bool 类型结点有效(稳定编码 编码, 节点种类 种类,
        std::optional<L1所有者范围值表示种类> 表示) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 事实 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && !读取.物理清理事实代次
            && !读取.物理清理墓碑 && 事实 && 事实->编码 == 编码
            && 事实->写入所有者 == 所有者_ && 事实->种类 == 种类
            && 事实->属性类型表示 == 表示
            && 事实->创建事实代次 != 0 && !事实->退出事实代次;
    }

    static bool 编码组有效(const std::vector<稳定编码>& 组,
        std::size_t 最小数量) noexcept {
        if (组.size() < 最小数量
            || 组.size() > 动态类数据内部::最大成员数量)
            return false;
        for (std::size_t i = 0; i < 组.size(); ++i) {
            if (!有效(组[i])) return false;
            for (std::size_t j = 0; j < i; ++j)
                if (组[i] == 组[j]) return false;
        }
        return true;
    }

    static bool 新增请求有效(const 动态类新增请求& 请求) noexcept {
        return 请求.合同版本 == 动态类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 编码组有效(请求.有序状态结点组, 2)
            && 编码组有效(请求.变化特征结点组, 1);
    }

    static bool 删除请求有效(const 动态类删除请求& 请求) noexcept {
        return 请求.合同版本 == 动态类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.动态结点);
    }

    static bool 查询请求有效(const 动态类查询请求& 请求) noexcept {
        return 请求.合同版本 == 动态类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.动态结点);
    }

    static std::optional<std::vector<稳定编码>> 规范化特征组(
        const std::vector<稳定编码>& 输入) {
        if (!编码组有效(输入, 1)) return std::nullopt;
        auto 结果 = 输入;
        std::sort(结果.begin(), 结果.end());
        return 结果;
    }

    状态组读取结果 读取状态组(const std::vector<稳定编码>& 编码组,
        std::uint64_t 期望事实代次) const {
        状态组读取结果 结果;
        结果.事实代次 = 期望事实代次;
        std::int64_t 前一时间 = 0;
        bool 有前一状态 = false;
        for (const auto 编码 : 编码组) {
            const auto 读取 = 状态服务_.查询状态(
                {状态类数据合同版本, 期望事实代次, 编码});
            if (!读取.成功() || 读取.状态 != 状态类数据状态::已读取
                || 读取.事实代次 != 期望事实代次 || !读取.状态结点) {
                结果.状态 = 映射状态状态(读取.状态);
                结果.事实代次 = 读取.事实代次;
                return 结果;
            }
            if (读取.状态结点->时间 <= 0) {
                结果.状态 = 动态类数据状态::状态读取失败;
                return 结果;
            }
            if (有前一状态 && 读取.状态结点->时间 < 前一时间) {
                结果.状态 = 动态类数据状态::成员时间无序;
                return 结果;
            }
            前一时间 = 读取.状态结点->时间;
            有前一状态 = true;
            结果.值.push_back(*读取.状态结点);
        }
        结果.成功 = true;
        结果.状态 = 动态类数据状态::已读取;
        return 结果;
    }

    特征组读取结果 读取特征组(const std::vector<稳定编码>& 编码组,
        std::uint64_t 期望事实代次) const {
        特征组读取结果 结果;
        结果.事实代次 = 期望事实代次;
        for (const auto 编码 : 编码组) {
            const auto 读取 = 特征服务_.查询特征(
                {特征类数据合同版本, 期望事实代次, 编码});
            if (!读取.成功() || 读取.状态 != 特征类数据状态::已读取
                || 读取.事实代次 != 期望事实代次 || !读取.特征) {
                结果.状态 = 映射特征状态(读取.状态);
                结果.事实代次 = 读取.事实代次;
                return 结果;
            }
            结果.值.push_back(*读取.特征);
        }
        结果.成功 = true;
        结果.状态 = 动态类数据状态::已读取;
        return 结果;
    }

    L1所有者范围写集请求 形成新增写集(
        const 动态类新增请求& 请求,
        const std::vector<稳定编码>& 规范特征组,
        std::int64_t 发生时间) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{动态类数据内部::动态结点本地键,
            节点种类::普通, std::nullopt}};
        写集.值 = {{动态类数据内部::发生时间值本地键,
            动态类数据内部::动态结点本地键, 发生时间属性类型_,
            发生时间, 动态类数据内部::动态结点本地键}};
        写集.属性槽变更 = {{动态类数据内部::动态结点本地键,
            发生时间属性类型_, 动态类数据内部::发生时间值本地键}};
        for (std::size_t i = 0; i < 请求.有序状态结点组.size(); ++i) {
            写集.关系.push_back({
                L1所有者范围写集本地键{
                    动态类数据内部::状态关系本地键起点
                        + static_cast<std::uint32_t>(i)},
                动态类数据内部::动态结点本地键,
                请求.有序状态结点组[i], 状态成员关系类型_,
                static_cast<std::int64_t>(i + 1)});
        }
        for (std::size_t i = 0; i < 规范特征组.size(); ++i) {
            写集.关系.push_back({
                L1所有者范围写集本地键{
                    动态类数据内部::特征关系本地键起点
                        + static_cast<std::uint32_t>(i)},
                动态类数据内部::动态结点本地键,
                规范特征组[i], 变化特征关系类型_,
                static_cast<std::int64_t>(i + 1)});
        }
        return 写集;
    }

    std::optional<动态类结点结果> 尝试重放新增(
        const 动态类新增请求& 请求,
        const std::vector<稳定编码>& 规范特征组) {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到)
            return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(首次.状态), 首次.读取事实代次);
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_
            || 首次.写入幂等身份 != 请求.幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果)
            return 失败(动态类数据状态::内部不一致,
                首次.读取事实代次);
        const auto& 写集 = *首次.首次规范化写集;
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 时间项 = std::find_if(写集.值.begin(), 写集.值.end(),
            [](const auto& 项) noexcept {
                return 项.本地键 == 动态类数据内部::发生时间值本地键;
            });
        const auto* 时间 = 时间项 == 写集.值.end()
            ? nullptr : std::get_if<std::int64_t>(&时间项->材料);
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || 写集.节点.size() != 1 || 写集.值.size() != 1
            || 写集.属性槽变更.size() != 1
            || 写集.关系.size()
                != 请求.有序状态结点组.size() + 规范特征组.size()
            || !写集.退出事实.empty() || !时间 || *时间 <= 0
            || 写集 != 形成新增写集(请求, 规范特征组, *时间)
            || 首次结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(首次结果, 请求.幂等身份))
            return 失败(动态类数据状态::幂等冲突,
                首次结果.事实代次);
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        if (写入.状态 != L1所有者范围写入状态::精确重复
            || !写入结果头完整(写入, 请求.幂等身份)
            || 写入.新编码映射 != 首次结果.新编码映射)
            return 失败(动态类数据状态::内部不一致,
                写入.事实代次);
        const auto 结点 = 动态类数据内部::查找唯一编码(
            写入, 动态类数据内部::动态结点本地键);
        if (!结点)
            return 失败(动态类数据状态::内部不一致,
                写入.事实代次);
        return 读取历史动态快照(*结点, 写入.事实代次,
            写入.事实代次, 动态类数据状态::精确重复, std::nullopt);
    }

    动态类结点结果 提交新增(const L1所有者范围写集请求& 写集,
        L1所有者范围写入幂等身份 幂等身份,
        动态类数据状态 成功状态) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 映射 = 映射写入状态(写入.状态, 成功状态);
        if (映射 != 成功状态 && 映射 != 动态类数据状态::精确重复)
            return 失败(映射, 写入.事实代次);
        if (!写入结果头完整(写入, 幂等身份)
            || 写入.新编码映射.size()
                != 2 + 写集.关系.size())
            return 失败(动态类数据状态::内部不一致, 写入.事实代次);
        const auto 结点 = 动态类数据内部::查找唯一编码(
            写入, 动态类数据内部::动态结点本地键);
        const auto 时间值 = 动态类数据内部::查找唯一编码(
            写入, 动态类数据内部::发生时间值本地键);
        if (!结点 || !时间值)
            return 失败(动态类数据状态::内部不一致, 写入.事实代次);
        auto 读回 = 映射 == 动态类数据状态::精确重复
            ? 读取历史动态快照(*结点, 写入.事实代次,
                写入.事实代次, 动态类数据状态::精确重复,
                std::nullopt)
            : 读取当前动态(*结点, 写入.事实代次);
        if (!读回.成功() || !读回.动态结点
            || 读回.动态结点->发生时间值事实 != *时间值)
            return 失败(动态类数据状态::内部不一致, 写入.事实代次);
        读回.状态 = 映射;
        return 读回;
    }

    动态类结点结果 读取当前动态(稳定编码 动态结点,
        std::uint64_t 期望事实代次) const {
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 期望事实代次;
        请求.所有者 = {所有者_};
        请求.节点 = {动态结点};
        请求.属性值 = {{动态结点, 发生时间属性类型_}};
        const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(请求);
        if (读取.状态 != L1所有者范围一致当前读取状态::成功)
            return 失败(映射一致读取状态(读取.状态), 读取.读取事实代次);
        if (读取.合同版本 != L1所有者范围一致当前读取合同版本
            || 读取.期望事实代次 != 期望事实代次
            || 读取.读取事实代次 != 期望事实代次
            || 读取.所有者.size() != 1 || 读取.节点.size() != 1
            || 读取.属性值.size() != 1 || !读取.关系.empty()
            || !读取.值.empty() || !读取.源关系组.empty()
            || !读取.目标关系组.empty()
            || 读取.所有者.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实
            || 读取.所有者.front().所有者事实->所有者 != 所有者_)
            return 失败(动态类数据状态::内部不一致,
                读取.读取事实代次);
        const auto& 节点项 = 读取.节点.front();
        if (节点项.状态 == L1所有者范围一致当前读取项目状态::未找到)
            return 失败(动态类数据状态::未找到, 读取.读取事实代次);
        if (节点项.状态 == L1所有者范围一致当前读取项目状态::已退出)
            return 失败(动态类数据状态::目标已退出, 读取.读取事实代次);
        if (节点项.状态 != L1所有者范围一致当前读取项目状态::成功
            || !节点项.事实)
            return 失败(动态类数据状态::内部不一致,
                读取.读取事实代次);
        const auto* 时间投影 = 查找属性投影(读取);
        if (!时间投影) return 失败(动态类数据状态::内部不一致,
            读取.读取事实代次);
        const auto& 节点事实 = *节点项.事实;
        const auto& 时间事实 = 时间投影->当前值事实;
        const auto* 时间 = std::get_if<std::int64_t>(&时间事实.材料);
        if (节点事实.编码 != 动态结点
            || 节点事实.写入所有者 != 所有者_
            || 节点事实.种类 != 节点种类::普通
            || 节点事实.属性类型表示 || 节点事实.退出事实代次
            || 节点事实.创建事实代次 == 0
            || 节点事实.创建事实代次 > 读取.读取事实代次
            || 节点事实.当前属性.size() != 1 || !时间 || *时间 <= 0
            || !值投影完整(*时间投影, 节点事实))
            return 失败(动态类数据状态::内部不一致,
                读取.读取事实代次);
        const auto 状态关系读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 动态结点, 状态成员关系类型_});
        const auto 特征关系读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 动态结点, 变化特征关系类型_});
        if (!关系组头完整(状态关系读取, 动态结点,
                状态成员关系类型_, 读取.读取事实代次)
            || !关系组头完整(特征关系读取, 动态结点,
                变化特征关系类型_, 读取.读取事实代次))
            return 失败(状态关系读取.读取事实代次
                    != 读取.读取事实代次
                    || 特征关系读取.读取事实代次 != 读取.读取事实代次
                ? 动态类数据状态::事实代次漂移
                : 动态类数据状态::内部不一致,
                std::max(状态关系读取.读取事实代次,
                    特征关系读取.读取事实代次));
        auto 状态关系 = 状态关系读取.关系组;
        auto 特征关系 = 特征关系读取.关系组;
        if (!规范化关系组(状态关系, 动态结点,
                状态成员关系类型_, 2)
            || !规范化关系组(特征关系, 动态结点,
                变化特征关系类型_, 1))
            return 失败(动态类数据状态::内部不一致,
                读取.读取事实代次);
        std::vector<稳定编码> 状态编码组;
        std::vector<稳定编码> 特征编码组;
        for (const auto& 关系 : 状态关系) 状态编码组.push_back(关系.目标节点);
        for (const auto& 关系 : 特征关系) 特征编码组.push_back(关系.目标节点);
        auto 状态组 = 读取状态组(状态编码组, 读取.读取事实代次);
        if (!状态组.成功) return 失败(状态组.状态, 状态组.事实代次);
        auto 特征组 = 读取特征组(特征编码组, 读取.读取事实代次);
        if (!特征组.成功) return 失败(特征组.状态, 特征组.事实代次);
        if (*时间 != 状态组.值.back().时间)
            return 失败(动态类数据状态::内部不一致,
                读取.读取事实代次);
        动态类结点 结果{动态结点, 时间事实.编码, *时间, {}, {},
            节点事实.创建事实代次, std::nullopt};
        for (std::size_t i = 0; i < 状态关系.size(); ++i)
            结果.有序状态组.push_back({static_cast<std::uint32_t>(i + 1),
                状态关系[i].编码, 状态关系[i].目标节点});
        for (std::size_t i = 0; i < 特征关系.size(); ++i)
            结果.变化特征组.push_back({static_cast<std::uint32_t>(i + 1),
                特征关系[i].编码, 特征关系[i].目标节点});
        return {动态类数据状态::已读取, 动态类数据合同版本,
            读取.读取事实代次, std::move(结果)};
    }

    std::optional<动态类结点结果> 尝试重放删除(
        const 动态类删除请求& 请求) {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到)
            return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功
            || 首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_
            || 首次.写入幂等身份 != 请求.幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果)
            return 失败(动态类数据状态::幂等冲突,
                首次.读取事实代次);
        const auto& 写集 = *首次.首次规范化写集;
        const auto& 首次结果 = *首次.首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.size() < 4
            || std::count(写集.退出事实.begin(), 写集.退出事实.end(),
                请求.动态结点) != 1
            || 首次结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(首次结果, 请求.幂等身份)
            || !首次结果.新编码映射.empty())
            return 失败(动态类数据状态::幂等冲突,
                首次结果.事实代次);
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        if (写入.状态 != L1所有者范围写入状态::精确重复
            || !写入结果头完整(写入, 请求.幂等身份))
            return 失败(动态类数据状态::内部不一致,
                写入.事实代次);
        return 读取已退出动态(请求.动态结点, 写入.事实代次,
            动态类数据状态::精确重复);
    }

    动态类结点结果 读取已退出动态(稳定编码 动态结点,
        std::uint64_t 退出事实代次, 动态类数据状态 返回状态) const {
        if (退出事实代次 <= 1)
            return 失败(动态类数据状态::内部不一致, 退出事实代次);
        return 读取历史动态快照(动态结点, 退出事实代次 - 1,
            退出事实代次, 返回状态, 退出事实代次);
    }

    动态类结点结果 读取历史动态快照(稳定编码 动态结点,
        std::uint64_t 历史截止事实代次, std::uint64_t 结果事实代次,
        动态类数据状态 返回状态,
        std::optional<std::uint64_t> 要求退出事实代次) const {
        const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 动态结点});
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (节点读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(节点读取.状态),
                节点读取.读取事实代次);
        if (!节点
            || 节点->编码 != 动态结点 || 节点->写入所有者 != 所有者_
            || 节点->创建事实代次 == 0
            || 节点->创建事实代次 > 历史截止事实代次
            || (节点->退出事实代次
                && *节点->退出事实代次 <= 历史截止事实代次)
            || (要求退出事实代次
                && 节点->退出事实代次 != 要求退出事实代次))
            return 失败(动态类数据状态::内部不一致,
                节点读取.读取事实代次);
        const auto 属性读取 = 第一层服务_.读取所有者范围历史属性值组(
            {L1所有者范围CRUD合同版本, 动态结点,
                历史截止事实代次});
        const auto 状态关系读取 = 第一层服务_.读取所有者范围历史关系组(
            {L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::源, 动态结点,
                状态成员关系类型_, 历史截止事实代次});
        const auto 特征关系读取 = 第一层服务_.读取所有者范围历史关系组(
            {L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::源, 动态结点,
                变化特征关系类型_, 历史截止事实代次});
        if (属性读取.状态 != L1所有者范围读取状态::成功
            || 状态关系读取.状态 != L1所有者范围读取状态::成功
            || 特征关系读取.状态 != L1所有者范围读取状态::成功
            || 属性读取.属性值组.size() != 1)
            return 失败(动态类数据状态::内部不一致, 结果事实代次);
        auto 状态关系 = 状态关系读取.关系组;
        auto 特征关系 = 特征关系读取.关系组;
        if (!规范化关系组(状态关系, 动态结点, 状态成员关系类型_, 2,
                历史截止事实代次, 要求退出事实代次)
            || !规范化关系组(特征关系, 动态结点,
                变化特征关系类型_, 1, 历史截止事实代次,
                要求退出事实代次))
            return 失败(动态类数据状态::内部不一致, 结果事实代次);
        const auto& 时间事实 = 属性读取.属性值组.front();
        const auto* 时间 = std::get_if<std::int64_t>(&时间事实.材料);
        if (!时间 || *时间 <= 0 || 时间事实.所属节点 != 动态结点
            || 时间事实.属性类型节点 != 发生时间属性类型_
            || 时间事实.写入所有者 != 所有者_
            || 时间事实.创建事实代次 != 节点->创建事实代次
            || 时间事实.创建事实代次 > 历史截止事实代次
            || (时间事实.退出事实代次
                && *时间事实.退出事实代次 <= 历史截止事实代次)
            || (要求退出事实代次
                && 时间事实.退出事实代次 != 要求退出事实代次))
            return 失败(动态类数据状态::内部不一致, 结果事实代次);
        动态类结点 结果{动态结点, 时间事实.编码, *时间, {}, {},
            节点->创建事实代次, 要求退出事实代次};
        for (std::size_t i = 0; i < 状态关系.size(); ++i)
            结果.有序状态组.push_back({static_cast<std::uint32_t>(i + 1),
                状态关系[i].编码, 状态关系[i].目标节点});
        for (std::size_t i = 0; i < 特征关系.size(); ++i)
            结果.变化特征组.push_back({static_cast<std::uint32_t>(i + 1),
                特征关系[i].编码, 特征关系[i].目标节点});
        return {返回状态, 动态类数据合同版本,
            结果事实代次, std::move(结果)};
    }

    template<class 谓词>
    动态类组查询结果 按关系目标查询(稳定编码 目标,
        稳定编码 关系类型, std::uint64_t 期望事实代次,
        std::uint64_t 最大结果数量, 谓词&& 命中) const {
        try {
            const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
                {L1所有者范围CRUD合同版本, 目标, 关系类型});
            if (读取.状态 != L1所有者范围读取状态::成功)
                return 组失败(映射读取状态(读取.状态),
                    读取.读取事实代次);
            if (读取.读取事实代次 != 期望事实代次)
                return 组失败(动态类数据状态::事实代次漂移,
                    读取.读取事实代次);
            std::vector<稳定编码> 候选;
            for (const auto& 关系 : 读取.关系组) {
                if (关系.目标节点 != 目标 || 关系.关系类型节点 != 关系类型
                    || 关系.写入所有者 != 所有者_ || 关系.退出事实代次)
                    return 组失败(动态类数据状态::内部不一致,
                        读取.读取事实代次);
                候选.push_back(关系.源节点);
            }
            std::sort(候选.begin(), 候选.end());
            候选.erase(std::unique(候选.begin(), 候选.end()), 候选.end());
            if (候选.size() > 最大结果数量)
                return 组失败(动态类数据状态::数量预算不足,
                    读取.读取事实代次);
            动态类组查询结果 结果{动态类数据状态::已读取,
                动态类数据合同版本, 读取.读取事实代次, {}};
            for (const auto 编码 : 候选) {
                const auto 单项 = 读取当前动态(编码, 读取.读取事实代次);
                if (!单项.成功() || 单项.状态 != 动态类数据状态::已读取
                    || !单项.动态结点)
                    return 组失败(动态类数据状态::内部不一致,
                        读取.读取事实代次);
                if (命中(*单项.动态结点))
                    结果.动态组.push_back(*单项.动态结点);
            }
            return 结果;
        } catch (const std::bad_alloc&) {
            return 组失败(动态类数据状态::资源失败);
        } catch (...) {
            return 组失败(动态类数据状态::内部不一致);
        }
    }

    const L1所有者范围一致属性值投影* 查找属性投影(
        const L1所有者范围一致当前读取结果& 读取) const noexcept {
        const auto it = std::find_if(读取.属性值.begin(), 读取.属性值.end(),
            [&](const auto& 项) noexcept {
                return 项.节点 == 读取.节点.front().查询编码
                    && 项.属性类型 == 发生时间属性类型_;
            });
        if (it == 读取.属性值.end()
            || it->状态 != L1所有者范围一致当前读取项目状态::成功
            || !it->投影)
            return nullptr;
        return &*it->投影;
    }

    bool 值投影完整(const L1所有者范围一致属性值投影& 投影,
        const L1所有者范围节点事实& 节点) const noexcept {
        const auto& 值 = 投影.当前值事实;
        return 投影.属性槽.属性类型节点 == 发生时间属性类型_
            && 投影.属性槽.当前值 == 值.编码
            && std::find(节点.当前属性.begin(), 节点.当前属性.end(),
                投影.属性槽) != 节点.当前属性.end()
            && 值.所属节点 == 节点.编码
            && 值.属性类型节点 == 发生时间属性类型_
            && 值.来源节点 == 节点.编码
            && 值.写入所有者 == 节点.写入所有者
            && 值.创建事实代次 == 节点.创建事实代次
            && !值.退出事实代次;
    }

    bool 关系组头完整(const L1所有者范围源关系组读取结果& 读取,
        稳定编码 源, 稳定编码 类型, std::uint64_t 事实代次) const noexcept {
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.源节点 == 源 && 读取.关系类型节点 == 类型
            && 读取.读取事实代次 == 事实代次;
    }

    bool 规范化关系组(std::vector<L1所有者范围关系事实>& 关系组,
        稳定编码 源, 稳定编码 类型, std::size_t 最小数量,
        std::optional<std::uint64_t> 历史截止事实代次 = std::nullopt,
        std::optional<std::uint64_t> 要求退出事实代次 = std::nullopt) const {
        if (关系组.size() < 最小数量
            || 关系组.size() > 动态类数据内部::最大成员数量)
            return false;
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept { return 左.角色或顺序 < 右.角色或顺序; });
        for (std::size_t i = 0; i < 关系组.size(); ++i) {
            const auto& 关系 = 关系组[i];
            if (!有效(关系.编码) || 关系.源节点 != 源
                || !有效(关系.目标节点) || 关系.关系类型节点 != 类型
                || 关系.角色或顺序 != static_cast<std::int64_t>(i + 1)
                || 关系.写入所有者 != 所有者_
                || (!历史截止事实代次 && 关系.退出事实代次)
                || (历史截止事实代次
                    && (关系.创建事实代次 > *历史截止事实代次
                        || (关系.退出事实代次
                            && *关系.退出事实代次
                                <= *历史截止事实代次)))
                || (要求退出事实代次
                    && 关系.退出事实代次 != 要求退出事实代次))
                return false;
            for (std::size_t j = 0; j < i; ++j)
                if (关系组[j].目标节点 == 关系.目标节点) return false;
        }
        return true;
    }

    bool 写入结果头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等身份) const noexcept {
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态
                == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_
            && 写入.写入幂等身份 == 幂等身份
            && 写入.事实代次 != 0 && (首次完整 || 重复完整);
    }

    static 动态类结点结果 失败(动态类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 动态类数据合同版本, 事实代次, std::nullopt};
    }

    static 动态类组查询结果 组失败(动态类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 动态类数据合同版本, 事实代次, {}};
    }

    static 动态类数据状态 映射状态状态(状态类数据状态 状态) noexcept {
        switch (状态) {
        case 状态类数据状态::未找到:
            return 动态类数据状态::状态未找到;
        case 状态类数据状态::目标已退出:
            return 动态类数据状态::状态已退出;
        case 状态类数据状态::事实代次漂移:
            return 动态类数据状态::事实代次漂移;
        case 状态类数据状态::入口拒绝:
            return 动态类数据状态::入口拒绝;
        case 状态类数据状态::历史材料已清理:
            return 动态类数据状态::历史材料已清理;
        case 状态类数据状态::资源失败:
            return 动态类数据状态::资源失败;
        default:
            return 动态类数据状态::状态读取失败;
        }
    }

    static 动态类数据状态 映射特征状态(特征类数据状态 状态) noexcept {
        switch (状态) {
        case 特征类数据状态::未找到:
        case 特征类数据状态::特征类型未找到:
            return 动态类数据状态::特征未找到;
        case 特征类数据状态::目标已退出:
        case 特征类数据状态::特征类型已退出:
            return 动态类数据状态::特征已退出;
        case 特征类数据状态::事实代次漂移:
            return 动态类数据状态::事实代次漂移;
        case 特征类数据状态::入口拒绝:
            return 动态类数据状态::入口拒绝;
        case 特征类数据状态::资源失败:
            return 动态类数据状态::资源失败;
        default:
            return 动态类数据状态::特征读取失败;
        }
    }

    static 动态类数据状态 映射读取状态(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::未找到:
            return 动态类数据状态::未找到;
        case L1所有者范围读取状态::已退出:
            return 动态类数据状态::目标已退出;
        case L1所有者范围读取状态::事实代次漂移:
            return 动态类数据状态::事实代次漂移;
        case L1所有者范围读取状态::历史材料已清理:
            return 动态类数据状态::历史材料已清理;
        case L1所有者范围读取状态::入口拒绝:
            return 动态类数据状态::入口拒绝;
        case L1所有者范围读取状态::资源失败:
            return 动态类数据状态::资源失败;
        default:
            return 动态类数据状态::内部不一致;
        }
    }

    static 动态类数据状态 映射一致读取状态(
        L1所有者范围一致当前读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围一致当前读取状态::事实代次漂移:
            return 动态类数据状态::事实代次漂移;
        case L1所有者范围一致当前读取状态::入口拒绝:
            return 动态类数据状态::入口拒绝;
        case L1所有者范围一致当前读取状态::资源失败:
            return 动态类数据状态::资源失败;
        default:
            return 动态类数据状态::内部不一致;
        }
    }

    static 动态类数据状态 映射写入状态(
        L1所有者范围写入状态 状态,
        动态类数据状态 成功状态) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功:
            return 成功状态;
        case L1所有者范围写入状态::精确重复:
            return 动态类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝:
            return 动态类数据状态::入口拒绝;
        case L1所有者范围写入状态::未找到:
            return 动态类数据状态::结构类型未找到;
        case L1所有者范围写入状态::已退出:
            return 动态类数据状态::结构类型已退出;
        case L1所有者范围写入状态::事实代次漂移:
            return 动态类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突:
            return 动态类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突:
            return 动态类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败:
            return 动态类数据状态::资源失败;
        default:
            return 动态类数据状态::内部不一致;
        }
    }

    const L1事实基座服务& 第一层服务_;
    const 特征类数据服务& 特征服务_;
    const 状态类数据服务& 状态服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    稳定编码 发生时间属性类型_{};
    稳定编码 状态成员关系类型_{};
    稳定编码 变化特征关系类型_{};
};

} // namespace 海中鱼巣
