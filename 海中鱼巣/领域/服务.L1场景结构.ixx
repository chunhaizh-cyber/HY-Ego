module;

#include <array>
#include <cstdint>
#include <mutex>
#include <new>
#include <optional>
#include <variant>

export module 海中鱼巣.领域.服务.L1场景结构;
export import 海中鱼巣.核心.合同.L1公共事实;
import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.世界登记;

export {
#define L1场景结构数据已导入公共事实
#include "L1场景结构.数据.h"
#undef L1场景结构数据已导入公共事实
}

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 初始场景直接存在成员退出合同版本 = 1;

struct 初始场景直接存在成员退出请求 final {
    std::uint32_t 合同版本 = 初始场景直接存在成员退出合同版本;
    std::uint32_t 世界规则版本 = 世界登记规则版本;
    世界操作幂等身份 幂等身份;
    std::uint64_t 期望事实代次 = 0;
    初始场景读取请求 场景;
    世界结构节点身份见证 存在;
    稳定编码 当前归属关系;
    friend bool operator==(const 初始场景直接存在成员退出请求&,
        const 初始场景直接存在成员退出请求&) = default;
};

struct 已退出直接存在成员关系见证 final {
    世界结构关系身份见证 关系;
    std::uint64_t 创建事实代次 = 0;
    std::uint64_t 退出事实代次 = 0;
    friend bool operator==(const 已退出直接存在成员关系见证&,
        const 已退出直接存在成员关系见证&) = default;
};

struct 初始场景直接存在成员退出事实 final {
    std::uint32_t 合同版本 = 初始场景直接存在成员退出合同版本;
    std::uint32_t 世界规则版本 = 世界登记规则版本;
    std::uint64_t 发布事实代次 = 0;
    std::uint64_t 事实截止代次 = 0;
    世界结构节点身份见证 世界根;
    世界结构节点身份见证 原场景;
    世界结构节点身份见证 存在;
    已退出直接存在成员关系见证 已退出归属关系;
    friend bool operator==(const 初始场景直接存在成员退出事实&,
        const 初始场景直接存在成员退出事实&) = default;
};

struct 初始场景直接存在成员退出结果 final {
    世界结构状态 状态 = 世界结构状态::入口拒绝;
    std::optional<初始场景直接存在成员退出事实> 事实;
    bool 成功() const noexcept;
    friend bool operator==(const 初始场景直接存在成员退出结果&,
        const 初始场景直接存在成员退出结果&) = default;
};

} // namespace 海中鱼巣

namespace 海中鱼巣::L1场景结构内部 {

using namespace 海中鱼巣;

inline constexpr std::uint64_t L1幂等域 = 0x02ULL;
inline constexpr std::uint64_t 直接存在成员退出幂等域 = 0x1AULL;

L1中性写集幂等键 映射L1幂等键(世界操作幂等身份 身份) noexcept {
    return { (L1幂等域 << 56) | 身份.值 };
}

L1中性写集幂等键 映射退出幂等键(世界操作幂等身份 身份) noexcept {
    return {(直接存在成员退出幂等域 << 56) | 身份.值};
}

世界结构状态 写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 世界结构状态::已提交;
    case L1中性写入状态::精确重复: return 世界结构状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 世界结构状态::入口拒绝;
    case L1中性写入状态::事实代次漂移: return 世界结构状态::版本漂移;
    case L1中性写入状态::幂等冲突: return 世界结构状态::幂等冲突;
    case L1中性写入状态::资源失败: return 世界结构状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return 世界结构状态::内部不一致;
    }
    return 世界结构状态::内部不一致;
}

世界结构状态 退出写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 世界结构状态::已提交;
    case L1中性写入状态::精确重复: return 世界结构状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 世界结构状态::入口拒绝;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出: return 世界结构状态::未找到;
    case L1中性写入状态::事实代次漂移: return 世界结构状态::版本漂移;
    case L1中性写入状态::幂等冲突: return 世界结构状态::幂等冲突;
    case L1中性写入状态::资源失败: return 世界结构状态::资源失败;
    case L1中性写入状态::内部不一致: return 世界结构状态::内部不一致;
    }
    return 世界结构状态::内部不一致;
}

bool 直接存在成员退出请求有效(
    const 初始场景直接存在成员退出请求& 请求) noexcept {
    return 请求.合同版本 == 初始场景直接存在成员退出合同版本
        && 请求.世界规则版本 == 世界登记规则版本
        && 世界操作幂等身份有效(请求.幂等身份)
        && 请求.期望事实代次 != 0
        && 初始场景读取请求有效(请求.场景)
        && 请求.场景.世界规则版本 == 请求.世界规则版本
        && 世界结构节点见证有效(请求.存在)
        && 请求.存在.类型 == 节点种类::普通
        && 有效(请求.当前归属关系)
        && 请求.当前归属关系 != 请求.场景.世界根.编码
        && 请求.当前归属关系 != 请求.场景.初始场景
        && 请求.当前归属关系 != 请求.存在.编码;
}

bool 已退出直接存在成员关系见证完整(
    const 已退出直接存在成员关系见证& 见证) noexcept {
    return 世界结构关系见证有效(见证.关系)
        && 见证.创建事实代次 != 0
        && 见证.退出事实代次 >= 见证.创建事实代次;
}

bool 直接存在成员退出事实完整(
    const 初始场景直接存在成员退出事实& 事实) noexcept {
    return 事实.合同版本 == 初始场景直接存在成员退出合同版本
        && 事实.世界规则版本 == 世界登记规则版本
        && 事实.发布事实代次 != 0
        && 事实.事实截止代次 >= 事实.发布事实代次
        && 世界结构节点见证有效(事实.世界根)
        && 世界结构节点见证有效(事实.原场景)
        && 世界结构节点见证有效(事实.存在)
        && 已退出直接存在成员关系见证完整(事实.已退出归属关系)
        && 事实.世界根.类型 == 节点种类::普通
        && 事实.原场景.类型 == 节点种类::普通
        && 事实.存在.类型 == 节点种类::普通
        && 事实.已退出归属关系.关系.源端 == 事实.原场景
        && 事实.已退出归属关系.关系.目标端 == 事实.存在
        && 事实.已退出归属关系.关系.角色或顺序 == 0
        && 事实.已退出归属关系.退出事实代次 == 事实.发布事实代次;
}

世界结构状态 读取状态(L1中性读取状态 状态) noexcept {
    if (状态 == L1中性读取状态::未找到
        || 状态 == L1中性读取状态::属性未设置)
        return 世界结构状态::未找到;
    if (状态 == L1中性读取状态::资源失败) return 世界结构状态::资源失败;
    if (状态 == L1中性读取状态::内部不一致
        || 状态 == L1中性读取状态::已退出)
        return 世界结构状态::内部不一致;
    return 世界结构状态::入口拒绝;
}

世界结构状态 读取状态(L1读取状态 状态) noexcept {
    if (状态 == L1读取状态::未找到 || 状态 == L1读取状态::属性未设置)
        return 世界结构状态::未找到;
    if (状态 == L1读取状态::事实代次漂移) return 世界结构状态::版本漂移;
    if (状态 == L1读取状态::资源失败) return 世界结构状态::资源失败;
    if (状态 == L1读取状态::内部不一致 || 状态 == L1读取状态::已退出)
        return 世界结构状态::内部不一致;
    return 世界结构状态::入口拒绝;
}

世界结构状态 登记状态(世界登记状态 状态) noexcept {
    switch (状态) {
    case 世界登记状态::事实代次漂移: return 世界结构状态::版本漂移;
    case 世界登记状态::许可拒绝: return 世界结构状态::许可拒绝;
    case 世界登记状态::资源失败: return 世界结构状态::资源失败;
    case 世界登记状态::内部不一致: return 世界结构状态::内部不一致;
    case 世界登记状态::登记未加载: return 世界结构状态::未找到;
    default: return 世界结构状态::入口拒绝;
    }
}

std::optional<稳定编码> 映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& 项 : 结果.新编码映射) {
        if (项.first.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 项.second;
    }
    return 找到;
}

bool 编码与登记不重复(const 世界结构登记& 登记,
    稳定编码 场景, 稳定编码 值, 稳定编码 关系) noexcept {
    const std::array<稳定编码, 8> 编码组{
        登记.服务身份, 登记.场景标记属性类型,
        登记.直接父场景关系类型, 登记.直接成员关系类型,
        登记.世界根场景, 场景, 值, 关系};
    for (std::size_t i = 0; i < 编码组.size(); ++i) {
        if (!有效(编码组[i])) return false;
        for (std::size_t j = i + 1; j < 编码组.size(); ++j)
            if (编码组[i] == 编码组[j]) return false;
    }
    return true;
}

初始场景结果 读取实现(const L1事实基座服务& L1,
    const 世界登记结果& 登记结果, const 初始场景读取请求& 请求) {
    if (!登记结果.成功() || !登记结果.登记)
        return {登记状态(登记结果.状态), std::nullopt};
    const auto& 登记 = *登记结果.登记;
    if (!初始场景读取请求有效(请求)
        || 请求.世界根.编码 != 登记.世界根场景)
        return {世界结构状态::入口拒绝, std::nullopt};

    const auto 起始 = L1.读取中性当前事实代次({});
    if (起始.状态 != L1中性读取状态::成功)
        return {读取状态(起始.状态), std::nullopt};
    const auto 场景结果 = L1.读取中性当前节点(
        {L1中性CRUD合同版本, 请求.初始场景});
    if (场景结果.状态 != L1中性读取状态::成功 || !场景结果.事实)
        return {读取状态(场景结果.状态), std::nullopt};
    const auto 属性结果 = L1.读取中性当前属性({
        L1中性CRUD合同版本, 请求.初始场景, 登记.场景标记属性类型});
    if (属性结果.状态 != L1中性读取状态::成功
        || !属性结果.当前值.has_value())
        return {读取状态(属性结果.状态), std::nullopt};
    const auto 值结果 = L1.读取中性当前值(
        {L1中性CRUD合同版本, 请求.场景标记值});
    if (值结果.状态 != L1中性读取状态::成功 || !值结果.事实)
        return {读取状态(值结果.状态), std::nullopt};
    const auto 关系结果 = L1.读取中性当前关系(
        {L1中性CRUD合同版本, 请求.直接父关系});
    if (关系结果.状态 != L1中性读取状态::成功 || !关系结果.事实)
        return {读取状态(关系结果.状态), std::nullopt};
    const auto 结束 = L1.读取中性当前事实代次({});
    if (结束.状态 != L1中性读取状态::成功)
        return {读取状态(结束.状态), std::nullopt};

    const auto 代次 = 起始.事实代次;
    if (起始.合同版本 != L1中性CRUD合同版本
        || 结束.合同版本 != L1中性CRUD合同版本
        || 代次 == 0 || 结束.事实代次 != 代次
        || 登记.已验证事实代次 != 代次
        || 场景结果.合同版本 != L1中性CRUD合同版本
        || 场景结果.读取事实代次 != 代次
        || 属性结果.合同版本 != L1中性CRUD合同版本
        || 属性结果.读取事实代次 != 代次
        || 值结果.合同版本 != L1中性CRUD合同版本
        || 值结果.读取事实代次 != 代次
        || 关系结果.合同版本 != L1中性CRUD合同版本
        || 关系结果.读取事实代次 != 代次)
        return {世界结构状态::版本漂移, std::nullopt};

    const auto& 场景 = *场景结果.事实;
    const auto& 值 = *值结果.事实;
    const auto& 关系 = *关系结果.事实;
    if (场景结果.查询编码 != 请求.初始场景
        || 场景.编码 != 请求.初始场景 || 场景.种类 != 节点种类::普通
        || 场景.属性类型表示.has_value() || 场景.退出事实代次.has_value()
        || 场景.当前属性.size() != 1
        || 场景.当前属性[0].属性类型节点 != 登记.场景标记属性类型
        || 场景.当前属性[0].当前值 != 请求.场景标记值
        || 属性结果.节点 != 请求.初始场景
        || 属性结果.属性类型 != 登记.场景标记属性类型
        || *属性结果.当前值 != 请求.场景标记值
        || 值结果.查询编码 != 请求.场景标记值
        || 值.编码 != 请求.场景标记值
        || 值.所属节点 != 请求.初始场景
        || 值.属性类型节点 != 登记.场景标记属性类型
        || 值.来源节点 != 登记.服务身份 || 值.退出事实代次.has_value()
        || !std::holds_alternative<std::int64_t>(值.材料)
        || std::get<std::int64_t>(值.材料) != 1
        || 关系结果.查询编码 != 请求.直接父关系
        || 关系.编码 != 请求.直接父关系
        || 关系.源节点 != 请求.世界根.编码
        || 关系.目标节点 != 请求.初始场景
        || 关系.关系类型节点 != 登记.直接父场景关系类型
        || 关系.角色或顺序 != 0 || 关系.退出事实代次.has_value()
        || 场景.创建事实代次 == 0
        || 场景.创建事实代次 != 值.创建事实代次
        || 场景.创建事实代次 != 关系.创建事实代次
        || 场景.创建事实代次 > 代次)
        return {世界结构状态::内部不一致, std::nullopt};

    初始场景事实 事实;
    事实.事实截止代次 = 代次;
    事实.世界根 = {登记.世界根场景, 节点种类::普通};
    事实.初始场景 = {场景.编码, 场景.种类};
    事实.场景标记 = {值.编码, {值.所属节点, 场景.种类},
        {值.属性类型节点, 节点种类::属性类型},
        std::get<std::int64_t>(值.材料),
        {值.来源节点, 节点种类::普通}, 值.创建事实代次};
    事实.直接父关系 = {关系.编码,
        {关系.关系类型节点, 节点种类::普通},
        {关系.源节点, 节点种类::普通},
        {关系.目标节点, 场景.种类}, 关系.角色或顺序};
    return {世界结构状态::已读取, 事实};
}

初始场景结果 创建实现(L1事实基座服务& L1, 世界登记服务& 登记服务,
    const 初始场景创建请求& 请求, L1中性写集幂等键 幂等键) {
    if (!初始场景创建请求有效(请求)) return {};

    const auto 登记结果 = 登记服务.读取当前登记();
    if (!登记结果.成功() || !登记结果.登记)
        return {登记状态(登记结果.状态), std::nullopt};
    if (登记结果.状态 != 世界登记状态::已读取
        || 请求.世界规则版本 != 登记结果.登记->世界规则版本
        || 请求.世界根.编码 != 登记结果.登记->世界根场景
        || 登记结果.登记->已验证事实代次 != 请求.期望事实代次)
        return {世界结构状态::版本漂移, std::nullopt};

    L1中性写集请求 写集;
    写集.合同版本 = L1中性CRUD合同版本;
    写集.期望事实代次 = 请求.期望事实代次;
    写集.幂等键 = 幂等键;
    写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    写集.值 = {{{2}, L1中性写集本地键{1},
        稳定编码{登记结果.登记->场景标记属性类型},
        std::int64_t{1}, 稳定编码{登记结果.登记->服务身份}}};
    写集.关系 = {{{3}, 稳定编码{请求.世界根.编码},
        L1中性写集本地键{1},
        稳定编码{登记结果.登记->直接父场景关系类型}, 0}};
    写集.属性槽变更 = {{L1中性写集本地键{1},
        稳定编码{登记结果.登记->场景标记属性类型},
        L1中性写集本地键{2}}};

    const auto 写入 = L1.提交中性写集(写集);
    const auto 写入世界状态 = 写入状态(写入.状态);
    if (写入世界状态 != 世界结构状态::已提交
        && 写入世界状态 != 世界结构状态::幂等读回) {
        return {写入世界状态, std::nullopt};
    }
    const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    if (写入.合同版本 != L1中性CRUD合同版本
        || !(写入.幂等键 == 幂等键) || 写入.事实代次 == 0
        || 写入.新编码映射.size() != 3
        || (!首次成功完整 && !重复成功完整))
        return {世界结构状态::内部不一致, std::nullopt};

    const auto 场景编码 = 映射(写入, 1);
    const auto 值编码 = 映射(写入, 2);
    const auto 关系编码 = 映射(写入, 3);
    if (!场景编码 || !值编码 || !关系编码
        || !编码与登记不重复(
            *登记结果.登记, *场景编码, *值编码, *关系编码))
        return {世界结构状态::内部不一致, std::nullopt};

    初始场景读取请求 读取请求;
    读取请求.合同版本 = 请求.合同版本;
    读取请求.世界规则版本 = 请求.世界规则版本;
    读取请求.世界根 = 请求.世界根;
    读取请求.初始场景 = *场景编码;
    读取请求.场景标记值 = *值编码;
    读取请求.直接父关系 = *关系编码;
    const auto 当前登记结果 = 登记服务.读取当前登记();
    const auto 读回 = 读取实现(L1, 当前登记结果, 读取请求);
    if (读回.状态 != 世界结构状态::已读取 || !读回.事实)
        return {读回.状态, std::nullopt};
    if (读回.事实->场景标记.创建事实代次 != 写入.事实代次
        || !初始场景事实完整(*读回.事实))
        return {世界结构状态::内部不一致, std::nullopt};
    return {写入世界状态, std::move(读回.事实)};
}

初始场景接纳规格结果 形成接纳规格实现(const L1事实基座服务& L1,
    const 世界登记结果& 登记结果, const 初始场景接纳规格请求& 请求) {
    const auto 场景结果 = 读取实现(L1, 登记结果, 请求.场景);
    if (场景结果.状态 != 世界结构状态::已读取 || !场景结果.事实)
        return {场景结果.状态, std::nullopt};
    if (场景结果.事实->事实截止代次 != 请求.期望事实代次)
        return {世界结构状态::版本漂移, std::nullopt};
    初始场景接纳规格 规格{请求.期望事实代次,
        场景结果.事实->初始场景,
        {登记结果.登记->直接成员关系类型, 节点种类::普通}};
    return 初始场景接纳规格完整(规格)
        ? 初始场景接纳规格结果{世界结构状态::已读取, 规格}
        : 初始场景接纳规格结果{世界结构状态::内部不一致, std::nullopt};
}

// 诊断责任：向上送出；条件关系组的缺失、漂移和结构矛盾保留为结构化结果。
初始场景接纳结果 读取接纳实现(const L1事实基座服务& L1,
    const 世界登记结果& 登记结果, const 初始场景接纳读取请求& 请求) {
    const auto 场景结果 = 读取实现(L1, 登记结果, 请求.场景);
    if (场景结果.状态 != 世界结构状态::已读取 || !场景结果.事实)
        return {场景结果.状态, std::nullopt};

    const auto 起始 = L1.读取中性当前事实代次({});
    const auto 成员结果 = L1.读取中性当前节点(
        {L1中性CRUD合同版本, 请求.成员});
    const auto 类型结果 = L1.读取中性当前节点({L1中性CRUD合同版本,
        登记结果.登记->直接成员关系类型});
    const auto 归属结果 = L1.读取中性当前目标关系组({L1中性CRUD合同版本,
        请求.成员, 登记结果.登记->直接成员关系类型});
    const auto 结束 = L1.读取中性当前事实代次({});

    const auto* 失败结果 = [&]() -> const L1中性读取状态* {
        if (起始.状态 != L1中性读取状态::成功) return &起始.状态;
        if (成员结果.状态 != L1中性读取状态::成功) return &成员结果.状态;
        if (类型结果.状态 != L1中性读取状态::成功) return &类型结果.状态;
        if (归属结果.状态 != L1中性读取状态::成功) return &归属结果.状态;
        if (结束.状态 != L1中性读取状态::成功) return &结束.状态;
        return nullptr;
    }();
    if (失败结果) return {读取状态(*失败结果), std::nullopt};

    const auto 代次 = 起始.事实代次;
    if (起始.合同版本 != L1中性CRUD合同版本
        || 结束.合同版本 != L1中性CRUD合同版本
        || 代次 == 0 || 结束.事实代次 != 代次
        || 场景结果.事实->事实截止代次 != 代次
        || 成员结果.合同版本 != L1中性CRUD合同版本
        || 类型结果.合同版本 != L1中性CRUD合同版本
        || 归属结果.合同版本 != L1中性CRUD合同版本
        || 归属结果.目标节点 != 请求.成员
        || 归属结果.关系类型节点 != 登记结果.登记->直接成员关系类型
        || 成员结果.读取事实代次 != 代次
        || 类型结果.读取事实代次 != 代次
        || 归属结果.读取事实代次 != 代次)
        return {世界结构状态::版本漂移, std::nullopt};
    if (!成员结果.事实 || !类型结果.事实)
        return {世界结构状态::内部不一致, std::nullopt};

    const auto& 成员 = *成员结果.事实;
    const auto& 类型 = *类型结果.事实;
    if (成员结果.查询编码 != 请求.成员 || 成员.编码 != 请求.成员
        || 类型结果.查询编码 != 登记结果.登记->直接成员关系类型
        || 类型.编码 != 登记结果.登记->直接成员关系类型
        || 成员.种类 != 节点种类::普通
        || 成员.属性类型表示.has_value() || 成员.退出事实代次.has_value()
        || 类型.种类 != 节点种类::普通
        || 类型.属性类型表示.has_value() || 类型.退出事实代次.has_value())
        return {世界结构状态::内部不一致, std::nullopt};
    if (归属结果.关系组.empty()) return {世界结构状态::未找到, std::nullopt};
    if (归属结果.关系组.size() != 1)
        return {世界结构状态::内部不一致, std::nullopt};

    const auto& 归属 = 归属结果.关系组.front();
    if (归属.目标节点 != 请求.成员
        || 归属.关系类型节点 != 登记结果.登记->直接成员关系类型
        || 归属.退出事实代次.has_value() || 归属.创建事实代次 == 0
        || 归属.创建事实代次 > 代次)
        return {世界结构状态::内部不一致, std::nullopt};
    if (归属.编码 != 请求.归属关系
        || 归属.源节点 != 请求.场景.初始场景
        || 归属.角色或顺序 != 0)
        return {世界结构状态::未找到, std::nullopt};
    初始场景接纳事实 事实;
    事实.事实截止代次 = 代次;
    事实.场景 = 场景结果.事实->初始场景;
    事实.成员 = {成员.编码, 成员.种类};
    事实.归属关系 = {归属.编码, {类型.编码, 类型.种类},
        事实.场景, 事实.成员, 归属.角色或顺序};
    return 初始场景接纳事实完整(事实)
        ? 初始场景接纳结果{世界结构状态::已读取, 事实}
        : 初始场景接纳结果{世界结构状态::内部不一致, std::nullopt};
}

} // namespace 海中鱼巣::L1场景结构内部

export namespace 海中鱼巣 {

// 诊断责任：无适用错误分支；纯值结果成功判断不读取状态、不产生副作用。
inline bool 初始场景直接存在成员退出结果::成功() const noexcept {
    return (状态 == 世界结构状态::已提交 || 状态 == 世界结构状态::幂等读回)
        && 事实.has_value() && L1场景结构内部::直接存在成员退出事实完整(*事实);
}

class L1场景结构服务 final {
public:
    L1场景结构服务(L1事实基座服务& L1, 世界登记服务& 世界登记) noexcept
        : L1_(L1), 世界登记_(世界登记) {}
    L1场景结构服务(const L1场景结构服务&) = delete;
    L1场景结构服务& operator=(const L1场景结构服务&) = delete;
    L1场景结构提供者身份凭证 读取提供者身份() const noexcept { return {}; }
    初始场景结果 创建初始场景(const 初始场景创建请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!初始场景创建请求有效(请求)) return {};
            const auto 幂等键 = L1场景结构内部::映射L1幂等键(请求.幂等身份);
            auto 结果 = L1场景结构内部::创建实现(
                L1_, 世界登记_, 请求, 幂等键);
            if (结果.成功() && 结果.事实) {
                初始场景读取请求 定位;
                定位.合同版本 = 结果.事实->合同版本;
                定位.世界规则版本 = 结果.事实->世界规则版本;
                定位.世界根 = 结果.事实->世界根;
                定位.初始场景 = 结果.事实->初始场景.编码;
                定位.场景标记值 = 结果.事实->场景标记.编码;
                定位.直接父关系 = 结果.事实->直接父关系.编码;
                if (!初始场景读取请求有效(定位)
                    || (当前初始场景定位_.has_value()
                        && !(*当前初始场景定位_ == 定位))) {
                    return {世界结构状态::内部不一致, std::nullopt};
                }
                当前初始场景定位_ = 定位;
            }
            return 结果;
        }
        catch (const std::bad_alloc&) { return {世界结构状态::资源失败, std::nullopt}; }
        catch (...) { return {世界结构状态::内部不一致, std::nullopt}; }
    }
    初始场景结果 读取初始场景(const 初始场景读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!初始场景读取请求有效(请求)) return {};
            const auto 登记结果 = 世界登记_.读取当前登记();
            if (!登记结果.成功() || !登记结果.登记)
                return {L1场景结构内部::登记状态(登记结果.状态), std::nullopt};
            if (登记结果.状态 != 世界登记状态::已读取
                || 请求.世界根.编码 != 登记结果.登记->世界根场景)
                return {世界结构状态::入口拒绝, std::nullopt};
            return L1场景结构内部::读取实现(L1_, 登记结果, 请求);
        } catch (const std::bad_alloc&) { return {世界结构状态::资源失败, std::nullopt}; }
        catch (...) { return {世界结构状态::内部不一致, std::nullopt}; }
    }
    初始场景结果 读取当前初始场景() const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!当前初始场景定位_.has_value())
                return {世界结构状态::未找到, std::nullopt};
            const auto 登记结果 = 世界登记_.读取当前登记();
            if (!登记结果.成功() || !登记结果.登记)
                return {L1场景结构内部::登记状态(登记结果.状态), std::nullopt};
            return L1场景结构内部::读取实现(
                L1_, 登记结果, *当前初始场景定位_);
        } catch (const std::bad_alloc&) {
            return {世界结构状态::资源失败, std::nullopt};
        } catch (...) { return {世界结构状态::内部不一致, std::nullopt}; }
    }
    初始场景接纳规格结果 形成初始场景接纳规格(
        const 初始场景接纳规格请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.期望事实代次 == 0
                || 请求.场景.合同版本 != L1场景结构合同版本
                || 请求.场景.世界规则版本 != 世界登记规则版本
                || !世界结构节点见证有效(请求.场景.世界根)
                || 请求.场景.世界根.类型 != 节点种类::普通
                || !有效(请求.场景.初始场景)
                || !有效(请求.场景.场景标记值)
                || !有效(请求.场景.直接父关系)) return {};
            const auto 登记结果 = 世界登记_.读取当前登记();
            if (登记结果.状态 != 世界登记状态::已读取 || !登记结果.登记
                || 请求.场景.世界根.编码 != 登记结果.登记->世界根场景)
                return {};
            return L1场景结构内部::形成接纳规格实现(L1_, 登记结果, 请求);
        } catch (const std::bad_alloc&) {
            return {世界结构状态::资源失败, std::nullopt};
        } catch (...) { return {世界结构状态::内部不一致, std::nullopt}; }
    }
    // 诊断责任：向上送出；场景关系准入、提交与终态读回均保留结构化结果。
    初始场景直接存在成员退出结果 退出初始场景直接存在成员关系(
        const 初始场景直接存在成员退出请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!L1场景结构内部::直接存在成员退出请求有效(请求)) return {};

            const auto 登记结果 = 世界登记_.读取当前登记();
            if (登记结果.状态 != 世界登记状态::已读取 || !登记结果.登记)
                return {L1场景结构内部::登记状态(登记结果.状态), std::nullopt};
            if (请求.场景.世界根.编码 != 登记结果.登记->世界根场景)
                return {世界结构状态::入口拒绝, std::nullopt};

            const auto 起始 = L1_.读取中性当前事实代次({});
            if (起始.状态 != L1中性读取状态::成功)
                return {L1场景结构内部::读取状态(起始.状态), std::nullopt};
            const auto 场景结果 = L1场景结构内部::读取实现(
                L1_, 登记结果, 请求.场景);
            if (场景结果.状态 != 世界结构状态::已读取 || !场景结果.事实)
                return {场景结果.状态, std::nullopt};
            const auto 存在结果 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 请求.存在.编码});
            if (存在结果.状态 != L1中性读取状态::成功 || !存在结果.事实)
                return {L1场景结构内部::读取状态(存在结果.状态), std::nullopt};

            const auto 当前关系结果 = L1_.读取中性当前关系(
                {L1中性CRUD合同版本, 请求.当前归属关系});
            bool 已退出候选 = false;
            L1中性关系事实 关系事实;
            if (当前关系结果.状态 == L1中性读取状态::成功
                && 当前关系结果.事实.has_value()) {
                关系事实 = *当前关系结果.事实;
            } else if (当前关系结果.状态 == L1中性读取状态::已退出
                && 当前关系结果.合同版本 == L1中性CRUD合同版本
                && 当前关系结果.查询编码 == 请求.当前归属关系
                && !当前关系结果.事实.has_value()) {
                const auto 历史结果 = L1_.读取中性历史事实(
                    {L1中性CRUD合同版本, 请求.当前归属关系});
                if (历史结果.状态 != L1中性读取状态::成功 || !历史结果.事实)
                    return {L1场景结构内部::读取状态(历史结果.状态), std::nullopt};
                const auto* 历史关系 = std::get_if<L1中性关系事实>(&*历史结果.事实);
                if (!历史关系 || 历史结果.合同版本 != L1中性CRUD合同版本
                    || 历史结果.查询编码 != 请求.当前归属关系)
                    return {世界结构状态::内部不一致, std::nullopt};
                关系事实 = *历史关系;
                已退出候选 = true;
            } else {
                return {L1场景结构内部::读取状态(当前关系结果.状态), std::nullopt};
            }

            const auto 结束 = L1_.读取中性当前事实代次({});
            if (结束.状态 != L1中性读取状态::成功)
                return {L1场景结构内部::读取状态(结束.状态), std::nullopt};
            const auto 当前截止 = 起始.事实代次;
            if (起始.合同版本 != L1中性CRUD合同版本
                || 结束.合同版本 != L1中性CRUD合同版本
                || 当前截止 == 0 || 结束.事实代次 != 当前截止
                || 场景结果.事实->事实截止代次 != 当前截止
                || 存在结果.合同版本 != L1中性CRUD合同版本
                || 存在结果.查询编码 != 请求.存在.编码
                || 存在结果.读取事实代次 != 当前截止
                || (!已退出候选
                    && (当前关系结果.合同版本 != L1中性CRUD合同版本
                        || 当前关系结果.查询编码 != 请求.当前归属关系
                        || 当前关系结果.读取事实代次 != 当前截止)))
                return {世界结构状态::版本漂移, std::nullopt};

            const auto& 存在 = *存在结果.事实;
            if (存在.编码 != 请求.存在.编码 || 存在.种类 != 节点种类::普通
                || 存在.属性类型表示.has_value() || 存在.退出事实代次.has_value()
                || 关系事实.编码 != 请求.当前归属关系
                || 关系事实.源节点 != 请求.场景.初始场景
                || 关系事实.目标节点 != 请求.存在.编码
                || 关系事实.关系类型节点 != 登记结果.登记->直接成员关系类型
                || 关系事实.角色或顺序 != 0 || 关系事实.创建事实代次 == 0)
                return {世界结构状态::内部不一致, std::nullopt};
            if (!已退出候选 && 关系事实.退出事实代次.has_value())
                return {世界结构状态::内部不一致, std::nullopt};
            if (已退出候选) {
                if (!关系事实.退出事实代次.has_value()
                    || 关系事实.创建事实代次 > 请求.期望事实代次
                    || *关系事实.退出事实代次 > 当前截止)
                    return {世界结构状态::版本漂移, std::nullopt};
                if (请求.期望事实代次 >= *关系事实.退出事实代次)
                    return {世界结构状态::未找到, std::nullopt};
            } else if (当前截止 != 请求.期望事实代次) {
                return {世界结构状态::版本漂移, std::nullopt};
            }

            const auto 幂等键 = L1场景结构内部::映射退出幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.退出事实 = {请求.当前归属关系};
            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1场景结构内部::退出写入状态(写入.状态);
            if (状态 != 世界结构状态::已提交
                && 状态 != 世界结构状态::幂等读回)
                return {状态, std::nullopt};
            if (已退出候选 && 写入.状态 != L1中性写入状态::精确重复)
                return {世界结构状态::内部不一致, std::nullopt};

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            if (写入.合同版本 != L1中性CRUD合同版本
                || !(写入.幂等键 == 幂等键) || 写入.事实代次 == 0
                || !写入.新编码映射.empty()
                || (!首次成功完整 && !重复成功完整))
                return {世界结构状态::内部不一致, std::nullopt};

            const auto 读回起始 = L1_.读取中性当前事实代次({});
            const auto 退出关系 = L1_.读取中性当前关系(
                {L1中性CRUD合同版本, 请求.当前归属关系});
            const auto 历史结果 = L1_.读取中性历史事实(
                {L1中性CRUD合同版本, 请求.当前归属关系});
            const auto 原场景结果 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 请求.场景.初始场景});
            const auto 当前存在结果 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 请求.存在.编码});
            const auto 读回结束 = L1_.读取中性当前事实代次({});
            if (读回起始.状态 != L1中性读取状态::成功
                || 读回结束.状态 != L1中性读取状态::成功
                || 退出关系.状态 != L1中性读取状态::已退出
                || 退出关系.事实.has_value()
                || 历史结果.状态 != L1中性读取状态::成功 || !历史结果.事实
                || 原场景结果.状态 != L1中性读取状态::成功 || !原场景结果.事实
                || 当前存在结果.状态 != L1中性读取状态::成功 || !当前存在结果.事实)
                return {世界结构状态::内部不一致, std::nullopt};
            const auto* 历史关系 = std::get_if<L1中性关系事实>(&*历史结果.事实);
            const auto 读回截止 = 读回起始.事实代次;
            if (!历史关系 || 读回起始.合同版本 != L1中性CRUD合同版本
                || 读回结束.合同版本 != L1中性CRUD合同版本
                || 读回截止 < 写入.事实代次 || 读回结束.事实代次 != 读回截止
                || 退出关系.合同版本 != L1中性CRUD合同版本
                || 退出关系.查询编码 != 请求.当前归属关系
                || 历史结果.合同版本 != L1中性CRUD合同版本
                || 历史结果.查询编码 != 请求.当前归属关系
                || 原场景结果.合同版本 != L1中性CRUD合同版本
                || 原场景结果.查询编码 != 请求.场景.初始场景
                || 原场景结果.读取事实代次 != 读回截止
                || 当前存在结果.合同版本 != L1中性CRUD合同版本
                || 当前存在结果.查询编码 != 请求.存在.编码
                || 当前存在结果.读取事实代次 != 读回截止)
                return {世界结构状态::版本漂移, std::nullopt};
            if (历史关系->编码 != 关系事实.编码
                || 历史关系->源节点 != 关系事实.源节点
                || 历史关系->目标节点 != 关系事实.目标节点
                || 历史关系->关系类型节点 != 关系事实.关系类型节点
                || 历史关系->角色或顺序 != 关系事实.角色或顺序
                || 历史关系->创建事实代次 != 关系事实.创建事实代次
                || !历史关系->退出事实代次.has_value()
                || *历史关系->退出事实代次 != 写入.事实代次
                || 原场景结果.事实->编码 != 请求.场景.初始场景
                || 原场景结果.事实->种类 != 节点种类::普通
                || 原场景结果.事实->退出事实代次.has_value()
                || 当前存在结果.事实->编码 != 请求.存在.编码
                || 当前存在结果.事实->种类 != 节点种类::普通
                || 当前存在结果.事实->退出事实代次.has_value())
                return {世界结构状态::内部不一致, std::nullopt};

            初始场景直接存在成员退出事实 事实;
            事实.发布事实代次 = 写入.事实代次;
            事实.事实截止代次 = 读回截止;
            事实.世界根 = 请求.场景.世界根;
            事实.原场景 = {请求.场景.初始场景, 节点种类::普通};
            事实.存在 = {请求.存在.编码, 节点种类::普通};
            事实.已退出归属关系 = {{历史关系->编码,
                    {历史关系->关系类型节点, 节点种类::普通},
                    事实.原场景, 事实.存在, 历史关系->角色或顺序},
                历史关系->创建事实代次, *历史关系->退出事实代次};
            if (!L1场景结构内部::直接存在成员退出事实完整(事实))
                return {世界结构状态::内部不一致, std::nullopt};
            return {状态, 事实};
        } catch (const std::bad_alloc&) {
            return {世界结构状态::资源失败, std::nullopt};
        } catch (...) {
            return {世界结构状态::内部不一致, std::nullopt};
        }
    }
    初始场景接纳结果 读取初始场景接纳(
        const 初始场景接纳读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.场景.合同版本 != L1场景结构合同版本
                || 请求.场景.世界规则版本 != 世界登记规则版本
                || !世界结构节点见证有效(请求.场景.世界根)
                || 请求.场景.世界根.类型 != 节点种类::普通
                || !有效(请求.场景.初始场景)
                || !有效(请求.场景.场景标记值)
                || !有效(请求.场景.直接父关系)
                || !有效(请求.成员) || !有效(请求.归属关系)) return {};
            const auto 登记结果 = 世界登记_.读取当前登记();
            if (登记结果.状态 != 世界登记状态::已读取 || !登记结果.登记
                || 请求.场景.世界根.编码 != 登记结果.登记->世界根场景)
                return {};
            return L1场景结构内部::读取接纳实现(L1_, 登记结果, 请求);
        } catch (const std::bad_alloc&) {
            return {世界结构状态::资源失败, std::nullopt};
        } catch (...) { return {世界结构状态::内部不一致, std::nullopt}; }
    }
private:
    L1事实基座服务& L1_;
    世界登记服务& 世界登记_;
    mutable std::mutex 锁_;
    std::optional<初始场景读取请求> 当前初始场景定位_;
};

} // namespace 海中鱼巣
