}

namespace 海中鱼巣::L1场景结构内部 {

using namespace 海中鱼巣;

inline constexpr std::uint64_t L1幂等域 = 0x02ULL;

写集幂等键 映射L1幂等键(世界操作幂等身份 身份) noexcept {
    return { (L1幂等域 << 56) | 身份.值 };
}

世界结构状态 写入状态(L1写入状态 状态) noexcept {
    switch (状态) {
    case L1写入状态::成功: return 世界结构状态::已提交;
    case L1写入状态::精确重复: return 世界结构状态::幂等读回;
    case L1写入状态::幂等冲突: return 世界结构状态::幂等冲突;
    case L1写入状态::事实代次漂移: return 世界结构状态::版本漂移;
    case L1写入状态::资源失败: return 世界结构状态::资源失败;
    case L1写入状态::内部不一致: return 世界结构状态::内部不一致;
    default: return 世界结构状态::入口拒绝;
    }
}

世界结构状态 读取状态(L1读取状态 状态) noexcept {
    if (状态 == L1读取状态::未找到 || 状态 == L1读取状态::属性未设置)
        return 世界结构状态::未找到;
    if (状态 == L1读取状态::事实代次漂移) return 世界结构状态::版本漂移;
    if (状态 == L1读取状态::资源失败) return 世界结构状态::资源失败;
    if (状态 == L1读取状态::内部不一致 || 状态 == L1读取状态::已退出)
        return 世界结构状态::内部不一致;
    return 世界结构状态::入口拒绝;
}

std::optional<稳定编码> 映射(const L1写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& 项 : 结果.新编码映射) {
        if (项.first.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 项.second;
    }
    return 找到;
}

const 节点事实* 节点(const L1完整快照& 快照, 稳定编码 编码) noexcept {
    for (const auto& 项 : 快照.当前节点) if (项.编码 == 编码) return &项;
    return nullptr;
}

bool 基线(const L1完整快照& 快照, const 世界结构登记& 登记) noexcept {
    if (快照.事实代次 != 登记.已验证事实代次 || 快照.当前节点.size() != 5
        || !快照.当前关系.empty() || 快照.当前值.size() != 1
        || 快照.永久占用编码.size() != 6) return false;
    const auto* 身份 = 节点(快照, 登记.服务身份);
    const auto* 类型 = 节点(快照, 登记.场景标记属性类型);
    const auto* 父 = 节点(快照, 登记.直接父场景关系类型);
    const auto* 成员 = 节点(快照, 登记.直接成员关系类型);
    const auto* 根 = 节点(快照, 登记.世界根场景);
    if (!身份 || !类型 || !父 || !成员 || !根) return false;
    const auto& 值 = 快照.当前值.front();
    return 身份->种类 == 节点种类::普通 && 类型->种类 == 节点种类::属性类型
        && 类型->属性类型表示 == std::optional{值表示种类::I64}
        && 父->种类 == 节点种类::普通 && 成员->种类 == 节点种类::普通
        && 根->种类 == 节点种类::普通 && 身份->当前属性.empty()
        && 类型->当前属性.empty() && 父->当前属性.empty()
        && 成员->当前属性.empty() && 根->当前属性.size() == 1
        && 根->当前属性[0].属性类型节点 == 登记.场景标记属性类型
        && 根->当前属性[0].当前值 == 值.编码
        && 值.所属节点 == 登记.世界根场景
        && 值.属性类型节点 == 登记.场景标记属性类型
        && 值.来源节点 == 登记.服务身份 && !值.退出事实代次
        && std::holds_alternative<std::int64_t>(值.材料)
        && std::get<std::int64_t>(值.材料) == 1;
}

bool 取节点(const L1读取结果& 结果, 节点事实& 输出) noexcept {
    if (结果.状态 != L1读取状态::成功 || !结果.事实) return false;
    const auto* 值 = std::get_if<节点事实>(&*结果.事实);
    if (!值) return false; 输出 = *值; return true;
}
bool 取值(const L1读取结果& 结果, 值事实& 输出) noexcept {
    if (结果.状态 != L1读取状态::成功 || !结果.事实) return false;
    const auto* 值 = std::get_if<值事实>(&*结果.事实);
    if (!值) return false; 输出 = *值; return true;
}
bool 取关系(const L1读取结果& 结果, 关系事实& 输出) noexcept {
    if (结果.状态 != L1读取状态::成功 || !结果.事实) return false;
    const auto* 值 = std::get_if<关系事实>(&*结果.事实);
    if (!值) return false; 输出 = *值; return true;
}

初始场景结果 读取实现(const L1事实基座服务& L1,
    const 世界登记结果& 登记结果, const 初始场景读取请求& 请求) {
    if (!登记结果.登记) return {};
    const auto& 登记 = *登记结果.登记;
    const auto 根结果 = L1.读取当前节点(请求.世界根.编码);
    const auto 场景结果 = L1.读取当前节点(请求.初始场景);
    const auto 类型结果 = L1.读取当前节点(登记.场景标记属性类型);
    const auto 来源结果 = L1.读取当前节点(登记.服务身份);
    节点事实 根, 场景, 类型, 来源;
    if (!取节点(根结果, 根)) return {读取状态(根结果.状态), std::nullopt};
    if (!取节点(场景结果, 场景)) return {读取状态(场景结果.状态), std::nullopt};
    if (!取节点(类型结果, 类型)) return {读取状态(类型结果.状态), std::nullopt};
    if (!取节点(来源结果, 来源)) return {读取状态(来源结果.状态), std::nullopt};
    const auto 属性结果 = L1.读取当前属性(请求.初始场景, 登记.场景标记属性类型);
    if (属性结果.状态 != L1读取状态::成功 || !属性结果.属性)
        return {读取状态(属性结果.状态), std::nullopt};
    const auto 值结果 = L1.读取当前值(请求.场景标记值);
    const auto 关系结果 = L1.读取当前关系(请求.直接父关系);
    值事实 值; 关系事实 关系;
    if (!取值(值结果, 值)) return {读取状态(值结果.状态), std::nullopt};
    if (!取关系(关系结果, 关系)) return {读取状态(关系结果.状态), std::nullopt};
    const auto 关系类型结果 = L1.读取当前节点(关系.关系类型节点);
    节点事实 关系类型;
    if (!取节点(关系类型结果, 关系类型))
        return {读取状态(关系类型结果.状态), std::nullopt};
    const std::uint64_t 代次 = 根结果.读取事实代次;
    if (代次 == 0 || 场景结果.读取事实代次 != 代次
        || 类型结果.读取事实代次 != 代次 || 来源结果.读取事实代次 != 代次
        || 属性结果.读取事实代次 != 代次 || 值结果.读取事实代次 != 代次
        || 关系结果.读取事实代次 != 代次
        || 关系类型结果.读取事实代次 != 代次)
        return {世界结构状态::版本漂移, std::nullopt};
    if (根.编码 != 请求.世界根.编码 || 根.种类 != 节点种类::普通
        || 场景.编码 != 请求.初始场景 || 场景.种类 != 节点种类::普通
        || 类型.种类 != 节点种类::属性类型
        || 类型.属性类型表示 != std::optional{值表示种类::I64}
        || 来源.种类 != 节点种类::普通 || 根.退出事实代次 || 场景.退出事实代次
        || 类型.退出事实代次 || 来源.退出事实代次 || 值.退出事实代次
        || 关系.退出事实代次 || 关系类型.退出事实代次
        || 属性结果.属性->当前值 != 请求.场景标记值
        || 关系.编码 != 请求.直接父关系 || 关系.源节点 != 请求.世界根.编码
        || 关系.目标节点 != 请求.初始场景
        || 关系.关系类型节点 != 登记.直接父场景关系类型
        || 关系.角色或顺序 != 0 || 值.编码 != 请求.场景标记值
        || 值.所属节点 != 请求.初始场景
        || 值.属性类型节点 != 登记.场景标记属性类型
        || 值.来源节点 != 登记.服务身份
        || !std::holds_alternative<std::int64_t>(值.材料)
        || std::get<std::int64_t>(值.材料) != 1)
        return {世界结构状态::内部不一致, std::nullopt};
    初始场景事实 事实;
    事实.事实截止代次 = 代次;
    事实.世界根 = {根.编码, 根.种类};
    事实.初始场景 = {场景.编码, 场景.种类};
    事实.场景标记 = {值.编码, {值.所属节点, 场景.种类},
        {值.属性类型节点, 类型.种类}, std::get<std::int64_t>(值.材料),
        {值.来源节点, 来源.种类}, 值.创建事实代次};
    事实.直接父关系 = {关系.编码, {关系.关系类型节点, 关系类型.种类},
        {关系.源节点, 根.种类}, {关系.目标节点, 场景.种类}, 关系.角色或顺序};
    return {世界结构状态::已读取, 事实};
}

初始场景结果 创建实现(L1事实基座服务& L1, 世界登记服务& 登记服务,
    const 初始场景创建请求& 请求) {
    if (请求.合同版本 != L1场景结构合同版本
        || 请求.世界规则版本 != 世界登记规则版本
        || !世界结构节点见证有效(请求.世界根)
        || 请求.世界根.类型 != 节点种类::普通
        || !世界操作幂等身份有效(请求.幂等身份)
        || 请求.期望事实代次 == 0) {
        return {};
    }

    const auto 登记结果 = 登记服务.读取当前登记();
    if (登记结果.状态 != 世界登记状态::已读取 || !登记结果.登记
        || 请求.世界规则版本 != 登记结果.登记->世界规则版本
        || 请求.世界根.编码 != 登记结果.登记->世界根场景) {
        return {};
    }

    const auto 初始快照结果 = L1.读取完整快照();
    if (初始快照结果.状态 != L1读取状态::成功
        || !初始快照结果.快照) {
        if (初始快照结果.状态 == L1读取状态::资源失败)
            return {世界结构状态::资源失败, std::nullopt};
        if (初始快照结果.状态 == L1读取状态::内部不一致)
            return {世界结构状态::内部不一致, std::nullopt};
        return {};
    }
    if (初始快照结果.快照->事实代次 == 请求.期望事实代次
        && !基线(*初始快照结果.快照, *登记结果.登记)) {
        return {};
    }

    L1写集请求 写集;
    写集.期望事实代次 = 请求.期望事实代次;
    写集.幂等键 = 映射L1幂等键(请求.幂等身份);
    写集.节点.push_back(节点新建项{
        写集本地键{1}, 节点种类::普通, std::nullopt});
    写集.值.push_back(值新建项{
        写集本地键{2}, 事实引用{写集本地键{1}},
        事实引用{稳定编码{登记结果.登记->场景标记属性类型}},
        原始值材料{std::int64_t{1}},
        事实引用{稳定编码{登记结果.登记->服务身份}}});
    写集.关系.push_back(关系新建项{
        写集本地键{3}, 事实引用{稳定编码{请求.世界根.编码}},
        事实引用{写集本地键{1}},
        事实引用{稳定编码{登记结果.登记->直接父场景关系类型}}, 0});
    写集.属性槽变更.push_back(属性槽变更项{
        事实引用{写集本地键{1}},
        事实引用{稳定编码{登记结果.登记->场景标记属性类型}},
        写集本地键{2}});

    const auto 写入 = L1.提交写集(写集);
    const auto 写入世界状态 = 写入状态(写入.状态);
    if (写入世界状态 != 世界结构状态::已提交
        && 写入世界状态 != 世界结构状态::幂等读回) {
        return {写入世界状态, std::nullopt};
    }
    if (写入.事实代次 == 0 || 写入.新编码映射.size() != 3)
        return {世界结构状态::内部不一致, std::nullopt};

    const auto 场景编码 = 映射(写入, 1);
    const auto 值编码 = 映射(写入, 2);
    const auto 关系编码 = 映射(写入, 3);
    if (!场景编码 || !值编码 || !关系编码
        || *场景编码 == *值编码 || *场景编码 == *关系编码
        || *值编码 == *关系编码)
        return {世界结构状态::内部不一致, std::nullopt};

    初始场景读取请求 读取请求;
    读取请求.合同版本 = 请求.合同版本;
    读取请求.世界规则版本 = 请求.世界规则版本;
    读取请求.世界根 = 请求.世界根;
    读取请求.初始场景 = *场景编码;
    读取请求.场景标记值 = *值编码;
    读取请求.直接父关系 = *关系编码;
    const auto 读回 = 读取实现(L1, 登记结果, 读取请求);
    if (读回.状态 != 世界结构状态::已读取 || !读回.事实)
        return {读回.状态, std::nullopt};
    if (写入.状态 == L1写入状态::成功
        && 读回.事实->事实截止代次 != 写入.事实代次)
        return {世界结构状态::版本漂移, std::nullopt};
    if (!初始场景事实完整(*读回.事实))
        return {世界结构状态::内部不一致, std::nullopt};
    return {写入世界状态, std::move(读回.事实)};
}

} // namespace 海中鱼巣::L1场景结构内部

export namespace 海中鱼巣 {

class L1场景结构服务 final {
public:
    L1场景结构服务(L1事实基座服务& L1, 世界登记服务& 世界登记) noexcept
        : L1_(L1), 世界登记_(世界登记) {}
    L1场景结构服务(const L1场景结构服务&) = delete;
    L1场景结构服务& operator=(const L1场景结构服务&) = delete;
    初始场景结果 创建初始场景(const 初始场景创建请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try { return L1场景结构内部::创建实现(L1_, 世界登记_, 请求); }
        catch (const std::bad_alloc&) { return {世界结构状态::资源失败, std::nullopt}; }
        catch (...) { return {世界结构状态::内部不一致, std::nullopt}; }
    }
    初始场景结果 读取初始场景(const 初始场景读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1场景结构合同版本
                || 请求.世界规则版本 != 世界登记规则版本
                || !世界结构节点见证有效(请求.世界根)
                || 请求.世界根.类型 != 节点种类::普通
                || !有效(请求.初始场景) || !有效(请求.场景标记值)
                || !有效(请求.直接父关系)) return {};
            const auto 登记结果 = 世界登记_.读取当前登记();
            if (登记结果.状态 != 世界登记状态::已读取 || !登记结果.登记
                || 请求.世界根.编码 != 登记结果.登记->世界根场景) return {};
            return L1场景结构内部::读取实现(L1_, 登记结果, 请求);
        } catch (const std::bad_alloc&) { return {世界结构状态::资源失败, std::nullopt}; }
        catch (...) { return {世界结构状态::内部不一致, std::nullopt}; }
    }
private:
    L1事实基座服务& L1_;
    世界登记服务& 世界登记_;
    mutable std::mutex 锁_;
};

} // namespace 海中鱼巣
