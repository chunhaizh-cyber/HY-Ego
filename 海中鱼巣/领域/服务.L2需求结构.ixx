        if (!L2按任务子目标记录读取需求来源请求有效(请求) || 截止 == 0)
            return 失败(L2结构状态::入口拒绝, 截止);
        try {
            return L2需求结构内部::按任务子目标记录读取需求来源当前投影(
                L1_, 身份来源定位_, 类型定位_, 请求,
                请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败, 截止);
        } catch (...) {
            return 失败(L2结构状态::内部不一致, 截止);
        }
    }

    // ===== 写入：新增需求并建立列表项 =====
    // 一次 owner-aware 原子写集：2 节点 + 12/13 关系同代发布。
    // 列表项节点、需求节点、列表项族归属、列表项所属存在、列表项目标宿主/特征/合同、
    // 需求族归属、需求所属存在、需求目标宿主/特征/合同、列表成员关系、（可选）父子关系。
    L2新增需求并建立列表项结果 新增需求并建立列表项(
        L2新增需求并建立列表项请求 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2新增需求并建立列表项结果 结果;
            结果.结果头.合同版本 = L2结构合同版本;
            结果.结果头.状态 = 状态;
            结果.结果头.事实截止代次 = 截止;
            return 结果;
        };
        try {
            if (!L2新增需求并建立列表项请求有效(请求))
                return 失败(L2结构状态::入口拒绝);
            const auto 代次 = L2需求结构内部::检查需求写入当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return 失败(代次.状态, 代次.事实截止代次);

            // 问题5：写集前验证目标宿主存在、目标特征定义、目标状态合同身份
            const auto 目标验证 = L2需求结构内部::验证需求目标身份当前有效(
                存在服务_, 特征服务_, 状态服务_, 请求,
                请求.请求头.期望事实代次);
            if (!目标验证.成功())
                return 失败(目标验证.状态, 代次.事实截止代次);

            const auto 本地键 = [](std::uint32_t 值) noexcept {
                return L1所有者范围写集本地键{值};
            };
            const auto 键列表项节点 = 本地键(
                L2需求结构内部::列表项节点写入本地键值);
            const auto 键需求节点 = 本地键(
                L2需求结构内部::需求节点写入本地键值);

            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2需求结构内部::映射需求幂等键(
                请求.幂等身份);

            // 2 个节点
            写集.节点 = {
                {键列表项节点, 节点种类::普通, std::nullopt},
                {键需求节点, 节点种类::普通, std::nullopt}};

            // 关系：列表项族归属 + 列表项所属存在 + 列表项目标宿主/特征/合同
            //       需求族归属 + 需求所属存在 + 需求目标宿主/特征/合同
            //       列表成员 + （可选）父子
            写集.关系 = {
                // 列表项族归属：列表项 -> 列表项锚点，类型=列表项类型，角色=1
                {本地键(L2需求结构内部::列表项族归属关系写入本地键值),
                    键列表项节点, 身份来源定位_.列表项锚点,
                    身份来源定位_.列表项类型, 1},
                // 列表项所属存在：列表项 -> 所属存在
                {本地键(L2需求结构内部::列表项所属存在关系写入本地键值),
                    键列表项节点, 请求.所属存在.值,
                    类型定位_.列表项所属存在关系类型, 1},
                // 列表项目标宿主：列表项 -> 目标宿主存在
                {本地键(L2需求结构内部::列表项目标宿主关系写入本地键值),
                    键列表项节点, 请求.目标宿主存在.值,
                    类型定位_.列表项目标宿主关系类型, 1},
                // 列表项目标特征：列表项 -> 目标特征定义
                {本地键(L2需求结构内部::列表项目标特征关系写入本地键值),
                    键列表项节点, 请求.目标特征定义.值,
                    类型定位_.列表项目标特征关系类型, 1},
                // 列表项目标合同：列表项 -> 目标状态合同
                {本地键(L2需求结构内部::列表项目标合同关系写入本地键值),
                    键列表项节点, 请求.目标状态合同.值,
                    类型定位_.列表项目标合同关系类型, 1},
                // 需求族归属：需求 -> 需求锚点，类型=需求类型，角色=1
                {本地键(L2需求结构内部::需求族归属关系写入本地键值),
                    键需求节点, 身份来源定位_.需求锚点,
                    身份来源定位_.需求类型, 1},
                // 需求所属存在：需求 -> 所属存在
                {本地键(L2需求结构内部::需求所属存在关系写入本地键值),
                    键需求节点, 请求.所属存在.值,
                    类型定位_.需求所属存在关系类型, 1},
                // 需求目标宿主：需求 -> 目标宿主存在
                {本地键(L2需求结构内部::需求目标宿主关系写入本地键值),
                    键需求节点, 请求.目标宿主存在.值,
                    类型定位_.需求目标宿主关系类型, 1},
                // 需求目标特征：需求 -> 目标特征定义
                {本地键(L2需求结构内部::需求目标特征关系写入本地键值),
                    键需求节点, 请求.目标特征定义.值,
                    类型定位_.需求目标特征关系类型, 1},
                // 需求目标合同：需求 -> 目标状态合同
                {本地键(L2需求结构内部::需求目标合同关系写入本地键值),
                    键需求节点, 请求.目标状态合同.值,
                    类型定位_.需求目标合同关系类型, 1},
                // 列表成员：列表项 -> 需求
                {本地键(L2需求结构内部::列表成员关系写入本地键值),
                    键列表项节点, 键需求节点,
                    类型定位_.需求列表成员关系类型, 1}};

            const bool 含父子关系 = static_cast<bool>(请求.父需求);
            if (含父子关系) {
                写集.关系.push_back(
                    {本地键(L2需求结构内部::父子关系写入本地键值),
                        请求.父需求->值, 键需求节点,
                        类型定位_.需求父子关系类型,
                        static_cast<std::int64_t>(请求.父子顺序)});
            }

            const auto 提交 = L2需求结构内部::提交并验证需求写集(
                第一层写入端口_, 写集, 含父子关系);
            if (提交.状态 != L2结构状态::已提交
                && 提交.状态 != L2结构状态::精确重复)
                return 失败(提交.状态, 提交.事实截止代次);

            return L2需求结构内部::读回新增需求并建立列表项(
                L1_, 身份来源定位_, 类型定位_, 请求,
                提交.编码映射, 提交.事实截止代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // ===== 写入：新增需求并加入既有列表项 =====
    // 基于既有列表项的目标四元组(所属存在/目标宿主/目标特征/目标合同)，
    // 一次 owner-aware 原子写集：1 节点 + 7/8 关系同代发布。
    L2新增需求并加入既有列表项结果 新增需求并加入既有列表项(
        L2新增需求并加入既有列表项请求 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2新增需求并加入既有列表项结果 结果;
            结果.结果头.合同版本 = L2结构合同版本;
            结果.结果头.状态 = 状态;
            结果.结果头.事实截止代次 = 截止;
            return 结果;
        };
        try {
            if (!L2新增需求并加入既有列表项请求有效(请求))
                return 失败(L2结构状态::入口拒绝);

            // 先读列表项完整,获取目标四元组
            L2需求列表项完整读取请求 列表项请求;
            列表项请求.请求头 = 请求.请求头;
            列表项请求.读取类别 = L2读取类别::当前;
            列表项请求.列表项 = 请求.既有列表项;
            const auto 截止 = L2需求结构内部::读取中性当前事实代次(L1_);
            const auto 列表项读取 = L2需求结构内部::
                读取需求列表项完整当前投影(
                L1_, 身份来源定位_, 类型定位_, 列表项请求, 截止);
            if (列表项读取.结果头.状态 != L2结构状态::已读取
                || !列表项读取.列表项 || !列表项读取.自有关系)
                return 失败(列表项读取.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致
                    : 列表项读取.结果头.状态, 截止);
            const auto& 列表项事实 = *列表项读取.列表项;

            // 写集前验证目标身份当前有效(基于列表项的目标四元组)
            L2新增需求并建立列表项请求 验证请求;
            验证请求.请求头 = 请求.请求头;
            验证请求.所属存在 = 列表项事实.所属存在;
            验证请求.目标宿主存在 = 列表项事实.目标宿主存在;
            验证请求.目标特征定义 = 列表项事实.目标特征定义;
            验证请求.目标状态合同 = 列表项事实.目标状态合同;
            const auto 目标验证 = L2需求结构内部::验证需求目标身份当前有效(
                存在服务_, 特征服务_, 状态服务_, 验证请求,
                请求.请求头.期望事实代次);
            if (!目标验证.成功())
                return 失败(目标验证.状态, 截止);

            // 代次预检
            const auto 代次 = L2需求结构内部::检查需求写入当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return 失败(代次.状态, 代次.事实截止代次);

            const auto 本地键 = [](std::uint32_t 值) noexcept {
                return L1所有者范围写集本地键{值};
            };
            const auto 键需求节点 = 本地键(
                L2需求结构内部::需求节点写入本地键值);

            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2需求结构内部::映射需求幂等键(
                请求.幂等身份);

            // 1 个节点
            写集.节点 = {{键需求节点, 节点种类::普通, std::nullopt}};

            // 关系: 需求族归属 + 需求所属存在 + 需求目标宿主/特征/合同 + 列表成员 + (可选)父子
            写集.关系 = {
                {本地键(L2需求结构内部::需求族归属关系写入本地键值),
                    键需求节点, 身份来源定位_.需求锚点,
                    身份来源定位_.需求类型, 1},
                {本地键(L2需求结构内部::需求所属存在关系写入本地键值),
                    键需求节点, 列表项事实.所属存在.值,
                    类型定位_.需求所属存在关系类型, 1},
                {本地键(L2需求结构内部::需求目标宿主关系写入本地键值),
                    键需求节点, 列表项事实.目标宿主存在.值,
                    类型定位_.需求目标宿主关系类型, 1},
                {本地键(L2需求结构内部::需求目标特征关系写入本地键值),
                    键需求节点, 列表项事实.目标特征定义.值,
                    类型定位_.需求目标特征关系类型, 1},
                {本地键(L2需求结构内部::需求目标合同关系写入本地键值),
                    键需求节点, 列表项事实.目标状态合同.值,
                    类型定位_.需求目标合同关系类型, 1},
                {本地键(L2需求结构内部::列表成员关系写入本地键值),
                    请求.既有列表项.值, 键需求节点,
                    类型定位_.需求列表成员关系类型, 1}};

            const bool 含父子关系 = static_cast<bool>(请求.父需求);
            if (含父子关系) {
                写集.关系.push_back(
                    {本地键(L2需求结构内部::父子关系写入本地键值),
                        请求.父需求->值, 键需求节点,
                        类型定位_.需求父子关系类型,
                        static_cast<std::int64_t>(请求.父子顺序)});
            }

            const auto 提交 = L2需求结构内部::提交并验证加入写集(
                第一层写入端口_, 写集, 含父子关系);
            if (提交.状态 != L2结构状态::已提交
                && 提交.状态 != L2结构状态::精确重复)
                return 失败(提交.状态, 提交.事实截止代次);

            return L2需求结构内部::读回新增需求并加入既有列表项(
                L1_, 身份来源定位_, 类型定位_, 请求,
                列表项事实, 提交.编码映射, 提交.事实截止代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    L2新增需求并建立列表项及任务子目标来源结果
    新增需求并建立列表项及任务子目标来源(
        L2新增需求并建立列表项及任务子目标来源请求 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2新增需求并建立列表项及任务子目标来源结果 结果;
            结果.结果头 = {L2结构合同版本, 状态, 截止, std::nullopt};
            return 结果;
        };
        try {
            if (!L2新增需求并建立列表项及任务子目标来源请求有效(请求))
                return 失败(L2结构状态::入口拒绝);
            const auto 代次 = L2需求结构内部::检查需求写入当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return 失败(代次.状态, 代次.事实截止代次);

            L2新增需求并建立列表项请求 基础请求;
            基础请求.请求头 = 请求.请求头;
            基础请求.幂等身份 = 请求.幂等身份;
            基础请求.所属存在 = 请求.所属存在;
            基础请求.目标宿主存在 = 请求.目标宿主存在;
            基础请求.目标特征定义 = 请求.目标特征定义;
            基础请求.目标状态合同 = 请求.目标状态合同;
            基础请求.父需求 = 请求.父需求;
            基础请求.父子顺序 = 请求.父子顺序;
            基础请求.来源稳定编码 = 请求.来源稳定编码;
            const auto 目标验证 = L2需求结构内部::验证需求目标身份当前有效(
                存在服务_, 特征服务_, 状态服务_, 基础请求,
                请求.请求头.期望事实代次);
            if (!目标验证.成功())
                return 失败(目标验证.状态, 代次.事实截止代次);
            const auto 父读取 = L2需求结构内部::读取需求完整当前投影(
                L1_, 身份来源定位_, 类型定位_,
                {请求.请求头, L2读取类别::当前, 请求.父需求, 0},
                请求.请求头.期望事实代次);
            if (!父读取.成功() || !父读取.需求
                || 父读取.需求->所属存在 != 请求.所属存在)
                return 失败(父读取.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::引用冲突 : 父读取.结果头.状态,
                    父读取.结果头.事实截止代次);

            const auto 本地键 = [](std::uint32_t 值) noexcept {
                return L1所有者范围写集本地键{值};
            };
            const auto 列表项节点 = 本地键(
                L2需求结构内部::列表项节点写入本地键值);
            const auto 需求节点 = 本地键(
                L2需求结构内部::需求节点写入本地键值);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2需求结构内部::映射需求幂等键(
                请求.幂等身份);
            写集.节点 = {{列表项节点, 节点种类::普通, std::nullopt},
                {需求节点, 节点种类::普通, std::nullopt}};
            写集.关系 = {
                {本地键(L2需求结构内部::列表项族归属关系写入本地键值),
                    列表项节点, 身份来源定位_.列表项锚点,
                    身份来源定位_.列表项类型, 1},
                {本地键(L2需求结构内部::列表项所属存在关系写入本地键值),
                    列表项节点, 请求.所属存在.值,
                    类型定位_.列表项所属存在关系类型, 1},
                {本地键(L2需求结构内部::列表项目标宿主关系写入本地键值),
                    列表项节点, 请求.目标宿主存在.值,
                    类型定位_.列表项目标宿主关系类型, 1},
                {本地键(L2需求结构内部::列表项目标特征关系写入本地键值),
                    列表项节点, 请求.目标特征定义.值,
                    类型定位_.列表项目标特征关系类型, 1},
                {本地键(L2需求结构内部::列表项目标合同关系写入本地键值),
                    列表项节点, 请求.目标状态合同.值,
                    类型定位_.列表项目标合同关系类型, 1},
                {本地键(L2需求结构内部::需求族归属关系写入本地键值),
                    需求节点, 身份来源定位_.需求锚点,
                    身份来源定位_.需求类型, 1},
                {本地键(L2需求结构内部::需求所属存在关系写入本地键值),
                    需求节点, 请求.所属存在.值,
                    类型定位_.需求所属存在关系类型, 1},
                {本地键(L2需求结构内部::需求目标宿主关系写入本地键值),
                    需求节点, 请求.目标宿主存在.值,
                    类型定位_.需求目标宿主关系类型, 1},
                {本地键(L2需求结构内部::需求目标特征关系写入本地键值),
                    需求节点, 请求.目标特征定义.值,
                    类型定位_.需求目标特征关系类型, 1},
                {本地键(L2需求结构内部::需求目标合同关系写入本地键值),
                    需求节点, 请求.目标状态合同.值,
                    类型定位_.需求目标合同关系类型, 1},
                {本地键(L2需求结构内部::列表成员关系写入本地键值),
                    列表项节点, 需求节点,
                    类型定位_.需求列表成员关系类型, 1},
                {本地键(L2需求结构内部::父子关系写入本地键值),
                    请求.父需求.值, 需求节点,
                    类型定位_.需求父子关系类型,
                    static_cast<std::int64_t>(请求.父子顺序)},
                {本地键(L2需求结构内部::任务子目标来源关系写入本地键值),
                    需求节点, 请求.来源记录.值,
                    类型定位_.任务子目标来源关系类型, 1}};
            const auto 提交 = L2需求结构内部::提交并验证需求写集(
                第一层写入端口_, 写集, true, true);
            if (提交.状态 != L2结构状态::已提交
                && 提交.状态 != L2结构状态::精确重复)
                return 失败(提交.状态, 提交.事实截止代次);
            return L2需求结构内部::
                读回需求任务子目标来源完整写结果<
                    L2新增需求并建立列表项及任务子目标来源结果>(
                    L1_, 身份来源定位_, 类型定位_, 提交.状态,
                    提交.事实截止代次,
                    L2需求身份{提交.编码映射.需求节点}, 请求.父需求,
                    L2需求列表项身份{提交.编码映射.列表项节点},
                    请求.来源记录);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    L2新增需求并加入既有列表项及任务子目标来源结果
    新增需求并加入既有列表项及任务子目标来源(
        L2新增需求并加入既有列表项及任务子目标来源请求 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2新增需求并加入既有列表项及任务子目标来源结果 结果;
            结果.结果头 = {L2结构合同版本, 状态, 截止, std::nullopt};
            return 结果;
        };
        try {
            if (!L2新增需求并加入既有列表项及任务子目标来源请求有效(请求))
                return 失败(L2结构状态::入口拒绝);
            const auto 代次 = L2需求结构内部::检查需求写入当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return 失败(代次.状态, 代次.事实截止代次);
            const auto 列表项读取 = L2需求结构内部::
                读取需求列表项完整当前投影(L1_, 身份来源定位_, 类型定位_,
                    {请求.请求头, L2读取类别::当前, 请求.既有列表项, 0},
                    请求.请求头.期望事实代次);
            const auto 父读取 = L2需求结构内部::读取需求完整当前投影(
                L1_, 身份来源定位_, 类型定位_,
                {请求.请求头, L2读取类别::当前, 请求.父需求, 0},
                请求.请求头.期望事实代次);
            if (!列表项读取.成功() || !列表项读取.列表项
                || !父读取.成功() || !父读取.需求
                || 列表项读取.列表项->所属存在 != 父读取.需求->所属存在)
                return 失败(L2结构状态::引用冲突,
                    请求.请求头.期望事实代次);
            const auto& 列表项 = *列表项读取.列表项;
            L2新增需求并建立列表项请求 验证请求;
            验证请求.请求头 = 请求.请求头;
            验证请求.所属存在 = 列表项.所属存在;
            验证请求.目标宿主存在 = 列表项.目标宿主存在;
            验证请求.目标特征定义 = 列表项.目标特征定义;
            验证请求.目标状态合同 = 列表项.目标状态合同;
            const auto 目标验证 = L2需求结构内部::验证需求目标身份当前有效(
                存在服务_, 特征服务_, 状态服务_, 验证请求,
                请求.请求头.期望事实代次);
            if (!目标验证.成功())
                return 失败(目标验证.状态, 请求.请求头.期望事实代次);
            const auto 本地键 = [](std::uint32_t 值) noexcept {
                return L1所有者范围写集本地键{值};
            };
            const auto 需求节点 = 本地键(
                L2需求结构内部::需求节点写入本地键值);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2需求结构内部::映射需求幂等键(
                请求.幂等身份);
            写集.节点 = {{需求节点, 节点种类::普通, std::nullopt}};
            写集.关系 = {
                {本地键(L2需求结构内部::需求族归属关系写入本地键值),
                    需求节点, 身份来源定位_.需求锚点,
                    身份来源定位_.需求类型, 1},
                {本地键(L2需求结构内部::需求所属存在关系写入本地键值),
                    需求节点, 列表项.所属存在.值,
                    类型定位_.需求所属存在关系类型, 1},
                {本地键(L2需求结构内部::需求目标宿主关系写入本地键值),
                    需求节点, 列表项.目标宿主存在.值,
                    类型定位_.需求目标宿主关系类型, 1},
                {本地键(L2需求结构内部::需求目标特征关系写入本地键值),
                    需求节点, 列表项.目标特征定义.值,
                    类型定位_.需求目标特征关系类型, 1},
                {本地键(L2需求结构内部::需求目标合同关系写入本地键值),
                    需求节点, 列表项.目标状态合同.值,
                    类型定位_.需求目标合同关系类型, 1},
                {本地键(L2需求结构内部::列表成员关系写入本地键值),
                    请求.既有列表项.值, 需求节点,
                    类型定位_.需求列表成员关系类型, 1},
                {本地键(L2需求结构内部::父子关系写入本地键值),
                    请求.父需求.值, 需求节点,
                    类型定位_.需求父子关系类型,
                    static_cast<std::int64_t>(请求.父子顺序)},
                {本地键(L2需求结构内部::任务子目标来源关系写入本地键值),
                    需求节点, 请求.来源记录.值,
                    类型定位_.任务子目标来源关系类型, 1}};
            const auto 提交 = L2需求结构内部::提交并验证加入写集(
                第一层写入端口_, 写集, true, true);
            if (提交.状态 != L2结构状态::已提交
                && 提交.状态 != L2结构状态::精确重复)
                return 失败(提交.状态, 提交.事实截止代次);
            return L2需求结构内部::
                读回需求任务子目标来源完整写结果<
                    L2新增需求并加入既有列表项及任务子目标来源结果>(
                    L1_, 身份来源定位_, 类型定位_, 提交.状态,
                    提交.事实截止代次,
                    L2需求身份{提交.编码映射.需求节点}, 请求.父需求,
                    请求.既有列表项, 请求.来源记录);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    L2为既有需求建立任务子目标来源结果 为既有需求建立任务子目标来源(
        L2为既有需求建立任务子目标来源请求 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2为既有需求建立任务子目标来源结果 结果;
            结果.结果头 = {L2结构合同版本, 状态, 截止, std::nullopt};
            return 结果;
        };
        try {
            if (!L2为既有需求建立任务子目标来源请求有效(请求))
                return 失败(L2结构状态::入口拒绝);
            const auto 代次 = L2需求结构内部::检查需求写入当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return 失败(代次.状态, 代次.事实截止代次);
            if (!代次.直接提交) {
                const auto 子 = L2需求结构内部::读取需求完整当前投影(
                    L1_, 身份来源定位_, 类型定位_,
                    {请求.请求头, L2读取类别::当前, 请求.子需求, 0},
                    请求.请求头.期望事实代次);
                const auto 父 = L2需求结构内部::按子需求读取当前父需求当前投影(
                    L1_, 身份来源定位_, 类型定位_,
                    {请求.请求头, 请求.子需求}, 请求.请求头.期望事实代次);
                const auto 成员 = L2需求结构内部::读取需求成员列表当前投影(
                    L1_, 身份来源定位_, 类型定位_,
                    {请求.请求头, L2读取类别::当前, 请求.子需求, 0},
                    请求.请求头.期望事实代次);
                const auto 项 = L2需求结构内部::读取需求列表项完整当前投影(
                    L1_, 身份来源定位_, 类型定位_,
                    {请求.请求头, L2读取类别::当前, 请求.所属列表项, 0},
                    请求.请求头.期望事实代次);
                if (!子.成功() || !子.需求 || !父.成功()
                    || !父.当前父关系 || !父.父需求
                    || !成员.成功() || !成员.当前成员关系
                    || !项.成功() || !项.列表项
                    || 父.当前父关系->父需求 != 请求.父需求
                    || 父.当前父关系->顺序 != 请求.父子顺序
                    || 成员.当前成员关系->列表项 != 请求.所属列表项
                    || 子.需求->所属存在 != 父.父需求->所属存在
                    || 子.需求->所属存在 != 项.列表项->所属存在
                    || 子.需求->目标宿主存在 != 项.列表项->目标宿主存在
                    || 子.需求->目标特征定义 != 项.列表项->目标特征定义
                    || 子.需求->目标状态合同 != 项.列表项->目标状态合同)
                    return 失败(L2结构状态::引用冲突,
                        请求.请求头.期望事实代次);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2需求结构内部::映射需求幂等键(
                请求.幂等身份);
            写集.关系 = {{L1所有者范围写集本地键{
                    L2需求结构内部::任务子目标来源关系写入本地键值},
                请求.子需求.值, 请求.来源记录.值,
                类型定位_.任务子目标来源关系类型, 1}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            auto 状态 = L2需求结构内部::映射需求写入状态(写入.状态);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0
                || ((状态 == L2结构状态::已提交
                        || 状态 == L2结构状态::精确重复)
                    && 写入.新编码映射.size() != 1))
                状态 = L2结构状态::内部不一致;
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 失败(状态, 写入.事实代次);
            if (写入.新编码映射.front().first.值
                    != L2需求结构内部::任务子目标来源关系写入本地键值
                || !有效(写入.新编码映射.front().second))
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            return L2需求结构内部::
                读回需求任务子目标来源完整写结果<
                    L2为既有需求建立任务子目标来源结果>(
                    L1_, 身份来源定位_, 类型定位_, 状态, 写入.事实代次,
                    请求.子需求, 请求.父需求, 请求.所属列表项,
                    请求.来源记录);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // ===== 写入：替换父需求（仅限父子关系换代） =====
    // 边界（4250 规范 10.2）：
    //   允许：旧父关系退出 + 新父关系建立（或升到根，新父为空）
    //   禁止：修改需求目标（目标宿主存在/目标特征定义/目标状态合同）
    //         修改列表项归属（所属存在/列表成员关系）
    // 结构性保证：L2替换父需求请求 仅含父关系字段（旧关系编码、旧/新父、顺序），
    //   不含目标或列表项字段，无法通过本接口修改目标或列表项。
    //   目标与列表项换代需通过退出需求 + 新增需求完成。
    L2替换父需求结果 替换父需求(
        L2替换父需求请求 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2替换父需求结果 结果;
            结果.结果头.合同版本 = L2结构合同版本;
            结果.结果头.状态 = 状态;
            结果.结果头.事实截止代次 = 截止;
            return 结果;
        };
        try {
            if (!L2替换父需求请求有效(请求))
                return 失败(L2结构状态::入口拒绝);
            const auto 代次 = L2需求结构内部::检查需求写入当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return 失败(代次.状态, 代次.事实截止代次);

            // 问题6：写集前验证旧关系事实与请求一致且当前有效
            const auto 旧关系验证 = L2需求结构内部::
                验证替换父需求旧关系当前有效(
                L1_, 身份来源定位_, 类型定位_, 请求);
            if (!旧关系验证.成功())
                return 失败(旧关系验证.状态, 代次.事实截止代次);

            // 问题6：新父需求非空时验证其当前存在且有效
            if (请求.新父需求) {
                const auto 新父验证 = L2需求结构内部::
                    验证新父需求当前存在有效(
                    L1_, 身份来源定位_, *请求.新父需求);
                if (!新父验证.成功())
                    return 失败(新父验证.状态, 代次.事实截止代次);
            }

            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2需求结构内部::映射需求幂等键(
                请求.幂等身份);

            // 退出旧父关系
            写集.退出事实 = {请求.旧关系稳定编码};

            // 新父关系非空时建立新父关系
            const bool 建立新父 = static_cast<bool>(请求.新父需求);
            if (建立新父) {
                写集.关系 = {
                    {L1所有者范围写集本地键{
                        L2需求结构内部::父子关系写入本地键值},
                        请求.新父需求->值, 请求.子需求.值,
                        类型定位_.需求父子关系类型,
                        static_cast<std::int64_t>(请求.新顺序)}};
            }

            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2需求结构内部::映射需求写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 失败(状态, 写入.事实代次);

            // 验证写入结果形状
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);

            const bool 首次完整 = 写入.状态
                == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态
                == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界
                    == L1所有者范围重试边界::原幂等身份读回收敛;
            if (!首次完整 && !重复完整)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);

            // 新父关系建立时,编码映射应有 1 项
            if (建立新父) {
                if (写入.新编码映射.size() != 1
                    || 写入.新编码映射.front().first.值
                        != L2需求结构内部::父子关系写入本地键值
                    || !有效(写入.新编码映射.front().second))
                    return 失败(L2结构状态::内部不一致, 写入.事实代次);
            } else {
                if (!写入.新编码映射.empty())
                    return 失败(L2结构状态::内部不一致, 写入.事实代次);
            }

            return L2需求结构内部::读回替换父需求(
                L1_, 身份来源定位_, 类型定位_, 请求,
                建立新父 ? 写入.新编码映射.front().second : 稳定编码{},
                写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // ===== 写入：退出需求 =====
    // 原子退出: 需求节点 + 5 自有关系 + (可选)父关系 + 列表成员关系 同代退出。
    // 不退出直接子关系(由子需求自行退出或后续清理)。
    L2需求退出结果 退出需求(
        L2需求退出请求 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2需求退出结果 结果;
            结果.结果头.合同版本 = L2结构合同版本;
            结果.结果头.状态 = 状态;
            结果.结果头.事实截止代次 = 截止;
            return 结果;
        };
        try {
            if (!L2需求退出请求有效(请求))
                return 失败(L2结构状态::入口拒绝);
            const auto 代次 = L2需求结构内部::检查需求写入当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return 失败(代次.状态, 代次.事实截止代次);

            // 问题7+：写集前验证退出事实闭包与请求一致且当前有效
            // 防止通过本接口退出非自有关系、错 owner 关系或已退出关系
            const auto 闭包验证 = L2需求结构内部::
                验证需求退出事实闭包当前有效(
                L1_, 身份来源定位_, 类型定位_, 请求);
            if (!闭包验证.成功())
                return 失败(闭包验证.状态, 代次.事实截止代次);

            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2需求结构内部::映射需求幂等键(
                请求.幂等身份);

            // 退出: 需求节点 + 5 自有关系 + 列表成员关系 + (可选)父关系
            写集.退出事实 = {
                请求.需求.值,
                请求.自有事实闭包.自有关系.族归属关系稳定编码,
                请求.自有事实闭包.自有关系.所属存在关系稳定编码,
                请求.自有事实闭包.自有关系.目标宿主关系稳定编码,
                请求.自有事实闭包.自有关系.目标特征关系稳定编码,
                请求.自有事实闭包.自有关系.目标合同关系稳定编码,
                请求.自有事实闭包.当前列表成员关系稳定编码};
            if (请求.自有事实闭包.当前父关系稳定编码)
                写集.退出事实.push_back(
                    *请求.自有事实闭包.当前父关系稳定编码);

            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2需求结构内部::映射需求写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 失败(状态, 写入.事实代次);

            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0
                || !写入.新编码映射.empty())
                return 失败(L2结构状态::内部不一致, 写入.事实代次);

            const bool 首次完整 = 写入.状态
                == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态
                == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界
                    == L1所有者范围重试边界::原幂等身份读回收敛;
            if (!首次完整 && !重复完整)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);

            return L2需求结构内部::读回退出需求(
                L1_, 身份来源定位_, 类型定位_, 请求, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

private:
    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务,
        L2需求所有者交付& 交付) {
        if (!交付.有效() || !交付.绑定于(第一层服务))
            throw std::invalid_argument(
                "L2 requirement owner delivery invalid or cross-instance");
        return std::move(交付.写入端口_);
    }

    const L1事实基座服务& L1_;
    const L2存在结构服务& 存在服务_;
    const L2特征结构服务& 特征服务_;
    const L2状态结构服务& 状态服务_;
    L1所有者范围写端口 第一层写入端口_;
    const L2需求结构内部::需求身份来源定位 身份来源定位_;
    const L2需求结构内部::需求结构类型定位 类型定位_;
    mutable std::mutex 互斥体_;
};

} // export namespace 海中鱼巣
