// ===== 失败构造器 =====
inline L2需求身份来源读取结果 形成身份来源读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    L2需求身份来源读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = 状态;
    结果.结果头.事实截止代次 = 截止;
    return 结果;
}

inline L2需求结构类型登记结果 形成需求结构类型登记失败(
    L2需求结构类型登记状态 状态, std::uint64_t 截止 = 0) noexcept {
    L2需求结构类型登记结果 结果;
    结果.状态 = 状态;
    结果.事实截止代次 = 截止;
    return 结果;
}

// ===== 中性当前事实代次辅助 =====
inline std::uint64_t 读取中性当前事实代次(
    const L1事实基座服务& 服务) noexcept {
    const auto 代次 = 服务.读取中性当前事实代次({L1中性CRUD合同版本});
    return 代次.状态 == L1中性读取状态::成功 ? 代次.事实代次 : 0;
}

// ===== 身份来源初始化 =====
需求身份来源定位 初始化需求身份来源(
    const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 requirement owner fact is invalid");

    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读取.所有者事实->创建事实代次;
    写集.写入幂等身份 = 需求身份来源登记幂等身份;
    写集.节点 = {
        {{需求锚点本地键值}, 节点种类::普通, std::nullopt},
        {{需求类型本地键值}, 节点种类::普通, std::nullopt},
        {{列表项锚点本地键值}, 节点种类::普通, std::nullopt},
        {{列表项类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 需求身份来源登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 4)
        throw std::runtime_error("L2 requirement identity source init failed");

    稳定编码 需求锚点, 需求类型, 列表项锚点, 列表项类型;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码))
            throw std::runtime_error("L2 req id source mapping invalid");
        if (本地键.值 == 需求锚点本地键值) 需求锚点 = 编码;
        else if (本地键.值 == 需求类型本地键值) 需求类型 = 编码;
        else if (本地键.值 == 列表项锚点本地键值) 列表项锚点 = 编码;
        else if (本地键.值 == 列表项类型本地键值) 列表项类型 = 编码;
        else throw std::runtime_error("L2 req id source mapping unknown");
    }
    const 稳定编码 编码组[] = {需求锚点, 需求类型, 列表项锚点, 列表项类型};
    for (std::size_t 左 = 0; 左 < 4; ++左) {
        if (!有效(编码组[左]))
            throw std::runtime_error(
                "L2 requirement identity source mapping incomplete");
        for (std::size_t 右 = 0; 右 < 左; ++右)
            if (编码组[左] == 编码组[右])
                throw std::runtime_error(
                    "L2 requirement identity source mapping duplicate");
    }

    const auto 检查节点 = [&](稳定编码 编码) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者
            && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次
            && !节点->退出事实代次;
    };
    if (!检查节点(需求锚点) || !检查节点(需求类型)
        || !检查节点(列表项锚点) || !检查节点(列表项类型))
        throw std::runtime_error(
            "L2 requirement identity source readback invalid");

    return {所有者, 需求锚点, 需求类型, 列表项锚点, 列表项类型,
        写入.事实代次};
}

// ===== 结构类型登记初始化 =====
需求结构类型定位 初始化需求结构类型(
    const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 写入端口,
    const 需求身份来源定位& 来源定位) {
    const auto 所有者 = 来源定位.所有者;
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 来源定位.建立事实代次;
    写集.写入幂等身份 = 需求结构类型登记幂等身份;
    写集.节点 = {
        {{需求父子关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{任务子目标来源关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{需求列表成员关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{需求所属存在关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{需求目标宿主关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{需求目标特征关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{需求目标合同关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{列表项所属存在关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{列表项目标宿主关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{列表项目标特征关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{列表项目标合同关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 需求结构类型登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 11)
        throw std::runtime_error("L2 requirement type registry init failed");

    需求结构类型定位 定位{};
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码))
            throw std::runtime_error("L2 req type mapping invalid");
        if (本地键.值 == 需求父子关系类型本地键值)
            定位.需求父子关系类型 = 编码;
        else if (本地键.值 == 任务子目标来源关系类型本地键值)
            定位.任务子目标来源关系类型 = 编码;
        else if (本地键.值 == 需求列表成员关系类型本地键值)
            定位.需求列表成员关系类型 = 编码;
        else if (本地键.值 == 需求所属存在关系类型本地键值)
            定位.需求所属存在关系类型 = 编码;
        else if (本地键.值 == 需求目标宿主关系类型本地键值)
            定位.需求目标宿主关系类型 = 编码;
        else if (本地键.值 == 需求目标特征关系类型本地键值)
            定位.需求目标特征关系类型 = 编码;
        else if (本地键.值 == 需求目标合同关系类型本地键值)
            定位.需求目标合同关系类型 = 编码;
        else if (本地键.值 == 列表项所属存在关系类型本地键值)
            定位.列表项所属存在关系类型 = 编码;
        else if (本地键.值 == 列表项目标宿主关系类型本地键值)
            定位.列表项目标宿主关系类型 = 编码;
        else if (本地键.值 == 列表项目标特征关系类型本地键值)
            定位.列表项目标特征关系类型 = 编码;
        else if (本地键.值 == 列表项目标合同关系类型本地键值)
            定位.列表项目标合同关系类型 = 编码;
        else
            throw std::runtime_error("L2 req type mapping unknown");
    }
    定位.建立事实代次 = 写入.事实代次;
    return 定位;
}

// ===== 身份读取：状态映射 =====

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部一致读取失败状态。
L2需求身份读取状态 映射需求身份一致读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2需求身份读取状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2需求身份读取状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2需求身份读取状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2需求身份读取状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2需求身份读取状态::内部不一致;
    }
    return L2需求身份读取状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部当前读取项目状态。
L2需求身份读取状态 映射需求身份当前项目状态(
    L1所有者范围一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取项目状态::成功:
        return L2需求身份读取状态::成功;
    case L1所有者范围一致当前读取项目状态::未找到:
        return L2需求身份读取状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出:
        return L2需求身份读取状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2需求身份读取状态::内部不一致;
    }
    return L2需求身份读取状态::内部不一致;
}

// 诊断责任：无适用错误分支；两个身份读取状态枚举值域同构，纯值映射。
L2需求列表项身份读取状态 映射需求列表项身份状态(
    L2需求身份读取状态 状态) noexcept {
    switch (状态) {
    case L2需求身份读取状态::成功:
        return L2需求列表项身份读取状态::成功;
    case L2需求身份读取状态::入口拒绝:
        return L2需求列表项身份读取状态::入口拒绝;
    case L2需求身份读取状态::未找到:
        return L2需求列表项身份读取状态::未找到;
    case L2需求身份读取状态::已退出:
        return L2需求列表项身份读取状态::已退出;
    case L2需求身份读取状态::事实代次漂移:
        return L2需求列表项身份读取状态::事实代次漂移;
    case L2需求身份读取状态::许可拒绝:
        return L2需求列表项身份读取状态::许可拒绝;
    case L2需求身份读取状态::资源失败:
        return L2需求列表项身份读取状态::资源失败;
    case L2需求身份读取状态::内部不一致:
        return L2需求列表项身份读取状态::内部不一致;
    }
    return L2需求列表项身份读取状态::内部不一致;
}

// ===== 身份读取：预检结果 =====

struct 需求身份预检结果 final {
    L2需求身份读取状态 状态 = L2需求身份读取状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 代次漂移 = false;
    bool 成功() const noexcept {
        return 状态 == L2需求身份读取状态::成功 && 事实截止代次 != 0;
    }
};

// 诊断责任：无适用错误分支；核对一致投影顶层成功或精确失败形状。
需求身份预检结果 解释需求身份一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取,
    std::uint64_t 期望代次) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次 && 读取.读取事实代次 != 0)
            return {L2需求身份读取状态::成功, 读取.读取事实代次, false};
        return {L2需求身份读取状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.所有者.empty() && 读取.节点.empty()
        && 读取.关系.empty() && 读取.值.empty()
        && 读取.属性值.empty() && 读取.源关系组.empty()
        && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态
        == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2需求身份读取状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
        return {L2需求身份读取状态::事实代次漂移,
            读取.读取事实代次, true};
    return {映射需求身份一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// ===== 身份读取：投影项查找 =====

// 诊断责任：无适用错误分支；按查询编码查找唯一节点结果项。
const L1所有者范围一致节点读取结果项* 查找唯一需求节点项(
    const L1所有者范围一致当前读取结果& 读取,
    稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；按精确选择项查找唯一来源关系组。
const L1所有者范围一致源关系组读取结果项* 查找唯一需求来源关系组(
    const L1所有者范围一致当前读取结果& 读取,
    稳定编码 源节点, 稳定编码 关系类型) noexcept {
    const L1所有者范围一致源关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.源关系组) {
        if (项.源节点 != 源节点
            || 项.关系类型节点 != 关系类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；按精确选择项查找唯一目标关系组。
const L1所有者范围一致目标关系组读取结果项* 查找唯一需求目标关系组(
    const L1所有者范围一致当前读取结果& 读取,
    稳定编码 目标节点, 稳定编码 关系类型) noexcept {
    const L1所有者范围一致目标关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.目标关系组) {
        if (项.目标节点 != 目标节点
            || 项.关系类型节点 != 关系类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// ===== 身份读取：失败构造器 =====

inline L2需求身份读取结果 形成需求身份读取失败(
    L2需求身份读取状态 状态, std::uint64_t 截止 = 0,
    L2需求身份 需求 = L2需求身份{}) noexcept {
    L2需求身份读取结果 结果;
    结果.合同版本 = L2结构合同版本;
    结果.状态 = 状态;
    结果.事实截止代次 = 截止;
    结果.需求 = 需求;
    return 结果;
}

inline L2需求列表项身份读取结果 形成需求列表项身份读取失败(
    L2需求列表项身份读取状态 状态, std::uint64_t 截止 = 0,
    L2需求列表项身份 列表项 = L2需求列表项身份{}) noexcept {
    L2需求列表项身份读取结果 结果;
    结果.合同版本 = L2结构合同版本;
    结果.状态 = 状态;
    结果.事实截止代次 = 截止;
    结果.列表项 = 列表项;
    return 结果;
}

// ===== 身份读取：需求身份投影验证 =====

// 诊断责任：向上送出；一次 owner-aware 当前投影裁决需求身份真实性。
// 验证项：需求 owner 归属、需求族证明、生命周期、列表成员关系。
L2需求身份读取结果 验证需求身份当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求身份读取请求& 请求,
    std::uint64_t 期望代次) {
    if (请求.需求.值 == 来源定位.需求锚点
        || 请求.需求.值 == 来源定位.需求类型)
        return 形成需求身份读取失败(
            L2需求身份读取状态::入口拒绝, 期望代次, 请求.需求);

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.节点 = {请求.需求.值, 来源定位.需求锚点,
        来源定位.需求类型};
    L1请求.源关系组 = {{请求.需求.值, 来源定位.需求类型}};
    L1请求.目标关系组 = {{请求.需求.值,
        类型定位.需求列表成员关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释需求身份一致读取顶层(读取, 期望代次);
    if (!顶层.成功())
        return 形成需求身份读取失败(
            顶层.状态, 顶层.事实截止代次, 请求.需求);

    // 预期形状：1 所有者、3 节点、0 关系、0 值、1 源关系组、1 目标关系组
    if (读取.所有者.size() != 1 || 读取.节点.size() != 3
        || !读取.关系.empty() || !读取.值.empty()
        || 读取.源关系组.size() != 1
        || 读取.目标关系组.size() != 1)
        return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);

    const auto& 所有者项 = 读取.所有者.front();
    const auto* 节点项 = 查找唯一需求节点项(读取, 请求.需求.值);
    const auto* 锚点项 = 查找唯一需求节点项(读取, 来源定位.需求锚点);
    const auto* 类型项 = 查找唯一需求节点项(读取, 来源定位.需求类型);
    const auto* 族归属组项 = 查找唯一需求来源关系组(
        读取, 请求.需求.值, 来源定位.需求类型);
    const auto* 列表成员组项 = 查找唯一需求目标关系组(
        读取, 请求.需求.值, 类型定位.需求列表成员关系类型);
    if (所有者项.查询所有者 != 来源定位.所有者 || !节点项 || !锚点项
        || !类型项 || !族归属组项 || !列表成员组项)
        return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);

    // 需求节点：存在性、归属、当前性
    if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (节点项->事实) return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);
        return 形成需求身份读取失败(
            映射需求身份当前项目状态(节点项->状态),
            顶层.事实截止代次, 请求.需求);
    }
    if (!节点项->事实) return 形成需求身份读取失败(
        L2需求身份读取状态::内部不一致,
        顶层.事实截止代次, 请求.需求);
    const auto& 节点 = *节点项->事实;
    if (节点.写入所有者 != 来源定位.所有者
        || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.退出事实代次)
        return 形成需求身份读取失败(
            L2需求身份读取状态::入口拒绝,
            顶层.事实截止代次, 请求.需求);

    // 所有者、族锚点、族归属关系类型：内部节点完整性
    if (所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实
        || 所有者项.所有者事实->所有者 != 来源定位.所有者
        || 所有者项.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者项.所有者事实->退出事实代次
        || 锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !锚点项->事实 || !类型项->事实)
        return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    const auto 内部节点完整 = [&](
        const L1所有者范围节点事实& 内部节点) noexcept {
        return 内部节点.写入所有者 == 来源定位.所有者
            && 内部节点.种类 == 节点种类::普通
            && !内部节点.属性类型表示 && !内部节点.退出事实代次
            && 内部节点.当前属性.empty();
    };
    if (!内部节点完整(锚点) || !内部节点完整(类型)
        || 锚点.编码 != 来源定位.需求锚点
        || 类型.编码 != 来源定位.需求类型
        || 锚点.创建事实代次 != 来源定位.建立事实代次
        || 类型.创建事实代次 != 来源定位.建立事实代次
        || 所有者项.所有者事实->创建事实代次
            > 来源定位.建立事实代次
        || 来源定位.建立事实代次 > 节点.创建事实代次)
        return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);

    // 需求族归属：恰有一条当前族归属关系，源为需求、目标为族锚点
    if (族归属组项->成员.size() != 1)
        return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);
    const auto& 族归属关系 = 族归属组项->成员.front().关系;
    if (族归属关系.写入所有者 != 来源定位.所有者
        || 族归属关系.源节点 != 请求.需求.值
        || 族归属关系.目标节点 != 来源定位.需求锚点
        || 族归属关系.关系类型节点 != 来源定位.需求类型
        || 族归属关系.退出事实代次
        || 族归属关系.创建事实代次 != 节点.创建事实代次)
        return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);

    // 列表成员关系：恰有一条当前列表成员关系（规范 10.3）
    const auto& 列表成员组 = 列表成员组项->成员;
    std::size_t 当前成员数 = 0;
    for (const auto& 成员 : 列表成员组) {
        if (!成员.关系.退出事实代次) ++当前成员数;
    }
    if (当前成员数 != 1)
        return 形成需求身份读取失败(
            L2需求身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.需求);

    L2需求身份读取结果 结果;
    结果.合同版本 = L2结构合同版本;
    结果.状态 = L2需求身份读取状态::成功;
    结果.事实截止代次 = 顶层.事实截止代次;
    结果.需求 = 请求.需求;
    结果.来源稳定编码 = 请求.来源稳定编码;
    return 结果;
}

// ===== 身份读取：需求列表项身份投影验证 =====

// 诊断责任：向上送出；一次 owner-aware 当前投影裁决列表项身份真实性。
// 验证项：列表项 owner 归属、列表项族证明、生命周期。
// 列表项当前成员数 = 0 是合法状态（规范 10.4），不强制列表成员关系。
L2需求列表项身份读取结果 验证需求列表项身份当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const L2需求列表项身份读取请求& 请求,
    std::uint64_t 期望代次) {
    if (请求.列表项.值 == 来源定位.列表项锚点
        || 请求.列表项.值 == 来源定位.列表项类型)
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::入口拒绝, 期望代次,
            请求.列表项);

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.节点 = {请求.列表项.值, 来源定位.列表项锚点,
        来源定位.列表项类型};
    L1请求.源关系组 = {{请求.列表项.值, 来源定位.列表项类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释需求身份一致读取顶层(读取, 期望代次);
    if (!顶层.成功())
        return 形成需求列表项身份读取失败(
            映射需求列表项身份状态(顶层.状态),
            顶层.事实截止代次, 请求.列表项);

    // 预期形状：1 所有者、3 节点、0 关系、0 值、1 源关系组、0 目标关系组
    if (读取.所有者.size() != 1 || 读取.节点.size() != 3
        || !读取.关系.empty() || !读取.值.empty()
        || 读取.源关系组.size() != 1
        || !读取.目标关系组.empty())
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.列表项);

    const auto& 所有者项 = 读取.所有者.front();
    const auto* 节点项 = 查找唯一需求节点项(读取, 请求.列表项.值);
    const auto* 锚点项 = 查找唯一需求节点项(读取, 来源定位.列表项锚点);
    const auto* 类型项 = 查找唯一需求节点项(读取, 来源定位.列表项类型);
    const auto* 族归属组项 = 查找唯一需求来源关系组(
        读取, 请求.列表项.值, 来源定位.列表项类型);
    if (所有者项.查询所有者 != 来源定位.所有者 || !节点项 || !锚点项
        || !类型项 || !族归属组项)
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.列表项);

    // 列表项节点：存在性、归属、当前性
    if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (节点项->事实) return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.列表项);
        return 形成需求列表项身份读取失败(
            映射需求列表项身份状态(
                映射需求身份当前项目状态(节点项->状态)),
            顶层.事实截止代次, 请求.列表项);
    }
    if (!节点项->事实) return 形成需求列表项身份读取失败(
        L2需求列表项身份读取状态::内部不一致,
        顶层.事实截止代次, 请求.列表项);
    const auto& 节点 = *节点项->事实;
    if (节点.写入所有者 != 来源定位.所有者
        || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.退出事实代次)
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::入口拒绝,
            顶层.事实截止代次, 请求.列表项);

    // 所有者、族锚点、族归属关系类型：内部节点完整性
    if (所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实
        || 所有者项.所有者事实->所有者 != 来源定位.所有者
        || 所有者项.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者项.所有者事实->退出事实代次
        || 锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !锚点项->事实 || !类型项->事实)
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.列表项);
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    const auto 内部节点完整 = [&](
        const L1所有者范围节点事实& 内部节点) noexcept {
        return 内部节点.写入所有者 == 来源定位.所有者
            && 内部节点.种类 == 节点种类::普通
            && !内部节点.属性类型表示 && !内部节点.退出事实代次
            && 内部节点.当前属性.empty();
    };
    if (!内部节点完整(锚点) || !内部节点完整(类型)
        || 锚点.编码 != 来源定位.列表项锚点
        || 类型.编码 != 来源定位.列表项类型
        || 锚点.创建事实代次 != 来源定位.建立事实代次
        || 类型.创建事实代次 != 来源定位.建立事实代次
        || 所有者项.所有者事实->创建事实代次
            > 来源定位.建立事实代次
        || 来源定位.建立事实代次 > 节点.创建事实代次)
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.列表项);

    // 列表项族归属：恰有一条当前族归属关系
    if (族归属组项->成员.size() != 1)
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.列表项);
    const auto& 族归属关系 = 族归属组项->成员.front().关系;
    if (族归属关系.写入所有者 != 来源定位.所有者
        || 族归属关系.源节点 != 请求.列表项.值
        || 族归属关系.目标节点 != 来源定位.列表项锚点
        || 族归属关系.关系类型节点 != 来源定位.列表项类型
        || 族归属关系.退出事实代次
        || 族归属关系.创建事实代次 != 节点.创建事实代次)
        return 形成需求列表项身份读取失败(
            L2需求列表项身份读取状态::内部不一致,
            顶层.事实截止代次, 请求.列表项);

    L2需求列表项身份读取结果 结果;
    结果.合同版本 = L2结构合同版本;
    结果.状态 = L2需求列表项身份读取状态::成功;
    结果.事实截止代次 = 顶层.事实截止代次;
    结果.列表项 = 请求.列表项;
    结果.来源稳定编码 = 请求.来源稳定编码;
    return 结果;
}

// ===== 身份来源读取：投影解释 =====

// 诊断责任：无适用错误分支；将 L1 一致读取状态映射到身份来源读取的 L2结构状态。
L2结构状态 映射身份来源一致读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；将当前读取项目状态映射到身份来源读取的 L2结构状态。
L2结构状态 映射身份来源当前项目状态(
    L1所有者范围一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取项目状态::成功:
        return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到:
        return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出:
        return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 身份来源投影预检结果
struct 需求身份来源预检结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 代次漂移 = false;
    bool 成功() const noexcept {
        return 状态 == L2结构状态::已读取 && 事实截止代次 != 0;
    }
};

// 诊断责任：无适用错误分支；核对身份来源一致投影顶层成功或精确失败形状。
需求身份来源预检结果 解释身份来源一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取,
    std::uint64_t 期望代次) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次
            && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.所有者.empty() && 读取.节点.empty()
        && 读取.关系.empty() && 读取.值.empty()
        && 读取.属性值.empty() && 读取.源关系组.empty()
        && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态
        == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移,
            读取.读取事实代次, true};
    return {映射身份来源一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 身份来源投影解释中间结果
struct 需求身份来源投影解释 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    std::optional<L2节点族身份来源事实> 来源;
};

// 诊断责任：向上送出；从已成功的一致投影中验证并构造需求节点族身份来源事实。
// 验证项：需求 owner 归属、需求族锚点证明、族归属关系类型证明、
//         族归属关系证明、角色或顺序、5 个生命周期。
需求身份来源投影解释 解释需求身份来源投影(
    const L1所有者范围一致当前读取结果& 读取,
    const 需求身份来源定位& 来源定位,
    稳定编码 需求编码,
    std::uint64_t 截止) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        return 需求身份来源投影解释{状态, 截止, std::nullopt};
    };

    // 预期形状：1 所有者、3 节点、0 关系、0 值、1 源关系组、0 目标关系组
    if (读取.所有者.size() != 1 || 读取.节点.size() != 3
        || !读取.关系.empty() || !读取.值.empty()
        || 读取.源关系组.size() != 1
        || !读取.目标关系组.empty())
        return 失败(L2结构状态::内部不一致);

    const auto& 所有者项 = 读取.所有者.front();
    const auto* 节点项 = 查找唯一需求节点项(读取, 需求编码);
    const auto* 锚点项 = 查找唯一需求节点项(读取, 来源定位.需求锚点);
    const auto* 类型项 = 查找唯一需求节点项(读取, 来源定位.需求类型);
    const auto* 族归属组项 = 查找唯一需求来源关系组(
        读取, 需求编码, 来源定位.需求类型);
    if (所有者项.查询所有者 != 来源定位.所有者 || !节点项 || !锚点项
        || !类型项 || !族归属组项)
        return 失败(L2结构状态::内部不一致);

    // 需求节点：存在性、归属、当前性
    if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (节点项->事实) return 失败(L2结构状态::内部不一致);
        return {映射身份来源当前项目状态(节点项->状态), 截止, std::nullopt};
    }
    if (!节点项->事实) return 失败(L2结构状态::内部不一致);
    const auto& 节点 = *节点项->事实;
    if (节点.写入所有者 != 来源定位.所有者
        || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.退出事实代次)
        return 失败(L2结构状态::入口拒绝);

    // 所有者、族锚点、族归属关系类型：内部节点完整性
    if (所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实
        || 所有者项.所有者事实->所有者 != 来源定位.所有者
        || 所有者项.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者项.所有者事实->退出事实代次
        || 锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !锚点项->事实 || !类型项->事实)
        return 失败(L2结构状态::内部不一致);
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    const auto 内部节点完整 = [&](
        const L1所有者范围节点事实& 内部节点) noexcept {
        return 内部节点.写入所有者 == 来源定位.所有者
            && 内部节点.种类 == 节点种类::普通
            && !内部节点.属性类型表示 && !内部节点.退出事实代次
            && 内部节点.当前属性.empty();
    };
    if (!内部节点完整(锚点) || !内部节点完整(类型)
        || 锚点.编码 != 来源定位.需求锚点
        || 类型.编码 != 来源定位.需求类型
        || 锚点.创建事实代次 != 来源定位.建立事实代次
        || 类型.创建事实代次 != 来源定位.建立事实代次
        || 所有者项.所有者事实->创建事实代次
            > 来源定位.建立事实代次
        || 来源定位.建立事实代次 > 节点.创建事实代次)
        return 失败(L2结构状态::内部不一致);

    // 族归属关系：恰有一条当前族归属关系
    if (族归属组项->成员.size() != 1)
        return 失败(L2结构状态::内部不一致);
    const auto& 族归属关系 = 族归属组项->成员.front().关系;
    if (族归属关系.写入所有者 != 来源定位.所有者
        || 族归属关系.源节点 != 需求编码
        || 族归属关系.目标节点 != 来源定位.需求锚点
        || 族归属关系.关系类型节点 != 来源定位.需求类型
        || 族归属关系.退出事实代次
        || 族归属关系.创建事实代次 != 节点.创建事实代次
        || 族归属关系.角色或顺序 != 1)
        return 失败(L2结构状态::内部不一致);

    // 构造 L2节点族身份来源事实
    L2节点族身份来源事实 来源;
    来源.节点族 = L2节点族::需求;
    来源.节点稳定编码 = 需求编码;
    来源.族锚点稳定编码 = 来源定位.需求锚点;
    来源.族归属关系类型稳定编码 = 来源定位.需求类型;
    来源.族归属关系稳定编码 = 族归属关系.编码;
    来源.角色或顺序 = 族归属关系.角色或顺序;
    来源.节点生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    来源.族锚点生命周期 = {锚点.创建事实代次, 锚点.退出事实代次};
    来源.关系类型生命周期 = {类型.创建事实代次, 类型.退出事实代次};
    来源.归属关系生命周期 = {族归属关系.创建事实代次,
        族归属关系.退出事实代次};

    if (!L2节点族身份来源事实完整(来源, 截止))
        return 失败(L2结构状态::内部不一致);

    return {L2结构状态::已读取, 截止, std::move(来源)};
}

// 诊断责任：向上送出；一次 owner-aware 当前投影读取需求身份来源事实。
L2需求身份来源读取结果 读取需求身份来源当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const L2需求身份来源读取请求& 请求,
    std::uint64_t 期望代次) {
    if (请求.需求.值 == 来源定位.需求锚点
        || 请求.需求.值 == 来源定位.需求类型) {
        L2需求身份来源读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = L2结构状态::入口拒绝;
        结果.结果头.事实截止代次 = 期望代次;
        return 结果;
    }

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.节点 = {请求.需求.值, 来源定位.需求锚点,
        来源定位.需求类型};
    L1请求.源关系组 = {{请求.需求.值, 来源定位.需求类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释身份来源一致读取顶层(读取, 期望代次);
    if (!顶层.成功()) {
        L2需求身份来源读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 顶层.状态;
        结果.结果头.事实截止代次 = 顶层.事实截止代次;
        return 结果;
    }

    const auto 解释 = 解释需求身份来源投影(
        读取, 来源定位, 请求.需求.值, 顶层.事实截止代次);
    L2需求身份来源读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = 解释.状态;
    结果.结果头.事实截止代次 = 解释.事实截止代次;
    结果.读取类别 = 请求.读取类别;
    结果.历史截止事实代次 = 请求.历史截止事实代次;
    结果.身份来源 = std::move(解释.来源);
    return 结果;
}

// ===== 写入：辅助函数 =====

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2结构状态 映射需求写入状态(
    L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；完整 64 位纯值映射不读取事实。
L1所有者范围写入幂等身份 映射需求幂等键(
    L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；纯值事实代次探测失败状态映射。
L2结构状态 映射需求事实代次探测失败(
    L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
    case L1中性读取状态::成功:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 写入代次预检结果
struct 需求写入预检结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 直接提交 = false;
    bool 成功() const noexcept {
        return 状态 == L2结构状态::已读取 && 事实截止代次 != 0;
    }
};

// 诊断责任：向上送出；当前代次失败或漂移均形成结构化预检结果。
需求写入预检结果 检查需求写入当前代次(
    const L1事实基座服务& 第一层服务, std::uint64_t 期望代次) {
    const auto 读取 = 第一层服务.读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (读取.合同版本 != L1中性CRUD合同版本)
        return {L2结构状态::内部不一致, 读取.事实代次, false};
    if (读取.状态 != L1中性读取状态::成功)
        return {映射需求事实代次探测失败(读取.状态), 读取.事实代次, false};
    if (读取.事实代次 == 0)
        return {L2结构状态::内部不一致, 0, false};
    if (读取.事实代次 != 期望代次)
        return {L2结构状态::事实代次漂移, 读取.事实代次, true};
    return {L2结构状态::已读取, 读取.事实代次, false};
}

// 写入编码映射查找结果
struct 需求写入编码映射 final {
    稳定编码 列表项节点;
    稳定编码 需求节点;
    稳定编码 列表项族归属关系;
    稳定编码 列表项所属存在关系;
    稳定编码 列表项目标宿主关系;
    稳定编码 列表项目标特征关系;
    稳定编码 列表项目标合同关系;
    稳定编码 需求族归属关系;
    稳定编码 需求所属存在关系;
    稳定编码 需求目标宿主关系;
    稳定编码 需求目标特征关系;
    稳定编码 需求目标合同关系;
    稳定编码 列表成员关系;
    稳定编码 父子关系;
    稳定编码 任务子目标来源关系;
};

// 诊断责任：无适用错误分支；按本地键从写入结果的新编码映射中提取稳定编码。
std::optional<需求写入编码映射> 查找需求写入编码映射(
    const L1所有者范围写入结果& 写入,
    bool 含父子关系, bool 含任务子目标来源 = false) noexcept {
    const auto 期望数 = (含父子关系 ? std::size_t(14) : std::size_t(13))
        + (含任务子目标来源 ? std::size_t(1) : std::size_t(0));
    if (写入.新编码映射.size() != 期望数) return std::nullopt;
    需求写入编码映射 映射;
    std::size_t 已找到 = 0;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) return std::nullopt;
        if (本地键.值 == 列表项节点写入本地键值) {
            映射.列表项节点 = 编码; ++已找到;
        } else if (本地键.值 == 需求节点写入本地键值) {
            映射.需求节点 = 编码; ++已找到;
        } else if (本地键.值 == 列表项族归属关系写入本地键值) {
            映射.列表项族归属关系 = 编码; ++已找到;
        } else if (本地键.值 == 列表项所属存在关系写入本地键值) {
            映射.列表项所属存在关系 = 编码; ++已找到;
        } else if (本地键.值 == 列表项目标宿主关系写入本地键值) {
            映射.列表项目标宿主关系 = 编码; ++已找到;
        } else if (本地键.值 == 列表项目标特征关系写入本地键值) {
            映射.列表项目标特征关系 = 编码; ++已找到;
        } else if (本地键.值 == 列表项目标合同关系写入本地键值) {
            映射.列表项目标合同关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求族归属关系写入本地键值) {
            映射.需求族归属关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求所属存在关系写入本地键值) {
            映射.需求所属存在关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求目标宿主关系写入本地键值) {
            映射.需求目标宿主关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求目标特征关系写入本地键值) {
            映射.需求目标特征关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求目标合同关系写入本地键值) {
            映射.需求目标合同关系 = 编码; ++已找到;
        } else if (本地键.值 == 列表成员关系写入本地键值) {
            映射.列表成员关系 = 编码; ++已找到;
        } else if (含父子关系
            && 本地键.值 == 父子关系写入本地键值) {
            映射.父子关系 = 编码; ++已找到;
        } else if (含任务子目标来源
            && 本地键.值 == 任务子目标来源关系写入本地键值) {
            映射.任务子目标来源关系 = 编码; ++已找到;
        } else return std::nullopt;
    }
    if (已找到 != 期望数) return std::nullopt;
    // 编码互不相同（节点与关系编码空间不重叠由仓库保证，这里只防重复）
    if (映射.列表项节点 == 映射.需求节点) return std::nullopt;
    return 映射;
}

// 诊断责任：无适用错误分支；从 L1 节点事实构造 L2 需求列表项事实。
L2需求列表项事实 形成L2需求列表项事实(
    const L1所有者范围节点事实& 节点,
    L2需求列表项身份 身份, L2存在身份 所属存在,
    L2存在身份 目标宿主存在, L2特征定义身份 目标特征定义,
    L2目标状态合同身份 目标状态合同, std::uint64_t 截止) noexcept {
    L2需求列表项事实 事实;
    事实.身份 = 身份;
    事实.所属存在 = 所属存在;
    事实.目标宿主存在 = 目标宿主存在;
    事实.目标特征定义 = 目标特征定义;
    事实.目标状态合同 = 目标状态合同;
    事实.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    (void)截止;
    return 事实;
}

// 诊断责任：无适用错误分支；从 L1 节点事实构造 L2 需求事实。
L2需求事实 形成L2需求事实(
    const L1所有者范围节点事实& 节点,
    L2需求身份 身份, L2存在身份 所属存在,
    L2存在身份 目标宿主存在, L2特征定义身份 目标特征定义,
    L2目标状态合同身份 目标状态合同, std::uint64_t 截止) noexcept {
    L2需求事实 事实;
    事实.身份 = 身份;
    事实.所属存在 = 所属存在;
    事实.目标宿主存在 = 目标宿主存在;
    事实.目标特征定义 = 目标特征定义;
    事实.目标状态合同 = 目标状态合同;
    事实.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    (void)截止;
    return 事实;
}

// 写入提交并读回结果
struct 需求写入提交读回结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 是否形成内存权威发布 = false;
    需求写入编码映射 编码映射;
};

// 诊断责任：向上送出；提交写集并验证写入结果的精确形状与编码映射完整性。
需求写入提交读回结果 提交并验证需求写集(
    L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集, bool 含父子关系,
    bool 含任务子目标来源 = false) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    需求写入提交读回结果 结果;
    结果.状态 = 映射需求写入状态(写入.状态);
    结果.事实截止代次 = 写入.事实代次;
    结果.是否形成内存权威发布 = 写入.是否形成内存权威发布;

    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 写入端口.所有者身份()
        || 写入.写入幂等身份 != 写集.写入幂等身份) {
        结果.状态 = L2结构状态::内部不一致;
        return 结果;
    }
    if (结果.状态 != L2结构状态::已提交
        && 结果.状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布) {
            结果.状态 = L2结构状态::内部不一致;
            return 结果;
        }
        return 结果;
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)) {
        结果.状态 = L2结构状态::内部不一致;
        return 结果;
    }
    const auto 映射 = 查找需求写入编码映射(
        写入, 含父子关系, 含任务子目标来源);
    if (!映射) {
        结果.状态 = L2结构状态::内部不一致;
        return 结果;
    }
    结果.编码映射 = *映射;
    return 结果;
}

// 诊断责任：向上送出；读回所有新建事实并构造完整写入结果。
L2新增需求并建立列表项结果 读回新增需求并建立列表项(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2新增需求并建立列表项请求& 请求,
    const 需求写入编码映射& 编码映射,
    std::uint64_t 写入代次) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        L2新增需求并建立列表项结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 写入代次;
        结果.结果头.变更事实代次 = 写入代次;
        return 结果;
    };

    const auto 列表项身份 = L2需求列表项身份{编码映射.列表项节点};
    const auto 需求身份 = L2需求身份{编码映射.需求节点};

    // 读回列表项节点
    const auto 列表项节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码映射.列表项节点});
    const auto* 列表项节点 = 列表项节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*列表项节点读取.事实)
        : nullptr;
    if (列表项节点读取.状态 != L1所有者范围读取状态::成功
        || !列表项节点
        || 列表项节点->编码 != 编码映射.列表项节点
        || 列表项节点->写入所有者 != 来源定位.所有者
        || 列表项节点->种类 != 节点种类::普通
        || 列表项节点->属性类型表示
        || 列表项节点->退出事实代次
        || 列表项节点->创建事实代次 != 写入代次)
        return 失败(L2结构状态::内部不一致);

    // 读回需求节点
    const auto 需求节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码映射.需求节点});
    const auto* 需求节点 = 需求节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*需求节点读取.事实)
        : nullptr;
    if (需求节点读取.状态 != L1所有者范围读取状态::成功
        || !需求节点
        || 需求节点->编码 != 编码映射.需求节点
        || 需求节点->写入所有者 != 来源定位.所有者
        || 需求节点->种类 != 节点种类::普通
        || 需求节点->属性类型表示
        || 需求节点->退出事实代次
        || 需求节点->创建事实代次 != 写入代次)
        return 失败(L2结构状态::内部不一致);

    // 读回所有关系并验证
    const auto 读回关系 = [&](稳定编码 编码)
        -> std::optional<L1所有者范围关系事实> {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实)
            : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功 || !关系
            || 关系->编码 != 编码
            || 关系->写入所有者 != 来源定位.所有者
            || 关系->退出事实代次
            || 关系->创建事实代次 != 写入代次)
            return std::nullopt;
        return *关系;
    };

    const auto 列表项族归属 = 读回关系(编码映射.列表项族归属关系);
    const auto 列表项所属存在 = 读回关系(编码映射.列表项所属存在关系);
    const auto 列表项目标宿主 = 读回关系(编码映射.列表项目标宿主关系);
    const auto 列表项目标特征 = 读回关系(编码映射.列表项目标特征关系);
    const auto 列表项目标合同 = 读回关系(编码映射.列表项目标合同关系);
    const auto 需求族归属 = 读回关系(编码映射.需求族归属关系);
    const auto 需求所属存在 = 读回关系(编码映射.需求所属存在关系);
    const auto 需求目标宿主 = 读回关系(编码映射.需求目标宿主关系);
    const auto 需求目标特征 = 读回关系(编码映射.需求目标特征关系);
    const auto 需求目标合同 = 读回关系(编码映射.需求目标合同关系);
    const auto 列表成员 = 读回关系(编码映射.列表成员关系);
    if (!列表项族归属 || !列表项所属存在 || !列表项目标宿主
        || !列表项目标特征 || !列表项目标合同
        || !需求族归属 || !需求所属存在 || !需求目标宿主
        || !需求目标特征 || !需求目标合同 || !列表成员)
        return 失败(L2结构状态::内部不一致);

    // 验证列表项族归属关系
    if (列表项族归属->源节点 != 编码映射.列表项节点
        || 列表项族归属->目标节点 != 来源定位.列表项锚点
        || 列表项族归属->关系类型节点 != 来源定位.列表项类型
        || 列表项族归属->角色或顺序 != 1)
        return 失败(L2结构状态::内部不一致);

    // 验证列表项目标关系
    if (列表项所属存在->源节点 != 编码映射.列表项节点
        || 列表项所属存在->目标节点 != 请求.所属存在.值
        || 列表项所属存在->关系类型节点
            != 类型定位.列表项所属存在关系类型)
        return 失败(L2结构状态::内部不一致);
    if (列表项目标宿主->源节点 != 编码映射.列表项节点
        || 列表项目标宿主->目标节点 != 请求.目标宿主存在.值
        || 列表项目标宿主->关系类型节点
            != 类型定位.列表项目标宿主关系类型)
        return 失败(L2结构状态::内部不一致);
    if (列表项目标特征->源节点 != 编码映射.列表项节点
        || 列表项目标特征->目标节点 != 请求.目标特征定义.值
        || 列表项目标特征->关系类型节点
            != 类型定位.列表项目标特征关系类型)
        return 失败(L2结构状态::内部不一致);
    if (列表项目标合同->源节点 != 编码映射.列表项节点
        || 列表项目标合同->目标节点 != 请求.目标状态合同.值
        || 列表项目标合同->关系类型节点
            != 类型定位.列表项目标合同关系类型)
        return 失败(L2结构状态::内部不一致);

    // 验证需求族归属关系
    if (需求族归属->源节点 != 编码映射.需求节点
        || 需求族归属->目标节点 != 来源定位.需求锚点
        || 需求族归属->关系类型节点 != 来源定位.需求类型
        || 需求族归属->角色或顺序 != 1)
        return 失败(L2结构状态::内部不一致);

    // 验证需求目标关系
    if (需求所属存在->源节点 != 编码映射.需求节点
        || 需求所属存在->目标节点 != 请求.所属存在.值
        || 需求所属存在->关系类型节点
            != 类型定位.需求所属存在关系类型)
        return 失败(L2结构状态::内部不一致);
    if (需求目标宿主->源节点 != 编码映射.需求节点
        || 需求目标宿主->目标节点 != 请求.目标宿主存在.值
        || 需求目标宿主->关系类型节点
            != 类型定位.需求目标宿主关系类型)
        return 失败(L2结构状态::内部不一致);
    if (需求目标特征->源节点 != 编码映射.需求节点
        || 需求目标特征->目标节点 != 请求.目标特征定义.值
        || 需求目标特征->关系类型节点
            != 类型定位.需求目标特征关系类型)
        return 失败(L2结构状态::内部不一致);
    if (需求目标合同->源节点 != 编码映射.需求节点
        || 需求目标合同->目标节点 != 请求.目标状态合同.值
        || 需求目标合同->关系类型节点
            != 类型定位.需求目标合同关系类型)
        return 失败(L2结构状态::内部不一致);

    // 验证列表成员关系：列表项 -> 需求
    if (列表成员->源节点 != 编码映射.列表项节点
        || 列表成员->目标节点 != 编码映射.需求节点
        || 列表成员->关系类型节点
            != 类型定位.需求列表成员关系类型
        || 列表成员->角色或顺序 != 1)
        return 失败(L2结构状态::内部不一致);

    // 可选父子关系
    std::optional<L2需求父子关系事实> 当前父关系;
    if (请求.父需求) {
        const auto 父子关系 = 读回关系(编码映射.父子关系);
        if (!父子关系
            || 父子关系->源节点 != 请求.父需求->值
            || 父子关系->目标节点 != 编码映射.需求节点
            || 父子关系->关系类型节点
                != 类型定位.需求父子关系类型
            || 父子关系->角色或顺序
                != static_cast<std::int64_t>(请求.父子顺序))
            return 失败(L2结构状态::内部不一致);
        当前父关系 = L2需求父子关系事实{
            编码映射.父子关系, *请求.父需求, 需求身份,
            请求.父子顺序, {写入代次, std::nullopt}};
    }

    // 构造完整结果
    L2新增需求并建立列表项结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已提交;
    结果.结果头.事实截止代次 = 写入代次;
    结果.结果头.变更事实代次 = 写入代次;

    结果.新建列表项 = 形成L2需求列表项事实(*列表项节点,
        列表项身份, 请求.所属存在, 请求.目标宿主存在,
        请求.目标特征定义, 请求.目标状态合同, 写入代次);
    结果.列表项自有关系 = L2需求列表项自有关系引用{
        编码映射.列表项族归属关系,
        编码映射.列表项所属存在关系,
        编码映射.列表项目标宿主关系,
        编码映射.列表项目标特征关系,
        编码映射.列表项目标合同关系};

    结果.新建需求 = 形成L2需求事实(*需求节点,
        需求身份, 请求.所属存在, 请求.目标宿主存在,
        请求.目标特征定义, 请求.目标状态合同, 写入代次);
    结果.需求自有关系 = L2需求自有关系引用{
        编码映射.需求族归属关系,
        编码映射.需求所属存在关系,
        编码映射.需求目标宿主关系,
        编码映射.需求目标特征关系,
        编码映射.需求目标合同关系};

    结果.当前成员关系 = L2需求列表成员关系事实{
        编码映射.列表成员关系, 列表项身份, 需求身份,
        {写入代次, std::nullopt}};
    结果.当前父关系 = std::move(当前父关系);
    return 结果;
}

// 诊断责任：无适用错误分支；从写入结果映射中提取加入场景的编码映射。
struct 需求加入编码映射 final {
    稳定编码 需求节点;
    稳定编码 需求族归属关系;
    稳定编码 需求所属存在关系;
    稳定编码 需求目标宿主关系;
    稳定编码 需求目标特征关系;
    稳定编码 需求目标合同关系;
    稳定编码 列表成员关系;
    稳定编码 父子关系;
    稳定编码 任务子目标来源关系;
};

std::optional<需求加入编码映射> 查找需求加入编码映射(
    const L1所有者范围写入结果& 写入,
    bool 含父子关系, bool 含任务子目标来源 = false) noexcept {
    const auto 期望数 = (含父子关系 ? std::size_t(8) : std::size_t(7))
        + (含任务子目标来源 ? std::size_t(1) : std::size_t(0));
    if (写入.新编码映射.size() != 期望数) return std::nullopt;
    需求加入编码映射 映射;
    std::size_t 已找到 = 0;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) return std::nullopt;
        if (本地键.值 == 需求节点写入本地键值) {
            映射.需求节点 = 编码; ++已找到;
        } else if (本地键.值 == 需求族归属关系写入本地键值) {
            映射.需求族归属关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求所属存在关系写入本地键值) {
            映射.需求所属存在关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求目标宿主关系写入本地键值) {
            映射.需求目标宿主关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求目标特征关系写入本地键值) {
            映射.需求目标特征关系 = 编码; ++已找到;
        } else if (本地键.值 == 需求目标合同关系写入本地键值) {
            映射.需求目标合同关系 = 编码; ++已找到;
        } else if (本地键.值 == 列表成员关系写入本地键值) {
            映射.列表成员关系 = 编码; ++已找到;
        } else if (含父子关系
            && 本地键.值 == 父子关系写入本地键值) {
            映射.父子关系 = 编码; ++已找到;
        } else if (含任务子目标来源
            && 本地键.值 == 任务子目标来源关系写入本地键值) {
            映射.任务子目标来源关系 = 编码; ++已找到;
        } else return std::nullopt;
    }
    if (已找到 != 期望数) return std::nullopt;
    return 映射;
}

// 诊断责任：向上送出；提交加入场景写集并验证编码映射。
需求写入提交读回结果 提交并验证加入写集(
    L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集, bool 含父子关系,
    bool 含任务子目标来源 = false) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    需求写入提交读回结果 结果;
    结果.状态 = 映射需求写入状态(写入.状态);
    结果.事实截止代次 = 写入.事实代次;
    结果.是否形成内存权威发布 = 写入.是否形成内存权威发布;

    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 写入端口.所有者身份()
        || 写入.写入幂等身份 != 写集.写入幂等身份) {
        结果.状态 = L2结构状态::内部不一致;
        return 结果;
    }
    if (结果.状态 != L2结构状态::已提交
        && 结果.状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布) {
            结果.状态 = L2结构状态::内部不一致;
            return 结果;
        }
        return 结果;
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)) {
        结果.状态 = L2结构状态::内部不一致;
        return 结果;
    }
    const auto 加入映射 = 查找需求加入编码映射(
        写入, 含父子关系, 含任务子目标来源);
    if (!加入映射) {
        结果.状态 = L2结构状态::内部不一致;
        return 结果;
    }
    结果.编码映射.需求节点 = 加入映射->需求节点;
    结果.编码映射.需求族归属关系 = 加入映射->需求族归属关系;
    结果.编码映射.需求所属存在关系 = 加入映射->需求所属存在关系;
    结果.编码映射.需求目标宿主关系 = 加入映射->需求目标宿主关系;
    结果.编码映射.需求目标特征关系 = 加入映射->需求目标特征关系;
    结果.编码映射.需求目标合同关系 = 加入映射->需求目标合同关系;
    结果.编码映射.列表成员关系 = 加入映射->列表成员关系;
    结果.编码映射.父子关系 = 加入映射->父子关系;
    结果.编码映射.任务子目标来源关系 =
        加入映射->任务子目标来源关系;
    return 结果;
}

// 诊断责任：向上送出；读回加入场景的所有新建事实并构造结果。
L2新增需求并加入既有列表项结果 读回新增需求并加入既有列表项(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2新增需求并加入既有列表项请求& 请求,
    const L2需求列表项事实& 列表项事实,
    const 需求写入编码映射& 编码映射,
    std::uint64_t 写入代次) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        L2新增需求并加入既有列表项结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 写入代次;
        结果.结果头.变更事实代次 = 写入代次;
        return 结果;
    };

    const auto 需求身份 = L2需求身份{编码映射.需求节点};

    // 读回需求节点
    const auto 需求节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码映射.需求节点});
    const auto* 需求节点 = 需求节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*需求节点读取.事实)
        : nullptr;
    if (需求节点读取.状态 != L1所有者范围读取状态::成功
        || !需求节点
        || 需求节点->编码 != 编码映射.需求节点
        || 需求节点->写入所有者 != 来源定位.所有者
        || 需求节点->种类 != 节点种类::普通
        || 需求节点->属性类型表示
        || 需求节点->退出事实代次
        || 需求节点->创建事实代次 != 写入代次)
        return 失败(L2结构状态::内部不一致);

    // 读回所有关系
    const auto 读回关系 = [&](稳定编码 编码)
        -> std::optional<L1所有者范围关系事实> {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实)
            : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功 || !关系
            || 关系->编码 != 编码
            || 关系->写入所有者 != 来源定位.所有者
            || 关系->退出事实代次
            || 关系->创建事实代次 != 写入代次)
            return std::nullopt;
        return *关系;
    };

    const auto 需求族归属 = 读回关系(编码映射.需求族归属关系);
    const auto 需求所属存在 = 读回关系(编码映射.需求所属存在关系);
    const auto 需求目标宿主 = 读回关系(编码映射.需求目标宿主关系);
    const auto 需求目标特征 = 读回关系(编码映射.需求目标特征关系);
    const auto 需求目标合同 = 读回关系(编码映射.需求目标合同关系);
    const auto 列表成员 = 读回关系(编码映射.列表成员关系);
    if (!需求族归属 || !需求所属存在 || !需求目标宿主
        || !需求目标特征 || !需求目标合同 || !列表成员)
        return 失败(L2结构状态::内部不一致);

    // 验证族归属
    if (需求族归属->源节点 != 编码映射.需求节点
        || 需求族归属->目标节点 != 来源定位.需求锚点
        || 需求族归属->关系类型节点 != 来源定位.需求类型
        || 需求族归属->角色或顺序 != 1)
        return 失败(L2结构状态::内部不一致);

    // 验证目标关系(目标四元组与列表项一致)
    if (需求所属存在->源节点 != 编码映射.需求节点
        || 需求所属存在->目标节点 != 列表项事实.所属存在.值
        || 需求所属存在->关系类型节点
            != 类型定位.需求所属存在关系类型)
        return 失败(L2结构状态::内部不一致);
    if (需求目标宿主->源节点 != 编码映射.需求节点
        || 需求目标宿主->目标节点 != 列表项事实.目标宿主存在.值
        || 需求目标宿主->关系类型节点
            != 类型定位.需求目标宿主关系类型)
        return 失败(L2结构状态::内部不一致);
    if (需求目标特征->源节点 != 编码映射.需求节点
        || 需求目标特征->目标节点 != 列表项事实.目标特征定义.值
        || 需求目标特征->关系类型节点
            != 类型定位.需求目标特征关系类型)
        return 失败(L2结构状态::内部不一致);
    if (需求目标合同->源节点 != 编码映射.需求节点
        || 需求目标合同->目标节点 != 列表项事实.目标状态合同.值
        || 需求目标合同->关系类型节点
            != 类型定位.需求目标合同关系类型)
        return 失败(L2结构状态::内部不一致);

    // 验证列表成员关系(列表项 -> 需求)
    if (列表成员->源节点 != 请求.既有列表项.值
        || 列表成员->目标节点 != 编码映射.需求节点
        || 列表成员->关系类型节点
            != 类型定位.需求列表成员关系类型
        || 列表成员->角色或顺序 != 1)
        return 失败(L2结构状态::内部不一致);

    // 可选父子关系
    std::optional<L2需求父子关系事实> 当前父关系;
    if (请求.父需求) {
        const auto 父子关系 = 读回关系(编码映射.父子关系);
        if (!父子关系
            || 父子关系->源节点 != 请求.父需求->值
            || 父子关系->目标节点 != 编码映射.需求节点
            || 父子关系->关系类型节点
                != 类型定位.需求父子关系类型
            || 父子关系->角色或顺序
                != static_cast<std::int64_t>(请求.父子顺序))
            return 失败(L2结构状态::内部不一致);
        当前父关系 = L2需求父子关系事实{
            编码映射.父子关系, *请求.父需求, 需求身份,
            请求.父子顺序, {写入代次, std::nullopt}};
    }

    L2新增需求并加入既有列表项结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已提交;
    结果.结果头.事实截止代次 = 写入代次;
    结果.结果头.变更事实代次 = 写入代次;

    结果.新建需求 = 形成L2需求事实(*需求节点,
        需求身份, 列表项事实.所属存在,
        列表项事实.目标宿主存在, 列表项事实.目标特征定义,
        列表项事实.目标状态合同, 写入代次);
    结果.需求自有关系 = L2需求自有关系引用{
        编码映射.需求族归属关系,
        编码映射.需求所属存在关系,
        编码映射.需求目标宿主关系,
        编码映射.需求目标特征关系,
        编码映射.需求目标合同关系};
    结果.当前成员关系 = L2需求列表成员关系事实{
        编码映射.列表成员关系, 请求.既有列表项, 需求身份,
        {写入代次, std::nullopt}};
    结果.当前父关系 = std::move(当前父关系);
    return 结果;
}

// 诊断责任：向上送出；读回替换父需求的旧/新父子关系并构造结果。
L2替换父需求结果 读回替换父需求(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2替换父需求请求& 请求,
    稳定编码 新父关系编码,
    std::uint64_t 写入代次) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        L2替换父需求结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 写入代次;
        结果.结果头.变更事实代次 = 写入代次;
        return 结果;
    };
    (void)类型定位;

    // 读回旧父关系(应已退出)
    const auto 旧关系读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.旧关系稳定编码});
    const auto* 旧关系 = 旧关系读取.事实
        ? std::get_if<L1所有者范围关系事实>(&*旧关系读取.事实)
        : nullptr;
    if (旧关系读取.状态 != L1所有者范围读取状态::成功 || !旧关系
        || 旧关系->编码 != 请求.旧关系稳定编码
        || 旧关系->写入所有者 != 来源定位.所有者
        || !旧关系->退出事实代次
        || 旧关系->退出事实代次 != 写入代次)
        return 失败(L2结构状态::内部不一致);

    L2替换父需求结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已提交;
    结果.结果头.事实截止代次 = 写入代次;
    结果.结果头.变更事实代次 = 写入代次;

    结果.已退出父关系 = L2需求父子关系事实{
        请求.旧关系稳定编码, 请求.旧父需求, 请求.子需求,
        请求.旧顺序,
        {旧关系->创建事实代次, 旧关系->退出事实代次}};

    // 新父关系非空时读回
    if (请求.新父需求) {
        const auto 新关系读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 新父关系编码});
        const auto* 新关系 = 新关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*新关系读取.事实)
            : nullptr;
        if (新关系读取.状态 != L1所有者范围读取状态::成功 || !新关系
            || 新关系->编码 != 新父关系编码
            || 新关系->写入所有者 != 来源定位.所有者
            || 新关系->退出事实代次
            || 新关系->源节点 != 请求.新父需求->值
            || 新关系->目标节点 != 请求.子需求.值
            || 新关系->关系类型节点
                != 类型定位.需求父子关系类型
            || 新关系->角色或顺序
                != static_cast<std::int64_t>(请求.新顺序)
            || 新关系->创建事实代次 != 写入代次)
            return 失败(L2结构状态::内部不一致);
        结果.当前父关系 = L2需求父子关系事实{
            新父关系编码, *请求.新父需求, 请求.子需求,
            请求.新顺序, {写入代次, std::nullopt}};
    }
    return 结果;
}

// 诊断责任：向上送出；读回退出需求的所有已退出事实并构造结果。
L2需求退出结果 读回退出需求(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求退出请求& 请求,
    std::uint64_t 写入代次) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        L2需求退出结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 写入代次;
        结果.结果头.变更事实代次 = 写入代次;
        return 结果;
    };
    (void)类型定位;

    // 读回需求节点(应已退出)
    const auto 节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.需求.值});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实)
        : nullptr;
    if (节点读取.状态 != L1所有者范围读取状态::成功 || !节点
        || 节点->编码 != 请求.需求.值
        || 节点->写入所有者 != 来源定位.所有者
        || !节点->退出事实代次
        || 节点->退出事实代次 != 写入代次)
        return 失败(L2结构状态::内部不一致);

    // 读回所有已退出关系
    const auto 读回退出关系 = [&](稳定编码 编码)
        -> std::optional<L1所有者范围关系事实> {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实)
            : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功 || !关系
            || 关系->编码 != 编码
            || 关系->写入所有者 != 来源定位.所有者
            || !关系->退出事实代次
            || 关系->退出事实代次 != 写入代次)
            return std::nullopt;
        return *关系;
    };

    const auto 形成退出事实 = [&](稳定编码 编码) ->
        L2需求关系退出事实 {
        const auto 关系 = 读回退出关系(编码);
        return {编码, {关系->创建事实代次, 关系->退出事实代次}};
    };

    const auto 族归属 = 读回退出关系(
        请求.自有事实闭包.自有关系.族归属关系稳定编码);
    const auto 所属存在 = 读回退出关系(
        请求.自有事实闭包.自有关系.所属存在关系稳定编码);
    const auto 目标宿主 = 读回退出关系(
        请求.自有事实闭包.自有关系.目标宿主关系稳定编码);
    const auto 目标特征 = 读回退出关系(
        请求.自有事实闭包.自有关系.目标特征关系稳定编码);
    const auto 目标合同 = 读回退出关系(
        请求.自有事实闭包.自有关系.目标合同关系稳定编码);
    const auto 列表成员 = 读回退出关系(
        请求.自有事实闭包.当前列表成员关系稳定编码);
    if (!族归属 || !所属存在 || !目标宿主
        || !目标特征 || !目标合同 || !列表成员)
        return 失败(L2结构状态::内部不一致);

    L2需求退出结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已提交;
    结果.结果头.事实截止代次 = 写入代次;
    结果.结果头.变更事实代次 = 写入代次;

    结果.已退出需求 = L2需求事实{
        请求.需求,
        L2存在身份{所属存在->目标节点},
        L2存在身份{目标宿主->目标节点},
        L2特征定义身份{目标特征->目标节点},
        L2目标状态合同身份{目标合同->目标节点},
        {节点->创建事实代次, 节点->退出事实代次},
        std::nullopt, std::nullopt, std::nullopt,
        std::nullopt};

    结果.已退出自有关系 = L2需求自有关系退出投影{
        形成退出事实(请求.自有事实闭包.自有关系.族归属关系稳定编码),
        形成退出事实(请求.自有事实闭包.自有关系.所属存在关系稳定编码),
        形成退出事实(请求.自有事实闭包.自有关系.目标宿主关系稳定编码),
        形成退出事实(请求.自有事实闭包.自有关系.目标特征关系稳定编码),
        形成退出事实(请求.自有事实闭包.自有关系.目标合同关系稳定编码)};

    结果.已退出列表成员关系 = L2需求列表成员关系事实{
        请求.自有事实闭包.当前列表成员关系稳定编码,
        L2需求列表项身份{列表成员->源节点}, 请求.需求,
        {列表成员->创建事实代次, 列表成员->退出事实代次}};

    if (请求.自有事实闭包.当前父关系稳定编码) {
        const auto 父子关系 = 读回退出关系(
            *请求.自有事实闭包.当前父关系稳定编码);
        if (!父子关系) return 失败(L2结构状态::内部不一致);
        结果.已退出父关系 = L2需求父子关系事实{
            *请求.自有事实闭包.当前父关系稳定编码,
            L2需求身份{父子关系->源节点}, 请求.需求,
            static_cast<std::uint64_t>(父子关系->角色或顺序),
            {父子关系->创建事实代次, 父子关系->退出事实代次}};
    }
    return 结果;
}

// ===== 精确目标查询：投影扫描 =====

// 诊断责任：无适用错误分支；精确目标查询顶层成功或失败形状检查。
// 成功时目标关系组允许非空（4 个查询项）；失败时七组全空。
需求身份来源预检结果 解释精确查询一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取,
    std::uint64_t 期望代次,
    std::size_t 期望目标关系组数) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次
            && 读取.读取事实代次 != 0
            && 读取.目标关系组.size() == 期望目标关系组数
            && 读取.节点.empty()
            && 读取.关系.empty() && 读取.值.empty()
            && 读取.属性值.empty() && 读取.源关系组.empty())
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.节点.empty()
        && 读取.关系.empty() && 读取.值.empty()
        && 读取.属性值.empty() && 读取.源关系组.empty()
        && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态
        == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移,
            读取.读取事实代次, true};
    return {映射身份来源一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；从目标关系组项提取当前有效的源节点编码集合。
std::vector<稳定编码> 提取目标关系组当前源节点(
    const L1所有者范围一致目标关系组读取结果项& 组) noexcept {
    std::vector<稳定编码> 源节点;
    for (const auto& 成员 : 组.成员) {
        if (!成员.关系.退出事实代次
            && !成员.对端节点.退出事实代次)
            源节点.push_back(成员.关系.源节点);
    }
    return 源节点;
}

// 诊断责任：无适用错误分支；求多个源节点集合的交集。
std::vector<稳定编码> 求源节点交集(
    std::vector<std::vector<稳定编码>> 集合组) noexcept {
    if (集合组.empty()) return {};
    auto 结果 = std::move(集合组.front());
    for (std::size_t i = 1; i < 集合组.size() && !结果.empty(); ++i) {
        std::vector<稳定编码> 临时;
        for (const auto& 编码 : 结果) {
            if (std::find(集合组[i].begin(), 集合组[i].end(), 编码)
                != 集合组[i].end())
                临时.push_back(编码);
        }
        结果 = std::move(临时);
    }
    return 结果;
}

// 诊断责任：无适用错误分支；按精确目标在目标关系组项中查找对应项。
const L1所有者范围一致目标关系组读取结果项* 查找精确目标关系组项(
    const L1所有者范围一致当前读取结果& 读取,
    稳定编码 目标节点, 稳定编码 关系类型) noexcept {
    for (const auto& 项 : 读取.目标关系组) {
        if (项.目标节点 == 目标节点
            && 项.关系类型节点 == 关系类型)
            return &项;
    }
    return nullptr;
}

// 诊断责任：向上送出；精确源查询顶层成功或失败形状检查。
// 成功时源关系组数等于期望；失败时七组全空。
需求身份来源预检结果 解释精确源查询一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取,
    std::uint64_t 期望代次,
    std::size_t 期望源关系组数) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次
            && 读取.读取事实代次 != 0
            && 读取.源关系组.size() == 期望源关系组数
            && 读取.节点.empty()
            && 读取.关系.empty() && 读取.值.empty()
            && 读取.属性值.empty() && 读取.目标关系组.empty())
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.节点.empty()
        && 读取.关系.empty() && 读取.值.empty()
        && 读取.属性值.empty() && 读取.源关系组.empty()
        && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态
        == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移,
            读取.读取事实代次, true};
    return {映射身份来源一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；按精确源在源关系组项中查找对应项。
const L1所有者范围一致源关系组读取结果项* 查找精确源关系组项(
    const L1所有者范围一致当前读取结果& 读取,
    稳定编码 源节点, 稳定编码 关系类型) noexcept {
    for (const auto& 项 : 读取.源关系组) {
        if (项.源节点 == 源节点
            && 项.关系类型节点 == 关系类型)
            return &项;
    }
    return nullptr;
}

// 诊断责任：向上送出；一次 owner-aware 一致投影扫描精确目标列表项。
// 查询 4 个目标关系组（所属存在、目标宿主、目标特征、目标合同），
// 求源节点交集：0 项空结果、1 项唯一结果、>1 项内部不一致。
L2按精确目标查询列表项结果 按精确目标查询需求列表项当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2按精确目标查询列表项请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2按精确目标查询列表项结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 截止;
        return 结果;
    };

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.目标关系组 = {
        {请求.所属存在.值, 类型定位.列表项所属存在关系类型},
        {请求.目标宿主存在.值, 类型定位.列表项目标宿主关系类型},
        {请求.目标特征定义.值, 类型定位.列表项目标特征关系类型},
        {请求.目标状态合同.值, 类型定位.列表项目标合同关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释精确查询一致读取顶层(
        读取, 期望代次, L1请求.目标关系组.size());
    if (!顶层.成功())
        return 失败(顶层.状态, 顶层.事实截止代次);

    // 提取 4 个目标关系组的当前源节点集合
    const auto 提取 = [&](稳定编码 目标节点,
        稳定编码 关系类型) -> std::vector<稳定编码> {
        const auto* 项 = 查找精确目标关系组项(
            读取, 目标节点, 关系类型);
        if (!项) return {稳定编码{}};
        return 提取目标关系组当前源节点(*项);
    };

    auto 集合1 = 提取(请求.所属存在.值,
        类型定位.列表项所属存在关系类型);
    auto 集合2 = 提取(请求.目标宿主存在.值,
        类型定位.列表项目标宿主关系类型);
    auto 集合3 = 提取(请求.目标特征定义.值,
        类型定位.列表项目标特征关系类型);
    auto 集合4 = 提取(请求.目标状态合同.值,
        类型定位.列表项目标合同关系类型);

    // 任一目标关系组项缺失视为内部不一致
    if (集合1.empty() && 集合2.empty()
        && 集合3.empty() && 集合4.empty()) {
        // 4 个目标都没有当前关系：合法空结果
    }
    // 4 个集合的交集
    auto 交集 = 求源节点交集(
        {std::move(集合1), std::move(集合2),
         std::move(集合3), std::move(集合4)});

    L2按精确目标查询列表项结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已读取;
    结果.结果头.事实截止代次 = 顶层.事实截止代次;

    if (交集.empty()) return 结果;  // 0 项：合法空结果

    if (交集.size() > 1) {
        // >1 项：内部不一致
        结果.结果头.状态 = L2结构状态::内部不一致;
        return 结果;
    }

    // 1 项：构造 L2需求列表项事实
    // 从交集唯一编码对应的对端节点提取生命周期
    const auto* 唯一列表项编码 = &交集.front();
    std::optional<L2生命周期> 生命周期;
    for (const auto& 项 : 读取.目标关系组) {
        for (const auto& 成员 : 项.成员) {
            if (成员.关系.源节点 == *唯一列表项编码
                && !成员.关系.退出事实代次
                && !成员.对端节点.退出事实代次) {
                生命周期 = L2生命周期{
                    成员.对端节点.创建事实代次,
                    成员.对端节点.退出事实代次};
                break;
            }
        }
        if (生命周期) break;
    }
    if (!生命周期) {
        结果.结果头.状态 = L2结构状态::内部不一致;
        return 结果;
    }

    L2需求列表项事实 列表项事实;
    列表项事实.身份 = L2需求列表项身份{*唯一列表项编码};
    列表项事实.所属存在 = 请求.所属存在;
    列表项事实.目标宿主存在 = 请求.目标宿主存在;
    列表项事实.目标特征定义 = 请求.目标特征定义;
    列表项事实.目标状态合同 = 请求.目标状态合同;
    列表项事实.生命周期 = *生命周期;
    结果.列表项组.push_back(std::move(列表项事实));
    return 结果;
}

// ===== 完整读取：投影解释 =====

// 诊断责任：向上送出；一次 owner-aware 一致投影读取需求完整事实。
// 读取需求节点 + 4 个目标关系组（所属存在、目标宿主、目标特征、目标合同）+ 族锚点/族类型。
L2需求完整读取结果 读取需求完整当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求完整读取请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2需求完整读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 截止;
        结果.读取类别 = 请求.读取类别;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        return 结果;
    };

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.节点 = {请求.需求.值, 来源定位.需求锚点, 来源定位.需求类型};
    L1请求.源关系组 = {
        {请求.需求.值, 来源定位.需求类型},
        {请求.需求.值, 类型定位.需求所属存在关系类型},
        {请求.需求.值, 类型定位.需求目标宿主关系类型},
        {请求.需求.值, 类型定位.需求目标特征关系类型},
        {请求.需求.值, 类型定位.需求目标合同关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释身份来源一致读取顶层(读取, 期望代次);
    if (!顶层.成功())
        return 失败(顶层.状态, 顶层.事实截止代次);

    // 预期形状：1 所有者、3 节点、0 关系、0 值、5 源关系组、0 目标关系组
    if (读取.所有者.size() != 1 || 读取.节点.size() != 3
        || !读取.关系.empty() || !读取.值.empty()
        || 读取.源关系组.size() != 5
        || !读取.目标关系组.empty())
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    const auto* 节点项 = 查找唯一需求节点项(读取, 请求.需求.值);
    const auto* 锚点项 = 查找唯一需求节点项(读取, 来源定位.需求锚点);
    const auto* 类型项 = 查找唯一需求节点项(读取, 来源定位.需求类型);
    const auto* 族归属组项 = 查找唯一需求来源关系组(
        读取, 请求.需求.值, 来源定位.需求类型);
    const auto* 所属存在组项 = 查找唯一需求来源关系组(
        读取, 请求.需求.值, 类型定位.需求所属存在关系类型);
    const auto* 目标宿主组项 = 查找唯一需求来源关系组(
        读取, 请求.需求.值, 类型定位.需求目标宿主关系类型);
    const auto* 目标特征组项 = 查找唯一需求来源关系组(
        读取, 请求.需求.值, 类型定位.需求目标特征关系类型);
    const auto* 目标合同组项 = 查找唯一需求来源关系组(
        读取, 请求.需求.值, 类型定位.需求目标合同关系类型);
    if (!节点项 || !锚点项 || !类型项 || !族归属组项
        || !所属存在组项 || !目标宿主组项
        || !目标特征组项 || !目标合同组项)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    // 需求节点
    if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功 || !节点项->事实)
        return 失败(映射身份来源当前项目状态(节点项->状态),
            顶层.事实截止代次);
    const auto& 节点 = *节点项->事实;
    if (节点.写入所有者 != 来源定位.所有者
        || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.退出事实代次)
        return 失败(L2结构状态::入口拒绝, 顶层.事实截止代次);

    // 族锚点/类型节点完整性
    if (锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !锚点项->事实
        || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !类型项->事实)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    const auto 内部节点完整 = [&](
        const L1所有者范围节点事实& 内部节点) noexcept {
        return 内部节点.写入所有者 == 来源定位.所有者
            && 内部节点.种类 == 节点种类::普通
            && !内部节点.属性类型表示 && !内部节点.退出事实代次
            && 内部节点.当前属性.empty();
    };
    if (!内部节点完整(锚点) || !内部节点完整(类型)
        || 锚点.编码 != 来源定位.需求锚点
        || 类型.编码 != 来源定位.需求类型
        || 锚点.创建事实代次 != 来源定位.建立事实代次
        || 类型.创建事实代次 != 来源定位.建立事实代次)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    // 4 个源关系组：每个恰有一条当前关系
    const auto 提取当前关系 = [&](
        const L1所有者范围一致源关系组读取结果项* 组,
        稳定编码 关系类型) -> const L1所有者范围关系事实* {
        if (!组 || 组->成员.size() != 1) return nullptr;
        const auto& 关系 = 组->成员.front().关系;
        if (关系.退出事实代次
            || 关系.关系类型节点 != 关系类型
            || 关系.源节点 != 请求.需求.值)
            return nullptr;
        return &关系;
    };

    const auto* 所属存在关系 = 提取当前关系(
        所属存在组项, 类型定位.需求所属存在关系类型);
    const auto* 目标宿主关系 = 提取当前关系(
        目标宿主组项, 类型定位.需求目标宿主关系类型);
    const auto* 目标特征关系 = 提取当前关系(
        目标特征组项, 类型定位.需求目标特征关系类型);
    const auto* 目标合同关系 = 提取当前关系(
        目标合同组项, 类型定位.需求目标合同关系类型);
    if (!所属存在关系 || !目标宿主关系
        || !目标特征关系 || !目标合同关系)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    // 构造 L2需求事实
    L2需求完整读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已读取;
    结果.结果头.事实截止代次 = 顶层.事实截止代次;
    结果.读取类别 = 请求.读取类别;
    结果.历史截止事实代次 = 请求.历史截止事实代次;

    L2需求事实 需求事实;
    需求事实.身份 = 请求.需求;
    需求事实.所属存在 = L2存在身份{所属存在关系->目标节点};
    需求事实.目标宿主存在 = L2存在身份{目标宿主关系->目标节点};
    需求事实.目标特征定义 = L2特征定义身份{目标特征关系->目标节点};
    需求事实.目标状态合同 = L2目标状态合同身份{目标合同关系->目标节点};
    需求事实.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    需求事实.当前所属存在关系 = L2需求所属存在关系事实{
        所属存在关系->编码, 请求.需求,
        需求事实.所属存在,
        {所属存在关系->创建事实代次, 所属存在关系->退出事实代次}};
    需求事实.当前目标宿主关系 = L2需求目标宿主关系事实{
        目标宿主关系->编码, 请求.需求,
        需求事实.目标宿主存在,
        {目标宿主关系->创建事实代次, 目标宿主关系->退出事实代次}};
    需求事实.当前目标特征关系 = L2需求目标特征关系事实{
        目标特征关系->编码, 请求.需求,
        需求事实.目标特征定义,
        {目标特征关系->创建事实代次, 目标特征关系->退出事实代次}};
    需求事实.当前目标合同关系 = L2需求目标合同关系事实{
        目标合同关系->编码, 请求.需求,
        需求事实.目标状态合同,
        {目标合同关系->创建事实代次, 目标合同关系->退出事实代次}};
    结果.需求 = std::move(需求事实);

    // 族归属关系作为自有关系引用
    if (族归属组项->成员.size() != 1
        || 族归属组项->成员.front().关系.退出事实代次)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
    const auto& 族归属关系 = 族归属组项->成员.front().关系;
    L2需求自有关系引用 自有关系;
    自有关系.族归属关系稳定编码 = 族归属关系.编码;
    自有关系.所属存在关系稳定编码 = 所属存在关系->编码;
    自有关系.目标宿主关系稳定编码 = 目标宿主关系->编码;
    自有关系.目标特征关系稳定编码 = 目标特征关系->编码;
    自有关系.目标合同关系稳定编码 = 目标合同关系->编码;
    结果.自有关系 = std::move(自有关系);

    // ===== 问题7：反向检查"需求→当前列表项"唯一性（规范 10.3） =====
    // 该需求当前只能属于一个列表项。读取其目标关系组（目标=需求，关系类型=列表成员关系类型），
    // 当前有效关系条数 > 1 时返回内部不一致。
    {
        L1所有者范围一致当前读取请求 反向请求;
        反向请求.合同版本 = L1所有者范围一致当前读取合同版本;
        反向请求.期望事实代次 = 期望代次;
        反向请求.所有者 = {来源定位.所有者};
        反向请求.目标关系组 = {{请求.需求.值,
            类型定位.需求列表成员关系类型}};
        const auto 反向读取 = 第一层服务.尝试读取所有者范围一致当前投影(反向请求);

        const auto 反向顶层 = 解释精确查询一致读取顶层(
            反向读取, 期望代次, 反向请求.目标关系组.size());
        if (!反向顶层.成功())
            return 失败(反向顶层.状态, 反向顶层.事实截止代次);

        const auto* 反向组 = 查找唯一需求目标关系组(
            反向读取, 请求.需求.值,
            类型定位.需求列表成员关系类型);
        if (!反向组)
            return 失败(L2结构状态::内部不一致, 反向顶层.事实截止代次);

        std::size_t 当前有效数 = 0;
        for (const auto& 反向成员 : 反向组->成员) {
            if (!反向成员.关系.退出事实代次)
                ++当前有效数;
        }
        // 规范约束：一个需求当前只能属于一个列表项（0 或 1 条当前有效关系）
        if (当前有效数 > 1)
            return 失败(L2结构状态::内部不一致, 反向顶层.事实截止代次);
    }
    return 结果;
}

// 诊断责任：向上送出；一次 owner-aware 一致投影读取列表项完整事实。
L2需求列表项完整读取结果 读取需求列表项完整当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求列表项完整读取请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2需求列表项完整读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 截止;
        结果.读取类别 = 请求.读取类别;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        return 结果;
    };

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.节点 = {请求.列表项.值, 来源定位.列表项锚点, 来源定位.列表项类型};
    L1请求.源关系组 = {
        {请求.列表项.值, 来源定位.列表项类型},
        {请求.列表项.值, 类型定位.列表项所属存在关系类型},
        {请求.列表项.值, 类型定位.列表项目标宿主关系类型},
        {请求.列表项.值, 类型定位.列表项目标特征关系类型},
        {请求.列表项.值, 类型定位.列表项目标合同关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释身份来源一致读取顶层(读取, 期望代次);
    if (!顶层.成功())
        return 失败(顶层.状态, 顶层.事实截止代次);

    if (读取.所有者.size() != 1 || 读取.节点.size() != 3
        || !读取.关系.empty() || !读取.值.empty()
        || 读取.源关系组.size() != 5
        || !读取.目标关系组.empty())
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    const auto* 节点项 = 查找唯一需求节点项(读取, 请求.列表项.值);
    const auto* 锚点项 = 查找唯一需求节点项(读取, 来源定位.列表项锚点);
    const auto* 类型项 = 查找唯一需求节点项(读取, 来源定位.列表项类型);
    const auto* 族归属组项 = 查找唯一需求来源关系组(
        读取, 请求.列表项.值, 来源定位.列表项类型);
    const auto* 所属存在组项 = 查找唯一需求来源关系组(
        读取, 请求.列表项.值, 类型定位.列表项所属存在关系类型);
    const auto* 目标宿主组项 = 查找唯一需求来源关系组(
        读取, 请求.列表项.值, 类型定位.列表项目标宿主关系类型);
    const auto* 目标特征组项 = 查找唯一需求来源关系组(
        读取, 请求.列表项.值, 类型定位.列表项目标特征关系类型);
    const auto* 目标合同组项 = 查找唯一需求来源关系组(
        读取, 请求.列表项.值, 类型定位.列表项目标合同关系类型);
    if (!节点项 || !锚点项 || !类型项 || !族归属组项
        || !所属存在组项 || !目标宿主组项
        || !目标特征组项 || !目标合同组项)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功 || !节点项->事实)
        return 失败(映射身份来源当前项目状态(节点项->状态),
            顶层.事实截止代次);
    const auto& 节点 = *节点项->事实;
    if (节点.写入所有者 != 来源定位.所有者
        || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.退出事实代次)
        return 失败(L2结构状态::入口拒绝, 顶层.事实截止代次);

    if (锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !锚点项->事实
        || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !类型项->事实)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    const auto 内部节点完整 = [&](
        const L1所有者范围节点事实& 内部节点) noexcept {
        return 内部节点.写入所有者 == 来源定位.所有者
            && 内部节点.种类 == 节点种类::普通
            && !内部节点.属性类型表示 && !内部节点.退出事实代次
            && 内部节点.当前属性.empty();
    };
    if (!内部节点完整(锚点) || !内部节点完整(类型)
        || 锚点.编码 != 来源定位.列表项锚点
        || 类型.编码 != 来源定位.列表项类型
        || 锚点.创建事实代次 != 来源定位.建立事实代次
        || 类型.创建事实代次 != 来源定位.建立事实代次)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    const auto 提取当前关系 = [&](
        const L1所有者范围一致源关系组读取结果项* 组,
        稳定编码 关系类型) -> const L1所有者范围关系事实* {
        if (!组 || 组->成员.size() != 1) return nullptr;
        const auto& 关系 = 组->成员.front().关系;
        if (关系.退出事实代次
            || 关系.关系类型节点 != 关系类型
            || 关系.源节点 != 请求.列表项.值)
            return nullptr;
        return &关系;
    };

    const auto* 所属存在关系 = 提取当前关系(
        所属存在组项, 类型定位.列表项所属存在关系类型);
    const auto* 目标宿主关系 = 提取当前关系(
        目标宿主组项, 类型定位.列表项目标宿主关系类型);
    const auto* 目标特征关系 = 提取当前关系(
        目标特征组项, 类型定位.列表项目标特征关系类型);
    const auto* 目标合同关系 = 提取当前关系(
        目标合同组项, 类型定位.列表项目标合同关系类型);
    if (!所属存在关系 || !目标宿主关系
        || !目标特征关系 || !目标合同关系)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    if (族归属组项->成员.size() != 1
        || 族归属组项->成员.front().关系.退出事实代次)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
    const auto& 族归属关系 = 族归属组项->成员.front().关系;

    L2需求列表项完整读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已读取;
    结果.结果头.事实截止代次 = 顶层.事实截止代次;
    结果.读取类别 = 请求.读取类别;
    结果.历史截止事实代次 = 请求.历史截止事实代次;

    L2需求列表项事实 列表项事实;
    列表项事实.身份 = 请求.列表项;
    列表项事实.所属存在 = L2存在身份{所属存在关系->目标节点};
    列表项事实.目标宿主存在 = L2存在身份{目标宿主关系->目标节点};
    列表项事实.目标特征定义 = L2特征定义身份{目标特征关系->目标节点};
    列表项事实.目标状态合同 = L2目标状态合同身份{目标合同关系->目标节点};
    列表项事实.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    列表项事实.当前所属存在关系 = L2列表项所属存在关系事实{
        所属存在关系->编码, 请求.列表项,
        列表项事实.所属存在,
        {所属存在关系->创建事实代次, 所属存在关系->退出事实代次}};
    列表项事实.当前目标宿主关系 = L2列表项目标宿主关系事实{
        目标宿主关系->编码, 请求.列表项,
        列表项事实.目标宿主存在,
        {目标宿主关系->创建事实代次, 目标宿主关系->退出事实代次}};
    列表项事实.当前目标特征关系 = L2列表项目标特征关系事实{
        目标特征关系->编码, 请求.列表项,
        列表项事实.目标特征定义,
        {目标特征关系->创建事实代次, 目标特征关系->退出事实代次}};
    列表项事实.当前目标合同关系 = L2列表项目标合同关系事实{
        目标合同关系->编码, 请求.列表项,
        列表项事实.目标状态合同,
        {目标合同关系->创建事实代次, 目标合同关系->退出事实代次}};
    结果.列表项 = std::move(列表项事实);

    L2需求列表项自有关系引用 自有关系;
    自有关系.族归属关系稳定编码 = 族归属关系.编码;
    自有关系.所属存在关系稳定编码 = 所属存在关系->编码;
    自有关系.目标宿主关系稳定编码 = 目标宿主关系->编码;
    自有关系.目标特征关系稳定编码 = 目标特征关系->编码;
    自有关系.目标合同关系稳定编码 = 目标合同关系->编码;
    结果.自有关系 = std::move(自有关系);
    return 结果;
}

// 诊断责任：向上送出；一次 owner-aware 一致投影读取需求目标。
L2需求目标读取结果 读取需求目标当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求目标读取请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2需求目标读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 截止;
        结果.读取类别 = 请求.读取类别;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        return 结果;
    };

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.源关系组 = {
        {请求.需求.值, 类型定位.需求所属存在关系类型},
        {请求.需求.值, 类型定位.需求目标宿主关系类型},
        {请求.需求.值, 类型定位.需求目标特征关系类型},
        {请求.需求.值, 类型定位.需求目标合同关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释精确源查询一致读取顶层(
        读取, 期望代次, L1请求.源关系组.size());
    if (!顶层.成功())
        return 失败(顶层.状态, 顶层.事实截止代次);

    const auto 提取当前目标 = [&](稳定编码 关系类型) ->
        const L1所有者范围关系事实* {
        const auto* 组 = 查找精确源关系组项(
            读取, 请求.需求.值, 关系类型);
        if (!组 || 组->成员.size() != 1) return nullptr;
        const auto& 关系 = 组->成员.front().关系;
        if (关系.退出事实代次) return nullptr;
        return &关系;
    };

    const auto* 所属存在关系 = 提取当前目标(
        类型定位.需求所属存在关系类型);
    const auto* 目标宿主关系 = 提取当前目标(
        类型定位.需求目标宿主关系类型);
    const auto* 目标特征关系 = 提取当前目标(
        类型定位.需求目标特征关系类型);
    const auto* 目标合同关系 = 提取当前目标(
        类型定位.需求目标合同关系类型);
    if (!所属存在关系 || !目标宿主关系
        || !目标特征关系 || !目标合同关系)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    L2需求目标读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已读取;
    结果.结果头.事实截止代次 = 顶层.事实截止代次;
    结果.读取类别 = 请求.读取类别;
    结果.历史截止事实代次 = 请求.历史截止事实代次;
    结果.所属存在 = L2存在身份{所属存在关系->目标节点};
    结果.目标宿主存在 = L2存在身份{目标宿主关系->目标节点};
    结果.目标特征定义 = L2特征定义身份{目标特征关系->目标节点};
    结果.目标状态合同 = L2目标状态合同身份{目标合同关系->目标节点};

    // ===== 问题7：反向检查"需求→当前列表项"唯一性（规范 10.3） =====
    // 该需求当前只能属于一个列表项。读取其目标关系组（目标=需求，关系类型=列表成员关系类型），
    // 当前有效关系条数 > 1 时返回内部不一致。
    {
        L1所有者范围一致当前读取请求 反向请求;
        反向请求.合同版本 = L1所有者范围一致当前读取合同版本;
        反向请求.期望事实代次 = 期望代次;
        反向请求.所有者 = {来源定位.所有者};
        反向请求.目标关系组 = {{请求.需求.值,
            类型定位.需求列表成员关系类型}};
        const auto 反向读取 = 第一层服务.尝试读取所有者范围一致当前投影(反向请求);

        const auto 反向顶层 = 解释精确查询一致读取顶层(
            反向读取, 期望代次, 反向请求.目标关系组.size());
        if (!反向顶层.成功())
            return 失败(反向顶层.状态, 反向顶层.事实截止代次);

        const auto* 反向组 = 查找唯一需求目标关系组(
            反向读取, 请求.需求.值,
            类型定位.需求列表成员关系类型);
        if (!反向组)
            return 失败(L2结构状态::内部不一致, 反向顶层.事实截止代次);

        std::size_t 当前有效数 = 0;
        for (const auto& 反向成员 : 反向组->成员) {
            if (!反向成员.关系.退出事实代次)
                ++当前有效数;
        }
        if (当前有效数 > 1)
            return 失败(L2结构状态::内部不一致, 反向顶层.事实截止代次);
    }
    return 结果;
}

// 诊断责任：向上送出；在调用方已持有服务锁时读取唯一当前父关系。
// 该内部投影不重新取得互斥体，供根组读取和公开父读取共同复用。
L2按子需求读取当前父需求结果 按子需求读取当前父需求当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2按子需求读取当前父需求请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2按子需求读取当前父需求结果 结果;
        结果.结果头 = {L2结构合同版本, 状态, 截止, std::nullopt};
        return 结果;
    };

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.目标关系组 = {{请求.子需求.值,
        类型定位.需求父子关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);
    const auto 顶层 = 解释精确查询一致读取顶层(
        读取, 期望代次, L1请求.目标关系组.size());
    if (!顶层.成功()) return 失败(顶层.状态, 顶层.事实截止代次);
    const auto* 父子组 = 查找唯一需求目标关系组(
        读取, 请求.子需求.值, 类型定位.需求父子关系类型);
    if (!父子组) return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    const L1所有者范围一致关系对端投影* 当前关系 = nullptr;
    for (const auto& 成员 : 父子组->成员) {
        if (成员.关系.退出事实代次) continue;
        if (成员.关系.目标节点 != 请求.子需求.值
            || 成员.关系.关系类型节点 != 类型定位.需求父子关系类型)
            return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
        if (当前关系) return 失败(L2结构状态::内部不一致,
            顶层.事实截止代次);
        当前关系 = &成员;
    }
    L2按子需求读取当前父需求结果 结果;
    结果.结果头 = {L2结构合同版本, L2结构状态::已读取,
        顶层.事实截止代次, std::nullopt};
    if (!当前关系) return 结果;

    L2需求完整读取请求 父请求;
    父请求.请求头 = {L2结构合同版本, 期望代次};
    父请求.读取类别 = L2读取类别::当前;
    父请求.需求 = L2需求身份{当前关系->关系.源节点};
    const auto 父读取 = 读取需求完整当前投影(
        第一层服务, 来源定位, 类型定位, 父请求, 期望代次);
    if (!父读取.成功() || !父读取.需求)
        return 失败(父读取.结果头.状态 == L2结构状态::已读取
            ? L2结构状态::内部不一致 : 父读取.结果头.状态,
            父读取.结果头.事实截止代次);
    结果.当前父关系 = L2需求父子关系事实{
        当前关系->关系.编码, 父请求.需求, 请求.子需求,
        static_cast<std::uint64_t>(当前关系->关系.角色或顺序),
        {当前关系->关系.创建事实代次, 当前关系->关系.退出事实代次}};
    结果.父需求 = *父读取.需求;
    return 结果;
}

// 诊断责任：向上送出；读取指定存在当前根需求组，不把根预算滥用于全候选扫描。
L2按所属存在读取当前根需求组结果 按所属存在读取当前根需求组当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2按所属存在读取当前根需求组请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2按所属存在读取当前根需求组结果 结果;
        结果.结果头 = {L2结构合同版本, 状态, 截止, std::nullopt};
        return 结果;
    };
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.目标关系组 = {{请求.所属存在.值,
        类型定位.需求所属存在关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);
    const auto 顶层 = 解释精确查询一致读取顶层(
        读取, 期望代次, L1请求.目标关系组.size());
    if (!顶层.成功()) return 失败(顶层.状态, 顶层.事实截止代次);
    const auto* 所属组 = 查找唯一需求目标关系组(
        读取, 请求.所属存在.值, 类型定位.需求所属存在关系类型);
    if (!所属组) return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    L2按所属存在读取当前根需求组结果 结果;
    结果.结果头 = {L2结构合同版本, L2结构状态::已读取,
        顶层.事实截止代次, std::nullopt};
    for (const auto& 成员 : 所属组->成员) {
        if (成员.关系.退出事实代次) continue;
        if (成员.关系.目标节点 != 请求.所属存在.值
            || 成员.关系.关系类型节点 != 类型定位.需求所属存在关系类型)
            return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
        L2需求完整读取请求 需求请求;
        需求请求.请求头 = {L2结构合同版本, 期望代次};
        需求请求.读取类别 = L2读取类别::当前;
        需求请求.需求 = L2需求身份{成员.关系.源节点};
        const auto 完整读取 = 读取需求完整当前投影(
            第一层服务, 来源定位, 类型定位, 需求请求, 期望代次);
        if (!完整读取.成功() || !完整读取.需求
            || 完整读取.需求->所属存在 != 请求.所属存在)
            return 失败(完整读取.结果头.状态 == L2结构状态::已读取
                ? L2结构状态::内部不一致 : 完整读取.结果头.状态,
                完整读取.结果头.事实截止代次);
        L2按子需求读取当前父需求请求 父请求;
        父请求.请求头 = {L2结构合同版本, 期望代次};
        父请求.子需求 = 完整读取.需求->身份;
        const auto 父读取 = 按子需求读取当前父需求当前投影(
            第一层服务, 来源定位, 类型定位, 父请求, 期望代次);
        if (!父读取.成功()) return 失败(父读取.结果头.状态,
            父读取.结果头.事实截止代次);
        if (父读取.当前父关系 || 父读取.父需求) continue;
        for (const auto& 已有根 : 结果.根需求组) {
            if (已有根.身份 == 完整读取.需求->身份)
                return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
        }
        结果.根需求组.push_back(*完整读取.需求);
    }
    std::sort(结果.根需求组.begin(), 结果.根需求组.end(),
        [](const L2需求事实& 左, const L2需求事实& 右) noexcept {
            return 左.身份.值 < 右.身份.值;
        });
    if (结果.根需求组.size() > 请求.数量预算)
        return 失败(L2结构状态::数量预算不足, 顶层.事实截止代次);
    return 结果;
}

// 诊断责任：向上送出；一次 owner-aware 一致投影读取直接子需求组。
L2需求直接子读取结果 读取需求直接子当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求直接子读取请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2需求直接子读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 截止;
        结果.读取类别 = 请求.读取类别;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        return 结果;
    };

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.源关系组 = {{请求.父需求.值, 类型定位.需求父子关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释精确源查询一致读取顶层(
        读取, 期望代次, L1请求.源关系组.size());
    if (!顶层.成功())
        return 失败(顶层.状态, 顶层.事实截止代次);

    const auto* 父子组 = 查找唯一需求来源关系组(
        读取, 请求.父需求.值, 类型定位.需求父子关系类型);
    if (!父子组) return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    L2需求直接子读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已读取;
    结果.结果头.事实截止代次 = 顶层.事实截止代次;
    结果.读取类别 = 请求.读取类别;
    结果.历史截止事实代次 = 请求.历史截止事实代次;

    for (const auto& 成员 : 父子组->成员) {
        if (成员.关系.退出事实代次) continue;
        if (成员.关系.源节点 != 请求.父需求.值
            || 成员.关系.关系类型节点
                != 类型定位.需求父子关系类型)
            return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
        L2需求父子关系事实 父子事实;
        父子事实.关系稳定编码 = 成员.关系.编码;
        父子事实.父需求 = 请求.父需求;
        父子事实.子需求 = L2需求身份{成员.关系.目标节点};
        父子事实.顺序 = static_cast<std::uint64_t>(成员.关系.角色或顺序);
        父子事实.生命周期 = {成员.关系.创建事实代次,
            成员.关系.退出事实代次};
        结果.直接子关系组.push_back(std::move(父子事实));

        L2需求事实 子需求事实;
        子需求事实.身份 = L2需求身份{成员.关系.目标节点};
        子需求事实.生命周期 = {成员.对端节点.创建事实代次,
            成员.对端节点.退出事实代次};
        结果.直接子需求组.push_back(std::move(子需求事实));
    }
    return 结果;
}

// 诊断责任：向上送出；一次 owner-aware 一致投影读取列表成员组。
L2需求列表成员读取结果 读取需求列表成员当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求列表成员读取请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2需求列表成员读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 截止;
        结果.读取类别 = 请求.读取类别;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        return 结果;
    };

    // ===== 第一遍：读取列表项的源成员关系组（列表项→需求） =====
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.源关系组 = {{请求.列表项.值, 类型定位.需求列表成员关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释精确源查询一致读取顶层(
        读取, 期望代次, L1请求.源关系组.size());
    if (!顶层.成功())
        return 失败(顶层.状态, 顶层.事实截止代次);

    const auto* 成员组 = 查找唯一需求来源关系组(
        读取, 请求.列表项.值, 类型定位.需求列表成员关系类型);
    if (!成员组) return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    L2需求列表成员读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已读取;
    结果.结果头.事实截止代次 = 顶层.事实截止代次;
    结果.读取类别 = 请求.读取类别;
    结果.历史截止事实代次 = 请求.历史截止事实代次;

    // 收集当前成员需求列表，同时构造第一遍结果
    std::vector<稳定编码> 成员需求编码;
    for (const auto& 成员 : 成员组->成员) {
        if (成员.关系.退出事实代次) continue;
        if (成员.关系.源节点 != 请求.列表项.值
            || 成员.关系.关系类型节点
                != 类型定位.需求列表成员关系类型)
            return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
        L2需求列表成员关系事实 成员事实;
        成员事实.关系稳定编码 = 成员.关系.编码;
        成员事实.列表项 = 请求.列表项;
        成员事实.需求 = L2需求身份{成员.关系.目标节点};
        成员事实.生命周期 = {成员.关系.创建事实代次,
            成员.关系.退出事实代次};
        结果.成员关系组.push_back(std::move(成员事实));

        L2需求事实 需求事实;
        需求事实.身份 = L2需求身份{成员.关系.目标节点};
        需求事实.生命周期 = {成员.对端节点.创建事实代次,
            成员.对端节点.退出事实代次};
        结果.成员需求组.push_back(std::move(需求事实));

        成员需求编码.push_back(成员.关系.目标节点);
    }

    // ===== 第二遍：对每个成员需求，反向检查“需求→当前列表项”唯一性 =====
    // 规范 10.3：一个需求当前只能属于一个列表项。
    // 对每个成员需求，读取其目标关系组（目标=需求，关系类型=列表成员关系类型），
    // 当前有效关系条数 == 1（就是它自己）时 OK；>1 时返回内部不一致。
    if (!成员需求编码.empty()) {
        L1所有者范围一致当前读取请求 反向请求;
        反向请求.合同版本 = L1所有者范围一致当前读取合同版本;
        反向请求.期望事实代次 = 期望代次;
        反向请求.所有者 = {来源定位.所有者};
        反向请求.目标关系组.reserve(成员需求编码.size());
        for (const auto& 需求编码 : 成员需求编码) {
            反向请求.目标关系组.push_back(
                {需求编码, 类型定位.需求列表成员关系类型});
        }
        const auto 反向读取 = 第一层服务.尝试读取所有者范围一致当前投影(反向请求);

        const auto 反向顶层 = 解释精确查询一致读取顶层(
            反向读取, 期望代次, 反向请求.目标关系组.size());
        if (!反向顶层.成功())
            return 失败(反向顶层.状态, 反向顶层.事实截止代次);

        for (std::size_t i = 0; i < 成员需求编码.size(); ++i) {
            const auto& 需求编码 = 成员需求编码[i];
            const auto* 反向组 = 查找唯一需求目标关系组(
                反向读取, 需求编码, 类型定位.需求列表成员关系类型);
            if (!反向组)
                return 失败(L2结构状态::内部不一致, 反向顶层.事实截止代次);

            std::size_t 当前有效数 = 0;
            for (const auto& 反向成员 : 反向组->成员) {
                if (!反向成员.关系.退出事实代次)
                    ++当前有效数;
            }
            // 规范约束：一个需求当前只能属于一个列表项（当前有效条数 == 1）
            if (当前有效数 != 1)
                return 失败(L2结构状态::内部不一致, 反向顶层.事实截止代次);
        }
    }
    return 结果;
}

// 诊断责任：向上送出；一次 owner-aware 一致投影读取需求的所属列表项。
L2需求成员列表读取结果 读取需求成员列表当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求成员列表读取请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2需求成员列表读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = 状态;
        结果.结果头.事实截止代次 = 截止;
        结果.读取类别 = 请求.读取类别;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        return 结果;
    };

    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 期望代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.目标关系组 = {{请求.需求.值, 类型定位.需求列表成员关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);

    const auto 顶层 = 解释精确查询一致读取顶层(
        读取, 期望代次, L1请求.目标关系组.size());
    if (!顶层.成功())
        return 失败(顶层.状态, 顶层.事实截止代次);

    const auto* 成员组 = 查找唯一需求目标关系组(
        读取, 请求.需求.值, 类型定位.需求列表成员关系类型);
    if (!成员组) return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    // 当前成员关系：恰有一条（规范 10.3）
    const L1所有者范围关系事实* 当前成员关系 = nullptr;
    for (const auto& 成员 : 成员组->成员) {
        if (!成员.关系.退出事实代次) {
            if (当前成员关系) return 失败(
                L2结构状态::内部不一致, 顶层.事实截止代次);
            当前成员关系 = &成员.关系;
        }
    }
    if (!当前成员关系) {
        // 0 项：合法空结果
        L2需求成员列表读取结果 结果;
        结果.结果头.合同版本 = L2结构合同版本;
        结果.结果头.状态 = L2结构状态::已读取;
        结果.结果头.事实截止代次 = 顶层.事实截止代次;
        结果.读取类别 = 请求.读取类别;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        return 结果;
    }

    L2需求成员列表读取结果 结果;
    结果.结果头.合同版本 = L2结构合同版本;
    结果.结果头.状态 = L2结构状态::已读取;
    结果.结果头.事实截止代次 = 顶层.事实截止代次;
    结果.读取类别 = 请求.读取类别;
    结果.历史截止事实代次 = 请求.历史截止事实代次;

    L2需求列表成员关系事实 成员关系事实;
    成员关系事实.关系稳定编码 = 当前成员关系->编码;
    成员关系事实.列表项 = L2需求列表项身份{当前成员关系->源节点};
    成员关系事实.需求 = 请求.需求;
    成员关系事实.生命周期 = {当前成员关系->创建事实代次,
        当前成员关系->退出事实代次};
    结果.当前成员关系 = std::move(成员关系事实);

    // 所属列表项事实（简化：仅身份和生命周期）
    L2需求列表项事实 列表项事实;
    列表项事实.身份 = L2需求列表项身份{当前成员关系->源节点};
    结果.所属列表项 = std::move(列表项事实);
    return 结果;
}

// ===== 写入：目标身份验证 =====

// 诊断责任：向上送出；验证目标宿主存在身份、目标特征定义身份、目标状态合同身份。
// 任一目标身份在事实基座中不存在或已退出时返回对应失败状态。
struct 需求目标身份验证结果 final {
    L2结构状态 状态 = L2结构状态::已读取;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

需求目标身份验证结果 验证需求目标身份当前有效(
    const L2存在结构服务& 存在服务,
    const L2特征结构服务& 特征服务,
    const L2状态结构服务& 状态服务,
    const L2新增需求并建立列表项请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        return 需求目标身份验证结果{状态};
    };

    const L2结构请求头 头{L2结构合同版本, 期望代次};

    // 验证目标宿主存在身份
    const auto 存在来源 = 存在服务.读取存在身份来源(
        {头, L2读取类别::当前, 请求.目标宿主存在, 0});
    if (!存在来源.成功() || !存在来源.身份来源)
        return 失败(存在来源.结果头.状态 == L2结构状态::已读取
            ? L2结构状态::内部不一致
            : 存在来源.结果头.状态);
    // 验证身份来源完整性（当前有效：退出事实代次为空）
    if (存在来源.身份来源->节点生命周期.退出事实代次)
        return 失败(L2结构状态::已退出);

    // 验证目标特征定义身份
    const auto 特征来源 = 特征服务.读取特征定义身份来源(
        {头, L2读取类别::当前, 请求.目标特征定义, 0});
    if (!特征来源.成功() || !特征来源.身份来源)
        return 失败(特征来源.结果头.状态 == L2结构状态::已读取
            ? L2结构状态::内部不一致
            : 特征来源.结果头.状态);
    if (特征来源.身份来源->节点生命周期.退出事实代次)
        return 失败(L2结构状态::已退出);

    // 验证目标状态合同身份（通过读取完整目标状态合同）
    const auto 状态合同 = 状态服务.读取完整目标状态合同(
        {头, L2读取类别::当前, 请求.目标状态合同, 0});
    if (!状态合同.成功() || !状态合同.合同)
        return 失败(状态合同.结果头.状态 == L2结构状态::已读取
            ? L2结构状态::内部不一致
            : 状态合同.结果头.状态);
    if (状态合同.合同->生命周期.退出事实代次)
        return 失败(L2结构状态::已退出);

    return {L2结构状态::已读取};
}

// 诊断责任：向上送出；验证替换父需求的旧关系事实与请求一致且当前有效。
// 检查项（4250 规范 10.2 边界）：
//   1. 旧关系稳定编码确实存在
//   2. 它确实是一条父子关系（关系类型 == 需求父子关系类型）
//   3. 源节点 == 请求.旧父需求、目标节点 == 请求.子需求
//   4. 角色或顺序 == 请求.旧顺序
//   5. 当前未退出（退出事实代次为空）
// 任一项不满足时返回对应失败状态，禁止通过本接口退出非父子关系。
struct 替换父需求旧关系验证结果 final {
    L2结构状态 状态 = L2结构状态::已读取;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

替换父需求旧关系验证结果 验证替换父需求旧关系当前有效(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2替换父需求请求& 请求) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        return 替换父需求旧关系验证结果{状态};
    };

    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.旧关系稳定编码});
    if (读取.状态 == L1所有者范围读取状态::已退出)
        return 失败(L2结构状态::已退出);
    if (读取.状态 != L1所有者范围读取状态::成功 || !读取.事实)
        return 失败(读取.状态 == L1所有者范围读取状态::未找到
            ? L2结构状态::未找到
            : (读取.状态 == L1所有者范围读取状态::入口拒绝
                ? L2结构状态::入口拒绝
                : L2结构状态::内部不一致));

    const auto* 关系 = std::get_if<L1所有者范围关系事实>(&*读取.事实);
    if (!关系 || 关系->编码 != 请求.旧关系稳定编码
        || 关系->写入所有者 != 来源定位.所有者)
        return 失败(L2结构状态::内部不一致);

    // 边界 1：必须是父子关系类型，禁止用其他关系类型伪装
    if (关系->关系类型节点 != 类型定位.需求父子关系类型)
        return 失败(L2结构状态::入口拒绝);
    // 边界 2：源/目标必须与请求一致
    if (关系->源节点 != 请求.旧父需求.值
        || 关系->目标节点 != 请求.子需求.值)
        return 失败(L2结构状态::入口拒绝);
    // 边界 3：顺序必须一致
    if (关系->角色或顺序
        != static_cast<std::int64_t>(请求.旧顺序))
        return 失败(L2结构状态::入口拒绝);
    // 边界 4：当前必须未退出
    if (关系->退出事实代次)
        return 失败(L2结构状态::已退出);
    return {L2结构状态::已读取};
}

// 诊断责任：向上送出；验证新父需求当前存在且有效（非退出）。
// 防止建立父子关系到已退出或无关的节点上。
struct 新父需求存在验证结果 final {
    L2结构状态 状态 = L2结构状态::已读取;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

新父需求存在验证结果 验证新父需求当前存在有效(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const L2需求身份& 新父需求) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        return 新父需求存在验证结果{状态};
    };

    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 新父需求.值});
    if (读取.状态 == L1所有者范围读取状态::已退出)
        return 失败(L2结构状态::已退出);
    if (读取.状态 != L1所有者范围读取状态::成功 || !读取.事实)
        return 失败(读取.状态 == L1所有者范围读取状态::未找到
            ? L2结构状态::未找到
            : (读取.状态 == L1所有者范围读取状态::入口拒绝
                ? L2结构状态::入口拒绝
                : L2结构状态::内部不一致));

    const auto* 节点 = std::get_if<L1所有者范围节点事实>(&*读取.事实);
    if (!节点 || 节点->编码 != 新父需求.值
        || 节点->写入所有者 != 来源定位.所有者
        || 节点->退出事实代次)
        return 失败(节点 && 节点->退出事实代次
            ? L2结构状态::已退出
            : L2结构状态::内部不一致);
    return {L2结构状态::已读取};
}

// 诊断责任：向上送出；验证退出需求的自有事实闭包与请求一致且当前有效。
// 检查项（4250 规范 10.4 生命周期闭环入口）：
//   1. 需求节点存在、owner 一致、当前未退出
//   2. 5 个自有关系（族归属/所属存在/目标宿主/目标特征/目标合同）：
//      - 编码存在、owner 一致、当前未退出
//      - 源节点 == 请求.需求
//      - 关系类型与请求声明的类型定位一致
//   3. 列表成员关系：源节点为列表项、目标节点 == 请求.需求、当前未退出
//   4. (可选) 父关系：源节点为父、目标节点 == 请求.需求、当前未退出
// 任一项不满足时返回对应失败状态，禁止通过本接口退出非自有关系。
struct 需求退出闭包验证结果 final {
    L2结构状态 状态 = L2结构状态::已读取;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

需求退出闭包验证结果 验证需求退出事实闭包当前有效(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2需求退出请求& 请求) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        return 需求退出闭包验证结果{状态};
    };

    // ===== 节点验证 =====
    const auto 节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.需求.值});
    if (节点读取.状态 == L1所有者范围读取状态::已退出)
        return 失败(L2结构状态::已退出);
    if (节点读取.状态 != L1所有者范围读取状态::成功 || !节点读取.事实)
        return 失败(节点读取.状态 == L1所有者范围读取状态::未找到
            ? L2结构状态::未找到
            : (节点读取.状态 == L1所有者范围读取状态::入口拒绝
                ? L2结构状态::入口拒绝
                : L2结构状态::内部不一致));
    const auto* 节点 = std::get_if<L1所有者范围节点事实>(
        &*节点读取.事实);
    if (!节点 || 节点->编码 != 请求.需求.值
        || 节点->写入所有者 != 来源定位.所有者
        || 节点->退出事实代次)
        return 失败(节点 && 节点->退出事实代次
            ? L2结构状态::已退出
            : L2结构状态::内部不一致);

    // ===== 自有关系验证（5 个）=====
    const auto 验证自有关系 = [&](
        稳定编码 关系编码, 稳定编码 期望关系类型) ->
        需求退出闭包验证结果 {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 关系编码});
        if (读取.状态 == L1所有者范围读取状态::已退出)
            return 失败(L2结构状态::已退出);
        if (读取.状态 != L1所有者范围读取状态::成功 || !读取.事实)
            return 失败(读取.状态 == L1所有者范围读取状态::未找到
                ? L2结构状态::未找到
                : (读取.状态 == L1所有者范围读取状态::入口拒绝
                    ? L2结构状态::入口拒绝
                    : L2结构状态::内部不一致));
        const auto* 关系 = std::get_if<L1所有者范围关系事实>(
            &*读取.事实);
        if (!关系 || 关系->编码 != 关系编码
            || 关系->写入所有者 != 来源定位.所有者
            || 关系->退出事实代次)
            return 失败(关系 && 关系->退出事实代次
                ? L2结构状态::已退出
                : L2结构状态::内部不一致);
        // 源节点必须是请求的需求自身
        if (关系->源节点 != 请求.需求.值)
            return 失败(L2结构状态::入口拒绝);
        // 关系类型必须与请求声明的类型定位一致
        if (关系->关系类型节点 != 期望关系类型)
            return 失败(L2结构状态::入口拒绝);
        return {L2结构状态::已读取};
    };

    // 族归属关系：需求 -> 需求锚点，关系类型 = 需求类型
    const auto 族归属 = 验证自有关系(
        请求.自有事实闭包.自有关系.族归属关系稳定编码,
        来源定位.需求类型);
    if (!族归属.成功()) return 族归属;

    // 所属存在关系：需求 -> 所属存在，关系类型 = 需求所属存在关系类型
    const auto 所属存在 = 验证自有关系(
        请求.自有事实闭包.自有关系.所属存在关系稳定编码,
        类型定位.需求所属存在关系类型);
    if (!所属存在.成功()) return 所属存在;

    // 目标宿主关系：需求 -> 目标宿主存在
    const auto 目标宿主 = 验证自有关系(
        请求.自有事实闭包.自有关系.目标宿主关系稳定编码,
        类型定位.需求目标宿主关系类型);
    if (!目标宿主.成功()) return 目标宿主;

    // 目标特征关系：需求 -> 目标特征定义
    const auto 目标特征 = 验证自有关系(
        请求.自有事实闭包.自有关系.目标特征关系稳定编码,
        类型定位.需求目标特征关系类型);
    if (!目标特征.成功()) return 目标特征;

    // 目标合同关系：需求 -> 目标状态合同
    const auto 目标合同 = 验证自有关系(
        请求.自有事实闭包.自有关系.目标合同关系稳定编码,
        类型定位.需求目标合同关系类型);
    if (!目标合同.成功()) return 目标合同;

    // ===== 列表成员关系验证 =====
    // 列表项 -> 需求，关系类型 = 需求列表成员关系类型
    {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本,
             请求.自有事实闭包.当前列表成员关系稳定编码});
        if (读取.状态 == L1所有者范围读取状态::已退出)
            return 失败(L2结构状态::已退出);
        if (读取.状态 != L1所有者范围读取状态::成功 || !读取.事实)
            return 失败(读取.状态 == L1所有者范围读取状态::未找到
                ? L2结构状态::未找到
                : (读取.状态 == L1所有者范围读取状态::入口拒绝
                    ? L2结构状态::入口拒绝
                    : L2结构状态::内部不一致));
        const auto* 列表成员 = std::get_if<L1所有者范围关系事实>(
            &*读取.事实);
        if (!列表成员
            || 列表成员->编码
                != 请求.自有事实闭包.当前列表成员关系稳定编码
            || 列表成员->写入所有者 != 来源定位.所有者
            || 列表成员->退出事实代次)
            return 失败(列表成员 && 列表成员->退出事实代次
                ? L2结构状态::已退出
                : L2结构状态::内部不一致);
        // 列表成员关系：源节点为列表项、目标节点必须是请求的需求
        if (列表成员->目标节点 != 请求.需求.值)
            return 失败(L2结构状态::入口拒绝);
        // 关系类型必须是列表成员关系类型
        if (列表成员->关系类型节点
            != 类型定位.需求列表成员关系类型)
            return 失败(L2结构状态::入口拒绝);
    }

    // ===== (可选) 父关系验证 =====
    if (请求.自有事实闭包.当前父关系稳定编码) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本,
             *请求.自有事实闭包.当前父关系稳定编码});
        if (读取.状态 == L1所有者范围读取状态::已退出)
            return 失败(L2结构状态::已退出);
        if (读取.状态 != L1所有者范围读取状态::成功 || !读取.事实)
            return 失败(读取.状态 == L1所有者范围读取状态::未找到
                ? L2结构状态::未找到
                : (读取.状态 == L1所有者范围读取状态::入口拒绝
                    ? L2结构状态::入口拒绝
                    : L2结构状态::内部不一致));
        const auto* 父子关系 = std::get_if<L1所有者范围关系事实>(
            &*读取.事实);
        if (!父子关系
            || 父子关系->编码
                != *请求.自有事实闭包.当前父关系稳定编码
            || 父子关系->写入所有者 != 来源定位.所有者
            || 父子关系->退出事实代次)
            return 失败(父子关系 && 父子关系->退出事实代次
                ? L2结构状态::已退出
                : L2结构状态::内部不一致);
        // 父子关系：源节点为父需求、目标节点必须是请求的需求
        if (父子关系->目标节点 != 请求.需求.值)
            return 失败(L2结构状态::入口拒绝);
        // 关系类型必须是父子关系类型
        if (父子关系->关系类型节点
            != 类型定位.需求父子关系类型)
            return 失败(L2结构状态::入口拒绝);
    }

    return {L2结构状态::已读取};
}

L2按任务子目标记录读取需求来源结果
按任务子目标记录读取需求来源当前投影(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    const L2按任务子目标记录读取需求来源请求& 请求,
    std::uint64_t 期望代次) {
    const auto 失败 = [&](L2结构状态 状态,
        std::uint64_t 截止 = 0) noexcept {
        L2按任务子目标记录读取需求来源结果 结果;
        结果.结果头 = {L2结构合同版本, 状态, 截止, std::nullopt};
        return 结果;
    };
    L1所有者范围一致当前读取请求 第一层请求;
    第一层请求.合同版本 = L1所有者范围一致当前读取合同版本;
    第一层请求.期望事实代次 = 期望代次;
    第一层请求.所有者 = {来源定位.所有者};
    第一层请求.目标关系组 = {{请求.来源记录.值,
        类型定位.任务子目标来源关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(
        第一层请求);
    const auto 顶层 = 解释精确查询一致读取顶层(
        读取, 期望代次, 第一层请求.目标关系组.size());
    if (!顶层.成功()) return 失败(顶层.状态, 顶层.事实截止代次);
    const auto* 来源组 = 查找唯一需求目标关系组(
        读取, 请求.来源记录.值, 类型定位.任务子目标来源关系类型);
    if (!来源组)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);

    L2按任务子目标记录读取需求来源结果 结果;
    结果.结果头 = {L2结构合同版本, L2结构状态::已读取,
        顶层.事实截止代次, std::nullopt};
    for (const auto& 成员 : 来源组->成员) {
        if (成员.关系.退出事实代次) continue;
        if (成员.关系.目标节点 != 请求.来源记录.值
            || 成员.关系.关系类型节点
                != 类型定位.任务子目标来源关系类型
            || 成员.关系.写入所有者 != 来源定位.所有者
            || 成员.对端节点.编码 != 成员.关系.源节点
            || 成员.对端节点.退出事实代次)
            return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
        结果.来源关系组.push_back({
            L2需求任务子目标来源关系身份{成员.关系.编码},
            L2需求身份{成员.关系.源节点}, 请求.来源记录,
            {成员.关系.创建事实代次, 成员.关系.退出事实代次}});
    }
    if (结果.来源关系组.size() > 1)
        return 失败(L2结构状态::内部不一致, 顶层.事实截止代次);
    return 结果;
}

template <typename 结果类型>
结果类型 读回需求任务子目标来源完整写结果(
    const L1事实基座服务& 第一层服务,
    const 需求身份来源定位& 来源定位,
    const 需求结构类型定位& 类型定位,
    L2结构状态 写入状态, std::uint64_t 写入代次,
    L2需求身份 子需求身份, L2需求身份 父需求身份,
    L2需求列表项身份 列表项身份,
    L2需求任务子目标记录引用 来源记录) {
    const auto 失败 = [&](L2结构状态 状态) noexcept {
        结果类型 结果;
        结果.结果头 = {L2结构合同版本, 状态, 写入代次, 写入代次};
        return 结果;
    };
    const L2结构请求头 请求头{L2结构合同版本, 写入代次};
    const auto 子需求 = 读取需求完整当前投影(第一层服务, 来源定位,
        类型定位, {请求头, L2读取类别::当前, 子需求身份, 0}, 写入代次);
    const auto 父需求 = 读取需求完整当前投影(第一层服务, 来源定位,
        类型定位, {请求头, L2读取类别::当前, 父需求身份, 0}, 写入代次);
    const auto 父关系 = 按子需求读取当前父需求当前投影(第一层服务,
        来源定位, 类型定位, {请求头, 子需求身份}, 写入代次);
    const auto 成员 = 读取需求成员列表当前投影(第一层服务, 来源定位,
        类型定位, {请求头, L2读取类别::当前, 子需求身份, 0}, 写入代次);
    const auto 列表项 = 读取需求列表项完整当前投影(第一层服务,
        来源定位, 类型定位,
        {请求头, L2读取类别::当前, 列表项身份, 0}, 写入代次);
    const auto 来源 = 按任务子目标记录读取需求来源当前投影(
        第一层服务, 来源定位, 类型定位, {请求头, 来源记录}, 写入代次);
    if (!子需求.成功() || !子需求.需求 || !父需求.成功() || !父需求.需求
        || !父关系.成功() || !父关系.当前父关系 || !父关系.父需求
        || !成员.成功() || !成员.当前成员关系
        || !列表项.成功() || !列表项.列表项
        || !来源.唯一结果())
        return 失败(L2结构状态::内部不一致);
    结果类型 结果;
    结果.结果头 = {L2结构合同版本, 写入状态, 写入代次, 写入代次};
    结果.子需求 = *子需求.需求;
    结果.父需求 = *父需求.需求;
    结果.所属列表项 = *列表项.列表项;
    结果.当前成员关系 = *成员.当前成员关系;
    结果.当前父关系 = *父关系.当前父关系;
    结果.来源关系 = 来源.来源关系组.front();
    if (!结果.成功()) return 失败(L2结构状态::内部不一致);
    return 结果;
}

} // namespace 海中鱼巣::L2需求结构内部

export namespace 海中鱼巣 {

// ===== 所有者交付验证 =====
inline std::optional<L2需求所有者交付> 尝试形成L2需求所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 需求所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份()
                != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务))
            return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2需求所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

// ===== 需求结构服务 =====
class L2需求结构服务 final {
public:
    explicit L2需求结构服务(const L1事实基座服务& 第一层服务,
        const L2存在结构服务& 存在服务, const L2特征结构服务& 特征服务,
        const L2状态结构服务& 状态服务, L2需求所有者交付&& 交付)
        : L1_(第一层服务), 存在服务_(存在服务),
          特征服务_(特征服务), 状态服务_(状态服务),
          第一层写入端口_(验证并移动交付(第一层服务, 交付)),
          身份来源定位_(L2需求结构内部::初始化需求身份来源(
              L1_, 第一层写入端口_)),
          类型定位_(L2需求结构内部::初始化需求结构类型(
              L1_, 第一层写入端口_, 身份来源定位_)) {
    }
    L2需求结构服务(const L2需求结构服务&) = delete;
    L2需求结构服务& operator=(const L2需求结构服务&) = delete;

    // ===== 身份来源公开读取 =====
    // 从事实基座读取需求身份来源事实：owner 归属、需求族锚点证明、
    // 族归属关系类型证明、族归属关系证明、角色或顺序、5 个生命周期。
    // 当前读取使用一致当前投影；历史读取尚未打通执行层，返回未实现。
    L2需求身份来源读取结果 读取需求身份来源(
        L2需求身份来源读取请求 请求) const noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 截止 = L2需求结构内部::读取中性当前事实代次(L1_);
        if (!L2需求身份来源读取请求有效(请求) || 截止 == 0)
            return L2需求结构内部::形成身份来源读取失败(
                L2结构状态::入口拒绝, 截止);
        if (请求.读取类别 == L2读取类别::历史)
            return L2需求结构内部::形成身份来源读取失败(
                L2结构状态::未实现, 截止);
        try {
            return L2需求结构内部::读取需求身份来源当前投影(
                L1_, 身份来源定位_, 请求, 截止);
        } catch (...) {
            return L2需求结构内部::形成身份来源读取失败(
                L2结构状态::资源失败, 截止);
        }
    }

    // ===== 结构登记公开读取 =====
    L2需求结构类型登记结果 读取需求结构类型登记(
        L2需求结构类型登记请求 请求) const noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 截止 = L2需求结构内部::读取中性当前事实代次(L1_);
        if (!L2需求结构类型登记请求有效(请求))
            return L2需求结构内部::形成需求结构类型登记失败(
                L2需求结构类型登记状态::入口拒绝, 截止);
        L2需求结构类型登记 登记;
        登记.父子关系类型 = L2需求父子关系类型身份{类型定位_.需求父子关系类型};
        登记.任务子目标来源关系类型 =
            L2需求任务子目标来源关系类型身份{
                类型定位_.任务子目标来源关系类型};
        登记.列表成员关系类型 = L2需求列表成员关系类型身份{类型定位_.需求列表成员关系类型};
        登记.需求所属存在关系类型 = L2需求所属存在关系类型身份{类型定位_.需求所属存在关系类型};
        登记.需求目标宿主关系类型 = L2需求目标宿主关系类型身份{类型定位_.需求目标宿主关系类型};
        登记.需求目标特征关系类型 = L2需求目标特征关系类型身份{类型定位_.需求目标特征关系类型};
        登记.需求目标合同关系类型 = L2需求目标合同关系类型身份{类型定位_.需求目标合同关系类型};
        登记.列表项所属存在关系类型 = L2列表项所属存在关系类型身份{类型定位_.列表项所属存在关系类型};
        登记.列表项目标宿主关系类型 = L2列表项目标宿主关系类型身份{类型定位_.列表项目标宿主关系类型};
        登记.列表项目标特征关系类型 = L2列表项目标特征关系类型身份{类型定位_.列表项目标特征关系类型};
        登记.列表项目标合同关系类型 = L2列表项目标合同关系类型身份{类型定位_.列表项目标合同关系类型};
        登记.首次幂等身份 = {请求.幂等身份.值};
        登记.规则版本 = 请求.规则版本;
        登记.首次期望事实代次 = 请求.请求头.期望事实代次;
        登记.建立事实代次 = 类型定位_.建立事实代次;
        登记.事实截止代次 = 截止;
        L2需求结构类型登记结果 结果;
        结果.状态 = L2需求结构类型登记状态::已读取;
        结果.事实截止代次 = 截止;
        结果.登记 = std::move(登记);
        return 结果;
    }

    // ===== 身份读取 =====
    // 从事实基座验证需求身份：owner 归属、需求族证明、生命周期、列表成员关系。
    L2需求身份读取结果 读取需求身份(
        L2需求身份读取请求 请求) const noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 截止 = L2需求结构内部::读取中性当前事实代次(L1_);
        if (请求.合同版本 != L2结构合同版本 || 截止 == 0)
            return L2需求结构内部::形成需求身份读取失败(
                L2需求身份读取状态::入口拒绝, 截止, 请求.需求);
        if (!有效(请求.需求.值))
            return L2需求结构内部::形成需求身份读取失败(
                L2需求身份读取状态::未找到, 截止, 请求.需求);
        try {
            return L2需求结构内部::验证需求身份当前投影(
                L1_, 身份来源定位_, 类型定位_, 请求, 截止);
        } catch (...) {
            return L2需求结构内部::形成需求身份读取失败(
                L2需求身份读取状态::资源失败, 截止, 请求.需求);
        }
    }

