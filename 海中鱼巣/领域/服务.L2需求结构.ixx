// ===== 所有者交付固定身份 =====
inline constexpr L1所有者范围建立幂等身份 需求所有者建立身份{
    0x4C31'4F57'4E45'5252ULL};

class L2需求结构服务;

// ===== 所有者交付 =====
class L2需求所有者交付 final {
public:
    L2需求所有者交付() = delete;
    L2需求所有者交付(const L2需求所有者交付&) = delete;
    L2需求所有者交付& operator=(const L2需求所有者交付&) = delete;
    L2需求所有者交付(L2需求所有者交付&&) noexcept = default;
    L2需求所有者交付& operator=(L2需求所有者交付&&) = delete;

    bool 有效() const noexcept { return 写入端口_.有效(); }
    bool 绑定于(const L1事实基座服务& 服务) const noexcept {
        return 写入端口_.绑定于(服务);
    }
    L1结构所有者身份 所有者身份() const noexcept {
        return 写入端口_.所有者身份();
    }

private:
    explicit L2需求所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2需求所有者交付> 尝试形成L2需求所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2需求结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2需求所有者交付> 尝试形成L2需求所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

} // namespace 海中鱼巣

namespace 海中鱼巣::L2需求结构内部 {

// ===== 身份来源定位 =====
struct 需求身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 需求锚点;
    稳定编码 需求类型;
    稳定编码 列表项锚点;
    稳定编码 列表项类型;
    std::uint64_t 建立事实代次 = 0;
};

struct 需求结构类型定位 final {
    稳定编码 需求父子关系类型;
    稳定编码 任务子目标来源关系类型;
    稳定编码 需求列表成员关系类型;
    稳定编码 需求所属存在关系类型;
    稳定编码 需求目标宿主关系类型;
    稳定编码 需求目标特征关系类型;
    稳定编码 需求目标合同关系类型;
    稳定编码 列表项所属存在关系类型;
    稳定编码 列表项目标宿主关系类型;
    稳定编码 列表项目标特征关系类型;
    稳定编码 列表项目标合同关系类型;
    std::uint64_t 建立事实代次 = 0;
};

