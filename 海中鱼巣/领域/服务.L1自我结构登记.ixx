module;

#include <cstddef>
#include <cstdint>
#include <mutex>
#include <new>
#include <optional>
#include <vector>

export module 海中鱼巣.领域.服务.L1自我结构登记;

export import 海中鱼巣.核心.合同.L1公共事实;
import 海中鱼巣.核心.服务.L1事实基座;

export {
#include "L1自我结构登记.数据.h"
}

namespace 海中鱼巣::L1自我结构登记内部 {

inline constexpr std::uint64_t 登记幂等域 = 0x1BULL;

// 诊断责任：无适用错误分支；纯值键映射不读取状态、不产生副作用。
L1中性写集幂等键 映射幂等键(
    自我结构登记操作幂等身份 身份) noexcept {
    return {(登记幂等域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；纯值状态映射覆盖全部中性写入状态。
自我结构登记状态 映射写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功:
        return 自我结构登记状态::已提交;
    case L1中性写入状态::精确重复:
        return 自我结构登记状态::幂等读回;
    case L1中性写入状态::入口拒绝:
        return 自我结构登记状态::入口拒绝;
    case L1中性写入状态::事实代次漂移:
        return 自我结构登记状态::事实代次漂移;
    case L1中性写入状态::幂等冲突:
        return 自我结构登记状态::幂等冲突;
    case L1中性写入状态::资源失败:
        return 自我结构登记状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return 自我结构登记状态::内部不一致;
    }
    return 自我结构登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值状态映射保留一致读取失败类别。
自我结构登记状态 映射一致读取失败状态(
    L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::入口拒绝:
        return 自我结构登记状态::入口拒绝;
    case L1中性一致当前读取状态::许可拒绝:
        return 自我结构登记状态::许可拒绝;
    case L1中性一致当前读取状态::事实代次漂移:
        return 自我结构登记状态::事实代次漂移;
    case L1中性一致当前读取状态::资源失败:
        return 自我结构登记状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::内部不一致:
        return 自我结构登记状态::内部不一致;
    }
    return 自我结构登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值核对一致读取失败的空材料和代次边界。
bool 一致读取失败形状完整(const L1中性一致当前读取结果& 结果,
    std::uint64_t 期望代次) noexcept {
    if (结果.状态 == L1中性一致当前读取状态::成功
        || 结果.合同版本 != L1中性一致当前读取合同版本
        || 结果.期望事实代次 != 期望代次
        || !结果.节点.empty() || !结果.关系.empty()
        || !结果.值.empty() || !结果.属性值.empty()
        || !结果.源关系组.empty() || !结果.目标关系组.empty()) {
        return false;
    }
    return 结果.状态 == L1中性一致当前读取状态::事实代次漂移
        ? 结果.读取事实代次 != 0 && 结果.读取事实代次 != 期望代次
        : 结果.读取事实代次 == 0;
}

// 诊断责任：无适用错误分支；未找到或重复映射均返回空值。
std::optional<稳定编码> 查找映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到.has_value()) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值唯一性判断不读取状态、不产生副作用。
bool 映射唯一(const L1中性写入结果& 结果) noexcept {
    for (std::size_t 左 = 0; 左 < 结果.新编码映射.size(); ++左) {
        if (!有效(结果.新编码映射[左].first)
            || !有效(结果.新编码映射[左].second)) return false;
        for (std::size_t 右 = 左 + 1; 右 < 结果.新编码映射.size(); ++右) {
            if (结果.新编码映射[左].first == 结果.新编码映射[右].first
                || 结果.新编码映射[左].second
                    == 结果.新编码映射[右].second) {
                return false;
            }
        }
    }
    return true;
}

} // namespace 海中鱼巣::L1自我结构登记内部

export namespace 海中鱼巣 {

class L1自我结构登记服务 final {
public:
    // 诊断责任：无适用错误分支；只保存第一层服务引用，不读取或写入事实。
    explicit L1自我结构登记服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L1自我结构登记服务(const L1自我结构登记服务&) = delete;
    L1自我结构登记服务& operator=(const L1自我结构登记服务&) = delete;

    // 诊断责任：向上送出；所有拒绝、漂移和内部矛盾均以结构化结果返回。
    自我结构登记结果 建立登记(const 自我结构登记请求& 请求) {
        std::lock_guard<std::mutex> 锁(定位锁_);
        try {
            if (!自我结构登记请求有效(请求)) return {};

            const auto 幂等键 =
                L1自我结构登记内部::映射幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {
                {{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::普通, std::nullopt}};
            写集.关系 = {};
            写集.值 = {};
            写集.属性槽变更 = {};
            写集.退出事实 = {};

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 =
                L1自我结构登记内部::映射写入状态(写入.状态);
            if (状态 != 自我结构登记状态::已提交
                && 状态 != 自我结构登记状态::幂等读回) {
                return {状态, std::nullopt};
            }

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 =
                写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            if (写入.合同版本 != L1中性CRUD合同版本
                || 写入.幂等键 != 幂等键 || 写入.事实代次 == 0
                || 写入.新编码映射.size() != 2
                || (!首次成功完整 && !重复成功完整)
                || !L1自我结构登记内部::映射唯一(写入)) {
                return {自我结构登记状态::内部不一致, std::nullopt};
            }

            const auto 服务 = L1自我结构登记内部::查找映射(写入, 1);
            const auto 关系类型 = L1自我结构登记内部::查找映射(写入, 2);
            if (!服务 || !关系类型 || *服务 == *关系类型) {
                return {自我结构登记状态::内部不一致, std::nullopt};
            }

            自我结构关系登记 新定位;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.服务身份 = *服务;
            新定位.自我结构关系类型 = *关系类型;
            if (!自我结构关系登记完整(新定位)) {
                return {自我结构登记状态::内部不一致, std::nullopt};
            }

            auto 读回 = 按定位读取当前登记(新定位, 写入.事实代次);
            if (读回.状态 != 自我结构登记状态::已读取 || !读回.登记) {
                return {读回.状态 == 自我结构登记状态::已读取
                        ? 自我结构登记状态::内部不一致 : 读回.状态,
                    std::nullopt};
            }
            if (登记定位_.has_value()
                && (登记定位_->首次幂等身份 != 新定位.首次幂等身份
                    || 登记定位_->服务身份 != 新定位.服务身份
                    || 登记定位_->自我结构关系类型
                        != 新定位.自我结构关系类型)) {
                return {自我结构登记状态::内部不一致, std::nullopt};
            }
            登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return {自我结构登记状态::资源失败, std::nullopt};
        } catch (...) {
            return {自我结构登记状态::内部不一致, std::nullopt};
        }
    }

    // 诊断责任：向上送出；定位只在锁内深复制，权威事实在锁外正式读取。
    自我结构登记结果 读取当前登记() const {
        std::optional<自我结构关系登记> 定位;
        {
            std::lock_guard<std::mutex> 锁(定位锁_);
            定位 = 登记定位_;
        }
        if (!定位) {
            return {自我结构登记状态::登记未加载, std::nullopt};
        }
        try {
            return 按定位读取当前登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return {自我结构登记状态::资源失败, std::nullopt};
        } catch (...) {
            return {自我结构登记状态::内部不一致, std::nullopt};
        }
    }

private:
    // 诊断责任：向上送出；许可、漂移、资源失败和事实矛盾均结构化返回。
    自我结构登记结果 按定位读取当前登记(
        const 自我结构关系登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!自我结构关系登记完整(定位)) {
            return {自我结构登记状态::内部不一致, std::nullopt};
        }

        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试序号 = 0;
            尝试序号 < 最大尝试次数; ++尝试序号) {
            L1中性一致当前读取请求 请求;
            请求.合同版本 = L1中性一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.节点 = {定位.服务身份, 定位.自我结构关系类型};
            请求.关系 = {};
            请求.值 = {};
            请求.属性值 = {};
            请求.源关系组 = {};
            请求.目标关系组 = {};

            const auto 读取 = L1_.尝试读取中性一致当前投影(请求);
            if (读取.状态 == L1中性一致当前读取状态::事实代次漂移) {
                if (!L1自我结构登记内部::一致读取失败形状完整(
                    读取, 本轮期望代次)) {
                    return {自我结构登记状态::内部不一致, std::nullopt};
                }
                if (尝试序号 == 0) {
                    本轮期望代次 = 读取.读取事实代次;
                    continue;
                }
                return {自我结构登记状态::事实代次漂移, std::nullopt};
            }
            if (读取.状态 != L1中性一致当前读取状态::成功) {
                if (!L1自我结构登记内部::一致读取失败形状完整(
                    读取, 本轮期望代次)) {
                    return {自我结构登记状态::内部不一致, std::nullopt};
                }
                return {L1自我结构登记内部::映射一致读取失败状态(
                    读取.状态), std::nullopt};
            }
            if (读取.合同版本 != L1中性一致当前读取合同版本
                || 读取.期望事实代次 != 本轮期望代次
                || 读取.读取事实代次 != 本轮期望代次
                || 读取.读取事实代次 == 0 || 读取.节点.size() != 2
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty()) {
                return {自我结构登记状态::内部不一致, std::nullopt};
            }

            const auto& 服务 = 读取.节点[0];
            const auto& 关系类型 = 读取.节点[1];
            if (服务.查询编码 != 定位.服务身份
                || 关系类型.查询编码 != 定位.自我结构关系类型
                || 服务.状态 != L1中性一致当前读取项目状态::成功
                || 关系类型.状态 != L1中性一致当前读取项目状态::成功
                || !服务.事实.has_value() || !关系类型.事实.has_value()) {
                return {自我结构登记状态::内部不一致, std::nullopt};
            }

            const auto& 服务事实 = *服务.事实;
            const auto& 关系类型事实 = *关系类型.事实;
            if (服务事实.编码 != 定位.服务身份
                || 关系类型事实.编码 != 定位.自我结构关系类型
                || 服务事实.种类 != 节点种类::普通
                || 关系类型事实.种类 != 节点种类::普通
                || 服务事实.属性类型表示.has_value()
                || 关系类型事实.属性类型表示.has_value()
                || 服务事实.创建事实代次 == 0
                || 服务事实.创建事实代次 != 关系类型事实.创建事实代次
                || 服务事实.创建事实代次 > 读取.读取事实代次
                || 服务事实.退出事实代次.has_value()
                || 关系类型事实.退出事实代次.has_value()
                || !服务事实.当前属性.empty()
                || !关系类型事实.当前属性.empty()
                || (期望创建代次.has_value()
                    && 服务事实.创建事实代次 != *期望创建代次)) {
                return {自我结构登记状态::内部不一致, std::nullopt};
            }

            auto 当前登记 = 定位;
            当前登记.事实截止代次 = 读取.读取事实代次;
            return 自我结构关系登记完整(当前登记)
                ? 自我结构登记结果{自我结构登记状态::已读取, 当前登记}
                : 自我结构登记结果{
                    自我结构登记状态::内部不一致, std::nullopt};
        }
        return {自我结构登记状态::内部不一致, std::nullopt};
    }

    L1事实基座服务& L1_;
    mutable std::mutex 定位锁_;
    std::optional<自我结构关系登记> 登记定位_;
};

} // namespace 海中鱼巣
