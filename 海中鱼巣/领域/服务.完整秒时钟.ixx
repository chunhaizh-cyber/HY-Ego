module;

#include <cstdint>
#include <optional>

export module 海中鱼巣.领域.服务.完整秒时钟;

import 海中鱼巣.适配.适配器.单调时钟;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 完整秒边界读取合同版本 = 1;

struct 完整秒时钟服务配置 final {
  std::uint64_t 运行代次 = 0;
  std::uint64_t 时间纪元身份 = 0;
  std::uint32_t 时间源版本 = 稳态时钟时间源版本;
};

struct 完整秒边界读取请求 final {
  std::uint32_t 合同版本 = 完整秒边界读取合同版本;
  std::uint64_t 运行代次 = 0;
  std::uint64_t 时间纪元身份 = 0;
  std::int64_t 上一已消费完整秒边界 = 0;
  std::uint32_t 期望时间源版本 = 稳态时钟时间源版本;
};

enum class 完整秒边界读取状态 : std::uint8_t {
  已读取 = 1,
  无新完整秒 = 2,
  请求拒绝 = 3,
  纪元错配 = 4,
  时间源版本漂移 = 5,
  时间倒退 = 6,
  计数不可表示 = 7,
  内部不一致 = 8
};

struct 完整秒边界观察 final {
  std::uint32_t 合同版本 = 完整秒边界读取合同版本;
  std::uint64_t 运行代次 = 0;
  std::uint64_t 时间纪元身份 = 0;
  std::int64_t 上一已消费完整秒边界 = 0;
  std::int64_t 当前完整秒边界 = 0;
  std::int64_t 当前经过纳秒 = 0;
  std::uint32_t 时间源版本 = 稳态时钟时间源版本;
};

struct 完整秒区间 final {
  std::int64_t 首个未消费完整秒边界 = 0;
  std::int64_t 最后完整秒边界 = 0;
  std::uint64_t 完整秒数量 = 0;
};

struct 完整秒边界读取结果 final {
  完整秒边界读取状态 状态 = 完整秒边界读取状态::请求拒绝;
  std::optional<完整秒边界观察> 观察;
  std::optional<完整秒区间> 区间;
};

class 完整秒时钟服务 final {
public:
  完整秒时钟服务(const 单调时钟适配器& 时间适配器,
                  完整秒时钟服务配置 配置) noexcept
      : 时间适配器_(时间适配器), 配置_(配置) {}

  完整秒时钟服务(const 完整秒时钟服务&) = delete;
  完整秒时钟服务& operator=(const 完整秒时钟服务&) = delete;
  完整秒时钟服务(完整秒时钟服务&&) = delete;
  完整秒时钟服务& operator=(完整秒时钟服务&&) = delete;

  完整秒边界读取结果 读取当前完整秒边界(
      const 完整秒边界读取请求& 请求) const noexcept {
    if (配置_.运行代次 == 0 || 配置_.时间纪元身份 == 0 ||
        配置_.时间源版本 != 稳态时钟时间源版本) {
      return {完整秒边界读取状态::内部不一致, std::nullopt,
              std::nullopt};
    }
    if (请求.合同版本 != 完整秒边界读取合同版本 ||
        请求.运行代次 == 0 || 请求.时间纪元身份 == 0 ||
        请求.期望时间源版本 == 0 ||
        请求.上一已消费完整秒边界 < 0) {
      return {完整秒边界读取状态::请求拒绝, std::nullopt,
              std::nullopt};
    }
    if (请求.运行代次 != 配置_.运行代次 ||
        请求.时间纪元身份 != 配置_.时间纪元身份) {
      return {完整秒边界读取状态::纪元错配, std::nullopt,
              std::nullopt};
    }
    if (请求.期望时间源版本 != 配置_.时间源版本) {
      return {完整秒边界读取状态::时间源版本漂移, std::nullopt,
              std::nullopt};
    }

    单调时间证据读取请求 时间请求;
    时间请求.运行代次 = 配置_.运行代次;
    时间请求.时间纪元身份 = 配置_.时间纪元身份;
    时间请求.期望时间源版本 = 配置_.时间源版本;
    const auto 时间结果 = 时间适配器_.读取可信单调时间证据(时间请求);
    if (时间结果.状态 == 单调时间证据读取状态::纪元错配) {
      return {完整秒边界读取状态::纪元错配, std::nullopt,
              std::nullopt};
    }
    if (时间结果.状态 == 单调时间证据读取状态::时间源版本漂移) {
      return {完整秒边界读取状态::时间源版本漂移, std::nullopt,
              std::nullopt};
    }
    if (时间结果.状态 == 单调时间证据读取状态::计数不可表示) {
      return {完整秒边界读取状态::计数不可表示, std::nullopt,
              std::nullopt};
    }
    if (时间结果.状态 != 单调时间证据读取状态::已读取 ||
        !时间结果.证据) {
      return {完整秒边界读取状态::内部不一致, std::nullopt,
              std::nullopt};
    }

    const auto& 时间证据 = *时间结果.证据;
    if (时间证据.合同版本 != 单调时间证据合同版本 ||
        时间证据.运行代次 != 配置_.运行代次 ||
        时间证据.时间纪元身份 != 配置_.时间纪元身份 ||
        时间证据.时间源版本 != 配置_.时间源版本 ||
        时间证据.从纪元起点经过纳秒 < 0) {
      return {完整秒边界读取状态::内部不一致, std::nullopt,
              std::nullopt};
    }

    const std::int64_t 当前完整秒边界 =
        时间证据.从纪元起点经过纳秒 / 1'000'000'000LL;
    if (当前完整秒边界 < 请求.上一已消费完整秒边界) {
      return {完整秒边界读取状态::时间倒退, std::nullopt,
              std::nullopt};
    }

    完整秒边界观察 观察;
    观察.运行代次 = 配置_.运行代次;
    观察.时间纪元身份 = 配置_.时间纪元身份;
    观察.上一已消费完整秒边界 = 请求.上一已消费完整秒边界;
    观察.当前完整秒边界 = 当前完整秒边界;
    观察.当前经过纳秒 = 时间证据.从纪元起点经过纳秒;
    观察.时间源版本 = 配置_.时间源版本;

    if (当前完整秒边界 == 请求.上一已消费完整秒边界) {
      return {完整秒边界读取状态::无新完整秒, 观察, std::nullopt};
    }

    完整秒区间 区间;
    区间.首个未消费完整秒边界 = 请求.上一已消费完整秒边界 + 1;
    区间.最后完整秒边界 = 当前完整秒边界;
    区间.完整秒数量 = static_cast<std::uint64_t>(
        当前完整秒边界 - 请求.上一已消费完整秒边界);
    return {完整秒边界读取状态::已读取, 观察, 区间};
  }

private:
  const 单调时钟适配器& 时间适配器_;
  const 完整秒时钟服务配置 配置_;
};

} // namespace 海中鱼巣
