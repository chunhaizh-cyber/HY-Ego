module;

#include <cstddef>
#include <cstdint>
#include <iostream>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.自检.L1场景结构;
import 海中鱼巣.领域.服务.L1场景结构;

export namespace 海中鱼巣 {

struct L1场景结构自检报告 final {
    std::vector<bool> 验收;
    std::size_t 失败数量 = 0;
    bool 总通过 = false;
};

L1场景结构自检报告 运行L1场景结构自检() {
    std::vector<bool> 验收;
    L1事实基座服务 L1;
    世界登记服务 登记服务(L1);
    L1场景结构服务 服务(L1, 登记服务);
    const auto 未加载 = 服务.创建初始场景({});
    验收.push_back(未加载.状态 == 世界结构状态::入口拒绝);
    世界登记建立请求 登记请求;
    登记请求.幂等身份 = {0x3000};
    const auto 登记结果 = 登记服务.建立空世界(登记请求);
    验收.push_back(登记结果.状态 == 世界登记状态::已提交);
    if (登记结果.登记) {
        初始场景创建请求 请求;
        请求.世界根.编码 = 登记结果.登记->世界根场景;
        请求.幂等身份 = {0x3010};
        请求.期望事实代次 = 1;
        const auto 首次 = 服务.创建初始场景(请求);
        验收.push_back(首次.状态 == 世界结构状态::已提交);
        const auto 重复 = 服务.创建初始场景(请求);
        验收.push_back(重复.状态 == 世界结构状态::幂等读回);
        auto 冲突 = 请求; 冲突.期望事实代次 = 3;
        const auto 冲突结果 = 服务.创建初始场景(冲突);
        验收.push_back(冲突结果.状态 == 世界结构状态::幂等冲突);
        auto 合同 = 请求; 合同.合同版本 = 1;
        验收.push_back(服务.创建初始场景(合同).状态 == 世界结构状态::入口拒绝);
        auto 根 = 请求; 根.世界根.编码 = 登记结果.登记->服务身份;
        验收.push_back(服务.创建初始场景(根).状态 == 世界结构状态::入口拒绝);
        auto 非初始 = 请求; 非初始.幂等身份 = {0x3020}; 非初始.期望事实代次 = 2;
        验收.push_back(服务.创建初始场景(非初始).状态 == 世界结构状态::入口拒绝);
        auto 旧代次 = 请求; 旧代次.幂等身份 = {0x3021}; 旧代次.期望事实代次 = 1;
        验收.push_back(服务.创建初始场景(旧代次).状态 == 世界结构状态::版本漂移);
        初始场景读取请求 读取请求;
        读取请求.世界根.编码 = 登记结果.登记->世界根场景;
        const auto 错误读取 = 服务.读取初始场景(读取请求);
        验收.push_back(错误读取.状态 == 世界结构状态::入口拒绝);
        读取请求.初始场景 = {7};
        读取请求.场景标记值 = {9};
        读取请求.直接父关系 = {8};
        const auto 独立读取 = 服务.读取初始场景(读取请求);
        验收.push_back(独立读取.状态 == 世界结构状态::已读取);
        auto 旧合同 = 请求; 旧合同.合同版本 = 1;
        验收.push_back(服务.创建初始场景(旧合同).状态 == 世界结构状态::入口拒绝);
        auto 越界身份 = 请求;
        越界身份.幂等身份 = {0x0100'0000'0000'0000ULL};
        验收.push_back(服务.创建初始场景(越界身份).状态 == 世界结构状态::入口拒绝);
    } else {
       验收.insert(验收.end(), 11, false);
    }
    验收.push_back(登记服务.读取当前登记().状态 == 世界登记状态::已读取
        && L1.读取完整快照().状态 == L1读取状态::成功);
    std::size_t 失败数量 = 0;
    for (const bool 通过 : 验收) if (!通过) ++失败数量;
    std::cout << "L1-SIMPLIFY-P1-S01 " << (失败数量 == 0 ? "通过" : "失败")
        << " checks=" << 验收.size() << " failed=" << 失败数量;
    for (std::size_t 索引 = 0; 索引 < 验收.size(); ++索引)
        if (!验收[索引]) std::cout << " failed#" << (索引 + 1);
    std::cout << '\n';
    return {std::move(验收), 失败数量, 失败数量 == 0};
}

} // namespace 海中鱼巣
