namespace 海中鱼巣::状态动态原子发布内部 {

inline constexpr std::uint64_t 状态动态原子发布私有幂等域 = 0x10ULL;

// P16-诊断责任：无适用错误分支；纯位运算形成服务私有中性幂等键。
L1中性写集幂等键 形成最终键(std::uint64_t 身份) noexcept {
    return {(状态动态原子发布私有幂等域 << 56) | 身份};
}

// P16-诊断责任：无适用错误分支；公开请求纯值合法性谓词。
bool 请求有效(const 状态动态原子发布请求& 请求) noexcept {
    return 请求.合同版本 == 状态动态原子发布合同版本
        && 请求.规则版本 == 状态动态原子发布规则版本
        && 请求.整理幂等身份 != 0
        && 请求.整理幂等身份 <= 0x00FF'FFFF'FFFF'FFFFULL
        && 请求.后状态.整理幂等身份 == 请求.整理幂等身份
        && 请求.后状态.合同版本 == L1状态合同版本
        && 请求.后状态.规则版本 == L1状态规则版本
        && 请求.后状态.规格版本 == I64后继状态规格版本
        && 请求.后状态.业务请求身份 != 0
        && 请求.后状态.新状态发生时间 != 0
        && 实际存在I64实例特征读取请求有效(请求.后状态.后当前);
}

// P16-诊断责任：无适用错误分支；逐字段比较完整公开请求，不依赖摘要或内存布局。
bool 公开请求相同(const 状态动态原子发布请求& 左,
    const 状态动态原子发布请求& 右) noexcept {
    const auto 节点身份相同 = [](const 世界结构节点身份见证& 左值,
        const 世界结构节点身份见证& 右值) noexcept {
        return 左值.编码 == 右值.编码 && 左值.类型 == 右值.类型;
    };
    const auto 场景相同 = [&](const 初始场景读取请求& 左值,
        const 初始场景读取请求& 右值) noexcept {
        return 左值.合同版本 == 右值.合同版本
            && 左值.世界规则版本 == 右值.世界规则版本
            && 节点身份相同(左值.世界根, 右值.世界根)
            && 左值.初始场景 == 右值.初始场景
            && 左值.场景标记值 == 右值.场景标记值
            && 左值.直接父关系 == 右值.直接父关系;
    };
    const auto 存在相同 = [&](const 实际存在读取请求& 左值,
        const 实际存在读取请求& 右值) noexcept {
        return 左值.合同版本 == 右值.合同版本
            && 左值.规则版本 == 右值.规则版本
            && 场景相同(左值.当前场景, 右值.当前场景)
            && 左值.存在 == 右值.存在
            && 左值.资格值 == 右值.资格值
            && 左值.当前场景归属关系 == 右值.当前场景归属关系;
    };
    const auto 定义相同 = [](const I64特征定义读取请求& 左值,
        const I64特征定义读取请求& 右值) noexcept {
        return 左值.合同版本 == 右值.合同版本
            && 左值.规则版本 == 右值.规则版本
            && 左值.特征定义 == 右值.特征定义
            && 左值.定义标记值 == 右值.定义标记值
            && 左值.下界值 == 右值.下界值
            && 左值.上界值 == 右值.上界值;
    };
    const auto 实例相同 = [&](const 实际存在I64实例特征读取请求& 左值,
        const 实际存在I64实例特征读取请求& 右值) noexcept {
        return 左值.合同版本 == 右值.合同版本
            && 左值.规则版本 == 右值.规则版本
            && 存在相同(左值.宿主, 右值.宿主)
            && 定义相同(左值.定义, 右值.定义)
            && 左值.实例槽 == 右值.实例槽
            && 左值.宿主关系 == 右值.宿主关系
            && 左值.定义关系 == 右值.定义关系
            && 左值.当前值 == 右值.当前值
            && 左值.来源节点 == 右值.来源节点;
    };
    const auto& 左后 = 左.后状态;
    const auto& 右后 = 右.后状态;
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.整理幂等身份 == 右.整理幂等身份
        && 左后.合同版本 == 右后.合同版本
        && 左后.规则版本 == 右后.规则版本
        && 左后.规格版本 == 右后.规格版本
        && 左后.业务请求身份 == 右后.业务请求身份
        && 左后.整理幂等身份 == 右后.整理幂等身份
        && 左后.新状态发生时间 == 右后.新状态发生时间
        && 实例相同(左后.后当前, 右后.后当前);
}

// P16-诊断责任：无适用错误分支；机械形成结构化非成功结果。
状态动态原子发布结果 失败(状态动态原子发布状态 状态,
    状态动态原子发布内部原因 原因 = 状态动态原子发布内部原因::无) noexcept {
    状态动态原子发布结果 结果;
    结果.状态 = 状态;
    结果.内部原因 = 原因;
    return 结果;
}

// P16-诊断责任：无适用错误分支；P13状态到P16状态的纯枚举映射。
状态动态原子发布状态 映射P13(I64后继状态规格状态 状态) noexcept {
    switch (状态) {
    case I64后继状态规格状态::无前状态: return 状态动态原子发布状态::无前状态;
    case I64后继状态规格状态::未找到: return 状态动态原子发布状态::未找到;
    case I64后继状态规格状态::冲突: return 状态动态原子发布状态::冲突;
    case I64后继状态规格状态::不可比较: return 状态动态原子发布状态::不可比较;
    case I64后继状态规格状态::版本漂移: return 状态动态原子发布状态::版本漂移;
    case I64后继状态规格状态::许可拒绝: return 状态动态原子发布状态::许可拒绝;
    case I64后继状态规格状态::资源失败: return 状态动态原子发布状态::资源失败;
    case I64后继状态规格状态::内部不一致: return 状态动态原子发布状态::内部不一致;
    default: return 状态动态原子发布状态::入口拒绝;
    }
}

// P16-诊断责任：无适用错误分支；P14状态到P16状态的纯枚举映射。
状态动态原子发布状态 映射P14(L1动态状态 状态) noexcept {
    switch (状态) {
    case L1动态状态::未找到: return 状态动态原子发布状态::未找到;
    case L1动态状态::幂等冲突: return 状态动态原子发布状态::冲突;
    case L1动态状态::版本漂移: return 状态动态原子发布状态::版本漂移;
    case L1动态状态::许可拒绝: return 状态动态原子发布状态::许可拒绝;
    case L1动态状态::资源失败: return 状态动态原子发布状态::资源失败;
    case L1动态状态::内部不一致: return 状态动态原子发布状态::内部不一致;
    default: return 状态动态原子发布状态::入口拒绝;
    }
}

// P16-诊断责任：无适用错误分支；中性L1状态到P16状态的纯枚举映射。
状态动态原子发布状态 映射中性写入(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
        return 状态动态原子发布状态::未找到;
    case L1中性写入状态::事实代次漂移:
        return 状态动态原子发布状态::版本漂移;
    case L1中性写入状态::幂等冲突:
        return 状态动态原子发布状态::冲突;
    case L1中性写入状态::资源失败:
        return 状态动态原子发布状态::资源失败;
    case L1中性写入状态::内部不一致:
        return 状态动态原子发布状态::内部不一致;
    default:
        return 状态动态原子发布状态::入口拒绝;
    }
}

// P16-诊断责任：向上送出；临时键组分配异常由公开入口统一映射。
bool 局部键精确(const L1写集请求& 写集, std::uint32_t 首键,
    std::uint32_t 末键, std::size_t 节点, std::size_t 值,
    std::size_t 关系, std::size_t 槽) {
    if (写集.节点.size() != 节点 || 写集.值.size() != 值
        || 写集.关系.size() != 关系 || 写集.属性槽变更.size() != 槽
        || !写集.退出事实.empty() || 写集.幂等键.值 != 0) return false;
    std::vector<std::uint32_t> 键;
    键.reserve(节点 + 值 + 关系);
    for (const auto& 项 : 写集.节点) 键.push_back(项.本地键.值);
    for (const auto& 项 : 写集.值) 键.push_back(项.本地键.值);
    for (const auto& 项 : 写集.关系) 键.push_back(项.本地键.值);
    std::sort(键.begin(), 键.end());
    if (键.size() != static_cast<std::size_t>(末键 - 首键 + 1)) return false;
    for (std::size_t i = 0; i < 键.size(); ++i)
        if (键[i] != 首键 + i) return false;
    return true;
}

// P16-诊断责任：无适用错误分支；只读判定P14角色5是否引用P13后状态本地键。
bool 动态后状态引用正确(const L1写集请求& 写集) noexcept {
    std::size_t 数量 = 0;
    for (const auto& 关系 : 写集.关系) {
        if (关系.本地键.值 != 0x4400000EU) continue;
        ++数量;
        const auto* 键 = std::get_if<写集本地键>(&关系.目标节点);
        if (!键 || 键->值 != 0x53000001U || 关系.角色或顺序 != 5) return false;
    }
    return 数量 == 1;
}

// P16-诊断责任：无适用错误分支；旧本地引用到中性本地引用的强类型转换。
std::optional<L1中性事实引用> 转换事实引用(const 事实引用& 引用) noexcept {
    return std::visit([](const auto& 值) -> std::optional<L1中性事实引用> {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, 稳定编码>) {
            if (!有效(值)) return std::nullopt;
            return L1中性事实引用{值};
        } else {
            if (值.值 == 0) return std::nullopt;
            return L1中性事实引用{L1中性写集本地键{值.值}};
        }
    }, 引用);
}

// P16-诊断责任：无适用错误分支；旧属性类型表示到中性表示的穷举转换。
std::optional<L1中性值表示种类> 转换值表示(值表示种类 表示) noexcept {
    switch (表示) {
    case 值表示种类::I64: return L1中性值表示种类::I64;
    case 值表示种类::I64组: return L1中性值表示种类::I64组;
    case 值表示种类::U64组: return L1中性值表示种类::U64组;
    case 值表示种类::独立材料引用: return L1中性值表示种类::独立材料引用;
    default: return std::nullopt;
    }
}

// P16-诊断责任：向上送出；组材料复制分配异常由公开入口统一映射。
std::optional<L1中性原始值材料> 转换材料(const 原始值材料& 材料) {
    std::optional<L1中性原始值材料> 结果;
    if (const auto* 值 = std::get_if<std::int64_t>(&材料)) 结果 = *值;
    else if (const auto* 值 = std::get_if<std::vector<std::int64_t>>(&材料)) 结果 = *值;
    else if (const auto* 值 = std::get_if<std::vector<std::uint64_t>>(&材料)) 结果 = *值;
    else if (const auto* 值 = std::get_if<独立材料引用>(&材料)) {
        if (!有效(值->编码)) return std::nullopt;
        结果 = L1中性独立材料引用{值->编码};
    }
    if (!结果 || !L1中性原始材料完整(*结果)) return std::nullopt;
    return 结果;
}

// P16-诊断责任：无适用错误分支；节点写项的机械强类型转换。
std::optional<L1中性节点新建项> 转换节点(const 节点新建项& 项) noexcept {
    if (项.本地键.值 == 0) return std::nullopt;
    std::optional<L1中性值表示种类> 表示;
    if (项.属性类型表示) {
        表示 = 转换值表示(*项.属性类型表示);
        if (!表示) return std::nullopt;
    }
    return L1中性节点新建项{{项.本地键.值}, 项.种类, 表示};
}

// P16-诊断责任：无适用错误分支；关系写项的机械强类型转换。
std::optional<L1中性关系新建项> 转换关系(const 关系新建项& 项) noexcept {
    if (项.本地键.值 == 0) return std::nullopt;
    const auto 源 = 转换事实引用(项.源节点);
    const auto 目标 = 转换事实引用(项.目标节点);
    const auto 类型 = 转换事实引用(项.关系类型节点);
    if (!源 || !目标 || !类型) return std::nullopt;
    return L1中性关系新建项{{项.本地键.值}, *源, *目标, *类型, 项.角色或顺序};
}

// P16-诊断责任：向上送出；值材料复制分配异常由公开入口统一映射。
std::optional<L1中性值新建项> 转换值(const 值新建项& 项) {
    if (项.本地键.值 == 0) return std::nullopt;
    const auto 所属 = 转换事实引用(项.所属节点);
    const auto 类型 = 转换事实引用(项.属性类型节点);
    const auto 来源 = 转换事实引用(项.来源节点);
    const auto 材料 = 转换材料(项.材料);
    if (!所属 || !类型 || !来源 || !材料) return std::nullopt;
    return L1中性值新建项{{项.本地键.值}, *所属, *类型, *材料, *来源};
}

// P16-诊断责任：无适用错误分支；属性槽写项的机械强类型转换。
std::optional<L1中性属性槽变更项> 转换属性槽(const 属性槽变更项& 项) noexcept {
    const auto 所属 = 转换事实引用(项.所属节点);
    const auto 类型 = 转换事实引用(项.属性类型节点);
    if (!所属 || !类型 || 项.新当前值.值 == 0) return std::nullopt;
    return L1中性属性槽变更项{*所属, *类型, {项.新当前值.值}};
}

// P16-诊断责任：向上送出；完整中性写集分配异常由公开入口统一映射。
std::optional<L1中性写集请求> 形成中性写集(
    const 实际存在I64后继状态写入规格& 状态规格,
    const std::optional<状态迁移动能写入规格>& 动态规格,
    L1中性写集幂等键 最终键) {
    if (状态规格.规格版本 != I64后继状态规格版本
        || 状态规格.事实截止代次 == 0
        || 状态规格.写集.期望事实代次 != 状态规格.事实截止代次
        || !局部键精确(状态规格.写集, 0x53000001U, 0x5300000CU, 2, 5, 5, 5))
        return std::nullopt;
    if (动态规格 && (动态规格->规格版本 != 状态迁移动能规格版本
        || 动态规格->事实截止代次 != 状态规格.事实截止代次
        || 动态规格->写集.期望事实代次 != 状态规格.事实截止代次
        || !局部键精确(动态规格->写集, 0x44000001U, 0x4400000FU, 1, 8, 6, 8)
        || !动态后状态引用正确(动态规格->写集))) return std::nullopt;

    L1中性写集请求 结果;
    结果.合同版本 = L1中性CRUD合同版本;
    结果.期望事实代次 = 状态规格.事实截止代次;
    结果.幂等键 = 最终键;
    const auto& 状态写集 = 状态规格.写集;
    const L1写集请求* 动态写集 = 动态规格 ? &动态规格->写集 : nullptr;
    结果.节点.reserve(状态写集.节点.size() + (动态写集 ? 动态写集->节点.size() : 0));
    结果.关系.reserve(状态写集.关系.size() + (动态写集 ? 动态写集->关系.size() : 0));
    结果.值.reserve(状态写集.值.size() + (动态写集 ? 动态写集->值.size() : 0));
    结果.属性槽变更.reserve(状态写集.属性槽变更.size()
        + (动态写集 ? 动态写集->属性槽变更.size() : 0));
    结果.退出事实.reserve(状态写集.退出事实.size()
        + (动态写集 ? 动态写集->退出事实.size() : 0));

    const auto 加入 = [&](const L1写集请求& 写集) -> bool {
        for (const auto& 项 : 写集.节点) {
            auto 中性 = 转换节点(项);
            if (!中性) return false;
            结果.节点.push_back(std::move(*中性));
        }
        for (const auto& 项 : 写集.关系) {
            auto 中性 = 转换关系(项);
            if (!中性) return false;
            结果.关系.push_back(std::move(*中性));
        }
        for (const auto& 项 : 写集.值) {
            auto 中性 = 转换值(项);
            if (!中性) return false;
            结果.值.push_back(std::move(*中性));
        }
        for (const auto& 项 : 写集.属性槽变更) {
            auto 中性 = 转换属性槽(项);
            if (!中性) return false;
            结果.属性槽变更.push_back(std::move(*中性));
        }
        for (const auto 身份 : 写集.退出事实) {
            if (!有效(身份)) return false;
            结果.退出事实.push_back(身份);
        }
        return true;
    };
    if (!加入(状态写集) || (动态写集 && !加入(*动态写集))) return std::nullopt;
    return 结果;
}

// P16-诊断责任：无适用错误分支；中性映射的完整、唯一和形状判定。
状态动态原子发布形状 判定中性映射形状(
    const std::vector<std::pair<L1中性写集本地键, 稳定编码>>& 映射) noexcept {
    std::array<std::uint32_t, 12> 状态{};
    std::array<std::uint32_t, 15> 动态{};
    for (std::size_t i = 0; i < 映射.size(); ++i) {
        const auto [键, 编码] = 映射[i];
        if (!有效(编码)) return 状态动态原子发布形状::无;
        for (std::size_t j = i + 1; j < 映射.size(); ++j)
            if (映射[j].first == 键 || 映射[j].second == 编码)
                return 状态动态原子发布形状::无;
        if (键.值 >= 0x53000001U && 键.值 <= 0x5300000CU)
            ++状态[键.值 - 0x53000001U];
        else if (键.值 >= 0x44000001U && 键.值 <= 0x4400000FU)
            ++动态[键.值 - 0x44000001U];
        else return 状态动态原子发布形状::无;
    }
    if (!std::all_of(状态.begin(), 状态.end(), [](auto 数量) { return 数量 == 1; }))
        return 状态动态原子发布形状::无;
    const bool 无动态 = std::all_of(动态.begin(), 动态.end(), [](auto 数量) { return 数量 == 0; });
    const bool 完整动态 = std::all_of(动态.begin(), 动态.end(), [](auto 数量) { return 数量 == 1; });
    return 无动态 ? 状态动态原子发布形状::仅后状态
        : 完整动态 ? 状态动态原子发布形状::后状态与迁移动能
        : 状态动态原子发布形状::无;
}

// P16-诊断责任：向上送出；临时旧映射分配异常由公开入口统一映射。
std::vector<std::pair<写集本地键, 稳定编码>> 形成领域读回映射(
    const std::vector<std::pair<L1中性写集本地键, 稳定编码>>& 映射) {
    std::vector<std::pair<写集本地键, 稳定编码>> 结果;
    结果.reserve(映射.size());
    for (const auto& [键, 编码] : 映射) 结果.push_back({{键.值}, 编码});
    return 结果;
}

} // namespace 海中鱼巣::状态动态原子发布内部

export namespace 海中鱼巣 {

class 状态动态原子发布服务 final {
private:
    enum class 发布阶段 : std::uint8_t { 提交中 = 1, 已发布待读回 = 2, 已发布 = 3 };

    struct 发布记录 final {
        状态动态原子发布请求 请求;
        L1中性写集请求 中性写集;
        std::vector<std::pair<L1中性写集本地键, 稳定编码>> 中性映射;
        std::uint64_t 首次发布事实代次 = 0;
        状态动态原子发布形状 形状 = 状态动态原子发布形状::无;
        std::optional<实际存在I64基准状态读取请求> 后状态读回请求;
        std::optional<状态迁移动能读取请求> 迁移动能读回请求;
        std::optional<状态动态原子发布首次见证> 首次见证;
        发布阶段 阶段 = 发布阶段::提交中;
    };

public:
    状态动态原子发布服务(
        L1事实基座服务& L1,
        L1实例特征服务& 实例特征,
        L1状态服务& 状态,
        特征比较服务& 比较,
        L1动态服务& 动态) noexcept
        : L1_(L1), 实例特征_(实例特征), 状态_(状态), 比较_(比较), 动态_(动态) {}

    状态动态原子发布服务(const 状态动态原子发布服务&) = delete;
    状态动态原子发布服务& operator=(const 状态动态原子发布服务&) = delete;

    // P16-诊断责任：向上送出；结构化结果是唯一公开责任边界。
    状态动态原子发布结果 发布实际存在I64后继状态与迁移动能(
        const 状态动态原子发布请求& 请求) {
        using namespace 状态动态原子发布内部;
        std::lock_guard<std::mutex> 锁(锁_);
        auto 记录位置 = 发布账_.end();
        bool 首次路径 = false;
        bool 已进入L1提交 = false;
        try {
            if (!请求有效(请求)) return 失败(状态动态原子发布状态::入口拒绝);
            const auto 最终键 = 形成最终键(请求.整理幂等身份);
            std::optional<L1中性写集请求> 重复写集;
            const L1中性写集请求* 本次写集 = nullptr;

            记录位置 = 发布账_.find(最终键.值);
            if (记录位置 != 发布账_.end()) {
                if (!公开请求相同(记录位置->second.请求, 请求))
                    return 失败(状态动态原子发布状态::冲突);
                if (记录位置->second.阶段 == 发布阶段::提交中)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::缓存记录矛盾);
                重复写集.emplace(记录位置->second.中性写集);
                本次写集 = &*重复写集;
            } else {
                const auto P13 = 形成实际存在I64后继状态规格(
                    L1_, 实例特征_, 状态_, 比较_, 请求.后状态);
                if (P13.状态 != I64后继状态规格状态::已形成)
                    return 失败(映射P13(P13.状态));
                if (!P13.状态规格 || !P13.迁移证据
                    || P13.状态规格->规格版本 != I64后继状态规格版本
                    || P13.状态规格->整理幂等身份 != 请求.整理幂等身份
                    || P13.状态规格->事实截止代次 == 0)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::上游状态规格矛盾);
                const bool 等价 = P13.迁移证据->等价;
                if (等价 != (P13.状态规格->动态准入 == 后继状态动态准入::禁止生成迁移动能))
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::上游状态规格矛盾);

                std::optional<状态迁移动能规格结果> P14;
                std::optional<状态迁移动能写入规格> 动态规格;
                if (!等价) {
                    P14 = 动态_.形成状态迁移动能规格(P13);
                    if (P14->状态 != L1动态状态::已形成)
                        return 失败(映射P14(P14->状态));
                    if (!P14->规格 || P14->规格->规格版本 != 状态迁移动能规格版本)
                        return 失败(状态动态原子发布状态::内部不一致,
                            状态动态原子发布内部原因::上游动态规格矛盾);
                    if (P14->规格->事实截止代次 != P13.状态规格->事实截止代次)
                        return 失败(状态动态原子发布状态::内部不一致,
                            状态动态原子发布内部原因::共同截止不一致);
                    动态规格 = *P14->规格;
                }

                auto 中性写集 = 形成中性写集(*P13.状态规格, 动态规格, 最终键);
                if (!中性写集)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::中性写集转换失败);
                发布记录 记录;
                记录.请求 = 请求;
                记录.中性写集 = std::move(*中性写集);
                记录.中性映射.reserve(等价 ? 12 : 27);
                记录.形状 = 等价 ? 状态动态原子发布形状::仅后状态
                    : 状态动态原子发布形状::后状态与迁移动能;
                auto [位置, 已插入] = 发布账_.try_emplace(最终键.值, std::move(记录));
                if (!已插入)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::缓存记录矛盾);
                记录位置 = 位置;
                首次路径 = true;
                本次写集 = &记录位置->second.中性写集;
            }

            已进入L1提交 = true;
            auto 写入 = L1_.提交中性写集(*本次写集);
            auto& 记录 = 记录位置->second;
            const bool 成功结果 = 写入.状态 == L1中性写入状态::成功
                || 写入.状态 == L1中性写入状态::精确重复;
            if (写入.是否形成内存权威发布 || 成功结果)
                记录.阶段 = 发布阶段::已发布待读回;

            if (!成功结果) {
                if (写入.是否形成内存权威发布)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::发布后隔离);
                const auto 状态 = 映射中性写入(写入.状态);
                if (首次路径) {
                    发布账_.erase(记录位置);
                    记录位置 = 发布账_.end();
                }
                return 失败(状态);
            }

            const auto 形状 = 判定中性映射形状(写入.新编码映射);
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 最终键
                || 写入.事实代次 == 0 || 形状 == 状态动态原子发布形状::无
                || 形状 != 记录.形状)
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::中性写入结果矛盾);
            if (写入.状态 == L1中性写入状态::成功) {
                if (!首次路径 || !写入.是否形成内存权威发布
                    || 写入.重试边界 != L1中性重试边界::不适用)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::中性写入结果矛盾);
            } else if (写入.是否形成内存权威发布
                || 写入.重试边界 != L1中性重试边界::原幂等键读回收敛) {
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::中性写入结果矛盾);
            }
            if (!首次路径 && 写入.状态 != L1中性写入状态::精确重复)
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::中性写入结果矛盾);

            if (记录.首次发布事实代次 == 0) {
                记录.首次发布事实代次 = 写入.事实代次;
                记录.中性映射 = std::move(写入.新编码映射);
            } else if (记录.首次发布事实代次 != 写入.事实代次
                || 记录.中性映射 != 写入.新编码映射) {
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::中性映射不完整);
            }

            if (!记录.后状态读回请求) {
                const auto 领域映射 = 形成领域读回映射(记录.中性映射);
                const auto 状态请求 = 状态_.从后继状态新编码映射形成读取请求(领域映射);
                if (状态请求.状态 != 后继状态读回请求形成状态::已形成 || !状态请求.请求)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::状态读回请求形成失败);
                记录.后状态读回请求 = *状态请求.请求;
                if (记录.形状 == 状态动态原子发布形状::后状态与迁移动能) {
                    const auto 动态请求 = 动态_.从迁移动能新编码映射形成读取请求(领域映射);
                    if (动态请求.状态 != 迁移动能读回请求形成状态::已形成 || !动态请求.请求)
                        return 失败(状态动态原子发布状态::内部不一致,
                            状态动态原子发布内部原因::动态读回请求形成失败);
                    记录.迁移动能读回请求 = *动态请求.请求;
                }
            }
            if (!记录.后状态读回请求
                || (记录.形状 == 状态动态原子发布形状::仅后状态
                    && 记录.迁移动能读回请求)
                || (记录.形状 == 状态动态原子发布形状::后状态与迁移动能
                    && !记录.迁移动能读回请求))
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::缓存记录矛盾);

            const auto 后状态 = 状态_.读取实际存在I64基准状态(*记录.后状态读回请求);
            if (后状态.状态 != L1基准状态状态::已读取 || !后状态.事实
                || 后状态.事实->状态.编码 != 记录.后状态读回请求->状态
                || 后状态.事实->状态.创建事实代次 != 记录.首次发布事实代次
                || 后状态.事实->读取事实截止代次 < 记录.首次发布事实代次)
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::状态权威读回矛盾);

            std::optional<状态迁移动能结果> 动态结果;
            if (记录.迁移动能读回请求) {
                动态结果 = 动态_.读取状态迁移动能(*记录.迁移动能读回请求);
                if (动态结果->状态 != L1动态状态::已读取 || !动态结果->事实
                    || 动态结果->事实->动态.编码 != 记录.迁移动能读回请求->动态
                    || 动态结果->事实->动态.创建事实代次 != 记录.首次发布事实代次
                    || 动态结果->事实->读取事实截止代次 < 记录.首次发布事实代次
                    || 动态结果->事实->后状态关系.目标节点 != 后状态.事实->状态.编码)
                    return 失败(状态动态原子发布状态::内部不一致,
                        状态动态原子发布内部原因::动态权威读回矛盾);
            }

            状态动态原子发布首次见证 本次见证;
            本次见证.整理幂等身份 = 请求.整理幂等身份;
            本次见证.发布事实代次 = 记录.首次发布事实代次;
            本次见证.形状 = 记录.形状;
            本次见证.后状态稳定身份 = 后状态.事实->状态.编码;
            if (动态结果) 本次见证.迁移动能稳定身份 = 动态结果->事实->动态.编码;
            if (记录.首次见证 && !(*记录.首次见证 == 本次见证))
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::缓存记录矛盾);
            记录.首次见证 = 本次见证;
            记录.阶段 = 发布阶段::已发布;

            状态动态原子发布结果 结果;
            结果.状态 = 写入.状态 == L1中性写入状态::精确重复
                ? 状态动态原子发布状态::幂等读回
                : 记录.形状 == 状态动态原子发布形状::仅后状态
                    ? 状态动态原子发布状态::已发布等价后状态
                    : 状态动态原子发布状态::已发布后状态与迁移动能;
            结果.来自精确重复 = 写入.状态 == L1中性写入状态::精确重复;
            结果.首次见证 = 本次见证;
            结果.后状态事实 = *后状态.事实;
            if (动态结果) 结果.迁移动能事实 = *动态结果->事实;
            return 结果;
        } catch (const std::bad_alloc&) {
            if (记录位置 != 发布账_.end()) {
                if (首次路径 && !已进入L1提交) {
                    发布账_.erase(记录位置);
                    记录位置 = 发布账_.end();
                } else if (已进入L1提交) {
                    记录位置->second.阶段 = 发布阶段::已发布待读回;
                }
            }
            return 失败(状态动态原子发布状态::资源失败);
        } catch (...) {
            if (记录位置 != 发布账_.end()) {
                if (首次路径 && !已进入L1提交) {
                    发布账_.erase(记录位置);
                    记录位置 = 发布账_.end();
                } else if (已进入L1提交) {
                    记录位置->second.阶段 = 发布阶段::已发布待读回;
                }
            }
            return 失败(状态动态原子发布状态::内部不一致);
        }
    }

private:
    L1事实基座服务& L1_;
    L1实例特征服务& 实例特征_;
    L1状态服务& 状态_;
    特征比较服务& 比较_;
    L1动态服务& 动态_;
    std::mutex 锁_;
    std::map<std::uint64_t, 发布记录> 发布账_;
};

} // namespace 海中鱼巣
