namespace 海中鱼巣::状态动态原子发布内部 {

using L1确定性编码内部::写U8;
using L1确定性编码内部::写U32;
using L1确定性编码内部::写U64;

// P16-诊断责任：无适用错误分支；纯位运算形成固定幂等域键。
写集幂等键 形成最终键(std::uint64_t 身份) noexcept {
    return {(状态动态原子发布幂等域 << 56) | 身份};
}

// P16-诊断责任：向上送出；编码或分配异常送至P16公开发布入口，最终由顺序400或未来合法消费者记录。
void 写节点身份(std::vector<std::uint8_t>& 出, const 世界结构节点身份见证& 见证) {
    写U64(出, 见证.编码.值);
    写U8(出, static_cast<std::uint8_t>(见证.类型));
}

// P16-诊断责任：向上送出；编码或分配异常送至P16公开发布入口，最终由顺序400或未来合法消费者记录。
void 写场景请求(std::vector<std::uint8_t>& 出, const 初始场景读取请求& 请求) {
    写U32(出, 请求.合同版本); 写U32(出, 请求.世界规则版本);
    写节点身份(出, 请求.世界根); 写U64(出, 请求.初始场景.值);
    写U64(出, 请求.场景标记值.值); 写U64(出, 请求.直接父关系.值);
}

// P16-诊断责任：向上送出；编码或分配异常送至P16公开发布入口，最终由顺序400或未来合法消费者记录。
void 写存在请求(std::vector<std::uint8_t>& 出, const 实际存在读取请求& 请求) {
    写U32(出, 请求.合同版本); 写U32(出, 请求.规则版本);
    写场景请求(出, 请求.当前场景); 写U64(出, 请求.存在.值);
    写U64(出, 请求.资格值.值); 写U64(出, 请求.当前场景归属关系.值);
}

// P16-诊断责任：向上送出；编码或分配异常送至P16公开发布入口，最终由顺序400或未来合法消费者记录。
void 写定义请求(std::vector<std::uint8_t>& 出, const I64特征定义读取请求& 请求) {
    写U32(出, 请求.合同版本); 写U32(出, 请求.规则版本);
    写U64(出, 请求.特征定义.值); 写U64(出, 请求.定义标记值.值);
    写U64(出, 请求.下界值.值); 写U64(出, 请求.上界值.值);
}

// P16-诊断责任：向上送出；编码或分配异常送至P16公开发布入口，最终由顺序400或未来合法消费者记录。
void 写实例请求(std::vector<std::uint8_t>& 出,
    const 实际存在I64实例特征读取请求& 请求) {
    写U32(出, 请求.合同版本); 写U32(出, 请求.规则版本);
    写存在请求(出, 请求.宿主); 写定义请求(出, 请求.定义);
    写U64(出, 请求.实例槽.值); 写U64(出, 请求.宿主关系.值);
    写U64(出, 请求.定义关系.值); 写U64(出, 请求.当前值.值);
    写U64(出, 请求.来源节点.值);
}

// P16-诊断责任：向上送出；异常映射为空摘要，由P16公开发布入口转为结构化资源失败。
std::optional<L1确定性摘要> 形成请求意图摘要(const 状态动态原子发布请求& 请求) {
    try {
        std::vector<std::uint8_t> 编码{'H','Z','Y','-','L','1','G','7'};
        写U32(编码, L1请求意图格式版本);
        写U32(编码, 状态动态原子发布操作标签);
        写U8(编码, 状态动态原子发布入口变体);
        写U32(编码, 请求.合同版本); 写U32(编码, 请求.规则版本);
        写U64(编码, 请求.整理幂等身份);
        写U32(编码, 请求.后状态.合同版本); 写U32(编码, 请求.后状态.规则版本);
        写U32(编码, 请求.后状态.规格版本); 写U64(编码, 请求.后状态.业务请求身份);
        写U64(编码, 请求.后状态.整理幂等身份);
        写U64(编码, 请求.后状态.新状态发生时间);
        写实例请求(编码, 请求.后状态.后当前);
        auto 摘要 = L1确定性编码内部::哈希(std::move(编码));
        return 完整(摘要) ? std::optional{摘要} : std::nullopt;
    } catch (...) {
        return std::nullopt;
    }
}

// P16-诊断责任：无适用错误分支；公开请求纯值合法性谓词。
bool 请求有效(const 状态动态原子发布请求& 请求) noexcept {
    return 请求.合同版本 == 状态动态原子发布合同版本
        && 请求.规则版本 == 状态动态原子发布规则版本
        && 请求.整理幂等身份 != 0
        && 请求.整理幂等身份 <= 0x00FF'FFFF'FFFF'FFFFULL
        && 请求.后状态.整理幂等身份 == 请求.整理幂等身份
        && 请求.后状态.合同版本 == L1状态合同版本
        && 请求.后状态.规则版本 == L1状态规则版本
        && 请求.后状态.规格版本 == I64后继状态规格版本
        && 请求.后状态.业务请求身份 != 0
        && 请求.后状态.新状态发生时间 != 0
        && 实际存在I64实例特征读取请求有效(请求.后状态.后当前);
}

// P16-诊断责任：无适用错误分支；机械形成结构化非成功结果，不记录合法拒绝。
状态动态原子发布结果 失败(状态动态原子发布状态 状态,
    状态动态原子发布内部原因 原因 = 状态动态原子发布内部原因::无,
    std::optional<L1失败见证身份> 见证 = std::nullopt) noexcept {
    状态动态原子发布结果 结果;
    结果.状态 = 状态; 结果.内部原因 = 原因; 结果.L1失败见证 = 见证;
    return 结果;
}

// P16-诊断责任：无适用错误分支；P13状态到P16状态的纯枚举映射。
状态动态原子发布状态 映射P13(I64后继状态规格状态 状态) noexcept {
    switch (状态) {
    case I64后继状态规格状态::无前状态: return 状态动态原子发布状态::无前状态;
    case I64后继状态规格状态::未找到: return 状态动态原子发布状态::未找到;
    case I64后继状态规格状态::冲突: return 状态动态原子发布状态::冲突;
    case I64后继状态规格状态::不可比较: return 状态动态原子发布状态::不可比较;
    case I64后继状态规格状态::版本漂移: return 状态动态原子发布状态::版本漂移;
    case I64后继状态规格状态::许可拒绝: return 状态动态原子发布状态::许可拒绝;
    case I64后继状态规格状态::资源失败: return 状态动态原子发布状态::资源失败;
    case I64后继状态规格状态::内部不一致: return 状态动态原子发布状态::内部不一致;
    default: return 状态动态原子发布状态::入口拒绝;
    }
}

// P16-诊断责任：无适用错误分支；P14状态到P16状态的纯枚举映射。
状态动态原子发布状态 映射P14(L1动态状态 状态) noexcept {
    switch (状态) {
    case L1动态状态::未找到: return 状态动态原子发布状态::未找到;
    case L1动态状态::幂等冲突: return 状态动态原子发布状态::冲突;
    case L1动态状态::版本漂移: return 状态动态原子发布状态::版本漂移;
    case L1动态状态::许可拒绝: return 状态动态原子发布状态::许可拒绝;
    case L1动态状态::资源失败: return 状态动态原子发布状态::资源失败;
    case L1动态状态::内部不一致: return 状态动态原子发布状态::内部不一致;
    default: return 状态动态原子发布状态::入口拒绝;
    }
}

// P16-诊断责任：无适用错误分支；L1写入状态到P16状态的纯枚举映射。
状态动态原子发布状态 映射L1(L1写入状态 状态) noexcept {
    switch (状态) {
    case L1写入状态::未找到: return 状态动态原子发布状态::未找到;
    case L1写入状态::幂等冲突: return 状态动态原子发布状态::冲突;
    case L1写入状态::事实代次漂移: return 状态动态原子发布状态::版本漂移;
    case L1写入状态::资源失败: return 状态动态原子发布状态::资源失败;
    case L1写入状态::内部不一致: return 状态动态原子发布状态::内部不一致;
    default: return 状态动态原子发布状态::入口拒绝;
    }
}

// P16-诊断责任：向上送出；临时键组分配异常送至P16公开发布入口，其余为结构化形状判定。
bool 局部键精确(const L1写集请求& 写集, std::uint32_t 首键,
    std::uint32_t 末键, std::size_t 节点, std::size_t 值,
    std::size_t 关系, std::size_t 槽) noexcept {
    if (写集.节点.size() != 节点 || 写集.值.size() != 值
        || 写集.关系.size() != 关系 || 写集.属性槽变更.size() != 槽
        || !写集.退出事实.empty() || 写集.幂等键.值 != 0) return false;
    std::vector<std::uint32_t> 键;
    键.reserve(节点 + 值 + 关系);
    for (const auto& 项 : 写集.节点) 键.push_back(项.本地键.值);
    for (const auto& 项 : 写集.值) 键.push_back(项.本地键.值);
    for (const auto& 项 : 写集.关系) 键.push_back(项.本地键.值);
    std::sort(键.begin(), 键.end());
    if (键.size() != static_cast<std::size_t>(末键 - 首键 + 1)) return false;
    for (std::size_t i = 0; i < 键.size(); ++i)
        if (键[i] != 首键 + i) return false;
    return true;
}

// P16-诊断责任：无适用错误分支；只读遍历并机械判定P14角色5引用。
bool 动态后状态引用正确(const L1写集请求& 写集) noexcept {
    std::size_t 数量 = 0;
    for (const auto& 关系 : 写集.关系)
        if (关系.本地键.值 == 0x4400000EU) {
            ++数量;
            const auto* 键 = std::get_if<写集本地键>(&关系.目标节点);
            if (!键 || 键->值 != 0x53000001U || 关系.角色或顺序 != 5) return false;
        }
    return 数量 == 1;
}

// P16-诊断责任：向上送出；形状矛盾返回空值，复制或扩容异常送至P16公开发布入口。
std::optional<L1写集请求> 合并写集(const 实际存在I64后继状态写入规格& 状态规格,
    const std::optional<状态迁移动能写入规格>& 动态规格, 写集幂等键 最终键,
    const L1领域意图凭证& 意图) {
    if (!局部键精确(状态规格.写集, 0x53000001U, 0x5300000CU, 2, 5, 5, 5))
        return std::nullopt;
    L1写集请求 结果 = 状态规格.写集;
    if (动态规格) {
        if (!局部键精确(动态规格->写集, 0x44000001U, 0x4400000FU, 1, 8, 6, 8)
            || !动态后状态引用正确(动态规格->写集)) return std::nullopt;
        结果.节点.insert(结果.节点.end(), 动态规格->写集.节点.begin(), 动态规格->写集.节点.end());
        结果.值.insert(结果.值.end(), 动态规格->写集.值.begin(), 动态规格->写集.值.end());
        结果.关系.insert(结果.关系.end(), 动态规格->写集.关系.begin(), 动态规格->写集.关系.end());
        结果.属性槽变更.insert(结果.属性槽变更.end(),
            动态规格->写集.属性槽变更.begin(), 动态规格->写集.属性槽变更.end());
    }
    结果.合同版本 = L1事实基座合同版本;
    结果.摘要合同版本 = L1幂等摘要合同版本;
    结果.幂等键 = 最终键;
    结果.领域意图凭证 = 意图;
    结果.请求意图摘要 = 意图.请求意图摘要;
    结果.执行证据摘要 = {};
    结果.发布后读回计划 = {};
    结果.执行证据材料 = std::nullopt;
    结果.领域结果见证计划 = std::nullopt;
    return 结果;
}

struct 事实候选 final { std::uint8_t 种类 = 0; 稳定编码 身份; L1事实副本 副本; };

// P16-诊断责任：无适用错误分支；事实副本变体与对象种类的纯谓词。
bool 副本种类匹配(std::uint8_t 种类, const L1事实副本& 副本) noexcept {
    return std::visit([&](const auto& 事实) {
        using T = std::decay_t<decltype(事实)>;
        if constexpr (std::is_same_v<T, 节点事实>) return 种类 == 1 && 事实.编码 != 稳定编码{};
        if constexpr (std::is_same_v<T, 关系事实>) return 种类 == 2 && 事实.编码 != 稳定编码{};
        return 种类 == 3 && 事实.编码 != 稳定编码{};
    }, 副本);
}

// P16-诊断责任：无适用错误分支；从强类型事实副本机械读取稳定身份。
稳定编码 副本身份(const L1事实副本& 副本) noexcept {
    return std::visit([](const auto& 事实) { return 事实.编码; }, 副本);
}

// P16-诊断责任：无适用错误分支；只读遍历写集和事实候选形成覆盖谓词。
bool 写集外部引用已覆盖(const L1写集请求& 写集,
    const std::vector<事实候选>& 组) noexcept {
    auto 有 = [&](稳定编码 身份) {
        return std::any_of(组.begin(), 组.end(), [&](const auto& 项) { return 项.身份 == 身份; });
    };
    auto 覆盖 = [&](const 事实引用& 引用) {
        const auto* 身份 = std::get_if<稳定编码>(&引用);
        return !身份 || 有(*身份);
    };
    for (const auto& 项 : 写集.关系)
        if (!覆盖(项.源节点) || !覆盖(项.目标节点) || !覆盖(项.关系类型节点)) return false;
    for (const auto& 项 : 写集.值)
        if (!覆盖(项.所属节点) || !覆盖(项.属性类型节点) || !覆盖(项.来源节点)) return false;
    for (const auto& 项 : 写集.属性槽变更)
        if (!覆盖(项.所属节点) || !覆盖(项.属性类型节点)) return false;
    return true;
}

// P16-诊断责任：向上送出；材料矛盾返回空值，复制、排序或扩容异常送至P16公开发布入口。
std::optional<L1执行证据材料> 形成执行证据材料(L1事实基座服务& L1,
    const 后继状态规格提供者证据凭证& PRE1,
    const std::optional<状态迁移动能规格提供者证据凭证>& PRE2,
    const L1写集请求& 写集, std::uint64_t 截止) {
    if (截止 == 0 || PRE1.共同事实截止代次 != 截止
        || PRE1.直接调用次数 != 1 || PRE1.去重后提供者见证数量 != 1
        || PRE1.写前事实身份组.size() != PRE1.写前事实副本组.size()
        || PRE1.去重后写前事实见证数量 != PRE1.写前事实身份组.size()) return std::nullopt;
    if (PRE2 && (PRE2->共同事实截止代次 != 截止 || PRE2->直接调用次数 != 1
        || PRE2->去重后提供者见证数量 != 1
        || PRE2->写前事实身份组.size() != PRE2->写前事实副本组.size()
        || PRE2->去重后写前事实见证数量 != PRE2->写前事实身份组.size())) return std::nullopt;
    std::vector<事实候选> 候选;
    auto 加PRE1 = [&] {
        for (std::size_t i = 0; i < PRE1.写前事实身份组.size(); ++i) {
            const auto& 身份 = PRE1.写前事实身份组[i];
            const auto 种类 = static_cast<std::uint8_t>(身份.种类);
            if (身份.观察事实代次 != 截止 || 身份.身份 != 副本身份(PRE1.写前事实副本组[i])
                || !副本种类匹配(种类, PRE1.写前事实副本组[i])) return false;
            候选.push_back({种类, 身份.身份, PRE1.写前事实副本组[i]});
        }
        return true;
    };
    if (!加PRE1()) return std::nullopt;
    if (PRE2) for (std::size_t i = 0; i < PRE2->写前事实身份组.size(); ++i) {
        const auto& 身份 = PRE2->写前事实身份组[i];
        const auto 种类 = static_cast<std::uint8_t>(身份.种类);
        if (身份.观察事实代次 != 截止 || 身份.身份 != 副本身份(PRE2->写前事实副本组[i])
            || !副本种类匹配(种类, PRE2->写前事实副本组[i])) return std::nullopt;
        候选.push_back({种类, 身份.身份, PRE2->写前事实副本组[i]});
    }
    std::sort(候选.begin(), 候选.end(), [](const auto& 左, const auto& 右) {
        return 左.种类 != 右.种类 ? 左.种类 < 右.种类 : 左.身份 < 右.身份;
    });
    std::vector<事实候选> 去重;
    for (auto& 项 : 候选) {
        if (!去重.empty() && 去重.back().种类 == 项.种类 && 去重.back().身份 == 项.身份) {
            if (!(去重.back().副本 == 项.副本)) return std::nullopt;
            continue;
        }
        if (!去重.empty() && 去重.back().身份 == 项.身份 && 去重.back().种类 != 项.种类)
            return std::nullopt;
        去重.push_back(std::move(项));
    }
    if (去重.empty() || !写集外部引用已覆盖(写集, 去重)) return std::nullopt;
    const auto L1身份 = L1.读取提供者身份();
    L1执行证据材料 材料;
    材料.执行证据模式 = L1执行证据模式::事实互证;
    材料.业务操作标签 = 状态动态原子发布操作标签;
    材料.幂等键 = 写集.幂等键;
    材料.共同事实截止代次 = 截止;
    材料.提供者版本组 = {
        {PRE1.直接提供者.稳定身份, PRE1.直接提供者.合同版本,
            PRE1.直接提供者.规则版本, PRE1.直接调用次数},
        {L1身份.稳定身份, L1身份.合同版本, L1身份.规则版本, 1}};
    if (PRE2) 材料.提供者版本组.push_back({PRE2->直接提供者.稳定身份,
        PRE2->直接提供者.合同版本, PRE2->直接提供者.规则版本,
        PRE2->直接调用次数});
    std::sort(材料.提供者版本组.begin(), 材料.提供者版本组.end(),
        [](const auto& 左, const auto& 右) { return 左.提供者身份 < 右.提供者身份; });
    for (const auto& 项 : 去重)
        材料.写前事实见证组.push_back({项.种类, 项.身份, 截止,
            形成L1写前事实摘要(项.副本)});
    return 材料;
}

// P16-诊断责任：无适用错误分支；只读映射计数形成纯形状判定。
状态动态原子发布形状 从映射判定形状(
    const std::vector<std::pair<写集本地键, 稳定编码>>& 映射) noexcept {
    std::array<std::uint32_t, 12> 状态{};
    std::array<std::uint32_t, 15> 动态{};
    for (const auto& [键, 编码] : 映射) {
        if (!有效(编码)) return 状态动态原子发布形状::无;
        if (键.值 >= 0x53000001U && 键.值 <= 0x5300000CU) ++状态[键.值 - 0x53000001U];
        else if (键.值 >= 0x44000001U && 键.值 <= 0x4400000FU) ++动态[键.值 - 0x44000001U];
        else return 状态动态原子发布形状::无;
    }
    if (!std::all_of(状态.begin(), 状态.end(), [](auto 数量) { return 数量 == 1; }))
        return 状态动态原子发布形状::无;
    const bool 无动态 = std::all_of(动态.begin(), 动态.end(), [](auto 数量) { return 数量 == 0; });
    const bool 完整动态 = std::all_of(动态.begin(), 动态.end(), [](auto 数量) { return 数量 == 1; });
    return 无动态 ? 状态动态原子发布形状::仅后状态
        : 完整动态 ? 状态动态原子发布形状::后状态与迁移动能
        : 状态动态原子发布形状::无;
}

// P16-诊断责任：向上送出；所有者读回矛盾转为结构化内部不一致，异常送至P16公开发布入口。
状态动态原子发布结果 完成领域读回(L1状态服务& 状态, L1动态服务& 动态,
    const L1确定性摘要& 请求摘要, const L1确定性摘要& 执行摘要,
    const L1写入结果& L1结果, bool 重复, std::uint64_t P13摘要,
    std::optional<std::uint64_t> P14摘要) {
    if (L1结果.事实代次 == 0 || !完整(执行摘要) || !完整(L1结果.确定性结果摘要)
        || L1结果.发布后读回.状态 != L1通用发布后读回状态::成功
        || L1结果.发布后读回.发布事实代次 != L1结果.事实代次)
        return 失败(状态动态原子发布状态::内部不一致,
            状态动态原子发布内部原因::幂等首次证据不完整, L1结果.失败见证身份);
    const auto 形状 = 从映射判定形状(L1结果.新编码映射);
    if (形状 == 状态动态原子发布形状::无)
        return 失败(状态动态原子发布状态::内部不一致,
            状态动态原子发布内部原因::L1映射不完整, L1结果.失败见证身份);
    const auto 状态请求 = 状态.从后继状态新编码映射形成读取请求(L1结果.新编码映射);
    if (状态请求.状态 != 后继状态读回请求形成状态::已形成 || !状态请求.请求)
        return 失败(状态动态原子发布状态::内部不一致,
            状态动态原子发布内部原因::状态读取请求映射失败, L1结果.失败见证身份);
    const auto 后状态 = 状态.读取实际存在I64基准状态(*状态请求.请求);
    if (后状态.状态 != L1基准状态状态::已读取 || !后状态.事实
        || 后状态.事实->状态.创建事实代次 != L1结果.事实代次)
        return 失败(状态动态原子发布状态::内部不一致,
            状态动态原子发布内部原因::状态领域读回矛盾, L1结果.失败见证身份);
    std::optional<迁移动能读回请求形成结果> 动态请求;
    std::optional<状态迁移动能结果> 动态结果;
    if (形状 == 状态动态原子发布形状::后状态与迁移动能) {
        动态请求 = 动态.从迁移动能新编码映射形成读取请求(L1结果.新编码映射);
        if (动态请求->状态 != 迁移动能读回请求形成状态::已形成 || !动态请求->请求)
            return 失败(状态动态原子发布状态::内部不一致,
                状态动态原子发布内部原因::动态读取请求映射失败, L1结果.失败见证身份);
        动态结果 = 动态.读取状态迁移动能(*动态请求->请求);
        if (动态结果->状态 != L1动态状态::已读取 || !动态结果->事实
            || 动态结果->事实->动态.创建事实代次 != L1结果.事实代次
            || 动态结果->事实->后状态关系.目标节点 != 后状态.事实->状态.编码)
            return 失败(状态动态原子发布状态::内部不一致,
                状态动态原子发布内部原因::动态领域读回矛盾, L1结果.失败见证身份);
    }
    状态动态原子发布首次证据 首次;
    首次.最终幂等键 = L1结果.状态 == L1写入状态::成功 || L1结果.状态 == L1写入状态::精确重复
        ? 0 : 0;
    首次.请求意图摘要 = 请求摘要;
    首次.首次执行证据摘要 = 执行摘要;
    首次.L1确定性结果摘要 = L1结果.确定性结果摘要;
    首次.发布事实代次 = L1结果.事实代次;
    首次.形状 = 形状;
    首次.新编码映射 = L1结果.新编码映射;
    首次.L1完整读回 = L1结果.发布后读回;
    首次.后状态读取请求 = *状态请求.请求;
    if (动态请求) 首次.迁移动能读取请求 = *动态请求->请求;
    首次.P13确定性摘要 = P13摘要;
    首次.P14确定性摘要 = P14摘要;
    状态动态原子发布结果 结果;
    结果.状态 = 重复 ? 状态动态原子发布状态::幂等读回
        : 形状 == 状态动态原子发布形状::仅后状态
            ? 状态动态原子发布状态::已发布等价后状态
            : 状态动态原子发布状态::已发布后状态与迁移动能;
    结果.来自精确重复 = 重复;
    结果.首次证据 = std::move(首次);
    结果.后状态事实 = *后状态.事实;
    if (动态结果) 结果.迁移动能事实 = *动态结果->事实;
    结果.L1失败见证 = L1结果.失败见证身份;
    return 结果;
}

// P16-诊断责任：向上送出；探测首次结果复制异常送至P16公开发布入口。
L1写入结果 从探测形成结果(const L1幂等探测结果& 探测) {
    return 映射L1幂等探测(探测);
}

} // namespace 海中鱼巣::状态动态原子发布内部

export namespace 海中鱼巣 {

class 状态动态原子发布服务 final {
public:
    状态动态原子发布服务(
        L1事实基座服务& L1,
        L1实例特征服务& 实例特征,
        L1状态服务& 状态,
        特征比较服务& 比较,
        L1动态服务& 动态) noexcept
        : L1_(L1), 实例特征_(实例特征), 状态_(状态), 比较_(比较), 动态_(动态) {}

    状态动态原子发布服务(const 状态动态原子发布服务&) = delete;
    状态动态原子发布服务& operator=(const 状态动态原子发布服务&) = delete;

    // P16-诊断责任：向上送出；最终责任边界为公开结构化结果或未来合法消费者。
    状态动态原子发布结果 发布实际存在I64后继状态与迁移动能(
        const 状态动态原子发布请求& 请求) {
    using namespace 状态动态原子发布内部;
    if (!请求有效(请求)) return 失败(状态动态原子发布状态::入口拒绝);
    try {
        const auto 请求摘要 = 形成请求意图摘要(请求);
        if (!请求摘要) return 失败(状态动态原子发布状态::资源失败);
        const auto 最终键 = 形成最终键(请求.整理幂等身份);
        const L1领域意图凭证 意图{状态动态原子发布意图组,
            L1请求意图格式版本, 状态动态原子发布操作标签, *请求摘要, {}};
        const auto 探测 = L1_.探测幂等({L1事实基座合同版本,
            L1幂等摘要合同版本, 最终键, *请求摘要, 意图});
        if (探测.状态 == L1幂等探测状态::同义已发布) {
            if (!探测.首次结果) return 失败(状态动态原子发布状态::内部不一致,
                状态动态原子发布内部原因::幂等首次证据不完整);
            auto L1结果 = 从探测形成结果(探测);
            auto 结果 = 完成领域读回(状态_, 动态_, *请求摘要,
                探测.首次结果->首次执行证据摘要, L1结果, true, 0, std::nullopt);
            if (结果.首次证据) 结果.首次证据->最终幂等键 = 最终键.值;
            return 结果;
        }
        if (探测.状态 == L1幂等探测状态::异义冲突)
            return 失败(状态动态原子发布状态::冲突);
        if (探测.状态 == L1幂等探测状态::已隔离)
            return 失败(状态动态原子发布状态::许可拒绝);
        if (探测.状态 == L1幂等探测状态::内部不一致)
            return 失败(状态动态原子发布状态::内部不一致);
        if (探测.状态 != L1幂等探测状态::未找到)
            return 失败(状态动态原子发布状态::入口拒绝);

        const auto P13 = 形成实际存在I64后继状态规格(
            L1_, 实例特征_, 状态_, 比较_, 请求.后状态);
        if (P13.状态 != I64后继状态规格状态::已形成) return 失败(映射P13(P13.状态));
        if (!P13.状态规格 || !P13.迁移证据 || !P13.提供者证据
            || P13.状态规格->事实截止代次 == 0 || P13.状态规格->确定性摘要 == 0)
            return 失败(状态动态原子发布状态::内部不一致,
                状态动态原子发布内部原因::P13坏成功);
        const bool 等价 = P13.迁移证据->等价;
        if (等价 != (P13.状态规格->动态准入 == 后继状态动态准入::禁止生成迁移动能))
            return 失败(状态动态原子发布状态::内部不一致,
                状态动态原子发布内部原因::P13坏成功);
        std::optional<状态迁移动能规格结果> P14;
        std::optional<状态迁移动能写入规格> 动态规格;
        std::optional<状态迁移动能规格提供者证据凭证> PRE2;
        if (!等价) {
            P14 = 动态_.形成状态迁移动能规格(P13);
            if (P14->状态 != L1动态状态::已形成) return 失败(映射P14(P14->状态));
            if (!P14->规格 || !P14->提供者证据 || P14->规格->确定性摘要 == 0)
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::P14坏成功);
            if (P14->规格->事实截止代次 != P13.状态规格->事实截止代次)
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::规格截止不一致);
            动态规格 = *P14->规格;
            PRE2 = *P14->提供者证据;
        }
        auto 写集 = 合并写集(*P13.状态规格, 动态规格, 最终键, 意图);
        if (!写集) return 失败(状态动态原子发布状态::内部不一致,
            状态动态原子发布内部原因::局部键冲突);
        auto 材料 = 形成执行证据材料(L1_, *P13.提供者证据, PRE2, *写集,
            P13.状态规格->事实截止代次);
        if (!材料) return 失败(状态动态原子发布状态::内部不一致,
            状态动态原子发布内部原因::执行证据材料不完整);
        写集->执行证据材料 = std::move(*材料);
        const auto L1结果 = L1_.提交写集(*写集, 状态动态原子发布操作标签);
        if (L1结果.状态 != L1写入状态::成功 && L1结果.状态 != L1写入状态::精确重复)
            return 失败(映射L1(L1结果.状态), 状态动态原子发布内部原因::无,
                L1结果.失败见证身份);
        L1确定性摘要 首次执行摘要 = 写集->执行证据摘要;
        bool 重复 = L1结果.状态 == L1写入状态::精确重复;
        if (重复) {
            const auto 胜者 = L1_.探测幂等({L1事实基座合同版本,
                L1幂等摘要合同版本, 最终键, *请求摘要, 意图});
            if (胜者.状态 != L1幂等探测状态::同义已发布 || !胜者.首次结果)
                return 失败(状态动态原子发布状态::内部不一致,
                    状态动态原子发布内部原因::幂等首次证据不完整);
            首次执行摘要 = 胜者.首次结果->首次执行证据摘要;
        }
        auto 结果 = 完成领域读回(状态_, 动态_, *请求摘要, 首次执行摘要,
            L1结果, 重复, 重复 ? 0 : P13.状态规格->确定性摘要,
            重复 || !P14 ? std::nullopt : std::optional{P14->规格->确定性摘要});
        if (结果.首次证据) 结果.首次证据->最终幂等键 = 最终键.值;
        return 结果;
    } catch (const std::bad_alloc&) {
        return 失败(状态动态原子发布状态::资源失败);
    } catch (...) {
        return 失败(状态动态原子发布状态::内部不一致);
    }
    }

private:
    L1事实基座服务& L1_;
    L1实例特征服务& 实例特征_;
    L1状态服务& 状态_;
    特征比较服务& 比较_;
    L1动态服务& 动态_;
};

} // namespace 海中鱼巣
