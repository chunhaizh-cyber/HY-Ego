    std::uint32_t 合同版本 = 方法类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    方法类记录身份 方法;
    std::uint64_t 最大结果方向数量 = 0;
    friend bool operator==(const 方法类结果方向组读取请求&,
        const 方法类结果方向组读取请求&) = default;
};

struct 方法类结果方向结果 final {
    方法类数据状态 状态 = 方法类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 方法类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<方法类结果方向项> 结果方向项;
    bool 成功() const noexcept {
        return (状态 == 方法类数据状态::已添加结果方向项
                || 状态 == 方法类数据状态::精确重复)
            && 合同版本 == 方法类数据合同版本 && 事实代次 != 0
            && 结果方向项 && 有效(结果方向项->身份.值)
            && 有效(结果方向项->方法.值)
            && 有效(结果方向项->行动变化方向.值)
            && 有效(结果方向项->结果方向.值)
            && 有效(结果方向项->方法结果方向关系)
            && 有效(结果方向项->结果行动方向关系)
            && 方法类结果方向项完整(*结果方向项, 事实代次);
    }
    friend bool operator==(const 方法类结果方向结果&,
        const 方法类结果方向结果&) = default;
};

struct 方法类结果方向组结果 final {
    方法类数据状态 状态 = 方法类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 方法类数据合同版本;
    std::uint64_t 事实代次 = 0;
    方法类记录身份 方法;
    std::vector<方法类结果方向项> 结果方向组;
    bool 成功() const noexcept {
        if (状态 != 方法类数据状态::已读取结果方向组
            || 合同版本 != 方法类数据合同版本 || 事实代次 == 0
            || !有效(方法.值)
            || !std::all_of(结果方向组.begin(), 结果方向组.end(),
                [this](const auto& 项) noexcept {
                    return 项.方法 == 方法
                        && 方法类结果方向项完整(项, 事实代次);
                })
            || !std::is_sorted(结果方向组.begin(), 结果方向组.end(), 结果小于))
            return false;
        for (std::size_t i = 1; i < 结果方向组.size(); ++i)
            if (结果方向组[i - 1].行动变化方向 == 结果方向组[i].行动变化方向
                && 结果方向组[i - 1].结果方向 == 结果方向组[i].结果方向)
                return false;
        return true;
    }
    friend bool operator==(const 方法类结果方向组结果&,
        const 方法类结果方向组结果&) = default;
private:
    static bool 结果小于(const 方法类结果方向项& 左,
        const 方法类结果方向项& 右) noexcept {
        if (左.行动变化方向.值 != 右.行动变化方向.值)
            return 左.行动变化方向.值 < 右.行动变化方向.值;
        if (左.结果方向.值 != 右.结果方向.值)
            return 左.结果方向.值 < 右.结果方向.值;
        return 左.身份.值 < 右.身份.值;
    }
};

class 方法类数据服务 final {
public:
    方法类数据服务() = delete;
    方法类数据服务(const 方法类数据服务&) = delete;
    方法类数据服务& operator=(const 方法类数据服务&) = delete;
    方法类数据服务(方法类数据服务&&) = delete;
    方法类数据服务& operator=(方法类数据服务&&) = delete;

    方法类数据服务(const L1事实基座服务& 第一层服务,
        const 特征类数据服务& 特征服务,
        const 二次特征类数据服务& 二次特征服务,
        const 存在类数据服务& 存在服务,
        L1所有者范围写端口&& 写入端口, 方法类结构类型 结构类型)
        : 第一层服务_(第一层服务), 特征服务_(特征服务),
          二次特征服务_(二次特征服务), 存在服务_(存在服务),
          写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()), 结构类型_(结构类型) {
        const std::vector<稳定编码> 类型组{结构类型_.方法来源关系类型,
            结构类型_.方法虚拟存在关系类型,
            结构类型_.方法条件关系类型, 结构类型_.条件特征关系类型,
            结构类型_.方法结果方向关系类型,
            结构类型_.结果行动方向关系类型,
            结构类型_.结果结果方向关系类型};
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !有效(所有者_) || std::any_of(类型组.begin(), 类型组.end(),
                [](稳定编码 值) noexcept { return !有效(值); }))
            throw std::invalid_argument("invalid method data configuration");
        auto 排序 = 类型组;
        std::sort(排序.begin(), 排序.end());
        if (std::adjacent_find(排序.begin(), 排序.end()) != 排序.end())
            throw std::invalid_argument("duplicate method relation types");
        const auto 所有者 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者.状态 != L1所有者范围读取状态::成功
            || 所有者.合同版本 != L1所有者范围CRUD合同版本
            || !所有者.所有者事实 || 所有者.所有者事实->所有者 != 所有者_
            || 所有者.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 所有者.所有者事实->创建事实代次 == 0
            || 所有者.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid method data owner");
        for (const auto 类型 : 类型组) {
            const auto 读取 = 第一层服务_.读取所有者范围当前节点(
                {L1所有者范围CRUD合同版本, 类型});
            const auto* 节点 = 读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || !节点 || 节点->编码 != 类型 || 节点->写入所有者 != 所有者_
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 == 0 || 节点->退出事实代次
                || !节点->当前属性.empty())
                throw std::invalid_argument("invalid method relation type");
        }
    }

    方法类记录结果 新增方法记录(const 方法类新增请求& 请求) {
        if (请求.合同版本 != 方法类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.幂等身份) || !有效(请求.来源节点)
            || 请求.最大同源候选数量 == 0)
            return 记录失败(方法类数据状态::入口拒绝);
        try {
            if (const auto e = 检查代次(请求.期望事实代次))
                return 记录失败(e->状态, e->事实代次);
            if (const auto e = 验证普通节点(请求.来源节点,
                    请求.期望事实代次, true))
                return 记录失败(*e, 请求.期望事实代次);
            const auto 写集 = 形成基础写集(请求);
            if (const auto 重放 = 尝试基础重放(请求, 写集)) return *重放;
            const auto 已有 = 按来源节点精确查询({方法类数据合同版本,
                请求.期望事实代次, 请求.来源节点, 请求.最大同源候选数量,
                std::numeric_limits<std::uint64_t>::max(),
                std::numeric_limits<std::uint64_t>::max()});
            if (已有.成功())
                return 记录失败(方法类数据状态::精确记录已存在, 已有.事实代次);
            if (已有.状态 != 方法类数据状态::未找到) return 已有;
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态, 方法类数据状态::已创建);
            if (状态 != 方法类数据状态::已创建
                && 状态 != 方法类数据状态::精确重复)
                return 记录失败(状态, 写入.事实代次);
            if (!写入头完整(写入, 请求.幂等身份))
                return 记录失败(写入.是否形成内存权威发布
                    ? 方法类数据状态::已可能发布
                    : 方法类数据状态::内部不一致, 写入.事实代次);
            return 从基础写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) { return 记录失败(方法类数据状态::资源失败); }
        catch (const std::length_error&) { return 记录失败(方法类数据状态::资源失败); }
        catch (...) { return 记录失败(方法类数据状态::内部不一致); }
    }

    方法类记录结果 查询方法记录(const 方法类身份查询请求& 请求) const {
        if (请求.合同版本 != 方法类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.方法.值) || 请求.最大条件数量 == 0
            || 请求.最大结果方向数量 == 0)
            return 记录失败(方法类数据状态::入口拒绝);
        try {
            auto 结果 = 读取基础记录(请求.方法, 请求.期望事实代次);
            if (!结果.成功() || !结果.记录) return 结果;
            const auto Vm = 存在服务_.查询方法虚拟存在(
                {方法虚拟存在专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.方法.值,
                    结构类型_.方法虚拟存在关系类型});
            if (Vm.状态 == 方法虚拟存在专用状态::已读取 && Vm.成功())
                结果.记录->虚拟存在 = Vm.投影;
            else if (Vm.状态 != 方法虚拟存在专用状态::未初始化)
                return 记录失败(映射Vm状态(Vm.状态), Vm.事实代次);
            const auto 条件 = 读取条件内部(请求.方法, 请求.期望事实代次,
                请求.最大条件数量);
            if (!条件.成功()) return 记录失败(条件.状态, 条件.事实代次);
            const auto 方向 = 读取结果内部(请求.方法, 请求.期望事实代次,
                请求.最大结果方向数量);
            if (!方向.成功()) return 记录失败(方向.状态, 方向.事实代次);
            结果.记录->条件组 = 条件.条件组;
            结果.记录->结果方向组 = 方向.结果方向组;
            if (const auto e = 检查代次(请求.期望事实代次))
                return 记录失败(e->状态, e->事实代次);
            return 结果;
        } catch (const std::bad_alloc&) { return 记录失败(方法类数据状态::资源失败); }
        catch (const std::length_error&) { return 记录失败(方法类数据状态::资源失败); }
        catch (...) { return 记录失败(方法类数据状态::内部不一致); }
    }

    方法类记录结果 按来源节点精确查询(const 方法类精确查询请求& 请求) const {
        if (请求.合同版本 != 方法类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.来源节点) || 请求.最大候选数量 == 0
            || 请求.最大条件数量 == 0 || 请求.最大结果方向数量 == 0)
            return 记录失败(方法类数据状态::入口拒绝);
        try {
            if (const auto e = 检查代次(请求.期望事实代次))
                return 记录失败(e->状态, e->事实代次);
            if (const auto e = 验证普通节点(请求.来源节点,
                    请求.期望事实代次, true))
                return 记录失败(*e, 请求.期望事实代次);
            const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
                {L1所有者范围CRUD合同版本, 请求.来源节点,
                    结构类型_.方法来源关系类型});
            if (读取.读取事实代次 != 请求.期望事实代次)
                return 记录失败(方法类数据状态::事实代次漂移,
                    读取.读取事实代次);
            if (读取.状态 != L1所有者范围读取状态::成功)
                return 记录失败(映射L1读取状态(读取.状态), 读取.读取事实代次);
            if (读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.目标节点 != 请求.来源节点
                || 读取.关系类型节点 != 结构类型_.方法来源关系类型)
                return 记录失败(方法类数据状态::内部不一致, 读取.读取事实代次);
            if (读取.关系组.size() > 请求.最大候选数量)
                return 记录失败(方法类数据状态::数量预算不足, 读取.读取事实代次);
            if (读取.关系组.empty())
                return 记录失败(方法类数据状态::未找到, 请求.期望事实代次);
            if (读取.关系组.size() != 1)
                return 记录失败(方法类数据状态::内部不一致, 请求.期望事实代次);
            const auto& 关系 = 读取.关系组.front();
            if (!关系有效(关系, 关系.源节点, 请求.来源节点,
                    结构类型_.方法来源关系类型, std::nullopt)
                || 关系.创建事实代次 > 请求.期望事实代次)
                return 记录失败(方法类数据状态::内部不一致, 请求.期望事实代次);
            auto 结果 = 查询方法记录({方法类数据合同版本, 请求.期望事实代次,
                {关系.源节点}, 请求.最大条件数量, 请求.最大结果方向数量});
            if (!结果.成功() || !结果.记录) return 结果;
            if (结果.记录->来源节点 != 请求.来源节点)
                return 记录失败(方法类数据状态::内部不一致, 结果.事实代次);
            return 结果;
        } catch (const std::bad_alloc&) { return 记录失败(方法类数据状态::资源失败); }
        catch (const std::length_error&) { return 记录失败(方法类数据状态::资源失败); }
        catch (...) { return 记录失败(方法类数据状态::内部不一致); }
    }

    方法类虚拟存在结果 初始化方法虚拟存在(
        const 方法类虚拟存在初始化请求& 请求) {
        if (请求.合同版本 != 方法类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.幂等身份)
            || !有效(请求.方法.值))
            return Vm失败(方法类数据状态::入口拒绝, 请求);
        try {
            const auto 方法 = 读取基础记录(请求.方法, 请求.期望事实代次);
            if (!方法.成功()) return Vm失败(方法.状态, 请求, 方法.事实代次);
            const auto 首次 = 读取首次(请求.幂等身份);
            if (首次 && 首次->状态 != L1所有者范围读取状态::成功)
                return Vm失败(映射L1读取状态(首次->状态), 请求,
                    首次->读取事实代次);
            const auto 当前 = 存在服务_.查询方法虚拟存在(
                {方法虚拟存在专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.方法.值,
                    结构类型_.方法虚拟存在关系类型});
            if (当前.状态 == 方法虚拟存在专用状态::已读取 && 当前.成功()) {
                if (!首次)
                    return {方法类数据状态::方法虚拟存在已初始化,
                        方法类数据合同版本, 当前.事实代次, 当前.状态,
                        请求.方法, 当前.投影};
                if (!首次材料头完整(*首次, 请求.幂等身份)
                    || !Vm写集匹配(*首次->首次规范化写集, 请求))
                    return Vm失败(方法类数据状态::幂等冲突, 请求,
                        首次->读取事实代次, 当前.状态);
                return 从Vm写入读回(*首次->首次写入结果, 请求,
                    方法类数据状态::精确重复);
            }
            if (当前.状态 != 方法虚拟存在专用状态::未初始化)
                return Vm失败(映射Vm状态(当前.状态), 请求,
                    当前.事实代次, 当前.状态);
            const auto 规格 = 存在服务_.形成方法虚拟存在写集规格(
                {方法虚拟存在专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.幂等身份, 请求.方法.值,
                    结构类型_.方法虚拟存在关系类型});
            if (!规格.成功() || !规格.写集)
                return Vm失败(规格.合同版本 != 方法虚拟存在专用合同版本
                    ? 方法类数据状态::方法虚拟存在提供者不兼容
                    : 映射Vm规格状态(规格.状态), 请求,
                    规格.事实代次, 规格.状态);
            if (规格.方法所有者 != 所有者_
                || 规格.写入幂等身份 != 请求.幂等身份
                || !Vm写集匹配(*规格.写集, 请求))
                return Vm失败(方法类数据状态::方法虚拟存在提供者不兼容,
                    请求, 规格.事实代次, 规格.状态);
            if (首次) {
                if (!首次材料头完整(*首次, 请求.幂等身份))
                    return Vm失败(映射L1读取状态(首次->状态), 请求,
                        首次->读取事实代次, 规格.状态);
                if (*首次->首次规范化写集 != *规格.写集)
                    return Vm失败(方法类数据状态::幂等冲突, 请求,
                        首次->读取事实代次, 规格.状态);
                return 从Vm写入读回(*首次->首次写入结果, 请求,
                    方法类数据状态::精确重复);
            }
            const auto 写入 = 写入端口_.提交所有者范围中性写集(*规格.写集);
            const auto 状态 = 映射写入状态(写入.状态,
                方法类数据状态::已初始化方法虚拟存在);
            if (状态 != 方法类数据状态::已初始化方法虚拟存在
                && 状态 != 方法类数据状态::精确重复)
                return Vm失败(状态, 请求, 写入.事实代次, 规格.状态);
            if (!写入头完整(写入, 请求.幂等身份))
                return Vm失败(写入.是否形成内存权威发布
                    ? 方法类数据状态::已可能发布
                    : 方法类数据状态::内部不一致,
                    请求, 写入.事实代次, 规格.状态);
            return 从Vm写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) {
            return Vm失败(方法类数据状态::资源失败, 请求);
        } catch (const std::length_error&) {
            return Vm失败(方法类数据状态::资源失败, 请求);
        } catch (...) {
            return Vm失败(方法类数据状态::内部不一致, 请求);
        }
    }

    方法类条件结果 添加条件项(const 方法类条件添加请求& 请求) {
        if (请求.合同版本 != 方法类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.幂等身份) || !有效(请求.方法.值)
            || !有效(请求.条件特征) || 请求.最大已有条件数量 == 0)
            return 条件失败(方法类数据状态::入口拒绝);
        try {
            const auto 方法 = 读取基础记录(请求.方法, 请求.期望事实代次);
            if (!方法.成功()) return 条件失败(方法.状态, 方法.事实代次);
            const auto 特征 = 特征服务_.查询特征(
                {特征类数据合同版本, 请求.期望事实代次, 请求.条件特征});
            if (!特征.成功() || 特征.状态 != 特征类数据状态::已读取
                || 特征.事实代次 != 请求.期望事实代次 || !特征.特征
                || 特征.特征->结点 != 请求.条件特征)
                return 条件失败(映射特征状态(特征.状态), 特征.事实代次);
            const auto 写集 = 形成条件写集(请求);
            if (const auto 重放 = 尝试条件重放(请求, 写集)) return *重放;
            const auto 当前 = 读取条件内部(请求.方法, 请求.期望事实代次,
                请求.最大已有条件数量);
            if (!当前.成功()) return 条件失败(当前.状态, 当前.事实代次);
            if (std::any_of(当前.条件组.begin(), 当前.条件组.end(),
                    [&请求](const auto& 项) noexcept {
                        return 项.条件特征 == 请求.条件特征;
                    }))
                return 条件失败(方法类数据状态::条件项已存在, 当前.事实代次);
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态,
                方法类数据状态::已添加条件项);
            if (状态 != 方法类数据状态::已添加条件项
                && 状态 != 方法类数据状态::精确重复)
                return 条件失败(状态, 写入.事实代次);
            if (!写入头完整(写入, 请求.幂等身份))
                return 条件失败(写入.是否形成内存权威发布
                    ? 方法类数据状态::已可能发布
                    : 方法类数据状态::内部不一致, 写入.事实代次);
            return 从条件写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) { return 条件失败(方法类数据状态::资源失败); }
        catch (const std::length_error&) { return 条件失败(方法类数据状态::资源失败); }
        catch (...) { return 条件失败(方法类数据状态::内部不一致); }
    }

    方法类条件组结果 读取条件项组(const 方法类条件组读取请求& 请求) const {
        if (请求.合同版本 != 方法类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.方法.值) || 请求.最大条件数量 == 0)
            return 条件组失败(方法类数据状态::入口拒绝, 请求);
        try {
            const auto 方法 = 读取基础记录(请求.方法, 请求.期望事实代次);
            if (!方法.成功()) return 条件组失败(方法.状态, 请求, 方法.事实代次);
            auto 结果 = 读取条件内部(请求.方法, 请求.期望事实代次,
                请求.最大条件数量);
            if (!结果.成功()) return 结果;
            if (const auto e = 检查代次(请求.期望事实代次))
                return 条件组失败(e->状态, 请求, e->事实代次);
            return 结果;
        } catch (const std::bad_alloc&) { return 条件组失败(方法类数据状态::资源失败, 请求); }
        catch (const std::length_error&) { return 条件组失败(方法类数据状态::资源失败, 请求); }
        catch (...) { return 条件组失败(方法类数据状态::内部不一致, 请求); }
    }

    方法类结果方向结果 添加结果方向项(const 方法类结果方向添加请求& 请求) {
        if (请求.合同版本 != 方法类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.幂等身份) || !有效(请求.方法.值)
            || !有效(请求.行动变化方向.值) || !有效(请求.结果方向.值)
            || 请求.最大已有结果方向数量 == 0)
            return 结果失败(方法类数据状态::入口拒绝);
        try {
            const auto 方法 = 读取基础记录(请求.方法, 请求.期望事实代次);
            if (!方法.成功()) return 结果失败(方法.状态, 方法.事实代次);
            if (const auto e = 验证二次特征(请求.行动变化方向,
                    请求.期望事实代次)) return 结果失败(*e, 请求.期望事实代次);
            if (const auto e = 验证二次特征(请求.结果方向,
                    请求.期望事实代次)) return 结果失败(*e, 请求.期望事实代次);
            const auto 写集 = 形成结果写集(请求);
            if (const auto 重放 = 尝试结果重放(请求, 写集)) return *重放;
            const auto 当前 = 读取结果内部(请求.方法, 请求.期望事实代次,
                请求.最大已有结果方向数量);
            if (!当前.成功()) return 结果失败(当前.状态, 当前.事实代次);
            if (std::any_of(当前.结果方向组.begin(), 当前.结果方向组.end(),
                    [&请求](const auto& 项) noexcept {
                        return 项.行动变化方向 == 请求.行动变化方向
                            && 项.结果方向 == 请求.结果方向;
                    }))
                return 结果失败(方法类数据状态::结果方向项已存在, 当前.事实代次);
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态,
                方法类数据状态::已添加结果方向项);
            if (状态 != 方法类数据状态::已添加结果方向项
                && 状态 != 方法类数据状态::精确重复)
                return 结果失败(状态, 写入.事实代次);
            if (!写入头完整(写入, 请求.幂等身份))
                return 结果失败(写入.是否形成内存权威发布
                    ? 方法类数据状态::已可能发布
                    : 方法类数据状态::内部不一致, 写入.事实代次);
            return 从结果写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) { return 结果失败(方法类数据状态::资源失败); }
        catch (const std::length_error&) { return 结果失败(方法类数据状态::资源失败); }
        catch (...) { return 结果失败(方法类数据状态::内部不一致); }
    }

    方法类结果方向组结果 读取结果方向项组(
        const 方法类结果方向组读取请求& 请求) const {
        if (请求.合同版本 != 方法类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.方法.值) || 请求.最大结果方向数量 == 0)
            return 结果组失败(方法类数据状态::入口拒绝, 请求);
        try {
            const auto 方法 = 读取基础记录(请求.方法, 请求.期望事实代次);
            if (!方法.成功()) return 结果组失败(方法.状态, 请求, 方法.事实代次);
            auto 结果 = 读取结果内部(请求.方法, 请求.期望事实代次,
                请求.最大结果方向数量);
            if (!结果.成功()) return 结果;
            if (const auto e = 检查代次(请求.期望事实代次))
                return 结果组失败(e->状态, 请求, e->事实代次);
            return 结果;
        } catch (const std::bad_alloc&) { return 结果组失败(方法类数据状态::资源失败, 请求); }
        catch (const std::length_error&) { return 结果组失败(方法类数据状态::资源失败, 请求); }
        catch (...) { return 结果组失败(方法类数据状态::内部不一致, 请求); }
    }

private:
    struct 代次失败值 { 方法类数据状态 状态; std::uint64_t 事实代次; };

    std::optional<代次失败值> 检查代次(std::uint64_t G0) const noexcept {
        const auto 读取 = 第一层服务_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (读取.状态 == L1中性读取状态::资源失败)
            return 代次失败值{方法类数据状态::资源失败, 读取.事实代次};
        if (读取.状态 == L1中性读取状态::入口拒绝)
            return 代次失败值{方法类数据状态::入口拒绝, 读取.事实代次};
        if (读取.状态 != L1中性读取状态::成功
            || 读取.合同版本 != L1中性CRUD合同版本 || 读取.事实代次 == 0)
            return 代次失败值{方法类数据状态::内部不一致, 读取.事实代次};
        if (读取.事实代次 != G0)
            return 代次失败值{方法类数据状态::事实代次漂移, 读取.事实代次};
        return std::nullopt;
    }

    std::optional<方法类数据状态> 验证普通节点(稳定编码 编码,
        std::uint64_t G0, bool 来源) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        if (读取.读取事实代次 != G0) return 方法类数据状态::事实代次漂移;
        if (读取.状态 == L1所有者范围读取状态::未找到)
            return 来源 ? 方法类数据状态::来源节点未找到 : 方法类数据状态::未找到;
        if (读取.状态 == L1所有者范围读取状态::已退出)
            return 来源 ? 方法类数据状态::来源节点已退出 : 方法类数据状态::未找到;
        if (读取.状态 == L1所有者范围读取状态::资源失败)
            return 方法类数据状态::资源失败;
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || !节点 || 节点->编码 != 编码 || 节点->退出事实代次)
            return 方法类数据状态::内部不一致;
        if (节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 == 0 || 节点->创建事实代次 > G0)
            return 来源 ? 方法类数据状态::来源节点不是普通节点
                : 方法类数据状态::内部不一致;
        return std::nullopt;
    }

    L1所有者范围写集请求 形成基础写集(const 方法类新增请求& 请求) const {
        using namespace 方法类数据内部;
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{方法本地键, 节点种类::普通, std::nullopt}};
        写集.关系 = {{方法来源关系本地键, 方法本地键, 请求.来源节点,
            结构类型_.方法来源关系类型, 0}};
        return 写集;
    }

    L1所有者范围写集请求 形成条件写集(const 方法类条件添加请求& 请求) const {
        using namespace 方法类数据内部;
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{条件项本地键, 节点种类::普通, std::nullopt}};
        写集.关系 = {
            {方法条件关系本地键, 请求.方法.值, 条件项本地键,
                结构类型_.方法条件关系类型, 0},
            {条件特征关系本地键, 条件项本地键, 请求.条件特征,
                结构类型_.条件特征关系类型, 0}};
        return 写集;
    }

    L1所有者范围写集请求 形成结果写集(const 方法类结果方向添加请求& 请求) const {
        using namespace 方法类数据内部;
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{结果方向项本地键, 节点种类::普通, std::nullopt}};
        写集.关系 = {
            {方法结果方向关系本地键, 请求.方法.值, 结果方向项本地键,
                结构类型_.方法结果方向关系类型, 0},
            {结果行动方向关系本地键, 结果方向项本地键,
                请求.行动变化方向.值, 结构类型_.结果行动方向关系类型, 0},
            {结果结果方向关系本地键, 结果方向项本地键,
                请求.结果方向.值, 结构类型_.结果结果方向关系类型, 0}};
        return 写集;
    }

    方法类记录结果 读取基础记录(方法类记录身份 身份,
        std::uint64_t G0) const {
        if (const auto e = 检查代次(G0)) return 记录失败(e->状态, e->事实代次);
        const auto 节点读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 身份.值});
        if (节点读取.读取事实代次 != G0)
            return 记录失败(方法类数据状态::事实代次漂移, 节点读取.读取事实代次);
        if (节点读取.状态 == L1所有者范围读取状态::未找到
            || 节点读取.状态 == L1所有者范围读取状态::已退出)
            return 记录失败(方法类数据状态::未找到, G0);
        if (节点读取.状态 != L1所有者范围读取状态::成功)
            return 记录失败(映射L1读取状态(节点读取.状态), 节点读取.读取事实代次);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (!节点 || 节点->编码 != 身份.值 || 节点->写入所有者 != 所有者_
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->退出事实代次 || !节点->当前属性.empty()
            || 节点->创建事实代次 == 0 || 节点->创建事实代次 > G0)
            return 记录失败(方法类数据状态::内部不一致, G0);
        const auto 关系读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 身份.值, 结构类型_.方法来源关系类型});
        if (关系读取.读取事实代次 != G0)
            return 记录失败(方法类数据状态::事实代次漂移, 关系读取.读取事实代次);
        if (关系读取.状态 != L1所有者范围读取状态::成功
            || 关系读取.合同版本 != L1所有者范围CRUD合同版本
            || 关系读取.源节点 != 身份.值
            || 关系读取.关系类型节点 != 结构类型_.方法来源关系类型
            || 关系读取.关系组.size() != 1)
            return 记录失败(方法类数据状态::内部不一致, 关系读取.读取事实代次);
        const auto& 关系 = 关系读取.关系组.front();
        if (!关系有效(关系, 身份.值, 关系.目标节点,
                结构类型_.方法来源关系类型, 节点->创建事实代次))
            return 记录失败(方法类数据状态::内部不一致, G0);
        if (const auto e = 验证普通节点(关系.目标节点, G0, true))
            return 记录失败(*e, G0);
        return {方法类数据状态::已读取, 方法类数据合同版本, G0,
            方法类记录{身份, 关系.目标节点, 关系.编码, {}, {}, {},
                节点->创建事实代次}};
    }

    方法类条件组结果 读取条件内部(方法类记录身份 方法,
        std::uint64_t G0, std::uint64_t 预算) const {
        const 方法类条件组读取请求 请求{方法类数据合同版本, G0, 方法, 预算};
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 方法.值, 结构类型_.方法条件关系类型});
        if (读取.读取事实代次 != G0)
            return 条件组失败(方法类数据状态::事实代次漂移, 请求, 读取.读取事实代次);
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 条件组失败(映射L1读取状态(读取.状态), 请求, 读取.读取事实代次);
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.源节点 != 方法.值
            || 读取.关系类型节点 != 结构类型_.方法条件关系类型)
            return 条件组失败(方法类数据状态::内部不一致, 请求, G0);
        if (读取.关系组.size() > 预算)
            return 条件组失败(方法类数据状态::数量预算不足, 请求, G0);
        std::vector<方法类条件项> 组;
        for (const auto& 主关系 : 读取.关系组) {
            if (!关系有效(主关系, 方法.值, 主关系.目标节点,
                    结构类型_.方法条件关系类型, std::nullopt))
                return 条件组失败(方法类数据状态::内部不一致, 请求, G0);
            const auto 子节点 = 第一层服务_.读取所有者范围当前节点(
                {L1所有者范围CRUD合同版本, 主关系.目标节点});
            const auto* 节点 = 子节点.事实
                ? std::get_if<L1所有者范围节点事实>(&*子节点.事实) : nullptr;
            if (子节点.读取事实代次 != G0 || 子节点.状态 != L1所有者范围读取状态::成功
                || !节点 || 节点->编码 != 主关系.目标节点
                || 节点->写入所有者 != 所有者_ || 节点->种类 != 节点种类::普通
                || 节点->属性类型表示 || 节点->退出事实代次
                || 节点->创建事实代次 != 主关系.创建事实代次
                || !节点->当前属性.empty())
                return 条件组失败(方法类数据状态::内部不一致, 请求, G0);
            const auto 特征关系 = 第一层服务_.读取所有者范围当前源关系组(
                {L1所有者范围CRUD合同版本, 节点->编码,
                    结构类型_.条件特征关系类型});
            if (特征关系.读取事实代次 != G0
                || 特征关系.状态 != L1所有者范围读取状态::成功
                || 特征关系.关系组.size() != 1)
                return 条件组失败(方法类数据状态::内部不一致, 请求, G0);
            const auto& 从关系 = 特征关系.关系组.front();
            if (!关系有效(从关系, 节点->编码, 从关系.目标节点,
                    结构类型_.条件特征关系类型, 节点->创建事实代次))
                return 条件组失败(方法类数据状态::内部不一致, 请求, G0);
            const auto 特征 = 特征服务_.查询特征(
                {特征类数据合同版本, G0, 从关系.目标节点});
            if (!特征.成功() || 特征.状态 != 特征类数据状态::已读取
                || 特征.事实代次 != G0 || !特征.特征
                || 特征.特征->结点 != 从关系.目标节点)
                return 条件组失败(映射特征状态(特征.状态), 请求, 特征.事实代次);
            组.push_back({{节点->编码}, 方法, 从关系.目标节点,
                主关系.编码, 从关系.编码, 节点->创建事实代次});
        }
        std::sort(组.begin(), 组.end(), [](const auto& 左, const auto& 右) noexcept {
            if (左.条件特征 != 右.条件特征) return 左.条件特征 < 右.条件特征;
            return 左.身份.值 < 右.身份.值;
        });
        for (std::size_t i = 1; i < 组.size(); ++i)
            if (组[i - 1].条件特征 == 组[i].条件特征)
                return 条件组失败(方法类数据状态::内部不一致, 请求, G0);
        return {方法类数据状态::已读取条件组, 方法类数据合同版本,
            G0, 方法, std::move(组)};
    }

    方法类结果方向组结果 读取结果内部(方法类记录身份 方法,
        std::uint64_t G0, std::uint64_t 预算) const {
        const 方法类结果方向组读取请求 请求{方法类数据合同版本, G0, 方法, 预算};
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 方法.值,
                结构类型_.方法结果方向关系类型});
        if (读取.读取事实代次 != G0)
            return 结果组失败(方法类数据状态::事实代次漂移, 请求, 读取.读取事实代次);
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 结果组失败(映射L1读取状态(读取.状态), 请求, 读取.读取事实代次);
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.源节点 != 方法.值
            || 读取.关系类型节点 != 结构类型_.方法结果方向关系类型)
            return 结果组失败(方法类数据状态::内部不一致, 请求, G0);
        if (读取.关系组.size() > 预算)
            return 结果组失败(方法类数据状态::数量预算不足, 请求, G0);
        std::vector<方法类结果方向项> 组;
        for (const auto& 主关系 : 读取.关系组) {
            if (!关系有效(主关系, 方法.值, 主关系.目标节点,
                    结构类型_.方法结果方向关系类型, std::nullopt))
                return 结果组失败(方法类数据状态::内部不一致, 请求, G0);
            const auto 子节点 = 第一层服务_.读取所有者范围当前节点(
                {L1所有者范围CRUD合同版本, 主关系.目标节点});
            const auto* 节点 = 子节点.事实
                ? std::get_if<L1所有者范围节点事实>(&*子节点.事实) : nullptr;
            if (子节点.读取事实代次 != G0 || 子节点.状态 != L1所有者范围读取状态::成功
                || !节点 || 节点->编码 != 主关系.目标节点
                || 节点->写入所有者 != 所有者_ || 节点->种类 != 节点种类::普通
                || 节点->属性类型表示 || 节点->退出事实代次
                || 节点->创建事实代次 != 主关系.创建事实代次
                || !节点->当前属性.empty())
                return 结果组失败(方法类数据状态::内部不一致, 请求, G0);
            const auto 行动 = 读取唯一方向关系(节点->编码,
                结构类型_.结果行动方向关系类型, G0, 节点->创建事实代次);
            const auto 结果 = 读取唯一方向关系(节点->编码,
                结构类型_.结果结果方向关系类型, G0, 节点->创建事实代次);
            if (!行动 || !结果)
                return 结果组失败(方法类数据状态::内部不一致, 请求, G0);
            if (const auto e = 验证二次特征({行动->目标节点}, G0))
                return 结果组失败(*e, 请求, G0);
            if (const auto e = 验证二次特征({结果->目标节点}, G0))
                return 结果组失败(*e, 请求, G0);
            组.push_back({{节点->编码}, 方法, {行动->目标节点},
                {结果->目标节点}, 主关系.编码, 行动->编码, 结果->编码,
                节点->创建事实代次});
        }
        std::sort(组.begin(), 组.end(), [](const auto& 左, const auto& 右) noexcept {
            if (左.行动变化方向.值 != 右.行动变化方向.值)
                return 左.行动变化方向.值 < 右.行动变化方向.值;
            if (左.结果方向.值 != 右.结果方向.值)
                return 左.结果方向.值 < 右.结果方向.值;
            return 左.身份.值 < 右.身份.值;
        });
        for (std::size_t i = 1; i < 组.size(); ++i)
            if (组[i - 1].行动变化方向 == 组[i].行动变化方向
                && 组[i - 1].结果方向 == 组[i].结果方向)
                return 结果组失败(方法类数据状态::内部不一致, 请求, G0);
        return {方法类数据状态::已读取结果方向组, 方法类数据合同版本,
            G0, 方法, std::move(组)};
    }

    std::optional<L1所有者范围关系事实> 读取唯一方向关系(稳定编码 源,
        稳定编码 类型, std::uint64_t G0, std::uint64_t 创建代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 源, 类型});
        if (读取.读取事实代次 != G0 || 读取.状态 != L1所有者范围读取状态::成功
            || 读取.关系组.size() != 1) return std::nullopt;
        const auto& 关系 = 读取.关系组.front();
        if (!关系有效(关系, 源, 关系.目标节点, 类型, 创建代次))
            return std::nullopt;
        return 关系;
    }

    std::optional<方法类数据状态> 验证二次特征(特征类定义身份 身份,
        std::uint64_t G0) const {
        const auto 读取 = 二次特征服务_.读取二次特征概念材料(
            {特征类派生数据合同版本, G0, 身份});
        if (读取.状态 == 特征类派生数据状态::未找到)
            return 方法类数据状态::结果方向未找到;
        if (读取.状态 == 特征类派生数据状态::目标已退出)
            return 方法类数据状态::结果方向已退出;
        if (读取.状态 == 特征类派生数据状态::事实代次漂移)
            return 方法类数据状态::事实代次漂移;
        if (读取.状态 == 特征类派生数据状态::资源失败)
            return 方法类数据状态::资源失败;
        if (!读取.成功() || 读取.事实代次 != G0 || !读取.材料
            || 读取.材料->特征身份 != 身份)
            return 方法类数据状态::结果方向不可用;
        if (读取.材料->实际阶次 != 2)
            return 方法类数据状态::结果方向不是二次特征;
        return std::nullopt;
    }

    std::optional<方法类记录结果> 尝试基础重放(const 方法类新增请求& 请求,
        const L1所有者范围写集请求& 写集) const {
        const auto 首次 = 读取首次(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (!首次材料头完整(*首次, 请求.幂等身份))
            return 记录失败(映射L1读取状态(首次->状态), 首次->读取事实代次);
        if (*首次->首次规范化写集 != 写集)
            return 记录失败(方法类数据状态::幂等冲突, 首次->读取事实代次);
        return 从基础写入读回(*首次->首次写入结果, 请求,
            方法类数据状态::精确重复);
    }

    std::optional<方法类条件结果> 尝试条件重放(const 方法类条件添加请求& 请求,
        const L1所有者范围写集请求& 写集) const {
        const auto 首次 = 读取首次(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (!首次材料头完整(*首次, 请求.幂等身份))
            return 条件失败(映射L1读取状态(首次->状态), 首次->读取事实代次);
        if (*首次->首次规范化写集 != 写集)
            return 条件失败(方法类数据状态::幂等冲突, 首次->读取事实代次);
        return 从条件写入读回(*首次->首次写入结果, 请求,
            方法类数据状态::精确重复);
    }

    std::optional<方法类结果方向结果> 尝试结果重放(
        const 方法类结果方向添加请求& 请求,
        const L1所有者范围写集请求& 写集) const {
        const auto 首次 = 读取首次(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (!首次材料头完整(*首次, 请求.幂等身份))
            return 结果失败(映射L1读取状态(首次->状态), 首次->读取事实代次);
        if (*首次->首次规范化写集 != 写集)
            return 结果失败(方法类数据状态::幂等冲突, 首次->读取事实代次);
        return 从结果写入读回(*首次->首次写入结果, 请求,
            方法类数据状态::精确重复);
    }

    std::optional<L1所有者范围首次写入读取结果> 读取首次(
        L1所有者范围写入幂等身份 幂等) const {
        const auto 读取 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 幂等});
        if (读取.状态 == L1所有者范围读取状态::未找到) return std::nullopt;
        return 读取;
    }

    方法类记录结果 从基础写入读回(const L1所有者范围写入结果& 写入,
        const 方法类新增请求& 请求, 方法类数据状态 状态) const {
        using namespace 方法类数据内部;
        if (!写入头完整(写入, 请求.幂等身份) || 写入.新编码映射.size() != 2)
            return 记录失败(写入.是否形成内存权威发布
                ? 方法类数据状态::已可能发布 : 方法类数据状态::内部不一致,
                写入.事实代次);
        const auto 方法 = 查找唯一编码(写入, 方法本地键);
        const auto 关系 = 查找唯一编码(写入, 方法来源关系本地键);
        if (!方法 || !关系) return 记录失败(方法类数据状态::已可能发布, 写入.事实代次);
        auto 读回 = 查询方法记录({方法类数据合同版本, 写入.事实代次,
            {*方法}, std::numeric_limits<std::uint64_t>::max(),
            std::numeric_limits<std::uint64_t>::max()});
        if (!读回.成功() || !读回.记录 || 读回.记录->来源节点 != 请求.来源节点
            || 读回.记录->来源关系 != *关系
            || 读回.记录->创建事实代次 != 写入.事实代次)
            return 记录失败(方法类数据状态::已可能发布, 写入.事实代次);
        读回.状态 = 状态;
        return 读回;
    }

    方法类虚拟存在结果 从Vm写入读回(
        const L1所有者范围写入结果& 写入,
        const 方法类虚拟存在初始化请求& 请求,
        方法类数据状态 状态) const {
        using namespace 方法类数据内部;
        if (!写入头完整(写入, 请求.幂等身份)
            || 写入.新编码映射.size() != 2)
            return Vm失败(写入.是否形成内存权威发布
                ? 方法类数据状态::已可能发布
                : 方法类数据状态::内部不一致,
                请求, 写入.事实代次);
        const auto 节点 = 查找唯一编码(写入, 虚拟存在节点本地键);
        const auto 关系 = 查找唯一编码(写入, 虚拟存在关系本地键);
        if (!节点 || !关系)
            return Vm失败(方法类数据状态::已可能发布, 请求, 写入.事实代次);
        const auto 读取 = 存在服务_.查询方法虚拟存在(
            {方法虚拟存在专用合同版本, 写入.事实代次, 所有者_,
                请求.方法.值, 结构类型_.方法虚拟存在关系类型});
        if (!读取.成功() || !读取.投影
            || 读取.投影->虚拟存在节点 != *节点
            || 读取.投影->方法虚拟存在关系 != *关系)
            return Vm失败(方法类数据状态::已可能发布, 请求,
                写入.事实代次, 读取.状态);
        return {状态, 方法类数据合同版本, 写入.事实代次,
            读取.状态, 请求.方法, 读取.投影};
    }

    bool Vm写集匹配(const L1所有者范围写集请求& 写集,
        const 方法类虚拟存在初始化请求& 请求) const noexcept {
        if (!方法虚拟存在写集完整(写集)
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份) return false;
        const auto& 关系 = 写集.关系.front();
        const auto* 源 = std::get_if<稳定编码>(&关系.源节点);
        const auto* 类型 = std::get_if<稳定编码>(&关系.关系类型节点);
        return 源 && *源 == 请求.方法.值
            && 类型 && *类型 == 结构类型_.方法虚拟存在关系类型;
    }

    方法类条件结果 从条件写入读回(const L1所有者范围写入结果& 写入,
        const 方法类条件添加请求& 请求, 方法类数据状态 状态) const {
        using namespace 方法类数据内部;
        if (!写入头完整(写入, 请求.幂等身份) || 写入.新编码映射.size() != 3)
            return 条件失败(写入.是否形成内存权威发布
                ? 方法类数据状态::已可能发布 : 方法类数据状态::内部不一致,
                写入.事实代次);
        const auto 项 = 查找唯一编码(写入, 条件项本地键);
        const auto r1 = 查找唯一编码(写入, 方法条件关系本地键);
        const auto r2 = 查找唯一编码(写入, 条件特征关系本地键);
        if (!项 || !r1 || !r2) return 条件失败(方法类数据状态::已可能发布, 写入.事实代次);
        const auto 组 = 读取条件内部(请求.方法, 写入.事实代次,
            std::numeric_limits<std::uint64_t>::max());
        const auto it = std::find_if(组.条件组.begin(), 组.条件组.end(),
            [项](const auto& x) noexcept { return x.身份.值 == *项; });
        if (!组.成功() || it == 组.条件组.end() || it->条件特征 != 请求.条件特征
            || it->方法条件关系 != *r1 || it->条件特征关系 != *r2)
            return 条件失败(方法类数据状态::已可能发布, 写入.事实代次);
        return {状态, 方法类数据合同版本, 写入.事实代次, *it};
    }

    方法类结果方向结果 从结果写入读回(const L1所有者范围写入结果& 写入,
        const 方法类结果方向添加请求& 请求, 方法类数据状态 状态) const {
        using namespace 方法类数据内部;
        if (!写入头完整(写入, 请求.幂等身份) || 写入.新编码映射.size() != 4)
            return 结果失败(写入.是否形成内存权威发布
                ? 方法类数据状态::已可能发布 : 方法类数据状态::内部不一致,
                写入.事实代次);
        const auto 项 = 查找唯一编码(写入, 结果方向项本地键);
        const auto r1 = 查找唯一编码(写入, 方法结果方向关系本地键);
        const auto r2 = 查找唯一编码(写入, 结果行动方向关系本地键);
        const auto r3 = 查找唯一编码(写入, 结果结果方向关系本地键);
        if (!项 || !r1 || !r2 || !r3)
            return 结果失败(方法类数据状态::已可能发布, 写入.事实代次);
        const auto 组 = 读取结果内部(请求.方法, 写入.事实代次,
            std::numeric_limits<std::uint64_t>::max());
        const auto it = std::find_if(组.结果方向组.begin(), 组.结果方向组.end(),
            [项](const auto& x) noexcept { return x.身份.值 == *项; });
        if (!组.成功() || it == 组.结果方向组.end()
            || it->行动变化方向 != 请求.行动变化方向 || it->结果方向 != 请求.结果方向
            || it->方法结果方向关系 != *r1 || it->结果行动方向关系 != *r2
            || it->结果结果方向关系 != *r3)
            return 结果失败(方法类数据状态::已可能发布, 写入.事实代次);
        return {状态, 方法类数据合同版本, 写入.事实代次, *it};
    }

    bool 关系有效(const L1所有者范围关系事实& 关系, 稳定编码 源,
        稳定编码 目标, 稳定编码 类型,
        std::optional<std::uint64_t> 创建代次) const noexcept {
        return 有效(关系.编码) && 关系.源节点 == 源 && 关系.目标节点 == 目标
            && 关系.关系类型节点 == 类型 && 关系.角色或顺序 == 0
            && 关系.写入所有者 == 所有者_ && 关系.创建事实代次 != 0
            && !关系.退出事实代次
            && (!创建代次 || 关系.创建事实代次 == *创建代次);
    }

    bool 首次材料头完整(const L1所有者范围首次写入读取结果& 首次,
        L1所有者范围写入幂等身份 幂等) const noexcept {
        return 首次.状态 == L1所有者范围读取状态::成功
            && 首次.合同版本 == L1所有者范围首次写入读取合同版本
            && 首次.所有者 == 所有者_ && 首次.写入幂等身份 == 幂等
            && 首次.首次规范化写集 && 首次.首次写入结果
            && 写入头完整(*首次.首次写入结果, 幂等);
    }

    bool 写入头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等) const noexcept {
        const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_ && 写入.写入幂等身份 == 幂等
            && 写入.事实代次 != 0 && (首次 || 重复);
    }

    static 方法类数据状态 映射L1读取状态(L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::未找到: return 方法类数据状态::未找到;
        case L1所有者范围读取状态::事实代次漂移: return 方法类数据状态::事实代次漂移;
        case L1所有者范围读取状态::资源失败: return 方法类数据状态::资源失败;
        case L1所有者范围读取状态::入口拒绝: return 方法类数据状态::入口拒绝;
        default: return 方法类数据状态::内部不一致;
        }
    }

    static 方法类数据状态 映射特征状态(特征类数据状态 状态) noexcept {
        switch (状态) {
        case 特征类数据状态::未找到: return 方法类数据状态::条件特征未找到;
        case 特征类数据状态::目标已退出: return 方法类数据状态::条件特征已退出;
        case 特征类数据状态::事实代次漂移: return 方法类数据状态::事实代次漂移;
        case 特征类数据状态::资源失败: return 方法类数据状态::资源失败;
        default: return 方法类数据状态::条件特征不可用;
        }
    }

    static 方法类数据状态 映射Vm状态(方法虚拟存在专用状态 状态) noexcept {
        switch (状态) {
        case 方法虚拟存在专用状态::未初始化:
            return 方法类数据状态::方法虚拟存在未初始化;
        case 方法虚拟存在专用状态::已初始化:
            return 方法类数据状态::方法虚拟存在已初始化;
        case 方法虚拟存在专用状态::事实代次漂移:
            return 方法类数据状态::事实代次漂移;
        case 方法虚拟存在专用状态::资源失败:
            return 方法类数据状态::资源失败;
        case 方法虚拟存在专用状态::入口拒绝:
            return 方法类数据状态::入口拒绝;
        default: return 方法类数据状态::内部不一致;
        }
    }

    static 方法类数据状态 映射Vm规格状态(
        方法虚拟存在专用状态 状态) noexcept {
        if (状态 == 方法虚拟存在专用状态::事实代次漂移
            || 状态 == 方法虚拟存在专用状态::资源失败
            || 状态 == 方法虚拟存在专用状态::入口拒绝
            || 状态 == 方法虚拟存在专用状态::已初始化)
            return 映射Vm状态(状态);
        return 方法类数据状态::方法虚拟存在规格失败;
    }

    static 方法类数据状态 映射写入状态(L1所有者范围写入状态 状态,
        方法类数据状态 首次成功) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功: return 首次成功;
        case L1所有者范围写入状态::精确重复: return 方法类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝: return 方法类数据状态::入口拒绝;
        case L1所有者范围写入状态::事实代次漂移: return 方法类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突: return 方法类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突: return 方法类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败: return 方法类数据状态::资源失败;
        default: return 方法类数据状态::内部不一致;
        }
    }

    static 方法类记录结果 记录失败(方法类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 方法类数据合同版本, 事实代次, std::nullopt};
    }
    static 方法类虚拟存在结果 Vm失败(方法类数据状态 状态,
        const 方法类虚拟存在初始化请求& 请求,
        std::uint64_t 事实代次 = 0,
        方法虚拟存在专用状态 提供者状态 =
            方法虚拟存在专用状态::入口拒绝) noexcept {
        return {状态, 方法类数据合同版本, 事实代次, 提供者状态,
            请求.方法, std::nullopt};
    }
    static 方法类条件结果 条件失败(方法类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 方法类数据合同版本, 事实代次, std::nullopt};
    }
    static 方法类条件组结果 条件组失败(方法类数据状态 状态,
        const 方法类条件组读取请求& 请求, std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 方法类数据合同版本, 事实代次, 请求.方法, {}};
    }
    static 方法类结果方向结果 结果失败(方法类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 方法类数据合同版本, 事实代次, std::nullopt};
    }
    static 方法类结果方向组结果 结果组失败(方法类数据状态 状态,
        const 方法类结果方向组读取请求& 请求,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 方法类数据合同版本, 事实代次, 请求.方法, {}};
    }

    const L1事实基座服务& 第一层服务_;
    const 特征类数据服务& 特征服务_;
    const 二次特征类数据服务& 二次特征服务_;
    const 存在类数据服务& 存在服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    方法类结构类型 结构类型_{};
};

} // namespace 海中鱼巣
