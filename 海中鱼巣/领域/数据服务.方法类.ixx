inline constexpr L1所有者范围写集本地键 方法本地键{1};
inline constexpr L1所有者范围写集本地键 方法来源关系本地键{2};
inline constexpr L1所有者范围写集本地键 虚拟存在节点本地键{1};
inline constexpr L1所有者范围写集本地键 虚拟存在关系本地键{2};
inline constexpr L1所有者范围写集本地键 条件项本地键{1};
inline constexpr L1所有者范围写集本地键 方法条件关系本地键{2};
inline constexpr L1所有者范围写集本地键 条件特征关系本地键{3};
inline constexpr L1所有者范围写集本地键 结果方向项本地键{1};
inline constexpr L1所有者范围写集本地键 方法结果方向关系本地键{2};
inline constexpr L1所有者范围写集本地键 结果行动方向关系本地键{3};
inline constexpr L1所有者范围写集本地键 结果结果方向关系本地键{4};

std::optional<稳定编码> 查找唯一编码(const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键 != 本地键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

} // namespace 海中鱼巣::方法类数据内部

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 方法类数据合同版本 = 2;

enum class 方法类数据状态 : std::uint8_t {
    已创建=1, 精确重复=2, 已读取=3, 已添加条件项=4,
    已读取条件组=5, 已添加结果方向项=6, 已读取结果方向组=7,
    入口拒绝=8, 未找到=9, 来源节点未找到=10, 来源节点已退出=11,
    来源节点不是普通节点=12, 精确记录已存在=13,
    条件特征未找到=14, 条件特征已退出=15, 条件特征不可用=16,
    条件项已存在=17, 结果方向未找到=18, 结果方向已退出=19,
    结果方向不是二次特征=20, 结果方向不可用=21,
    结果方向项已存在=22, 数量预算不足=23, 事实代次漂移=24,
    幂等冲突=25, 引用冲突=26, 资源失败=27, 内部不一致=28,
    已可能发布=29, 已初始化方法虚拟存在=30,
    方法虚拟存在已初始化=31, 方法虚拟存在未初始化=32,
    方法虚拟存在规格失败=33, 方法虚拟存在提供者不兼容=34
};

