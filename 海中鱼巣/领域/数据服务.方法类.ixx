struct 方法类结果方向项 final {
    方法类结果方向项身份 身份;
    方法类记录身份 方法;
    特征类定义身份 行动变化方向;
    特征类定义身份 结果方向;
    稳定编码 方法结果方向关系{};
    稳定编码 结果行动方向关系{};
    稳定编码 结果结果方向关系{};
