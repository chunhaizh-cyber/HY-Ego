struct 方法类记录 final {
    方法类记录身份 身份;
    稳定编码 来源节点{};
    稳定编码 来源关系{};
    std::optional<方法虚拟存在投影> 虚拟存在;
    std::vector<方法类条件项> 条件组;
    std::vector<方法类结果方向项> 结果方向组;
    std::uint64_t 创建事实代次 = 0;
    friend bool operator==(const 方法类记录&, const 方法类记录&) = default;
};

inline bool 方法类条件项完整(const 方法类条件项& 项,
    std::uint64_t G) noexcept {
    return 有效(项.身份.值) && 有效(项.方法.值) && 有效(项.条件特征)
        && 有效(项.方法条件关系) && 有效(项.条件特征关系)
        && 项.创建事实代次 != 0 && 项.创建事实代次 <= G;
}

inline bool 方法类结果方向项完整(const 方法类结果方向项& 项,
    std::uint64_t G) noexcept {
    return 有效(项.身份.值) && 有效(项.方法.值)
        && 有效(项.行动变化方向.值) && 有效(项.结果方向.值)
        && 有效(项.方法结果方向关系) && 有效(项.结果行动方向关系)
        && 有效(项.结果结果方向关系) && 项.创建事实代次 != 0
        && 项.创建事实代次 <= G;
}

