    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    方法类记录身份 方法;
    稳定编码 条件特征{};
    std::uint64_t 最大已有条件数量 = 0;
    friend bool operator==(const 方法类条件添加请求&,
        const 方法类条件添加请求&) = default;
};

struct 方法类条件组读取请求 final {
    std::uint32_t 合同版本 = 方法类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    方法类记录身份 方法;
    std::uint64_t 最大条件数量 = 0;
    friend bool operator==(const 方法类条件组读取请求&,
        const 方法类条件组读取请求&) = default;
};

struct 方法类条件结果 final {
    方法类数据状态 状态 = 方法类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 方法类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<方法类条件项> 条件项;
    bool 成功() const noexcept {
        return (状态 == 方法类数据状态::已添加条件项
                || 状态 == 方法类数据状态::精确重复)
            && 合同版本 == 方法类数据合同版本 && 事实代次 != 0 && 条件项
            && 有效(条件项->身份.值) && 有效(条件项->方法.值)
            && 有效(条件项->条件特征) && 有效(条件项->方法条件关系)
            && 有效(条件项->条件特征关系)
            && 方法类条件项完整(*条件项, 事实代次);
    }
    friend bool operator==(const 方法类条件结果&,
        const 方法类条件结果&) = default;
};

struct 方法类条件组结果 final {
    方法类数据状态 状态 = 方法类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 方法类数据合同版本;
    std::uint64_t 事实代次 = 0;
    方法类记录身份 方法;
    std::vector<方法类条件项> 条件组;
    bool 成功() const noexcept {
        if (状态 != 方法类数据状态::已读取条件组
            || 合同版本 != 方法类数据合同版本 || 事实代次 == 0
            || !有效(方法.值)
            || !std::all_of(条件组.begin(), 条件组.end(),
                [this](const auto& 项) noexcept {
                    return 项.方法 == 方法 && 方法类条件项完整(项, 事实代次);
                })
            || !std::is_sorted(条件组.begin(), 条件组.end(), 条件小于))
            return false;
        for (std::size_t i = 1; i < 条件组.size(); ++i)
            if (条件组[i - 1].条件特征 == 条件组[i].条件特征) return false;
        return true;
    }
    friend bool operator==(const 方法类条件组结果&,
        const 方法类条件组结果&) = default;
private:
    static bool 条件小于(const 方法类条件项& 左,
        const 方法类条件项& 右) noexcept {
        if (左.条件特征 != 右.条件特征)
            return 左.条件特征 < 右.条件特征;
        return 左.身份.值 < 右.身份.值;
    }
};

