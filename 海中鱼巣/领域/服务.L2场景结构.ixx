    0x4C31'4F57'4E45'5237ULL};

class L2场景结构服务;

class L2场景所有者交付 final {
public:
    L2场景所有者交付() = delete;
    L2场景所有者交付(const L2场景所有者交付&) = delete;
    L2场景所有者交付& operator=(const L2场景所有者交付&) = delete;
    L2场景所有者交付(L2场景所有者交付&&) noexcept = default;
    L2场景所有者交付& operator=(L2场景所有者交付&&) = delete;

private:
    explicit L2场景所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}

    friend std::optional<L2场景所有者交付> 尝试形成L2场景所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2场景结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2场景所有者交付> 尝试形成L2场景所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

}

