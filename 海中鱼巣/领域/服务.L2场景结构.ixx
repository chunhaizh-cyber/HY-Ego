inline constexpr std::uint32_t 树内场景树归属本地键值 = 0x0201'1503U;
inline constexpr std::uint32_t 树内场景父子关系本地键值 = 0x0201'1504U;
inline constexpr std::uint32_t 场景宿主关系类型本地键值 = 0x0201'1601U;
inline constexpr std::uint32_t 场景宿主关系本地键值 = 0x0201'1602U;

struct 场景身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

struct 场景树结构定位 final {
    稳定编码 树登记锚点;
    稳定编码 根标记关系类型;
    稳定编码 树归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

// 诊断责任：向上送出；场景来源登记失败使服务构造失败，不发布半构造服务。
场景身份来源定位 初始化场景身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 scene owner fact is invalid");

    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读取.所有者事实->创建事实代次;
    写集.写入幂等身份 = 场景身份来源登记幂等身份;
    写集.节点 = {
        {{场景族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{场景族归属关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 场景身份来源登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 2)
        throw std::runtime_error("L2 scene identity source initialization failed");

    稳定编码 锚点编码;
    稳定编码 类型编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码))
            throw std::runtime_error("L2 scene identity source mapping invalid");
        if (本地键.值 == 场景族锚点本地键值) 锚点编码 = 编码;
        else if (本地键.值 == 场景族归属关系类型本地键值) 类型编码 = 编码;
        else throw std::runtime_error("L2 scene identity source mapping unknown");
    }
    if (!有效(锚点编码) || !有效(类型编码) || 锚点编码 == 类型编码)
        throw std::runtime_error("L2 scene identity source mapping incomplete");

    const auto 锚点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 锚点编码});
    const auto 类型读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 类型编码});
    const auto* 锚点 = 锚点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
    const auto* 类型 = 类型读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
    const auto 节点完整 = [&](const auto& 读取,
        const L1所有者范围节点事实* 节点, 稳定编码 编码) noexcept {
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者 && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次
            && !节点->退出事实代次;
    };
    if (!节点完整(锚点读取, 锚点, 锚点编码)
        || !节点完整(类型读取, 类型, 类型编码))
        throw std::runtime_error("L2 scene identity source readback invalid");
    return {所有者, 锚点编码, 类型编码, 写入.事实代次};
}

bool 是保留登记幂等身份(L2结构幂等身份 身份) noexcept {
    return 身份.值 == 场景身份来源登记幂等身份.值
        || 身份.值 == 场景关系类型登记幂等身份.值
        || 身份.值 == 场景属性类型登记幂等身份.值
        || 身份 == L2场景树结构登记固定幂等身份
        || 身份 == L2场景宿主结构登记固定幂等身份;
}

// 诊断责任：无适用错误分支；固定私有域纯值映射不读取事实。
L1所有者范围写入幂等身份 映射场景关系类型登记幂等键(
    L2结构幂等身份) noexcept {
    return 场景关系类型登记幂等身份;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2场景关系类型登记状态 映射场景关系类型登记写入状态(
    L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功:
        return L2场景关系类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2场景关系类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝:
        return L2场景关系类型登记状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝:
        return L2场景关系类型登记状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2场景关系类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突:
        return L2场景关系类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败:
        return L2场景关系类型登记状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::引用冲突:
    case L1所有者范围写入状态::内部不一致:
        return L2场景关系类型登记状态::内部不一致;
    }
    return L2场景关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值状态映射保留一致读取失败类别。
L2场景关系类型登记状态 映射场景关系类型登记读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2场景关系类型登记状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2场景关系类型登记状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2场景关系类型登记状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2场景关系类型登记状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2场景关系类型登记状态::内部不一致;
    }
    return L2场景关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对一致读取失败的空载荷和代次边界。
bool 场景关系类型一致读取失败形状完整(
    const L1所有者范围一致当前读取结果& 结果,
    std::uint64_t 期望代次) noexcept {
    if (结果.状态 == L1所有者范围一致当前读取状态::成功
        || 结果.合同版本 != L1所有者范围一致当前读取合同版本
        || 结果.期望事实代次 != 期望代次
        || !结果.节点.empty() || !结果.关系.empty()
        || !结果.值.empty() || !结果.属性值.empty()
        || !结果.源关系组.empty() || !结果.目标关系组.empty()) {
        return false;
    }
    return 结果.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 结果.读取事实代次 != 0 && 结果.读取事实代次 != 期望代次
        : 结果.读取事实代次 == 0;
}

// 诊断责任：无适用错误分支；未找到或重复映射均返回空值。
std::optional<稳定编码> 查找场景关系类型编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键.值 != 本地键值) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只检查两项映射的键和值分别唯一。
bool 场景关系类型编码映射唯一(const L1所有者范围写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 2) return false;
    for (std::size_t 左 = 0; 左 < 结果.新编码映射.size(); ++左) {
        if (!有效(结果.新编码映射[左].first)
            || !有效(结果.新编码映射[左].second)) return false;
        for (std::size_t 右 = 左 + 1; 右 < 结果.新编码映射.size(); ++右) {
            if (结果.新编码映射[左].first == 结果.新编码映射[右].first
                || 结果.新编码映射[左].second == 结果.新编码映射[右].second)
                return false;
        }
    }
    return true;
}

// 诊断责任：无适用错误分支；只形成无登记载荷的结构化失败。
L2场景关系类型登记结果 形成场景关系类型登记失败(
    L2场景关系类型登记状态 状态,
    std::uint64_t 事实截止代次 = 0) noexcept {
    return {状态, 事实截止代次, std::nullopt};
}

// 诊断责任：无适用错误分支；完整 64 位纯值映射不读取事实。
L1所有者范围写入幂等身份 映射场景幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2结构状态 映射场景写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2场景树结构登记结果 形成场景树登记失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

L2场景树归属读取结果 形成场景树归属读取失败(
    const L2场景树归属读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
}

L2场景树读取结果 形成场景树读取失败(
    const L2场景树读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
}

L2当前场景树组读取结果 形成当前场景树组读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, {}};
}

L2场景树节点写入结果 形成场景树节点写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt, std::nullopt};
}

std::optional<L2场景树归属事实> 形成场景树归属事实(
    const L1所有者范围关系事实& 关系, L1结构所有者身份 所有者,
    const L2场景树结构登记& 登记, L2场景身份 场景,
    L2场景树归属类别 类别, std::uint64_t 截止) noexcept {
    const auto 期望类型 = 类别 == L2场景树归属类别::根
        ? 登记.根标记关系类型.值 : 登记.树归属关系类型.值;
    if (截止 == 0 || 关系.写入所有者 != 所有者
        || 关系.源节点 != 场景.值 || 关系.关系类型节点 != 期望类型
        || 关系.角色或顺序 != 1 || 关系.创建事实代次 == 0
        || 关系.创建事实代次 > 截止
        || (关系.退出事实代次 && *关系.退出事实代次 <= 截止))
        return std::nullopt;
    L2场景树归属事实 结果;
    结果.场景 = 场景;
    结果.类别 = 类别;
    结果.关系稳定编码 = 关系.编码;
    结果.物理目标稳定编码 = 关系.目标节点;
    结果.根场景 = 类别 == L2场景树归属类别::根
        ? 场景 : L2场景身份{关系.目标节点};
    结果.树 = {结果.根场景.值};
    结果.生命周期 = {关系.创建事实代次,
        关系.退出事实代次 && *关系.退出事实代次 <= 截止
            ? 关系.退出事实代次 : std::nullopt};
    if (类别 == L2场景树归属类别::根
        && 关系.目标节点 != 登记.树登记锚点稳定编码)
        return std::nullopt;
    return L2场景树归属事实完整(结果, 截止)
        ? std::optional<L2场景树归属事实>{结果} : std::nullopt;
}

std::optional<稳定编码> 查找唯一映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键.值 != 本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

bool 映射集合唯一(const L1所有者范围写入结果& 结果,
    const std::vector<std::uint32_t>& 期望本地键) noexcept {
    if (结果.新编码映射.size() != 期望本地键.size()) return false;
    std::vector<稳定编码> 编码组;
    for (const auto 键 : 期望本地键) {
        const auto 编码 = 查找唯一映射(结果, 键);
        if (!编码 || std::find(编码组.begin(), 编码组.end(), *编码)
                != 编码组.end()) return false;
        编码组.push_back(*编码);
    }
    return true;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部一致读取状态。
L2结构状态 映射场景一致读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部读取项目状态。
L2结构状态 映射场景当前项目状态(
    L1所有者范围一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；缺项、失败项及成功空载荷在调用侧统一分账。
template<class 读取结果项类型>
L2结构状态 映射场景当前失败项目(const 读取结果项类型* 项) noexcept {
    if (!项) return L2结构状态::未找到;
    const auto 状态 = 映射场景当前项目状态(项->状态);
    return 状态 == L2结构状态::已读取 ? L2结构状态::内部不一致 : 状态;
}

// 诊断责任：无适用错误分支；多端点失败优先保留内部矛盾，其次已退出和未找到。
L2结构状态 合并场景端点失败状态(
    L2结构状态 当前, L2结构状态 新状态) noexcept {
    if (当前 == L2结构状态::内部不一致
        || 新状态 == L2结构状态::内部不一致)
        return L2结构状态::内部不一致;
    if (当前 == L2结构状态::已退出 || 新状态 == L2结构状态::已退出)
        return L2结构状态::已退出;
    return 当前 == L2结构状态::未找到 || 新状态 == L2结构状态::未找到
        ? L2结构状态::未找到 : L2结构状态::已读取;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部历史读取状态。
L2结构状态 映射场景历史读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围读取状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对唯一场景本地键映射。
// 诊断责任：无适用错误分支；只把完整 L1 普通节点映射为 S1 值式事实。
std::optional<L2场景事实> 形成S1场景事实(
    const L1所有者范围节点事实& 节点, L1结构所有者身份 所有者,
    std::uint64_t 事实截止代次) noexcept {
    if (!有效(节点.编码) || 节点.写入所有者 != 所有者
        || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 事实截止代次 || !节点.当前属性.empty()
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 事实截止代次))) {
        return std::nullopt;
    }
    L2场景事实 场景;
    场景.身份 = L2场景身份{节点.编码};
    场景.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    if (!L2场景S1事实完整(场景)) return std::nullopt;
    return 场景;
}

// 诊断责任：无适用错误分支；只形成无载荷的结构化读取失败。
L2场景节点读取结果 形成读取失败(L2结构状态 状态,
    std::uint64_t 事实截止代次 = 0) noexcept {
    return {{L2结构合同版本, 状态, 事实截止代次, std::nullopt}, std::nullopt};
}

L2场景身份来源读取结果 形成场景身份来源读取失败(
    const L2场景身份来源读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
}

L2生命周期 投影场景来源生命周期(
    std::uint64_t 创建, std::optional<std::uint64_t> 退出,
    std::uint64_t 截止) noexcept {
    if (退出 && *退出 > 截止) 退出.reset();
    return {创建, 退出};
}

// 诊断责任：向上送出；当前场景来源由同一 owner-aware 投影裁决。
L2场景身份来源读取结果 读取当前场景身份来源(
    const L1事实基座服务& L1, const 场景身份来源定位& 定位,
    const L2场景身份来源读取请求& 请求) {
    if (请求.场景.值 == 定位.族锚点
        || 请求.场景.值 == 定位.族归属关系类型)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::入口拒绝, 请求.请求头.期望事实代次);
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.所有者 = {定位.所有者};
    L1请求.节点 = {请求.场景.值, 定位.族锚点, 定位.族归属关系类型};
    L1请求.源关系组 = {{请求.场景.值, 定位.族归属关系类型}};
    const auto 读取 = L1.尝试读取所有者范围一致当前投影(L1请求);
    if (读取.状态 != L1所有者范围一致当前读取状态::成功)
        return 形成场景身份来源读取失败(请求,
            映射场景一致读取失败状态(读取.状态), 读取.读取事实代次);
    if (读取.读取事实代次 != 请求.请求头.期望事实代次
        || 读取.所有者.size() != 1 || 读取.节点.size() != 3
        || 读取.源关系组.size() != 1 || !读取.关系.empty()
        || !读取.值.empty() || !读取.属性值.empty()
        || !读取.目标关系组.empty())
        return 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 读取.读取事实代次);
    const auto& 所有者项 = 读取.所有者.front();
    const auto 查节点 = [&](稳定编码 编码)
        -> const L1所有者范围一致节点读取结果项* {
        const L1所有者范围一致节点读取结果项* 找到 = nullptr;
        for (const auto& 项 : 读取.节点) if (项.查询编码 == 编码) {
            if (找到) return nullptr; 找到 = &项;
        }
        return 找到;
    };
    const auto* 节点项 = 查节点(请求.场景.值);
    const auto* 锚点项 = 查节点(定位.族锚点);
    const auto* 类型项 = 查节点(定位.族归属关系类型);
    const auto 成功节点 = [](const auto* 项) noexcept {
        return 项 && 项->状态 == L1所有者范围一致当前读取项目状态::成功
            && 项->事实 && !项->事实->退出事实代次;
    };
    if (!成功节点(节点项)) {
        const auto 状态 = 节点项
            ? 映射场景当前项目状态(节点项->状态) : L2结构状态::未找到;
        return 形成场景身份来源读取失败(请求,
            状态 == L2结构状态::已读取 ? L2结构状态::内部不一致 : 状态,
            读取.读取事实代次);
    }
    if (!成功节点(锚点项) || !成功节点(类型项)
        || 所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实 || 所有者项.所有者事实->退出事实代次)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 读取.读取事实代次);
    const auto& 节点 = *节点项->事实;
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    const auto& 组 = 读取.源关系组.front();
    if (所有者项.查询所有者 != 定位.所有者
        || 所有者项.所有者事实->所有者 != 定位.所有者
        || 所有者项.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者项.所有者事实->创建事实代次 > 定位.建立事实代次
        || 节点.写入所有者 != 定位.所有者 || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 组.成员.size() > 1)
        return 形成场景身份来源读取失败(
            请求, 节点.写入所有者 == 定位.所有者
                ? L2结构状态::内部不一致 : L2结构状态::入口拒绝,
            读取.读取事实代次);
    if (组.成员.empty())
        return 形成场景身份来源读取失败(
            请求, L2结构状态::入口拒绝, 读取.读取事实代次);
    const auto& 关系 = 组.成员.front().关系;
    if (锚点.编码 != 定位.族锚点 || 类型.编码 != 定位.族归属关系类型
        || 锚点.写入所有者 != 定位.所有者
        || 类型.写入所有者 != 定位.所有者
        || 锚点.种类 != 节点种类::普通 || 类型.种类 != 节点种类::普通
        || 锚点.属性类型表示 || 类型.属性类型表示
        || !锚点.当前属性.empty() || !类型.当前属性.empty()
        || 锚点.创建事实代次 != 定位.建立事实代次
        || 类型.创建事实代次 != 定位.建立事实代次
        || 定位.建立事实代次 > 节点.创建事实代次
        || 关系.写入所有者 != 定位.所有者
        || 关系.源节点 != 节点.编码 || 关系.目标节点 != 锚点.编码
        || 关系.关系类型节点 != 类型.编码 || 关系.角色或顺序 != 1
        || 关系.退出事实代次 || 关系.创建事实代次 != 节点.创建事实代次)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 读取.读取事实代次);
    L2节点族身份来源事实 来源{L2节点族::场景, 节点.编码,
        定位.所有者, 锚点.编码, 类型.编码, 关系.编码, 1,
        {所有者项.所有者事实->创建事实代次, std::nullopt},
        {节点.创建事实代次, std::nullopt}, {锚点.创建事实代次, std::nullopt},
        {类型.创建事实代次, std::nullopt}, {关系.创建事实代次, std::nullopt}};
    return L2节点族身份来源事实完整(来源, 读取.读取事实代次)
        ? L2场景身份来源读取结果{{L2结构合同版本,
            L2结构状态::已读取, 读取.读取事实代次, std::nullopt},
            请求.读取类别, 0, std::move(来源)}
        : 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 读取.读取事实代次);
}

// 诊断责任：向上送出；历史来源以权威生命周期和历史关系组投影。
L2场景身份来源读取结果 读取历史场景身份来源(
    const L1事实基座服务& L1, const 场景身份来源定位& 定位,
    const L2场景身份来源读取请求& 请求) {
    const auto 前代次 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (前代次.状态 != L1中性读取状态::成功
        || 前代次.合同版本 != L1中性CRUD合同版本
        || 前代次.事实代次 != 请求.请求头.期望事实代次)
        return 形成场景身份来源读取失败(请求,
            前代次.状态 == L1中性读取状态::成功
                ? L2结构状态::事实代次漂移 : L2结构状态::内部不一致,
            前代次.事实代次);
    const auto 读节点 = [&](稳定编码 编码) {
        return L1.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
    };
    const auto 节点读 = 读节点(请求.场景.值);
    const auto 锚点读 = 读节点(定位.族锚点);
    const auto 类型读 = 读节点(定位.族归属关系类型);
    const auto* 节点 = 节点读.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读.事实) : nullptr;
    const auto* 锚点 = 锚点读.事实
        ? std::get_if<L1所有者范围节点事实>(&*锚点读.事实) : nullptr;
    const auto* 类型 = 类型读.事实
        ? std::get_if<L1所有者范围节点事实>(&*类型读.事实) : nullptr;
    if (节点读.合同版本 != L1所有者范围CRUD合同版本
        || 节点读.查询编码 != 请求.场景.值
        || 节点读.读取事实代次 != 请求.请求头.期望事实代次)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (节点读.状态 != L1所有者范围读取状态::成功 || !节点)
        return 形成场景身份来源读取失败(请求,
            节点读.状态 == L1所有者范围读取状态::未找到
                ? L2结构状态::未找到 : L2结构状态::入口拒绝,
            请求.历史截止事实代次);
    if (节点->创建事实代次 > 请求.历史截止事实代次)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::未找到, 请求.历史截止事实代次);
    if (节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || !锚点 || !类型)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::入口拒绝, 请求.历史截止事实代次);
    const auto 判定截止 = 节点->退出事实代次
            && *节点->退出事实代次 <= 请求.历史截止事实代次
        ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
    const auto 组 = L1.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
            请求.场景.值, 定位.族归属关系类型, 判定截止});
    if (组.合同版本 != L1所有者范围CRUD合同版本
        || 组.方向 != L1所有者范围关系端点方向::源
        || 组.端点节点 != 请求.场景.值
        || 组.关系类型节点 != 定位.族归属关系类型
        || 组.历史截止事实代次 != 判定截止
        || 组.读取事实代次 != 请求.请求头.期望事实代次)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (组.状态 != L1所有者范围读取状态::成功 || 组.关系组.size() != 1)
        return 形成场景身份来源读取失败(
            请求, 组.关系组.empty() ? L2结构状态::入口拒绝
                : L2结构状态::内部不一致, 请求.历史截止事实代次);
    const auto& 关系 = 组.关系组.front();
    const auto 所有者读 = L1.读取历史结构所有者(
        {L1所有者范围CRUD合同版本, 定位.所有者});
    const auto 内部节点完整 = [&](const auto& 读取,
        const L1所有者范围节点事实* 事实, 稳定编码 编码) noexcept {
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码
            && 读取.读取事实代次 == 请求.请求头.期望事实代次
            && 事实 && 事实->编码 == 编码
            && 事实->写入所有者 == 定位.所有者
            && 事实->种类 == 节点种类::普通 && !事实->属性类型表示
            && 事实->当前属性.empty()
            && 事实->创建事实代次 == 定位.建立事实代次;
    };
    if (所有者读.状态 != L1所有者范围读取状态::成功
        || 所有者读.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读.查询所有者 != 定位.所有者
        || 所有者读.读取事实代次 != 请求.请求头.期望事实代次
        || !所有者读.所有者事实
        || 所有者读.所有者事实->所有者 != 定位.所有者
        || 所有者读.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || !内部节点完整(锚点读, 锚点, 定位.族锚点)
        || !内部节点完整(类型读, 类型, 定位.族归属关系类型)
        || 关系.写入所有者 != 定位.所有者
        || 关系.源节点 != 节点->编码 || 关系.目标节点 != 锚点->编码
        || 关系.关系类型节点 != 类型->编码 || 关系.角色或顺序 != 1
        || 关系.创建事实代次 != 节点->创建事实代次
        || 关系.退出事实代次 != 节点->退出事实代次
        || 所有者读.所有者事实->创建事实代次 > 定位.建立事实代次
        || 定位.建立事实代次 > 节点->创建事实代次
        || (所有者读.所有者事实->退出事实代次
            && *所有者读.所有者事实->退出事实代次
                < 节点->退出事实代次.value_or(节点->创建事实代次))
        || (锚点->退出事实代次 && *锚点->退出事实代次
                < 节点->退出事实代次.value_or(节点->创建事实代次))
        || (类型->退出事实代次 && *类型->退出事实代次
                < 节点->退出事实代次.value_or(节点->创建事实代次)))
        return 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    const auto 后代次 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (后代次.状态 != L1中性读取状态::成功
        || 后代次.合同版本 != L1中性CRUD合同版本)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 后代次.事实代次);
    if (后代次.事实代次 != 请求.请求头.期望事实代次
        || 后代次.事实代次 != 前代次.事实代次)
        return 形成场景身份来源读取失败(
            请求, L2结构状态::事实代次漂移, 后代次.事实代次);
    L2节点族身份来源事实 来源{L2节点族::场景, 节点->编码,
        定位.所有者, 锚点->编码, 类型->编码, 关系.编码, 1,
        投影场景来源生命周期(所有者读.所有者事实->创建事实代次,
            所有者读.所有者事实->退出事实代次, 请求.历史截止事实代次),
        投影场景来源生命周期(节点->创建事实代次,
            节点->退出事实代次, 请求.历史截止事实代次),
        投影场景来源生命周期(锚点->创建事实代次,
            锚点->退出事实代次, 请求.历史截止事实代次),
        投影场景来源生命周期(类型->创建事实代次,
            类型->退出事实代次, 请求.历史截止事实代次),
        投影场景来源生命周期(关系.创建事实代次,
            关系.退出事实代次, 请求.历史截止事实代次)};
    return L2节点族身份来源事实完整(来源, 请求.历史截止事实代次)
        ? L2场景身份来源读取结果{{L2结构合同版本,
            L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
            请求.读取类别, 请求.历史截止事实代次, std::move(来源)}
        : 形成场景身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
}

// 诊断责任：向上送出；公开 L1 一致读取的失败与事实矛盾均结构化返回。
L2场景节点读取结果 读取当前场景节点(
    const L1事实基座服务& L1, const L2场景节点读取请求& 请求) {
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    const auto 读取 = L1.尝试读取所有者范围一致当前投影(L1请求);

    if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
        const bool 形状完整 = 读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 请求.请求头.期望事实代次
            && 读取.节点.empty() && 读取.关系.empty() && 读取.值.empty()
            && 读取.属性值.empty() && 读取.源关系组.empty()
            && 读取.目标关系组.empty()
            && (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
                ? 读取.读取事实代次 != 0
                    && 读取.读取事实代次 != 请求.请求头.期望事实代次
                : 读取.读取事实代次 == 0);
        if (!形状完整) return 形成读取失败(L2结构状态::内部不一致);
        return 形成读取失败(映射场景一致读取失败状态(读取.状态),
            读取.读取事实代次);
    }

    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 请求.请求头.期望事实代次
        || 读取.读取事实代次 != 请求.请求头.期望事实代次
        || 读取.读取事实代次 == 0 || 读取.节点.size() != 1
        || !读取.关系.empty() || !读取.值.empty() || !读取.属性值.empty()
        || !读取.源关系组.empty() || !读取.目标关系组.empty()) {
        return 形成读取失败(L2结构状态::内部不一致);
    }

    const auto& 项 = 读取.节点.front();
    if (项.查询编码 != 请求.场景.值) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    if (项.状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (项.事实) return 形成读取失败(L2结构状态::内部不一致,
            读取.读取事实代次);
        return 形成读取失败(映射场景当前项目状态(项.状态),
            读取.读取事实代次);
    }
    if (!项.事实 || 项.事实->退出事实代次) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    auto 场景 = 形成S1场景事实(
        *项.事实, 项.事实->写入所有者, 读取.读取事实代次);
    if (!场景 || 场景->身份 != 请求.场景) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    return {{L2结构合同版本, L2结构状态::已读取,
        读取.读取事实代次, std::nullopt}, std::move(场景)};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖事实代次探测失败。
L2结构状态 映射事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：向上送出；前后代次探测、历史读取与事实矛盾均结构化返回。
L2场景节点读取结果 读取历史场景节点(
    const L1事实基座服务& L1, const L2场景节点读取请求& 请求) {
    const L1中性事实代次读取请求 代次请求{L1中性CRUD合同版本};
    const auto 前代次 = L1.读取中性当前事实代次(代次请求);
    if (前代次.状态 != L1中性读取状态::成功
        || 前代次.合同版本 != L1中性CRUD合同版本) {
        return 形成读取失败(前代次.合同版本 == L1中性CRUD合同版本
            ? 映射事实代次探测失败(前代次.状态)
            : L2结构状态::内部不一致);
    }
    if (前代次.事实代次 != 请求.请求头.期望事实代次) {
        return 形成读取失败(L2结构状态::事实代次漂移, 前代次.事实代次);
    }

    const auto 历史 = L1.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.场景.值});
    const auto 后代次 = L1.读取中性当前事实代次(代次请求);
    if (后代次.状态 != L1中性读取状态::成功
        || 后代次.合同版本 != L1中性CRUD合同版本) {
        return 形成读取失败(后代次.合同版本 == L1中性CRUD合同版本
            ? 映射事实代次探测失败(后代次.状态)
            : L2结构状态::内部不一致);
    }
    if (后代次.事实代次 != 请求.请求头.期望事实代次
        || 后代次.事实代次 != 前代次.事实代次) {
        return 形成读取失败(L2结构状态::事实代次漂移, 后代次.事实代次);
    }

    if (历史.合同版本 != L1所有者范围CRUD合同版本
        || 历史.查询编码 != 请求.场景.值) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    if (历史.状态 != L1所有者范围读取状态::成功) {
        if (历史.事实) return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
        return 形成读取失败(映射场景历史读取状态(历史.状态),
            请求.请求头.期望事实代次);
    }
    const auto* 节点 = 历史.事实
        ? std::get_if<L1所有者范围节点事实>(&*历史.事实) : nullptr;
    if (!节点 || 历史.读取事实代次 == 0
        || 历史.读取事实代次
            != 节点->退出事实代次.value_or(节点->创建事实代次)) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    auto 场景 = 形成S1场景事实(
        *节点, 节点->写入所有者, 请求.请求头.期望事实代次);
    if (!场景 || 场景->身份 != 请求.场景) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.请求头.期望事实代次, std::nullopt}, std::move(场景)};
}

struct 场景S2预检结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 直接提交 = false;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

// 诊断责任：向上送出；场景端点必须由本族正式来源证明，不能仅凭 owner 和普通节点形状。
场景S2预检结果 检查当前场景来源(
    const L1事实基座服务& L1, const 场景身份来源定位& 定位,
    L2场景身份 场景, std::uint64_t 截止) {
    const L2场景身份来源读取请求 请求{
        {L2结构合同版本, 截止}, L2读取类别::当前, 场景, 0};
    const auto 读取 = 读取当前场景身份来源(L1, 定位, 请求);
    if (读取.结果头.合同版本 != L2结构合同版本)
        return {L2结构状态::内部不一致, 读取.结果头.事实截止代次, false};
    if (读取.结果头.状态 == L2结构状态::事实代次漂移)
        return {L2结构状态::事实代次漂移, 读取.结果头.事实截止代次, true};
    if (!读取.成功() || 读取.结果头.事实截止代次 != 截止
        || !读取.身份来源 || 读取.身份来源->节点稳定编码 != 场景.值)
        return {读取.结果头.状态 == L2结构状态::已读取
                ? L2结构状态::内部不一致 : 读取.结果头.状态,
            读取.结果头.事实截止代次, false};
    return {L2结构状态::已读取, 截止, false};
}

// 诊断责任：无适用错误分支；只形成父子写入空载荷失败。
L2场景父子关系写入结果 形成父子写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成成员写入空载荷失败。
L2场景成员关系写入结果 形成成员写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

L2场景宿主结构登记结果 形成场景宿主登记失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

L2场景宿主存在写入结果 形成场景宿主写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

L2场景宿主存在读取结果 形成场景宿主读取失败(
    const L2场景宿主存在读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
}

L2存在当前宿主场景读取结果 形成存在宿主场景读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成完整读取空载荷失败并回显读取类别。
L2场景完整读取结果 形成完整读取失败(
    const L2场景完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖 S2 写入所需全部状态。
L2结构状态 映射场景S2写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::未找到: return L2结构状态::未找到;
    case L1所有者范围写入状态::已退出: return L2结构状态::已退出;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；历史属性值组状态只映射为 S3 结构状态。
L2结构状态 映射历史属性值组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝:
        return L2结构状态::许可拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::未找到:
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；四类 L2 材料无损映射到 L1 中性材料。
L1所有者范围原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1所有者范围独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；四类 L1 材料无损映射到 L2 类型化材料。
L2原始值材料 转换为L2材料(const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1所有者范围独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；把完整 L1 值事实投影到具名截止。
std::optional<L2属性事实> 形成截止属性事实(
    L1所有者范围值事实 值, L1结构所有者身份 所有者,
    std::uint64_t 截止) {
    if (值.写入所有者 != 所有者) return std::nullopt;
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

// 诊断责任：无适用错误分支；登记读取状态只映射为 S2 结构状态。
L2结构状态 映射登记读取状态(L2场景关系类型登记状态 状态) noexcept {
    switch (状态) {
    case L2场景关系类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2场景关系类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2场景关系类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2场景关系类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2场景关系类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2场景关系类型登记状态::已提交:
    case L2场景关系类型登记状态::精确重复:
    case L2场景关系类型登记状态::已读取:
    case L2场景关系类型登记状态::登记未加载:
    case L2场景关系类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；历史关系组状态只映射为 S2 结构状态。
L2结构状态 映射历史关系组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝:
        return L2结构状态::许可拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::未找到:
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；核对一致投影顶层形状并分出漂移直提路径。
场景S2预检结果 解释S2一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取, std::uint64_t 期望代次) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次 && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.所有者.empty() && 读取.节点.empty()
        && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移, 读取.读取事实代次, true};
    return {映射场景一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；普通场景节点骨架允许有序非空当前属性槽。
std::optional<L2场景事实> 形成截止场景节点骨架(
    L1所有者范围节点事实 节点, L1结构所有者身份 所有者,
    std::uint64_t 截止) noexcept {
    if (节点.写入所有者 != 所有者) return std::nullopt;
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 截止))) return std::nullopt;
    for (std::size_t 索引 = 0; 索引 < 节点.当前属性.size(); ++索引) {
        const auto& 槽 = 节点.当前属性[索引];
        if (!有效(槽.属性类型节点) || !有效(槽.当前值)
            || (索引 != 0
                && !(节点.当前属性[索引 - 1].属性类型节点 < 槽.属性类型节点)))
            return std::nullopt;
        for (std::size_t 前索引 = 0; 前索引 < 索引; ++前索引)
            if (节点.当前属性[前索引].当前值 == 槽.当前值) return std::nullopt;
    }
    L2场景事实 场景;
    场景.身份 = L2场景身份{节点.编码};
    场景.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return 场景;
}

// 诊断责任：无适用错误分支；兼容旧私有调用名，返回场景节点骨架。
std::optional<L2场景事实> 形成截止场景节点事实(
    L1所有者范围节点事实 节点, L1结构所有者身份 所有者,
    std::uint64_t 截止) noexcept {
    return 形成截止场景节点骨架(std::move(节点), 所有者, 截止);
}

// 诊断责任：无适用错误分支；把节点生命周期投影到具名截止后形成存在节点。
std::optional<L2存在事实> 形成截止存在节点事实(
    L1所有者范围节点事实 节点, std::uint64_t 截止) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 截止))) return std::nullopt;
    for (std::size_t 索引 = 0; 索引 < 节点.当前属性.size(); ++索引) {
        const auto& 槽 = 节点.当前属性[索引];
        if (!有效(槽.属性类型节点) || !有效(槽.当前值)
            || (索引 != 0
                && !(节点.当前属性[索引 - 1].属性类型节点 < 槽.属性类型节点)))
            return std::nullopt;
        for (std::size_t 前索引 = 0; 前索引 < 索引; ++前索引)
            if (节点.当前属性[前索引].当前值 == 槽.当前值) return std::nullopt;
    }
    L2存在事实 存在{L2存在身份{节点.编码},
        {节点.创建事实代次, 节点.退出事实代次}, {}};
    return 存在;
}

// 诊断责任：无适用错误分支；只判断关系是否命中半开历史区间。
bool 关系在截止有效(const L1所有者范围关系事实& 关系,
    std::uint64_t 截止) noexcept {
    return 截止 != 0 && 关系.创建事实代次 != 0
        && 关系.创建事实代次 <= 截止
        && (!关系.退出事实代次 || 截止 < *关系.退出事实代次);
}

// 诊断责任：无适用错误分支；把 L1 父子关系投影为具名截止的 L2 值式事实。
std::optional<L2场景父子关系事实> 形成截止父子关系事实(
    const L1所有者范围关系事实& 关系, L1结构所有者身份 所有者,
    稳定编码 类型,
    std::uint64_t 截止) noexcept {
    if (关系.写入所有者 != 所有者
        || !有效(关系.编码) || 关系.关系类型节点 != 类型
        || !有效(关系.源节点) || !有效(关系.目标节点)
        || 关系.源节点 == 关系.目标节点 || 关系.角色或顺序 <= 0
        || 关系.创建事实代次 == 0 || 关系.创建事实代次 > 截止
        || (关系.退出事实代次
            && *关系.退出事实代次 < 关系.创建事实代次)) return std::nullopt;
    auto 退出 = 关系.退出事实代次;
    if (退出 && *退出 > 截止) 退出.reset();
    L2场景父子关系事实 结果{关系.编码, L2场景身份{关系.源节点},
        L2场景身份{关系.目标节点},
        static_cast<std::uint64_t>(关系.角色或顺序),
        {关系.创建事实代次, 退出}};
    return L2场景父子关系事实截止投影完整(结果, 截止)
        ? std::optional<L2场景父子关系事实>{std::move(结果)} : std::nullopt;
}

// 诊断责任：无适用错误分支；把 L1 成员关系投影为具名截止的 L2 值式事实。
std::optional<L2场景成员关系事实> 形成截止成员关系事实(
    const L1所有者范围关系事实& 关系, L1结构所有者身份 所有者,
    稳定编码 类型,
    std::uint64_t 截止) noexcept {
    if (关系.写入所有者 != 所有者
        || !有效(关系.编码) || 关系.关系类型节点 != 类型
        || !有效(关系.源节点) || !有效(关系.目标节点)
        || 关系.角色或顺序 <= 0 || 关系.创建事实代次 == 0
        || 关系.创建事实代次 > 截止
        || (关系.退出事实代次
            && *关系.退出事实代次 < 关系.创建事实代次)) return std::nullopt;
    auto 退出 = 关系.退出事实代次;
    if (退出 && *退出 > 截止) 退出.reset();
    L2场景成员关系事实 结果{关系.编码, L2场景身份{关系.源节点},
        L2存在身份{关系.目标节点},
        static_cast<std::uint64_t>(关系.角色或顺序),
        {关系.创建事实代次, 退出}};
    return L2场景成员关系事实截止投影完整(结果, 截止)
        ? std::optional<L2场景成员关系事实>{std::move(结果)} : std::nullopt;
}

std::optional<L2场景宿主存在关系事实> 形成截止场景宿主关系事实(
    const L1所有者范围关系事实& 关系, L1结构所有者身份 所有者,
    稳定编码 类型, std::uint64_t 截止) noexcept {
    if (关系.写入所有者 != 所有者 || !有效(关系.编码)
        || 关系.关系类型节点 != 类型 || !有效(关系.源节点)
        || !有效(关系.目标节点) || 关系.角色或顺序 != 1
        || 关系.创建事实代次 == 0 || 关系.创建事实代次 > 截止
        || (关系.退出事实代次
            && *关系.退出事实代次 < 关系.创建事实代次)) return std::nullopt;
    auto 退出 = 关系.退出事实代次;
    if (退出 && *退出 > 截止) 退出.reset();
    L2场景宿主存在关系事实 结果{关系.编码,
        L2场景身份{关系.源节点}, L2存在身份{关系.目标节点},
        {关系.创建事实代次, 退出}};
    return L2场景宿主存在关系事实截止投影完整(结果, 截止)
        ? std::optional<L2场景宿主存在关系事实>{std::move(结果)}
        : std::nullopt;
}

// 诊断责任：无适用错误分支；只核对 S2 新关系本地键唯一映射。
std::optional<稳定编码> 查找唯一S2关系编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    return 本地键.值 == 本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

struct 父子关系读回规格 final {
    稳定编码 关系;
    L2场景身份 父场景;
    L2场景身份 子场景;
    std::uint64_t 顺序 = 0;
};

struct 成员关系读回规格 final {
    稳定编码 关系;
    L2场景身份 场景;
    L2存在身份 存在;
    std::uint64_t 顺序 = 0;
};

// 诊断责任：向上送出；提交、映射和历史读回矛盾均结构化返回。
L2场景父子关系写入结果 提交并读回父子写集(
    const L1事实基座服务& L1, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    稳定编码 父子类型, std::optional<父子关系读回规格> 新关系,
    std::optional<父子关系读回规格> 旧关系) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射场景S2写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成父子写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整))
        return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);

    if (新关系) {
        const auto 编码 = 查找唯一S2关系编码映射(
            写入, 场景父子关系本地键值);
        if (!编码) return 形成父子写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新关系->关系 = *编码;
    } else if (!写入.新编码映射.empty()) {
        return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);
    }

    L2场景父子关系写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::nullopt, std::nullopt};
    const auto 读取一项 = [&](const 父子关系读回规格& 规格,
        bool 应已退出) -> std::optional<L2场景父子关系事实> {
        const auto 读取 = L1.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 规格.关系});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 规格.关系 || !关系
            || 关系->编码 != 规格.关系) return std::nullopt;
        auto 投影 = 形成截止父子关系事实(
            *关系, 写入端口.所有者身份(), 父子类型, 写入.事实代次);
        if (!投影 || 投影->父场景 != 规格.父场景
            || 投影->子场景 != 规格.子场景 || 投影->顺序 != 规格.顺序)
            return std::nullopt;
        if (应已退出) {
            if (关系->退出事实代次 != 写入.事实代次
                || 投影->生命周期.退出事实代次 != 写入.事实代次)
                return std::nullopt;
        } else if (关系->创建事实代次 != 写入.事实代次
            || 投影->生命周期.退出事实代次) return std::nullopt;
        return 投影;
    };
    if (新关系) {
        结果.当前关系 = 读取一项(*新关系, false);
        if (!结果.当前关系) return 形成父子写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    if (旧关系) {
        结果.已退出关系 = 读取一项(*旧关系, true);
        if (!结果.已退出关系) return 形成父子写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成父子写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；提交、映射和历史读回矛盾均结构化返回。
L2场景成员关系写入结果 提交并读回成员写集(
    const L1事实基座服务& L1, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    稳定编码 成员类型, std::optional<成员关系读回规格> 新关系,
    std::optional<成员关系读回规格> 旧关系) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射场景S2写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成成员写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整))
        return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);

    if (新关系) {
        const auto 编码 = 查找唯一S2关系编码映射(
            写入, 场景成员关系本地键值);
        if (!编码) return 形成成员写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新关系->关系 = *编码;
    } else if (!写入.新编码映射.empty()) {
        return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);
    }

    L2场景成员关系写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::nullopt, std::nullopt};
    const auto 读取一项 = [&](const 成员关系读回规格& 规格,
        bool 应已退出) -> std::optional<L2场景成员关系事实> {
        const auto 读取 = L1.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 规格.关系});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 规格.关系 || !关系
            || 关系->编码 != 规格.关系) return std::nullopt;
        auto 投影 = 形成截止成员关系事实(
            *关系, 写入端口.所有者身份(), 成员类型, 写入.事实代次);
        if (!投影 || 投影->场景 != 规格.场景
            || 投影->存在 != 规格.存在 || 投影->顺序 != 规格.顺序)
            return std::nullopt;
        if (应已退出) {
            if (关系->退出事实代次 != 写入.事实代次
                || 投影->生命周期.退出事实代次 != 写入.事实代次)
                return std::nullopt;
        } else if (关系->创建事实代次 != 写入.事实代次
            || 投影->生命周期.退出事实代次) return std::nullopt;
        return 投影;
    };
    if (新关系) {
        结果.当前关系 = 读取一项(*新关系, false);
        if (!结果.当前关系) return 形成成员写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    if (旧关系) {
        结果.已退出关系 = 读取一项(*旧关系, true);
        if (!结果.已退出关系) return 形成成员写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成成员写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

struct 场景宿主关系读回规格 final {
    稳定编码 关系;
    L2场景身份 场景;
    L2存在身份 宿主存在;
};

L2场景宿主存在写入结果 提交并读回场景宿主写集(
    const L1事实基座服务& L1, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集, 稳定编码 宿主类型,
    std::optional<场景宿主关系读回规格> 新关系,
    std::optional<场景宿主关系读回规格> 旧关系) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 写入端口.所有者身份()
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成场景宿主写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射场景S2写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成场景宿主写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成场景宿主写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整))
        return 形成场景宿主写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    if (新关系) {
        const auto 编码 = 查找唯一S2关系编码映射(
            写入, 场景宿主关系本地键值);
        if (!编码) return 形成场景宿主写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新关系->关系 = *编码;
    } else if (!写入.新编码映射.empty()) {
        return 形成场景宿主写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    const auto 读取一项 = [&](const 场景宿主关系读回规格& 规格,
        bool 应已退出) -> std::optional<L2场景宿主存在关系事实> {
        const auto 读取 = L1.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 规格.关系});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 规格.关系 || !关系
            || 关系->编码 != 规格.关系) return std::nullopt;
        auto 事实 = 形成截止场景宿主关系事实(
            *关系, 写入端口.所有者身份(), 宿主类型, 写入.事实代次);
        if (!事实 || 事实->场景 != 规格.场景
            || 事实->宿主存在 != 规格.宿主存在) return std::nullopt;
        if (应已退出) {
            if (事实->生命周期.退出事实代次 != 写入.事实代次)
                return std::nullopt;
        } else if (事实->生命周期.创建事实代次 != 写入.事实代次
            || 事实->生命周期.退出事实代次) return std::nullopt;
        return 事实;
    };
    L2场景宿主存在写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::nullopt, std::nullopt};
    if (新关系) {
        结果.当前关系 = 读取一项(*新关系, false);
        if (!结果.当前关系) return 形成场景宿主写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    if (旧关系) {
        结果.已退出关系 = 读取一项(*旧关系, true);
        if (!结果.已退出关系) return 形成场景宿主写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成场景宿主写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；当前代次失败或漂移均形成结构化预检结果。
场景S2预检结果 检查S2当前代次(
    const L1事实基座服务& L1, std::uint64_t 期望代次) {
    const auto 读取 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (读取.合同版本 != L1中性CRUD合同版本)
        return {L2结构状态::内部不一致, 读取.事实代次, false};
    if (读取.状态 != L1中性读取状态::成功)
        return {映射事实代次探测失败(读取.状态), 读取.事实代次, false};
    if (读取.事实代次 == 0)
        return {L2结构状态::内部不一致, 0, false};
    if (读取.事实代次 != 期望代次)
        return {L2结构状态::事实代次漂移, 读取.事实代次, true};
    return {L2结构状态::已读取, 读取.事实代次, false};
}

// 诊断责任：无适用错误分支；按查询编码查找唯一节点结果项。
const L1所有者范围一致节点读取结果项* 查找唯一节点项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；按查询编码查找唯一关系结果项。
const L1所有者范围一致关系读取结果项* 查找唯一关系项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致关系读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.关系) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只核对当前普通场景节点结果项。
bool 当前场景节点项完整(const L1所有者范围一致节点读取结果项* 项,
    稳定编码 编码, L1结构所有者身份 所有者,
    std::uint64_t 截止) noexcept {
    if (!项 || 项->查询编码 != 编码
        || 项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !项->事实 || 项->事实->退出事实代次) return false;
    const auto 场景 = 形成截止场景节点事实(*项->事实, 所有者, 截止);
    return 场景 && 场景->身份.值 == 编码;
}

// 诊断责任：无适用错误分支；只核对当前父子关系逐字段形状。
bool 当前父子关系完整(const L1所有者范围关系事实& 关系,
    L1结构所有者身份 所有者, 稳定编码 类型,
    L2场景身份 父场景, L2场景身份 子场景,
    std::uint64_t 顺序, std::uint64_t 截止) noexcept {
    const auto 投影 = 形成截止父子关系事实(关系, 所有者, 类型, 截止);
    return 投影 && !关系.退出事实代次
        && 投影->父场景 == 父场景 && 投影->子场景 == 子场景
        && 投影->顺序 == 顺序 && !投影->生命周期.退出事实代次;
}

// 诊断责任：无适用错误分支；只核对当前成员关系逐字段形状。
bool 当前成员关系完整(const L1所有者范围关系事实& 关系,
    L1结构所有者身份 所有者, 稳定编码 类型,
    L2场景身份 场景, L2存在身份 存在,
    std::uint64_t 顺序, std::uint64_t 截止) noexcept {
    const auto 投影 = 形成截止成员关系事实(关系, 所有者, 类型, 截止);
    return 投影 && !关系.退出事实代次
        && 投影->场景 == 场景 && 投影->存在 == 存在
        && 投影->顺序 == 顺序 && !投影->生命周期.退出事实代次;
}

// 诊断责任：向上送出；沿父子源关系组遍历后继并拒绝新父进入闭包。
场景S2预检结果 检查父子无环(
    const L1事实基座服务& L1, L2场景身份 子场景,
    L2场景身份 新父场景, L1结构所有者身份 所有者,
    稳定编码 父子类型, std::uint64_t 截止) {
    std::vector<稳定编码> 已访问{子场景.值};
    for (std::size_t 当前索引 = 0; 当前索引 < 已访问.size(); ++当前索引) {
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 截止;
        请求.源关系组 = {{已访问[当前索引], 父子类型}};
        const auto 读取 = L1.尝试读取所有者范围一致当前投影(请求);
        const auto 顶层 = 解释S2一致读取顶层(读取, 截止);
        if (!顶层.成功()) return 顶层;
        if (!读取.节点.empty() || !读取.关系.empty() || !读取.值.empty()
            || !读取.属性值.empty() || !读取.目标关系组.empty()
            || 读取.源关系组.size() != 1) {
            return {L2结构状态::内部不一致, 截止, false};
        }
        const auto& 关系组 = 读取.源关系组.front();
        if (关系组.源节点 != 已访问[当前索引]
            || 关系组.关系类型节点 != 父子类型)
            return {L2结构状态::内部不一致, 截止, false};
        for (const auto& 成员 : 关系组.成员) {
            if (!当前父子关系完整(成员.关系, 所有者, 父子类型,
                    L2场景身份{已访问[当前索引]},
                    L2场景身份{成员.对端节点.编码},
                    static_cast<std::uint64_t>(成员.关系.角色或顺序), 截止)
                || 成员.关系.目标节点 != 成员.对端节点.编码
                || !形成截止场景节点事实(成员.对端节点, 所有者, 截止)
                || 成员.对端节点.退出事实代次) {
                return {L2结构状态::内部不一致, 截止, false};
            }
            if (成员.对端节点.编码 == 新父场景.值)
                return {L2结构状态::引用冲突, 截止, false};
            if (std::find(已访问.begin(), 已访问.end(),
                    成员.对端节点.编码) != 已访问.end())
                return {L2结构状态::内部不一致, 截止, false};
            已访问.push_back(成员.对端节点.编码);
        }
    }
    return {L2结构状态::已读取, 截止, false};
}

// 诊断责任：无适用错误分支；向唯一向量追加不重复编码。
void 追加唯一编码(std::vector<稳定编码>& 编码组, 稳定编码 编码) {
    if (std::find(编码组.begin(), 编码组.end(), 编码) == 编码组.end())
        编码组.push_back(编码);
}

// 诊断责任：向上送出；父子替换旧关系、唯一父与无环预检均结构化返回。
场景S2预检结果 检查父子替换前置(
    const L1事实基座服务& L1, const L2场景父子关系替换请求& 请求,
    const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记) {
    for (const auto 场景 : {请求.旧父场景, 请求.新父场景, 请求.子场景}) {
        const auto 来源 = 检查当前场景来源(
            L1, 来源定位, 场景, 请求.请求头.期望事实代次);
        if (!来源.成功()) return 来源;
    }
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    追加唯一编码(L1请求.节点, 请求.旧父场景.值);
    追加唯一编码(L1请求.节点, 请求.新父场景.值);
    追加唯一编码(L1请求.节点, 请求.子场景.值);
    L1请求.关系 = {请求.旧关系稳定编码};
    L1请求.目标关系组 = {{请求.子场景.值, 登记.父子关系类型.值}};
    const auto 读取 = L1.尝试读取所有者范围一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != L1请求.节点.size() || 读取.关系.size() != 1
        || !读取.值.empty() || !读取.属性值.empty()
        || !读取.源关系组.empty() || 读取.目标关系组.size() != 1)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    L2结构状态 端点状态 = L2结构状态::已读取;
    for (const auto 编码 : L1请求.节点) {
        const auto* 项 = 查找唯一节点项(读取, 编码);
        if (!当前场景节点项完整(项, 编码,
            项 && 项->事实 ? 项->事实->写入所有者 : L1结构所有者身份{},
            顶层.事实截止代次))
            端点状态 = 合并场景端点失败状态(端点状态,
                映射场景当前失败项目(项));
    }
    if (端点状态 != L2结构状态::已读取)
        return {端点状态, 顶层.事实截止代次, false};
    const auto* 关系项 = 查找唯一关系项(读取, 请求.旧关系稳定编码);
    if (!关系项 || 关系项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !关系项->事实)
        return {映射场景当前失败项目(关系项),
            顶层.事实截止代次, false};
    if (!当前父子关系完整(*关系项->事实, 来源定位.所有者,
            登记.父子关系类型.值,
            请求.旧父场景, 请求.子场景, 请求.旧顺序, 顶层.事实截止代次))
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    const auto& 组 = 读取.目标关系组.front();
    if (组.目标节点 != 请求.子场景.值
        || 组.关系类型节点 != 登记.父子关系类型.值
        || 组.成员.size() != 1
        || 组.成员.front().关系.编码 != 请求.旧关系稳定编码
        || 组.成员.front().对端节点.编码 != 请求.旧父场景.值)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return 检查父子无环(L1, 请求.子场景, 请求.新父场景,
        来源定位.所有者,
        登记.父子关系类型.值, 顶层.事实截止代次);
}

// 诊断责任：向上送出；存在端点只经 E-ID 正式身份来源验证。
场景S2预检结果 检查成员存在端点(
    const L2存在结构服务& 存在服务, L2存在身份 存在,
    std::uint64_t 截止) {
    const auto 读取 = 存在服务.读取存在身份来源(
        {{L2结构合同版本, 截止}, L2读取类别::当前, 存在, 0});
    if (读取.结果头.合同版本 != L2结构合同版本)
        return {L2结构状态::内部不一致, 读取.结果头.事实截止代次, false};
    if (读取.结果头.状态 == L2结构状态::事实代次漂移)
        return {L2结构状态::事实代次漂移,
            读取.结果头.事实截止代次, true};
    if (读取.结果头.状态 != L2结构状态::已读取)
        return {读取.结果头.状态, 读取.结果头.事实截止代次, false};
    if (读取.结果头.事实截止代次 != 截止
        || 读取.结果头.变更事实代次 || !读取.身份来源
        || 读取.身份来源->节点族 != L2节点族::存在
        || 读取.身份来源->节点稳定编码 != 存在.值
        || !L2节点族身份来源事实完整(*读取.身份来源, 截止))
        return {L2结构状态::内部不一致, 截止, false};
    return {L2结构状态::已读取, 截止, false};
}

struct 成员源组核对结果 final {
    bool 形状完整 = false;
    std::size_t 同存在数量 = 0;
    bool 具名旧关系匹配 = false;
};

// 诊断责任：无适用错误分支；核对成员源组方向、端点和同对唯一计数。
成员源组核对结果 核对成员源组(
    const L1所有者范围一致源关系组读取结果项& 组, L2场景身份 场景,
    L2存在身份 存在, L1结构所有者身份 所有者,
    稳定编码 成员类型, std::uint64_t 截止,
    std::optional<稳定编码> 具名旧关系 = std::nullopt,
    std::optional<std::uint64_t> 旧顺序 = std::nullopt) noexcept {
    if (组.源节点 != 场景.值 || 组.关系类型节点 != 成员类型)
        return {};
    成员源组核对结果 结果{true, 0, false};
    for (const auto& 成员 : 组.成员) {
        if (成员.关系.目标节点 != 成员.对端节点.编码
            || !形成截止存在节点事实(成员.对端节点, 截止)
            || 成员.对端节点.退出事实代次
            || !当前成员关系完整(成员.关系, 所有者, 成员类型, 场景,
                L2存在身份{成员.对端节点.编码},
                static_cast<std::uint64_t>(成员.关系.角色或顺序), 截止))
            return {};
        if (成员.对端节点.编码 != 存在.值) continue;
        ++结果.同存在数量;
        if (具名旧关系 && 旧顺序
            && 成员.关系.编码 == *具名旧关系
            && 成员.关系.角色或顺序 == static_cast<std::int64_t>(*旧顺序))
            结果.具名旧关系匹配 = true;
    }
    return 结果;
}

// 诊断责任：向上送出；成员新增端点与同场景存在唯一性预检均结构化返回。
场景S2预检结果 检查成员新增前置(
    const L1事实基座服务& L1, const L2存在结构服务& 存在服务,
    const L2场景成员关系新增请求& 请求,
    const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记) {
    const auto 场景来源 = 检查当前场景来源(
        L1, 来源定位, 请求.场景, 请求.请求头.期望事实代次);
    if (!场景来源.成功()) return 场景来源;
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    L1请求.源关系组 = {{请求.场景.值, 登记.成员关系类型.值}};
    const auto 读取 = L1.尝试读取所有者范围一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 1 || !读取.关系.empty() || !读取.值.empty()
        || !读取.属性值.empty() || 读取.源关系组.size() != 1
        || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 场景项 = 查找唯一节点项(读取, 请求.场景.值);
    if (!当前场景节点项完整(场景项, 请求.场景.值,
        场景项 && 场景项->事实
            ? 场景项->事实->写入所有者 : L1结构所有者身份{},
        顶层.事实截止代次))
        return {场景项 && 场景项->状态 == L1所有者范围一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 场景项 && 场景项->状态 == L1所有者范围一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    const auto 存在结果 = 检查成员存在端点(
        存在服务, 请求.存在, 顶层.事实截止代次);
    if (!存在结果.成功()) return 存在结果;
    const auto 组结果 = 核对成员源组(读取.源关系组.front(),
        请求.场景, 请求.存在, 来源定位.所有者,
        登记.成员关系类型.值, 顶层.事实截止代次);
    if (!组结果.形状完整)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    return 组结果.同存在数量 == 0
        ? 场景S2预检结果{L2结构状态::已读取, 顶层.事实截止代次, false}
        : 场景S2预检结果{L2结构状态::引用冲突, 顶层.事实截止代次, false};
}

// 诊断责任：向上送出；成员替换旧关系、端点与同对唯一预检均结构化返回。
场景S2预检结果 检查成员替换前置(
    const L1事实基座服务& L1, const L2存在结构服务& 存在服务,
    const L2场景成员关系替换请求& 请求,
    const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记) {
    for (const auto 场景 : {请求.旧场景, 请求.新场景}) {
        const auto 来源 = 检查当前场景来源(
            L1, 来源定位, 场景, 请求.请求头.期望事实代次);
        if (!来源.成功()) return 来源;
    }
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    追加唯一编码(L1请求.节点, 请求.旧场景.值);
    追加唯一编码(L1请求.节点, 请求.新场景.值);
    L1请求.关系 = {请求.旧关系稳定编码};
    L1请求.源关系组 = {{请求.旧场景.值, 登记.成员关系类型.值}};
    if (请求.新场景 != 请求.旧场景)
        L1请求.源关系组.push_back(
            {请求.新场景.值, 登记.成员关系类型.值});
    const auto 读取 = L1.尝试读取所有者范围一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != L1请求.节点.size() || 读取.关系.size() != 1
        || !读取.值.empty() || !读取.属性值.empty()
        || 读取.源关系组.size() != L1请求.源关系组.size()
        || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    for (const auto 编码 : L1请求.节点) {
        const auto* 项 = 查找唯一节点项(读取, 编码);
        if (!当前场景节点项完整(项, 编码,
            项 && 项->事实 ? 项->事实->写入所有者 : L1结构所有者身份{},
            顶层.事实截止代次))
            return {项 && 项->状态 == L1所有者范围一致当前读取项目状态::已退出
                    ? L2结构状态::已退出
                    : 项 && 项->状态 == L1所有者范围一致当前读取项目状态::未找到
                        ? L2结构状态::未找到 : L2结构状态::内部不一致,
                顶层.事实截止代次, false};
    }
    const auto 存在结果 = 检查成员存在端点(
        存在服务, 请求.存在, 顶层.事实截止代次);
    if (!存在结果.成功()) return 存在结果;
    const auto* 关系项 = 查找唯一关系项(读取, 请求.旧关系稳定编码);
    if (!关系项 || 关系项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !关系项->事实)
        return {关系项 && 关系项->状态 == L1所有者范围一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 关系项 && 关系项->状态 == L1所有者范围一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    if (!当前成员关系完整(*关系项->事实, 来源定位.所有者,
            登记.成员关系类型.值,
            请求.旧场景, 请求.存在, 请求.旧顺序, 顶层.事实截止代次))
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    const auto 旧组结果 = 核对成员源组(读取.源关系组.front(),
        请求.旧场景, 请求.存在, 来源定位.所有者,
        登记.成员关系类型.值,
        顶层.事实截止代次, 请求.旧关系稳定编码, 请求.旧顺序);
    if (!旧组结果.形状完整 || 旧组结果.同存在数量 != 1
        || !旧组结果.具名旧关系匹配)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    if (请求.新场景 != 请求.旧场景) {
        const auto 新组结果 = 核对成员源组(读取.源关系组.back(),
            请求.新场景, 请求.存在, 来源定位.所有者,
            登记.成员关系类型.值,
            顶层.事实截止代次);
        if (!新组结果.形状完整)
            return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
        if (新组结果.同存在数量 != 0)
            return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    }
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：向上送出；成员退出具名关系、端点与同对唯一预检均结构化返回。
场景S2预检结果 检查成员退出前置(
    const L1事实基座服务& L1, const L2存在结构服务& 存在服务,
    const L2场景成员关系退出请求& 请求,
    const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记) {
    const auto 场景来源 = 检查当前场景来源(
        L1, 来源定位, 请求.场景, 请求.请求头.期望事实代次);
    if (!场景来源.成功()) return 场景来源;
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    L1请求.关系 = {请求.关系稳定编码};
    L1请求.源关系组 = {{请求.场景.值, 登记.成员关系类型.值}};
    const auto 读取 = L1.尝试读取所有者范围一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 1 || 读取.关系.size() != 1
        || !读取.值.empty() || !读取.属性值.empty()
        || 读取.源关系组.size() != 1 || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 场景项 = 查找唯一节点项(读取, 请求.场景.值);
    if (!当前场景节点项完整(场景项, 请求.场景.值,
        场景项 && 场景项->事实
            ? 场景项->事实->写入所有者 : L1结构所有者身份{},
        顶层.事实截止代次))
        return {场景项 && 场景项->状态 == L1所有者范围一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 场景项 && 场景项->状态 == L1所有者范围一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    const auto 存在结果 = 检查成员存在端点(
        存在服务, 请求.存在, 顶层.事实截止代次);
    if (!存在结果.成功()) return 存在结果;
    const auto* 关系项 = 查找唯一关系项(读取, 请求.关系稳定编码);
    if (!关系项 || 关系项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !关系项->事实)
        return {关系项 && 关系项->状态 == L1所有者范围一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 关系项 && 关系项->状态 == L1所有者范围一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    if (!当前成员关系完整(*关系项->事实, 来源定位.所有者,
            登记.成员关系类型.值,
            请求.场景, 请求.存在, 请求.顺序, 顶层.事实截止代次))
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    const auto 组结果 = 核对成员源组(读取.源关系组.front(),
        请求.场景, 请求.存在, 来源定位.所有者,
        登记.成员关系类型.值,
        顶层.事实截止代次, 请求.关系稳定编码, 请求.顺序);
    if (!组结果.形状完整 || 组结果.同存在数量 != 1
        || !组结果.具名旧关系匹配)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：无适用错误分支；只形成固定属性写入空载荷失败。
L2场景固定属性写入结果 形成固定属性写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成按存在反向查询的空载荷失败。
L2存在当前场景成员引用读取结果 形成存在成员引用读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, {}};
}

// 诊断责任：向上送出；同期场景节点与具名属性槽前置均结构化返回。
场景S2预检结果 检查固定属性前置(
    const L1事实基座服务& L1, const 场景身份来源定位& 来源定位,
    L2场景身份 场景, 稳定编码 属性类型,
    std::optional<稳定编码> 期望旧值, std::uint64_t 截止) {
    const auto 来源 = 检查当前场景来源(L1, 来源定位, 场景, 截止);
    if (!来源.成功()) return 来源;
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 截止;
    请求.节点 = {场景.值};
    请求.属性值 = {{场景.值, 属性类型}};
    const auto 读取 = L1.尝试读取所有者范围一致当前投影(请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 截止);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 1 || 读取.属性值.size() != 1
        || !读取.关系.empty() || !读取.值.empty()
        || !读取.源关系组.empty() || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 节点项 = 查找唯一节点项(读取, 场景.值);
    if (!当前场景节点项完整(节点项, 场景.值,
        节点项 && 节点项->事实
            ? 节点项->事实->写入所有者 : L1结构所有者身份{}, 截止))
        return {映射场景当前失败项目(节点项), 顶层.事实截止代次, false};
    const auto& 属性项 = 读取.属性值.front();
    if (属性项.节点 != 场景.值 || 属性项.属性类型 != 属性类型)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    if (属性项.状态 == L1所有者范围一致当前读取项目状态::属性未设置) {
        if (属性项.投影)
            return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
        return 期望旧值
            ? 场景S2预检结果{L2结构状态::属性未设置,
                顶层.事实截止代次, false}
            : 场景S2预检结果{L2结构状态::已读取,
                顶层.事实截止代次, false};
    }
    if (属性项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !属性项.投影 || 属性项.投影->属性槽.属性类型节点 != 属性类型
        || 属性项.投影->属性槽.当前值
            != 属性项.投影->当前值事实.编码
        || 属性项.投影->当前值事实.所属节点 != 场景.值
        || 属性项.投影->当前值事实.属性类型节点 != 属性类型
        || 属性项.投影->当前值事实.退出事实代次
        || !形成截止属性事实(属性项.投影->当前值事实,
            来源定位.所有者, 截止))
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    if (!期望旧值 || 属性项.投影->当前值事实.编码 != *期望旧值)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：无适用错误分支；固定属性类型只能来自场景 owner 的四项正式登记。
bool 场景属性类型已登记(
    const L2场景属性类型登记& 登记, 稳定编码 属性类型) noexcept {
    return 属性类型 == 登记.I64属性类型.值
        || 属性类型 == 登记.I64组属性类型.值
        || 属性类型 == 登记.U64组属性类型.值
        || 属性类型 == 登记.独立材料属性类型.值;
}

// 诊断责任：向上送出；属性写集提交、首次映射和历史读回矛盾均结构化返回。
L2场景固定属性写入结果 提交并读回固定属性写集(
    const L1事实基座服务& L1, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    L2场景身份 场景, const L2属性提交项& 新属性,
    std::optional<稳定编码> 旧值编码) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成固定属性写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射场景S2写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成固定属性写入失败(L2结构状态::内部不一致,
                写入.事实代次);
        return 形成固定属性写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    const auto 新值编码 = 查找唯一S2关系编码映射(写入, 场景固定属性值本地键值);
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !新值编码)
        return 形成固定属性写入失败(L2结构状态::内部不一致, 写入.事实代次);

    const auto 属性组 = L1.读取所有者范围历史属性值组(
        {L1所有者范围CRUD合同版本, 场景.值, 写入.事实代次});
    if (属性组.状态 != L1所有者范围读取状态::成功
        || 属性组.合同版本 != L1所有者范围CRUD合同版本
        || 属性组.所属节点 != 场景.值
        || 属性组.历史截止事实代次 != 写入.事实代次
        || 属性组.读取事实代次 < 写入.事实代次)
        return 形成固定属性写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const L1所有者范围值事实* 新值 = nullptr;
    for (const auto& 值 : 属性组.属性值组) {
        if (值.编码 != *新值编码) continue;
        if (新值) return 形成固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新值 = &值;
    }
    if (!新值 || 新值->所属节点 != 场景.值
        || 新值->属性类型节点 != 新属性.属性类型身份
        || 新值->来源节点 != 新属性.来源稳定编码
        || 转换为L2材料(新值->材料) != 新属性.原始值材料
        || 新值->创建事实代次 != 写入.事实代次 || 新值->退出事实代次)
        return 形成固定属性写入失败(L2结构状态::内部不一致, 写入.事实代次);
    auto 当前属性 = 形成截止属性事实(
        *新值, 写入端口.所有者身份(), 写入.事实代次);
    if (!当前属性 || 当前属性->退出事实代次)
        return 形成固定属性写入失败(L2结构状态::内部不一致, 写入.事实代次);

    L2场景固定属性写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(当前属性), std::nullopt};
    if (旧值编码) {
        const auto 旧读取 = L1.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, *旧值编码});
        const auto* 旧值 = 旧读取.事实
            ? std::get_if<L1所有者范围值事实>(&*旧读取.事实) : nullptr;
        if (旧读取.状态 != L1所有者范围读取状态::成功
            || 旧读取.合同版本 != L1所有者范围CRUD合同版本
            || 旧读取.查询编码 != *旧值编码 || !旧值
            || 旧值->编码 != *旧值编码 || 旧值->所属节点 != 场景.值
            || 旧值->属性类型节点 != 新属性.属性类型身份
            || 旧值->退出事实代次 != 写入.事实代次)
            return 形成固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        结果.已退出属性 = 形成截止属性事实(
            *旧值, 写入端口.所有者身份(), 写入.事实代次);
        if (!结果.已退出属性
            || 结果.已退出属性->退出事实代次 != 写入.事实代次)
            return 形成固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成固定属性写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

struct 当前场景快照结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    std::optional<L2节点族身份来源事实> 身份来源;
    std::optional<L2场景事实> 场景;
    std::optional<L2场景父子关系事实> 直接父关系;
    bool 成功() const noexcept {
        return 状态 == L2结构状态::已读取 && 场景.has_value();
    }
};

// 诊断责任：向上送出；两次同期一致投影形成完整场景及可选唯一父关系。
当前场景快照结果 读取当前场景快照(
    const L1事实基座服务& L1, const L2存在结构服务& 存在服务,
    L2场景身份 场景身份, std::uint64_t 期望代次,
    const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记,
    const L2场景属性类型登记& 属性登记, bool 包含直接父关系) {
    const L2场景身份来源读取请求 来源请求{
        {L2结构合同版本, 期望代次}, L2读取类别::当前, 场景身份, 0};
    const auto 来源 = 读取当前场景身份来源(L1, 来源定位, 来源请求);
    if (!来源.成功() || !来源.身份来源)
        return {来源.结果头.状态, 来源.结果头.事实截止代次};
    L1所有者范围一致当前读取请求 首次请求;
    首次请求.合同版本 = L1所有者范围一致当前读取合同版本;
    首次请求.期望事实代次 = 期望代次;
    首次请求.节点 = {场景身份.值};
    const auto 首次读取 = L1.尝试读取所有者范围一致当前投影(首次请求);
    const auto 首次顶层 = 解释S2一致读取顶层(首次读取, 期望代次);
    if (!首次顶层.成功()) return {首次顶层.状态, 首次顶层.事实截止代次};
    if (首次读取.节点.size() != 1 || !首次读取.关系.empty()
        || !首次读取.值.empty() || !首次读取.属性值.empty()
        || !首次读取.源关系组.empty() || !首次读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 首次顶层.事实截止代次};
    const auto* 首次场景项 = 查找唯一节点项(首次读取, 场景身份.值);
    if (!首次场景项) return {L2结构状态::内部不一致, 首次顶层.事实截止代次};
    if (首次场景项->状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (首次场景项->事实) return {L2结构状态::内部不一致,
            首次顶层.事实截止代次};
        return {映射场景当前项目状态(首次场景项->状态),
            首次顶层.事实截止代次};
    }
    if (!首次场景项->事实 || 首次场景项->事实->退出事实代次
        || !形成截止场景节点骨架(*首次场景项->事实,
            首次场景项->事实->写入所有者, 期望代次))
        return {L2结构状态::内部不一致, 首次顶层.事实截止代次};

    L1所有者范围一致当前读取请求 完整请求;
    完整请求.合同版本 = L1所有者范围一致当前读取合同版本;
    完整请求.期望事实代次 = 期望代次;
    完整请求.节点 = {场景身份.值};
    for (const auto& 槽 : 首次场景项->事实->当前属性)
        完整请求.属性值.push_back({场景身份.值, 槽.属性类型节点});
    完整请求.源关系组 = {{场景身份.值, 登记.父子关系类型.值},
        {场景身份.值, 登记.成员关系类型.值}};
    if (包含直接父关系)
        完整请求.目标关系组 = {{场景身份.值, 登记.父子关系类型.值}};
    const auto 完整读取 = L1.尝试读取所有者范围一致当前投影(完整请求);
    const auto 完整顶层 = 解释S2一致读取顶层(完整读取, 期望代次);
    if (!完整顶层.成功()) return {完整顶层.状态, 完整顶层.事实截止代次};
    if (完整读取.节点.size() != 1 || !完整读取.关系.empty()
        || !完整读取.值.empty()
        || 完整读取.属性值.size() != 完整请求.属性值.size()
        || 完整读取.源关系组.size() != 2
        || 完整读取.目标关系组.size() != (包含直接父关系 ? 1U : 0U))
        return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
    const auto* 完整场景项 = 查找唯一节点项(完整读取, 场景身份.值);
    if (!完整场景项
        || 完整场景项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !完整场景项->事实 || 完整场景项->事实->退出事实代次
        || 完整场景项->事实->当前属性 != 首次场景项->事实->当前属性)
        return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
    auto 场景 = 形成截止场景节点骨架(*完整场景项->事实,
        完整场景项->事实->写入所有者, 期望代次);
    if (!场景 || 场景->身份 != 场景身份)
        return {L2结构状态::内部不一致, 完整顶层.事实截止代次};

    for (const auto& 槽 : 完整场景项->事实->当前属性) {
        if (!场景属性类型已登记(属性登记, 槽.属性类型节点))
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        const L1所有者范围一致属性值读取结果项* 找到 = nullptr;
        for (const auto& 项 : 完整读取.属性值) {
            if (项.节点 != 场景身份.值 || 项.属性类型 != 槽.属性类型节点) continue;
            if (找到) return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
            找到 = &项;
        }
        if (!找到 || 找到->状态 != L1所有者范围一致当前读取项目状态::成功
            || !找到->投影 || 找到->投影->属性槽 != 槽
            || 找到->投影->当前值事实.编码 != 槽.当前值
            || 找到->投影->当前值事实.所属节点 != 场景身份.值
            || 找到->投影->当前值事实.属性类型节点 != 槽.属性类型节点
            || 找到->投影->当前值事实.退出事实代次)
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        auto 属性 = 形成截止属性事实(找到->投影->当前值事实,
            来源定位.所有者, 期望代次);
        if (!属性 || 属性->退出事实代次)
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        场景->固定属性.push_back(std::move(*属性));
    }

    const auto& 父子组 = 完整读取.源关系组[0];
    const auto& 成员组 = 完整读取.源关系组[1];
    if (父子组.源节点 != 场景身份.值
        || 父子组.关系类型节点 != 登记.父子关系类型.值
        || 成员组.源节点 != 场景身份.值
        || 成员组.关系类型节点 != 登记.成员关系类型.值)
        return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
    std::vector<稳定编码> 子场景组;
    for (const auto& 成员 : 父子组.成员) {
        if (成员.关系.目标节点 != 成员.对端节点.编码
            || 成员.对端节点.退出事实代次
            || !形成截止场景节点骨架(成员.对端节点,
                成员.对端节点.写入所有者, 期望代次)
            || std::find(子场景组.begin(), 子场景组.end(),
                成员.对端节点.编码) != 子场景组.end())
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        const auto 子来源 = 检查当前场景来源(L1, 来源定位,
            L2场景身份{成员.对端节点.编码}, 期望代次);
        if (!子来源.成功()) return {子来源.直接提交
                ? L2结构状态::事实代次漂移 : 子来源.状态,
            子来源.事实截止代次};
        auto 关系 = 形成截止父子关系事实(成员.关系,
            来源定位.所有者, 登记.父子关系类型.值, 期望代次);
        if (!关系 || 关系->父场景 != 场景身份
            || 关系->子场景.值 != 成员.对端节点.编码
            || 关系->生命周期.退出事实代次)
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        子场景组.push_back(成员.对端节点.编码);
        场景->直接子场景.push_back(std::move(*关系));
    }
    std::vector<稳定编码> 存在组;
    for (const auto& 成员 : 成员组.成员) {
        if (成员.关系.目标节点 != 成员.对端节点.编码
            || 成员.对端节点.退出事实代次
            || !形成截止存在节点事实(成员.对端节点, 期望代次)
            || std::find(存在组.begin(), 存在组.end(),
                成员.对端节点.编码) != 存在组.end())
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        const auto 存在结果 = 检查成员存在端点(
            存在服务, L2存在身份{成员.对端节点.编码}, 期望代次);
        if (!存在结果.成功()) return {存在结果.直接提交
                ? L2结构状态::事实代次漂移 : 存在结果.状态,
            存在结果.事实截止代次};
        auto 关系 = 形成截止成员关系事实(成员.关系,
            来源定位.所有者, 登记.成员关系类型.值, 期望代次);
        if (!关系 || 关系->场景 != 场景身份
            || 关系->存在.值 != 成员.对端节点.编码
            || 关系->生命周期.退出事实代次)
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        存在组.push_back(成员.对端节点.编码);
        场景->直接成员.push_back(std::move(*关系));
    }

    std::optional<L2场景父子关系事实> 父关系;
    if (包含直接父关系) {
        const auto& 目标组 = 完整读取.目标关系组.front();
        if (目标组.目标节点 != 场景身份.值
            || 目标组.关系类型节点 != 登记.父子关系类型.值
            || 目标组.成员.size() > 1)
            return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        if (!目标组.成员.empty()) {
            const auto& 成员 = 目标组.成员.front();
            if (成员.关系.源节点 != 成员.对端节点.编码
                || 成员.对端节点.退出事实代次
                || !形成截止场景节点骨架(成员.对端节点,
                    成员.对端节点.写入所有者, 期望代次))
                return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
            const auto 父来源 = 检查当前场景来源(L1, 来源定位,
                L2场景身份{成员.对端节点.编码}, 期望代次);
            if (!父来源.成功()) return {父来源.直接提交
                    ? L2结构状态::事实代次漂移 : 父来源.状态,
                父来源.事实截止代次};
            父关系 = 形成截止父子关系事实(成员.关系,
                来源定位.所有者, 登记.父子关系类型.值, 期望代次);
            if (!父关系 || 父关系->父场景.值 != 成员.对端节点.编码
                || 父关系->子场景 != 场景身份 || 父关系->生命周期.退出事实代次)
                return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
        }
    }
    std::sort(场景->固定属性.begin(), 场景->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    std::sort(场景->直接子场景.begin(), 场景->直接子场景.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.子场景.值 < 右.子场景.值);
        });
    std::sort(场景->直接成员.begin(), 场景->直接成员.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.存在.值 < 右.存在.值);
        });
    if (!L2场景事实完整(*场景, 期望代次))
        return {L2结构状态::内部不一致, 完整顶层.事实截止代次};
    return {L2结构状态::已读取, 期望代次, std::move(来源.身份来源),
        std::move(场景), std::move(父关系)};
}

// 诊断责任：向上送出；当前快照失败不携带部分场景。
L2场景完整读取结果 读取当前完整场景(
    const L1事实基座服务& L1, const L2存在结构服务& 存在服务,
    const L2场景完整读取请求& 请求,
    const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记,
    const L2场景属性类型登记& 属性登记) {
    auto 快照 = 读取当前场景快照(L1, 存在服务, 请求.场景,
        请求.请求头.期望事实代次, 来源定位, 登记, 属性登记, false);
    if (!快照.成功())
        return 形成完整读取失败(请求, 快照.状态, 快照.事实截止代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        快照.事实截止代次, std::nullopt}, 请求.读取类别, 0,
        std::move(快照.场景)};
}

// 诊断责任：无适用错误分支；只形成场景退出空载荷失败。
L2场景退出结果 形成场景退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；把当前快照投影为显式闭包并逐字段核对请求。
bool 场景退出闭包一致(
    const 当前场景快照结果& 快照, const L2场景退出请求& 请求) {
    if (!快照.成功() || !快照.身份来源) return false;
    const std::optional<稳定编码> 父关系 = 快照.直接父关系
        ? std::optional<稳定编码>{快照.直接父关系->关系稳定编码} : std::nullopt;
    std::vector<稳定编码> 子关系;
    std::vector<稳定编码> 成员关系;
    std::vector<稳定编码> 属性值;
    for (const auto& 关系 : 快照.场景->直接子场景)
        子关系.push_back(关系.关系稳定编码);
    for (const auto& 关系 : 快照.场景->直接成员)
        成员关系.push_back(关系.关系稳定编码);
    for (const auto& 属性 : 快照.场景->固定属性)
        属性值.push_back(属性.值稳定编码);
    std::sort(子关系.begin(), 子关系.end());
    std::sort(成员关系.begin(), 成员关系.end());
    std::sort(属性值.begin(), 属性值.end());
    const std::optional<稳定编码> 宿主关系 = 快照.场景->当前宿主关系
        ? std::optional<稳定编码>{快照.场景->当前宿主关系->关系稳定编码}
        : std::nullopt;
    return 快照.身份来源->族归属关系稳定编码 == 请求.族归属关系稳定编码
        && 父关系 == 请求.当前直接父关系
        && 子关系 == 请求.当前直接子关系
        && 成员关系 == 请求.当前直接成员关系
        && 属性值 == 请求.当前固定属性值
        && 宿主关系 == 请求.当前宿主关系;
}

// 诊断责任：向上送出；场景退出提交与全部显式历史读回矛盾均结构化返回。
L2场景退出结果 提交并读回场景退出写集(
    const L1事实基座服务& L1, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    const L2场景退出请求& 请求, const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记,
    const L2场景树结构登记& 树登记,
    const L2场景宿主结构登记& 宿主登记) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射场景S2写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成场景退出失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || !写入.新编码映射.empty())
        return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);

    const auto 节点读取 = L1.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.场景.值});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
    if (节点读取.状态 != L1所有者范围读取状态::成功
        || 节点读取.合同版本 != L1所有者范围CRUD合同版本
        || 节点读取.查询编码 != 请求.场景.值 || !节点
        || 节点->编码 != 请求.场景.值
        || 节点->退出事实代次 != 写入.事实代次)
        return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
    auto 场景 = 形成截止场景节点骨架(
        *节点, 写入端口.所有者身份(), 写入.事实代次);
    if (!场景 || 场景->身份 != 请求.场景
        || 场景->生命周期.退出事实代次 != 写入.事实代次)
        return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);

    for (const auto 编码 : 请求.当前固定属性值) {
        const auto 读取 = L1.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 值 = 读取.事实
            ? std::get_if<L1所有者范围值事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本 || 读取.查询编码 != 编码
            || !值 || 值->编码 != 编码 || 值->所属节点 != 请求.场景.值
            || 值->退出事实代次 != 写入.事实代次)
            return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
        auto 属性 = 形成截止属性事实(
            *值, 写入端口.所有者身份(), 写入.事实代次);
        if (!属性 || 属性->退出事实代次 != 写入.事实代次)
            return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
        场景->固定属性.push_back(std::move(*属性));
    }
    if (节点->当前属性.size() != 场景->固定属性.size())
        return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
    for (const auto& 槽 : 节点->当前属性) {
        const auto 找到 = std::find_if(场景->固定属性.begin(), 场景->固定属性.end(),
            [&](const auto& 属性) noexcept {
                return 属性.属性类型身份 == 槽.属性类型节点
                    && 属性.值稳定编码 == 槽.当前值;
            });
        if (找到 == 场景->固定属性.end())
            return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
    }

    const auto 读取关系 = [&](稳定编码 编码)
        -> std::optional<L1所有者范围关系事实> {
        const auto 读取 = L1.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 编码 || !关系 || 关系->编码 != 编码
            || 关系->退出事实代次 != 写入.事实代次) return std::nullopt;
        return *关系;
    };
    for (const auto 编码 : 请求.当前直接子关系) {
        const auto 原关系 = 读取关系(编码);
        auto 关系 = 原关系 ? 形成截止父子关系事实(
            *原关系, 写入端口.所有者身份(),
            登记.父子关系类型.值, 写入.事实代次) : std::nullopt;
        if (!关系 || 关系->父场景 != 请求.场景
            || 关系->生命周期.退出事实代次 != 写入.事实代次)
            return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
        场景->直接子场景.push_back(std::move(*关系));
    }
    for (const auto 编码 : 请求.当前直接成员关系) {
        const auto 原关系 = 读取关系(编码);
        auto 关系 = 原关系 ? 形成截止成员关系事实(
            *原关系, 写入端口.所有者身份(),
            登记.成员关系类型.值, 写入.事实代次) : std::nullopt;
        if (!关系 || 关系->场景 != 请求.场景
            || 关系->生命周期.退出事实代次 != 写入.事实代次)
            return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
        场景->直接成员.push_back(std::move(*关系));
    }
    std::optional<L2场景宿主存在关系事实> 宿主关系;
    if (请求.当前宿主关系) {
        const auto 原关系 = 读取关系(*请求.当前宿主关系);
        宿主关系 = 原关系 ? 形成截止场景宿主关系事实(
            *原关系, 写入端口.所有者身份(), 宿主登记.关系类型.值,
            写入.事实代次) : std::nullopt;
        if (!宿主关系 || 宿主关系->场景 != 请求.场景
            || 宿主关系->生命周期.退出事实代次 != 写入.事实代次)
            return 形成场景退出失败(
                L2结构状态::内部不一致, 写入.事实代次);
        场景->当前宿主关系 = 宿主关系;
    }
    std::optional<L2场景父子关系事实> 父关系;
    if (请求.当前直接父关系) {
        const auto 原关系 = 读取关系(*请求.当前直接父关系);
        父关系 = 原关系 ? 形成截止父子关系事实(
            *原关系, 写入端口.所有者身份(),
            登记.父子关系类型.值, 写入.事实代次) : std::nullopt;
        if (!父关系 || 父关系->子场景 != 请求.场景
            || 父关系->生命周期.退出事实代次 != 写入.事实代次)
            return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
    }
    std::optional<L2场景树归属事实> 树归属;
    if (请求.当前树归属关系) {
        const auto 原关系 = 读取关系(*请求.当前树归属关系);
        树归属 = 原关系 ? 形成场景树归属事实(*原关系,
            写入端口.所有者身份(), 树登记, 请求.场景,
            L2场景树归属类别::非根, 写入.事实代次) : std::nullopt;
        if (!树归属) {
            // 当前归属 helper 拒绝已退出事实；退出读回保留其原始生命周期。
            if (!原关系 || 原关系->关系类型节点
                    != 树登记.树归属关系类型.值
                || 原关系->写入所有者 != 写入端口.所有者身份()
                || 原关系->源节点 != 请求.场景.值
                || 原关系->目标节点 == 请求.场景.值
                || 原关系->角色或顺序 != 1
                || 原关系->退出事实代次 != 写入.事实代次)
                return 形成场景退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2场景树归属事实 历史{L2场景树身份{原关系->目标节点}, 请求.场景,
                L2场景身份{原关系->目标节点}, L2场景树归属类别::非根,
                原关系->编码, 原关系->目标节点,
                {原关系->创建事实代次, 原关系->退出事实代次}};
            if (!L2场景树归属退出事实完整(历史, 写入.事实代次))
                return 形成场景退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            树归属 = std::move(历史);
        }
    }
    std::sort(场景->固定属性.begin(), 场景->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    std::sort(场景->直接子场景.begin(), 场景->直接子场景.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.子场景.值 < 右.子场景.值);
        });
    std::sort(场景->直接成员.begin(), 场景->直接成员.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.存在.值 < 右.存在.值);
        });
    const auto 当前代次 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (当前代次.状态 != L1中性读取状态::成功
        || 当前代次.事实代次 < 写入.事实代次)
        return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 来源读取 = 读取历史场景身份来源(L1, 来源定位,
        {{L2结构合同版本, 当前代次.事实代次}, L2读取类别::历史,
            请求.场景, 写入.事实代次});
    if (!来源读取.成功() || !来源读取.身份来源
        || 来源读取.身份来源->族归属关系稳定编码
            != 请求.族归属关系稳定编码
        || 来源读取.身份来源->节点生命周期.退出事实代次
            != 写入.事实代次
        || 来源读取.身份来源->归属关系生命周期.退出事实代次
            != 写入.事实代次)
        return 形成场景退出失败(L2结构状态::内部不一致, 写入.事实代次);
    L2场景退出结果 结果{{L2结构合同版本, 状态, 写入.事实代次,
        写入.事实代次}, std::move(场景), std::move(来源读取.身份来源),
        std::move(树归属), std::move(父关系), std::move(宿主关系)};
    return 结果.成功() ? 结果 : 形成场景退出失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

struct 历史普通节点读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::optional<L1所有者范围节点事实> 节点;
    bool 成功() const noexcept {
        return 状态 == L2结构状态::已读取 && 节点.has_value();
    }
};

// 诊断责任：向上送出；历史节点读取保留 L1 失败状态并只接受一条具名普通节点。
历史普通节点读取结果 读取历史普通节点(
    const L1事实基座服务& L1, 稳定编码 编码) {
    const auto 读取 = L1.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    if (读取.合同版本 != L1所有者范围CRUD合同版本 || 读取.查询编码 != 编码)
        return {};
    if (读取.状态 != L1所有者范围读取状态::成功)
        return {映射场景历史读取状态(读取.状态), std::nullopt};
    if (!读取.事实) return {};
    const auto* 节点 = std::get_if<L1所有者范围节点事实>(&*读取.事实);
    return 节点 && 节点->编码 == 编码
        ? 历史普通节点读取结果{L2结构状态::已读取, *节点}
        : 历史普通节点读取结果{};
}

// 诊断责任：向上送出；历史节点、两关系组和前后代次矛盾均返回零部分场景。
L2场景完整读取结果 读取历史完整场景(
    const L1事实基座服务& L1, const L2存在结构服务& 存在服务,
    const L2场景完整读取请求& 请求,
    const 场景身份来源定位& 来源定位,
    const L2场景关系类型登记& 登记,
    const L2场景属性类型登记& 属性登记) {
    const auto 前代次 = 检查S2当前代次(L1, 请求.请求头.期望事实代次);
    if (!前代次.成功()) return 形成完整读取失败(请求,
        前代次.直接提交 ? L2结构状态::事实代次漂移 : 前代次.状态,
        前代次.事实截止代次);

    const auto 场景节点结果 = 读取历史普通节点(L1, 请求.场景.值);
    if (!场景节点结果.成功())
        return 形成完整读取失败(请求, 场景节点结果.状态,
            请求.历史截止事实代次);
    const auto& 场景节点 = *场景节点结果.节点;
    const auto 场景来源 = 读取历史场景身份来源(L1, 来源定位,
        {请求.请求头, L2读取类别::历史, 请求.场景,
            请求.历史截止事实代次});
    if (!场景来源.成功() || !场景来源.身份来源)
        return 形成完整读取失败(请求, 场景来源.结果头.状态,
            场景来源.结果头.事实截止代次);
    if (场景节点.创建事实代次 > 请求.历史截止事实代次)
        return 形成完整读取失败(请求, L2结构状态::未找到,
            请求.历史截止事实代次);
    if (场景节点.退出事实代次
        && *场景节点.退出事实代次 <= 请求.历史截止事实代次)
        return 形成完整读取失败(请求, L2结构状态::已退出,
            请求.历史截止事实代次);
    auto 场景 = 形成截止场景节点事实(场景节点,
        场景节点.写入所有者, 请求.历史截止事实代次);
    if (!场景 || 场景->身份 != 请求.场景)
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            请求.历史截止事实代次);

    const L1所有者范围历史关系组读取请求 父子请求{
        L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
        请求.场景.值,
        登记.父子关系类型.值, 请求.历史截止事实代次};
    const L1所有者范围历史关系组读取请求 成员请求{
        L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
        请求.场景.值,
        登记.成员关系类型.值, 请求.历史截止事实代次};
    const L1所有者范围历史属性值组读取请求 属性请求{
        L1所有者范围CRUD合同版本,
        请求.场景.值, 请求.历史截止事实代次};
    const auto 父子组 = L1.读取所有者范围历史关系组(父子请求);
    const auto 成员组 = L1.读取所有者范围历史关系组(成员请求);
    const auto 属性组 = L1.读取所有者范围历史属性值组(属性请求);
    const auto 检查组顶层 = [&](const auto& 组, const auto& 组请求) {
        if (组.合同版本 != L1所有者范围CRUD合同版本 || 组.方向 != 组请求.方向
            || 组.端点节点 != 组请求.端点节点
            || 组.关系类型节点 != 组请求.关系类型节点
            || 组.历史截止事实代次 != 组请求.历史截止事实代次)
            return L2结构状态::内部不一致;
        return 组.状态 == L1所有者范围读取状态::成功
            ? (组.读取事实代次 == 请求.请求头.期望事实代次
                ? L2结构状态::已读取 : L2结构状态::事实代次漂移)
            : 映射历史关系组失败状态(组.状态);
    };
    const auto 父子状态 = 检查组顶层(父子组, 父子请求);
    if (父子状态 != L2结构状态::已读取)
        return 形成完整读取失败(请求, 父子状态, 父子组.读取事实代次);
    const auto 成员状态 = 检查组顶层(成员组, 成员请求);
    if (成员状态 != L2结构状态::已读取)
        return 形成完整读取失败(请求, 成员状态, 成员组.读取事实代次);
    if (属性组.合同版本 != L1所有者范围CRUD合同版本
        || 属性组.所属节点 != 属性请求.所属节点
        || 属性组.历史截止事实代次 != 属性请求.历史截止事实代次)
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            属性组.读取事实代次);
    if (属性组.状态 != L1所有者范围读取状态::成功) {
        if (!属性组.属性值组.empty())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                属性组.读取事实代次);
        return 形成完整读取失败(请求,
            映射历史属性值组失败状态(属性组.状态), 属性组.读取事实代次);
    }
    if (属性组.读取事实代次 != 请求.请求头.期望事实代次)
        return 形成完整读取失败(请求, L2结构状态::事实代次漂移,
            属性组.读取事实代次);

    std::vector<稳定编码> 属性类型组;
    for (const auto& 原属性 : 属性组.属性值组) {
        if (原属性.所属节点 != 请求.场景.值
            || !场景属性类型已登记(属性登记, 原属性.属性类型节点)
            || 原属性.创建事实代次 == 0
            || 原属性.创建事实代次 > 请求.历史截止事实代次
            || (原属性.退出事实代次
                && *原属性.退出事实代次 <= 请求.历史截止事实代次)
            || std::find(属性类型组.begin(), 属性类型组.end(),
                原属性.属性类型节点) != 属性类型组.end())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        auto 属性 = 形成截止属性事实(原属性,
            来源定位.所有者, 请求.历史截止事实代次);
        if (!属性 || 属性->退出事实代次)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        属性类型组.push_back(原属性.属性类型节点);
        场景->固定属性.push_back(std::move(*属性));
    }

    std::vector<稳定编码> 子场景组;
    for (const auto& 原关系 : 父子组.关系组) {
        if (!关系在截止有效(原关系, 请求.历史截止事实代次)
            || 原关系.源节点 != 请求.场景.值
            || std::find(子场景组.begin(), 子场景组.end(), 原关系.目标节点)
                != 子场景组.end())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 子节点结果 = 读取历史普通节点(L1, 原关系.目标节点);
        if (!子节点结果.成功())
            return 形成完整读取失败(请求,
                子节点结果.状态 == L2结构状态::资源失败
                    ? L2结构状态::资源失败 : L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto& 子节点 = *子节点结果.节点;
        if (子节点.创建事实代次 > 请求.历史截止事实代次
            || (子节点.退出事实代次
                && *子节点.退出事实代次 <= 请求.历史截止事实代次)
            || !形成截止场景节点事实(子节点,
                子节点.写入所有者, 请求.历史截止事实代次))
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 子来源 = 读取历史场景身份来源(L1, 来源定位,
            {请求.请求头, L2读取类别::历史,
                L2场景身份{原关系.目标节点}, 请求.历史截止事实代次});
        if (!子来源.成功() || !子来源.身份来源)
            return 形成完整读取失败(请求, 子来源.结果头.状态,
                子来源.结果头.事实截止代次);
        auto 关系 = 形成截止父子关系事实(原关系,
            来源定位.所有者, 登记.父子关系类型.值,
            请求.历史截止事实代次);
        if (!关系 || 关系->父场景 != 请求.场景
            || 关系->子场景.值 != 原关系.目标节点
            || 关系->生命周期.退出事实代次)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        子场景组.push_back(原关系.目标节点);
        场景->直接子场景.push_back(std::move(*关系));
    }

    std::vector<稳定编码> 存在组;
    for (const auto& 原关系 : 成员组.关系组) {
        if (!关系在截止有效(原关系, 请求.历史截止事实代次)
            || 原关系.源节点 != 请求.场景.值
            || std::find(存在组.begin(), 存在组.end(), 原关系.目标节点)
                != 存在组.end())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 存在节点结果 = 读取历史普通节点(L1, 原关系.目标节点);
        if (!存在节点结果.成功())
            return 形成完整读取失败(请求,
                存在节点结果.状态 == L2结构状态::资源失败
                    ? L2结构状态::资源失败 : L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto& 存在节点 = *存在节点结果.节点;
        if (存在节点.创建事实代次 > 请求.历史截止事实代次
            || (存在节点.退出事实代次
                && *存在节点.退出事实代次 <= 请求.历史截止事实代次)
            || !形成截止存在节点事实(存在节点, 请求.历史截止事实代次))
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 存在来源 = 存在服务.读取存在身份来源(
            {请求.请求头, L2读取类别::历史,
                L2存在身份{原关系.目标节点}, 请求.历史截止事实代次});
        if (!存在来源.成功() || !存在来源.身份来源)
            return 形成完整读取失败(请求, 存在来源.结果头.状态,
                存在来源.结果头.事实截止代次);
        auto 关系 = 形成截止成员关系事实(原关系,
            来源定位.所有者, 登记.成员关系类型.值,
            请求.历史截止事实代次);
        if (!关系 || 关系->场景 != 请求.场景
            || 关系->存在.值 != 原关系.目标节点
            || 关系->生命周期.退出事实代次)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        存在组.push_back(原关系.目标节点);
        场景->直接成员.push_back(std::move(*关系));
    }
    const auto 后代次 = 检查S2当前代次(L1, 请求.请求头.期望事实代次);
    if (!后代次.成功()) return 形成完整读取失败(请求,
        后代次.直接提交 ? L2结构状态::事实代次漂移 : 后代次.状态,
        后代次.事实截止代次);

    std::sort(场景->固定属性.begin(), 场景->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    std::sort(场景->直接子场景.begin(), 场景->直接子场景.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.子场景.值 < 右.子场景.值);
        });
    std::sort(场景->直接成员.begin(), 场景->直接成员.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.存在.值 < 右.存在.值);
        });
    if (!L2场景事实完整(*场景, 请求.历史截止事实代次))
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            请求.历史截止事实代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::move(场景)};
}

} // namespace 海中鱼巣::L2场景结构内部

export namespace 海中鱼巣 {

std::optional<L2场景所有者交付> 尝试形成L2场景所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 场景所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份()
                != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务))
            return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2场景所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class L2场景结构服务 final {
public:
    explicit L2场景结构服务(const L1事实基座服务& 第一层服务,
        const L2存在结构服务& 存在服务,
        L2场景所有者交付&& 场景所有者交付)
        : L1_(第一层服务), 存在服务_(存在服务),
          第一层写入端口_(验证并移动交付(第一层服务, 场景所有者交付)),
          场景身份来源定位_(L2场景结构内部::初始化场景身份来源(
              L1_, 第一层写入端口_)) {
        const auto 代次1 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (代次1.状态 != L1中性读取状态::成功 || 代次1.事实代次 == 0)
            throw std::runtime_error("L2 scene relation registry generation unavailable");
        const auto 关系 = 建立场景关系类型登记(
            {{L2结构合同版本, 代次1.事实代次},
                L2场景关系类型登记规则版本, {1}});
        if (!关系.成功())
            throw std::runtime_error("L2 scene relation registry initialization failed");
        const auto 代次2 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (代次2.状态 != L1中性读取状态::成功 || 代次2.事实代次 == 0)
            throw std::runtime_error("L2 scene attribute registry generation unavailable");
        const auto 属性 = 建立场景属性类型登记(
            {{L2结构合同版本, 代次2.事实代次},
                L2场景属性类型登记规则版本, {1}});
        if (!属性.成功())
            throw std::runtime_error("L2 scene attribute registry initialization failed");
        const auto 代次3 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (代次3.状态 != L1中性读取状态::成功 || 代次3.事实代次 == 0)
            throw std::runtime_error("L2 scene tree registry generation unavailable");
        const auto 树登记 = 建立场景树结构登记(
            {{L2结构合同版本, 代次3.事实代次},
                L2场景树结构登记规则版本,
                L2场景树结构登记固定幂等身份});
        if (!树登记.成功())
            throw std::runtime_error("L2 scene tree registry initialization failed");
        const auto 代次4 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (代次4.状态 != L1中性读取状态::成功 || 代次4.事实代次 == 0)
            throw std::runtime_error("L2 scene host registry generation unavailable");
        const auto 宿主登记 = 建立场景宿主结构登记(
            {{L2结构合同版本, 代次4.事实代次},
                L2场景宿主结构登记规则版本,
                L2场景宿主结构登记固定幂等身份});
        if (!宿主登记.成功())
            throw std::runtime_error("L2 scene host registry initialization failed");
    }
    L2场景结构服务(const L2场景结构服务&) = delete;
    L2场景结构服务& operator=(const L2场景结构服务&) = delete;

    L2场景宿主结构登记结果 建立场景宿主结构登记(
        const L2场景宿主结构登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(宿主结构登记锁_);
            if (!L2场景宿主结构登记请求有效(请求))
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::入口拒绝);
            if (宿主结构登记定位_) {
                const auto 当前 = 按定位读取当前场景宿主结构登记(
                    *宿主结构登记定位_, std::nullopt);
                if (!当前.成功() || !当前.登记)
                    return L2场景结构内部::形成场景宿主登记失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                if (当前.登记->首次幂等身份 != 请求.幂等身份
                    || 当前.登记->规则版本 != 请求.规则版本
                    || 当前.登记->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2场景结构内部::形成场景宿主登记失败(
                        L2结构状态::幂等冲突,
                        当前.结果头.事实截止代次);
                auto 重复 = 当前;
                重复.结果头.状态 = L2结构状态::精确重复;
                重复.结果头.变更事实代次 = 当前.登记->建立事实代次;
                return 重复.成功() ? 重复
                    : L2场景结构内部::形成场景宿主登记失败(
                        L2结构状态::内部不一致,
                        当前.结果头.事实截止代次);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.节点 = {{{L2场景结构内部::场景宿主关系类型本地键值},
                节点种类::普通, std::nullopt}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2场景结构内部::映射场景S2写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return L2场景结构内部::形成场景宿主登记失败(
                    状态, 写入.事实代次);
            const auto 编码 = L2场景结构内部::查找唯一S2关系编码映射(
                写入, L2场景结构内部::场景宿主关系类型本地键值);
            if (!编码 || 写入.事实代次 == 0)
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2场景宿主结构登记 新定位{L2结构合同版本, 请求.规则版本,
                请求.幂等身份, 请求.请求头.期望事实代次, 写入.事实代次,
                写入.事实代次, {*编码}, {写入.事实代次, std::nullopt}};
            if (!L2场景宿主结构登记完整(新定位))
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            auto 读回 = 按定位读取当前场景宿主结构登记(
                新定位, 写入.事实代次);
            if (!读回.成功() || !读回.登记)
                return L2场景结构内部::形成场景宿主登记失败(
                    读回.结果头.状态, 读回.结果头.事实截止代次);
            宿主结构登记定位_ = *读回.登记;
            读回.结果头.状态 = 状态;
            读回.结果头.变更事实代次 = 写入.事实代次;
            return 读回.成功() ? 读回
                : L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景宿主登记失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景宿主登记失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景宿主结构登记结果 读取当前场景宿主结构登记() const {
        try {
            std::optional<L2场景宿主结构登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(宿主结构登记锁_);
                定位 = 宿主结构登记定位_;
            }
            return 定位 ? 按定位读取当前场景宿主结构登记(*定位, std::nullopt)
                : L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景宿主登记失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景宿主登记失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；登记拒绝、漂移、冲突和读回矛盾均结构化返回。
    L2场景关系类型登记结果 建立场景关系类型登记(
        const L2场景关系类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(关系类型登记锁_);
            if (!L2场景关系类型登记请求有效(请求)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::入口拒绝);
            }
            if (关系类型登记定位_) {
                if (!L2场景关系类型登记完整(*关系类型登记定位_)) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致);
                }
                if (关系类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 关系类型登记定位_->规则版本 != 请求.规则版本
                    || 关系类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 关系类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::幂等冲突);
                }
            }

            const auto 幂等键 =
                L2场景结构内部::映射场景关系类型登记幂等键(请求.幂等身份);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 幂等键;
            写集.节点 = {
                {{L2场景结构内部::场景父子关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2场景结构内部::场景成员关系类型本地键值},
                    节点种类::普通, std::nullopt}};
            写集.关系 = {};
            写集.值 = {};
            写集.属性槽变更 = {};
            写集.退出事实 = {};

            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.写入幂等身份 != 幂等键) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            const auto 状态 =
                L2场景结构内部::映射场景关系类型登记写入状态(写入.状态);
            if (状态 != L2场景关系类型登记状态::已提交
                && 状态 != L2场景关系类型登记状态::精确重复) {
                const auto 截止 = 状态 == L2场景关系类型登记状态::事实代次漂移
                    || 状态 == L2场景关系类型登记状态::幂等冲突
                    ? 写入.事实代次 : 0;
                return L2场景结构内部::形成场景关系类型登记失败(状态, 截止);
            }

            const bool 首次成功完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.事实代次 == 0 || (!首次成功完整 && !重复成功完整)
                || !L2场景结构内部::场景关系类型编码映射唯一(写入)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            const auto 父子编码 = L2场景结构内部::查找场景关系类型编码映射(
                写入, L2场景结构内部::场景父子关系类型本地键值);
            const auto 成员编码 = L2场景结构内部::查找场景关系类型编码映射(
                写入, L2场景结构内部::场景成员关系类型本地键值);
            if (!父子编码 || !成员编码 || *父子编码 == *成员编码) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            L2场景关系类型登记 新定位;
            新定位.合同版本 = 请求.请求头.合同版本;
            新定位.规则版本 = 请求.规则版本;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            新定位.建立事实代次 = 写入.事实代次;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.父子关系类型 = {*父子编码};
            新定位.成员关系类型 = {*成员编码};
            if (!L2场景关系类型登记完整(新定位)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            auto 读回 = 按定位读取当前场景关系类型登记(
                新定位, 写入.事实代次);
            if (读回.状态 != L2场景关系类型登记状态::已读取
                || !读回.登记 || !读回.成功()) {
                return 读回.状态 == L2场景关系类型登记状态::已读取
                    ? L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致)
                    : 读回;
            }
            if (关系类型登记定位_
                && (关系类型登记定位_->合同版本 != 新定位.合同版本
                    || 关系类型登记定位_->规则版本 != 新定位.规则版本
                    || 关系类型登记定位_->首次幂等身份 != 新定位.首次幂等身份
                    || 关系类型登记定位_->首次期望事实代次
                        != 新定位.首次期望事实代次
                    || 关系类型登记定位_->建立事实代次 != 新定位.建立事实代次
                    || 关系类型登记定位_->父子关系类型 != 新定位.父子关系类型
                    || 关系类型登记定位_->成员关系类型 != 新定位.成员关系类型)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            关系类型登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；定位只在锁内深复制，权威节点在锁外正式读取。
    L2场景关系类型登记结果 读取当前场景关系类型登记() const {
        try {
            std::optional<L2场景关系类型登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(关系类型登记锁_);
                定位 = 关系类型登记定位_;
            }
            if (!定位) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::登记未加载);
            }
            return 按定位读取当前场景关系类型登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::内部不一致);
        }
    }

    L2场景属性类型登记结果 建立场景属性类型登记(
        const L2场景属性类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(属性类型登记锁_);
            if (!L2场景属性类型登记请求有效(请求))
                return {L2场景属性类型登记状态::入口拒绝, 0, std::nullopt};
            if (属性类型登记定位_) {
                if (!L2场景属性类型登记完整(*属性类型登记定位_)
                    || 属性类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return {L2场景属性类型登记状态::幂等冲突, 0, std::nullopt};
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2场景结构内部::场景属性类型登记幂等身份;
            写集.节点 = {
                {{L2场景结构内部::场景I64属性类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2场景结构内部::场景I64组属性类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2场景结构内部::场景U64组属性类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2场景结构内部::场景独立材料属性类型本地键值},
                    节点种类::属性类型,
                    L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            L2场景属性类型登记状态 状态 =
                L2场景属性类型登记状态::内部不一致;
            switch (写入.状态) {
            case L1所有者范围写入状态::成功:
                状态 = L2场景属性类型登记状态::已提交; break;
            case L1所有者范围写入状态::精确重复:
                状态 = L2场景属性类型登记状态::精确重复; break;
            case L1所有者范围写入状态::入口拒绝:
                状态 = L2场景属性类型登记状态::入口拒绝; break;
            case L1所有者范围写入状态::许可拒绝:
                状态 = L2场景属性类型登记状态::许可拒绝; break;
            case L1所有者范围写入状态::事实代次漂移:
                状态 = L2场景属性类型登记状态::事实代次漂移; break;
            case L1所有者范围写入状态::幂等冲突:
                状态 = L2场景属性类型登记状态::幂等冲突; break;
            case L1所有者范围写入状态::资源失败:
                状态 = L2场景属性类型登记状态::资源失败; break;
            default: break;
            }
            if (状态 != L2场景属性类型登记状态::已提交
                && 状态 != L2场景属性类型登记状态::精确重复)
                return {状态, 写入.事实代次, std::nullopt};
            const auto 查找 = [&](std::uint32_t 键值) -> std::optional<稳定编码> {
                std::optional<稳定编码> 找到;
                for (const auto& [键, 编码] : 写入.新编码映射) {
                    if (键.值 != 键值) continue;
                    if (找到 || !有效(编码)) return std::nullopt;
                    找到 = 编码;
                }
                return 找到;
            };
            const auto I64 = 查找(L2场景结构内部::场景I64属性类型本地键值);
            const auto I64组 = 查找(L2场景结构内部::场景I64组属性类型本地键值);
            const auto U64组 = 查找(L2场景结构内部::场景U64组属性类型本地键值);
            const auto 独立 = 查找(
                L2场景结构内部::场景独立材料属性类型本地键值);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0 || 写入.新编码映射.size() != 4
                || !I64 || !I64组 || !U64组 || !独立)
                return {L2场景属性类型登记状态::内部不一致,
                    写入.事实代次, std::nullopt};
            L2场景属性类型登记 定位;
            定位.合同版本 = 请求.请求头.合同版本;
            定位.规则版本 = 请求.规则版本;
            定位.首次幂等身份 = 请求.幂等身份;
            定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            定位.建立事实代次 = 写入.事实代次;
            定位.事实截止代次 = 写入.事实代次;
            定位.I64属性类型 = {*I64};
            定位.I64组属性类型 = {*I64组};
            定位.U64组属性类型 = {*U64组};
            定位.独立材料属性类型 = {*独立};
            if (!L2场景属性类型登记完整(定位))
                return {L2场景属性类型登记状态::内部不一致,
                    写入.事实代次, std::nullopt};
            属性类型登记定位_ = 定位;
            return {状态, 写入.事实代次, std::move(定位)};
        } catch (const std::bad_alloc&) {
            return {L2场景属性类型登记状态::资源失败, 0, std::nullopt};
        } catch (...) {
            return {L2场景属性类型登记状态::内部不一致, 0, std::nullopt};
        }
    }

    L2场景属性类型登记结果 读取当前场景属性类型登记() const {
        try {
            std::optional<L2场景属性类型登记> 定位副本;
            {
                std::lock_guard<std::mutex> 锁(属性类型登记锁_);
                定位副本 = 属性类型登记定位_;
            }
            if (!定位副本)
                return {L2场景属性类型登记状态::登记未加载, 0, std::nullopt};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
                return {代次.状态 == L1中性读取状态::资源失败
                        ? L2场景属性类型登记状态::资源失败
                        : 代次.状态 == L1中性读取状态::入口拒绝
                            ? L2场景属性类型登记状态::入口拒绝
                            : L2场景属性类型登记状态::内部不一致,
                    代次.事实代次, std::nullopt};
            auto 定位 = *定位副本;
            L1所有者范围一致当前读取请求 请求;
            请求.合同版本 = L1所有者范围一致当前读取合同版本;
            请求.期望事实代次 = 代次.事实代次;
            请求.所有者 = {第一层写入端口_.所有者身份()};
            请求.节点 = {定位.I64属性类型.值, 定位.I64组属性类型.值,
                定位.U64组属性类型.值, 定位.独立材料属性类型.值};
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
            if (读取.状态 != L1所有者范围一致当前读取状态::成功
                || 读取.读取事实代次 != 代次.事实代次
                || 读取.所有者.size() != 1 || 读取.节点.size() != 4)
                return {读取.状态 == L1所有者范围一致当前读取状态::许可拒绝
                        ? L2场景属性类型登记状态::许可拒绝
                        : 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
                            ? L2场景属性类型登记状态::事实代次漂移
                            : 读取.状态 == L1所有者范围一致当前读取状态::资源失败
                                ? L2场景属性类型登记状态::资源失败
                                : L2场景属性类型登记状态::内部不一致,
                    读取.读取事实代次, std::nullopt};
            const auto 核对类型 = [&](稳定编码 编码,
                L1所有者范围值表示种类 表示) noexcept {
                for (const auto& 项 : 读取.节点) {
                    if (项.查询编码 != 编码) continue;
                    return 项.状态 == L1所有者范围一致当前读取项目状态::成功
                        && 项.事实 && 项.事实->编码 == 编码
                        && 项.事实->写入所有者 == 第一层写入端口_.所有者身份()
                        && 项.事实->种类 == 节点种类::属性类型
                        && 项.事实->属性类型表示 == 表示
                        && !项.事实->退出事实代次;
                }
                return false;
            };
            if (!核对类型(定位.I64属性类型.值, L1所有者范围值表示种类::I64)
                || !核对类型(定位.I64组属性类型.值, L1所有者范围值表示种类::I64组)
                || !核对类型(定位.U64组属性类型.值, L1所有者范围值表示种类::U64组)
                || !核对类型(定位.独立材料属性类型.值,
                    L1所有者范围值表示种类::独立材料引用))
                return {L2场景属性类型登记状态::内部不一致,
                    代次.事实代次, std::nullopt};
            定位.事实截止代次 = 代次.事实代次;
            return L2场景属性类型登记完整(定位)
                ? L2场景属性类型登记结果{
                    L2场景属性类型登记状态::已读取,
                    代次.事实代次, std::move(定位)}
                : L2场景属性类型登记结果{
                    L2场景属性类型登记状态::内部不一致,
                    代次.事实代次, std::nullopt};
        } catch (...) {
            return {L2场景属性类型登记状态::内部不一致, 0, std::nullopt};
        }
    }

    L2场景树结构登记结果 建立场景树结构登记(
        const L2场景树结构登记请求& 请求) {
        try {
            if (!L2场景树结构登记请求有效(请求))
                return L2场景结构内部::形成场景树登记失败(
                    L2结构状态::入口拒绝);
            std::optional<L2场景树结构登记> 已有定位;
            {
                std::lock_guard<std::mutex> 锁(场景树结构登记锁_);
                已有定位 = 场景树结构定位_;
            }
            if (已有定位) {
                if (已有定位->首次期望事实代次 != 请求.请求头.期望事实代次
                    || 已有定位->首次幂等身份 != 请求.幂等身份
                    || 已有定位->规则版本 != 请求.规则版本)
                    return L2场景结构内部::形成场景树登记失败(
                        L2结构状态::幂等冲突);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.节点 = {
                {{L2场景结构内部::场景树登记锚点本地键值},
                    节点种类::普通, std::nullopt},
                {{L2场景结构内部::场景树根标记类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2场景结构内部::场景树归属类型本地键值},
                    节点种类::普通, std::nullopt}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2场景结构内部::映射场景写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return L2场景结构内部::形成场景树登记失败(
                    状态, 写入.事实代次);
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2场景结构内部::映射集合唯一(写入,
                    {L2场景结构内部::场景树登记锚点本地键值,
                     L2场景结构内部::场景树根标记类型本地键值,
                     L2场景结构内部::场景树归属类型本地键值}))
                return L2场景结构内部::形成场景树登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2场景树结构登记 定位;
            定位.合同版本 = 请求.请求头.合同版本;
            定位.规则版本 = 请求.规则版本;
            定位.首次幂等身份 = 请求.幂等身份;
            定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            定位.树登记锚点稳定编码 = *L2场景结构内部::查找唯一映射(
                写入, L2场景结构内部::场景树登记锚点本地键值);
            定位.根标记关系类型 = {*L2场景结构内部::查找唯一映射(
                写入, L2场景结构内部::场景树根标记类型本地键值)};
            定位.树归属关系类型 = {*L2场景结构内部::查找唯一映射(
                写入, L2场景结构内部::场景树归属类型本地键值)};
            定位.树登记锚点生命周期 = {写入.事实代次, std::nullopt};
            定位.根标记关系类型生命周期 = {写入.事实代次, std::nullopt};
            定位.树归属关系类型生命周期 = {写入.事实代次, std::nullopt};
            定位.事实截止代次 = 写入.事实代次;
            if (!L2场景树结构登记完整(定位))
                return L2场景结构内部::形成场景树登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            auto 读回 = 按定位读取当前场景树结构登记(定位, 写入.事实代次);
            if (读回.结果头.状态 != L2结构状态::已读取 || !读回.成功())
                return 读回;
            {
                std::lock_guard<std::mutex> 锁(场景树结构登记锁_);
                if (场景树结构定位_ && *场景树结构定位_ != 定位)
                    return L2场景结构内部::形成场景树登记失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                场景树结构定位_ = 定位;
            }
            读回.结果头.状态 = 状态;
            读回.结果头.变更事实代次 = 写入.事实代次;
            return 读回;
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景树结构登记结果 读取当前场景树结构登记() const {
        try {
            std::optional<L2场景树结构登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(场景树结构登记锁_);
                定位 = 场景树结构定位_;
            }
            if (!定位)
                return L2场景结构内部::形成场景树登记失败(
                    L2结构状态::入口拒绝);
            return 按定位读取当前场景树结构登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景树节点写入结果 建立场景树根(
        const L2场景树根建立请求& 请求) {
        if (!L2场景树根建立请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份))
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::入口拒绝);
        std::lock_guard<std::mutex> 写锁(场景业务写入锁_);
        try {
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成场景树节点写入失败(
                    代次.状态, 代次.事实截止代次);
            const auto 登记结果 = 读取当前场景树结构登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成场景树节点写入失败(
                    登记结果.结果头.状态 == L2结构状态::事实代次漂移
                        ? L2结构状态::事实代次漂移
                        : 登记结果.结果头.状态 == L2结构状态::资源失败
                            ? L2结构状态::资源失败 : L2结构状态::入口拒绝,
                    登记结果.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.节点 = {{{L2场景结构内部::树根场景节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2场景结构内部::树根场景族归属本地键值},
                    L1所有者范围写集本地键{
                        L2场景结构内部::树根场景节点本地键值},
                    场景身份来源定位_.族锚点,
                    场景身份来源定位_.族归属关系类型, 1},
                {{L2场景结构内部::树根标记关系本地键值},
                    L1所有者范围写集本地键{
                        L2场景结构内部::树根场景节点本地键值},
                    登记结果.登记->树登记锚点稳定编码,
                    登记结果.登记->根标记关系类型.值, 1}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2场景结构内部::映射场景写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return L2场景结构内部::形成场景树节点写入失败(
                    状态, 写入.事实代次);
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2场景结构内部::映射集合唯一(写入,
                    {L2场景结构内部::树根场景节点本地键值,
                     L2场景结构内部::树根场景族归属本地键值,
                     L2场景结构内部::树根标记关系本地键值}))
                return L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 节点编码 = *L2场景结构内部::查找唯一映射(
                写入, L2场景结构内部::树根场景节点本地键值);
            const L2场景树身份 树{节点编码};
            const auto 读回当前代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (读回当前代次.状态 != L1中性读取状态::成功
                || 读回当前代次.事实代次 < 写入.事实代次)
                return L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 归属 = 读取场景树归属({
                {L2结构合同版本, 读回当前代次.事实代次}, L2读取类别::历史,
                L2场景身份{节点编码}, 写入.事实代次});
            const auto 场景 = 读取完整场景({
                {L2结构合同版本, 读回当前代次.事实代次}, L2读取类别::历史,
                L2场景身份{节点编码}, 写入.事实代次});
            const auto 来源 = L2场景结构内部::读取历史场景身份来源(
                L1_, 场景身份来源定位_, {
                    {L2结构合同版本, 读回当前代次.事实代次}, L2读取类别::历史,
                    L2场景身份{节点编码}, 写入.事实代次});
            const auto 关系登记 = 读取当前场景关系类型登记();
            const auto 父组 = 关系登记.成功() && 关系登记.登记
                ? L1_.读取所有者范围历史关系组({
                    L1所有者范围CRUD合同版本,
                    L1所有者范围关系端点方向::目标, 节点编码,
                    关系登记.登记->父子关系类型.值, 写入.事实代次})
                : L1所有者范围历史关系组读取结果{};
            const bool 读回截止可接受 = 场景.结果头.事实截止代次
                    == 写入.事实代次
                && 来源.结果头.事实截止代次 == 写入.事实代次
                && 归属.结果头.事实截止代次 == 写入.事实代次;
            if (!归属.成功() || !归属.树归属 || !场景.场景
                || 场景.结果头.状态 != L2结构状态::已读取
                || !来源.成功() || !来源.身份来源
                || 父组.状态 != L1所有者范围读取状态::成功
                || 父组.历史截止事实代次 != 写入.事实代次
                || 父组.读取事实代次 < 写入.事实代次
                || !父组.关系组.empty()
                || !读回截止可接受
                || 归属.树归属->类别 != L2场景树归属类别::根
                || 归属.树归属->树 != 树)
                return L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2场景树节点事实 节点事实{
                *场景.场景, *来源.身份来源, *归属.树归属};
            L2场景树节点写入结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, 树,
                std::move(节点事实), std::nullopt};
            return 结果.成功() ? 结果
                : L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景树归属读取结果 读取场景树归属(
        const L2场景树归属读取请求& 请求) const {
        if (!L2场景树归属读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景树结构登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成场景树归属读取失败(
                    请求, 登记结果.结果头.状态,
                    登记结果.结果头.事实截止代次);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            if (请求.读取类别 == L2读取类别::当前
                && 登记结果.结果头.事实截止代次 != 截止)
                return L2场景结构内部::形成场景树归属读取失败(
                    请求, 登记结果.结果头.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    登记结果.结果头.事实截止代次);
            const L2场景身份来源读取请求 来源请求{请求.请求头,
                请求.读取类别, 请求.场景,
                请求.读取类别 == L2读取类别::历史 ? 截止 : 0};
            const auto 来源 = 请求.读取类别 == L2读取类别::当前
                ? L2场景结构内部::读取当前场景身份来源(
                    L1_, 场景身份来源定位_, 来源请求)
                : L2场景结构内部::读取历史场景身份来源(
                    L1_, 场景身份来源定位_, 来源请求);
            if (!来源.成功() || !来源.身份来源)
                return L2场景结构内部::形成场景树归属读取失败(
                    请求, 来源.结果头.状态, 来源.结果头.事实截止代次);
            const bool 来源在截止已退出 = 请求.读取类别 == L2读取类别::历史
                && 来源.身份来源->节点生命周期.退出事实代次
                && *来源.身份来源->节点生命周期.退出事实代次 <= 截止;
            std::vector<L1所有者范围关系事实> 根标记组;
            std::vector<L1所有者范围关系事实> 树归属组;
            std::uint64_t 实际读取代次 = 0;
            if (请求.读取类别 == L2读取类别::当前) {
                L1所有者范围一致当前读取请求 L1请求;
                L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
                L1请求.期望事实代次 = 截止;
                L1请求.节点 = {请求.场景.值};
                L1请求.源关系组 = {
                    {请求.场景.值, 登记结果.登记->根标记关系类型.值},
                    {请求.场景.值, 登记结果.登记->树归属关系类型.值}};
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
                const auto 顶层 = L2场景结构内部::解释S2一致读取顶层(
                    读取, 截止);
                if (!顶层.成功())
                    return L2场景结构内部::形成场景树归属读取失败(
                        请求, 顶层.状态, 顶层.事实截止代次);
                if (读取.节点.size() != 1 || !读取.关系.empty()
                    || !读取.值.empty() || !读取.属性值.empty()
                    || 读取.源关系组.size() != 2
                    || !读取.目标关系组.empty())
                    return L2场景结构内部::形成场景树归属读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                for (const auto& 项 : 读取.源关系组) {
                    auto& 目标 = 项.关系类型节点
                            == 登记结果.登记->根标记关系类型.值
                        ? 根标记组 : 树归属组;
                    for (const auto& 成员 : 项.成员) 目标.push_back(成员.关系);
                }
                实际读取代次 = 顶层.事实截止代次;
            } else {
                const auto 读组 = [&](稳定编码 类型) {
                    return L1_.读取所有者范围历史关系组({
                        L1所有者范围CRUD合同版本,
                        L1所有者范围关系端点方向::源, 请求.场景.值,
                        类型, 截止});
                };
                const auto 根组 = 读组(登记结果.登记->根标记关系类型.值);
                const auto 非根组 = 读组(登记结果.登记->树归属关系类型.值);
                if (根组.状态 != L1所有者范围读取状态::成功
                    || 非根组.状态 != L1所有者范围读取状态::成功
                    || 根组.读取事实代次 != 非根组.读取事实代次)
                    return L2场景结构内部::形成场景树归属读取失败(
                        请求, L2结构状态::内部不一致,
                        根组.读取事实代次);
                根标记组 = 根组.关系组;
                树归属组 = 非根组.关系组;
                实际读取代次 = 截止;
            }
            const bool 根形状 = 根标记组.size() == 1 && 树归属组.empty();
            const bool 非根形状 = 根标记组.empty() && 树归属组.size() == 1;
            if (!根形状 && !非根形状)
                return L2场景结构内部::形成场景树归属读取失败(
                    请求, 根标记组.empty() && 树归属组.empty()
                        ? 来源在截止已退出 ? L2结构状态::已退出
                            : 来源.身份来源->节点生命周期.创建事实代次
                                    < 登记结果.登记->树登记锚点生命周期.创建事实代次
                                ? L2结构状态::入口拒绝
                                : L2结构状态::内部不一致
                        : L2结构状态::内部不一致, 实际读取代次);
            const auto 类别 = 根标记组.size() == 1
                ? L2场景树归属类别::根 : L2场景树归属类别::非根;
            const auto& 原关系 = 类别 == L2场景树归属类别::根
                ? 根标记组.front() : 树归属组.front();
            auto 归属 = L2场景结构内部::形成场景树归属事实(
                原关系, 第一层写入端口_.所有者身份(),
                *登记结果.登记, 请求.场景, 类别, 截止);
            if (!归属)
                return L2场景结构内部::形成场景树归属读取失败(
                    请求, L2结构状态::内部不一致, 实际读取代次);
            if (类别 == L2场景树归属类别::非根) {
                const auto 根请求 = L2场景树归属读取请求{
                    请求.请求头, 请求.读取类别, 归属->根场景,
                    请求.历史截止事实代次};
                const auto 根归属 = 读取场景树归属(根请求);
                if (!根归属.成功() || !根归属.树归属)
                    return L2场景结构内部::形成场景树归属读取失败(
                        请求, 根归属.结果头.状态,
                        根归属.结果头.事实截止代次);
                if (根归属.树归属->类别 != L2场景树归属类别::根
                    || 根归属.树归属->树 != 归属->树)
                    return L2场景结构内部::形成场景树归属读取失败(
                        请求, L2结构状态::内部不一致, 实际读取代次);
            }
            L2场景树归属读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::move(归属)};
            return 结果.成功() ? 结果
                : L2场景结构内部::形成场景树归属读取失败(
                    请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景树归属读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景树归属读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景树归属读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    L2场景树节点写入结果 新增树内场景(
        const L2树内场景新增请求& 请求) {
        if (!L2树内场景新增请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份))
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::入口拒绝);
        std::lock_guard<std::mutex> 写锁(场景业务写入锁_);
        try {
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成场景树节点写入失败(
                    代次.状态, 代次.事实截止代次);
            const auto 登记 = 读取当前场景树结构登记();
            const auto 关系登记 = 读取当前场景关系类型登记();
            if (!登记.成功() || !登记.登记 || !关系登记.成功()
                || !关系登记.登记)
                return L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致,
                    登记.结果头.事实截止代次);
            if (代次.成功()) {
                const auto 根归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, L2场景身份{请求.树.值}, 0});
                const auto 父归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.直接父场景, 0});
                if (!根归属.成功() || !根归属.树归属)
                    return L2场景结构内部::形成场景树节点写入失败(
                        根归属.结果头.状态, 根归属.结果头.事实截止代次);
                if (!父归属.成功() || !父归属.树归属)
                    return L2场景结构内部::形成场景树节点写入失败(
                        父归属.结果头.状态, 父归属.结果头.事实截止代次);
                if (根归属.树归属->类别 != L2场景树归属类别::根
                    || 根归属.树归属->树 != 请求.树
                    || 父归属.树归属->树 != 请求.树)
                    return L2场景结构内部::形成场景树节点写入失败(
                        L2结构状态::入口拒绝,
                        父归属.结果头.事实截止代次);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.节点 = {{{L2场景结构内部::树内场景节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2场景结构内部::树内场景族归属本地键值},
                    L1所有者范围写集本地键{
                        L2场景结构内部::树内场景节点本地键值},
                    场景身份来源定位_.族锚点,
                    场景身份来源定位_.族归属关系类型, 1},
                {{L2场景结构内部::树内场景树归属本地键值},
                    L1所有者范围写集本地键{
                        L2场景结构内部::树内场景节点本地键值},
                    请求.树.值, 登记.登记->树归属关系类型.值, 1},
                {{L2场景结构内部::树内场景父子关系本地键值},
                    请求.直接父场景.值,
                    L1所有者范围写集本地键{
                        L2场景结构内部::树内场景节点本地键值},
                    关系登记.登记->父子关系类型.值,
                    static_cast<std::int64_t>(请求.顺序)}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2场景结构内部::映射场景写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return L2场景结构内部::形成场景树节点写入失败(
                    状态, 写入.事实代次);
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2场景结构内部::映射集合唯一(写入,
                    {L2场景结构内部::树内场景节点本地键值,
                     L2场景结构内部::树内场景族归属本地键值,
                     L2场景结构内部::树内场景树归属本地键值,
                     L2场景结构内部::树内场景父子关系本地键值}))
                return L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 节点编码 = *L2场景结构内部::查找唯一映射(
                写入, L2场景结构内部::树内场景节点本地键值);
            const auto 父子编码 = *L2场景结构内部::查找唯一映射(
                写入, L2场景结构内部::树内场景父子关系本地键值);
            const auto 读回当前代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (读回当前代次.状态 != L1中性读取状态::成功
                || 读回当前代次.事实代次 < 写入.事实代次)
                return L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 归属 = 读取场景树归属({
                {L2结构合同版本, 读回当前代次.事实代次}, L2读取类别::历史,
                L2场景身份{节点编码}, 写入.事实代次});
            const auto 场景 = 读取完整场景({
                {L2结构合同版本, 读回当前代次.事实代次}, L2读取类别::历史,
                L2场景身份{节点编码}, 写入.事实代次});
            const auto 来源 = L2场景结构内部::读取历史场景身份来源(
                L1_, 场景身份来源定位_, {
                    {L2结构合同版本, 读回当前代次.事实代次}, L2读取类别::历史,
                    L2场景身份{节点编码}, 写入.事实代次});
            const auto 父读回 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 父子编码});
            const auto* 原父关系 = 父读回.事实
                ? std::get_if<L1所有者范围关系事实>(&*父读回.事实) : nullptr;
            const auto 父关系 = 原父关系
                ? L2场景结构内部::形成截止父子关系事实(*原父关系,
                    第一层写入端口_.所有者身份(),
                    关系登记.登记->父子关系类型.值, 写入.事实代次)
                : std::nullopt;
            const auto 父组 = L1_.读取所有者范围历史关系组({
                L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::目标, 节点编码,
                关系登记.登记->父子关系类型.值, 写入.事实代次});
            if (!归属.成功() || !归属.树归属 || !场景.场景
                || !来源.成功() || !来源.身份来源 || !父关系
                || 父组.状态 != L1所有者范围读取状态::成功
                || 父组.历史截止事实代次 != 写入.事实代次
                || 父组.读取事实代次 < 写入.事实代次
                || 父组.关系组.size() != 1
                || 父组.关系组.front().编码 != 父子编码
                || 归属.树归属->树 != 请求.树
                || 父关系->父场景 != 请求.直接父场景
                || 父关系->子场景.值 != 节点编码
                || 父关系->顺序 != 请求.顺序)
                return L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2场景树节点事实 节点事实{
                *场景.场景, *来源.身份来源, *归属.树归属};
            L2场景树节点写入结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, 请求.树,
                std::move(节点事实), std::move(父关系)};
            return 结果.成功() ? 结果
                : L2场景结构内部::形成场景树节点写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景树节点写入失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景树读取结果 读取场景树(const L2场景树读取请求& 请求) const {
        if (!L2场景树读取请求有效(请求)) return {};
        try {
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            const auto 登记 = 读取当前场景树结构登记();
            const auto 关系登记 = 读取当前场景关系类型登记();
            if (!登记.成功() || !登记.登记)
                return L2场景结构内部::形成场景树读取失败(
                    请求, 登记.结果头.状态, 登记.结果头.事实截止代次);
            if (!关系登记.成功() || !关系登记.登记)
                return L2场景结构内部::形成场景树读取失败(
                    请求, L2场景结构内部::映射登记读取状态(关系登记.状态),
                    关系登记.事实截止代次);
            if (请求.读取类别 == L2读取类别::当前
                && 登记.结果头.事实截止代次 != 截止)
                return L2场景结构内部::形成场景树读取失败(
                    请求, 登记.结果头.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    登记.结果头.事实截止代次);
            if (请求.读取类别 == L2读取类别::当前
                && 关系登记.事实截止代次 != 截止)
                return L2场景结构内部::形成场景树读取失败(
                    请求, 关系登记.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    关系登记.事实截止代次);
            const L2场景身份 根{请求.树.值};
            const auto 根归属 = 读取场景树归属({请求.请求头,
                请求.读取类别, 根, 请求.历史截止事实代次});
            if (!根归属.成功() || !根归属.树归属
                || 根归属.树归属->类别 != L2场景树归属类别::根
                || 根归属.树归属->树 != 请求.树)
                return L2场景结构内部::形成场景树读取失败(
                    请求, 根归属.结果头.状态,
                    根归属.结果头.事实截止代次);
            std::vector<稳定编码> 场景编码组{根.值};
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 组 = L1_.读取所有者范围当前目标关系组({
                    L1所有者范围CRUD合同版本, 根.值,
                    登记.登记->树归属关系类型.值});
                if (组.状态 != L1所有者范围读取状态::成功)
                    return L2场景结构内部::形成场景树读取失败(
                        请求, 组.状态 == L1所有者范围读取状态::事实代次漂移
                            ? L2结构状态::事实代次漂移
                            : L2结构状态::内部不一致, 组.读取事实代次);
                if (组.读取事实代次 != 截止)
                    return L2场景结构内部::形成场景树读取失败(
                        请求, 组.读取事实代次 != 0
                            ? L2结构状态::事实代次漂移
                            : L2结构状态::内部不一致, 组.读取事实代次);
                for (const auto& 关系 : 组.关系组) {
                    if (关系.目标节点 != 根.值
                        || 关系.关系类型节点
                            != 登记.登记->树归属关系类型.值
                        || 关系.写入所有者
                            != 第一层写入端口_.所有者身份()
                        || 关系.角色或顺序 != 1 || 关系.退出事实代次
                        || std::find(场景编码组.begin(), 场景编码组.end(),
                            关系.源节点) != 场景编码组.end())
                        return L2场景结构内部::形成场景树读取失败(
                            请求, L2结构状态::内部不一致, 截止);
                    场景编码组.push_back(关系.源节点);
                }
            } else {
                const auto 组 = L1_.读取所有者范围历史关系组({
                    L1所有者范围CRUD合同版本,
                    L1所有者范围关系端点方向::目标, 根.值,
                    登记.登记->树归属关系类型.值, 截止});
                if (组.状态 != L1所有者范围读取状态::成功)
                    return L2场景结构内部::形成场景树读取失败(
                        请求, L2结构状态::内部不一致, 组.读取事实代次);
                for (const auto& 关系 : 组.关系组) {
                    if (关系.目标节点 != 根.值
                        || 关系.关系类型节点 != 登记.登记->树归属关系类型.值
                        || 关系.写入所有者 != 第一层写入端口_.所有者身份()
                        || 关系.角色或顺序 != 1
                        || 关系.创建事实代次 > 截止
                        || (关系.退出事实代次 && *关系.退出事实代次 <= 截止)
                        || std::find(场景编码组.begin(), 场景编码组.end(),
                            关系.源节点) != 场景编码组.end())
                        return L2场景结构内部::形成场景树读取失败(
                            请求, L2结构状态::内部不一致, 截止);
                    场景编码组.push_back(关系.源节点);
                }
            }
            std::sort(场景编码组.begin(), 场景编码组.end());
            L2场景树事实 树{请求.树, 根, *登记.登记,
                *根归属.树归属, {}, {}, 截止};
            树.结构登记.事实截止代次 = 截止;
            for (const auto 编码 : 场景编码组) {
                const L2场景身份 场景身份{编码};
                const auto 场景 = 读取完整场景({请求.请求头,
                    请求.读取类别, 场景身份,
                    请求.读取类别 == L2读取类别::历史 ? 截止 : 0});
                const L2场景身份来源读取请求 来源请求{请求.请求头,
                    请求.读取类别, 场景身份,
                    请求.读取类别 == L2读取类别::历史 ? 截止 : 0};
                const auto 来源 = 请求.读取类别 == L2读取类别::当前
                    ? L2场景结构内部::读取当前场景身份来源(
                        L1_, 场景身份来源定位_, 来源请求)
                    : L2场景结构内部::读取历史场景身份来源(
                        L1_, 场景身份来源定位_, 来源请求);
                const auto 归属 = 读取场景树归属({请求.请求头,
                    请求.读取类别, 场景身份,
                    请求.读取类别 == L2读取类别::历史 ? 截止 : 0});
                if (请求.读取类别 == L2读取类别::当前) {
                    if (场景.结果头.状态 == L2结构状态::事实代次漂移
                        || 场景.结果头.状态 == L2结构状态::许可拒绝
                        || 场景.结果头.状态 == L2结构状态::资源失败)
                        return L2场景结构内部::形成场景树读取失败(
                            请求, 场景.结果头.状态,
                            场景.结果头.事实截止代次);
                    if (来源.结果头.状态 == L2结构状态::事实代次漂移
                        || 来源.结果头.状态 == L2结构状态::许可拒绝
                        || 来源.结果头.状态 == L2结构状态::资源失败)
                        return L2场景结构内部::形成场景树读取失败(
                            请求, 来源.结果头.状态,
                            来源.结果头.事实截止代次);
                    if (归属.结果头.状态 == L2结构状态::事实代次漂移
                        || 归属.结果头.状态 == L2结构状态::许可拒绝
                        || 归属.结果头.状态 == L2结构状态::资源失败)
                        return L2场景结构内部::形成场景树读取失败(
                            请求, 归属.结果头.状态,
                            归属.结果头.事实截止代次);
                }
                if (场景.结果头.状态 != L2结构状态::已读取 || !场景.场景
                    || !来源.成功() || !来源.身份来源
                    || !归属.成功() || !归属.树归属
                    || 场景.结果头.事实截止代次 != 截止
                    || 来源.结果头.事实截止代次 != 截止
                    || 归属.结果头.事实截止代次 != 截止
                    || 归属.树归属->树 != 请求.树)
                    return L2场景结构内部::形成场景树读取失败(
                        请求, L2结构状态::内部不一致, 截止);
                for (const auto& 关系 : 场景.场景->直接子场景) {
                    if (std::find(场景编码组.begin(), 场景编码组.end(),
                            关系.子场景.值) == 场景编码组.end())
                        return L2场景结构内部::形成场景树读取失败(
                            请求, L2结构状态::内部不一致, 截止);
                    树.父子关系组.push_back(关系);
                }
                std::vector<L1所有者范围关系事实> 目标父关系组;
                std::uint64_t 目标父读取代次 = 0;
                if (请求.读取类别 == L2读取类别::当前) {
                    const auto 目标父组 = L1_.读取所有者范围当前目标关系组({
                        L1所有者范围CRUD合同版本, 编码,
                        关系登记.登记->父子关系类型.值});
                    if (目标父组.状态 != L1所有者范围读取状态::成功)
                        return L2场景结构内部::形成场景树读取失败(
                            请求, 目标父组.状态
                                == L1所有者范围读取状态::事实代次漂移
                                ? L2结构状态::事实代次漂移
                                : L2结构状态::内部不一致,
                            目标父组.读取事实代次);
                    if (目标父组.读取事实代次 != 截止)
                        return L2场景结构内部::形成场景树读取失败(
                            请求, 目标父组.读取事实代次 != 0
                                ? L2结构状态::事实代次漂移
                                : L2结构状态::内部不一致,
                            目标父组.读取事实代次);
                    目标父关系组 = 目标父组.关系组;
                    目标父读取代次 = 目标父组.读取事实代次;
                } else {
                    const auto 目标父组 = L1_.读取所有者范围历史关系组({
                        L1所有者范围CRUD合同版本,
                        L1所有者范围关系端点方向::目标, 编码,
                        关系登记.登记->父子关系类型.值, 截止});
                    if (目标父组.状态 != L1所有者范围读取状态::成功)
                        return L2场景结构内部::形成场景树读取失败(
                            请求, L2结构状态::内部不一致, 目标父组.读取事实代次);
                    目标父关系组 = 目标父组.关系组;
                    目标父读取代次 = 目标父组.读取事实代次;
                }
                if (目标父读取代次 != 截止 || 目标父关系组.size()
                        != (场景身份 == 根 ? 0U : 1U))
                    return L2场景结构内部::形成场景树读取失败(
                        请求, L2结构状态::内部不一致, 截止);
                if (!目标父关系组.empty()) {
                    const auto& 关系 = 目标父关系组.front();
                    if (关系.目标节点 != 编码
                        || 关系.关系类型节点 != 关系登记.登记->父子关系类型.值
                        || 关系.写入所有者 != 第一层写入端口_.所有者身份()
                        || 关系.创建事实代次 > 截止
                        || (关系.退出事实代次 && *关系.退出事实代次 <= 截止)
                        || std::find(场景编码组.begin(), 场景编码组.end(),
                            关系.源节点) == 场景编码组.end()
                        || std::none_of(树.父子关系组.begin(),
                            树.父子关系组.end(), [&](const auto& 已收集) noexcept {
                                return 已收集.关系稳定编码 == 关系.编码
                                    && 已收集.父场景.值 == 关系.源节点
                                    && 已收集.子场景.值 == 关系.目标节点;
                            }))
                        return L2场景结构内部::形成场景树读取失败(
                            请求, L2结构状态::内部不一致, 截止);
                }
                树.场景组.push_back({*场景.场景, *来源.身份来源,
                    *归属.树归属});
            }
            std::sort(树.父子关系组.begin(), 树.父子关系组.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.关系稳定编码 < 右.关系稳定编码;
                });
            L2场景树读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::move(树)};
            return 结果.成功() ? 结果
                : L2场景结构内部::形成场景树读取失败(
                    请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景树读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景树读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景树读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    L2当前场景树组读取结果 读取全部当前场景树(
        const L2当前场景树组读取请求& 请求) const {
        if (!L2当前场景树组读取请求有效(请求))
            return L2场景结构内部::形成当前场景树组读取失败(
                L2结构状态::入口拒绝);
        try {
            std::optional<L2场景树结构登记> 登记;
            {
                std::lock_guard<std::mutex> 锁(场景树结构登记锁_);
                登记 = 场景树结构定位_;
            }
            if (!登记 || !L2场景树结构登记完整(*登记))
                return L2场景结构内部::形成当前场景树组读取失败(
                    L2结构状态::入口拒绝);

            L1所有者范围一致当前读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.所有者 = {第一层写入端口_.所有者身份()};
            L1请求.节点 = {登记->树登记锚点稳定编码,
                登记->根标记关系类型.值};
            L1请求.目标关系组 = {{登记->树登记锚点稳定编码,
                登记->根标记关系类型.值}};
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);

            const auto 映射顶层失败 = [&](L2结构状态 状态,
                std::uint64_t 截止 = 0) noexcept {
                return L2场景结构内部::形成当前场景树组读取失败(
                    状态, 截止);
            };
            if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
                const bool 空载荷 = 读取.所有者.empty() && 读取.节点.empty()
                    && 读取.关系.empty() && 读取.值.empty()
                    && 读取.属性值.empty() && 读取.源关系组.empty()
                    && 读取.目标关系组.empty();
                const bool 漂移完整 = 请求.请求头.期望事实代次 != 0
                    && 读取.状态
                        == L1所有者范围一致当前读取状态::事实代次漂移
                    && 读取.读取事实代次 != 0
                    && 读取.读取事实代次 != 请求.请求头.期望事实代次;
                const bool 其它失败完整 = 读取.状态
                        != L1所有者范围一致当前读取状态::事实代次漂移
                    && 读取.读取事实代次 == 0;
                if (读取.合同版本 != L1所有者范围一致当前读取合同版本
                    || 读取.期望事实代次 != 请求.请求头.期望事实代次
                    || !空载荷 || (!漂移完整 && !其它失败完整))
                    return 映射顶层失败(L2结构状态::内部不一致,
                        读取.读取事实代次);
                return 映射顶层失败(
                    L2场景结构内部::映射场景一致读取失败状态(读取.状态),
                    读取.读取事实代次);
            }

            const std::uint64_t 截止 = 读取.读取事实代次;
            if (读取.合同版本 != L1所有者范围一致当前读取合同版本
                || 读取.期望事实代次 != 请求.请求头.期望事实代次
                || 截止 == 0
                || (请求.请求头.期望事实代次 != 0
                    && 截止 != 请求.请求头.期望事实代次)
                || 读取.所有者.size() != 1 || 读取.节点.size() != 2
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || 读取.目标关系组.size() != 1)
                return 映射顶层失败(L2结构状态::内部不一致, 截止);

            const auto& 所有者项 = 读取.所有者.front();
            const auto* 锚点项 = L2场景结构内部::查找唯一节点项(
                读取, 登记->树登记锚点稳定编码);
            const auto* 类型项 = L2场景结构内部::查找唯一节点项(
                读取, 登记->根标记关系类型.值);
            const auto& 根组 = 读取.目标关系组.front();
            const auto 内部节点完整 = [&](const auto* 项, 稳定编码 编码,
                const L2生命周期& 生命周期) noexcept {
                return 项 && 项->查询编码 == 编码
                    && 项->状态
                        == L1所有者范围一致当前读取项目状态::成功
                    && 项->事实 && 项->事实->编码 == 编码
                    && 项->事实->写入所有者
                        == 第一层写入端口_.所有者身份()
                    && 项->事实->种类 == 节点种类::普通
                    && !项->事实->属性类型表示
                    && 项->事实->当前属性.empty()
                    && 项->事实->创建事实代次
                        == 生命周期.创建事实代次
                    && !项->事实->退出事实代次;
            };
            if (所有者项.查询所有者 != 第一层写入端口_.所有者身份()
                || 所有者项.状态
                    != L1所有者范围一致当前读取项目状态::成功
                || !所有者项.所有者事实
                || 所有者项.所有者事实->所有者
                    != 第一层写入端口_.所有者身份()
                || 所有者项.所有者事实->范围种类
                    != L1所有者范围种类::独占结构范围
                || 所有者项.所有者事实->退出事实代次
                || !内部节点完整(锚点项, 登记->树登记锚点稳定编码,
                    登记->树登记锚点生命周期)
                || !内部节点完整(类型项, 登记->根标记关系类型.值,
                    登记->根标记关系类型生命周期)
                || 根组.目标节点 != 登记->树登记锚点稳定编码
                || 根组.关系类型节点 != 登记->根标记关系类型.值)
                return 映射顶层失败(L2结构状态::内部不一致, 截止);

            std::vector<L2场景树身份> 树身份组;
            树身份组.reserve(根组.成员.size());
            for (const auto& 成员 : 根组.成员) {
                const auto& 关系 = 成员.关系;
                const auto& 根节点 = 成员.对端节点;
                if (关系.写入所有者 != 第一层写入端口_.所有者身份()
                    || 关系.源节点 != 根节点.编码
                    || 关系.目标节点 != 登记->树登记锚点稳定编码
                    || 关系.关系类型节点 != 登记->根标记关系类型.值
                    || 关系.角色或顺序 != 1 || 关系.退出事实代次
                    || 关系.创建事实代次 == 0
                    || 关系.创建事实代次 > 截止
                    || 根节点.写入所有者
                        != 第一层写入端口_.所有者身份()
                    || 根节点.种类 != 节点种类::普通
                    || 根节点.属性类型表示 || 根节点.退出事实代次
                    || 根节点.创建事实代次 != 关系.创建事实代次
                    || 根节点.编码 == 登记->树登记锚点稳定编码
                    || 根节点.编码 == 登记->根标记关系类型.值)
                    return 映射顶层失败(L2结构状态::内部不一致, 截止);
                树身份组.push_back(L2场景树身份{根节点.编码});
            }
            std::sort(树身份组.begin(), 树身份组.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.值 < 右.值;
                });
            if (std::adjacent_find(树身份组.begin(), 树身份组.end())
                    != 树身份组.end())
                return 映射顶层失败(L2结构状态::内部不一致, 截止);

            L2当前场景树组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt}, {}};
            结果.场景树组.reserve(树身份组.size());
            for (const auto 树身份 : 树身份组) {
                const auto 单树 = 读取场景树({{L2结构合同版本, 截止},
                    L2读取类别::当前, 树身份, 0});
                if (!单树.成功() || !单树.树
                    || 单树.结果头.事实截止代次 != 截止
                    || 单树.树->树 != 树身份) {
                    const auto 当前代次 = L1_.读取中性当前事实代次(
                        {L1中性CRUD合同版本});
                    if (当前代次.合同版本 != L1中性CRUD合同版本)
                        return 映射顶层失败(L2结构状态::内部不一致,
                            当前代次.事实代次);
                    if (当前代次.状态 != L1中性读取状态::成功)
                        return 映射顶层失败(
                            L2场景结构内部::映射事实代次探测失败(
                                当前代次.状态),
                            当前代次.事实代次);
                    if (当前代次.事实代次 != 截止)
                        return 映射顶层失败(L2结构状态::事实代次漂移,
                            当前代次.事实代次);
                    return 映射顶层失败(
                        单树.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致
                            : 单树.结果头.状态,
                        单树.结果头.事实截止代次);
                }
                结果.场景树组.push_back(*单树.树);
            }
            if (!结果.成功())
                return 映射顶层失败(L2结构状态::内部不一致, 截止);

            const auto 尾代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (尾代次.合同版本 != L1中性CRUD合同版本)
                return 映射顶层失败(L2结构状态::内部不一致,
                    尾代次.事实代次);
            if (尾代次.状态 != L1中性读取状态::成功)
                return 映射顶层失败(
                    L2场景结构内部::映射事实代次探测失败(尾代次.状态),
                    尾代次.事实代次);
            if (尾代次.事实代次 != 截止)
                return 映射顶层失败(L2结构状态::事实代次漂移,
                    尾代次.事实代次);
            return 结果;
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成当前场景树组读取失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成当前场景树组读取失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成当前场景树组读取失败(
                L2结构状态::内部不一致);
        }
    }


    L2场景身份来源读取结果 读取场景身份来源(
        const L2场景身份来源读取请求& 请求) const {
        if (!L2场景身份来源读取请求有效(请求)) return {};
        try {
            const auto 归属 = 读取场景树归属({请求.请求头,
                请求.读取类别, 请求.场景, 请求.历史截止事实代次});
            if (!归属.成功())
                return L2场景结构内部::形成场景身份来源读取失败(
                    请求, 归属.结果头.状态, 归属.结果头.事实截止代次);
            return 请求.读取类别 == L2读取类别::当前
                ? L2场景结构内部::读取当前场景身份来源(
                    L1_, 场景身份来源定位_, 请求)
                : L2场景结构内部::读取历史场景身份来源(
                    L1_, 场景身份来源定位_, 请求);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景身份来源读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景身份来源读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景身份来源读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；初始属性以一份写集建立值并设置当前槽。
    L2场景固定属性写入结果 新增场景固定属性(
        const L2场景固定属性新增请求& 请求) {
        if (!L2场景固定属性新增请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份)) return {};
        try {
            const auto 类型登记 = 读取当前场景属性类型登记();
            if (!类型登记.成功() || !类型登记.登记)
                return L2场景结构内部::形成固定属性写入失败(
                    类型登记.状态 == L2场景属性类型登记状态::事实代次漂移
                        ? L2结构状态::事实代次漂移
                        : 类型登记.状态 == L2场景属性类型登记状态::资源失败
                            ? L2结构状态::资源失败 : L2结构状态::入口拒绝,
                    类型登记.事实截止代次);
            const auto 期望类型 = std::visit([&](const auto& 材料) noexcept {
                using 类型 = std::decay_t<decltype(材料)>;
                if constexpr (std::is_same_v<类型, std::int64_t>)
                    return 类型登记.登记->I64属性类型.值;
                else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>)
                    return 类型登记.登记->I64组属性类型.值;
                else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>)
                    return 类型登记.登记->U64组属性类型.值;
                else return 类型登记.登记->独立材料属性类型.值;
            }, 请求.新属性.原始值材料);
            if (请求.新属性.属性类型身份 != 期望类型)
                return L2场景结构内部::形成固定属性写入失败(
                    L2结构状态::入口拒绝, 类型登记.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.值 = {{{L2场景结构内部::场景固定属性值本地键值},
                L1所有者范围事实引用{请求.场景.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                L2场景结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1所有者范围事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1所有者范围事实引用{请求.场景.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                {L2场景结构内部::场景固定属性值本地键值}}};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 树归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.场景, 0});
                if (!树归属.成功())
                    return L2场景结构内部::形成固定属性写入失败(
                        树归属.结果头.状态, 树归属.结果头.事实截止代次);
                if (类型登记.事实截止代次 != 请求.请求头.期望事实代次)
                    return L2场景结构内部::形成固定属性写入失败(
                        L2结构状态::事实代次漂移,
                        类型登记.事实截止代次);
                const auto 前置 = L2场景结构内部::检查固定属性前置(
                    L1_, 场景身份来源定位_, 请求.场景,
                    请求.新属性.属性类型身份,
                    std::nullopt, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2场景结构内部::提交并读回固定属性写集(
                L1_, 第一层写入端口_, 写集, 请求.场景,
                请求.新属性, std::nullopt);
            return 结果.成功() && !结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2场景结构内部::形成固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成固定属性写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成固定属性写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成固定属性写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；换代在一份写集中建立新值、切槽并退出具名旧值。
    L2场景固定属性写入结果 换代场景固定属性(
        const L2场景固定属性换代请求& 请求) {
        if (!L2场景固定属性换代请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份)) return {};
        try {
            const auto 类型登记 = 读取当前场景属性类型登记();
            if (!类型登记.成功() || !类型登记.登记)
                return L2场景结构内部::形成固定属性写入失败(
                    类型登记.状态 == L2场景属性类型登记状态::事实代次漂移
                        ? L2结构状态::事实代次漂移
                        : 类型登记.状态 == L2场景属性类型登记状态::资源失败
                            ? L2结构状态::资源失败 : L2结构状态::入口拒绝,
                    类型登记.事实截止代次);
            const auto 期望类型 = std::visit([&](const auto& 材料) noexcept {
                using 类型 = std::decay_t<decltype(材料)>;
                if constexpr (std::is_same_v<类型, std::int64_t>)
                    return 类型登记.登记->I64属性类型.值;
                else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>)
                    return 类型登记.登记->I64组属性类型.值;
                else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>)
                    return 类型登记.登记->U64组属性类型.值;
                else return 类型登记.登记->独立材料属性类型.值;
            }, 请求.新属性.原始值材料);
            if (请求.新属性.属性类型身份 != 期望类型)
                return L2场景结构内部::形成固定属性写入失败(
                    L2结构状态::入口拒绝, 类型登记.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.值 = {{{L2场景结构内部::场景固定属性值本地键值},
                L1所有者范围事实引用{请求.场景.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                L2场景结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1所有者范围事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1所有者范围事实引用{请求.场景.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                {L2场景结构内部::场景固定属性值本地键值}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 树归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.场景, 0});
                if (!树归属.成功())
                    return L2场景结构内部::形成固定属性写入失败(
                        树归属.结果头.状态, 树归属.结果头.事实截止代次);
                if (类型登记.事实截止代次 != 请求.请求头.期望事实代次)
                    return L2场景结构内部::形成固定属性写入失败(
                        L2结构状态::事实代次漂移,
                        类型登记.事实截止代次);
                const auto 前置 = L2场景结构内部::检查固定属性前置(
                    L1_, 场景身份来源定位_, 请求.场景,
                    请求.新属性.属性类型身份,
                    请求.旧值稳定编码, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2场景结构内部::提交并读回固定属性写集(
                L1_, 第一层写入端口_, 写集, 请求.场景,
                请求.新属性, 请求.旧值稳定编码);
            return 结果.成功() && 结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2场景结构内部::形成固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成固定属性写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成固定属性写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成固定属性写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史读取异常与矛盾均映射为结构化状态。
    L2场景节点读取结果 读取场景节点(const L2场景节点读取请求& 请求) const {
        if (!L2场景节点读取请求有效(请求)) return {};
        try {
            const L2场景完整读取请求 完整请求{请求.请求头, 请求.读取类别,
                请求.场景, 请求.读取类别 == L2读取类别::历史
                    ? 请求.请求头.期望事实代次 : 0};
            const auto 完整结果 = 读取完整场景(完整请求);
            return {完整结果.结果头, 完整结果.场景};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

    // 诊断责任：向上送出；替换在一份写集中建立新关系并退出具名旧关系。
    L2场景父子关系写入结果 替换场景父子关系(
        const L2场景父子关系替换请求& 请求) {
        if (!L2场景父子关系替换请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成父子写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景父子关系本地键值},
                请求.新父场景.值, 请求.子场景.值, 登记.父子关系类型.值,
                static_cast<std::int64_t>(请求.新顺序)}};
            写集.退出事实 = {请求.旧关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成父子写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 旧父归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.旧父场景, 0});
                const auto 新父归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.新父场景, 0});
                const auto 子归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.子场景, 0});
                for (const auto* 归属 : {&旧父归属, &新父归属, &子归属}) {
                    if (!归属->成功() || !归属->树归属)
                        return L2场景结构内部::形成父子写入失败(
                            归属->结果头.状态, 归属->结果头.事实截止代次);
                }
                if (子归属.树归属->类别 == L2场景树归属类别::根
                    || 旧父归属.树归属->树 != 新父归属.树归属->树
                    || 旧父归属.树归属->树 != 子归属.树归属->树)
                    return L2场景结构内部::形成父子写入失败(
                        L2结构状态::入口拒绝,
                        子归属.结果头.事实截止代次);
                const auto 前置 = L2场景结构内部::检查父子替换前置(
                    L1_, 请求, 场景身份来源定位_, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成父子写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回父子写集(
                L1_, 第一层写入端口_, 写集,
                登记.父子关系类型.值,
                L2场景结构内部::父子关系读回规格{
                    {}, 请求.新父场景, 请求.子场景, 请求.新顺序},
                L2场景结构内部::父子关系读回规格{请求.旧关系稳定编码,
                    请求.旧父场景, 请求.子场景, 请求.旧顺序});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；成员端点只经 E1 公开读取并恰一次提交。
    L2场景成员关系写入结果 新增场景成员关系(
        const L2场景成员关系新增请求& 请求) {
        if (!L2场景成员关系新增请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成成员写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景成员关系本地键值},
                请求.场景.值, 请求.存在.值, 登记.成员关系类型.值,
                static_cast<std::int64_t>(请求.顺序)}};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成成员写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 树归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.场景, 0});
                if (!树归属.成功())
                    return L2场景结构内部::形成成员写入失败(
                        树归属.结果头.状态, 树归属.结果头.事实截止代次);
                const auto 前置 = L2场景结构内部::检查成员新增前置(
                    L1_, 存在服务_, 请求, 场景身份来源定位_, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成成员写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回成员写集(
                L1_, 第一层写入端口_, 写集,
                登记.成员关系类型.值,
                L2场景结构内部::成员关系读回规格{
                    {}, 请求.场景, 请求.存在, 请求.顺序}, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；成员替换原子建立新关系并退出具名旧关系。
    L2场景成员关系写入结果 替换场景成员关系(
        const L2场景成员关系替换请求& 请求) {
        if (!L2场景成员关系替换请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成成员写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景成员关系本地键值},
                请求.新场景.值, 请求.存在.值, 登记.成员关系类型.值,
                static_cast<std::int64_t>(请求.新顺序)}};
            写集.退出事实 = {请求.旧关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成成员写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 旧归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.旧场景, 0});
                if (!旧归属.成功())
                    return L2场景结构内部::形成成员写入失败(
                        旧归属.结果头.状态, 旧归属.结果头.事实截止代次);
                const auto 新归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.新场景, 0});
                if (!新归属.成功())
                    return L2场景结构内部::形成成员写入失败(
                        新归属.结果头.状态, 新归属.结果头.事实截止代次);
                const auto 前置 = L2场景结构内部::检查成员替换前置(
                    L1_, 存在服务_, 请求, 场景身份来源定位_, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成成员写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回成员写集(
                L1_, 第一层写入端口_, 写集,
                登记.成员关系类型.值,
                L2场景结构内部::成员关系读回规格{
                    {}, 请求.新场景, 请求.存在, 请求.新顺序},
                L2场景结构内部::成员关系读回规格{请求.旧关系稳定编码,
                    请求.旧场景, 请求.存在, 请求.旧顺序});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；成员退出只退出具名关系并正式历史读回。
    L2场景成员关系写入结果 退出场景成员关系(
        const L2场景成员关系退出请求& 请求) {
        if (!L2场景成员关系退出请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成成员写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.退出事实 = {请求.关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成成员写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 树归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.场景, 0});
                if (!树归属.成功())
                    return L2场景结构内部::形成成员写入失败(
                        树归属.结果头.状态, 树归属.结果头.事实截止代次);
                const auto 前置 = L2场景结构内部::检查成员退出前置(
                    L1_, 存在服务_, 请求, 场景身份来源定位_, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成成员写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回成员写集(
                L1_, 第一层写入端口_, 写集,
                登记.成员关系类型.值, std::nullopt,
                L2场景结构内部::成员关系读回规格{请求.关系稳定编码,
                    请求.场景, 请求.存在, 请求.顺序});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::内部不一致);
        }
    }

    L2场景宿主存在读取结果 读取场景宿主存在关系(
        const L2场景宿主存在读取请求& 请求) const {
        if (!L2场景宿主存在读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景宿主结构登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成场景宿主读取失败(
                    请求, 登记结果.结果头.状态,
                    登记结果.结果头.事实截止代次);
            if (请求.读取类别 == L2读取类别::当前
                && 登记结果.结果头.事实截止代次
                    != 请求.请求头.期望事实代次)
                return L2场景结构内部::形成场景宿主读取失败(
                    请求, 登记结果.结果头.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    登记结果.结果头.事实截止代次);
            const auto 场景来源 = 读取场景身份来源({请求.请求头,
                请求.读取类别, 请求.场景, 请求.历史截止事实代次});
            if (!场景来源.成功())
                return L2场景结构内部::形成场景宿主读取失败(
                    请求, 场景来源.结果头.状态,
                    场景来源.结果头.事实截止代次);
            const auto 树归属 = 读取场景树归属({请求.请求头,
                请求.读取类别, 请求.场景, 请求.历史截止事实代次});
            if (!树归属.成功())
                return L2场景结构内部::形成场景宿主读取失败(
                    请求, 树归属.结果头.状态,
                    树归属.结果头.事实截止代次);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            std::optional<L2场景宿主存在关系事实> 找到;
            if (请求.读取类别 == L2读取类别::当前) {
                L1所有者范围一致当前读取请求 L1请求;
                L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
                L1请求.期望事实代次 = 截止;
                L1请求.节点 = {请求.场景.值};
                L1请求.源关系组 = {{请求.场景.值,
                    登记结果.登记->关系类型.值}};
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
                const auto 顶层 = L2场景结构内部::解释S2一致读取顶层(
                    读取, 截止);
                if (!顶层.成功())
                    return L2场景结构内部::形成场景宿主读取失败(
                        请求, 顶层.状态, 顶层.事实截止代次);
                if (读取.节点.size() != 1 || !读取.关系.empty()
                    || !读取.值.empty() || !读取.属性值.empty()
                    || 读取.源关系组.size() != 1
                    || !读取.目标关系组.empty())
                    return L2场景结构内部::形成场景宿主读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto* 场景项 = L2场景结构内部::查找唯一节点项(
                    读取, 请求.场景.值);
                if (!L2场景结构内部::当前场景节点项完整(
                        场景项, 请求.场景.值, 场景身份来源定位_.所有者,
                        顶层.事实截止代次))
                    return L2场景结构内部::形成场景宿主读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto& 组 = 读取.源关系组.front();
                if (组.源节点 != 请求.场景.值
                    || 组.关系类型节点 != 登记结果.登记->关系类型.值)
                    return L2场景结构内部::形成场景宿主读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                for (const auto& 成员 : 组.成员) {
                    if (成员.关系.目标节点 != 成员.对端节点.编码
                        || 成员.关系.退出事实代次
                        || 成员.对端节点.退出事实代次)
                        return L2场景结构内部::形成场景宿主读取失败(
                            请求, L2结构状态::内部不一致,
                            顶层.事实截止代次);
                    auto 事实 = L2场景结构内部::形成截止场景宿主关系事实(
                        成员.关系, 场景身份来源定位_.所有者,
                        登记结果.登记->关系类型.值, 顶层.事实截止代次);
                    if (!事实 || 事实->场景 != 请求.场景
                        || 找到)
                        return L2场景结构内部::形成场景宿主读取失败(
                            请求, L2结构状态::内部不一致,
                            顶层.事实截止代次);
                    找到 = std::move(事实);
                }
            } else {
                const auto 读取 = L1_.读取所有者范围历史关系组({
                    L1所有者范围CRUD合同版本,
                    L1所有者范围关系端点方向::源, 请求.场景.值,
                    登记结果.登记->关系类型.值, 截止});
                if (读取.合同版本 != L1所有者范围CRUD合同版本
                    || 读取.方向 != L1所有者范围关系端点方向::源
                    || 读取.端点节点 != 请求.场景.值
                    || 读取.关系类型节点 != 登记结果.登记->关系类型.值
                    || 读取.历史截止事实代次 != 截止
                    || 读取.读取事实代次 != 请求.请求头.期望事实代次)
                    return L2场景结构内部::形成场景宿主读取失败(
                        请求, L2结构状态::内部不一致, 截止);
                if (读取.状态 != L1所有者范围读取状态::成功)
                    return L2场景结构内部::形成场景宿主读取失败(
                        请求, L2场景结构内部::映射历史关系组失败状态(
                            读取.状态), 截止);
                for (const auto& 原关系 : 读取.关系组) {
                    auto 事实 = L2场景结构内部::形成截止场景宿主关系事实(
                        原关系, 场景身份来源定位_.所有者,
                        登记结果.登记->关系类型.值, 截止);
                    if (!事实 || 事实->场景 != 请求.场景
                        || 事实->生命周期.退出事实代次 || 找到)
                        return L2场景结构内部::形成场景宿主读取失败(
                            请求, L2结构状态::内部不一致, 截止);
                    找到 = std::move(事实);
                }
            }
            if (!找到)
                return L2场景结构内部::形成场景宿主读取失败(
                    请求, L2结构状态::未找到, 截止);
            const auto 宿主来源 = 存在服务_.读取存在身份来源({请求.请求头,
                请求.读取类别, 找到->宿主存在, 请求.历史截止事实代次});
            if (!宿主来源.成功())
                return L2场景结构内部::形成场景宿主读取失败(
                    请求, 宿主来源.结果头.状态,
                    宿主来源.结果头.事实截止代次);
            L2场景宿主存在读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::move(找到)};
            return 结果.成功() ? 结果
                : L2场景结构内部::形成场景宿主读取失败(
                    请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景宿主读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景宿主读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景宿主读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    L2存在当前宿主场景读取结果 读取存在当前宿主场景(
        const L2存在当前宿主场景读取请求& 请求) const {
        if (!L2存在当前宿主场景读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景宿主结构登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成存在宿主场景读取失败(
                    登记结果.结果头.状态,
                    登记结果.结果头.事实截止代次);
            if (登记结果.结果头.事实截止代次
                    != 请求.请求头.期望事实代次)
                return L2场景结构内部::形成存在宿主场景读取失败(
                    登记结果.结果头.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    登记结果.结果头.事实截止代次);
            const auto 宿主来源 = 存在服务_.读取存在身份来源(
                {请求.请求头, L2读取类别::当前, 请求.宿主存在, 0});
            if (!宿主来源.成功())
                return L2场景结构内部::形成存在宿主场景读取失败(
                    宿主来源.结果头.状态, 宿主来源.结果头.事实截止代次);
            L1所有者范围一致当前读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.节点 = {请求.宿主存在.值};
            L1请求.目标关系组 = {{请求.宿主存在.值,
                登记结果.登记->关系类型.值}};
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
            const auto 顶层 = L2场景结构内部::解释S2一致读取顶层(
                读取, 请求.请求头.期望事实代次);
            if (!顶层.成功())
                return L2场景结构内部::形成存在宿主场景读取失败(
                    顶层.状态, 顶层.事实截止代次);
            if (读取.节点.size() != 1 || !读取.关系.empty()
                || !读取.值.empty() || !读取.属性值.empty()
                || !读取.源关系组.empty() || 读取.目标关系组.size() != 1)
                return L2场景结构内部::形成存在宿主场景读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto& 组 = 读取.目标关系组.front();
            if (组.目标节点 != 请求.宿主存在.值
                || 组.关系类型节点 != 登记结果.登记->关系类型.值)
                return L2场景结构内部::形成存在宿主场景读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            std::optional<L2场景宿主存在关系事实> 找到;
            for (const auto& 成员 : 组.成员) {
                if (成员.关系.源节点 != 成员.对端节点.编码
                    || 成员.关系.退出事实代次 || 成员.对端节点.退出事实代次)
                    return L2场景结构内部::形成存在宿主场景读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                auto 事实 = L2场景结构内部::形成截止场景宿主关系事实(
                    成员.关系, 场景身份来源定位_.所有者,
                    登记结果.登记->关系类型.值, 顶层.事实截止代次);
                if (!事实 || 事实->宿主存在 != 请求.宿主存在 || 找到)
                    return L2场景结构内部::形成存在宿主场景读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto 场景来源 = 读取场景身份来源({请求.请求头,
                    L2读取类别::当前, 事实->场景, 0});
                const auto 树归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 事实->场景, 0});
                if (!场景来源.成功() || !树归属.成功())
                    return L2场景结构内部::形成存在宿主场景读取失败(
                        !场景来源.成功() ? 场景来源.结果头.状态
                            : 树归属.结果头.状态,
                        !场景来源.成功() ? 场景来源.结果头.事实截止代次
                            : 树归属.结果头.事实截止代次);
                找到 = std::move(事实);
            }
            if (!找到)
                return L2场景结构内部::形成存在宿主场景读取失败(
                    L2结构状态::未找到, 顶层.事实截止代次);
            L2存在当前宿主场景读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 顶层.事实截止代次, std::nullopt},
                std::move(找到)};
            return 结果.成功() ? 结果
                : L2场景结构内部::形成存在宿主场景读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成存在宿主场景读取失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成存在宿主场景读取失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成存在宿主场景读取失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景宿主存在写入结果 新增场景宿主存在关系(
        const L2场景宿主存在新增请求& 请求) {
        if (!L2场景宿主存在新增请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份))
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::入口拒绝);
        try {
            const auto 登记 = 读取当前场景宿主结构登记();
            if (!登记.成功() || !登记.登记)
                return L2场景结构内部::形成场景宿主写入失败(
                    登记.结果头.状态, 登记.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景宿主关系本地键值},
                请求.场景.值, 请求.宿主存在.值,
                登记.登记->关系类型.值, 1}};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成场景宿主写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 当前 = 读取场景宿主存在关系(
                    {请求.请求头, L2读取类别::当前, 请求.场景, 0});
                if (当前.结果头.状态 != L2结构状态::未找到)
                    return L2场景结构内部::形成场景宿主写入失败(
                        当前.成功() ? L2结构状态::引用冲突
                            : 当前.结果头.状态,
                        当前.结果头.事实截止代次);
                const auto 反向 = 读取存在当前宿主场景(
                    {请求.请求头, 请求.宿主存在});
                if (反向.结果头.状态 != L2结构状态::未找到)
                    return L2场景结构内部::形成场景宿主写入失败(
                        反向.成功() ? L2结构状态::引用冲突
                            : 反向.结果头.状态,
                        反向.结果头.事实截止代次);
            }
            return L2场景结构内部::提交并读回场景宿主写集(
                L1_, 第一层写入端口_, 写集, 登记.登记->关系类型.值,
                L2场景结构内部::场景宿主关系读回规格{
                    {}, 请求.场景, 请求.宿主存在}, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景宿主存在写入结果 替换场景宿主存在关系(
        const L2场景宿主存在替换请求& 请求) {
        if (!L2场景宿主存在替换请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份))
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::入口拒绝);
        try {
            const auto 登记 = 读取当前场景宿主结构登记();
            if (!登记.成功() || !登记.登记)
                return L2场景结构内部::形成场景宿主写入失败(
                    登记.结果头.状态, 登记.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景宿主关系本地键值},
                请求.场景.值, 请求.新宿主存在.值,
                登记.登记->关系类型.值, 1}};
            写集.退出事实 = {请求.旧关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成场景宿主写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 当前 = 读取场景宿主存在关系(
                    {请求.请求头, L2读取类别::当前, 请求.场景, 0});
                if (!当前.成功() || !当前.关系)
                    return L2场景结构内部::形成场景宿主写入失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                if (当前.关系->关系稳定编码 != 请求.旧关系稳定编码
                    || 当前.关系->宿主存在 != 请求.旧宿主存在)
                    return L2场景结构内部::形成场景宿主写入失败(
                        L2结构状态::引用冲突, 当前.结果头.事实截止代次);
                const auto 旧反向 = 读取存在当前宿主场景(
                    {请求.请求头, 请求.旧宿主存在});
                if (!旧反向.成功() || !旧反向.关系
                    || 旧反向.关系->关系稳定编码 != 请求.旧关系稳定编码
                    || 旧反向.关系->场景 != 请求.场景)
                    return L2场景结构内部::形成场景宿主写入失败(
                        旧反向.成功() ? L2结构状态::引用冲突
                            : 旧反向.结果头.状态,
                        旧反向.结果头.事实截止代次);
                const auto 新反向 = 读取存在当前宿主场景(
                    {请求.请求头, 请求.新宿主存在});
                if (新反向.结果头.状态 != L2结构状态::未找到)
                    return L2场景结构内部::形成场景宿主写入失败(
                        新反向.成功() ? L2结构状态::引用冲突
                            : 新反向.结果头.状态,
                        新反向.结果头.事实截止代次);
            }
            return L2场景结构内部::提交并读回场景宿主写集(
                L1_, 第一层写入端口_, 写集, 登记.登记->关系类型.值,
                L2场景结构内部::场景宿主关系读回规格{
                    {}, 请求.场景, 请求.新宿主存在},
                L2场景结构内部::场景宿主关系读回规格{
                    请求.旧关系稳定编码, 请求.场景, 请求.旧宿主存在});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::内部不一致);
        }
    }

    L2场景宿主存在写入结果 退出场景宿主存在关系(
        const L2场景宿主存在退出请求& 请求) {
        if (!L2场景宿主存在退出请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份))
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::入口拒绝);
        try {
            const auto 登记 = 读取当前场景宿主结构登记();
            if (!登记.成功() || !登记.登记)
                return L2场景结构内部::形成场景宿主写入失败(
                    登记.结果头.状态, 登记.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.退出事实 = {请求.关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成场景宿主写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 当前 = 读取场景宿主存在关系(
                    {请求.请求头, L2读取类别::当前, 请求.场景, 0});
                const auto 反向 = 读取存在当前宿主场景(
                    {请求.请求头, 请求.宿主存在});
                if (!当前.成功() || !当前.关系 || !反向.成功() || !反向.关系)
                    return L2场景结构内部::形成场景宿主写入失败(
                        !当前.成功() ? 当前.结果头.状态 : 反向.结果头.状态,
                        !当前.成功() ? 当前.结果头.事实截止代次
                            : 反向.结果头.事实截止代次);
                if (当前.关系->关系稳定编码 != 请求.关系稳定编码
                    || 当前.关系->宿主存在 != 请求.宿主存在
                    || *当前.关系 != *反向.关系)
                    return L2场景结构内部::形成场景宿主写入失败(
                        L2结构状态::引用冲突, 当前.结果头.事实截止代次);
            }
            return L2场景结构内部::提交并读回场景宿主写集(
                L1_, 第一层写入端口_, 写集, 登记.登记->关系类型.值,
                std::nullopt, L2场景结构内部::场景宿主关系读回规格{
                    请求.关系稳定编码, 请求.场景, 请求.宿主存在});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景宿主写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；显式场景闭包经同期快照核对后由一份写集退出。
    L2场景退出结果 退出场景(const L2场景退出请求& 请求) {
        if (!L2场景退出请求有效(请求)
            || L2场景结构内部::是保留登记幂等身份(请求.幂等身份)) return {};
        std::lock_guard<std::mutex> 写锁(场景业务写入锁_);
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成场景退出失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.退出事实 = {请求.场景.值, 请求.族归属关系稳定编码};
            if (请求.当前树归属关系)
                写集.退出事实.push_back(*请求.当前树归属关系);
            if (请求.当前直接父关系)
                写集.退出事实.push_back(*请求.当前直接父关系);
            if (请求.当前宿主关系)
                写集.退出事实.push_back(*请求.当前宿主关系);
            写集.退出事实.insert(写集.退出事实.end(),
                请求.当前直接子关系.begin(), 请求.当前直接子关系.end());
            写集.退出事实.insert(写集.退出事实.end(),
                请求.当前直接成员关系.begin(), 请求.当前直接成员关系.end());
            写集.退出事实.insert(写集.退出事实.end(),
                请求.当前固定属性值.begin(), 请求.当前固定属性值.end());
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());

            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成场景退出失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 树归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 请求.场景, 0});
                if (!树归属.成功() || !树归属.树归属)
                    return L2场景结构内部::形成场景退出失败(
                        树归属.结果头.状态, 树归属.结果头.事实截止代次);
                if (树归属.树归属->类别 == L2场景树归属类别::根)
                    return L2场景结构内部::形成场景退出失败(
                        L2结构状态::引用冲突, 树归属.结果头.事实截止代次);
                if (!请求.当前树归属关系 || !请求.当前直接父关系
                    || 树归属.树归属->关系稳定编码
                        != *请求.当前树归属关系)
                    return L2场景结构内部::形成场景退出失败(
                        L2结构状态::引用冲突, 树归属.结果头.事实截止代次);
                const auto 来源 = L2场景结构内部::读取当前场景身份来源(
                    L1_, 场景身份来源定位_, {请求.请求头,
                        L2读取类别::当前, 请求.场景, 0});
                if (来源.结果头.状态 != L2结构状态::已读取
                    || !来源.身份来源) {
                    if (来源.结果头.状态 != L2结构状态::事实代次漂移)
                        return L2场景结构内部::形成场景退出失败(
                            来源.结果头.状态, 来源.结果头.事实截止代次);
                } else if (来源.身份来源->族归属关系稳定编码
                    != 请求.族归属关系稳定编码) {
                    return L2场景结构内部::形成场景退出失败(
                        L2结构状态::引用冲突, 来源.结果头.事实截止代次);
                }
                const auto 属性登记结果 = 读取当前场景属性类型登记();
                if (!属性登记结果.成功() || !属性登记结果.登记)
                    return L2场景结构内部::形成场景退出失败(
                        L2结构状态::内部不一致,
                        属性登记结果.事实截止代次);
                auto 快照 = L2场景结构内部::读取当前场景快照(
                    L1_, 存在服务_, 请求.场景, 代次.事实截止代次,
                    场景身份来源定位_, 登记, *属性登记结果.登记, true);
                if (!快照.成功()) {
                    if (快照.状态 != L2结构状态::事实代次漂移)
                        return L2场景结构内部::形成场景退出失败(
                            快照.状态, 快照.事实截止代次);
                }
                const auto 宿主 = 读取场景宿主存在关系({请求.请求头,
                    L2读取类别::当前, 请求.场景, 0});
                if (宿主.成功()) 快照.场景->当前宿主关系 = 宿主.关系;
                else if (宿主.结果头.状态 != L2结构状态::未找到)
                    return L2场景结构内部::形成场景退出失败(
                        宿主.结果头.状态, 宿主.结果头.事实截止代次);
                if (!快照.场景->直接子场景.empty()
                    || !L2场景结构内部::场景退出闭包一致(快照, 请求)) {
                    return L2场景结构内部::形成场景退出失败(
                        L2结构状态::引用冲突, 快照.事实截止代次);
                }
                if (!快照.直接父关系
                    || 快照.直接父关系->关系稳定编码
                        != *请求.当前直接父关系)
                    return L2场景结构内部::形成场景退出失败(
                        L2结构状态::引用冲突, 快照.事实截止代次);
                const auto 父归属 = 读取场景树归属({请求.请求头,
                    L2读取类别::当前, 快照.直接父关系->父场景, 0});
                if (!父归属.成功() || !父归属.树归属)
                    return L2场景结构内部::形成场景退出失败(
                        父归属.结果头.状态, 父归属.结果头.事实截止代次);
                if (父归属.树归属->树 != 树归属.树归属->树)
                    return L2场景结构内部::形成场景退出失败(
                        L2结构状态::引用冲突, 父归属.结果头.事实截止代次);
            }
            const auto 树登记 = 读取当前场景树结构登记();
            if (!树登记.成功() || !树登记.登记)
                return L2场景结构内部::形成场景退出失败(
                    L2结构状态::内部不一致,
                    树登记.结果头.事实截止代次);
            const auto 宿主登记 = 读取当前场景宿主结构登记();
            if (!宿主登记.成功() || !宿主登记.登记)
                return L2场景结构内部::形成场景退出失败(
                    宿主登记.结果头.状态,
                    宿主登记.结果头.事实截止代次);
            return L2场景结构内部::提交并读回场景退出写集(
                L1_, 第一层写入端口_, 写集, 请求,
                场景身份来源定位_, 登记, *树登记.登记,
                *宿主登记.登记);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景退出失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景退出失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史完整读取失败均不携带部分场景。
    L2场景完整读取结果 读取完整场景(
        const L2场景完整读取请求& 请求) const {
        if (!L2场景完整读取请求有效(请求)) return {};
        try {
            const auto 树归属 = 读取场景树归属({请求.请求头,
                请求.读取类别, 请求.场景, 请求.历史截止事实代次});
            if (!树归属.成功())
                return L2场景结构内部::形成完整读取失败(
                    请求, 树归属.结果头.状态,
                    树归属.结果头.事实截止代次);
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成完整读取失败(请求,
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto 属性登记结果 = 读取当前场景属性类型登记();
            if (!属性登记结果.成功() || !属性登记结果.登记)
                return L2场景结构内部::形成完整读取失败(请求,
                    属性登记结果.状态 == L2场景属性类型登记状态::许可拒绝
                        ? L2结构状态::许可拒绝
                        : 属性登记结果.状态
                            == L2场景属性类型登记状态::事实代次漂移
                            ? L2结构状态::事实代次漂移
                            : 属性登记结果.状态
                                == L2场景属性类型登记状态::资源失败
                                ? L2结构状态::资源失败
                                : 属性登记结果.状态
                                    == L2场景属性类型登记状态::入口拒绝
                                    ? L2结构状态::入口拒绝
                                    : L2结构状态::内部不一致,
                    属性登记结果.事实截止代次);
            if (请求.读取类别 == L2读取类别::当前
                && 登记结果.事实截止代次 != 请求.请求头.期望事实代次)
                return L2场景结构内部::形成完整读取失败(请求,
                    登记结果.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    登记结果.事实截止代次);
            if (请求.读取类别 == L2读取类别::当前
                && 属性登记结果.事实截止代次
                    != 请求.请求头.期望事实代次)
                return L2场景结构内部::形成完整读取失败(请求,
                    属性登记结果.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    属性登记结果.事实截止代次);
            auto 结果 = 请求.读取类别 == L2读取类别::当前
                ? L2场景结构内部::读取当前完整场景(
                    L1_, 存在服务_, 请求, 场景身份来源定位_,
                    *登记结果.登记, *属性登记结果.登记)
                : L2场景结构内部::读取历史完整场景(
                    L1_, 存在服务_, 请求, 场景身份来源定位_,
                    *登记结果.登记, *属性登记结果.登记);
            if (结果.结果头.状态 != L2结构状态::已读取 || !结果.场景)
                return 结果;
            const auto 宿主 = 读取场景宿主存在关系({请求.请求头,
                请求.读取类别, 请求.场景, 请求.历史截止事实代次});
            if (宿主.成功()) 结果.场景->当前宿主关系 = 宿主.关系;
            else if (宿主.结果头.状态 != L2结构状态::未找到)
                return L2场景结构内部::形成完整读取失败(
                    请求, 宿主.结果头.状态, 宿主.结果头.事实截止代次);
            return L2场景事实完整(*结果.场景, 结果.结果头.事实截止代次)
                ? 结果 : L2场景结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致,
                    结果.结果头.事实截止代次);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；存在公开读取与同期目标关系投影形成稳定反向引用组。
    L2存在当前场景成员引用读取结果 读取存在当前场景成员引用(
        const L2存在当前场景成员引用读取请求& 请求) const {
        if (!L2存在当前场景成员引用读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成存在成员引用读取失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            if (登记结果.事实截止代次 != 请求.请求头.期望事实代次)
                return L2场景结构内部::形成存在成员引用读取失败(
                    登记结果.事实截止代次 != 0
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    登记结果.事实截止代次);
            const auto 存在读取 = 存在服务_.读取存在身份来源(
                {请求.请求头, L2读取类别::当前, 请求.存在, 0});
            if (存在读取.结果头.合同版本 != L2结构合同版本)
                return L2场景结构内部::形成存在成员引用读取失败(
                    L2结构状态::内部不一致, 存在读取.结果头.事实截止代次);
            if (存在读取.结果头.状态 != L2结构状态::已读取)
                return L2场景结构内部::形成存在成员引用读取失败(
                    存在读取.结果头.状态, 存在读取.结果头.事实截止代次);
            if (存在读取.结果头.事实截止代次 != 请求.请求头.期望事实代次
                || 存在读取.结果头.变更事实代次 || !存在读取.身份来源
                || 存在读取.身份来源->节点稳定编码 != 请求.存在.值
                || 存在读取.身份来源->节点族 != L2节点族::存在
                || !L2节点族身份来源事实完整(*存在读取.身份来源,
                    请求.请求头.期望事实代次))
                return L2场景结构内部::形成存在成员引用读取失败(
                    L2结构状态::内部不一致, 存在读取.结果头.事实截止代次);

            L1所有者范围一致当前读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.节点 = {请求.存在.值};
            L1请求.目标关系组 = {{请求.存在.值,
                登记结果.登记->成员关系类型.值}};
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
            const auto 顶层 = L2场景结构内部::解释S2一致读取顶层(
                读取, 请求.请求头.期望事实代次);
            if (!顶层.成功())
                return L2场景结构内部::形成存在成员引用读取失败(
                    顶层.状态, 顶层.事实截止代次);
            if (读取.节点.size() != 1 || !读取.关系.empty()
                || !读取.值.empty() || !读取.属性值.empty()
                || !读取.源关系组.empty() || 读取.目标关系组.size() != 1)
                return L2场景结构内部::形成存在成员引用读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto* 节点项 = L2场景结构内部::查找唯一节点项(
                读取, 请求.存在.值);
            if (!节点项
                || 节点项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !节点项->事实 || 节点项->事实->退出事实代次)
                return L2场景结构内部::形成存在成员引用读取失败(
                    节点项 && !节点项->事实
                        ? L2场景结构内部::映射场景当前项目状态(节点项->状态)
                        : L2结构状态::内部不一致,
                    顶层.事实截止代次);
            const auto 节点骨架 = L2场景结构内部::形成截止存在节点事实(
                *节点项->事实, 顶层.事实截止代次);
            if (!节点骨架 || 节点骨架->身份 != 请求.存在
                || 节点骨架->生命周期
                    != 存在读取.身份来源->节点生命周期)
                return L2场景结构内部::形成存在成员引用读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto& 关系组 = 读取.目标关系组.front();
            if (关系组.目标节点 != 请求.存在.值
                || 关系组.关系类型节点 != 登记结果.登记->成员关系类型.值)
                return L2场景结构内部::形成存在成员引用读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            L2存在当前场景成员引用读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 顶层.事实截止代次, std::nullopt}, {}};
            std::vector<稳定编码> 场景组;
            std::vector<稳定编码> 关系编码组;
            for (const auto& 成员 : 关系组.成员) {
                if (成员.关系.目标节点 != 请求.存在.值
                    || 成员.关系.源节点 != 成员.对端节点.编码
                    || 成员.对端节点.退出事实代次
                    || !L2场景结构内部::形成截止场景节点骨架(
                        成员.对端节点, 成员.对端节点.写入所有者,
                        顶层.事实截止代次)
                    || std::find(场景组.begin(), 场景组.end(),
                        成员.对端节点.编码) != 场景组.end()
                    || std::find(关系编码组.begin(), 关系编码组.end(),
                        成员.关系.编码) != 关系编码组.end())
                    return L2场景结构内部::形成存在成员引用读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto 场景来源 = L2场景结构内部::检查当前场景来源(
                    L1_, 场景身份来源定位_,
                    L2场景身份{成员.对端节点.编码}, 顶层.事实截止代次);
                if (!场景来源.成功())
                    return L2场景结构内部::形成存在成员引用读取失败(
                        场景来源.直接提交 ? L2结构状态::事实代次漂移
                            : 场景来源.状态,
                        场景来源.事实截止代次);
                const auto 树归属 = 读取场景树归属({
                    {L2结构合同版本, 顶层.事实截止代次},
                    L2读取类别::当前,
                    L2场景身份{成员.对端节点.编码}, 0});
                if (!树归属.成功())
                    return L2场景结构内部::形成存在成员引用读取失败(
                        树归属.结果头.状态, 树归属.结果头.事实截止代次);
                const auto 关系 = L2场景结构内部::形成截止成员关系事实(
                    成员.关系, 场景身份来源定位_.所有者,
                    登记结果.登记->成员关系类型.值,
                    顶层.事实截止代次);
                if (!关系 || 关系->存在 != 请求.存在
                    || 关系->场景.值 != 成员.对端节点.编码
                    || 关系->生命周期.退出事实代次)
                    return L2场景结构内部::形成存在成员引用读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                场景组.push_back(关系->场景.值);
                关系编码组.push_back(关系->关系稳定编码);
                结果.引用.push_back({关系->关系稳定编码, 关系->场景,
                    关系->存在, 关系->顺序, 关系->生命周期});
            }
            std::sort(结果.引用.begin(), 结果.引用.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.顺序 < 右.顺序
                        || (左.顺序 == 右.顺序 && (左.场景.值 < 右.场景.值
                            || (左.场景 == 右.场景
                                && 左.关系稳定编码 < 右.关系稳定编码)));
                });
            return 结果.成功() ? 结果
                : L2场景结构内部::形成存在成员引用读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成存在成员引用读取失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成存在成员引用读取失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成存在成员引用读取失败(
                L2结构状态::内部不一致);
        }
    }

private:
    L2场景宿主结构登记结果 按定位读取当前场景宿主结构登记(
        const L2场景宿主结构登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2场景宿主结构登记完整(定位))
            return L2场景结构内部::形成场景宿主登记失败(
                L2结构状态::内部不一致);
        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        for (std::size_t 尝试 = 0; 尝试 < 2; ++尝试) {
            L1所有者范围一致当前读取请求 请求;
            请求.合同版本 = L1所有者范围一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.所有者 = {场景身份来源定位_.所有者};
            请求.节点 = {定位.关系类型.值};
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
            const auto 顶层 = L2场景结构内部::解释S2一致读取顶层(
                读取, 本轮期望代次);
            if (顶层.状态 == L2结构状态::事实代次漂移 && 尝试 == 0
                && 顶层.事实截止代次 != 0) {
                本轮期望代次 = 顶层.事实截止代次;
                continue;
            }
            if (!顶层.成功())
                return L2场景结构内部::形成场景宿主登记失败(
                    顶层.状态, 顶层.事实截止代次);
            if (读取.所有者.size() != 1 || 读取.节点.size() != 1
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty())
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto& 所有者项 = 读取.所有者.front();
            const auto* 类型项 = L2场景结构内部::查找唯一节点项(
                读取, 定位.关系类型.值);
            if (所有者项.查询所有者 != 场景身份来源定位_.所有者
                || 所有者项.状态
                    != L1所有者范围一致当前读取项目状态::成功
                || !所有者项.所有者事实
                || 所有者项.所有者事实->所有者 != 场景身份来源定位_.所有者
                || 所有者项.所有者事实->范围种类
                    != L1所有者范围种类::独占结构范围
                || 所有者项.所有者事实->退出事实代次
                || !类型项
                || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !类型项->事实)
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto& 节点 = *类型项->事实;
            if (节点.编码 != 定位.关系类型.值
                || 节点.写入所有者 != 场景身份来源定位_.所有者
                || 节点.种类 != 节点种类::普通 || 节点.属性类型表示
                || !节点.当前属性.empty()
                || 节点.创建事实代次 != 定位.建立事实代次
                || 节点.退出事实代次
                || (期望创建代次
                    && 节点.创建事实代次 != *期望创建代次)
                || 所有者项.所有者事实->创建事实代次 > 定位.建立事实代次)
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            auto 当前 = 定位;
            当前.类型生命周期 = {节点.创建事实代次, 节点.退出事实代次};
            当前.事实截止代次 = 顶层.事实截止代次;
            if (!L2场景宿主结构登记完整(当前))
                return L2场景结构内部::形成场景宿主登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            return {{L2结构合同版本, L2结构状态::已读取,
                顶层.事实截止代次, std::nullopt}, std::move(当前)};
        }
        return L2场景结构内部::形成场景宿主登记失败(
            L2结构状态::内部不一致);
    }

    L2场景树结构登记结果 按定位读取当前场景树结构登记(
        const L2场景树结构登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2场景树结构登记完整(定位))
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::内部不一致);
        const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
            return L2场景结构内部::形成场景树登记失败(
                代次.状态 == L1中性读取状态::成功
                    ? L2结构状态::内部不一致
                    : L2场景结构内部::映射事实代次探测失败(代次.状态),
                代次.事实代次);
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 代次.事实代次;
        请求.所有者 = {第一层写入端口_.所有者身份()};
        请求.节点 = {定位.树登记锚点稳定编码,
            定位.根标记关系类型.值, 定位.树归属关系类型.值};
        const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
        const auto 顶层 = L2场景结构内部::解释S2一致读取顶层(
            读取, 代次.事实代次);
        if (!顶层.成功())
            return L2场景结构内部::形成场景树登记失败(
                顶层.状态, 顶层.事实截止代次);
        if (读取.所有者.size() != 1 || 读取.节点.size() != 3
            || !读取.关系.empty() || !读取.值.empty()
            || !读取.属性值.empty() || !读取.源关系组.empty()
            || !读取.目标关系组.empty())
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::内部不一致, 顶层.事实截止代次);
        const auto& 所有者项 = 读取.所有者.front();
        if (所有者项.查询所有者 != 第一层写入端口_.所有者身份()
            || 所有者项.状态
                != L1所有者范围一致当前读取项目状态::成功
            || !所有者项.所有者事实
            || 所有者项.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 所有者项.所有者事实->退出事实代次)
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::内部不一致, 顶层.事实截止代次);
        for (const auto 编码 : 请求.节点) {
            const auto* 项 = L2场景结构内部::查找唯一节点项(读取, 编码);
            if (!项 || 项->状态
                    != L1所有者范围一致当前读取项目状态::成功
                || !项->事实 || 项->事实->编码 != 编码
                || 项->事实->写入所有者
                    != 第一层写入端口_.所有者身份()
                || 项->事实->种类 != 节点种类::普通
                || 项->事实->属性类型表示 || 项->事实->退出事实代次
                || !项->事实->当前属性.empty()
                || 项->事实->创建事实代次
                    != 定位.树登记锚点生命周期.创建事实代次
                || (期望创建代次
                    && 项->事实->创建事实代次 != *期望创建代次))
                return L2场景结构内部::形成场景树登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
        }
        auto 当前 = 定位;
        当前.事实截止代次 = 顶层.事实截止代次;
        当前.树登记锚点生命周期.退出事实代次.reset();
        当前.根标记关系类型生命周期.退出事实代次.reset();
        当前.树归属关系类型生命周期.退出事实代次.reset();
        if (!L2场景树结构登记完整(当前))
            return L2场景结构内部::形成场景树登记失败(
                L2结构状态::内部不一致, 顶层.事实截止代次);
        return {{L2结构合同版本, L2结构状态::已读取,
            顶层.事实截止代次, std::nullopt}, std::move(当前)};
    }

    // 诊断责任：向上送出；许可、漂移、资源失败和节点矛盾均结构化返回。
    L2场景关系类型登记结果 按定位读取当前场景关系类型登记(
        const L2场景关系类型登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2场景关系类型登记完整(定位)) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::内部不一致);
        }

        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试序号 = 0; 尝试序号 < 最大尝试次数; ++尝试序号) {
            L1所有者范围一致当前读取请求 请求;
            请求.合同版本 = L1所有者范围一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.节点 = {定位.父子关系类型.值, 定位.成员关系类型.值};
            请求.关系 = {};
            请求.值 = {};
            请求.属性值 = {};
            请求.源关系组 = {};
            请求.目标关系组 = {};

            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
            if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移) {
                if (!L2场景结构内部::场景关系类型一致读取失败形状完整(
                    读取, 本轮期望代次)) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致);
                }
                if (尝试序号 == 0) {
                    本轮期望代次 = 读取.读取事实代次;
                    continue;
                }
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::事实代次漂移,
                    读取.读取事实代次);
            }
            if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
                if (!L2场景结构内部::场景关系类型一致读取失败形状完整(
                    读取, 本轮期望代次)) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致);
                }
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景结构内部::映射场景关系类型登记读取失败状态(
                        读取.状态));
            }
            if (读取.合同版本 != L1所有者范围一致当前读取合同版本
                || 读取.期望事实代次 != 本轮期望代次
                || 读取.读取事实代次 != 本轮期望代次
                || 读取.读取事实代次 == 0 || 读取.节点.size() != 2
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty()) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            const auto& 父子项 = 读取.节点[0];
            const auto& 成员项 = 读取.节点[1];
            if (父子项.查询编码 != 定位.父子关系类型.值
                || 成员项.查询编码 != 定位.成员关系类型.值
                || 父子项.状态 != L1所有者范围一致当前读取项目状态::成功
                || 成员项.状态 != L1所有者范围一致当前读取项目状态::成功
                || !父子项.事实 || !成员项.事实) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            const auto& 父子事实 = *父子项.事实;
            const auto& 成员事实 = *成员项.事实;
            if (父子事实.编码 != 定位.父子关系类型.值
                || 成员事实.编码 != 定位.成员关系类型.值
                || 父子事实.种类 != 节点种类::普通
                || 成员事实.种类 != 节点种类::普通
                || 父子事实.属性类型表示 || 成员事实.属性类型表示
                || 父子事实.创建事实代次 != 定位.建立事实代次
                || 成员事实.创建事实代次 != 定位.建立事实代次
                || 父子事实.退出事实代次 || 成员事实.退出事实代次
                || !父子事实.当前属性.empty() || !成员事实.当前属性.empty()
                || (期望创建代次
                    && (父子事实.创建事实代次 != *期望创建代次
                        || 成员事实.创建事实代次 != *期望创建代次))) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            auto 当前登记 = 定位;
            当前登记.事实截止代次 = 读取.读取事实代次;
            if (!L2场景关系类型登记完整(当前登记)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            return {L2场景关系类型登记状态::已读取,
                当前登记.事实截止代次, std::move(当前登记)};
        }
        return L2场景结构内部::形成场景关系类型登记失败(
            L2场景关系类型登记状态::内部不一致);
    }

    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务,
        L2场景所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument(
                "L2 scene owner delivery is invalid or cross-instance");
        return std::move(交付.写入端口_);
    }

    const L1事实基座服务& L1_;
    const L2存在结构服务& 存在服务_;
    L1所有者范围写端口 第一层写入端口_;
    const L2场景结构内部::场景身份来源定位 场景身份来源定位_;
    mutable std::mutex 身份来源锁_;
    mutable std::mutex 关系类型登记锁_;
    std::optional<L2场景关系类型登记> 关系类型登记定位_;
    mutable std::mutex 属性类型登记锁_;
    std::optional<L2场景属性类型登记> 属性类型登记定位_;
    mutable std::mutex 场景树结构登记锁_;
    mutable std::mutex 场景业务写入锁_;
    std::optional<L2场景树结构登记> 场景树结构定位_;
    mutable std::mutex 宿主结构登记锁_;
    std::optional<L2场景宿主结构登记> 宿主结构登记定位_;
};

} // namespace 海中鱼巣
