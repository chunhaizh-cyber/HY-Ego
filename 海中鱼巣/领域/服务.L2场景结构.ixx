module;

#include <cstdint>
#include <cstddef>
#include <algorithm>
#include <limits>
#include <mutex>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

#define L2_SCENE_STRUCTURE_NO_INCLUDES

export module 海中鱼巣.领域.服务.L2场景结构;

export import 海中鱼巣.领域.合同.L2结构公共;
import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.L2存在结构;

export {
#include "L2场景结构.数据.h"
}

namespace 海中鱼巣::L2场景结构内部 {

inline constexpr std::uint32_t 场景节点本地键值 = 0x0201'0001U;
inline constexpr std::uint64_t 场景关系类型登记幂等域 = 0x1DULL;
inline constexpr std::uint32_t 场景父子关系类型本地键值 = 0x0201'0101U;
inline constexpr std::uint32_t 场景成员关系类型本地键值 = 0x0201'0102U;
inline constexpr std::uint32_t 场景父子关系本地键值 = 0x0201'0201U;
inline constexpr std::uint32_t 场景成员关系本地键值 = 0x0201'0202U;

// 诊断责任：无适用错误分支；固定私有域纯值映射不读取事实。
L1中性写集幂等键 映射场景关系类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(场景关系类型登记幂等域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2场景关系类型登记状态 映射场景关系类型登记写入状态(
    L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功:
        return L2场景关系类型登记状态::已提交;
    case L1中性写入状态::精确重复:
        return L2场景关系类型登记状态::精确重复;
    case L1中性写入状态::入口拒绝:
        return L2场景关系类型登记状态::入口拒绝;
    case L1中性写入状态::事实代次漂移:
        return L2场景关系类型登记状态::事实代次漂移;
    case L1中性写入状态::幂等冲突:
        return L2场景关系类型登记状态::幂等冲突;
    case L1中性写入状态::资源失败:
        return L2场景关系类型登记状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return L2场景关系类型登记状态::内部不一致;
    }
    return L2场景关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值状态映射保留一致读取失败类别。
L2场景关系类型登记状态 映射场景关系类型登记读取失败状态(
    L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::入口拒绝:
        return L2场景关系类型登记状态::入口拒绝;
    case L1中性一致当前读取状态::许可拒绝:
        return L2场景关系类型登记状态::许可拒绝;
    case L1中性一致当前读取状态::事实代次漂移:
        return L2场景关系类型登记状态::事实代次漂移;
    case L1中性一致当前读取状态::资源失败:
        return L2场景关系类型登记状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::内部不一致:
        return L2场景关系类型登记状态::内部不一致;
    }
    return L2场景关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对一致读取失败的空载荷和代次边界。
bool 场景关系类型一致读取失败形状完整(
    const L1中性一致当前读取结果& 结果,
    std::uint64_t 期望代次) noexcept {
    if (结果.状态 == L1中性一致当前读取状态::成功
        || 结果.合同版本 != L1中性一致当前读取合同版本
        || 结果.期望事实代次 != 期望代次
        || !结果.节点.empty() || !结果.关系.empty()
        || !结果.值.empty() || !结果.属性值.empty()
        || !结果.源关系组.empty() || !结果.目标关系组.empty()) {
        return false;
    }
    return 结果.状态 == L1中性一致当前读取状态::事实代次漂移
        ? 结果.读取事实代次 != 0 && 结果.读取事实代次 != 期望代次
        : 结果.读取事实代次 == 0;
}

// 诊断责任：无适用错误分支；未找到或重复映射均返回空值。
std::optional<稳定编码> 查找场景关系类型编码映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键.值 != 本地键值) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只检查两项映射的键和值分别唯一。
bool 场景关系类型编码映射唯一(const L1中性写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 2) return false;
    for (std::size_t 左 = 0; 左 < 结果.新编码映射.size(); ++左) {
        if (!有效(结果.新编码映射[左].first)
            || !有效(结果.新编码映射[左].second)) return false;
        for (std::size_t 右 = 左 + 1; 右 < 结果.新编码映射.size(); ++右) {
            if (结果.新编码映射[左].first == 结果.新编码映射[右].first
                || 结果.新编码映射[左].second == 结果.新编码映射[右].second)
                return false;
        }
    }
    return true;
}

// 诊断责任：无适用错误分支；只形成无登记载荷的结构化失败。
L2场景关系类型登记结果 形成场景关系类型登记失败(
    L2场景关系类型登记状态 状态,
    std::uint64_t 事实截止代次 = 0) noexcept {
    return {状态, 事实截止代次, std::nullopt};
}

// 诊断责任：无适用错误分支；完整 64 位纯值映射不读取事实。
L1中性写集幂等键 映射场景幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2结构状态 映射场景写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return L2结构状态::已提交;
    case L1中性写入状态::精确重复: return L2结构状态::精确重复;
    case L1中性写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1中性写入状态::资源失败: return L2结构状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部一致读取状态。
L2结构状态 映射场景一致读取失败状态(
    L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1中性一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1中性一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部读取项目状态。
L2结构状态 映射场景当前项目状态(
    L1中性一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1中性一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1中性一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1中性一致当前读取项目状态::属性未设置:
    case L1中性一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；缺项、失败项及成功空载荷在调用侧统一分账。
template<class 读取结果项类型>
L2结构状态 映射场景当前失败项目(const 读取结果项类型* 项) noexcept {
    if (!项) return L2结构状态::未找到;
    const auto 状态 = 映射场景当前项目状态(项->状态);
    return 状态 == L2结构状态::已读取 ? L2结构状态::内部不一致 : 状态;
}

// 诊断责任：无适用错误分支；多端点失败优先保留内部矛盾，其次已退出和未找到。
L2结构状态 合并场景端点失败状态(
    L2结构状态 当前, L2结构状态 新状态) noexcept {
    if (当前 == L2结构状态::内部不一致
        || 新状态 == L2结构状态::内部不一致)
        return L2结构状态::内部不一致;
    if (当前 == L2结构状态::已退出 || 新状态 == L2结构状态::已退出)
        return L2结构状态::已退出;
    return 当前 == L2结构状态::未找到 || 新状态 == L2结构状态::未找到
        ? L2结构状态::未找到 : L2结构状态::已读取;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部历史读取状态。
L2结构状态 映射场景历史读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::成功: return L2结构状态::已读取;
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::未找到: return L2结构状态::未找到;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对唯一场景本地键映射。
std::optional<稳定编码> 查找唯一场景编码映射(
    const L1中性写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    if (本地键.值 != 场景节点本地键值 || !有效(编码)) return std::nullopt;
    return 编码;
}

// 诊断责任：无适用错误分支；只把完整 L1 普通节点映射为 S1 值式事实。
std::optional<L2场景事实> 形成S1场景事实(
    const L1中性节点事实& 节点, std::uint64_t 事实截止代次) noexcept {
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 事实截止代次 || !节点.当前属性.empty()
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 事实截止代次))) {
        return std::nullopt;
    }
    L2场景事实 场景;
    场景.身份 = L2场景身份{节点.编码};
    场景.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    if (!L2场景S1事实完整(场景)) return std::nullopt;
    return 场景;
}

// 诊断责任：无适用错误分支；只形成无载荷的结构化读取失败。
L2场景节点读取结果 形成读取失败(L2结构状态 状态,
    std::uint64_t 事实截止代次 = 0) noexcept {
    return {{L2结构合同版本, 状态, 事实截止代次, std::nullopt}, std::nullopt};
}

// 诊断责任：向上送出；公开 L1 一致读取的失败与事实矛盾均结构化返回。
L2场景节点读取结果 读取当前场景节点(
    const L1事实基座服务& L1, const L2场景节点读取请求& 请求) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);

    if (读取.状态 != L1中性一致当前读取状态::成功) {
        const bool 形状完整 = 读取.合同版本 == L1中性一致当前读取合同版本
            && 读取.期望事实代次 == 请求.请求头.期望事实代次
            && 读取.节点.empty() && 读取.关系.empty() && 读取.值.empty()
            && 读取.属性值.empty() && 读取.源关系组.empty()
            && 读取.目标关系组.empty()
            && (读取.状态 == L1中性一致当前读取状态::事实代次漂移
                ? 读取.读取事实代次 != 0
                    && 读取.读取事实代次 != 请求.请求头.期望事实代次
                : 读取.读取事实代次 == 0);
        if (!形状完整) return 形成读取失败(L2结构状态::内部不一致);
        return 形成读取失败(映射场景一致读取失败状态(读取.状态),
            读取.读取事实代次);
    }

    if (读取.合同版本 != L1中性一致当前读取合同版本
        || 读取.期望事实代次 != 请求.请求头.期望事实代次
        || 读取.读取事实代次 != 请求.请求头.期望事实代次
        || 读取.读取事实代次 == 0 || 读取.节点.size() != 1
        || !读取.关系.empty() || !读取.值.empty() || !读取.属性值.empty()
        || !读取.源关系组.empty() || !读取.目标关系组.empty()) {
        return 形成读取失败(L2结构状态::内部不一致);
    }

    const auto& 项 = 读取.节点.front();
    if (项.查询编码 != 请求.场景.值) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    if (项.状态 != L1中性一致当前读取项目状态::成功) {
        if (项.事实) return 形成读取失败(L2结构状态::内部不一致,
            读取.读取事实代次);
        return 形成读取失败(映射场景当前项目状态(项.状态),
            读取.读取事实代次);
    }
    if (!项.事实 || 项.事实->退出事实代次) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    auto 场景 = 形成S1场景事实(*项.事实, 读取.读取事实代次);
    if (!场景 || 场景->身份 != 请求.场景) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    return {{L2结构合同版本, L2结构状态::已读取,
        读取.读取事实代次, std::nullopt}, std::move(场景)};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖事实代次探测失败。
L2结构状态 映射事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：向上送出；前后代次探测、历史读取与事实矛盾均结构化返回。
L2场景节点读取结果 读取历史场景节点(
    const L1事实基座服务& L1, const L2场景节点读取请求& 请求) {
    const L1中性事实代次读取请求 代次请求{L1中性CRUD合同版本};
    const auto 前代次 = L1.读取中性当前事实代次(代次请求);
    if (前代次.状态 != L1中性读取状态::成功
        || 前代次.合同版本 != L1中性CRUD合同版本) {
        return 形成读取失败(前代次.合同版本 == L1中性CRUD合同版本
            ? 映射事实代次探测失败(前代次.状态)
            : L2结构状态::内部不一致);
    }
    if (前代次.事实代次 != 请求.请求头.期望事实代次) {
        return 形成读取失败(L2结构状态::事实代次漂移, 前代次.事实代次);
    }

    const auto 历史 = L1.读取中性历史事实(
        {L1中性CRUD合同版本, 请求.场景.值});
    const auto 后代次 = L1.读取中性当前事实代次(代次请求);
    if (后代次.状态 != L1中性读取状态::成功
        || 后代次.合同版本 != L1中性CRUD合同版本) {
        return 形成读取失败(后代次.合同版本 == L1中性CRUD合同版本
            ? 映射事实代次探测失败(后代次.状态)
            : L2结构状态::内部不一致);
    }
    if (后代次.事实代次 != 请求.请求头.期望事实代次
        || 后代次.事实代次 != 前代次.事实代次) {
        return 形成读取失败(L2结构状态::事实代次漂移, 后代次.事实代次);
    }

    if (历史.合同版本 != L1中性CRUD合同版本
        || 历史.查询编码 != 请求.场景.值) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    if (历史.状态 != L1中性读取状态::成功) {
        if (历史.事实) return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
        return 形成读取失败(映射场景历史读取状态(历史.状态),
            请求.请求头.期望事实代次);
    }
    const auto* 节点 = 历史.事实
        ? std::get_if<L1中性节点事实>(&*历史.事实) : nullptr;
    if (!节点 || 历史.读取事实代次 == 0
        || 历史.读取事实代次
            != 节点->退出事实代次.value_or(节点->创建事实代次)) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    auto 场景 = 形成S1场景事实(*节点, 请求.请求头.期望事实代次);
    if (!场景 || 场景->身份 != 请求.场景) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.请求头.期望事实代次, std::nullopt}, std::move(场景)};
}

struct 场景S2预检结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 直接提交 = false;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

// 诊断责任：无适用错误分支；只形成父子写入空载荷失败。
L2场景父子关系写入结果 形成父子写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成成员写入空载荷失败。
L2场景成员关系写入结果 形成成员写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成完整读取空载荷失败并回显读取类别。
L2场景完整读取结果 形成完整读取失败(
    const L2场景完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖 S2 写入所需全部状态。
L2结构状态 映射场景S2写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return L2结构状态::已提交;
    case L1中性写入状态::精确重复: return L2结构状态::精确重复;
    case L1中性写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性写入状态::未找到: return L2结构状态::未找到;
    case L1中性写入状态::已退出: return L2结构状态::已退出;
    case L1中性写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1中性写入状态::资源失败: return L2结构状态::资源失败;
    case L1中性写入状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；登记读取状态只映射为 S2 结构状态。
L2结构状态 映射登记读取状态(L2场景关系类型登记状态 状态) noexcept {
    switch (状态) {
    case L2场景关系类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2场景关系类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2场景关系类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2场景关系类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2场景关系类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2场景关系类型登记状态::已提交:
    case L2场景关系类型登记状态::精确重复:
    case L2场景关系类型登记状态::已读取:
    case L2场景关系类型登记状态::登记未加载:
    case L2场景关系类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；历史关系组状态只映射为 S2 结构状态。
L2结构状态 映射历史关系组失败状态(
    L1中性历史关系组读取状态 状态) noexcept {
    switch (状态) {
    case L1中性历史关系组读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性历史关系组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1中性历史关系组读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性历史关系组读取状态::成功:
    case L1中性历史关系组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；核对一致投影顶层形状并分出漂移直提路径。
场景S2预检结果 解释S2一致读取顶层(
    const L1中性一致当前读取结果& 读取, std::uint64_t 期望代次) noexcept {
    if (读取.状态 == L1中性一致当前读取状态::成功) {
        if (读取.合同版本 == L1中性一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次 && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1中性一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1中性一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1中性一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移, 读取.读取事实代次, true};
    return {映射场景一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；把节点生命周期投影到具名截止后形成场景节点。
std::optional<L2场景事实> 形成截止场景节点事实(
    L1中性节点事实 节点, std::uint64_t 截止) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    return 形成S1场景事实(节点, 截止);
}

// 诊断责任：无适用错误分支；把节点生命周期投影到具名截止后形成存在节点。
std::optional<L2存在事实> 形成截止存在节点事实(
    L1中性节点事实 节点, std::uint64_t 截止) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止 || !节点.当前属性.empty()
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 截止))) return std::nullopt;
    L2存在事实 存在{L2存在身份{节点.编码},
        {节点.创建事实代次, 节点.退出事实代次}, {}};
    return L2存在E1事实完整(存在)
        ? std::optional<L2存在事实>{std::move(存在)} : std::nullopt;
}

// 诊断责任：无适用错误分支；只判断关系是否命中半开历史区间。
bool 关系在截止有效(const L1中性关系事实& 关系,
    std::uint64_t 截止) noexcept {
    return 截止 != 0 && 关系.创建事实代次 != 0
        && 关系.创建事实代次 <= 截止
        && (!关系.退出事实代次 || 截止 < *关系.退出事实代次);
}

// 诊断责任：无适用错误分支；把 L1 父子关系投影为具名截止的 L2 值式事实。
std::optional<L2场景父子关系事实> 形成截止父子关系事实(
    const L1中性关系事实& 关系, 稳定编码 类型,
    std::uint64_t 截止) noexcept {
    if (!有效(关系.编码) || 关系.关系类型节点 != 类型
        || !有效(关系.源节点) || !有效(关系.目标节点)
        || 关系.源节点 == 关系.目标节点 || 关系.角色或顺序 <= 0
        || 关系.创建事实代次 == 0 || 关系.创建事实代次 > 截止
        || (关系.退出事实代次
            && *关系.退出事实代次 < 关系.创建事实代次)) return std::nullopt;
    auto 退出 = 关系.退出事实代次;
    if (退出 && *退出 > 截止) 退出.reset();
    L2场景父子关系事实 结果{关系.编码, L2场景身份{关系.源节点},
        L2场景身份{关系.目标节点},
        static_cast<std::uint64_t>(关系.角色或顺序),
        {关系.创建事实代次, 退出}};
    return L2场景父子关系事实截止投影完整(结果, 截止)
        ? std::optional<L2场景父子关系事实>{std::move(结果)} : std::nullopt;
}

// 诊断责任：无适用错误分支；把 L1 成员关系投影为具名截止的 L2 值式事实。
std::optional<L2场景成员关系事实> 形成截止成员关系事实(
    const L1中性关系事实& 关系, 稳定编码 类型,
    std::uint64_t 截止) noexcept {
    if (!有效(关系.编码) || 关系.关系类型节点 != 类型
        || !有效(关系.源节点) || !有效(关系.目标节点)
        || 关系.角色或顺序 <= 0 || 关系.创建事实代次 == 0
        || 关系.创建事实代次 > 截止
        || (关系.退出事实代次
            && *关系.退出事实代次 < 关系.创建事实代次)) return std::nullopt;
    auto 退出 = 关系.退出事实代次;
    if (退出 && *退出 > 截止) 退出.reset();
    L2场景成员关系事实 结果{关系.编码, L2场景身份{关系.源节点},
        L2存在身份{关系.目标节点},
        static_cast<std::uint64_t>(关系.角色或顺序),
        {关系.创建事实代次, 退出}};
    return L2场景成员关系事实截止投影完整(结果, 截止)
        ? std::optional<L2场景成员关系事实>{std::move(结果)} : std::nullopt;
}

// 诊断责任：无适用错误分支；只核对 S2 新关系本地键唯一映射。
std::optional<稳定编码> 查找唯一S2关系编码映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键值) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    return 本地键.值 == 本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

struct 父子关系读回规格 final {
    稳定编码 关系;
    L2场景身份 父场景;
    L2场景身份 子场景;
    std::uint64_t 顺序 = 0;
};

struct 成员关系读回规格 final {
    稳定编码 关系;
    L2场景身份 场景;
    L2存在身份 存在;
    std::uint64_t 顺序 = 0;
};

// 诊断责任：向上送出；提交、映射和历史读回矛盾均结构化返回。
L2场景父子关系写入结果 提交并读回父子写集(
    L1事实基座服务& L1, const L1中性写集请求& 写集,
    稳定编码 父子类型, std::optional<父子关系读回规格> 新关系,
    std::optional<父子关系读回规格> 旧关系) {
    const auto 写入 = L1.提交中性写集(写集);
    if (写入.合同版本 != L1中性CRUD合同版本
        || 写入.幂等键 != 写集.幂等键)
        return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射场景S2写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成父子写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整))
        return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);

    if (新关系) {
        const auto 编码 = 查找唯一S2关系编码映射(
            写入, 场景父子关系本地键值);
        if (!编码) return 形成父子写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新关系->关系 = *编码;
    } else if (!写入.新编码映射.empty()) {
        return 形成父子写入失败(L2结构状态::内部不一致, 写入.事实代次);
    }

    L2场景父子关系写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::nullopt, std::nullopt};
    const auto 读取一项 = [&](const 父子关系读回规格& 规格,
        bool 应已退出) -> std::optional<L2场景父子关系事实> {
        const auto 读取 = L1.读取中性历史事实(
            {L1中性CRUD合同版本, 规格.关系});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1中性关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1中性读取状态::成功
            || 读取.合同版本 != L1中性CRUD合同版本
            || 读取.查询编码 != 规格.关系 || !关系
            || 关系->编码 != 规格.关系) return std::nullopt;
        auto 投影 = 形成截止父子关系事实(*关系, 父子类型, 写入.事实代次);
        if (!投影 || 投影->父场景 != 规格.父场景
            || 投影->子场景 != 规格.子场景 || 投影->顺序 != 规格.顺序)
            return std::nullopt;
        if (应已退出) {
            if (关系->退出事实代次 != 写入.事实代次
                || 投影->生命周期.退出事实代次 != 写入.事实代次)
                return std::nullopt;
        } else if (关系->创建事实代次 != 写入.事实代次
            || 投影->生命周期.退出事实代次) return std::nullopt;
        return 投影;
    };
    if (新关系) {
        结果.当前关系 = 读取一项(*新关系, false);
        if (!结果.当前关系) return 形成父子写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    if (旧关系) {
        结果.已退出关系 = 读取一项(*旧关系, true);
        if (!结果.已退出关系) return 形成父子写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成父子写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；提交、映射和历史读回矛盾均结构化返回。
L2场景成员关系写入结果 提交并读回成员写集(
    L1事实基座服务& L1, const L1中性写集请求& 写集,
    稳定编码 成员类型, std::optional<成员关系读回规格> 新关系,
    std::optional<成员关系读回规格> 旧关系) {
    const auto 写入 = L1.提交中性写集(写集);
    if (写入.合同版本 != L1中性CRUD合同版本
        || 写入.幂等键 != 写集.幂等键)
        return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射场景S2写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成成员写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整))
        return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);

    if (新关系) {
        const auto 编码 = 查找唯一S2关系编码映射(
            写入, 场景成员关系本地键值);
        if (!编码) return 形成成员写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新关系->关系 = *编码;
    } else if (!写入.新编码映射.empty()) {
        return 形成成员写入失败(L2结构状态::内部不一致, 写入.事实代次);
    }

    L2场景成员关系写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::nullopt, std::nullopt};
    const auto 读取一项 = [&](const 成员关系读回规格& 规格,
        bool 应已退出) -> std::optional<L2场景成员关系事实> {
        const auto 读取 = L1.读取中性历史事实(
            {L1中性CRUD合同版本, 规格.关系});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1中性关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1中性读取状态::成功
            || 读取.合同版本 != L1中性CRUD合同版本
            || 读取.查询编码 != 规格.关系 || !关系
            || 关系->编码 != 规格.关系) return std::nullopt;
        auto 投影 = 形成截止成员关系事实(*关系, 成员类型, 写入.事实代次);
        if (!投影 || 投影->场景 != 规格.场景
            || 投影->存在 != 规格.存在 || 投影->顺序 != 规格.顺序)
            return std::nullopt;
        if (应已退出) {
            if (关系->退出事实代次 != 写入.事实代次
                || 投影->生命周期.退出事实代次 != 写入.事实代次)
                return std::nullopt;
        } else if (关系->创建事实代次 != 写入.事实代次
            || 投影->生命周期.退出事实代次) return std::nullopt;
        return 投影;
    };
    if (新关系) {
        结果.当前关系 = 读取一项(*新关系, false);
        if (!结果.当前关系) return 形成成员写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    if (旧关系) {
        结果.已退出关系 = 读取一项(*旧关系, true);
        if (!结果.已退出关系) return 形成成员写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成成员写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；当前代次失败或漂移均形成结构化预检结果。
场景S2预检结果 检查S2当前代次(
    const L1事实基座服务& L1, std::uint64_t 期望代次) {
    const auto 读取 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (读取.合同版本 != L1中性CRUD合同版本)
        return {L2结构状态::内部不一致, 读取.事实代次, false};
    if (读取.状态 != L1中性读取状态::成功)
        return {映射事实代次探测失败(读取.状态), 读取.事实代次, false};
    if (读取.事实代次 == 0)
        return {L2结构状态::内部不一致, 0, false};
    if (读取.事实代次 != 期望代次)
        return {L2结构状态::事实代次漂移, 读取.事实代次, true};
    return {L2结构状态::已读取, 读取.事实代次, false};
}

// 诊断责任：无适用错误分支；按查询编码查找唯一节点结果项。
const L1中性一致节点读取结果项* 查找唯一节点项(
    const L1中性一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1中性一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；按查询编码查找唯一关系结果项。
const L1中性一致关系读取结果项* 查找唯一关系项(
    const L1中性一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1中性一致关系读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.关系) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只核对当前普通场景节点结果项。
bool 当前场景节点项完整(const L1中性一致节点读取结果项* 项,
    稳定编码 编码, std::uint64_t 截止) noexcept {
    if (!项 || 项->查询编码 != 编码
        || 项->状态 != L1中性一致当前读取项目状态::成功
        || !项->事实 || 项->事实->退出事实代次) return false;
    const auto 场景 = 形成截止场景节点事实(*项->事实, 截止);
    return 场景 && 场景->身份.值 == 编码;
}

// 诊断责任：无适用错误分支；只核对当前父子关系逐字段形状。
bool 当前父子关系完整(const L1中性关系事实& 关系,
    稳定编码 类型, L2场景身份 父场景, L2场景身份 子场景,
    std::uint64_t 顺序, std::uint64_t 截止) noexcept {
    const auto 投影 = 形成截止父子关系事实(关系, 类型, 截止);
    return 投影 && !关系.退出事实代次
        && 投影->父场景 == 父场景 && 投影->子场景 == 子场景
        && 投影->顺序 == 顺序 && !投影->生命周期.退出事实代次;
}

// 诊断责任：无适用错误分支；只核对当前成员关系逐字段形状。
bool 当前成员关系完整(const L1中性关系事实& 关系,
    稳定编码 类型, L2场景身份 场景, L2存在身份 存在,
    std::uint64_t 顺序, std::uint64_t 截止) noexcept {
    const auto 投影 = 形成截止成员关系事实(关系, 类型, 截止);
    return 投影 && !关系.退出事实代次
        && 投影->场景 == 场景 && 投影->存在 == 存在
        && 投影->顺序 == 顺序 && !投影->生命周期.退出事实代次;
}

// 诊断责任：向上送出；沿父子源关系组遍历后继并拒绝新父进入闭包。
场景S2预检结果 检查父子无环(
    const L1事实基座服务& L1, L2场景身份 子场景,
    L2场景身份 新父场景, 稳定编码 父子类型, std::uint64_t 截止) {
    std::vector<稳定编码> 已访问{子场景.值};
    for (std::size_t 当前索引 = 0; 当前索引 < 已访问.size(); ++当前索引) {
        L1中性一致当前读取请求 请求;
        请求.合同版本 = L1中性一致当前读取合同版本;
        请求.期望事实代次 = 截止;
        请求.源关系组 = {{已访问[当前索引], 父子类型}};
        const auto 读取 = L1.尝试读取中性一致当前投影(请求);
        const auto 顶层 = 解释S2一致读取顶层(读取, 截止);
        if (!顶层.成功()) return 顶层;
        if (!读取.节点.empty() || !读取.关系.empty() || !读取.值.empty()
            || !读取.属性值.empty() || !读取.目标关系组.empty()
            || 读取.源关系组.size() != 1) {
            return {L2结构状态::内部不一致, 截止, false};
        }
        const auto& 关系组 = 读取.源关系组.front();
        if (关系组.源节点 != 已访问[当前索引]
            || 关系组.关系类型节点 != 父子类型)
            return {L2结构状态::内部不一致, 截止, false};
        for (const auto& 成员 : 关系组.成员) {
            if (!当前父子关系完整(成员.关系, 父子类型,
                    L2场景身份{已访问[当前索引]},
                    L2场景身份{成员.对端节点.编码},
                    static_cast<std::uint64_t>(成员.关系.角色或顺序), 截止)
                || 成员.关系.目标节点 != 成员.对端节点.编码
                || !形成截止场景节点事实(成员.对端节点, 截止)
                || 成员.对端节点.退出事实代次) {
                return {L2结构状态::内部不一致, 截止, false};
            }
            if (成员.对端节点.编码 == 新父场景.值)
                return {L2结构状态::引用冲突, 截止, false};
            if (std::find(已访问.begin(), 已访问.end(),
                    成员.对端节点.编码) != 已访问.end())
                return {L2结构状态::内部不一致, 截止, false};
            已访问.push_back(成员.对端节点.编码);
        }
    }
    return {L2结构状态::已读取, 截止, false};
}

// 诊断责任：向上送出；父子新增端点、单父与无环预检均结构化返回。
场景S2预检结果 检查父子新增前置(
    const L1事实基座服务& L1, const L2场景父子关系新增请求& 请求,
    const L2场景关系类型登记& 登记) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.父场景.值, 请求.子场景.值};
    L1请求.目标关系组 = {{请求.子场景.值, 登记.父子关系类型.值}};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 2 || !读取.关系.empty() || !读取.值.empty()
        || !读取.属性值.empty() || !读取.源关系组.empty()
        || 读取.目标关系组.size() != 1)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 父项 = 查找唯一节点项(读取, 请求.父场景.值);
    const auto* 子项 = 查找唯一节点项(读取, 请求.子场景.值);
    L2结构状态 端点状态 = L2结构状态::已读取;
    if (!当前场景节点项完整(父项, 请求.父场景.值, 顶层.事实截止代次))
        端点状态 = 合并场景端点失败状态(端点状态,
            映射场景当前失败项目(父项));
    if (!当前场景节点项完整(子项, 请求.子场景.值, 顶层.事实截止代次))
        端点状态 = 合并场景端点失败状态(端点状态,
            映射场景当前失败项目(子项));
    if (端点状态 != L2结构状态::已读取)
        return {端点状态, 顶层.事实截止代次, false};
    const auto& 组 = 读取.目标关系组.front();
    if (组.目标节点 != 请求.子场景.值
        || 组.关系类型节点 != 登记.父子关系类型.值)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    if (!组.成员.empty())
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return 检查父子无环(L1, 请求.子场景, 请求.父场景,
        登记.父子关系类型.值, 顶层.事实截止代次);
}

// 诊断责任：无适用错误分支；向唯一向量追加不重复编码。
void 追加唯一编码(std::vector<稳定编码>& 编码组, 稳定编码 编码) {
    if (std::find(编码组.begin(), 编码组.end(), 编码) == 编码组.end())
        编码组.push_back(编码);
}

// 诊断责任：向上送出；父子替换旧关系、唯一父与无环预检均结构化返回。
场景S2预检结果 检查父子替换前置(
    const L1事实基座服务& L1, const L2场景父子关系替换请求& 请求,
    const L2场景关系类型登记& 登记) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    追加唯一编码(L1请求.节点, 请求.旧父场景.值);
    追加唯一编码(L1请求.节点, 请求.新父场景.值);
    追加唯一编码(L1请求.节点, 请求.子场景.值);
    L1请求.关系 = {请求.旧关系稳定编码};
    L1请求.目标关系组 = {{请求.子场景.值, 登记.父子关系类型.值}};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != L1请求.节点.size() || 读取.关系.size() != 1
        || !读取.值.empty() || !读取.属性值.empty()
        || !读取.源关系组.empty() || 读取.目标关系组.size() != 1)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    L2结构状态 端点状态 = L2结构状态::已读取;
    for (const auto 编码 : L1请求.节点) {
        const auto* 项 = 查找唯一节点项(读取, 编码);
        if (!当前场景节点项完整(项, 编码, 顶层.事实截止代次))
            端点状态 = 合并场景端点失败状态(端点状态,
                映射场景当前失败项目(项));
    }
    if (端点状态 != L2结构状态::已读取)
        return {端点状态, 顶层.事实截止代次, false};
    const auto* 关系项 = 查找唯一关系项(读取, 请求.旧关系稳定编码);
    if (!关系项 || 关系项->状态 != L1中性一致当前读取项目状态::成功
        || !关系项->事实)
        return {映射场景当前失败项目(关系项),
            顶层.事实截止代次, false};
    if (!当前父子关系完整(*关系项->事实, 登记.父子关系类型.值,
            请求.旧父场景, 请求.子场景, 请求.旧顺序, 顶层.事实截止代次))
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    const auto& 组 = 读取.目标关系组.front();
    if (组.目标节点 != 请求.子场景.值
        || 组.关系类型节点 != 登记.父子关系类型.值
        || 组.成员.size() != 1
        || 组.成员.front().关系.编码 != 请求.旧关系稳定编码
        || 组.成员.front().对端节点.编码 != 请求.旧父场景.值)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return 检查父子无环(L1, 请求.子场景, 请求.新父场景,
        登记.父子关系类型.值, 顶层.事实截止代次);
}

// 诊断责任：向上送出；父子退出具名关系与唯一父预检均结构化返回。
场景S2预检结果 检查父子退出前置(
    const L1事实基座服务& L1, const L2场景父子关系退出请求& 请求,
    const L2场景关系类型登记& 登记) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.父场景.值, 请求.子场景.值};
    L1请求.关系 = {请求.关系稳定编码};
    L1请求.目标关系组 = {{请求.子场景.值, 登记.父子关系类型.值}};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 2 || 读取.关系.size() != 1
        || !读取.值.empty() || !读取.属性值.empty()
        || !读取.源关系组.empty() || 读取.目标关系组.size() != 1)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    L2结构状态 端点状态 = L2结构状态::已读取;
    for (const auto 编码 : L1请求.节点) {
        const auto* 项 = 查找唯一节点项(读取, 编码);
        if (!当前场景节点项完整(项, 编码, 顶层.事实截止代次))
            端点状态 = 合并场景端点失败状态(端点状态,
                映射场景当前失败项目(项));
    }
    if (端点状态 != L2结构状态::已读取)
        return {端点状态, 顶层.事实截止代次, false};
    const auto* 关系项 = 查找唯一关系项(读取, 请求.关系稳定编码);
    if (!关系项 || 关系项->状态 != L1中性一致当前读取项目状态::成功
        || !关系项->事实)
        return {映射场景当前失败项目(关系项),
            顶层.事实截止代次, false};
    if (!当前父子关系完整(*关系项->事实, 登记.父子关系类型.值,
            请求.父场景, 请求.子场景, 请求.顺序, 顶层.事实截止代次))
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    const auto& 组 = 读取.目标关系组.front();
    if (组.目标节点 != 请求.子场景.值
        || 组.关系类型节点 != 登记.父子关系类型.值
        || 组.成员.size() != 1
        || 组.成员.front().关系.编码 != 请求.关系稳定编码
        || 组.成员.front().对端节点.编码 != 请求.父场景.值)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：向上送出；存在端点只经 E1 公开当前读取验证。
场景S2预检结果 检查成员存在端点(
    L1事实基座服务& L1, L2存在身份 存在, std::uint64_t 截止) {
    L2存在结构服务 存在服务{L1};
    const auto 读取 = 存在服务.读取存在节点(
        {{L2结构合同版本, 截止}, L2读取类别::当前, 存在});
    if (读取.结果头.合同版本 != L2结构合同版本)
        return {L2结构状态::内部不一致, 读取.结果头.事实截止代次, false};
    if (读取.结果头.状态 == L2结构状态::事实代次漂移)
        return {L2结构状态::事实代次漂移,
            读取.结果头.事实截止代次, true};
    if (读取.结果头.状态 != L2结构状态::已读取)
        return {读取.结果头.状态, 读取.结果头.事实截止代次, false};
    if (读取.结果头.事实截止代次 != 截止
        || 读取.结果头.变更事实代次 || !读取.存在
        || 读取.存在->身份 != 存在 || 读取.存在->生命周期.退出事实代次
        || !L2存在E1事实完整(*读取.存在))
        return {L2结构状态::内部不一致, 截止, false};
    return {L2结构状态::已读取, 截止, false};
}

struct 成员源组核对结果 final {
    bool 形状完整 = false;
    std::size_t 同存在数量 = 0;
    bool 具名旧关系匹配 = false;
};

// 诊断责任：无适用错误分支；核对成员源组方向、端点和同对唯一计数。
成员源组核对结果 核对成员源组(
    const L1中性一致源关系组读取结果项& 组, L2场景身份 场景,
    L2存在身份 存在, 稳定编码 成员类型, std::uint64_t 截止,
    std::optional<稳定编码> 具名旧关系 = std::nullopt,
    std::optional<std::uint64_t> 旧顺序 = std::nullopt) noexcept {
    if (组.源节点 != 场景.值 || 组.关系类型节点 != 成员类型)
        return {};
    成员源组核对结果 结果{true, 0, false};
    for (const auto& 成员 : 组.成员) {
        if (成员.关系.目标节点 != 成员.对端节点.编码
            || !形成截止存在节点事实(成员.对端节点, 截止)
            || 成员.对端节点.退出事实代次
            || !当前成员关系完整(成员.关系, 成员类型, 场景,
                L2存在身份{成员.对端节点.编码},
                static_cast<std::uint64_t>(成员.关系.角色或顺序), 截止))
            return {};
        if (成员.对端节点.编码 != 存在.值) continue;
        ++结果.同存在数量;
        if (具名旧关系 && 旧顺序
            && 成员.关系.编码 == *具名旧关系
            && 成员.关系.角色或顺序 == static_cast<std::int64_t>(*旧顺序))
            结果.具名旧关系匹配 = true;
    }
    return 结果;
}

// 诊断责任：向上送出；成员新增端点与同场景存在唯一性预检均结构化返回。
场景S2预检结果 检查成员新增前置(
    L1事实基座服务& L1, const L2场景成员关系新增请求& 请求,
    const L2场景关系类型登记& 登记) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    L1请求.源关系组 = {{请求.场景.值, 登记.成员关系类型.值}};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 1 || !读取.关系.empty() || !读取.值.empty()
        || !读取.属性值.empty() || 读取.源关系组.size() != 1
        || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 场景项 = 查找唯一节点项(读取, 请求.场景.值);
    if (!当前场景节点项完整(场景项, 请求.场景.值, 顶层.事实截止代次))
        return {场景项 && 场景项->状态 == L1中性一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 场景项 && 场景项->状态 == L1中性一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    const auto 存在结果 = 检查成员存在端点(L1, 请求.存在, 顶层.事实截止代次);
    if (!存在结果.成功()) return 存在结果;
    const auto 组结果 = 核对成员源组(读取.源关系组.front(),
        请求.场景, 请求.存在, 登记.成员关系类型.值, 顶层.事实截止代次);
    if (!组结果.形状完整)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    return 组结果.同存在数量 == 0
        ? 场景S2预检结果{L2结构状态::已读取, 顶层.事实截止代次, false}
        : 场景S2预检结果{L2结构状态::引用冲突, 顶层.事实截止代次, false};
}

// 诊断责任：向上送出；成员替换旧关系、端点与同对唯一预检均结构化返回。
场景S2预检结果 检查成员替换前置(
    L1事实基座服务& L1, const L2场景成员关系替换请求& 请求,
    const L2场景关系类型登记& 登记) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    追加唯一编码(L1请求.节点, 请求.旧场景.值);
    追加唯一编码(L1请求.节点, 请求.新场景.值);
    L1请求.关系 = {请求.旧关系稳定编码};
    L1请求.源关系组 = {{请求.旧场景.值, 登记.成员关系类型.值}};
    if (请求.新场景 != 请求.旧场景)
        L1请求.源关系组.push_back(
            {请求.新场景.值, 登记.成员关系类型.值});
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != L1请求.节点.size() || 读取.关系.size() != 1
        || !读取.值.empty() || !读取.属性值.empty()
        || 读取.源关系组.size() != L1请求.源关系组.size()
        || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    for (const auto 编码 : L1请求.节点) {
        const auto* 项 = 查找唯一节点项(读取, 编码);
        if (!当前场景节点项完整(项, 编码, 顶层.事实截止代次))
            return {项 && 项->状态 == L1中性一致当前读取项目状态::已退出
                    ? L2结构状态::已退出
                    : 项 && 项->状态 == L1中性一致当前读取项目状态::未找到
                        ? L2结构状态::未找到 : L2结构状态::内部不一致,
                顶层.事实截止代次, false};
    }
    const auto 存在结果 = 检查成员存在端点(L1, 请求.存在, 顶层.事实截止代次);
    if (!存在结果.成功()) return 存在结果;
    const auto* 关系项 = 查找唯一关系项(读取, 请求.旧关系稳定编码);
    if (!关系项 || 关系项->状态 != L1中性一致当前读取项目状态::成功
        || !关系项->事实)
        return {关系项 && 关系项->状态 == L1中性一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 关系项 && 关系项->状态 == L1中性一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    if (!当前成员关系完整(*关系项->事实, 登记.成员关系类型.值,
            请求.旧场景, 请求.存在, 请求.旧顺序, 顶层.事实截止代次))
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    const auto 旧组结果 = 核对成员源组(读取.源关系组.front(),
        请求.旧场景, 请求.存在, 登记.成员关系类型.值,
        顶层.事实截止代次, 请求.旧关系稳定编码, 请求.旧顺序);
    if (!旧组结果.形状完整 || 旧组结果.同存在数量 != 1
        || !旧组结果.具名旧关系匹配)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    if (请求.新场景 != 请求.旧场景) {
        const auto 新组结果 = 核对成员源组(读取.源关系组.back(),
            请求.新场景, 请求.存在, 登记.成员关系类型.值,
            顶层.事实截止代次);
        if (!新组结果.形状完整)
            return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
        if (新组结果.同存在数量 != 0)
            return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    }
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：向上送出；成员退出具名关系、端点与同对唯一预检均结构化返回。
场景S2预检结果 检查成员退出前置(
    L1事实基座服务& L1, const L2场景成员关系退出请求& 请求,
    const L2场景关系类型登记& 登记) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    L1请求.关系 = {请求.关系稳定编码};
    L1请求.源关系组 = {{请求.场景.值, 登记.成员关系类型.值}};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 1 || 读取.关系.size() != 1
        || !读取.值.empty() || !读取.属性值.empty()
        || 读取.源关系组.size() != 1 || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 场景项 = 查找唯一节点项(读取, 请求.场景.值);
    if (!当前场景节点项完整(场景项, 请求.场景.值, 顶层.事实截止代次))
        return {场景项 && 场景项->状态 == L1中性一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 场景项 && 场景项->状态 == L1中性一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    const auto 存在结果 = 检查成员存在端点(L1, 请求.存在, 顶层.事实截止代次);
    if (!存在结果.成功()) return 存在结果;
    const auto* 关系项 = 查找唯一关系项(读取, 请求.关系稳定编码);
    if (!关系项 || 关系项->状态 != L1中性一致当前读取项目状态::成功
        || !关系项->事实)
        return {关系项 && 关系项->状态 == L1中性一致当前读取项目状态::已退出
                ? L2结构状态::已退出
                : 关系项 && 关系项->状态 == L1中性一致当前读取项目状态::未找到
                    ? L2结构状态::未找到 : L2结构状态::内部不一致,
            顶层.事实截止代次, false};
    if (!当前成员关系完整(*关系项->事实, 登记.成员关系类型.值,
            请求.场景, 请求.存在, 请求.顺序, 顶层.事实截止代次))
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    const auto 组结果 = 核对成员源组(读取.源关系组.front(),
        请求.场景, 请求.存在, 登记.成员关系类型.值,
        顶层.事实截止代次, 请求.关系稳定编码, 请求.顺序);
    if (!组结果.形状完整 || 组结果.同存在数量 != 1
        || !组结果.具名旧关系匹配)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：向上送出；当前一致投影和 E1 端点复核失败均返回零部分场景。
L2场景完整读取结果 读取当前完整场景(
    L1事实基座服务& L1, const L2场景完整读取请求& 请求,
    const L2场景关系类型登记& 登记) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    L1请求.源关系组 = {
        {请求.场景.值, 登记.父子关系类型.值},
        {请求.场景.值, 登记.成员关系类型.值}};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);
    const auto 顶层 = 解释S2一致读取顶层(读取, 请求.请求头.期望事实代次);
    if (!顶层.成功())
        return 形成完整读取失败(请求, 顶层.状态, 顶层.事实截止代次);
    if (读取.节点.size() != 1 || !读取.关系.empty() || !读取.值.empty()
        || !读取.属性值.empty() || 读取.源关系组.size() != 2
        || !读取.目标关系组.empty())
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            顶层.事实截止代次);
    const auto* 场景项 = 查找唯一节点项(读取, 请求.场景.值);
    if (!场景项)
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            顶层.事实截止代次);
    if (场景项->状态 != L1中性一致当前读取项目状态::成功) {
        if (场景项->事实)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                顶层.事实截止代次);
        return 形成完整读取失败(请求,
            映射场景当前项目状态(场景项->状态), 顶层.事实截止代次);
    }
    if (!场景项->事实 || 场景项->事实->退出事实代次)
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            顶层.事实截止代次);
    auto 场景 = 形成截止场景节点事实(*场景项->事实, 顶层.事实截止代次);
    if (!场景 || 场景->身份 != 请求.场景)
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            顶层.事实截止代次);

    const auto& 父子组 = 读取.源关系组[0];
    const auto& 成员组 = 读取.源关系组[1];
    if (父子组.源节点 != 请求.场景.值
        || 父子组.关系类型节点 != 登记.父子关系类型.值
        || 成员组.源节点 != 请求.场景.值
        || 成员组.关系类型节点 != 登记.成员关系类型.值)
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            顶层.事实截止代次);

    std::vector<稳定编码> 子场景组;
    for (const auto& 成员 : 父子组.成员) {
        if (成员.关系.目标节点 != 成员.对端节点.编码
            || 成员.对端节点.退出事实代次
            || !形成截止场景节点事实(成员.对端节点, 顶层.事实截止代次)
            || std::find(子场景组.begin(), 子场景组.end(),
                成员.对端节点.编码) != 子场景组.end())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                顶层.事实截止代次);
        auto 关系 = 形成截止父子关系事实(成员.关系,
            登记.父子关系类型.值, 顶层.事实截止代次);
        if (!关系 || 关系->父场景 != 请求.场景
            || 关系->子场景.值 != 成员.对端节点.编码
            || 关系->生命周期.退出事实代次)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                顶层.事实截止代次);
        子场景组.push_back(成员.对端节点.编码);
        场景->直接子场景.push_back(std::move(*关系));
    }

    std::vector<稳定编码> 存在组;
    for (const auto& 成员 : 成员组.成员) {
        if (成员.关系.目标节点 != 成员.对端节点.编码
            || 成员.对端节点.退出事实代次
            || !形成截止存在节点事实(成员.对端节点, 顶层.事实截止代次)
            || std::find(存在组.begin(), 存在组.end(),
                成员.对端节点.编码) != 存在组.end())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                顶层.事实截止代次);
        const auto 存在结果 = 检查成员存在端点(
            L1, L2存在身份{成员.对端节点.编码}, 顶层.事实截止代次);
        if (!存在结果.成功())
            return 形成完整读取失败(请求,
                存在结果.直接提交 ? L2结构状态::事实代次漂移 : 存在结果.状态,
                存在结果.事实截止代次);
        auto 关系 = 形成截止成员关系事实(成员.关系,
            登记.成员关系类型.值, 顶层.事实截止代次);
        if (!关系 || 关系->场景 != 请求.场景
            || 关系->存在.值 != 成员.对端节点.编码
            || 关系->生命周期.退出事实代次)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                顶层.事实截止代次);
        存在组.push_back(成员.对端节点.编码);
        场景->直接成员.push_back(std::move(*关系));
    }
    std::sort(场景->直接子场景.begin(), 场景->直接子场景.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.子场景.值 < 右.子场景.值);
        });
    std::sort(场景->直接成员.begin(), 场景->直接成员.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.存在.值 < 右.存在.值);
        });
    if (!L2场景S2事实完整(*场景, 顶层.事实截止代次))
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            顶层.事实截止代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        顶层.事实截止代次, std::nullopt}, 请求.读取类别, 0,
        std::move(场景)};
}

struct 历史普通节点读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::optional<L1中性节点事实> 节点;
    bool 成功() const noexcept {
        return 状态 == L2结构状态::已读取 && 节点.has_value();
    }
};

// 诊断责任：向上送出；历史节点读取保留 L1 失败状态并只接受一条具名普通节点。
历史普通节点读取结果 读取历史普通节点(
    const L1事实基座服务& L1, 稳定编码 编码) {
    const auto 读取 = L1.读取中性历史事实({L1中性CRUD合同版本, 编码});
    if (读取.合同版本 != L1中性CRUD合同版本 || 读取.查询编码 != 编码)
        return {};
    if (读取.状态 != L1中性读取状态::成功)
        return {映射场景历史读取状态(读取.状态), std::nullopt};
    if (!读取.事实) return {};
    const auto* 节点 = std::get_if<L1中性节点事实>(&*读取.事实);
    return 节点 && 节点->编码 == 编码
        ? 历史普通节点读取结果{L2结构状态::已读取, *节点}
        : 历史普通节点读取结果{};
}

// 诊断责任：向上送出；历史节点、两关系组和前后代次矛盾均返回零部分场景。
L2场景完整读取结果 读取历史完整场景(
    L1事实基座服务& L1, const L2场景完整读取请求& 请求,
    const L2场景关系类型登记& 登记) {
    const auto 前代次 = 检查S2当前代次(L1, 请求.请求头.期望事实代次);
    if (!前代次.成功()) return 形成完整读取失败(请求,
        前代次.直接提交 ? L2结构状态::事实代次漂移 : 前代次.状态,
        前代次.事实截止代次);

    const auto 场景节点结果 = 读取历史普通节点(L1, 请求.场景.值);
    if (!场景节点结果.成功())
        return 形成完整读取失败(请求, 场景节点结果.状态,
            请求.历史截止事实代次);
    const auto& 场景节点 = *场景节点结果.节点;
    if (场景节点.创建事实代次 > 请求.历史截止事实代次)
        return 形成完整读取失败(请求, L2结构状态::未找到,
            请求.历史截止事实代次);
    if (场景节点.退出事实代次
        && *场景节点.退出事实代次 <= 请求.历史截止事实代次)
        return 形成完整读取失败(请求, L2结构状态::已退出,
            请求.历史截止事实代次);
    auto 场景 = 形成截止场景节点事实(场景节点, 请求.历史截止事实代次);
    if (!场景 || 场景->身份 != 请求.场景)
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            请求.历史截止事实代次);

    const L1中性历史关系组读取请求 父子请求{L1中性CRUD合同版本,
        L1中性关系端点方向::源, 请求.场景.值,
        登记.父子关系类型.值, 请求.历史截止事实代次};
    const L1中性历史关系组读取请求 成员请求{L1中性CRUD合同版本,
        L1中性关系端点方向::源, 请求.场景.值,
        登记.成员关系类型.值, 请求.历史截止事实代次};
    const auto 父子组 = L1.读取中性历史关系组(父子请求);
    const auto 成员组 = L1.读取中性历史关系组(成员请求);
    const auto 检查组顶层 = [&](const auto& 组, const auto& 组请求) {
        if (组.合同版本 != L1中性CRUD合同版本 || 组.方向 != 组请求.方向
            || 组.端点节点 != 组请求.端点节点
            || 组.关系类型节点 != 组请求.关系类型节点
            || 组.历史截止事实代次 != 组请求.历史截止事实代次)
            return L2结构状态::内部不一致;
        return 组.状态 == L1中性历史关系组读取状态::成功
            ? (组.读取事实代次 == 请求.请求头.期望事实代次
                ? L2结构状态::已读取 : L2结构状态::事实代次漂移)
            : 映射历史关系组失败状态(组.状态);
    };
    const auto 父子状态 = 检查组顶层(父子组, 父子请求);
    if (父子状态 != L2结构状态::已读取)
        return 形成完整读取失败(请求, 父子状态, 父子组.读取事实代次);
    const auto 成员状态 = 检查组顶层(成员组, 成员请求);
    if (成员状态 != L2结构状态::已读取)
        return 形成完整读取失败(请求, 成员状态, 成员组.读取事实代次);

    std::vector<稳定编码> 子场景组;
    for (const auto& 原关系 : 父子组.关系组) {
        if (!关系在截止有效(原关系, 请求.历史截止事实代次)
            || 原关系.源节点 != 请求.场景.值
            || std::find(子场景组.begin(), 子场景组.end(), 原关系.目标节点)
                != 子场景组.end())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 子节点结果 = 读取历史普通节点(L1, 原关系.目标节点);
        if (!子节点结果.成功())
            return 形成完整读取失败(请求,
                子节点结果.状态 == L2结构状态::资源失败
                    ? L2结构状态::资源失败 : L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto& 子节点 = *子节点结果.节点;
        if (子节点.创建事实代次 > 请求.历史截止事实代次
            || (子节点.退出事实代次
                && *子节点.退出事实代次 <= 请求.历史截止事实代次)
            || !形成截止场景节点事实(子节点, 请求.历史截止事实代次))
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        auto 关系 = 形成截止父子关系事实(原关系,
            登记.父子关系类型.值, 请求.历史截止事实代次);
        if (!关系 || 关系->父场景 != 请求.场景
            || 关系->子场景.值 != 原关系.目标节点
            || 关系->生命周期.退出事实代次)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        子场景组.push_back(原关系.目标节点);
        场景->直接子场景.push_back(std::move(*关系));
    }

    std::vector<稳定编码> 存在组;
    for (const auto& 原关系 : 成员组.关系组) {
        if (!关系在截止有效(原关系, 请求.历史截止事实代次)
            || 原关系.源节点 != 请求.场景.值
            || std::find(存在组.begin(), 存在组.end(), 原关系.目标节点)
                != 存在组.end())
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 存在节点结果 = 读取历史普通节点(L1, 原关系.目标节点);
        if (!存在节点结果.成功())
            return 形成完整读取失败(请求,
                存在节点结果.状态 == L2结构状态::资源失败
                    ? L2结构状态::资源失败 : L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto& 存在节点 = *存在节点结果.节点;
        if (存在节点.创建事实代次 > 请求.历史截止事实代次
            || (存在节点.退出事实代次
                && *存在节点.退出事实代次 <= 请求.历史截止事实代次)
            || !形成截止存在节点事实(存在节点, 请求.历史截止事实代次))
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        auto 关系 = 形成截止成员关系事实(原关系,
            登记.成员关系类型.值, 请求.历史截止事实代次);
        if (!关系 || 关系->场景 != 请求.场景
            || 关系->存在.值 != 原关系.目标节点
            || 关系->生命周期.退出事实代次)
            return 形成完整读取失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        存在组.push_back(原关系.目标节点);
        场景->直接成员.push_back(std::move(*关系));
    }
    const auto 后代次 = 检查S2当前代次(L1, 请求.请求头.期望事实代次);
    if (!后代次.成功()) return 形成完整读取失败(请求,
        后代次.直接提交 ? L2结构状态::事实代次漂移 : 后代次.状态,
        后代次.事实截止代次);

    std::sort(场景->直接子场景.begin(), 场景->直接子场景.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.子场景.值 < 右.子场景.值);
        });
    std::sort(场景->直接成员.begin(), 场景->直接成员.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.顺序 < 右.顺序
                || (左.顺序 == 右.顺序 && 左.存在.值 < 右.存在.值);
        });
    if (!L2场景S2事实完整(*场景, 请求.历史截止事实代次))
        return 形成完整读取失败(请求, L2结构状态::内部不一致,
            请求.历史截止事实代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::move(场景)};
}

} // namespace 海中鱼巣::L2场景结构内部

export namespace 海中鱼巣 {

class L2场景结构服务 final {
public:
    // 诊断责任：无适用错误分支；只保存公开 L1 服务引用。
    explicit L2场景结构服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L2场景结构服务(const L2场景结构服务&) = delete;
    L2场景结构服务& operator=(const L2场景结构服务&) = delete;

    // 诊断责任：向上送出；登记拒绝、漂移、冲突和读回矛盾均结构化返回。
    L2场景关系类型登记结果 建立场景关系类型登记(
        const L2场景关系类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(关系类型登记锁_);
            if (!L2场景关系类型登记请求有效(请求)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::入口拒绝);
            }
            if (关系类型登记定位_) {
                if (!L2场景关系类型登记完整(*关系类型登记定位_)) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致);
                }
                if (关系类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 关系类型登记定位_->规则版本 != 请求.规则版本
                    || 关系类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 关系类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::幂等冲突);
                }
            }

            const auto 幂等键 =
                L2场景结构内部::映射场景关系类型登记幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {
                {{L2场景结构内部::场景父子关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2场景结构内部::场景成员关系类型本地键值},
                    节点种类::普通, std::nullopt}};
            写集.关系 = {};
            写集.值 = {};
            写集.属性槽变更 = {};
            写集.退出事实 = {};

            const auto 写入 = L1_.提交中性写集(写集);
            if (写入.合同版本 != L1中性CRUD合同版本
                || 写入.幂等键 != 幂等键) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            const auto 状态 =
                L2场景结构内部::映射场景关系类型登记写入状态(写入.状态);
            if (状态 != L2场景关系类型登记状态::已提交
                && 状态 != L2场景关系类型登记状态::精确重复) {
                const auto 截止 = 状态 == L2场景关系类型登记状态::事实代次漂移
                    || 状态 == L2场景关系类型登记状态::幂等冲突
                    ? 写入.事实代次 : 0;
                return L2场景结构内部::形成场景关系类型登记失败(状态, 截止);
            }

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            if (写入.事实代次 == 0 || (!首次成功完整 && !重复成功完整)
                || !L2场景结构内部::场景关系类型编码映射唯一(写入)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            const auto 父子编码 = L2场景结构内部::查找场景关系类型编码映射(
                写入, L2场景结构内部::场景父子关系类型本地键值);
            const auto 成员编码 = L2场景结构内部::查找场景关系类型编码映射(
                写入, L2场景结构内部::场景成员关系类型本地键值);
            if (!父子编码 || !成员编码 || *父子编码 == *成员编码) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            L2场景关系类型登记 新定位;
            新定位.合同版本 = 请求.请求头.合同版本;
            新定位.规则版本 = 请求.规则版本;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            新定位.建立事实代次 = 写入.事实代次;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.父子关系类型 = {*父子编码};
            新定位.成员关系类型 = {*成员编码};
            if (!L2场景关系类型登记完整(新定位)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            auto 读回 = 按定位读取当前场景关系类型登记(
                新定位, 写入.事实代次);
            if (读回.状态 != L2场景关系类型登记状态::已读取
                || !读回.登记 || !读回.成功()) {
                return 读回.状态 == L2场景关系类型登记状态::已读取
                    ? L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致)
                    : 读回;
            }
            if (关系类型登记定位_
                && (关系类型登记定位_->合同版本 != 新定位.合同版本
                    || 关系类型登记定位_->规则版本 != 新定位.规则版本
                    || 关系类型登记定位_->首次幂等身份 != 新定位.首次幂等身份
                    || 关系类型登记定位_->首次期望事实代次
                        != 新定位.首次期望事实代次
                    || 关系类型登记定位_->建立事实代次 != 新定位.建立事实代次
                    || 关系类型登记定位_->父子关系类型 != 新定位.父子关系类型
                    || 关系类型登记定位_->成员关系类型 != 新定位.成员关系类型)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            关系类型登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；定位只在锁内深复制，权威节点在锁外正式读取。
    L2场景关系类型登记结果 读取当前场景关系类型登记() const {
        try {
            std::optional<L2场景关系类型登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(关系类型登记锁_);
                定位 = 关系类型登记定位_;
            }
            if (!定位) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::登记未加载);
            }
            return 按定位读取当前场景关系类型登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；所有异常、拒绝和读回矛盾均映射为结构化状态。
    L2场景节点写入结果 新增场景节点(const L2场景节点新增请求& 请求) {
        if (!L2场景节点新增请求有效(请求)) return {};
        try {
            const auto 幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{L2场景结构内部::场景节点本地键值},
                节点种类::普通, std::nullopt}};

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L2场景结构内部::映射场景写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                const auto 截止 = 写入.事实代次;
                return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
            }

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            const auto 编码 = L2场景结构内部::查找唯一场景编码映射(写入);
            if (写入.合同版本 != L1中性CRUD合同版本
                || 写入.幂等键 != 幂等键 || 写入.事实代次 == 0
                || (!首次成功完整 && !重复成功完整) || !编码) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }

            const auto 读回 = L1_.读取中性历史事实(
                {L1中性CRUD合同版本, *编码});
            const auto* 节点 = 读回.事实
                ? std::get_if<L1中性节点事实>(&*读回.事实) : nullptr;
            auto 场景 = 节点 ? L2场景结构内部::形成S1场景事实(
                *节点, 写入.事实代次) : std::nullopt;
            if (读回.状态 != L1中性读取状态::成功
                || 读回.合同版本 != L1中性CRUD合同版本
                || 读回.查询编码 != *编码 || 读回.读取事实代次 != 写入.事实代次
                || !节点 || 节点->编码 != *编码 || 节点->退出事实代次 || !场景) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }
            return {{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(场景)};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

    // 诊断责任：向上送出；当前或历史读取异常与矛盾均映射为结构化状态。
    L2场景节点读取结果 读取场景节点(const L2场景节点读取请求& 请求) const {
        if (!L2场景节点读取请求有效(请求)) return {};
        try {
            return 请求.读取类别 == L2读取类别::当前
                ? L2场景结构内部::读取当前场景节点(L1_, 请求)
                : L2场景结构内部::读取历史场景节点(L1_, 请求);
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

    // 诊断责任：向上送出；登记、预检、提交和读回失败均结构化返回。
    L2场景父子关系写入结果 新增场景父子关系(
        const L2场景父子关系新增请求& 请求) {
        if (!L2场景父子关系新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成父子写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景父子关系本地键值},
                请求.父场景.值, 请求.子场景.值, 登记.父子关系类型.值,
                static_cast<std::int64_t>(请求.顺序)}};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成父子写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2场景结构内部::检查父子新增前置(
                    L1_, 请求, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成父子写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回父子写集(L1_, 写集,
                登记.父子关系类型.值,
                L2场景结构内部::父子关系读回规格{
                    {}, 请求.父场景, 请求.子场景, 请求.顺序}, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；替换在一份写集中建立新关系并退出具名旧关系。
    L2场景父子关系写入结果 替换场景父子关系(
        const L2场景父子关系替换请求& 请求) {
        if (!L2场景父子关系替换请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成父子写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景父子关系本地键值},
                请求.新父场景.值, 请求.子场景.值, 登记.父子关系类型.值,
                static_cast<std::int64_t>(请求.新顺序)}};
            写集.退出事实 = {请求.旧关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成父子写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2场景结构内部::检查父子替换前置(
                    L1_, 请求, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成父子写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回父子写集(L1_, 写集,
                登记.父子关系类型.值,
                L2场景结构内部::父子关系读回规格{
                    {}, 请求.新父场景, 请求.子场景, 请求.新顺序},
                L2场景结构内部::父子关系读回规格{请求.旧关系稳定编码,
                    请求.旧父场景, 请求.子场景, 请求.旧顺序});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；退出只提交具名旧关系并正式历史读回。
    L2场景父子关系写入结果 退出场景父子关系(
        const L2场景父子关系退出请求& 请求) {
        if (!L2场景父子关系退出请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成父子写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.退出事实 = {请求.关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成父子写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2场景结构内部::检查父子退出前置(
                    L1_, 请求, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成父子写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回父子写集(L1_, 写集,
                登记.父子关系类型.值, std::nullopt,
                L2场景结构内部::父子关系读回规格{请求.关系稳定编码,
                    请求.父场景, 请求.子场景, 请求.顺序});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成父子写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；成员端点只经 E1 公开读取并恰一次提交。
    L2场景成员关系写入结果 新增场景成员关系(
        const L2场景成员关系新增请求& 请求) {
        if (!L2场景成员关系新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成成员写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景成员关系本地键值},
                请求.场景.值, 请求.存在.值, 登记.成员关系类型.值,
                static_cast<std::int64_t>(请求.顺序)}};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成成员写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2场景结构内部::检查成员新增前置(
                    L1_, 请求, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成成员写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回成员写集(L1_, 写集,
                登记.成员关系类型.值,
                L2场景结构内部::成员关系读回规格{
                    {}, 请求.场景, 请求.存在, 请求.顺序}, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；成员替换原子建立新关系并退出具名旧关系。
    L2场景成员关系写入结果 替换场景成员关系(
        const L2场景成员关系替换请求& 请求) {
        if (!L2场景成员关系替换请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成成员写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.关系 = {{{L2场景结构内部::场景成员关系本地键值},
                请求.新场景.值, 请求.存在.值, 登记.成员关系类型.值,
                static_cast<std::int64_t>(请求.新顺序)}};
            写集.退出事实 = {请求.旧关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成成员写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2场景结构内部::检查成员替换前置(
                    L1_, 请求, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成成员写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回成员写集(L1_, 写集,
                登记.成员关系类型.值,
                L2场景结构内部::成员关系读回规格{
                    {}, 请求.新场景, 请求.存在, 请求.新顺序},
                L2场景结构内部::成员关系读回规格{请求.旧关系稳定编码,
                    请求.旧场景, 请求.存在, 请求.旧顺序});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；成员退出只退出具名关系并正式历史读回。
    L2场景成员关系写入结果 退出场景成员关系(
        const L2场景成员关系退出请求& 请求) {
        if (!L2场景成员关系退出请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成成员写入失败(
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            写集.退出事实 = {请求.关系稳定编码};
            const auto 代次 = L2场景结构内部::检查S2当前代次(
                L1_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2场景结构内部::形成成员写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2场景结构内部::检查成员退出前置(
                    L1_, 请求, 登记);
                if (!前置.成功() && !前置.直接提交)
                    return L2场景结构内部::形成成员写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            return L2场景结构内部::提交并读回成员写集(L1_, 写集,
                登记.成员关系类型.值, std::nullopt,
                L2场景结构内部::成员关系读回规格{请求.关系稳定编码,
                    请求.场景, 请求.存在, 请求.顺序});
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成成员写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史完整读取失败均不携带部分场景。
    L2场景完整读取结果 读取完整场景(
        const L2场景完整读取请求& 请求) const {
        if (!L2场景完整读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前场景关系类型登记();
            if (登记结果.状态 != L2场景关系类型登记状态::已读取
                || !登记结果.成功() || !登记结果.登记)
                return L2场景结构内部::形成完整读取失败(请求,
                    L2场景结构内部::映射登记读取状态(登记结果.状态),
                    登记结果.事实截止代次);
            return 请求.读取类别 == L2读取类别::当前
                ? L2场景结构内部::读取当前完整场景(
                    L1_, 请求, *登记结果.登记)
                : L2场景结构内部::读取历史完整场景(
                    L1_, 请求, *登记结果.登记);
        } catch (const std::bad_alloc&) {
            return L2场景结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2场景结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2场景结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

private:
    // 诊断责任：向上送出；许可、漂移、资源失败和节点矛盾均结构化返回。
    L2场景关系类型登记结果 按定位读取当前场景关系类型登记(
        const L2场景关系类型登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2场景关系类型登记完整(定位)) {
            return L2场景结构内部::形成场景关系类型登记失败(
                L2场景关系类型登记状态::内部不一致);
        }

        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试序号 = 0; 尝试序号 < 最大尝试次数; ++尝试序号) {
            L1中性一致当前读取请求 请求;
            请求.合同版本 = L1中性一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.节点 = {定位.父子关系类型.值, 定位.成员关系类型.值};
            请求.关系 = {};
            请求.值 = {};
            请求.属性值 = {};
            请求.源关系组 = {};
            请求.目标关系组 = {};

            const auto 读取 = L1_.尝试读取中性一致当前投影(请求);
            if (读取.状态 == L1中性一致当前读取状态::事实代次漂移) {
                if (!L2场景结构内部::场景关系类型一致读取失败形状完整(
                    读取, 本轮期望代次)) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致);
                }
                if (尝试序号 == 0) {
                    本轮期望代次 = 读取.读取事实代次;
                    continue;
                }
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::事实代次漂移,
                    读取.读取事实代次);
            }
            if (读取.状态 != L1中性一致当前读取状态::成功) {
                if (!L2场景结构内部::场景关系类型一致读取失败形状完整(
                    读取, 本轮期望代次)) {
                    return L2场景结构内部::形成场景关系类型登记失败(
                        L2场景关系类型登记状态::内部不一致);
                }
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景结构内部::映射场景关系类型登记读取失败状态(
                        读取.状态));
            }
            if (读取.合同版本 != L1中性一致当前读取合同版本
                || 读取.期望事实代次 != 本轮期望代次
                || 读取.读取事实代次 != 本轮期望代次
                || 读取.读取事实代次 == 0 || 读取.节点.size() != 2
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty()) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            const auto& 父子项 = 读取.节点[0];
            const auto& 成员项 = 读取.节点[1];
            if (父子项.查询编码 != 定位.父子关系类型.值
                || 成员项.查询编码 != 定位.成员关系类型.值
                || 父子项.状态 != L1中性一致当前读取项目状态::成功
                || 成员项.状态 != L1中性一致当前读取项目状态::成功
                || !父子项.事实 || !成员项.事实) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            const auto& 父子事实 = *父子项.事实;
            const auto& 成员事实 = *成员项.事实;
            if (父子事实.编码 != 定位.父子关系类型.值
                || 成员事实.编码 != 定位.成员关系类型.值
                || 父子事实.种类 != 节点种类::普通
                || 成员事实.种类 != 节点种类::普通
                || 父子事实.属性类型表示 || 成员事实.属性类型表示
                || 父子事实.创建事实代次 != 定位.建立事实代次
                || 成员事实.创建事实代次 != 定位.建立事实代次
                || 父子事实.退出事实代次 || 成员事实.退出事实代次
                || !父子事实.当前属性.empty() || !成员事实.当前属性.empty()
                || (期望创建代次
                    && (父子事实.创建事实代次 != *期望创建代次
                        || 成员事实.创建事实代次 != *期望创建代次))) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }

            auto 当前登记 = 定位;
            当前登记.事实截止代次 = 读取.读取事实代次;
            if (!L2场景关系类型登记完整(当前登记)) {
                return L2场景结构内部::形成场景关系类型登记失败(
                    L2场景关系类型登记状态::内部不一致);
            }
            return {L2场景关系类型登记状态::已读取,
                当前登记.事实截止代次, std::move(当前登记)};
        }
        return L2场景结构内部::形成场景关系类型登记失败(
            L2场景关系类型登记状态::内部不一致);
    }

    L1事实基座服务& L1_;
    mutable std::mutex 关系类型登记锁_;
    std::optional<L2场景关系类型登记> 关系类型登记定位_;
};

} // namespace 海中鱼巣
