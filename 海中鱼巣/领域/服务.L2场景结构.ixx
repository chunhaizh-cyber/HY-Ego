module;

#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

#define L2_SCENE_STRUCTURE_NO_INCLUDES

export module 海中鱼巣.领域.服务.L2场景结构;

export import 海中鱼巣.领域.合同.L2结构公共;
import 海中鱼巣.核心.服务.L1事实基座;

export {
#include "L2场景结构.数据.h"
}

namespace 海中鱼巣::L2场景结构内部 {

inline constexpr std::uint32_t 场景节点本地键值 = 0x0201'0001U;

// 诊断责任：无适用错误分支；完整 64 位纯值映射不读取事实。
L1中性写集幂等键 映射场景幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2结构状态 映射场景写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return L2结构状态::已提交;
    case L1中性写入状态::精确重复: return L2结构状态::精确重复;
    case L1中性写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1中性写入状态::资源失败: return L2结构状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部一致读取状态。
L2结构状态 映射场景一致读取失败状态(
    L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1中性一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1中性一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部读取项目状态。
L2结构状态 映射场景当前项目状态(
    L1中性一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1中性一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1中性一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1中性一致当前读取项目状态::属性未设置:
    case L1中性一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部历史读取状态。
L2结构状态 映射场景历史读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::成功: return L2结构状态::已读取;
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::未找到: return L2结构状态::未找到;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对唯一场景本地键映射。
std::optional<稳定编码> 查找唯一场景编码映射(
    const L1中性写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    if (本地键.值 != 场景节点本地键值 || !有效(编码)) return std::nullopt;
    return 编码;
}

// 诊断责任：无适用错误分支；只把完整 L1 普通节点映射为 S1 值式事实。
std::optional<L2场景事实> 形成S1场景事实(
    const L1中性节点事实& 节点, std::uint64_t 事实截止代次) noexcept {
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 事实截止代次 || !节点.当前属性.empty()
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 事实截止代次))) {
        return std::nullopt;
    }
    L2场景事实 场景;
    场景.身份 = L2场景身份{节点.编码};
    场景.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    if (!L2场景S1事实完整(场景)) return std::nullopt;
    return 场景;
}

// 诊断责任：无适用错误分支；只形成无载荷的结构化读取失败。
L2场景节点读取结果 形成读取失败(L2结构状态 状态,
    std::uint64_t 事实截止代次 = 0) noexcept {
    return {{L2结构合同版本, 状态, 事实截止代次, std::nullopt}, std::nullopt};
}

// 诊断责任：向上送出；公开 L1 一致读取的失败与事实矛盾均结构化返回。
L2场景节点读取结果 读取当前场景节点(
    const L1事实基座服务& L1, const L2场景节点读取请求& 请求) {
    L1中性一致当前读取请求 L1请求;
    L1请求.合同版本 = L1中性一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.节点 = {请求.场景.值};
    const auto 读取 = L1.尝试读取中性一致当前投影(L1请求);

    if (读取.状态 != L1中性一致当前读取状态::成功) {
        const bool 形状完整 = 读取.合同版本 == L1中性一致当前读取合同版本
            && 读取.期望事实代次 == 请求.请求头.期望事实代次
            && 读取.节点.empty() && 读取.关系.empty() && 读取.值.empty()
            && 读取.属性值.empty() && 读取.源关系组.empty()
            && 读取.目标关系组.empty()
            && (读取.状态 == L1中性一致当前读取状态::事实代次漂移
                ? 读取.读取事实代次 != 0
                    && 读取.读取事实代次 != 请求.请求头.期望事实代次
                : 读取.读取事实代次 == 0);
        if (!形状完整) return 形成读取失败(L2结构状态::内部不一致);
        return 形成读取失败(映射场景一致读取失败状态(读取.状态),
            读取.读取事实代次);
    }

    if (读取.合同版本 != L1中性一致当前读取合同版本
        || 读取.期望事实代次 != 请求.请求头.期望事实代次
        || 读取.读取事实代次 != 请求.请求头.期望事实代次
        || 读取.读取事实代次 == 0 || 读取.节点.size() != 1
        || !读取.关系.empty() || !读取.值.empty() || !读取.属性值.empty()
        || !读取.源关系组.empty() || !读取.目标关系组.empty()) {
        return 形成读取失败(L2结构状态::内部不一致);
    }

    const auto& 项 = 读取.节点.front();
    if (项.查询编码 != 请求.场景.值) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    if (项.状态 != L1中性一致当前读取项目状态::成功) {
        if (项.事实) return 形成读取失败(L2结构状态::内部不一致,
            读取.读取事实代次);
        return 形成读取失败(映射场景当前项目状态(项.状态),
            读取.读取事实代次);
    }
    if (!项.事实 || 项.事实->退出事实代次) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    auto 场景 = 形成S1场景事实(*项.事实, 读取.读取事实代次);
    if (!场景 || 场景->身份 != 请求.场景) {
        return 形成读取失败(L2结构状态::内部不一致, 读取.读取事实代次);
    }
    return {{L2结构合同版本, L2结构状态::已读取,
        读取.读取事实代次, std::nullopt}, std::move(场景)};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖事实代次探测失败。
L2结构状态 映射事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：向上送出；前后代次探测、历史读取与事实矛盾均结构化返回。
L2场景节点读取结果 读取历史场景节点(
    const L1事实基座服务& L1, const L2场景节点读取请求& 请求) {
    const L1中性事实代次读取请求 代次请求{L1中性CRUD合同版本};
    const auto 前代次 = L1.读取中性当前事实代次(代次请求);
    if (前代次.状态 != L1中性读取状态::成功
        || 前代次.合同版本 != L1中性CRUD合同版本) {
        return 形成读取失败(前代次.合同版本 == L1中性CRUD合同版本
            ? 映射事实代次探测失败(前代次.状态)
            : L2结构状态::内部不一致);
    }
    if (前代次.事实代次 != 请求.请求头.期望事实代次) {
        return 形成读取失败(L2结构状态::事实代次漂移, 前代次.事实代次);
    }

    const auto 历史 = L1.读取中性历史事实(
        {L1中性CRUD合同版本, 请求.场景.值});
    const auto 后代次 = L1.读取中性当前事实代次(代次请求);
    if (后代次.状态 != L1中性读取状态::成功
        || 后代次.合同版本 != L1中性CRUD合同版本) {
        return 形成读取失败(后代次.合同版本 == L1中性CRUD合同版本
            ? 映射事实代次探测失败(后代次.状态)
            : L2结构状态::内部不一致);
    }
    if (后代次.事实代次 != 请求.请求头.期望事实代次
        || 后代次.事实代次 != 前代次.事实代次) {
        return 形成读取失败(L2结构状态::事实代次漂移, 后代次.事实代次);
    }

    if (历史.合同版本 != L1中性CRUD合同版本
        || 历史.查询编码 != 请求.场景.值) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    if (历史.状态 != L1中性读取状态::成功) {
        if (历史.事实) return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
        return 形成读取失败(映射场景历史读取状态(历史.状态),
            请求.请求头.期望事实代次);
    }
    const auto* 节点 = 历史.事实
        ? std::get_if<L1中性节点事实>(&*历史.事实) : nullptr;
    if (!节点 || 历史.读取事实代次 == 0
        || 历史.读取事实代次
            != 节点->退出事实代次.value_or(节点->创建事实代次)) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    auto 场景 = 形成S1场景事实(*节点, 请求.请求头.期望事实代次);
    if (!场景 || 场景->身份 != 请求.场景) {
        return 形成读取失败(L2结构状态::内部不一致,
            请求.请求头.期望事实代次);
    }
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.请求头.期望事实代次, std::nullopt}, std::move(场景)};
}

} // namespace 海中鱼巣::L2场景结构内部

export namespace 海中鱼巣 {

class L2场景结构服务 final {
public:
    // 诊断责任：无适用错误分支；只保存公开 L1 服务引用。
    explicit L2场景结构服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L2场景结构服务(const L2场景结构服务&) = delete;
    L2场景结构服务& operator=(const L2场景结构服务&) = delete;

    // 诊断责任：向上送出；所有异常、拒绝和读回矛盾均映射为结构化状态。
    L2场景节点写入结果 新增场景节点(const L2场景节点新增请求& 请求) {
        if (!L2场景节点新增请求有效(请求)) return {};
        try {
            const auto 幂等键 = L2场景结构内部::映射场景幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{L2场景结构内部::场景节点本地键值},
                节点种类::普通, std::nullopt}};

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L2场景结构内部::映射场景写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                const auto 截止 = 写入.事实代次;
                return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
            }

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            const auto 编码 = L2场景结构内部::查找唯一场景编码映射(写入);
            if (写入.合同版本 != L1中性CRUD合同版本
                || 写入.幂等键 != 幂等键 || 写入.事实代次 == 0
                || (!首次成功完整 && !重复成功完整) || !编码) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }

            const auto 读回 = L1_.读取中性历史事实(
                {L1中性CRUD合同版本, *编码});
            const auto* 节点 = 读回.事实
                ? std::get_if<L1中性节点事实>(&*读回.事实) : nullptr;
            auto 场景 = 节点 ? L2场景结构内部::形成S1场景事实(
                *节点, 写入.事实代次) : std::nullopt;
            if (读回.状态 != L1中性读取状态::成功
                || 读回.合同版本 != L1中性CRUD合同版本
                || 读回.查询编码 != *编码 || 读回.读取事实代次 != 写入.事实代次
                || !节点 || 节点->编码 != *编码 || 节点->退出事实代次 || !场景) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }
            return {{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(场景)};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

    // 诊断责任：向上送出；当前或历史读取异常与矛盾均映射为结构化状态。
    L2场景节点读取结果 读取场景节点(const L2场景节点读取请求& 请求) const {
        if (!L2场景节点读取请求有效(请求)) return {};
        try {
            return 请求.读取类别 == L2读取类别::当前
                ? L2场景结构内部::读取当前场景节点(L1_, 请求)
                : L2场景结构内部::读取历史场景节点(L1_, 请求);
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

private:
    L1事实基座服务& L1_;
};

} // namespace 海中鱼巣
