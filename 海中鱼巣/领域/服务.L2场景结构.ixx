inline constexpr std::uint32_t 场景U64组属性类型本地键值 = 0x0201'1203U;
inline constexpr std::uint32_t 场景独立材料属性类型本地键值 = 0x0201'1204U;
inline constexpr std::uint32_t 场景树登记锚点本地键值 = 0x0201'1301U;
inline constexpr std::uint32_t 场景树根标记类型本地键值 = 0x0201'1302U;
inline constexpr std::uint32_t 场景树归属类型本地键值 = 0x0201'1303U;
inline constexpr std::uint32_t 树根场景节点本地键值 = 0x0201'1401U;
inline constexpr std::uint32_t 树根场景族归属本地键值 = 0x0201'1402U;
inline constexpr std::uint32_t 树根标记关系本地键值 = 0x0201'1403U;
inline constexpr std::uint32_t 树内场景节点本地键值 = 0x0201'1501U;
