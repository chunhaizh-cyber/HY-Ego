export {
#include "特征比较.数据.h"
}

export namespace 海中鱼巣 {

namespace 特征比较内部 {

inline constexpr std::uint64_t 合同幂等域 = 0x09ULL;
inline constexpr std::uint64_t 迁移合同幂等域 = 0x0EULL;

L1中性写集幂等键 映射登记中性幂等键(
    特征比较操作幂等身份 身份) noexcept {
    return {(特征比较登记幂等域 << 56) | 身份.值};
}

L1中性写集幂等键 映射目标判断合同中性幂等键(
    特征比较操作幂等身份 身份) noexcept {
    return {(合同幂等域 << 56) | 身份.值};
}

L1中性写集幂等键 映射状态迁移合同中性幂等键(
    特征比较操作幂等身份 身份) noexcept {
    return {(迁移合同幂等域 << 56) | 身份.值};
}

bool 身份有效(特征比较操作幂等身份 身份) noexcept {
    return 身份.值 != 0 && 身份.值 <= 0x00FF'FFFF'FFFF'FFFFULL;
}
std::optional<稳定编码> 查找中性映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}
bool 中性映射完整唯一(const L1中性写入结果& 结果,
    std::uint32_t 数量) noexcept {
    if (结果.新编码映射.size() != 数量) return false;
    for (std::uint32_t i = 1; i <= 数量; ++i) {
        const auto 编码 = 查找中性映射(结果, i);
        if (!编码 || !有效(*编码)) return false;
        for (std::uint32_t j = i + 1; j <= 数量; ++j) {
            const auto 另一个 = 查找中性映射(结果, j);
            if (!另一个 || *另一个 == *编码) return false;
        }
    }
    return true;
}
bool 中性登记节点形状符合(const L1中性节点事实& 节点,
    std::size_t 索引) noexcept {
    if (索引 == 1)
        return 节点.种类 == 节点种类::属性类型
            && 节点.属性类型表示 == std::optional{L1中性值表示种类::I64组};
    return 节点.种类 == 节点种类::普通 && !节点.属性类型表示;
}
bool 登记定位相同(const 特征比较登记& 左,
    const 特征比较登记& 右) noexcept {
    return 左.服务身份 == 右.服务身份
        && 左.合同配置I64组属性类型 == 右.合同配置I64组属性类型
        && 左.合同字段关系类型 == 右.合同字段关系类型
        && 左.无单位 == 右.无单位 && 左.标量维度 == 右.标量维度
        && 左.标量分量角色 == 右.标量分量角色;
}
特征比较状态 映射中性写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功:
    case L1中性写入状态::精确重复: return 特征比较状态::已比较;
    case L1中性写入状态::事实代次漂移: return 特征比较状态::版本漂移;
    case L1中性写入状态::幂等冲突:
    case L1中性写入状态::入口拒绝: return 特征比较状态::入口拒绝;
    case L1中性写入状态::资源失败: return 特征比较状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致: return 特征比较状态::内部不一致;
    }
    return 特征比较状态::内部不一致;
}
特征比较状态 映射中性读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置: return 特征比较状态::未注册;
    case L1中性读取状态::资源失败: return 特征比较状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::入口拒绝:
    case L1中性读取状态::内部不一致: return 特征比较状态::内部不一致;
    }
    return 特征比较状态::内部不一致;
}
const 节点事实* 找节点(const L1完整快照& 快照, 稳定编码 编码) noexcept {
    const 节点事实* 找到 = nullptr;
    for (const auto& 值 : 快照.当前节点) if (值.编码 == 编码) {
        if (找到) return nullptr;
        找到 = &值;
    }
    return 找到;
}
const 值事实* 找值(const L1完整快照& 快照, 稳定编码 编码) noexcept {
    const 值事实* 找到 = nullptr;
    for (const auto& 值 : 快照.当前值) if (值.编码 == 编码) {
        if (找到) return nullptr;
        找到 = &值;
    }
    return 找到;
}
const 关系事实* 找关系(const L1完整快照& 快照, 稳定编码 编码) noexcept {
    const 关系事实* 找到 = nullptr;
    for (const auto& 值 : 快照.当前关系) if (值.编码 == 编码) {
        if (找到) return nullptr;
        找到 = &值;
    }
    return 找到;
}
std::optional<std::int64_t> 取I64(const 值事实* 值) noexcept {
    if (!值 || !std::holds_alternative<std::int64_t>(值->材料)) return std::nullopt;
    return std::get<std::int64_t>(值->材料);
}
bool 当前槽指向(const 节点事实* 节点, 稳定编码 属性类型, 稳定编码 当前值) noexcept {
    if (!节点) return false;
    std::size_t 数量 = 0;
    for (const auto& 槽 : 节点->当前属性) if (槽.属性类型节点 == 属性类型) {
        ++数量;
        if (槽.当前值 != 当前值) return false;
    }
    return 数量 == 1;
}
bool 定义读取相同(const I64特征定义读取请求& 左, const I64特征定义读取请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.特征定义 == 右.特征定义 && 左.定义标记值 == 右.定义标记值
        && 左.下界值 == 右.下界值 && 左.上界值 == 右.上界值;
}
bool 合同请求相同(const I64目标判断比较合同登记请求& 左,
    const I64目标判断比较合同登记请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份 && 左.期望事实代次 == 右.期望事实代次
        && 左.定义登记.合同版本 == 右.定义登记.合同版本
        && 左.定义登记.规则版本 == 右.定义登记.规则版本
        && 左.定义登记.事实截止代次 == 右.定义登记.事实截止代次
        && 左.定义登记.服务身份 == 右.定义登记.服务身份
        && 左.定义登记.定义标记属性类型 == 右.定义登记.定义标记属性类型
        && 左.定义登记.I64下界属性类型 == 右.定义登记.I64下界属性类型
        && 左.定义登记.I64上界属性类型 == 右.定义登记.I64上界属性类型
        && 定义读取相同(左.特征定义, 右.特征定义)
        && 左.实例登记.合同版本 == 右.实例登记.合同版本
        && 左.实例登记.规则版本 == 右.实例登记.规则版本
        && 左.实例登记.事实截止代次 == 右.实例登记.事实截止代次
        && 左.实例登记.服务身份 == 右.实例登记.服务身份
        && 左.实例登记.宿主槽关系类型 == 右.实例登记.宿主槽关系类型
        && 左.实例登记.定义模板关系类型 == 右.实例登记.定义模板关系类型
        && 左.实例登记.当前I64值属性类型 == 右.实例登记.当前I64值属性类型;
}
bool 登记完整(const 特征比较登记& 登记) noexcept;
bool 目标判断合同完整(const I64目标判断比较合同& 合同) noexcept {
    return 合同.合同版本 == 特征比较合同版本 && 合同.规则版本 == 特征比较规则版本
        && 合同.事实截止代次 != 0 && 有效(合同.注册身份) && 有效(合同.配置值)
        && 有效(合同.特征定义) && 有效(合同.定义标记值) && 有效(合同.下界值)
        && 有效(合同.上界值) && 有效(合同.定义模板关系类型)
        && 有效(合同.当前I64值属性类型) && 有效(合同.目标I64值属性类型)
        && 有效(合同.单位) && 有效(合同.维度) && 有效(合同.分量角色)
        && 有效(合同.定义来源服务) && 合同.用途 == 特征比较用途::目标判断
        && 合同.算法族 == 特征比较算法族::标量有序比较与安全差异
        && 合同.算法版本 == 1 && 合同.原始类型 == 特征比较原始类型::I64
        && 合同.左角色 == 特征比较角色::当前事实
        && 合同.右角色 == 特征比较角色::目标状态
        && 合同.差异方向 == 特征比较方向::右减左 && 合同.允许结果位 == 7
        && 合同.当前有效 && 合同.边界包含 == 特征比较边界包含::不适用
        && 合同.量化规则 == 特征比较量化规则::精确无量化
        && 合同.误差合同版本 == 1 && 合同.下界 <= 合同.上界;
}
bool 目标判断合同定位相同(const I64目标判断比较合同& 左,
    const I64目标判断比较合同& 右) noexcept {
    auto 左定位 = 左;
    auto 右定位 = 右;
    左定位.事实截止代次 = 1;
    右定位.事实截止代次 = 1;
    return 左定位.合同版本 == 右定位.合同版本
        && 左定位.规则版本 == 右定位.规则版本
        && 左定位.事实截止代次 == 右定位.事实截止代次
        && 左定位.注册身份 == 右定位.注册身份
        && 左定位.配置值 == 右定位.配置值
        && 左定位.特征定义 == 右定位.特征定义
        && 左定位.定义标记值 == 右定位.定义标记值
        && 左定位.下界值 == 右定位.下界值 && 左定位.上界值 == 右定位.上界值
        && 左定位.定义模板关系类型 == 右定位.定义模板关系类型
        && 左定位.当前I64值属性类型 == 右定位.当前I64值属性类型
        && 左定位.目标I64值属性类型 == 右定位.目标I64值属性类型
        && 左定位.单位 == 右定位.单位 && 左定位.维度 == 右定位.维度
        && 左定位.分量角色 == 右定位.分量角色
        && 左定位.定义来源服务 == 右定位.定义来源服务
        && 左定位.用途 == 右定位.用途 && 左定位.算法族 == 右定位.算法族
        && 左定位.算法版本 == 右定位.算法版本
        && 左定位.原始类型 == 右定位.原始类型
        && 左定位.左角色 == 右定位.左角色 && 左定位.右角色 == 右定位.右角色
        && 左定位.差异方向 == 右定位.差异方向
        && 左定位.允许结果位 == 右定位.允许结果位
        && 左定位.当前有效 == 右定位.当前有效
        && 左定位.边界包含 == 右定位.边界包含
        && 左定位.量化规则 == 右定位.量化规则
        && 左定位.误差合同版本 == 右定位.误差合同版本
        && 左定位.下界 == 右定位.下界 && 左定位.上界 == 右定位.上界;
}
bool 目标判断合同与请求登记相符(const I64目标判断比较合同& 合同,
    const I64目标判断比较合同登记请求& 请求,
    const 特征比较登记& 登记) noexcept {
    return 目标判断合同完整(合同) && 登记完整(登记)
        && 合同.特征定义 == 请求.特征定义.特征定义
        && 合同.定义标记值 == 请求.特征定义.定义标记值
        && 合同.下界值 == 请求.特征定义.下界值
        && 合同.上界值 == 请求.特征定义.上界值
        && 合同.定义模板关系类型 == 请求.实例登记.定义模板关系类型
        && 合同.当前I64值属性类型 == 请求.实例登记.当前I64值属性类型
        && 合同.目标I64值属性类型 == 请求.定义登记.I64上界属性类型
        && 合同.单位 == 登记.无单位 && 合同.维度 == 登记.标量维度
        && 合同.分量角色 == 登记.标量分量角色
        && 合同.定义来源服务 == 请求.定义登记.服务身份;
}
std::optional<std::int64_t> 取中性I64(const L1中性值事实& 值) noexcept {
    if (const auto* 结果 = std::get_if<std::int64_t>(&值.材料)) return *结果;
    return std::nullopt;
}
std::vector<std::int64_t> 形成目标判断配置材料(
    std::int64_t 下界, std::int64_t 上界) {
    return {1, 1, 1, 1, 1, 1, 2, 1, 7, 1,
        1, 1, 0, 1, 1, 1, 1, 1, 下界, 上界};
}
std::array<稳定编码, 8> 形成目标判断关系目标(
    const I64目标判断比较合同登记请求& 请求,
    const 特征比较登记& 登记) noexcept {
    return {请求.特征定义.特征定义, 请求.实例登记.定义模板关系类型,
        请求.实例登记.当前I64值属性类型, 请求.定义登记.I64上界属性类型,
        登记.无单位, 登记.标量维度, 登记.标量分量角色,
        请求.定义登记.服务身份};
}
L1中性写集请求 形成目标判断合同中性写集(
    const I64目标判断比较合同登记请求& 请求,
    const 特征比较登记& 登记, std::int64_t 下界, std::int64_t 上界) {
    L1中性写集请求 写集;
    写集.合同版本 = L1中性CRUD合同版本;
    写集.期望事实代次 = 请求.期望事实代次;
    写集.幂等键 = 映射目标判断合同中性幂等键(请求.幂等身份);
    写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    写集.值 = {{{2}, L1中性写集本地键{1}, 登记.合同配置I64组属性类型,
        形成目标判断配置材料(下界, 上界), 登记.服务身份}};
    写集.属性槽变更 = {{L1中性写集本地键{1},
        登记.合同配置I64组属性类型, L1中性写集本地键{2}}};
    const auto 目标 = 形成目标判断关系目标(请求, 登记);
    for (std::uint32_t i = 0; i < 目标.size(); ++i)
        写集.关系.push_back({L1中性写集本地键{3 + i},
            L1中性写集本地键{1}, 目标[i], 登记.合同字段关系类型,
            static_cast<std::int64_t>(i + 1)});
    return 写集;
}
I64目标判断比较合同 形成目标判断合同见证(
    const I64目标判断比较合同登记请求& 请求,
    const 特征比较登记& 登记, 稳定编码 注册, 稳定编码 配置,
    std::int64_t 下界, std::int64_t 上界) noexcept {
    I64目标判断比较合同 合同;
    合同.注册身份 = 注册;
    合同.配置值 = 配置;
    合同.特征定义 = 请求.特征定义.特征定义;
    合同.定义标记值 = 请求.特征定义.定义标记值;
    合同.下界值 = 请求.特征定义.下界值;
    合同.上界值 = 请求.特征定义.上界值;
    合同.定义模板关系类型 = 请求.实例登记.定义模板关系类型;
    合同.当前I64值属性类型 = 请求.实例登记.当前I64值属性类型;
    合同.目标I64值属性类型 = 请求.定义登记.I64上界属性类型;
    合同.单位 = 登记.无单位;
    合同.维度 = 登记.标量维度;
    合同.分量角色 = 登记.标量分量角色;
    合同.定义来源服务 = 请求.定义登记.服务身份;
    合同.下界 = 下界;
    合同.上界 = 上界;
    return 合同;
}
bool 状态迁移合同完整(const I64状态迁移比较合同& 合同) noexcept {
    return 合同.合同版本 == 特征比较合同版本 && 合同.规则版本 == 特征比较规则版本
        && 合同.事实截止代次 != 0 && 有效(合同.注册身份) && 有效(合同.配置值)
        && 有效(合同.特征定义) && 有效(合同.定义标记值) && 有效(合同.下界值)
        && 有效(合同.上界值) && 有效(合同.定义模板关系类型)
        && 有效(合同.当前I64值属性类型) && 有效(合同.单位) && 有效(合同.维度)
        && 有效(合同.分量角色) && 有效(合同.定义来源服务)
        && 合同.用途 == 特征比较用途::状态迁移
        && 合同.算法族 == 特征比较算法族::标量有序比较与安全差异
        && 合同.算法版本 == 1 && 合同.原始类型 == 特征比较原始类型::I64
        && 合同.左角色 == 特征比较角色::前状态
        && 合同.右角色 == 特征比较角色::后当前事实
        && 合同.差异方向 == 特征比较方向::右减左 && 合同.允许结果位 == 7
        && 合同.当前有效 && 合同.边界包含 == 特征比较边界包含::不适用
        && 合同.量化规则 == 特征比较量化规则::精确无量化
        && 合同.误差合同版本 == 1 && 合同.下界 <= 合同.上界;
}
bool 状态迁移合同定位相同(const I64状态迁移比较合同& 左,
    const I64状态迁移比较合同& 右) noexcept {
    auto 左定位 = 左;
    auto 右定位 = 右;
    左定位.事实截止代次 = 1;
    右定位.事实截止代次 = 1;
    return 左定位.合同版本 == 右定位.合同版本
        && 左定位.规则版本 == 右定位.规则版本
        && 左定位.事实截止代次 == 右定位.事实截止代次
        && 左定位.注册身份 == 右定位.注册身份
        && 左定位.配置值 == 右定位.配置值
        && 左定位.特征定义 == 右定位.特征定义
        && 左定位.定义标记值 == 右定位.定义标记值
        && 左定位.下界值 == 右定位.下界值 && 左定位.上界值 == 右定位.上界值
        && 左定位.定义模板关系类型 == 右定位.定义模板关系类型
        && 左定位.当前I64值属性类型 == 右定位.当前I64值属性类型
        && 左定位.单位 == 右定位.单位 && 左定位.维度 == 右定位.维度
        && 左定位.分量角色 == 右定位.分量角色
        && 左定位.定义来源服务 == 右定位.定义来源服务
        && 左定位.用途 == 右定位.用途 && 左定位.算法族 == 右定位.算法族
        && 左定位.算法版本 == 右定位.算法版本
        && 左定位.原始类型 == 右定位.原始类型
        && 左定位.左角色 == 右定位.左角色 && 左定位.右角色 == 右定位.右角色
        && 左定位.差异方向 == 右定位.差异方向
        && 左定位.允许结果位 == 右定位.允许结果位
        && 左定位.当前有效 == 右定位.当前有效
        && 左定位.边界包含 == 右定位.边界包含
        && 左定位.量化规则 == 右定位.量化规则
        && 左定位.误差合同版本 == 右定位.误差合同版本
        && 左定位.下界 == 右定位.下界 && 左定位.上界 == 右定位.上界;
}
bool 状态迁移合同与请求登记相符(const I64状态迁移比较合同& 合同,
    const I64状态迁移比较合同登记请求& 请求,
    const 特征比较登记& 登记) noexcept {
    return 状态迁移合同完整(合同) && 登记完整(登记)
        && 合同.特征定义 == 请求.特征定义.特征定义
        && 合同.定义标记值 == 请求.特征定义.定义标记值
        && 合同.下界值 == 请求.特征定义.下界值
        && 合同.上界值 == 请求.特征定义.上界值
        && 合同.定义模板关系类型 == 请求.实例登记.定义模板关系类型
        && 合同.当前I64值属性类型 == 请求.实例登记.当前I64值属性类型
        && 合同.单位 == 登记.无单位 && 合同.维度 == 登记.标量维度
        && 合同.分量角色 == 登记.标量分量角色
        && 合同.定义来源服务 == 请求.定义登记.服务身份;
}
std::vector<std::int64_t> 形成状态迁移配置材料(
    std::int64_t 下界, std::int64_t 上界) {
    return {1, 2, 1, 1, 1, 3, 4, 1, 7, 1,
        1, 1, 0, 1, 1, 1, 1, 1, 下界, 上界};
}
std::array<稳定编码, 7> 形成状态迁移关系目标(
    const I64状态迁移比较合同登记请求& 请求,
    const 特征比较登记& 登记) noexcept {
    return {请求.特征定义.特征定义, 请求.实例登记.定义模板关系类型,
        请求.实例登记.当前I64值属性类型, 登记.无单位, 登记.标量维度,
        登记.标量分量角色, 请求.定义登记.服务身份};
}
L1中性写集请求 形成状态迁移合同中性写集(
    const I64状态迁移比较合同登记请求& 请求,
    const 特征比较登记& 登记, std::int64_t 下界, std::int64_t 上界) {
    L1中性写集请求 写集;
    写集.合同版本 = L1中性CRUD合同版本;
    写集.期望事实代次 = 请求.期望事实代次;
    写集.幂等键 = 映射状态迁移合同中性幂等键(请求.幂等身份);
    写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    写集.值 = {{{2}, L1中性写集本地键{1}, 登记.合同配置I64组属性类型,
        形成状态迁移配置材料(下界, 上界), 登记.服务身份}};
    写集.属性槽变更 = {{L1中性写集本地键{1},
        登记.合同配置I64组属性类型, L1中性写集本地键{2}}};
    const auto 目标 = 形成状态迁移关系目标(请求, 登记);
    for (std::uint32_t i = 0; i < 目标.size(); ++i)
        写集.关系.push_back({L1中性写集本地键{3 + i},
            L1中性写集本地键{1}, 目标[i], 登记.合同字段关系类型,
            static_cast<std::int64_t>(i + 1)});
    return 写集;
}
I64状态迁移比较合同 形成状态迁移合同见证(
    const I64状态迁移比较合同登记请求& 请求,
    const 特征比较登记& 登记, 稳定编码 注册, 稳定编码 配置,
    std::int64_t 下界, std::int64_t 上界) noexcept {
    I64状态迁移比较合同 合同;
    合同.注册身份 = 注册;
    合同.配置值 = 配置;
    合同.特征定义 = 请求.特征定义.特征定义;
    合同.定义标记值 = 请求.特征定义.定义标记值;
    合同.下界值 = 请求.特征定义.下界值;
    合同.上界值 = 请求.特征定义.上界值;
    合同.定义模板关系类型 = 请求.实例登记.定义模板关系类型;
    合同.当前I64值属性类型 = 请求.实例登记.当前I64值属性类型;
    合同.单位 = 登记.无单位;
    合同.维度 = 登记.标量维度;
    合同.分量角色 = 登记.标量分量角色;
    合同.定义来源服务 = 请求.定义登记.服务身份;
    合同.下界 = 下界;
    合同.上界 = 上界;
    return 合同;
}
bool 登记完整(const 特征比较登记& 登记) noexcept {
    return 登记.合同版本 == 特征比较合同版本 && 登记.规则版本 == 特征比较规则版本
        && 登记.事实截止代次 != 0 && 有效(登记.服务身份) && 有效(登记.合同配置I64组属性类型)
        && 有效(登记.合同字段关系类型) && 有效(登记.无单位) && 有效(登记.标量维度)
        && 有效(登记.标量分量角色);
}
bool 请求基础有效(const I64目标判断比较合同登记请求& 请求) noexcept {
    return 请求.合同版本 == 特征比较合同版本 && 请求.规则版本 == 特征比较规则版本
        && 身份有效(请求.幂等身份) && 请求.期望事实代次 != 0
        && 特征定义登记完整(请求.定义登记) && 实例特征结构登记完整(请求.实例登记)
        && 有效(请求.特征定义.特征定义) && 有效(请求.特征定义.定义标记值)
        && 有效(请求.特征定义.下界值) && 有效(请求.特征定义.上界值);
}
bool 请求基础有效(const I64状态迁移比较合同登记请求& 请求) noexcept {
    return 请求.合同版本 == 特征比较合同版本 && 请求.规则版本 == 特征比较规则版本
        && 身份有效(请求.幂等身份) && 请求.期望事实代次 != 0
        && 特征定义登记完整(请求.定义登记) && 实例特征结构登记完整(请求.实例登记)
        && 有效(请求.特征定义.特征定义) && 有效(请求.特征定义.定义标记值)
        && 有效(请求.特征定义.下界值) && 有效(请求.特征定义.上界值);
}
bool 迁移合同请求相同(const I64状态迁移比较合同登记请求& 左,
    const I64状态迁移比较合同登记请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份 && 左.期望事实代次 == 右.期望事实代次
        && 左.定义登记.合同版本 == 右.定义登记.合同版本
        && 左.定义登记.规则版本 == 右.定义登记.规则版本
        && 左.定义登记.事实截止代次 == 右.定义登记.事实截止代次
        && 左.定义登记.服务身份 == 右.定义登记.服务身份
        && 左.定义登记.定义标记属性类型 == 右.定义登记.定义标记属性类型
        && 左.定义登记.I64下界属性类型 == 右.定义登记.I64下界属性类型
        && 左.定义登记.I64上界属性类型 == 右.定义登记.I64上界属性类型
        && 定义读取相同(左.特征定义, 右.特征定义)
        && 左.实例登记.合同版本 == 右.实例登记.合同版本
        && 左.实例登记.规则版本 == 右.实例登记.规则版本
        && 左.实例登记.事实截止代次 == 右.实例登记.事实截止代次
        && 左.实例登记.服务身份 == 右.实例登记.服务身份
        && 左.实例登记.宿主槽关系类型 == 右.实例登记.宿主槽关系类型
        && 左.实例登记.定义模板关系类型 == 右.实例登记.定义模板关系类型
        && 左.实例登记.当前I64值属性类型 == 右.实例登记.当前I64值属性类型;
}
状态I64事实见证 形成I64见证(const 值事实& 值) {
    return {值.编码, 值.所属节点, 值.属性类型节点, std::get<std::int64_t>(值.材料),
        值.来源节点, std::nullopt, 值.创建事实代次, 值.退出事实代次, 值.创建事实代次};
}

} // namespace 特征比较内部

class 特征比较服务 final {
public:
    explicit 特征比较服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    特征比较服务(L1事实基座服务& L1, L1状态服务& 状态,
        L1实例特征服务& 实例特征) noexcept
        : L1_(L1), 状态_(&状态), 实例特征_(&实例特征) {}
    特征比较服务(const 特征比较服务&) = delete;
    特征比较服务& operator=(const 特征比较服务&) = delete;

    特征比较登记结果 建立登记(const 特征比较登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(锁_);
            if (请求.合同版本 != 特征比较合同版本 || 请求.规则版本 != 特征比较规则版本
                || !特征比较内部::身份有效(请求.幂等身份) || 请求.期望事实代次 == 0) return {};
            const auto 预读 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (预读.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, std::nullopt};
            if (预读.状态 != L1中性读取状态::成功)
                return {特征比较内部::映射中性读取状态(预读.状态), std::nullopt};
            if (预读.事实代次 == 0)
                return {特征比较状态::内部不一致, std::nullopt};

            const auto 幂等键 = 特征比较内部::映射登记中性幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::属性类型, L1中性值表示种类::I64组},
                {{3}, 节点种类::普通, std::nullopt}, {{4}, 节点种类::普通, std::nullopt},
                {{5}, 节点种类::普通, std::nullopt}, {{6}, 节点种类::普通, std::nullopt}};

            const auto 写入 = L1_.提交中性写集(写集);
            if (写入.状态 != L1中性写入状态::成功
                && 写入.状态 != L1中性写入状态::精确重复)
                return {特征比较内部::映射中性写入状态(写入.状态), std::nullopt};
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 幂等键
                || 写入.事实代次 == 0 || !特征比较内部::中性映射完整唯一(写入, 6))
                return {特征比较状态::内部不一致, std::nullopt};
            if (写入.状态 == L1中性写入状态::成功) {
                if (预读.事实代次 != 请求.期望事实代次
                    || !写入.是否形成内存权威发布
                    || 写入.重试边界 != L1中性重试边界::不适用)
                    return {特征比较状态::内部不一致, std::nullopt};
            } else if (写入.是否形成内存权威发布
                || 写入.重试边界 != L1中性重试边界::原幂等键读回收敛) {
                return {特征比较状态::内部不一致, std::nullopt};
            }

            std::array<稳定编码, 6> 编码组{};
            for (std::uint32_t i = 1; i <= 编码组.size(); ++i) {
                const auto 编码 = 特征比较内部::查找中性映射(写入, i);
                if (!编码) return {特征比较状态::内部不一致, std::nullopt};
                编码组[i - 1] = *编码;
            }
            auto 读回 = 精确读回特征比较登记(编码组, 写入.事实代次);
            if (读回.状态 != 特征比较状态::已比较 || !读回.登记)
                return 读回;
            if (登记_ && !特征比较内部::登记定位相同(*登记_, *读回.登记))
                return {特征比较状态::内部不一致, std::nullopt};
            登记_ = *读回.登记;
            return {特征比较状态::已比较, 登记_};
        } catch (const std::bad_alloc&) { return {特征比较状态::资源失败, std::nullopt}; }
        catch (...) { return {特征比较状态::内部不一致, std::nullopt}; }
    }

    特征比较登记结果 读取当前登记() const {
        try {
            std::lock_guard<std::mutex> 锁(锁_);
            if (!登记_ || !特征比较内部::登记完整(*登记_))
                return {特征比较状态::未注册, std::nullopt};
            const auto& 定位 = *登记_;
            const std::array<稳定编码, 6> 编码组{定位.服务身份,
                定位.合同配置I64组属性类型, 定位.合同字段关系类型,
                定位.无单位, 定位.标量维度, 定位.标量分量角色};
            return 精确读回特征比较登记(编码组, std::nullopt);
        }
        catch (const std::bad_alloc&) { return {特征比较状态::资源失败, std::nullopt}; }
        catch (...) { return {特征比较状态::内部不一致, std::nullopt}; }
    }

    I64目标判断比较合同结果 登记I64目标判断比较合同(
        const I64目标判断比较合同登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 目标锁(目标判断合同锁_);
            if (!特征比较内部::请求基础有效(请求)) return {};

            bool 预期精确重复 = false;
            特征比较登记 登记;
            I64目标判断比较合同 缓存合同;
            {
                std::lock_guard<std::mutex> 锁(锁_);
                if (合同请求_.has_value() != 合同_.has_value())
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                if (合同请求_) {
                    if (!特征比较内部::合同请求相同(*合同请求_, 请求))
                        return {特征比较状态::入口拒绝,
                            比较拒绝原因::注册不唯一, std::nullopt};
                    if (!登记_ || !特征比较内部::登记完整(*登记_)
                        || !特征比较内部::目标判断合同与请求登记相符(
                            *合同_, *合同请求_, *登记_))
                        return {特征比较状态::内部不一致,
                            比较拒绝原因::无, std::nullopt};
                    登记 = *登记_;
                    缓存合同 = *合同_;
                    预期精确重复 = true;
                }
            }

            std::uint64_t 输入代次 = 0;
            std::int64_t 下界 = 0;
            std::int64_t 上界 = 0;
            if (预期精确重复) {
                下界 = 缓存合同.下界;
                上界 = 缓存合同.上界;
            } else {
                const auto 输入结果 = 读取目标判断登记输入(请求);
                if (输入结果.状态 != 特征比较状态::已比较 || !输入结果.输入)
                    return {输入结果.状态, 输入结果.拒绝原因, std::nullopt};
                登记 = 输入结果.输入->登记;
                输入代次 = 输入结果.输入->事实代次;
                下界 = 输入结果.输入->下界;
                上界 = 输入结果.输入->上界;
            }

            const auto 写集 = 特征比较内部::形成目标判断合同中性写集(
                请求, 登记, 下界, 上界);
            const auto 写入 = L1_.提交中性写集(写集);
            if (写入.状态 != L1中性写入状态::成功
                && 写入.状态 != L1中性写入状态::精确重复) {
                switch (写入.状态) {
                case L1中性写入状态::幂等冲突:
                    return {特征比较状态::入口拒绝,
                        比较拒绝原因::注册不唯一, std::nullopt};
                case L1中性写入状态::事实代次漂移:
                case L1中性写入状态::未找到:
                case L1中性写入状态::已退出:
                    return {特征比较状态::版本漂移,
                        比较拒绝原因::输入版本失效, std::nullopt};
                case L1中性写入状态::入口拒绝:
                    return {特征比较状态::入口拒绝,
                        比较拒绝原因::无, std::nullopt};
                case L1中性写入状态::资源失败:
                    return {特征比较状态::资源失败,
                        比较拒绝原因::无, std::nullopt};
                case L1中性写入状态::内部不一致:
                case L1中性写入状态::成功:
                case L1中性写入状态::精确重复:
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                }
            }

            const auto 幂等键 = 特征比较内部::映射目标判断合同中性幂等键(
                请求.幂等身份);
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 幂等键
                || 写入.事实代次 == 0
                || !特征比较内部::中性映射完整唯一(写入, 10))
                return {特征比较状态::内部不一致,
                    比较拒绝原因::无, std::nullopt};
            if (写入.状态 == L1中性写入状态::成功) {
                if (预期精确重复 || 输入代次 != 请求.期望事实代次
                    || !写入.是否形成内存权威发布
                    || 写入.重试边界 != L1中性重试边界::不适用)
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
            } else if (!预期精确重复 || 写入.是否形成内存权威发布
                || 写入.重试边界 != L1中性重试边界::原幂等键读回收敛) {
                return {特征比较状态::内部不一致,
                    比较拒绝原因::无, std::nullopt};
            }

            std::array<稳定编码, 10> 新编码组{};
            for (std::uint32_t i = 1; i <= 新编码组.size(); ++i) {
                const auto 编码 = 特征比较内部::查找中性映射(写入, i);
                if (!编码) return {特征比较状态::内部不一致,
                    比较拒绝原因::无, std::nullopt};
                新编码组[i - 1] = *编码;
            }
            auto 新合同 = 特征比较内部::形成目标判断合同见证(
                请求, 登记, 新编码组[0], 新编码组[1], 下界, 上界);
            新合同.事实截止代次 = 写入.事实代次;
            if (!特征比较内部::目标判断合同完整(新合同))
                return {特征比较状态::内部不一致,
                    比较拒绝原因::无, std::nullopt};
            auto 读回 = 精确读回目标判断合同(登记, 新合同,
                写入.事实代次, 新编码组);
            if (读回.状态 != 特征比较状态::已比较 || !读回.合同)
                return 读回;

            {
                std::lock_guard<std::mutex> 锁(锁_);
                if (合同请求_.has_value() != 合同_.has_value())
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                if (预期精确重复) {
                    if (!合同请求_ || !特征比较内部::合同请求相同(*合同请求_, 请求)
                        || !特征比较内部::目标判断合同定位相同(*合同_, *读回.合同))
                        return {特征比较状态::内部不一致,
                            比较拒绝原因::无, std::nullopt};
                } else if (合同请求_ || 合同_) {
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                }
                if (!登记_ || !特征比较内部::登记定位相同(*登记_, 登记))
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                合同请求_ = 请求;
                合同_ = *读回.合同;
            }
            return {特征比较状态::已比较, 比较拒绝原因::无, 读回.合同};
        } catch (const std::bad_alloc&) { return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt}; }
        catch (...) { return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt}; }
    }

    I64目标判断比较合同结果 读取I64目标判断比较合同(
        const I64目标判断比较合同读取请求& 请求) const {
        try {
            std::lock_guard<std::mutex> 目标锁(目标判断合同锁_);
            if (请求.合同版本 != 特征比较合同版本 || 请求.规则版本 != 特征比较规则版本
                || !有效(请求.注册身份) || !有效(请求.配置值) || !有效(请求.特征定义)
                || 请求.算法版本 != 1) return {};
            I64目标判断比较合同 合同;
            特征比较登记 登记;
            {
                std::lock_guard<std::mutex> 锁(锁_);
                if (合同请求_.has_value() != 合同_.has_value())
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                if (!合同_) return {特征比较状态::未注册,
                    比较拒绝原因::未注册, std::nullopt};
                if (!登记_ || !特征比较内部::登记完整(*登记_)
                    || !特征比较内部::目标判断合同完整(*合同_))
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                登记 = *登记_;
                合同 = *合同_;
            }
            if (请求.注册身份 != 合同.注册身份 || 请求.配置值 != 合同.配置值
                || 请求.特征定义 != 合同.特征定义
                || 请求.算法版本 != 合同.算法版本)
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            return 精确读回目标判断合同(登记, 合同, std::nullopt, std::nullopt);
        } catch (const std::bad_alloc&) { return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt}; }
        catch (...) { return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt}; }
    }

    I64状态迁移比较合同结果 登记I64状态迁移比较合同(
        const I64状态迁移比较合同登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 迁移锁(状态迁移合同锁_);
            if (!特征比较内部::请求基础有效(请求)) return {};

            bool 预期精确重复 = false;
            特征比较登记 登记;
            I64状态迁移比较合同 缓存合同;
            {
                std::lock_guard<std::mutex> 锁(锁_);
                if (迁移合同请求_.has_value() != 迁移合同_.has_value())
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                if (迁移合同请求_) {
                    if (!特征比较内部::迁移合同请求相同(*迁移合同请求_, 请求))
                        return {特征比较状态::入口拒绝,
                            比较拒绝原因::注册不唯一, std::nullopt};
                    if (!登记_ || !特征比较内部::登记完整(*登记_)
                        || !特征比较内部::状态迁移合同与请求登记相符(
                            *迁移合同_, *迁移合同请求_, *登记_))
                        return {特征比较状态::内部不一致,
                            比较拒绝原因::无, std::nullopt};
                    登记 = *登记_;
                    缓存合同 = *迁移合同_;
                    预期精确重复 = true;
                }
            }

            std::uint64_t 输入代次 = 0;
            std::int64_t 下界 = 0;
            std::int64_t 上界 = 0;
            if (预期精确重复) {
                下界 = 缓存合同.下界;
                上界 = 缓存合同.上界;
            } else {
                const auto 输入结果 = 读取状态迁移登记输入(请求);
                if (输入结果.状态 != 特征比较状态::已比较 || !输入结果.输入)
                    return {输入结果.状态, 输入结果.拒绝原因, std::nullopt};
                登记 = 输入结果.输入->登记;
                输入代次 = 输入结果.输入->事实代次;
                下界 = 输入结果.输入->下界;
                上界 = 输入结果.输入->上界;
            }

            const auto 写集 = 特征比较内部::形成状态迁移合同中性写集(
                请求, 登记, 下界, 上界);
            const auto 写入 = L1_.提交中性写集(写集);
            if (写入.状态 != L1中性写入状态::成功
                && 写入.状态 != L1中性写入状态::精确重复) {
                switch (写入.状态) {
                case L1中性写入状态::幂等冲突:
                    return {特征比较状态::入口拒绝,
                        比较拒绝原因::注册不唯一, std::nullopt};
                case L1中性写入状态::事实代次漂移:
                case L1中性写入状态::未找到:
                case L1中性写入状态::已退出:
                    return {特征比较状态::版本漂移,
                        比较拒绝原因::输入版本失效, std::nullopt};
                case L1中性写入状态::入口拒绝:
                    return {特征比较状态::入口拒绝,
                        比较拒绝原因::无, std::nullopt};
                case L1中性写入状态::资源失败:
                    return {特征比较状态::资源失败,
                        比较拒绝原因::无, std::nullopt};
                case L1中性写入状态::内部不一致:
                case L1中性写入状态::成功:
                case L1中性写入状态::精确重复:
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                }
            }

            const auto 幂等键 = 特征比较内部::映射状态迁移合同中性幂等键(
                请求.幂等身份);
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 幂等键
                || 写入.事实代次 == 0
                || !特征比较内部::中性映射完整唯一(写入, 9))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (写入.状态 == L1中性写入状态::成功) {
                if (预期精确重复 || 输入代次 != 请求.期望事实代次
                    || !写入.是否形成内存权威发布
                    || 写入.重试边界 != L1中性重试边界::不适用)
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
            } else if (!预期精确重复 || 写入.是否形成内存权威发布
                || 写入.重试边界 != L1中性重试边界::原幂等键读回收敛) {
                return {特征比较状态::内部不一致,
                    比较拒绝原因::无, std::nullopt};
            }

            std::array<稳定编码, 9> 新编码组{};
            for (std::uint32_t i = 1; i <= 新编码组.size(); ++i) {
                const auto 编码 = 特征比较内部::查找中性映射(写入, i);
                if (!编码) return {特征比较状态::内部不一致,
                    比较拒绝原因::无, std::nullopt};
                新编码组[i - 1] = *编码;
            }
            auto 新合同 = 特征比较内部::形成状态迁移合同见证(
                请求, 登记, 新编码组[0], 新编码组[1], 下界, 上界);
            新合同.事实截止代次 = 写入.事实代次;
            if (!特征比较内部::状态迁移合同完整(新合同))
                return {特征比较状态::内部不一致,
                    比较拒绝原因::无, std::nullopt};
            auto 读回 = 精确读回状态迁移合同(登记, 请求, 新合同,
                写入.事实代次, 新编码组);
            if (读回.状态 != 特征比较状态::已比较 || !读回.合同)
                return 读回;

            {
                std::lock_guard<std::mutex> 锁(锁_);
                if (迁移合同请求_.has_value() != 迁移合同_.has_value())
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                if (预期精确重复) {
                    if (!迁移合同请求_
                        || !特征比较内部::迁移合同请求相同(*迁移合同请求_, 请求)
                        || !特征比较内部::状态迁移合同定位相同(
                            *迁移合同_, *读回.合同))
                        return {特征比较状态::内部不一致,
                            比较拒绝原因::无, std::nullopt};
                } else if (迁移合同请求_ || 迁移合同_) {
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                }
                if (!登记_ || !特征比较内部::登记定位相同(*登记_, 登记))
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                迁移合同请求_ = 请求;
                迁移合同_ = *读回.合同;
            }
            return {特征比较状态::已比较, 比较拒绝原因::无, 读回.合同};
        } catch (const std::bad_alloc&) {
            return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
        } catch (...) {
            return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
        }
    }

    I64状态迁移比较合同结果 读取I64状态迁移比较合同(
        const I64状态迁移比较合同读取请求& 请求) const {
        try {
            std::lock_guard<std::mutex> 迁移锁(状态迁移合同锁_);
            if (请求.合同版本 != 特征比较合同版本 || 请求.规则版本 != 特征比较规则版本
                || !有效(请求.注册身份) || !有效(请求.配置值) || !有效(请求.特征定义)
                || 请求.算法版本 != 1) return {};
            I64状态迁移比较合同 合同;
            I64状态迁移比较合同登记请求 登记请求;
            特征比较登记 登记;
            {
                std::lock_guard<std::mutex> 锁(锁_);
                if (迁移合同请求_.has_value() != 迁移合同_.has_value())
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                if (!迁移合同_) return {特征比较状态::未注册,
                    比较拒绝原因::未注册, std::nullopt};
                if (!登记_ || !特征比较内部::登记完整(*登记_)
                    || !特征比较内部::状态迁移合同与请求登记相符(
                        *迁移合同_, *迁移合同请求_, *登记_))
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};
                登记 = *登记_;
                登记请求 = *迁移合同请求_;
                合同 = *迁移合同_;
            }
            if (请求.注册身份 != 合同.注册身份 || 请求.配置值 != 合同.配置值
                || 请求.特征定义 != 合同.特征定义
                || 请求.算法版本 != 合同.算法版本)
                return {特征比较状态::版本漂移, 比较拒绝原因::输入版本失效, std::nullopt};
            return 精确读回状态迁移合同(
                登记, 登记请求, 合同, std::nullopt, std::nullopt);
        } catch (const std::bad_alloc&) {
            return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
        } catch (...) {
            return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
        }
    }

    I64状态迁移比较结果 比较I64状态迁移(const I64状态迁移比较请求& 请求) const {
        if (请求.合同版本 != 特征比较合同版本 || 请求.规则版本 != 特征比较规则版本
            || 请求.请求身份 == 0 || 请求.预期事实截止代次 == 0
            || !实际存在I64基准状态读取请求有效(请求.前状态)
            || !实际存在I64实例特征读取请求有效(请求.后当前)
            || !状态_ || !实例特征_)
            return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::请求身份或特征定义不完整);
        try {
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const auto 起始 = L1_.读取完整快照({});
                if (起始.状态 == L1读取状态::资源失败)
                    return 迁移失败(请求, 特征比较状态::资源失败, 比较拒绝原因::无);
                if (起始.状态 != L1读取状态::成功 || !起始.快照)
                    return 迁移失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
                const auto G = 起始.快照->事实代次;
                if (G != 请求.预期事实截止代次)
                    return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
                const auto 前 = 状态_->读取实际存在I64基准状态(请求.前状态);
                const auto 后 = 实例特征_->读取实际存在I64实例特征(请求.后当前);
                const auto 结束 = L1_.读取完整快照({});
                if (结束.状态 == L1读取状态::资源失败)
                    return 迁移失败(请求, 特征比较状态::资源失败, 比较拒绝原因::无);
                if (结束.状态 != L1读取状态::成功 || !结束.快照)
                    return 迁移失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
                if (结束.快照->事实代次 != G) {
                    if (尝试 == 0) continue;
                    return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
                }
                const auto 前失败 = 映射前状态失败(请求, 前);
                if (前失败) return *前失败;
                const auto 后失败 = 映射后当前失败(请求, 后);
                if (后失败) return *后失败;
                if (!前.事实 || !后.事实 || 前.事实->读取事实截止代次 != G
                    || 后.事实->事实截止代次 != G)
                    return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
                I64状态迁移比较合同 合同;
                特征比较登记 登记;
                {
                    std::lock_guard<std::mutex> 锁(锁_);
                    if (!迁移合同_ || !登记_)
                        return 迁移失败(请求, 特征比较状态::未注册, 比较拒绝原因::未注册);
                    合同 = *迁移合同_; 登记 = *登记_;
                }
                const auto 已解析 = 解析迁移合同(*结束.快照, 登记, 合同);
                if (!已解析)
                    return 迁移失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
                合同 = *已解析;
                const auto& 左 = *前.事实;
                const auto& 右 = *后.事实;
                if (左.主体.编码 != 右.宿主 || 左.特征.编码 != 右.实例槽
                    || 左.场景.编码 != 请求.后当前.宿主.当前场景.初始场景)
                    return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::左右角色不合法);
                if (右.特征定义 != 合同.特征定义 || 右.特征定义 != 请求.后当前.定义.特征定义
                    || 后.定义关系 != 请求.后当前.定义关系)
                    return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::请求身份或特征定义不完整);
                const auto* 定义关系 = 特征比较内部::找关系(*结束.快照, 后.定义关系);
                const auto* 当前值 = 特征比较内部::找值(*结束.快照, 右.当前值);
                const auto* 当前槽 = 特征比较内部::找节点(*结束.快照, 右.实例槽);
                if (!定义关系 || 定义关系->源节点 != 右.实例槽
                    || 定义关系->目标节点 != 合同.特征定义
                    || 定义关系->关系类型节点 != 合同.定义模板关系类型)
                    return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::请求身份或特征定义不完整);
                if (!当前值 || !当前槽 || !特征比较内部::当前槽指向(当前槽,
                    合同.当前I64值属性类型, 右.当前值))
                    return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
                if (左.被采样P8值.属性类型 != 合同.当前I64值属性类型
                    || 当前值->属性类型节点 != 合同.当前I64值属性类型)
                    return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::原始类型不匹配);
                const auto 新值 = 特征比较内部::取I64(当前值);
                const auto 旧值 = 左.采样I64值.材料;
                if (!新值 || *新值 != 右.I64值 || 当前值->所属节点 != 右.实例槽
                    || 当前值->来源节点 != 右.来源节点)
                    return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
                if (左.被采样P8值.编码 == 当前值->编码 || !左.被采样P8值.退出事实代次
                    || 当前值->创建事实代次 < *左.被采样P8值.退出事实代次
                    || 左.状态.创建事实代次 >= *左.被采样P8值.退出事实代次
                    || 左.发生时间.材料.size() != 1 || 左.发生时间.材料.front() == 0)
                    return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::时间基准不成立);
                if (旧值 < 合同.下界 || 旧值 > 合同.上界 || *新值 < 合同.下界 || *新值 > 合同.上界)
                    return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::值域不允许);
                const bool 溢出 = (旧值 < 0 && *新值 > (std::numeric_limits<std::int64_t>::max)() + 旧值)
                    || (旧值 > 0 && *新值 < (std::numeric_limits<std::int64_t>::min)() + 旧值);
                if (溢出)
                    return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::差异不可表示);
                const std::int8_t 排序 = 旧值 < *新值 ? -1 : (旧值 > *新值 ? 1 : 0);
                const auto 关系 = 排序 < 0 ? 特征比较具名关系::状态迁移增加
                    : (排序 > 0 ? 特征比较具名关系::状态迁移减少 : 特征比较具名关系::状态迁移等价);
                I64状态迁移比较结果 结果;
                结果.比较.请求身份 = 请求.请求身份; 结果.比较.状态 = 特征比较状态::已比较;
                结果.比较.事实截止代次 = G; 结果.比较.注册身份 = 合同.注册身份;
                结果.比较.算法版本 = 合同.算法版本; 结果.比较.排序三态 = 排序;
                结果.比较.具名关系 = 关系; 结果.比较.差异材料 = I64差异材料{
                    特征比较原始类型::I64, *新值 - 旧值, 合同.单位, 合同.维度,
                    合同.分量角色, 合同.差异方向, 合同.算法版本, true};
                结果.比较.边界包含 = 合同.边界包含; 结果.比较.量化规则 = 合同.量化规则;
                结果.比较.误差合同版本 = 合同.误差合同版本; 结果.比较.实际单位 = 合同.单位;
                结果.比较.实际维度 = 合同.维度; 结果.比较.实际分量角色 = 合同.分量角色;
                结果.比较.实际左角色 = 合同.左角色; 结果.比较.实际右角色 = 合同.右角色;
                结果.比较.实际方向 = 合同.差异方向;
                结果.比较.左输入回执 = 特征比较输入版本回执{左.被采样P8值.编码,
                    左.被采样P8值.来源节点, 左.被采样P8值.创建事实代次};
                结果.比较.右输入回执 = 特征比较输入版本回执{当前值->编码,
                    当前值->来源节点, 当前值->创建事实代次};
                结果.等价 = 排序 == 0;
                I64状态迁移后当前见证 后见证;
                后见证.事实截止代次 = G; 后见证.主体 = 右.宿主;
                后见证.当前场景 = 请求.后当前.宿主.当前场景.初始场景;
                后见证.当前场景归属关系 = 请求.后当前.宿主.当前场景归属关系;
                后见证.实例槽 = 右.实例槽; 后见证.特征定义 = 右.特征定义;
                后见证.宿主关系 = 后.宿主关系; 后见证.定义关系 = 后.定义关系;
                后见证.当前值 = 特征比较内部::形成I64见证(*当前值);
                结果.输入 = I64状态迁移完整输入见证{左, 后见证};
                return 结果;
            }
            return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
        } catch (const std::bad_alloc&) {
            return 迁移失败(请求, 特征比较状态::资源失败, 比较拒绝原因::无);
        } catch (...) {
            return 迁移失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
        }
    }

    特征比较结果 比较特征(const 特征比较请求& 请求) const {
        try {
            if (请求.合同版本 != 特征比较合同版本)
                return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::请求合同版本不匹配);
            if (请求.规则版本 != 特征比较规则版本 || 请求.请求身份 == 0
                || !有效(请求.特征定义) || 请求.用途 != 特征比较用途::目标判断
                || !有效(请求.左.实例槽) || !有效(请求.左.定义关系) || !有效(请求.左.当前值)
                || !有效(请求.左.来源节点) || 请求.左.创建事实代次 == 0
                || !有效(请求.右.目标值) || !有效(请求.右.来源节点) || 请求.右.创建事实代次 == 0
                || !有效(请求.单位) || !有效(请求.维度) || !有效(请求.分量角色)
                || 请求.左角色 != 特征比较角色::当前事实 || 请求.右角色 != 特征比较角色::目标状态)
                return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::请求身份或特征定义不完整);
            if (请求.要求结果位 == 0 || 请求.要求结果位 > 7)
                return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::要求结果组合不支持);
            I64目标判断比较合同 合同;
            特征比较登记 登记;
            { std::lock_guard<std::mutex> 锁(锁_); if (!登记_ || !合同_)
                return 失败(请求, 特征比较状态::未注册, 比较拒绝原因::未注册);
              登记 = *登记_; 合同 = *合同_; }
            if (!合同.当前有效) return 失败(请求, 特征比较状态::未注册, 比较拒绝原因::注册失效);
            if ((请求.预期算法族 && *请求.预期算法族 != 合同.算法族)
                || (请求.预期算法版本 && *请求.预期算法版本 != 合同.算法版本))
                return 失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::算法版本不匹配, 合同);
            if (请求.单位 != 合同.单位) return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::单位不匹配);
            if (请求.维度 != 合同.维度) return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::维度不匹配);
            if (请求.分量角色 != 合同.分量角色) return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::左右角色不合法);

            const auto 快照结果 = L1_.读取完整快照({});
            if (快照结果.状态 == L1读取状态::资源失败)
                return 失败(请求, 特征比较状态::资源失败, 比较拒绝原因::无);
            if (快照结果.状态 != L1读取状态::成功 || !快照结果.快照)
                return 失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
            const auto& 快照 = *快照结果.快照;
            if (快照.事实代次 != 请求.预期事实截止代次)
                return 失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效, 合同);
            const auto 解析 = 解析合同(快照, 登记, 合同);
            if (!解析) return 失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
            std::size_t 路由数 = 0;
            for (const auto& 关系 : 快照.当前关系)
                if (关系.关系类型节点 == 登记.合同字段关系类型 && 关系.角色或顺序 == 1
                    && 关系.目标节点 == 合同.特征定义) ++路由数;
            if (路由数 != 1) return 失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::注册不唯一);
            if (请求.特征定义 != 合同.特征定义 || 请求.右.目标值 != 合同.上界值)
                return 失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效, 合同);
            const auto* 左槽 = 特征比较内部::找节点(快照, 请求.左.实例槽);
            const auto* 定义关系 = 特征比较内部::找关系(快照, 请求.左.定义关系);
            const auto* 左值事实 = 特征比较内部::找值(快照, 请求.左.当前值);
            const auto* 右值事实 = 特征比较内部::找值(快照, 请求.右.目标值);
            const auto 左值 = 特征比较内部::取I64(左值事实);
            const auto 右值 = 特征比较内部::取I64(右值事实);
            if (!左槽 || !定义关系 || !左值 || !右值
                || !特征比较内部::当前槽指向(左槽, 合同.当前I64值属性类型, 请求.左.当前值)
                || 定义关系->源节点 != 请求.左.实例槽 || 定义关系->目标节点 != 合同.特征定义
                || 定义关系->关系类型节点 != 合同.定义模板关系类型
                || 左值事实->所属节点 != 请求.左.实例槽
                || 左值事实->属性类型节点 != 合同.当前I64值属性类型
                || 左值事实->来源节点 != 请求.左.来源节点
                || 左值事实->创建事实代次 != 请求.左.创建事实代次 || *左值 != 请求.左.预计值
                || 右值事实->所属节点 != 合同.特征定义
                || 右值事实->属性类型节点 != 合同.目标I64值属性类型
                || 右值事实->来源节点 != 请求.右.来源节点
                || 右值事实->创建事实代次 != 请求.右.创建事实代次 || *右值 != 请求.右.预计值)
                return 失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效, 合同);
            if (*左值 < 合同.下界 || *左值 > 合同.上界 || *右值 < 合同.下界 || *右值 > 合同.上界)
                return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::值域不允许);
            std::int8_t 排序 = *左值 < *右值 ? -1 : (*左值 > *右值 ? 1 : 0);
            const auto 关系 = 排序 < 0 ? 特征比较具名关系::当前低于目标
                : (排序 > 0 ? 特征比较具名关系::当前高于目标 : 特征比较具名关系::当前达到目标);
            std::optional<std::int64_t> 差异;
            if ((请求.要求结果位 & 4U) != 0) {
                const bool 溢出 = (*左值 < 0 && *右值 > (std::numeric_limits<std::int64_t>::max)() + *左值)
                    || (*左值 > 0 && *右值 < (std::numeric_limits<std::int64_t>::min)() + *左值);
                if (溢出) return 失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::差异不可表示);
                差异 = *右值 - *左值;
            }
            特征比较结果 结果;
            结果.请求身份 = 请求.请求身份; 结果.状态 = 特征比较状态::已比较;
            结果.事实截止代次 = 快照.事实代次; 结果.注册身份 = 合同.注册身份; 结果.算法版本 = 合同.算法版本;
            if ((请求.要求结果位 & 1U) != 0) 结果.排序三态 = 排序;
            if ((请求.要求结果位 & 2U) != 0) 结果.具名关系 = 关系;
            if (差异) 结果.差异材料 = I64差异材料{特征比较原始类型::I64, *差异,
                合同.单位, 合同.维度, 合同.分量角色, 合同.差异方向, 合同.算法版本, true};
            结果.边界包含 = 合同.边界包含; 结果.量化规则 = 合同.量化规则;
            结果.误差合同版本 = 合同.误差合同版本; 结果.实际单位 = 合同.单位;
            结果.实际维度 = 合同.维度; 结果.实际分量角色 = 合同.分量角色;
            结果.实际左角色 = 合同.左角色; 结果.实际右角色 = 合同.右角色; 结果.实际方向 = 合同.差异方向;
            结果.左输入回执 = 特征比较输入版本回执{请求.左.当前值, 请求.左.来源节点, 请求.左.创建事实代次};
            结果.右输入回执 = 特征比较输入版本回执{请求.右.目标值, 请求.右.来源节点, 请求.右.创建事实代次};
            return 结果;
        } catch (const std::bad_alloc&) { return 失败(请求, 特征比较状态::资源失败, 比较拒绝原因::无); }
        catch (...) { return 失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无); }
    }

private:
    enum class 目标判断中性读取裁决 : std::uint8_t {
        通过, 代次漂移, 输入失效, 资源失败, 内部不一致
    };

    struct 目标判断登记输入束 final {
        特征比较登记 登记;
        std::uint64_t 事实代次 = 0;
        std::int64_t 下界 = 0;
        std::int64_t 上界 = 0;
    };

    struct 目标判断登记输入结果 final {
        特征比较状态 状态 = 特征比较状态::内部不一致;
        比较拒绝原因 拒绝原因 = 比较拒绝原因::无;
        std::optional<目标判断登记输入束> 输入;
    };

    struct 状态迁移登记输入束 final {
        特征比较登记 登记;
        std::uint64_t 事实代次 = 0;
        std::int64_t 下界 = 0;
        std::int64_t 上界 = 0;
    };

    struct 状态迁移登记输入结果 final {
        特征比较状态 状态 = 特征比较状态::内部不一致;
        比较拒绝原因 拒绝原因 = 比较拒绝原因::无;
        std::optional<状态迁移登记输入束> 输入;
    };

    static I64目标判断比较合同结果 形成目标判断读取失败(
        目标判断中性读取裁决 裁决) noexcept {
        switch (裁决) {
        case 目标判断中性读取裁决::代次漂移:
        case 目标判断中性读取裁决::输入失效:
            return {特征比较状态::版本漂移, 比较拒绝原因::输入版本失效, std::nullopt};
        case 目标判断中性读取裁决::资源失败:
            return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
        case 目标判断中性读取裁决::通过:
        case 目标判断中性读取裁决::内部不一致:
            return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
        }
        return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
    }

    static I64状态迁移比较合同结果 形成状态迁移读取失败(
        目标判断中性读取裁决 裁决) noexcept {
        switch (裁决) {
        case 目标判断中性读取裁决::代次漂移:
        case 目标判断中性读取裁决::输入失效:
            return {特征比较状态::版本漂移,
                比较拒绝原因::输入版本失效, std::nullopt};
        case 目标判断中性读取裁决::资源失败:
            return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
        case 目标判断中性读取裁决::通过:
        case 目标判断中性读取裁决::内部不一致:
            return {特征比较状态::内部不一致,
                比较拒绝原因::无, std::nullopt};
        }
        return {特征比较状态::内部不一致,
            比较拒绝原因::无, std::nullopt};
    }

    static 目标判断中性读取裁决 核对中性节点读取(
        const L1中性节点读取结果& 结果, 稳定编码 期望编码,
        std::uint64_t 期望代次, bool 缺失视为输入失效,
        L1中性节点事实& 事实) noexcept {
        if (结果.合同版本 != L1中性CRUD合同版本 || 结果.查询编码 != 期望编码)
            return 目标判断中性读取裁决::内部不一致;
        if (结果.状态 == L1中性读取状态::资源失败)
            return 目标判断中性读取裁决::资源失败;
        if (结果.状态 == L1中性读取状态::未找到
            || 结果.状态 == L1中性读取状态::已退出
            || 结果.状态 == L1中性读取状态::属性未设置)
            return 缺失视为输入失效 ? 目标判断中性读取裁决::输入失效
                : 目标判断中性读取裁决::内部不一致;
        if (结果.状态 != L1中性读取状态::成功)
            return 目标判断中性读取裁决::内部不一致;
        if (结果.读取事实代次 != 期望代次)
            return 目标判断中性读取裁决::代次漂移;
        if (!结果.事实 || 结果.事实->编码 != 期望编码
            || 结果.事实->退出事实代次 || 结果.事实->创建事实代次 == 0
            || 结果.事实->创建事实代次 > 期望代次)
            return 目标判断中性读取裁决::内部不一致;
        事实 = *结果.事实;
        return 目标判断中性读取裁决::通过;
    }

    static 目标判断中性读取裁决 核对中性值读取(
        const L1中性值读取结果& 结果, 稳定编码 期望编码,
        std::uint64_t 期望代次, bool 缺失视为输入失效,
        L1中性值事实& 事实) noexcept {
        if (结果.合同版本 != L1中性CRUD合同版本 || 结果.查询编码 != 期望编码)
            return 目标判断中性读取裁决::内部不一致;
        if (结果.状态 == L1中性读取状态::资源失败)
            return 目标判断中性读取裁决::资源失败;
        if (结果.状态 == L1中性读取状态::未找到
            || 结果.状态 == L1中性读取状态::已退出
            || 结果.状态 == L1中性读取状态::属性未设置)
            return 缺失视为输入失效 ? 目标判断中性读取裁决::输入失效
                : 目标判断中性读取裁决::内部不一致;
        if (结果.状态 != L1中性读取状态::成功)
            return 目标判断中性读取裁决::内部不一致;
        if (结果.读取事实代次 != 期望代次)
            return 目标判断中性读取裁决::代次漂移;
        if (!结果.事实 || 结果.事实->编码 != 期望编码
            || 结果.事实->退出事实代次 || 结果.事实->创建事实代次 == 0
            || 结果.事实->创建事实代次 > 期望代次)
            return 目标判断中性读取裁决::内部不一致;
        事实 = *结果.事实;
        return 目标判断中性读取裁决::通过;
    }

    目标判断登记输入结果 读取目标判断登记输入(
        const I64目标判断比较合同登记请求& 请求) const {
        for (int 尝试 = 0; 尝试 < 2; ++尝试) {
            const auto 登记结果 = 读取当前登记();
            if (登记结果.状态 == 特征比较状态::版本漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            if (登记结果.状态 == 特征比较状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (登记结果.状态 == 特征比较状态::未注册)
                return {特征比较状态::未注册,
                    比较拒绝原因::未注册, std::nullopt};
            if (登记结果.状态 != 特征比较状态::已比较 || !登记结果.登记
                || !特征比较内部::登记完整(*登记结果.登记))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            const auto G0 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G0.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 != L1中性读取状态::成功 || G0.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            const auto G = G0.事实代次;
            if (登记结果.登记->事实截止代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            const auto 定义读取 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 请求.特征定义.特征定义});
            const auto 标记读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 请求.特征定义.定义标记值});
            const auto 下界读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 请求.特征定义.下界值});
            const auto 上界读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 请求.特征定义.上界值});
            const auto 目标编码 = 特征比较内部::形成目标判断关系目标(
                请求, *登记结果.登记);
            std::array<L1中性节点读取结果, 8> 目标读取{};
            for (std::size_t i = 0; i < 目标编码.size(); ++i)
                目标读取[i] = L1_.读取中性当前节点(
                    {L1中性CRUD合同版本, 目标编码[i]});

            bool 发生代次漂移 = false;
            L1中性节点事实 定义事实;
            auto 裁决 = 核对中性节点读取(定义读取,
                请求.特征定义.特征定义, G, true, 定义事实);
            if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
            else if (裁决 != 目标判断中性读取裁决::通过)
                return {形成目标判断读取失败(裁决).状态,
                    形成目标判断读取失败(裁决).拒绝原因, std::nullopt};

            L1中性值事实 标记事实, 下界事实, 上界事实;
            const std::array<const L1中性值读取结果*, 3> 值读取{
                &标记读取, &下界读取, &上界读取};
            const std::array<稳定编码, 3> 值编码{请求.特征定义.定义标记值,
                请求.特征定义.下界值, 请求.特征定义.上界值};
            std::array<L1中性值事实*, 3> 值事实{&标记事实, &下界事实, &上界事实};
            for (std::size_t i = 0; i < 值读取.size(); ++i) {
                裁决 = 核对中性值读取(*值读取[i], 值编码[i], G, true, *值事实[i]);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过) {
                    const auto 失败 = 形成目标判断读取失败(裁决);
                    return {失败.状态, 失败.拒绝原因, std::nullopt};
                }
            }
            for (std::size_t i = 0; i < 目标读取.size(); ++i) {
                L1中性节点事实 目标事实;
                裁决 = 核对中性节点读取(目标读取[i], 目标编码[i], G, true, 目标事实);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过) {
                    const auto 失败 = 形成目标判断读取失败(裁决);
                    return {失败.状态, 失败.拒绝原因, std::nullopt};
                }
            }
            if (发生代次漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            const auto 标记 = 特征比较内部::取中性I64(标记事实);
            const auto 下界 = 特征比较内部::取中性I64(下界事实);
            const auto 上界 = 特征比较内部::取中性I64(上界事实);
            if (!标记 || *标记 != 1 || !下界 || !上界 || *下界 > *上界
                || 标记事实.所属节点 != 请求.特征定义.特征定义
                || 标记事实.属性类型节点 != 请求.定义登记.定义标记属性类型
                || 标记事实.来源节点 != 请求.定义登记.服务身份
                || 下界事实.所属节点 != 请求.特征定义.特征定义
                || 下界事实.属性类型节点 != 请求.定义登记.I64下界属性类型
                || 下界事实.来源节点 != 请求.定义登记.服务身份
                || 上界事实.所属节点 != 请求.特征定义.特征定义
                || 上界事实.属性类型节点 != 请求.定义登记.I64上界属性类型
                || 上界事实.来源节点 != 请求.定义登记.服务身份)
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};

            const auto G1 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G1.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 != L1中性读取状态::成功 || G1.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.事实代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            return {特征比较状态::已比较, 比较拒绝原因::无,
                目标判断登记输入束{*登记结果.登记, G, *下界, *上界}};
        }
        return {特征比较状态::版本漂移,
            比较拒绝原因::输入版本失效, std::nullopt};
    }

    I64目标判断比较合同结果 精确读回目标判断合同(
        const 特征比较登记& 登记定位, const I64目标判断比较合同& 合同见证,
        std::optional<std::uint64_t> 首次创建代次,
        const std::optional<std::array<稳定编码, 10>>& 新编码组) const {
        if (!特征比较内部::登记完整(登记定位)
            || !特征比较内部::目标判断合同完整(合同见证)
            || (首次创建代次 && *首次创建代次 == 0))
            return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
        if (新编码组 && ((*新编码组)[0] != 合同见证.注册身份
            || (*新编码组)[1] != 合同见证.配置值))
            return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

        for (int 尝试 = 0; 尝试 < 2; ++尝试) {
            const auto 登记结果 = 读取当前登记();
            if (登记结果.状态 == 特征比较状态::版本漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            if (登记结果.状态 == 特征比较状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (登记结果.状态 != 特征比较状态::已比较 || !登记结果.登记
                || !特征比较内部::登记定位相同(*登记结果.登记, 登记定位))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            const auto G0 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G0.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 != L1中性读取状态::成功 || G0.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            const auto G = G0.事实代次;
            if (登记结果.登记->事实截止代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            const auto 注册读取 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 合同见证.注册身份});
            const auto 配置读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 合同见证.配置值});
            const auto 属性读取 = L1_.读取中性当前属性({L1中性CRUD合同版本,
                合同见证.注册身份, 登记定位.合同配置I64组属性类型});
            const auto 关系读取 = L1_.读取中性当前源关系组({L1中性CRUD合同版本,
                合同见证.注册身份, 登记定位.合同字段关系类型});
            const std::array<稳定编码, 8> 目标编码{合同见证.特征定义,
                合同见证.定义模板关系类型, 合同见证.当前I64值属性类型,
                合同见证.目标I64值属性类型, 合同见证.单位, 合同见证.维度,
                合同见证.分量角色, 合同见证.定义来源服务};
            std::array<L1中性节点读取结果, 8> 目标读取{};
            for (std::size_t i = 0; i < 目标编码.size(); ++i)
                目标读取[i] = L1_.读取中性当前节点(
                    {L1中性CRUD合同版本, 目标编码[i]});
            const std::array<稳定编码, 3> 定义值编码{合同见证.定义标记值,
                合同见证.下界值, 合同见证.上界值};
            std::array<L1中性值读取结果, 3> 定义值读取{};
            for (std::size_t i = 0; i < 定义值编码.size(); ++i)
                定义值读取[i] = L1_.读取中性当前值(
                    {L1中性CRUD合同版本, 定义值编码[i]});

            bool 发生代次漂移 = false;
            L1中性节点事实 注册事实;
            auto 裁决 = 核对中性节点读取(注册读取, 合同见证.注册身份,
                G, false, 注册事实);
            if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
            else if (裁决 != 目标判断中性读取裁决::通过)
                return 形成目标判断读取失败(裁决);
            L1中性值事实 配置事实;
            裁决 = 核对中性值读取(配置读取, 合同见证.配置值,
                G, false, 配置事实);
            if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
            else if (裁决 != 目标判断中性读取裁决::通过)
                return 形成目标判断读取失败(裁决);

            if (属性读取.合同版本 != L1中性CRUD合同版本
                || 属性读取.节点 != 合同见证.注册身份
                || 属性读取.属性类型 != 登记定位.合同配置I64组属性类型)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (属性读取.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (属性读取.状态 != L1中性读取状态::成功 || !属性读取.当前值
                || *属性读取.当前值 != 合同见证.配置值)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (属性读取.读取事实代次 != G) 发生代次漂移 = true;

            if (关系读取.合同版本 != L1中性CRUD合同版本
                || 关系读取.源节点 != 合同见证.注册身份
                || 关系读取.关系类型节点 != 登记定位.合同字段关系类型)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (关系读取.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (关系读取.状态 != L1中性读取状态::成功)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (关系读取.读取事实代次 != G) 发生代次漂移 = true;

            for (std::size_t i = 0; i < 目标读取.size(); ++i) {
                L1中性节点事实 目标事实;
                裁决 = 核对中性节点读取(目标读取[i], 目标编码[i], G, false, 目标事实);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过)
                    return 形成目标判断读取失败(裁决);
            }
            std::array<L1中性值事实, 3> 定义值事实{};
            for (std::size_t i = 0; i < 定义值读取.size(); ++i) {
                裁决 = 核对中性值读取(定义值读取[i], 定义值编码[i],
                    G, false, 定义值事实[i]);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过)
                    return 形成目标判断读取失败(裁决);
            }
            if (发生代次漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            if (注册事实.种类 != 节点种类::普通 || 注册事实.属性类型表示
                || 配置事实.所属节点 != 合同见证.注册身份
                || 配置事实.属性类型节点 != 登记定位.合同配置I64组属性类型
                || 配置事实.来源节点 != 登记定位.服务身份)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            const auto* 配置材料 = std::get_if<std::vector<std::int64_t>>(&配置事实.材料);
            if (!配置材料 || *配置材料 != 特征比较内部::形成目标判断配置材料(
                    合同见证.下界, 合同见证.上界))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            std::size_t 配置槽数量 = 0;
            for (const auto& 槽 : 注册事实.当前属性)
                if (槽.属性类型节点 == 登记定位.合同配置I64组属性类型) {
                    ++配置槽数量;
                    if (槽.当前值 != 合同见证.配置值)
                        return {特征比较状态::内部不一致,
                            比较拒绝原因::无, std::nullopt};
                }
            if (配置槽数量 != 1)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            if (关系读取.关系组.size() != 8)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            std::array<bool, 8> 角色已有{};
            std::uint64_t 共同创建代次 = 注册事实.创建事实代次;
            if (共同创建代次 == 0 || 配置事实.创建事实代次 != 共同创建代次)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            for (const auto& 关系 : 关系读取.关系组) {
                if (!有效(关系.编码) || 关系.退出事实代次
                    || 关系.源节点 != 合同见证.注册身份
                    || 关系.关系类型节点 != 登记定位.合同字段关系类型
                    || 关系.角色或顺序 < 1 || 关系.角色或顺序 > 8
                    || 关系.创建事实代次 != 共同创建代次)
                    return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
                const auto 索引 = static_cast<std::size_t>(关系.角色或顺序 - 1);
                if (角色已有[索引] || 关系.目标节点 != 目标编码[索引]
                    || (新编码组 && 关系.编码 != (*新编码组)[索引 + 2]))
                    return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
                角色已有[索引] = true;
            }
            if (std::find(角色已有.begin(), 角色已有.end(), false) != 角色已有.end()
                || (首次创建代次 && 共同创建代次 != *首次创建代次))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            const auto 标记 = 特征比较内部::取中性I64(定义值事实[0]);
            const auto 下界 = 特征比较内部::取中性I64(定义值事实[1]);
            const auto 上界 = 特征比较内部::取中性I64(定义值事实[2]);
            if (!标记 || *标记 != 1 || !下界 || !上界
                || *下界 != 合同见证.下界 || *上界 != 合同见证.上界
                || *下界 > *上界)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            for (const auto& 值 : 定义值事实)
                if (值.所属节点 != 合同见证.特征定义
                    || 值.来源节点 != 合同见证.定义来源服务)
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};

            const auto G1 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G1.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 != L1中性读取状态::成功 || G1.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.事实代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            auto 当前合同 = 合同见证;
            当前合同.事实截止代次 = G;
            if (!特征比较内部::目标判断合同完整(当前合同))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            return {特征比较状态::已比较, 比较拒绝原因::无, 当前合同};
        }
        return {特征比较状态::版本漂移,
            比较拒绝原因::输入版本失效, std::nullopt};
    }

    状态迁移登记输入结果 读取状态迁移登记输入(
        const I64状态迁移比较合同登记请求& 请求) const {
        for (int 尝试 = 0; 尝试 < 2; ++尝试) {
            const auto 登记结果 = 读取当前登记();
            if (登记结果.状态 == 特征比较状态::版本漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            if (登记结果.状态 == 特征比较状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (登记结果.状态 == 特征比较状态::未注册)
                return {特征比较状态::未注册,
                    比较拒绝原因::未注册, std::nullopt};
            if (登记结果.状态 != 特征比较状态::已比较 || !登记结果.登记
                || !特征比较内部::登记完整(*登记结果.登记))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            const auto G0 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G0.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 != L1中性读取状态::成功 || G0.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            const auto G = G0.事实代次;
            if (登记结果.登记->事实截止代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            const auto 定义读取 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 请求.特征定义.特征定义});
            const auto 标记读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 请求.特征定义.定义标记值});
            const auto 下界读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 请求.特征定义.下界值});
            const auto 上界读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 请求.特征定义.上界值});
            const auto 目标编码 = 特征比较内部::形成状态迁移关系目标(
                请求, *登记结果.登记);
            std::array<L1中性节点读取结果, 7> 目标读取{};
            for (std::size_t i = 0; i < 目标编码.size(); ++i)
                目标读取[i] = L1_.读取中性当前节点(
                    {L1中性CRUD合同版本, 目标编码[i]});

            bool 发生代次漂移 = false;
            L1中性节点事实 定义事实;
            auto 裁决 = 核对中性节点读取(定义读取,
                请求.特征定义.特征定义, G, true, 定义事实);
            if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
            else if (裁决 != 目标判断中性读取裁决::通过) {
                const auto 失败 = 形成状态迁移读取失败(裁决);
                return {失败.状态, 失败.拒绝原因, std::nullopt};
            }

            L1中性值事实 标记事实, 下界事实, 上界事实;
            const std::array<const L1中性值读取结果*, 3> 值读取{
                &标记读取, &下界读取, &上界读取};
            const std::array<稳定编码, 3> 值编码{请求.特征定义.定义标记值,
                请求.特征定义.下界值, 请求.特征定义.上界值};
            std::array<L1中性值事实*, 3> 值事实{&标记事实, &下界事实, &上界事实};
            for (std::size_t i = 0; i < 值读取.size(); ++i) {
                裁决 = 核对中性值读取(*值读取[i], 值编码[i], G, true, *值事实[i]);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过) {
                    const auto 失败 = 形成状态迁移读取失败(裁决);
                    return {失败.状态, 失败.拒绝原因, std::nullopt};
                }
            }
            for (std::size_t i = 0; i < 目标读取.size(); ++i) {
                L1中性节点事实 目标事实;
                裁决 = 核对中性节点读取(目标读取[i], 目标编码[i], G, true, 目标事实);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过) {
                    const auto 失败 = 形成状态迁移读取失败(裁决);
                    return {失败.状态, 失败.拒绝原因, std::nullopt};
                }
            }
            if (发生代次漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            const auto 标记 = 特征比较内部::取中性I64(标记事实);
            const auto 下界 = 特征比较内部::取中性I64(下界事实);
            const auto 上界 = 特征比较内部::取中性I64(上界事实);
            if (!标记 || *标记 != 1 || !下界 || !上界 || *下界 > *上界
                || 标记事实.所属节点 != 请求.特征定义.特征定义
                || 标记事实.属性类型节点 != 请求.定义登记.定义标记属性类型
                || 标记事实.来源节点 != 请求.定义登记.服务身份
                || 下界事实.所属节点 != 请求.特征定义.特征定义
                || 下界事实.属性类型节点 != 请求.定义登记.I64下界属性类型
                || 下界事实.来源节点 != 请求.定义登记.服务身份
                || 上界事实.所属节点 != 请求.特征定义.特征定义
                || 上界事实.属性类型节点 != 请求.定义登记.I64上界属性类型
                || 上界事实.来源节点 != 请求.定义登记.服务身份)
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};

            const auto G1 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G1.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 != L1中性读取状态::成功 || G1.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.事实代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            return {特征比较状态::已比较, 比较拒绝原因::无,
                状态迁移登记输入束{*登记结果.登记, G, *下界, *上界}};
        }
        return {特征比较状态::版本漂移,
            比较拒绝原因::输入版本失效, std::nullopt};
    }

    I64状态迁移比较合同结果 精确读回状态迁移合同(
        const 特征比较登记& 登记定位,
        const I64状态迁移比较合同登记请求& 登记请求,
        const I64状态迁移比较合同& 合同见证,
        std::optional<std::uint64_t> 首次创建代次,
        const std::optional<std::array<稳定编码, 9>>& 新编码组) const {
        if (!特征比较内部::登记完整(登记定位)
            || !特征比较内部::请求基础有效(登记请求)
            || !特征比较内部::状态迁移合同与请求登记相符(
                合同见证, 登记请求, 登记定位)
            || (首次创建代次 && *首次创建代次 == 0))
            return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
        if (新编码组 && ((*新编码组)[0] != 合同见证.注册身份
            || (*新编码组)[1] != 合同见证.配置值))
            return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

        for (int 尝试 = 0; 尝试 < 2; ++尝试) {
            const auto 登记结果 = 读取当前登记();
            if (登记结果.状态 == 特征比较状态::版本漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            if (登记结果.状态 == 特征比较状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (登记结果.状态 != 特征比较状态::已比较 || !登记结果.登记
                || !特征比较内部::登记定位相同(*登记结果.登记, 登记定位))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            const auto G0 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G0.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G0.状态 != L1中性读取状态::成功 || G0.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            const auto G = G0.事实代次;
            if (登记结果.登记->事实截止代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            const auto 注册读取 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 合同见证.注册身份});
            const auto 配置读取 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 合同见证.配置值});
            const auto 属性读取 = L1_.读取中性当前属性({L1中性CRUD合同版本,
                合同见证.注册身份, 登记定位.合同配置I64组属性类型});
            const auto 关系读取 = L1_.读取中性当前源关系组({L1中性CRUD合同版本,
                合同见证.注册身份, 登记定位.合同字段关系类型});
            const auto 目标编码 = 特征比较内部::形成状态迁移关系目标(
                登记请求, 登记定位);
            std::array<L1中性节点读取结果, 7> 目标读取{};
            for (std::size_t i = 0; i < 目标编码.size(); ++i)
                目标读取[i] = L1_.读取中性当前节点(
                    {L1中性CRUD合同版本, 目标编码[i]});
            const std::array<稳定编码, 3> 定义值编码{合同见证.定义标记值,
                合同见证.下界值, 合同见证.上界值};
            std::array<L1中性值读取结果, 3> 定义值读取{};
            for (std::size_t i = 0; i < 定义值编码.size(); ++i)
                定义值读取[i] = L1_.读取中性当前值(
                    {L1中性CRUD合同版本, 定义值编码[i]});

            bool 发生代次漂移 = false;
            L1中性节点事实 注册事实;
            auto 裁决 = 核对中性节点读取(注册读取, 合同见证.注册身份,
                G, false, 注册事实);
            if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
            else if (裁决 != 目标判断中性读取裁决::通过)
                return 形成状态迁移读取失败(裁决);
            L1中性值事实 配置事实;
            裁决 = 核对中性值读取(配置读取, 合同见证.配置值,
                G, false, 配置事实);
            if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
            else if (裁决 != 目标判断中性读取裁决::通过)
                return 形成状态迁移读取失败(裁决);

            if (属性读取.合同版本 != L1中性CRUD合同版本
                || 属性读取.节点 != 合同见证.注册身份
                || 属性读取.属性类型 != 登记定位.合同配置I64组属性类型)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (属性读取.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (属性读取.状态 != L1中性读取状态::成功 || !属性读取.当前值
                || *属性读取.当前值 != 合同见证.配置值)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (属性读取.读取事实代次 != G) 发生代次漂移 = true;

            if (关系读取.合同版本 != L1中性CRUD合同版本
                || 关系读取.源节点 != 合同见证.注册身份
                || 关系读取.关系类型节点 != 登记定位.合同字段关系类型)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (关系读取.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (关系读取.状态 != L1中性读取状态::成功)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (关系读取.读取事实代次 != G) 发生代次漂移 = true;

            for (std::size_t i = 0; i < 目标读取.size(); ++i) {
                L1中性节点事实 目标事实;
                裁决 = 核对中性节点读取(目标读取[i], 目标编码[i], G, false, 目标事实);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过)
                    return 形成状态迁移读取失败(裁决);
            }
            std::array<L1中性值事实, 3> 定义值事实{};
            for (std::size_t i = 0; i < 定义值读取.size(); ++i) {
                裁决 = 核对中性值读取(定义值读取[i], 定义值编码[i],
                    G, false, 定义值事实[i]);
                if (裁决 == 目标判断中性读取裁决::代次漂移) 发生代次漂移 = true;
                else if (裁决 != 目标判断中性读取裁决::通过)
                    return 形成状态迁移读取失败(裁决);
            }
            if (发生代次漂移) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }

            if (注册事实.种类 != 节点种类::普通 || 注册事实.属性类型表示
                || 配置事实.所属节点 != 合同见证.注册身份
                || 配置事实.属性类型节点 != 登记定位.合同配置I64组属性类型
                || 配置事实.来源节点 != 登记定位.服务身份)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            const auto* 配置材料 = std::get_if<std::vector<std::int64_t>>(&配置事实.材料);
            if (!配置材料 || *配置材料 != 特征比较内部::形成状态迁移配置材料(
                    合同见证.下界, 合同见证.上界))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            std::size_t 配置槽数量 = 0;
            for (const auto& 槽 : 注册事实.当前属性)
                if (槽.属性类型节点 == 登记定位.合同配置I64组属性类型) {
                    ++配置槽数量;
                    if (槽.当前值 != 合同见证.配置值)
                        return {特征比较状态::内部不一致,
                            比较拒绝原因::无, std::nullopt};
                }
            if (配置槽数量 != 1)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            if (关系读取.关系组.size() != 7)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            std::array<bool, 7> 角色已有{};
            std::uint64_t 共同创建代次 = 注册事实.创建事实代次;
            if (共同创建代次 == 0 || 配置事实.创建事实代次 != 共同创建代次)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            for (const auto& 关系 : 关系读取.关系组) {
                if (!有效(关系.编码) || 关系.退出事实代次
                    || 关系.源节点 != 合同见证.注册身份
                    || 关系.关系类型节点 != 登记定位.合同字段关系类型
                    || 关系.角色或顺序 < 1 || 关系.角色或顺序 > 7
                    || 关系.创建事实代次 != 共同创建代次)
                    return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
                const auto 索引 = static_cast<std::size_t>(关系.角色或顺序 - 1);
                if (角色已有[索引] || 关系.目标节点 != 目标编码[索引]
                    || (新编码组 && 关系.编码 != (*新编码组)[索引 + 2]))
                    return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
                角色已有[索引] = true;
            }
            if (std::find(角色已有.begin(), 角色已有.end(), false) != 角色已有.end()
                || (首次创建代次 && 共同创建代次 != *首次创建代次))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};

            const auto 标记 = 特征比较内部::取中性I64(定义值事实[0]);
            const auto 下界 = 特征比较内部::取中性I64(定义值事实[1]);
            const auto 上界 = 特征比较内部::取中性I64(定义值事实[2]);
            if (!标记 || *标记 != 1 || !下界 || !上界
                || *下界 != 合同见证.下界 || *上界 != 合同见证.上界
                || *下界 > *上界)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            const std::array<稳定编码, 3> 定义属性类型{
                登记请求.定义登记.定义标记属性类型,
                登记请求.定义登记.I64下界属性类型,
                登记请求.定义登记.I64上界属性类型};
            for (std::size_t i = 0; i < 定义值事实.size(); ++i)
                if (定义值事实[i].所属节点 != 合同见证.特征定义
                    || 定义值事实[i].属性类型节点 != 定义属性类型[i]
                    || 定义值事实[i].来源节点 != 合同见证.定义来源服务)
                    return {特征比较状态::内部不一致,
                        比较拒绝原因::无, std::nullopt};

            const auto G1 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (G1.合同版本 != L1中性CRUD合同版本)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 == L1中性读取状态::资源失败)
                return {特征比较状态::资源失败, 比较拒绝原因::无, std::nullopt};
            if (G1.状态 != L1中性读取状态::成功 || G1.事实代次 == 0)
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            if (G1.事实代次 != G) {
                if (尝试 == 0) continue;
                return {特征比较状态::版本漂移,
                    比较拒绝原因::输入版本失效, std::nullopt};
            }
            auto 当前合同 = 合同见证;
            当前合同.事实截止代次 = G;
            if (!特征比较内部::状态迁移合同完整(当前合同))
                return {特征比较状态::内部不一致, 比较拒绝原因::无, std::nullopt};
            return {特征比较状态::已比较, 比较拒绝原因::无, 当前合同};
        }
        return {特征比较状态::版本漂移,
            比较拒绝原因::输入版本失效, std::nullopt};
    }

    特征比较登记结果 精确读回特征比较登记(
        const std::array<稳定编码, 6>& 编码组,
        std::optional<std::uint64_t> 首次创建代次) const {
        for (std::size_t i = 0; i < 编码组.size(); ++i) {
            if (!有效(编码组[i]))
                return {特征比较状态::内部不一致, std::nullopt};
            for (std::size_t j = i + 1; j < 编码组.size(); ++j)
                if (编码组[i] == 编码组[j])
                    return {特征比较状态::内部不一致, std::nullopt};
        }
        if (首次创建代次 && *首次创建代次 == 0)
            return {特征比较状态::内部不一致, std::nullopt};

        const auto G0 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (G0.合同版本 != L1中性CRUD合同版本)
            return {特征比较状态::内部不一致, std::nullopt};
        if (G0.状态 != L1中性读取状态::成功)
            return {特征比较内部::映射中性读取状态(G0.状态), std::nullopt};
        if (G0.事实代次 == 0)
            return {特征比较状态::内部不一致, std::nullopt};

        std::array<L1中性节点事实, 6> 节点组{};
        std::uint64_t 共同创建代次 = 0;
        for (std::size_t i = 0; i < 编码组.size(); ++i) {
            const auto 读取 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 编码组[i]});
            if (读取.合同版本 != L1中性CRUD合同版本 || 读取.查询编码 != 编码组[i])
                return {特征比较状态::内部不一致, std::nullopt};
            if (读取.状态 != L1中性读取状态::成功)
                return {特征比较内部::映射中性读取状态(读取.状态), std::nullopt};
            if (读取.读取事实代次 != G0.事实代次)
                return {特征比较状态::版本漂移, std::nullopt};
            if (!读取.事实 || 读取.事实->编码 != 编码组[i]
                || 读取.事实->退出事实代次 || !读取.事实->当前属性.empty()
                || !特征比较内部::中性登记节点形状符合(*读取.事实, i)
                || 读取.事实->创建事实代次 == 0
                || 读取.事实->创建事实代次 > G0.事实代次)
                return {特征比较状态::内部不一致, std::nullopt};
            if (共同创建代次 == 0) 共同创建代次 = 读取.事实->创建事实代次;
            else if (读取.事实->创建事实代次 != 共同创建代次)
                return {特征比较状态::内部不一致, std::nullopt};
            节点组[i] = *读取.事实;
        }
        if (首次创建代次 && 共同创建代次 != *首次创建代次)
            return {特征比较状态::内部不一致, std::nullopt};

        const auto G1 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (G1.合同版本 != L1中性CRUD合同版本)
            return {特征比较状态::内部不一致, std::nullopt};
        if (G1.状态 != L1中性读取状态::成功)
            return {特征比较内部::映射中性读取状态(G1.状态), std::nullopt};
        if (G1.事实代次 == 0)
            return {特征比较状态::内部不一致, std::nullopt};
        if (G1.事实代次 != G0.事实代次)
            return {特征比较状态::版本漂移, std::nullopt};

        特征比较登记 登记;
        登记.事实截止代次 = G0.事实代次;
        登记.服务身份 = 节点组[0].编码;
        登记.合同配置I64组属性类型 = 节点组[1].编码;
        登记.合同字段关系类型 = 节点组[2].编码;
        登记.无单位 = 节点组[3].编码;
        登记.标量维度 = 节点组[4].编码;
        登记.标量分量角色 = 节点组[5].编码;
        if (!特征比较内部::登记完整(登记))
            return {特征比较状态::内部不一致, std::nullopt};
        return {特征比较状态::已比较, 登记};
    }

    std::optional<I64目标判断比较合同> 解析合同(const L1完整快照& 快照,
        const 特征比较登记& 登记, const I64目标判断比较合同& 见证) const {
        const auto* 注册 = 特征比较内部::找节点(快照, 见证.注册身份);
        const auto* 配置 = 特征比较内部::找值(快照, 见证.配置值);
        if (!注册 || !配置 || 配置->所属节点 != 见证.注册身份
            || 配置->属性类型节点 != 登记.合同配置I64组属性类型
            || 配置->来源节点 != 登记.服务身份
            || !特征比较内部::当前槽指向(注册, 登记.合同配置I64组属性类型, 见证.配置值)
            || !std::holds_alternative<std::vector<std::int64_t>>(配置->材料)) return std::nullopt;
        const auto& 材料 = std::get<std::vector<std::int64_t>>(配置->材料);
        if (材料.size() != 20 || 材料[0] != 1 || 材料[1] != 1 || 材料[2] != 1 || 材料[3] != 1
            || 材料[4] != 1 || 材料[5] != 1 || 材料[6] != 2 || 材料[7] != 1 || 材料[8] != 7
            || 材料[9] != 1 || 材料[10] != 1 || 材料[11] != 1 || 材料[12] != 0
            || 材料[13] != 1 || 材料[14] != 1 || 材料[15] != 1 || 材料[16] != 1
            || 材料[17] != 1 || 材料[18] != 见证.下界 || 材料[19] != 见证.上界) return std::nullopt;
        std::array<稳定编码, 8> 目标{};
        std::array<bool, 8> 已有{};
        for (const auto& 关系 : 快照.当前关系) if (关系.源节点 == 见证.注册身份
            && 关系.关系类型节点 == 登记.合同字段关系类型) {
            if (关系.角色或顺序 < 1 || 关系.角色或顺序 > 8) return std::nullopt;
            const auto i = static_cast<std::size_t>(关系.角色或顺序 - 1);
            if (已有[i]) return std::nullopt;
            已有[i] = true; 目标[i] = 关系.目标节点;
        }
        if (std::find(已有.begin(), 已有.end(), false) != 已有.end()) return std::nullopt;
        const std::array<稳定编码, 8> 期望 = {见证.特征定义, 见证.定义模板关系类型,
            见证.当前I64值属性类型, 见证.目标I64值属性类型, 见证.单位,
            见证.维度, 见证.分量角色, 见证.定义来源服务};
        if (目标 != 期望) return std::nullopt;
        for (const auto 编码 : 期望) if (!特征比较内部::找节点(快照, 编码)) return std::nullopt;
        const auto* 标记 = 特征比较内部::找值(快照, 见证.定义标记值);
        const auto* 下界 = 特征比较内部::找值(快照, 见证.下界值);
        const auto* 上界 = 特征比较内部::找值(快照, 见证.上界值);
        if (!标记 || !下界 || !上界
            || 标记->所属节点 != 见证.特征定义 || 下界->所属节点 != 见证.特征定义
            || 上界->所属节点 != 见证.特征定义
            || 标记->来源节点 != 见证.定义来源服务
            || 下界->来源节点 != 见证.定义来源服务 || 上界->来源节点 != 见证.定义来源服务
            || 特征比较内部::取I64(标记) != std::optional<std::int64_t>{1}
            || 特征比较内部::取I64(下界) != std::optional<std::int64_t>{见证.下界}
            || 特征比较内部::取I64(上界) != std::optional<std::int64_t>{见证.上界}) return std::nullopt;
        auto 结果 = 见证; 结果.事实截止代次 = 快照.事实代次;
        return 结果;
    }
    std::optional<I64状态迁移比较合同> 解析迁移合同(const L1完整快照& 快照,
        const 特征比较登记& 登记, const I64状态迁移比较合同& 见证) const {
        const auto* 注册 = 特征比较内部::找节点(快照, 见证.注册身份);
        const auto* 配置 = 特征比较内部::找值(快照, 见证.配置值);
        if (!注册 || !配置 || 配置->所属节点 != 见证.注册身份
            || 配置->属性类型节点 != 登记.合同配置I64组属性类型
            || 配置->来源节点 != 登记.服务身份
            || !特征比较内部::当前槽指向(注册, 登记.合同配置I64组属性类型, 见证.配置值)
            || !std::holds_alternative<std::vector<std::int64_t>>(配置->材料)) return std::nullopt;
        const auto& 材料 = std::get<std::vector<std::int64_t>>(配置->材料);
        if (材料.size() != 20 || 材料[0] != 1 || 材料[1] != 2 || 材料[2] != 1
            || 材料[3] != 1 || 材料[4] != 1 || 材料[5] != 3 || 材料[6] != 4
            || 材料[7] != 1 || 材料[8] != 7 || 材料[9] != 1 || 材料[10] != 1
            || 材料[11] != 1 || 材料[12] != 0 || 材料[13] != 1 || 材料[14] != 1
            || 材料[15] != 1 || 材料[16] != 1 || 材料[17] != 1
            || 材料[18] != 见证.下界 || 材料[19] != 见证.上界) return std::nullopt;
        std::array<稳定编码, 7> 目标{};
        std::array<bool, 7> 已有{};
        for (const auto& 关系 : 快照.当前关系) if (关系.源节点 == 见证.注册身份
            && 关系.关系类型节点 == 登记.合同字段关系类型) {
            if (关系.角色或顺序 < 1 || 关系.角色或顺序 > 7) return std::nullopt;
            const auto i = static_cast<std::size_t>(关系.角色或顺序 - 1);
            if (已有[i]) return std::nullopt;
            已有[i] = true; 目标[i] = 关系.目标节点;
        }
        if (std::find(已有.begin(), 已有.end(), false) != 已有.end()) return std::nullopt;
        const std::array<稳定编码, 7> 期望 = {见证.特征定义, 见证.定义模板关系类型,
            见证.当前I64值属性类型, 见证.单位, 见证.维度, 见证.分量角色,
            见证.定义来源服务};
        if (目标 != 期望) return std::nullopt;
        for (const auto 编码 : 期望) if (!特征比较内部::找节点(快照, 编码)) return std::nullopt;
        const auto* 标记 = 特征比较内部::找值(快照, 见证.定义标记值);
        const auto* 下界 = 特征比较内部::找值(快照, 见证.下界值);
        const auto* 上界 = 特征比较内部::找值(快照, 见证.上界值);
        if (!标记 || !下界 || !上界 || 标记->所属节点 != 见证.特征定义
            || 下界->所属节点 != 见证.特征定义 || 上界->所属节点 != 见证.特征定义
            || 标记->来源节点 != 见证.定义来源服务
            || 下界->来源节点 != 见证.定义来源服务 || 上界->来源节点 != 见证.定义来源服务
            || 特征比较内部::取I64(标记) != std::optional<std::int64_t>{1}
            || 特征比较内部::取I64(下界) != std::optional<std::int64_t>{见证.下界}
            || 特征比较内部::取I64(上界) != std::optional<std::int64_t>{见证.上界}) return std::nullopt;
        auto 结果 = 见证; 结果.事实截止代次 = 快照.事实代次;
        return 结果;
    }
    static I64状态迁移比较结果 迁移失败(const I64状态迁移比较请求& 请求,
        特征比较状态 状态, 比较拒绝原因 原因) noexcept {
        I64状态迁移比较结果 结果;
        结果.比较.请求身份 = 请求.请求身份;
        结果.比较.状态 = 状态; 结果.比较.拒绝原因 = 原因;
        return 结果;
    }
    static std::optional<I64状态迁移比较结果> 映射前状态失败(
        const I64状态迁移比较请求& 请求, const 实际存在I64基准状态结果& 结果) noexcept {
        if (结果.状态 == L1基准状态状态::已读取 && 结果.事实) return std::nullopt;
        switch (结果.状态) {
        case L1基准状态状态::未找到:
            return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::样本不足);
        case L1基准状态状态::版本漂移:
            return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
        case L1基准状态状态::许可拒绝:
            return 迁移失败(请求, 特征比较状态::许可拒绝, 比较拒绝原因::无);
        case L1基准状态状态::资源失败:
            return 迁移失败(请求, 特征比较状态::资源失败, 比较拒绝原因::无);
        case L1基准状态状态::内部不一致:
        case L1基准状态状态::已读取:
        case L1基准状态状态::已提交:
        case L1基准状态状态::幂等读回:
            return 迁移失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
        default:
            return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::请求身份或特征定义不完整);
        }
    }
    static std::optional<I64状态迁移比较结果> 映射后当前失败(
        const I64状态迁移比较请求& 请求, const I64实例特征结果& 结果) noexcept {
        if (结果.状态 == 实例特征状态::已读取 && 结果.事实) return std::nullopt;
        switch (结果.状态) {
        case 实例特征状态::未找到:
            return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::样本不足);
        case 实例特征状态::事实代次漂移:
            return 迁移失败(请求, 特征比较状态::版本漂移, 比较拒绝原因::输入版本失效);
        case 实例特征状态::资源失败:
            return 迁移失败(请求, 特征比较状态::资源失败, 比较拒绝原因::无);
        case 实例特征状态::内部不一致:
        case 实例特征状态::已读取:
        case 实例特征状态::已提交:
        case 实例特征状态::幂等读回:
            return 迁移失败(请求, 特征比较状态::内部不一致, 比较拒绝原因::无);
        default:
            return 迁移失败(请求, 特征比较状态::入口拒绝, 比较拒绝原因::请求身份或特征定义不完整);
        }
    }
    static 特征比较结果 失败(const 特征比较请求& 请求, 特征比较状态 状态,
        比较拒绝原因 原因, std::optional<I64目标判断比较合同> 合同 = std::nullopt) noexcept {
        特征比较结果 结果; 结果.请求身份 = 请求.请求身份; 结果.状态 = 状态; 结果.拒绝原因 = 原因;
        if (合同 && (状态 == 特征比较状态::未注册 || 状态 == 特征比较状态::版本漂移)) {
            结果.事实截止代次 = 合同->事实截止代次; 结果.注册身份 = 合同->注册身份; 结果.算法版本 = 合同->算法版本;
        }
        return 结果;
    }

    L1事实基座服务& L1_;
    mutable std::mutex 目标判断合同锁_;
    mutable std::mutex 状态迁移合同锁_;
    mutable std::mutex 锁_;
    std::optional<特征比较登记> 登记_;
    std::optional<I64目标判断比较合同登记请求> 合同请求_;
    std::optional<I64目标判断比较合同> 合同_;
    L1状态服务* 状态_ = nullptr;
    L1实例特征服务* 实例特征_ = nullptr;
    std::optional<I64状态迁移比较合同登记请求> 迁移合同请求_;
    std::optional<I64状态迁移比较合同> 迁移合同_;
};

} // namespace 海中鱼巣
