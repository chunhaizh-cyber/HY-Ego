inline constexpr L1所有者范围写集本地键 因果结点本地键{1};
inline constexpr L1所有者范围写集本地键 来源值本地键{2};
inline constexpr L1所有者范围写集本地键 规则版本值本地键{3};
inline constexpr L1所有者范围写集本地键 样本数量值本地键{4};
inline constexpr L1所有者范围写集本地键 失败数量值本地键{5};
inline constexpr std::uint32_t 条件关系本地键起点 = 0x0001'0000U;
inline constexpr std::uint32_t 动作关系本地键起点 = 0x0002'0000U;
inline constexpr std::uint32_t 结果关系本地键起点 = 0x0003'0000U;
inline constexpr std::uint32_t 动态证据关系本地键起点 = 0x0004'0000U;
inline constexpr std::uint32_t 适用场景关系本地键起点 = 0x0005'0000U;
inline constexpr std::size_t 最大成员数量 = 0x0000'FFFFU;

std::optional<稳定编码> 查找唯一编码(
    const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键 != 本地键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

} // namespace 海中鱼巣::因果类数据内部

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 因果类数据合同版本 = 1;

enum class 因果类数据状态 : std::uint8_t {
    已创建 = 1, 精确重复 = 2, 已读取 = 3, 已退出 = 4,
    入口拒绝 = 5, 未找到 = 6, 目标已退出 = 7,
    状态未找到 = 8, 状态已退出 = 9, 状态读取失败 = 10,
    动态未找到 = 11, 动态已退出 = 12, 动态读取失败 = 13,
    场景未找到 = 14, 场景已退出 = 15, 场景读取失败 = 16,
    结构类型未找到 = 17, 结构类型已退出 = 18,
    事实代次漂移 = 19, 幂等冲突 = 20, 引用冲突 = 21,
    数量预算不足 = 22, 历史材料已清理 = 23,
    资源失败 = 24, 内部不一致 = 25, 已可能发布 = 26
};

enum class 因果类状态位置 : std::uint8_t { 任意 = 1, 条件 = 2, 结果 = 3 };

struct 因果类状态成员 final {
    std::uint32_t 顺序 = 0;
    稳定编码 成员关系{};
    稳定编码 状态结点{};
    friend bool operator==(const 因果类状态成员&,
        const 因果类状态成员&) = default;
};

struct 因果类动作成员 final {
    稳定编码 动作关系{};
    稳定编码 动作结点{};
    friend bool operator==(const 因果类动作成员&,
        const 因果类动作成员&) = default;
};

struct 因果类动态证据成员 final {
    std::uint32_t 顺序 = 0;
    稳定编码 成员关系{};
    稳定编码 动态结点{};
    friend bool operator==(const 因果类动态证据成员&,
        const 因果类动态证据成员&) = default;
};

struct 因果类适用场景成员 final {
    稳定编码 成员关系{};
    稳定编码 场景结点{};
    friend bool operator==(const 因果类适用场景成员&,
        const 因果类适用场景成员&) = default;
};

struct 因果类结点 final {
    稳定编码 结点{};
    稳定编码 来源值事实{};
    稳定编码 规则版本值事实{};
    稳定编码 样本数量值事实{};
    稳定编码 失败数量值事实{};
    std::vector<因果类状态成员> 有序条件状态组;
    std::optional<因果类动作成员> 动作;
    std::vector<因果类状态成员> 有序结果状态组;
    std::vector<因果类动态证据成员> 有序动态证据组;
    std::vector<因果类适用场景成员> 适用场景组;
    稳定编码 来源稳定编码{};
    std::int64_t 规则版本 = 0;
    std::int64_t 样本数量 = 0;
    std::int64_t 失败数量 = 0;
    std::uint64_t 创建事实代次 = 0;
    std::optional<std::uint64_t> 退出事实代次;
    friend bool operator==(const 因果类结点&, const 因果类结点&) = default;
};

struct 因果类新增请求 final {
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    std::vector<稳定编码> 有序条件状态结点组;
    std::optional<稳定编码> 动作结点;
    std::vector<稳定编码> 有序结果状态结点组;
    std::vector<稳定编码> 有序动态证据结点组;
    std::vector<稳定编码> 适用场景结点组;
    稳定编码 来源稳定编码{};
    std::int64_t 规则版本 = 0;
    std::int64_t 样本数量 = 0;
    std::int64_t 失败数量 = 0;
    friend bool operator==(const 因果类新增请求&,
        const 因果类新增请求&) = default;
};

struct 因果类删除请求 final {
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 因果结点{};
    friend bool operator==(const 因果类删除请求&,
        const 因果类删除请求&) = default;
};

struct 因果类查询请求 final {
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 因果结点{};
    friend bool operator==(const 因果类查询请求&,
        const 因果类查询请求&) = default;
};

struct 因果类状态查询请求 final {
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 状态结点{};
    因果类状态位置 位置 = 因果类状态位置::任意;
    std::uint64_t 最大结果数量 = 0;
    friend bool operator==(const 因果类状态查询请求&,
        const 因果类状态查询请求&) = default;
};

struct 因果类动态查询请求 final {
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 动态结点{};
    std::uint64_t 最大结果数量 = 0;
    friend bool operator==(const 因果类动态查询请求&,
        const 因果类动态查询请求&) = default;
};

struct 因果类场景查询请求 final {
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 场景结点{};
    std::uint64_t 最大结果数量 = 0;
    friend bool operator==(const 因果类场景查询请求&,
        const 因果类场景查询请求&) = default;
};

struct 因果类来源查询请求 final {
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 来源稳定编码{};
    std::uint64_t 最大结果数量 = 0;
    friend bool operator==(const 因果类来源查询请求&,
        const 因果类来源查询请求&) = default;
};

inline bool 因果类结点闭合(const 因果类结点& 值) noexcept {
    return 有效(值.结点) && 有效(值.来源值事实)
        && 有效(值.规则版本值事实) && 有效(值.样本数量值事实)
        && 有效(值.失败数量值事实) && 有效(值.来源稳定编码)
        && !值.有序条件状态组.empty() && !值.有序结果状态组.empty()
        && !值.有序动态证据组.empty() && !值.适用场景组.empty()
        && 值.规则版本 > 0 && 值.样本数量 > 0
        && 值.样本数量 == static_cast<std::int64_t>(值.有序动态证据组.size())
        && 值.失败数量 >= 0 && 值.失败数量 <= 值.样本数量
        && 值.创建事实代次 != 0;
}

struct 因果类结点结果 final {
    因果类数据状态 状态 = 因果类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<因果类结点> 因果结点;
    bool 成功() const noexcept {
        return (状态 == 因果类数据状态::已创建
                || 状态 == 因果类数据状态::精确重复
                || 状态 == 因果类数据状态::已读取
                || 状态 == 因果类数据状态::已退出)
            && 合同版本 == 因果类数据合同版本 && 事实代次 != 0
            && 因果结点 && 因果类结点闭合(*因果结点);
    }
};

struct 因果类组查询结果 final {
    因果类数据状态 状态 = 因果类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 因果类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::vector<因果类结点> 因果组;
    bool 成功() const noexcept {
        return 状态 == 因果类数据状态::已读取
            && 合同版本 == 因果类数据合同版本 && 事实代次 != 0
            && std::all_of(因果组.begin(), 因果组.end(), 因果类结点闭合);
    }
};

class 因果类数据服务 final {
public:
    因果类数据服务() = delete;
    因果类数据服务(const 因果类数据服务&) = delete;
    因果类数据服务& operator=(const 因果类数据服务&) = delete;
    因果类数据服务(因果类数据服务&&) = delete;
    因果类数据服务& operator=(因果类数据服务&&) = delete;

    因果类数据服务(const L1事实基座服务& 第一层服务,
        const 状态类数据服务& 状态服务,
        const 动态类数据服务& 动态服务,
        const 场景类数据服务& 场景服务,
        L1所有者范围写端口&& 写入端口,
        稳定编码 来源属性类型, 稳定编码 规则版本属性类型,
        稳定编码 样本数量属性类型, 稳定编码 失败数量属性类型,
        稳定编码 条件关系类型, 稳定编码 动作关系类型,
        稳定编码 结果关系类型, 稳定编码 动态证据关系类型,
        稳定编码 适用场景关系类型)
        : 第一层服务_(第一层服务), 状态服务_(状态服务),
          动态服务_(动态服务), 场景服务_(场景服务),
          写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()),
          来源属性类型_(来源属性类型), 规则版本属性类型_(规则版本属性类型),
          样本数量属性类型_(样本数量属性类型), 失败数量属性类型_(失败数量属性类型),
          条件关系类型_(条件关系类型), 动作关系类型_(动作关系类型),
          结果关系类型_(结果关系类型), 动态证据关系类型_(动态证据关系类型),
          适用场景关系类型_(适用场景关系类型) {
        const std::vector<稳定编码> 类型组{来源属性类型_, 规则版本属性类型_,
            样本数量属性类型_, 失败数量属性类型_, 条件关系类型_,
            动作关系类型_, 结果关系类型_, 动态证据关系类型_,
            适用场景关系类型_};
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !有效(所有者_)
            || std::any_of(类型组.begin(), 类型组.end(),
                [](稳定编码 编码) noexcept { return !有效(编码); }))
            throw std::invalid_argument("invalid causal data configuration");
        auto 排序类型 = 类型组;
        std::sort(排序类型.begin(), 排序类型.end());
        if (std::adjacent_find(排序类型.begin(), 排序类型.end()) != 排序类型.end())
            throw std::invalid_argument("duplicate causal data types");
        const auto 所有者读取 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者读取.状态 != L1所有者范围读取状态::成功
            || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
            || !所有者读取.所有者事实
            || 所有者读取.所有者事实->所有者 != 所有者_
            || 所有者读取.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 所有者读取.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid causal data owner");
        if (!类型结点有效(来源属性类型_, 节点种类::属性类型,
                L1所有者范围值表示种类::独立材料引用)
            || !类型结点有效(规则版本属性类型_, 节点种类::属性类型,
                L1所有者范围值表示种类::I64)
            || !类型结点有效(样本数量属性类型_, 节点种类::属性类型,
                L1所有者范围值表示种类::I64)
            || !类型结点有效(失败数量属性类型_, 节点种类::属性类型,
                L1所有者范围值表示种类::I64)
            || !类型结点有效(条件关系类型_, 节点种类::普通, std::nullopt)
            || !类型结点有效(动作关系类型_, 节点种类::普通, std::nullopt)
            || !类型结点有效(结果关系类型_, 节点种类::普通, std::nullopt)
            || !类型结点有效(动态证据关系类型_, 节点种类::普通, std::nullopt)
            || !类型结点有效(适用场景关系类型_, 节点种类::普通, std::nullopt))
            throw std::invalid_argument("invalid causal data types");
    }

    因果类结点结果 新增因果(const 因果类新增请求& 请求) {
        auto 规范请求 = 规范化新增请求(请求);
        if (!规范请求) return 失败(因果类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放新增(*规范请求)) return *重放;
            if (const auto 失败状态 = 验证状态组(
                    规范请求->有序条件状态结点组, 规范请求->期望事实代次))
                return *失败状态;
            if (const auto 失败状态 = 验证状态组(
                    规范请求->有序结果状态结点组, 规范请求->期望事实代次))
                return *失败状态;
            if (const auto 失败状态 = 验证动态组(
                    规范请求->有序动态证据结点组, 规范请求->期望事实代次))
                return *失败状态;
            if (const auto 失败状态 = 验证场景组(
                    规范请求->适用场景结点组, 规范请求->期望事实代次))
                return *失败状态;
            if (规范请求->动作结点) {
                const auto 验证 = 验证普通当前结点(*规范请求->动作结点,
                    规范请求->期望事实代次);
                if (验证 != 因果类数据状态::已读取) return 失败(验证,
                    规范请求->期望事实代次);
            }
            const auto 来源验证 = 验证普通当前结点(规范请求->来源稳定编码,
                规范请求->期望事实代次);
            if (来源验证 != 因果类数据状态::已读取)
                return 失败(来源验证, 规范请求->期望事实代次);
            return 提交新增(形成新增写集(*规范请求), 规范请求->幂等身份,
                因果类数据状态::已创建);
        } catch (const std::bad_alloc&) {
            return 失败(因果类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(因果类数据状态::资源失败);
        } catch (...) {
            return 失败(因果类数据状态::内部不一致);
        }
    }

    因果类结点结果 删除因果(const 因果类删除请求& 请求) {
        if (!删除请求有效(请求)) return 失败(因果类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放删除(请求)) return *重放;
            const auto 当前 = 读取当前因果(请求.因果结点, 请求.期望事实代次);
            if (!当前.成功() || 当前.状态 != 因果类数据状态::已读取) return 当前;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            const auto& 值 = *当前.因果结点;
            写集.退出事实 = {值.结点, 值.来源值事实, 值.规则版本值事实,
                值.样本数量值事实, 值.失败数量值事实};
            for (const auto& 成员 : 值.有序条件状态组) 写集.退出事实.push_back(成员.成员关系);
            if (值.动作) 写集.退出事实.push_back(值.动作->动作关系);
            for (const auto& 成员 : 值.有序结果状态组) 写集.退出事实.push_back(成员.成员关系);
            for (const auto& 成员 : 值.有序动态证据组) 写集.退出事实.push_back(成员.成员关系);
            for (const auto& 成员 : 值.适用场景组) 写集.退出事实.push_back(成员.成员关系);
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 映射 = 映射写入状态(写入.状态, 因果类数据状态::已退出);
            if (映射 != 因果类数据状态::已退出
                && 映射 != 因果类数据状态::精确重复)
                return 失败(映射, 写入.事实代次);
            if (!写入结果头完整(写入, 请求.幂等身份)
                || !写入.新编码映射.empty())
                return 写入.状态 == L1所有者范围写入状态::成功
                    ? 失败(因果类数据状态::已可能发布, 写入.事实代次)
                    : 失败(因果类数据状态::内部不一致, 写入.事实代次);
            auto 读回 = 读取已退出因果(请求.因果结点, 写入.事实代次, 映射);
            if (!读回.成功()) return 失败(因果类数据状态::已可能发布, 写入.事实代次);
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(因果类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(因果类数据状态::资源失败);
        } catch (...) {
            return 失败(因果类数据状态::内部不一致);
        }
    }

    因果类结点结果 查询因果(const 因果类查询请求& 请求) const {
        if (!查询请求有效(请求)) return 失败(因果类数据状态::入口拒绝);
        try { return 读取当前因果(请求.因果结点, 请求.期望事实代次); }
        catch (const std::bad_alloc&) { return 失败(因果类数据状态::资源失败); }
        catch (const std::length_error&) { return 失败(因果类数据状态::资源失败); }
        catch (...) { return 失败(因果类数据状态::内部不一致); }
    }

    因果类组查询结果 按状态查询因果(const 因果类状态查询请求& 请求) const {
        if (请求.合同版本 != 因果类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.状态结点) || 请求.最大结果数量 == 0
            || (请求.位置 != 因果类状态位置::任意
                && 请求.位置 != 因果类状态位置::条件
                && 请求.位置 != 因果类状态位置::结果))
            return 组失败(因果类数据状态::入口拒绝);
        try {
            std::vector<稳定编码> 候选;
            if (请求.位置 != 因果类状态位置::结果) {
                const auto 读取 = 读取目标关系候选(请求.状态结点, 条件关系类型_, 请求.期望事实代次);
                if (!读取.成功) return 组失败(读取.状态, 读取.事实代次);
                候选.insert(候选.end(), 读取.候选.begin(), 读取.候选.end());
            }
            if (请求.位置 != 因果类状态位置::条件) {
                const auto 读取 = 读取目标关系候选(请求.状态结点, 结果关系类型_, 请求.期望事实代次);
                if (!读取.成功) return 组失败(读取.状态, 读取.事实代次);
                候选.insert(候选.end(), 读取.候选.begin(), 读取.候选.end());
            }
            return 闭合候选(std::move(候选), 请求.期望事实代次, 请求.最大结果数量);
        } catch (const std::bad_alloc&) { return 组失败(因果类数据状态::资源失败); }
        catch (const std::length_error&) { return 组失败(因果类数据状态::资源失败); }
        catch (...) { return 组失败(因果类数据状态::内部不一致); }
    }

    因果类组查询结果 按动态证据查询因果(const 因果类动态查询请求& 请求) const {
        if (请求.合同版本 != 因果类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.动态结点) || 请求.最大结果数量 == 0)
            return 组失败(因果类数据状态::入口拒绝);
        const auto 读取 = 读取目标关系候选(请求.动态结点, 动态证据关系类型_, 请求.期望事实代次);
        if (!读取.成功) return 组失败(读取.状态, 读取.事实代次);
        return 闭合候选(读取.候选, 请求.期望事实代次, 请求.最大结果数量);
    }

    因果类组查询结果 按适用场景查询因果(const 因果类场景查询请求& 请求) const {
        if (请求.合同版本 != 因果类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.场景结点) || 请求.最大结果数量 == 0)
            return 组失败(因果类数据状态::入口拒绝);
        const auto 读取 = 读取目标关系候选(请求.场景结点, 适用场景关系类型_, 请求.期望事实代次);
        if (!读取.成功) return 组失败(读取.状态, 读取.事实代次);
        return 闭合候选(读取.候选, 请求.期望事实代次, 请求.最大结果数量);
    }

    因果类组查询结果 按来源查询因果(const 因果类来源查询请求& 请求) const {
        if (请求.合同版本 != 因果类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.来源稳定编码) || 请求.最大结果数量 == 0)
            return 组失败(因果类数据状态::入口拒绝);
        try {
            const auto 读取 = 第一层服务_.按属性类型读取所有者范围全部当前值(
                {L1所有者范围属性类型当前值组读取合同版本, 所有者_,
                    来源属性类型_, 请求.期望事实代次, 请求.最大结果数量});
            const auto 映射 = 映射属性组读取状态(读取.状态);
            if (映射 != 因果类数据状态::已读取)
                return 组失败(映射, 读取.读取事实代次);
            if (读取.合同版本 != L1所有者范围属性类型当前值组读取合同版本
                || 读取.所有者 != 所有者_ || 读取.属性类型节点 != 来源属性类型_
                || 读取.期望事实代次 != 请求.期望事实代次
                || 读取.读取事实代次 != 请求.期望事实代次)
                return 组失败(因果类数据状态::内部不一致, 读取.读取事实代次);
            std::vector<稳定编码> 候选;
            for (const auto& 值 : 读取.当前值) {
                const auto* 来源 = std::get_if<L1所有者范围独立材料引用>(&值.材料);
                if (!来源 || 值.写入所有者 != 所有者_
                    || 值.属性类型节点 != 来源属性类型_ || 值.退出事实代次)
                    return 组失败(因果类数据状态::内部不一致, 读取.读取事实代次);
                if (来源->编码 == 请求.来源稳定编码) 候选.push_back(值.所属节点);
            }
            return 闭合候选(std::move(候选), 请求.期望事实代次, 请求.最大结果数量);
        } catch (const std::bad_alloc&) { return 组失败(因果类数据状态::资源失败); }
        catch (const std::length_error&) { return 组失败(因果类数据状态::资源失败); }
        catch (...) { return 组失败(因果类数据状态::内部不一致); }
    }

private:
    struct 候选读取结果 final {
        bool 成功 = false;
        因果类数据状态 状态 = 因果类数据状态::内部不一致;
        std::uint64_t 事实代次 = 0;
        std::vector<稳定编码> 候选;
        std::vector<L1所有者范围关系事实> 关系组;
    };

    bool 类型结点有效(稳定编码 编码, 节点种类 种类,
        std::optional<L1所有者范围值表示种类> 表示) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 事实 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && !读取.物理清理事实代次
            && !读取.物理清理墓碑 && 事实 && 事实->编码 == 编码
            && 事实->写入所有者 == 所有者_ && 事实->种类 == 种类
            && 事实->属性类型表示 == 表示 && 事实->创建事实代次 != 0
            && !事实->退出事实代次 && 事实->当前属性.empty();
    }

    static bool 编码组有效(const std::vector<稳定编码>& 组) noexcept {
        if (组.empty() || 组.size() > 因果类数据内部::最大成员数量) return false;
        for (std::size_t i = 0; i < 组.size(); ++i) {
            if (!有效(组[i])) return false;
            for (std::size_t j = 0; j < i; ++j) if (组[i] == 组[j]) return false;
        }
        return true;
    }

    static std::optional<因果类新增请求> 规范化新增请求(
        const 因果类新增请求& 请求) {
        if (请求.合同版本 != 因果类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.幂等身份) || !编码组有效(请求.有序条件状态结点组)
            || !编码组有效(请求.有序结果状态结点组)
            || !编码组有效(请求.有序动态证据结点组)
            || !编码组有效(请求.适用场景结点组) || !有效(请求.来源稳定编码)
            || (请求.动作结点 && !有效(*请求.动作结点)) || 请求.规则版本 <= 0
            || 请求.样本数量 <= 0 || 请求.失败数量 < 0
            || 请求.失败数量 > 请求.样本数量
            || 请求.样本数量 != static_cast<std::int64_t>(请求.有序动态证据结点组.size()))
            return std::nullopt;
        auto 结果 = 请求;
        std::sort(结果.适用场景结点组.begin(), 结果.适用场景结点组.end());
        return 结果;
    }

    static bool 删除请求有效(const 因果类删除请求& 请求) noexcept {
        return 请求.合同版本 == 因果类数据合同版本 && 请求.期望事实代次 != 0
            && 有效(请求.幂等身份) && 有效(请求.因果结点);
    }

    static bool 查询请求有效(const 因果类查询请求& 请求) noexcept {
        return 请求.合同版本 == 因果类数据合同版本 && 请求.期望事实代次 != 0
            && 有效(请求.因果结点);
    }

    std::optional<因果类结点结果> 验证状态组(
        const std::vector<稳定编码>& 组, std::uint64_t 期望事实代次) const {
        for (const auto 编码 : 组) {
            const auto 读取 = 状态服务_.查询状态(
                {状态类数据合同版本, 期望事实代次, 编码});
            if (!读取.成功() || 读取.状态 != 状态类数据状态::已读取
                || 读取.事实代次 != 期望事实代次 || !读取.状态结点
                || 读取.状态结点->结点 != 编码)
                return 失败(映射状态状态(读取.状态), 读取.事实代次);
        }
        return std::nullopt;
    }

    std::optional<因果类结点结果> 验证动态组(
        const std::vector<稳定编码>& 组, std::uint64_t 期望事实代次) const {
        for (const auto 编码 : 组) {
            const auto 读取 = 动态服务_.查询动态(
                {动态类数据合同版本, 期望事实代次, 编码});
            if (!读取.成功() || 读取.状态 != 动态类数据状态::已读取
                || 读取.事实代次 != 期望事实代次 || !读取.动态结点
                || 读取.动态结点->结点 != 编码)
                return 失败(映射动态状态(读取.状态), 读取.事实代次);
        }
        return std::nullopt;
    }

    std::optional<因果类结点结果> 验证场景组(
        const std::vector<稳定编码>& 组, std::uint64_t 期望事实代次) const {
        for (const auto 编码 : 组) {
            const auto 读取 = 场景服务_.查询场景(
                {场景类数据合同版本, 期望事实代次, 编码});
            if (!读取.成功() || 读取.状态 != 场景类数据状态::已读取
                || 读取.事实代次 != 期望事实代次 || !读取.场景结点
                || 读取.场景结点->结点 != 编码)
                return 失败(映射场景状态(读取.状态), 读取.事实代次);
        }
        return std::nullopt;
    }

    因果类数据状态 验证普通当前结点(稳定编码 编码,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        if (读取.读取事实代次 != 期望事实代次) return 因果类数据状态::事实代次漂移;
        if (读取.状态 != L1所有者范围读取状态::成功) return 映射读取状态(读取.状态);
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        if (读取.合同版本 != L1所有者范围CRUD合同版本 || 读取.查询编码 != 编码
            || 读取.物理清理事实代次 || 读取.物理清理墓碑 || !节点
            || 节点->编码 != 编码 || 节点->种类 != 节点种类::普通
            || 节点->属性类型表示 || 节点->退出事实代次)
            return 因果类数据状态::内部不一致;
        return 因果类数据状态::已读取;
    }

    L1所有者范围写集请求 形成新增写集(const 因果类新增请求& 请求) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{因果类数据内部::因果结点本地键, 节点种类::普通, std::nullopt}};
        写集.值 = {
            {因果类数据内部::来源值本地键, 因果类数据内部::因果结点本地键,
                来源属性类型_, L1所有者范围独立材料引用{请求.来源稳定编码},
                因果类数据内部::因果结点本地键},
            {因果类数据内部::规则版本值本地键, 因果类数据内部::因果结点本地键,
                规则版本属性类型_, 请求.规则版本, 因果类数据内部::因果结点本地键},
            {因果类数据内部::样本数量值本地键, 因果类数据内部::因果结点本地键,
                样本数量属性类型_, 请求.样本数量, 因果类数据内部::因果结点本地键},
            {因果类数据内部::失败数量值本地键, 因果类数据内部::因果结点本地键,
                失败数量属性类型_, 请求.失败数量, 因果类数据内部::因果结点本地键}};
        写集.属性槽变更 = {
            {因果类数据内部::因果结点本地键, 来源属性类型_, 因果类数据内部::来源值本地键},
            {因果类数据内部::因果结点本地键, 规则版本属性类型_, 因果类数据内部::规则版本值本地键},
            {因果类数据内部::因果结点本地键, 样本数量属性类型_, 因果类数据内部::样本数量值本地键},
            {因果类数据内部::因果结点本地键, 失败数量属性类型_, 因果类数据内部::失败数量值本地键}};
        添加关系组(写集, 请求.有序条件状态结点组,
            因果类数据内部::条件关系本地键起点, 条件关系类型_, true);
        if (请求.动作结点) 写集.关系.push_back({
            L1所有者范围写集本地键{因果类数据内部::动作关系本地键起点},
            因果类数据内部::因果结点本地键, *请求.动作结点, 动作关系类型_, 1});
        添加关系组(写集, 请求.有序结果状态结点组,
            因果类数据内部::结果关系本地键起点, 结果关系类型_, true);
        添加关系组(写集, 请求.有序动态证据结点组,
            因果类数据内部::动态证据关系本地键起点, 动态证据关系类型_, true);
        添加关系组(写集, 请求.适用场景结点组,
            因果类数据内部::适用场景关系本地键起点, 适用场景关系类型_, false);
        return 写集;
    }

    static void 添加关系组(L1所有者范围写集请求& 写集,
        const std::vector<稳定编码>& 目标组, std::uint32_t 本地键起点,
        稳定编码 关系类型, bool 有序) {
        for (std::size_t i = 0; i < 目标组.size(); ++i)
            写集.关系.push_back({L1所有者范围写集本地键{
                    本地键起点 + static_cast<std::uint32_t>(i)},
                因果类数据内部::因果结点本地键, 目标组[i], 关系类型,
                有序 ? static_cast<std::int64_t>(i + 1) : 1});
    }

    std::optional<因果类结点结果> 尝试重放新增(const 因果类新增请求& 请求) {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到) return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功
            || 首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_ || 首次.写入幂等身份 != 请求.幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果)
            return 失败(因果类数据状态::幂等冲突, 首次.读取事实代次);
        const auto& 写集 = *首次.首次规范化写集;
        const auto& 首次结果 = *首次.首次写入结果;
        if (写集 != 形成新增写集(请求)
            || 首次结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(首次结果, 请求.幂等身份))
            return 失败(因果类数据状态::幂等冲突, 首次结果.事实代次);
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        if (写入.状态 != L1所有者范围写入状态::精确重复
            || !写入结果头完整(写入, 请求.幂等身份)
            || 写入.新编码映射 != 首次结果.新编码映射)
            return 失败(因果类数据状态::内部不一致, 写入.事实代次);
        const auto 结点 = 因果类数据内部::查找唯一编码(写入, 因果类数据内部::因果结点本地键);
        if (!结点) return 失败(因果类数据状态::内部不一致, 写入.事实代次);
        auto 读回 = 读取历史因果快照(*结点, 写入.事实代次, 写入.事实代次,
            因果类数据状态::精确重复, std::nullopt);
        if (!读回.成功()) return 失败(因果类数据状态::已可能发布, 写入.事实代次);
        return 读回;
    }

    std::optional<因果类结点结果> 尝试重放删除(const 因果类删除请求& 请求) {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到) return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功
            || 首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_ || 首次.写入幂等身份 != 请求.幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果)
            return 失败(因果类数据状态::幂等冲突, 首次.读取事实代次);
        const auto& 写集 = *首次.首次规范化写集;
        const auto& 首次结果 = *首次.首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份 || !写集.节点.empty()
            || !写集.关系.empty() || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.size() < 9
            || std::count(写集.退出事实.begin(), 写集.退出事实.end(), 请求.因果结点) != 1
            || 首次结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(首次结果, 请求.幂等身份)
            || !首次结果.新编码映射.empty())
            return 失败(因果类数据状态::幂等冲突, 首次结果.事实代次);
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        if (写入.状态 != L1所有者范围写入状态::精确重复
            || !写入结果头完整(写入, 请求.幂等身份))
            return 失败(因果类数据状态::内部不一致, 写入.事实代次);
        auto 读回 = 读取已退出因果(请求.因果结点, 写入.事实代次,
            因果类数据状态::精确重复);
        if (!读回.成功()) return 失败(因果类数据状态::已可能发布, 写入.事实代次);
        return 读回;
    }

    因果类结点结果 提交新增(const L1所有者范围写集请求& 写集,
        L1所有者范围写入幂等身份 幂等身份, 因果类数据状态 成功状态) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 映射 = 映射写入状态(写入.状态, 成功状态);
        if (映射 != 成功状态 && 映射 != 因果类数据状态::精确重复)
            return 失败(映射, 写入.事实代次);
        if (!写入结果头完整(写入, 幂等身份)
            || 写入.新编码映射.size() != 5 + 写集.关系.size())
            return 写入.状态 == L1所有者范围写入状态::成功
                ? 失败(因果类数据状态::已可能发布, 写入.事实代次)
                : 失败(因果类数据状态::内部不一致, 写入.事实代次);
        const auto 结点 = 因果类数据内部::查找唯一编码(写入, 因果类数据内部::因果结点本地键);
        const auto 来源值 = 因果类数据内部::查找唯一编码(写入, 因果类数据内部::来源值本地键);
        const auto 规则值 = 因果类数据内部::查找唯一编码(写入, 因果类数据内部::规则版本值本地键);
        const auto 样本值 = 因果类数据内部::查找唯一编码(写入, 因果类数据内部::样本数量值本地键);
        const auto 失败值 = 因果类数据内部::查找唯一编码(写入, 因果类数据内部::失败数量值本地键);
        if (!结点 || !来源值 || !规则值 || !样本值 || !失败值)
            return 失败(因果类数据状态::已可能发布, 写入.事实代次);
        auto 读回 = 映射 == 因果类数据状态::精确重复
            ? 读取历史因果快照(*结点, 写入.事实代次, 写入.事实代次,
                因果类数据状态::精确重复, std::nullopt)
            : 读取当前因果(*结点, 写入.事实代次);
        if (!读回.成功() || !读回.因果结点
            || 读回.因果结点->来源值事实 != *来源值
            || 读回.因果结点->规则版本值事实 != *规则值
            || 读回.因果结点->样本数量值事实 != *样本值
            || 读回.因果结点->失败数量值事实 != *失败值)
            return 失败(因果类数据状态::已可能发布, 写入.事实代次);
        读回.状态 = 映射;
        return 读回;
    }

    因果类结点结果 读取当前因果(稳定编码 因果结点,
        std::uint64_t 期望事实代次) const {
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 期望事实代次;
        请求.所有者 = {所有者_}; 请求.节点 = {因果结点};
        请求.属性值 = {{因果结点, 来源属性类型_}, {因果结点, 规则版本属性类型_},
            {因果结点, 样本数量属性类型_}, {因果结点, 失败数量属性类型_}};
        const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(请求);
        if (读取.状态 != L1所有者范围一致当前读取状态::成功)
            return 失败(映射一致读取状态(读取.状态), 读取.读取事实代次);
        if (读取.合同版本 != L1所有者范围一致当前读取合同版本
            || 读取.期望事实代次 != 期望事实代次 || 读取.读取事实代次 != 期望事实代次
            || 读取.所有者.size() != 1 || 读取.节点.size() != 1 || 读取.属性值.size() != 4
            || !读取.关系.empty() || !读取.值.empty() || !读取.源关系组.empty()
            || !读取.目标关系组.empty() || 读取.所有者.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实
            || 读取.所有者.front().所有者事实->所有者 != 所有者_)
            return 失败(因果类数据状态::内部不一致, 读取.读取事实代次);
        const auto& 节点项 = 读取.节点.front();
        if (节点项.状态 == L1所有者范围一致当前读取项目状态::未找到)
            return 失败(因果类数据状态::未找到, 读取.读取事实代次);
        if (节点项.状态 == L1所有者范围一致当前读取项目状态::已退出)
            return 失败(因果类数据状态::目标已退出, 读取.读取事实代次);
        if (节点项.状态 != L1所有者范围一致当前读取项目状态::成功 || !节点项.事实)
            return 失败(因果类数据状态::内部不一致, 读取.读取事实代次);
        const auto& 节点 = *节点项.事实;
        if (节点.编码 != 因果结点 || 节点.写入所有者 != 所有者_
            || 节点.种类 != 节点种类::普通 || 节点.属性类型表示 || 节点.退出事实代次
            || 节点.创建事实代次 == 0 || 节点.创建事实代次 > 期望事实代次
            || 节点.当前属性.size() != 4)
            return 失败(因果类数据状态::内部不一致, 读取.读取事实代次);
        const auto* 来源投影 = 查找属性投影(读取, 来源属性类型_);
        const auto* 规则投影 = 查找属性投影(读取, 规则版本属性类型_);
        const auto* 样本投影 = 查找属性投影(读取, 样本数量属性类型_);
        const auto* 失败投影 = 查找属性投影(读取, 失败数量属性类型_);
        if (!来源投影 || !规则投影 || !样本投影 || !失败投影
            || !值投影完整(*来源投影, 节点, 来源属性类型_)
            || !值投影完整(*规则投影, 节点, 规则版本属性类型_)
            || !值投影完整(*样本投影, 节点, 样本数量属性类型_)
            || !值投影完整(*失败投影, 节点, 失败数量属性类型_))
            return 失败(因果类数据状态::内部不一致, 读取.读取事实代次);
        return 组装因果(节点, 来源投影->当前值事实, 规则投影->当前值事实,
            样本投影->当前值事实, 失败投影->当前值事实, 期望事实代次,
            因果类数据状态::已读取, std::nullopt, true);
    }

    因果类结点结果 读取已退出因果(稳定编码 因果结点,
        std::uint64_t 退出事实代次, 因果类数据状态 返回状态) const {
        if (退出事实代次 <= 1) return 失败(因果类数据状态::内部不一致, 退出事实代次);
        return 读取历史因果快照(因果结点, 退出事实代次 - 1,
            退出事实代次, 返回状态, 退出事实代次);
    }

    因果类结点结果 读取历史因果快照(稳定编码 因果结点,
        std::uint64_t 历史截止, std::uint64_t 结果代次,
        因果类数据状态 返回状态,
        std::optional<std::uint64_t> 要求退出代次) const {
        const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 因果结点});
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (节点读取.状态 != L1所有者范围读取状态::成功) return 失败(
            映射读取状态(节点读取.状态), 节点读取.读取事实代次);
        if (!节点 || 节点->编码 != 因果结点 || 节点->写入所有者 != 所有者_
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 == 0 || 节点->创建事实代次 > 历史截止
            || (节点->退出事实代次 && *节点->退出事实代次 <= 历史截止)
            || (要求退出代次 && 节点->退出事实代次 != 要求退出代次))
            return 失败(因果类数据状态::内部不一致, 节点读取.读取事实代次);
        const auto 属性读取 = 第一层服务_.读取所有者范围历史属性值组(
            {L1所有者范围CRUD合同版本, 因果结点, 历史截止});
        if (属性读取.状态 != L1所有者范围读取状态::成功
            || 属性读取.合同版本 != L1所有者范围CRUD合同版本
            || 属性读取.所属节点 != 因果结点 || 属性读取.历史截止事实代次 != 历史截止
            || 属性读取.属性值组.size() != 4)
            return 失败(因果类数据状态::内部不一致, 结果代次);
        const auto* 来源 = 查找历史值(属性读取.属性值组, 来源属性类型_, *节点,
            历史截止, 要求退出代次);
        const auto* 规则 = 查找历史值(属性读取.属性值组, 规则版本属性类型_, *节点,
            历史截止, 要求退出代次);
        const auto* 样本 = 查找历史值(属性读取.属性值组, 样本数量属性类型_, *节点,
            历史截止, 要求退出代次);
        const auto* 失败值 = 查找历史值(属性读取.属性值组, 失败数量属性类型_, *节点,
            历史截止, 要求退出代次);
        if (!来源 || !规则 || !样本 || !失败值)
            return 失败(因果类数据状态::内部不一致, 结果代次);
        return 组装因果(*节点, *来源, *规则, *样本, *失败值,
            历史截止, 返回状态, 要求退出代次, false, 结果代次);
    }

    因果类结点结果 组装因果(const L1所有者范围节点事实& 节点,
        const L1所有者范围值事实& 来源事实,
        const L1所有者范围值事实& 规则事实,
        const L1所有者范围值事实& 样本事实,
        const L1所有者范围值事实& 失败事实,
        std::uint64_t 截止, 因果类数据状态 返回状态,
        std::optional<std::uint64_t> 要求退出代次, bool 当前,
        std::uint64_t 结果代次 = 0) const {
        const auto* 来源 = std::get_if<L1所有者范围独立材料引用>(&来源事实.材料);
        const auto* 规则 = std::get_if<std::int64_t>(&规则事实.材料);
        const auto* 样本 = std::get_if<std::int64_t>(&样本事实.材料);
        const auto* 失败数 = std::get_if<std::int64_t>(&失败事实.材料);
        if (!来源 || !规则 || !样本 || !失败数 || !有效(来源->编码)
            || *规则 <= 0 || *样本 <= 0 || *失败数 < 0 || *失败数 > *样本)
            return 失败(因果类数据状态::内部不一致, 结果代次 ? 结果代次 : 截止);
        auto 条件 = 读取关系组(节点.编码, 条件关系类型_, 截止, 1, true, 当前, 要求退出代次);
        auto 动作 = 读取关系组(节点.编码, 动作关系类型_, 截止, 0, false, 当前, 要求退出代次);
        auto 结果 = 读取关系组(节点.编码, 结果关系类型_, 截止, 1, true, 当前, 要求退出代次);
        auto 动态 = 读取关系组(节点.编码, 动态证据关系类型_, 截止, 1, true, 当前, 要求退出代次);
        auto 场景 = 读取关系组(节点.编码, 适用场景关系类型_, 截止, 1, false, 当前, 要求退出代次);
        const auto 失败结果 = [&](const 候选读取结果& 读) {
            return !读.成功 ? std::optional<因果类结点结果>{失败(读.状态, 读.事实代次)}
                : std::optional<因果类结点结果>{};
        };
        if (auto f = 失败结果(条件)) return *f;
        if (auto f = 失败结果(动作)) return *f;
        if (auto f = 失败结果(结果)) return *f;
        if (auto f = 失败结果(动态)) return *f;
        if (auto f = 失败结果(场景)) return *f;
        if (动作.候选.size() > 1 || static_cast<std::int64_t>(动态.候选.size()) != *样本)
            return 失败(因果类数据状态::内部不一致, 结果代次 ? 结果代次 : 截止);
        if (当前) {
            if (const auto f = 验证状态组(条件.候选, 截止)) return *f;
            if (const auto f = 验证状态组(结果.候选, 截止)) return *f;
            if (const auto f = 验证动态组(动态.候选, 截止)) return *f;
            if (const auto f = 验证场景组(场景.候选, 截止)) return *f;
            if (!动作.候选.empty()) {
                const auto s = 验证普通当前结点(动作.候选.front(), 截止);
                if (s != 因果类数据状态::已读取) return 失败(s, 截止);
            }
            const auto s = 验证普通当前结点(来源->编码, 截止);
            if (s != 因果类数据状态::已读取) return 失败(s, 截止);
        }
        因果类结点 值{节点.编码, 来源事实.编码, 规则事实.编码,
            样本事实.编码, 失败事实.编码, {}, std::nullopt, {}, {}, {},
            来源->编码, *规则, *样本, *失败数, 节点.创建事实代次, 要求退出代次};
        for (std::size_t i = 0; i < 条件.候选.size(); ++i)
            值.有序条件状态组.push_back({static_cast<std::uint32_t>(i + 1),
                条件.关系组[i].编码, 条件.候选[i]});
        if (!动作.候选.empty()) 值.动作 = 因果类动作成员{
            动作.关系组.front().编码, 动作.候选.front()};
        for (std::size_t i = 0; i < 结果.候选.size(); ++i)
            值.有序结果状态组.push_back({static_cast<std::uint32_t>(i + 1),
                结果.关系组[i].编码, 结果.候选[i]});
        for (std::size_t i = 0; i < 动态.候选.size(); ++i)
            值.有序动态证据组.push_back({static_cast<std::uint32_t>(i + 1),
                动态.关系组[i].编码, 动态.候选[i]});
        for (std::size_t i = 0; i < 场景.候选.size(); ++i)
            值.适用场景组.push_back({场景.关系组[i].编码, 场景.候选[i]});
        if (!因果类结点闭合(值)) return 失败(因果类数据状态::内部不一致,
            结果代次 ? 结果代次 : 截止);
        return {返回状态, 因果类数据合同版本, 结果代次 ? 结果代次 : 截止, std::move(值)};
    }

    候选读取结果 读取关系组(稳定编码 源, 稳定编码 类型,
        std::uint64_t 截止, std::size_t 最小数量, bool 有序,
        bool 当前, std::optional<std::uint64_t> 要求退出代次) const {
        std::vector<L1所有者范围关系事实> 关系组;
        std::uint64_t 读取代次 = 0;
        if (当前) {
            const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
                {L1所有者范围CRUD合同版本, 源, 类型});
            if (读取.状态 != L1所有者范围读取状态::成功)
                return {false, 映射读取状态(读取.状态), 读取.读取事实代次, {}, {}};
            if (读取.合同版本 != L1所有者范围CRUD合同版本 || 读取.源节点 != 源
                || 读取.关系类型节点 != 类型 || 读取.读取事实代次 != 截止)
                return {false, 读取.读取事实代次 != 截止
                    ? 因果类数据状态::事实代次漂移 : 因果类数据状态::内部不一致,
                    读取.读取事实代次, {}, {}};
            关系组 = 读取.关系组; 读取代次 = 读取.读取事实代次;
        } else {
            const auto 读取 = 第一层服务_.读取所有者范围历史关系组(
                {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                    源, 类型, 截止});
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.端点节点 != 源 || 读取.关系类型节点 != 类型
                || 读取.历史截止事实代次 != 截止)
                return {false, 映射读取状态(读取.状态), 读取.读取事实代次, {}, {}};
            关系组 = 读取.关系组; 读取代次 = 读取.读取事实代次;
        }
        if (关系组.size() < 最小数量 || 关系组.size() > 因果类数据内部::最大成员数量)
            return {false, 因果类数据状态::内部不一致, 读取代次, {}, {}};
        if (有序) std::sort(关系组.begin(), 关系组.end(),
            [](const auto& a, const auto& b) noexcept { return a.角色或顺序 < b.角色或顺序; });
        else std::sort(关系组.begin(), 关系组.end(),
            [](const auto& a, const auto& b) noexcept { return a.目标节点 < b.目标节点; });
        std::vector<稳定编码> 目标组;
        for (std::size_t i = 0; i < 关系组.size(); ++i) {
            const auto& 关系 = 关系组[i];
            if (!有效(关系.编码) || 关系.源节点 != 源 || !有效(关系.目标节点)
                || 关系.关系类型节点 != 类型 || 关系.写入所有者 != 所有者_
                || 关系.创建事实代次 == 0 || 关系.创建事实代次 > 截止
                || 关系.角色或顺序 != (有序 ? static_cast<std::int64_t>(i + 1) : 1)
                || (当前 && 关系.退出事实代次)
                || (!当前 && 关系.退出事实代次 && *关系.退出事实代次 <= 截止)
                || (要求退出代次 && 关系.退出事实代次 != 要求退出代次))
                return {false, 因果类数据状态::内部不一致, 读取代次, {}, {}};
            if (std::find(目标组.begin(), 目标组.end(), 关系.目标节点) != 目标组.end())
                return {false, 因果类数据状态::内部不一致, 读取代次, {}, {}};
            目标组.push_back(关系.目标节点);
        }
        return {true, 因果类数据状态::已读取, 读取代次,
            std::move(目标组), std::move(关系组)};
    }

    候选读取结果 读取目标关系候选(稳定编码 目标, 稳定编码 类型,
        std::uint64_t 期望事实代次) const {
        try {
            const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
                {L1所有者范围CRUD合同版本, 目标, 类型});
            if (读取.状态 != L1所有者范围读取状态::成功)
                return {false, 映射读取状态(读取.状态), 读取.读取事实代次, {}, {}};
            if (读取.合同版本 != L1所有者范围CRUD合同版本 || 读取.目标节点 != 目标
                || 读取.关系类型节点 != 类型 || 读取.读取事实代次 != 期望事实代次)
                return {false, 读取.读取事实代次 != 期望事实代次
                    ? 因果类数据状态::事实代次漂移 : 因果类数据状态::内部不一致,
                    读取.读取事实代次, {}, {}};
            std::vector<稳定编码> 候选;
            for (const auto& 关系 : 读取.关系组) {
                if (关系.目标节点 != 目标 || 关系.关系类型节点 != 类型
                    || 关系.写入所有者 != 所有者_ || 关系.退出事实代次)
                    return {false, 因果类数据状态::内部不一致, 读取.读取事实代次, {}, {}};
                候选.push_back(关系.源节点);
            }
            return {true, 因果类数据状态::已读取, 读取.读取事实代次,
                std::move(候选), {}};
        } catch (const std::bad_alloc&) {
            return {false, 因果类数据状态::资源失败, 0, {}, {}};
        } catch (...) {
            return {false, 因果类数据状态::内部不一致, 0, {}, {}};
        }
    }

    因果类组查询结果 闭合候选(std::vector<稳定编码> 候选,
        std::uint64_t 期望事实代次, std::uint64_t 最大结果数量) const {
        try {
            std::sort(候选.begin(), 候选.end());
            候选.erase(std::unique(候选.begin(), 候选.end()), 候选.end());
            if (候选.size() > 最大结果数量)
                return 组失败(因果类数据状态::数量预算不足, 期望事实代次);
            因果类组查询结果 结果{因果类数据状态::已读取,
                因果类数据合同版本, 期望事实代次, {}};
            for (const auto 编码 : 候选) {
                const auto 单项 = 读取当前因果(编码, 期望事实代次);
                if (!单项.成功() || 单项.状态 != 因果类数据状态::已读取 || !单项.因果结点)
                    return 组失败(因果类数据状态::内部不一致, 期望事实代次);
                结果.因果组.push_back(*单项.因果结点);
            }
            return 结果;
        } catch (const std::bad_alloc&) { return 组失败(因果类数据状态::资源失败); }
        catch (const std::length_error&) { return 组失败(因果类数据状态::资源失败); }
        catch (...) { return 组失败(因果类数据状态::内部不一致); }
    }

    const L1所有者范围一致属性值投影* 查找属性投影(
        const L1所有者范围一致当前读取结果& 读取, 稳定编码 类型) const noexcept {
        const auto it = std::find_if(读取.属性值.begin(), 读取.属性值.end(),
            [&](const auto& 项) noexcept { return 项.节点 == 读取.节点.front().查询编码
                && 项.属性类型 == 类型; });
        return it != 读取.属性值.end()
                && it->状态 == L1所有者范围一致当前读取项目状态::成功 && it->投影
            ? &*it->投影 : nullptr;
    }

    static bool 值投影完整(const L1所有者范围一致属性值投影& 投影,
        const L1所有者范围节点事实& 节点, 稳定编码 类型) noexcept {
        const auto& 值 = 投影.当前值事实;
        return 投影.属性槽.属性类型节点 == 类型 && 投影.属性槽.当前值 == 值.编码
            && std::find(节点.当前属性.begin(), 节点.当前属性.end(), 投影.属性槽)
                != 节点.当前属性.end() && 值.所属节点 == 节点.编码
            && 值.属性类型节点 == 类型 && 值.来源节点 == 节点.编码
            && 值.写入所有者 == 节点.写入所有者
            && 值.创建事实代次 == 节点.创建事实代次 && !值.退出事实代次;
    }

    const L1所有者范围值事实* 查找历史值(
        const std::vector<L1所有者范围值事实>& 组, 稳定编码 类型,
        const L1所有者范围节点事实& 节点, std::uint64_t 截止,
        std::optional<std::uint64_t> 要求退出代次) const noexcept {
        const L1所有者范围值事实* 找到 = nullptr;
        for (const auto& 值 : 组) {
            if (值.属性类型节点 != 类型) continue;
            if (找到 || 值.所属节点 != 节点.编码 || 值.来源节点 != 节点.编码
                || 值.写入所有者 != 所有者_ || 值.创建事实代次 != 节点.创建事实代次
                || 值.创建事实代次 > 截止
                || (值.退出事实代次 && *值.退出事实代次 <= 截止)
                || (要求退出代次 && 值.退出事实代次 != 要求退出代次)) return nullptr;
            找到 = &值;
        }
        return 找到;
    }

    bool 写入结果头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等身份) const noexcept {
        const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_ && 写入.写入幂等身份 == 幂等身份
            && 写入.事实代次 != 0 && (首次 || 重复);
    }

    static 因果类结点结果 失败(因果类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 因果类数据合同版本, 事实代次, std::nullopt};
    }
    static 因果类组查询结果 组失败(因果类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 因果类数据合同版本, 事实代次, {}};
    }

    static 因果类数据状态 映射状态状态(状态类数据状态 状态) noexcept {
        switch (状态) {
        case 状态类数据状态::未找到: return 因果类数据状态::状态未找到;
        case 状态类数据状态::目标已退出: return 因果类数据状态::状态已退出;
        case 状态类数据状态::事实代次漂移: return 因果类数据状态::事实代次漂移;
        case 状态类数据状态::入口拒绝: return 因果类数据状态::入口拒绝;
        case 状态类数据状态::历史材料已清理: return 因果类数据状态::历史材料已清理;
        case 状态类数据状态::资源失败: return 因果类数据状态::资源失败;
        default: return 因果类数据状态::状态读取失败;
        }
    }
    static 因果类数据状态 映射动态状态(动态类数据状态 状态) noexcept {
        switch (状态) {
        case 动态类数据状态::未找到: return 因果类数据状态::动态未找到;
        case 动态类数据状态::目标已退出: return 因果类数据状态::动态已退出;
        case 动态类数据状态::事实代次漂移: return 因果类数据状态::事实代次漂移;
        case 动态类数据状态::入口拒绝: return 因果类数据状态::入口拒绝;
        case 动态类数据状态::历史材料已清理: return 因果类数据状态::历史材料已清理;
        case 动态类数据状态::资源失败: return 因果类数据状态::资源失败;
        default: return 因果类数据状态::动态读取失败;
        }
    }
    static 因果类数据状态 映射场景状态(场景类数据状态 状态) noexcept {
        switch (状态) {
        case 场景类数据状态::未找到: return 因果类数据状态::场景未找到;
        case 场景类数据状态::目标已退出: return 因果类数据状态::场景已退出;
        case 场景类数据状态::事实代次漂移: return 因果类数据状态::事实代次漂移;
        case 场景类数据状态::入口拒绝: return 因果类数据状态::入口拒绝;
        case 场景类数据状态::历史材料已清理: return 因果类数据状态::历史材料已清理;
        case 场景类数据状态::资源失败: return 因果类数据状态::资源失败;
        default: return 因果类数据状态::场景读取失败;
        }
    }
    static 因果类数据状态 映射读取状态(L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::未找到: return 因果类数据状态::未找到;
        case L1所有者范围读取状态::已退出: return 因果类数据状态::目标已退出;
        case L1所有者范围读取状态::事实代次漂移: return 因果类数据状态::事实代次漂移;
        case L1所有者范围读取状态::历史材料已清理: return 因果类数据状态::历史材料已清理;
        case L1所有者范围读取状态::入口拒绝: return 因果类数据状态::入口拒绝;
        case L1所有者范围读取状态::资源失败: return 因果类数据状态::资源失败;
        default: return 因果类数据状态::内部不一致;
        }
    }
    static 因果类数据状态 映射一致读取状态(
        L1所有者范围一致当前读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围一致当前读取状态::事实代次漂移: return 因果类数据状态::事实代次漂移;
        case L1所有者范围一致当前读取状态::入口拒绝: return 因果类数据状态::入口拒绝;
        case L1所有者范围一致当前读取状态::资源失败: return 因果类数据状态::资源失败;
        default: return 因果类数据状态::内部不一致;
        }
    }
    static 因果类数据状态 映射属性组读取状态(
        L1所有者范围属性类型当前值组读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围属性类型当前值组读取状态::成功: return 因果类数据状态::已读取;
        case L1所有者范围属性类型当前值组读取状态::未找到: return 因果类数据状态::结构类型未找到;
        case L1所有者范围属性类型当前值组读取状态::已退出: return 因果类数据状态::结构类型已退出;
        case L1所有者范围属性类型当前值组读取状态::事实代次漂移: return 因果类数据状态::事实代次漂移;
        case L1所有者范围属性类型当前值组读取状态::数量预算不足: return 因果类数据状态::数量预算不足;
        case L1所有者范围属性类型当前值组读取状态::入口拒绝: return 因果类数据状态::入口拒绝;
        case L1所有者范围属性类型当前值组读取状态::资源失败: return 因果类数据状态::资源失败;
        default: return 因果类数据状态::内部不一致;
        }
    }
    static 因果类数据状态 映射写入状态(L1所有者范围写入状态 状态,
        因果类数据状态 成功状态) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功: return 成功状态;
        case L1所有者范围写入状态::精确重复: return 因果类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝: return 因果类数据状态::入口拒绝;
        case L1所有者范围写入状态::未找到: return 因果类数据状态::结构类型未找到;
        case L1所有者范围写入状态::已退出: return 因果类数据状态::结构类型已退出;
        case L1所有者范围写入状态::事实代次漂移: return 因果类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突: return 因果类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突: return 因果类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败: return 因果类数据状态::资源失败;
        default: return 因果类数据状态::内部不一致;
        }
    }

    const L1事实基座服务& 第一层服务_;
    const 状态类数据服务& 状态服务_;
    const 动态类数据服务& 动态服务_;
    const 场景类数据服务& 场景服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    稳定编码 来源属性类型_{};
    稳定编码 规则版本属性类型_{};
    稳定编码 样本数量属性类型_{};
    稳定编码 失败数量属性类型_{};
    稳定编码 条件关系类型_{};
    稳定编码 动作关系类型_{};
    稳定编码 结果关系类型_{};
    稳定编码 动态证据关系类型_{};
    稳定编码 适用场景关系类型_{};
};

} // namespace 海中鱼巣
