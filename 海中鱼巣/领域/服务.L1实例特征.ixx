export namespace 海中鱼巣 {

namespace L1实例特征内部 {

inline constexpr std::uint64_t 登记幂等域 = 0x05ULL;
inline constexpr std::uint64_t 实例幂等域 = 0x06ULL;
inline constexpr std::uint64_t 换代幂等域 = 0x07ULL;

写集幂等键 映射幂等键(std::uint64_t 域, 特征操作幂等身份 身份) noexcept {
    return {(域 << 56) | 身份.值};
}

std::optional<稳定编码> 查找映射(const L1写入结果& 结果,
    std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& 项 : 结果.新编码映射) {
        if (项.first.值 != 本地键) continue;
        if (找到.has_value()) return std::nullopt;
        找到 = 项.second;
    }
    return 找到;
}

bool 映射唯一(const L1写入结果& 结果) noexcept {
    for (std::size_t i = 0; i < 结果.新编码映射.size(); ++i) {
        if (!有效(结果.新编码映射[i].first)
            || !有效(结果.新编码映射[i].second)) return false;
        for (std::size_t j = i + 1; j < 结果.新编码映射.size(); ++j) {
            if (结果.新编码映射[i].first == 结果.新编码映射[j].first
                || 结果.新编码映射[i].second == 结果.新编码映射[j].second) return false;
        }
    }
    return true;
}

bool 实例请求相同(const 初始场景I64实例特征建立请求& 左,
    const 初始场景I64实例特征建立请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份 && 左.期望事实代次 == 右.期望事实代次
        && 左.宿主 == 右.宿主
        && 左.定义.合同版本 == 右.定义.合同版本
        && 左.定义.规则版本 == 右.定义.规则版本
        && 左.定义.特征定义 == 右.定义.特征定义
        && 左.定义.定义标记值 == 右.定义.定义标记值
        && 左.定义.下界值 == 右.定义.下界值
        && 左.定义.上界值 == 右.定义.上界值
        && 左.初始值 == 右.初始值 && 左.来源节点 == 右.来源节点;
}

bool 读取请求相同(const I64实例特征读取请求& 左,
    const I64实例特征读取请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.宿主 == 右.宿主
        && 左.定义.合同版本 == 右.定义.合同版本
        && 左.定义.规则版本 == 右.定义.规则版本
        && 左.定义.特征定义 == 右.定义.特征定义
        && 左.定义.定义标记值 == 右.定义.定义标记值
        && 左.定义.下界值 == 右.定义.下界值
        && 左.定义.上界值 == 右.定义.上界值
        && 左.实例槽 == 右.实例槽
        && 左.宿主关系 == 右.宿主关系
        && 左.定义关系 == 右.定义关系
        && 左.当前值 == 右.当前值
        && 左.来源节点 == 右.来源节点;
}

bool 换代请求相同(const I64实例特征当前值换代请求& 左,
    const I64实例特征当前值换代请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份
        && 左.期望事实代次 == 右.期望事实代次
        && 左.新值 == 右.新值 && 左.新来源节点 == 右.新来源节点
        && 读取请求相同(左.当前事实, 右.当前事实);
}

bool 定义读取请求相同(const I64特征定义读取请求& 左,
    const I64特征定义读取请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.特征定义 == 右.特征定义 && 左.定义标记值 == 右.定义标记值
        && 左.下界值 == 右.下界值 && 左.上界值 == 右.上界值;
}

bool 实际存在实例请求相同(const 实际存在I64实例特征建立请求& 左,
    const 实际存在I64实例特征建立请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份
        && 左.期望事实代次 == 右.期望事实代次
        && 左.宿主 == 右.宿主 && 定义读取请求相同(左.定义, 右.定义)
        && 左.初始值 == 右.初始值 && 左.来源节点 == 右.来源节点;
}

实例特征状态 映射写入状态(L1写入状态 状态) noexcept {
    switch (状态) {
    case L1写入状态::成功: return 实例特征状态::已提交;
    case L1写入状态::精确重复: return 实例特征状态::幂等读回;
    case L1写入状态::幂等冲突: return 实例特征状态::幂等冲突;
    case L1写入状态::未找到:
    case L1写入状态::已退出: return 实例特征状态::未找到;
    case L1写入状态::事实代次漂移: return 实例特征状态::事实代次漂移;
    case L1写入状态::资源失败: return 实例特征状态::资源失败;
    case L1写入状态::内部不一致: return 实例特征状态::内部不一致;
    default: return 实例特征状态::入口拒绝;
    }
}

实例特征状态 映射场景状态(世界结构状态 状态) noexcept {
    switch (状态) {
    case 世界结构状态::已读取: return 实例特征状态::已读取;
    case 世界结构状态::版本漂移: return 实例特征状态::事实代次漂移;
    case 世界结构状态::资源失败: return 实例特征状态::资源失败;
    case 世界结构状态::未找到: return 实例特征状态::未找到;
    case 世界结构状态::内部不一致: return 实例特征状态::内部不一致;
    default: return 实例特征状态::入口拒绝;
    }
}

实例特征状态 映射定义状态(特征定义状态 状态) noexcept {
    switch (状态) {
    case 特征定义状态::已读取: return 实例特征状态::已读取;
    case 特征定义状态::事实代次漂移: return 实例特征状态::事实代次漂移;
    case 特征定义状态::资源失败: return 实例特征状态::资源失败;
    case 特征定义状态::未找到: return 实例特征状态::未找到;
    case 特征定义状态::内部不一致: return 实例特征状态::内部不一致;
    case 特征定义状态::登记未加载: return 实例特征状态::登记未加载;
    default: return 实例特征状态::入口拒绝;
    }
}

实例特征状态 映射实际存在状态(实际存在状态 状态) noexcept {
    switch (状态) {
    case 实际存在状态::已读取: return 实例特征状态::已读取;
    case 实际存在状态::未找到: return 实例特征状态::未找到;
    case 实际存在状态::版本漂移: return 实例特征状态::事实代次漂移;
    case 实际存在状态::资源失败: return 实例特征状态::资源失败;
    case 实际存在状态::内部不一致: return 实例特征状态::内部不一致;
    default: return 实例特征状态::入口拒绝;
    }
}

struct 实例写入材料 final {
    std::uint64_t 期望事实代次 = 0;
    特征操作幂等身份 幂等身份;
    稳定编码 宿主;
    稳定编码 定义;
    std::int64_t 初始值 = 0;
    稳定编码 来源;
    稳定编码 宿主关系类型;
    稳定编码 定义关系类型;
    稳定编码 当前值属性类型;
};

L1写集请求 形成实例写集(const 实例写入材料& 材料) {
    L1写集请求 写集;
    写集.期望事实代次 = 材料.期望事实代次;
    写集.幂等键 = 映射幂等键(实例幂等域, 材料.幂等身份);
    写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{2}, 事实引用{材料.宿主}, 事实引用{写集本地键{1}},
            事实引用{材料.宿主关系类型}, 1},
        {{3}, 事实引用{写集本地键{1}}, 事实引用{材料.定义},
            事实引用{材料.定义关系类型}, 2}};
    写集.值 = {{{4}, 事实引用{写集本地键{1}},
        事实引用{材料.当前值属性类型}, 材料.初始值, 事实引用{材料.来源}}};
    写集.属性槽变更 = {{事实引用{写集本地键{1}},
        事实引用{材料.当前值属性类型}, 写集本地键{4}}};
    return 写集;
}

struct 实例写入结果 final {
    实例特征状态 状态 = 实例特征状态::入口拒绝;
    std::uint64_t 事实代次 = 0;
    稳定编码 实例槽;
    稳定编码 宿主关系;
    稳定编码 定义关系;
    稳定编码 当前值;
};

实例写入结果 提交实例写集(L1事实基座服务& L1, const L1写集请求& 写集) {
    const auto 写入 = L1.提交写集(写集);
    const auto 状态 = 映射写入状态(写入.状态);
    if (状态 != 实例特征状态::已提交 && 状态 != 实例特征状态::幂等读回)
        return {状态};
    if (写入.事实代次 == 0 || !映射唯一(写入))
        return {实例特征状态::内部不一致};
    if (写入.状态 == L1写入状态::精确重复 && 写入.新编码映射.empty())
        return {状态, 写入.事实代次};
    if (写入.新编码映射.size() != 4)
        return {实例特征状态::内部不一致};
    const auto 槽 = 查找映射(写入, 1);
    const auto 宿主关系 = 查找映射(写入, 2);
    const auto 定义关系 = 查找映射(写入, 3);
    const auto 当前值 = 查找映射(写入, 4);
    if (!槽 || !宿主关系 || !定义关系 || !当前值)
        return {实例特征状态::内部不一致};
    return {状态, 写入.事实代次, *槽, *宿主关系, *定义关系, *当前值};
}

bool 读取节点(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t& 代次, 节点事实& 输出, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取当前节点({L1事实基座合同版本, 编码});
    if (结果.状态 != L1读取状态::成功 || !结果.事实.has_value()) {
        失败 = (结果.状态 == L1读取状态::未找到
                || 结果.状态 == L1读取状态::已退出)
            ? 实例特征状态::未找到
            : (结果.状态 == L1读取状态::资源失败
                ? 实例特征状态::资源失败 : 实例特征状态::内部不一致);
        return false;
    }
    const auto* 节点 = std::get_if<节点事实>(&*结果.事实);
    if (!节点 || 结果.读取事实代次 == 0) {
        失败 = 实例特征状态::内部不一致;
        return false;
    }
    if (代次 == 0) 代次 = 结果.读取事实代次;
    else if (代次 != 结果.读取事实代次) {
        失败 = 实例特征状态::事实代次漂移;
        return false;
    }
    输出 = *节点;
    return true;
}

bool 读取关系(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t& 代次, 关系事实& 输出, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取当前关系({L1事实基座合同版本, 编码});
    if (结果.状态 != L1读取状态::成功 || !结果.事实.has_value()) {
        失败 = (结果.状态 == L1读取状态::未找到
                || 结果.状态 == L1读取状态::已退出)
            ? 实例特征状态::未找到
            : (结果.状态 == L1读取状态::资源失败
                ? 实例特征状态::资源失败 : 实例特征状态::内部不一致);
        return false;
    }
    const auto* 关系 = std::get_if<关系事实>(&*结果.事实);
    if (!关系 || 结果.读取事实代次 == 0) {
        失败 = 实例特征状态::内部不一致;
        return false;
    }
    if (代次 == 0) 代次 = 结果.读取事实代次;
    else if (代次 != 结果.读取事实代次) {
        失败 = 实例特征状态::事实代次漂移;
        return false;
    }
    输出 = *关系;
    return true;
}

bool 读取值(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t& 代次, 值事实& 输出, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取当前值({L1事实基座合同版本, 编码});
    if (结果.状态 != L1读取状态::成功 || !结果.事实.has_value()) {
        失败 = (结果.状态 == L1读取状态::未找到
                || 结果.状态 == L1读取状态::已退出)
            ? 实例特征状态::未找到
            : (结果.状态 == L1读取状态::资源失败
                ? 实例特征状态::资源失败 : 实例特征状态::内部不一致);
        return false;
    }
    const auto* 值 = std::get_if<值事实>(&*结果.事实);
    if (!值 || 结果.读取事实代次 == 0) {
        失败 = 实例特征状态::内部不一致;
        return false;
    }
    if (代次 == 0) 代次 = 结果.读取事实代次;
    else if (代次 != 结果.读取事实代次) {
        失败 = 实例特征状态::事实代次漂移;
        return false;
    }
    输出 = *值;
    return true;
}

} // namespace L1实例特征内部

class L1实例特征服务 final {
public:
    L1实例特征服务(L1事实基座服务& L1, L1场景结构服务& 场景结构,
        L1特征定义服务& 特征定义) noexcept
        : L1_(L1), 场景结构_(场景结构), 特征定义_(特征定义) {}
    L1实例特征服务(L1事实基座服务& L1, L1场景结构服务& 场景结构,
        L1特征定义服务& 特征定义,
        L1实际存在场景组合服务& 实际存在) noexcept
        : L1_(L1), 场景结构_(场景结构), 特征定义_(特征定义),
          实际存在_(&实际存在) {}
    L1实例特征服务(const L1实例特征服务&) = delete;
    L1实例特征服务& operator=(const L1实例特征服务&) = delete;

    实例特征登记结果 建立登记(const 实例特征登记请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!实例特征登记请求有效(请求)) return {};
            if (首次登记请求_.has_value()) {
                if (*首次登记请求_ == 请求) return {实例特征状态::幂等读回, 登记_};
                return {实例特征状态::幂等冲突, std::nullopt};
            }
            const auto 快照 = L1_.读取完整快照({});
            if (快照.状态 != L1读取状态::成功 || !快照.快照.has_value())
                return {实例特征状态::内部不一致, std::nullopt};
            if (快照.快照->事实代次 != 请求.期望事实代次) return {实例特征状态::事实代次漂移, std::nullopt};

            L1写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = L1实例特征内部::映射幂等键(
                L1实例特征内部::登记幂等域, 请求.幂等身份);
            写集.节点 = {
                {{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::普通, std::nullopt},
                {{3}, 节点种类::普通, std::nullopt},
                {{4}, 节点种类::属性类型, 值表示种类::I64}};
            const auto 写入 = L1_.提交写集(写集);
            const auto 状态 = L1实例特征内部::映射写入状态(写入.状态);
            if (状态 != 实例特征状态::已提交 && 状态 != 实例特征状态::幂等读回)
                return {状态, std::nullopt};
            if (写入.事实代次 == 0 || 写入.新编码映射.size() != 4
                || !L1实例特征内部::映射唯一(写入)) return {实例特征状态::内部不一致, std::nullopt};
            const auto 服务 = L1实例特征内部::查找映射(写入, 1);
            const auto 宿主 = L1实例特征内部::查找映射(写入, 2);
            const auto 定义 = L1实例特征内部::查找映射(写入, 3);
            const auto 属性 = L1实例特征内部::查找映射(写入, 4);
            if (!服务 || !宿主 || !定义 || !属性) return {实例特征状态::内部不一致, std::nullopt};
            std::uint64_t 代次 = 0;
            节点事实 服务节点, 宿主节点, 定义节点, 属性节点;
            实例特征状态 失败 = 实例特征状态::内部不一致;
            if (!L1实例特征内部::读取节点(L1_, *服务, 代次, 服务节点, 失败)
                || !L1实例特征内部::读取节点(L1_, *宿主, 代次, 宿主节点, 失败)
                || !L1实例特征内部::读取节点(L1_, *定义, 代次, 定义节点, 失败)
                || !L1实例特征内部::读取节点(L1_, *属性, 代次, 属性节点, 失败)
                || 代次 != 写入.事实代次 || 服务节点.种类 != 节点种类::普通
                || 宿主节点.种类 != 节点种类::普通 || 定义节点.种类 != 节点种类::普通
                || 属性节点.种类 != 节点种类::属性类型) return {失败, std::nullopt};
            实例特征结构登记 新登记;
            新登记.事实截止代次 = 代次;
            新登记.服务身份 = *服务;
            新登记.宿主槽关系类型 = *宿主;
            新登记.定义模板关系类型 = *定义;
            新登记.当前I64值属性类型 = *属性;
            if (!实例特征结构登记完整(新登记)) return {实例特征状态::内部不一致, std::nullopt};
            首次登记请求_ = 请求;
            登记_ = 新登记;
            return {状态, 登记_};
        } catch (const std::bad_alloc&) { return {实例特征状态::资源失败, std::nullopt}; }
        catch (...) { return {实例特征状态::内部不一致, std::nullopt}; }
    }

    实例特征登记结果 读取当前登记() const {
        std::lock_guard<std::mutex> 锁(锁_);
        return 登记_.has_value() ? 实例特征登记结果{实例特征状态::已读取, 登记_}
            : 实例特征登记结果{实例特征状态::登记未加载, std::nullopt};
    }

    I64实例特征结果 建立初始场景I64实例特征(
        const 初始场景I64实例特征建立请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!初始场景I64实例特征建立请求有效(请求)
                || !登记_.has_value()) return {登记_.has_value() ? 实例特征状态::入口拒绝 : 实例特征状态::登记未加载, std::nullopt, {}, {}};
            if (首次实例请求_.has_value()) {
                if (!L1实例特征内部::实例请求相同(*首次实例请求_, 请求)) return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
                auto 读回 = 读取I64实例特征内部(实例读取请求_);
                if (读回.状态 == 实例特征状态::已读取) 读回.状态 = 实例特征状态::幂等读回;
                return 读回;
            }
            if (请求.期望事实代次 != 登记_->事实截止代次) return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            const auto 场景 = 场景结构_.读取初始场景(请求.宿主);
            if (场景.状态 != 世界结构状态::已读取 || !场景.事实.has_value())
                return {L1实例特征内部::映射场景状态(场景.状态), std::nullopt, {}, {}};
            const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
            if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value())
                return {L1实例特征内部::映射定义状态(定义.状态), std::nullopt, {}, {}};
            if (场景.事实->事实截止代次 != 请求.期望事实代次
                || 定义.事实->事实截止代次 != 请求.期望事实代次)
                return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            if (请求.初始值 < 定义.事实->下界 || 请求.初始值 > 定义.事实->上界)
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            std::uint64_t 代次 = 请求.期望事实代次;
            节点事实 来源节点;
            实例特征状态 失败 = 实例特征状态::内部不一致;
            if (!L1实例特征内部::读取节点(L1_, 请求.来源节点, 代次, 来源节点, 失败)) return {失败, std::nullopt, {}, {}};
            if (来源节点.种类 != 节点种类::普通) return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            const auto 快照 = L1_.读取完整快照({});
            if (快照.状态 != L1读取状态::成功 || !快照.快照.has_value()
                || 快照.快照->事实代次 != 请求.期望事实代次) return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            for (const auto& 关系 : 快照.快照->当前关系) {
                if (关系.退出事实代次 || 关系.角色或顺序 == 1
                    && 关系.源节点 == 场景.事实->初始场景.编码
                    && 关系.关系类型节点 == 登记_->宿主槽关系类型) return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            }
            const auto 写集 = L1实例特征内部::形成实例写集({
                请求.期望事实代次, 请求.幂等身份,
                场景.事实->初始场景.编码, 定义.事实->特征定义,
                请求.初始值, 请求.来源节点, 登记_->宿主槽关系类型,
                登记_->定义模板关系类型, 登记_->当前I64值属性类型});
            const auto 写入 = L1实例特征内部::提交实例写集(L1_, 写集);
            const auto 状态 = 写入.状态;
            if (状态 != 实例特征状态::已提交 && 状态 != 实例特征状态::幂等读回)
                return {状态, std::nullopt, {}, {}};
            if (!有效(写入.实例槽) || !有效(写入.宿主关系)
                || !有效(写入.定义关系) || !有效(写入.当前值))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            实例读取请求_ = {};
            实例读取请求_.宿主 = 请求.宿主;
            实例读取请求_.定义 = 请求.定义;
            实例读取请求_.实例槽 = 写入.实例槽;
            实例读取请求_.宿主关系 = 写入.宿主关系;
            实例读取请求_.定义关系 = 写入.定义关系;
            实例读取请求_.当前值 = 写入.当前值;
            实例读取请求_.来源节点 = 请求.来源节点;
            const auto 读回 = 读取I64实例特征内部(实例读取请求_);
            if (读回.状态 != 实例特征状态::已读取 || !读回.事实.has_value()
                || 读回.事实->事实截止代次 != 写入.事实代次)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            首次实例请求_ = 请求;
            return {状态, 读回.事实, 读回.宿主关系, 读回.定义关系};
        } catch (const std::bad_alloc&) { return {实例特征状态::资源失败, std::nullopt, {}, {}}; }
        catch (...) { return {实例特征状态::内部不一致, std::nullopt, {}, {}}; }
    }

    I64实例特征结果 建立实际存在I64实例特征(
        const 实际存在I64实例特征建立请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!实际存在I64实例特征建立请求有效(请求) || !实际存在_)
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            if (!登记_.has_value())
                return {实例特征状态::登记未加载, std::nullopt, {}, {}};
            const auto 键 = 请求.幂等身份.值;
            const auto 已有 = 实际存在实例账_.find(键);
            if (已有 != 实际存在实例账_.end()) {
                if (!L1实例特征内部::实际存在实例请求相同(已有->second.请求, 请求))
                    return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
                const auto 重复写入 = L1实例特征内部::提交实例写集(L1_, 已有->second.写集);
                if (重复写入.状态 != 实例特征状态::幂等读回
                    || !实际存在I64实例特征读取请求有效(已有->second.读取请求))
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
                auto 读回 = 读取实际存在I64实例特征内部(已有->second.读取请求);
                if (读回.状态 != 实例特征状态::已读取 || !读回.事实.has_value()
                    || 读回.事实->事实截止代次 < 重复写入.事实代次)
                    return {读回.状态 == 实例特征状态::已读取
                        ? 实例特征状态::内部不一致 : 读回.状态,
                        std::nullopt, {}, {}};
                读回.状态 = 实例特征状态::幂等读回;
                return 读回;
            }
            const auto 宿主 = 实际存在_->读取实际存在(请求.宿主);
            if (宿主.状态 != 实际存在状态::已读取 || !宿主.事实.has_value())
                return {L1实例特征内部::映射实际存在状态(宿主.状态),
                    std::nullopt, {}, {}};
            if (!实际存在事实完整(*宿主.事实))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
            if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value())
                return {L1实例特征内部::映射定义状态(定义.状态),
                    std::nullopt, {}, {}};
            if (宿主.事实->事实截止代次 != 请求.期望事实代次
                || 定义.事实->事实截止代次 != 请求.期望事实代次)
                return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            if (请求.初始值 < 定义.事实->下界 || 请求.初始值 > 定义.事实->上界)
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            std::uint64_t 代次 = 请求.期望事实代次;
            节点事实 来源节点;
            实例特征状态 失败 = 实例特征状态::内部不一致;
            if (!L1实例特征内部::读取节点(L1_, 请求.来源节点, 代次, 来源节点, 失败))
                return {失败, std::nullopt, {}, {}};
            if (来源节点.种类 != 节点种类::普通 || 来源节点.退出事实代次)
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            const auto 快照 = L1_.读取完整快照({});
            if (快照.状态 != L1读取状态::成功 || !快照.快照.has_value())
                return {快照.状态 == L1读取状态::资源失败
                    ? 实例特征状态::资源失败 : 实例特征状态::内部不一致,
                    std::nullopt, {}, {}};
            if (快照.快照->事实代次 != 请求.期望事实代次)
                return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            bool 已存在 = false;
            const auto 唯一状态 = 检查宿主定义唯一性(*快照.快照,
                宿主.事实->存在.编码, 定义.事实->特征定义, 已存在);
            if (唯一状态 != 实例特征状态::已读取)
                return {唯一状态, std::nullopt, {}, {}};
            if (已存在) return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
            const auto 写集 = L1实例特征内部::形成实例写集({
                请求.期望事实代次, 请求.幂等身份, 宿主.事实->存在.编码,
                定义.事实->特征定义, 请求.初始值, 请求.来源节点,
                登记_->宿主槽关系类型, 登记_->定义模板关系类型,
                登记_->当前I64值属性类型});
            实际存在实例记录 新记录;
            新记录.请求 = 请求;
            新记录.写集 = 写集;
            const auto [位置, 已插入] = 实际存在实例账_.try_emplace(键, std::move(新记录));
            if (!已插入) return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            const auto 写入 = L1实例特征内部::提交实例写集(L1_, 位置->second.写集);
            if (写入.状态 != 实例特征状态::已提交
                && 写入.状态 != 实例特征状态::幂等读回) {
                实际存在实例账_.erase(位置);
                return {写入.状态, std::nullopt, {}, {}};
            }
            if (!有效(写入.实例槽) || !有效(写入.宿主关系)
                || !有效(写入.定义关系) || !有效(写入.当前值)) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }
            auto& 读取请求 = 位置->second.读取请求;
            读取请求.宿主 = 请求.宿主;
            读取请求.定义 = 请求.定义;
            读取请求.实例槽 = 写入.实例槽;
            读取请求.宿主关系 = 写入.宿主关系;
            读取请求.定义关系 = 写入.定义关系;
            读取请求.当前值 = 写入.当前值;
            读取请求.来源节点 = 请求.来源节点;
            位置->second.写入代次 = 写入.事实代次;
            auto 读回 = 读取实际存在I64实例特征内部(读取请求);
            if (读回.状态 != 实例特征状态::已读取 || !读回.事实.has_value()
                || 读回.事实->事实截止代次 != 写入.事实代次)
                return {读回.状态 == 实例特征状态::已读取
                    ? 实例特征状态::内部不一致 : 读回.状态,
                    std::nullopt, {}, {}};
            读回.状态 = 写入.状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }

    I64实例特征结果 换代I64实例特征当前值(
        const I64实例特征当前值换代请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!I64实例特征当前值换代请求有效(请求)
                || !登记_.has_value()) {
                return {登记_.has_value() ? 实例特征状态::入口拒绝
                    : 实例特征状态::登记未加载, std::nullopt, {}, {}};
            }

            const bool 同一幂等键 = 换代请求_.has_value()
                && 换代请求_->幂等身份 == 请求.幂等身份;
            const bool 精确重复 = 同一幂等键
                && L1实例特征内部::换代请求相同(*换代请求_, 请求);
            if (同一幂等键 && !精确重复) {
                return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
            }

            L1写集请求 写集;
            I64实例特征事实 旧事实;
            if (精确重复) {
                if (!换代写集_.has_value() || !换代旧事实_.has_value()
                    || !换代后读取请求_.has_value()) {
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
                }
                写集 = *换代写集_;
                旧事实 = *换代旧事实_;
            } else {
                const auto 当前 = 读取I64实例特征内部(请求.当前事实);
                if (当前.状态 != 实例特征状态::已读取 || !当前.事实.has_value()) {
                    return {当前.状态, std::nullopt, {}, {}};
                }
                if (当前.事实->事实截止代次 != 请求.期望事实代次) {
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
                }
                const auto 定义 = 特征定义_.读取I64特征定义(请求.当前事实.定义);
                if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value()) {
                    return {L1实例特征内部::映射定义状态(定义.状态), std::nullopt, {}, {}};
                }
                if (定义.事实->事实截止代次 != 请求.期望事实代次) {
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
                }
                if (请求.新值 < 定义.事实->下界
                    || 请求.新值 > 定义.事实->上界) {
                    return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
                }
                std::uint64_t 代次 = 请求.期望事实代次;
                节点事实 来源节点;
                实例特征状态 失败 = 实例特征状态::内部不一致;
                if (!L1实例特征内部::读取节点(L1_, 请求.新来源节点,
                    代次, 来源节点, 失败)) {
                    return {失败, std::nullopt, {}, {}};
                }
                if (来源节点.种类 != 节点种类::普通) {
                    return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
                }
                const auto 快照 = L1_.读取完整快照({});
                if (快照.状态 != L1读取状态::成功 || !快照.快照.has_value()) {
                    return {快照.状态 == L1读取状态::资源失败
                        ? 实例特征状态::资源失败 : 实例特征状态::内部不一致,
                        std::nullopt, {}, {}};
                }
                if (快照.快照->事实代次 != 请求.期望事实代次) {
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
                }

                旧事实 = *当前.事实;
                写集.期望事实代次 = 请求.期望事实代次;
                写集.幂等键 = L1实例特征内部::映射幂等键(
                    L1实例特征内部::换代幂等域, 请求.幂等身份);
                写集.值 = {{{1}, 事实引用{请求.当前事实.实例槽},
                    事实引用{登记_->当前I64值属性类型}, 请求.新值,
                    事实引用{请求.新来源节点}}};
                写集.属性槽变更 = {{事实引用{请求.当前事实.实例槽},
                    事实引用{登记_->当前I64值属性类型}, 写集本地键{1}}};
                写集.退出事实 = {请求.当前事实.当前值};
            }

            if (写集.节点.size() != 0 || 写集.关系.size() != 0
                || 写集.值.size() != 1 || 写集.属性槽变更.size() != 1
                || 写集.退出事实.size() != 1) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }
            const auto 写入 = L1_.提交写集(写集);
            const auto 状态 = L1实例特征内部::映射写入状态(写入.状态);
            if (状态 != 实例特征状态::已提交
                && 状态 != 实例特征状态::幂等读回) {
                return {状态, std::nullopt, {}, {}};
            }
            if (写入.事实代次 == 0 || !L1实例特征内部::映射唯一(写入)) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }
            const auto 新值 = L1实例特征内部::查找映射(写入, 1);
            if (!新值) return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            I64实例特征读取请求 新读取 = 精确重复
                ? *换代后读取请求_ : 请求.当前事实;
            新读取.当前值 = *新值;
            新读取.来源节点 = 请求.新来源节点;
            const auto 新当前 = 读取I64实例特征内部(新读取);
            if (新当前.状态 != 实例特征状态::已读取
                || !新当前.事实.has_value()
                || 新当前.事实->事实截止代次 != 写入.事实代次
                || 新当前.事实->I64值 != 请求.新值
                || 新当前.事实->来源节点 != 请求.新来源节点
                || 新当前.事实->实例槽 != 旧事实.实例槽
                || 新当前.事实->宿主 != 旧事实.宿主
                || 新当前.事实->特征定义 != 旧事实.特征定义
                || 新当前.宿主关系 != 请求.当前事实.宿主关系
                || 新当前.定义关系 != 请求.当前事实.定义关系) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }

            const auto 旧当前 = L1_.读取当前值({L1事实基座合同版本,
                请求.当前事实.当前值});
            if (旧当前.状态 != L1读取状态::已退出 || 旧当前.事实.has_value()) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }
            const auto 旧历史 = L1_.读取历史事实({L1事实基座合同版本,
                请求.当前事实.当前值});
            const auto* 旧值事实 = 旧历史.历史.has_value()
                ? std::get_if<值事实>(&旧历史.历史->事实) : nullptr;
            if (旧历史.状态 != L1读取状态::成功 || !旧历史.历史.has_value()
                || 旧历史.历史->当前有效 || !旧值事实
                || 旧值事实->编码 != 请求.当前事实.当前值
                || 旧值事实->所属节点 != 旧事实.实例槽
                || 旧值事实->属性类型节点 != 登记_->当前I64值属性类型
                || 旧值事实->来源节点 != 旧事实.来源节点
                || 旧值事实->退出事实代次 != 写入.事实代次
                || !std::holds_alternative<std::int64_t>(旧值事实->材料)
                || std::get<std::int64_t>(旧值事实->材料) != 旧事实.I64值) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }
            const auto 属性 = L1_.读取当前属性({L1事实基座合同版本,
                请求.当前事实.实例槽, 登记_->当前I64值属性类型});
            if (属性.状态 != L1读取状态::成功 || !属性.属性.has_value()
                || 属性.读取事实代次 != 写入.事实代次
                || 属性.属性->当前值 != *新值) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }

            if (!精确重复) {
                换代请求_ = 请求;
                换代写集_ = 写集;
                换代后读取请求_ = 新读取;
                换代旧事实_ = 旧事实;
            }
            return {状态, 新当前.事实, 新当前.宿主关系, 新当前.定义关系};
        } catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }

    I64实例特征结果 读取I64实例特征(const I64实例特征读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try { return 读取I64实例特征内部(请求); }
        catch (const std::bad_alloc&) { return {实例特征状态::资源失败, std::nullopt, {}, {}}; }
        catch (...) { return {实例特征状态::内部不一致, std::nullopt, {}, {}}; }
    }

    I64实例特征结果 读取实际存在I64实例特征(
        const 实际存在I64实例特征读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try { return 读取实际存在I64实例特征内部(请求); }
        catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }

private:
    实例特征状态 检查宿主定义唯一性(const L1完整快照& 快照,
        稳定编码 宿主, 稳定编码 定义, bool& 已存在) const noexcept {
        已存在 = false;
        std::size_t 组合数量 = 0;
        for (const auto& 宿主项 : 快照.当前关系) {
            if (宿主项.关系类型节点 != 登记_->宿主槽关系类型
                || 宿主项.角色或顺序 != 1 || 宿主项.源节点 != 宿主) continue;
            const auto 槽 = 宿主项.目标节点;
            std::size_t 槽宿主数量 = 0, 槽定义数量 = 0, 匹配定义数量 = 0;
            std::size_t 当前值数量 = 0, 当前属性数量 = 0;
            const 节点事实* 槽节点 = nullptr;
            for (const auto& 节点 : 快照.当前节点) {
                if (节点.编码 == 槽) 槽节点 = &节点;
            }
            for (const auto& 关系 : 快照.当前关系) {
                if (关系.关系类型节点 == 登记_->宿主槽关系类型
                    && 关系.角色或顺序 == 1 && 关系.目标节点 == 槽) ++槽宿主数量;
                if (关系.关系类型节点 == 登记_->定义模板关系类型
                    && 关系.角色或顺序 == 2 && 关系.源节点 == 槽) {
                    ++槽定义数量;
                    if (关系.目标节点 == 定义) ++匹配定义数量;
                }
            }
            for (const auto& 值 : 快照.当前值) {
                if (值.所属节点 == 槽
                    && 值.属性类型节点 == 登记_->当前I64值属性类型) ++当前值数量;
            }
            if (槽节点) for (const auto& 属性 : 槽节点->当前属性) {
                if (属性.属性类型节点 == 登记_->当前I64值属性类型) ++当前属性数量;
            }
            if (!槽节点 || 槽节点->种类 != 节点种类::普通
                || 槽宿主数量 != 1 || 槽定义数量 != 1
                || 当前值数量 != 1 || 当前属性数量 != 1)
                return 实例特征状态::内部不一致;
            if (匹配定义数量 == 1) ++组合数量;
        }
        if (组合数量 > 1) return 实例特征状态::内部不一致;
        已存在 = 组合数量 == 1;
        return 实例特征状态::已读取;
    }

    I64实例特征结果 读取I64实例特征事实核心(
        稳定编码 宿主, 稳定编码 定义, std::uint64_t 截止代次,
        稳定编码 实例槽, 稳定编码 宿主关系编码, 稳定编码 定义关系编码,
        稳定编码 当前值编码, 稳定编码 来源节点编码) const {
        std::uint64_t 代次 = 截止代次;
        节点事实 槽;
        关系事实 宿主关系, 定义关系;
        值事实 当前值;
        实例特征状态 失败 = 实例特征状态::内部不一致;
        if (!L1实例特征内部::读取节点(L1_, 实例槽, 代次, 槽, 失败)
            || !L1实例特征内部::读取关系(L1_, 宿主关系编码, 代次, 宿主关系, 失败)
            || !L1实例特征内部::读取关系(L1_, 定义关系编码, 代次, 定义关系, 失败)
            || !L1实例特征内部::读取值(L1_, 当前值编码, 代次, 当前值, 失败))
            return {失败, std::nullopt, {}, {}};
        const auto 属性 = L1_.读取当前属性({L1事实基座合同版本,
            实例槽, 登记_->当前I64值属性类型});
        if (属性.状态 != L1读取状态::成功 || !属性.属性.has_value())
            return {属性.状态 == L1读取状态::未找到
                || 属性.状态 == L1读取状态::属性未设置
                    ? 实例特征状态::未找到 : 实例特征状态::内部不一致,
                std::nullopt, {}, {}};
        if (属性.读取事实代次 != 代次)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        if (属性.属性->当前值 != 当前值编码 || 槽.种类 != 节点种类::普通
            || 宿主关系.源节点 != 宿主 || 宿主关系.目标节点 != 实例槽
            || 宿主关系.关系类型节点 != 登记_->宿主槽关系类型
            || 宿主关系.角色或顺序 != 1
            || 定义关系.源节点 != 实例槽 || 定义关系.目标节点 != 定义
            || 定义关系.关系类型节点 != 登记_->定义模板关系类型
            || 定义关系.角色或顺序 != 2
            || 当前值.所属节点 != 实例槽
            || 当前值.属性类型节点 != 登记_->当前I64值属性类型
            || 当前值.来源节点 != 来源节点编码 || 当前值.退出事实代次
            || !std::holds_alternative<std::int64_t>(当前值.材料))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        const auto 快照 = L1_.读取完整快照({});
        if (快照.状态 != L1读取状态::成功 || !快照.快照.has_value())
            return {快照.状态 == L1读取状态::资源失败
                ? 实例特征状态::资源失败 : 实例特征状态::内部不一致,
                std::nullopt, {}, {}};
        if (快照.快照->事实代次 != 代次)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        bool 已存在 = false;
        const auto 唯一状态 = 检查宿主定义唯一性(*快照.快照, 宿主, 定义, 已存在);
        if (唯一状态 != 实例特征状态::已读取 || !已存在)
            return {唯一状态 == 实例特征状态::已读取
                ? 实例特征状态::内部不一致 : 唯一状态, std::nullopt, {}, {}};
        I64实例特征事实 事实;
        事实.事实截止代次 = 代次;
        事实.宿主 = 宿主;
        事实.特征定义 = 定义;
        事实.实例槽 = 实例槽;
        事实.当前值 = 当前值编码;
        事实.I64值 = std::get<std::int64_t>(当前值.材料);
        事实.来源节点 = 来源节点编码;
        if (!I64实例特征事实完整(事实))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        return {实例特征状态::已读取, 事实, 宿主关系编码, 定义关系编码};
    }

    I64实例特征结果 读取实际存在I64实例特征内部(
        const 实际存在I64实例特征读取请求& 请求) const {
        if (!实际存在I64实例特征读取请求有效(请求) || !实际存在_)
            return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
        if (!登记_.has_value())
            return {实例特征状态::登记未加载, std::nullopt, {}, {}};
        const auto 宿主 = 实际存在_->读取实际存在(请求.宿主);
        if (宿主.状态 != 实际存在状态::已读取 || !宿主.事实.has_value())
            return {L1实例特征内部::映射实际存在状态(宿主.状态),
                std::nullopt, {}, {}};
        if (!实际存在事实完整(*宿主.事实))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
        if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value())
            return {L1实例特征内部::映射定义状态(定义.状态),
                std::nullopt, {}, {}};
        if (宿主.事实->事实截止代次 != 定义.事实->事实截止代次)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        return 读取I64实例特征事实核心(宿主.事实->存在.编码,
            定义.事实->特征定义, 宿主.事实->事实截止代次,
            请求.实例槽, 请求.宿主关系, 请求.定义关系,
            请求.当前值, 请求.来源节点);
    }

    I64实例特征结果 读取I64实例特征内部(const I64实例特征读取请求& 请求) const {
        if (请求.合同版本 != L1实例特征合同版本 || 请求.规则版本 != L1实例特征规则版本
            || !有效(请求.实例槽) || !有效(请求.宿主关系) || !有效(请求.定义关系)
            || !有效(请求.当前值) || !有效(请求.来源节点) || !登记_.has_value())
            return {登记_.has_value() ? 实例特征状态::入口拒绝 : 实例特征状态::登记未加载, std::nullopt, {}, {}};
        const auto 场景 = 场景结构_.读取初始场景(请求.宿主);
        if (场景.状态 != 世界结构状态::已读取 || !场景.事实.has_value()) return {L1实例特征内部::映射场景状态(场景.状态), std::nullopt, {}, {}};
        const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
        if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value()) return {L1实例特征内部::映射定义状态(定义.状态), std::nullopt, {}, {}};
        if (定义.事实->事实截止代次 != 场景.事实->事实截止代次)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        return 读取I64实例特征事实核心(场景.事实->初始场景.编码,
            定义.事实->特征定义, 场景.事实->事实截止代次,
            请求.实例槽, 请求.宿主关系, 请求.定义关系,
            请求.当前值, 请求.来源节点);
    }

    L1事实基座服务& L1_;
    L1场景结构服务& 场景结构_;
    L1特征定义服务& 特征定义_;
    L1实际存在场景组合服务* const 实际存在_ = nullptr;
    mutable std::mutex 锁_;
    std::optional<实例特征登记请求> 首次登记请求_;
    std::optional<实例特征结构登记> 登记_;
    std::optional<初始场景I64实例特征建立请求> 首次实例请求_;
    I64实例特征读取请求 实例读取请求_;
    std::optional<I64实例特征当前值换代请求> 换代请求_;
    std::optional<L1写集请求> 换代写集_;
    std::optional<I64实例特征读取请求> 换代后读取请求_;
    std::optional<I64实例特征事实> 换代旧事实_;
    struct 实际存在实例记录 final {
        实际存在I64实例特征建立请求 请求;
        L1写集请求 写集;
        实际存在I64实例特征读取请求 读取请求;
        std::uint64_t 写入代次 = 0;
    };
    std::map<std::uint64_t, 实际存在实例记录> 实际存在实例账_;
};

} // namespace 海中鱼巣
