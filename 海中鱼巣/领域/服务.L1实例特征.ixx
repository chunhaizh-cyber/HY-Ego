namespace L1实例特征内部 {

inline constexpr std::uint64_t 登记幂等域 = 0x05ULL;
inline constexpr std::uint64_t 实例幂等域 = 0x06ULL;
inline constexpr std::uint64_t 换代幂等域 = 0x07ULL;

写集幂等键 映射幂等键(std::uint64_t 域, 特征操作幂等身份 身份) noexcept {
    return {(域 << 56) | 身份.值};
}

void 写节点见证(std::vector<std::uint8_t>& 出, const 世界结构节点身份见证& 见证) {
    L1确定性编码内部::写稳定编码(出, 见证.编码);
    L1确定性编码内部::写U8(出, static_cast<std::uint8_t>(见证.类型));
}

void 写初始场景读取请求(std::vector<std::uint8_t>& 出, const 初始场景读取请求& 请求) {
    L1确定性编码内部::写U32(出, 请求.合同版本);
    L1确定性编码内部::写U32(出, 请求.世界规则版本);
    写节点见证(出, 请求.世界根);
    L1确定性编码内部::写稳定编码(出, 请求.初始场景);
    L1确定性编码内部::写稳定编码(出, 请求.场景标记值);
    L1确定性编码内部::写稳定编码(出, 请求.直接父关系);
}

void 写I64定义读取请求(std::vector<std::uint8_t>& 出, const I64特征定义读取请求& 请求) {
    L1确定性编码内部::写U32(出, 请求.合同版本);
    L1确定性编码内部::写U32(出, 请求.规则版本);
    L1确定性编码内部::写稳定编码(出, 请求.特征定义);
    L1确定性编码内部::写稳定编码(出, 请求.定义标记值);
    L1确定性编码内部::写稳定编码(出, 请求.下界值);
    L1确定性编码内部::写稳定编码(出, 请求.上界值);
}

void 写实际存在读取请求(std::vector<std::uint8_t>& 出, const 实际存在读取请求& 请求) {
    L1确定性编码内部::写U32(出, 请求.合同版本);
    L1确定性编码内部::写U32(出, 请求.规则版本);
    写初始场景读取请求(出, 请求.当前场景);
    L1确定性编码内部::写稳定编码(出, 请求.存在);
    L1确定性编码内部::写稳定编码(出, 请求.资格值);
    L1确定性编码内部::写稳定编码(出, 请求.当前场景归属关系);
}

void 写I64实例读取请求(std::vector<std::uint8_t>& 出, const I64实例特征读取请求& 请求) {
    L1确定性编码内部::写U32(出, 请求.合同版本);
    L1确定性编码内部::写U32(出, 请求.规则版本);
    写初始场景读取请求(出, 请求.宿主);
    写I64定义读取请求(出, 请求.定义);
    L1确定性编码内部::写稳定编码(出, 请求.实例槽);
    L1确定性编码内部::写稳定编码(出, 请求.宿主关系);
    L1确定性编码内部::写稳定编码(出, 请求.定义关系);
    L1确定性编码内部::写稳定编码(出, 请求.当前值);
    L1确定性编码内部::写稳定编码(出, 请求.来源节点);
}

void 写实际存在I64实例读取请求(std::vector<std::uint8_t>& 出,
    const 实际存在I64实例特征读取请求& 请求) {
    L1确定性编码内部::写U32(出, 请求.合同版本);
    L1确定性编码内部::写U32(出, 请求.规则版本);
    写实际存在读取请求(出, 请求.宿主);
    写I64定义读取请求(出, 请求.定义);
    L1确定性编码内部::写稳定编码(出, 请求.实例槽);
    L1确定性编码内部::写稳定编码(出, 请求.宿主关系);
    L1确定性编码内部::写稳定编码(出, 请求.定义关系);
    L1确定性编码内部::写稳定编码(出, 请求.当前值);
    L1确定性编码内部::写稳定编码(出, 请求.来源节点);
}

template<class 写DTO>
L1领域意图凭证 形成G4凭证(std::uint32_t 标签, std::uint8_t 变体, 写DTO&& 写DTO字段) {
    std::vector<std::uint8_t> 编码{'H','Z','Y','-','L','1','G','4'};
    L1确定性编码内部::写U32(编码, L1请求意图格式版本);
    L1确定性编码内部::写U32(编码, 标签);
    L1确定性编码内部::写U8(编码, 变体);
    写DTO字段(编码);
    return {4, L1请求意图格式版本, 标签,
        L1确定性编码内部::哈希(std::move(编码))};
}

L1领域意图凭证 形成G4登记意图凭证(const 实例特征登记请求& 请求) {
    return 形成G4凭证(0x15000402U, 1, [&](auto& 编码) {
        L1确定性编码内部::写U32(编码, 请求.合同版本);
        L1确定性编码内部::写U32(编码, 请求.规则版本);
        L1确定性编码内部::写U64(编码, 请求.幂等身份.值);
        L1确定性编码内部::写U64(编码, 请求.期望事实代次);
    });
}

L1领域意图凭证 形成G4初始实例意图凭证(const 初始场景I64实例特征建立请求& 请求) {
    return 形成G4凭证(0x15000401U, 1, [&](auto& 编码) {
        L1确定性编码内部::写U32(编码, 请求.合同版本);
        L1确定性编码内部::写U32(编码, 请求.规则版本);
        L1确定性编码内部::写U64(编码, 请求.幂等身份.值);
        L1确定性编码内部::写U64(编码, 请求.期望事实代次);
        写初始场景读取请求(编码, 请求.宿主);
        写I64定义读取请求(编码, 请求.定义);
        L1确定性编码内部::写I64(编码, 请求.初始值);
        L1确定性编码内部::写稳定编码(编码, 请求.来源节点);
    });
}

L1领域意图凭证 形成G4实际存在实例意图凭证(const 实际存在I64实例特征建立请求& 请求) {
    return 形成G4凭证(0x15000401U, 2, [&](auto& 编码) {
        L1确定性编码内部::写U32(编码, 请求.合同版本);
        L1确定性编码内部::写U32(编码, 请求.规则版本);
        L1确定性编码内部::写U64(编码, 请求.幂等身份.值);
        L1确定性编码内部::写U64(编码, 请求.期望事实代次);
        写实际存在读取请求(编码, 请求.宿主);
        写I64定义读取请求(编码, 请求.定义);
        L1确定性编码内部::写I64(编码, 请求.初始值);
        L1确定性编码内部::写稳定编码(编码, 请求.来源节点);
    });
}

L1领域意图凭证 形成G4初始换代意图凭证(const I64实例特征当前值换代请求& 请求) {
    return 形成G4凭证(0x15000403U, 1, [&](auto& 编码) {
        L1确定性编码内部::写U32(编码, 请求.合同版本);
        L1确定性编码内部::写U32(编码, 请求.规则版本);
        L1确定性编码内部::写U64(编码, 请求.幂等身份.值);
        L1确定性编码内部::写U64(编码, 请求.期望事实代次);
        写I64实例读取请求(编码, 请求.当前事实);
        L1确定性编码内部::写I64(编码, 请求.新值);
        L1确定性编码内部::写稳定编码(编码, 请求.新来源节点);
    });
}

L1领域意图凭证 形成G4实际存在换代意图凭证(
    const 实际存在I64实例特征当前值换代请求& 请求) {
    return 形成G4凭证(0x15000403U, 2, [&](auto& 编码) {
        L1确定性编码内部::写U32(编码, 请求.合同版本);
        L1确定性编码内部::写U32(编码, 请求.规则版本);
        L1确定性编码内部::写U64(编码, 请求.幂等身份.值);
        L1确定性编码内部::写U64(编码, 请求.期望事实代次);
        写实际存在I64实例读取请求(编码, 请求.当前事实);
        L1确定性编码内部::写I64(编码, 请求.新值);
        L1确定性编码内部::写稳定编码(编码, 请求.新来源节点);
    });
}

void 设置执行证据提供者(L1写集请求& 写集,
    std::vector<L1提供者版本见证> 提供者组) {
    std::sort(提供者组.begin(), 提供者组.end(), [](const auto& 左, const auto& 右) {
        return 左.提供者身份 < 右.提供者身份;
    });
    std::vector<L1提供者版本见证> 唯一组;
    for (const auto& 当前 : 提供者组) {
        if (!唯一组.empty() && 唯一组.back().提供者身份 == 当前.提供者身份) {
            if (唯一组.back().合同版本 != 当前.合同版本
                || 唯一组.back().规则版本 != 当前.规则版本
                || 唯一组.back().调用次数 > std::numeric_limits<std::uint32_t>::max()
                    - 当前.调用次数) {
                唯一组.clear();
                break;
            }
            唯一组.back().调用次数 += 当前.调用次数;
        } else {
            唯一组.push_back(当前);
        }
    }
    L1执行证据材料 材料;
    材料.提供者版本组 = std::move(唯一组);
    写集.执行证据材料 = std::move(材料);
}

std::optional<稳定编码> 查找映射(const L1写入结果& 结果,
    std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& 项 : 结果.新编码映射) {
        if (项.first.值 != 本地键) continue;
        if (找到.has_value()) return std::nullopt;
        找到 = 项.second;
    }
    return 找到;
}

bool 映射唯一(const L1写入结果& 结果) noexcept {
    for (std::size_t i = 0; i < 结果.新编码映射.size(); ++i) {
        if (!有效(结果.新编码映射[i].first)
            || !有效(结果.新编码映射[i].second)) return false;
        for (std::size_t j = i + 1; j < 结果.新编码映射.size(); ++j) {
            if (结果.新编码映射[i].first == 结果.新编码映射[j].first
                || 结果.新编码映射[i].second == 结果.新编码映射[j].second) return false;
        }
    }
    return true;
}

bool 实例请求相同(const 初始场景I64实例特征建立请求& 左,
    const 初始场景I64实例特征建立请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份 && 左.期望事实代次 == 右.期望事实代次
        && 左.宿主 == 右.宿主
        && 左.定义.合同版本 == 右.定义.合同版本
        && 左.定义.规则版本 == 右.定义.规则版本
        && 左.定义.特征定义 == 右.定义.特征定义
        && 左.定义.定义标记值 == 右.定义.定义标记值
        && 左.定义.下界值 == 右.定义.下界值
        && 左.定义.上界值 == 右.定义.上界值
        && 左.初始值 == 右.初始值 && 左.来源节点 == 右.来源节点;
}

bool 读取请求相同(const I64实例特征读取请求& 左,
    const I64实例特征读取请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.宿主 == 右.宿主
        && 左.定义.合同版本 == 右.定义.合同版本
        && 左.定义.规则版本 == 右.定义.规则版本
        && 左.定义.特征定义 == 右.定义.特征定义
        && 左.定义.定义标记值 == 右.定义.定义标记值
        && 左.定义.下界值 == 右.定义.下界值
        && 左.定义.上界值 == 右.定义.上界值
        && 左.实例槽 == 右.实例槽
        && 左.宿主关系 == 右.宿主关系
        && 左.定义关系 == 右.定义关系
        && 左.当前值 == 右.当前值
        && 左.来源节点 == 右.来源节点;
}

bool 换代请求相同(const I64实例特征当前值换代请求& 左,
    const I64实例特征当前值换代请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份
        && 左.期望事实代次 == 右.期望事实代次
        && 左.新值 == 右.新值 && 左.新来源节点 == 右.新来源节点
        && 读取请求相同(左.当前事实, 右.当前事实);
}

bool 换代请求相同(const 实际存在I64实例特征当前值换代请求& 左,
    const 实际存在I64实例特征当前值换代请求& 右) noexcept {
    return 左 == 右;
}

bool 定义读取请求相同(const I64特征定义读取请求& 左,
    const I64特征定义读取请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.特征定义 == 右.特征定义 && 左.定义标记值 == 右.定义标记值
        && 左.下界值 == 右.下界值 && 左.上界值 == 右.上界值;
}

bool 实际存在实例请求相同(const 实际存在I64实例特征建立请求& 左,
    const 实际存在I64实例特征建立请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.幂等身份 == 右.幂等身份
        && 左.期望事实代次 == 右.期望事实代次
        && 左.宿主 == 右.宿主 && 定义读取请求相同(左.定义, 右.定义)
        && 左.初始值 == 右.初始值 && 左.来源节点 == 右.来源节点;
}

实例特征状态 映射写入状态(L1写入状态 状态) noexcept {
    switch (状态) {
    case L1写入状态::成功: return 实例特征状态::已提交;
    case L1写入状态::精确重复: return 实例特征状态::幂等读回;
    case L1写入状态::幂等冲突: return 实例特征状态::幂等冲突;
    case L1写入状态::未找到:
    case L1写入状态::已退出: return 实例特征状态::未找到;
    case L1写入状态::事实代次漂移: return 实例特征状态::事实代次漂移;
    case L1写入状态::资源失败: return 实例特征状态::资源失败;
    case L1写入状态::内部不一致: return 实例特征状态::内部不一致;
    default: return 实例特征状态::入口拒绝;
    }
}

实例特征状态 映射场景状态(世界结构状态 状态) noexcept {
    switch (状态) {
    case 世界结构状态::已读取: return 实例特征状态::已读取;
    case 世界结构状态::版本漂移: return 实例特征状态::事实代次漂移;
    case 世界结构状态::资源失败: return 实例特征状态::资源失败;
    case 世界结构状态::未找到: return 实例特征状态::未找到;
    case 世界结构状态::内部不一致: return 实例特征状态::内部不一致;
    default: return 实例特征状态::入口拒绝;
    }
}

实例特征状态 映射定义状态(特征定义状态 状态) noexcept {
    switch (状态) {
    case 特征定义状态::已读取: return 实例特征状态::已读取;
    case 特征定义状态::事实代次漂移: return 实例特征状态::事实代次漂移;
    case 特征定义状态::资源失败: return 实例特征状态::资源失败;
    case 特征定义状态::未找到: return 实例特征状态::未找到;
    case 特征定义状态::内部不一致: return 实例特征状态::内部不一致;
    case 特征定义状态::登记未加载: return 实例特征状态::登记未加载;
    default: return 实例特征状态::入口拒绝;
    }
}

实例特征状态 映射实际存在状态(实际存在状态 状态) noexcept {
    switch (状态) {
    case 实际存在状态::已读取: return 实例特征状态::已读取;
    case 实际存在状态::未找到: return 实例特征状态::未找到;
    case 实际存在状态::版本漂移: return 实例特征状态::事实代次漂移;
    case 实际存在状态::资源失败: return 实例特征状态::资源失败;
    case 实际存在状态::内部不一致: return 实例特征状态::内部不一致;
    default: return 实例特征状态::入口拒绝;
    }
}

// 诊断责任：无适用错误分支；纯值映射不访问外部状态。
L1中性写集幂等键 映射中性幂等键(
    std::uint64_t 域, 特征操作幂等身份 身份) noexcept {
    return {(域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；只在中性结构化映射中查找唯一键。
std::optional<稳定编码> 查找中性映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到.has_value()) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只验证中性结构化映射的键和值唯一。
bool 中性映射唯一(const L1中性写入结果& 结果) noexcept {
    for (std::size_t 左 = 0; 左 < 结果.新编码映射.size(); ++左) {
        if (!有效(结果.新编码映射[左].first)
            || !有效(结果.新编码映射[左].second)) return false;
        for (std::size_t 右 = 左 + 1; 右 < 结果.新编码映射.size(); ++右) {
            if (结果.新编码映射[左].first == 结果.新编码映射[右].first
                || 结果.新编码映射[左].second == 结果.新编码映射[右].second) {
                return false;
            }
        }
    }
    return true;
}

// 诊断责任：无适用错误分支；纯值状态映射保留中性失败类别。
实例特征状态 映射中性写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 实例特征状态::已提交;
    case L1中性写入状态::精确重复: return 实例特征状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 实例特征状态::入口拒绝;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出: return 实例特征状态::未找到;
    case L1中性写入状态::事实代次漂移: return 实例特征状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return 实例特征状态::幂等冲突;
    case L1中性写入状态::资源失败: return 实例特征状态::资源失败;
    case L1中性写入状态::内部不一致: return 实例特征状态::内部不一致;
    }
    return 实例特征状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值状态映射保留中性失败类别。
实例特征状态 映射中性读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::成功: return 实例特征状态::已读取;
    case L1中性读取状态::入口拒绝: return 实例特征状态::入口拒绝;
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置: return 实例特征状态::未找到;
    case L1中性读取状态::资源失败: return 实例特征状态::资源失败;
    case L1中性读取状态::内部不一致: return 实例特征状态::内部不一致;
    }
    return 实例特征状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对成功类中性写入合同。
bool 中性写入成功合同完整(const L1中性写入结果& 结果,
    L1中性写集幂等键 期望键, std::size_t 期望映射数量) noexcept {
    if (结果.合同版本 != L1中性CRUD合同版本
        || 结果.幂等键 != 期望键 || 结果.事实代次 == 0
        || 结果.新编码映射.size() != 期望映射数量
        || !中性映射唯一(结果)) return false;
    if (结果.状态 == L1中性写入状态::成功) {
        return 结果.是否形成内存权威发布
            && 结果.重试边界 == L1中性重试边界::不适用;
    }
    if (结果.状态 == L1中性写入状态::精确重复) {
        return !结果.是否形成内存权威发布
            && 结果.重试边界 == L1中性重试边界::原幂等键读回收敛;
    }
    return false;
}

struct 实例写入材料 final {
    std::uint64_t 期望事实代次 = 0;
    特征操作幂等身份 幂等身份;
    稳定编码 宿主;
    稳定编码 定义;
    std::int64_t 初始值 = 0;
    稳定编码 来源;
    稳定编码 宿主关系类型;
    稳定编码 定义关系类型;
    稳定编码 当前值属性类型;
};

struct I64当前值换代已验证材料 final {
    特征操作幂等身份 幂等身份;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 宿主;
    稳定编码 特征定义;
    稳定编码 实例槽;
    稳定编码 宿主关系;
    稳定编码 定义关系;
    稳定编码 旧当前值;
    std::int64_t 旧I64值 = 0;
    稳定编码 旧来源节点;
    std::int64_t 新I64值 = 0;
    稳定编码 新来源节点;
};

L1写集请求 形成实例写集(const 实例写入材料& 材料) {
    L1写集请求 写集;
    写集.期望事实代次 = 材料.期望事实代次;
    写集.幂等键 = 映射幂等键(实例幂等域, 材料.幂等身份);
    写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{2}, 事实引用{材料.宿主}, 事实引用{写集本地键{1}},
            事实引用{材料.宿主关系类型}, 1},
        {{3}, 事实引用{写集本地键{1}}, 事实引用{材料.定义},
            事实引用{材料.定义关系类型}, 2}};
    写集.值 = {{{4}, 事实引用{写集本地键{1}},
        事实引用{材料.当前值属性类型}, 材料.初始值, 事实引用{材料.来源}}};
    写集.属性槽变更 = {{事实引用{写集本地键{1}},
        事实引用{材料.当前值属性类型}, 写集本地键{4}}};
    return 写集;
}

// 诊断责任：向上送出；分配异常由公开服务调用边界结构化映射。
L1中性写集请求 形成中性实例写集(const 实例写入材料& 材料) {
    L1中性写集请求 写集;
    写集.期望事实代次 = 材料.期望事实代次;
    写集.幂等键 = 映射中性幂等键(实例幂等域, 材料.幂等身份);
    写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{2}, 稳定编码{材料.宿主}, L1中性写集本地键{1},
            稳定编码{材料.宿主关系类型}, 1},
        {{3}, L1中性写集本地键{1}, 稳定编码{材料.定义},
            稳定编码{材料.定义关系类型}, 2}};
    写集.值 = {{{4}, L1中性写集本地键{1},
        稳定编码{材料.当前值属性类型}, 材料.初始值,
        稳定编码{材料.来源}}};
    写集.属性槽变更 = {{L1中性写集本地键{1},
        稳定编码{材料.当前值属性类型}, L1中性写集本地键{4}}};
    return 写集;
}

struct 实例写入结果 final {
    实例特征状态 状态 = 实例特征状态::入口拒绝;
    std::uint64_t 事实代次 = 0;
    稳定编码 实例槽;
    稳定编码 宿主关系;
    稳定编码 定义关系;
    稳定编码 当前值;
};

实例写入结果 提交实例写集(L1事实基座服务& L1, L1写集请求 写集,
    const L1领域意图凭证& 凭证) {
    写集.领域意图凭证 = 凭证;
    const auto 写入 = L1.提交写集(std::move(写集), 0x15000401U);
    const auto 状态 = 映射写入状态(写入.状态);
    if (状态 != 实例特征状态::已提交 && 状态 != 实例特征状态::幂等读回)
        return {状态};
    if (写入.事实代次 == 0 || !映射唯一(写入))
        return {实例特征状态::内部不一致};
    if (写入.状态 == L1写入状态::精确重复 && 写入.新编码映射.empty())
        return {状态, 写入.事实代次};
    if (写入.新编码映射.size() != 4)
        return {实例特征状态::内部不一致};
    const auto 槽 = 查找映射(写入, 1);
    const auto 宿主关系 = 查找映射(写入, 2);
    const auto 定义关系 = 查找映射(写入, 3);
    const auto 当前值 = 查找映射(写入, 4);
    if (!槽 || !宿主关系 || !定义关系 || !当前值)
        return {实例特征状态::内部不一致};
    return {状态, 写入.事实代次, *槽, *宿主关系, *定义关系, *当前值};
}

bool 读取节点(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t& 代次, 节点事实& 输出, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取当前节点({L1事实基座合同版本, 编码});
    if (结果.状态 != L1读取状态::成功 || !结果.事实.has_value()) {
        失败 = (结果.状态 == L1读取状态::未找到
                || 结果.状态 == L1读取状态::已退出)
            ? 实例特征状态::未找到
            : (结果.状态 == L1读取状态::资源失败
                ? 实例特征状态::资源失败 : 实例特征状态::内部不一致);
        return false;
    }
    const auto* 节点 = std::get_if<节点事实>(&*结果.事实);
    if (!节点 || 结果.读取事实代次 == 0) {
        失败 = 实例特征状态::内部不一致;
        return false;
    }
    if (代次 == 0) 代次 = 结果.读取事实代次;
    else if (代次 != 结果.读取事实代次) {
        失败 = 实例特征状态::事实代次漂移;
        return false;
    }
    输出 = *节点;
    return true;
}

bool 读取关系(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t& 代次, 关系事实& 输出, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取当前关系({L1事实基座合同版本, 编码});
    if (结果.状态 != L1读取状态::成功 || !结果.事实.has_value()) {
        失败 = (结果.状态 == L1读取状态::未找到
                || 结果.状态 == L1读取状态::已退出)
            ? 实例特征状态::未找到
            : (结果.状态 == L1读取状态::资源失败
                ? 实例特征状态::资源失败 : 实例特征状态::内部不一致);
        return false;
    }
    const auto* 关系 = std::get_if<关系事实>(&*结果.事实);
    if (!关系 || 结果.读取事实代次 == 0) {
        失败 = 实例特征状态::内部不一致;
        return false;
    }
    if (代次 == 0) 代次 = 结果.读取事实代次;
    else if (代次 != 结果.读取事实代次) {
        失败 = 实例特征状态::事实代次漂移;
        return false;
    }
    输出 = *关系;
    return true;
}

