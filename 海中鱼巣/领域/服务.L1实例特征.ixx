export module 海中鱼巣.领域.服务.L1实例特征;

export import 海中鱼巣.领域.服务.L1场景结构;
export import 海中鱼巣.领域.服务.L1特征定义;
export import 海中鱼巣.领域.组合.L1实际存在场景;
import 海中鱼巣.核心.服务.L1事实基座;

export {
#include "L1实例特征.数据.h"
}

export namespace 海中鱼巣 {

namespace L1实例特征内部 {

inline constexpr std::uint64_t 登记幂等域 = 0x05ULL;
inline constexpr std::uint64_t 实例幂等域 = 0x06ULL;
inline constexpr std::uint64_t 换代幂等域 = 0x07ULL;

实例特征状态 映射定义状态(特征定义状态 状态) noexcept {
    switch (状态) {
    case 特征定义状态::已读取: return 实例特征状态::已读取;
    case 特征定义状态::事实代次漂移: return 实例特征状态::事实代次漂移;
    case 特征定义状态::资源失败: return 实例特征状态::资源失败;
    case 特征定义状态::未找到: return 实例特征状态::未找到;
    case 特征定义状态::内部不一致: return 实例特征状态::内部不一致;
    case 特征定义状态::登记未加载: return 实例特征状态::登记未加载;
    default: return 实例特征状态::入口拒绝;
    }
}

实例特征状态 映射实际存在状态(实际存在状态 状态) noexcept {
    switch (状态) {
    case 实际存在状态::已读取: return 实例特征状态::已读取;
    case 实际存在状态::未找到: return 实例特征状态::未找到;
    case 实际存在状态::版本漂移: return 实例特征状态::事实代次漂移;
    case 实际存在状态::资源失败: return 实例特征状态::资源失败;
    case 实际存在状态::内部不一致: return 实例特征状态::内部不一致;
    default: return 实例特征状态::入口拒绝;
    }
}

// 诊断责任：无适用错误分支；纯值映射不访问外部状态。
L1中性写集幂等键 映射中性幂等键(
    std::uint64_t 域, 特征操作幂等身份 身份) noexcept {
    return {(域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；只在中性结构化映射中查找唯一键。
std::optional<稳定编码> 查找中性映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到.has_value()) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只验证中性结构化映射的键和值唯一。
bool 中性映射唯一(const L1中性写入结果& 结果) noexcept {
    for (std::size_t 左 = 0; 左 < 结果.新编码映射.size(); ++左) {
        if (!有效(结果.新编码映射[左].first)
            || !有效(结果.新编码映射[左].second)) return false;
        for (std::size_t 右 = 左 + 1; 右 < 结果.新编码映射.size(); ++右) {
            if (结果.新编码映射[左].first == 结果.新编码映射[右].first
                || 结果.新编码映射[左].second == 结果.新编码映射[右].second) {
                return false;
            }
        }
    }
    return true;
}

// 诊断责任：无适用错误分支；纯值状态映射保留中性失败类别。
实例特征状态 映射中性写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 实例特征状态::已提交;
    case L1中性写入状态::精确重复: return 实例特征状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 实例特征状态::入口拒绝;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出: return 实例特征状态::未找到;
    case L1中性写入状态::事实代次漂移: return 实例特征状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return 实例特征状态::幂等冲突;
    case L1中性写入状态::资源失败: return 实例特征状态::资源失败;
    case L1中性写入状态::内部不一致: return 实例特征状态::内部不一致;
    }
    return 实例特征状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值状态映射保留中性失败类别。
实例特征状态 映射中性读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::成功: return 实例特征状态::已读取;
    case L1中性读取状态::入口拒绝: return 实例特征状态::入口拒绝;
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置: return 实例特征状态::未找到;
    case L1中性读取状态::资源失败: return 实例特征状态::资源失败;
    case L1中性读取状态::内部不一致: return 实例特征状态::内部不一致;
    }
    return 实例特征状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对成功类中性写入合同。
bool 中性写入成功合同完整(const L1中性写入结果& 结果,
    L1中性写集幂等键 期望键, std::size_t 期望映射数量) noexcept {
    if (结果.合同版本 != L1中性CRUD合同版本
        || 结果.幂等键 != 期望键 || 结果.事实代次 == 0
        || 结果.新编码映射.size() != 期望映射数量
        || !中性映射唯一(结果)) return false;
    if (结果.状态 == L1中性写入状态::成功) {
        return 结果.是否形成内存权威发布
            && 结果.重试边界 == L1中性重试边界::不适用;
    }
    if (结果.状态 == L1中性写入状态::精确重复) {
        return !结果.是否形成内存权威发布
            && 结果.重试边界 == L1中性重试边界::原幂等键读回收敛;
    }
    return false;
}

struct 实例写入材料 final {
    std::uint64_t 期望事实代次 = 0;
    特征操作幂等身份 幂等身份;
    稳定编码 宿主;
    稳定编码 定义;
    std::int64_t 初始值 = 0;
    稳定编码 来源;
    稳定编码 宿主关系类型;
    稳定编码 定义关系类型;
    稳定编码 当前值属性类型;
};

// 诊断责任：向上送出；分配异常由公开服务调用边界结构化映射。
L1中性写集请求 形成中性实例写集(const 实例写入材料& 材料) {
    L1中性写集请求 写集;
    写集.期望事实代次 = 材料.期望事实代次;
    写集.幂等键 = 映射中性幂等键(实例幂等域, 材料.幂等身份);
    写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{2}, 稳定编码{材料.宿主}, L1中性写集本地键{1},
            稳定编码{材料.宿主关系类型}, 1},
        {{3}, L1中性写集本地键{1}, 稳定编码{材料.定义},
            稳定编码{材料.定义关系类型}, 2}};
    写集.值 = {{{4}, L1中性写集本地键{1},
        稳定编码{材料.当前值属性类型}, 材料.初始值,
        稳定编码{材料.来源}}};
    写集.属性槽变更 = {{L1中性写集本地键{1},
        稳定编码{材料.当前值属性类型}, L1中性写集本地键{4}}};
    return 写集;
}

// 诊断责任：向上送出；分配异常由公开服务调用边界结构化映射。
L1中性写集请求 形成中性实际存在I64当前值换代写集(
    const 实际存在I64实例特征当前值换代请求& 请求,
    const 实例特征结构登记& 登记) {
    L1中性写集请求 写集;
    写集.期望事实代次 = 请求.期望事实代次;
    写集.幂等键 = 映射中性幂等键(换代幂等域, 请求.幂等身份);
    写集.值 = {{{1}, 稳定编码{请求.当前事实.实例槽},
        稳定编码{登记.当前I64值属性类型}, 请求.新值,
        稳定编码{请求.新来源节点}}};
    写集.属性槽变更 = {{稳定编码{请求.当前事实.实例槽},
        稳定编码{登记.当前I64值属性类型}, L1中性写集本地键{1}}};
    写集.退出事实 = {请求.当前事实.当前值};
    return 写集;
}

// 诊断责任：向上送出；无有效代次不降级为成功。
std::optional<std::uint64_t> 读取中性当前代次(
    const L1事实基座服务& L1, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (结果.状态 != L1中性读取状态::成功 || 结果.事实代次 == 0) {
        失败 = 映射中性读取状态(结果.状态);
        if (结果.状态 == L1中性读取状态::成功)
            失败 = 实例特征状态::内部不一致;
        return std::nullopt;
    }
    return 结果.事实代次;
}

// 诊断责任：向上送出；编码或代次不匹配不降级为成功。
std::optional<L1中性节点事实> 读取中性节点(
    const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前节点({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
        || 结果.事实->编码 != 编码) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.事实;
}

// 诊断责任：向上送出；编码或代次不匹配不降级为成功。
std::optional<L1中性关系事实> 读取中性关系(
    const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前关系({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
        || 结果.事实->编码 != 编码) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.事实;
}

// 诊断责任：向上送出；编码或代次不匹配不降级为成功。
std::optional<L1中性值事实> 读取中性值(
    const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前值({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
        || 结果.事实->编码 != 编码) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.事实;
}

// 诊断责任：向上送出；旧值必须明确处于已退出状态且不泄漏当前事实。
bool 中性当前值已退出(const L1事实基座服务& L1, 稳定编码 编码,
    实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前值({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::已退出 || 结果.事实) {
        失败 = 结果.状态 == L1中性读取状态::资源失败
            ? 实例特征状态::资源失败 : 实例特征状态::内部不一致;
        return false;
    }
    if (结果.合同版本 != L1中性CRUD合同版本 || 结果.查询编码 != 编码
        || 结果.读取事实代次 != 0) {
        失败 = 实例特征状态::内部不一致;
        return false;
    }
    return true;
}

// 诊断责任：向上送出；历史入口必须返回同一编码的一条完整值事实。
std::optional<L1中性值事实> 读取中性历史值(
    const L1事实基座服务& L1, 稳定编码 编码,
    实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性历史事实({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    const auto* 值 = std::get_if<L1中性值事实>(&*结果.事实);
    if (结果.合同版本 != L1中性CRUD合同版本 || 结果.查询编码 != 编码
        || 结果.读取事实代次 == 0 || !值 || 值->编码 != 编码) {
        失败 = 实例特征状态::内部不一致;
        return std::nullopt;
    }
    return *值;
}

// 诊断责任：向上送出；属性缺失和代次漂移保留为具名状态。
std::optional<稳定编码> 读取中性属性(
    const L1事实基座服务& L1, 稳定编码 节点, 稳定编码 属性类型,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前属性(
        {L1中性CRUD合同版本, 节点, 属性类型});
    if (结果.状态 != L1中性读取状态::成功 || !结果.当前值) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.节点 != 节点 || 结果.属性类型 != 属性类型
        || 结果.读取事实代次 != 期望代次) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.当前值;
}

} // namespace L1实例特征内部

class L1实例特征服务 final {
    struct 实际存在身份定位 final {
        std::array<std::uint64_t, 2> 组合{};
        实际存在I64实例特征读取请求 读取请求;
    };

    struct 实际存在组合定位 final {
        std::uint64_t 幂等身份 = 0;
        实际存在I64实例特征读取请求 读取请求;
    };

public:
    L1实例特征服务(L1事实基座服务& L1, L1场景结构服务& 场景结构,
        L1特征定义服务& 特征定义,
        L1实际存在场景组合服务& 实际存在) noexcept
        : L1_(L1), 场景结构_(场景结构), 特征定义_(特征定义),
          实际存在_(实际存在) {}
    L1实例特征服务(const L1实例特征服务&) = delete;
    L1实例特征服务& operator=(const L1实例特征服务&) = delete;

    // 诊断责任：向上送出；兼容入口只转发同对象的正式 const 写重载。
    实例特征登记结果 建立登记(const 实例特征登记请求& 请求) {
        return static_cast<const L1实例特征服务&>(*this).建立登记(请求);
    }

    // 诊断责任：向上送出；所有失败由结构化实例特征状态返回。
    实例特征登记结果 建立登记(const 实例特征登记请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!实例特征登记请求有效(请求)) return {};
            const auto 幂等键 = L1实例特征内部::映射中性幂等键(
                L1实例特征内部::登记幂等域, 请求.幂等身份);
            L1中性写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {
                {{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::普通, std::nullopt},
                {{3}, 节点种类::普通, std::nullopt},
                {{4}, 节点种类::属性类型, L1中性值表示种类::I64}};
            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1实例特征内部::映射中性写入状态(写入.状态);
            if (状态 != 实例特征状态::已提交 && 状态 != 实例特征状态::幂等读回)
                return {状态, std::nullopt};
            if (!L1实例特征内部::中性写入成功合同完整(写入, 幂等键, 4))
                return {实例特征状态::内部不一致, std::nullopt};
            const auto 服务 = L1实例特征内部::查找中性映射(写入, 1);
            const auto 宿主 = L1实例特征内部::查找中性映射(写入, 2);
            const auto 定义 = L1实例特征内部::查找中性映射(写入, 3);
            const auto 属性 = L1实例特征内部::查找中性映射(写入, 4);
            if (!服务 || !宿主 || !定义 || !属性)
                return {实例特征状态::内部不一致, std::nullopt};
            const std::array<稳定编码, 4> 新定位{*服务, *宿主, *定义, *属性};
            auto 读回 = 读取当前登记已持锁(新定位, 写入.事实代次);
            if (读回.状态 != 实例特征状态::已读取 || !读回.登记)
                return {读回.状态 == 实例特征状态::已读取
                        ? 实例特征状态::内部不一致 : 读回.状态,
                    std::nullopt};
            if (登记定位_.has_value() && *登记定位_ != 新定位)
                return {实例特征状态::内部不一致, std::nullopt};
            登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) { return {实例特征状态::资源失败, std::nullopt}; }
        catch (...) { return {实例特征状态::内部不一致, std::nullopt}; }
    }

    实例特征登记结果 读取当前登记() const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!登记定位_)
                return {实例特征状态::登记未加载, std::nullopt};
            return 读取当前登记已持锁(*登记定位_, std::nullopt);
        } catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt};
        }
    }


    // 诊断责任：向上送出；兼容入口只转发同对象的正式 const 写重载。
    I64实例特征结果 建立实际存在I64实例特征(
        const 实际存在I64实例特征建立请求& 请求) {
        return static_cast<const L1实例特征服务&>(*this)
            .建立实际存在I64实例特征(请求);
    }

    // 诊断责任：向上送出；所有失败由结构化实例特征状态返回。
    I64实例特征结果 建立实际存在I64实例特征(
        const 实际存在I64实例特征建立请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!实际存在I64实例特征建立请求有效(请求))
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            if (!登记定位_)
                return {实例特征状态::登记未加载, std::nullopt, {}, {}};

            const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
            if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
                return {登记结果.状态, std::nullopt, {}, {}};
            const auto& 登记 = *登记结果.登记;
            const auto 键 = 请求.幂等身份.值;
            const std::array<std::uint64_t, 2> 组合{
                请求.宿主.存在.值, 请求.定义.特征定义.值};
            const auto 已有身份 = 实际存在身份定位_.find(键);
            const bool 精确重复候选 = 已有身份 != 实际存在身份定位_.end();
            if (!精确重复候选 && 实际存在组合定位_.contains(组合))
                return {实例特征状态::幂等冲突, std::nullopt, {}, {}};

            L1实例特征内部::实例写入材料 材料{
                请求.期望事实代次, 请求.幂等身份, 请求.宿主.存在,
                请求.定义.特征定义, 请求.初始值, 请求.来源节点,
                登记.宿主槽关系类型, 登记.定义模板关系类型,
                登记.当前I64值属性类型};

            std::map<std::uint64_t, 实际存在身份定位> 待登记身份;
            std::map<std::array<std::uint64_t, 2>, 实际存在组合定位> 待登记组合;
            if (!精确重复候选) {
                待登记身份.try_emplace(键, 实际存在身份定位{组合, {}});
                待登记组合.try_emplace(组合, 实际存在组合定位{键, {}});
            }

            if (!精确重复候选) {
                实例特征状态 失败 = 实例特征状态::内部不一致;
                const auto 起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
                if (!起始) return {失败, std::nullopt, {}, {}};
                if (*起始 != 请求.期望事实代次
                    || 登记.事实截止代次 != *起始)
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};

                const auto 宿主 = 实际存在_.读取实际存在(请求.宿主);
                if (宿主.状态 != 实际存在状态::已读取 || !宿主.事实.has_value())
                    return {L1实例特征内部::映射实际存在状态(宿主.状态),
                        std::nullopt, {}, {}};
                if (!实际存在事实完整(*宿主.事实))
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
                const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
                if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value())
                    return {L1实例特征内部::映射定义状态(定义.状态),
                        std::nullopt, {}, {}};
                if (宿主.事实->事实截止代次 != *起始
                    || 定义.事实->事实截止代次 != *起始)
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
                if (宿主.事实->存在.编码 != 请求.宿主.存在
                    || 定义.事实->特征定义 != 请求.定义.特征定义)
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
                if (请求.初始值 < 定义.事实->下界
                    || 请求.初始值 > 定义.事实->上界)
                    return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
                const auto 来源 = L1实例特征内部::读取中性节点(
                    L1_, 请求.来源节点, *起始, 失败);
                if (!来源) return {失败, std::nullopt, {}, {}};
                if (来源->种类 != 节点种类::普通 || 来源->属性类型表示
                    || 来源->退出事实代次)
                    return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
                const auto 结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
                if (!结束) return {失败, std::nullopt, {}, {}};
                if (*结束 != *起始)
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
                材料.宿主 = 宿主.事实->存在.编码;
                材料.定义 = 定义.事实->特征定义;
            }

            const auto 写集 = L1实例特征内部::形成中性实例写集(材料);
            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1实例特征内部::映射中性写入状态(写入.状态);
            if (状态 != 实例特征状态::已提交
                && 状态 != 实例特征状态::幂等读回)
                return {状态, std::nullopt, {}, {}};
            if (!L1实例特征内部::中性写入成功合同完整(
                    写入, 写集.幂等键, 4))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            const auto 实例槽 = L1实例特征内部::查找中性映射(写入, 1);
            const auto 宿主关系 = L1实例特征内部::查找中性映射(写入, 2);
            const auto 定义关系 = L1实例特征内部::查找中性映射(写入, 3);
            const auto 当前值 = L1实例特征内部::查找中性映射(写入, 4);
            if (!实例槽 || !宿主关系 || !定义关系 || !当前值)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            实际存在I64实例特征读取请求 读取请求;
            读取请求.宿主 = 请求.宿主;
            读取请求.定义 = 请求.定义;
            读取请求.实例槽 = *实例槽;
            读取请求.宿主关系 = *宿主关系;
            读取请求.定义关系 = *定义关系;
            读取请求.当前值 = *当前值;
            读取请求.来源节点 = 请求.来源节点;
            if (!实际存在I64实例特征读取请求有效(读取请求))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            if (精确重复候选
                && (已有身份->second.组合 != 组合
                    || !(已有身份->second.读取请求 == 读取请求)))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            auto 读回 = 读取实际存在I64实例特征已持锁(
                读取请求, 写入.事实代次);
            if (读回.状态 != 实例特征状态::已读取 || !读回.事实)
                return {读回.状态 == 实例特征状态::已读取
                        ? 实例特征状态::内部不一致 : 读回.状态,
                    std::nullopt, {}, {}};
            if (!精确重复候选) {
                待登记身份.begin()->second.读取请求 = 读取请求;
                待登记组合.begin()->second.读取请求 = 读取请求;
                实际存在身份定位_.merge(待登记身份);
                实际存在组合定位_.merge(待登记组合);
                if (!待登记身份.empty() || !待登记组合.empty())
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }


    I64实例特征结果 换代实际存在I64实例特征当前值(
        const 实际存在I64实例特征当前值换代请求& 请求) {
        return static_cast<const L1实例特征服务&>(*this)
            .换代实际存在I64实例特征当前值(请求);
    }

    I64实例特征结果 换代实际存在I64实例特征当前值(
        const 实际存在I64实例特征当前值换代请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        bool 暂定定位 = false;
        bool 保留定位 = false;
        try {
            if (!实际存在I64实例特征当前值换代请求有效(请求)) {
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            }
            if (!登记定位_)
                return {实例特征状态::登记未加载, std::nullopt, {}, {}};
            const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
            if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
                return {登记结果.状态, std::nullopt, {}, {}};
            const auto& 登记 = *登记结果.登记;

            const bool 已定位 = 实际存在换代幂等定位_.contains(请求.幂等身份.值);
            if (!已定位) {
                const auto [位置, 已插入] = 实际存在换代幂等定位_.try_emplace(
                    请求.幂等身份.值, true);
                if (!已插入 || 位置 == 实际存在换代幂等定位_.end())
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
                暂定定位 = true;
            }
            const auto 失败返回 = [&](实例特征状态 状态) {
                if (暂定定位 && !保留定位)
                    实际存在换代幂等定位_.erase(请求.幂等身份.值);
                return I64实例特征结果{状态, std::nullopt, {}, {}};
            };

            std::optional<I64实例特征事实> 写前事实;
            if (!已定位) {
                实例特征状态 失败 = 实例特征状态::内部不一致;
                const auto 起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
                if (!起始) return 失败返回(失败);
                if (*起始 != 请求.期望事实代次
                    || 登记.事实截止代次 != 请求.期望事实代次)
                    return 失败返回(实例特征状态::事实代次漂移);

                const auto 当前 = 读取实际存在I64实例特征已持锁(
                    请求.当前事实, std::nullopt);
                if (当前.状态 != 实例特征状态::已读取)
                    return 失败返回(当前.状态);
                if (!当前.事实.has_value())
                    return 失败返回(实例特征状态::内部不一致);
                if (!I64实例特征事实完整(*当前.事实)
                    || 当前.事实->事实截止代次 != 请求.期望事实代次)
                    return 失败返回(当前.事实->事实截止代次 != 请求.期望事实代次
                        ? 实例特征状态::事实代次漂移
                        : 实例特征状态::内部不一致);
                if (当前.事实->宿主 != 请求.当前事实.宿主.存在
                    || 当前.事实->特征定义 != 请求.当前事实.定义.特征定义
                    || 当前.事实->实例槽 != 请求.当前事实.实例槽
                    || 当前.事实->当前值 != 请求.当前事实.当前值
                    || 当前.事实->来源节点 != 请求.当前事实.来源节点
                    || 当前.宿主关系 != 请求.当前事实.宿主关系
                    || 当前.定义关系 != 请求.当前事实.定义关系)
                    return 失败返回(实例特征状态::内部不一致);

                const auto 定义 = 特征定义_.读取I64特征定义(请求.当前事实.定义);
                if (定义.状态 != 特征定义状态::已读取)
                    return 失败返回(L1实例特征内部::映射定义状态(定义.状态));
                if (!定义.事实.has_value())
                    return 失败返回(实例特征状态::内部不一致);
                if (定义.事实->事实截止代次 != 请求.期望事实代次)
                    return 失败返回(实例特征状态::事实代次漂移);
                if (请求.新值 < 定义.事实->下界 || 请求.新值 > 定义.事实->上界)
                    return 失败返回(实例特征状态::入口拒绝);

                const auto 来源 = L1实例特征内部::读取中性节点(
                    L1_, 请求.新来源节点, 请求.期望事实代次, 失败);
                if (!来源) return 失败返回(失败);
                if (来源->种类 != 节点种类::普通 || 来源->属性类型表示
                    || 来源->退出事实代次)
                    return 失败返回(实例特征状态::入口拒绝);

                const auto 结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
                if (!结束) return 失败返回(失败);
                if (*结束 != 请求.期望事实代次)
                    return 失败返回(实例特征状态::事实代次漂移);
                写前事实 = *当前.事实;
            }

            const auto 写集 = L1实例特征内部::形成中性实际存在I64当前值换代写集(
                请求, 登记);
            if (写集.节点.size() != 0 || 写集.关系.size() != 0
                || 写集.值.size() != 1 || 写集.属性槽变更.size() != 1
                || 写集.退出事实.size() != 1)
                return 失败返回(实例特征状态::内部不一致);

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1实例特征内部::映射中性写入状态(写入.状态);
            if (状态 != 实例特征状态::已提交
                && 状态 != 实例特征状态::幂等读回) {
                return 失败返回(状态);
            }
            保留定位 = true;
            if (!L1实例特征内部::中性写入成功合同完整(
                写入, 写集.幂等键, 1)) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }

            const auto 映射新值 = L1实例特征内部::查找中性映射(写入, 1);
            if (!映射新值)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            实际存在I64实例特征读取请求 新读取 = 请求.当前事实;
            新读取.当前值 = *映射新值;
            新读取.来源节点 = 请求.新来源节点;

            实例特征状态 失败 = 实例特征状态::内部不一致;
            const auto 读回起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
            if (!读回起始) return {失败, std::nullopt, {}, {}};
            const auto 新当前 = 读取实际存在I64实例特征已持锁(新读取, std::nullopt);
            if (新当前.状态 != 实例特征状态::已读取)
                return {新当前.状态, std::nullopt, {}, {}};
            if (!新当前.事实.has_value()
                || 新当前.事实->事实截止代次 != *读回起始
                || 新当前.事实->I64值 != 请求.新值
                || 新当前.事实->来源节点 != 请求.新来源节点
                || 新当前.事实->宿主 != 请求.当前事实.宿主.存在
                || 新当前.事实->特征定义 != 请求.当前事实.定义.特征定义
                || 新当前.事实->实例槽 != 请求.当前事实.实例槽
                || 新当前.宿主关系 != 请求.当前事实.宿主关系
                || 新当前.定义关系 != 请求.当前事实.定义关系)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            const auto 新值事实 = L1实例特征内部::读取中性值(
                L1_, *映射新值, *读回起始, 失败);
            if (!新值事实) return {失败, std::nullopt, {}, {}};
            if (!L1实例特征内部::中性当前值已退出(
                L1_, 请求.当前事实.当前值, 失败))
                return {失败, std::nullopt, {}, {}};
            const auto 旧历史 = L1实例特征内部::读取中性历史值(
                L1_, 请求.当前事实.当前值, 失败);
            if (!旧历史) return {失败, std::nullopt, {}, {}};
            const auto 当前属性 = L1实例特征内部::读取中性属性(
                L1_, 请求.当前事实.实例槽, 登记.当前I64值属性类型,
                *读回起始, 失败);
            if (!当前属性) return {失败, std::nullopt, {}, {}};
            const auto 读回结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
            if (!读回结束) return {失败, std::nullopt, {}, {}};

            const auto* 新I64 = std::get_if<std::int64_t>(&新值事实->材料);
            const auto* 旧I64 = std::get_if<std::int64_t>(&旧历史->材料);
            if (*读回结束 != *读回起始 || *读回起始 < 写入.事实代次
                || 新值事实->所属节点 != 请求.当前事实.实例槽
                || 新值事实->属性类型节点 != 登记.当前I64值属性类型
                || 新值事实->来源节点 != 请求.新来源节点
                || 新值事实->创建事实代次 != 写入.事实代次
                || 新值事实->退出事实代次 || !新I64 || *新I64 != 请求.新值
                || 旧历史->所属节点 != 请求.当前事实.实例槽
                || 旧历史->属性类型节点 != 登记.当前I64值属性类型
                || 旧历史->来源节点 != 请求.当前事实.来源节点
                || 旧历史->创建事实代次 > 请求.期望事实代次
                || 旧历史->退出事实代次 != 写入.事实代次 || !旧I64
                || (写前事实 && *旧I64 != 写前事实->I64值)
                || *当前属性 != *映射新值) {
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }

            return {状态, 新当前.事实, 新当前.宿主关系, 新当前.定义关系};
        } catch (const std::bad_alloc&) {
            if (暂定定位 && !保留定位)
                实际存在换代幂等定位_.erase(请求.幂等身份.值);
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            if (暂定定位 && !保留定位)
                实际存在换代幂等定位_.erase(请求.幂等身份.值);
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }


    I64实例特征结果 读取实际存在I64实例特征(
        const 实际存在I64实例特征读取请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try { return 读取实际存在I64实例特征已持锁(请求, std::nullopt); }
        catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }

private:
    // 诊断责任：向上送出；四个登记节点必须来自同一中性权威截止。
    实例特征登记结果 读取当前登记已持锁(
        const std::array<稳定编码, 4>& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        实例特征状态 失败 = 实例特征状态::内部不一致;
        const auto 起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!起始) return {失败, std::nullopt};

        std::array<L1中性节点事实, 4> 节点组;
        for (std::size_t 索引 = 0; 索引 < 定位.size(); ++索引) {
            const auto 节点 = L1实例特征内部::读取中性节点(
                L1_, 定位[索引], *起始, 失败);
            if (!节点) return {失败, std::nullopt};
            节点组[索引] = *节点;
        }
        const auto 结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!结束) return {失败, std::nullopt};
        if (*结束 != *起始)
            return {实例特征状态::事实代次漂移, std::nullopt};

        for (std::size_t 索引 = 0; 索引 < 3; ++索引) {
            const auto& 节点 = 节点组[索引];
            if (节点.种类 != 节点种类::普通 || 节点.属性类型表示
                || 节点.退出事实代次 || !节点.当前属性.empty())
                return {实例特征状态::内部不一致, std::nullopt};
        }
        const auto& 属性类型 = 节点组[3];
        if (属性类型.种类 != 节点种类::属性类型
            || 属性类型.属性类型表示
                != std::optional{L1中性值表示种类::I64}
            || 属性类型.退出事实代次 || !属性类型.当前属性.empty())
            return {实例特征状态::内部不一致, std::nullopt};
        if (期望创建代次) {
            for (const auto& 节点 : 节点组) {
                if (节点.创建事实代次 != *期望创建代次)
                    return {实例特征状态::内部不一致, std::nullopt};
            }
        }

        实例特征结构登记 登记;
        登记.事实截止代次 = *起始;
        登记.服务身份 = 定位[0];
        登记.宿主槽关系类型 = 定位[1];
        登记.定义模板关系类型 = 定位[2];
        登记.当前I64值属性类型 = 定位[3];
        return 实例特征结构登记完整(登记)
            ? 实例特征登记结果{实例特征状态::已读取, 登记}
            : 实例特征登记结果{实例特征状态::内部不一致, std::nullopt};
    }





    // 诊断责任：向上送出；提供者和全部中性事实必须落在同一截止。
    I64实例特征结果 读取实际存在I64实例特征已持锁(
        const 实际存在I64实例特征读取请求& 请求,
        std::optional<std::uint64_t> 期望首次创建代次) const {
        if (!实际存在I64实例特征读取请求有效(请求))
            return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
        if (!登记定位_)
            return {实例特征状态::登记未加载, std::nullopt, {}, {}};

        实例特征状态 失败 = 实例特征状态::内部不一致;
        const auto 起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!起始) return {失败, std::nullopt, {}, {}};
        const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
        if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
            return {登记结果.状态, std::nullopt, {}, {}};
        const auto& 登记 = *登记结果.登记;

        const auto 宿主 = 实际存在_.读取实际存在(请求.宿主);
        if (宿主.状态 != 实际存在状态::已读取 || !宿主.事实)
            return {L1实例特征内部::映射实际存在状态(宿主.状态),
                std::nullopt, {}, {}};
        if (!实际存在事实完整(*宿主.事实))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
        if (定义.状态 != 特征定义状态::已读取 || !定义.事实)
            return {L1实例特征内部::映射定义状态(定义.状态),
                std::nullopt, {}, {}};
        if (登记.事实截止代次 != *起始
            || 宿主.事实->事实截止代次 != *起始
            || 定义.事实->事实截止代次 != *起始)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        if (宿主.事实->存在.编码 != 请求.宿主.存在
            || 定义.事实->特征定义 != 请求.定义.特征定义)
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};

        const auto 槽 = L1实例特征内部::读取中性节点(
            L1_, 请求.实例槽, *起始, 失败);
        const auto 宿主关系 = L1实例特征内部::读取中性关系(
            L1_, 请求.宿主关系, *起始, 失败);
        const auto 定义关系 = L1实例特征内部::读取中性关系(
            L1_, 请求.定义关系, *起始, 失败);
        const auto 当前属性 = L1实例特征内部::读取中性属性(
            L1_, 请求.实例槽, 登记.当前I64值属性类型, *起始, 失败);
        const auto 当前值 = L1实例特征内部::读取中性值(
            L1_, 请求.当前值, *起始, 失败);
        const auto 来源 = L1实例特征内部::读取中性节点(
            L1_, 请求.来源节点, *起始, 失败);
        if (!槽 || !宿主关系 || !定义关系 || !当前属性 || !当前值 || !来源)
            return {失败, std::nullopt, {}, {}};
        const auto 结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!结束) return {失败, std::nullopt, {}, {}};
        if (*结束 != *起始)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};

        std::size_t 当前值槽数量 = 0;
        bool 节点槽匹配 = false;
        for (const auto& 属性 : 槽->当前属性) {
            if (属性.属性类型节点 != 登记.当前I64值属性类型) continue;
            ++当前值槽数量;
            节点槽匹配 = 属性.当前值 == 请求.当前值;
        }
        if (槽->种类 != 节点种类::普通 || 槽->属性类型表示
            || 槽->退出事实代次 || 当前值槽数量 != 1 || !节点槽匹配
            || *当前属性 != 请求.当前值
            || 宿主关系->源节点 != 请求.宿主.存在
            || 宿主关系->目标节点 != 请求.实例槽
            || 宿主关系->关系类型节点 != 登记.宿主槽关系类型
            || 宿主关系->角色或顺序 != 1 || 宿主关系->退出事实代次
            || 定义关系->源节点 != 请求.实例槽
            || 定义关系->目标节点 != 请求.定义.特征定义
            || 定义关系->关系类型节点 != 登记.定义模板关系类型
            || 定义关系->角色或顺序 != 2 || 定义关系->退出事实代次
            || 当前值->所属节点 != 请求.实例槽
            || 当前值->属性类型节点 != 登记.当前I64值属性类型
            || 当前值->来源节点 != 请求.来源节点 || 当前值->退出事实代次
            || !std::holds_alternative<std::int64_t>(当前值->材料)
            || 来源->种类 != 节点种类::普通 || 来源->属性类型表示
            || 来源->退出事实代次)
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        if (槽->创建事实代次 > *起始
            || 宿主关系->创建事实代次 > *起始
            || 定义关系->创建事实代次 > *起始
            || 当前值->创建事实代次 > *起始)
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        if (期望首次创建代次
            && (槽->创建事实代次 != *期望首次创建代次
                || 宿主关系->创建事实代次 != *期望首次创建代次
                || 定义关系->创建事实代次 != *期望首次创建代次
                || 当前值->创建事实代次 != *期望首次创建代次))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};

        I64实例特征事实 事实;
        事实.事实截止代次 = *起始;
        事实.宿主 = 请求.宿主.存在;
        事实.特征定义 = 请求.定义.特征定义;
        事实.实例槽 = 请求.实例槽;
        事实.当前值 = 请求.当前值;
        事实.I64值 = std::get<std::int64_t>(当前值->材料);
        事实.来源节点 = 请求.来源节点;
        return I64实例特征事实完整(事实)
            ? I64实例特征结果{实例特征状态::已读取, 事实,
                请求.宿主关系, 请求.定义关系}
            : I64实例特征结果{实例特征状态::内部不一致,
                std::nullopt, {}, {}};
    }


    L1事实基座服务& L1_;
    L1场景结构服务& 场景结构_;
    L1特征定义服务& 特征定义_;
    L1实际存在场景组合服务& 实际存在_;
    mutable std::recursive_mutex 锁_;
    mutable std::optional<std::array<稳定编码, 4>> 登记定位_;
    mutable std::map<std::uint64_t, bool> 实际存在换代幂等定位_;
    mutable std::map<std::uint64_t, 实际存在身份定位> 实际存在身份定位_;
    mutable std::map<std::array<std::uint64_t, 2>, 实际存在组合定位>
        实际存在组合定位_;
};

} // namespace 海中鱼巣
