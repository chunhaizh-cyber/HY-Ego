            }
            if (!新当前.事实.has_value()
                || 新当前.事实->事实截止代次 != 写入.事实代次
                || 新当前.事实->I64值 != 请求.新值
                || 新当前.事实->来源节点 != 请求.新来源节点
                || 新当前.事实->宿主 != 旧事实.宿主
                || 新当前.事实->特征定义 != 旧事实.特征定义
                || 新当前.事实->实例槽 != 旧事实.实例槽
                || 新当前.宿主关系 != 请求.当前事实.宿主关系
                || 新当前.定义关系 != 请求.当前事实.定义关系) {
                if (!精确重复) 换代账_.erase(新位置);
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }

            const auto 旧当前 = L1_.读取当前值({L1事实基座合同版本,
                请求.当前事实.当前值});
            const auto 旧历史 = L1_.读取历史事实({L1事实基座合同版本,
                请求.当前事实.当前值});
            const auto* 旧值事实 = 旧历史.历史.has_value()
                ? std::get_if<值事实>(&旧历史.历史->事实) : nullptr;
            const auto 属性 = L1_.读取当前属性({L1事实基座合同版本,
                请求.当前事实.实例槽, 登记.当前I64值属性类型});
            if (旧当前.状态 != L1读取状态::已退出 || 旧当前.事实.has_value()
                || 旧历史.状态 != L1读取状态::成功 || !旧历史.历史.has_value()
                || 旧历史.历史->当前有效 || !旧值事实
                || 旧值事实->编码 != 请求.当前事实.当前值
                || 旧值事实->所属节点 != 旧事实.实例槽
                || 旧值事实->属性类型节点 != 登记.当前I64值属性类型
                || 旧值事实->来源节点 != 旧事实.来源节点
                || 旧值事实->退出事实代次 != 写入.事实代次
                || !std::holds_alternative<std::int64_t>(旧值事实->材料)
                || std::get<std::int64_t>(旧值事实->材料) != 旧事实.I64值
                || 属性.状态 != L1读取状态::成功 || !属性.属性.has_value()
                || 属性.读取事实代次 != 写入.事实代次
                || 属性.属性->当前值 != 新读取.当前值) {
                if (!精确重复) 换代账_.erase(新位置);
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }

            if (!精确重复) {
                新位置->second.读取请求 = 新读取;
                新位置->second.首次发布事实代次 = 写入.事实代次;
            }
            I64实例特征结果 结果{状态, 新当前.事实,
                新当前.宿主关系, 新当前.定义关系};
            新位置->second.首次结果 = 结果;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }

    I64实例特征结果 读取I64实例特征(const I64实例特征读取请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try { return 读取I64实例特征内部(请求); }
        catch (const std::bad_alloc&) { return {实例特征状态::资源失败, std::nullopt, {}, {}}; }
        catch (...) { return {实例特征状态::内部不一致, std::nullopt, {}, {}}; }
    }

    I64实例特征结果 读取实际存在I64实例特征(
        const 实际存在I64实例特征读取请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try { return 读取实际存在I64实例特征已持锁(请求, std::nullopt); }
        catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }

private:
    // 诊断责任：向上送出；四个登记节点必须来自同一中性权威截止。
    实例特征登记结果 读取当前登记已持锁(
        const std::array<稳定编码, 4>& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        实例特征状态 失败 = 实例特征状态::内部不一致;
        const auto 起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!起始) return {失败, std::nullopt};

        std::array<L1中性节点事实, 4> 节点组;
        for (std::size_t 索引 = 0; 索引 < 定位.size(); ++索引) {
            const auto 节点 = L1实例特征内部::读取中性节点(
                L1_, 定位[索引], *起始, 失败);
            if (!节点) return {失败, std::nullopt};
            节点组[索引] = *节点;
        }
        const auto 结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!结束) return {失败, std::nullopt};
        if (*结束 != *起始)
            return {实例特征状态::事实代次漂移, std::nullopt};

        for (std::size_t 索引 = 0; 索引 < 3; ++索引) {
            const auto& 节点 = 节点组[索引];
            if (节点.种类 != 节点种类::普通 || 节点.属性类型表示
                || 节点.退出事实代次 || !节点.当前属性.empty())
                return {实例特征状态::内部不一致, std::nullopt};
        }
        const auto& 属性类型 = 节点组[3];
        if (属性类型.种类 != 节点种类::属性类型
            || 属性类型.属性类型表示
                != std::optional{L1中性值表示种类::I64}
            || 属性类型.退出事实代次 || !属性类型.当前属性.empty())
            return {实例特征状态::内部不一致, std::nullopt};
        if (期望创建代次) {
            for (const auto& 节点 : 节点组) {
                if (节点.创建事实代次 != *期望创建代次)
                    return {实例特征状态::内部不一致, std::nullopt};
            }
        }

        实例特征结构登记 登记;
        登记.事实截止代次 = *起始;
        登记.服务身份 = 定位[0];
        登记.宿主槽关系类型 = 定位[1];
        登记.定义模板关系类型 = 定位[2];
        登记.当前I64值属性类型 = 定位[3];
        return 实例特征结构登记完整(登记)
            ? 实例特征登记结果{实例特征状态::已读取, 登记}
            : 实例特征登记结果{实例特征状态::内部不一致, std::nullopt};
    }

    L1写集请求 形成I64当前值换代写集(
        const L1实例特征内部::I64当前值换代已验证材料& 材料,
        const 实例特征结构登记& 登记) const {
        L1写集请求 写集;
        写集.期望事实代次 = 材料.期望事实代次;
        写集.幂等键 = L1实例特征内部::映射幂等键(
            L1实例特征内部::换代幂等域, 材料.幂等身份);
        写集.值 = {{{1}, 事实引用{材料.实例槽},
            事实引用{登记.当前I64值属性类型}, 材料.新I64值,
            事实引用{材料.新来源节点}}};
        写集.属性槽变更 = {{事实引用{材料.实例槽},
            事实引用{登记.当前I64值属性类型}, 写集本地键{1}}};
        写集.退出事实 = {材料.旧当前值};
        return 写集;
    }

    L1写入结果 提交I64当前值换代写集(
        const L1实例特征内部::I64当前值换代已验证材料& 材料,
        const 实例特征结构登记& 登记,
        const L1领域意图凭证& 凭证,
        std::vector<L1提供者版本见证> 提供者组) {
        auto 写集 = 形成I64当前值换代写集(材料, 登记);
        写集.领域意图凭证 = 凭证;
        L1实例特征内部::设置执行证据提供者(写集, std::move(提供者组));
        return L1_.提交写集(std::move(写集), 0x15000403U);
    }

    bool 换代前结构完整(const L1完整快照& 快照,
        const 实际存在I64实例特征读取请求& 请求,
        const 实例特征结构登记& 登记) const noexcept {
        std::size_t 槽数量 = 0, 宿主关系数量 = 0, 定义关系数量 = 0;
        std::size_t 当前值数量 = 0, 当前属性数量 = 0;
        for (const auto& 节点 : 快照.当前节点) {
            if (节点.编码 != 请求.实例槽) continue;
            ++槽数量;
            if (节点.种类 != 节点种类::普通) return false;
            for (const auto& 属性 : 节点.当前属性) {
                if (属性.属性类型节点 != 登记.当前I64值属性类型) continue;
                ++当前属性数量;
                if (属性.当前值 != 请求.当前值) return false;
            }
        }
        for (const auto& 关系 : 快照.当前关系) {
            if (关系.编码 == 请求.宿主关系) {
                ++宿主关系数量;
                if (关系.源节点 != 请求.宿主.存在
                    || 关系.目标节点 != 请求.实例槽
                    || 关系.关系类型节点 != 登记.宿主槽关系类型
                    || 关系.角色或顺序 != 1) return false;
            }
            if (关系.编码 == 请求.定义关系) {
                ++定义关系数量;
                if (关系.源节点 != 请求.实例槽
                    || 关系.目标节点 != 请求.定义.特征定义
                    || 关系.关系类型节点 != 登记.定义模板关系类型
                    || 关系.角色或顺序 != 2) return false;
            }
        }
        for (const auto& 值 : 快照.当前值) {
            if (值.所属节点 != 请求.实例槽
                || 值.属性类型节点 != 登记.当前I64值属性类型) continue;
            ++当前值数量;
            if (值.编码 != 请求.当前值 || 值.来源节点 != 请求.来源节点
                || 值.退出事实代次) return false;
        }
        return 槽数量 == 1 && 宿主关系数量 == 1 && 定义关系数量 == 1
            && 当前值数量 == 1 && 当前属性数量 == 1;
    }

    实例特征状态 检查宿主定义唯一性(const L1完整快照& 快照,
        稳定编码 宿主, 稳定编码 定义, const 实例特征结构登记& 登记,
        bool& 已存在) const noexcept {
        已存在 = false;
        std::size_t 组合数量 = 0;
        for (const auto& 宿主项 : 快照.当前关系) {
            if (宿主项.关系类型节点 != 登记.宿主槽关系类型
                || 宿主项.角色或顺序 != 1 || 宿主项.源节点 != 宿主) continue;
            const auto 槽 = 宿主项.目标节点;
            std::size_t 槽宿主数量 = 0, 槽定义数量 = 0, 匹配定义数量 = 0;
            std::size_t 当前值数量 = 0, 当前属性数量 = 0;
            const 节点事实* 槽节点 = nullptr;
            for (const auto& 节点 : 快照.当前节点) {
                if (节点.编码 == 槽) 槽节点 = &节点;
            }
            for (const auto& 关系 : 快照.当前关系) {
                if (关系.关系类型节点 == 登记.宿主槽关系类型
                    && 关系.角色或顺序 == 1 && 关系.目标节点 == 槽) ++槽宿主数量;
                if (关系.关系类型节点 == 登记.定义模板关系类型
                    && 关系.角色或顺序 == 2 && 关系.源节点 == 槽) {
                    ++槽定义数量;
                    if (关系.目标节点 == 定义) ++匹配定义数量;
                }
            }
            for (const auto& 值 : 快照.当前值) {
                if (值.所属节点 == 槽
                    && 值.属性类型节点 == 登记.当前I64值属性类型) ++当前值数量;
            }
            if (槽节点) for (const auto& 属性 : 槽节点->当前属性) {
                if (属性.属性类型节点 == 登记.当前I64值属性类型) ++当前属性数量;
            }
            if (!槽节点 || 槽节点->种类 != 节点种类::普通
                || 槽宿主数量 != 1 || 槽定义数量 != 1
                || 当前值数量 != 1 || 当前属性数量 != 1)
                return 实例特征状态::内部不一致;
            if (匹配定义数量 == 1) ++组合数量;
        }
        if (组合数量 > 1) return 实例特征状态::内部不一致;
        已存在 = 组合数量 == 1;
        return 实例特征状态::已读取;
    }

    I64实例特征结果 读取I64实例特征事实核心(
        稳定编码 宿主, 稳定编码 定义, std::uint64_t 截止代次,
        稳定编码 实例槽, 稳定编码 宿主关系编码, 稳定编码 定义关系编码,
        稳定编码 当前值编码, 稳定编码 来源节点编码,
        const 实例特征结构登记& 登记) const {
        std::uint64_t 代次 = 截止代次;
        节点事实 槽;
        关系事实 宿主关系, 定义关系;
        值事实 当前值;
        实例特征状态 失败 = 实例特征状态::内部不一致;
        if (!L1实例特征内部::读取节点(L1_, 实例槽, 代次, 槽, 失败)
            || !L1实例特征内部::读取关系(L1_, 宿主关系编码, 代次, 宿主关系, 失败)
            || !L1实例特征内部::读取关系(L1_, 定义关系编码, 代次, 定义关系, 失败)
            || !L1实例特征内部::读取值(L1_, 当前值编码, 代次, 当前值, 失败))
            return {失败, std::nullopt, {}, {}};
        const auto 属性 = L1_.读取当前属性({L1事实基座合同版本,
            实例槽, 登记.当前I64值属性类型});
        if (属性.状态 != L1读取状态::成功 || !属性.属性.has_value())
            return {属性.状态 == L1读取状态::未找到
                || 属性.状态 == L1读取状态::属性未设置
                    ? 实例特征状态::未找到 : 实例特征状态::内部不一致,
                std::nullopt, {}, {}};
        if (属性.读取事实代次 != 代次)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        if (属性.属性->当前值 != 当前值编码 || 槽.种类 != 节点种类::普通
            || 宿主关系.源节点 != 宿主 || 宿主关系.目标节点 != 实例槽
            || 宿主关系.关系类型节点 != 登记.宿主槽关系类型
            || 宿主关系.角色或顺序 != 1
            || 定义关系.源节点 != 实例槽 || 定义关系.目标节点 != 定义
            || 定义关系.关系类型节点 != 登记.定义模板关系类型
            || 定义关系.角色或顺序 != 2
            || 当前值.所属节点 != 实例槽
            || 当前值.属性类型节点 != 登记.当前I64值属性类型
            || 当前值.来源节点 != 来源节点编码 || 当前值.退出事实代次
            || !std::holds_alternative<std::int64_t>(当前值.材料))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        const auto 快照 = L1_.读取完整快照({});
        if (快照.状态 != L1读取状态::成功 || !快照.快照.has_value())
            return {快照.状态 == L1读取状态::资源失败
                ? 实例特征状态::资源失败 : 实例特征状态::内部不一致,
                std::nullopt, {}, {}};
        if (快照.快照->事实代次 != 代次)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        bool 已存在 = false;
        const auto 唯一状态 = 检查宿主定义唯一性(
            *快照.快照, 宿主, 定义, 登记, 已存在);
        if (唯一状态 != 实例特征状态::已读取 || !已存在)
            return {唯一状态 == 实例特征状态::已读取
                ? 实例特征状态::内部不一致 : 唯一状态, std::nullopt, {}, {}};
        I64实例特征事实 事实;
        事实.事实截止代次 = 代次;
        事实.宿主 = 宿主;
        事实.特征定义 = 定义;
        事实.实例槽 = 实例槽;
        事实.当前值 = 当前值编码;
        事实.I64值 = std::get<std::int64_t>(当前值.材料);
        事实.来源节点 = 来源节点编码;
        if (!I64实例特征事实完整(事实))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        return {实例特征状态::已读取, 事实, 宿主关系编码, 定义关系编码};
    }

    // 诊断责任：向上送出；提供者和全部中性事实必须落在同一截止。
    I64实例特征结果 读取实际存在I64实例特征已持锁(
        const 实际存在I64实例特征读取请求& 请求,
        std::optional<std::uint64_t> 期望首次创建代次) const {
        if (!实际存在I64实例特征读取请求有效(请求))
            return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
        if (!登记定位_)
            return {实例特征状态::登记未加载, std::nullopt, {}, {}};

        实例特征状态 失败 = 实例特征状态::内部不一致;
        const auto 起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!起始) return {失败, std::nullopt, {}, {}};
        const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
        if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
            return {登记结果.状态, std::nullopt, {}, {}};
        const auto& 登记 = *登记结果.登记;

        const auto 宿主 = 实际存在_.读取实际存在(请求.宿主);
        if (宿主.状态 != 实际存在状态::已读取 || !宿主.事实)
            return {L1实例特征内部::映射实际存在状态(宿主.状态),
                std::nullopt, {}, {}};
        if (!实际存在事实完整(*宿主.事实))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
        if (定义.状态 != 特征定义状态::已读取 || !定义.事实)
            return {L1实例特征内部::映射定义状态(定义.状态),
                std::nullopt, {}, {}};
        if (登记.事实截止代次 != *起始
            || 宿主.事实->事实截止代次 != *起始
            || 定义.事实->事实截止代次 != *起始)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        if (宿主.事实->存在.编码 != 请求.宿主.存在
            || 定义.事实->特征定义 != 请求.定义.特征定义)
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};

        const auto 槽 = L1实例特征内部::读取中性节点(
            L1_, 请求.实例槽, *起始, 失败);
        const auto 宿主关系 = L1实例特征内部::读取中性关系(
            L1_, 请求.宿主关系, *起始, 失败);
        const auto 定义关系 = L1实例特征内部::读取中性关系(
            L1_, 请求.定义关系, *起始, 失败);
        const auto 当前属性 = L1实例特征内部::读取中性属性(
            L1_, 请求.实例槽, 登记.当前I64值属性类型, *起始, 失败);
        const auto 当前值 = L1实例特征内部::读取中性值(
            L1_, 请求.当前值, *起始, 失败);
        const auto 来源 = L1实例特征内部::读取中性节点(
            L1_, 请求.来源节点, *起始, 失败);
        if (!槽 || !宿主关系 || !定义关系 || !当前属性 || !当前值 || !来源)
            return {失败, std::nullopt, {}, {}};
        const auto 结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
        if (!结束) return {失败, std::nullopt, {}, {}};
        if (*结束 != *起始)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};

        std::size_t 当前值槽数量 = 0;
        bool 节点槽匹配 = false;
        for (const auto& 属性 : 槽->当前属性) {
            if (属性.属性类型节点 != 登记.当前I64值属性类型) continue;
            ++当前值槽数量;
            节点槽匹配 = 属性.当前值 == 请求.当前值;
        }
        if (槽->种类 != 节点种类::普通 || 槽->属性类型表示
            || 槽->退出事实代次 || 当前值槽数量 != 1 || !节点槽匹配
            || *当前属性 != 请求.当前值
            || 宿主关系->源节点 != 请求.宿主.存在
            || 宿主关系->目标节点 != 请求.实例槽
            || 宿主关系->关系类型节点 != 登记.宿主槽关系类型
            || 宿主关系->角色或顺序 != 1 || 宿主关系->退出事实代次
            || 定义关系->源节点 != 请求.实例槽
            || 定义关系->目标节点 != 请求.定义.特征定义
            || 定义关系->关系类型节点 != 登记.定义模板关系类型
            || 定义关系->角色或顺序 != 2 || 定义关系->退出事实代次
            || 当前值->所属节点 != 请求.实例槽
            || 当前值->属性类型节点 != 登记.当前I64值属性类型
            || 当前值->来源节点 != 请求.来源节点 || 当前值->退出事实代次
            || !std::holds_alternative<std::int64_t>(当前值->材料)
            || 来源->种类 != 节点种类::普通 || 来源->属性类型表示
            || 来源->退出事实代次)
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        if (槽->创建事实代次 > *起始
            || 宿主关系->创建事实代次 > *起始
            || 定义关系->创建事实代次 > *起始
            || 当前值->创建事实代次 > *起始)
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        if (期望首次创建代次
            && (槽->创建事实代次 != *期望首次创建代次
                || 宿主关系->创建事实代次 != *期望首次创建代次
                || 定义关系->创建事实代次 != *期望首次创建代次
                || 当前值->创建事实代次 != *期望首次创建代次))
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};

        I64实例特征事实 事实;
        事实.事实截止代次 = *起始;
        事实.宿主 = 请求.宿主.存在;
        事实.特征定义 = 请求.定义.特征定义;
        事实.实例槽 = 请求.实例槽;
        事实.当前值 = 请求.当前值;
        事实.I64值 = std::get<std::int64_t>(当前值->材料);
        事实.来源节点 = 请求.来源节点;
        return I64实例特征事实完整(事实)
            ? I64实例特征结果{实例特征状态::已读取, 事实,
                请求.宿主关系, 请求.定义关系}
            : I64实例特征结果{实例特征状态::内部不一致,
                std::nullopt, {}, {}};
    }

    I64实例特征结果 读取I64实例特征内部(const I64实例特征读取请求& 请求) const {
        if (请求.合同版本 != L1实例特征合同版本 || 请求.规则版本 != L1实例特征规则版本
            || !有效(请求.实例槽) || !有效(请求.宿主关系) || !有效(请求.定义关系)
            || !有效(请求.当前值) || !有效(请求.来源节点))
            return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
        if (!登记定位_)
            return {实例特征状态::登记未加载, std::nullopt, {}, {}};
        const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
        if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
            return {登记结果.状态, std::nullopt, {}, {}};
        const auto& 登记 = *登记结果.登记;
        const auto 场景 = 场景结构_.读取初始场景(请求.宿主);
        if (场景.状态 != 世界结构状态::已读取 || !场景.事实.has_value()) return {L1实例特征内部::映射场景状态(场景.状态), std::nullopt, {}, {}};
        const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
        if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value()) return {L1实例特征内部::映射定义状态(定义.状态), std::nullopt, {}, {}};
        if (定义.事实->事实截止代次 != 场景.事实->事实截止代次)
            return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
        return 读取I64实例特征事实核心(场景.事实->初始场景.编码,
            定义.事实->特征定义, 场景.事实->事实截止代次,
            请求.实例槽, 请求.宿主关系, 请求.定义关系,
            请求.当前值, 请求.来源节点, 登记);
    }

    L1事实基座服务& L1_;
    L1场景结构服务& 场景结构_;
    L1特征定义服务& 特征定义_;
    L1实际存在场景组合服务& 实际存在_;
    mutable std::recursive_mutex 锁_;
    mutable std::optional<std::array<稳定编码, 4>> 登记定位_;
    std::optional<初始场景I64实例特征建立请求> 首次实例请求_;
    I64实例特征读取请求 实例读取请求_;
    I64实例特征结果 首次实例结果_;
    struct I64当前值换代记录 final {
        std::variant<I64实例特征当前值换代请求,
            实际存在I64实例特征当前值换代请求> 请求;
        L1写集请求 写集;
        std::variant<I64实例特征读取请求,
            实际存在I64实例特征读取请求> 读取请求;
        I64实例特征事实 旧事实;
        L1实例特征内部::I64当前值换代已验证材料 已验证材料;
        std::uint64_t 首次发布事实代次 = 0;
        I64实例特征结果 首次结果;
    };
    std::map<std::uint64_t, I64当前值换代记录> 换代账_;
    mutable std::map<std::uint64_t, 实际存在身份定位> 实际存在身份定位_;
    mutable std::map<std::array<std::uint64_t, 2>, 实际存在组合定位>
        实际存在组合定位_;
};

} // namespace 海中鱼巣
