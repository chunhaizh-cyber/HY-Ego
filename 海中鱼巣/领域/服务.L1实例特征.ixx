// 诊断责任：向上送出；无有效代次不降级为成功。
std::optional<std::uint64_t> 读取中性当前代次(
    const L1事实基座服务& L1, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (结果.状态 != L1中性读取状态::成功 || 结果.事实代次 == 0) {
        失败 = 映射中性读取状态(结果.状态);
        if (结果.状态 == L1中性读取状态::成功)
            失败 = 实例特征状态::内部不一致;
        return std::nullopt;
    }
    return 结果.事实代次;
}

// 诊断责任：向上送出；编码或代次不匹配不降级为成功。
std::optional<L1中性节点事实> 读取中性节点(
    const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前节点({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
        || 结果.事实->编码 != 编码) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.事实;
}

// 诊断责任：向上送出；编码或代次不匹配不降级为成功。
std::optional<L1中性关系事实> 读取中性关系(
    const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前关系({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
        || 结果.事实->编码 != 编码) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.事实;
}

// 诊断责任：向上送出；编码或代次不匹配不降级为成功。
std::optional<L1中性值事实> 读取中性值(
    const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前值({L1中性CRUD合同版本, 编码});
    if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
        || 结果.事实->编码 != 编码) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.事实;
}

// 诊断责任：向上送出；属性缺失和代次漂移保留为具名状态。
std::optional<稳定编码> 读取中性属性(
    const L1事实基座服务& L1, 稳定编码 节点, 稳定编码 属性类型,
    std::uint64_t 期望代次, 实例特征状态& 失败) noexcept {
    const auto 结果 = L1.读取中性当前属性(
        {L1中性CRUD合同版本, 节点, 属性类型});
    if (结果.状态 != L1中性读取状态::成功 || !结果.当前值) {
        失败 = 映射中性读取状态(结果.状态);
        return std::nullopt;
    }
    if (结果.节点 != 节点 || 结果.属性类型 != 属性类型
        || 结果.读取事实代次 != 期望代次) {
        失败 = 结果.读取事实代次 == 期望代次
            ? 实例特征状态::内部不一致 : 实例特征状态::事实代次漂移;
        return std::nullopt;
    }
    return 结果.当前值;
}

} // namespace L1实例特征内部

class L1实例特征服务 final {
    struct 实际存在身份定位 final {
        std::array<std::uint64_t, 2> 组合{};
        实际存在I64实例特征读取请求 读取请求;
    };

    struct 实际存在组合定位 final {
        std::uint64_t 幂等身份 = 0;
        实际存在I64实例特征读取请求 读取请求;
    };

public:
    L1实例特征服务(L1事实基座服务& L1, L1场景结构服务& 场景结构,
        L1特征定义服务& 特征定义,
        L1实际存在场景组合服务& 实际存在) noexcept
        : L1_(L1), 场景结构_(场景结构), 特征定义_(特征定义),
          实际存在_(实际存在) {}
    L1实例特征服务(const L1实例特征服务&) = delete;
    L1实例特征服务& operator=(const L1实例特征服务&) = delete;

    // 诊断责任：向上送出；兼容入口只转发同对象的正式 const 写重载。
    实例特征登记结果 建立登记(const 实例特征登记请求& 请求) {
        return static_cast<const L1实例特征服务&>(*this).建立登记(请求);
    }

    // 诊断责任：向上送出；所有失败由结构化实例特征状态返回。
    实例特征登记结果 建立登记(const 实例特征登记请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!实例特征登记请求有效(请求)) return {};
            const auto 幂等键 = L1实例特征内部::映射中性幂等键(
                L1实例特征内部::登记幂等域, 请求.幂等身份);
            L1中性写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {
                {{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::普通, std::nullopt},
                {{3}, 节点种类::普通, std::nullopt},
                {{4}, 节点种类::属性类型, L1中性值表示种类::I64}};
            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1实例特征内部::映射中性写入状态(写入.状态);
            if (状态 != 实例特征状态::已提交 && 状态 != 实例特征状态::幂等读回)
                return {状态, std::nullopt};
            if (!L1实例特征内部::中性写入成功合同完整(写入, 幂等键, 4))
                return {实例特征状态::内部不一致, std::nullopt};
            const auto 服务 = L1实例特征内部::查找中性映射(写入, 1);
            const auto 宿主 = L1实例特征内部::查找中性映射(写入, 2);
            const auto 定义 = L1实例特征内部::查找中性映射(写入, 3);
            const auto 属性 = L1实例特征内部::查找中性映射(写入, 4);
            if (!服务 || !宿主 || !定义 || !属性)
                return {实例特征状态::内部不一致, std::nullopt};
            const std::array<稳定编码, 4> 新定位{*服务, *宿主, *定义, *属性};
            auto 读回 = 读取当前登记已持锁(新定位, 写入.事实代次);
            if (读回.状态 != 实例特征状态::已读取 || !读回.登记)
                return {读回.状态 == 实例特征状态::已读取
                        ? 实例特征状态::内部不一致 : 读回.状态,
                    std::nullopt};
            if (登记定位_.has_value() && *登记定位_ != 新定位)
                return {实例特征状态::内部不一致, std::nullopt};
            登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) { return {实例特征状态::资源失败, std::nullopt}; }
        catch (...) { return {实例特征状态::内部不一致, std::nullopt}; }
    }

    实例特征登记结果 读取当前登记() const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!登记定位_)
                return {实例特征状态::登记未加载, std::nullopt};
            return 读取当前登记已持锁(*登记定位_, std::nullopt);
        } catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt};
        }
    }

    I64实例特征结果 建立初始场景I64实例特征(
        const 初始场景I64实例特征建立请求& 请求) {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!初始场景I64实例特征建立请求有效(请求))
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            const auto 凭证 = L1实例特征内部::形成G4初始实例意图凭证(请求);
            const auto 幂等键 = L1实例特征内部::映射幂等键(
                L1实例特征内部::实例幂等域, 请求.幂等身份);
            const auto 探测 = L1_.探测幂等({L1事实基座合同版本,
                L1幂等摘要合同版本, 幂等键, 凭证.请求意图摘要, 凭证});
            if (探测.状态 == L1幂等探测状态::异义冲突)
                return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
            if (探测.状态 == L1幂等探测状态::已隔离
                || 探测.状态 == L1幂等探测状态::内部不一致)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            if (探测.状态 != L1幂等探测状态::未找到
                && 探测.状态 != L1幂等探测状态::同义已发布)
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            if (!登记定位_)
                return {实例特征状态::登记未加载, std::nullopt, {}, {}};
            const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
            if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
                return {登记结果.状态, std::nullopt, {}, {}};
            const auto& 登记 = *登记结果.登记;
            if (首次实例请求_.has_value()) {
                if (!L1实例特征内部::实例请求相同(*首次实例请求_, 请求)
                    || 探测.状态 != L1幂等探测状态::同义已发布)
                    return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
                auto 结果 = 首次实例结果_;
                结果.状态 = 实例特征状态::幂等读回;
                return 结果;
            }
            if (探测.状态 == L1幂等探测状态::同义已发布)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            if (请求.期望事实代次 != 登记.事实截止代次) return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            const auto 场景 = 场景结构_.读取初始场景(请求.宿主);
            if (场景.状态 != 世界结构状态::已读取 || !场景.事实.has_value())
                return {L1实例特征内部::映射场景状态(场景.状态), std::nullopt, {}, {}};
            const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
            if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value())
                return {L1实例特征内部::映射定义状态(定义.状态), std::nullopt, {}, {}};
            if (场景.事实->事实截止代次 != 请求.期望事实代次
                || 定义.事实->事实截止代次 != 请求.期望事实代次)
                return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            if (请求.初始值 < 定义.事实->下界 || 请求.初始值 > 定义.事实->上界)
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            std::uint64_t 代次 = 请求.期望事实代次;
            节点事实 来源节点;
            实例特征状态 失败 = 实例特征状态::内部不一致;
            if (!L1实例特征内部::读取节点(L1_, 请求.来源节点, 代次, 来源节点, 失败)) return {失败, std::nullopt, {}, {}};
            if (来源节点.种类 != 节点种类::普通) return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            const auto 快照 = L1_.读取完整快照({});
            if (快照.状态 != L1读取状态::成功 || !快照.快照.has_value()
                || 快照.快照->事实代次 != 请求.期望事实代次) return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
            for (const auto& 关系 : 快照.快照->当前关系) {
                if (关系.退出事实代次 || 关系.角色或顺序 == 1
                    && 关系.源节点 == 场景.事实->初始场景.编码
                    && 关系.关系类型节点 == 登记.宿主槽关系类型) return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            }
            auto 写集 = L1实例特征内部::形成实例写集({
                请求.期望事实代次, 请求.幂等身份,
                场景.事实->初始场景.编码, 定义.事实->特征定义,
                请求.初始值, 请求.来源节点, 登记.宿主槽关系类型,
                登记.定义模板关系类型, 登记.当前I64值属性类型});
            const auto 场景身份 = 场景结构_.读取提供者身份();
            const auto L1身份 = L1_.读取提供者身份();
            L1实例特征内部::设置执行证据提供者(写集, {
                {场景身份.稳定身份, 场景身份.合同版本, 场景身份.规则版本, 1},
                {定义.事实->来源服务, L1特征定义合同版本, L1特征定义规则版本, 1},
                {L1身份.稳定身份, L1身份.合同版本, L1身份.规则版本, 1}});
            const auto 写入 = L1实例特征内部::提交实例写集(L1_, 写集, 凭证);
            const auto 状态 = 写入.状态;
            if (状态 != 实例特征状态::已提交 && 状态 != 实例特征状态::幂等读回)
                return {状态, std::nullopt, {}, {}};
            if (!有效(写入.实例槽) || !有效(写入.宿主关系)
                || !有效(写入.定义关系) || !有效(写入.当前值))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            实例读取请求_ = {};
            实例读取请求_.宿主 = 请求.宿主;
            实例读取请求_.定义 = 请求.定义;
            实例读取请求_.实例槽 = 写入.实例槽;
            实例读取请求_.宿主关系 = 写入.宿主关系;
            实例读取请求_.定义关系 = 写入.定义关系;
            实例读取请求_.当前值 = 写入.当前值;
            实例读取请求_.来源节点 = 请求.来源节点;
            const auto 读回 = 读取I64实例特征内部(实例读取请求_);
            if (读回.状态 != 实例特征状态::已读取 || !读回.事实.has_value()
                || 读回.事实->事实截止代次 != 写入.事实代次)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            首次实例请求_ = 请求;
            首次实例结果_ = {状态, 读回.事实, 读回.宿主关系, 读回.定义关系};
            return 首次实例结果_;
        } catch (const std::bad_alloc&) { return {实例特征状态::资源失败, std::nullopt, {}, {}}; }
        catch (...) { return {实例特征状态::内部不一致, std::nullopt, {}, {}}; }
    }

    // 诊断责任：向上送出；兼容入口只转发同对象的正式 const 写重载。
    I64实例特征结果 建立实际存在I64实例特征(
        const 实际存在I64实例特征建立请求& 请求) {
        return static_cast<const L1实例特征服务&>(*this)
            .建立实际存在I64实例特征(请求);
    }

    // 诊断责任：向上送出；所有失败由结构化实例特征状态返回。
    I64实例特征结果 建立实际存在I64实例特征(
        const 实际存在I64实例特征建立请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!实际存在I64实例特征建立请求有效(请求))
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            if (!登记定位_)
                return {实例特征状态::登记未加载, std::nullopt, {}, {}};

            const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
            if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
                return {登记结果.状态, std::nullopt, {}, {}};
            const auto& 登记 = *登记结果.登记;
            const auto 键 = 请求.幂等身份.值;
            const std::array<std::uint64_t, 2> 组合{
                请求.宿主.存在.值, 请求.定义.特征定义.值};
            const auto 已有身份 = 实际存在身份定位_.find(键);
            const bool 精确重复候选 = 已有身份 != 实际存在身份定位_.end();
            if (!精确重复候选 && 实际存在组合定位_.contains(组合))
                return {实例特征状态::幂等冲突, std::nullopt, {}, {}};

            L1实例特征内部::实例写入材料 材料{
                请求.期望事实代次, 请求.幂等身份, 请求.宿主.存在,
                请求.定义.特征定义, 请求.初始值, 请求.来源节点,
                登记.宿主槽关系类型, 登记.定义模板关系类型,
                登记.当前I64值属性类型};

            std::map<std::uint64_t, 实际存在身份定位> 待登记身份;
            std::map<std::array<std::uint64_t, 2>, 实际存在组合定位> 待登记组合;
            if (!精确重复候选) {
                待登记身份.try_emplace(键, 实际存在身份定位{组合, {}});
                待登记组合.try_emplace(组合, 实际存在组合定位{键, {}});
            }

            if (!精确重复候选) {
                实例特征状态 失败 = 实例特征状态::内部不一致;
                const auto 起始 = L1实例特征内部::读取中性当前代次(L1_, 失败);
                if (!起始) return {失败, std::nullopt, {}, {}};
                if (*起始 != 请求.期望事实代次
                    || 登记.事实截止代次 != *起始)
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};

                const auto 宿主 = 实际存在_.读取实际存在(请求.宿主);
                if (宿主.状态 != 实际存在状态::已读取 || !宿主.事实.has_value())
                    return {L1实例特征内部::映射实际存在状态(宿主.状态),
                        std::nullopt, {}, {}};
                if (!实际存在事实完整(*宿主.事实))
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
                const auto 定义 = 特征定义_.读取I64特征定义(请求.定义);
                if (定义.状态 != 特征定义状态::已读取 || !定义.事实.has_value())
                    return {L1实例特征内部::映射定义状态(定义.状态),
                        std::nullopt, {}, {}};
                if (宿主.事实->事实截止代次 != *起始
                    || 定义.事实->事实截止代次 != *起始)
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
                if (宿主.事实->存在.编码 != 请求.宿主.存在
                    || 定义.事实->特征定义 != 请求.定义.特征定义)
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
                if (请求.初始值 < 定义.事实->下界
                    || 请求.初始值 > 定义.事实->上界)
                    return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
                const auto 来源 = L1实例特征内部::读取中性节点(
                    L1_, 请求.来源节点, *起始, 失败);
                if (!来源) return {失败, std::nullopt, {}, {}};
                if (来源->种类 != 节点种类::普通 || 来源->属性类型表示
                    || 来源->退出事实代次)
                    return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
                const auto 结束 = L1实例特征内部::读取中性当前代次(L1_, 失败);
                if (!结束) return {失败, std::nullopt, {}, {}};
                if (*结束 != *起始)
                    return {实例特征状态::事实代次漂移, std::nullopt, {}, {}};
                材料.宿主 = 宿主.事实->存在.编码;
                材料.定义 = 定义.事实->特征定义;
            }

            const auto 写集 = L1实例特征内部::形成中性实例写集(材料);
            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1实例特征内部::映射中性写入状态(写入.状态);
            if (状态 != 实例特征状态::已提交
                && 状态 != 实例特征状态::幂等读回)
                return {状态, std::nullopt, {}, {}};
            if (!L1实例特征内部::中性写入成功合同完整(
                    写入, 写集.幂等键, 4))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            const auto 实例槽 = L1实例特征内部::查找中性映射(写入, 1);
            const auto 宿主关系 = L1实例特征内部::查找中性映射(写入, 2);
            const auto 定义关系 = L1实例特征内部::查找中性映射(写入, 3);
            const auto 当前值 = L1实例特征内部::查找中性映射(写入, 4);
            if (!实例槽 || !宿主关系 || !定义关系 || !当前值)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            实际存在I64实例特征读取请求 读取请求;
            读取请求.宿主 = 请求.宿主;
            读取请求.定义 = 请求.定义;
            读取请求.实例槽 = *实例槽;
            读取请求.宿主关系 = *宿主关系;
            读取请求.定义关系 = *定义关系;
            读取请求.当前值 = *当前值;
            读取请求.来源节点 = 请求.来源节点;
            if (!实际存在I64实例特征读取请求有效(读取请求))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            if (精确重复候选
                && (已有身份->second.组合 != 组合
                    || !(已有身份->second.读取请求 == 读取请求)))
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};

            auto 读回 = 读取实际存在I64实例特征已持锁(
                读取请求, 写入.事实代次);
            if (读回.状态 != 实例特征状态::已读取 || !读回.事实)
                return {读回.状态 == 实例特征状态::已读取
                        ? 实例特征状态::内部不一致 : 读回.状态,
                    std::nullopt, {}, {}};
            if (!精确重复候选) {
                待登记身份.begin()->second.读取请求 = 读取请求;
                待登记组合.begin()->second.读取请求 = 读取请求;
                实际存在身份定位_.merge(待登记身份);
                实际存在组合定位_.merge(待登记组合);
                if (!待登记身份.empty() || !待登记组合.empty())
                    return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            }
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return {实例特征状态::资源失败, std::nullopt, {}, {}};
        } catch (...) {
            return {实例特征状态::内部不一致, std::nullopt, {}, {}};
        }
    }

    I64实例特征结果 换代I64实例特征当前值(
        const I64实例特征当前值换代请求& 请求) {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!I64实例特征当前值换代请求有效(请求))
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            const auto 凭证 = L1实例特征内部::形成G4初始换代意图凭证(请求);
            const auto 幂等键 = L1实例特征内部::映射幂等键(
                L1实例特征内部::换代幂等域, 请求.幂等身份);
            const auto 探测 = L1_.探测幂等({L1事实基座合同版本,
                L1幂等摘要合同版本, 幂等键, 凭证.请求意图摘要, 凭证});
            if (探测.状态 == L1幂等探测状态::异义冲突)
                return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
            if (探测.状态 == L1幂等探测状态::已隔离
                || 探测.状态 == L1幂等探测状态::内部不一致)
                return {实例特征状态::内部不一致, std::nullopt, {}, {}};
            if (探测.状态 != L1幂等探测状态::未找到
                && 探测.状态 != L1幂等探测状态::同义已发布)
                return {实例特征状态::入口拒绝, std::nullopt, {}, {}};
            if (!登记定位_)
                return {实例特征状态::登记未加载, std::nullopt, {}, {}};
            const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
            if (登记结果.状态 != 实例特征状态::已读取 || !登记结果.登记)
                return {登记结果.状态, std::nullopt, {}, {}};
            const auto& 登记 = *登记结果.登记;

            const auto 已有 = 换代账_.find(请求.幂等身份.值);
            const bool 同一幂等键 = 已有 != 换代账_.end();
            const auto* 已有请求 = 同一幂等键
                ? std::get_if<I64实例特征当前值换代请求>(&已有->second.请求) : nullptr;
            const bool 精确重复 = 已有请求
                && L1实例特征内部::换代请求相同(*已有请求, 请求);
            if (同一幂等键 && !精确重复) {
                return {实例特征状态::幂等冲突, std::nullopt, {}, {}};
            }
