module;

#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <variant>

export module 海中鱼巣.领域.服务.L1方法登记根当前读取;

import 海中鱼巣.核心.服务.L1事实基座;

export {
#include "L1方法登记根当前读取.数据.h"
}

namespace 海中鱼巣::L1方法登记根当前读取内部 {

// R1-诊断责任：无适用错误分支；最终责任边界为公开读取入口。
bool 节点见证入口有效(const 方法登记根节点见证& 见证,
    节点种类 期望种类, std::uint64_t 截止) noexcept {
    return 有效(见证.编码) && 见证.种类 == 期望种类
        && 见证.创建事实代次 != 0 && 见证.创建事实代次 <= 截止;
}

// R1-诊断责任：无适用错误分支；最终责任边界为公开读取入口。
bool 请求有效(const 方法登记根当前读取请求& 请求) noexcept {
    const auto& 定位 = 请求.定位;
    return 请求.合同版本 == L1方法登记根当前读取合同版本
        && 请求.读取规则版本 == 方法登记根当前读取规则版本
        && 请求.期望事实截止代次 != 0 && 定位.角色合同版本 == 1
        && 节点见证入口有效(定位.登记根, 节点种类::普通, 请求.期望事实截止代次)
        && 节点见证入口有效(定位.系统角色属性类型, 节点种类::属性类型,
            请求.期望事实截止代次)
        && 节点见证入口有效(定位.方法领域服务, 节点种类::普通,
            请求.期望事实截止代次)
        && 定位.登记根.编码 != 定位.系统角色属性类型.编码
        && 定位.登记根.编码 != 定位.方法领域服务.编码
        && 定位.系统角色属性类型.编码 != 定位.方法领域服务.编码;
}

// R1-诊断责任：向上送出；最终责任边界为公开读取结果和启动薄日志。
constexpr 方法登记根当前读取结果 映射读取失败(L1读取状态 状态) noexcept {
    switch (状态) {
    case L1读取状态::未找到:
        return {方法登记根当前读取状态::未找到, 0, std::nullopt};
    case L1读取状态::许可拒绝:
        return {方法登记根当前读取状态::许可拒绝, 0, std::nullopt};
    case L1读取状态::资源失败:
        return {方法登记根当前读取状态::资源失败, 0, std::nullopt};
    case L1读取状态::内部不一致:
        return {方法登记根当前读取状态::内部不一致, 0, std::nullopt};
    default:
        return {方法登记根当前读取状态::内部不一致, 0, std::nullopt};
    }
}

static_assert(映射读取失败(L1读取状态::未找到).状态
    == 方法登记根当前读取状态::未找到);
static_assert(映射读取失败(L1读取状态::许可拒绝).状态
    == 方法登记根当前读取状态::许可拒绝);
static_assert(映射读取失败(L1读取状态::资源失败).状态
    == 方法登记根当前读取状态::资源失败);
static_assert(映射读取失败(L1读取状态::内部不一致).状态
    == 方法登记根当前读取状态::内部不一致);
static_assert(映射读取失败(L1读取状态::成功).状态
    == 方法登记根当前读取状态::内部不一致);

// R1-诊断责任：无适用错误分支；最终责任边界为解释快照。
bool 节点匹配(const 节点事实& 事实, const 方法登记根节点见证& 见证,
    std::optional<值表示种类> 期望表示) noexcept {
    return 事实.编码 == 见证.编码 && 事实.种类 == 见证.种类
        && 事实.创建事实代次 == 见证.创建事实代次
        && !事实.退出事实代次 && 事实.属性类型表示 == 期望表示;
}

// R1-诊断责任：无适用错误分支；最终责任边界为解释快照。
const 节点事实* 唯一节点(const L1完整快照& 快照, 稳定编码 编码,
    std::size_t& 数量) noexcept {
    const 节点事实* 结果 = nullptr;
    数量 = 0;
    for (const auto& 事实 : 快照.当前节点) {
        if (事实.编码 == 编码) {
            ++数量;
            结果 = &事实;
        }
    }
    return 结果;
}

// R1-诊断责任：无适用错误分支；最终责任边界为解释快照。
const 值事实* 唯一值(const L1完整快照& 快照, 稳定编码 编码,
    std::size_t& 数量) noexcept {
    const 值事实* 结果 = nullptr;
    数量 = 0;
    for (const auto& 事实 : 快照.当前值) {
        if (事实.编码 == 编码) {
            ++数量;
            结果 = &事实;
        }
    }
    return 结果;
}

// R1-诊断责任：向上送出；最终责任边界为公开读取结果和启动薄日志。
方法登记根当前读取结果 解释快照(const L1完整快照& 快照,
    const 方法登记根当前读取请求& 请求) {
    if (快照.事实代次 != 请求.期望事实截止代次)
        return {方法登记根当前读取状态::版本漂移, 快照.事实代次, std::nullopt};

    std::size_t 根数 = 0;
    std::size_t 类型数 = 0;
    std::size_t 服务数 = 0;
    const auto* 根 = 唯一节点(快照, 请求.定位.登记根.编码, 根数);
    const auto* 类型 = 唯一节点(快照, 请求.定位.系统角色属性类型.编码, 类型数);
    const auto* 来源 = 唯一节点(快照, 请求.定位.方法领域服务.编码, 服务数);
    if (根数 == 0 && 类型数 == 0 && 服务数 == 0)
        return {方法登记根当前读取状态::未找到, 快照.事实代次, std::nullopt};
    if (根数 != 1 || 类型数 != 1 || 服务数 != 1
        || !节点匹配(*根, 请求.定位.登记根, std::nullopt)
        || !节点匹配(*类型, 请求.定位.系统角色属性类型, 值表示种类::I64)
        || !节点匹配(*来源, 请求.定位.方法领域服务, std::nullopt))
        return {方法登记根当前读取状态::内部不一致, 快照.事实代次, std::nullopt};

    const 属性槽* 角色槽 = nullptr;
    std::size_t 角色槽数 = 0;
    for (const auto& 槽 : 根->当前属性) {
        if (槽.属性类型节点 == 类型->编码) {
            ++角色槽数;
            角色槽 = &槽;
        }
    }
    if (角色槽数 != 1 || !角色槽 || !有效(角色槽->当前值))
        return {方法登记根当前读取状态::内部不一致, 快照.事实代次, std::nullopt};

    std::size_t 值数 = 0;
    const auto* 值 = 唯一值(快照, 角色槽->当前值, 值数);
    if (值数 != 1 || !值 || 值->退出事实代次
        || 值->所属节点 != 根->编码 || 值->属性类型节点 != 类型->编码
        || 值->来源节点 != 来源->编码 || 值->创建事实代次 == 0
        || 值->创建事实代次 > 快照.事实代次)
        return {方法登记根当前读取状态::内部不一致, 快照.事实代次, std::nullopt};
    const auto* 角色 = std::get_if<std::int64_t>(&值->材料);
    if (!角色 || *角色 != static_cast<std::int64_t>(方法固定系统角色::方法登记根))
        return {方法登记根当前读取状态::内部不一致, 快照.事实代次, std::nullopt};

    方法登记根角色值见证 角色值{值->编码, 请求.定位.登记根,
        请求.定位.系统角色属性类型, 方法固定系统角色::方法登记根,
        请求.定位.方法领域服务, 值->创建事实代次};
    方法登记根当前事实 事实{L1方法登记根当前读取合同版本,
        方法登记根当前读取规则版本, 快照.事实代次, 请求.定位, 角色值};
    return {方法登记根当前读取状态::已读取, 快照.事实代次, std::move(事实)};
}

} // namespace 海中鱼巣::L1方法登记根当前读取内部

export namespace 海中鱼巣 {

class L1方法登记根当前读取服务 final {
public:
    // R1-诊断责任：无适用错误分支；最终责任边界为公开读取入口。
    explicit L1方法登记根当前读取服务(const L1事实基座服务& L1) noexcept
        : L1_(L1) {}
    L1方法登记根当前读取服务(const L1方法登记根当前读取服务&) = delete;
    L1方法登记根当前读取服务& operator=(const L1方法登记根当前读取服务&) = delete;
    L1方法登记根当前读取服务(L1方法登记根当前读取服务&&) = delete;
    L1方法登记根当前读取服务& operator=(L1方法登记根当前读取服务&&) = delete;

    // R1-诊断责任：向上送出；最终责任边界为结构化结果和启动薄日志。
    方法登记根当前读取结果 读取当前方法登记根(
        const 方法登记根当前读取请求& 请求) const {
        return 读取当前方法登记根实现(请求,
            [this](const L1完整快照读取请求& 快照请求) {
                return L1_.尝试读取完整快照(快照请求);
            });
    }

private:
    // R1-诊断责任：向上送出；最终责任边界为公开读取结果和专项自检。
    template<class 快照读取器>
    方法登记根当前读取结果 读取当前方法登记根实现(
        const 方法登记根当前读取请求& 请求, 快照读取器&& 读取器) const {
        try {
            if (!L1方法登记根当前读取内部::请求有效(请求)) return {};
            const auto 快照结果 = 读取器(L1完整快照读取请求{L1事实基座合同版本});
            if (快照结果.状态 != L1读取状态::成功 || !快照结果.快照)
                return L1方法登记根当前读取内部::映射读取失败(快照结果.状态);
            return L1方法登记根当前读取内部::解释快照(*快照结果.快照, 请求);
        } catch (const std::bad_alloc&) {
            return {方法登记根当前读取状态::资源失败, 0, std::nullopt};
        } catch (...) {
            return {方法登记根当前读取状态::内部不一致, 0, std::nullopt};
        }
    }

    friend struct L1方法登记根当前读取自检访问器;
    const L1事实基座服务& L1_;
};

} // namespace 海中鱼巣
