module;

#include <cstdint>
#include <optional>

export module 海中鱼巣.领域.组合.运行期事实版本;

import 海中鱼巣.领域.服务.完整秒时钟;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.合同.L2结构公共;

// 对齐 BIZ-L3-002-01-03 v0.2
// 运行期事实版本服务：经 L2存在结构服务读取当前已发布共享事实截止
// 不直达 L1，不枚举 owner，不缓存全局截止
export namespace 海中鱼巣 {

class 运行期事实版本服务 final {
public:
  explicit 运行期事实版本服务(
      const L2存在结构服务& 存在结构服务) noexcept
      : 存在结构服务_(存在结构服务) {}

  运行期事实版本服务(const 运行期事实版本服务&) = delete;
  运行期事实版本服务& operator=(const 运行期事实版本服务&) = delete;

  // BIZ-L3-002-01-03: 读取当前已发布共享事实截止
  共享事实截止读取结果 读取当前已发布共享事实截止(
      const 共享事实截止读取请求& 请求) const noexcept {
    共享事实截止读取结果 结果;

    // N01: 合同版本、运行代次和事实范围版本非零且匹配服务配置
    if (请求.合同版本 != 事实版本服务合同版本 ||
        请求.运行代次 == 0 || 请求.事实范围版本 == 0) {
      结果.状态 = 共享事实截止状态::请求拒绝;
      return 结果;
    }

    // N02: 经 L2存在结构服务读取当前事实代次
    const auto 代次结果 = 存在结构服务_.读取当前事实代次();

    // N02 非成功 → N09
    if (代次结果.状态 != L2结构状态::已读取) {
      if (代次结果.状态 == L2结构状态::资源失败) {
        结果.状态 = 共享事实截止状态::资源失败;
      } else {
        结果.状态 = 共享事实截止状态::内部不一致;
      }
      return 结果;
    }

    // N03: DATA合同、成功状态和非零事实截止完整
    if (代次结果.事实截止代次 == 0) {
      结果.状态 = 共享事实截止状态::内部不一致;
      return 结果;
    }

    // N04-N05: 绑定并返回已读取
    结果.共享事实截止 = 代次结果.事实截止代次;
    结果.状态 = 共享事实截止状态::已读取;
    return 结果;
  }

private:
  const L2存在结构服务& 存在结构服务_;
};

} // namespace 海中鱼巣
