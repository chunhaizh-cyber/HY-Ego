export namespace 海中鱼巣 {

inline constexpr L1所有者范围建立幂等身份 存在所有者建立身份{
    0x4C31'4F57'4E45'5231ULL};

class L2存在结构服务;

class L2存在所有者交付 final {
public:
    L2存在所有者交付() = delete;
    L2存在所有者交付(const L2存在所有者交付&) = delete;
    L2存在所有者交付& operator=(const L2存在所有者交付&) = delete;
    L2存在所有者交付(L2存在所有者交付&&) noexcept = default;
    L2存在所有者交付& operator=(L2存在所有者交付&&) = delete;

private:
    explicit L2存在所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}

    friend std::optional<L2存在所有者交付> 尝试形成L2存在所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2存在结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2存在所有者交付> 尝试形成L2存在所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept;

}

namespace 海中鱼巣::L2存在结构内部 {

inline constexpr std::uint32_t 存在节点本地键值 = 0x0202'0001U;
inline constexpr std::uint32_t 存在固定属性值本地键值 = 0x0202'0301U;
inline constexpr L1所有者范围写入幂等身份 存在身份来源登记幂等身份{
    0x4C32'4944'5352'4301ULL};
inline constexpr std::uint32_t 存在族锚点本地键值 = 0x0202'1001U;
inline constexpr std::uint32_t 存在族归属关系类型本地键值 = 0x0202'1002U;
inline constexpr std::uint32_t 存在族归属关系本地键值 = 0x0202'1003U;
inline constexpr std::uint32_t 存在单例角色登记锚点本地键值 = 0x0202'1301U;
inline constexpr std::uint32_t 存在单例角色关系类型本地键值 = 0x0202'1302U;
inline constexpr std::uint32_t 存在单例角色关系本地键值 = 0x0202'1303U;

struct 存在身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

bool 是保留来源登记幂等身份(L2结构幂等身份 身份) noexcept {
    return 身份.值 == 存在身份来源登记幂等身份.值
        || 身份 == L2存在单例角色登记固定幂等身份;
}

// 诊断责任：无适用错误分支；完整 64 位纯值映射不读取事实。
L1所有者范围写入幂等身份 映射存在幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2结构状态 映射存在写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::内部不一致;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部一致读取状态。
L2结构状态 映射存在一致读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部读取项目状态。
L2结构状态 映射存在当前项目状态(
    L1所有者范围一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部历史读取状态。
L2结构状态 映射存在历史读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

struct 存在节点与来源关系编码 final {
    稳定编码 节点;
    稳定编码 关系;
};

// 诊断责任：无适用错误分支；只核对节点与归属关系两项确定映射。
std::optional<存在节点与来源关系编码> 查找存在节点与来源关系编码映射(
    const L1所有者范围写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 2) return std::nullopt;
    存在节点与来源关系编码 映射;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (!有效(编码)) return std::nullopt;
        if (本地键.值 == 存在节点本地键值) 映射.节点 = 编码;
        else if (本地键.值 == 存在族归属关系本地键值) 映射.关系 = 编码;
        else return std::nullopt;
    }
    return 有效(映射.节点) && 有效(映射.关系) && 映射.节点 != 映射.关系
        ? std::optional<存在节点与来源关系编码>{映射} : std::nullopt;
}

// 诊断责任：无适用错误分支；只把完整 L1 普通节点映射为 E1 值式事实。
std::optional<L2存在事实> 形成E1存在事实(
    const L1所有者范围节点事实& 节点, L1结构所有者身份 所有者,
    std::uint64_t 事实截止代次) noexcept {
    if (!有效(节点.编码) || 节点.写入所有者 != 所有者
        || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 事实截止代次 || !节点.当前属性.empty()
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 事实截止代次))) {
        return std::nullopt;
    }
    L2存在事实 存在;
    存在.身份 = L2存在身份{节点.编码};
    存在.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    if (!L2存在E1事实完整(存在)) return std::nullopt;
    return 存在;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖事实代次探测失败。
L2结构状态 映射存在事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

struct 存在预检结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 直接提交 = false;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

// 诊断责任：无适用错误分支；历史属性值组状态只映射为 E2 结构状态。
L2结构状态 映射存在历史属性值组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::未找到:
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；四类 L2 材料无损映射到 L1 中性材料。
L1所有者范围原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1所有者范围独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；四类 L1 材料无损映射到 L2 类型化材料。
L2原始值材料 转换为L2材料(const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1所有者范围独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；把完整 L1 值事实投影到具名截止。
std::optional<L2属性事实> 形成截止属性事实(
    L1所有者范围值事实 值, L1结构所有者身份 所有者,
    std::uint64_t 截止) {
    if (值.写入所有者 != 所有者) return std::nullopt;
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

// 诊断责任：无适用错误分支；普通存在节点骨架允许有序非空当前属性槽。
std::optional<L2存在事实> 形成截止存在节点骨架(
    L1所有者范围节点事实 节点, L1结构所有者身份 所有者,
    std::uint64_t 截止) noexcept {
    if (节点.写入所有者 != 所有者) return std::nullopt;
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 截止))) return std::nullopt;
    for (std::size_t 索引 = 0; 索引 < 节点.当前属性.size(); ++索引) {
        const auto& 槽 = 节点.当前属性[索引];
        if (!有效(槽.属性类型节点) || !有效(槽.当前值)
            || (索引 != 0
                && !(节点.当前属性[索引 - 1].属性类型节点 < 槽.属性类型节点)))
            return std::nullopt;
        for (std::size_t 前索引 = 0; 前索引 < 索引; ++前索引)
            if (节点.当前属性[前索引].当前值 == 槽.当前值) return std::nullopt;
    }
    L2存在事实 存在;
    存在.身份 = L2存在身份{节点.编码};
    存在.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return 存在;
}

// 诊断责任：无适用错误分支；核对一致投影顶层成功或精确失败形状。
存在预检结果 解释存在一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取, std::uint64_t 期望代次) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次 && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.所有者.empty() && 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移, 读取.读取事实代次, true};
    return {映射存在一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；按查询编码查找唯一节点结果项。
const L1所有者范围一致节点读取结果项* 查找唯一存在节点项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：向上送出；当前代次失败或漂移均形成结构化预检结果。
存在预检结果 检查存在当前代次(
    const L1事实基座服务& 第一层服务, std::uint64_t 期望代次) {
    const auto 读取 = 第一层服务.读取中性当前事实代次({L1中性CRUD合同版本});
    if (读取.合同版本 != L1中性CRUD合同版本)
        return {L2结构状态::内部不一致, 读取.事实代次, false};
    if (读取.状态 != L1中性读取状态::成功)
        return {映射存在事实代次探测失败(读取.状态), 读取.事实代次, false};
    if (读取.事实代次 == 0)
        return {L2结构状态::内部不一致, 0, false};
    if (读取.事实代次 != 期望代次)
        return {L2结构状态::事实代次漂移, 读取.事实代次, true};
    return {L2结构状态::已读取, 读取.事实代次, false};
}

// 诊断责任：无适用错误分支；只形成身份来源读取的空载荷失败。
L2存在身份来源读取结果 形成存在身份来源读取失败(
    const L2存在身份来源读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt};
}

// 诊断责任：无适用错误分支；晚于截止的退出不进入具名历史投影。
L2生命周期 投影生命周期(
    std::uint64_t 创建事实代次, std::optional<std::uint64_t> 退出事实代次,
    std::uint64_t 截止) noexcept {
    if (退出事实代次 && *退出事实代次 > 截止) 退出事实代次.reset();
    return {创建事实代次, 退出事实代次};
}

// 诊断责任：无适用错误分支；按精确选择项查找唯一来源关系组。
const L1所有者范围一致源关系组读取结果项* 查找唯一存在来源关系组(
    const L1所有者范围一致当前读取结果& 读取,
    稳定编码 源节点, 稳定编码 关系类型) noexcept {
    const L1所有者范围一致源关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.源关系组) {
        if (项.源节点 != 源节点 || 项.关系类型节点 != 关系类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；一次 owner-aware 当前投影唯一裁决存在来源。
L2存在身份来源读取结果 解释当前存在身份来源投影(
    const L1所有者范围一致当前读取结果& 读取,
    const 存在身份来源定位& 定位,
    const L2存在身份来源读取请求& 请求) {
    const auto 顶层 = 解释存在一致读取顶层(
        读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 形成存在身份来源读取失败(
        请求, 顶层.状态, 顶层.事实截止代次);
    if (读取.所有者.size() != 1 || 读取.节点.size() != 3
        || !读取.关系.empty() || !读取.值.empty()
        || 读取.源关系组.size() != 1 || !读取.目标关系组.empty())
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);

    const auto& 所有者项 = 读取.所有者.front();
    const auto* 节点项 = 查找唯一存在节点项(读取, 请求.存在.值);
    const auto* 锚点项 = 查找唯一存在节点项(读取, 定位.族锚点);
    const auto* 类型项 = 查找唯一存在节点项(读取, 定位.族归属关系类型);
    const auto* 关系组项 = 查找唯一存在来源关系组(
        读取, 请求.存在.值, 定位.族归属关系类型);
    if (所有者项.查询所有者 != 定位.所有者 || !节点项 || !锚点项
        || !类型项 || !关系组项)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);

    if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (节点项->事实) return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
        const auto 状态 = 节点项->状态
            == L1所有者范围一致当前读取项目状态::种类不匹配
            ? L2结构状态::入口拒绝 : 映射存在当前项目状态(节点项->状态);
        return 形成存在身份来源读取失败(请求, 状态, 顶层.事实截止代次);
    }
    if (!节点项->事实)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
    const auto& 节点 = *节点项->事实;
    if (节点.写入所有者 != 定位.所有者 || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.退出事实代次)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::入口拒绝, 顶层.事实截止代次);

    if (所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实
        || 所有者项.所有者事实->所有者 != 定位.所有者
        || 所有者项.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者项.所有者事实->退出事实代次
        || 锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !锚点项->事实 || !类型项->事实)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    const auto 内部节点完整 = [&](const L1所有者范围节点事实& 内部节点) noexcept {
        return 内部节点.写入所有者 == 定位.所有者
            && 内部节点.种类 == 节点种类::普通
            && !内部节点.属性类型表示 && !内部节点.退出事实代次
            && 内部节点.当前属性.empty();
    };
    if (!内部节点完整(锚点) || !内部节点完整(类型)
        || 锚点.编码 != 定位.族锚点
        || 类型.编码 != 定位.族归属关系类型
        || 锚点.创建事实代次 != 定位.建立事实代次
        || 类型.创建事实代次 != 定位.建立事实代次
        || 关系组项->成员.size() > 1)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
    if (关系组项->成员.empty())
        return 形成存在身份来源读取失败(
            请求, L2结构状态::入口拒绝, 顶层.事实截止代次);

    const auto& 成员 = 关系组项->成员.front();
    const auto& 关系 = 成员.关系;
    if (成员.对端节点 != 锚点 || 关系.写入所有者 != 定位.所有者
        || 关系.源节点 != 请求.存在.值 || 关系.目标节点 != 定位.族锚点
        || 关系.关系类型节点 != 定位.族归属关系类型
        || 关系.角色或顺序 != 1 || 关系.退出事实代次
        || 节点.创建事实代次 != 关系.创建事实代次
        || 所有者项.所有者事实->创建事实代次 > 定位.建立事实代次
        || 定位.建立事实代次 > 节点.创建事实代次)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);

    L2节点族身份来源事实 来源{L2节点族::存在, 节点.编码,
        定位.所有者, 锚点.编码, 类型.编码, 关系.编码, 关系.角色或顺序,
        {所有者项.所有者事实->创建事实代次,
            所有者项.所有者事实->退出事实代次},
        {节点.创建事实代次, 节点.退出事实代次},
        {锚点.创建事实代次, 锚点.退出事实代次},
        {类型.创建事实代次, 类型.退出事实代次},
        {关系.创建事实代次, 关系.退出事实代次}};
    if (!L2节点族身份来源事实完整(来源, 顶层.事实截止代次))
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        顶层.事实截止代次, std::nullopt}, 请求.读取类别, 0,
        std::move(来源)};
}

// 诊断责任：向上送出；当前来源由一次一致投影裁决，非成功零载荷。
L2存在身份来源读取结果 读取当前存在身份来源(
    const L1事实基座服务& 第一层服务, const 存在身份来源定位& 定位,
    const L2存在身份来源读取请求& 请求) {
    if (请求.存在.值 == 定位.族锚点
        || 请求.存在.值 == 定位.族归属关系类型)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::入口拒绝, 请求.请求头.期望事实代次);
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.所有者 = {定位.所有者};
    L1请求.节点 = {请求.存在.值, 定位.族锚点, 定位.族归属关系类型};
    L1请求.源关系组 = {{请求.存在.值, 定位.族归属关系类型}};
    return 解释当前存在身份来源投影(
        第一层服务.尝试读取所有者范围一致当前投影(L1请求), 定位, 请求);
}

// 诊断责任：向上送出；历史 owner、节点、关系组和前后代次共同裁决来源。
L2存在身份来源读取结果 读取历史存在身份来源(
    const L1事实基座服务& 第一层服务, const 存在身份来源定位& 定位,
    const L2存在身份来源读取请求& 请求) {
    const auto 前代次 = 检查存在当前代次(
        第一层服务, 请求.请求头.期望事实代次);
    if (!前代次.成功()) return 形成存在身份来源读取失败(
        请求, 前代次.状态, 前代次.事实截止代次);
    if (请求.存在.值 == 定位.族锚点
        || 请求.存在.值 == 定位.族归属关系类型)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::入口拒绝, 请求.历史截止事实代次);

    const auto 所有者读取 = 第一层服务.读取历史结构所有者(
        {L1所有者范围CRUD合同版本, 定位.所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 定位.所有者
        || 所有者读取.读取事实代次 != 请求.请求头.期望事实代次
        || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 定位.所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围)
        return 形成存在身份来源读取失败(
            请求, 所有者读取.状态 == L1所有者范围读取状态::资源失败
                ? L2结构状态::资源失败 : L2结构状态::内部不一致,
            请求.历史截止事实代次);

    const auto 节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.存在.值});
    if (节点读取.合同版本 != L1所有者范围CRUD合同版本
        || 节点读取.查询编码 != 请求.存在.值
        || 节点读取.读取事实代次 != 请求.请求头.期望事实代次)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (节点读取.状态 != L1所有者范围读取状态::成功) {
        if (节点读取.事实) return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return 形成存在身份来源读取失败(请求,
            映射存在历史读取状态(节点读取.状态), 请求.历史截止事实代次);
    }
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
    if (!节点 || 节点->编码 != 请求.存在.值)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::入口拒绝, 请求.历史截止事实代次);
    if (节点->创建事实代次 > 请求.历史截止事实代次)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::未找到, 请求.历史截止事实代次);
    if (节点->写入所有者 != 定位.所有者 || 节点->种类 != 节点种类::普通
        || 节点->属性类型表示)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::入口拒绝, 请求.历史截止事实代次);
    if (节点->退出事实代次
        && *节点->退出事实代次 <= 节点->创建事实代次)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);

    const auto 锚点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 定位.族锚点});
    const auto 类型读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 定位.族归属关系类型});
    const auto* 锚点 = 锚点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
    const auto* 类型 = 类型读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
    const auto 内部节点读取完整 = [&](const auto& 读取,
        const L1所有者范围节点事实* 事实, 稳定编码 编码) noexcept {
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码
            && 读取.读取事实代次 == 请求.请求头.期望事实代次
            && 事实 && 事实->编码 == 编码 && 事实->写入所有者 == 定位.所有者
            && 事实->种类 == 节点种类::普通 && !事实->属性类型表示
            && 事实->当前属性.empty()
            && 事实->创建事实代次 == 定位.建立事实代次;
    };
    if (!内部节点读取完整(锚点读取, 锚点, 定位.族锚点)
        || !内部节点读取完整(
            类型读取, 类型, 定位.族归属关系类型))
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);

    const std::uint64_t 关系判定截止 = 节点->退出事实代次
            && *节点->退出事实代次 <= 请求.历史截止事实代次
        ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
    auto 读取关系组 = [&](std::uint64_t 截止) {
        return 第一层服务.读取所有者范围历史关系组(
            {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                请求.存在.值, 定位.族归属关系类型, 截止});
    };
    const auto 判定关系组 = 读取关系组(关系判定截止);
    const auto 关系组头完整 = [&](const auto& 读取, std::uint64_t 截止) noexcept {
        return 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.方向 == L1所有者范围关系端点方向::源
            && 读取.端点节点 == 请求.存在.值
            && 读取.关系类型节点 == 定位.族归属关系类型
            && 读取.历史截止事实代次 == 截止
            && 读取.读取事实代次 == 请求.请求头.期望事实代次;
    };
    if (!关系组头完整(判定关系组, 关系判定截止))
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (判定关系组.状态 != L1所有者范围读取状态::成功)
        return 形成存在身份来源读取失败(请求,
            映射存在历史读取状态(判定关系组.状态), 请求.历史截止事实代次);
    if (判定关系组.关系组.size() > 1)
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (判定关系组.关系组.empty()) {
        const auto 创建关系组 = 读取关系组(节点->创建事实代次);
        if (!关系组头完整(创建关系组, 节点->创建事实代次)
            || 创建关系组.状态 != L1所有者范围读取状态::成功
            || 创建关系组.关系组.size() > 1)
            return 形成存在身份来源读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return 形成存在身份来源读取失败(请求,
            创建关系组.关系组.empty() ? L2结构状态::入口拒绝
                : L2结构状态::内部不一致,
            请求.历史截止事实代次);
    }

    const auto& 关系候选 = 判定关系组.关系组.front();
    const auto 关系读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 关系候选.编码});
    const auto* 关系 = 关系读取.事实
        ? std::get_if<L1所有者范围关系事实>(&*关系读取.事实) : nullptr;
    if (关系读取.状态 != L1所有者范围读取状态::成功
        || 关系读取.合同版本 != L1所有者范围CRUD合同版本
        || 关系读取.查询编码 != 关系候选.编码
        || 关系读取.读取事实代次 != 请求.请求头.期望事实代次
        || !关系 || *关系 != 关系候选
        || 关系->写入所有者 != 定位.所有者
        || 关系->源节点 != 请求.存在.值 || 关系->目标节点 != 定位.族锚点
        || 关系->关系类型节点 != 定位.族归属关系类型
        || 关系->角色或顺序 != 1
        || 关系->创建事实代次 != 节点->创建事实代次
        || 关系->退出事实代次 != 节点->退出事实代次
        || 所有者读取.所有者事实->创建事实代次 > 定位.建立事实代次
        || 定位.建立事实代次 > 节点->创建事实代次
        || (所有者读取.所有者事实->退出事实代次
            && *所有者读取.所有者事实->退出事实代次
                < 节点->退出事实代次.value_or(节点->创建事实代次))
        || (锚点->退出事实代次
            && *锚点->退出事实代次
                < 节点->退出事实代次.value_or(节点->创建事实代次))
        || (类型->退出事实代次
            && *类型->退出事实代次
                < 节点->退出事实代次.value_or(节点->创建事实代次)))
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);

    const auto 后代次 = 检查存在当前代次(
        第一层服务, 请求.请求头.期望事实代次);
    if (!后代次.成功()) return 形成存在身份来源读取失败(
        请求, 后代次.状态, 后代次.事实截止代次);
    L2节点族身份来源事实 来源{L2节点族::存在, 节点->编码,
        定位.所有者, 锚点->编码, 类型->编码, 关系->编码, 关系->角色或顺序,
        投影生命周期(所有者读取.所有者事实->创建事实代次,
            所有者读取.所有者事实->退出事实代次,
            请求.历史截止事实代次),
        投影生命周期(节点->创建事实代次, 节点->退出事实代次,
            请求.历史截止事实代次),
        投影生命周期(锚点->创建事实代次, 锚点->退出事实代次,
            请求.历史截止事实代次),
        投影生命周期(类型->创建事实代次, 类型->退出事实代次,
            请求.历史截止事实代次),
        投影生命周期(关系->创建事实代次, 关系->退出事实代次,
            请求.历史截止事实代次)};
    if (!L2节点族身份来源事实完整(来源, 请求.历史截止事实代次))
        return 形成存在身份来源读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::move(来源)};
}

// 诊断责任：无适用错误分支；只形成完整存在读取的空载荷失败。
L2存在完整读取结果 形成完整存在读取失败(
    const L2存在完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt};
}

// 诊断责任：向上送出；两次同期一致投影形成完整当前存在。
L2存在完整读取结果 读取当前完整存在(
    const L1事实基座服务& 第一层服务, const 存在身份来源定位& 定位,
    const L2存在完整读取请求& 请求) {
    const auto 所有者 = 定位.所有者;
    L1所有者范围一致当前读取请求 首次请求;
    首次请求.合同版本 = L1所有者范围一致当前读取合同版本;
    首次请求.期望事实代次 = 请求.请求头.期望事实代次;
    首次请求.所有者 = {所有者};
    首次请求.节点 = {请求.存在.值, 定位.族锚点, 定位.族归属关系类型};
    首次请求.源关系组 = {{请求.存在.值, 定位.族归属关系类型}};
    const auto 首次读取 = 第一层服务.尝试读取所有者范围一致当前投影(首次请求);
    const L2存在身份来源读取请求 来源请求{请求.请求头,
        L2读取类别::当前, 请求.存在, 0};
    const auto 首次来源 = 解释当前存在身份来源投影(
        首次读取, 定位, 来源请求);
    if (!首次来源.成功()) return 形成完整存在读取失败(
        请求, 首次来源.结果头.状态, 首次来源.结果头.事实截止代次);
    if (首次读取.所有者.size() != 1 || 首次读取.节点.size() != 3
        || !首次读取.关系.empty()
        || !首次读取.值.empty() || !首次读取.属性值.empty()
        || 首次读取.源关系组.size() != 1 || !首次读取.目标关系组.empty())
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            首次来源.结果头.事实截止代次);
    const auto& 首次所有者项 = 首次读取.所有者.front();
    if (首次所有者项.查询所有者 != 所有者
        || 首次所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !首次所有者项.所有者事实
        || 首次所有者项.所有者事实->所有者 != 所有者
        || 首次所有者项.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
        || 首次所有者项.所有者事实->退出事实代次)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            首次来源.结果头.事实截止代次);
    const auto* 首次存在项 = 查找唯一存在节点项(首次读取, 请求.存在.值);
    if (!首次存在项) return 形成完整存在读取失败(
        请求, L2结构状态::内部不一致,
        首次来源.结果头.事实截止代次);
    if (首次存在项->状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (首次存在项->事实) return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            首次来源.结果头.事实截止代次);
        return 形成完整存在读取失败(请求,
            映射存在当前项目状态(首次存在项->状态),
            首次来源.结果头.事实截止代次);
    }
    if (!首次存在项->事实 || 首次存在项->事实->退出事实代次
        || !形成截止存在节点骨架(*首次存在项->事实, 所有者,
            请求.请求头.期望事实代次))
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            首次来源.结果头.事实截止代次);

    L1所有者范围一致当前读取请求 完整请求;
    完整请求.合同版本 = L1所有者范围一致当前读取合同版本;
    完整请求.期望事实代次 = 请求.请求头.期望事实代次;
    完整请求.所有者 = {所有者};
    完整请求.节点 = {请求.存在.值, 定位.族锚点, 定位.族归属关系类型};
    完整请求.源关系组 = {{请求.存在.值, 定位.族归属关系类型}};
    for (const auto& 槽 : 首次存在项->事实->当前属性)
        完整请求.属性值.push_back({请求.存在.值, 槽.属性类型节点});
    const auto 完整读取 = 第一层服务.尝试读取所有者范围一致当前投影(完整请求);
    const auto 完整来源 = 解释当前存在身份来源投影(
        完整读取, 定位, 来源请求);
    if (!完整来源.成功()) return 形成完整存在读取失败(
        请求, 完整来源.结果头.状态, 完整来源.结果头.事实截止代次);
    if (!首次来源.身份来源 || !完整来源.身份来源
        || *首次来源.身份来源 != *完整来源.身份来源
        || 完整读取.所有者.size() != 1 || 完整读取.节点.size() != 3
        || !完整读取.关系.empty()
        || !完整读取.值.empty()
        || 完整读取.属性值.size() != 完整请求.属性值.size()
        || 完整读取.源关系组.size() != 1 || !完整读取.目标关系组.empty())
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            完整来源.结果头.事实截止代次);
    const auto& 完整所有者项 = 完整读取.所有者.front();
    const auto* 完整存在项 = 查找唯一存在节点项(完整读取, 请求.存在.值);
    if (完整所有者项 != 首次所有者项 || !完整存在项
        || 完整存在项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !完整存在项->事实 || 完整存在项->事实->退出事实代次
        || 完整存在项->事实->当前属性 != 首次存在项->事实->当前属性)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            完整来源.结果头.事实截止代次);
    auto 存在 = 形成截止存在节点骨架(
        *完整存在项->事实, 所有者, 请求.请求头.期望事实代次);
    if (!存在 || 存在->身份 != 请求.存在)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            完整来源.结果头.事实截止代次);
    for (const auto& 槽 : 完整存在项->事实->当前属性) {
        const L1所有者范围一致属性值读取结果项* 找到 = nullptr;
        for (const auto& 项 : 完整读取.属性值) {
            if (项.节点 != 请求.存在.值 || 项.属性类型 != 槽.属性类型节点) continue;
            if (找到) return 形成完整存在读取失败(
                请求, L2结构状态::内部不一致,
                完整来源.结果头.事实截止代次);
            找到 = &项;
        }
        if (!找到 || 找到->状态 != L1所有者范围一致当前读取项目状态::成功
            || !找到->投影 || 找到->投影->属性槽 != 槽
            || 找到->投影->当前值事实.编码 != 槽.当前值
            || 找到->投影->当前值事实.所属节点 != 请求.存在.值
            || 找到->投影->当前值事实.属性类型节点 != 槽.属性类型节点
            || 找到->投影->当前值事实.写入所有者 != 所有者
            || 找到->投影->当前值事实.退出事实代次)
            return 形成完整存在读取失败(
                请求, L2结构状态::内部不一致,
                完整来源.结果头.事实截止代次);
        auto 属性 = 形成截止属性事实(
            找到->投影->当前值事实, 所有者, 请求.请求头.期望事实代次);
        if (!属性 || 属性->退出事实代次)
            return 形成完整存在读取失败(
                请求, L2结构状态::内部不一致,
                完整来源.结果头.事实截止代次);
        存在->固定属性.push_back(std::move(*属性));
    }
    std::sort(存在->固定属性.begin(), 存在->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    if (!L2存在事实完整(*存在, 请求.请求头.期望事实代次))
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致,
            完整来源.结果头.事实截止代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.请求头.期望事实代次, std::nullopt}, 请求.读取类别, 0,
        std::move(存在)};
}

// 诊断责任：向上送出；历史节点、属性组和前后代次矛盾均返回零部分存在。
L2存在完整读取结果 读取历史完整存在(
    const L1事实基座服务& 第一层服务, const 存在身份来源定位& 定位,
    const L2存在完整读取请求& 请求) {
    const auto 所有者 = 定位.所有者;
    const L2存在身份来源读取请求 来源请求{请求.请求头,
        L2读取类别::历史, 请求.存在, 请求.历史截止事实代次};
    const auto 来源 = 读取历史存在身份来源(第一层服务, 定位, 来源请求);
    if (!来源.成功()) return 形成完整存在读取失败(
        请求, 来源.结果头.状态, 来源.结果头.事实截止代次);
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || !所有者读取.所有者事实
        || 所有者读取.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->退出事实代次)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    const auto 历史 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.存在.值});
    if (历史.合同版本 != L1所有者范围CRUD合同版本
        || 历史.查询编码 != 请求.存在.值)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (历史.状态 != L1所有者范围读取状态::成功) {
        if (历史.事实) return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return 形成完整存在读取失败(
            请求, 映射存在历史读取状态(历史.状态), 请求.历史截止事实代次);
    }
    const auto* 节点 = 历史.事实
        ? std::get_if<L1所有者范围节点事实>(&*历史.事实) : nullptr;
    if (!节点 || 节点->编码 != 请求.存在.值 || 节点->写入所有者 != 所有者)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (节点->创建事实代次 > 请求.历史截止事实代次)
        return 形成完整存在读取失败(
            请求, L2结构状态::未找到, 请求.历史截止事实代次);
    auto 存在 = 形成截止存在节点骨架(*节点, 所有者,
        请求.历史截止事实代次);
    if (!存在 || 存在->身份 != 请求.存在)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    const auto 属性组 = 第一层服务.读取所有者范围历史属性值组(
        {L1所有者范围CRUD合同版本, 请求.存在.值, 请求.历史截止事实代次});
    if (属性组.合同版本 != L1所有者范围CRUD合同版本
        || 属性组.所属节点 != 请求.存在.值
        || 属性组.历史截止事实代次 != 请求.历史截止事实代次)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 属性组.读取事实代次);
    if (属性组.状态 != L1所有者范围读取状态::成功) {
        if (!属性组.属性值组.empty()) return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 属性组.读取事实代次);
        return 形成完整存在读取失败(请求,
            映射存在历史属性值组失败状态(属性组.状态), 属性组.读取事实代次);
    }
    if (属性组.读取事实代次 != 请求.请求头.期望事实代次)
        return 形成完整存在读取失败(
            请求, L2结构状态::事实代次漂移, 属性组.读取事实代次);
    std::vector<稳定编码> 属性类型组;
    for (const auto& 原属性 : 属性组.属性值组) {
        if (原属性.所属节点 != 请求.存在.值 || 原属性.写入所有者 != 所有者
            || 原属性.创建事实代次 == 0
            || 原属性.创建事实代次 > 请求.历史截止事实代次
            || (原属性.退出事实代次
                && *原属性.退出事实代次 <= 请求.历史截止事实代次)
            || std::find(属性类型组.begin(), 属性类型组.end(),
                原属性.属性类型节点) != 属性类型组.end())
            return 形成完整存在读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        auto 属性 = 形成截止属性事实(原属性, 所有者,
            请求.历史截止事实代次);
        if (!属性 || 属性->退出事实代次)
            return 形成完整存在读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        属性类型组.push_back(原属性.属性类型节点);
        存在->固定属性.push_back(std::move(*属性));
    }
    const auto 后代次 = 检查存在当前代次(第一层服务, 请求.请求头.期望事实代次);
    if (!后代次.成功()) return 形成完整存在读取失败(请求,
        后代次.直接提交 ? L2结构状态::事实代次漂移 : 后代次.状态,
        后代次.事实截止代次);
    std::sort(存在->固定属性.begin(), 存在->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    if (!L2存在事实完整(*存在, 请求.历史截止事实代次))
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (!来源.身份来源
        || 存在->身份.值 != 来源.身份来源->节点稳定编码
        || 存在->生命周期 != 来源.身份来源->节点生命周期)
        return 形成完整存在读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::move(存在)};
}

// 诊断责任：无适用错误分支；只形成固定属性写入空载荷失败。
L2存在固定属性写入结果 形成存在固定属性写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：向上送出；同期存在节点与具名属性槽前置均结构化返回。
存在预检结果 检查存在固定属性前置(
    const L1事实基座服务& 第一层服务, const 存在身份来源定位& 定位,
    L2存在身份 存在, 稳定编码 属性类型,
    std::optional<稳定编码> 期望旧值, std::uint64_t 截止) {
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 截止;
    请求.所有者 = {定位.所有者};
    请求.节点 = {存在.值, 定位.族锚点, 定位.族归属关系类型};
    请求.属性值 = {{存在.值, 属性类型}};
    请求.源关系组 = {{存在.值, 定位.族归属关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    const L2存在身份来源读取请求 来源请求{{L2结构合同版本, 截止},
        L2读取类别::当前, 存在, 0};
    const auto 来源 = 解释当前存在身份来源投影(读取, 定位, 来源请求);
    if (!来源.成功()) return {来源.结果头.状态,
        来源.结果头.事实截止代次, false};
    if (读取.所有者.size() != 1 || 读取.节点.size() != 3
        || 读取.属性值.size() != 1
        || !读取.关系.empty() || !读取.值.empty()
        || 读取.源关系组.size() != 1 || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 来源.结果头.事实截止代次, false};
    const auto& 属性项 = 读取.属性值.front();
    if (属性项.节点 != 存在.值 || 属性项.属性类型 != 属性类型)
        return {L2结构状态::内部不一致, 来源.结果头.事实截止代次, false};
    if (属性项.状态 == L1所有者范围一致当前读取项目状态::属性未设置) {
        if (属性项.投影)
            return {L2结构状态::内部不一致,
                来源.结果头.事实截止代次, false};
        return 期望旧值
            ? 存在预检结果{L2结构状态::属性未设置,
                来源.结果头.事实截止代次, false}
            : 存在预检结果{L2结构状态::已读取,
                来源.结果头.事实截止代次, false};
    }
    if (属性项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !属性项.投影 || 属性项.投影->属性槽.属性类型节点 != 属性类型
        || 属性项.投影->属性槽.当前值 != 属性项.投影->当前值事实.编码
        || 属性项.投影->当前值事实.所属节点 != 存在.值
        || 属性项.投影->当前值事实.属性类型节点 != 属性类型
        || 属性项.投影->当前值事实.写入所有者 != 定位.所有者
        || 属性项.投影->当前值事实.退出事实代次
        || !形成截止属性事实(
            属性项.投影->当前值事实, 定位.所有者, 截止))
        return {L2结构状态::内部不一致,
            来源.结果头.事实截止代次, false};
    if (!期望旧值 || 属性项.投影->当前值事实.编码 != *期望旧值)
        return {L2结构状态::引用冲突,
            来源.结果头.事实截止代次, false};
    return {L2结构状态::已读取, 来源.结果头.事实截止代次, false};
}

// 诊断责任：无适用错误分支；只核对新值本地键唯一映射。
std::optional<稳定编码> 查找唯一存在固定属性编码映射(
    const L1所有者范围写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    return 本地键.值 == 存在固定属性值本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

// 诊断责任：向上送出；属性写集提交、首次映射和历史读回矛盾均结构化返回。
L2存在固定属性写入结果 提交并读回存在固定属性写集(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 第一层写入端口,
    const L1所有者范围写集请求& 写集,
    L2存在身份 存在, const L2属性提交项& 新属性,
    std::optional<稳定编码> 旧值编码) {
    const auto 所有者 = 第一层写入端口.所有者身份();
    const auto 写入 = 第一层写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成存在固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射存在写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成存在固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成存在固定属性写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    const auto 新值编码 = 查找唯一存在固定属性编码映射(写入);
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !新值编码)
        return 形成存在固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 属性组 = 第一层服务.读取所有者范围历史属性值组(
        {L1所有者范围CRUD合同版本, 存在.值, 写入.事实代次});
    if (属性组.状态 != L1所有者范围读取状态::成功
        || 属性组.合同版本 != L1所有者范围CRUD合同版本
        || 属性组.所属节点 != 存在.值
        || 属性组.历史截止事实代次 != 写入.事实代次
        || 属性组.读取事实代次 < 写入.事实代次)
        return 形成存在固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const L1所有者范围值事实* 新值 = nullptr;
    for (const auto& 值 : 属性组.属性值组) {
        if (值.编码 != *新值编码) continue;
        if (新值) return 形成存在固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新值 = &值;
    }
    if (!新值 || 新值->写入所有者 != 所有者 || 新值->所属节点 != 存在.值
        || 新值->属性类型节点 != 新属性.属性类型身份
        || 新值->来源节点 != 新属性.来源稳定编码
        || 转换为L2材料(新值->材料) != 新属性.原始值材料
        || 新值->创建事实代次 != 写入.事实代次 || 新值->退出事实代次)
        return 形成存在固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    auto 当前属性 = 形成截止属性事实(*新值, 所有者, 写入.事实代次);
    if (!当前属性 || 当前属性->退出事实代次)
        return 形成存在固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    L2存在固定属性写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(当前属性), std::nullopt};
    if (旧值编码) {
        const auto 旧读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, *旧值编码});
        const auto* 旧值 = 旧读取.事实
            ? std::get_if<L1所有者范围值事实>(&*旧读取.事实) : nullptr;
        if (旧读取.状态 != L1所有者范围读取状态::成功
            || 旧读取.合同版本 != L1所有者范围CRUD合同版本
            || 旧读取.查询编码 != *旧值编码 || !旧值
            || 旧值->编码 != *旧值编码 || 旧值->写入所有者 != 所有者
            || 旧值->所属节点 != 存在.值
            || 旧值->属性类型节点 != 新属性.属性类型身份
            || 旧值->退出事实代次 != 写入.事实代次)
            return 形成存在固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        结果.已退出属性 = 形成截止属性事实(*旧值, 所有者, 写入.事实代次);
        if (!结果.已退出属性
            || 结果.已退出属性->退出事实代次 != 写入.事实代次)
            return 形成存在固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成存在固定属性写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：无适用错误分支；只形成单例角色登记空载荷失败。
L2存在单例角色结构登记结果 形成存在单例角色登记失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成单例角色读取空载荷失败。
L2存在单例角色读取结果 形成存在单例角色读取失败(
    const L2存在单例角色读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成单例角色写入空载荷失败。
L2存在单例角色写入结果 形成存在单例角色写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成角色化存在写入空载荷失败。
L2角色化存在写入结果 形成角色化存在写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；把具名 L1 关系投影为单例角色事实。
std::optional<L2存在单例角色事实> 形成截止存在单例角色事实(
    const L1所有者范围关系事实& 关系, L1结构所有者身份 所有者,
    const L2存在单例角色结构登记& 登记, std::uint64_t 截止) noexcept {
    if (关系.写入所有者 != 所有者 || !有效(关系.编码)
        || 关系.源节点 != 登记.角色登记锚点稳定编码
        || 关系.关系类型节点 != 登记.角色关系类型.值
        || !有效(关系.目标节点) || 关系.角色或顺序 <= 0
        || 关系.创建事实代次 == 0 || 关系.创建事实代次 > 截止
        || (关系.退出事实代次
            && *关系.退出事实代次 < 关系.创建事实代次)) return std::nullopt;
    auto 退出 = 关系.退出事实代次;
    if (退出 && *退出 > 截止) 退出.reset();
    L2存在单例角色事实 事实{{关系.角色或顺序},
        L2存在身份{关系.目标节点}, 关系.编码,
        {关系.创建事实代次, 退出}};
    return L2存在单例角色事实完整(事实, 截止)
        ? std::optional<L2存在单例角色事实>{std::move(事实)} : std::nullopt;
}

// 诊断责任：向上送出；当前角色组、目标来源与同截止唯一性共同裁决读取。
L2存在单例角色读取结果 读取当前存在单例角色(
    const L1事实基座服务& 第一层服务, const 存在身份来源定位& 来源定位,
    const L2存在单例角色结构登记& 登记,
    const L2存在单例角色读取请求& 请求) {
    L1所有者范围一致当前读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.节点 = {登记.角色登记锚点稳定编码, 登记.角色关系类型.值};
    L1请求.源关系组 = {{登记.角色登记锚点稳定编码,
        登记.角色关系类型.值}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(L1请求);
    const auto 顶层 = 解释存在一致读取顶层(
        读取, 请求.请求头.期望事实代次);
    if (!顶层.成功()) return 形成存在单例角色读取失败(
        请求, 顶层.状态, 顶层.事实截止代次);
    if (读取.所有者.size() != 1 || 读取.节点.size() != 2
        || !读取.关系.empty() || !读取.值.empty() || !读取.属性值.empty()
        || 读取.源关系组.size() != 1 || !读取.目标关系组.empty())
        return 形成存在单例角色读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
    const auto& 所有者项 = 读取.所有者.front();
    const auto* 锚点项 = 查找唯一存在节点项(
        读取, 登记.角色登记锚点稳定编码);
    const auto* 类型项 = 查找唯一存在节点项(读取, 登记.角色关系类型.值);
    const auto& 组 = 读取.源关系组.front();
    if (所有者项.查询所有者 != 来源定位.所有者
        || 所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实
        || 所有者项.所有者事实->所有者 != 来源定位.所有者
        || 所有者项.所有者事实->退出事实代次 || !锚点项 || !类型项
        || 锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !锚点项->事实 || !类型项->事实
        || 锚点项->事实->编码 != 登记.角色登记锚点稳定编码
        || 类型项->事实->编码 != 登记.角色关系类型.值
        || 锚点项->事实->写入所有者 != 来源定位.所有者
        || 类型项->事实->写入所有者 != 来源定位.所有者
        || 锚点项->事实->种类 != 节点种类::普通
        || 类型项->事实->种类 != 节点种类::普通
        || 锚点项->事实->属性类型表示 || 类型项->事实->属性类型表示
        || 锚点项->事实->退出事实代次 || 类型项->事实->退出事实代次
        || 组.源节点 != 登记.角色登记锚点稳定编码
        || 组.关系类型节点 != 登记.角色关系类型.值)
        return 形成存在单例角色读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);

    std::optional<L2存在单例角色事实> 找到;
    for (const auto& 成员 : 组.成员) {
        const auto& 关系 = 成员.关系;
        if (成员.对端节点.编码 != 关系.目标节点
            || 成员.对端节点.写入所有者 != 来源定位.所有者
            || 成员.对端节点.种类 != 节点种类::普通
            || 成员.对端节点.属性类型表示 || 成员.对端节点.退出事实代次
            || 关系.退出事实代次) return 形成存在单例角色读取失败(
                请求, L2结构状态::内部不一致, 顶层.事实截止代次);
        auto 事实 = 形成截止存在单例角色事实(
            关系, 来源定位.所有者, 登记, 顶层.事实截止代次);
        if (!事实) return 形成存在单例角色读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
        if (事实->角色 != 请求.角色) continue;
        if (找到) return 形成存在单例角色读取失败(
            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
        找到 = std::move(事实);
    }
    if (!找到) return 形成存在单例角色读取失败(
        请求, L2结构状态::未找到, 顶层.事实截止代次);
    const L2存在身份来源读取请求 来源请求{请求.请求头,
        L2读取类别::当前, 找到->存在, 0};
    const auto 来源 = 读取当前存在身份来源(第一层服务, 来源定位, 来源请求);
    if (!来源.成功() || !来源.身份来源)
        return 形成存在单例角色读取失败(
            请求, 来源.结果头.状态, 来源.结果头.事实截止代次);
    L2存在单例角色读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
        顶层.事实截止代次, std::nullopt}, 请求.读取类别, 0,
        std::move(找到), 来源.身份来源};
    return 结果.成功() ? 结果 : 形成存在单例角色读取失败(
        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
}

// 诊断责任：向上送出；具名历史截止的唯一角色关系与存在来源共同裁决读取。
L2存在单例角色读取结果 读取历史存在单例角色(
    const L1事实基座服务& 第一层服务, const 存在身份来源定位& 来源定位,
    const L2存在单例角色结构登记& 登记,
    const L2存在单例角色读取请求& 请求) {
    const auto 前代次 = 检查存在当前代次(
        第一层服务, 请求.请求头.期望事实代次);
    if (!前代次.成功()) return 形成存在单例角色读取失败(
        请求, 前代次.状态, 前代次.事实截止代次);
    const auto 组 = 第一层服务.读取所有者范围历史关系组({
        L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
        登记.角色登记锚点稳定编码, 登记.角色关系类型.值,
        请求.历史截止事实代次});
    if (组.合同版本 != L1所有者范围CRUD合同版本
        || 组.方向 != L1所有者范围关系端点方向::源
        || 组.端点节点 != 登记.角色登记锚点稳定编码
        || 组.关系类型节点 != 登记.角色关系类型.值
        || 组.历史截止事实代次 != 请求.历史截止事实代次
        || 组.读取事实代次 != 请求.请求头.期望事实代次)
        return 形成存在单例角色读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (组.状态 != L1所有者范围读取状态::成功)
        return 形成存在单例角色读取失败(请求,
            映射存在历史读取状态(组.状态), 请求.历史截止事实代次);
    std::optional<L2存在单例角色事实> 找到;
    for (const auto& 关系 : 组.关系组) {
        auto 事实 = 形成截止存在单例角色事实(
            关系, 来源定位.所有者, 登记, 请求.历史截止事实代次);
        if (!事实 || 事实->生命周期.退出事实代次)
            return 形成存在单例角色读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (事实->角色 != 请求.角色) continue;
        if (找到) return 形成存在单例角色读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        找到 = std::move(事实);
    }
    if (!找到) return 形成存在单例角色读取失败(
        请求, L2结构状态::未找到, 请求.历史截止事实代次);
    const L2存在身份来源读取请求 来源请求{请求.请求头,
        L2读取类别::历史, 找到->存在, 请求.历史截止事实代次};
    const auto 来源 = 读取历史存在身份来源(第一层服务, 来源定位, 来源请求);
    if (!来源.成功() || !来源.身份来源)
        return 形成存在单例角色读取失败(
            请求, 来源.结果头.状态, 来源.结果头.事实截止代次);
    const auto 后代次 = 检查存在当前代次(
        第一层服务, 请求.请求头.期望事实代次);
    if (!后代次.成功()) return 形成存在单例角色读取失败(
        请求, 后代次.状态, 后代次.事实截止代次);
    L2存在单例角色读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
        请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::move(找到), 来源.身份来源};
    return 结果.成功() ? 结果 : 形成存在单例角色读取失败(
        请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
}

struct 存在单例角色关系读回规格 final {
    稳定编码 关系;
    L2存在单例角色键 角色;
    L2存在身份 存在;
};

// 诊断责任：无适用错误分支；只核对单一关系本地键映射。
std::optional<稳定编码> 查找唯一存在单例角色关系编码映射(
    const L1所有者范围写入结果& 写入) noexcept {
    if (写入.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 写入.新编码映射.front();
    return 本地键.值 == 存在单例角色关系本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

// 诊断责任：向上送出；关系提交、首次映射和新旧历史读回矛盾均结构化返回。
L2存在单例角色写入结果 提交并读回存在单例角色写集(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    const L2存在单例角色结构登记& 登记,
    std::optional<存在单例角色关系读回规格> 新关系,
    std::optional<存在单例角色关系读回规格> 旧关系) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 写入端口.所有者身份()
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成存在单例角色写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射存在写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成存在单例角色写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成存在单例角色写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整))
        return 形成存在单例角色写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    if (新关系) {
        const auto 编码 = 查找唯一存在单例角色关系编码映射(写入);
        if (!编码) return 形成存在单例角色写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新关系->关系 = *编码;
    } else if (!写入.新编码映射.empty()) {
        return 形成存在单例角色写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    const auto 读取一项 = [&](const 存在单例角色关系读回规格& 规格,
        bool 应已退出) -> std::optional<L2存在单例角色事实> {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 规格.关系});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 规格.关系 || !关系
            || 关系->编码 != 规格.关系) return std::nullopt;
        auto 事实 = 形成截止存在单例角色事实(
            *关系, 写入端口.所有者身份(), 登记, 写入.事实代次);
        if (!事实 || 事实->角色 != 规格.角色 || 事实->存在 != 规格.存在)
            return std::nullopt;
        if (应已退出) {
            if (事实->生命周期.退出事实代次 != 写入.事实代次)
                return std::nullopt;
        } else if (事实->生命周期.创建事实代次 != 写入.事实代次
            || 事实->生命周期.退出事实代次) return std::nullopt;
        return 事实;
    };
    L2存在单例角色写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::nullopt, std::nullopt};
    if (新关系) {
        结果.当前角色关系 = 读取一项(*新关系, false);
        if (!结果.当前角色关系) return 形成存在单例角色写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    if (旧关系) {
        结果.已退出角色关系 = 读取一项(*旧关系, true);
        if (!结果.已退出角色关系) return 形成存在单例角色写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成存在单例角色写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；三项原子创建必须取得唯一映射并按首次截止完整读回。
L2角色化存在写入结果 提交并读回角色化存在写集(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集, const 存在身份来源定位& 来源定位,
    const L2存在单例角色结构登记& 登记, L2存在单例角色键 角色) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 写入端口.所有者身份()
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射存在写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成角色化存在写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成角色化存在写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 3)
        return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    稳定编码 存在编码;
    稳定编码 归属关系编码;
    稳定编码 角色关系编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        if (本地键.值 == 存在节点本地键值) 存在编码 = 编码;
        else if (本地键.值 == 存在族归属关系本地键值) 归属关系编码 = 编码;
        else if (本地键.值 == 存在单例角色关系本地键值) 角色关系编码 = 编码;
        else return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }
    if (!有效(存在编码) || !有效(归属关系编码) || !有效(角色关系编码)
        || 存在编码 == 归属关系编码 || 存在编码 == 角色关系编码
        || 归属关系编码 == 角色关系编码)
        return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 存在编码});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
    auto 存在 = 节点 ? 形成E1存在事实(
        *节点, 写入端口.所有者身份(), 写入.事实代次) : std::nullopt;
    if (节点读取.状态 != L1所有者范围读取状态::成功 || !存在)
        return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 当前代次 = 第一层服务.读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (当前代次.状态 != L1中性读取状态::成功
        || 当前代次.事实代次 < 写入.事实代次)
        return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const L2存在身份来源读取请求 来源请求{{L2结构合同版本,
        当前代次.事实代次}, L2读取类别::历史, 存在->身份, 写入.事实代次};
    const auto 来源 = 读取历史存在身份来源(
        第一层服务, 来源定位, 来源请求);
    if (!来源.成功() || !来源.身份来源
        || 来源.身份来源->族归属关系稳定编码 != 归属关系编码)
        return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 关系读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 角色关系编码});
    const auto* 关系 = 关系读取.事实
        ? std::get_if<L1所有者范围关系事实>(&*关系读取.事实) : nullptr;
    auto 角色事实 = 关系 ? 形成截止存在单例角色事实(
        *关系, 写入端口.所有者身份(), 登记, 写入.事实代次) : std::nullopt;
    if (关系读取.状态 != L1所有者范围读取状态::成功 || !角色事实
        || 角色事实->角色 != 角色 || 角色事实->存在 != 存在->身份
        || 角色事实->生命周期.创建事实代次 != 写入.事实代次
        || 角色事实->生命周期.退出事实代次)
        return 形成角色化存在写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    L2角色化存在写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(存在),
        来源.身份来源, std::move(角色事实)};
    return 结果.成功() ? 结果 : 形成角色化存在写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：无适用错误分支；只形成存在退出空载荷失败。
L2存在退出结果 形成存在退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

// 诊断责任：向上送出；存在退出提交与显式节点、属性历史读回矛盾均结构化返回。
L2存在退出结果 提交并读回存在退出写集(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 第一层写入端口,
    const L1所有者范围写集请求& 写集,
    const 存在身份来源定位& 定位, const L2存在退出请求& 请求) {
    const auto 所有者 = 第一层写入端口.所有者身份();
    const auto 写入 = 第一层写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射存在写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成存在退出失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || !写入.新编码映射.empty())
        return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.存在.值});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
    if (节点读取.状态 != L1所有者范围读取状态::成功
        || 节点读取.合同版本 != L1所有者范围CRUD合同版本
        || 节点读取.查询编码 != 请求.存在.值 || !节点
        || 节点->编码 != 请求.存在.值 || 节点->写入所有者 != 所有者
        || 节点->退出事实代次 != 写入.事实代次)
        return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
    auto 存在 = 形成截止存在节点骨架(*节点, 所有者, 写入.事实代次);
    if (!存在 || 存在->身份 != 请求.存在
        || 存在->生命周期.退出事实代次 != 写入.事实代次)
        return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 关系读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.族归属关系稳定编码});
    const auto* 关系 = 关系读取.事实
        ? std::get_if<L1所有者范围关系事实>(&*关系读取.事实) : nullptr;
    if (关系读取.状态 != L1所有者范围读取状态::成功
        || 关系读取.合同版本 != L1所有者范围CRUD合同版本
        || 关系读取.查询编码 != 请求.族归属关系稳定编码 || !关系
        || 关系->编码 != 请求.族归属关系稳定编码
        || 关系->写入所有者 != 所有者
        || 关系->源节点 != 请求.存在.值 || 关系->目标节点 != 定位.族锚点
        || 关系->关系类型节点 != 定位.族归属关系类型
        || 关系->角色或顺序 != 1
        || 关系->创建事实代次 != 节点->创建事实代次
        || 关系->退出事实代次 != 写入.事实代次)
        return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
    for (const auto 编码 : 请求.当前固定属性值) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 值 = 读取.事实
            ? std::get_if<L1所有者范围值事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 编码
            || !值 || 值->编码 != 编码 || 值->写入所有者 != 所有者
            || 值->所属节点 != 请求.存在.值
            || 值->退出事实代次 != 写入.事实代次)
            return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
        auto 属性 = 形成截止属性事实(*值, 所有者, 写入.事实代次);
        if (!属性 || 属性->退出事实代次 != 写入.事实代次)
            return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
        存在->固定属性.push_back(std::move(*属性));
    }
    if (节点->当前属性.size() != 存在->固定属性.size())
        return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
    for (const auto& 槽 : 节点->当前属性) {
        const auto 找到 = std::find_if(存在->固定属性.begin(), 存在->固定属性.end(),
            [&](const auto& 属性) noexcept {
                return 属性.属性类型身份 == 槽.属性类型节点
                    && 属性.值稳定编码 == 槽.当前值;
            });
        if (找到 == 存在->固定属性.end())
            return 形成存在退出失败(L2结构状态::内部不一致, 写入.事实代次);
    }
    std::sort(存在->固定属性.begin(), 存在->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    L2存在退出结果 结果{{L2结构合同版本, 状态, 写入.事实代次,
        写入.事实代次}, std::move(存在)};
    return 结果.成功() ? 结果 : 形成存在退出失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；来源登记任何结构化非成功都使服务构造失败。
存在身份来源定位 初始化存在身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 existence owner fact is invalid");

    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读取.所有者事实->创建事实代次;
    写集.写入幂等身份 = 存在身份来源登记幂等身份;
    写集.节点 = {
        {{存在族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{存在族归属关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 存在身份来源登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 2)
        throw std::runtime_error("L2 existence identity source initialization failed");

    稳定编码 锚点编码;
    稳定编码 类型编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码))
            throw std::runtime_error("L2 existence identity source mapping is invalid");
        if (本地键.值 == 存在族锚点本地键值) 锚点编码 = 编码;
        else if (本地键.值 == 存在族归属关系类型本地键值) 类型编码 = 编码;
        else throw std::runtime_error("L2 existence identity source mapping is unknown");
    }
    if (!有效(锚点编码) || !有效(类型编码) || 锚点编码 == 类型编码)
        throw std::runtime_error("L2 existence identity source mapping is incomplete");

    const auto 锚点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 锚点编码});
    const auto 类型读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 类型编码});
    const auto* 锚点 = 锚点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
    const auto* 类型 = 类型读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
    const auto 节点完整 = [&](const auto& 读取,
        const L1所有者范围节点事实* 节点, 稳定编码 编码) noexcept {
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者 && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次
            && !节点->退出事实代次;
    };
    if (!节点完整(锚点读取, 锚点, 锚点编码)
        || !节点完整(类型读取, 类型, 类型编码))
        throw std::runtime_error("L2 existence identity source readback is invalid");
    return {所有者, 锚点编码, 类型编码, 写入.事实代次};
}

} // namespace 海中鱼巣::L2存在结构内部

export namespace 海中鱼巣 {

std::optional<L2存在所有者交付> 尝试形成L2存在所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 存在所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份()
                != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务))
            return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2存在所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class L2存在结构服务 final {
public:
    explicit L2存在结构服务(
        const L1事实基座服务& 第一层读取服务,
        L2存在所有者交付&& 存在所有者交付)
        : 第一层读取服务_(第一层读取服务),
          第一层写入端口_(验证并移动交付(
              第一层读取服务, 存在所有者交付)),
          存在身份来源定位_(L2存在结构内部::初始化存在身份来源(
              第一层读取服务_, 第一层写入端口_)) {
        const auto 代次 = 第一层读取服务_.读取中性当前事实代次(
            {L1中性CRUD合同版本});
        if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
            throw std::runtime_error("L2 existence singleton role registry generation unavailable");
        const auto 登记 = 建立存在单例角色结构登记({
            {L2结构合同版本, 代次.事实代次},
            L2存在单例角色登记规则版本,
            L2存在单例角色登记固定幂等身份});
        if (!登记.成功())
            throw std::runtime_error("L2 existence singleton role registry initialization failed");
    }
    L2存在结构服务(const L2存在结构服务&) = delete;
    L2存在结构服务& operator=(const L2存在结构服务&) = delete;

    // 诊断责任：向上送出；固定登记提交、精确重复与正式读回矛盾均结构化返回。
    L2存在单例角色结构登记结果 建立存在单例角色结构登记(
        const L2存在单例角色结构登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(单例角色结构登记锁_);
            if (!L2存在单例角色结构登记请求有效(请求))
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::入口拒绝);
            if (单例角色结构登记定位_) {
                if (!L2存在单例角色结构登记完整(*单例角色结构登记定位_))
                    return L2存在结构内部::形成存在单例角色登记失败(
                        L2结构状态::内部不一致);
                if (单例角色结构登记定位_->合同版本 != 请求.请求头.合同版本
                    || 单例角色结构登记定位_->规则版本 != 请求.规则版本
                    || 单例角色结构登记定位_->首次幂等身份 != 请求.幂等身份
                    || 单例角色结构登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2存在结构内部::形成存在单例角色登记失败(
                        L2结构状态::幂等冲突,
                        单例角色结构登记定位_->事实截止代次);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.节点 = {
                {{L2存在结构内部::存在单例角色登记锚点本地键值},
                    节点种类::普通, std::nullopt},
                {{L2存在结构内部::存在单例角色关系类型本地键值},
                    节点种类::普通, std::nullopt}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2存在结构内部::映射存在写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2存在结构内部::形成存在单例角色登记失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2存在结构内部::形成存在单例角色登记失败(
                    状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界
                    == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || 写入.新编码映射.size() != 2)
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            稳定编码 锚点;
            稳定编码 类型;
            for (const auto& [本地键, 编码] : 写入.新编码映射) {
                if (!有效(编码)) return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
                if (本地键.值 == L2存在结构内部::存在单例角色登记锚点本地键值)
                    锚点 = 编码;
                else if (本地键.值
                    == L2存在结构内部::存在单例角色关系类型本地键值)
                    类型 = 编码;
                else return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            }
            L2存在单例角色结构登记 新定位{请求.请求头.合同版本,
                请求.规则版本, 请求.幂等身份, 请求.请求头.期望事实代次,
                写入.事实代次, 锚点, {类型}, {写入.事实代次, std::nullopt},
                {写入.事实代次, std::nullopt}, 写入.事实代次};
            if (!L2存在单例角色结构登记完整(新定位))
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            auto 读回 = 按定位读取当前存在单例角色结构登记(
                新定位, 写入.事实代次);
            if (!读回.成功() || !读回.登记)
                return 读回.结果头.状态 == L2结构状态::已读取
                    ? L2存在结构内部::形成存在单例角色登记失败(
                        L2结构状态::内部不一致, 读回.结果头.事实截止代次)
                    : 读回;
            if (单例角色结构登记定位_
                && (单例角色结构登记定位_->建立事实代次 != 新定位.建立事实代次
                    || 单例角色结构登记定位_->角色登记锚点稳定编码
                        != 新定位.角色登记锚点稳定编码
                    || 单例角色结构登记定位_->角色关系类型
                        != 新定位.角色关系类型))
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            单例角色结构登记定位_ = 新定位;
            读回.结果头.状态 = 状态;
            读回.结果头.变更事实代次 = 写入.事实代次;
            return 读回.成功() ? 读回
                : L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2存在结构内部::形成存在单例角色登记失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2存在结构内部::形成存在单例角色登记失败(
                L2结构状态::资源失败);
        } catch (...) {
