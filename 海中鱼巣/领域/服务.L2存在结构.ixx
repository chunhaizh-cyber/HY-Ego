                L1所有者范围写集本地键{L2存在结构内部::存在节点本地键值},
                存在身份来源定位_.族锚点,
                存在身份来源定位_.族归属关系类型, 1}};

            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2存在结构内部::映射存在写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                return {{L2结构合同版本, 状态, 写入.事实代次,
                    std::nullopt}, std::nullopt};
            }

            const bool 首次成功完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            const auto 编码 =
                L2存在结构内部::查找存在节点与来源关系编码映射(写入);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 幂等键 || 写入.事实代次 == 0
                || (!首次成功完整 && !重复成功完整) || !编码) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }

            const auto 读回 = 第一层读取服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码->节点});
            const auto* 节点 = 读回.事实
                ? std::get_if<L1所有者范围节点事实>(&*读回.事实) : nullptr;
            auto 存在 = 节点 ? L2存在结构内部::形成E1存在事实(
                *节点, 第一层写入端口_.所有者身份(), 写入.事实代次) : std::nullopt;
            if (读回.状态 != L1所有者范围读取状态::成功
                || 读回.合同版本 != L1所有者范围CRUD合同版本
                || 读回.查询编码 != 编码->节点
                || !节点 || 节点->编码 != 编码->节点
                || 节点->退出事实代次 || !存在) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }
            const auto 当前代次读取 = 第一层读取服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次读取.状态 != L1中性读取状态::成功
                || 当前代次读取.合同版本 != L1中性CRUD合同版本
                || 当前代次读取.事实代次 < 写入.事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            const L2存在身份来源读取请求 来源请求{
                {L2结构合同版本, 当前代次读取.事实代次}, L2读取类别::历史,
                L2存在身份{编码->节点}, 写入.事实代次};
            const auto 来源 = L2存在结构内部::读取历史存在身份来源(
                第一层读取服务_, 存在身份来源定位_, 来源请求);
            if (!来源.成功() || !来源.身份来源
                || 来源.身份来源->族归属关系稳定编码 != 编码->关系
                || 来源.身份来源->节点生命周期.创建事实代次 != 写入.事实代次
                || 来源.身份来源->归属关系生命周期.创建事实代次
                    != 写入.事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            return {{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(存在)};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

    // 诊断责任：向上送出；当前与历史身份来源均只消费 L1 权威读回。
    L2存在身份来源读取结果 读取存在身份来源(
        const L2存在身份来源读取请求& 请求) const {
        if (!L2存在身份来源读取请求有效(请求)) return {};
        try {
            return 请求.读取类别 == L2读取类别::当前
                ? L2存在结构内部::读取当前存在身份来源(
                    第一层读取服务_, 存在身份来源定位_, 请求)
                : L2存在结构内部::读取历史存在身份来源(
                    第一层读取服务_, 存在身份来源定位_, 请求);
        } catch (const std::bad_alloc&) {
            return L2存在结构内部::形成存在身份来源读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2存在结构内部::形成存在身份来源读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2存在结构内部::形成存在身份来源读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；初始属性由一份写集建值、设槽并按首次代次读回。
    L2存在固定属性写入结果 新增存在固定属性(
        const L2存在固定属性新增请求& 请求) {
        if (!L2存在固定属性新增请求有效(请求)
            || L2存在结构内部::是保留来源登记幂等身份(请求.幂等身份)) return {};
        try {
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2存在结构内部::映射存在幂等键(请求.幂等身份);
            写集.值 = {{{L2存在结构内部::存在固定属性值本地键值},
                L1所有者范围事实引用{请求.存在.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                L2存在结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1所有者范围事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1所有者范围事实引用{请求.存在.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                {L2存在结构内部::存在固定属性值本地键值}}};
            const auto 代次 = L2存在结构内部::检查存在当前代次(
                第一层读取服务_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2存在结构内部::形成存在固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2存在结构内部::检查存在固定属性前置(
                    第一层读取服务_, 存在身份来源定位_,
                    请求.存在, 请求.新属性.属性类型身份,
                    std::nullopt, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2存在结构内部::形成存在固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2存在结构内部::提交并读回存在固定属性写集(
                第一层读取服务_, 第一层写入端口_, 写集,
                请求.存在, 请求.新属性, std::nullopt);
            return 结果.成功() && !结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2存在结构内部::形成存在固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2存在结构内部::形成存在固定属性写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2存在结构内部::形成存在固定属性写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2存在结构内部::形成存在固定属性写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；换代在一份写集中建立新值、切槽并退出具名旧值。
    L2存在固定属性写入结果 换代存在固定属性(
        const L2存在固定属性换代请求& 请求) {
        if (!L2存在固定属性换代请求有效(请求)
            || L2存在结构内部::是保留来源登记幂等身份(请求.幂等身份)) return {};
        try {
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2存在结构内部::映射存在幂等键(请求.幂等身份);
            写集.值 = {{{L2存在结构内部::存在固定属性值本地键值},
                L1所有者范围事实引用{请求.存在.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                L2存在结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1所有者范围事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1所有者范围事实引用{请求.存在.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                {L2存在结构内部::存在固定属性值本地键值}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 = L2存在结构内部::检查存在当前代次(
                第一层读取服务_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2存在结构内部::形成存在固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2存在结构内部::检查存在固定属性前置(
                    第一层读取服务_, 存在身份来源定位_,
                    请求.存在, 请求.新属性.属性类型身份,
                    请求.旧值稳定编码, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2存在结构内部::形成存在固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2存在结构内部::提交并读回存在固定属性写集(
                第一层读取服务_, 第一层写入端口_, 写集,
                请求.存在, 请求.新属性,
                请求.旧值稳定编码);
            return 结果.成功() && 结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2存在结构内部::形成存在固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2存在结构内部::形成存在固定属性写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2存在结构内部::形成存在固定属性写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2存在结构内部::形成存在固定属性写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史完整读取失败均不携带部分存在。
    L2存在完整读取结果 读取完整存在(
        const L2存在完整读取请求& 请求) const {
        if (!L2存在完整读取请求有效(请求)) return {};
        try {
            return 请求.读取类别 == L2读取类别::当前
                ? L2存在结构内部::读取当前完整存在(第一层读取服务_,
                    存在身份来源定位_, 请求)
                : L2存在结构内部::读取历史完整存在(第一层读取服务_,
                    存在身份来源定位_, 请求);
        } catch (const std::bad_alloc&) {
            return L2存在结构内部::形成完整存在读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2存在结构内部::形成完整存在读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2存在结构内部::形成完整存在读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；显式属性闭包核对后由一份写集退出存在及其值。
    L2存在退出结果 退出存在(const L2存在退出请求& 请求) {
        if (!L2存在退出请求有效(请求)
            || L2存在结构内部::是保留来源登记幂等身份(请求.幂等身份)) return {};
        try {
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2存在结构内部::映射存在幂等键(请求.幂等身份);
            写集.退出事实 = {请求.存在.值, 请求.族归属关系稳定编码};
            写集.退出事实.insert(写集.退出事实.end(),
                请求.当前固定属性值.begin(), 请求.当前固定属性值.end());
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            const auto 代次 = L2存在结构内部::检查存在当前代次(
                第一层读取服务_, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2存在结构内部::形成存在退出失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 来源 = 读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.存在, 0});
                if (来源.结果头.状态 != L2结构状态::已读取 || !来源.身份来源) {
                    if (来源.结果头.状态 != L2结构状态::事实代次漂移)
                        return L2存在结构内部::形成存在退出失败(
                            来源.结果头.状态, 来源.结果头.事实截止代次);
                } else if (来源.身份来源->族归属关系稳定编码
                    != 请求.族归属关系稳定编码) {
                    return L2存在结构内部::形成存在退出失败(
                        L2结构状态::引用冲突, 来源.结果头.事实截止代次);
                }
                const auto 快照 = 读取完整存在({请求.请求头,
                    L2读取类别::当前, 请求.存在, 0});
                if (快照.结果头.状态 != L2结构状态::已读取 || !快照.存在) {
                    if (快照.结果头.状态 != L2结构状态::事实代次漂移)
                        return L2存在结构内部::形成存在退出失败(
                            快照.结果头.状态, 快照.结果头.事实截止代次);
                } else {
                    std::vector<稳定编码> 当前属性值;
                    for (const auto& 属性 : 快照.存在->固定属性)
                        当前属性值.push_back(属性.值稳定编码);
                    std::sort(当前属性值.begin(), 当前属性值.end());
                    if (当前属性值 != 请求.当前固定属性值)
                        return L2存在结构内部::形成存在退出失败(
                            L2结构状态::引用冲突, 快照.结果头.事实截止代次);
                }
            }
            return L2存在结构内部::提交并读回存在退出写集(
                第一层读取服务_, 第一层写入端口_, 写集,
                存在身份来源定位_, 请求);
        } catch (const std::bad_alloc&) {
            return L2存在结构内部::形成存在退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2存在结构内部::形成存在退出失败(L2结构状态::资源失败);
        } catch (...) {
            return L2存在结构内部::形成存在退出失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史读取异常与矛盾均映射为结构化状态。
    L2存在节点读取结果 读取存在节点(const L2存在节点读取请求& 请求) const {
        if (!L2存在节点读取请求有效(请求)) return {};
        try {
            const L2存在完整读取请求 完整请求{请求.请求头, 请求.读取类别,
                请求.存在, 请求.读取类别 == L2读取类别::历史
                    ? 请求.请求头.期望事实代次 : 0};
            const auto 完整结果 = 读取完整存在(完整请求);
            return {完整结果.结果头, 完整结果.存在};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

    L2结构结果头 读取当前事实代次() const {
        try {
            const auto 读取 = 第一层读取服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (读取.合同版本 != L1中性CRUD合同版本)
                return {L2结构合同版本, L2结构状态::内部不一致, 0,
                    std::nullopt};
            if (读取.状态 != L1中性读取状态::成功)
                return {L2结构合同版本,
                    L2存在结构内部::映射存在事实代次探测失败(读取.状态),
                    读取.事实代次, std::nullopt};
            if (读取.事实代次 == 0)
                return {L2结构合同版本, L2结构状态::内部不一致, 0,
                    std::nullopt};
            return {L2结构合同版本, L2结构状态::已读取,
                读取.事实代次, std::nullopt};
        } catch (...) {
            return {L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt};
        }
    }

private:
    // 诊断责任：向上送出；登记定位只作查找，owner 与两节点每次按当前代次读回。
    L2存在单例角色结构登记结果 按定位读取当前存在单例角色结构登记(
        const L2存在单例角色结构登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2存在单例角色结构登记完整(定位))
            return L2存在结构内部::形成存在单例角色登记失败(
                L2结构状态::内部不一致);
        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试 = 0; 尝试 < 最大尝试次数; ++尝试) {
            L1所有者范围一致当前读取请求 请求;
            请求.合同版本 = L1所有者范围一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.所有者 = {存在身份来源定位_.所有者};
            请求.节点 = {定位.角色登记锚点稳定编码, 定位.角色关系类型.值};
            const auto 读取 = 第一层读取服务_.尝试读取所有者范围一致当前投影(请求);
            const auto 顶层 = L2存在结构内部::解释存在一致读取顶层(
                读取, 本轮期望代次);
            if (顶层.状态 == L2结构状态::事实代次漂移 && 尝试 == 0
                && 顶层.事实截止代次 != 0) {
                本轮期望代次 = 顶层.事实截止代次;
                continue;
            }
            if (!顶层.成功())
                return L2存在结构内部::形成存在单例角色登记失败(
                    顶层.状态, 顶层.事实截止代次);
            if (读取.所有者.size() != 1 || 读取.节点.size() != 2
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty())
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto& 所有者项 = 读取.所有者.front();
            const auto* 锚点项 = L2存在结构内部::查找唯一存在节点项(
                读取, 定位.角色登记锚点稳定编码);
            const auto* 类型项 = L2存在结构内部::查找唯一存在节点项(
                读取, 定位.角色关系类型.值);
            if (所有者项.查询所有者 != 存在身份来源定位_.所有者
                || 所有者项.状态
                    != L1所有者范围一致当前读取项目状态::成功
                || !所有者项.所有者事实
                || 所有者项.所有者事实->所有者 != 存在身份来源定位_.所有者
                || 所有者项.所有者事实->范围种类
                    != L1所有者范围种类::独占结构范围
                || 所有者项.所有者事实->退出事实代次
                || !锚点项 || !类型项
                || 锚点项->状态 != L1所有者范围一致当前读取项目状态::成功
                || 类型项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !锚点项->事实 || !类型项->事实)
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto 节点完整 = [&](const L1所有者范围节点事实& 节点,
                稳定编码 编码) noexcept {
                return 节点.编码 == 编码
                    && 节点.写入所有者 == 存在身份来源定位_.所有者
                    && 节点.种类 == 节点种类::普通
                    && !节点.属性类型表示 && 节点.当前属性.empty()
                    && 节点.创建事实代次 == 定位.建立事实代次
                    && !节点.退出事实代次
                    && (!期望创建代次
                        || 节点.创建事实代次 == *期望创建代次);
            };
            if (!节点完整(*锚点项->事实, 定位.角色登记锚点稳定编码)
                || !节点完整(*类型项->事实, 定位.角色关系类型.值)
                || 所有者项.所有者事实->创建事实代次 > 定位.建立事实代次)
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            auto 当前 = 定位;
            当前.锚点生命周期 = {锚点项->事实->创建事实代次,
                锚点项->事实->退出事实代次};
            当前.类型生命周期 = {类型项->事实->创建事实代次,
                类型项->事实->退出事实代次};
            当前.事实截止代次 = 顶层.事实截止代次;
            if (!L2存在单例角色结构登记完整(当前))
                return L2存在结构内部::形成存在单例角色登记失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            return {{L2结构合同版本, L2结构状态::已读取,
                顶层.事实截止代次, std::nullopt}, std::move(当前)};
        }
        return L2存在结构内部::形成存在单例角色登记失败(
            L2结构状态::内部不一致);
    }

    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层读取服务,
        L2存在所有者交付& 存在所有者交付) {
        if (!存在所有者交付.写入端口_.有效()
            || !存在所有者交付.写入端口_.绑定于(第一层读取服务))
            throw std::invalid_argument(
                "L2 existence owner delivery is invalid or cross-instance");
        return std::move(存在所有者交付.写入端口_);
    }

    const L1事实基座服务& 第一层读取服务_;
    L1所有者范围写端口 第一层写入端口_;
    const L2存在结构内部::存在身份来源定位 存在身份来源定位_;
    mutable std::mutex 单例角色结构登记锁_;
    std::optional<L2存在单例角色结构登记> 单例角色结构登记定位_;
};

} // namespace 海中鱼巣
