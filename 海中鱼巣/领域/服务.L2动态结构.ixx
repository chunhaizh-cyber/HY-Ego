export namespace 海中鱼巣 {

inline constexpr L1所有者范围建立幂等身份 动态所有者建立身份{
    0x4C31'4F57'4E45'5235ULL};

class L2动态结构服务;

class L2动态所有者交付 final {
public:
    L2动态所有者交付() = delete;
    L2动态所有者交付(const L2动态所有者交付&) = delete;
    L2动态所有者交付& operator=(const L2动态所有者交付&) = delete;
    L2动态所有者交付(L2动态所有者交付&&) noexcept = default;
    L2动态所有者交付& operator=(L2动态所有者交付&&) = delete;

private:
    explicit L2动态所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2动态所有者交付> 尝试形成L2动态所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2动态结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2动态所有者交付> 尝试形成L2动态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept;

}

namespace 海中鱼巣::L2动态结构内部 {

inline constexpr std::uint64_t 动态结构类型登记幂等域 = 0x21ULL;
inline constexpr std::uint32_t 动态主体关系类型本地键值 = 0x0205'0101U;
inline constexpr std::uint32_t 动态前状态关系类型本地键值 = 0x0205'0102U;
inline constexpr std::uint32_t 动态后状态关系类型本地键值 = 0x0205'0103U;
inline constexpr std::uint32_t 动态起始I64值类型本地键值 = 0x0205'0201U;
inline constexpr std::uint32_t 动态起始I64组值类型本地键值 = 0x0205'0202U;
inline constexpr std::uint32_t 动态起始U64组值类型本地键值 = 0x0205'0203U;
inline constexpr std::uint32_t 动态起始独立材料值类型本地键值 = 0x0205'0204U;
inline constexpr std::uint32_t 动态结束I64值类型本地键值 = 0x0205'0301U;
inline constexpr std::uint32_t 动态结束I64组值类型本地键值 = 0x0205'0302U;
inline constexpr std::uint32_t 动态结束U64组值类型本地键值 = 0x0205'0303U;
inline constexpr std::uint32_t 动态结束独立材料值类型本地键值 = 0x0205'0304U;
inline constexpr std::uint32_t 动态节点本地键值 = 0x0205'1001U;
inline constexpr std::uint32_t 动态族归属关系本地键值 = 0x0205'1002U;
inline constexpr std::uint32_t 动态主体关系本地键值 = 0x0205'1101U;
inline constexpr std::uint32_t 动态前状态关系本地键值 = 0x0205'1102U;
inline constexpr std::uint32_t 动态后状态关系本地键值 = 0x0205'1103U;
inline constexpr std::uint32_t 动态起始值本地键值 = 0x0205'1201U;
inline constexpr std::uint32_t 动态结束值本地键值 = 0x0205'1202U;
inline constexpr std::int64_t 动态端点角色值 = 1;
inline constexpr L1所有者范围写入幂等身份 动态身份来源登记幂等身份{
    0x4C32'4944'5352'4305ULL};
inline constexpr std::uint32_t 动态族锚点本地键值 = 0x0205'2001U;
inline constexpr std::uint32_t 动态族归属关系类型本地键值 = 0x0205'2002U;
inline constexpr std::uint32_t 动态身份来源族归属关系本地键值 = 0x0205'2003U;

struct 动态身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

L1所有者范围写入幂等身份 映射动态结构类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(动态结构类型登记幂等域 << 56) | 身份.值};
}

L1所有者范围写入幂等身份 映射动态幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

L1所有者范围原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1所有者范围独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2原始值材料 转换为L2材料(const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1所有者范围独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2结构状态 映射写入动态(L1所有者范围写入状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::未找到: return L2结构状态::未找到;
    case L1所有者范围写入状态::已退出: return L2结构状态::已退出;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射一致读取失败动态(
    L1所有者范围一致当前读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射当前项目动态(
    L1所有者范围一致当前读取项目状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史读取动态(L1所有者范围读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史关系组失败动态(
    L1所有者范围读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史属性组失败动态(
    L1所有者范围读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2动态结构类型登记状态 映射登记写入动态(
    L1所有者范围写入状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围写入状态::成功: return L2动态结构类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2动态结构类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2动态结构类型登记状态::入口拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2动态结构类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2动态结构类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2动态结构类型登记状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::引用冲突:
    case L1所有者范围写入状态::内部不一致:
        return L2动态结构类型登记状态::内部不一致;
    }
    return L2动态结构类型登记状态::内部不一致;
}

L2动态结构类型登记状态 映射登记读取失败动态(
    L1所有者范围一致当前读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2动态结构类型登记状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2动态结构类型登记状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2动态结构类型登记状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2动态结构类型登记状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2动态结构类型登记状态::内部不一致;
    }
    return L2动态结构类型登记状态::内部不一致;
}

L2结构状态 映射登记失败为结构动态(
    L2动态结构类型登记状态 动态) noexcept {
    switch (动态) {
    case L2动态结构类型登记状态::登记未加载:
    case L2动态结构类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2动态结构类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2动态结构类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2动态结构类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2动态结构类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2动态结构类型登记状态::已提交:
    case L2动态结构类型登记状态::精确重复:
    case L2动态结构类型登记状态::已读取:
    case L2动态结构类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2动态结构类型登记结果 形成登记失败(
    L2动态结构类型登记状态 动态, std::uint64_t 截止 = 0) noexcept {
    return {动态, 截止, std::nullopt};
}

L2动态写入结果 形成写入失败(
    L2结构状态 动态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 动态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

L2动态完整读取结果 形成完整读取失败(
    const L2动态完整读取请求& 请求, L2结构状态 动态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 动态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt, std::nullopt};
}

L2当前动态组读取结果 形成组读取失败(
    L2结构状态 动态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 动态, 截止, std::nullopt}, {}};
}

std::optional<稳定编码> 查找编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

std::array<稳定编码, 11> 登记编码组(
    const L2动态结构类型登记& 登记) noexcept {
    return {登记.主体关系类型.值, 登记.前状态关系类型.值,
        登记.后状态关系类型.值,
        登记.起始I64值类型.值, 登记.起始I64组值类型.值,
        登记.起始U64组值类型.值, 登记.起始独立材料值类型.值,
        登记.结束I64值类型.值, 登记.结束I64组值类型.值,
        登记.结束U64组值类型.值, 登记.结束独立材料值类型.值};
}

std::optional<L2动态结构类型登记> 从写入形成登记(
    const L1所有者范围写入结果& 写入,
    const L2动态结构类型登记请求& 请求) noexcept {
    if (写入.新编码映射.size() != 11) return std::nullopt;
    const auto 主体 = 查找编码映射(写入, 动态主体关系类型本地键值);
    const auto 前状态 = 查找编码映射(写入, 动态前状态关系类型本地键值);
    const auto 后状态 = 查找编码映射(写入, 动态后状态关系类型本地键值);
    const auto 起始I64 = 查找编码映射(写入, 动态起始I64值类型本地键值);
    const auto 起始I64组 = 查找编码映射(写入, 动态起始I64组值类型本地键值);
    const auto 起始U64组 = 查找编码映射(写入, 动态起始U64组值类型本地键值);
    const auto 起始独立 = 查找编码映射(写入, 动态起始独立材料值类型本地键值);
    const auto 结束I64 = 查找编码映射(写入, 动态结束I64值类型本地键值);
    const auto 结束I64组 = 查找编码映射(写入, 动态结束I64组值类型本地键值);
    const auto 结束U64组 = 查找编码映射(写入, 动态结束U64组值类型本地键值);
    const auto 结束独立 = 查找编码映射(写入, 动态结束独立材料值类型本地键值);
    if (!主体 || !前状态 || !后状态 || !起始I64 || !起始I64组 || !起始U64组
        || !起始独立 || !结束I64 || !结束I64组 || !结束U64组 || !结束独立)
        return std::nullopt;
    L2动态结构类型登记 登记;
    登记.首次期望事实代次 = 请求.请求头.期望事实代次;
    登记.建立事实代次 = 写入.事实代次;
    登记.事实截止代次 = 写入.事实代次;
    登记.主体关系类型 = L2动态主体关系类型身份{*主体};
    登记.前状态关系类型 = L2动态前状态关系类型身份{*前状态};
    登记.后状态关系类型 = L2动态后状态关系类型身份{*后状态};
    登记.起始I64值类型 = L2动态起始I64值类型身份{*起始I64};
    登记.起始I64组值类型 = L2动态起始I64组值类型身份{*起始I64组};
    登记.起始U64组值类型 = L2动态起始U64组值类型身份{*起始U64组};
    登记.起始独立材料值类型 = L2动态起始独立材料值类型身份{*起始独立};
    登记.结束I64值类型 = L2动态结束I64值类型身份{*结束I64};
    登记.结束I64组值类型 = L2动态结束I64组值类型身份{*结束I64组};
    登记.结束U64组值类型 = L2动态结束U64组值类型身份{*结束U64组};
    登记.结束独立材料值类型 = L2动态结束独立材料值类型身份{*结束独立};
    return L2动态结构类型登记完整(登记)
        ? std::optional<L2动态结构类型登记>{登记} : std::nullopt;
}

bool 登记节点历史完整(const L1事实基座服务& 第一层服务,
    稳定编码 编码, 节点种类 种类,
    std::optional<L1所有者范围值表示种类> 表示, std::uint64_t 建立代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    return 读取.状态 == L1所有者范围读取状态::成功
        && 读取.合同版本 == L1所有者范围CRUD合同版本
        && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
        && 节点->种类 == 种类 && 节点->属性类型表示 == 表示
        && 节点->创建事实代次 == 建立代次 && !节点->退出事实代次
        && 节点->当前属性.empty();
}

bool 登记历史完整(const L1事实基座服务& 第一层服务,
    const L2动态结构类型登记& 登记) {
    const auto 编码 = 登记编码组(登记);
    const std::array<std::optional<L1所有者范围值表示种类>, 11> 表示 = {
        std::nullopt, std::nullopt, std::nullopt, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用};
    for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
        const auto 种类 = 索引 < 3 ? 节点种类::普通 : 节点种类::属性类型;
        if (!登记节点历史完整(
                第一层服务, 编码[索引], 种类, 表示[索引], 登记.建立事实代次))
            return false;
    }
    return true;
}

稳定编码 选择动态值类型编码(const L2动态结构类型登记& 登记,
    const L2原始值材料& 材料, bool 起始角色) noexcept {
    return std::visit([&](const auto& 值) noexcept -> 稳定编码 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, std::int64_t>)
            return 起始角色 ? 登记.起始I64值类型.值 : 登记.结束I64值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>)
            return 起始角色 ? 登记.起始I64组值类型.值 : 登记.结束I64组值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>)
            return 起始角色 ? 登记.起始U64组值类型.值 : 登记.结束U64组值类型.值;
        else return 起始角色 ? 登记.起始独立材料值类型.值
            : 登记.结束独立材料值类型.值;
    }, 材料);
}

bool 动态值类型与材料一致(const L2动态结构类型登记& 登记,
    稳定编码 类型编码, const L1所有者范围原始值材料& 材料, bool 起始角色) {
    return 选择动态值类型编码(登记, 转换为L2材料(材料), 起始角色)
        == 类型编码;
}

std::optional<L2属性事实> 形成截止属性事实(
    L1所有者范围值事实 值, const L2动态结构类型登记& 登记,
    std::uint64_t 截止, bool 起始角色) {
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    if (!动态值类型与材料一致(登记, 值.属性类型节点, 值.材料, 起始角色))
        return std::nullopt;
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

std::optional<L2动态事实> 形成动态事实(
    L1所有者范围节点事实 节点, L1所有者范围关系事实 主体关系,
    L1所有者范围关系事实 前状态关系, L1所有者范围关系事实 后状态关系,
    L1所有者范围值事实 起始时间值,
    L1所有者范围值事实 结束时间值, const L2动态结构类型登记& 登记,
    std::uint64_t 截止) {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (主体关系.退出事实代次 && *主体关系.退出事实代次 > 截止)
        主体关系.退出事实代次.reset();
    if (前状态关系.退出事实代次 && *前状态关系.退出事实代次 > 截止)
        前状态关系.退出事实代次.reset();
    if (后状态关系.退出事实代次 && *后状态关系.退出事实代次 > 截止)
        后状态关系.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || !有效(主体关系.编码) || !有效(前状态关系.编码)
        || !有效(后状态关系.编码)
        || 主体关系.编码 == 前状态关系.编码
        || 主体关系.编码 == 后状态关系.编码
        || 前状态关系.编码 == 后状态关系.编码
        || 主体关系.源节点 != 节点.编码
        || 前状态关系.源节点 != 节点.编码
        || 后状态关系.源节点 != 节点.编码
        || 主体关系.关系类型节点 != 登记.主体关系类型.值
        || 前状态关系.关系类型节点 != 登记.前状态关系类型.值
        || 后状态关系.关系类型节点 != 登记.后状态关系类型.值
        || 主体关系.角色或顺序 != 动态端点角色值
        || 前状态关系.角色或顺序 != 动态端点角色值
        || 后状态关系.角色或顺序 != 动态端点角色值
        || 主体关系.创建事实代次 < 节点.创建事实代次
        || 前状态关系.创建事实代次 < 节点.创建事实代次
        || 后状态关系.创建事实代次 < 节点.创建事实代次
        || 主体关系.创建事实代次 > 截止
        || 前状态关系.创建事实代次 > 截止
        || 后状态关系.创建事实代次 > 截止
        || 起始时间值.所属节点 != 节点.编码 || 结束时间值.所属节点 != 节点.编码
        || 起始时间值.创建事实代次 < 节点.创建事实代次
        || 结束时间值.创建事实代次 < 节点.创建事实代次
        || 起始时间值.创建事实代次 > 截止
        || 结束时间值.创建事实代次 > 截止)
        return std::nullopt;
    auto 起始属性 = 形成截止属性事实(起始时间值, 登记, 截止, true);
    auto 结束属性 = 形成截止属性事实(结束时间值, 登记, 截止, false);
    if (!起始属性 || !结束属性) return std::nullopt;
    L2动态事实 动态;
    动态.身份 = L2动态身份{节点.编码};
    动态.主体存在 = L2存在身份{主体关系.目标节点};
    动态.前状态 = L2状态身份{前状态关系.目标节点};
    动态.后状态 = L2状态身份{后状态关系.目标节点};
    动态.起始时间值 = std::move(*起始属性);
    动态.结束时间值 = std::move(*结束属性);
    动态.来源稳定编码 = 动态.起始时间值.来源稳定编码;
    动态.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return L2动态事实完整(动态, 登记, 截止)
        ? std::optional<L2动态事实>{std::move(动态)} : std::nullopt;
}

struct 一致读取顶层结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

一致读取顶层结果 解释一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取, std::uint64_t 期望) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望 && 读取.读取事实代次 == 期望
            && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次};
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    }
    const bool 空 = 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望 || !空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    return {映射一致读取失败动态(读取.状态), 读取.读取事实代次};
}

const L1所有者范围一致节点读取结果项* 查找唯一节点项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致源关系组读取结果项* 查找唯一源关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 源,
    稳定编码 类型) noexcept {
    const L1所有者范围一致源关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.源关系组) {
        if (项.源节点 != 源 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致目标关系组读取结果项* 查找唯一目标关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 目标,
    稳定编码 类型) noexcept {
    const L1所有者范围一致目标关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.目标关系组) {
        if (项.目标节点 != 目标 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致属性值读取结果项* 查找唯一属性项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 节点,
    稳定编码 类型) noexcept {
    const L1所有者范围一致属性值读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.属性值) {
        if (项.节点 != 节点 || 项.属性类型 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

bool 普通当前节点完整(const L1所有者范围节点事实& 节点,
    稳定编码 编码, std::uint64_t 截止) noexcept {
    return 节点.编码 == 编码 && 节点.种类 == 节点种类::普通
        && !节点.属性类型表示 && 节点.创建事实代次 != 0
        && 节点.创建事实代次 <= 截止 && !节点.退出事实代次;
}

L2结构状态 映射事实代次探测失败(L1中性读取状态 动态) noexcept {
    switch (动态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 检查端点结果头(const L2结构结果头& 结果头,
    std::uint64_t 期望) noexcept {
    if (结果头.状态 == L2结构状态::已读取) {
        return 结果头.事实截止代次 == 期望 && !结果头.变更事实代次
            ? L2结构状态::已读取 : L2结构状态::内部不一致;
    }
    if (结果头.变更事实代次) return L2结构状态::内部不一致;
    return 结果头.状态;
}

// 诊断责任：向上送出；来源登记任何结构化非成功都使服务构造失败。
动态身份来源定位 初始化动态身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 state owner fact is invalid");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读取.所有者事实->创建事实代次;
    写集.写入幂等身份 = 动态身份来源登记幂等身份;
    写集.节点 = {
        {{动态族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{动态族归属关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 动态身份来源登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 2)
        throw std::runtime_error("L2 state identity source initialization failed");
    稳定编码 锚点编码;
    稳定编码 类型编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) throw std::runtime_error("L2 state source mapping invalid");
        if (本地键.值 == 动态族锚点本地键值) 锚点编码 = 编码;
        else if (本地键.值 == 动态族归属关系类型本地键值) 类型编码 = 编码;
        else throw std::runtime_error("L2 state source mapping unknown");
    }
    if (!有效(锚点编码) || !有效(类型编码) || 锚点编码 == 类型编码)
        throw std::runtime_error("L2 state source mapping incomplete");
    const auto 核对节点 = [&](稳定编码 编码) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者 && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次 && !节点->退出事实代次;
    };
    if (!核对节点(锚点编码) || !核对节点(类型编码))
        throw std::runtime_error("L2 state source readback invalid");
    return {所有者, 锚点编码, 类型编码, 写入.事实代次};
}

} // namespace 海中鱼巣::L2动态结构内部

export namespace 海中鱼巣 {

std::optional<L2动态所有者交付> 尝试形成L2动态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 动态所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务)) return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2动态所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class L2动态结构服务 final {
public:
    explicit L2动态结构服务(const L1事实基座服务& L1,
        const L2存在结构服务& 存在服务,
        const L2状态结构服务& 状态服务,
        L2动态所有者交付&& 动态所有者交付)
        : L1_(L1), 存在服务_(存在服务), 状态服务_(状态服务),
          第一层写入端口_(验证并移动交付(L1, 动态所有者交付)),
          动态身份来源定位_(L2动态结构内部::初始化动态身份来源(
              L1_, 第一层写入端口_)) {
        const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
            throw std::runtime_error("L2 state type registration baseline invalid");
        const auto 登记 = 建立动态结构类型登记(
            {{L2结构合同版本, 代次.事实代次},
                L2动态结构类型登记规则版本, L2结构幂等身份{1}});
        if (!登记.成功()) throw std::runtime_error("L2 state type registration failed");
    }
    L2动态结构服务(const L2动态结构服务&) = delete;
    L2动态结构服务& operator=(const L2动态结构服务&) = delete;

    L2动态结构类型登记结果 建立动态结构类型登记(
        const L2动态结构类型登记请求& 请求) {
        try {
            if (!L2动态结构类型登记请求有效(请求))
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::入口拒绝);
            if (结构类型登记定位_) {
                if (!L2动态结构类型登记完整(*结构类型登记定位_))
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::内部不一致);
                if (结构类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 结构类型登记定位_->规则版本 != 请求.规则版本
                    || 结构类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 结构类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::幂等冲突);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2动态结构内部::映射动态结构类型登记幂等键(
                请求.幂等身份);
            写集.节点 = {
                {{L2动态结构内部::动态主体关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2动态结构内部::动态前状态关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2动态结构内部::动态后状态关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2动态结构内部::动态起始I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2动态结构内部::动态起始I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2动态结构内部::动态起始U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2动态结构内部::动态起始独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用},
                {{L2动态结构内部::动态结束I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2动态结构内部::动态结束I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2动态结构内部::动态结束U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2动态结构内部::动态结束独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 写入.事实代次);
            const auto 登记状态 = L2动态结构内部::映射登记写入动态(写入.状态);
            if (登记状态 != L2动态结构类型登记状态::已提交
                && 登记状态 != L2动态结构类型登记状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::内部不一致, 写入.事实代次);
                return L2动态结构内部::形成登记失败(登记状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            auto 登记 = L2动态结构内部::从写入形成登记(写入, 请求);
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !登记
                || !L2动态结构内部::登记历史完整(L1_, *登记))
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 写入.事实代次);
            if (结构类型登记定位_ && *结构类型登记定位_ != *登记)
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 写入.事实代次);
            结构类型登记定位_ = *登记;
            L2动态结构类型登记结果 结果{登记状态, 写入.事实代次, std::move(登记)};
            return 结果.成功() ? 结果 : L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::内部不一致);
        }
    }

    L2动态结构类型登记结果 读取当前动态结构类型登记() const {
        try {
            if (!结构类型登记定位_)
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::登记未加载);
            if (!L2动态结构类型登记完整(*结构类型登记定位_))
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致);
            auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2动态结构内部::形成登记失败(
                    代次.状态 == L1中性读取状态::资源失败
                        ? L2动态结构类型登记状态::资源失败
                        : L2动态结构类型登记状态::内部不一致,
                    代次.事实代次);
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const auto 编码 = L2动态结构内部::登记编码组(*结构类型登记定位_);
                L1所有者范围一致当前读取请求 请求;
                请求.合同版本 = L1所有者范围一致当前读取合同版本;
                请求.期望事实代次 = 代次.事实代次;
                请求.节点.assign(编码.begin(), 编码.end());
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
                const auto 顶层 = L2动态结构内部::解释一致读取顶层(
                    读取, 请求.期望事实代次);
                if (!顶层.成功()) {
                    if (顶层.状态 == L2结构状态::事实代次漂移 && 尝试 == 0) {
                        代次.事实代次 = 顶层.截止;
                        continue;
                    }
                    const auto 登记动态 = 顶层.状态 == L2结构状态::入口拒绝
                        ? L2动态结构类型登记状态::入口拒绝
                        : 顶层.状态 == L2结构状态::许可拒绝
                            ? L2动态结构类型登记状态::许可拒绝
                        : 顶层.状态 == L2结构状态::事实代次漂移
                            ? L2动态结构类型登记状态::事实代次漂移
                        : 顶层.状态 == L2结构状态::资源失败
                            ? L2动态结构类型登记状态::资源失败
                            : L2动态结构类型登记状态::内部不一致;
                    return L2动态结构内部::形成登记失败(登记动态, 顶层.截止);
                }
                if (读取.节点.size() != 编码.size() || !读取.关系.empty()
                    || !读取.值.empty() || !读取.属性值.empty()
                    || !读取.源关系组.empty() || !读取.目标关系组.empty())
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::内部不一致, 顶层.截止);
                const std::array<std::optional<L1所有者范围值表示种类>, 11> 表示 = {
                    std::nullopt, std::nullopt, std::nullopt,
                    L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用};
                for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
                    const auto* 项 = L2动态结构内部::查找唯一节点项(读取, 编码[索引]);
                    const auto 种类 = 索引 < 3 ? 节点种类::普通 : 节点种类::属性类型;
                    if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                        || !项->事实 || 项->事实->编码 != 编码[索引]
                        || 项->事实->种类 != 种类
                        || 项->事实->属性类型表示 != 表示[索引]
                        || 项->事实->创建事实代次
                            != 结构类型登记定位_->建立事实代次
                        || 项->事实->退出事实代次 || !项->事实->当前属性.empty())
                        return L2动态结构内部::形成登记失败(
                            L2动态结构类型登记状态::内部不一致, 顶层.截止);
                }
                auto 登记 = *结构类型登记定位_;
                登记.事实截止代次 = 顶层.截止;
                L2动态结构类型登记结果 结果{
                    L2动态结构类型登记状态::已读取, 顶层.截止, 登记};
                return 结果.成功() ? 结果 : L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 顶层.截止);
            }
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::事实代次漂移, 代次.事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::内部不一致);
        }
    }

    L2动态写入结果 新增动态(const L2动态新增请求& 请求) {
        if (!L2动态新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (登记结果.状态 != L2动态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2动态结构内部::形成写入失败(
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 起始类型 = L2动态结构内部::选择动态值类型编码(
                登记, 请求.起始时间材料, true);
            const auto 结束类型 = L2动态结构内部::选择动态值类型编码(
                登记, 请求.结束时间材料, false);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2动态结构内部::映射动态幂等键(请求.幂等身份);
            写集.节点 = {{{L2动态结构内部::动态节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2动态结构内部::动态族归属关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    动态身份来源定位_.族锚点,
                    动态身份来源定位_.族归属关系类型,
                    L2动态结构内部::动态端点角色值},
                {{L2动态结构内部::动态主体关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    请求.主体存在.值, 登记.主体关系类型.值,
                    L2动态结构内部::动态端点角色值},
                {{L2动态结构内部::动态前状态关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    请求.前状态.值, 登记.前状态关系类型.值,
                    L2动态结构内部::动态端点角色值},
                {{L2动态结构内部::动态后状态关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    请求.后状态.值, 登记.后状态关系类型.值,
                    L2动态结构内部::动态端点角色值}};
            写集.值 = {
                {{L2动态结构内部::动态起始值本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    起始类型, L2动态结构内部::转换为L1材料(请求.起始时间材料),
                    请求.来源稳定编码},
                {{L2动态结构内部::动态结束值本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    结束类型, L2动态结构内部::转换为L1材料(请求.结束时间材料),
                    请求.来源稳定编码}};
            写集.属性槽变更 = {
                {L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    起始类型,
                    L1所有者范围写集本地键{L2动态结构内部::动态起始值本地键值}},
                {L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    结束类型,
                    L1所有者范围写集本地键{L2动态结构内部::动态结束值本地键值}}};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2动态结构内部::形成写入失败(
                    L2动态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.主体存在, 0});
                if (!主体来源.成功() || !主体来源.身份来源
                    || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值)
                    return L2动态结构内部::形成写入失败(
                        主体来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 主体来源.结果头.状态,
                        主体来源.结果头.事实截止代次);
                const auto 前状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                    L2读取类别::当前, 请求.前状态, 0});
                if (!前状态来源.成功() || !前状态来源.身份来源
                    || 前状态来源.身份来源->节点稳定编码 != 请求.前状态.值)
                    return L2动态结构内部::形成写入失败(
                        前状态来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 前状态来源.结果头.状态,
                        前状态来源.结果头.事实截止代次);
                const auto 后状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                    L2读取类别::当前, 请求.后状态, 0});
                if (!后状态来源.成功() || !后状态来源.身份来源
                    || 后状态来源.身份来源->节点稳定编码 != 请求.后状态.值)
                    return L2动态结构内部::形成写入失败(
                        后状态来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 后状态来源.结果头.状态,
                        后状态来源.结果头.事实截止代次);
            }
            return 提交并读回新增动态(写集, 请求, 登记);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成写入失败(L2结构状态::内部不一致);
        }
    }

    L2动态完整读取结果 读取完整动态(
        const L2动态完整读取请求& 请求) const {
        if (!L2动态完整读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (登记结果.状态 != L2动态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2动态结构内部::形成完整读取失败(请求,
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            return 请求.读取类别 == L2读取类别::当前
                ? 读取当前完整动态(请求, *登记结果.登记)
                : 读取历史完整动态(请求, *登记结果.登记);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前来源由 owner、锚点和唯一非自环归属同截止证明。
    L2动态身份来源读取结果 读取动态身份来源(
        const L2动态身份来源读取请求& 请求) const {
        if (!L2动态身份来源读取请求有效(请求)) return {};
        try {
            if (请求.动态.值 == 动态身份来源定位_.族锚点
                || 请求.动态.值 == 动态身份来源定位_.族归属关系类型)
                return {{L2结构合同版本, L2结构状态::入口拒绝,
                    请求.读取类别 == L2读取类别::当前
                        ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次,
                    std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (请求.读取类别 == L2读取类别::当前) {
                L1所有者范围一致当前读取请求 L1请求;
                L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
                L1请求.期望事实代次 = 请求.请求头.期望事实代次;
                L1请求.所有者 = {动态身份来源定位_.所有者};
                L1请求.节点 = {请求.动态.值, 动态身份来源定位_.族锚点,
                    动态身份来源定位_.族归属关系类型};
                L1请求.源关系组 = {{请求.动态.值,
                    动态身份来源定位_.族归属关系类型}};
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
                const auto 顶层 = L2动态结构内部::解释一致读取顶层(
                    读取, 请求.请求头.期望事实代次);
                if (!顶层.成功()) return {{L2结构合同版本, 顶层.状态,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (读取.所有者.size() != 1 || 读取.节点.size() != 3
                    || !读取.关系.empty() || !读取.值.empty()
                    || !读取.属性值.empty() || 读取.源关系组.size() != 1
                    || !读取.目标关系组.empty())
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto* 节点项 = L2动态结构内部::查找唯一节点项(
                    读取, 请求.动态.值);
                const auto* 锚点项 = L2动态结构内部::查找唯一节点项(
                    读取, 动态身份来源定位_.族锚点);
                const auto* 类型项 = L2动态结构内部::查找唯一节点项(
                    读取, 动态身份来源定位_.族归属关系类型);
                const auto* 关系组 = L2动态结构内部::查找唯一源关系组(
                    读取, 请求.动态.值, 动态身份来源定位_.族归属关系类型);
                if (!节点项 || !锚点项 || !类型项 || !关系组)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
                    const auto 动态 = 节点项->状态
                            == L1所有者范围一致当前读取项目状态::未找到
                        ? L2结构状态::未找到
                        : 节点项->状态
                            == L1所有者范围一致当前读取项目状态::已退出
                            ? L2结构状态::已退出 : L2结构状态::入口拒绝;
                    return {{L2结构合同版本, 节点项->事实
                            ? L2结构状态::内部不一致 : 动态,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                }
                if (!节点项->事实 || !锚点项->事实 || !类型项->事实
                    || 读取.所有者.front().状态
                        != L1所有者范围一致当前读取项目状态::成功
                    || !读取.所有者.front().所有者事实 || 关系组->成员.size() != 1)
                    return {{L2结构合同版本, 关系组->成员.empty()
                            ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 节点 = *节点项->事实;
                const auto& 锚点 = *锚点项->事实;
                const auto& 类型 = *类型项->事实;
                const auto& 关系 = 关系组->成员.front().关系;
                if (节点.写入所有者 != 动态身份来源定位_.所有者
                    || 节点.种类 != 节点种类::普通 || 节点.属性类型表示
                    || 节点.退出事实代次 || 锚点.编码 != 动态身份来源定位_.族锚点
                    || 类型.编码 != 动态身份来源定位_.族归属关系类型
                    || 锚点.写入所有者 != 动态身份来源定位_.所有者
                    || 类型.写入所有者 != 动态身份来源定位_.所有者
                    || 关系.写入所有者 != 动态身份来源定位_.所有者
                    || 关系.源节点 != 请求.动态.值
                    || 关系.目标节点 != 动态身份来源定位_.族锚点
                    || 关系.关系类型节点 != 动态身份来源定位_.族归属关系类型
                    || 关系.角色或顺序 != L2动态结构内部::动态端点角色值
                    || 关系.退出事实代次 || 关系.创建事实代次 != 节点.创建事实代次)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 所有者 = *读取.所有者.front().所有者事实;
                L2节点族身份来源事实 来源{L2节点族::动态, 节点.编码,
                    动态身份来源定位_.所有者, 锚点.编码, 类型.编码, 关系.编码,
                    关系.角色或顺序, {所有者.创建事实代次, 所有者.退出事实代次},
                    {节点.创建事实代次, 节点.退出事实代次},
                    {锚点.创建事实代次, 锚点.退出事实代次},
                    {类型.创建事实代次, 类型.退出事实代次},
                    {关系.创建事实代次, 关系.退出事实代次}};
                L2动态身份来源读取结果 结果{{L2结构合同版本,
                    L2结构状态::已读取, 顶层.截止, std::nullopt},
                    请求.读取类别, 0, std::move(来源)};
                return 结果.成功() ? 结果 : L2动态身份来源读取结果{{
                    L2结构合同版本, L2结构状态::内部不一致,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
            }
            const auto 当前代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 != 请求.请求头.期望事实代次)
                return {{L2结构合同版本,
                    当前代次.状态 == L1中性读取状态::成功
                        ? L2结构状态::事实代次漂移
                        : L2动态结构内部::映射事实代次探测失败(当前代次.状态),
                    当前代次.事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 节点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.动态.值});
            const auto 所有者读取 = L1_.读取历史结构所有者(
                {L1所有者范围CRUD合同版本, 动态身份来源定位_.所有者});
            const auto 锚点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 动态身份来源定位_.族锚点});
            const auto 类型读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 动态身份来源定位_.族归属关系类型});
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
            const auto* 锚点 = 锚点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
            const auto* 类型 = 类型读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
            if (节点读取.状态 != L1所有者范围读取状态::成功)
                return {{L2结构合同版本,
                    L2动态结构内部::映射历史读取动态(节点读取.状态),
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (!节点 || !锚点 || !类型 || !所有者读取.所有者事实
                || 节点->写入所有者 != 动态身份来源定位_.所有者
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 > 请求.历史截止事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const std::uint64_t 关系截止 = 节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次
                ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
            const auto 关系组 = L1_.读取所有者范围历史关系组({
                L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                请求.动态.值, 动态身份来源定位_.族归属关系类型, 关系截止});
            if (关系组.状态 != L1所有者范围读取状态::成功
                || 关系组.关系组.size() != 1)
                return {{L2结构合同版本, 关系组.关系组.empty()
                        ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto& 关系 = 关系组.关系组.front();
            if (关系.写入所有者 != 动态身份来源定位_.所有者
                || 关系.源节点 != 请求.动态.值
                || 关系.目标节点 != 动态身份来源定位_.族锚点
                || 关系.关系类型节点 != 动态身份来源定位_.族归属关系类型
                || 关系.角色或顺序 != L2动态结构内部::动态端点角色值
                || 关系.创建事实代次 != 节点->创建事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 投影生命周期 = [&](std::uint64_t 创建,
                std::optional<std::uint64_t> 退出) noexcept {
                if (退出 && *退出 > 请求.历史截止事实代次) 退出.reset();
                return L2生命周期{创建, 退出};
            };
            L2节点族身份来源事实 来源{L2节点族::动态, 节点->编码,
                动态身份来源定位_.所有者, 锚点->编码, 类型->编码, 关系.编码,
                关系.角色或顺序,
                投影生命周期(所有者读取.所有者事实->创建事实代次,
                    所有者读取.所有者事实->退出事实代次),
                投影生命周期(节点->创建事实代次, 节点->退出事实代次),
                投影生命周期(锚点->创建事实代次, 锚点->退出事实代次),
                投影生命周期(类型->创建事实代次, 类型->退出事实代次),
                投影生命周期(关系.创建事实代次, 关系.退出事实代次)};
            L2动态身份来源读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::move(来源)};
            return 结果.成功() ? 结果 : L2动态身份来源读取结果{{
                L2结构合同版本, L2结构状态::内部不一致,
                请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        }
    }

    L2当前动态组读取结果 按主体读取全部当前动态(
        const L2按主体当前动态读取请求& 请求) const {
        if (!L2按主体当前动态读取请求有效(请求)) return {};
        try {
            const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                L2读取类别::当前, 请求.主体存在, 0});
            if (!主体来源.成功() || !主体来源.身份来源)
                return L2动态结构内部::形成组读取失败(
                    主体来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源.结果头.状态,
                    主体来源.结果头.事实截止代次);
            return 收敛并发条件读取(按端点读取动态组(
                请求.请求头, 请求.主体存在.值, 动态端点角色::主体),
                请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前动态组读取结果 按前状态读取全部当前动态(
        const L2按前状态当前动态读取请求& 请求) const {
        if (!L2按前状态当前动态读取请求有效(请求)) return {};
        try {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::当前, 请求.前状态, 0});
            if (!状态来源.成功() || !状态来源.身份来源)
                return L2动态结构内部::形成组读取失败(
                    状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                    状态来源.结果头.事实截止代次);
            return 收敛并发条件读取(按端点读取动态组(
                请求.请求头, 请求.前状态.值, 动态端点角色::前状态),
                请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前动态组读取结果 按后状态读取全部当前动态(
        const L2按后状态当前动态读取请求& 请求) const {
        if (!L2按后状态当前动态读取请求有效(请求)) return {};
        try {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::当前, 请求.后状态, 0});
            if (!状态来源.成功() || !状态来源.身份来源)
                return L2动态结构内部::形成组读取失败(
                    状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                    状态来源.结果头.事实截止代次);
            return 收敛并发条件读取(按端点读取动态组(
                请求.请求头, 请求.后状态.值, 动态端点角色::后状态),
                请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

private:
    enum class 动态端点角色 : std::uint8_t { 主体, 前状态, 后状态 };

    L2当前动态组读取结果 收敛并发条件读取(
        L2当前动态组读取结果 结果, std::uint64_t 期望) const {
        if (结果.结果头.状态 != L2结构状态::内部不一致) return 结果;
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.状态 == L1中性读取状态::成功
            && 当前代次.事实代次 != 期望)
            return L2动态结构内部::形成组读取失败(
                L2结构状态::事实代次漂移, 当前代次.事实代次);
        return 结果;
    }
    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务,
        L2动态所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument("L2 state owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    L2动态写入结果 提交并读回新增动态(
        const L1所有者范围写集请求& 写集, const L2动态新增请求& 请求,
        const L2动态结构类型登记& 登记) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 动态码 = L2动态结构内部::映射写入动态(写入.状态);
        if (动态码 != L2结构状态::已提交 && 动态码 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2动态结构内部::形成写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return L2动态结构内部::形成写入失败(动态码, 写入.事实代次);
        }
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
            || 写入.新编码映射.size() != 7)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 节点编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态节点本地键值);
        const auto 族归属关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态族归属关系本地键值);
        const auto 主体关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态主体关系本地键值);
        const auto 前状态关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态前状态关系本地键值);
        const auto 后状态关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态后状态关系本地键值);
        const auto 起始时间值编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态起始值本地键值);
        const auto 结束时间值编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态结束值本地键值);
        if (!节点编码 || !族归属关系编码 || !主体关系编码
            || !前状态关系编码 || !后状态关系编码
            || !起始时间值编码 || !结束时间值编码)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 读取事实 = [&](稳定编码 编码) {
            return L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
        };
        const auto 节点读取 = 读取事实(*节点编码);
        const auto 族归属关系读取 = 读取事实(*族归属关系编码);
        const auto 主体关系读取 = 读取事实(*主体关系编码);
        const auto 前状态关系读取 = 读取事实(*前状态关系编码);
        const auto 后状态关系读取 = 读取事实(*后状态关系编码);
        const auto 起始时间值读取 = 读取事实(*起始时间值编码);
        const auto 结束时间值读取 = 读取事实(*结束时间值编码);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        const auto* 族归属关系 = 族归属关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*族归属关系读取.事实) : nullptr;
        const auto* 主体关系 = 主体关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*主体关系读取.事实) : nullptr;
        const auto* 前状态关系 = 前状态关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*前状态关系读取.事实) : nullptr;
        const auto* 后状态关系 = 后状态关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*后状态关系读取.事实) : nullptr;
        const auto* 起始时间值 = 起始时间值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*起始时间值读取.事实) : nullptr;
        const auto* 结束时间值 = 结束时间值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*结束时间值读取.事实) : nullptr;
        const auto owner = 第一层写入端口_.所有者身份();
        if (!节点 || !族归属关系 || !主体关系 || !前状态关系
            || !后状态关系 || !起始时间值 || !结束时间值
            || 节点->编码 != *节点编码 || 节点->写入所有者 != owner
            || 节点->创建事实代次 != 写入.事实代次 || 节点->退出事实代次
            || 族归属关系->源节点 != *节点编码
            || 族归属关系->目标节点 != 动态身份来源定位_.族锚点
            || 族归属关系->关系类型节点 != 动态身份来源定位_.族归属关系类型
            || 族归属关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 族归属关系->写入所有者 != owner
            || 族归属关系->创建事实代次 != 写入.事实代次
            || 族归属关系->退出事实代次
            || 主体关系->源节点 != *节点编码
            || 主体关系->目标节点 != 请求.主体存在.值
            || 主体关系->关系类型节点 != 登记.主体关系类型.值
            || 主体关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 主体关系->写入所有者 != owner
            || 主体关系->创建事实代次 != 写入.事实代次 || 主体关系->退出事实代次
            || 前状态关系->源节点 != *节点编码
            || 前状态关系->目标节点 != 请求.前状态.值
            || 前状态关系->关系类型节点 != 登记.前状态关系类型.值
            || 前状态关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 前状态关系->写入所有者 != owner
            || 前状态关系->创建事实代次 != 写入.事实代次 || 前状态关系->退出事实代次
            || 后状态关系->源节点 != *节点编码
            || 后状态关系->目标节点 != 请求.后状态.值
            || 后状态关系->关系类型节点 != 登记.后状态关系类型.值
            || 后状态关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 后状态关系->写入所有者 != owner
            || 后状态关系->创建事实代次 != 写入.事实代次 || 后状态关系->退出事实代次
            || 起始时间值->所属节点 != *节点编码
            || 起始时间值->属性类型节点
                != L2动态结构内部::选择动态值类型编码(登记, 请求.起始时间材料, true)
            || 起始时间值->材料 != L2动态结构内部::转换为L1材料(请求.起始时间材料)
            || 起始时间值->来源节点 != 请求.来源稳定编码
            || 起始时间值->写入所有者 != owner
            || 起始时间值->创建事实代次 != 写入.事实代次 || 起始时间值->退出事实代次
            || 结束时间值->所属节点 != *节点编码
            || 结束时间值->属性类型节点
                != L2动态结构内部::选择动态值类型编码(登记, 请求.结束时间材料, false)
            || 结束时间值->材料 != L2动态结构内部::转换为L1材料(请求.结束时间材料)
            || 结束时间值->来源节点 != 请求.来源稳定编码
            || 结束时间值->写入所有者 != owner
            || 结束时间值->创建事实代次 != 写入.事实代次 || 结束时间值->退出事实代次
            || 节点->当前属性.size() != 2)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        bool 起始槽 = false, 结束槽 = false;
        for (const auto& 槽 : 节点->当前属性) {
            if (槽.属性类型节点 == 起始时间值->属性类型节点
                && 槽.当前值 == *起始时间值编码) 起始槽 = true;
            else if (槽.属性类型节点 == 结束时间值->属性类型节点
                && 槽.当前值 == *结束时间值编码) 结束槽 = true;
            else return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        }
        if (!起始槽 || !结束槽) return L2动态结构内部::形成写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        auto 动态 = L2动态结构内部::形成动态事实(*节点, *主体关系,
            *前状态关系, *后状态关系, *起始时间值, *结束时间值,
            登记, 写入.事实代次);
        if (!动态 || 动态->主体存在 != 请求.主体存在
            || 动态->前状态 != 请求.前状态
            || 动态->后状态 != 请求.后状态
            || 动态->起始时间值.类型化不可变材料 != 请求.起始时间材料
            || 动态->结束时间值.类型化不可变材料 != 请求.结束时间材料
            || 动态->来源稳定编码 != 请求.来源稳定编码)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.状态 != L1中性读取状态::成功
            || 当前代次.合同版本 != L1中性CRUD合同版本
            || 当前代次.事实代次 < 写入.事实代次)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const L2结构请求头 历史头{L2结构合同版本, 当前代次.事实代次};
        const auto 主体来源 = 存在服务_.读取存在身份来源({历史头,
            L2读取类别::历史, 请求.主体存在, 写入.事实代次});
        const auto 前状态来源 = 状态服务_.读取状态身份来源({历史头,
            L2读取类别::历史, 请求.前状态, 写入.事实代次});
        const auto 后状态来源 = 状态服务_.读取状态身份来源({历史头,
            L2读取类别::历史, 请求.后状态, 写入.事实代次});
        if (!主体来源.成功() || !主体来源.身份来源
            || !前状态来源.成功() || !前状态来源.身份来源
            || !后状态来源.成功() || !后状态来源.身份来源
            || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值
            || 前状态来源.身份来源->节点稳定编码 != 请求.前状态.值
            || 后状态来源.身份来源->节点稳定编码 != 请求.后状态.值)
            return L2动态结构内部::形成写入失败(
                主体来源.结果头.状态 == L2结构状态::事实代次漂移
                    || 前状态来源.结果头.状态 == L2结构状态::事实代次漂移
                    || 后状态来源.结果头.状态 == L2结构状态::事实代次漂移
                    ? L2结构状态::事实代次漂移 : L2结构状态::内部不一致,
                当前代次.事实代次);
        L2动态写入结果 结果{{L2结构合同版本, 动态码,
            写入.事实代次, 写入.事实代次}, std::move(动态),
            L2动态自有关系引用{*族归属关系编码,
                *主体关系编码, *前状态关系编码, *后状态关系编码}};
        return 结果.成功() ? 结果 : L2动态结构内部::形成写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }

    L2动态完整读取结果 读取当前完整动态(
        const L2动态完整读取请求& 请求,
        const L2动态结构类型登记& 登记) const {
        const auto 动态来源 = 读取动态身份来源({请求.请求头,
            L2读取类别::当前, 请求.动态, 0});
        if (!动态来源.成功() || !动态来源.身份来源)
            return L2动态结构内部::形成完整读取失败(请求,
                动态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 动态来源.结果头.状态,
                动态来源.结果头.事实截止代次);
        L1所有者范围一致当前读取请求 首次请求;
        首次请求.合同版本 = L1所有者范围一致当前读取合同版本;
        首次请求.期望事实代次 = 请求.请求头.期望事实代次;
        首次请求.所有者 = {动态身份来源定位_.所有者};
        首次请求.节点 = {请求.动态.值};
        首次请求.源关系组 = {
            {请求.动态.值, 动态身份来源定位_.族归属关系类型},
            {请求.动态.值, 登记.主体关系类型.值},
            {请求.动态.值, 登记.前状态关系类型.值},
            {请求.动态.值, 登记.后状态关系类型.值}};
        const auto 首次读取 = L1_.尝试读取所有者范围一致当前投影(首次请求);
        const auto 首次顶层 = L2动态结构内部::解释一致读取顶层(
            首次读取, 请求.请求头.期望事实代次);
        if (!首次顶层.成功()) return L2动态结构内部::形成完整读取失败(
            请求, 首次顶层.状态, 首次顶层.截止);
        if (首次读取.所有者.size() != 1 || 首次读取.节点.size() != 1 || !首次读取.关系.empty()
            || !首次读取.值.empty() || !首次读取.属性值.empty()
            || 首次读取.源关系组.size() != 4 || !首次读取.目标关系组.empty())
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 节点项 = L2动态结构内部::查找唯一节点项(
            首次读取, 请求.动态.值);
        if (!节点项) return L2动态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 首次顶层.截止);
        if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
            if (节点项->事实) return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
            return L2动态结构内部::形成完整读取失败(请求,
                L2动态结构内部::映射当前项目动态(节点项->状态), 首次顶层.截止);
        }
        if (!节点项->事实 || !L2动态结构内部::普通当前节点完整(
                *节点项->事实, 请求.动态.值, 首次顶层.截止)
            || 节点项->事实->当前属性.size() != 2)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 主体组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 登记.主体关系类型.值);
        const auto* 前状态组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 登记.前状态关系类型.值);
        const auto* 后状态组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 登记.后状态关系类型.值);
        const auto* 族归属组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 动态身份来源定位_.族归属关系类型);
        if (!族归属组 || 族归属组->成员.size() != 1
            || !主体组 || !前状态组 || !后状态组
            || 主体组->成员.size() != 1
            || 前状态组->成员.size() != 1 || 后状态组->成员.size() != 1)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto& 主体关系 = 主体组->成员.front().关系;
        const auto& 前状态关系 = 前状态组->成员.front().关系;
        const auto& 后状态关系 = 后状态组->成员.front().关系;
        if (!L2动态结构内部::普通当前节点完整(
                主体组->成员.front().对端节点, 主体关系.目标节点, 首次顶层.截止)
            || !L2动态结构内部::普通当前节点完整(
                前状态组->成员.front().对端节点, 前状态关系.目标节点,
                首次顶层.截止)
            || !L2动态结构内部::普通当前节点完整(
                后状态组->成员.front().对端节点, 后状态关系.目标节点,
                首次顶层.截止))
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::当前, L2存在身份{主体关系.目标节点}, 0});
        const auto 前状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, L2状态身份{前状态关系.目标节点}, 0});
        const auto 后状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, L2状态身份{后状态关系.目标节点}, 0});
        if (!主体来源.成功() || !前状态来源.成功() || !后状态来源.成功())
            return L2动态结构内部::形成完整读取失败(
                请求,
                !主体来源.成功()
                    ? (主体来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源.结果头.状态)
                : !前状态来源.成功()
                    ? (前状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 前状态来源.结果头.状态)
                    : (后状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 后状态来源.结果头.状态),
                std::max({主体来源.结果头.事实截止代次,
                    前状态来源.结果头.事实截止代次,
                    后状态来源.结果头.事实截止代次}));
        L1所有者范围一致当前读取请求 完整请求 = 首次请求;
        for (const auto& 槽 : 节点项->事实->当前属性)
            完整请求.属性值.push_back({请求.动态.值, 槽.属性类型节点});
        const auto 完整读取 = L1_.尝试读取所有者范围一致当前投影(完整请求);
        const auto 完整顶层 = L2动态结构内部::解释一致读取顶层(
            完整读取, 请求.请求头.期望事实代次);
        if (!完整顶层.成功()) return L2动态结构内部::形成完整读取失败(
            请求, 完整顶层.状态, 完整顶层.截止);
        const auto* 完整节点项 = L2动态结构内部::查找唯一节点项(
            完整读取, 请求.动态.值);
        const auto* 完整主体组 = L2动态结构内部::查找唯一源关系组(
            完整读取, 请求.动态.值, 登记.主体关系类型.值);
        const auto* 完整前状态组 = L2动态结构内部::查找唯一源关系组(
            完整读取, 请求.动态.值, 登记.前状态关系类型.值);
        const auto* 完整后状态组 = L2动态结构内部::查找唯一源关系组(
            完整读取, 请求.动态.值, 登记.后状态关系类型.值);
        if (完整读取.所有者.size() != 1 || 完整读取.节点.size() != 1 || !完整读取.关系.empty()
            || !完整读取.值.empty() || 完整读取.属性值.size() != 2
            || 完整读取.源关系组.size() != 4 || !完整读取.目标关系组.empty()
            || !完整节点项 || 完整节点项->状态
                != L1所有者范围一致当前读取项目状态::成功 || !完整节点项->事实
            || *完整节点项->事实 != *节点项->事实 || !完整主体组
            || !完整前状态组 || !完整后状态组
            || *完整主体组 != *主体组
            || *完整前状态组 != *前状态组 || *完整后状态组 != *后状态组)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const L1所有者范围值事实* 起始时间值 = nullptr;
        const L1所有者范围值事实* 结束时间值 = nullptr;
        for (const auto& 槽 : 完整节点项->事实->当前属性) {
            const auto* 项 = L2动态结构内部::查找唯一属性项(
                完整读取, 请求.动态.值, 槽.属性类型节点);
            if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !项->投影 || 项->投影->属性槽 != 槽
                || 项->投影->当前值事实.编码 != 槽.当前值
                || 项->投影->当前值事实.所属节点 != 请求.动态.值
                || 项->投影->当前值事实.退出事实代次)
                return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
            const auto& 值 = 项->投影->当前值事实;
            if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) {
                if (起始时间值) return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                起始时间值 = &值;
            } else if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) {
                if (结束时间值) return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                结束时间值 = &值;
            } else return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        }
        if (!起始时间值 || !结束时间值) return L2动态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.截止);
        auto 动态 = L2动态结构内部::形成动态事实(*完整节点项->事实,
            完整主体组->成员.front().关系,
            完整前状态组->成员.front().关系,
            完整后状态组->成员.front().关系,
            *起始时间值, *结束时间值, 登记, 完整顶层.截止);
        if (!动态 || 动态->身份 != 请求.动态)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const auto 主体来源复核 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::当前, 动态->主体存在, 0});
        const auto 前状态来源复核 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, 动态->前状态, 0});
        const auto 后状态来源复核 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, 动态->后状态, 0});
        if (!主体来源复核.成功() || !前状态来源复核.成功()
            || !后状态来源复核.成功())
            return L2动态结构内部::形成完整读取失败(
                请求,
                !主体来源复核.成功()
                    ? (主体来源复核.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源复核.结果头.状态)
                : !前状态来源复核.成功()
                    ? (前状态来源复核.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 前状态来源复核.结果头.状态)
                    : (后状态来源复核.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 后状态来源复核.结果头.状态),
                std::max({主体来源复核.结果头.事实截止代次,
                    前状态来源复核.结果头.事实截止代次,
                    后状态来源复核.结果头.事实截止代次}));
        return {{L2结构合同版本, L2结构状态::已读取, 完整顶层.截止,
            std::nullopt}, 请求.读取类别, 0, std::move(动态),
            L2动态自有关系引用{族归属组->成员.front().关系.编码,
                完整主体组->成员.front().关系.编码,
                完整前状态组->成员.front().关系.编码,
                完整后状态组->成员.front().关系.编码}};
    }

    L2动态完整读取结果 读取历史完整动态(
        const L2动态完整读取请求& 请求,
        const L2动态结构类型登记& 登记) const {
        const auto 动态来源 = 读取动态身份来源({请求.请求头,
            L2读取类别::历史, 请求.动态, 请求.历史截止事实代次});
        if (!动态来源.成功() || !动态来源.身份来源)
            return L2动态结构内部::形成完整读取失败(请求,
                动态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 动态来源.结果头.状态,
                动态来源.结果头.事实截止代次);
        const auto 前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (前代次.状态 != L1中性读取状态::成功
            || 前代次.合同版本 != L1中性CRUD合同版本 || 前代次.事实代次 == 0)
            return L2动态结构内部::形成完整读取失败(请求,
                L2动态结构内部::映射事实代次探测失败(前代次.状态),
                前代次.事实代次);
        if (前代次.事实代次 != 请求.请求头.期望事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移, 前代次.事实代次);
        const auto 节点读取 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 请求.动态.值});
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 请求.动态.值)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点读取.状态 != L1所有者范围读取状态::成功) {
            if (节点读取.事实) return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            return L2动态结构内部::形成完整读取失败(请求,
                L2动态结构内部::映射历史读取动态(节点读取.状态),
                请求.历史截止事实代次);
        }
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (!节点 || 节点->编码 != 请求.动态.值
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点->创建事实代次 > 请求.历史截止事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::未找到, 请求.历史截止事实代次);
        const std::uint64_t 结构截止 = 节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次
            ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
        const auto 主体组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.动态.值, 登记.主体关系类型.值,
            结构截止});
        const auto 前状态组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.动态.值, 登记.前状态关系类型.值,
            结构截止});
        const auto 后状态组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.动态.值, 登记.后状态关系类型.值,
            结构截止});
        const auto 属性组 = L1_.读取所有者范围历史属性值组({L1所有者范围CRUD合同版本,
            请求.动态.值, 结构截止});
        if (主体组.状态 != L1所有者范围读取状态::成功
            || 前状态组.状态 != L1所有者范围读取状态::成功
            || 后状态组.状态 != L1所有者范围读取状态::成功
            || 属性组.状态 != L1所有者范围读取状态::成功) {
            const auto 动态 = 主体组.状态 != L1所有者范围读取状态::成功
                ? L2动态结构内部::映射历史关系组失败动态(主体组.状态)
                : 前状态组.状态 != L1所有者范围读取状态::成功
                    ? L2动态结构内部::映射历史关系组失败动态(前状态组.状态)
                : 后状态组.状态 != L1所有者范围读取状态::成功
                    ? L2动态结构内部::映射历史关系组失败动态(后状态组.状态)
                    : L2动态结构内部::映射历史属性组失败动态(属性组.状态);
            return L2动态结构内部::形成完整读取失败(
                请求, 动态, std::max({主体组.读取事实代次,
                    前状态组.读取事实代次, 后状态组.读取事实代次,
                    属性组.读取事实代次}));
        }
        if (主体组.读取事实代次 != 请求.请求头.期望事实代次
            || 前状态组.读取事实代次 != 请求.请求头.期望事实代次
            || 后状态组.读取事实代次 != 请求.请求头.期望事实代次
            || 属性组.读取事实代次 != 请求.请求头.期望事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移,
                std::max({主体组.读取事实代次,
                    前状态组.读取事实代次, 后状态组.读取事实代次,
                    属性组.读取事实代次}));
        if (主体组.关系组.size() != 1 || 前状态组.关系组.size() != 1
            || 后状态组.关系组.size() != 1
            || 属性组.属性值组.size() != 2)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const L1所有者范围值事实* 起始时间值 = nullptr;
        const L1所有者范围值事实* 结束时间值 = nullptr;
        for (const auto& 值 : 属性组.属性值组) {
            if (值.所属节点 != 请求.动态.值)
                return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) 起始时间值 = &值;
            else if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) 结束时间值 = &值;
            else return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        }
        if (!起始时间值 || !结束时间值)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const auto& 主体关系 = 主体组.关系组.front();
        const auto& 前状态关系 = 前状态组.关系组.front();
        const auto& 后状态关系 = 后状态组.关系组.front();
        const auto 族归属读取 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本,
                动态来源.身份来源->族归属关系稳定编码});
        const auto* 族归属关系 = 族归属读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*族归属读取.事实) : nullptr;
        const auto owner = 动态身份来源定位_.所有者;
        if (!族归属关系 || 节点->写入所有者 != owner
            || 族归属关系->写入所有者 != owner
            || 族归属关系->源节点 != 请求.动态.值
            || 族归属关系->目标节点 != 动态身份来源定位_.族锚点
            || 族归属关系->关系类型节点 != 动态身份来源定位_.族归属关系类型
            || 族归属关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 主体关系.写入所有者 != owner || 前状态关系.写入所有者 != owner
            || 后状态关系.写入所有者 != owner
            || 起始时间值->写入所有者 != owner || 结束时间值->写入所有者 != owner
            || 主体关系.源节点 != 请求.动态.值
            || 前状态关系.源节点 != 请求.动态.值
            || 后状态关系.源节点 != 请求.动态.值
            || 主体关系.关系类型节点 != 登记.主体关系类型.值
            || 前状态关系.关系类型节点 != 登记.前状态关系类型.值
            || 后状态关系.关系类型节点 != 登记.后状态关系类型.值
            || 主体关系.角色或顺序 != L2动态结构内部::动态端点角色值
            || 前状态关系.角色或顺序 != L2动态结构内部::动态端点角色值
            || 后状态关系.角色或顺序 != L2动态结构内部::动态端点角色值)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点->退出事实代次
            && *节点->退出事实代次 <= 请求.历史截止事实代次) {
            const auto 退出代次 = 节点->退出事实代次;
            if (动态来源.身份来源->节点生命周期.退出事实代次 != 退出代次
                || 动态来源.身份来源->归属关系生命周期.退出事实代次 != 退出代次
                || 族归属关系->退出事实代次 != 退出代次
                || 主体关系.退出事实代次 != 退出代次
                || 前状态关系.退出事实代次 != 退出代次
                || 后状态关系.退出事实代次 != 退出代次
                || 起始时间值->退出事实代次 != 退出代次
                || 结束时间值->退出事实代次 != 退出代次)
                return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        }
        const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::历史, L2存在身份{主体关系.目标节点},
            请求.历史截止事实代次});
        const auto 前状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::历史, L2状态身份{前状态关系.目标节点},
            请求.历史截止事实代次});
        const auto 后状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::历史, L2状态身份{后状态关系.目标节点},
            请求.历史截止事实代次});
        if (!主体来源.成功() || !前状态来源.成功() || !后状态来源.成功())
            return L2动态结构内部::形成完整读取失败(请求,
                L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 后代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (后代次.状态 != L1中性读取状态::成功
            || 后代次.合同版本 != L1中性CRUD合同版本
            || 后代次.事实代次 != 请求.请求头.期望事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, 后代次.状态 == L1中性读取状态::成功
                    ? L2结构状态::事实代次漂移
                    : L2动态结构内部::映射事实代次探测失败(后代次.状态),
                后代次.事实代次);
        auto 动态 = L2动态结构内部::形成动态事实(*节点, 主体关系,
            前状态关系, 后状态关系, *起始时间值, *结束时间值,
            登记, 请求.历史截止事实代次);
        if (!动态 || 动态->身份 != 请求.动态)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return {{L2结构合同版本, L2结构状态::已读取,
            请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
            请求.历史截止事实代次, std::move(动态),
            L2动态自有关系引用{动态来源.身份来源->族归属关系稳定编码,
                主体关系.编码, 前状态关系.编码, 后状态关系.编码}};
    }

    L2当前动态组读取结果 按端点读取动态组(
        const L2结构请求头& 请求头, 稳定编码 端点, 动态端点角色 角色) const {
        const auto 登记结果 = 读取当前动态结构类型登记();
        if (登记结果.状态 != L2动态结构类型登记状态::已读取
            || !登记结果.登记 || !登记结果.成功())
            return L2动态结构内部::形成组读取失败(
                L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                登记结果.事实截止代次);
        稳定编码 关系类型;
        switch (角色) {
        case 动态端点角色::主体:
            关系类型 = 登记结果.登记->主体关系类型.值;
            break;
        case 动态端点角色::前状态:
            关系类型 = 登记结果.登记->前状态关系类型.值;
            break;
        case 动态端点角色::后状态:
            关系类型 = 登记结果.登记->后状态关系类型.值;
            break;
        }
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 请求头.期望事实代次;
        请求.所有者 = {动态身份来源定位_.所有者};
        请求.目标关系组 = {{端点, 关系类型}};
        const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
        const auto 顶层 = L2动态结构内部::解释一致读取顶层(
            读取, 请求头.期望事实代次);
        if (!顶层.成功()) return L2动态结构内部::形成组读取失败(
            顶层.状态, 顶层.截止);
        const auto* 关系组 = L2动态结构内部::查找唯一目标关系组(
            读取, 端点, 关系类型);
        if (读取.所有者.size() != 1 || !读取.节点.empty()
            || !读取.关系.empty() || !读取.值.empty()
            || !读取.属性值.empty() || !读取.源关系组.empty()
            || 读取.目标关系组.size() != 1 || !关系组
            || 读取.所有者.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实)
            return L2动态结构内部::形成组读取失败(
                L2结构状态::内部不一致, 顶层.截止);
        std::vector<稳定编码> 动态编码组;
        for (const auto& 成员 : 关系组->成员) {
            const auto& 关系 = 成员.关系;
            if (关系.目标节点 != 端点 || 关系.关系类型节点 != 关系类型
                || 关系.角色或顺序 != L2动态结构内部::动态端点角色值
                || 关系.退出事实代次
                || !L2动态结构内部::普通当前节点完整(
                    成员.对端节点, 关系.源节点, 顶层.截止)
                || 关系.写入所有者 != 动态身份来源定位_.所有者
                || 成员.对端节点.写入所有者 != 动态身份来源定位_.所有者
                || std::find(动态编码组.begin(), 动态编码组.end(),
                    关系.源节点) != 动态编码组.end())
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            动态编码组.push_back(关系.源节点);
        }
        std::sort(动态编码组.begin(), 动态编码组.end());
        L2当前动态组读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
            顶层.截止, std::nullopt}, {}};
        结果.动态.reserve(动态编码组.size());
        for (const auto 编码 : 动态编码组) {
            const auto 单项 = 读取完整动态({请求头, L2读取类别::当前,
                L2动态身份{编码}, 0});
            if (单项.结果头.状态 != L2结构状态::已读取 || !单项.动态
                || 单项.结果头.事实截止代次 != 顶层.截止)
            {
                auto 失败状态 = 单项.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 单项.结果头.状态;
                auto 失败截止 = 单项.结果头.事实截止代次;
                if (失败状态 == L2结构状态::内部不一致) {
                    const auto 当前代次 = L1_.读取中性当前事实代次(
                        {L1中性CRUD合同版本});
                    if (当前代次.状态 == L1中性读取状态::成功
                        && 当前代次.事实代次 != 请求头.期望事实代次) {
                        失败状态 = L2结构状态::事实代次漂移;
                        失败截止 = 当前代次.事实代次;
                    }
                }
                return L2动态结构内部::形成组读取失败(失败状态, 失败截止);
            }
            const bool 角色匹配 = 角色 == 动态端点角色::主体
                ? 单项.动态->主体存在.值 == 端点
                : 角色 == 动态端点角色::前状态
                    ? 单项.动态->前状态.值 == 端点
                    : 单项.动态->后状态.值 == 端点;
            if (!角色匹配)
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            结果.动态.push_back(*单项.动态);
        }
        return 结果.成功() ? 结果 : L2动态结构内部::形成组读取失败(
            L2结构状态::内部不一致, 顶层.截止);
    }

    const L1事实基座服务& L1_;
    const L2存在结构服务& 存在服务_;
    const L2状态结构服务& 状态服务_;
    L1所有者范围写端口 第一层写入端口_;
    L2动态结构内部::动态身份来源定位 动态身份来源定位_;
    std::optional<L2动态结构类型登记> 结构类型登记定位_;
};

} // namespace 海中鱼巣
