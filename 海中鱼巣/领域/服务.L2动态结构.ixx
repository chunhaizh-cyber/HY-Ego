inline constexpr L1所有者范围建立幂等身份 动态所有者建立身份{
    0x4C31'4F57'4E45'5235ULL};

class L2动态所有者交付 final {
public:
    L2动态所有者交付() = delete;
    L2动态所有者交付(const L2动态所有者交付&) = delete;
    L2动态所有者交付& operator=(const L2动态所有者交付&) = delete;
    L2动态所有者交付(L2动态所有者交付&&) noexcept = default;
    L2动态所有者交付& operator=(L2动态所有者交付&&) = delete;

private:
    explicit L2动态所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2动态所有者交付> 尝试形成L2动态所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2动态结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2动态所有者交付> 尝试形成L2动态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept;

}

namespace 海中鱼巣::L2动态结构内部 {

inline constexpr std::uint64_t 动态结构类型登记幂等域 = 0x21ULL;
inline constexpr std::uint32_t 动态主体关系类型本地键值 = 0x0205'0101U;
inline constexpr std::uint32_t 动态前状态关系类型本地键值 = 0x0205'0102U;
inline constexpr std::uint32_t 动态后状态关系类型本地键值 = 0x0205'0103U;
inline constexpr std::uint32_t 动态起始I64值类型本地键值 = 0x0205'0201U;
inline constexpr std::uint32_t 动态起始I64组值类型本地键值 = 0x0205'0202U;
inline constexpr std::uint32_t 动态起始U64组值类型本地键值 = 0x0205'0203U;
inline constexpr std::uint32_t 动态起始独立材料值类型本地键值 = 0x0205'0204U;
inline constexpr std::uint32_t 动态结束I64值类型本地键值 = 0x0205'0301U;
inline constexpr std::uint32_t 动态结束I64组值类型本地键值 = 0x0205'0302U;
inline constexpr std::uint32_t 动态结束U64组值类型本地键值 = 0x0205'0303U;
inline constexpr std::uint32_t 动态结束独立材料值类型本地键值 = 0x0205'0304U;
inline constexpr std::uint32_t 动态节点本地键值 = 0x0205'1001U;
inline constexpr std::uint32_t 动态族归属关系本地键值 = 0x0205'1002U;
inline constexpr std::uint32_t 动态主体关系本地键值 = 0x0205'1101U;
inline constexpr std::uint32_t 动态前状态关系本地键值 = 0x0205'1102U;
inline constexpr std::uint32_t 动态后状态关系本地键值 = 0x0205'1103U;
inline constexpr std::uint32_t 动态起始值本地键值 = 0x0205'1201U;
inline constexpr std::uint32_t 动态结束值本地键值 = 0x0205'1202U;
inline constexpr std::int64_t 动态端点角色值 = 1;
inline constexpr L1所有者范围写入幂等身份 动态身份来源登记幂等身份{
    0x4C32'4944'5352'4305ULL};
inline constexpr std::uint32_t 动态族锚点本地键值 = 0x0205'2001U;
inline constexpr std::uint32_t 动态族归属关系类型本地键值 = 0x0205'2002U;
inline constexpr std::uint32_t 动态身份来源族归属关系本地键值 = 0x0205'2003U;
inline constexpr L1所有者范围写入幂等身份 动态上下文关系类型登记幂等身份{
    0x4C32'4459'4354'5801ULL};
inline constexpr std::uint32_t 动态上下文关系类型本地键值 = 0x0205'0401U;
inline constexpr std::uint64_t 动态关系式载荷魔数 = 0x4C32'4E44'5952'454CULL;

struct 动态上下文关系类型定位 final {
    稳定编码 关系类型{};
    std::uint64_t 建立事实代次 = 0;
};

// 诊断责任：向上送出；固定登记恢复只复用 L1 首次请求的原 G0。
std::uint64_t 读取固定登记期望代次(const L1事实基座服务& L1,
    L1所有者范围写端口& 端口,
    L1所有者范围写入幂等身份 幂等身份) {
    const auto 首次 = 端口.读取首次写入材料(
        {L1所有者范围首次写入读取合同版本, 幂等身份});
    if (首次.状态 == L1所有者范围读取状态::成功) {
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 端口.所有者身份()
            || 首次.写入幂等身份 != 幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果
            || 首次.首次规范化写集->写入幂等身份 != 幂等身份
            || 首次.首次规范化写集->期望事实代次 == 0
            || 首次.首次写入结果->所有者 != 端口.所有者身份()
            || 首次.首次写入结果->写入幂等身份 != 幂等身份
            || 首次.首次写入结果->事实代次 == 0)
            throw std::runtime_error(
                "L2 dynamic fixed registration first material invalid");
        return 首次.首次规范化写集->期望事实代次;
    }
    if (首次.状态 != L1所有者范围读取状态::未找到)
        throw std::runtime_error("L2 dynamic fixed registration first read failed");
    const auto 当前 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (当前.状态 != L1中性读取状态::成功 || 当前.事实代次 == 0)
        throw std::runtime_error("L2 dynamic fixed registration generation failed");
    return 当前.事实代次;
}

动态上下文关系类型定位 初始化动态上下文关系类型(
    const L1事实基座服务& L1, L1所有者范围写端口& 端口) {
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 读取固定登记期望代次(
        L1, 端口, 动态上下文关系类型登记幂等身份);
    写集.写入幂等身份 = 动态上下文关系类型登记幂等身份;
    写集.节点 = {{{动态上下文关系类型本地键值},
        节点种类::普通, std::nullopt}};
    const auto 写入 = 端口.提交所有者范围中性写集(写集);
    if ((写入.状态 != L1所有者范围写入状态::成功
            && 写入.状态 != L1所有者范围写入状态::精确重复)
        || 写入.新编码映射.size() != 1
        || 写入.新编码映射.front().first.值
            != 动态上下文关系类型本地键值
        || !有效(写入.新编码映射.front().second)
        || 写入.事实代次 == 0)
        throw std::runtime_error("L2 dynamic context relation registration failed");
    const auto 节点 = L1.读取所有者范围当前节点({
        L1所有者范围CRUD合同版本, 写入.新编码映射.front().second});
    const auto* 节点事实 = 节点.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点.事实) : nullptr;
    if (节点.状态 != L1所有者范围读取状态::成功 || !节点事实
        || 节点事实->编码 != 写入.新编码映射.front().second
        || 节点事实->种类 != 节点种类::普通
        || 节点事实->退出事实代次)
        throw std::runtime_error("L2 dynamic context relation readback failed");
    return {写入.新编码映射.front().second, 节点事实->创建事实代次};
}

struct 动态身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

L1所有者范围写入幂等身份 映射动态结构类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(动态结构类型登记幂等域 << 56) | 身份.值};
}

L1所有者范围写入幂等身份 映射动态幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

L1所有者范围原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1所有者范围独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2原始值材料 转换为L2材料(const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1所有者范围独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2结构状态 映射写入动态(L1所有者范围写入状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::未找到: return L2结构状态::未找到;
    case L1所有者范围写入状态::已退出: return L2结构状态::已退出;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射一致读取失败动态(
    L1所有者范围一致当前读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射当前项目动态(
    L1所有者范围一致当前读取项目状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史读取动态(L1所有者范围读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史关系组失败动态(
    L1所有者范围读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史属性组失败动态(
    L1所有者范围读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射来源值组读取失败动态(
    L1所有者范围来源当前值组读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围来源当前值组读取状态::入口拒绝:
        return L2结构状态::入口拒绝;
    case L1所有者范围来源当前值组读取状态::未找到:
        return L2结构状态::未找到;
    case L1所有者范围来源当前值组读取状态::已退出:
        return L2结构状态::已退出;
    case L1所有者范围来源当前值组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围来源当前值组读取状态::数量预算不足:
        return L2结构状态::数量预算不足;
    case L1所有者范围来源当前值组读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围来源当前值组读取状态::成功:
    case L1所有者范围来源当前值组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射属性类型值组读取失败动态(
    L1所有者范围属性类型当前值组读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围属性类型当前值组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围属性类型当前值组读取状态::数量预算不足:
        return L2结构状态::数量预算不足;
    case L1所有者范围属性类型当前值组读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围属性类型当前值组读取状态::成功:
    case L1所有者范围属性类型当前值组读取状态::入口拒绝:
    case L1所有者范围属性类型当前值组读取状态::未找到:
    case L1所有者范围属性类型当前值组读取状态::已退出:
    case L1所有者范围属性类型当前值组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2动态结构类型登记状态 映射登记写入动态(
    L1所有者范围写入状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围写入状态::成功: return L2动态结构类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2动态结构类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2动态结构类型登记状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2动态结构类型登记状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2动态结构类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2动态结构类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2动态结构类型登记状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::引用冲突:
    case L1所有者范围写入状态::内部不一致:
        return L2动态结构类型登记状态::内部不一致;
    }
    return L2动态结构类型登记状态::内部不一致;
}

L2动态结构类型登记状态 映射登记读取失败动态(
    L1所有者范围一致当前读取状态 动态) noexcept {
    switch (动态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2动态结构类型登记状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2动态结构类型登记状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2动态结构类型登记状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2动态结构类型登记状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2动态结构类型登记状态::内部不一致;
    }
    return L2动态结构类型登记状态::内部不一致;
}

L2结构状态 映射登记失败为结构动态(
    L2动态结构类型登记状态 动态) noexcept {
    switch (动态) {
    case L2动态结构类型登记状态::登记未加载:
    case L2动态结构类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2动态结构类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2动态结构类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2动态结构类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2动态结构类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2动态结构类型登记状态::已提交:
    case L2动态结构类型登记状态::精确重复:
    case L2动态结构类型登记状态::已读取:
    case L2动态结构类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2动态结构类型登记结果 形成登记失败(
    L2动态结构类型登记状态 动态, std::uint64_t 截止 = 0) noexcept {
    return {动态, 截止, std::nullopt};
}

L2动态写入结果 形成写入失败(
    L2结构状态 动态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 动态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

L2动态完整读取结果 形成完整读取失败(
    const L2动态完整读取请求& 请求, L2结构状态 动态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 动态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt, std::nullopt};
}

L2当前动态组读取结果 形成组读取失败(
    L2结构状态 动态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 动态, 截止, std::nullopt}, {}};
}

L2动态引用替换结果 形成引用替换失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt, std::nullopt};
}

L2动态时间值换代结果 形成时间值换代失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt, std::nullopt};
}

L2动态退出结果 形成动态退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt};
}

bool 写入成功边界完整(const L1所有者范围写入结果& 写入) noexcept {
    const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    return 写入.事实代次 != 0 && (首次 || 重复);
}

bool 历史关系匹配(const L1所有者范围关系事实& 关系,
    稳定编码 编码, 稳定编码 源, 稳定编码 目标, 稳定编码 类型,
    L1结构所有者身份 所有者, std::optional<std::uint64_t> 退出 = std::nullopt) noexcept {
    return 关系.编码 == 编码 && 关系.源节点 == 源 && 关系.目标节点 == 目标
        && 关系.关系类型节点 == 类型 && 关系.角色或顺序 == 动态端点角色值
        && 关系.写入所有者 == 所有者 && 关系.创建事实代次 != 0
        && (!退出 || 关系.退出事实代次 == 退出);
}

bool 动态未改字段相同(const L2动态事实& 左, const L2动态事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.来源稳定编码 == 右.来源稳定编码
        && 左.生命周期 == 右.生命周期;
}

std::optional<稳定编码> 查找编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

std::array<稳定编码, 11> 登记编码组(
    const L2动态结构类型登记& 登记) noexcept {
    return {登记.主体关系类型.值, 登记.前状态关系类型.值,
        登记.后状态关系类型.值,
        登记.起始I64值类型.值, 登记.起始I64组值类型.值,
        登记.起始U64组值类型.值, 登记.起始独立材料值类型.值,
        登记.结束I64值类型.值, 登记.结束I64组值类型.值,
        登记.结束U64组值类型.值, 登记.结束独立材料值类型.值};
}

std::optional<L2动态结构类型登记> 从写入形成登记(
    const L1所有者范围写入结果& 写入,
    const L2动态结构类型登记请求& 请求) noexcept {
    if (写入.新编码映射.size() != 11) return std::nullopt;
    const auto 主体 = 查找编码映射(写入, 动态主体关系类型本地键值);
    const auto 前状态 = 查找编码映射(写入, 动态前状态关系类型本地键值);
    const auto 后状态 = 查找编码映射(写入, 动态后状态关系类型本地键值);
    const auto 起始I64 = 查找编码映射(写入, 动态起始I64值类型本地键值);
    const auto 起始I64组 = 查找编码映射(写入, 动态起始I64组值类型本地键值);
    const auto 起始U64组 = 查找编码映射(写入, 动态起始U64组值类型本地键值);
    const auto 起始独立 = 查找编码映射(写入, 动态起始独立材料值类型本地键值);
    const auto 结束I64 = 查找编码映射(写入, 动态结束I64值类型本地键值);
    const auto 结束I64组 = 查找编码映射(写入, 动态结束I64组值类型本地键值);
    const auto 结束U64组 = 查找编码映射(写入, 动态结束U64组值类型本地键值);
    const auto 结束独立 = 查找编码映射(写入, 动态结束独立材料值类型本地键值);
    if (!主体 || !前状态 || !后状态 || !起始I64 || !起始I64组 || !起始U64组
        || !起始独立 || !结束I64 || !结束I64组 || !结束U64组 || !结束独立)
        return std::nullopt;
    L2动态结构类型登记 登记;
    登记.首次期望事实代次 = 请求.请求头.期望事实代次;
    登记.建立事实代次 = 写入.事实代次;
    登记.事实截止代次 = 写入.事实代次;
    登记.主体关系类型 = L2动态主体关系类型身份{*主体};
    登记.前状态关系类型 = L2动态前状态关系类型身份{*前状态};
    登记.后状态关系类型 = L2动态后状态关系类型身份{*后状态};
    登记.起始I64值类型 = L2动态起始I64值类型身份{*起始I64};
    登记.起始I64组值类型 = L2动态起始I64组值类型身份{*起始I64组};
    登记.起始U64组值类型 = L2动态起始U64组值类型身份{*起始U64组};
    登记.起始独立材料值类型 = L2动态起始独立材料值类型身份{*起始独立};
    登记.结束I64值类型 = L2动态结束I64值类型身份{*结束I64};
    登记.结束I64组值类型 = L2动态结束I64组值类型身份{*结束I64组};
    登记.结束U64组值类型 = L2动态结束U64组值类型身份{*结束U64组};
    登记.结束独立材料值类型 = L2动态结束独立材料值类型身份{*结束独立};
    return L2动态结构类型登记完整(登记)
        ? std::optional<L2动态结构类型登记>{登记} : std::nullopt;
}

bool 登记节点历史完整(const L1事实基座服务& 第一层服务,
    稳定编码 编码, 节点种类 种类,
    std::optional<L1所有者范围值表示种类> 表示, std::uint64_t 建立代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    return 读取.状态 == L1所有者范围读取状态::成功
        && 读取.合同版本 == L1所有者范围CRUD合同版本
        && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
        && 节点->种类 == 种类 && 节点->属性类型表示 == 表示
        && 节点->创建事实代次 == 建立代次 && !节点->退出事实代次
        && 节点->当前属性.empty();
}

bool 登记历史完整(const L1事实基座服务& 第一层服务,
    const L2动态结构类型登记& 登记) {
    const auto 编码 = 登记编码组(登记);
    const std::array<std::optional<L1所有者范围值表示种类>, 11> 表示 = {
        std::nullopt, std::nullopt, std::nullopt, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用};
    for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
        const auto 种类 = 索引 < 3 ? 节点种类::普通 : 节点种类::属性类型;
        if (!登记节点历史完整(
                第一层服务, 编码[索引], 种类, 表示[索引], 登记.建立事实代次))
            return false;
    }
    return true;
}

稳定编码 选择动态值类型编码(const L2动态结构类型登记& 登记,
    const L2原始值材料& 材料, bool 起始角色) noexcept {
    return std::visit([&](const auto& 值) noexcept -> 稳定编码 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, std::int64_t>)
            return 起始角色 ? 登记.起始I64值类型.值 : 登记.结束I64值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>)
            return 起始角色 ? 登记.起始I64组值类型.值 : 登记.结束I64组值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>)
            return 起始角色 ? 登记.起始U64组值类型.值 : 登记.结束U64组值类型.值;
        else return 起始角色 ? 登记.起始独立材料值类型.值
            : 登记.结束独立材料值类型.值;
    }, 材料);
}

bool 动态值类型与材料一致(const L2动态结构类型登记& 登记,
    稳定编码 类型编码, const L1所有者范围原始值材料& 材料, bool 起始角色) {
    return 选择动态值类型编码(登记, 转换为L2材料(材料), 起始角色)
        == 类型编码;
}

std::optional<L2属性事实> 形成截止属性事实(
    L1所有者范围值事实 值, const L2动态结构类型登记& 登记,
    std::uint64_t 截止, bool 起始角色) {
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    if (!动态值类型与材料一致(登记, 值.属性类型节点, 值.材料, 起始角色))
        return std::nullopt;
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

std::optional<L2动态事实> 形成动态事实(
    L1所有者范围节点事实 节点, L1所有者范围关系事实 主体关系,
    L1所有者范围关系事实 前状态关系, L1所有者范围关系事实 后状态关系,
    L1所有者范围值事实 起始时间值,
    L1所有者范围值事实 结束时间值, const L2动态结构类型登记& 登记,
    std::uint64_t 截止) {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (主体关系.退出事实代次 && *主体关系.退出事实代次 > 截止)
        主体关系.退出事实代次.reset();
    if (前状态关系.退出事实代次 && *前状态关系.退出事实代次 > 截止)
        前状态关系.退出事实代次.reset();
    if (后状态关系.退出事实代次 && *后状态关系.退出事实代次 > 截止)
        后状态关系.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || !有效(主体关系.编码) || !有效(前状态关系.编码)
        || !有效(后状态关系.编码)
        || 主体关系.编码 == 前状态关系.编码
        || 主体关系.编码 == 后状态关系.编码
        || 前状态关系.编码 == 后状态关系.编码
        || 主体关系.源节点 != 节点.编码
        || 前状态关系.源节点 != 节点.编码
        || 后状态关系.源节点 != 节点.编码
        || 主体关系.关系类型节点 != 登记.主体关系类型.值
        || 前状态关系.关系类型节点 != 登记.前状态关系类型.值
        || 后状态关系.关系类型节点 != 登记.后状态关系类型.值
        || 主体关系.角色或顺序 != 动态端点角色值
        || 前状态关系.角色或顺序 != 动态端点角色值
        || 后状态关系.角色或顺序 != 动态端点角色值
        || 主体关系.创建事实代次 < 节点.创建事实代次
        || 前状态关系.创建事实代次 < 节点.创建事实代次
        || 后状态关系.创建事实代次 < 节点.创建事实代次
        || 主体关系.创建事实代次 > 截止
        || 前状态关系.创建事实代次 > 截止
        || 后状态关系.创建事实代次 > 截止
        || 起始时间值.所属节点 != 节点.编码 || 结束时间值.所属节点 != 节点.编码
        || 起始时间值.创建事实代次 < 节点.创建事实代次
        || 结束时间值.创建事实代次 < 节点.创建事实代次
        || 起始时间值.创建事实代次 > 截止
        || 结束时间值.创建事实代次 > 截止)
        return std::nullopt;
    auto 起始属性 = 形成截止属性事实(起始时间值, 登记, 截止, true);
    auto 结束属性 = 形成截止属性事实(结束时间值, 登记, 截止, false);
    if (!起始属性 || !结束属性) return std::nullopt;
    L2动态事实 动态;
    动态.身份 = L2动态身份{节点.编码};
    动态.主体存在 = L2存在身份{主体关系.目标节点};
    动态.前状态 = L2状态身份{前状态关系.目标节点};
    动态.后状态 = L2状态身份{后状态关系.目标节点};
    动态.起始时间值 = std::move(*起始属性);
    动态.结束时间值 = std::move(*结束属性);
    动态.来源稳定编码 = 动态.起始时间值.来源稳定编码;
    动态.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return L2动态事实完整(动态, 登记, 截止)
        ? std::optional<L2动态事实>{std::move(动态)} : std::nullopt;
}

struct 一致读取顶层结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

一致读取顶层结果 解释一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取, std::uint64_t 期望) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望 && 读取.读取事实代次 == 期望
            && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次};
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    }
    const bool 空 = 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望 || !空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    return {映射一致读取失败动态(读取.状态), 读取.读取事实代次};
}

const L1所有者范围一致节点读取结果项* 查找唯一节点项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致源关系组读取结果项* 查找唯一源关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 源,
    稳定编码 类型) noexcept {
    const L1所有者范围一致源关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.源关系组) {
        if (项.源节点 != 源 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致目标关系组读取结果项* 查找唯一目标关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 目标,
    稳定编码 类型) noexcept {
    const L1所有者范围一致目标关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.目标关系组) {
        if (项.目标节点 != 目标 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致属性值读取结果项* 查找唯一属性项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 节点,
    稳定编码 类型) noexcept {
    const L1所有者范围一致属性值读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.属性值) {
        if (项.节点 != 节点 || 项.属性类型 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

bool 普通当前节点完整(const L1所有者范围节点事实& 节点,
    稳定编码 编码, std::uint64_t 截止) noexcept {
    return 节点.编码 == 编码 && 节点.种类 == 节点种类::普通
        && !节点.属性类型表示 && 节点.创建事实代次 != 0
        && 节点.创建事实代次 <= 截止 && !节点.退出事实代次;
}

L2结构状态 映射事实代次探测失败(L1中性读取状态 动态) noexcept {
    switch (动态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 检查端点结果头(const L2结构结果头& 结果头,
    std::uint64_t 期望) noexcept {
    if (结果头.状态 == L2结构状态::已读取) {
        return 结果头.事实截止代次 == 期望 && !结果头.变更事实代次
            ? L2结构状态::已读取 : L2结构状态::内部不一致;
    }
    if (结果头.变更事实代次) return L2结构状态::内部不一致;
    return 结果头.状态;
}

// 诊断责任：向上送出；来源登记任何结构化非成功都使服务构造失败。
动态身份来源定位 初始化动态身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 state owner fact is invalid");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读取.所有者事实->创建事实代次;
    写集.写入幂等身份 = 动态身份来源登记幂等身份;
    写集.节点 = {
        {{动态族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{动态族归属关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 动态身份来源登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 2)
        throw std::runtime_error("L2 state identity source initialization failed");
    稳定编码 锚点编码;
    稳定编码 类型编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) throw std::runtime_error("L2 state source mapping invalid");
        if (本地键.值 == 动态族锚点本地键值) 锚点编码 = 编码;
        else if (本地键.值 == 动态族归属关系类型本地键值) 类型编码 = 编码;
        else throw std::runtime_error("L2 state source mapping unknown");
    }
    if (!有效(锚点编码) || !有效(类型编码) || 锚点编码 == 类型编码)
        throw std::runtime_error("L2 state source mapping incomplete");
    const auto 核对节点 = [&](稳定编码 编码) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者 && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次 && !节点->退出事实代次;
    };
    if (!核对节点(锚点编码) || !核对节点(类型编码))
        throw std::runtime_error("L2 state source readback invalid");
    return {所有者, 锚点编码, 类型编码, 写入.事实代次};
}

} // namespace 海中鱼巣::L2动态结构内部

export namespace 海中鱼巣 {

std::optional<L2动态所有者交付> 尝试形成L2动态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 动态所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务)) return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2动态所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

bool L2中性动态上下文读取结果_v1::成功() const noexcept {
    if (结果头.合同版本 != L2中性状态动态合同版本_v1
        || 结果头.状态 != L2中性结构状态_v1::已读取
        || 结果头.事实截止代次 == 0 || 结果头.变更事实代次
        || !上下文 || !有效(上下文->动态.值)
        || !有效(上下文->主体存在.值) || !有效(上下文->共同场景.值)
        || !有效(上下文->被改变特征实例.值)
        || !有效(上下文->前状态.值) || !有效(上下文->后状态.值)
        || !有效(上下文->来源存在.值)
        || !有效(上下文->主体关系稳定编码)
        || !有效(上下文->场景关系稳定编码)
        || !有效(上下文->被改变目标关系稳定编码)
        || !有效(上下文->前状态关系稳定编码)
        || !有效(上下文->后状态关系稳定编码)
        || !有效(上下文->来源存在关系稳定编码)
        || 上下文->生命周期.创建事实代次 == 0
        || 上下文->生命周期.创建事实代次 > 结果头.事实截止代次)
        return false;
    if (上下文->类别 == L2中性动态记录类别_v1::状态迁移) {
        if (上下文->来源方法 || 上下文->同源状态迁移动能
            || 上下文->来源动作关系稳定编码
            || 上下文->同源迁移动能关系稳定编码)
            return false;
    } else if (上下文->类别 == L2中性动态记录类别_v1::动作致变) {
        if (!上下文->来源方法 || !有效(上下文->来源方法->值)
            || !上下文->同源状态迁移动能
            || !有效(上下文->同源状态迁移动能->值)
            || !上下文->来源动作关系稳定编码
            || !有效(*上下文->来源动作关系稳定编码)
            || !上下文->同源迁移动能关系稳定编码
            || !有效(*上下文->同源迁移动能关系稳定编码))
            return false;
    } else return false;
    if (读取类别 == L2读取类别::当前)
        return 历史截止事实代次 == 0
            && !上下文->生命周期.退出事实代次;
    return 读取类别 == L2读取类别::历史
        && 历史截止事实代次 != 0
        && 历史截止事实代次 <= 结果头.事实截止代次;
}

class L2动态结构服务 final {
public:
    explicit L2动态结构服务(const L1事实基座服务& L1,
        const L2存在结构服务& 存在服务,
        L2状态结构服务& 状态服务,
        L2动态所有者交付&& 动态所有者交付,
        L2中性实例材料保留策略_v1 保留策略 =
            L2中性实例材料默认保留策略_v1)
        : L1_(L1), 存在服务_(存在服务), 状态服务_(状态服务),
          第一层写入端口_(验证并移动交付(L1, 动态所有者交付)),
          动态身份来源定位_(L2动态结构内部::初始化动态身份来源(
              L1_, 第一层写入端口_)),
          中性动态提供者_(L1_, 第一层写入端口_, 状态服务_, 动态身份来源定位_,
              结构类型登记定位_, 动态上下文关系类型定位_, 保留策略) {
        if (!L2中性实例材料保留策略有效_v1(保留策略))
            throw std::invalid_argument("L2 neutral dynamic retention policy is invalid");
        const auto 登记幂等身份 =
            L2动态结构内部::映射动态结构类型登记幂等键(
                L2结构幂等身份{1});
        const auto 固定登记代次 = L2动态结构内部::读取固定登记期望代次(
            L1_, 第一层写入端口_, 登记幂等身份);
        const auto 登记 = 建立动态结构类型登记(
            {{L2结构合同版本, 固定登记代次},
                L2动态结构类型登记规则版本, L2结构幂等身份{1}});
        if (!登记.成功()) throw std::runtime_error("L2 state type registration failed");
        动态上下文关系类型定位_ =
            L2动态结构内部::初始化动态上下文关系类型(
                L1_, 第一层写入端口_);
    }
    L2动态结构服务(const L2动态结构服务&) = delete;
    L2动态结构服务& operator=(const L2动态结构服务&) = delete;

    L2中性动态写入结果_v1 新增中性动态_v1(
        const L2中性动态新增请求_v1& 请求) noexcept {
        return 中性动态提供者_.新增动态(请求);
    }

    L2中性动态读取结果_v1 读取中性动态_v1(
        const L2中性动态读取请求_v1& 请求) const noexcept {
        const auto legacy = 中性动态提供者_.读取动态(请求);
        if (legacy.成功()
            || legacy.结果头.状态 != L2中性结构状态_v1::内部错误)
            return legacy;
        const auto 失败 = [&](L2中性结构状态_v1 状态,
            std::uint64_t 截止 = 0) {
            return L2中性动态读取结果_v1{{
                    L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次,
                std::nullopt, {}, std::nullopt};
        };
        if (!L2中性动态读取请求有效_v1(请求) || !结构类型登记定位_)
            return 失败(L2中性结构状态_v1::入口拒绝);
        try {
            const auto 前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (前.状态 != L1中性读取状态::成功 || 前.事实代次 == 0)
                return 失败(前.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误);
            if (前.事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2中性结构状态_v1::事实代次漂移, 前.事实代次);
            const auto 材料截止 = 请求.读取类别 == L2读取类别::当前
                ? 前.事实代次 : 请求.历史截止事实代次;
            std::uint64_t 创建代次 = 0;
            std::optional<std::uint64_t> 退出代次;
            std::optional<稳定编码> 载荷身份;
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 节点 = L1_.读取中性当前节点({
                    L1中性CRUD合同版本, 请求.动态.值});
                if (节点.状态 != L1中性读取状态::成功 || !节点.事实
                    || 节点.读取事实代次 != 前.事实代次
                    || 节点.事实->退出事实代次
                    || 节点.事实->当前属性.size() != 1)
                    return 失败(节点.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                创建代次 = 节点.事实->创建事实代次;
                载荷身份 = 节点.事实->当前属性.front().当前值;
            } else {
                const auto 节点读取 = L1_.读取中性历史事实({
                    L1中性CRUD合同版本, 请求.动态.值});
                const auto* 节点 = 节点读取.事实
                    ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
                if (节点读取.状态 != L1中性读取状态::成功 || !节点
                    || 节点->创建事实代次 > 材料截止)
                    return 失败(节点读取.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                创建代次 = 节点->创建事实代次;
                退出代次 = 节点->退出事实代次;
                const auto 值组 = L1_.读取中性历史属性值组({
                    L1中性CRUD合同版本, 请求.动态.值, 材料截止});
                if (值组.状态 != L1中性历史属性值组读取状态::成功
                    || 值组.读取事实代次 != 前.事实代次)
                    return 失败(值组.状态
                            == L1中性历史属性值组读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                for (const auto& 值 : 值组.属性值组)
                    if (值.属性类型节点
                            == 结构类型登记定位_->起始U64组值类型.值) {
                        if (载荷身份)
                            return 失败(L2中性结构状态_v1::内部错误,
                                前.事实代次);
                        载荷身份 = 值.编码;
                    }
            }
            if (!载荷身份)
                return 失败(L2中性结构状态_v1::内部错误, 前.事实代次);
            std::optional<L1中性值事实> 载荷事实;
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 值 = L1_.读取中性当前值({
                    L1中性CRUD合同版本, *载荷身份});
                if (值.状态 == L1中性读取状态::成功 && 值.事实)
                    载荷事实 = *值.事实;
            } else {
                const auto 值 = L1_.读取中性历史事实({
                    L1中性CRUD合同版本, *载荷身份});
                if (值.状态 == L1中性读取状态::成功 && 值.事实)
                    if (const auto* 事实 = std::get_if<L1中性值事实>(&*值.事实))
                        载荷事实 = *事实;
            }
            const auto* 载荷 = 载荷事实
                ? std::get_if<std::vector<std::uint64_t>>(&载荷事实->材料)
                : nullptr;
            if (!载荷 || 载荷->size() != 4
                || (*载荷)[0] != L2动态结构内部::动态关系式载荷魔数
                || (*载荷)[1] != L2中性状态动态合同版本_v1
                || ((*载荷)[2] != static_cast<std::uint64_t>(
                        L2中性动态记录类别_v1::状态迁移)
                    && (*载荷)[2] != static_cast<std::uint64_t>(
                        L2中性动态记录类别_v1::动作致变)))
                return 失败(L2中性结构状态_v1::内部错误, 前.事实代次);

            std::vector<L1中性关系事实> 关系组;
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 读 = L1_.读取中性当前源关系组({
                    L1中性CRUD合同版本, 请求.动态.值,
                    动态上下文关系类型定位_.关系类型});
                if (读.状态 != L1中性读取状态::成功
                    || 读.读取事实代次 != 前.事实代次)
                    return 失败(读.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                关系组 = 读.关系组;
            } else {
                const auto 读 = L1_.读取中性历史关系组({
                    L1中性CRUD合同版本, L1中性关系端点方向::源,
                    请求.动态.值, 动态上下文关系类型定位_.关系类型,
                    材料截止});
                if (读.状态 != L1中性历史关系组读取状态::成功
                    || 读.读取事实代次 != 前.事实代次)
                    return 失败(读.状态
                            == L1中性历史关系组读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                关系组 = 读.关系组;
            }
            std::optional<L2状态身份> 前状态;
            std::optional<L2状态身份> 后状态;
            for (const auto& 关系 : 关系组) {
                if (关系.源节点 != 请求.动态.值
                    || 关系.关系类型节点
                        != 动态上下文关系类型定位_.关系类型)
                    return 失败(L2中性结构状态_v1::动态不闭合,
                        前.事实代次);
                if (关系.角色或顺序 == 4) {
                    if (前状态) return 失败(
                        L2中性结构状态_v1::动态不闭合, 前.事实代次);
                    前状态 = L2状态身份{关系.目标节点};
                } else if (关系.角色或顺序 == 5) {
                    if (后状态) return 失败(
                        L2中性结构状态_v1::动态不闭合, 前.事实代次);
                    后状态 = L2状态身份{关系.目标节点};
                }
            }
            if (!前状态 || !后状态 || *前状态 == *后状态)
                return 失败(L2中性结构状态_v1::动态不闭合, 前.事实代次);
            const auto 前读 = 状态服务_.读取中性状态_v1({请求.请求头,
                L2中性状态动态合同版本_v1, 请求.读取类别, *前状态,
                请求.历史截止事实代次});
            const auto 后读 = 状态服务_.读取中性状态_v1({请求.请求头,
                L2中性状态动态合同版本_v1, 请求.读取类别, *后状态,
                请求.历史截止事实代次});
            if (!前读.成功() || !后读.成功() || !前读.状态 || !后读.状态
                || 前读.状态->材料类别 != L2中性材料类别_v1::实例
                || 后读.状态->材料类别 != L2中性材料类别_v1::实例
                || 前读.状态->时间.语义
                    != L2中性时间语义_v1::绝对UTC纳秒
                || 后读.状态->时间.语义
                    != L2中性时间语义_v1::绝对UTC纳秒
                || 后读.状态->时间.纳秒 < 前读.状态->时间.纳秒)
                return 失败(L2中性结构状态_v1::动态不闭合, 前.事实代次);
            L2中性动态事实_v1 动态{请求.动态,
                L2中性材料类别_v1::实例,
                L2中性时间语义_v1::绝对UTC纳秒,
                {{1, *前状态}, {2, *后状态}},
                std::bit_cast<std::int64_t>((*载荷)[3]), 创建代次};
            const auto 后 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (后.状态 != L1中性读取状态::成功
                || 后.事实代次 != 前.事实代次)
                return 失败(后.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::事实代次漂移, 后.事实代次);
            L2中性动态读取结果_v1 结果{{
                    L2中性状态动态合同版本_v1,
                    L2中性结构状态_v1::已读取, 前.事实代次,
                    std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(动态),
                {*前读.状态, *后读.状态}, std::nullopt};
            return 结果.成功() ? 结果
                : 失败(L2中性结构状态_v1::内部错误, 前.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (...) {
            return 失败(L2中性结构状态_v1::内部错误);
        }
    }

    L2中性动态上下文读取结果_v1 读取中性动态上下文_v1(
        const L2中性动态上下文读取请求_v1& 请求) const noexcept {
        const auto 失败 = [&](L2中性结构状态_v1 状态) {
            return L2中性动态上下文读取结果_v1{{
                L2中性状态动态合同版本_v1, 状态, 0, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        };
        if (请求.专属合同版本 != L2中性状态动态合同版本_v1
            || !L2结构请求头合同有效(请求.请求头)
            || 请求.请求头.期望事实代次 == 0 || !有效(请求.动态.值)
            || (请求.读取类别 == L2读取类别::当前
                && 请求.历史截止事实代次 != 0)
            || (请求.读取类别 == L2读取类别::历史
                && (请求.历史截止事实代次 == 0
                    || 请求.历史截止事实代次
                        > 请求.请求头.期望事实代次)))
            return 失败(L2中性结构状态_v1::入口拒绝);
        try {
            const auto 前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (前.状态 != L1中性读取状态::成功 || 前.事实代次 == 0)
                return 失败(前.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误);
            if (前.事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2中性结构状态_v1::事实代次漂移);
            const auto 动态读取 = 读取中性动态_v1({请求.请求头,
                L2中性状态动态合同版本_v1, 请求.读取类别,
                请求.动态, 请求.历史截止事实代次});
            if (!动态读取.成功() || !动态读取.动态)
                return 失败(动态读取.结果头.状态);
            std::vector<L1中性关系事实> 关系组;
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 读 = L1_.读取中性当前源关系组({
                    L1中性CRUD合同版本, 请求.动态.值,
                    动态上下文关系类型定位_.关系类型});
                if (读.状态 != L1中性读取状态::成功
                    || 读.读取事实代次 != 请求.请求头.期望事实代次)
                    return 失败(读.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误);
                关系组 = 读.关系组;
            } else {
                const auto 读 = L1_.读取中性历史关系组({
                    L1中性CRUD合同版本, L1中性关系端点方向::源,
                    请求.动态.值, 动态上下文关系类型定位_.关系类型,
                    请求.历史截止事实代次});
                if (读.状态 != L1中性历史关系组读取状态::成功
                    || 读.读取事实代次 != 请求.请求头.期望事实代次)
                    return 失败(读.状态
                            == L1中性历史关系组读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误);
                关系组 = 读.关系组;
            }
            if (关系组.size() != 6 && 关系组.size() != 8)
                return 失败(L2中性结构状态_v1::动态不闭合);
            L2中性动态上下文事实_v1 上下文;
            上下文.动态 = 请求.动态;
            上下文.生命周期 = {动态读取.动态->形成事实代次, std::nullopt};
            bool 角色[10]{};
            for (const auto& 关系 : 关系组) {
                const auto 角色值 = 关系.角色或顺序;
                if (关系.源节点 != 请求.动态.值
                    || 关系.关系类型节点
                        != 动态上下文关系类型定位_.关系类型
                    || 关系.退出事实代次 || 角色值 < 1 || 角色值 > 9
                    || 角色值 == 7 || 角色[角色值])
                    return 失败(L2中性结构状态_v1::动态不闭合);
                角色[角色值] = true;
                switch (角色值) {
                case 1: 上下文.主体存在 = L2存在身份{关系.目标节点};
                    上下文.主体关系稳定编码 = 关系.编码; break;
                case 2: 上下文.共同场景 = L2场景身份{关系.目标节点};
                    上下文.场景关系稳定编码 = 关系.编码; break;
                case 3: 上下文.被改变特征实例 =
                    L2特征实例身份{关系.目标节点};
                    上下文.被改变目标关系稳定编码 = 关系.编码; break;
                case 4: 上下文.前状态 = L2状态身份{关系.目标节点};
                    上下文.前状态关系稳定编码 = 关系.编码; break;
                case 5: 上下文.后状态 = L2状态身份{关系.目标节点};
                    上下文.后状态关系稳定编码 = 关系.编码; break;
                case 6: 上下文.来源方法 = L2方法身份{关系.目标节点};
                    上下文.来源动作关系稳定编码 = 关系.编码; break;
                case 8: 上下文.同源状态迁移动能 =
                    L2动态身份{关系.目标节点};
                    上下文.同源迁移动能关系稳定编码 = 关系.编码; break;
                case 9: 上下文.来源存在 = L2存在身份{关系.目标节点};
                    上下文.来源存在关系稳定编码 = 关系.编码; break;
                }
            }
            if (!角色[1] || !角色[2] || !角色[3] || !角色[4]
                || !角色[5] || !角色[9])
                return 失败(L2中性结构状态_v1::动态不闭合);
            上下文.类别 = 角色[6] && 角色[8]
                ? L2中性动态记录类别_v1::动作致变
                : L2中性动态记录类别_v1::状态迁移;
            if (角色[6] != 角色[8])
                return 失败(L2中性结构状态_v1::动态不闭合);
            const auto 后 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (后.状态 != L1中性读取状态::成功
                || 后.事实代次 != 请求.请求头.期望事实代次)
                return 失败(后.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::事实代次漂移);
            L2中性动态上下文读取结果_v1 结果{{
                L2中性状态动态合同版本_v1, L2中性结构状态_v1::已读取,
                请求.请求头.期望事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(上下文)};
            return 结果.成功() ? 结果 : 失败(L2中性结构状态_v1::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (...) {
            return 失败(L2中性结构状态_v1::内部错误);
        }
    }

    L2中性动态退出结果_v1 退出中性动态_v1(
        const L2中性动态退出请求_v1& 请求) noexcept {
        return 中性动态提供者_.退出动态(请求);
    }

    L2中性实例材料清理结果_v1 执行中性实例材料清理_v1(
        const L2中性实例材料清理请求_v1& 请求) noexcept {
        return 中性动态提供者_.执行实例材料清理(请求);
    }

    // 仅供 ARCH-L2 组合 provider 绑定非拥有参与者引用。
    L1所有者范围写端口& 取得组合发布写入端口() noexcept {
        return 第一层写入端口_;
    }

    const L1所有者范围写端口& 取得组合发布写入端口() const noexcept {
        return 第一层写入端口_;
    }

    struct 当前值记录动态参与者结果_v1 final {
        L2结构状态 状态 = L2结构状态::内部不一致;
        std::optional<L1三分区原子参与者写集_v2> 参与者{};
        L1所有者范围写集本地键 状态迁移动能本地键{};
        std::optional<L1所有者范围写集本地键> 动作致变动态本地键{};
    };

    bool 组合发布当前值动态材料就绪_v1() const noexcept {
        return 结构类型登记定位_.has_value()
            && 有效(动态上下文关系类型定位_.关系类型);
    }

    L2动态结构类型登记结果 建立动态结构类型登记(
        const L2动态结构类型登记请求& 请求) {
        try {
            if (!L2动态结构类型登记请求有效(请求))
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::入口拒绝);
            if (结构类型登记定位_) {
                if (!L2动态结构类型登记完整(*结构类型登记定位_))
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::内部不一致);
                if (结构类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 结构类型登记定位_->规则版本 != 请求.规则版本
                    || 结构类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 结构类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::幂等冲突);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2动态结构内部::映射动态结构类型登记幂等键(
                请求.幂等身份);
            写集.节点 = {
                {{L2动态结构内部::动态主体关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2动态结构内部::动态前状态关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2动态结构内部::动态后状态关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2动态结构内部::动态起始I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2动态结构内部::动态起始I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2动态结构内部::动态起始U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2动态结构内部::动态起始独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用},
                {{L2动态结构内部::动态结束I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2动态结构内部::动态结束I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2动态结构内部::动态结束U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2动态结构内部::动态结束独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 写入.事实代次);
            const auto 登记状态 = L2动态结构内部::映射登记写入动态(写入.状态);
            if (登记状态 != L2动态结构类型登记状态::已提交
                && 登记状态 != L2动态结构类型登记状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::内部不一致, 写入.事实代次);
                return L2动态结构内部::形成登记失败(登记状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            auto 登记 = L2动态结构内部::从写入形成登记(写入, 请求);
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !登记
                || !L2动态结构内部::登记历史完整(L1_, *登记))
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 写入.事实代次);
            if (结构类型登记定位_ && *结构类型登记定位_ != *登记)
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 写入.事实代次);
            结构类型登记定位_ = *登记;
            L2动态结构类型登记结果 结果{登记状态, 写入.事实代次, std::move(登记)};
            return 结果.成功() ? 结果 : L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::内部不一致);
        }
    }

    L2动态结构类型登记结果 读取当前动态结构类型登记() const {
        try {
            if (!结构类型登记定位_)
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::登记未加载);
            if (!L2动态结构类型登记完整(*结构类型登记定位_))
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致);
            auto 事实截止代次 = 结构类型登记定位_->事实截止代次;
            if (事实截止代次 == 0)
                return L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致);
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const auto 编码 = L2动态结构内部::登记编码组(*结构类型登记定位_);
                L1所有者范围一致当前读取请求 请求;
                请求.合同版本 = L1所有者范围一致当前读取合同版本;
                请求.期望事实代次 = 事实截止代次;
                请求.节点.assign(编码.begin(), 编码.end());
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
                const auto 顶层 = L2动态结构内部::解释一致读取顶层(
                    读取, 请求.期望事实代次);
                if (!顶层.成功()) {
                    if (顶层.状态 == L2结构状态::事实代次漂移 && 尝试 == 0) {
                        事实截止代次 = 顶层.截止;
                        continue;
                    }
                    const auto 登记动态 = 顶层.状态 == L2结构状态::入口拒绝
                        ? L2动态结构类型登记状态::入口拒绝
                        : 顶层.状态 == L2结构状态::许可拒绝
                            ? L2动态结构类型登记状态::许可拒绝
                        : 顶层.状态 == L2结构状态::事实代次漂移
                            ? L2动态结构类型登记状态::事实代次漂移
                        : 顶层.状态 == L2结构状态::资源失败
                            ? L2动态结构类型登记状态::资源失败
                            : L2动态结构类型登记状态::内部不一致;
                    return L2动态结构内部::形成登记失败(登记动态, 顶层.截止);
                }
                if (读取.节点.size() != 编码.size() || !读取.关系.empty()
                    || !读取.值.empty() || !读取.属性值.empty()
                    || !读取.源关系组.empty() || !读取.目标关系组.empty())
                    return L2动态结构内部::形成登记失败(
                        L2动态结构类型登记状态::内部不一致, 顶层.截止);
                const std::array<std::optional<L1所有者范围值表示种类>, 11> 表示 = {
                    std::nullopt, std::nullopt, std::nullopt,
                    L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用};
                for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
                    const auto* 项 = L2动态结构内部::查找唯一节点项(读取, 编码[索引]);
                    const auto 种类 = 索引 < 3 ? 节点种类::普通 : 节点种类::属性类型;
                    if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                        || !项->事实 || 项->事实->编码 != 编码[索引]
                        || 项->事实->种类 != 种类
                        || 项->事实->属性类型表示 != 表示[索引]
                        || 项->事实->创建事实代次
                            != 结构类型登记定位_->建立事实代次
                        || 项->事实->退出事实代次 || !项->事实->当前属性.empty())
                        return L2动态结构内部::形成登记失败(
                            L2动态结构类型登记状态::内部不一致, 顶层.截止);
                }
                auto 登记 = *结构类型登记定位_;
                登记.事实截止代次 = 顶层.截止;
                L2动态结构类型登记结果 结果{
                    L2动态结构类型登记状态::已读取, 顶层.截止, 登记};
                return 结果.成功() ? 结果 : L2动态结构内部::形成登记失败(
                    L2动态结构类型登记状态::内部不一致, 顶层.截止);
            }
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::事实代次漂移, 事实截止代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成登记失败(
                L2动态结构类型登记状态::内部不一致);
        }
    }

    L2动态写入结果 新增动态(const L2动态新增请求& 请求) {
        if (!L2动态新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (登记结果.状态 != L2动态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2动态结构内部::形成写入失败(
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 起始类型 = L2动态结构内部::选择动态值类型编码(
                登记, 请求.起始时间材料, true);
            const auto 结束类型 = L2动态结构内部::选择动态值类型编码(
                登记, 请求.结束时间材料, false);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2动态结构内部::映射动态幂等键(请求.幂等身份);
            写集.节点 = {{{L2动态结构内部::动态节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2动态结构内部::动态族归属关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    动态身份来源定位_.族锚点,
                    动态身份来源定位_.族归属关系类型,
                    L2动态结构内部::动态端点角色值},
                {{L2动态结构内部::动态主体关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    请求.主体存在.值, 登记.主体关系类型.值,
                    L2动态结构内部::动态端点角色值},
                {{L2动态结构内部::动态前状态关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    请求.前状态.值, 登记.前状态关系类型.值,
                    L2动态结构内部::动态端点角色值},
                {{L2动态结构内部::动态后状态关系本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    请求.后状态.值, 登记.后状态关系类型.值,
                    L2动态结构内部::动态端点角色值}};
            写集.值 = {
                {{L2动态结构内部::动态起始值本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    起始类型, L2动态结构内部::转换为L1材料(请求.起始时间材料),
                    请求.来源稳定编码},
                {{L2动态结构内部::动态结束值本地键值},
                    L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    结束类型, L2动态结构内部::转换为L1材料(请求.结束时间材料),
                    请求.来源稳定编码}};
            写集.属性槽变更 = {
                {L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    起始类型,
                    L1所有者范围写集本地键{L2动态结构内部::动态起始值本地键值}},
                {L1所有者范围写集本地键{L2动态结构内部::动态节点本地键值},
                    结束类型,
                    L1所有者范围写集本地键{L2动态结构内部::动态结束值本地键值}}};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2动态结构内部::形成写入失败(
                    L2动态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.主体存在, 0});
                if (!主体来源.成功() || !主体来源.身份来源
                    || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值)
                    return L2动态结构内部::形成写入失败(
                        主体来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 主体来源.结果头.状态,
                        主体来源.结果头.事实截止代次);
                const auto 前状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                    L2读取类别::当前, 请求.前状态, 0});
                if (!前状态来源.成功() || !前状态来源.身份来源
                    || 前状态来源.身份来源->节点稳定编码 != 请求.前状态.值)
                    return L2动态结构内部::形成写入失败(
                        前状态来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 前状态来源.结果头.状态,
                        前状态来源.结果头.事实截止代次);
                const auto 后状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                    L2读取类别::当前, 请求.后状态, 0});
                if (!后状态来源.成功() || !后状态来源.身份来源
                    || 后状态来源.身份来源->节点稳定编码 != 请求.后状态.值)
                    return L2动态结构内部::形成写入失败(
                        后状态来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 后状态来源.结果头.状态,
                        后状态来源.结果头.事实截止代次);
            }
            return 提交并读回新增动态(写集, 请求, 登记);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成写入失败(L2结构状态::内部不一致);
        }
    }

    L2动态完整读取结果 读取完整动态(
        const L2动态完整读取请求& 请求) const {
        if (!L2动态完整读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (登记结果.状态 != L2动态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2动态结构内部::形成完整读取失败(请求,
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            return 请求.读取类别 == L2读取类别::当前
                ? 读取当前完整动态(请求, *登记结果.登记)
                : 读取历史完整动态(请求, *登记结果.登记);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前来源由 owner、锚点和唯一非自环归属同截止证明。
    L2动态身份来源读取结果 读取动态身份来源(
        const L2动态身份来源读取请求& 请求) const {
        if (!L2动态身份来源读取请求有效(请求)) return {};
        try {
            if (请求.动态.值 == 动态身份来源定位_.族锚点
                || 请求.动态.值 == 动态身份来源定位_.族归属关系类型)
                return {{L2结构合同版本, L2结构状态::入口拒绝,
                    请求.读取类别 == L2读取类别::当前
                        ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次,
                    std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (请求.读取类别 == L2读取类别::当前) {
                L1所有者范围一致当前读取请求 L1请求;
                L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
                L1请求.期望事实代次 = 请求.请求头.期望事实代次;
                L1请求.所有者 = {动态身份来源定位_.所有者};
                L1请求.节点 = {请求.动态.值, 动态身份来源定位_.族锚点,
                    动态身份来源定位_.族归属关系类型};
                L1请求.源关系组 = {{请求.动态.值,
                    动态身份来源定位_.族归属关系类型}};
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
                const auto 顶层 = L2动态结构内部::解释一致读取顶层(
                    读取, 请求.请求头.期望事实代次);
                if (!顶层.成功()) return {{L2结构合同版本, 顶层.状态,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (读取.所有者.size() != 1 || 读取.节点.size() != 3
                    || !读取.关系.empty() || !读取.值.empty()
                    || !读取.属性值.empty() || 读取.源关系组.size() != 1
                    || !读取.目标关系组.empty())
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto* 节点项 = L2动态结构内部::查找唯一节点项(
                    读取, 请求.动态.值);
                const auto* 锚点项 = L2动态结构内部::查找唯一节点项(
                    读取, 动态身份来源定位_.族锚点);
                const auto* 类型项 = L2动态结构内部::查找唯一节点项(
                    读取, 动态身份来源定位_.族归属关系类型);
                const auto* 关系组 = L2动态结构内部::查找唯一源关系组(
                    读取, 请求.动态.值, 动态身份来源定位_.族归属关系类型);
                if (!节点项 || !锚点项 || !类型项 || !关系组)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
                    const auto 动态 = 节点项->状态
                            == L1所有者范围一致当前读取项目状态::未找到
                        ? L2结构状态::未找到
                        : 节点项->状态
                            == L1所有者范围一致当前读取项目状态::已退出
                            ? L2结构状态::已退出 : L2结构状态::入口拒绝;
                    return {{L2结构合同版本, 节点项->事实
                            ? L2结构状态::内部不一致 : 动态,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                }
                if (!节点项->事实 || !锚点项->事实 || !类型项->事实
                    || 读取.所有者.front().状态
                        != L1所有者范围一致当前读取项目状态::成功
                    || !读取.所有者.front().所有者事实 || 关系组->成员.size() != 1)
                    return {{L2结构合同版本, 关系组->成员.empty()
                            ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 节点 = *节点项->事实;
                const auto& 锚点 = *锚点项->事实;
                const auto& 类型 = *类型项->事实;
                const auto& 关系 = 关系组->成员.front().关系;
                if (节点.写入所有者 != 动态身份来源定位_.所有者
                    || 节点.种类 != 节点种类::普通 || 节点.属性类型表示
                    || 节点.退出事实代次 || 锚点.编码 != 动态身份来源定位_.族锚点
                    || 类型.编码 != 动态身份来源定位_.族归属关系类型
                    || 锚点.写入所有者 != 动态身份来源定位_.所有者
                    || 类型.写入所有者 != 动态身份来源定位_.所有者
                    || 关系.写入所有者 != 动态身份来源定位_.所有者
                    || 关系.源节点 != 请求.动态.值
                    || 关系.目标节点 != 动态身份来源定位_.族锚点
                    || 关系.关系类型节点 != 动态身份来源定位_.族归属关系类型
                    || 关系.角色或顺序 != L2动态结构内部::动态端点角色值
                    || 关系.退出事实代次 || 关系.创建事实代次 != 节点.创建事实代次)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 所有者 = *读取.所有者.front().所有者事实;
                if (所有者.所有者 != 动态身份来源定位_.所有者
                    || 所有者.范围种类 != L1所有者范围种类::独占结构范围
                    || 所有者.退出事实代次)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                L2节点族身份来源事实 来源{L2节点族::动态, 节点.编码,
                    锚点.编码, 类型.编码, 关系.编码, 关系.角色或顺序,
                    {节点.创建事实代次, 节点.退出事实代次},
                    {锚点.创建事实代次, 锚点.退出事实代次},
                    {类型.创建事实代次, 类型.退出事实代次},
                    {关系.创建事实代次, 关系.退出事实代次}};
                L2动态身份来源读取结果 结果{{L2结构合同版本,
                    L2结构状态::已读取, 顶层.截止, std::nullopt},
                    请求.读取类别, 0, std::move(来源)};
                return 结果.成功() ? 结果 : L2动态身份来源读取结果{{
                    L2结构合同版本, L2结构状态::内部不一致,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
            }
            const auto 当前代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 != 请求.请求头.期望事实代次)
                return {{L2结构合同版本,
                    当前代次.状态 == L1中性读取状态::成功
                        ? L2结构状态::事实代次漂移
                        : L2动态结构内部::映射事实代次探测失败(当前代次.状态),
                    当前代次.事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 节点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.动态.值});
            const auto 所有者读取 = L1_.读取历史结构所有者(
                {L1所有者范围CRUD合同版本, 动态身份来源定位_.所有者});
            const auto 锚点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 动态身份来源定位_.族锚点});
            const auto 类型读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 动态身份来源定位_.族归属关系类型});
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
            const auto* 锚点 = 锚点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
            const auto* 类型 = 类型读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
            if (节点读取.状态 != L1所有者范围读取状态::成功)
                return {{L2结构合同版本,
                    L2动态结构内部::映射历史读取动态(节点读取.状态),
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (!节点 || !锚点 || !类型 || !所有者读取.所有者事实
                || 所有者读取.所有者事实->所有者 != 动态身份来源定位_.所有者
                || 所有者读取.所有者事实->范围种类
                    != L1所有者范围种类::独占结构范围
                || 节点->写入所有者 != 动态身份来源定位_.所有者
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 > 请求.历史截止事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const std::uint64_t 关系截止 = 节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次
                ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
            const auto 关系组 = L1_.读取所有者范围历史关系组({
                L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                请求.动态.值, 动态身份来源定位_.族归属关系类型, 关系截止});
            if (关系组.状态 != L1所有者范围读取状态::成功
                || 关系组.关系组.size() != 1)
                return {{L2结构合同版本, 关系组.关系组.empty()
                        ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto& 关系 = 关系组.关系组.front();
            if (关系.写入所有者 != 动态身份来源定位_.所有者
                || 关系.源节点 != 请求.动态.值
                || 关系.目标节点 != 动态身份来源定位_.族锚点
                || 关系.关系类型节点 != 动态身份来源定位_.族归属关系类型
                || 关系.角色或顺序 != L2动态结构内部::动态端点角色值
                || 关系.创建事实代次 != 节点->创建事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 投影生命周期 = [&](std::uint64_t 创建,
                std::optional<std::uint64_t> 退出) noexcept {
                if (退出 && *退出 > 请求.历史截止事实代次) 退出.reset();
                return L2生命周期{创建, 退出};
            };
            L2节点族身份来源事实 来源{L2节点族::动态, 节点->编码,
                锚点->编码, 类型->编码, 关系.编码,
                关系.角色或顺序,
                投影生命周期(节点->创建事实代次, 节点->退出事实代次),
                投影生命周期(锚点->创建事实代次, 锚点->退出事实代次),
                投影生命周期(类型->创建事实代次, 类型->退出事实代次),
                投影生命周期(关系.创建事实代次, 关系.退出事实代次)};
            L2动态身份来源读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::move(来源)};
            return 结果.成功() ? 结果 : L2动态身份来源读取结果{{
                L2结构合同版本, L2结构状态::内部不一致,
                请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        }
    }

    L2当前动态组读取结果 按主体读取全部当前动态(
        const L2按主体当前动态读取请求& 请求) const {
        if (!L2按主体当前动态读取请求有效(请求)) return {};
        try {
            const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                L2读取类别::当前, 请求.主体存在, 0});
            if (!主体来源.成功() || !主体来源.身份来源)
                return L2动态结构内部::形成组读取失败(
                    主体来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源.结果头.状态,
                    主体来源.结果头.事实截止代次);
            return 收敛并发条件读取(按端点读取动态组(
                请求.请求头, 请求.主体存在.值, 动态端点角色::主体,
                请求.最大数量),
                请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前动态组读取结果 按前状态读取全部当前动态(
        const L2按前状态当前动态读取请求& 请求) const {
        if (!L2按前状态当前动态读取请求有效(请求)) return {};
        try {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::当前, 请求.前状态, 0});
            if (!状态来源.成功() || !状态来源.身份来源)
                return L2动态结构内部::形成组读取失败(
                    状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                    状态来源.结果头.事实截止代次);
            return 收敛并发条件读取(按端点读取动态组(
                请求.请求头, 请求.前状态.值, 动态端点角色::前状态,
                请求.最大数量),
                请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前动态组读取结果 按后状态读取全部当前动态(
        const L2按后状态当前动态读取请求& 请求) const {
        if (!L2按后状态当前动态读取请求有效(请求)) return {};
        try {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::当前, 请求.后状态, 0});
            if (!状态来源.成功() || !状态来源.身份来源)
                return L2动态结构内部::形成组读取失败(
                    状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                    状态来源.结果头.事实截止代次);
            return 收敛并发条件读取(按端点读取动态组(
                请求.请求头, 请求.后状态.值, 动态端点角色::后状态,
                请求.最大数量),
                请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前动态组读取结果 按来源读取全部当前动态(
        const L2按来源当前动态读取请求& 请求) const {
        if (!L2按来源当前动态读取请求有效(请求))
            return L2动态结构内部::形成组读取失败(L2结构状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (登记结果.状态 != L2动态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2动态结构内部::形成组读取失败(
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            constexpr auto 最大整数 = (std::numeric_limits<std::uint64_t>::max)();
            const auto 半最大整数 = 最大整数 / 2;
            const auto 第一层预算 = 请求.最大数量 >= 半最大整数
                ? 最大整数 : (请求.最大数量 + 1) * 2;
            const auto 候选上限 = 请求.最大数量 == 最大整数
                ? 最大整数 : 请求.最大数量 + 1;
            const auto 读取 = L1_.按来源读取所有者范围全部当前值({
                L1所有者范围来源当前值组读取合同版本,
                动态身份来源定位_.所有者, 请求.来源稳定编码,
                请求.请求头.期望事实代次, 第一层预算});
            if (读取.合同版本 != L1所有者范围来源当前值组读取合同版本
                || 读取.所有者 != 动态身份来源定位_.所有者
                || 读取.来源节点 != 请求.来源稳定编码
                || 读取.期望事实代次 != 请求.请求头.期望事实代次)
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
            if (读取.状态 != L1所有者范围来源当前值组读取状态::成功) {
                if (!读取.当前值.empty())
                    return L2动态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                return L2动态结构内部::形成组读取失败(
                    L2动态结构内部::映射来源值组读取失败动态(读取.状态),
                    读取.读取事实代次);
            }
            if (读取.读取事实代次 != 请求.请求头.期望事实代次
                || 读取.读取事实代次 == 0
                || 读取.当前值.size() > 第一层预算)
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);

            struct 候选值角色 final {
                稳定编码 动态;
                std::uint8_t 角色 = 0;
            };
            std::vector<候选值角色> 候选值;
            候选值.reserve(读取.当前值.size());
            const auto 是起始类型 = [&](稳定编码 类型) noexcept {
                return 类型 == 登记.起始I64值类型.值
                    || 类型 == 登记.起始I64组值类型.值
                    || 类型 == 登记.起始U64组值类型.值
                    || 类型 == 登记.起始独立材料值类型.值;
            };
            const auto 是结束类型 = [&](稳定编码 类型) noexcept {
                return 类型 == 登记.结束I64值类型.值
                    || 类型 == 登记.结束I64组值类型.值
                    || 类型 == 登记.结束U64组值类型.值
                    || 类型 == 登记.结束独立材料值类型.值;
            };
            for (const auto& 值 : 读取.当前值) {
                const bool 起始 = 是起始类型(值.属性类型节点);
                const bool 结束 = 是结束类型(值.属性类型节点);
                if (!有效(值.编码) || !有效(值.所属节点)
                    || 值.来源节点 != 请求.来源稳定编码
                    || 值.写入所有者 != 动态身份来源定位_.所有者
                    || 值.创建事实代次 == 0
                    || 值.创建事实代次 > 读取.读取事实代次
                    || 值.退出事实代次 || 起始 == 结束)
                    return L2动态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                候选值.push_back({值.所属节点,
                    static_cast<std::uint8_t>(起始 ? 1 : 2)});
            }
            std::sort(候选值.begin(), 候选值.end(),
                [](const 候选值角色& 左, const 候选值角色& 右) noexcept {
                    if (左.动态 != 右.动态) return 左.动态 < 右.动态;
                    return 左.角色 < 右.角色;
                });
            std::vector<稳定编码> 动态编码组;
            动态编码组.reserve(候选值.size() / 2);
            for (std::size_t 索引 = 0; 索引 < 候选值.size();) {
                if (索引 + 1 >= 候选值.size()
                    || 候选值[索引].角色 != 1
                    || 候选值[索引 + 1].角色 != 2
                    || 候选值[索引].动态 != 候选值[索引 + 1].动态)
                    return L2动态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                动态编码组.push_back(候选值[索引].动态);
                索引 += 2;
            }
            if (动态编码组.size() > 候选上限)
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);

            L2当前动态组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 读取.读取事实代次, std::nullopt}, {}};
            结果.动态.reserve(动态编码组.size());
            for (const auto 编码 : 动态编码组) {
                const auto 单项 = 读取完整动态({请求.请求头,
                    L2读取类别::当前, L2动态身份{编码}, 0});
                if (单项.结果头.状态 != L2结构状态::已读取
                    || !单项.动态
                    || 单项.结果头.事实截止代次 != 读取.读取事实代次) {
                    const auto 状态 = 单项.结果头.状态
                            == L2结构状态::事实代次漂移
                        || 单项.结果头.状态 == L2结构状态::资源失败
                        ? 单项.结果头.状态 : L2结构状态::内部不一致;
                    return L2动态结构内部::形成组读取失败(
                        状态, 单项.结果头.事实截止代次);
                }
                if (单项.动态->身份 != L2动态身份{编码}
                    || 单项.动态->来源稳定编码 != 请求.来源稳定编码
                    || 单项.动态->生命周期.退出事实代次
                    || !L2动态事实完整(*单项.动态, 登记,
                        读取.读取事实代次))
                    return L2动态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                结果.动态.push_back(*单项.动态);
            }
            if (结果.动态.size() > 请求.最大数量)
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::数量预算不足, 读取.读取事实代次);
            return 结果.成功() ? 结果
                : L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(
                L2结构状态::内部不一致);
        }
    }

    L2当前动态组读取结果 按I64时间范围读取全部当前动态(
        const L2按I64时间范围当前动态读取请求& 请求) const {
        if (!L2按I64时间范围当前动态读取请求有效(请求))
            return L2动态结构内部::形成组读取失败(L2结构状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (登记结果.状态 != L2动态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2动态结构内部::形成组读取失败(
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 读取端点 = [&](稳定编码 属性类型) {
                return L1_.按属性类型读取所有者范围全部当前值({
                    L1所有者范围属性类型当前值组读取合同版本,
                    动态身份来源定位_.所有者, 属性类型,
                    请求.请求头.期望事实代次, 请求.最大候选数量});
            };
            const auto 起始读取 = 读取端点(登记.起始I64值类型.值);
            const auto 结束读取 = 读取端点(登记.结束I64值类型.值);
            const auto 检查读取失败 = [&](const auto& 读取,
                稳定编码 属性类型)
                -> std::optional<L2当前动态组读取结果> {
                if (读取.合同版本
                        != L1所有者范围属性类型当前值组读取合同版本
                    || 读取.所有者 != 动态身份来源定位_.所有者
                    || 读取.属性类型节点 != 属性类型
                    || 读取.期望事实代次 != 请求.请求头.期望事实代次)
                    return L2动态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                if (读取.状态
                    != L1所有者范围属性类型当前值组读取状态::成功) {
                    if (!读取.当前值.empty())
                        return L2动态结构内部::形成组读取失败(
                            L2结构状态::内部不一致, 读取.读取事实代次);
                    return L2动态结构内部::形成组读取失败(
                        L2动态结构内部::映射属性类型值组读取失败动态(
                            读取.状态),
                        读取.读取事实代次);
                }
                if (读取.读取事实代次 != 请求.请求头.期望事实代次
                    || 读取.读取事实代次 == 0
                    || 读取.当前值.size() > 请求.最大候选数量)
                    return L2动态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                return std::nullopt;
            };
            if (const auto 失败 = 检查读取失败(
                    起始读取, 登记.起始I64值类型.值))
                return *失败;
            if (const auto 失败 = 检查读取失败(
                    结束读取, 登记.结束I64值类型.值))
                return *失败;

            struct I64端点候选 final {
                稳定编码 动态;
                稳定编码 时间值;
                std::int64_t 时间I64 = 0;
            };
            const auto 形成端点候选 = [&](const auto& 读取,
                稳定编码 属性类型, std::vector<I64端点候选>& 候选) {
                候选.reserve(读取.当前值.size());
                std::uint64_t 前一值编码 = 0;
                for (const auto& 值 : 读取.当前值) {
                    const auto 时间 = std::get_if<std::int64_t>(&值.材料);
                    if (!有效(值.编码) || 值.编码.值 <= 前一值编码
                        || !有效(值.所属节点) || !有效(值.来源节点)
                        || 值.属性类型节点 != 属性类型
                        || 值.写入所有者 != 动态身份来源定位_.所有者
                        || 值.创建事实代次 == 0
                        || 值.创建事实代次 > 读取.读取事实代次
                        || 值.退出事实代次 || !时间)
                        return false;
                    前一值编码 = 值.编码.值;
                    候选.push_back({值.所属节点, 值.编码, *时间});
                }
                std::sort(候选.begin(), 候选.end(),
                    [](const I64端点候选& 左,
                        const I64端点候选& 右) noexcept {
                        return 左.动态 < 右.动态;
                    });
                for (std::size_t 索引 = 1; 索引 < 候选.size(); ++索引)
                    if (!(候选[索引 - 1].动态 < 候选[索引].动态))
                        return false;
                return true;
            };
            std::vector<I64端点候选> 起始候选;
            std::vector<I64端点候选> 结束候选;
            if (!形成端点候选(起始读取, 登记.起始I64值类型.值, 起始候选)
                || !形成端点候选(结束读取, 登记.结束I64值类型.值, 结束候选))
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 请求.请求头.期望事实代次);

            struct I64动态候选 final {
                稳定编码 动态;
                稳定编码 起始时间值;
                稳定编码 结束时间值;
                std::int64_t 起始时间I64 = 0;
                std::int64_t 结束时间I64 = 0;
            };
            std::vector<I64动态候选> 命中;
            命中.reserve((std::min)(起始候选.size(), 结束候选.size()));
            std::size_t 起始索引 = 0;
            std::size_t 结束索引 = 0;
            while (起始索引 < 起始候选.size()
                && 结束索引 < 结束候选.size()) {
                const auto& 起始 = 起始候选[起始索引];
                const auto& 结束 = 结束候选[结束索引];
                if (起始.动态 < 结束.动态) {
                    ++起始索引;
                    continue;
                }
                if (结束.动态 < 起始.动态) {
                    ++结束索引;
                    continue;
                }
                if (起始.时间I64 <= 请求.最大时间I64
                    && 结束.时间I64 >= 请求.最小时间I64)
                    命中.push_back({起始.动态, 起始.时间值, 结束.时间值,
                        起始.时间I64, 结束.时间I64});
                ++起始索引;
                ++结束索引;
            }
            if (命中.size() > 请求.最大返回数量)
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::数量预算不足, 请求.请求头.期望事实代次);

            L2当前动态组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 请求.请求头.期望事实代次,
                std::nullopt}, {}};
            结果.动态.reserve(命中.size());
            for (const auto& 项 : 命中) {
                const auto 单项 = 读取完整动态({请求.请求头,
                    L2读取类别::当前, L2动态身份{项.动态}, 0});
                if (单项.结果头.状态 != L2结构状态::已读取
                    || 单项.结果头.变更事实代次 || !单项.动态
                    || 单项.结果头.事实截止代次
                        != 请求.请求头.期望事实代次) {
                    const auto 状态 = 单项.结果头.状态
                            == L2结构状态::事实代次漂移
                        || 单项.结果头.状态 == L2结构状态::资源失败
                        ? 单项.结果头.状态 : L2结构状态::内部不一致;
                    return L2动态结构内部::形成组读取失败(
                        状态, 单项.结果头.事实截止代次);
                }
                const auto 起始 = std::get_if<std::int64_t>(
                    &单项.动态->起始时间值.类型化不可变材料);
                const auto 结束 = std::get_if<std::int64_t>(
                    &单项.动态->结束时间值.类型化不可变材料);
                if (单项.动态->身份 != L2动态身份{项.动态}
                    || 单项.动态->生命周期.退出事实代次
                    || !L2动态事实完整(*单项.动态, 登记,
                        请求.请求头.期望事实代次)
                    || 单项.动态->起始时间值.属性类型身份
                        != 登记.起始I64值类型.值
                    || 单项.动态->结束时间值.属性类型身份
                        != 登记.结束I64值类型.值
                    || 单项.动态->起始时间值.值稳定编码 != 项.起始时间值
                    || 单项.动态->结束时间值.值稳定编码 != 项.结束时间值
                    || !起始 || !结束 || *起始 != 项.起始时间I64
                    || *结束 != 项.结束时间I64
                    || *起始 > 请求.最大时间I64
                    || *结束 < 请求.最小时间I64)
                    return L2动态结构内部::形成组读取失败(
                        L2结构状态::内部不一致,
                        请求.请求头.期望事实代次);
                结果.动态.push_back(*单项.动态);
            }
            return 结果.成功() ? 结果
                : L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致,
                    请求.请求头.期望事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成组读取失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；一次只替换一个强类型动态引用角色。
    L2动态引用替换结果 替换动态引用(const L2动态引用替换请求& 请求) {
        if (!L2动态引用替换请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2动态结构内部::形成引用替换失败(
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const bool 主体角色 = 请求.引用角色 == L2动态引用角色::主体;
            const bool 前状态角色 = 请求.引用角色 == L2动态引用角色::前状态;
            const auto 新目标 = 主体角色
                ? std::get<L2存在身份>(请求.新目标).值
                : std::get<L2状态身份>(请求.新目标).值;
            const auto 关系类型 = 主体角色 ? 登记.主体关系类型.值
                : 前状态角色 ? 登记.前状态关系类型.值 : 登记.后状态关系类型.值;
            const auto 本地键 = 主体角色 ? L2动态结构内部::动态主体关系本地键值
                : 前状态角色 ? L2动态结构内部::动态前状态关系本地键值
                : L2动态结构内部::动态后状态关系本地键值;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2动态结构内部::映射动态幂等键(请求.幂等身份);
            写集.关系 = {{{本地键}, 请求.动态.值, 新目标, 关系类型,
                L2动态结构内部::动态端点角色值}};
            写集.退出事实 = {请求.旧关系稳定编码};
            std::optional<L2动态事实> 写前动态;
            std::optional<L2动态自有关系引用> 写前关系;
            if (登记结果.事实截止代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整动态({请求.请求头,
                    L2读取类别::当前, 请求.动态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.动态 || !当前.自有关系)
                    return L2动态结构内部::形成引用替换失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                const auto 旧关系 = 主体角色 ? 当前.自有关系->主体关系稳定编码
                    : 前状态角色 ? 当前.自有关系->前状态关系稳定编码
                    : 当前.自有关系->后状态关系稳定编码;
                const auto 旧目标 = 主体角色 ? 当前.动态->主体存在.值
                    : 前状态角色 ? 当前.动态->前状态.值 : 当前.动态->后状态.值;
                if (旧关系 != 请求.旧关系稳定编码 || 旧目标 == 新目标)
                    return L2动态结构内部::形成引用替换失败(
                        L2结构状态::引用冲突, 登记结果.事实截止代次);
                const auto 动态来源 = 读取动态身份来源({请求.请求头,
                    L2读取类别::当前, 请求.动态, 0});
                const auto 目标来源 = 主体角色
                    ? 存在服务_.读取存在身份来源({请求.请求头,
                        L2读取类别::当前, L2存在身份{新目标}, 0}).结果头
                    : 状态服务_.读取状态身份来源({请求.请求头,
                        L2读取类别::当前, L2状态身份{新目标}, 0}).结果头;
                if (!动态来源.成功()
                    || 目标来源.状态 != L2结构状态::已读取)
                    return L2动态结构内部::形成引用替换失败(
                        !动态来源.成功() ? 动态来源.结果头.状态 : 目标来源.状态,
                        std::max(动态来源.结果头.事实截止代次,
                            目标来源.事实截止代次));
                if (动态来源.结果头.事实截止代次 != 登记结果.事实截止代次
                    || 目标来源.事实截止代次 != 登记结果.事实截止代次)
                    return L2动态结构内部::形成引用替换失败(
                        L2结构状态::内部不一致, 登记结果.事实截止代次);
                写前动态 = *当前.动态;
                写前关系 = *当前.自有关系;
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2动态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2动态结构内部::映射写入动态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2动态结构内部::形成引用替换失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2动态结构内部::形成引用替换失败(状态, 写入.事实代次);
            }
            const auto 新关系 = L2动态结构内部::查找编码映射(写入, 本地键);
            if (!L2动态结构内部::写入成功边界完整(写入)
                || 写入.新编码映射.size() != 1 || !新关系)
                return L2动态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 读回请求代次 = std::max(
                登记结果.事实截止代次, 写入.事实代次);
            const auto 首次 = 读取完整动态({{L2结构合同版本, 读回请求代次},
                L2读取类别::历史, 请求.动态, 写入.事实代次});
            const auto 旧读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.旧关系稳定编码});
            const auto 新读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, *新关系});
            const auto* 旧事实 = 旧读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*旧读取.事实) : nullptr;
            const auto* 新事实 = 新读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*新读取.事实) : nullptr;
            if (首次.结果头.状态 != L2结构状态::已读取 || !首次.动态
                || !首次.自有关系 || !旧事实 || !新事实
                || 旧事实->退出事实代次 != 写入.事实代次
                || !L2动态结构内部::历史关系匹配(*新事实, *新关系,
                    请求.动态.值, 新目标, 关系类型,
                    第一层写入端口_.所有者身份())
                || (主体角色 && (首次.动态->主体存在.值 != 新目标
                    || 首次.自有关系->主体关系稳定编码 != *新关系))
                || (前状态角色 && (首次.动态->前状态.值 != 新目标
                    || 首次.自有关系->前状态关系稳定编码 != *新关系))
                || (!主体角色 && !前状态角色
                    && (首次.动态->后状态.值 != 新目标
                        || 首次.自有关系->后状态关系稳定编码 != *新关系))
                || (写前动态 && (!L2动态结构内部::动态未改字段相同(
                        *写前动态, *首次.动态)
                    || (主体角色 && (写前动态->前状态 != 首次.动态->前状态
                        || 写前动态->后状态 != 首次.动态->后状态))
                    || (前状态角色 && (写前动态->主体存在 != 首次.动态->主体存在
                        || 写前动态->后状态 != 首次.动态->后状态))
                    || (!主体角色 && !前状态角色
                        && (写前动态->主体存在 != 首次.动态->主体存在
                            || 写前动态->前状态 != 首次.动态->前状态))
                    || 写前动态->起始时间值 != 首次.动态->起始时间值
                    || 写前动态->结束时间值 != 首次.动态->结束时间值)))
                return L2动态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2动态引用替换结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, *首次.动态, *首次.自有关系,
                L2动态已退出关系引用{请求.引用角色, 请求.旧关系稳定编码}};
            return 结果.成功() ? 结果 : L2动态结构内部::形成引用替换失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成引用替换失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成引用替换失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成引用替换失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；只换代一个时间值角色且显式保持动态来源。
    L2动态时间值换代结果 换代动态时间值(
        const L2动态时间值换代请求& 请求) {
        if (!L2动态时间值换代请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2动态结构内部::形成时间值换代失败(
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const bool 起始角色 = 请求.时间值角色 == L2动态时间值角色::起始时间;
            const auto 类型 = L2动态结构内部::选择动态值类型编码(
                登记, 请求.新值材料, 起始角色);
            const auto 本地键 = 起始角色 ? L2动态结构内部::动态起始值本地键值
                : L2动态结构内部::动态结束值本地键值;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2动态结构内部::映射动态幂等键(请求.幂等身份);
            写集.值 = {{{本地键}, 请求.动态.值, 类型,
                L2动态结构内部::转换为L1材料(请求.新值材料), 请求.来源稳定编码}};
            写集.属性槽变更 = {{请求.动态.值, 类型, {本地键}}};
            写集.退出事实 = {请求.旧值稳定编码};
            std::optional<L2动态事实> 写前动态;
            std::optional<L2动态自有关系引用> 写前关系;
            if (登记结果.事实截止代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整动态({请求.请求头,
                    L2读取类别::当前, 请求.动态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.动态 || !当前.自有关系)
                    return L2动态结构内部::形成时间值换代失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                const auto& 旧值 = 起始角色 ? 当前.动态->起始时间值
                    : 当前.动态->结束时间值;
                if (旧值.值稳定编码 != 请求.旧值稳定编码
                    || 当前.动态->来源稳定编码 != 请求.来源稳定编码
                    || 当前.动态->起始时间值.来源稳定编码 != 请求.来源稳定编码
                    || 当前.动态->结束时间值.来源稳定编码 != 请求.来源稳定编码)
                    return L2动态结构内部::形成时间值换代失败(
                        L2结构状态::引用冲突, 登记结果.事实截止代次);
                写前动态 = *当前.动态;
                写前关系 = *当前.自有关系;
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2动态结构内部::形成时间值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2动态结构内部::映射写入动态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2动态结构内部::形成时间值换代失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2动态结构内部::形成时间值换代失败(状态, 写入.事实代次);
            }
            const auto 新值 = L2动态结构内部::查找编码映射(写入, 本地键);
            if (!L2动态结构内部::写入成功边界完整(写入)
                || 写入.新编码映射.size() != 1 || !新值)
                return L2动态结构内部::形成时间值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 读回请求代次 = std::max(
                登记结果.事实截止代次, 写入.事实代次);
            const auto 首次 = 读取完整动态({{L2结构合同版本, 读回请求代次},
                L2读取类别::历史, 请求.动态, 写入.事实代次});
            const auto 旧读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.旧值稳定编码});
            const auto* 旧事实 = 旧读取.事实
                ? std::get_if<L1所有者范围值事实>(&*旧读取.事实) : nullptr;
            const auto 已退出值 = 旧事实
                ? L2动态结构内部::形成截止属性事实(
                    *旧事实, 登记, 写入.事实代次, 起始角色) : std::nullopt;
            const auto& 当前角色值 = 首次.动态
                ? (起始角色 ? 首次.动态->起始时间值 : 首次.动态->结束时间值)
                : L2属性事实{};
            const auto& 另一角色值 = 首次.动态
                ? (起始角色 ? 首次.动态->结束时间值 : 首次.动态->起始时间值)
                : L2属性事实{};
            if (首次.结果头.状态 != L2结构状态::已读取 || !首次.动态
                || !首次.自有关系 || !已退出值 || 当前角色值.值稳定编码 != *新值
                || 当前角色值.类型化不可变材料 != 请求.新值材料
                || 当前角色值.来源稳定编码 != 请求.来源稳定编码
                || 已退出值->值稳定编码 != 请求.旧值稳定编码
                || 已退出值->退出事实代次 != 写入.事实代次
                || !旧事实 || 旧事实->所属节点 != 请求.动态.值
                || 旧事实->来源节点 != 请求.来源稳定编码
                || 旧事实->写入所有者 != 第一层写入端口_.所有者身份()
                || (写前动态 && (!L2动态结构内部::动态未改字段相同(
                        *写前动态, *首次.动态)
                    || 另一角色值 != (起始角色 ?写前动态->结束时间值
                        : 写前动态->起始时间值)
                    || 写前动态->主体存在 != 首次.动态->主体存在
                    || 写前动态->前状态 != 首次.动态->前状态
                    || 写前动态->后状态 != 首次.动态->后状态))
                || (写前关系 && *写前关系 != *首次.自有关系))
                return L2动态结构内部::形成时间值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2动态时间值换代结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, *首次.动态,
                *首次.自有关系, *已退出值};
            return 结果.成功() ? 结果 : L2动态结构内部::形成时间值换代失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成时间值换代失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成时间值换代失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成时间值换代失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；动态节点与六项自有事实由一份闭包写集退出。
    L2动态退出结果 退出动态(const L2动态退出请求& 请求) {
        if (!L2动态退出请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前动态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2动态结构内部::形成动态退出失败(
                    L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2动态结构内部::映射动态幂等键(请求.幂等身份);
            写集.退出事实 = 请求.自有事实闭包;
            写集.退出事实.push_back(请求.动态.值);
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            if (登记结果.事实截止代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整动态({请求.请求头,
                    L2读取类别::当前, 请求.动态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.动态 || !当前.自有关系)
                    return L2动态结构内部::形成动态退出失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                std::vector<稳定编码> 当前闭包 = {
                    当前.自有关系->族归属关系稳定编码,
                    当前.自有关系->主体关系稳定编码,
                    当前.自有关系->前状态关系稳定编码,
                    当前.自有关系->后状态关系稳定编码,
                    当前.动态->起始时间值.值稳定编码,
                    当前.动态->结束时间值.值稳定编码};
                std::sort(当前闭包.begin(), 当前闭包.end());
                if (当前闭包 != 请求.自有事实闭包)
                    return L2动态结构内部::形成动态退出失败(
                        L2结构状态::引用冲突, 登记结果.事实截止代次);
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2动态结构内部::形成动态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2动态结构内部::映射写入动态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2动态结构内部::形成动态退出失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2动态结构内部::形成动态退出失败(状态, 写入.事实代次);
            }
            if (!L2动态结构内部::写入成功边界完整(写入)
                || !写入.新编码映射.empty())
                return L2动态结构内部::形成动态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 读回请求代次 = std::max(
                登记结果.事实截止代次, 写入.事实代次);
            const auto 历史 = 读取完整动态({{L2结构合同版本, 读回请求代次},
                L2读取类别::历史, 请求.动态, 写入.事实代次});
            const auto owner = 第一层写入端口_.所有者身份();
            bool 七事实退出 = 历史.结果头.状态 == L2结构状态::已读取
                && 历史.动态 && 历史.自有关系
                && 历史.动态->生命周期.退出事实代次 == 写入.事实代次
                && 历史.动态->起始时间值.退出事实代次 == 写入.事实代次
                && 历史.动态->结束时间值.退出事实代次 == 写入.事实代次;
            if (七事实退出) {
                const 稳定编码 关系编码[] = {
                    历史.自有关系->族归属关系稳定编码,
                    历史.自有关系->主体关系稳定编码,
                    历史.自有关系->前状态关系稳定编码,
                    历史.自有关系->后状态关系稳定编码};
                const 稳定编码 目标[] = {动态身份来源定位_.族锚点,
                    历史.动态->主体存在.值, 历史.动态->前状态.值,
                    历史.动态->后状态.值};
                const 稳定编码 类型[] = {动态身份来源定位_.族归属关系类型,
                    登记.主体关系类型.值, 登记.前状态关系类型.值,
                    登记.后状态关系类型.值};
                for (std::size_t 索引 = 0; 索引 < 4; ++索引) {
                    const auto 读取 = L1_.读取所有者范围历史事实(
                        {L1所有者范围CRUD合同版本, 关系编码[索引]});
                    const auto* 关系 = 读取.事实
                        ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
                    七事实退出 = 七事实退出 && 关系
                        && L2动态结构内部::历史关系匹配(*关系, 关系编码[索引],
                            请求.动态.值, 目标[索引], 类型[索引], owner,
                            写入.事实代次);
                }
            }
            if (!七事实退出)
                return L2动态结构内部::形成动态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2动态退出结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, *历史.动态, *历史.自有关系};
            return 结果.成功() ? 结果 : L2动态结构内部::形成动态退出失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2动态结构内部::形成动态退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2动态结构内部::形成动态退出失败(L2结构状态::资源失败);
        } catch (...) {
            return L2动态结构内部::形成动态退出失败(L2结构状态::内部不一致);
        }
    }

private:
    enum class 动态端点角色 : std::uint8_t { 主体, 前状态, 后状态 };

    L2当前动态组读取结果 收敛并发条件读取(
        L2当前动态组读取结果 结果, std::uint64_t 期望) const {
        if (结果.结果头.状态 != L2结构状态::内部不一致) return 结果;
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.状态 == L1中性读取状态::成功
            && 当前代次.事实代次 != 期望)
            return L2动态结构内部::形成组读取失败(
                L2结构状态::事实代次漂移, 当前代次.事实代次);
        return 结果;
    }
    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务,
        L2动态所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument("L2 state owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    L2动态写入结果 提交并读回新增动态(
        const L1所有者范围写集请求& 写集, const L2动态新增请求& 请求,
        const L2动态结构类型登记& 登记) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 动态码 = L2动态结构内部::映射写入动态(写入.状态);
        if (动态码 != L2结构状态::已提交 && 动态码 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2动态结构内部::形成写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return L2动态结构内部::形成写入失败(动态码, 写入.事实代次);
        }
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
            || 写入.新编码映射.size() != 7)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 节点编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态节点本地键值);
        const auto 族归属关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态族归属关系本地键值);
        const auto 主体关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态主体关系本地键值);
        const auto 前状态关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态前状态关系本地键值);
        const auto 后状态关系编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态后状态关系本地键值);
        const auto 起始时间值编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态起始值本地键值);
        const auto 结束时间值编码 = L2动态结构内部::查找编码映射(
            写入, L2动态结构内部::动态结束值本地键值);
        if (!节点编码 || !族归属关系编码 || !主体关系编码
            || !前状态关系编码 || !后状态关系编码
            || !起始时间值编码 || !结束时间值编码)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 读取事实 = [&](稳定编码 编码) {
            return L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
        };
        const auto 节点读取 = 读取事实(*节点编码);
        const auto 族归属关系读取 = 读取事实(*族归属关系编码);
        const auto 主体关系读取 = 读取事实(*主体关系编码);
        const auto 前状态关系读取 = 读取事实(*前状态关系编码);
        const auto 后状态关系读取 = 读取事实(*后状态关系编码);
        const auto 起始时间值读取 = 读取事实(*起始时间值编码);
        const auto 结束时间值读取 = 读取事实(*结束时间值编码);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        const auto* 族归属关系 = 族归属关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*族归属关系读取.事实) : nullptr;
        const auto* 主体关系 = 主体关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*主体关系读取.事实) : nullptr;
        const auto* 前状态关系 = 前状态关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*前状态关系读取.事实) : nullptr;
        const auto* 后状态关系 = 后状态关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*后状态关系读取.事实) : nullptr;
        const auto* 起始时间值 = 起始时间值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*起始时间值读取.事实) : nullptr;
        const auto* 结束时间值 = 结束时间值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*结束时间值读取.事实) : nullptr;
        const auto owner = 第一层写入端口_.所有者身份();
        if (!节点 || !族归属关系 || !主体关系 || !前状态关系
            || !后状态关系 || !起始时间值 || !结束时间值
            || 节点->编码 != *节点编码 || 节点->写入所有者 != owner
            || 节点->创建事实代次 != 写入.事实代次 || 节点->退出事实代次
            || 族归属关系->源节点 != *节点编码
            || 族归属关系->目标节点 != 动态身份来源定位_.族锚点
            || 族归属关系->关系类型节点 != 动态身份来源定位_.族归属关系类型
            || 族归属关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 族归属关系->写入所有者 != owner
            || 族归属关系->创建事实代次 != 写入.事实代次
            || 族归属关系->退出事实代次
            || 主体关系->源节点 != *节点编码
            || 主体关系->目标节点 != 请求.主体存在.值
            || 主体关系->关系类型节点 != 登记.主体关系类型.值
            || 主体关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 主体关系->写入所有者 != owner
            || 主体关系->创建事实代次 != 写入.事实代次 || 主体关系->退出事实代次
            || 前状态关系->源节点 != *节点编码
            || 前状态关系->目标节点 != 请求.前状态.值
            || 前状态关系->关系类型节点 != 登记.前状态关系类型.值
            || 前状态关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 前状态关系->写入所有者 != owner
            || 前状态关系->创建事实代次 != 写入.事实代次 || 前状态关系->退出事实代次
            || 后状态关系->源节点 != *节点编码
            || 后状态关系->目标节点 != 请求.后状态.值
            || 后状态关系->关系类型节点 != 登记.后状态关系类型.值
            || 后状态关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 后状态关系->写入所有者 != owner
            || 后状态关系->创建事实代次 != 写入.事实代次 || 后状态关系->退出事实代次
            || 起始时间值->所属节点 != *节点编码
            || 起始时间值->属性类型节点
                != L2动态结构内部::选择动态值类型编码(登记, 请求.起始时间材料, true)
            || 起始时间值->材料 != L2动态结构内部::转换为L1材料(请求.起始时间材料)
            || 起始时间值->来源节点 != 请求.来源稳定编码
            || 起始时间值->写入所有者 != owner
            || 起始时间值->创建事实代次 != 写入.事实代次 || 起始时间值->退出事实代次
            || 结束时间值->所属节点 != *节点编码
            || 结束时间值->属性类型节点
                != L2动态结构内部::选择动态值类型编码(登记, 请求.结束时间材料, false)
            || 结束时间值->材料 != L2动态结构内部::转换为L1材料(请求.结束时间材料)
            || 结束时间值->来源节点 != 请求.来源稳定编码
            || 结束时间值->写入所有者 != owner
            || 结束时间值->创建事实代次 != 写入.事实代次 || 结束时间值->退出事实代次
            || 节点->当前属性.size() != 2)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        bool 起始槽 = false, 结束槽 = false;
        for (const auto& 槽 : 节点->当前属性) {
            if (槽.属性类型节点 == 起始时间值->属性类型节点
                && 槽.当前值 == *起始时间值编码) 起始槽 = true;
            else if (槽.属性类型节点 == 结束时间值->属性类型节点
                && 槽.当前值 == *结束时间值编码) 结束槽 = true;
            else return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        }
        if (!起始槽 || !结束槽) return L2动态结构内部::形成写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        auto 动态 = L2动态结构内部::形成动态事实(*节点, *主体关系,
            *前状态关系, *后状态关系, *起始时间值, *结束时间值,
            登记, 写入.事实代次);
        if (!动态 || 动态->主体存在 != 请求.主体存在
            || 动态->前状态 != 请求.前状态
            || 动态->后状态 != 请求.后状态
            || 动态->起始时间值.类型化不可变材料 != 请求.起始时间材料
            || 动态->结束时间值.类型化不可变材料 != 请求.结束时间材料
            || 动态->来源稳定编码 != 请求.来源稳定编码)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.状态 != L1中性读取状态::成功
            || 当前代次.合同版本 != L1中性CRUD合同版本
            || 当前代次.事实代次 < 写入.事实代次)
            return L2动态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const L2结构请求头 历史头{L2结构合同版本, 当前代次.事实代次};
        const auto 主体来源 = 存在服务_.读取存在身份来源({历史头,
            L2读取类别::历史, 请求.主体存在, 写入.事实代次});
        const auto 前状态来源 = 状态服务_.读取状态身份来源({历史头,
            L2读取类别::历史, 请求.前状态, 写入.事实代次});
        const auto 后状态来源 = 状态服务_.读取状态身份来源({历史头,
            L2读取类别::历史, 请求.后状态, 写入.事实代次});
        if (!主体来源.成功() || !主体来源.身份来源
            || !前状态来源.成功() || !前状态来源.身份来源
            || !后状态来源.成功() || !后状态来源.身份来源
            || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值
            || 前状态来源.身份来源->节点稳定编码 != 请求.前状态.值
            || 后状态来源.身份来源->节点稳定编码 != 请求.后状态.值)
            return L2动态结构内部::形成写入失败(
                主体来源.结果头.状态 == L2结构状态::事实代次漂移
                    || 前状态来源.结果头.状态 == L2结构状态::事实代次漂移
                    || 后状态来源.结果头.状态 == L2结构状态::事实代次漂移
                    ? L2结构状态::事实代次漂移 : L2结构状态::内部不一致,
                当前代次.事实代次);
        L2动态写入结果 结果{{L2结构合同版本, 动态码,
            写入.事实代次, 写入.事实代次}, std::move(动态),
            L2动态自有关系引用{*族归属关系编码,
                *主体关系编码, *前状态关系编码, *后状态关系编码}};
        return 结果.成功() ? 结果 : L2动态结构内部::形成写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }

    L2动态完整读取结果 读取当前完整动态(
        const L2动态完整读取请求& 请求,
        const L2动态结构类型登记& 登记) const {
        const auto 动态来源 = 读取动态身份来源({请求.请求头,
            L2读取类别::当前, 请求.动态, 0});
        if (!动态来源.成功() || !动态来源.身份来源)
            return L2动态结构内部::形成完整读取失败(请求,
                动态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 动态来源.结果头.状态,
                动态来源.结果头.事实截止代次);
        L1所有者范围一致当前读取请求 首次请求;
        首次请求.合同版本 = L1所有者范围一致当前读取合同版本;
        首次请求.期望事实代次 = 请求.请求头.期望事实代次;
        首次请求.所有者 = {动态身份来源定位_.所有者};
        首次请求.节点 = {请求.动态.值};
        首次请求.源关系组 = {
            {请求.动态.值, 动态身份来源定位_.族归属关系类型},
            {请求.动态.值, 登记.主体关系类型.值},
            {请求.动态.值, 登记.前状态关系类型.值},
            {请求.动态.值, 登记.后状态关系类型.值}};
        const auto 首次读取 = L1_.尝试读取所有者范围一致当前投影(首次请求);
        const auto 首次顶层 = L2动态结构内部::解释一致读取顶层(
            首次读取, 请求.请求头.期望事实代次);
        if (!首次顶层.成功()) return L2动态结构内部::形成完整读取失败(
            请求, 首次顶层.状态, 首次顶层.截止);
        if (首次读取.所有者.size() != 1 || 首次读取.节点.size() != 1 || !首次读取.关系.empty()
            || !首次读取.值.empty() || !首次读取.属性值.empty()
            || 首次读取.源关系组.size() != 4 || !首次读取.目标关系组.empty())
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 节点项 = L2动态结构内部::查找唯一节点项(
            首次读取, 请求.动态.值);
        if (!节点项) return L2动态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 首次顶层.截止);
        if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
            if (节点项->事实) return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
            return L2动态结构内部::形成完整读取失败(请求,
                L2动态结构内部::映射当前项目动态(节点项->状态), 首次顶层.截止);
        }
        if (!节点项->事实 || !L2动态结构内部::普通当前节点完整(
                *节点项->事实, 请求.动态.值, 首次顶层.截止)
            || 节点项->事实->当前属性.size() != 2)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 主体组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 登记.主体关系类型.值);
        const auto* 前状态组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 登记.前状态关系类型.值);
        const auto* 后状态组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 登记.后状态关系类型.值);
        const auto* 族归属组 = L2动态结构内部::查找唯一源关系组(
            首次读取, 请求.动态.值, 动态身份来源定位_.族归属关系类型);
        if (!族归属组 || 族归属组->成员.size() != 1
            || !主体组 || !前状态组 || !后状态组
            || 主体组->成员.size() != 1
            || 前状态组->成员.size() != 1 || 后状态组->成员.size() != 1)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto& 主体关系 = 主体组->成员.front().关系;
        const auto& 前状态关系 = 前状态组->成员.front().关系;
        const auto& 后状态关系 = 后状态组->成员.front().关系;
        if (!L2动态结构内部::普通当前节点完整(
                主体组->成员.front().对端节点, 主体关系.目标节点, 首次顶层.截止)
            || !L2动态结构内部::普通当前节点完整(
                前状态组->成员.front().对端节点, 前状态关系.目标节点,
                首次顶层.截止)
            || !L2动态结构内部::普通当前节点完整(
                后状态组->成员.front().对端节点, 后状态关系.目标节点,
                首次顶层.截止))
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::当前, L2存在身份{主体关系.目标节点}, 0});
        const auto 前状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, L2状态身份{前状态关系.目标节点}, 0});
        const auto 后状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, L2状态身份{后状态关系.目标节点}, 0});
        if (!主体来源.成功() || !前状态来源.成功() || !后状态来源.成功())
            return L2动态结构内部::形成完整读取失败(
                请求,
                !主体来源.成功()
                    ? (主体来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源.结果头.状态)
                : !前状态来源.成功()
                    ? (前状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 前状态来源.结果头.状态)
                    : (后状态来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 后状态来源.结果头.状态),
                std::max({主体来源.结果头.事实截止代次,
                    前状态来源.结果头.事实截止代次,
                    后状态来源.结果头.事实截止代次}));
        L1所有者范围一致当前读取请求 完整请求 = 首次请求;
        for (const auto& 槽 : 节点项->事实->当前属性)
            完整请求.属性值.push_back({请求.动态.值, 槽.属性类型节点});
        const auto 完整读取 = L1_.尝试读取所有者范围一致当前投影(完整请求);
        const auto 完整顶层 = L2动态结构内部::解释一致读取顶层(
            完整读取, 请求.请求头.期望事实代次);
        if (!完整顶层.成功()) return L2动态结构内部::形成完整读取失败(
            请求, 完整顶层.状态, 完整顶层.截止);
        const auto* 完整节点项 = L2动态结构内部::查找唯一节点项(
            完整读取, 请求.动态.值);
        const auto* 完整主体组 = L2动态结构内部::查找唯一源关系组(
            完整读取, 请求.动态.值, 登记.主体关系类型.值);
        const auto* 完整前状态组 = L2动态结构内部::查找唯一源关系组(
            完整读取, 请求.动态.值, 登记.前状态关系类型.值);
        const auto* 完整后状态组 = L2动态结构内部::查找唯一源关系组(
            完整读取, 请求.动态.值, 登记.后状态关系类型.值);
        if (完整读取.所有者.size() != 1 || 完整读取.节点.size() != 1 || !完整读取.关系.empty()
            || !完整读取.值.empty() || 完整读取.属性值.size() != 2
            || 完整读取.源关系组.size() != 4 || !完整读取.目标关系组.empty()
            || !完整节点项 || 完整节点项->状态
                != L1所有者范围一致当前读取项目状态::成功 || !完整节点项->事实
            || *完整节点项->事实 != *节点项->事实 || !完整主体组
            || !完整前状态组 || !完整后状态组
            || *完整主体组 != *主体组
            || *完整前状态组 != *前状态组 || *完整后状态组 != *后状态组)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const L1所有者范围值事实* 起始时间值 = nullptr;
        const L1所有者范围值事实* 结束时间值 = nullptr;
        for (const auto& 槽 : 完整节点项->事实->当前属性) {
            const auto* 项 = L2动态结构内部::查找唯一属性项(
                完整读取, 请求.动态.值, 槽.属性类型节点);
            if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !项->投影 || 项->投影->属性槽 != 槽
                || 项->投影->当前值事实.编码 != 槽.当前值
                || 项->投影->当前值事实.所属节点 != 请求.动态.值
                || 项->投影->当前值事实.退出事实代次)
                return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
            const auto& 值 = 项->投影->当前值事实;
            if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) {
                if (起始时间值) return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                起始时间值 = &值;
            } else if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) {
                if (结束时间值) return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                结束时间值 = &值;
            } else return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        }
        if (!起始时间值 || !结束时间值) return L2动态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.截止);
        auto 动态 = L2动态结构内部::形成动态事实(*完整节点项->事实,
            完整主体组->成员.front().关系,
            完整前状态组->成员.front().关系,
            完整后状态组->成员.front().关系,
            *起始时间值, *结束时间值, 登记, 完整顶层.截止);
        if (!动态 || 动态->身份 != 请求.动态)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const auto 主体来源复核 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::当前, 动态->主体存在, 0});
        const auto 前状态来源复核 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, 动态->前状态, 0});
        const auto 后状态来源复核 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, 动态->后状态, 0});
        if (!主体来源复核.成功() || !前状态来源复核.成功()
            || !后状态来源复核.成功())
            return L2动态结构内部::形成完整读取失败(
                请求,
                !主体来源复核.成功()
                    ? (主体来源复核.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源复核.结果头.状态)
                : !前状态来源复核.成功()
                    ? (前状态来源复核.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 前状态来源复核.结果头.状态)
                    : (后状态来源复核.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 后状态来源复核.结果头.状态),
                std::max({主体来源复核.结果头.事实截止代次,
                    前状态来源复核.结果头.事实截止代次,
                    后状态来源复核.结果头.事实截止代次}));
        return {{L2结构合同版本, L2结构状态::已读取, 完整顶层.截止,
            std::nullopt}, 请求.读取类别, 0, std::move(动态),
            L2动态自有关系引用{族归属组->成员.front().关系.编码,
                完整主体组->成员.front().关系.编码,
                完整前状态组->成员.front().关系.编码,
                完整后状态组->成员.front().关系.编码}};
    }

    L2动态完整读取结果 读取历史完整动态(
        const L2动态完整读取请求& 请求,
        const L2动态结构类型登记& 登记) const {
        const auto 动态来源 = 读取动态身份来源({请求.请求头,
            L2读取类别::历史, 请求.动态, 请求.历史截止事实代次});
        if (!动态来源.成功() || !动态来源.身份来源)
            return L2动态结构内部::形成完整读取失败(请求,
                动态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 动态来源.结果头.状态,
                动态来源.结果头.事实截止代次);
        const auto 前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (前代次.状态 != L1中性读取状态::成功
            || 前代次.合同版本 != L1中性CRUD合同版本 || 前代次.事实代次 == 0)
            return L2动态结构内部::形成完整读取失败(请求,
                L2动态结构内部::映射事实代次探测失败(前代次.状态),
                前代次.事实代次);
        if (前代次.事实代次 != 请求.请求头.期望事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移, 前代次.事实代次);
        const auto 节点读取 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 请求.动态.值});
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 请求.动态.值)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点读取.状态 != L1所有者范围读取状态::成功) {
            if (节点读取.事实) return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            return L2动态结构内部::形成完整读取失败(请求,
                L2动态结构内部::映射历史读取动态(节点读取.状态),
                请求.历史截止事实代次);
        }
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (!节点 || 节点->编码 != 请求.动态.值
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点->创建事实代次 > 请求.历史截止事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::未找到, 请求.历史截止事实代次);
        const std::uint64_t 结构截止 = 节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次
            ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
        const auto 主体组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.动态.值, 登记.主体关系类型.值,
            结构截止});
        const auto 前状态组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.动态.值, 登记.前状态关系类型.值,
            结构截止});
        const auto 后状态组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.动态.值, 登记.后状态关系类型.值,
            结构截止});
        const auto 属性组 = L1_.读取所有者范围历史属性值组({L1所有者范围CRUD合同版本,
            请求.动态.值, 结构截止});
        if (主体组.状态 != L1所有者范围读取状态::成功
            || 前状态组.状态 != L1所有者范围读取状态::成功
            || 后状态组.状态 != L1所有者范围读取状态::成功
            || 属性组.状态 != L1所有者范围读取状态::成功) {
            const auto 动态 = 主体组.状态 != L1所有者范围读取状态::成功
                ? L2动态结构内部::映射历史关系组失败动态(主体组.状态)
                : 前状态组.状态 != L1所有者范围读取状态::成功
                    ? L2动态结构内部::映射历史关系组失败动态(前状态组.状态)
                : 后状态组.状态 != L1所有者范围读取状态::成功
                    ? L2动态结构内部::映射历史关系组失败动态(后状态组.状态)
                    : L2动态结构内部::映射历史属性组失败动态(属性组.状态);
            return L2动态结构内部::形成完整读取失败(
                请求, 动态, std::max({主体组.读取事实代次,
                    前状态组.读取事实代次, 后状态组.读取事实代次,
                    属性组.读取事实代次}));
        }
        if (主体组.读取事实代次 != 请求.请求头.期望事实代次
            || 前状态组.读取事实代次 != 请求.请求头.期望事实代次
            || 后状态组.读取事实代次 != 请求.请求头.期望事实代次
            || 属性组.读取事实代次 != 请求.请求头.期望事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移,
                std::max({主体组.读取事实代次,
                    前状态组.读取事实代次, 后状态组.读取事实代次,
                    属性组.读取事实代次}));
        if (主体组.关系组.size() != 1 || 前状态组.关系组.size() != 1
            || 后状态组.关系组.size() != 1
            || 属性组.属性值组.size() != 2)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const L1所有者范围值事实* 起始时间值 = nullptr;
        const L1所有者范围值事实* 结束时间值 = nullptr;
        for (const auto& 值 : 属性组.属性值组) {
            if (值.所属节点 != 请求.动态.值)
                return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) 起始时间值 = &值;
            else if (L2动态结构内部::动态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) 结束时间值 = &值;
            else return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        }
        if (!起始时间值 || !结束时间值)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const auto& 主体关系 = 主体组.关系组.front();
        const auto& 前状态关系 = 前状态组.关系组.front();
        const auto& 后状态关系 = 后状态组.关系组.front();
        const auto 族归属读取 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本,
                动态来源.身份来源->族归属关系稳定编码});
        const auto* 族归属关系 = 族归属读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*族归属读取.事实) : nullptr;
        const auto owner = 动态身份来源定位_.所有者;
        if (!族归属关系 || 节点->写入所有者 != owner
            || 族归属关系->写入所有者 != owner
            || 族归属关系->源节点 != 请求.动态.值
            || 族归属关系->目标节点 != 动态身份来源定位_.族锚点
            || 族归属关系->关系类型节点 != 动态身份来源定位_.族归属关系类型
            || 族归属关系->角色或顺序 != L2动态结构内部::动态端点角色值
            || 主体关系.写入所有者 != owner || 前状态关系.写入所有者 != owner
            || 后状态关系.写入所有者 != owner
            || 起始时间值->写入所有者 != owner || 结束时间值->写入所有者 != owner
            || 主体关系.源节点 != 请求.动态.值
            || 前状态关系.源节点 != 请求.动态.值
            || 后状态关系.源节点 != 请求.动态.值
            || 主体关系.关系类型节点 != 登记.主体关系类型.值
            || 前状态关系.关系类型节点 != 登记.前状态关系类型.值
            || 后状态关系.关系类型节点 != 登记.后状态关系类型.值
            || 主体关系.角色或顺序 != L2动态结构内部::动态端点角色值
            || 前状态关系.角色或顺序 != L2动态结构内部::动态端点角色值
            || 后状态关系.角色或顺序 != L2动态结构内部::动态端点角色值)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点->退出事实代次
            && *节点->退出事实代次 <= 请求.历史截止事实代次) {
            const auto 退出代次 = 节点->退出事实代次;
            if (动态来源.身份来源->节点生命周期.退出事实代次 != 退出代次
                || 动态来源.身份来源->归属关系生命周期.退出事实代次 != 退出代次
                || 族归属关系->退出事实代次 != 退出代次
                || 主体关系.退出事实代次 != 退出代次
                || 前状态关系.退出事实代次 != 退出代次
                || 后状态关系.退出事实代次 != 退出代次
                || 起始时间值->退出事实代次 != 退出代次
                || 结束时间值->退出事实代次 != 退出代次)
                return L2动态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        }
        const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::历史, L2存在身份{主体关系.目标节点},
            请求.历史截止事实代次});
        const auto 前状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::历史, L2状态身份{前状态关系.目标节点},
            请求.历史截止事实代次});
        const auto 后状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::历史, L2状态身份{后状态关系.目标节点},
            请求.历史截止事实代次});
        if (!主体来源.成功() || !前状态来源.成功() || !后状态来源.成功())
            return L2动态结构内部::形成完整读取失败(请求,
                L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 后代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (后代次.状态 != L1中性读取状态::成功
            || 后代次.合同版本 != L1中性CRUD合同版本
            || 后代次.事实代次 != 请求.请求头.期望事实代次)
            return L2动态结构内部::形成完整读取失败(
                请求, 后代次.状态 == L1中性读取状态::成功
                    ? L2结构状态::事实代次漂移
                    : L2动态结构内部::映射事实代次探测失败(后代次.状态),
                后代次.事实代次);
        auto 动态 = L2动态结构内部::形成动态事实(*节点, 主体关系,
            前状态关系, 后状态关系, *起始时间值, *结束时间值,
            登记, 请求.历史截止事实代次);
        if (!动态 || 动态->身份 != 请求.动态)
            return L2动态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return {{L2结构合同版本, L2结构状态::已读取,
            请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
            请求.历史截止事实代次, std::move(动态),
            L2动态自有关系引用{动态来源.身份来源->族归属关系稳定编码,
                主体关系.编码, 前状态关系.编码, 后状态关系.编码}};
    }

    L2当前动态组读取结果 按端点读取动态组(
        const L2结构请求头& 请求头, 稳定编码 端点, 动态端点角色 角色,
        std::uint64_t 最大数量) const {
        const auto 登记结果 = 读取当前动态结构类型登记();
        if (登记结果.状态 != L2动态结构类型登记状态::已读取
            || !登记结果.登记 || !登记结果.成功())
            return L2动态结构内部::形成组读取失败(
                L2动态结构内部::映射登记失败为结构动态(登记结果.状态),
                登记结果.事实截止代次);
        稳定编码 关系类型;
        switch (角色) {
        case 动态端点角色::主体:
            关系类型 = 登记结果.登记->主体关系类型.值;
            break;
        case 动态端点角色::前状态:
            关系类型 = 登记结果.登记->前状态关系类型.值;
            break;
        case 动态端点角色::后状态:
            关系类型 = 登记结果.登记->后状态关系类型.值;
            break;
        }
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 请求头.期望事实代次;
        请求.所有者 = {动态身份来源定位_.所有者};
        请求.目标关系组 = {{端点, 关系类型}};
        const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
        const auto 顶层 = L2动态结构内部::解释一致读取顶层(
            读取, 请求头.期望事实代次);
        if (!顶层.成功()) return L2动态结构内部::形成组读取失败(
            顶层.状态, 顶层.截止);
        const auto* 关系组 = L2动态结构内部::查找唯一目标关系组(
            读取, 端点, 关系类型);
        if (读取.所有者.size() != 1 || !读取.节点.empty()
            || !读取.关系.empty() || !读取.值.empty()
            || !读取.属性值.empty() || !读取.源关系组.empty()
            || 读取.目标关系组.size() != 1 || !关系组
            || 读取.所有者.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实)
            return L2动态结构内部::形成组读取失败(
                L2结构状态::内部不一致, 顶层.截止);
        std::vector<稳定编码> 动态编码组;
        for (const auto& 成员 : 关系组->成员) {
            const auto& 关系 = 成员.关系;
            if (关系.目标节点 != 端点 || 关系.关系类型节点 != 关系类型
                || 关系.角色或顺序 != L2动态结构内部::动态端点角色值
                || 关系.退出事实代次
                || !L2动态结构内部::普通当前节点完整(
                    成员.对端节点, 关系.源节点, 顶层.截止)
                || 关系.写入所有者 != 动态身份来源定位_.所有者
                || 成员.对端节点.写入所有者 != 动态身份来源定位_.所有者
                || std::find(动态编码组.begin(), 动态编码组.end(),
                    关系.源节点) != 动态编码组.end())
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            动态编码组.push_back(关系.源节点);
        }
        std::sort(动态编码组.begin(), 动态编码组.end());
        if (动态编码组.size() > 最大数量)
            return L2动态结构内部::形成组读取失败(
                L2结构状态::数量预算不足, 顶层.截止);
        L2当前动态组读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
            顶层.截止, std::nullopt}, {}};
        结果.动态.reserve(动态编码组.size());
        for (const auto 编码 : 动态编码组) {
            const auto 单项 = 读取完整动态({请求头, L2读取类别::当前,
                L2动态身份{编码}, 0});
            if (单项.结果头.状态 != L2结构状态::已读取 || !单项.动态
                || 单项.结果头.事实截止代次 != 顶层.截止)
            {
                auto 失败状态 = 单项.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 单项.结果头.状态;
                auto 失败截止 = 单项.结果头.事实截止代次;
                if (失败状态 == L2结构状态::内部不一致) {
                    const auto 当前代次 = L1_.读取中性当前事实代次(
                        {L1中性CRUD合同版本});
                    if (当前代次.状态 == L1中性读取状态::成功
                        && 当前代次.事实代次 != 请求头.期望事实代次) {
                        失败状态 = L2结构状态::事实代次漂移;
                        失败截止 = 当前代次.事实代次;
                    }
                }
                return L2动态结构内部::形成组读取失败(失败状态, 失败截止);
            }
            const bool 角色匹配 = 角色 == 动态端点角色::主体
                ? 单项.动态->主体存在.值 == 端点
                : 角色 == 动态端点角色::前状态
                    ? 单项.动态->前状态.值 == 端点
                    : 单项.动态->后状态.值 == 端点;
            if (!角色匹配)
                return L2动态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            结果.动态.push_back(*单项.动态);
        }
        return 结果.成功() ? 结果 : L2动态结构内部::形成组读取失败(
            L2结构状态::内部不一致, 顶层.截止);
    }

public:
    L2动态原子参与者形成结果 形成动态原子参与者写集(
        const L2动态原子参与者请求& 请求) const noexcept {
        L2动态原子参与者形成结果 失败{L2结构状态::内部不一致,
            请求.共同期望事实代次, std::nullopt, {}};
        if (请求.合同版本 != L2结构合同版本
            || 请求.共同期望事实代次 == 0
            || !有效(请求.组合写入幂等身份)
            || !有效(请求.主体存在.值)
            || !有效(请求.变化特征实例.值)
            || !有效(请求.前状态.值)
            || !有效(请求.来源方法稳定编码)
            || 请求.后状态局部引用.参与者
                != L1跨所有者原子事务参与者序号::状态
            || 请求.后状态局部引用.本地键.值 != 0x02041001)
        {
            失败.状态 = L2结构状态::入口拒绝;
            return 失败;
        }
        try {
            const auto 代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            const auto 登记结果 = 读取当前动态结构类型登记();
            const auto 前 = 状态服务_.读取完整状态({
                {L2结构合同版本, 请求.共同期望事实代次},
                L2读取类别::当前, 请求.前状态, 0});
            const auto 主体 = 存在服务_.读取存在身份来源({
                {L2结构合同版本, 请求.共同期望事实代次},
                L2读取类别::当前, 请求.主体存在, 0});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.事实代次 != 请求.共同期望事实代次
                || !登记结果.成功() || !登记结果.登记
                || 前.结果头.状态 != L2结构状态::已读取 || !前.状态
                || 前.状态->主体存在 != 请求.主体存在
                || !主体.成功() || !主体.身份来源
                || 主体.身份来源->节点稳定编码 != 请求.主体存在.值) {
                失败.状态 = 代次.状态 == L1中性读取状态::成功
                    ? (代次.事实代次 == 请求.共同期望事实代次
                        ? L2结构状态::内部不一致
                        : L2结构状态::事实代次漂移)
                    : L2动态结构内部::映射事实代次探测失败(代次.状态);
                return 失败;
            }
            const auto& 登记 = *登记结果.登记;
            const auto 起始类型 = L2动态结构内部::选择动态值类型编码(
                登记, 请求.起始时间材料, true);
            const auto 结束类型 = L2动态结构内部::选择动态值类型编码(
                登记, 请求.结束时间材料, false);
            if (!有效(起始类型) || !有效(结束类型)) {
                失败.状态 = L2结构状态::引用冲突;
                return 失败;
            }
            L1跨所有者原子写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.共同期望事实代次;
            写集.写入幂等身份 = 请求.组合写入幂等身份;
            const L1跨所有者原子事实引用值 节点{
                L1所有者范围写集本地键{0x02051001}};
            写集.节点 = {{{0x02051001}, 节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{0x02052002}, 节点, 动态身份来源定位_.族锚点,
                    动态身份来源定位_.族归属关系类型, 1},
                {{0x02051101}, 节点, 请求.主体存在.值,
                    登记.主体关系类型.值, 1},
                {{0x02051102}, 节点, 请求.前状态.值,
                    登记.前状态关系类型.值, 1},
                {{0x02051103}, 节点,
                    L1跨所有者原子事实引用{
                        L1跨所有者原子事务参与者序号::状态,
                        请求.后状态局部引用.本地键},
                    登记.后状态关系类型.值, 1}};
            写集.值 = {
                {{0x02051201}, 节点, 起始类型,
                    L2动态结构内部::转换为L1材料(请求.起始时间材料),
                    请求.来源方法稳定编码},
                {{0x02051202}, 节点, 结束类型,
                    L2动态结构内部::转换为L1材料(请求.结束时间材料),
                    请求.来源方法稳定编码}};
            写集.属性槽变更 = {
                {节点, 起始类型, {0x02051201}},
                {节点, 结束类型, {0x02051202}}};
            L1跨所有者原子参与者写集 参与者;
            参与者.参与者 = L1跨所有者原子事务参与者序号::动态;
            参与者.所有者 = 第一层写入端口_.所有者身份();
            参与者.写集 = std::move(写集);
            失败.状态 = L2结构状态::已读取;
            失败.参与者 = std::move(参与者);
            return 失败;
        } catch (const std::bad_alloc&) {
            失败.状态 = L2结构状态::资源失败;
        } catch (...) {
            失败.状态 = L2结构状态::内部不一致;
        }
        return 失败;
    }

private:
    class 中性动态提供者 final {
    public:
        中性动态提供者(const L1事实基座服务& L1,
            L1所有者范围写端口& 所有者写入端口,
            L2状态结构服务& 状态服务,
            const L2动态结构内部::动态身份来源定位& 定位,
            const std::optional<L2动态结构类型登记>& 类型登记,
            const L2动态结构内部::动态上下文关系类型定位& 上下文定位,
            L2中性实例材料保留策略_v1 保留策略) noexcept
            : L1_(L1), 所有者写入端口_(所有者写入端口),
              状态服务_(状态服务), 定位_(定位),
              类型登记_(类型登记), 上下文定位_(上下文定位),
              保留策略_(保留策略) {}

        当前值记录动态参与者结果_v1 形成当前值记录动态参与者_v1(
            const L2结构请求头& 请求头, L2结构幂等身份 幂等身份,
            L2存在身份 主体存在, L2场景身份 共同场景,
            L2特征实例身份 特征实例, L2存在身份 来源存在,
            const std::optional<L2方法身份>& 来源方法,
            const L1三分区原子事实引用值_v2& 前状态,
            const L1三分区原子事实引用值_v2& 后状态,
            稳定编码 上下文关系类型, std::int64_t 变化UTC纳秒,
            L1结构所有者身份 动态所有者) const noexcept {
            当前值记录动态参与者结果_v1 失败;
            if (!L2结构请求头合同有效(请求头)
                || 请求头.期望事实代次 == 0
                || !L2结构幂等身份有效(幂等身份)
                || !有效(主体存在.值) || !有效(共同场景.值)
                || !有效(特征实例.值) || !有效(来源存在.值)
                || (来源方法 && !有效(来源方法->值))
                || !有效(上下文关系类型) || 变化UTC纳秒 <= 0
                || !有效(动态所有者) || !类型登记_) {
                失败.状态 = L2结构状态::入口拒绝;
                return 失败;
            }
            try {
                constexpr std::uint32_t 迁移根键 = 0x02F5'1101U;
                constexpr std::uint32_t 迁移索引键 = 0x02F5'1102U;
                constexpr std::uint32_t 迁移载荷键 = 0x02F5'1103U;
                constexpr std::uint32_t 动作根键 = 0x02F5'1201U;
                constexpr std::uint32_t 动作索引键 = 0x02F5'1202U;
                constexpr std::uint32_t 动作载荷键 = 0x02F5'1203U;
                L1三分区原子写集请求_v2 写集;
                写集.合同版本 = L1所有者范围CRUD合同版本;
                写集.期望事实代次 = 请求头.期望事实代次;
                写集.写入幂等身份 = {幂等身份.值};
                const auto 追加动态 = [&](std::uint32_t 根键,
                    std::uint32_t 索引键, std::uint32_t 载荷键,
                    std::uint32_t 上下文起始键,
                    L2中性动态记录类别_v1 类别,
                    bool 携带动作来源) {
                    const L1所有者范围写集本地键 根{根键};
                    写集.节点.push_back({根, 节点种类::普通, std::nullopt});
                    写集.关系.push_back({{索引键}, 根, 定位_.族锚点,
                        定位_.族归属关系类型, 动态索引角色});
                    写集.值.push_back({{载荷键}, 根,
                        类型登记_->起始U64组值类型.值,
                        std::vector<std::uint64_t>{
                            L2动态结构内部::动态关系式载荷魔数,
                            L2中性状态动态合同版本_v1,
                            static_cast<std::uint64_t>(类别),
                            std::bit_cast<std::uint64_t>(变化UTC纳秒)}, 根});
                    写集.属性槽变更.push_back({根,
                        类型登记_->起始U64组值类型.值, {载荷键}});
                    写集.关系.push_back({{上下文起始键}, 根,
                        主体存在.值, 上下文关系类型, 1});
                    写集.关系.push_back({{上下文起始键 + 1}, 根,
                        共同场景.值, 上下文关系类型, 2});
                    写集.关系.push_back({{上下文起始键 + 2}, 根,
                        特征实例.值, 上下文关系类型, 3});
                    写集.关系.push_back({{上下文起始键 + 3}, 根,
                        前状态, 上下文关系类型, 4});
                    写集.关系.push_back({{上下文起始键 + 4}, 根,
                        后状态, 上下文关系类型, 5});
                    if (携带动作来源) {
                        写集.关系.push_back({{上下文起始键 + 5}, 根,
                            来源方法->值, 上下文关系类型, 6});
                        写集.关系.push_back({{上下文起始键 + 7}, 根,
                            L1所有者范围写集本地键{迁移根键},
                            上下文关系类型, 8});
                    }
                    写集.关系.push_back({{上下文起始键 + 8}, 根,
                        来源存在.值, 上下文关系类型, 9});
                };
                追加动态(迁移根键, 迁移索引键, 迁移载荷键,
                    0x02F5'1111U, L2中性动态记录类别_v1::状态迁移,
                    false);
                if (来源方法)
                    追加动态(动作根键, 动作索引键, 动作载荷键,
                        0x02F5'1211U, L2中性动态记录类别_v1::动作致变,
                        true);
                L1三分区原子参与者写集_v2 参与者;
                参与者.参与者 = {3};
                参与者.所有者 = 动态所有者;
                参与者.写集 = std::move(写集);
                失败.状态 = L2结构状态::已读取;
                失败.参与者 = std::move(参与者);
                失败.状态迁移动能本地键 = {迁移根键};
                if (来源方法) 失败.动作致变动态本地键 = {动作根键};
                return 失败;
            } catch (const std::bad_alloc&) {
                失败.状态 = L2结构状态::资源失败;
            } catch (const std::length_error&) {
                失败.状态 = L2结构状态::资源失败;
            } catch (...) {
                失败.状态 = L2结构状态::内部不一致;
            }
            return 失败;
        }

        L2中性动态写入结果_v1 新增动态(
            const L2中性动态新增请求_v1& 请求) noexcept {
            if (!L2中性动态新增请求有效_v1(请求))
                return 动态写失败(L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_) || !类型登记_)
                return 动态写失败(L2中性结构状态_v1::内部错误);
            try {
                std::scoped_lock 锁(新增锁_);
                for (const auto& 项 : 新增缓存_) {
                    if (项.请求.幂等身份 != 请求.幂等身份) continue;
                    if (项.请求 != 请求)
                        return 动态写失败(L2中性结构状态_v1::幂等冲突);
                    auto 结果 = 项.结果;
                    结果.结果头.状态 = L2中性结构状态_v1::精确重复;
                    return 结果;
                }
                const auto G0 = 当前代次();
                if (!G0) return 动态写失败(L2中性结构状态_v1::内部错误);
                if (*G0 != 请求.请求头.期望事实代次)
                    return 动态写失败(L2中性结构状态_v1::事实代次漂移, *G0);
                std::vector<L2中性动态成员_v1> 成员;
                成员.reserve(请求.有序状态组.size());
                for (std::size_t i = 0; i < 请求.有序状态组.size(); ++i)
                    成员.push_back({static_cast<std::uint32_t>(i + 1),
                        请求.有序状态组[i]});
                const auto 状态组 = 读取成员状态(成员, 请求.材料类别,
                    std::nullopt, L2读取类别::当前, *G0, 0);
                if (状态组.状态 != L2中性结构状态_v1::已读取)
                    return 动态写失败(状态组.状态, *G0);
                bool 冲突 = false;
                const auto 首次UTC = 取得首次UTC(请求, 冲突);
                if (冲突) return 动态写失败(L2中性结构状态_v1::幂等冲突);
                if (!首次UTC || *首次UTC <= 0 || !状态组.时间语义)
                    return 动态写失败(L2中性结构状态_v1::内部错误);
                const auto 写集 = 形成动态新增写集(
                    请求, *状态组.时间语义, *首次UTC);
                const auto 写入 = 提交写集(写集);
                const auto 映射 = 映射写入状态(写入.状态);
                if (写入.状态 != L1中性写入状态::成功
                    && 写入.状态 != L1中性写入状态::精确重复)
                    return 动态写失败(映射, 写入.事实代次);
                const auto 根 = 查找新编码(写入, 动态根本地键值);
                if (!根 || 写入.事实代次 == 0)
                    return 动态写失败(
                        L2中性结构状态_v1::内部错误, 写入.事实代次);
                const auto 截止 = 当前代次();
                if (!截止) return 动态写失败(L2中性结构状态_v1::内部错误);
                const auto 读回 = 读取当前动态闭包(*根, *截止);
                if (!读回.闭包 || 读回.状态 != L2中性结构状态_v1::已读取)
                    return 动态写失败(读回.状态, *截止);
                const auto& 动态 = 读回.闭包->动态;
                if (动态.材料类别 != 请求.材料类别
                    || 动态.时间语义 != *状态组.时间语义
                    || 动态.首次形成UTC纳秒 != *首次UTC
                    || 动态.有序状态组 != 成员)
                    return 动态写失败(L2中性结构状态_v1::内部错误, *截止);
                const auto 正式成员 = 读取成员状态(动态.有序状态组,
                    动态.材料类别, 动态.时间语义,
                    L2读取类别::当前, *截止, 0);
                if (正式成员.状态 != L2中性结构状态_v1::已读取)
                    return 动态写失败(正式成员.状态, *截止);
                L2中性动态写入结果_v1 结果{{L2中性状态动态合同版本_v1,
                    映射, *截止, 动态.形成事实代次}, 动态};
                if (!结果.成功())
                    return 动态写失败(L2中性结构状态_v1::内部错误, *截止);
                新增缓存_.push_back({请求, 结果});
                return 结果;
            } catch (const std::bad_alloc&) {
                return 动态写失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 动态写失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 动态写失败(L2中性结构状态_v1::内部错误);
            }
        }

        L2中性动态读取结果_v1 读取动态(
            const L2中性动态读取请求_v1& 请求) const noexcept {
            if (!L2中性动态读取请求有效_v1(请求))
                return 动态读失败(请求, L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_) || !类型登记_)
                return 动态读失败(请求, L2中性结构状态_v1::内部错误);
            try {
                const auto 前 = 当前代次();
                if (!前) return 动态读失败(请求,
                    L2中性结构状态_v1::内部错误);
                if (*前 != 请求.请求头.期望事实代次)
                    return 动态读失败(请求,
                        L2中性结构状态_v1::事实代次漂移, *前);
                const auto 读取 = 请求.读取类别 == L2读取类别::当前
                    ? 读取当前动态闭包(请求.动态.值, *前)
                    : 读取历史动态闭包(请求.动态.值,
                        请求.历史截止事实代次, *前);
                if (!读取.闭包) {
                    const auto 后 = 当前代次();
                    if (!后 || *后 != *前)
                        return 动态读失败(请求,
                            L2中性结构状态_v1::事实代次漂移,
                            后.value_or(0));
                    return 动态读失败(请求, 读取.状态, *前, 读取.墓碑);
                }
                if (读取.状态 != L2中性结构状态_v1::已读取)
                    return 动态读失败(请求, 读取.状态, *前, 读取.墓碑);
                const auto 状态组 = 读取成员状态(读取.闭包->动态.有序状态组,
                    读取.闭包->动态.材料类别, 读取.闭包->动态.时间语义,
                    请求.读取类别, *前, 请求.历史截止事实代次);
                const auto 后 = 当前代次();
                if (!后 || *后 != *前)
                    return 动态读失败(请求,
                        L2中性结构状态_v1::事实代次漂移, 后.value_or(0));
                if (状态组.状态 != L2中性结构状态_v1::已读取)
                    return 动态读失败(请求, 状态组.状态, *前);
                L2中性动态读取结果_v1 结果{{
                    L2中性状态动态合同版本_v1,
                    L2中性结构状态_v1::已读取, *前, std::nullopt},
                    请求.读取类别, 请求.历史截止事实代次,
                    读取.闭包->动态, 状态组.状态组, std::nullopt};
                return 结果.成功() ? 结果 : 动态读失败(
                    请求, L2中性结构状态_v1::内部错误, *前);
            } catch (const std::bad_alloc&) {
                return 动态读失败(请求, L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 动态读失败(请求, L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 动态读失败(请求, L2中性结构状态_v1::内部错误);
            }
        }

        L2中性动态退出结果_v1 退出动态(
            const L2中性动态退出请求_v1& 请求) noexcept {
            if (!L2结构请求头合同有效(请求.请求头)
                || 请求.请求头.期望事实代次 == 0
                || 请求.专属合同版本 != L2中性状态动态合同版本_v1
                || !L2结构幂等身份有效(请求.幂等身份)
                || !有效(请求.动态.值))
                return 动态退失败(L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_) || !类型登记_)
                return 动态退失败(L2中性结构状态_v1::内部错误);
            try {
                std::scoped_lock 锁(退出锁_);
                for (const auto& 项 : 退出缓存_) {
                    if (项.请求.幂等身份 != 请求.幂等身份) continue;
                    if (项.请求 != 请求)
                        return 动态退失败(L2中性结构状态_v1::幂等冲突);
                    auto 结果 = 项.结果;
                    结果.结果头.状态 = L2中性结构状态_v1::精确重复;
                    return 结果;
                }
                const auto 当前 = 当前代次();
                if (!当前) return 动态退失败(L2中性结构状态_v1::内部错误);
                const auto 读取 = *当前 == 请求.请求头.期望事实代次
                    ? 读取当前动态闭包(请求.动态.值, *当前)
                    : 读取历史动态闭包(请求.动态.值,
                        请求.请求头.期望事实代次, *当前);
                if (!读取.闭包) return 动态退失败(读取.状态, *当前);
                L1中性写集请求 写集;
                写集.合同版本 = L1中性CRUD合同版本;
                写集.期望事实代次 = 请求.请求头.期望事实代次;
                写集.幂等键 = 映射幂等键(退出动态幂等域, 请求.幂等身份);
                写集.退出事实 = 动态退出事实组(*读取.闭包);
                const auto 写入 = 读取.闭包->上下文关系.empty()
                    ? 提交写集(写集)
                    : 提交所有者写集(写集);
                const auto 映射 = 映射写入状态(写入.状态);
                if (写入.状态 != L1中性写入状态::成功
                    && 写入.状态 != L1中性写入状态::精确重复)
                    return 动态退失败(映射, 写入.事实代次);
                const auto 截止 = 当前代次();
                if (!截止 || 写入.事实代次 == 0)
                    return 动态退失败(L2中性结构状态_v1::内部错误);
                const auto 历史 = 读取历史动态闭包(请求.动态.值,
                    写入.事实代次 - 1, *截止);
                if (!历史.闭包)
                    return 动态退失败(历史.状态, *截止);
                L2中性动态退出结果_v1 结果{{
                    L2中性状态动态合同版本_v1,
                    写入.状态 == L1中性写入状态::精确重复
                        ? L2中性结构状态_v1::精确重复
                        : L2中性结构状态_v1::已退出,
                    *截止, 写入.事实代次}, 历史.闭包->动态};
                if (!结果.成功())
                    return 动态退失败(L2中性结构状态_v1::内部错误, *截止);
                退出缓存_.push_back({请求, 结果});
                return 结果;
            } catch (const std::bad_alloc&) {
                return 动态退失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 动态退失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 动态退失败(L2中性结构状态_v1::内部错误);
            }
        }

        L2中性实例材料清理结果_v1 执行实例材料清理(
            const L2中性实例材料清理请求_v1& 请求) noexcept {
            if (!L2中性实例材料清理请求有效_v1(请求))
                return 清理失败(L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_) || !类型登记_)
                return 清理失败(L2中性结构状态_v1::内部错误);
            try {
                std::scoped_lock 锁(清理锁_);
                清理进度项* 进度 = nullptr;
                for (auto& 项 : 清理进度_) {
                    if (项.请求.幂等身份 != 请求.幂等身份) continue;
                    if (项.请求 != 请求)
                        return 清理失败(L2中性结构状态_v1::幂等冲突);
                    if (项.最终结果) {
                        auto 结果 = *项.最终结果;
                        if (结果.结果头.变更事实代次)
                            结果.结果头.状态 = L2中性结构状态_v1::精确重复;
                        return 结果;
                    }
                    进度 = &项;
                    break;
                }
                if (!进度) {
                    const auto G0 = 当前代次();
                    if (!G0) return 清理失败(L2中性结构状态_v1::内部错误);
                    if (*G0 != 请求.请求头.期望事实代次)
                        return 清理失败(
                            L2中性结构状态_v1::事实代次漂移, *G0);
                    const auto 当前UTC = 生产当前UTC纳秒();
                    if (!当前UTC) return 清理失败(
                        L2中性结构状态_v1::内部错误, *G0);
                    const auto 计划 = 形成清理计划(请求, *当前UTC, *G0);
                    if (计划.状态 != L2中性结构状态_v1::已读取)
                        return 清理失败(计划.状态, *G0, nullptr, nullptr,
                            计划.清理前实例动态数量,
                            计划.清理前实例动态数量);
                    清理进度_.push_back({请求, *当前UTC, 计划.候选,
                        {}, 计划.清理前实例动态数量,
                        计划.清理后实例动态数量, std::nullopt,
                        false, std::nullopt, std::nullopt});
                    进度 = &清理进度_.back();
                }
                if (!进度->动态阶段完成) {
                    std::uint64_t 动态阶段截止 = 请求.请求头.期望事实代次;
                    if (!进度->候选.empty()) {
                        L1中性写集请求 旧式退出写集;
                        旧式退出写集.合同版本 = L1中性CRUD合同版本;
                        旧式退出写集.期望事实代次 =
                            请求.请求头.期望事实代次;
                        旧式退出写集.幂等键 = 映射幂等键(
                            清理逻辑退出幂等域, 请求.幂等身份);
                        L1中性写集请求 关系式退出写集;
                        关系式退出写集.合同版本 = L1中性CRUD合同版本;
                        关系式退出写集.幂等键 = 映射幂等键(
                            清理关系式逻辑退出幂等域, 请求.幂等身份);
                        for (const auto& 动态 : 进度->候选) {
                            const auto 组 = 动态退出事实组(动态.闭包);
                            auto& 写集 = 动态.闭包.上下文关系.empty()
                                ? 旧式退出写集 : 关系式退出写集;
                            写集.退出事实.insert(写集.退出事实.end(),
                                组.begin(), 组.end());
                        }
                        规范退出事实(旧式退出写集.退出事实);
                        规范退出事实(关系式退出写集.退出事实);
                        std::uint64_t 退出事实代次 =
                            请求.请求头.期望事实代次;
                        L1中性写入结果 退出{};
                        if (!旧式退出写集.退出事实.empty()) {
                            退出 = 提交写集(旧式退出写集);
                            if (退出.状态 != L1中性写入状态::成功
                                && 退出.状态 != L1中性写入状态::精确重复)
                                return 清理失败(映射写入状态(退出.状态),
                                    退出.事实代次, 进度);
                            退出事实代次 = 退出.事实代次;
                        }
                        if (!关系式退出写集.退出事实.empty()) {
                            关系式退出写集.期望事实代次 = 退出事实代次;
                            退出 = 提交所有者写集(关系式退出写集);
                            if (退出.状态 != L1中性写入状态::成功
                                && 退出.状态 != L1中性写入状态::精确重复)
                                return 清理失败(映射写入状态(退出.状态),
                                    退出.事实代次, 进度);
                            退出事实代次 = 退出.事实代次;
                        }
                        L1物理清理请求 清理请求;
                        清理请求.合同版本 = L1物理清理合同版本;
                        清理请求.期望事实代次 = 退出事实代次;
                        清理请求.幂等身份 = {
                            物理清理幂等域 ^ 请求.幂等身份.值};
                        for (const auto& 动态 : 进度->候选)
                            追加物理闭包(清理请求, 动态.闭包);
                        std::sort(清理请求.待清理事实身份组.begin(),
                            清理请求.待清理事实身份组.end());
                        清理请求.待清理事实身份组.erase(std::unique(
                            清理请求.待清理事实身份组.begin(),
                            清理请求.待清理事实身份组.end()),
                            清理请求.待清理事实身份组.end());
                        const auto 清理 = const_cast<L1事实基座服务&>(L1_)
                            .执行L1物理清理(清理请求);
                        if (!清理.成功()) return 清理失败(
                            映射清理状态(清理.状态),
                            清理.物理清理事实代次, 进度);
                        进度->已清理动态.clear();
                        for (const auto& 动态 : 进度->候选) {
                            const auto 项 = std::find_if(清理.墓碑组.begin(),
                                清理.墓碑组.end(), [&](const auto& 墓碑) {
                                    return 墓碑.事实种类
                                            == L1物理清理事实种类::节点
                                        && 墓碑.编码 == 动态.闭包.动态.身份.值;
                                });
                            if (项 == 清理.墓碑组.end())
                                return 清理失败(
                                    L2中性结构状态_v1::内部错误,
                                    清理.物理清理事实代次, 进度);
                            进度->已清理动态.push_back({项->编码,
                                L2中性事实种类_v1::动态,
                                项->内部结构分区, 项->创建事实代次,
                                项->退出事实代次,
                                项->物理清理事实代次});
                        }
                        进度->动态变更事实代次 = 清理.物理清理事实代次;
                        动态阶段截止 = 清理.物理清理事实代次;
                    }
                    const auto 当前 = 当前代次();
                    if (!当前 || *当前 < 动态阶段截止)
                        return 清理失败(
                            L2中性结构状态_v1::内部错误,
                            当前.value_or(0), 进度);
                    const auto 覆盖 = 形成活动实例成员覆盖(*当前);
                    if (覆盖.状态 != L2中性结构状态_v1::已读取)
                        return 清理失败(覆盖.状态, *当前, 进度);
                    进度->状态清理请求 = L2中性实例状态清理阶段请求_v1{
                        L2中性状态动态合同版本_v1,
                        {L2结构合同版本, *当前}, 进度->本次UTC,
                        覆盖.状态身份规范组, *当前, 请求.幂等身份};
                    进度->动态阶段完成 = true;
                }
                if (!进度->状态清理请求)
                    return 清理失败(L2中性结构状态_v1::内部错误,
                        进度->动态变更事实代次.value_or(0), 进度);
                const auto 状态阶段 = 执行L2中性实例状态清理阶段_v1(
                    状态服务_, *进度->状态清理请求);
                if (!状态阶段.成功())
                    return 清理失败(状态阶段.结果头.状态,
                        状态阶段.结果头.事实截止代次, 进度, &状态阶段);
                const bool 动态有写 = !进度->已清理动态.empty();
                const bool 状态有写 = !状态阶段.已清理状态.empty();
                const auto 最终变更 = 状态有写
                    ? 状态阶段.结果头.变更事实代次
                    : 进度->动态变更事实代次;
                L2中性实例材料清理结果_v1 结果;
                结果.结果头 = {L2中性状态动态合同版本_v1,
                    动态有写 || 状态有写
                        ? L2中性结构状态_v1::已提交
                        : L2中性结构状态_v1::无须清理,
                    状态阶段.结果头.事实截止代次, 最终变更};
                结果.已清理动态 = 进度->已清理动态;
                结果.已清理状态 = 状态阶段.已清理状态;
                结果.已退出当前选择 = 状态阶段.已退出当前选择;
                结果.清理前实例动态数量 = 进度->清理前实例动态数量;
                结果.清理后实例动态数量 = 进度->清理后实例动态数量;
                结果.清理前实例状态数量 = 状态阶段.清理前实例状态数量;
                结果.清理后实例状态数量 = 状态阶段.清理后实例状态数量;
                if (!结果.成功())
                    return 清理失败(L2中性结构状态_v1::内部错误,
                        状态阶段.结果头.事实截止代次, 进度, &状态阶段);
                进度->最终结果 = 结果;
                return 结果;
            } catch (const std::bad_alloc&) {
                return 清理失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 清理失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 清理失败(L2中性结构状态_v1::内部错误);
            }
        }

    private:
        static constexpr std::uint64_t 动态载荷魔数 =
            0x4C32'4E44'594E'3031ULL;
        static constexpr std::uint64_t 新增动态幂等域 = 0x41ULL;
        static constexpr std::uint64_t 退出动态幂等域 = 0x42ULL;
        static constexpr std::uint64_t 清理逻辑退出幂等域 = 0x43ULL;
        static constexpr std::uint64_t 清理关系式逻辑退出幂等域 = 0x44ULL;
        static constexpr std::uint64_t 物理清理幂等域 =
            0x4C32'4459'434C'4541ULL;
        static constexpr std::int64_t 动态索引角色 = 0x4E44'5931;
        static constexpr std::uint32_t 动态根本地键值 = 0x02F5'1001U;
        static constexpr std::uint32_t 索引关系本地键值 = 0x02F5'1002U;
        static constexpr std::uint32_t 载荷值本地键值 = 0x02F5'1003U;

        struct 动态物理闭包 final {
            L2中性动态事实_v1 动态{};
            稳定编码 索引关系{};
            稳定编码 载荷值{};
            std::vector<稳定编码> 上下文关系{};
        };
        struct 关系式动态解码 final {
            L2中性动态事实_v1 动态{};
            std::vector<稳定编码> 上下文关系{};
        };
        struct 动态闭包读取 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::optional<动态物理闭包> 闭包{};
            std::optional<L2中性结构墓碑_v1> 墓碑{};
        };
        struct 动态枚举结果 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::vector<动态物理闭包> 动态组{};
        };
        struct 成员读取结果 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::optional<L2中性时间语义_v1> 时间语义{};
            std::vector<L2中性状态事实_v1> 状态组{};
        };
        struct 实例动态项 final {
            动态物理闭包 闭包{};
            std::int64_t 最早绝对时间 = 0;
        };
        struct 清理计划结果 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::vector<实例动态项> 候选{};
            std::uint64_t 清理前实例动态数量 = 0;
            std::uint64_t 清理后实例动态数量 = 0;
        };
        struct 覆盖结果 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::vector<L2状态身份> 状态身份规范组{};
        };
        struct 首次UTC项 final {
            L2中性动态新增请求_v1 请求{};
            std::int64_t UTC纳秒 = 0;
        };
        struct 新增缓存项 final {
            L2中性动态新增请求_v1 请求{};
            L2中性动态写入结果_v1 结果{};
        };
        struct 退出缓存项 final {
            L2中性动态退出请求_v1 请求{};
            L2中性动态退出结果_v1 结果{};
        };
        struct 清理进度项 final {
            L2中性实例材料清理请求_v1 请求{};
            std::int64_t 本次UTC = 0;
            std::vector<实例动态项> 候选{};
            std::vector<L2中性结构墓碑_v1> 已清理动态{};
            std::uint64_t 清理前实例动态数量 = 0;
            std::uint64_t 清理后实例动态数量 = 0;
            std::optional<std::uint64_t> 动态变更事实代次{};
            bool 动态阶段完成 = false;
            std::optional<L2中性实例状态清理阶段请求_v1> 状态清理请求{};
            std::optional<L2中性实例材料清理结果_v1> 最终结果{};
        };

        static L2中性动态写入结果_v1 动态写失败(
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                std::nullopt};
        }
        static L2中性动态读取结果_v1 动态读失败(
            const L2中性动态读取请求_v1& 请求,
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0,
            std::optional<L2中性结构墓碑_v1> 墓碑 = std::nullopt) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::nullopt, {},
                std::move(墓碑)};
        }
        static L2中性动态退出结果_v1 动态退失败(
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                std::nullopt};
        }
        static L2中性实例材料清理结果_v1 清理失败(
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0,
            const 清理进度项* 进度 = nullptr,
            const L2中性实例状态清理阶段结果_v1* 状态阶段 = nullptr,
            std::uint64_t 动态前 = 0, std::uint64_t 动态后 = 0) {
            L2中性实例材料清理结果_v1 结果;
            结果.结果头 = {L2中性状态动态合同版本_v1, 状态, 截止,
                进度 ? 进度->动态变更事实代次 : std::nullopt};
            if (进度) {
                结果.已清理动态 = 进度->已清理动态;
                结果.清理前实例动态数量 = 进度->清理前实例动态数量;
                结果.清理后实例动态数量 = 进度->清理后实例动态数量;
            } else {
                结果.清理前实例动态数量 = 动态前;
                结果.清理后实例动态数量 = 动态后;
            }
            if (状态阶段) {
                结果.已清理状态 = 状态阶段->已清理状态;
                结果.已退出当前选择 = 状态阶段->已退出当前选择;
                结果.清理前实例状态数量 = 状态阶段->清理前实例状态数量;
                结果.清理后实例状态数量 = 状态阶段->清理后实例状态数量;
            }
            return 结果;
        }

        std::optional<std::uint64_t> 当前代次() const noexcept {
            const auto 读取 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (读取.状态 != L1中性读取状态::成功
                || 读取.合同版本 != L1中性CRUD合同版本
                || 读取.事实代次 == 0) return std::nullopt;
            return 读取.事实代次;
        }
        static std::optional<std::int64_t> 生产当前UTC纳秒() noexcept {
            const auto 当前 = std::chrono::duration_cast<std::chrono::nanoseconds>(
                std::chrono::system_clock::now().time_since_epoch()).count();
            return 当前 > 0 ? std::optional<std::int64_t>{当前} : std::nullopt;
        }
        static L1中性写集幂等键 映射幂等键(
            std::uint64_t 域, L2结构幂等身份 身份) noexcept {
            return {(域 << 56) | 身份.值};
        }
        static L2中性结构状态_v1 映射写入状态(
            L1中性写入状态 状态) noexcept {
            switch (状态) {
            case L1中性写入状态::成功: return L2中性结构状态_v1::已提交;
            case L1中性写入状态::精确重复:
                return L2中性结构状态_v1::精确重复;
            case L1中性写入状态::事实代次漂移:
                return L2中性结构状态_v1::事实代次漂移;
            case L1中性写入状态::幂等冲突:
                return L2中性结构状态_v1::幂等冲突;
            case L1中性写入状态::引用冲突:
                return L2中性结构状态_v1::引用冲突;
            case L1中性写入状态::资源失败:
                return L2中性结构状态_v1::资源失败;
            default: return L2中性结构状态_v1::内部错误;
            }
        }
        static L2中性结构状态_v1 映射读取状态(
            L1中性读取状态 状态, bool 历史 = false) noexcept {
            switch (状态) {
            case L1中性读取状态::成功: return L2中性结构状态_v1::已读取;
            case L1中性读取状态::未找到: return L2中性结构状态_v1::未找到;
            case L1中性读取状态::已退出: return L2中性结构状态_v1::已退出;
            case L1中性读取状态::历史材料已清理:
                return 历史 ? L2中性结构状态_v1::历史材料已清理
                    : L2中性结构状态_v1::已清理;
            case L1中性读取状态::资源失败:
                return L2中性结构状态_v1::资源失败;
            default: return L2中性结构状态_v1::内部错误;
            }
        }
        static L2中性结构状态_v1 映射清理状态(
            L1物理清理状态 状态) noexcept {
            switch (状态) {
            case L1物理清理状态::事实代次漂移:
                return L2中性结构状态_v1::事实代次漂移;
            case L1物理清理状态::同键冲突:
                return L2中性结构状态_v1::幂等冲突;
            case L1物理清理状态::引用冲突:
            case L1物理清理状态::尚未退出:
                return L2中性结构状态_v1::引用冲突;
            case L1物理清理状态::资源失败:
                return L2中性结构状态_v1::资源失败;
            default: return L2中性结构状态_v1::内部错误;
            }
        }
        static L2中性结构状态_v1 映射成员失败(
            L2中性结构状态_v1 状态) noexcept {
            switch (状态) {
            case L2中性结构状态_v1::事实代次漂移:
            case L2中性结构状态_v1::资源失败:
                return 状态;
            case L2中性结构状态_v1::未找到:
            case L2中性结构状态_v1::已退出:
            case L2中性结构状态_v1::已清理:
            case L2中性结构状态_v1::历史材料已清理:
                return L2中性结构状态_v1::引用冲突;
            default: return L2中性结构状态_v1::内部错误;
            }
        }
        static std::optional<稳定编码> 查找新编码(
            const L1中性写入结果& 写入, std::uint32_t 本地键) noexcept {
            for (const auto& [键, 编码] : 写入.新编码映射)
                if (键.值 == 本地键) return 编码;
            return std::nullopt;
        }

        std::optional<std::int64_t> 取得首次UTC(
            const L2中性动态新增请求_v1& 请求, bool& 冲突) {
            for (const auto& 项 : 首次UTC组_) {
                if (项.请求.幂等身份 != 请求.幂等身份) continue;
                if (项.请求 != 请求) { 冲突 = true; return std::nullopt; }
                return 项.UTC纳秒;
            }
            const auto 当前 = 生产当前UTC纳秒();
            if (!当前) return std::nullopt;
            首次UTC组_.push_back({请求, *当前});
            return 当前;
        }
        static std::vector<std::uint64_t> 编码动态载荷(
            const L2中性动态新增请求_v1& 请求,
            L2中性时间语义_v1 时间语义, std::int64_t 首次UTC) {
            std::vector<std::uint64_t> 载荷{动态载荷魔数,
                L2中性状态动态合同版本_v1,
                static_cast<std::uint64_t>(请求.材料类别),
                static_cast<std::uint64_t>(时间语义),
                std::bit_cast<std::uint64_t>(首次UTC),
                请求.有序状态组.size()};
            载荷.reserve(6 + 请求.有序状态组.size());
            for (const auto& 状态 : 请求.有序状态组)
                载荷.push_back(状态.值.值);
            return 载荷;
        }
        static std::optional<L2中性动态事实_v1> 解码动态载荷(
            稳定编码 身份, std::uint64_t 创建代次,
            const std::vector<std::uint64_t>& 载荷) {
            if (载荷.size() < 8 || 载荷[0] != 动态载荷魔数
                || 载荷[1] != L2中性状态动态合同版本_v1
                || 载荷[5] < 2 || 载荷.size() != 6 + 载荷[5])
                return std::nullopt;
            std::vector<L2中性动态成员_v1> 成员;
            成员.reserve(static_cast<std::size_t>(载荷[5]));
            for (std::size_t i = 0; i < 载荷[5]; ++i)
                成员.push_back({static_cast<std::uint32_t>(i + 1),
                    L2状态身份{稳定编码{载荷[6 + i]}}});
            L2中性动态事实_v1 动态{L2动态身份{身份},
                static_cast<L2中性材料类别_v1>(载荷[2]),
                static_cast<L2中性时间语义_v1>(载荷[3]),
                std::move(成员), std::bit_cast<std::int64_t>(载荷[4]),
                创建代次};
            return L2中性动态事实完整_v1(动态)
                ? std::optional<L2中性动态事实_v1>{std::move(动态)}
                : std::nullopt;
        }
        static std::optional<关系式动态解码> 解码关系式动态载荷(
            稳定编码 身份, std::uint64_t 创建代次,
            const std::vector<std::uint64_t>& 载荷,
            const std::vector<L1中性关系事实>& 关系组) {
            if (载荷.size() != 4
                || 载荷[0] != L2动态结构内部::动态关系式载荷魔数
                || 载荷[1] != L2中性状态动态合同版本_v1)
                return std::nullopt;
            const auto 类别 = static_cast<L2中性动态记录类别_v1>(载荷[2]);
            if (类别 != L2中性动态记录类别_v1::状态迁移
                && 类别 != L2中性动态记录类别_v1::动作致变)
                return std::nullopt;
            const auto UTC = std::bit_cast<std::int64_t>(载荷[3]);
            if (UTC <= 0) return std::nullopt;
            bool 角色[10]{};
            std::optional<L2状态身份> 前状态;
            std::optional<L2状态身份> 后状态;
            std::vector<稳定编码> 上下文关系;
            上下文关系.reserve(关系组.size());
            for (const auto& 关系 : 关系组) {
                const auto 角色值 = 关系.角色或顺序;
                if (关系.源节点 != 身份
                    || 角色值 < 1 || 角色值 > 9 || 角色值 == 7
                    || 角色[角色值] || 关系.退出事实代次)
                    return std::nullopt;
                角色[角色值] = true;
                上下文关系.push_back(关系.编码);
                if (角色值 == 4) 前状态 = L2状态身份{关系.目标节点};
                else if (角色值 == 5) 后状态 = L2状态身份{关系.目标节点};
            }
            if (!角色[1] || !角色[2] || !角色[3] || !角色[4]
                || !角色[5] || !角色[9] || 角色[6] != 角色[8]
                || (类别 == L2中性动态记录类别_v1::动作致变) != 角色[6]
                || !前状态 || !后状态)
                return std::nullopt;
            std::sort(上下文关系.begin(), 上下文关系.end());
            L2中性动态事实_v1 动态{L2动态身份{身份},
                L2中性材料类别_v1::实例,
                L2中性时间语义_v1::绝对UTC纳秒,
                {{1, *前状态}, {2, *后状态}}, UTC, 创建代次};
            return L2中性动态事实完整_v1(动态)
                ? std::optional<关系式动态解码>{关系式动态解码{
                    std::move(动态), std::move(上下文关系)}}
                : std::nullopt;
        }

        L1中性写集请求 形成动态新增写集(
            const L2中性动态新增请求_v1& 请求,
            L2中性时间语义_v1 时间语义, std::int64_t 首次UTC) const {
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 映射幂等键(新增动态幂等域, 请求.幂等身份);
            const L1中性写集本地键 根{动态根本地键值};
            const L1中性写集本地键 关系{索引关系本地键值};
            const L1中性写集本地键 值{载荷值本地键值};
            写集.节点 = {{根, 节点种类::普通, std::nullopt}};
            写集.关系 = {{关系, 根, 定位_.族锚点,
                定位_.族归属关系类型, 动态索引角色}};
            写集.值 = {{值, 根, 类型登记_->起始U64组值类型.值,
                编码动态载荷(请求, 时间语义, 首次UTC), 根}};
            写集.属性槽变更 = {{根, 类型登记_->起始U64组值类型.值, 值}};
            return 写集;
        }
        L1中性写入结果 提交写集(const L1中性写集请求& 写集) {
            return const_cast<L1事实基座服务&>(L1_).提交中性写集(写集);
        }
        L1中性写入结果 提交所有者写集(const L1中性写集请求& 写集) {
            L1中性写入结果 结果;
            结果.幂等键 = 写集.幂等键;
            if (!写集.节点.empty() || !写集.关系.empty()
                || !写集.值.empty() || !写集.属性槽变更.empty()
                || 写集.退出事实.empty())
                return 结果;
            L1所有者范围写集请求 所有者写集;
            所有者写集.期望事实代次 = 写集.期望事实代次;
            所有者写集.写入幂等身份 = {写集.幂等键.值};
            所有者写集.退出事实 = 写集.退出事实;
            const auto 写入 =
                所有者写入端口_.提交所有者范围中性写集(所有者写集);
            结果.状态 = 映射所有者写入状态(写入.状态);
            结果.事实代次 = 写入.事实代次;
            结果.是否形成内存权威发布 = 写入.是否形成内存权威发布;
            return 结果;
        }

        static L1中性写入状态 映射所有者写入状态(
            L1所有者范围写入状态 状态) noexcept {
            switch (状态) {
            case L1所有者范围写入状态::成功: return L1中性写入状态::成功;
            case L1所有者范围写入状态::精确重复:
                return L1中性写入状态::精确重复;
            case L1所有者范围写入状态::入口拒绝:
                return L1中性写入状态::入口拒绝;
            case L1所有者范围写入状态::未找到:
                return L1中性写入状态::未找到;
            case L1所有者范围写入状态::已退出:
                return L1中性写入状态::已退出;
            case L1所有者范围写入状态::事实代次漂移:
                return L1中性写入状态::事实代次漂移;
            case L1所有者范围写入状态::幂等冲突:
                return L1中性写入状态::幂等冲突;
            case L1所有者范围写入状态::引用冲突:
                return L1中性写入状态::引用冲突;
            case L1所有者范围写入状态::资源失败:
                return L1中性写入状态::资源失败;
            default: return L1中性写入状态::内部不一致;
            }
        }

        static void 规范退出事实(std::vector<稳定编码>& 退出事实) {
            std::sort(退出事实.begin(), 退出事实.end());
            退出事实.erase(std::unique(退出事实.begin(), 退出事实.end()),
                退出事实.end());
        }

        动态闭包读取 读取当前动态闭包(
            稳定编码 身份, std::uint64_t G) const {
            const auto 节点 = L1_.读取中性当前节点({L1中性CRUD合同版本, 身份});
            if (节点.状态 != L1中性读取状态::成功) {
                动态闭包读取 结果{映射读取状态(节点.状态),
                    std::nullopt, std::nullopt};
                if (节点.状态 == L1中性读取状态::历史材料已清理)
                    结果.墓碑 = L2中性结构墓碑_v1{身份,
                        L2中性事实种类_v1::动态, {}, 0, std::nullopt,
                        节点.物理清理事实代次.value_or(节点.读取事实代次)};
                return 结果;
            }
            if (!节点.事实 || 节点.读取事实代次 != G
                || 节点.事实->种类 != 节点种类::普通
                || 节点.事实->退出事实代次 || 节点.事实->当前属性.size() != 1)
                return {L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            const auto& 槽 = 节点.事实->当前属性.front();
            if (槽.属性类型节点 != 类型登记_->起始U64组值类型.值)
                return {L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            const auto 关系组 = L1_.读取中性当前源关系组({
                L1中性CRUD合同版本, 身份, 定位_.族归属关系类型});
            const auto 值 = L1_.读取中性当前值({
                L1中性CRUD合同版本, 槽.当前值});
            if (关系组.状态 != L1中性读取状态::成功
                || 值.状态 != L1中性读取状态::成功
                || 关系组.读取事实代次 != G || 值.读取事实代次 != G
                || !值.事实 || 值.事实->所属节点 != 身份
                || 值.事实->属性类型节点 != 槽.属性类型节点
                || 值.事实->退出事实代次)
                return {关系组.状态 == L1中性读取状态::资源失败
                        || 值.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            const L1中性关系事实* 索引 = nullptr;
            for (const auto& 关系 : 关系组.关系组)
                if (关系.角色或顺序 == 动态索引角色) {
                    if (索引) return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                    索引 = &关系;
                }
            const auto* 载荷 = std::get_if<std::vector<std::uint64_t>>(
                &值.事实->材料);
            if (!索引 || !载荷 || 索引->源节点 != 身份
                || 索引->目标节点 != 定位_.族锚点
                || 索引->关系类型节点 != 定位_.族归属关系类型
                || 索引->退出事实代次)
                return {L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            auto 动态 = 解码动态载荷(身份, 节点.事实->创建事实代次, *载荷);
            if (动态) return {L2中性结构状态_v1::已读取,
                动态物理闭包{std::move(*动态), 索引->编码,
                    值.事实->编码, {}}, std::nullopt};
            const auto 上下文读取 = L1_.读取中性当前源关系组({
                L1中性CRUD合同版本, 身份, 上下文定位_.关系类型});
            if (上下文读取.状态 != L1中性读取状态::成功
                || 上下文读取.读取事实代次 != G)
                return {上下文读取.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            auto 关系式 = 解码关系式动态载荷(身份,
                节点.事实->创建事实代次, *载荷, 上下文读取.关系组);
            if (!关系式) return {L2中性结构状态_v1::内部错误,
                std::nullopt, std::nullopt};
            return {L2中性结构状态_v1::已读取,
                动态物理闭包{std::move(关系式->动态), 索引->编码,
                    值.事实->编码, std::move(关系式->上下文关系)},
                std::nullopt};
        }
        动态闭包读取 读取历史动态闭包(
            稳定编码 身份, std::uint64_t 截止, std::uint64_t G) const {
            const auto 节点读取 = L1_.读取中性历史事实({
                L1中性CRUD合同版本, 身份});
            if (节点读取.状态 != L1中性读取状态::成功) {
                动态闭包读取 结果{映射读取状态(节点读取.状态, true),
                    std::nullopt, std::nullopt};
                if (节点读取.状态 == L1中性读取状态::历史材料已清理)
                    结果.墓碑 = L2中性结构墓碑_v1{身份,
                        L2中性事实种类_v1::动态, {}, 0, std::nullopt,
                        节点读取.物理清理事实代次.value_or(
                            节点读取.读取事实代次)};
                return 结果;
            }
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
            if (!节点 || 节点->创建事实代次 > 截止)
                return {节点 ? L2中性结构状态_v1::未找到
                    : L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            const bool 已退出 = 节点->退出事实代次
                && *节点->退出事实代次 <= 截止;
            const auto 材料截止 = 已退出 ? *节点->退出事实代次 - 1 : 截止;
            if (材料截止 == 0) return {L2中性结构状态_v1::内部错误,
                std::nullopt, std::nullopt};
            const auto 关系组 = L1_.读取中性历史关系组({
                L1中性CRUD合同版本, L1中性关系端点方向::源,
                身份, 定位_.族归属关系类型, 材料截止});
            const auto 值组 = L1_.读取中性历史属性值组({
                L1中性CRUD合同版本, 身份, 材料截止});
            if (关系组.状态 != L1中性历史关系组读取状态::成功
                || 值组.状态 != L1中性历史属性值组读取状态::成功
                || 关系组.读取事实代次 != G || 值组.读取事实代次 != G)
                return {关系组.状态 == L1中性历史关系组读取状态::资源失败
                        || 值组.状态 == L1中性历史属性值组读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            const L1中性关系事实* 索引 = nullptr;
            for (const auto& 关系 : 关系组.关系组)
                if (关系.角色或顺序 == 动态索引角色) {
                    if (索引) return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                    索引 = &关系;
                }
            const L1中性值事实* 值 = nullptr;
            for (const auto& 项 : 值组.属性值组)
                if (项.属性类型节点 == 类型登记_->起始U64组值类型.值) {
                    if (值) return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                    值 = &项;
                }
            const auto* 载荷 = 值
                ? std::get_if<std::vector<std::uint64_t>>(&值->材料) : nullptr;
            if (!索引 || !值 || !载荷)
                return {L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            auto 动态 = 解码动态载荷(身份, 节点->创建事实代次, *载荷);
            if (动态) return {已退出 ? L2中性结构状态_v1::已退出
                    : L2中性结构状态_v1::已读取,
                动态物理闭包{std::move(*动态), 索引->编码, 值->编码, {}},
                std::nullopt};
            const auto 上下文读取 = L1_.读取中性历史关系组({
                L1中性CRUD合同版本, L1中性关系端点方向::源,
                身份, 上下文定位_.关系类型, 材料截止});
            if (上下文读取.状态 != L1中性历史关系组读取状态::成功
                || 上下文读取.读取事实代次 != G)
                return {上下文读取.状态
                            == L1中性历史关系组读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            auto 关系式 = 解码关系式动态载荷(身份,
                节点->创建事实代次, *载荷, 上下文读取.关系组);
            if (!关系式) return {L2中性结构状态_v1::内部错误,
                std::nullopt, std::nullopt};
            return {已退出 ? L2中性结构状态_v1::已退出
                    : L2中性结构状态_v1::已读取,
                动态物理闭包{std::move(关系式->动态), 索引->编码,
                    值->编码, std::move(关系式->上下文关系)},
                std::nullopt};
        }

        动态枚举结果 枚举当前动态(std::uint64_t G) const {
            const auto 组 = L1_.读取中性当前目标关系组({
                L1中性CRUD合同版本, 定位_.族锚点,
                定位_.族归属关系类型});
            if (组.状态 != L1中性读取状态::成功
                && 组.状态 != L1中性读取状态::未找到)
                return {映射读取状态(组.状态), {}};
            if (组.读取事实代次 != G)
                return {L2中性结构状态_v1::事实代次漂移, {}};
            动态枚举结果 结果{L2中性结构状态_v1::已读取, {}};
            for (const auto& 关系 : 组.关系组) {
                if (关系.角色或顺序 != 动态索引角色) continue;
                const auto 读取 = 读取当前动态闭包(关系.源节点, G);
                if (!读取.闭包 || 读取.闭包->索引关系 != 关系.编码)
                    return {读取.闭包 ? L2中性结构状态_v1::内部错误
                        : 读取.状态, {}};
                结果.动态组.push_back(*读取.闭包);
            }
            std::sort(结果.动态组.begin(), 结果.动态组.end(),
                [](const auto& 左, const auto& 右) {
                    return 左.动态.身份.值 < 右.动态.身份.值;
                });
            for (std::size_t i = 1; i < 结果.动态组.size(); ++i)
                if (结果.动态组[i - 1].动态.身份
                    == 结果.动态组[i].动态.身份)
                    return {L2中性结构状态_v1::内部错误, {}};
            return 结果;
        }

        成员读取结果 读取成员状态(
            const std::vector<L2中性动态成员_v1>& 成员,
            L2中性材料类别_v1 材料类别,
            std::optional<L2中性时间语义_v1> 预期时间语义,
            L2读取类别 读取类别, std::uint64_t G,
            std::uint64_t 历史截止) const {
            成员读取结果 结果{L2中性结构状态_v1::已读取,
                预期时间语义, {}};
            结果.状态组.reserve(成员.size());
            std::optional<std::int64_t> 前时间;
            for (const auto& 项 : 成员) {
                const auto 读取 = 状态服务_.读取中性状态_v1({
                    {L2结构合同版本, G}, L2中性状态动态合同版本_v1,
                    读取类别, 项.状态, 历史截止});
                if (!读取.成功() || !读取.状态
                    || 读取.结果头.事实截止代次 != G)
                    return {映射成员失败(读取.结果头.状态), std::nullopt, {}};
                const auto& 状态 = *读取.状态;
                if (状态.身份 != 项.状态 || 状态.材料类别 != 材料类别)
                    return {L2中性结构状态_v1::动态不闭合, std::nullopt, {}};
                if (!结果.时间语义) 结果.时间语义 = 状态.时间.语义;
                if (状态.时间.语义 != *结果.时间语义
                    || (前时间 && 状态.时间.纳秒 < *前时间))
                    return {L2中性结构状态_v1::动态不闭合, std::nullopt, {}};
                前时间 = 状态.时间.纳秒;
                结果.状态组.push_back(状态);
            }
            return 结果.状态组.size() == 成员.size() && 结果.时间语义
                ? 结果 : 成员读取结果{
                    L2中性结构状态_v1::动态不闭合, std::nullopt, {}};
        }

        清理计划结果 形成清理计划(
            const L2中性实例材料清理请求_v1& 请求,
            std::int64_t 当前UTC, std::uint64_t G) const {
            const auto 枚举 = 枚举当前动态(G);
            if (枚举.状态 != L2中性结构状态_v1::已读取)
                return {枚举.状态, {}, 0, 0};
            std::vector<实例动态项> 实例;
            for (const auto& 动态 : 枚举.动态组) {
                if (动态.动态.材料类别 != L2中性材料类别_v1::实例) continue;
                const auto 成员 = 读取成员状态(动态.动态.有序状态组,
                    L2中性材料类别_v1::实例,
                    L2中性时间语义_v1::绝对UTC纳秒,
                    L2读取类别::当前, G, 0);
                if (成员.状态 != L2中性结构状态_v1::已读取
                    || 成员.状态组.empty())
                    return {成员.状态, {}, 0, 0};
                实例.push_back({动态, 成员.状态组.front().时间.纳秒});
            }
            std::sort(实例.begin(), 实例.end(), [](const auto& 左,
                const auto& 右) {
                if (左.最早绝对时间 != 右.最早绝对时间)
                    return 左.最早绝对时间 < 右.最早绝对时间;
                if (左.闭包.动态.形成事实代次 != 右.闭包.动态.形成事实代次)
                    return 左.闭包.动态.形成事实代次
                        < 右.闭包.动态.形成事实代次;
                return 左.闭包.动态.身份.值 < 右.闭包.动态.身份.值;
            });
            清理计划结果 结果{L2中性结构状态_v1::已读取, {},
                实例.size(), 实例.size()};
            const auto 已选 = [&](const L2动态身份& 身份) {
                return std::any_of(结果.候选.begin(), 结果.候选.end(),
                    [&](const auto& 项) { return 项.闭包.动态.身份 == 身份; });
            };
            if (请求.原因 == L2中性实例材料清理原因_v1::抽象完成) {
                if (*请求.抽象结果形成事实代次 > G)
                    return {L2中性结构状态_v1::事实代次漂移, {},
                        实例.size(), 实例.size()};
                const auto 项 = std::find_if(实例.begin(), 实例.end(),
                    [&](const auto& 候选) {
                        return 候选.闭包.动态.身份 == *请求.已抽象实例动态;
                    });
                if (项 == 实例.end())
                    return {L2中性结构状态_v1::引用冲突, {},
                        实例.size(), 实例.size()};
                结果.候选.push_back(*项);
            }
            for (const auto& 动态 : 实例) {
                const bool 到期 = 当前UTC >= 动态.闭包.动态.首次形成UTC纳秒
                    && static_cast<std::uint64_t>(当前UTC
                        - 动态.闭包.动态.首次形成UTC纳秒)
                        >= 保留策略_.实例动态TTL纳秒;
                if (到期 && !已选(动态.闭包.动态.身份))
                    结果.候选.push_back(动态);
            }
            std::uint64_t 保留数量 = 实例.size() - 结果.候选.size();
            for (const auto& 动态 : 实例) {
                if (保留数量 <= 保留策略_.实例动态总量上限) break;
                if (已选(动态.闭包.动态.身份)) continue;
                结果.候选.push_back(动态);
                --保留数量;
            }
            std::sort(结果.候选.begin(), 结果.候选.end(), [](const auto& 左,
                const auto& 右) {
                if (左.最早绝对时间 != 右.最早绝对时间)
                    return 左.最早绝对时间 < 右.最早绝对时间;
                if (左.闭包.动态.形成事实代次 != 右.闭包.动态.形成事实代次)
                    return 左.闭包.动态.形成事实代次
                        < 右.闭包.动态.形成事实代次;
                return 左.闭包.动态.身份.值 < 右.闭包.动态.身份.值;
            });
            结果.清理后实例动态数量 = 保留数量;
            return 结果;
        }

        覆盖结果 形成活动实例成员覆盖(std::uint64_t G) const {
            const auto 枚举 = 枚举当前动态(G);
            if (枚举.状态 != L2中性结构状态_v1::已读取)
                return {枚举.状态, {}};
            覆盖结果 结果{L2中性结构状态_v1::已读取, {}};
            for (const auto& 动态 : 枚举.动态组) {
                if (动态.动态.材料类别 != L2中性材料类别_v1::实例) continue;
                const auto 成员 = 读取成员状态(动态.动态.有序状态组,
                    L2中性材料类别_v1::实例,
                    L2中性时间语义_v1::绝对UTC纳秒,
                    L2读取类别::当前, G, 0);
                if (成员.状态 != L2中性结构状态_v1::已读取)
                    return {成员.状态, {}};
                for (const auto& 状态 : 成员.状态组)
                    结果.状态身份规范组.push_back(状态.身份);
            }
            std::sort(结果.状态身份规范组.begin(),
                结果.状态身份规范组.end(), [](const auto& 左, const auto& 右) {
                    return 左.值 < 右.值;
                });
            结果.状态身份规范组.erase(std::unique(
                结果.状态身份规范组.begin(),
                结果.状态身份规范组.end()),
                结果.状态身份规范组.end());
            return 结果;
        }

        static std::vector<稳定编码> 动态退出事实组(
            const 动态物理闭包& 闭包) {
            std::vector<稳定编码> 组{闭包.动态.身份.值,
                闭包.索引关系, 闭包.载荷值};
            组.insert(组.end(), 闭包.上下文关系.begin(), 闭包.上下文关系.end());
            std::sort(组.begin(), 组.end());
            return 组;
        }
        static void 追加物理闭包(
            L1物理清理请求& 请求, const 动态物理闭包& 闭包) {
            请求.待清理事实身份组.push_back({
                L1物理清理事实种类::节点, 闭包.动态.身份.值});
            请求.待清理事实身份组.push_back({
                L1物理清理事实种类::关系, 闭包.索引关系});
            请求.待清理事实身份组.push_back({
                L1物理清理事实种类::值, 闭包.载荷值});
            for (const auto 关系 : 闭包.上下文关系)
                请求.待清理事实身份组.push_back({
                    L1物理清理事实种类::关系, 关系});
        }

        const L1事实基座服务& L1_;
        L1所有者范围写端口& 所有者写入端口_;
        L2状态结构服务& 状态服务_;
        const L2动态结构内部::动态身份来源定位& 定位_;
        const std::optional<L2动态结构类型登记>& 类型登记_;
        const L2动态结构内部::动态上下文关系类型定位& 上下文定位_;
        L2中性实例材料保留策略_v1 保留策略_{};
        mutable std::mutex 新增锁_;
        std::vector<首次UTC项> 首次UTC组_{};
        std::vector<新增缓存项> 新增缓存_{};
        mutable std::mutex 退出锁_;
        std::vector<退出缓存项> 退出缓存_{};
        mutable std::mutex 清理锁_;
        std::vector<清理进度项> 清理进度_{};
    };

public:
    当前值记录动态参与者结果_v1 形成组合发布当前值记录动态参与者_v1(
        const L2结构请求头& 请求头, L2结构幂等身份 幂等身份,
        L2存在身份 主体存在, L2场景身份 共同场景,
        L2特征实例身份 特征实例, L2存在身份 来源存在,
        const std::optional<L2方法身份>& 来源方法,
        const L1三分区原子事实引用值_v2& 前状态,
        const L1三分区原子事实引用值_v2& 后状态,
        std::int64_t 变化UTC纳秒) const noexcept {
        if (!组合发布当前值动态材料就绪_v1()) {
            当前值记录动态参与者结果_v1 失败;
            失败.状态 = L2结构状态::未找到;
            return 失败;
        }
        return 中性动态提供者_.形成当前值记录动态参与者_v1(
            请求头, 幂等身份, 主体存在, 共同场景, 特征实例, 来源存在,
            来源方法, 前状态, 后状态,
            动态上下文关系类型定位_.关系类型, 变化UTC纳秒,
            第一层写入端口_.所有者身份());
    }

private:

    const L1事实基座服务& L1_;
    const L2存在结构服务& 存在服务_;
    L2状态结构服务& 状态服务_;
    L1所有者范围写端口 第一层写入端口_;
    L2动态结构内部::动态身份来源定位 动态身份来源定位_;
    std::optional<L2动态结构类型登记> 结构类型登记定位_;
    L2动态结构内部::动态上下文关系类型定位 动态上下文关系类型定位_{};
    中性动态提供者 中性动态提供者_;
};

} // namespace 海中鱼巣
