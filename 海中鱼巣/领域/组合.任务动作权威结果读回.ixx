module;

#include <cstdint>
#include <optional>

export module 海中鱼巣.领域.组合.任务动作权威结果读回;

import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2动态结构;
export import 海中鱼巣.线程.协议.任务动作完成消息;

export namespace 海中鱼巣 {

enum class 任务动作权威结果读回状态 : std::uint8_t {
    已形成 = 1, 合法等待 = 2, 当前性漂移 = 3,
    引用冲突 = 4, 归因不足 = 5, 入口拒绝 = 6,
    资源失败 = 7, 内部错误 = 8
};

struct 任务动作权威结果读回请求 final {
    std::uint32_t 合同版本 = 1;
    任务动作完成消息 完成消息;
};

struct 任务动作权威结果快照 final {
    任务动作完成消息 完成消息;
    L2状态当前选择关系引用 当前选择;
    L2场景事实 场景;
    L2存在事实 主体;
    L2状态事实 实际状态;
    L2动态事实 动态证据;
    std::uint64_t 事实截止代次 = 0;
    friend bool operator==(const 任务动作权威结果快照&,
        const 任务动作权威结果快照&) = default;
};

inline bool 任务动作权威结果快照有效(
    const 任务动作权威结果快照& 快照) noexcept {
    return 任务动作完成消息有效(快照.完成消息)
        && 快照.事实截止代次 != 0
        && 快照.当前选择.状态 == 快照.实际状态.身份
        && 快照.实际状态.主体存在 == 快照.主体.身份
        && 快照.动态证据.主体存在 == 快照.主体.身份
        && 快照.动态证据.后状态 == 快照.实际状态.身份
        && 快照.场景.身份 == 快照.完成消息.结果候选.场景
        && 快照.主体.身份 == 快照.完成消息.结果候选.主体
        && 快照.实际状态.身份 == 快照.完成消息.结果候选.实际状态
        && 快照.动态证据.身份 == 快照.完成消息.结果候选.动态证据;
}

struct 任务动作权威结果读回结果 final {
    任务动作权威结果读回状态 状态 =
        任务动作权威结果读回状态::入口拒绝;
    std::optional<任务动作权威结果快照> 快照;
    std::optional<任务动作归因缺口定位> 归因缺口;
    bool 成功() const noexcept {
        return 状态 == 任务动作权威结果读回状态::已形成
            && 快照 && !归因缺口 && 快照->事实截止代次 != 0;
    }
};

class 任务动作权威结果读回提供者 final {
public:
    任务动作权威结果读回提供者(
        const L1事实基座服务& 第一层服务,
        const L2场景结构服务& 场景服务,
        const L2存在结构服务& 存在服务,
        const L2状态结构服务& 状态服务,
        const L2动态结构服务& 动态服务) noexcept
        : 第一层服务_(第一层服务), 场景服务_(场景服务),
          存在服务_(存在服务), 状态服务_(状态服务), 动态服务_(动态服务) {}

    任务动作权威结果读回结果 读取动作后权威结果(
        const 任务动作权威结果读回请求& 请求) const noexcept {
        if (请求.合同版本 != 1 || !任务动作完成消息完整(请求.完成消息))
            return 失败(任务动作权威结果读回状态::入口拒绝);
        try {
            const auto 代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (代次.状态 == L1中性读取状态::资源失败)
                return 失败(任务动作权威结果读回状态::资源失败);
            if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
                return 失败(任务动作权威结果读回状态::内部错误);
            const auto Gread = 代次.事实代次;
            const L2结构请求头 头{L2结构合同版本, Gread};
            const auto& 候选 = 请求.完成消息.结果候选;

            const auto 状态 = 状态服务_.读取完整状态(
                {头, L2读取类别::历史, 候选.实际状态, Gread});
            if (状态.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务动作权威结果读回状态::资源失败);
            if (!状态.状态)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::状态缺失,
                    任务动作权威结果读回状态::合法等待);

            const auto 选择 = 状态服务_.读取特征实例历史状态选择(
                {头, 状态.状态->特征实例, Gread});
            if (选择.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务动作权威结果读回状态::资源失败);
            if (!选择.当前选择关系 || !选择.状态)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::当前选择缺失,
                    任务动作权威结果读回状态::归因不足);
            if (选择.当前选择关系->状态 != 候选.实际状态
                || 选择.状态->身份 != 候选.实际状态)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::当前选择异义,
                    任务动作权威结果读回状态::当前性漂移);

            const auto 动态 = 动态服务_.读取完整动态(
                {头, L2读取类别::历史, 候选.动态证据, Gread});
            if (动态.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务动作权威结果读回状态::资源失败);
            if (!动态.动态)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::动态缺失,
                    任务动作权威结果读回状态::合法等待);

            const auto 主体 = 存在服务_.读取完整存在(
                {头, L2读取类别::历史, 候选.主体, Gread});
            if (主体.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务动作权威结果读回状态::资源失败);
            if (!主体.存在)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::主体缺失,
                    任务动作权威结果读回状态::合法等待);

            const auto 场景 = 场景服务_.读取完整场景(
                {头, L2读取类别::历史, 候选.场景, Gread});
            if (场景.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务动作权威结果读回状态::资源失败);
            if (!场景.场景)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::场景缺失,
                    任务动作权威结果读回状态::合法等待);

            if (状态.状态->主体存在 != 候选.主体)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::状态主体不符,
                    任务动作权威结果读回状态::引用冲突);
            if (动态.动态->主体存在 != 候选.主体)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::动态主体不符,
                    任务动作权威结果读回状态::引用冲突);
            if (动态.动态->后状态 != 候选.实际状态)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::动态后态不符,
                    任务动作权威结果读回状态::引用冲突);
            if (动态.动态->来源稳定编码.值
                != 请求.完成消息.稳定动作键.值)
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::动态来源不符,
                    任务动作权威结果读回状态::归因不足);
            if (!有效(请求.完成消息.结果验证合同))
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::验证合同不满足,
                    任务动作权威结果读回状态::归因不足);
            if (!有效(请求.完成消息.动作归因合同))
                return 缺口(请求.完成消息, Gread,
                    任务动作归因缺口原因::归因合同不满足,
                    任务动作权威结果读回状态::归因不足);

            任务动作权威结果快照 快照{请求.完成消息,
                *选择.当前选择关系, *场景.场景, *主体.存在,
                *状态.状态, *动态.动态, Gread};
            return {任务动作权威结果读回状态::已形成,
                std::move(快照), std::nullopt};
        } catch (const std::bad_alloc&) {
            return 失败(任务动作权威结果读回状态::资源失败);
        } catch (...) {
            return 失败(任务动作权威结果读回状态::内部错误);
        }
    }

private:
    static 任务动作权威结果读回结果 失败(
        任务动作权威结果读回状态 状态) noexcept {
        return {状态, std::nullopt, std::nullopt};
    }

    static 任务动作权威结果读回结果 缺口(
        const 任务动作完成消息& 消息, std::uint64_t 截止,
        任务动作归因缺口原因 原因,
        任务动作权威结果读回状态 状态) noexcept {
        任务动作归因缺口定位 定位{消息.执行幂等身份,
            消息.动作顺序, 消息.动作入口, 消息.稳定动作键,
            消息.结果候选, 截止, 原因};
        return {状态, std::nullopt, std::move(定位)};
    }

    const L1事实基座服务& 第一层服务_;
    const L2场景结构服务& 场景服务_;
    const L2存在结构服务& 存在服务_;
    const L2状态结构服务& 状态服务_;
    const L2动态结构服务& 动态服务_;
};

} // namespace 海中鱼巣
