module;

#include <algorithm>
#include <cstdint>
#include <exception>
#include <new>
#include <optional>
#include <stdexcept>
#include <type_traits>
#include <utility>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.数据服务.状态类;

export import 海中鱼巣.领域.数据服务.特征类;

namespace 海中鱼巣::状态类数据内部 {

inline constexpr L1所有者范围写集本地键 状态结点本地键{1};
inline constexpr L1所有者范围写集本地键 时间值本地键{2};
inline constexpr L1所有者范围写集本地键 快照值本地键{3};

std::optional<稳定编码> 查找唯一编码(
    const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键 != 本地键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

特征类值 转换为特征值(
    const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> 特征类值 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型,
                L1所有者范围独立材料引用>)
            return 特征值结点引用{值.编码};
        else
            return 特征直接值{值};
    }, 材料);
}

L1所有者范围原始值材料 转换为L1材料(const 特征类值& 特征值) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, 特征值结点引用>)
            return L1所有者范围独立材料引用{值.结点};
        else
            return std::visit([](const auto& 直接值)
                    -> L1所有者范围原始值材料 {
                return 直接值;
            }, 值);
    }, 特征值);
}

bool 快照编码有效(const std::vector<std::uint64_t>& 编码组) noexcept {
    if (编码组.empty() || 编码组.size() % 2 != 0) return false;
    std::uint64_t 前一特征 = 0;
    for (std::size_t i = 0; i < 编码组.size(); i += 2) {
        const auto 特征 = 编码组[i];
        const auto 值 = 编码组[i + 1];
        if (特征 == 0 || 值 == 0 || (i != 0 && 前一特征 >= 特征))
            return false;
        前一特征 = 特征;
    }
    return true;
}

} // namespace 海中鱼巣::状态类数据内部

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 状态类数据合同版本 = 1;

enum class 状态类数据状态 : std::uint8_t {
    已创建 = 1,
    精确重复 = 2,
    已读取 = 3,
    已退出 = 4,
    入口拒绝 = 5,
    未找到 = 6,
    目标已退出 = 7,
    特征未找到 = 8,
    特征已退出 = 9,
    特征读取失败 = 10,
    结构类型未找到 = 11,
    结构类型已退出 = 12,
    事实代次漂移 = 13,
    幂等冲突 = 14,
    引用冲突 = 15,
    数量预算不足 = 16,
    历史材料已清理 = 17,
    资源失败 = 18,
    内部不一致 = 19
};

// 本类只承载实例状态；时间统一为大于零的 UTC Unix epoch 纳秒。
struct 状态类结点 final {
    稳定编码 结点{};
    稳定编码 时间值事实{};
    稳定编码 快照值事实{};
    std::int64_t 时间 = 0;
    std::vector<特征类结点> 特征值快照组;
    std::uint64_t 创建事实代次 = 0;
    std::optional<std::uint64_t> 退出事实代次;
    friend bool operator==(const 状态类结点&, const 状态类结点&) = default;
};

struct 状态类新增请求 final {
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    std::int64_t 时间 = 0; // UTC Unix epoch 纳秒，必须大于零。
    std::vector<稳定编码> 特征结点组;
    friend bool operator==(const 状态类新增请求&,
        const 状态类新增请求&) = default;
};

struct 状态类删除请求 final {
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 状态结点{};
    friend bool operator==(const 状态类删除请求&,
        const 状态类删除请求&) = default;
};

struct 状态类查询请求 final {
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 状态结点{};
    friend bool operator==(const 状态类查询请求&,
        const 状态类查询请求&) = default;
};

struct 状态类时间范围查询请求 final {
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    std::int64_t 起始时间 = 0;
    std::int64_t 终止时间 = 0;
    std::uint64_t 最大候选数量 = 0;
    friend bool operator==(const 状态类时间范围查询请求&,
        const 状态类时间范围查询请求&) = default;
};

struct 状态类特征快照查询请求 final {
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 特征结点{};
    稳定编码 特征值事实{};
    std::uint64_t 最大候选数量 = 0;
    friend bool operator==(const 状态类特征快照查询请求&,
        const 状态类特征快照查询请求&) = default;
};

struct 状态类结点结果 final {
    状态类数据状态 状态 = 状态类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<状态类结点> 状态结点;

    bool 成功() const noexcept {
        return (状态 == 状态类数据状态::已创建
                || 状态 == 状态类数据状态::精确重复
                || 状态 == 状态类数据状态::已读取
                || 状态 == 状态类数据状态::已退出)
            && 合同版本 == 状态类数据合同版本
            && 事实代次 != 0 && 状态结点.has_value();
    }
};

struct 状态类特征值快照结果 final {
    状态类数据状态 状态 = 状态类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 事实代次 = 0;
    稳定编码 状态结点{};
    std::int64_t 时间 = 0;
    std::vector<特征类结点> 特征值快照组;

    bool 成功() const noexcept {
        return 状态 == 状态类数据状态::已读取
            && 合同版本 == 状态类数据合同版本
            && 事实代次 != 0 && 有效(状态结点)
            && !特征值快照组.empty();
    }
};

struct 状态类组查询结果 final {
    状态类数据状态 状态 = 状态类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 状态类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::vector<状态类结点> 状态组;

    bool 成功() const noexcept {
        return 状态 == 状态类数据状态::已读取
            && 合同版本 == 状态类数据合同版本
            && 事实代次 != 0;
    }
};

class 状态类数据服务 final {
public:
    状态类数据服务() = delete;
    状态类数据服务(const 状态类数据服务&) = delete;
    状态类数据服务& operator=(const 状态类数据服务&) = delete;
    状态类数据服务(状态类数据服务&&) = delete;
    状态类数据服务& operator=(状态类数据服务&&) = delete;

    // 两个属性类型都由同一状态 owner 预先建立；本类不负责应用装配。
    // 抽象状态及其相对时间不进入本服务。
    状态类数据服务(const L1事实基座服务& 第一层服务,
        const 特征类数据服务& 特征服务,
        L1所有者范围写端口&& 写入端口,
        稳定编码 时间属性类型,
        稳定编码 快照属性类型)
        : 第一层服务_(第一层服务), 特征服务_(特征服务),
          写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()),
          时间属性类型_(时间属性类型),
          快照属性类型_(快照属性类型) {
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !有效(所有者_) || !有效(时间属性类型_)
            || !有效(快照属性类型_)
            || 时间属性类型_ == 快照属性类型_)
            throw std::invalid_argument("invalid state data configuration");
        const auto 所有者读取 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者读取.状态 != L1所有者范围读取状态::成功
            || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
            || !所有者读取.所有者事实
            || 所有者读取.所有者事实->所有者 != 所有者_
            || 所有者读取.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 所有者读取.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid state data owner");
        if (!属性类型有效(时间属性类型_,
                L1所有者范围值表示种类::I64)
            || !属性类型有效(快照属性类型_,
                L1所有者范围值表示种类::U64组))
            throw std::invalid_argument("invalid state data property types");
    }

    // 状态不可修改；内容变化由调用方建立另一个状态。
    状态类结点结果 新增状态(const 状态类新增请求& 请求) {
        if (!新增请求有效(请求)) return 失败(状态类数据状态::入口拒绝);
        try {
            const auto 特征组 = 规范化特征结点组(请求.特征结点组);
            if (!特征组) return 失败(状态类数据状态::入口拒绝);
            if (const auto 重放 = 尝试重放新增(请求, *特征组))
                return *重放;

            std::vector<特征类结点> 快照组;
            快照组.reserve(特征组->size());
            for (const auto 特征结点 : *特征组) {
                const auto 读取 = 特征服务_.查询特征(
                    {特征类数据合同版本, 请求.期望事实代次, 特征结点});
                if (!读取.成功() || 读取.状态 != 特征类数据状态::已读取
                    || 读取.事实代次 != 请求.期望事实代次
                    || !读取.特征 || 读取.特征->结点 != 特征结点)
                    return 失败(映射特征状态(读取.状态), 读取.事实代次);
                if (!特征属于第一层服务(*读取.特征,
                        请求.期望事实代次))
                    return 失败(状态类数据状态::特征读取失败,
                        请求.期望事实代次);
                快照组.push_back(*读取.特征);
            }
            const auto 写集 = 形成新增写集(请求, 快照组);
            return 提交新增(写集, 请求.幂等身份,
                状态类数据状态::已创建);
        } catch (const std::bad_alloc&) {
            return 失败(状态类数据状态::资源失败);
        } catch (...) {
            return 失败(状态类数据状态::内部不一致);
        }
    }

    状态类结点结果 删除状态(const 状态类删除请求& 请求) {
        if (!删除请求有效(请求)) return 失败(状态类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放删除(请求)) return *重放;
            const auto 当前 = 读取当前状态(请求.状态结点,
                请求.期望事实代次);
            if (!当前.成功() || 当前.状态 != 状态类数据状态::已读取)
                return 当前;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.退出事实 = {当前.状态结点->结点,
                当前.状态结点->时间值事实,
                当前.状态结点->快照值事实};
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 映射 = 映射写入状态(写入.状态,
                状态类数据状态::已退出);
            if (映射 != 状态类数据状态::已退出
                && 映射 != 状态类数据状态::精确重复)
                return 失败(映射, 写入.事实代次);
            if (!写入结果头完整(写入, 请求.幂等身份)
                || !写入.新编码映射.empty())
                return 失败(状态类数据状态::内部不一致,
                    写入.事实代次);
            auto 读回 = 读取历史已退出状态(*当前.状态结点,
                写入.事实代次);
            if (!读回.成功()) return 读回;
            读回.状态 = 映射;
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(状态类数据状态::资源失败);
        } catch (...) {
            return 失败(状态类数据状态::内部不一致);
        }
    }

    状态类结点结果 查询状态(const 状态类查询请求& 请求) const {
        if (!查询请求有效(请求)) return 失败(状态类数据状态::入口拒绝);
        try {
            return 读取当前状态(请求.状态结点, 请求.期望事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(状态类数据状态::资源失败);
        } catch (...) {
            return 失败(状态类数据状态::内部不一致);
        }
    }

    状态类特征值快照结果 读取状态中的特征值快照(
        const 状态类查询请求& 请求) const {
        const auto 读取 = 查询状态(请求);
        if (!读取.成功() || 读取.状态 != 状态类数据状态::已读取
            || !读取.状态结点)
            return {读取.状态, 状态类数据合同版本,
                读取.事实代次, 请求.状态结点, 0, {}};
        return {状态类数据状态::已读取, 状态类数据合同版本,
            读取.事实代次, 读取.状态结点->结点,
            读取.状态结点->时间, 读取.状态结点->特征值快照组};
    }

    状态类组查询结果 按时间范围查询状态(
        const 状态类时间范围查询请求& 请求) const {
        if (请求.合同版本 != 状态类数据合同版本
            || 请求.期望事实代次 == 0 || 请求.最大候选数量 == 0
            || 请求.起始时间 > 请求.终止时间)
            return 组失败(状态类数据状态::入口拒绝);
        try {
            const auto 读取 = 第一层服务_.按属性类型读取所有者范围全部当前值(
                {L1所有者范围属性类型当前值组读取合同版本,
                    所有者_, 时间属性类型_, 请求.期望事实代次,
                    请求.最大候选数量});
            const auto 映射 = 映射组读取状态(读取.状态);
            if (映射 != 状态类数据状态::已读取)
                return 组失败(映射, 读取.读取事实代次);
            if (!组读取结果头完整(读取, 时间属性类型_,
                    请求.期望事实代次))
                return 组失败(状态类数据状态::内部不一致,
                    读取.读取事实代次);
            状态类组查询结果 结果{状态类数据状态::已读取,
                状态类数据合同版本, 读取.读取事实代次, {}};
            for (const auto& 值 : 读取.当前值) {
                const auto* 时间 = std::get_if<std::int64_t>(&值.材料);
                if (!时间 || 值.写入所有者 != 所有者_
                    || 值.属性类型节点 != 时间属性类型_
                    || 值.退出事实代次 || 值.创建事实代次 == 0
                    || 值.创建事实代次 > 读取.读取事实代次)
                    return 组失败(状态类数据状态::内部不一致,
                        读取.读取事实代次);
                if (*时间 < 请求.起始时间 || *时间 > 请求.终止时间)
                    continue;
                const auto 状态读取 = 读取当前状态(
                    值.所属节点, 请求.期望事实代次);
                if (!状态读取.成功()
                    || 状态读取.状态 != 状态类数据状态::已读取
                    || !状态读取.状态结点
                    || 状态读取.状态结点->时间值事实 != 值.编码)
                    return 组失败(状态类数据状态::内部不一致,
                        读取.读取事实代次);
                结果.状态组.push_back(*状态读取.状态结点);
            }
            规范化状态组(结果.状态组);
            return 结果;
        } catch (const std::bad_alloc&) {
            return 组失败(状态类数据状态::资源失败);
        } catch (...) {
            return 组失败(状态类数据状态::内部不一致);
        }
    }

    状态类组查询结果 按特征值快照查询状态(
        const 状态类特征快照查询请求& 请求) const {
        if (请求.合同版本 != 状态类数据合同版本
            || 请求.期望事实代次 == 0 || 请求.最大候选数量 == 0
            || !有效(请求.特征结点) || !有效(请求.特征值事实))
            return 组失败(状态类数据状态::入口拒绝);
        try {
            const auto 读取 = 第一层服务_.按属性类型读取所有者范围全部当前值(
                {L1所有者范围属性类型当前值组读取合同版本,
                    所有者_, 快照属性类型_, 请求.期望事实代次,
                    请求.最大候选数量});
            const auto 映射 = 映射组读取状态(读取.状态);
            if (映射 != 状态类数据状态::已读取)
                return 组失败(映射, 读取.读取事实代次);
            if (!组读取结果头完整(读取, 快照属性类型_,
                    请求.期望事实代次))
                return 组失败(状态类数据状态::内部不一致,
                    读取.读取事实代次);
            状态类组查询结果 结果{状态类数据状态::已读取,
                状态类数据合同版本, 读取.读取事实代次, {}};
            for (const auto& 值 : 读取.当前值) {
                const auto* 快照 = std::get_if<std::vector<std::uint64_t>>(
                    &值.材料);
                if (!快照 || !状态类数据内部::快照编码有效(*快照)
                    || 值.写入所有者 != 所有者_
                    || 值.属性类型节点 != 快照属性类型_
                    || 值.退出事实代次 || 值.创建事实代次 == 0
                    || 值.创建事实代次 > 读取.读取事实代次)
                    return 组失败(状态类数据状态::内部不一致,
                        读取.读取事实代次);
                bool 命中 = false;
                for (std::size_t i = 0; i < 快照->size(); i += 2)
                    if ((*快照)[i] == 请求.特征结点.值
                        && (*快照)[i + 1] == 请求.特征值事实.值) {
                        命中 = true;
                        break;
                    }
                if (!命中) continue;
                const auto 状态读取 = 读取当前状态(
                    值.所属节点, 请求.期望事实代次);
                if (!状态读取.成功()
                    || 状态读取.状态 != 状态类数据状态::已读取
                    || !状态读取.状态结点
                    || 状态读取.状态结点->快照值事实 != 值.编码)
                    return 组失败(状态类数据状态::内部不一致,
                        读取.读取事实代次);
                结果.状态组.push_back(*状态读取.状态结点);
            }
            规范化状态组(结果.状态组);
            return 结果;
        } catch (const std::bad_alloc&) {
            return 组失败(状态类数据状态::资源失败);
        } catch (...) {
            return 组失败(状态类数据状态::内部不一致);
        }
    }

private:
    bool 属性类型有效(稳定编码 编码,
        L1所有者范围值表示种类 表示) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 事实 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && !读取.物理清理事实代次
            && !读取.物理清理墓碑 && 事实 && 事实->编码 == 编码
            && 事实->写入所有者 == 所有者_
            && 事实->种类 == 节点种类::属性类型
            && 事实->属性类型表示 == 表示
            && 事实->创建事实代次 != 0 && !事实->退出事实代次
            && 事实->当前属性.empty();
    }

    bool 特征属于第一层服务(const 特征类结点& 特征,
        std::uint64_t 期望事实代次) const {
        const auto 节点读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 特征.结点});
        const auto 值读取 = 第一层服务_.读取所有者范围当前值(
            {L1所有者范围CRUD合同版本, 特征.值事实});
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        const auto* 值 = 值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*值读取.事实) : nullptr;
        return 节点读取.状态 == L1所有者范围读取状态::成功
            && 值读取.状态 == L1所有者范围读取状态::成功
            && 节点读取.合同版本 == L1所有者范围CRUD合同版本
            && 值读取.合同版本 == L1所有者范围CRUD合同版本
            && 节点读取.读取事实代次 == 期望事实代次
            && 值读取.读取事实代次 == 期望事实代次
            && 节点 && 值 && 节点->编码 == 特征.结点
            && 值->编码 == 特征.值事实
            && 节点->写入所有者 == 值->写入所有者
            && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && !节点->退出事实代次
            && 节点->当前属性.size() == 1
            && 节点->当前属性.front().属性类型节点 == 特征.特征类型
            && 节点->当前属性.front().当前值 == 特征.值事实
            && 值->所属节点 == 特征.结点
            && 值->属性类型节点 == 特征.特征类型
            && 值->来源节点 == 特征.结点 && !值->退出事实代次
            && 值->材料 == 状态类数据内部::转换为L1材料(特征.特征值)
            && 节点->创建事实代次 == 特征.创建事实代次
            && 值->创建事实代次 == 特征.创建事实代次
            && !特征.退出事实代次;
    }

    static bool 新增请求有效(const 状态类新增请求& 请求) noexcept {
        return 请求.合同版本 == 状态类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 请求.时间 > 0 && !请求.特征结点组.empty();
    }

    static bool 删除请求有效(const 状态类删除请求& 请求) noexcept {
        return 请求.合同版本 == 状态类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.状态结点);
    }

    static bool 查询请求有效(const 状态类查询请求& 请求) noexcept {
        return 请求.合同版本 == 状态类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.状态结点);
    }

    static std::optional<std::vector<稳定编码>> 规范化特征结点组(
        const std::vector<稳定编码>& 输入) {
        if (输入.empty()) return std::nullopt;
        auto 结果 = 输入;
        if (std::any_of(结果.begin(), 结果.end(),
                [](稳定编码 编码) noexcept { return !有效(编码); }))
            return std::nullopt;
        std::sort(结果.begin(), 结果.end());
        if (std::adjacent_find(结果.begin(), 结果.end()) != 结果.end())
            return std::nullopt;
        return 结果;
    }

    static std::vector<std::uint64_t> 形成快照编码组(
        const std::vector<特征类结点>& 特征组) {
        std::vector<std::uint64_t> 结果;
        结果.reserve(特征组.size() * 2);
        for (const auto& 特征 : 特征组) {
            结果.push_back(特征.结点.值);
            结果.push_back(特征.值事实.值);
        }
        return 结果;
    }

    L1所有者范围写集请求 形成新增写集(
        const 状态类新增请求& 请求,
        const std::vector<特征类结点>& 快照组) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{状态类数据内部::状态结点本地键,
            节点种类::普通, std::nullopt}};
        写集.值 = {
            {状态类数据内部::时间值本地键,
                状态类数据内部::状态结点本地键, 时间属性类型_,
                请求.时间, 状态类数据内部::状态结点本地键},
            {状态类数据内部::快照值本地键,
                状态类数据内部::状态结点本地键, 快照属性类型_,
                形成快照编码组(快照组),
                状态类数据内部::状态结点本地键}};
        写集.属性槽变更 = {
            {状态类数据内部::状态结点本地键, 时间属性类型_,
                状态类数据内部::时间值本地键},
            {状态类数据内部::状态结点本地键, 快照属性类型_,
                状态类数据内部::快照值本地键}};
        return 写集;
    }

    std::optional<状态类结点结果> 尝试重放新增(
        const 状态类新增请求& 请求,
        const std::vector<稳定编码>& 规范特征组) {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到)
            return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(首次.状态), 首次.读取事实代次);
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_
            || 首次.写入幂等身份 != 请求.幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果)
            return 失败(状态类数据状态::内部不一致,
                首次.读取事实代次);
        const auto& 写集 = *首次.首次规范化写集;
        const auto& 首次结果 = *首次.首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || 写集.节点.size() != 1 || 写集.值.size() != 2
            || 写集.属性槽变更.size() != 2 || !写集.关系.empty()
            || !写集.退出事实.empty()
            || 首次结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(首次结果, 请求.幂等身份))
            return 失败(状态类数据状态::幂等冲突,
                首次结果.事实代次);

        const L1所有者范围值新建项* 时间项 = nullptr;
        const L1所有者范围值新建项* 快照项 = nullptr;
        for (const auto& 项 : 写集.值) {
            if (项.本地键 == 状态类数据内部::时间值本地键)
                时间项 = &项;
            else if (项.本地键 == 状态类数据内部::快照值本地键)
                快照项 = &项;
        }
        const auto* 时间 = 时间项
            ? std::get_if<std::int64_t>(&时间项->材料) : nullptr;
        const auto* 快照 = 快照项
            ? std::get_if<std::vector<std::uint64_t>>(&快照项->材料) : nullptr;
        if (!时间项 || !快照项 || !时间 || !快照
            || *时间 != 请求.时间
            || !状态类数据内部::快照编码有效(*快照)
            || 快照->size() != 规范特征组.size() * 2)
            return 失败(状态类数据状态::幂等冲突,
                首次结果.事实代次);
        for (std::size_t i = 0; i < 规范特征组.size(); ++i)
            if ((*快照)[i * 2] != 规范特征组[i].值)
                return 失败(状态类数据状态::幂等冲突,
                    首次结果.事实代次);
        std::vector<特征类结点> 首次快照组;
        首次快照组.reserve(规范特征组.size());
        for (std::size_t i = 0; i < 规范特征组.size(); ++i)
            首次快照组.push_back({规范特征组[i],
                稳定编码{(*快照)[i * 2 + 1]}, {},
                特征直接值{std::int64_t{0}}, 0, std::nullopt});
        if (写集 != 形成新增写集(请求, 首次快照组))
            return 失败(状态类数据状态::幂等冲突,
                首次结果.事实代次);
        return 提交新增(写集, 请求.幂等身份,
            状态类数据状态::精确重复);
    }

    std::optional<状态类结点结果> 尝试重放删除(
        const 状态类删除请求& 请求) {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到)
            return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(首次.状态), 首次.读取事实代次);
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_
            || 首次.写入幂等身份 != 请求.幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果)
            return 失败(状态类数据状态::内部不一致,
                首次.读取事实代次);
        const auto& 写集 = *首次.首次规范化写集;
        const auto& 首次结果 = *首次.首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.size() != 3
            || std::count(写集.退出事实.begin(), 写集.退出事实.end(),
                请求.状态结点) != 1
            || 首次结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(首次结果, 请求.幂等身份)
            || !首次结果.新编码映射.empty())
            return 失败(状态类数据状态::幂等冲突,
                首次结果.事实代次);
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        if (写入.状态 != L1所有者范围写入状态::精确重复
            || !写入结果头完整(写入, 请求.幂等身份)
            || !写入.新编码映射.empty())
            return 失败(写入.状态 == L1所有者范围写入状态::精确重复
                    ? 状态类数据状态::内部不一致
                    : 映射写入状态(写入.状态,
                        状态类数据状态::已退出),
                写入.事实代次);
        auto 读回 = 读取历史已退出状态(请求.状态结点,
            写入.事实代次);
        if (!读回.成功()) return 读回;
        读回.状态 = 状态类数据状态::精确重复;
        return 读回;
    }

    状态类结点结果 提交新增(
        const L1所有者范围写集请求& 写集,
        L1所有者范围写入幂等身份 幂等身份,
        状态类数据状态 成功状态) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 映射 = 映射写入状态(写入.状态, 成功状态);
        if (映射 != 成功状态 && 映射 != 状态类数据状态::精确重复)
            return 失败(映射, 写入.事实代次);
        if (!写入结果头完整(写入, 幂等身份)
            || 写入.新编码映射.size() != 3)
            return 失败(状态类数据状态::内部不一致, 写入.事实代次);
        const auto 结点 = 状态类数据内部::查找唯一编码(
            写入, 状态类数据内部::状态结点本地键);
        const auto 时间值 = 状态类数据内部::查找唯一编码(
            写入, 状态类数据内部::时间值本地键);
        const auto 快照值 = 状态类数据内部::查找唯一编码(
            写入, 状态类数据内部::快照值本地键);
        if (!结点 || !时间值 || !快照值)
            return 失败(状态类数据状态::内部不一致, 写入.事实代次);
        auto 读回 = 映射 == 状态类数据状态::精确重复
            ? 读取历史状态快照(*结点, 写入.事实代次,
                写入.事实代次, 状态类数据状态::已读取, std::nullopt)
            : 读取当前状态(*结点, 写入.事实代次);
        if (!读回.成功() || !读回.状态结点
            || 读回.状态结点->时间值事实 != *时间值
            || 读回.状态结点->快照值事实 != *快照值)
            return 失败(状态类数据状态::内部不一致, 写入.事实代次);
        读回.状态 = 映射;
        return 读回;
    }

    状态类结点结果 读取当前状态(稳定编码 状态结点,
        std::uint64_t 期望事实代次) const {
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 期望事实代次;
        请求.所有者 = {所有者_};
        请求.节点 = {状态结点};
        请求.属性值 = {{状态结点, 时间属性类型_},
            {状态结点, 快照属性类型_}};
        const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(请求);
        if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
            if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
                return 失败(状态类数据状态::事实代次漂移,
                    读取.读取事实代次);
            if (读取.状态 == L1所有者范围一致当前读取状态::资源失败)
                return 失败(状态类数据状态::资源失败,
                    读取.读取事实代次);
            if (读取.状态 == L1所有者范围一致当前读取状态::入口拒绝)
                return 失败(状态类数据状态::入口拒绝,
                    读取.读取事实代次);
            return 失败(状态类数据状态::内部不一致,
                读取.读取事实代次);
        }
        if (读取.合同版本 != L1所有者范围一致当前读取合同版本
            || 读取.期望事实代次 != 期望事实代次
            || 读取.读取事实代次 != 期望事实代次
            || 读取.所有者.size() != 1 || 读取.节点.size() != 1
            || 读取.属性值.size() != 2 || !读取.关系.empty()
            || !读取.值.empty() || !读取.源关系组.empty()
            || !读取.目标关系组.empty()
            || 读取.所有者.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实
            || 读取.所有者.front().所有者事实->所有者 != 所有者_)
            return 失败(状态类数据状态::内部不一致,
                读取.读取事实代次);
        const auto& 节点项 = 读取.节点.front();
        if (节点项.状态 == L1所有者范围一致当前读取项目状态::未找到)
            return 失败(状态类数据状态::未找到, 读取.读取事实代次);
        if (节点项.状态 == L1所有者范围一致当前读取项目状态::已退出)
            return 失败(状态类数据状态::目标已退出,
                读取.读取事实代次);
        if (节点项.状态 != L1所有者范围一致当前读取项目状态::成功
            || !节点项.事实)
            return 失败(状态类数据状态::内部不一致,
                读取.读取事实代次);
        const auto* 时间投影 = 查找属性投影(读取, 时间属性类型_);
        const auto* 快照投影 = 查找属性投影(读取, 快照属性类型_);
        if (!时间投影 || !快照投影)
            return 失败(状态类数据状态::内部不一致,
                读取.读取事实代次);
        const auto& 结点事实 = *节点项.事实;
        const auto& 时间事实 = 时间投影->当前值事实;
        const auto& 快照事实 = 快照投影->当前值事实;
        const auto* 时间 = std::get_if<std::int64_t>(&时间事实.材料);
        const auto* 快照 = std::get_if<std::vector<std::uint64_t>>(
            &快照事实.材料);
        if (结点事实.编码 != 状态结点
            || 结点事实.写入所有者 != 所有者_
            || 结点事实.种类 != 节点种类::普通
            || 结点事实.属性类型表示 || 结点事实.退出事实代次
            || 结点事实.创建事实代次 == 0
            || 结点事实.创建事实代次 > 读取.读取事实代次
            || 结点事实.当前属性.size() != 2
            || !时间 || *时间 <= 0 || !快照
            || !状态类数据内部::快照编码有效(*快照)
            || !值投影完整(*时间投影, 结点事实, 时间属性类型_)
            || !值投影完整(*快照投影, 结点事实, 快照属性类型_)
            || 时间事实.创建事实代次 != 结点事实.创建事实代次
            || 快照事实.创建事实代次 != 结点事实.创建事实代次)
            return 失败(状态类数据状态::内部不一致,
                读取.读取事实代次);
        auto 快照失败状态 = 状态类数据状态::内部不一致;
        auto 特征组 = 读取快照特征组(*快照,
            结点事实.创建事实代次, 快照失败状态);
        if (!特征组) return 失败(快照失败状态, 读取.读取事实代次);
        状态类结点 状态值{状态结点, 时间事实.编码, 快照事实.编码,
            *时间, std::move(*特征组), 结点事实.创建事实代次,
            std::nullopt};
        return {状态类数据状态::已读取, 状态类数据合同版本,
            读取.读取事实代次, std::move(状态值)};
    }

    状态类结点结果 读取历史已退出状态(稳定编码 状态结点,
        std::uint64_t 退出事实代次) const {
        if (退出事实代次 <= 1)
            return 失败(状态类数据状态::内部不一致, 退出事实代次);
        return 读取历史状态快照(状态结点, 退出事实代次 - 1,
            退出事实代次, 状态类数据状态::已退出, 退出事实代次);
    }

    状态类结点结果 读取历史状态快照(稳定编码 状态结点,
        std::uint64_t 历史截止事实代次, std::uint64_t 结果事实代次,
        状态类数据状态 返回状态,
        std::optional<std::uint64_t> 要求退出事实代次) const {
        const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 状态结点});
        const auto* 节点事实 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (节点读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(节点读取.状态),
                节点读取.读取事实代次);
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 状态结点 || !节点事实
            || 节点事实->编码 != 状态结点
            || 节点事实->写入所有者 != 所有者_
            || 节点事实->种类 != 节点种类::普通
            || 节点事实->属性类型表示
            || 节点事实->创建事实代次 == 0
            || 节点事实->创建事实代次 > 历史截止事实代次
            || (节点事实->退出事实代次
                && *节点事实->退出事实代次 <= 历史截止事实代次)
            || (要求退出事实代次
                && 节点事实->退出事实代次 != 要求退出事实代次)
            || 节点事实->当前属性.size() != 2)
            return 失败(状态类数据状态::内部不一致,
                节点读取.读取事实代次);
        const auto 时间编码 = 查找槽值(*节点事实, 时间属性类型_);
        const auto 快照编码 = 查找槽值(*节点事实, 快照属性类型_);
        if (!时间编码 || !快照编码)
            return 失败(状态类数据状态::内部不一致,
                节点读取.读取事实代次);
        const auto 时间读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, *时间编码});
        const auto 快照读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, *快照编码});
        const auto* 时间事实 = 时间读取.事实
            ? std::get_if<L1所有者范围值事实>(&*时间读取.事实) : nullptr;
        const auto* 快照事实 = 快照读取.事实
            ? std::get_if<L1所有者范围值事实>(&*快照读取.事实) : nullptr;
        const auto* 时间 = 时间事实
            ? std::get_if<std::int64_t>(&时间事实->材料) : nullptr;
        const auto* 快照 = 快照事实
            ? std::get_if<std::vector<std::uint64_t>>(&快照事实->材料)
            : nullptr;
        if (时间读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(时间读取.状态),
                时间读取.读取事实代次);
        if (快照读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(快照读取.状态),
                快照读取.读取事实代次);
        if (!时间事实 || !快照事实 || !时间 || *时间 <= 0 || !快照
            || !状态类数据内部::快照编码有效(*快照)
            || !历史值在截止有效(*时间事实, *节点事实,
                时间属性类型_, *时间编码, 历史截止事实代次,
                要求退出事实代次)
            || !历史值在截止有效(*快照事实, *节点事实,
                快照属性类型_, *快照编码, 历史截止事实代次,
                要求退出事实代次))
            return 失败(状态类数据状态::内部不一致,
                std::max(时间读取.读取事实代次,
                    快照读取.读取事实代次));
        auto 快照失败状态 = 状态类数据状态::内部不一致;
        auto 特征组 = 读取快照特征组(*快照,
            节点事实->创建事实代次, 快照失败状态);
        if (!特征组)
            return 失败(快照失败状态, 节点读取.读取事实代次);
        状态类结点 状态值{状态结点, *时间编码, *快照编码, *时间,
            std::move(*特征组), 节点事实->创建事实代次,
            要求退出事实代次};
        return {返回状态, 状态类数据合同版本,
            结果事实代次, std::move(状态值)};
    }

    状态类结点结果 读取历史已退出状态(const 状态类结点& 原状态,
        std::uint64_t 退出事实代次) const {
        auto 结果 = 读取历史已退出状态(原状态.结点, 退出事实代次);
        if (!结果.成功() || !结果.状态结点
            || 结果.状态结点->时间值事实 != 原状态.时间值事实
            || 结果.状态结点->快照值事实 != 原状态.快照值事实
            || 结果.状态结点->时间 != 原状态.时间
            || 结果.状态结点->特征值快照组 != 原状态.特征值快照组)
            return 失败(状态类数据状态::内部不一致, 退出事实代次);
        return 结果;
    }

    std::optional<std::vector<特征类结点>> 读取快照特征组(
        const std::vector<std::uint64_t>& 快照,
        std::uint64_t 状态创建代次,
        状态类数据状态& 失败状态) const {
        失败状态 = 状态类数据状态::内部不一致;
        if (!状态类数据内部::快照编码有效(快照)) return std::nullopt;
        std::vector<特征类结点> 结果;
        结果.reserve(快照.size() / 2);
        for (std::size_t i = 0; i < 快照.size(); i += 2) {
            const 稳定编码 特征结点{快照[i]};
            const 稳定编码 值编码{快照[i + 1]};
            const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 特征结点});
            const auto 值读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 值编码});
            if (节点读取.状态 != L1所有者范围读取状态::成功
                || 值读取.状态 != L1所有者范围读取状态::成功) {
                if (节点读取.状态 == L1所有者范围读取状态::资源失败
                    || 值读取.状态 == L1所有者范围读取状态::资源失败)
                    失败状态 = 状态类数据状态::资源失败;
                else if (节点读取.状态
                        == L1所有者范围读取状态::历史材料已清理
                    || 值读取.状态
                        == L1所有者范围读取状态::历史材料已清理)
                    失败状态 = 状态类数据状态::历史材料已清理;
                else if (节点读取.状态 == L1所有者范围读取状态::未找到
                    || 值读取.状态 == L1所有者范围读取状态::未找到)
                    失败状态 = 状态类数据状态::特征未找到;
                return std::nullopt;
            }
            const auto* 节点事实 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实)
                : nullptr;
            const auto* 值事实 = 值读取.事实
                ? std::get_if<L1所有者范围值事实>(&*值读取.事实)
                : nullptr;
            if (!节点事实 || !值事实 || 节点事实->编码 != 特征结点
                || 值事实->编码 != 值编码
                || 节点事实->写入所有者 != 值事实->写入所有者
                || 节点事实->种类 != 节点种类::普通
                || 节点事实->属性类型表示
                || 节点事实->当前属性.size() != 1
                || 节点事实->当前属性.front().属性类型节点
                    != 值事实->属性类型节点
                || 节点事实->当前属性.front().当前值 != 值编码
                || 值事实->所属节点 != 特征结点
                || 值事实->来源节点 != 特征结点
                || 节点事实->创建事实代次 == 0
                || 节点事实->创建事实代次 != 值事实->创建事实代次
                || 节点事实->创建事实代次 >= 状态创建代次
                || (节点事实->退出事实代次
                    && *节点事实->退出事实代次 <= 状态创建代次)
                || (值事实->退出事实代次
                    && *值事实->退出事实代次 <= 状态创建代次))
                return std::nullopt;
            结果.push_back({特征结点, 值编码,
                值事实->属性类型节点,
                状态类数据内部::转换为特征值(值事实->材料),
                节点事实->创建事实代次,
                std::nullopt});
        }
        return 结果;
    }

    const L1所有者范围一致属性值投影* 查找属性投影(
        const L1所有者范围一致当前读取结果& 读取,
        稳定编码 属性类型) const noexcept {
        const auto it = std::find_if(读取.属性值.begin(), 读取.属性值.end(),
            [&](const auto& 项) noexcept {
                return 项.节点 == 读取.节点.front().查询编码
                    && 项.属性类型 == 属性类型;
            });
        if (it == 读取.属性值.end()
            || it->状态 != L1所有者范围一致当前读取项目状态::成功
            || !it->投影)
            return nullptr;
        return &*it->投影;
    }

    static bool 值投影完整(
        const L1所有者范围一致属性值投影& 投影,
        const L1所有者范围节点事实& 节点,
        稳定编码 属性类型) noexcept {
        const auto& 值 = 投影.当前值事实;
        return 投影.属性槽.属性类型节点 == 属性类型
            && 投影.属性槽.当前值 == 值.编码
            && std::find(节点.当前属性.begin(), 节点.当前属性.end(),
                投影.属性槽) != 节点.当前属性.end()
            && 值.所属节点 == 节点.编码
            && 值.属性类型节点 == 属性类型
            && 值.来源节点 == 节点.编码
            && 值.写入所有者 == 节点.写入所有者
            && !值.退出事实代次;
    }

    static bool 历史值在截止有效(const L1所有者范围值事实& 值,
        const L1所有者范围节点事实& 节点,
        稳定编码 属性类型, 稳定编码 值编码,
        std::uint64_t 历史截止事实代次,
        std::optional<std::uint64_t> 要求退出事实代次) noexcept {
        return 值.编码 == 值编码 && 值.所属节点 == 节点.编码
            && 值.属性类型节点 == 属性类型
            && 值.来源节点 == 节点.编码
            && 值.写入所有者 == 节点.写入所有者
            && 值.创建事实代次 == 节点.创建事实代次
            && 值.创建事实代次 <= 历史截止事实代次
            && (!值.退出事实代次
                || *值.退出事实代次 > 历史截止事实代次)
            && (!要求退出事实代次
                || 值.退出事实代次 == 要求退出事实代次);
    }

    static std::optional<稳定编码> 查找槽值(
        const L1所有者范围节点事实& 节点,
        稳定编码 属性类型) noexcept {
        std::optional<稳定编码> 结果;
        for (const auto& 槽 : 节点.当前属性) {
            if (槽.属性类型节点 != 属性类型) continue;
            if (结果 || !有效(槽.当前值)) return std::nullopt;
            结果 = 槽.当前值;
        }
        return 结果;
    }

    bool 写入结果头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等身份) const noexcept {
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态
                == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_
            && 写入.写入幂等身份 == 幂等身份
            && 写入.事实代次 != 0 && (首次完整 || 重复完整);
    }

    bool 组读取结果头完整(
        const L1所有者范围属性类型当前值组读取结果& 读取,
        稳定编码 属性类型, std::uint64_t 期望事实代次) const noexcept {
        return 读取.合同版本
                == L1所有者范围属性类型当前值组读取合同版本
            && 读取.所有者 == 所有者_
            && 读取.属性类型节点 == 属性类型
            && 读取.期望事实代次 == 期望事实代次
            && 读取.读取事实代次 == 期望事实代次;
    }

    static void 规范化状态组(std::vector<状态类结点>& 状态组) {
        std::sort(状态组.begin(), 状态组.end(),
            [](const auto& 左, const auto& 右) noexcept {
                if (左.时间 != 右.时间) return 左.时间 < 右.时间;
                return 左.结点 < 右.结点;
            });
    }

    static 状态类结点结果 失败(状态类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 状态类数据合同版本, 事实代次, std::nullopt};
    }

    static 状态类组查询结果 组失败(状态类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 状态类数据合同版本, 事实代次, {}};
    }

    static 状态类数据状态 映射特征状态(
        特征类数据状态 状态) noexcept {
        switch (状态) {
        case 特征类数据状态::未找到:
        case 特征类数据状态::特征类型未找到:
            return 状态类数据状态::特征未找到;
        case 特征类数据状态::目标已退出:
        case 特征类数据状态::特征类型已退出:
            return 状态类数据状态::特征已退出;
        case 特征类数据状态::事实代次漂移:
            return 状态类数据状态::事实代次漂移;
        case 特征类数据状态::入口拒绝:
            return 状态类数据状态::入口拒绝;
        case 特征类数据状态::引用冲突:
            return 状态类数据状态::引用冲突;
        case 特征类数据状态::资源失败:
            return 状态类数据状态::资源失败;
        default:
            return 状态类数据状态::特征读取失败;
        }
    }

    static 状态类数据状态 映射读取状态(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::成功:
            return 状态类数据状态::已读取;
        case L1所有者范围读取状态::入口拒绝:
        case L1所有者范围读取状态::许可拒绝:
            return 状态类数据状态::入口拒绝;
        case L1所有者范围读取状态::未找到:
            return 状态类数据状态::未找到;
        case L1所有者范围读取状态::已退出:
            return 状态类数据状态::目标已退出;
        case L1所有者范围读取状态::事实代次漂移:
            return 状态类数据状态::事实代次漂移;
        case L1所有者范围读取状态::历史材料已清理:
            return 状态类数据状态::历史材料已清理;
        case L1所有者范围读取状态::资源失败:
            return 状态类数据状态::资源失败;
        default:
            return 状态类数据状态::内部不一致;
        }
    }

    static 状态类数据状态 映射组读取状态(
        L1所有者范围属性类型当前值组读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围属性类型当前值组读取状态::成功:
            return 状态类数据状态::已读取;
        case L1所有者范围属性类型当前值组读取状态::未找到:
            return 状态类数据状态::结构类型未找到;
        case L1所有者范围属性类型当前值组读取状态::已退出:
            return 状态类数据状态::结构类型已退出;
        case L1所有者范围属性类型当前值组读取状态::事实代次漂移:
            return 状态类数据状态::事实代次漂移;
        case L1所有者范围属性类型当前值组读取状态::数量预算不足:
            return 状态类数据状态::数量预算不足;
        case L1所有者范围属性类型当前值组读取状态::资源失败:
            return 状态类数据状态::资源失败;
        case L1所有者范围属性类型当前值组读取状态::入口拒绝:
            return 状态类数据状态::入口拒绝;
        default:
            return 状态类数据状态::内部不一致;
        }
    }

    static 状态类数据状态 映射写入状态(
        L1所有者范围写入状态 状态,
        状态类数据状态 成功状态) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功:
            return 成功状态;
        case L1所有者范围写入状态::精确重复:
            return 状态类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝:
        case L1所有者范围写入状态::许可拒绝:
            return 状态类数据状态::入口拒绝;
        case L1所有者范围写入状态::未找到:
            return 状态类数据状态::未找到;
        case L1所有者范围写入状态::已退出:
            return 状态类数据状态::目标已退出;
        case L1所有者范围写入状态::事实代次漂移:
            return 状态类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突:
            return 状态类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突:
            return 状态类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败:
            return 状态类数据状态::资源失败;
        default:
            return 状态类数据状态::内部不一致;
        }
    }

    const L1事实基座服务& 第一层服务_;
    const 特征类数据服务& 特征服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    稳定编码 时间属性类型_{};
    稳定编码 快照属性类型_{};
};

} // namespace 海中鱼巣
