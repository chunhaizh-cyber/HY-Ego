    bool 成功() const noexcept {
        return 状态 == 任务类数据状态::已读取方法实例参数规格组
            && 合同版本 == 任务类数据合同版本 && 事实代次 != 0
            && 提供者状态 == 任务方法实例参数规格专用状态::已读取
            && 有效(任务.值);
    }
};

struct 任务类实例参数绑定结果 final {
    任务类数据状态 状态 = 任务类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 任务类数据合同版本;
    std::uint64_t 事实代次 = 0;
    任务方法实例参数规格专用状态 提供者状态 =
        任务方法实例参数规格专用状态::入口拒绝;
    任务类记录身份 任务; 方法类记录身份 方法;
    std::optional<任务实例参数规格关系项> 参数槽;
    bool 成功() const noexcept {
        return (状态 == 任务类数据状态::已绑定实例参数
                || 状态 == 任务类数据状态::精确重复)
            && 合同版本 == 任务类数据合同版本 && 事实代次 != 0
            && 提供者状态 == 任务方法实例参数规格专用状态::已读取
            && 有效(任务.值) && 有效(方法.值) && 参数槽
            && 参数槽->数据关系 && 参数槽->特征节点;
    }
};

struct 任务类可执行参数组结果 final {
    任务类数据状态 状态 = 任务类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 任务类数据合同版本;
    std::uint64_t 事实代次 = 0; 任务类记录身份 任务; 方法类记录身份 方法;
    std::vector<任务类可执行参数项> 参数组;
    bool 成功() const noexcept {
        if (状态 != 任务类数据状态::已读取可执行参数组
            || 合同版本 != 任务类数据合同版本 || 事实代次 == 0
            || !有效(任务.值) || !有效(方法.值)) return false;
        for (std::size_t i = 0; i < 参数组.size(); ++i)
            if (参数组[i].顺序 != i + 1 || !有效(参数组[i].参数特征类型)
                || !有效(参数组[i].数据关系)
                || 参数组[i].特征.特征类型 != 参数组[i].参数特征类型)
                return false;
        return true;
    }
};

class 任务类数据服务 final {
public:
    任务类数据服务() = delete;
    任务类数据服务(const 任务类数据服务&) = delete;
    任务类数据服务& operator=(const 任务类数据服务&) = delete;
    任务类数据服务(任务类数据服务&&) = delete;
    任务类数据服务& operator=(任务类数据服务&&) = delete;

    任务类数据服务(const L1事实基座服务& 第一层服务,
        const 需求类数据服务& 需求服务,
        const 存在类数据服务& 存在服务,
        const 方法类数据服务& 方法服务,
        const 特征类数据服务& 特征服务,
        L1所有者范围写端口&& 写入端口,
        任务类结构类型 结构类型)
        : 第一层服务_(第一层服务), 需求服务_(需求服务),
          存在服务_(存在服务), 方法服务_(方法服务), 特征服务_(特征服务),
          写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()), 结构类型_(结构类型) {
        const std::vector<稳定编码> 任务类型组{结构类型_.所属存在关系类型,
            结构类型_.来源需求关系类型, 结构类型_.任务虚拟存在关系类型,
            结构类型_.任务方法关系类型, 结构类型_.实例宿主关系类型,
            结构类型_.实例来源方法关系类型, 结构类型_.实例来源虚拟存在关系类型,
            结构类型_.实例场景参数关系类型, 结构类型_.实例存在参数关系类型,
            结构类型_.实例特征参数关系类型, 结构类型_.实例场景参数数据关系类型,
            结构类型_.实例存在参数数据关系类型, 结构类型_.实例特征参数数据关系类型};
        const std::vector<稳定编码> 方法类型组{结构类型_.方法虚拟存在关系类型,
            结构类型_.方法场景参数关系类型, 结构类型_.方法存在参数关系类型,
            结构类型_.方法特征参数关系类型};
        auto 类型组 = 任务类型组;
        类型组.insert(类型组.end(), 方法类型组.begin(), 方法类型组.end());
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !有效(所有者_) || std::any_of(类型组.begin(), 类型组.end(),
                [](稳定编码 值) noexcept { return !有效(值); }))
            throw std::invalid_argument("invalid task data configuration");
        auto 排序 = 类型组;
        std::sort(排序.begin(), 排序.end());
        if (std::adjacent_find(排序.begin(), 排序.end()) != 排序.end())
            throw std::invalid_argument("duplicate task relation types");
        const auto 所有者 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者.状态 != L1所有者范围读取状态::成功
            || 所有者.合同版本 != L1所有者范围CRUD合同版本
            || !所有者.所有者事实 || 所有者.所有者事实->所有者 != 所有者_
            || 所有者.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 所有者.所有者事实->创建事实代次 == 0
            || 所有者.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid task data owner");
        for (const auto 类型 : 任务类型组) {
            const auto 读取 = 第一层服务_.读取所有者范围当前节点(
                {L1所有者范围CRUD合同版本, 类型});
            const auto* 节点 = 读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || !节点 || 节点->编码 != 类型 || 节点->写入所有者 != 所有者_
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 == 0 || 节点->退出事实代次
                || !节点->当前属性.empty())
                throw std::invalid_argument("invalid task relation type");
        }
        std::optional<L1结构所有者身份> 方法所有者;
        for (const auto 类型 : 方法类型组) {
            const auto 读取 = 第一层服务_.读取所有者范围当前节点(
                {L1所有者范围CRUD合同版本, 类型});
            const auto* 节点 = 读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
            if (读取.状态 != L1所有者范围读取状态::成功 || !节点
                || 节点->编码 != 类型 || !有效(节点->写入所有者)
                || 节点->写入所有者 == 所有者_ || 节点->种类 != 节点种类::普通
                || 节点->属性类型表示 || 节点->退出事实代次
                || !节点->当前属性.empty()
                || (方法所有者 && *方法所有者 != 节点->写入所有者))
                throw std::invalid_argument("invalid method relation type");
            方法所有者 = 节点->写入所有者;
        }
    }

    任务类记录结果 新增任务记录(const 任务类新增请求& 请求) {
        if (!新增请求有效(请求)) return 记录失败(任务类数据状态::入口拒绝);
        try {
            if (const auto 代次 = 检查代次(请求.期望事实代次))
                return 记录失败(代次->状态, 代次->事实代次);
            const auto 写集 = 形成基础写集(请求);
            if (const auto 重放 = 尝试基础重放(请求, 写集)) return *重放;
            const auto 来源 = 读取来源需求(请求.来源需求,
                请求.期望事实代次);
            if (!来源.成功)
                return 记录失败(来源.状态, 来源.事实代次, 来源.来源状态);
            if (来源.记录->所属存在 != 请求.所属存在)
                return 记录失败(任务类数据状态::来源需求不属于存在,
                    请求.期望事实代次, 来源.来源状态);
            const auto 已有 = 按所属存在和来源需求精确查询(
                {任务类数据合同版本, 请求.期望事实代次, 请求.所属存在,
                    请求.来源需求, std::numeric_limits<std::uint64_t>::max(),
                    std::numeric_limits<std::uint64_t>::max()});
            if (已有.成功()) return 记录失败(任务类数据状态::精确记录已存在,
                已有.事实代次, 已有.来源需求状态);
            if (已有.状态 != 任务类数据状态::未找到) return 已有;
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态, 任务类数据状态::已创建);
            if (状态 != 任务类数据状态::已创建
                && 状态 != 任务类数据状态::精确重复)
                return 记录失败(状态, 写入.事实代次);
            if (!写入头完整(写入, 请求.幂等身份))
                return 记录失败(写入.是否形成内存权威发布
                    ? 任务类数据状态::已可能发布
                    : 任务类数据状态::内部不一致, 写入.事实代次);
            return 从基础写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) { return 记录失败(任务类数据状态::资源失败); }
        catch (const std::length_error&) { return 记录失败(任务类数据状态::资源失败); }
        catch (...) { return 记录失败(任务类数据状态::内部不一致); }
    }

    任务类记录结果 查询任务记录(const 任务类身份查询请求& 请求) const {
        if (请求.合同版本 != 任务类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.任务.值)
            || 请求.最大方法节点数量 == 0)
            return 记录失败(任务类数据状态::入口拒绝);
        try {
            auto 基础 = 读取基础记录(请求.任务, 请求.期望事实代次);
            if (!基础.成功() || !基础.记录) return 基础;
            const auto Vt = 存在服务_.查询任务虚拟存在(
                {任务虚拟存在专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.任务.值, 结构类型_.任务虚拟存在关系类型});
            if (Vt.状态 == 任务虚拟存在专用状态::已读取 && Vt.成功())
                基础.记录->虚拟存在 = Vt.投影;
            else if (Vt.状态 != 任务虚拟存在专用状态::未初始化)
                return 记录失败(映射提供者状态(Vt.状态), Vt.事实代次,
                    基础.来源需求状态);
            const auto 方法 = 读取方法组内部(请求.任务, 请求.期望事实代次,
                请求.最大方法节点数量);
            if (!方法.成功())
                return 记录失败(方法.状态, 方法.事实代次,
                    基础.来源需求状态);
            基础.记录->方法节点组 = 方法.方法节点组;
            if (const auto 代次 = 检查代次(请求.期望事实代次))
                return 记录失败(代次->状态, 代次->事实代次,
                    基础.来源需求状态);
            return 基础;
        } catch (const std::bad_alloc&) { return 记录失败(任务类数据状态::资源失败); }
        catch (const std::length_error&) { return 记录失败(任务类数据状态::资源失败); }
        catch (...) { return 记录失败(任务类数据状态::内部不一致); }
    }

    任务类记录结果 按所属存在和来源需求精确查询(
        const 任务类精确查询请求& 请求) const {
        if (请求.合同版本 != 任务类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.所属存在)
            || !有效(请求.来源需求.值) || 请求.最大候选数量 == 0
            || 请求.最大方法节点数量 == 0)
            return 记录失败(任务类数据状态::入口拒绝);
        try {
            if (const auto 代次 = 检查代次(请求.期望事实代次))
                return 记录失败(代次->状态, 代次->事实代次);
            const auto 来源 = 读取来源需求(请求.来源需求, 请求.期望事实代次);
            if (!来源.成功)
                return 记录失败(来源.状态, 来源.事实代次, 来源.来源状态);
            if (来源.记录->所属存在 != 请求.所属存在)
                return 记录失败(任务类数据状态::来源需求不属于存在,
                    请求.期望事实代次, 来源.来源状态);
            const std::vector<std::pair<稳定编码, 稳定编码>> 条件{
                {请求.所属存在, 结构类型_.所属存在关系类型},
                {请求.来源需求.值, 结构类型_.来源需求关系类型}};
            std::optional<std::set<std::uint64_t>> 交集;
            for (const auto& [目标, 类型] : 条件) {
                const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
                    {L1所有者范围CRUD合同版本, 目标, 类型});
                if (读取.读取事实代次 != 请求.期望事实代次)
                    return 记录失败(任务类数据状态::事实代次漂移,
                        读取.读取事实代次, 来源.来源状态);
                if (读取.状态 != L1所有者范围读取状态::成功)
                    return 记录失败(映射L1读取状态(读取.状态),
                        读取.读取事实代次, 来源.来源状态);
                if (读取.合同版本 != L1所有者范围CRUD合同版本
                    || 读取.目标节点 != 目标 || 读取.关系类型节点 != 类型)
                    return 记录失败(任务类数据状态::内部不一致,
                        读取.读取事实代次, 来源.来源状态);
                if (读取.关系组.size() > 请求.最大候选数量)
                    return 记录失败(任务类数据状态::数量预算不足,
                        读取.读取事实代次, 来源.来源状态);
                std::set<std::uint64_t> 当前;
                for (const auto& 关系 : 读取.关系组) {
                    if (!关系有效(关系, 关系.源节点, 目标, 类型, std::nullopt)
                        || 关系.创建事实代次 > 请求.期望事实代次
                        || !当前.insert(关系.源节点.值).second)
                        return 记录失败(任务类数据状态::内部不一致,
                            读取.读取事实代次, 来源.来源状态);
                }
                if (!交集) 交集 = std::move(当前);
                else {
                    std::set<std::uint64_t> 新交集;
                    std::set_intersection(交集->begin(), 交集->end(),
                        当前.begin(), 当前.end(), std::inserter(新交集, 新交集.end()));
                    交集 = std::move(新交集);
                }
            }
            if (!交集 || 交集->empty())
                return 记录失败(任务类数据状态::未找到,
                    请求.期望事实代次, 来源.来源状态);
            if (交集->size() != 1)
                return 记录失败(任务类数据状态::内部不一致,
                    请求.期望事实代次, 来源.来源状态);
            auto 结果 = 查询任务记录({任务类数据合同版本,
                请求.期望事实代次, {{*交集->begin()}}, 请求.最大方法节点数量});
            if (!结果.成功() || !结果.记录) return 结果;
            if (结果.记录->所属存在 != 请求.所属存在
                || 结果.记录->来源需求 != 请求.来源需求)
                return 记录失败(任务类数据状态::内部不一致,
                    结果.事实代次, 结果.来源需求状态);
            return 结果;
        } catch (const std::bad_alloc&) { return 记录失败(任务类数据状态::资源失败); }
        catch (const std::length_error&) { return 记录失败(任务类数据状态::资源失败); }
        catch (...) { return 记录失败(任务类数据状态::内部不一致); }
    }

    任务类目标方向读取结果 读取任务目标方向(
        const 任务类目标方向读取请求& 请求) const {
        if (请求.合同版本 != 任务类数据合同版本
            || 请求.期望事实代次 == 0 || 请求.请求身份 == 0
            || !有效(请求.任务.值) || !有效(请求.当前事实特征)
            || 请求.要求结果位 == 0 || 请求.要求结果位 > 7)
            return 方向失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto 基础 = 读取基础记录(请求.任务, 请求.期望事实代次);
            if (!基础.成功() || !基础.记录)
                return 方向失败(基础.状态, 请求, 基础.事实代次,
                    基础.来源需求状态, 基础.记录 ? &*基础.记录 : nullptr);
            const auto 方向 = 需求服务_.计算临时需求方向(
                {需求类数据合同版本, 请求.期望事实代次, 请求.请求身份,
                    基础.记录->来源需求, 请求.当前事实特征, 请求.要求结果位});
            if (!方向.成功())
                return 方向失败(映射需求状态(方向.状态), 请求,
                    方向.事实代次, 方向.状态, &*基础.记录);
            const auto 来源 = 读取来源需求(基础.记录->来源需求,
                请求.期望事实代次);
            if (!来源.成功 || !来源.记录)
                return 方向失败(来源.状态, 请求, 来源.事实代次,
                    来源.来源状态, &*基础.记录);
            if (方向.需求 != 基础.记录->来源需求
                || 方向.当前事实特征 != 请求.当前事实特征
                || 方向.静态目标特征 != 来源.记录->静态目标特征
                || 方向.方向二次特征 != 来源.记录->方向二次特征)
                return 方向失败(任务类数据状态::内部不一致, 请求,
                    方向.事实代次, 方向.状态, &*基础.记录);
            if (const auto 代次 = 检查代次(请求.期望事实代次))
                return 方向失败(代次->状态, 请求, 代次->事实代次,
                    方向.状态, &*基础.记录);
            任务类目标方向读取结果 结果{任务类数据状态::已读取目标方向,
                任务类数据合同版本, 请求.期望事实代次, 方向.状态,
                请求.任务, 基础.记录->所属存在, 基础.记录->来源需求,
                请求.当前事实特征, 来源.记录->目标宿主, 方向.静态目标特征,
                方向.方向二次特征, 方向.比较};
            return 结果.成功() ? 结果
                : 方向失败(任务类数据状态::内部不一致, 请求,
                    请求.期望事实代次, 方向.状态, &*基础.记录);
        } catch (const std::bad_alloc&) { return 方向失败(任务类数据状态::资源失败, 请求); }
        catch (const std::length_error&) { return 方向失败(任务类数据状态::资源失败, 请求); }
        catch (...) { return 方向失败(任务类数据状态::内部不一致, 请求); }
    }

    任务类虚拟存在结果 初始化任务虚拟存在(
        const 任务类虚拟存在初始化请求& 请求) {
        if (请求.合同版本 != 任务类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.幂等身份)
            || !有效(请求.任务.值))
            return 虚拟存在失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto 基础 = 读取基础记录(请求.任务, 请求.期望事实代次);
            if (!基础.成功())
                return 虚拟存在失败(基础.状态, 请求, 基础.事实代次);
            const auto 首次 = 写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
            if (首次.状态 != L1所有者范围读取状态::成功
                && 首次.状态 != L1所有者范围读取状态::未找到)
                return 虚拟存在失败(映射L1读取状态(首次.状态), 请求,
                    首次.读取事实代次);
            const auto 当前 = 存在服务_.查询任务虚拟存在(
                {任务虚拟存在专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.任务.值, 结构类型_.任务虚拟存在关系类型});
            if (当前.状态 == 任务虚拟存在专用状态::已读取 && 当前.成功()) {
                if (首次.状态 == L1所有者范围读取状态::未找到)
                    return {任务类数据状态::虚拟存在已初始化,
                        任务类数据合同版本, 当前.事实代次, 当前.状态,
                        请求.任务, 当前.投影};
                if (!首次材料头完整(首次, 请求.幂等身份)
                    || !写入头完整(*首次.首次写入结果, 请求.幂等身份))
                    return 虚拟存在失败(任务类数据状态::内部不一致, 请求,
                        首次.读取事实代次, 当前.状态);
                if (!虚拟存在写集匹配(*首次.首次规范化写集, 请求))
                    return 虚拟存在失败(任务类数据状态::幂等冲突, 请求,
                        首次.读取事实代次, 当前.状态);
                const auto 节点 = 任务类数据内部::查找唯一编码(
                    *首次.首次写入结果,
                    任务类数据内部::虚拟存在节点本地键);
                const auto 关系 = 任务类数据内部::查找唯一编码(
                    *首次.首次写入结果,
                    任务类数据内部::虚拟存在关系本地键);
                if (首次.首次写入结果->新编码映射.size() != 2
                    || !节点 || !关系 || !当前.投影
                    || 当前.投影->虚拟存在节点 != *节点
                    || 当前.投影->任务虚拟存在关系 != *关系)
                    return 虚拟存在失败(任务类数据状态::内部不一致, 请求,
                        首次.读取事实代次, 当前.状态);
                return {任务类数据状态::精确重复, 任务类数据合同版本,
                    当前.事实代次, 当前.状态, 请求.任务, 当前.投影};
            }
            if (当前.状态 != 任务虚拟存在专用状态::未初始化)
                return 虚拟存在失败(映射提供者状态(当前.状态), 请求,
                    当前.事实代次, 当前.状态);
            const auto 规格 = 存在服务_.形成任务虚拟存在写集规格(
                {任务虚拟存在专用合同版本, 请求.期望事实代次, 所有者_,
                    请求.幂等身份, 请求.任务.值,
                    结构类型_.任务虚拟存在关系类型});
            if (!规格.成功() || !规格.写集) {
                const auto 状态 = 规格.合同版本 != 任务虚拟存在专用合同版本
                    ? 任务类数据状态::提供者不兼容
                    : (规格.状态 == 任务虚拟存在专用状态::事实代次漂移
                        || 规格.状态 == 任务虚拟存在专用状态::资源失败
                        || 规格.状态 == 任务虚拟存在专用状态::入口拒绝)
                        ? 映射提供者状态(规格.状态)
                        : 任务类数据状态::虚拟存在规格失败;
                return 虚拟存在失败(状态, 请求, 规格.事实代次, 规格.状态);
            }
            if (规格.任务所有者 != 所有者_
                || 规格.写入幂等身份 != 请求.幂等身份
                || !虚拟存在写集匹配(*规格.写集, 请求))
                return 虚拟存在失败(任务类数据状态::提供者不兼容,
                    请求, 规格.事实代次, 规格.状态);
            if (首次.状态 == L1所有者范围读取状态::成功) {
                if (!首次材料头完整(首次, 请求.幂等身份)
                    || !写入头完整(*首次.首次写入结果, 请求.幂等身份))
                    return 虚拟存在失败(任务类数据状态::内部不一致,
                        请求, 首次.读取事实代次, 规格.状态);
                if (*首次.首次规范化写集 != *规格.写集)
                    return 虚拟存在失败(任务类数据状态::幂等冲突,
                        请求, 首次.读取事实代次, 规格.状态);
                return 从虚拟存在写入读回(*首次.首次写入结果, 请求,
                    任务类数据状态::精确重复);
            }
            const auto 写入 = 写入端口_.提交所有者范围中性写集(*规格.写集);
            const auto 状态 = 映射写入状态(写入.状态,
                任务类数据状态::已初始化虚拟存在);
            if (状态 != 任务类数据状态::已初始化虚拟存在
                && 状态 != 任务类数据状态::精确重复)
                return 虚拟存在失败(状态, 请求, 写入.事实代次, 规格.状态);
            if (!写入头完整(写入, 请求.幂等身份))
                return 虚拟存在失败(写入.是否形成内存权威发布
                    ? 任务类数据状态::已可能发布
                    : 任务类数据状态::内部不一致,
                    请求, 写入.事实代次, 规格.状态);
            return 从虚拟存在写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) { return 虚拟存在失败(任务类数据状态::资源失败, 请求); }
        catch (const std::length_error&) { return 虚拟存在失败(任务类数据状态::资源失败, 请求); }
        catch (...) { return 虚拟存在失败(任务类数据状态::内部不一致, 请求); }
    }

    任务类方法结果 添加方法节点(const 任务类方法添加请求& 请求) {
        if (请求.合同版本 != 任务类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.幂等身份)
            || !有效(请求.任务.值) || !有效(请求.方法节点))
            return 方法失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto 基础 = 读取基础记录(请求.任务, 请求.期望事实代次);
            if (!基础.成功()) return 方法失败(基础.状态, 请求, 基础.事实代次);
            if (const auto 状态 = 验证方法节点(请求.方法节点,
                    请求.期望事实代次))
                return 方法失败(*状态, 请求, 请求.期望事实代次);
            const auto 写集 = 形成方法写集(请求);
            const auto 首次 = 写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
            if (首次.状态 == L1所有者范围读取状态::成功) {
                if (!首次材料头完整(首次, 请求.幂等身份)
                    || !写入头完整(*首次.首次写入结果, 请求.幂等身份))
                    return 方法失败(任务类数据状态::内部不一致, 请求,
                        首次.读取事实代次);
                if (*首次.首次规范化写集 != 写集)
                    return 方法失败(任务类数据状态::幂等冲突, 请求,
                        首次.读取事实代次);
                return 从方法写入读回(*首次.首次写入结果, 请求,
                    任务类数据状态::精确重复);
            }
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 方法失败(映射L1读取状态(首次.状态), 请求,
                    首次.读取事实代次);
            const auto 当前 = 查找当前方法关系(请求.任务, 请求.方法节点,
                请求.期望事实代次);
            if (当前.状态 != 任务类数据状态::未找到)
                return 当前.成功()
                    ? 方法失败(任务类数据状态::方法节点已存在, 请求,
                        当前.事实代次)
                    : 当前;
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态,
                任务类数据状态::已添加方法节点);
            if (状态 != 任务类数据状态::已添加方法节点
                && 状态 != 任务类数据状态::精确重复)
                return 方法失败(状态, 请求, 写入.事实代次);
            if (!写入头完整(写入, 请求.幂等身份))
                return 方法失败(写入.是否形成内存权威发布
                    ? 任务类数据状态::已可能发布
                    : 任务类数据状态::内部不一致, 请求, 写入.事实代次);
            return 从方法写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) { return 方法失败(任务类数据状态::资源失败, 请求); }
        catch (const std::length_error&) { return 方法失败(任务类数据状态::资源失败, 请求); }
        catch (...) { return 方法失败(任务类数据状态::内部不一致, 请求); }
    }

    任务类方法组结果 读取方法节点组(
        const 任务类方法组读取请求& 请求) const {
        if (请求.合同版本 != 任务类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.任务.值)
            || 请求.最大方法节点数量 == 0)
            return 方法组失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto 基础 = 读取基础记录(请求.任务, 请求.期望事实代次);
            if (!基础.成功())
                return 方法组失败(基础.状态, 请求, 基础.事实代次);
            auto 结果 = 读取方法组内部(请求.任务, 请求.期望事实代次,
                请求.最大方法节点数量);
            if (!结果.成功()) return 结果;
            if (const auto 代次 = 检查代次(请求.期望事实代次))
                return 方法组失败(代次->状态, 请求, 代次->事实代次);
            return 结果;
        } catch (const std::bad_alloc&) { return 方法组失败(任务类数据状态::资源失败, 请求); }
        catch (const std::length_error&) { return 方法组失败(任务类数据状态::资源失败, 请求); }
        catch (...) { return 方法组失败(任务类数据状态::内部不一致, 请求); }
    }

    任务类方法实例结果 实例化方法虚拟存在到任务虚拟存在(
        const 任务类方法实例化请求& 请求) {
        if (请求.合同版本 != 任务类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.幂等身份) || !有效(请求.任务.值)
            || !有效(请求.方法.值) || 请求.最大任务方法数量 == 0
            || 请求.最大方法参数数量 == 0 || 请求.最大已有实例数量 == 0)
            return 实例失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto task = 查询任务记录({任务类数据合同版本,
                请求.期望事实代次, 请求.任务, 请求.最大任务方法数量});
            if (!task.成功() || !task.记录)
                return 实例失败(task.状态, 请求, task.事实代次);
            if (!task.记录->虚拟存在)
                return 实例失败(任务类数据状态::虚拟存在未初始化, 请求,
                    请求.期望事实代次);
            if (!std::binary_search(task.记录->方法节点组.begin(),
                    task.记录->方法节点组.end(), 请求.方法.值))
                return 实例失败(任务类数据状态::方法未登记到任务, 请求,
                    请求.期望事实代次);
            const auto method = 方法服务_.查询方法记录({方法类数据合同版本,
                请求.期望事实代次, 请求.方法,
                std::numeric_limits<std::uint64_t>::max(),
                std::numeric_limits<std::uint64_t>::max()});
            if (!method.成功() || !method.记录)
                return 实例失败(method.状态 == 方法类数据状态::方法虚拟存在未初始化
                    ? 任务类数据状态::方法虚拟存在未初始化
                    : 任务类数据状态::方法读取失败, 请求, method.事实代次);
            if (!method.记录->虚拟存在)
                return 实例失败(任务类数据状态::方法虚拟存在未初始化, 请求,
                    请求.期望事实代次);
            const auto params = 方法服务_.读取方法参数规格组({方法类数据合同版本,
                请求.期望事实代次, 请求.方法, 请求.最大方法参数数量});
            if (!params.成功()) return 实例失败(
                params.状态 == 方法类数据状态::事实代次漂移
                    ? 任务类数据状态::事实代次漂移
                    : 任务类数据状态::方法参数规格读取失败,
                请求, params.事实代次);
            if (params.方法虚拟存在节点
                    != method.记录->虚拟存在->虚拟存在节点)
                return 实例失败(任务类数据状态::方法材料漂移, 请求,
                    请求.期望事实代次);
            任务方法实例参数规格来源 source{请求.方法.值,
                params.方法虚拟存在节点,
                method.记录->虚拟存在->方法虚拟存在关系, {}};
            for (const auto& p : params.参数规格组)
                source.参数规格组.push_back({映射参数类别(p.类别), p.关系,
                    p.参数特征类型, p.顺序});
            const auto first = 写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
            if (first.状态 != L1所有者范围读取状态::未找到) {
                if (first.状态 != L1所有者范围读取状态::成功
                    || first.读取事实代次 != 请求.期望事实代次
                    || !first.首次规范化写集 || !first.首次写入结果)
                    return 实例失败(映射L1读取状态(first.状态), 请求,
                        first.读取事实代次);
                if (!实例首次写集匹配(*first.首次规范化写集, 请求,
                        *task.记录->虚拟存在, source))
                    return 实例失败(任务类数据状态::幂等冲突, 请求,
                        first.读取事实代次);
                const auto replay = 读取实例组({任务类数据合同版本,
                    first.首次写入结果->事实代次, 请求.任务,
                    请求.最大已有实例数量 == std::numeric_limits<std::uint64_t>::max()
                        ? 请求.最大已有实例数量 : 请求.最大已有实例数量 + 1,
                    请求.最大方法参数数量});
                const auto* found = 查找实例(replay, 请求.方法);
                if (!found || found->来源 != source)
                    return 实例失败(任务类数据状态::已可能发布, 请求,
                        first.首次写入结果->事实代次, replay.提供者状态);
                return {任务类数据状态::精确重复, 任务类数据合同版本,
                    replay.事实代次, replay.提供者状态, 请求.任务,
                    请求.方法, *found};
            }
            const auto spec = 存在服务_.形成任务方法实例参数规格写集规格(
                {任务方法实例参数规格专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.幂等身份, 请求.任务.值, source,
                    实例结构类型(), 请求.最大已有实例数量,
                    请求.最大方法参数数量});
            if (spec.状态 == 任务方法实例参数规格专用状态::已实例化) {
                const auto current = 读取实例组({任务类数据合同版本,
                    请求.期望事实代次, 请求.任务, 请求.最大已有实例数量,
                    请求.最大方法参数数量});
                const auto* found = 查找实例(current, 请求.方法);
                if (!found) return 实例失败(任务类数据状态::实例规格失败,
                    请求, current.事实代次, spec.状态);
                return 实例失败(任务类数据状态::实例已存在, 请求,
                    current.事实代次, current.提供者状态);
            }
            if (!spec.成功() || !spec.写集)
                return 实例失败(映射实例提供者状态(spec.状态), 请求,
                    spec.事实代次, spec.状态);
            if (spec.任务所有者 != 所有者_
                || spec.写入幂等身份 != 请求.幂等身份
                || spec.写集->期望事实代次 != 请求.期望事实代次
                || spec.写集->写入幂等身份 != 请求.幂等身份)
                return 实例失败(任务类数据状态::实例提供者不兼容,
                    请求, spec.事实代次, spec.状态);
            const auto write = 写入端口_.提交所有者范围中性写集(*spec.写集);
            const auto ws = 映射写入状态(write.状态,
                任务类数据状态::已实例化方法虚拟存在);
            if (ws != 任务类数据状态::已实例化方法虚拟存在
                && ws != 任务类数据状态::精确重复)
                return 实例失败(ws, 请求, write.事实代次, spec.状态);
            const auto current = 读取实例组({任务类数据合同版本,
                write.事实代次, 请求.任务,
                请求.最大已有实例数量 == std::numeric_limits<std::uint64_t>::max()
                    ? 请求.最大已有实例数量 : 请求.最大已有实例数量 + 1,
                请求.最大方法参数数量});
            const auto* found = 查找实例(current, 请求.方法);
            if (!found || found->来源 != source)
                return 实例失败(任务类数据状态::已可能发布, 请求,
                    write.事实代次, current.提供者状态);
            return {ws, 任务类数据合同版本, write.事实代次,
                current.提供者状态, 请求.任务, 请求.方法, *found};
        } catch (const std::bad_alloc&) {
            return 实例失败(任务类数据状态::资源失败, 请求);
        } catch (const std::length_error&) {
            return 实例失败(任务类数据状态::资源失败, 请求);
        } catch (...) { return 实例失败(任务类数据状态::内部不一致, 请求); }
    }

    任务类方法实例参数规格组结果 读取任务方法实例参数规格组(
        const 任务类方法实例参数规格组读取请求& 请求) const {
        if (请求.合同版本 != 任务类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.任务.值) || 请求.最大实例数量 == 0
            || 请求.每实例最大参数数量 == 0)
            return 实例组失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto task = 读取基础记录(请求.任务, 请求.期望事实代次);
            if (!task.成功())
                return 实例组失败(task.状态, 请求, task.事实代次);
            const auto q = 存在服务_.读取任务方法实例参数规格组(
                {任务方法实例参数规格专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.任务.值, 实例结构类型(),
                    请求.最大实例数量, 请求.每实例最大参数数量});
            if (!q.成功()) return 实例组失败(映射实例提供者状态(q.状态),
                请求, q.事实代次, q.状态);
            if (q.任务所有者 != 所有者_ || q.任务节点 != 请求.任务.值)
                return 实例组失败(任务类数据状态::实例提供者不兼容,
                    请求, q.事实代次, q.状态);
            return {任务类数据状态::已读取方法实例参数规格组,
                任务类数据合同版本, q.事实代次, q.状态, 请求.任务,
                q.投影组};
        } catch (const std::bad_alloc&) {
            return 实例组失败(任务类数据状态::资源失败, 请求);
        } catch (const std::length_error&) {
            return 实例组失败(任务类数据状态::资源失败, 请求);
        } catch (...) { return 实例组失败(任务类数据状态::内部不一致, 请求); }
    }

    任务类实例参数绑定结果 绑定任务方法实例参数(
        const 任务类实例参数绑定请求& 请求) {
        if (请求.合同版本 != 任务类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.幂等身份) || !有效(请求.任务.值)
            || !有效(请求.方法.值) || !方法参数类别有效(请求.类别)
            || 请求.顺序 == 0 || 请求.顺序 > static_cast<std::uint64_t>(
                std::numeric_limits<std::int64_t>::max())
            || !有效(请求.特征节点)
            || 请求.最大实例数量 == 0 || 请求.每实例最大参数数量 == 0)
            return 绑定失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto group = 读取实例组({任务类数据合同版本,
                请求.期望事实代次, 请求.任务, 请求.最大实例数量,
                请求.每实例最大参数数量});
            if (!group.成功()) return 绑定失败(group.状态, 请求,
                group.事实代次, group.提供者状态);
            const auto* instance = 查找实例(group, 请求.方法);
            if (!instance) return 绑定失败(任务类数据状态::实例未找到,
                请求, group.事实代次, group.提供者状态);
            const auto c = 映射参数类别(请求.类别);
            const auto slot = std::find_if(instance->实例参数规格组.begin(),
                instance->实例参数规格组.end(), [&请求, c](const auto& x) {
                    return x.类别 == c && x.顺序 == 请求.顺序;
                });
            if (slot == instance->实例参数规格组.end())
                return 绑定失败(任务类数据状态::参数槽未找到, 请求,
                    group.事实代次, group.提供者状态);
            const auto first = 写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
            if (first.状态 != L1所有者范围读取状态::未找到) {
                if (first.状态 != L1所有者范围读取状态::成功
                    || first.读取事实代次 != 请求.期望事实代次
                    || !first.首次规范化写集 || !first.首次写入结果)
                    return 绑定失败(映射L1读取状态(first.状态), 请求,
                        first.读取事实代次, group.提供者状态);
                if (!绑定首次写集匹配(*first.首次规范化写集, 请求,
                        instance->实例节点))
                    return 绑定失败(任务类数据状态::幂等冲突, 请求,
                        first.读取事实代次, group.提供者状态);
                if (slot->特征节点 == 请求.特征节点 && slot->数据关系)
                    return {任务类数据状态::精确重复, 任务类数据合同版本,
                        group.事实代次, group.提供者状态, 请求.任务,
                        请求.方法, *slot};
                return 绑定失败(任务类数据状态::已可能发布, 请求,
                    first.首次写入结果->事实代次, group.提供者状态);
            }
            if (slot->数据关系 || slot->特征节点)
                return 绑定失败(slot->特征节点 == 请求.特征节点
                        ? 任务类数据状态::参数槽已绑定
                        : 任务类数据状态::参数绑定冲突,
                    请求, group.事实代次, group.提供者状态);
            const auto f = 特征服务_.查询特征({特征类数据合同版本,
                请求.期望事实代次, 请求.特征节点});
            if (!f.成功() || !f.特征) return 绑定失败(
                映射参数特征状态(f.状态), 请求, f.事实代次,
                group.提供者状态);
            if (f.特征->特征类型 != slot->参数特征类型)
                return 绑定失败(任务类数据状态::参数特征类型不匹配,
                    请求, f.事实代次, group.提供者状态);
            const auto spec = 存在服务_.形成任务实例参数绑定写集规格(
                {任务方法实例参数规格专用合同版本, 请求.期望事实代次,
                    所有者_, 请求.幂等身份, 请求.任务.值, 请求.方法.值,
                    c, 请求.顺序, slot->参数特征类型, 请求.特征节点,
                    实例结构类型(), 请求.最大实例数量,
                    请求.每实例最大参数数量});
            if (!spec.成功() || !spec.写集)
                return 绑定失败(映射绑定提供者状态(spec.状态), 请求,
                    spec.事实代次, spec.状态);
            if (spec.任务所有者 != 所有者_
                || spec.写入幂等身份 != 请求.幂等身份
                || spec.写集->期望事实代次 != 请求.期望事实代次
                || spec.写集->写入幂等身份 != 请求.幂等身份)
                return 绑定失败(任务类数据状态::实例提供者不兼容,
                    请求, spec.事实代次, spec.状态);
            const auto write = 写入端口_.提交所有者范围中性写集(*spec.写集);
            const auto ws = 映射写入状态(write.状态,
                任务类数据状态::已绑定实例参数);
            if (ws != 任务类数据状态::已绑定实例参数
                && ws != 任务类数据状态::精确重复)
                return 绑定失败(ws, 请求, write.事实代次, spec.状态);
            const auto after = 读取实例组({任务类数据合同版本,
                write.事实代次, 请求.任务, 请求.最大实例数量,
                请求.每实例最大参数数量});
            const auto* ai = 查找实例(after, 请求.方法);
            if (!ai) return 绑定失败(任务类数据状态::已可能发布,
                请求, write.事实代次, after.提供者状态);
            const auto as = std::find_if(ai->实例参数规格组.begin(),
                ai->实例参数规格组.end(), [&请求, c](const auto& x) {
                    return x.类别 == c && x.顺序 == 请求.顺序;
                });
            if (as == ai->实例参数规格组.end() || as->特征节点 != 请求.特征节点
                || !as->数据关系)
                return 绑定失败(任务类数据状态::已可能发布,
                    请求, write.事实代次, after.提供者状态);
            return {ws, 任务类数据合同版本, write.事实代次,
                after.提供者状态, 请求.任务, 请求.方法, *as};
        } catch (const std::bad_alloc&) {
            return 绑定失败(任务类数据状态::资源失败, 请求);
        } catch (const std::length_error&) {
            return 绑定失败(任务类数据状态::资源失败, 请求);
        } catch (...) { return 绑定失败(任务类数据状态::内部不一致, 请求); }
    }

    任务类可执行参数组结果 读取任务方法实例可执行参数组(
        const 任务类可执行参数组读取请求& 请求) const {
        if (请求.合同版本 != 任务类数据合同版本 || 请求.期望事实代次 == 0
            || !有效(请求.任务.值) || !有效(请求.方法.值)
            || 请求.最大实例数量 == 0 || 请求.每实例最大参数数量 == 0)
            return 可执行组失败(任务类数据状态::入口拒绝, 请求);
        try {
            const auto group = 读取实例组({任务类数据合同版本,
                请求.期望事实代次, 请求.任务, 请求.最大实例数量,
                请求.每实例最大参数数量});
            if (!group.成功()) return 可执行组失败(group.状态, 请求,
                group.事实代次);
            const auto* instance = 查找实例(group, 请求.方法);
            if (!instance) return 可执行组失败(任务类数据状态::实例未找到,
                请求, group.事实代次);
            std::vector<任务类可执行参数项> out;
            for (const auto& slot : instance->实例参数规格组) {
                if (!slot.数据关系 || !slot.特征节点)
                    return 可执行组失败(任务类数据状态::参数槽未绑定,
                        请求, group.事实代次);
                const auto f = 特征服务_.查询特征({特征类数据合同版本,
                    请求.期望事实代次, *slot.特征节点});
                if (!f.成功() || !f.特征)
                    return 可执行组失败(映射参数特征状态(f.状态), 请求,
                        f.事实代次);
                if (f.特征->特征类型 != slot.参数特征类型)
                    return 可执行组失败(任务类数据状态::参数特征类型不匹配,
                        请求, f.事实代次);
                out.push_back({映射参数类别(slot.类别), slot.顺序,
                    slot.参数特征类型, *slot.数据关系, *f.特征});
            }
            return {任务类数据状态::已读取可执行参数组,
                任务类数据合同版本, 请求.期望事实代次,
                请求.任务, 请求.方法, std::move(out)};
        } catch (const std::bad_alloc&) {
            return 可执行组失败(任务类数据状态::资源失败, 请求);
        } catch (const std::length_error&) {
            return 可执行组失败(任务类数据状态::资源失败, 请求);
        } catch (...) { return 可执行组失败(任务类数据状态::内部不一致, 请求); }
    }

private:
    struct 代次失败值 { 任务类数据状态 状态; std::uint64_t 事实代次; };
    struct 来源需求读取值 { bool 成功=false; 任务类数据状态 状态=任务类数据状态::内部不一致;
        需求类数据状态 来源状态=需求类数据状态::入口拒绝; std::uint64_t 事实代次=0;
        std::optional<需求类记录> 记录; };

    std::optional<代次失败值> 检查代次(std::uint64_t G0) const noexcept {
        const auto 读取 = 第一层服务_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (读取.状态 == L1中性读取状态::资源失败)
            return 代次失败值{任务类数据状态::资源失败, 读取.事实代次};
        if (读取.状态 == L1中性读取状态::入口拒绝)
            return 代次失败值{任务类数据状态::入口拒绝, 读取.事实代次};
        if (读取.状态 != L1中性读取状态::成功
            || 读取.合同版本 != L1中性CRUD合同版本 || 读取.事实代次 == 0)
            return 代次失败值{任务类数据状态::内部不一致, 读取.事实代次};
        if (读取.事实代次 != G0)
            return 代次失败值{任务类数据状态::事实代次漂移, 读取.事实代次};
        return std::nullopt;
    }

    static bool 新增请求有效(const 任务类新增请求& 请求) noexcept {
        return 请求.合同版本 == 任务类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.所属存在) && 有效(请求.来源需求.值);
    }

    L1所有者范围写集请求 形成基础写集(const 任务类新增请求& 请求) const {
        using namespace 任务类数据内部;
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{任务本地键, 节点种类::普通, std::nullopt}};
        写集.关系 = {
            {所属存在关系本地键, 任务本地键, 请求.所属存在,
                结构类型_.所属存在关系类型, 0},
            {来源需求关系本地键, 任务本地键, 请求.来源需求.值,
                结构类型_.来源需求关系类型, 0}};
        return 写集;
    }

    L1所有者范围写集请求 形成方法写集(const 任务类方法添加请求& 请求) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.关系 = {{任务类数据内部::方法关系本地键,
            请求.任务.值, 请求.方法节点, 结构类型_.任务方法关系类型, 0}};
        return 写集;
    }

    来源需求读取值 读取来源需求(需求类记录身份 身份,
        std::uint64_t G0) const {
        const auto 读取 = 需求服务_.查询需求记录({需求类数据合同版本, G0, 身份});
        if (读取.成功() && 读取.状态 == 需求类数据状态::已读取
            && 读取.事实代次 == G0 && 读取.记录 && 读取.记录->身份 == 身份)
            return {true, 任务类数据状态::已读取, 读取.状态,
                读取.事实代次, 读取.记录};
        return {false, 映射需求状态(读取.状态), 读取.状态,
            读取.事实代次, std::nullopt};
    }

    任务类记录结果 读取基础记录(任务类记录身份 身份,
        std::uint64_t G0) const {
        if (const auto 代次 = 检查代次(G0))
            return 记录失败(代次->状态, 代次->事实代次);
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = G0;
        请求.所有者 = {所有者_};
        请求.节点 = {身份.值};
        请求.源关系组 = {{身份.值, 结构类型_.所属存在关系类型},
            {身份.值, 结构类型_.来源需求关系类型}};
        const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(请求);
        if (读取.状态 != L1所有者范围一致当前读取状态::成功)
            return 记录失败(映射一致读取状态(读取.状态), 读取.读取事实代次);
        if (读取.合同版本 != L1所有者范围一致当前读取合同版本
            || 读取.期望事实代次 != G0 || 读取.读取事实代次 != G0
            || 读取.所有者.size() != 1 || 读取.节点.size() != 1
            || 读取.源关系组.size() != 2 || !读取.关系.empty()
            || !读取.值.empty() || !读取.属性值.empty()
            || !读取.目标关系组.empty()
            || 读取.所有者.front().查询所有者 != 所有者_
            || 读取.所有者.front().状态 != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实
            || 读取.所有者.front().所有者事实->所有者 != 所有者_
            || 读取.所有者.front().所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 读取.所有者.front().所有者事实->创建事实代次 == 0
            || 读取.所有者.front().所有者事实->创建事实代次 > G0
            || 读取.所有者.front().所有者事实->退出事实代次)
            return 记录失败(任务类数据状态::内部不一致, 读取.读取事实代次);
        const auto& 项 = 读取.节点.front();
        if (项.状态 == L1所有者范围一致当前读取项目状态::未找到
            || 项.状态 == L1所有者范围一致当前读取项目状态::已退出)
            return 记录失败(任务类数据状态::未找到, G0);
        if (项.查询编码 != 身份.值
            || 项.状态 != L1所有者范围一致当前读取项目状态::成功
            || !项.事实 || 项.物理清理事实代次 || 项.物理清理墓碑)
            return 记录失败(任务类数据状态::内部不一致, G0);
        const auto& 节点 = *项.事实;
        if (节点.写入所有者 != 所有者_)
            return 记录失败(任务类数据状态::未找到, G0);
        if (节点.编码 != 身份.值 || 节点.种类 != 节点种类::普通
            || 节点.属性类型表示 || 节点.退出事实代次
            || !节点.当前属性.empty() || 节点.创建事实代次 == 0
            || 节点.创建事实代次 > G0)
            return 记录失败(任务类数据状态::内部不一致, G0);
        任务类记录 记录;
        记录.身份 = 身份;
        记录.创建事实代次 = 节点.创建事实代次;
        if (std::any_of(读取.源关系组.begin(), 读取.源关系组.end(),
                [身份](const auto& 项) noexcept { return 项.源节点 != 身份.值; }))
            return 记录失败(任务类数据状态::内部不一致, G0);
        if (!提取基础关系(读取.源关系组, 结构类型_.所属存在关系类型,
                记录.所属存在, 记录.所属存在关系, 节点.创建事实代次))
            return 记录失败(任务类数据状态::内部不一致, G0);
        稳定编码 来源{};
        if (!提取基础关系(读取.源关系组, 结构类型_.来源需求关系类型,
                来源, 记录.来源需求关系, 节点.创建事实代次))
            return 记录失败(任务类数据状态::内部不一致, G0);
        记录.来源需求 = {来源};
        const auto 需求 = 读取来源需求(记录.来源需求, G0);
        if (!需求.成功)
            return 记录失败(需求.状态, 需求.事实代次, 需求.来源状态);
        if (需求.记录->所属存在 != 记录.所属存在)
            return 记录失败(任务类数据状态::来源需求不属于存在,
                G0, 需求.来源状态);
        if (const auto 代次 = 检查代次(G0))
            return 记录失败(代次->状态, 代次->事实代次, 需求.来源状态);
        return {任务类数据状态::已读取, 任务类数据合同版本, G0,
            需求.来源状态, std::move(记录)};
    }

    bool 提取基础关系(
        const std::vector<L1所有者范围一致源关系组读取结果项>& 组,
        稳定编码 类型, 稳定编码& 目标, 稳定编码& 关系编码,
        std::uint64_t 创建代次) const noexcept {
        const auto it = std::find_if(组.begin(), 组.end(),
            [类型](const auto& 项) noexcept { return 项.关系类型节点 == 类型; });
        if (it == 组.end() || it->成员.size() != 1) return false;
        const auto& 投影 = it->成员.front();
        if (!关系有效(投影.关系, it->源节点, 投影.关系.目标节点,
                类型, 创建代次)
            || 投影.对端节点.编码 != 投影.关系.目标节点
            || 投影.对端节点.退出事实代次) return false;
        目标 = 投影.关系.目标节点;
        关系编码 = 投影.关系.编码;
        return true;
    }

    任务类方法组结果 读取方法组内部(任务类记录身份 任务,
        std::uint64_t G0, std::uint64_t 预算) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 任务.值, 结构类型_.任务方法关系类型});
        if (读取.读取事实代次 != G0)
            return 方法组失败(任务类数据状态::事实代次漂移, {任务类数据合同版本,
                G0, 任务, 预算}, 读取.读取事实代次);
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 方法组失败(映射L1读取状态(读取.状态),
                {任务类数据合同版本, G0, 任务, 预算}, 读取.读取事实代次);
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.源节点 != 任务.值
            || 读取.关系类型节点 != 结构类型_.任务方法关系类型)
            return 方法组失败(任务类数据状态::内部不一致,
                {任务类数据合同版本, G0, 任务, 预算}, G0);
        if (读取.关系组.size() > 预算)
            return 方法组失败(任务类数据状态::方法节点数量预算不足,
                {任务类数据合同版本, G0, 任务, 预算}, G0);
        std::vector<稳定编码> 方法;
        方法.reserve(读取.关系组.size());
        for (const auto& 关系 : 读取.关系组) {
            if (!关系有效(关系, 任务.值, 关系.目标节点,
                    结构类型_.任务方法关系类型, std::nullopt)
                || 关系.创建事实代次 > G0)
                return 方法组失败(任务类数据状态::内部不一致,
                    {任务类数据合同版本, G0, 任务, 预算}, G0);
            if (const auto 状态 = 验证方法节点(关系.目标节点, G0))
                return 方法组失败(*状态,
                    {任务类数据合同版本, G0, 任务, 预算}, G0);
            方法.push_back(关系.目标节点);
        }
        std::sort(方法.begin(), 方法.end());
        if (std::adjacent_find(方法.begin(), 方法.end()) != 方法.end())
            return 方法组失败(任务类数据状态::内部不一致,
                {任务类数据合同版本, G0, 任务, 预算}, G0);
        return {任务类数据状态::已读取方法节点组, 任务类数据合同版本,
            G0, 任务, std::move(方法)};
    }

    std::optional<任务类数据状态> 验证方法节点(稳定编码 编码,
        std::uint64_t G0) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        if (读取.读取事实代次 != G0) return 任务类数据状态::事实代次漂移;
        if (读取.状态 == L1所有者范围读取状态::未找到)
            return 任务类数据状态::方法节点未找到;
        if (读取.状态 == L1所有者范围读取状态::已退出)
            return 任务类数据状态::方法节点已退出;
        if (读取.状态 == L1所有者范围读取状态::资源失败)
            return 任务类数据状态::资源失败;
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 任务类数据状态::内部不一致;
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 编码 || 读取.物理清理事实代次
            || 读取.物理清理墓碑 || !节点 || 节点->编码 != 编码)
            return 任务类数据状态::内部不一致;
        if (节点->退出事实代次) return 任务类数据状态::方法节点已退出;
        if (节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 == 0 || 节点->创建事实代次 > G0)
            return 任务类数据状态::方法节点不是普通节点;
        return std::nullopt;
    }

    任务类方法结果 查找当前方法关系(任务类记录身份 任务,
        稳定编码 方法, std::uint64_t G0) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 任务.值, 结构类型_.任务方法关系类型});
        if (读取.读取事实代次 != G0)
            return 方法失败(任务类数据状态::事实代次漂移,
                {任务类数据合同版本, G0, {}, 任务, 方法}, 读取.读取事实代次);
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 方法失败(映射L1读取状态(读取.状态),
                {任务类数据合同版本, G0, {}, 任务, 方法}, 读取.读取事实代次);
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.源节点 != 任务.值
            || 读取.关系类型节点 != 结构类型_.任务方法关系类型)
            return 方法失败(任务类数据状态::内部不一致,
                {任务类数据合同版本, G0, {}, 任务, 方法}, G0);
        std::optional<稳定编码> 找到;
        for (const auto& 关系 : 读取.关系组) {
            if (!关系有效(关系, 任务.值, 关系.目标节点,
                    结构类型_.任务方法关系类型, std::nullopt)
                || 关系.创建事实代次 > G0)
                return 方法失败(任务类数据状态::内部不一致,
                    {任务类数据合同版本, G0, {}, 任务, 方法}, G0);
            if (关系.目标节点 != 方法) continue;
            if (找到) return 方法失败(任务类数据状态::内部不一致,
                {任务类数据合同版本, G0, {}, 任务, 方法}, G0);
            找到 = 关系.编码;
        }
        if (!找到) return 方法失败(任务类数据状态::未找到,
            {任务类数据合同版本, G0, {}, 任务, 方法}, G0);
        return {任务类数据状态::已添加方法节点, 任务类数据合同版本,
            G0, 任务, 方法, 找到};
    }

    std::optional<任务类记录结果> 尝试基础重放(const 任务类新增请求& 请求,
        const L1所有者范围写集请求& 写集) const {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到) return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功)
            return 记录失败(映射L1读取状态(首次.状态), 首次.读取事实代次);
        if (!首次材料头完整(首次, 请求.幂等身份))
            return 记录失败(任务类数据状态::内部不一致, 首次.读取事实代次);
        if (*首次.首次规范化写集 != 写集)
            return 记录失败(任务类数据状态::幂等冲突, 首次.读取事实代次);
        if (!写入头完整(*首次.首次写入结果, 请求.幂等身份))
            return 记录失败(任务类数据状态::内部不一致, 首次.读取事实代次);
        return 从基础写入读回(*首次.首次写入结果, 请求,
            任务类数据状态::精确重复);
    }

    任务类记录结果 从基础写入读回(const L1所有者范围写入结果& 写入,
        const 任务类新增请求& 请求, 任务类数据状态 返回状态) const {
        using namespace 任务类数据内部;
        if (写入.新编码映射.size() != 3)
            return 记录失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                写入.事实代次);
        const auto 任务 = 查找唯一编码(写入, 任务本地键);
        const auto r2 = 查找唯一编码(写入, 所属存在关系本地键);
        const auto r3 = 查找唯一编码(写入, 来源需求关系本地键);
        if (!任务 || !r2 || !r3)
            return 记录失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                写入.事实代次);
        auto 读回 = 查询任务记录({任务类数据合同版本, 写入.事实代次,
            {*任务}, std::numeric_limits<std::uint64_t>::max()});
        if (!读回.成功() || !读回.记录
            || 读回.记录->所属存在 != 请求.所属存在
            || 读回.记录->来源需求 != 请求.来源需求
            || 读回.记录->所属存在关系 != *r2
            || 读回.记录->来源需求关系 != *r3
            || 读回.记录->创建事实代次 != 写入.事实代次)
            return 记录失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                写入.事实代次, 读回.来源需求状态);
        读回.状态 = 返回状态;
        return 读回;
    }

    任务类虚拟存在结果 从虚拟存在写入读回(
        const L1所有者范围写入结果& 写入,
        const 任务类虚拟存在初始化请求& 请求,
        任务类数据状态 返回状态) const {
        if (写入.新编码映射.size() != 2)
            return 虚拟存在失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                请求, 写入.事实代次);
        const auto 节点 = 任务类数据内部::查找唯一编码(
            写入, 任务类数据内部::虚拟存在节点本地键);
        const auto 关系 = 任务类数据内部::查找唯一编码(
            写入, 任务类数据内部::虚拟存在关系本地键);
        if (!节点 || !关系)
            return 虚拟存在失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                请求, 写入.事实代次);
        const auto 读取 = 存在服务_.查询任务虚拟存在(
            {任务虚拟存在专用合同版本, 写入.事实代次, 所有者_,
                请求.任务.值, 结构类型_.任务虚拟存在关系类型});
        if (!读取.成功() || !读取.投影
            || 读取.投影->虚拟存在节点 != *节点
            || 读取.投影->任务虚拟存在关系 != *关系)
            return 虚拟存在失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 映射提供者状态(读取.状态),
                请求, 写入.事实代次, 读取.状态);
        return {返回状态, 任务类数据合同版本, 写入.事实代次,
            读取.状态, 请求.任务, 读取.投影};
    }

    任务类方法结果 从方法写入读回(const L1所有者范围写入结果& 写入,
        const 任务类方法添加请求& 请求, 任务类数据状态 返回状态) const {
        if (写入.新编码映射.size() != 1)
            return 方法失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                请求, 写入.事实代次);
        const auto 关系 = 任务类数据内部::查找唯一编码(
            写入, 任务类数据内部::方法关系本地键);
        if (!关系)
            return 方法失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                请求, 写入.事实代次);
        const auto 读回 = 查找当前方法关系(请求.任务, 请求.方法节点,
            写入.事实代次);
        if (!读回.成功() || !读回.任务方法关系
            || *读回.任务方法关系 != *关系)
            return 方法失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : 任务类数据状态::内部不一致,
                请求, 写入.事实代次);
        if (const auto 状态 = 验证方法节点(请求.方法节点, 写入.事实代次))
            return 方法失败(写入.是否形成内存权威发布
                ? 任务类数据状态::已可能发布 : *状态,
                请求, 写入.事实代次);
        return {返回状态, 任务类数据合同版本, 写入.事实代次,
            请求.任务, 请求.方法节点, 关系};
    }

    bool 虚拟存在写集匹配(const L1所有者范围写集请求& 写集,
        const 任务类虚拟存在初始化请求& 请求) const noexcept {
        if (!任务虚拟存在写集完整(写集)
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份) return false;
        const auto& 关系 = 写集.关系.front();
        const auto* 源 = std::get_if<稳定编码>(&关系.源节点);
        const auto* 类型 = std::get_if<稳定编码>(&关系.关系类型节点);
        return 源 && *源 == 请求.任务.值
            && 类型 && *类型 == 结构类型_.任务虚拟存在关系类型;
    }

    bool 关系有效(const L1所有者范围关系事实& 关系, 稳定编码 源,
        稳定编码 目标, 稳定编码 类型,
        std::optional<std::uint64_t> 创建代次) const noexcept {
        return 有效(关系.编码) && 有效(源) && 有效(目标)
            && 关系.源节点 == 源 && 关系.目标节点 == 目标
            && 关系.关系类型节点 == 类型 && 关系.角色或顺序 == 0
            && 关系.写入所有者 == 所有者_ && 关系.创建事实代次 != 0
            && !关系.退出事实代次
            && (!创建代次 || 关系.创建事实代次 == *创建代次);
    }

    bool 首次材料头完整(const L1所有者范围首次写入读取结果& 首次,
        L1所有者范围写入幂等身份 幂等) const noexcept {
        return 首次.状态 == L1所有者范围读取状态::成功
            && 首次.合同版本 == L1所有者范围首次写入读取合同版本
            && 首次.所有者 == 所有者_ && 首次.写入幂等身份 == 幂等
            && 首次.首次规范化写集 && 首次.首次写入结果;
    }

    bool 写入头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等) const noexcept {
        const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_ && 写入.写入幂等身份 == 幂等
            && 写入.事实代次 != 0 && (首次 || 重复);
    }

    static 任务类数据状态 映射需求状态(需求类数据状态 状态) noexcept {
        switch (状态) {
        case 需求类数据状态::未找到: return 任务类数据状态::来源需求未找到;
        case 需求类数据状态::所属存在未找到: return 任务类数据状态::所属存在未找到;
        case 需求类数据状态::所属存在已退出: return 任务类数据状态::所属存在已退出;
        case 需求类数据状态::事实代次漂移: return 任务类数据状态::事实代次漂移;
        case 需求类数据状态::资源失败: return 任务类数据状态::资源失败;
        default: return 任务类数据状态::来源需求不可用;
        }
    }

    static 任务类数据状态 映射提供者状态(
        任务虚拟存在专用状态 状态) noexcept {
        switch (状态) {
        case 任务虚拟存在专用状态::未初始化:
            return 任务类数据状态::虚拟存在未初始化;
        case 任务虚拟存在专用状态::已初始化:
            return 任务类数据状态::虚拟存在已初始化;
        case 任务虚拟存在专用状态::事实代次漂移:
            return 任务类数据状态::事实代次漂移;
        case 任务虚拟存在专用状态::资源失败:
            return 任务类数据状态::资源失败;
        case 任务虚拟存在专用状态::入口拒绝:
            return 任务类数据状态::入口拒绝;
        default: return 任务类数据状态::内部不一致;
        }
    }

    static 任务类数据状态 映射L1读取状态(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::未找到: return 任务类数据状态::未找到;
        case L1所有者范围读取状态::事实代次漂移: return 任务类数据状态::事实代次漂移;
        case L1所有者范围读取状态::资源失败: return 任务类数据状态::资源失败;
        case L1所有者范围读取状态::入口拒绝: return 任务类数据状态::入口拒绝;
        default: return 任务类数据状态::内部不一致;
        }
    }

    static 任务类数据状态 映射一致读取状态(
        L1所有者范围一致当前读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围一致当前读取状态::事实代次漂移:
            return 任务类数据状态::事实代次漂移;
        case L1所有者范围一致当前读取状态::资源失败:
            return 任务类数据状态::资源失败;
        case L1所有者范围一致当前读取状态::入口拒绝:
            return 任务类数据状态::入口拒绝;
        default: return 任务类数据状态::内部不一致;
        }
    }

    static 任务类数据状态 映射写入状态(L1所有者范围写入状态 状态,
        任务类数据状态 首次成功) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功: return 首次成功;
        case L1所有者范围写入状态::精确重复: return 任务类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝: return 任务类数据状态::入口拒绝;
        case L1所有者范围写入状态::事实代次漂移: return 任务类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突: return 任务类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突: return 任务类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败: return 任务类数据状态::资源失败;
        default: return 任务类数据状态::内部不一致;
        }
    }

    static 任务类记录结果 记录失败(任务类数据状态 状态,
        std::uint64_t 事实代次 = 0,
        需求类数据状态 来源状态 = 需求类数据状态::入口拒绝) noexcept {
        return {状态, 任务类数据合同版本, 事实代次, 来源状态, std::nullopt};
    }

    static 任务类目标方向读取结果 方向失败(任务类数据状态 状态,
        const 任务类目标方向读取请求& 请求, std::uint64_t 事实代次 = 0,
        需求类数据状态 来源状态 = 需求类数据状态::入口拒绝,
        const 任务类记录* 记录 = nullptr) noexcept {
        return {状态, 任务类数据合同版本, 事实代次, 来源状态, 请求.任务,
            记录 ? 记录->所属存在 : 稳定编码{},
            记录 ? 记录->来源需求 : 需求类记录身份{}, 请求.当前事实特征,
            {}, {}, {}, std::nullopt};
    }

    static 任务类虚拟存在结果 虚拟存在失败(任务类数据状态 状态,
        const 任务类虚拟存在初始化请求& 请求, std::uint64_t 事实代次 = 0,
        任务虚拟存在专用状态 提供者状态 =
            任务虚拟存在专用状态::入口拒绝) noexcept {
        return {状态, 任务类数据合同版本, 事实代次, 提供者状态,
            请求.任务, std::nullopt};
    }

    static 任务类方法结果 方法失败(任务类数据状态 状态,
        const 任务类方法添加请求& 请求, std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 任务类数据合同版本, 事实代次,
            请求.任务, 请求.方法节点, std::nullopt};
    }

    static 任务类方法组结果 方法组失败(任务类数据状态 状态,
        const 任务类方法组读取请求& 请求, std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 任务类数据合同版本, 事实代次, 请求.任务, {}};
    }

    static bool 方法参数类别有效(方法参数类别 c) noexcept {
        return c == 方法参数类别::场景 || c == 方法参数类别::存在
            || c == 方法参数类别::特征;
    }

    static 方法参数规格类别 映射参数类别(方法参数类别 c) noexcept {
        switch (c) {
        case 方法参数类别::场景: return 方法参数规格类别::场景;
        case 方法参数类别::存在: return 方法参数规格类别::存在;
        case 方法参数类别::特征: return 方法参数规格类别::特征;
        }
        return 方法参数规格类别::场景;
    }

    static 方法参数类别 映射参数类别(方法参数规格类别 c) noexcept {
        switch (c) {
        case 方法参数规格类别::场景: return 方法参数类别::场景;
        case 方法参数规格类别::存在: return 方法参数类别::存在;
        case 方法参数规格类别::特征: return 方法参数类别::特征;
        }
        return 方法参数类别::场景;
    }

    任务方法实例参数规格结构类型 实例结构类型() const noexcept {
        return {结构类型_.任务虚拟存在关系类型,
            结构类型_.方法虚拟存在关系类型,
            结构类型_.方法场景参数关系类型,
            结构类型_.方法存在参数关系类型,
            结构类型_.方法特征参数关系类型,
            结构类型_.实例宿主关系类型,
            结构类型_.实例来源方法关系类型,
            结构类型_.实例来源虚拟存在关系类型,
            结构类型_.实例场景参数关系类型,
            结构类型_.实例存在参数关系类型,
            结构类型_.实例特征参数关系类型,
            结构类型_.实例场景参数数据关系类型,
            结构类型_.实例存在参数数据关系类型,
            结构类型_.实例特征参数数据关系类型};
    }

    任务类方法实例参数规格组结果 读取实例组(
        const 任务类方法实例参数规格组读取请求& r) const {
        return 读取任务方法实例参数规格组(r);
    }

    static const 任务方法实例参数规格投影* 查找实例(
        const 任务类方法实例参数规格组结果& r,
        方法类记录身份 m) noexcept {
        if (!r.成功()) return nullptr;
        const auto it = std::find_if(r.投影组.begin(), r.投影组.end(),
            [m](const auto& x) noexcept { return x.来源.方法节点 == m.值; });
        return it == r.投影组.end() ? nullptr : &*it;
    }

    bool 实例首次写集匹配(const L1所有者范围写集请求& w,
        const 任务类方法实例化请求& r,
        const 任务虚拟存在投影& tvm,
        const 任务方法实例参数规格来源& source) const noexcept {
        if (w.合同版本 != L1所有者范围CRUD合同版本
            || w.期望事实代次 != r.期望事实代次
            || w.写入幂等身份 != r.幂等身份 || w.节点.size() != 1
            || w.关系.size() != 3 + source.参数规格组.size()
            || !w.值.empty() || !w.属性槽变更.empty() || !w.退出事实.empty()) return false;
        const auto& n = w.节点.front();
        if (n.本地键 != 任务类数据内部::实例节点本地键
            || n.种类 != 节点种类::普通 || n.属性类型表示) return false;
        const auto match = [](const auto& rel, L1所有者范围写集本地键 key,
            const auto& src, const auto& dst, 稳定编码 type,
            std::uint64_t role) noexcept {
            return rel == L1所有者范围关系新建项{key, src, dst, type,
                static_cast<std::int64_t>(role)};
        };
        if (!match(w.关系[0], {2}, tvm.虚拟存在节点,
                L1所有者范围写集本地键{1}, 结构类型_.实例宿主关系类型, 0)
            || !match(w.关系[1], {3}, L1所有者范围写集本地键{1},
                source.方法节点, 结构类型_.实例来源方法关系类型, 0)
            || !match(w.关系[2], {4}, L1所有者范围写集本地键{1},
                source.方法虚拟存在节点,
                结构类型_.实例来源虚拟存在关系类型, 0)) return false;
        for (std::size_t i = 0; i < source.参数规格组.size(); ++i) {
            const auto& p = source.参数规格组[i];
            稳定编码 type{};
            switch (p.类别) {
            case 方法参数规格类别::场景: type = 结构类型_.实例场景参数关系类型; break;
            case 方法参数规格类别::存在: type = 结构类型_.实例存在参数关系类型; break;
            case 方法参数规格类别::特征: type = 结构类型_.实例特征参数关系类型; break;
            }
            if (!match(w.关系[3 + i], {static_cast<std::uint32_t>(5 + i)},
                    L1所有者范围写集本地键{1},
                    p.参数特征类型, type, p.顺序)) return false;
        }
        return true;
    }

    bool 绑定首次写集匹配(const L1所有者范围写集请求& w,
        const 任务类实例参数绑定请求& r, 稳定编码 instance) const noexcept {
        if (w.合同版本 != L1所有者范围CRUD合同版本
            || w.期望事实代次 != r.期望事实代次
            || w.写入幂等身份 != r.幂等身份 || !w.节点.empty()
            || w.关系.size() != 1 || !w.值.empty() || !w.属性槽变更.empty()
            || !w.退出事实.empty()) return false;
        稳定编码 type{};
        switch (r.类别) {
        case 方法参数类别::场景: type = 结构类型_.实例场景参数数据关系类型; break;
        case 方法参数类别::存在: type = 结构类型_.实例存在参数数据关系类型; break;
        case 方法参数类别::特征: type = 结构类型_.实例特征参数数据关系类型; break;
        }
        const auto& rel = w.关系.front();
        return rel == L1所有者范围关系新建项{{1}, instance, r.特征节点,
            type, static_cast<std::int64_t>(r.顺序)};
    }

    static 任务类数据状态 映射实例提供者状态(
        任务方法实例参数规格专用状态 s) noexcept {
        switch (s) {
        case 任务方法实例参数规格专用状态::已实例化:
            return 任务类数据状态::实例已存在;
        case 任务方法实例参数规格专用状态::未实例化:
            return 任务类数据状态::实例未找到;
        case 任务方法实例参数规格专用状态::方法虚拟存在未初始化:
            return 任务类数据状态::方法虚拟存在未初始化;
        case 任务方法实例参数规格专用状态::数量预算不足:
            return 任务类数据状态::实例数量预算不足;
        case 任务方法实例参数规格专用状态::事实代次漂移:
            return 任务类数据状态::事实代次漂移;
        case 任务方法实例参数规格专用状态::资源失败:
            return 任务类数据状态::资源失败;
        case 任务方法实例参数规格专用状态::入口拒绝:
            return 任务类数据状态::入口拒绝;
        default: return 任务类数据状态::实例规格失败;
        }
    }

    static 任务类数据状态 映射绑定提供者状态(
        任务方法实例参数规格专用状态 s) noexcept {
        switch (s) {
        case 任务方法实例参数规格专用状态::已实例化:
            return 任务类数据状态::参数槽已绑定;
        case 任务方法实例参数规格专用状态::未实例化:
            return 任务类数据状态::实例未找到;
        case 任务方法实例参数规格专用状态::结构冲突:
            return 任务类数据状态::参数绑定冲突;
        default: return 映射实例提供者状态(s);
        }
    }

    static 任务类数据状态 映射参数特征状态(特征类数据状态 s) noexcept {
        switch (s) {
        case 特征类数据状态::未找到: return 任务类数据状态::参数特征未找到;
        case 特征类数据状态::目标已退出: return 任务类数据状态::参数特征已退出;
        case 特征类数据状态::事实代次漂移: return 任务类数据状态::事实代次漂移;
        case 特征类数据状态::资源失败: return 任务类数据状态::资源失败;
        default: return 任务类数据状态::参数特征读取失败;
        }
    }

    static 任务类方法实例结果 实例失败(任务类数据状态 s,
        const 任务类方法实例化请求& r, std::uint64_t g = 0,
        任务方法实例参数规格专用状态 ps =
            任务方法实例参数规格专用状态::入口拒绝) noexcept {
        return {s, 任务类数据合同版本, g, ps, r.任务, r.方法, std::nullopt};
    }

    static 任务类方法实例参数规格组结果 实例组失败(任务类数据状态 s,
        const 任务类方法实例参数规格组读取请求& r, std::uint64_t g = 0,
        任务方法实例参数规格专用状态 ps =
            任务方法实例参数规格专用状态::入口拒绝) noexcept {
        return {s, 任务类数据合同版本, g, ps, r.任务, {}};
    }

    static 任务类实例参数绑定结果 绑定失败(任务类数据状态 s,
        const 任务类实例参数绑定请求& r, std::uint64_t g = 0,
        任务方法实例参数规格专用状态 ps =
            任务方法实例参数规格专用状态::入口拒绝,
        std::optional<任务实例参数规格关系项> slot = std::nullopt) noexcept {
        return {s, 任务类数据合同版本, g, ps, r.任务, r.方法, slot};
    }

    static 任务类可执行参数组结果 可执行组失败(任务类数据状态 s,
        const 任务类可执行参数组读取请求& r,
        std::uint64_t g = 0) noexcept {
        return {s, 任务类数据合同版本, g, r.任务, r.方法, {}};
    }

    const L1事实基座服务& 第一层服务_;
    const 需求类数据服务& 需求服务_;
    const 存在类数据服务& 存在服务_;
    const 方法类数据服务& 方法服务_;
    const 特征类数据服务& 特征服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    任务类结构类型 结构类型_{};
};

} // namespace 海中鱼巣
