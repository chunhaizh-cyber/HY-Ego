        const 任务类精确查询请求&) = default;
};

struct 任务类记录结果 final {
    任务类数据状态 状态 = 任务类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 任务类数据合同版本;
    std::uint64_t 事实代次 = 0;
    需求类数据状态 来源需求状态 = 需求类数据状态::入口拒绝;
    std::optional<任务类记录> 记录;
    bool 成功() const noexcept {
        if (状态 != 任务类数据状态::已创建
            && 状态 != 任务类数据状态::精确重复
            && 状态 != 任务类数据状态::已读取) return false;
        if (合同版本 != 任务类数据合同版本 || 事实代次 == 0
            || 来源需求状态 != 需求类数据状态::已读取 || !记录
            || !有效(记录->身份.值) || !有效(记录->所属存在)
            || !有效(记录->来源需求.值) || !有效(记录->所属存在关系)
            || !有效(记录->来源需求关系) || 记录->创建事实代次 == 0
            || 记录->创建事实代次 > 事实代次)
            return false;
        if (记录->虚拟存在
            && (记录->虚拟存在->任务节点 != 记录->身份.值
                || !有效(记录->虚拟存在->虚拟存在节点)
                || !有效(记录->虚拟存在->任务虚拟存在关系)
                || 记录->虚拟存在->创建事实代次 == 0
                || 记录->虚拟存在->创建事实代次 > 事实代次)) return false;
        return std::all_of(记录->方法节点组.begin(),
            记录->方法节点组.end(), [](稳定编码 编码) noexcept {
                return 有效(编码);
            }) && std::is_sorted(记录->方法节点组.begin(),
                记录->方法节点组.end())
            && std::adjacent_find(记录->方法节点组.begin(),
                记录->方法节点组.end()) == 记录->方法节点组.end();
    }
    friend bool operator==(const 任务类记录结果&,
        const 任务类记录结果&) = default;
};

struct 任务类目标方向读取请求 final {
    std::uint32_t 合同版本 = 任务类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    std::uint64_t 请求身份 = 0;
    任务类记录身份 任务;
    稳定编码 当前事实特征{};
    std::uint8_t 要求结果位 = 0;
    friend bool operator==(const 任务类目标方向读取请求&,
        const 任务类目标方向读取请求&) = default;
};

struct 任务类目标方向读取结果 final {
    任务类数据状态 状态 = 任务类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 任务类数据合同版本;
    std::uint64_t 事实代次 = 0;
    需求类数据状态 来源需求状态 = 需求类数据状态::入口拒绝;
    任务类记录身份 任务;
    稳定编码 所属存在{};
    需求类记录身份 来源需求;
    稳定编码 当前事实特征{};
    稳定编码 目标宿主{};
    稳定编码 静态目标特征{};
    特征类定义身份 方向二次特征;
    std::optional<特征类比较结果> 比较;
    bool 成功() const noexcept {
        return 状态 == 任务类数据状态::已读取目标方向
            && 合同版本 == 任务类数据合同版本 && 事实代次 != 0
            && 来源需求状态 == 需求类数据状态::已计算
            && 有效(任务.值) && 有效(所属存在) && 有效(来源需求.值)
            && 有效(当前事实特征) && 有效(目标宿主)
            && 有效(静态目标特征) && 有效(方向二次特征.值)
            && 比较 && 比较->成功() && 比较->事实代次 == 事实代次;
    }
    friend bool operator==(const 任务类目标方向读取结果&,
        const 任务类目标方向读取结果&) = default;
};

struct 任务类虚拟存在初始化请求 final {
    std::uint32_t 合同版本 = 任务类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    任务类记录身份 任务;
    friend bool operator==(const 任务类虚拟存在初始化请求&,
        const 任务类虚拟存在初始化请求&) = default;
};

struct 任务类虚拟存在结果 final {
    任务类数据状态 状态 = 任务类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 任务类数据合同版本;
    std::uint64_t 事实代次 = 0;
    任务虚拟存在专用状态 提供者状态 = 任务虚拟存在专用状态::入口拒绝;
    任务类记录身份 任务;
    std::optional<任务虚拟存在投影> 虚拟存在;
    bool 成功() const noexcept {
        return (状态 == 任务类数据状态::已初始化虚拟存在
                || 状态 == 任务类数据状态::精确重复
                || 状态 == 任务类数据状态::虚拟存在已初始化)
            && 合同版本 == 任务类数据合同版本 && 事实代次 != 0
            && 提供者状态 == 任务虚拟存在专用状态::已读取
            && 有效(任务.值) && 虚拟存在
            && 虚拟存在->任务节点 == 任务.值
            && 有效(虚拟存在->虚拟存在节点)
            && 有效(虚拟存在->任务虚拟存在关系)
            && 虚拟存在->创建事实代次 != 0
            && 虚拟存在->创建事实代次 <= 事实代次;
    }
    friend bool operator==(const 任务类虚拟存在结果&,
        const 任务类虚拟存在结果&) = default;
};

