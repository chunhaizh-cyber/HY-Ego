inline constexpr L1所有者范围写集本地键 任务本地键{1};
inline constexpr L1所有者范围写集本地键 所属存在关系本地键{2};
inline constexpr L1所有者范围写集本地键 来源需求关系本地键{3};
inline constexpr L1所有者范围写集本地键 方法关系本地键{1};
inline constexpr L1所有者范围写集本地键 虚拟存在节点本地键{1};
inline constexpr L1所有者范围写集本地键 虚拟存在关系本地键{2};
inline constexpr L1所有者范围写集本地键 实例节点本地键{1};

std::optional<稳定编码> 查找唯一编码(const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键 != 本地键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

} // namespace 海中鱼巣::任务类数据内部

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 任务类数据合同版本 = 3;

enum class 任务类数据状态 : std::uint8_t {
    已创建=1, 精确重复=2, 已读取=3, 已读取目标方向=4,
    入口拒绝=5, 未找到=6, 所属存在未找到=7, 所属存在已退出=8,
    来源需求未找到=9, 来源需求不属于存在=10, 来源需求不可用=11,
    精确记录已存在=12, 数量预算不足=13, 事实代次漂移=14,
    幂等冲突=15, 引用冲突=16, 资源失败=17, 内部不一致=18,
    已可能发布=19, 已初始化虚拟存在=20, 已添加方法节点=21,
    已读取方法节点组=22, 虚拟存在已初始化=23, 虚拟存在未初始化=24,
    虚拟存在规格失败=25, 方法节点未找到=26, 方法节点已退出=27,
    方法节点不是普通节点=28, 方法节点已存在=29,
    方法节点数量预算不足=30, 提供者不兼容=31,
    已实例化方法虚拟存在=32, 已读取方法实例参数规格组=33,
    方法未登记到任务=34, 方法读取失败=35, 方法虚拟存在未初始化=36,
    方法参数规格读取失败=37, 方法材料漂移=38, 实例已存在=39,
    实例规格失败=40, 实例数量预算不足=41, 实例提供者不兼容=42,
    已绑定实例参数=43, 已读取可执行参数组=44, 实例未找到=45,
    参数槽未找到=46, 参数槽未绑定=47, 参数槽已绑定=48,
    参数绑定冲突=49, 参数特征未找到=50, 参数特征已退出=51,
    参数特征类型不匹配=52, 参数特征读取失败=53
};

