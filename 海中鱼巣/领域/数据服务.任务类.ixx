    需求类记录身份 来源需求;
    稳定编码 所属存在关系{};
    稳定编码 来源需求关系{};
    std::optional<任务虚拟存在投影> 虚拟存在;
    std::vector<稳定编码> 方法节点组;
    std::uint64_t 创建事实代次 = 0;
    friend bool operator==(const 任务类记录&, const 任务类记录&) = default;
};

