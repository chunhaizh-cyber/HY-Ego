    稳定编码 所属存在关系类型{};
    稳定编码 来源需求关系类型{};
    稳定编码 任务虚拟存在关系类型{};
    稳定编码 任务方法关系类型{};
    稳定编码 实例宿主关系类型{};
    稳定编码 实例来源方法关系类型{};
    稳定编码 实例来源虚拟存在关系类型{};
    稳定编码 实例场景参数关系类型{};
    稳定编码 实例存在参数关系类型{};
    稳定编码 实例特征参数关系类型{};
    稳定编码 实例场景参数数据关系类型{};
    稳定编码 实例存在参数数据关系类型{};
    稳定编码 实例特征参数数据关系类型{};
    稳定编码 方法虚拟存在关系类型{};
    稳定编码 方法场景参数关系类型{};
    稳定编码 方法存在参数关系类型{};
    稳定编码 方法特征参数关系类型{};
    friend bool operator==(const 任务类结构类型&,
        const 任务类结构类型&) = default;
};

