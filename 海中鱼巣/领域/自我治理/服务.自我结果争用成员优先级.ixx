module;

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

#define SELF_RESULT_CONTENTION_PRIORITY_NO_INCLUDES

export module 海中鱼巣.领域.自我治理.服务.自我结果争用成员优先级;

export import 海中鱼巣.领域.服务.L2自我治理结构;

export {
#include "自我结果争用成员优先级.数据.h"
}

export namespace 海中鱼巣 {

class 自我结果争用成员优先级提供者 final {
public:
    explicit 自我结果争用成员优先级提供者(
        L2自我治理结构服务& 结构服务) noexcept
        : 结构服务_(结构服务) {}

    自我结果争用优先级结果 裁决并发布自我结果争用成员优先级(
        const 自我结果争用成员优先级请求& 请求) noexcept {
        const auto 验证 = 验证请求(请求);
        if (验证) return {*验证};
        try {
            auto 候选组 = 请求.候选组;
            std::sort(候选组.begin(), 候选组.end(), [](const auto& 左, const auto& 右) {
                return 左.消费资格.成员.关系稳定编码.值
                    < 右.消费资格.成员.关系稳定编码.值;
            });

            L2自我结果争用优先级完整事实 候选;
            候选.批次.自我 = 请求.自我;
            候选.批次.任务 = 请求.任务;
            候选.批次.任务轮次 = 请求.任务轮次;
            候选.批次.正式结果 = 请求.正式结果;
            候选.批次.冻结成员集合版本 = 请求.冻结成员集合版本;
            候选.批次.容量合同 = 请求.容量合同;
            候选.批次.来源规则身份 = 请求.来源规则身份;
            候选.批次.关系规则版本 = 请求.关系规则版本;
            候选.批次.优先级规则版本 = 请求.优先级规则版本;
            候选.批次.同级规则版本 = 请求.同级规则版本;
            候选.批次.来源共同事实截止 = 请求.来源共同事实截止;
            候选.成员事实组.reserve(候选组.size());
            for (const auto& 项 : 候选组) {
                自我结果争用成员优先级事实 成员;
                成员.消费资格 = 项.消费资格;
                成员.优先级序号 = 项.优先级序号;
                成员.同级顺序序号 = 项.同级顺序序号;
                成员.理由证据组 = 项.理由证据组;
                候选.成员事实组.push_back(std::move(成员));
            }

            const auto 提交 = 结构服务_.提交自我治理结构事实(
                {请求.请求头, 请求.幂等身份,
                    L2自我治理结构事实种类::结果争用优先级批次,
                    std::move(候选)});
            自我结果争用优先级结果 结果;
            结果.状态 = 映射提交状态(提交);
            结果.提交见证 = 提交.提交见证;
            结果.本次正式读回截止 = 提交.本次正式读回截止;
            if (结果.状态 != 自我结果争用优先级状态::已形成
                && 结果.状态 != 自我结果争用优先级状态::精确重复)
                return 结果;
            const auto* 完整 = 提交.事实
                ? std::get_if<L2自我结果争用优先级完整事实>(&*提交.事实)
                : nullptr;
            if (!完整 || !完整事实绑定请求(
                    *完整, 请求, 结果.本次正式读回截止))
                return {自我结果争用优先级状态::内部错误};
            结果.批次 = 完整->批次;
            结果.成员事实组 = 完整->成员事实组;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {自我结果争用优先级状态::资源失败};
        } catch (const std::length_error&) {
            return {自我结果争用优先级状态::资源失败};
        } catch (...) {
            return {自我结果争用优先级状态::内部错误};
        }
    }

    自我结果争用优先级读取结果 读取自我结果争用成员优先级(
        const 自我结果争用优先级读取请求& 请求) const noexcept {
        if (请求.合同版本 != 1 || !有效(请求.自我.值)
            || !有效(请求.正式结果.值) || !有效(请求.批次.值)
            || 请求.非零读取截止 == 0)
            return {自我结果争用优先级状态::入口拒绝};
        try {
            const auto 读取 = 结构服务_.读取自我治理结构事实(
                {请求.合同版本, 请求.自我,
                    L2自我治理结构事实种类::结果争用优先级批次,
                    请求.批次.值, 请求.非零读取截止});
            自我结果争用优先级读取结果 结果;
            结果.状态 = 映射读取状态(读取.结果头.状态);
            结果.本次正式读回截止 = 读取.本次正式读回截止;
            if (结果.状态 != 自我结果争用优先级状态::已形成)
                return 结果;
            const auto* 完整 = 读取.事实
                ? std::get_if<L2自我结果争用优先级完整事实>(&*读取.事实)
                : nullptr;
            if (!完整 || !完整事实自洽(*完整, 结果.本次正式读回截止)
                || 完整->批次.身份 != 请求.批次
                || 完整->批次.自我 != 请求.自我
                || 完整->批次.正式结果 != 请求.正式结果)
                return {自我结果争用优先级状态::内部错误};
            结果.批次 = 完整->批次;
            结果.成员事实组 = 完整->成员事实组;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {自我结果争用优先级状态::资源失败};
        } catch (...) {
            return {自我结果争用优先级状态::内部错误};
        }
    }

private:
    static std::optional<自我结果争用优先级状态> 验证请求(
        const 自我结果争用成员优先级请求& 请求) noexcept {
        if (请求.合同版本 != 1 || !L2结构请求头合同有效(请求.请求头)
            || !L2结构幂等身份有效(请求.幂等身份)
            || !有效(请求.自我.值) || !有效(请求.任务.值)
            || !有效(请求.任务轮次.值) || !有效(请求.正式结果.值)
            || 请求.冻结成员集合版本 == 0
            || !L2任务结果消费容量合同有效(请求.容量合同)
            || 请求.容量合同.消费形态 == L2任务结果消费形态::可重复引用
            || 请求.候选组.empty() || !有效(请求.来源规则身份)
            || 请求.关系规则版本 == 0 || 请求.优先级规则版本 == 0
            || 请求.同级规则版本 == 0 || 请求.来源共同事实截止 == 0
            || 请求.请求头.期望事实代次 != 请求.来源共同事实截止)
            return 自我结果争用优先级状态::入口拒绝;

        for (std::size_t i = 0; i < 请求.候选组.size(); ++i) {
            const auto& 候选 = 请求.候选组[i];
            if (!L2成员消费资格材料有效(候选.消费资格)
                || 候选.消费资格.成员.任务 != 请求.任务)
                return 自我结果争用优先级状态::成员漂移;
            if (候选.优先级序号 == 0 || 候选.同级顺序序号 == 0)
                return 自我结果争用优先级状态::入口拒绝;
            if (候选.理由证据组.empty()
                || std::any_of(候选.理由证据组.begin(), 候选.理由证据组.end(),
                    [](稳定编码 证据) { return !有效(证据); }))
                return 自我结果争用优先级状态::证据不足;
            for (std::size_t j = 0; j < i; ++j) {
                const auto& 已有 = 请求.候选组[j];
                if (已有.消费资格.成员.关系稳定编码
                    == 候选.消费资格.成员.关系稳定编码)
                    return 自我结果争用优先级状态::成员漂移;
                if (已有.优先级序号 == 候选.优先级序号
                    && 已有.同级顺序序号 == 候选.同级顺序序号)
                    return 自我结果争用优先级状态::成员漂移;
            }
        }
        return std::nullopt;
    }

    static bool 完整事实自洽(const L2自我结果争用优先级完整事实& 完整,
        std::uint64_t 读取截止) noexcept {
        if (读取截止 == 0 || !有效(完整.批次.身份.值)
            || !L2生命周期完整(完整.批次.生命周期)
            || 完整.批次.生命周期.创建事实代次 > 读取截止
            || 完整.批次.生命周期.退出事实代次
            || 完整.批次.来源共同事实截止 == 0
            || 完整.批次.来源共同事实截止 > 读取截止
            || 完整.成员事实组.empty()
            || 完整.批次.成员优先级.size() != 完整.成员事实组.size())
            return false;
        for (std::size_t i = 0; i < 完整.成员事实组.size(); ++i) {
            const auto& 成员 = 完整.成员事实组[i];
            if (!有效(成员.身份.值) || 成员.批次 != 完整.批次.身份
                || 完整.批次.成员优先级[i] != 成员.身份
                || !L2生命周期完整(成员.生命周期)
                || 成员.生命周期.创建事实代次
                    != 完整.批次.生命周期.创建事实代次
                || 成员.生命周期.创建事实代次 > 读取截止
                || 成员.生命周期.退出事实代次)
                return false;
            for (std::size_t j = 0; j < i; ++j)
                if (完整.成员事实组[j].身份 == 成员.身份)
                    return false;
        }
        return true;
    }

    static bool 完整事实绑定请求(const L2自我结果争用优先级完整事实& 完整,
        const 自我结果争用成员优先级请求& 请求,
        std::uint64_t 读取截止) noexcept {
        if (!完整事实自洽(完整, 读取截止)
            || 完整.批次.自我 != 请求.自我
            || 完整.批次.任务 != 请求.任务 || 完整.批次.任务轮次 != 请求.任务轮次
            || 完整.批次.正式结果 != 请求.正式结果
            || 完整.批次.冻结成员集合版本 != 请求.冻结成员集合版本
            || 完整.批次.容量合同 != 请求.容量合同
            || 完整.批次.来源规则身份 != 请求.来源规则身份
            || 完整.批次.关系规则版本 != 请求.关系规则版本
            || 完整.批次.优先级规则版本 != 请求.优先级规则版本
            || 完整.批次.同级规则版本 != 请求.同级规则版本
            || 完整.批次.来源共同事实截止 != 请求.来源共同事实截止
            || 完整.成员事实组.size() != 请求.候选组.size())
            return false;
        for (const auto& 事实 : 完整.成员事实组) {
            if (!有效(事实.身份.值) || 事实.批次 != 完整.批次.身份
                || std::count_if(请求.候选组.begin(), 请求.候选组.end(),
                    [&](const auto& 候选) {
                        return 候选.消费资格 == 事实.消费资格
                            && 候选.优先级序号 == 事实.优先级序号
                            && 候选.同级顺序序号 == 事实.同级顺序序号
                            && 候选.理由证据组 == 事实.理由证据组;
                    }) != 1)
                return false;
        }
        return true;
    }

    static 自我结果争用优先级状态 映射提交状态(
        const L2自我治理结构提交结果& 结果) noexcept {
        if (结果.提交见证) return 自我结果争用优先级状态::已可能发布;
        switch (结果.结果头.状态) {
        case L2结构状态::已提交: return 自我结果争用优先级状态::已形成;
        case L2结构状态::精确重复: return 自我结果争用优先级状态::精确重复;
        case L2结构状态::入口拒绝: return 自我结果争用优先级状态::入口拒绝;
        case L2结构状态::许可拒绝: return 自我结果争用优先级状态::许可拒绝;
        case L2结构状态::事实代次漂移: return 自我结果争用优先级状态::当前性漂移;
        case L2结构状态::幂等冲突: return 自我结果争用优先级状态::幂等冲突;
        case L2结构状态::资源失败:
        case L2结构状态::数量预算不足: return 自我结果争用优先级状态::资源失败;
        default: return 自我结果争用优先级状态::内部错误;
        }
    }

    static 自我结果争用优先级状态 映射读取状态(L2结构状态 状态) noexcept {
        switch (状态) {
        case L2结构状态::已读取: return 自我结果争用优先级状态::已形成;
        case L2结构状态::未找到: return 自我结果争用优先级状态::未找到;
        case L2结构状态::入口拒绝: return 自我结果争用优先级状态::入口拒绝;
        case L2结构状态::许可拒绝: return 自我结果争用优先级状态::许可拒绝;
        case L2结构状态::事实代次漂移: return 自我结果争用优先级状态::当前性漂移;
        case L2结构状态::资源失败: return 自我结果争用优先级状态::资源失败;
        default: return 自我结果争用优先级状态::内部错误;
        }
    }

    L2自我治理结构服务& 结构服务_;
};

} // namespace 海中鱼巣
