module;

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <variant>
#include <vector>

#define SELF_REALITY_EXECUTION_AUTHORIZATION_NO_INCLUDES

export module 海中鱼巣.领域.自我治理.服务.自我现实执行授权;

export import 海中鱼巣.领域.服务.L2自我治理结构;

export {
#include "自我现实执行授权.数据.h"
}

export namespace 海中鱼巣 {

class 自我现实执行授权提供者 final {
public:
    explicit 自我现实执行授权提供者(
        L2自我治理结构服务& 结构服务) noexcept
        : 结构服务_(结构服务) {}

    自我现实执行授权结果 发布或读取自我现实执行授权(
        const 自我现实执行授权请求& 请求) noexcept {
        if (!请求有效(请求)) return {自我现实执行授权状态::拒绝};
        if (!包含现实改变(请求.有序冻结动作范围))
            return {自我现实执行授权状态::无需授权};
        try {
            L2自我现实执行授权事实 候选;
            候选.自我 = 请求.自我;
            候选.任务 = 请求.任务;
            候选.任务轮次 = 请求.任务轮次;
            候选.筹办轮次 = 请求.筹办轮次;
            候选.执行轮次 = 请求.执行轮次;
            候选.冻结 = 请求.冻结;
            候选.冻结版本 = 请求.冻结版本;
            候选.实例方法 = 请求.实例方法;
            候选.方法 = 请求.方法;
            候选.方法内容版本 = 请求.方法内容版本;
            候选.有序冻结动作范围 = 请求.有序冻结动作范围;
            候选.来源共同事实截止 = 请求.来源共同事实截止;
            候选.授权规则版本 = 请求.授权规则版本;
            候选.发生时间 = 请求.发生时间;
            候选.有效截止时间 = 请求.有效截止时间;

            const auto 提交 = 结构服务_.提交自我治理结构事实(
                {请求.请求头, 请求.幂等身份,
                    L2自我治理结构事实种类::现实执行授权, 候选});
            自我现实执行授权结果 结果;
            结果.状态 = 映射提交状态(提交);
            结果.提交见证 = 提交.提交见证;
            结果.本次正式读回截止 = 提交.本次正式读回截止;
            if (结果.状态 != 自我现实执行授权状态::已授权
                && 结果.状态 != 自我现实执行授权状态::精确重复)
                return 结果;
            const auto* 授权 = 提交.事实
                ? std::get_if<L2自我现实执行授权事实>(&*提交.事实) : nullptr;
            if (!授权 || !授权绑定请求(*授权, 请求))
                return {自我现实执行授权状态::内部错误};
            结果.授权 = *授权;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {自我现实执行授权状态::资源失败};
        } catch (const std::length_error&) {
            return {自我现实执行授权状态::资源失败};
        } catch (...) {
            return {自我现实执行授权状态::内部错误};
        }
    }

    自我现实执行授权读取结果 读取自我现实执行授权(
        const 自我现实执行授权读取请求& 请求) const noexcept {
        if (!读取请求有效(请求)) return {自我现实执行授权状态::拒绝};
        try {
            const auto 读取 = 结构服务_.读取自我治理结构事实(
                {请求.合同版本, 请求.自我,
                    L2自我治理结构事实种类::现实执行授权,
                    请求.授权.值, 请求.非零读取截止});
            自我现实执行授权读取结果 结果;
            结果.状态 = 映射读取状态(读取.结果头.状态);
            结果.本次正式读回截止 = 读取.本次正式读回截止;
            if (结果.状态 != 自我现实执行授权状态::已授权)
                return 结果;
            const auto* 授权 = 读取.事实
                ? std::get_if<L2自我现实执行授权事实>(&*读取.事实) : nullptr;
            if (!授权 || 授权->身份 != 请求.授权 || 授权->自我 != 请求.自我
                || 授权->任务 != 请求.任务 || 授权->任务轮次 != 请求.任务轮次
                || 授权->执行轮次 != 请求.执行轮次)
                return {自我现实执行授权状态::内部错误};
            结果.授权 = *授权;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {自我现实执行授权状态::资源失败};
        } catch (...) {
            return {自我现实执行授权状态::内部错误};
        }
    }

    自我现实执行授权收口结果 收口自我现实执行授权(
        const 自我现实执行授权收口请求& 请求) noexcept {
        if (!收口请求有效(请求)) return {自我现实执行授权状态::拒绝};
        const auto 授权读取 = 读取自我现实执行授权(
            {请求.合同版本, 请求.自我, 请求.任务, 请求.任务轮次,
                请求.执行轮次, 请求.授权, 请求.来源共同事实截止});
        if (!授权读取.成功() || !授权读取.授权) {
            自我现实执行授权收口结果 失败;
            失败.状态 = 授权读取.状态;
            return 失败;
        }
        try {
            L2自我现实执行授权收口事实 候选;
            候选.授权 = 请求.授权;
            候选.任务 = 请求.任务;
            候选.任务轮次 = 请求.任务轮次;
            候选.执行轮次 = 请求.执行轮次;
            候选.种类 = 请求.种类;
            候选.发生时间 = 请求.发生时间;
            候选.收口规则版本 = 请求.收口规则版本;
            const auto 提交 = 结构服务_.提交自我治理结构事实(
                {请求.请求头, 请求.幂等身份,
                    L2自我治理结构事实种类::现实执行授权收口, 候选});
            自我现实执行授权收口结果 结果;
            结果.状态 = 映射收口提交状态(提交, 请求.种类);
            结果.提交见证 = 提交.提交见证;
            结果.本次正式读回截止 = 提交.本次正式读回截止;
            if (结果.状态 != 自我现实执行授权状态::精确重复
                && 结果.状态 != 自我现实执行授权状态::已消费
                && 结果.状态 != 自我现实执行授权状态::已撤回
                && 结果.状态 != 自我现实执行授权状态::已失效)
                return 结果;
            const auto* 收口 = 提交.事实
                ? std::get_if<L2自我现实执行授权收口事实>(&*提交.事实) : nullptr;
            if (!收口 || 收口->授权 != 请求.授权 || 收口->任务 != 请求.任务
                || 收口->任务轮次 != 请求.任务轮次
                || 收口->执行轮次 != 请求.执行轮次 || 收口->种类 != 请求.种类)
                return {自我现实执行授权状态::内部错误};
            结果.授权 = *授权读取.授权;
            结果.收口 = *收口;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {自我现实执行授权状态::资源失败};
        } catch (const std::length_error&) {
            return {自我现实执行授权状态::资源失败};
        } catch (...) {
            return {自我现实执行授权状态::内部错误};
        }
    }

private:
    static bool 动作范围有效(const std::vector<任务冻结动作项>& 动作组) noexcept {
        if (动作组.empty()) return false;
        for (std::size_t i = 0; i < 动作组.size(); ++i) {
            const auto& 动作 = 动作组[i];
            if (动作.顺序 != i + 1 || !有效(动作.动作入口.值)
                || !L2方法稳定动作键有效(动作.稳定动作键)
                || !有效(动作.作用主体.值) || !有效(动作.动作范围材料)
                || !有效(动作.预期结果材料)
                || !有效(动作.结果验证合同)
                || !有效(动作.动作归因合同)
                || (动作.作用场景 && !有效(动作.作用场景->值))
                || (动作.作用范围 != 任务动作作用范围::内部治理
                    && 动作.作用范围 != 任务动作作用范围::纯现实观察
                    && 动作.作用范围 != 任务动作作用范围::现实改变))
                return false;
        }
        return true;
    }

    static bool 包含现实改变(const std::vector<任务冻结动作项>& 动作组) noexcept {
        return std::any_of(动作组.begin(), 动作组.end(), [](const auto& 动作) {
            return 动作.作用范围 == 任务动作作用范围::现实改变;
        });
    }

    static bool 请求有效(const 自我现实执行授权请求& 请求) noexcept {
        return 请求.合同版本 == 自我现实执行授权合同版本
            && L2结构请求头合同有效(请求.请求头)
            && L2结构幂等身份有效(请求.幂等身份)
            && 有效(请求.自我.值) && 有效(请求.任务.值)
            && 有效(请求.任务轮次.值) && 有效(请求.筹办轮次.值)
            && 有效(请求.执行轮次.值) && 有效(请求.冻结.值)
            && 请求.冻结版本 != 0 && 有效(请求.实例方法.值)
            && 有效(请求.方法.值) && 有效(请求.方法内容版本)
            && 动作范围有效(请求.有序冻结动作范围)
            && 请求.来源共同事实截止 != 0
            && 请求.请求头.期望事实代次 == 请求.来源共同事实截止
            && 请求.授权规则版本 == 自我现实执行授权规则版本
            && 请求.发生时间 != 0 && 请求.有效截止时间 >= 请求.发生时间;
    }

    static bool 读取请求有效(const 自我现实执行授权读取请求& 请求) noexcept {
        return 请求.合同版本 == 自我现实执行授权合同版本
            && 有效(请求.自我.值) && 有效(请求.任务.值)
            && 有效(请求.任务轮次.值) && 有效(请求.执行轮次.值)
            && 请求.授权.有效() && 请求.非零读取截止 != 0;
    }

    static bool 收口请求有效(const 自我现实执行授权收口请求& 请求) noexcept {
        return 请求.合同版本 == 自我现实执行授权合同版本
            && L2结构请求头合同有效(请求.请求头)
            && L2结构幂等身份有效(请求.幂等身份)
            && 有效(请求.自我.值) && 有效(请求.任务.值)
            && 有效(请求.任务轮次.值) && 有效(请求.执行轮次.值)
            && 请求.授权.有效() && 请求.来源共同事实截止 != 0
            && 请求.请求头.期望事实代次 == 请求.来源共同事实截止
            && 请求.发生时间 != 0 && 请求.收口规则版本 != 0
            && 请求.种类 >= 自我现实执行授权收口种类::已消费
            && 请求.种类 <= 自我现实执行授权收口种类::已失效;
    }

    static bool 授权绑定请求(const L2自我现实执行授权事实& 授权,
        const 自我现实执行授权请求& 请求) noexcept {
        return 授权.身份.有效() && 授权.自我 == 请求.自我
            && 授权.任务 == 请求.任务 && 授权.任务轮次 == 请求.任务轮次
            && 授权.筹办轮次 == 请求.筹办轮次 && 授权.执行轮次 == 请求.执行轮次
            && 授权.冻结 == 请求.冻结 && 授权.冻结版本 == 请求.冻结版本
            && 授权.实例方法 == 请求.实例方法 && 授权.方法 == 请求.方法
            && 授权.方法内容版本 == 请求.方法内容版本
            && 授权.有序冻结动作范围 == 请求.有序冻结动作范围
            && 授权.来源共同事实截止 == 请求.来源共同事实截止
            && 授权.授权规则版本 == 请求.授权规则版本
            && 授权.发生时间 == 请求.发生时间
            && 授权.有效截止时间 == 请求.有效截止时间;
    }

    static 自我现实执行授权状态 映射提交状态(
        const L2自我治理结构提交结果& 结果) noexcept {
        if (结果.提交见证) return 自我现实执行授权状态::已可能发布;
        switch (结果.结果头.状态) {
        case L2结构状态::已提交: return 自我现实执行授权状态::已授权;
        case L2结构状态::精确重复: return 自我现实执行授权状态::精确重复;
        case L2结构状态::入口拒绝: return 自我现实执行授权状态::拒绝;
        case L2结构状态::许可拒绝: return 自我现实执行授权状态::许可拒绝;
        case L2结构状态::事实代次漂移: return 自我现实执行授权状态::当前性漂移;
        case L2结构状态::幂等冲突: return 自我现实执行授权状态::幂等冲突;
        case L2结构状态::资源失败:
        case L2结构状态::数量预算不足: return 自我现实执行授权状态::资源失败;
        default: return 自我现实执行授权状态::内部错误;
        }
    }

    static 自我现实执行授权状态 映射读取状态(L2结构状态 状态) noexcept {
        switch (状态) {
        case L2结构状态::已读取: return 自我现实执行授权状态::已授权;
        case L2结构状态::未找到: return 自我现实执行授权状态::等待;
        case L2结构状态::已退出: return 自我现实执行授权状态::已失效;
        case L2结构状态::入口拒绝: return 自我现实执行授权状态::拒绝;
        case L2结构状态::许可拒绝: return 自我现实执行授权状态::许可拒绝;
        case L2结构状态::事实代次漂移: return 自我现实执行授权状态::当前性漂移;
        case L2结构状态::资源失败: return 自我现实执行授权状态::资源失败;
        default: return 自我现实执行授权状态::内部错误;
        }
    }

    static 自我现实执行授权状态 映射收口提交状态(
        const L2自我治理结构提交结果& 结果,
        自我现实执行授权收口种类 种类) noexcept {
        const auto 基础 = 映射提交状态(结果);
        if (基础 == 自我现实执行授权状态::已授权) {
            switch (种类) {
            case 自我现实执行授权收口种类::已消费:
                return 自我现实执行授权状态::已消费;
            case 自我现实执行授权收口种类::已撤回:
                return 自我现实执行授权状态::已撤回;
            case 自我现实执行授权收口种类::已失效:
                return 自我现实执行授权状态::已失效;
            }
        }
        return 基础;
    }

    L2自我治理结构服务& 结构服务_;
};

} // namespace 海中鱼巣
