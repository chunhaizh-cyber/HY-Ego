module;

#include <algorithm>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <variant>
#include <vector>

#define SELF_TASK_SUCCESSOR_DECISION_NO_INCLUDES

export module 海中鱼巣.领域.自我治理.服务.自我任务后继决议;

export import 海中鱼巣.领域.服务.L2自我治理结构;

export {
#include "自我任务后继决议.数据.h"
}

export namespace 海中鱼巣 {

class 自我任务后继决议提供者 final {
public:
    explicit 自我任务后继决议提供者(
        L2自我治理结构服务& 结构服务) noexcept
        : 结构服务_(结构服务) {}

    自我任务后继决议结果 发布或读取自我任务后继决议(
        const 自我任务后继决议请求& 请求) noexcept {
        if (!请求有效(请求)) return {自我任务后继决议状态::材料不足};
        try {
            L2自我任务后继决议事实 候选;
            候选.自我 = 请求.自我;
            候选.任务 = 请求.任务;
            候选.已收束任务轮次 = 请求.已收束任务轮次;
            候选.轮次结算 = 请求.轮次结算;
            候选.指令 = 请求.指令;
            候选.当前需求依据 = 请求.当前需求依据;
            候选.当前安全依据 = 请求.当前安全依据;
            候选.当前整体治理依据 = 请求.当前整体治理依据;
            候选.来源共同事实截止 = 请求.来源共同事实截止;
            候选.决议规则版本 = 请求.决议规则版本;
            候选.发生时间 = 请求.发生时间;
            const auto 提交 = 结构服务_.提交自我治理结构事实(
                {请求.请求头, 请求.幂等身份,
                    L2自我治理结构事实种类::任务后继决议, 候选});
            自我任务后继决议结果 结果;
            结果.状态 = 映射提交状态(提交);
            结果.提交见证 = 提交.提交见证;
            结果.本次正式读回截止 = 提交.本次正式读回截止;
            if (结果.状态 != 自我任务后继决议状态::已形成
                && 结果.状态 != 自我任务后继决议状态::精确重复)
                return 结果;
            const auto* 决议 = 提交.事实
                ? std::get_if<L2自我任务后继决议事实>(&*提交.事实) : nullptr;
            if (!决议 || !事实绑定请求(*决议, 请求))
                return {自我任务后继决议状态::内部错误};
            结果.决议 = *决议;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {自我任务后继决议状态::资源失败};
        } catch (const std::length_error&) {
            return {自我任务后继决议状态::资源失败};
        } catch (...) {
            return {自我任务后继决议状态::内部错误};
        }
    }

    自我任务后继决议读取结果 读取自我任务后继决议(
        const 自我任务后继决议读取请求& 请求) const noexcept {
        if (!读取请求有效(请求)) return {自我任务后继决议状态::入口拒绝};
        try {
            const auto 读取 = 结构服务_.读取自我治理结构事实(
                {请求.合同版本, 请求.自我,
                    L2自我治理结构事实种类::任务后继决议,
                    请求.决议身份, 请求.非零读取截止});
            自我任务后继决议读取结果 结果;
            结果.状态 = 映射读取状态(读取.结果头.状态);
            结果.本次正式读回截止 = 读取.本次正式读回截止;
            if (结果.状态 != 自我任务后继决议状态::已形成)
                return 结果;
            const auto* 决议 = 读取.事实
                ? std::get_if<L2自我任务后继决议事实>(&*读取.事实) : nullptr;
            if (!决议 || 决议->身份 != 请求.决议身份 || 决议->自我 != 请求.自我
                || 决议->任务 != 请求.任务
                || 决议->已收束任务轮次 != 请求.已收束任务轮次)
                return {自我任务后继决议状态::内部错误};
            结果.决议 = *决议;
            return 结果;
        } catch (const std::bad_alloc&) {
            return {自我任务后继决议状态::资源失败};
        } catch (...) {
            return {自我任务后继决议状态::内部错误};
        }
    }

private:
    static bool 请求有效(const 自我任务后继决议请求& 请求) noexcept {
        const bool 指令有效 = 请求.指令 >= 自我任务后继指令::继续当前任务
            && 请求.指令 <= 自我任务后继指令::取消任务;
        const bool 需求有效 = std::all_of(请求.当前需求依据.begin(),
            请求.当前需求依据.end(), [](const auto& 依据) {
                return 有效(依据.需求.值) && 有效(依据.当前状态.值)
                    && 有效(依据.当前优先级事实);
            });
        const bool 安全有效 = std::all_of(请求.当前安全依据.begin(),
            请求.当前安全依据.end(), [](const auto& 依据) {
                return 有效(依据.安全事实);
            });
        const bool 治理有效 = std::all_of(请求.当前整体治理依据.begin(),
            请求.当前整体治理依据.end(), [](const auto& 依据) {
                return 有效(依据.治理事实);
            });
        return 请求.合同版本 == 自我任务后继决议合同版本
            && L2结构请求头合同有效(请求.请求头)
            && L2结构幂等身份有效(请求.幂等身份)
            && 有效(请求.自我.值) && 有效(请求.任务.值)
            && 有效(请求.已收束任务轮次.值) && 有效(请求.轮次结算.值)
            && 指令有效 && 需求有效 && 安全有效 && 治理有效
            && 请求.来源共同事实截止 != 0
            && 请求.请求头.期望事实代次 == 请求.来源共同事实截止
            && 请求.决议规则版本 == 自我任务后继决议规则版本
            && 请求.发生时间 != 0;
    }

    static bool 读取请求有效(const 自我任务后继决议读取请求& 请求) noexcept {
        return 请求.合同版本 == 自我任务后继决议合同版本
            && 有效(请求.自我.值) && 有效(请求.任务.值)
            && 有效(请求.已收束任务轮次.值) && 有效(请求.决议身份)
            && 请求.非零读取截止 != 0;
    }

    static bool 事实绑定请求(const L2自我任务后继决议事实& 事实,
        const 自我任务后继决议请求& 请求) noexcept {
        return 有效(事实.身份) && 事实.自我 == 请求.自我
            && 事实.任务 == 请求.任务
            && 事实.已收束任务轮次 == 请求.已收束任务轮次
            && 事实.轮次结算 == 请求.轮次结算 && 事实.指令 == 请求.指令
            && 事实.当前需求依据 == 请求.当前需求依据
            && 事实.当前安全依据 == 请求.当前安全依据
            && 事实.当前整体治理依据 == 请求.当前整体治理依据
            && 事实.来源共同事实截止 == 请求.来源共同事实截止
            && 事实.决议规则版本 == 请求.决议规则版本
            && 事实.发生时间 == 请求.发生时间;
    }

    static 自我任务后继决议状态 映射提交状态(
        const L2自我治理结构提交结果& 结果) noexcept {
        if (结果.提交见证) return 自我任务后继决议状态::已可能发布;
        switch (结果.结果头.状态) {
        case L2结构状态::已提交: return 自我任务后继决议状态::已形成;
        case L2结构状态::精确重复: return 自我任务后继决议状态::精确重复;
        case L2结构状态::入口拒绝: return 自我任务后继决议状态::入口拒绝;
        case L2结构状态::许可拒绝: return 自我任务后继决议状态::许可拒绝;
        case L2结构状态::事实代次漂移: return 自我任务后继决议状态::当前性漂移;
        case L2结构状态::幂等冲突: return 自我任务后继决议状态::幂等冲突;
        case L2结构状态::资源失败:
        case L2结构状态::数量预算不足: return 自我任务后继决议状态::资源失败;
        default: return 自我任务后继决议状态::内部错误;
        }
    }

    static 自我任务后继决议状态 映射读取状态(L2结构状态 状态) noexcept {
        switch (状态) {
        case L2结构状态::已读取: return 自我任务后继决议状态::已形成;
        case L2结构状态::未找到: return 自我任务后继决议状态::未找到;
        case L2结构状态::入口拒绝: return 自我任务后继决议状态::入口拒绝;
        case L2结构状态::许可拒绝: return 自我任务后继决议状态::许可拒绝;
        case L2结构状态::事实代次漂移: return 自我任务后继决议状态::当前性漂移;
        case L2结构状态::资源失败: return 自我任务后继决议状态::资源失败;
        default: return 自我任务后继决议状态::内部错误;
        }
    }

    L2自我治理结构服务& 结构服务_;
};

} // namespace 海中鱼巣
