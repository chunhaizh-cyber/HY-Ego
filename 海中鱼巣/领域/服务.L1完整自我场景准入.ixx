module;

#include <array>
#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.服务.L1完整自我场景准入;

export import 海中鱼巣.领域.服务.L1完整自我存在准入;

namespace 海中鱼巣::完整自我场景准入内部 {

// 诊断责任：无适用错误分支；纯值上游形状判断不分配。
bool 上游有效(const 完整自我场景准入请求& 请求) noexcept {
    return 请求.合同版本 == L1完整自我合同版本
        && 请求.规则版本 == L1完整自我规则版本
        && 请求.共同事实截止代次 != 0
        && 世界结构登记完整(请求.世界登记)
        && 实际存在写入规格完整(请求.实际存在规格)
        && 自我结构关系登记完整(请求.自我结构登记);
}

// 诊断责任：无适用错误分支；纯值身份碰撞判断。
bool 身份互异(const 完整自我场景准入请求& 请求) noexcept {
    const std::array<稳定编码, 9> 固定身份组{
        请求.世界登记.世界根场景,
        请求.世界登记.服务身份,
        请求.世界登记.场景标记属性类型,
        请求.世界登记.直接父场景关系类型,
        请求.世界登记.直接成员关系类型,
        请求.实际存在规格.服务身份.编码,
        请求.实际存在规格.资格属性类型.编码,
        请求.自我结构登记.服务身份,
        请求.自我结构登记.自我结构关系类型};
    for (std::size_t i = 0; i < 固定身份组.size(); ++i) {
        for (std::size_t j = i + 1; j < 固定身份组.size(); ++j)
            if (固定身份组[i] == 固定身份组[j]) return false;
        for (const auto& 成员 : 请求.出生期成员资格组)
            if (固定身份组[i] == 成员.存在.编码) return false;
    }
    return true;
}

} // namespace 海中鱼巣::完整自我场景准入内部

export namespace 海中鱼巣 {

class L1完整自我场景准入服务 final {
public:
    L1完整自我场景准入服务() = default;
    L1完整自我场景准入服务(const L1完整自我场景准入服务&) = delete;
    L1完整自我场景准入服务& operator=(const L1完整自我场景准入服务&) = delete;
    L1完整自我场景准入服务(L1完整自我场景准入服务&&) = delete;
    L1完整自我场景准入服务& operator=(L1完整自我场景准入服务&&) = delete;

    // 诊断责任：向上送出；成员拒绝、漂移、资源失败与矛盾均结构化返回。
    完整自我场景准入结果 形成完整自我场景准入(
        const 完整自我场景准入请求& 请求) const {
        if (!完整自我场景准入内部::上游有效(请求)) return {};
        if (请求.世界登记.已验证事实代次 != 请求.共同事实截止代次
            || 请求.实际存在规格.事实截止代次 != 请求.共同事实截止代次
            || 请求.自我结构登记.事实截止代次 != 请求.共同事实截止代次) {
            return {完整自我场景准入状态::事实代次漂移, std::nullopt};
        }
        if (!完整自我成员资格组有效(请求.出生期成员资格组,
                请求.共同事实截止代次, 请求.实际存在规格)) {
            return {完整自我场景准入状态::出生期成员不合格, std::nullopt};
        }
        if (!完整自我场景准入内部::身份互异(请求)) {
            return {完整自我场景准入状态::内部不一致, std::nullopt};
        }
        try {
            完整自我场景准入规格 规格;
            规格.共同事实截止代次 = 请求.共同事实截止代次;
            规格.世界根 = {请求.世界登记.世界根场景, 节点种类::普通};
            规格.世界登记服务 = {请求.世界登记.服务身份, 节点种类::普通};
            规格.场景标记属性类型 = {
                请求.世界登记.场景标记属性类型, 节点种类::属性类型};
            规格.直接父场景关系类型 = {
                请求.世界登记.直接父场景关系类型, 节点种类::普通};
            规格.直接成员关系类型 = {
                请求.世界登记.直接成员关系类型, 节点种类::普通};
            规格.自我结构登记服务 = {
                请求.自我结构登记.服务身份, 节点种类::普通};
            规格.自我结构关系类型 = {
                请求.自我结构登记.自我结构关系类型, 节点种类::普通};
            规格.出生期成员资格组 = 请求.出生期成员资格组;
            if (!完整自我场景准入规格完整(规格)) {
                return {完整自我场景准入状态::内部不一致, std::nullopt};
            }
            return {完整自我场景准入状态::已批准, std::move(规格)};
        } catch (const std::bad_alloc&) {
            return {完整自我场景准入状态::资源失败, std::nullopt};
        } catch (const std::length_error&) {
            return {完整自我场景准入状态::资源失败, std::nullopt};
        } catch (...) {
            return {完整自我场景准入状态::内部不一致, std::nullopt};
        }
    }
};

} // namespace 海中鱼巣
