    任务现实执行硬否决规则所有者建立身份{0x4C31'5346'5459'4F57ULL};

class L2任务现实执行硬否决规则结构服务;

class L2任务现实执行硬否决规则结构所有者交付 final {
public:
    L2任务现实执行硬否决规则结构所有者交付() = delete;
    L2任务现实执行硬否决规则结构所有者交付(
        const L2任务现实执行硬否决规则结构所有者交付&) = delete;
    L2任务现实执行硬否决规则结构所有者交付& operator=(
        const L2任务现实执行硬否决规则结构所有者交付&) = delete;
    L2任务现实执行硬否决规则结构所有者交付(
        L2任务现实执行硬否决规则结构所有者交付&&) noexcept = default;
    L2任务现实执行硬否决规则结构所有者交付& operator=(
        L2任务现实执行硬否决规则结构所有者交付&&) = delete;

    bool 有效() const noexcept { return 写入端口_.有效(); }
    bool 绑定于(const L1事实基座服务& 服务) const noexcept {
        return 写入端口_.绑定于(服务);
    }
    L1结构所有者身份 所有者身份() const noexcept {
        return 写入端口_.所有者身份();
    }

private:
    explicit L2任务现实执行硬否决规则结构所有者交付(
        L1所有者范围写端口&& 端口) noexcept : 写入端口_(std::move(端口)) {}
    friend std::optional<L2任务现实执行硬否决规则结构所有者交付>
    尝试形成L2任务现实执行硬否决规则结构所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2任务现实执行硬否决规则结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2任务现实执行硬否决规则结构所有者交付>
尝试形成L2任务现实执行硬否决规则结构所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

