namespace 海中鱼巣::L2任务现实执行硬否决规则结构内部 {

inline constexpr L1所有者范围写入幂等身份 结构登记幂等身份{
    0x4C32'5346'5459'5247ULL};

inline constexpr std::uint32_t 宇宙登记锚点键 = 0x0307'2001U;
inline constexpr std::uint32_t 当前宇宙版本关系键 = 0x0307'2002U;
inline constexpr std::uint32_t 宇宙规则版本键 = 0x0307'2003U;
inline constexpr std::uint32_t 成员集合版本键 = 0x0307'2004U;
inline constexpr std::uint32_t 宇宙成员关系键 = 0x0307'2005U;
inline constexpr std::uint32_t 规则语义身份键 = 0x0307'2006U;
inline constexpr std::uint32_t self约束模式键 = 0x0307'2007U;
inline constexpr std::uint32_t self约束成员关系键 = 0x0307'2008U;
inline constexpr std::uint32_t 场景约束模式键 = 0x0307'2009U;
inline constexpr std::uint32_t 场景约束成员关系键 = 0x0307'200AU;
inline constexpr std::uint32_t 动作作用范围键 = 0x0307'200BU;
inline constexpr std::uint32_t 物理来源事实键 = 0x0307'200CU;
inline constexpr std::uint32_t 版本切换原因键 = 0x0307'200DU;
inline constexpr std::uint32_t 切换依据事件键 = 0x0307'200EU;

struct 结构登记定位 final {
    稳定编码 宇宙登记锚点;
    稳定编码 当前宇宙版本关系;
    稳定编码 宇宙规则版本;
    稳定编码 成员集合版本;
    稳定编码 宇宙成员关系;
    稳定编码 规则语义身份;
    稳定编码 self约束模式;
    稳定编码 self约束成员关系;
    稳定编码 场景约束模式;
    稳定编码 场景约束成员关系;
    稳定编码 动作作用范围;
    稳定编码 物理来源事实;
    稳定编码 版本切换原因;
    稳定编码 切换依据事件;
};

inline L1所有者范围写集本地键 键(std::uint32_t 值) noexcept { return {值}; }

inline std::optional<稳定编码> 查找映射(
    const std::vector<std::pair<L1所有者范围写集本地键, 稳定编码>>& 映射,
    std::uint32_t 本地键) noexcept {
    for (const auto& [键值, 编码] : 映射)
        if (键值.值 == 本地键) return 编码;
    return std::nullopt;
}

inline 结构登记定位 初始化结构登记(
    const L1事实基座服务& L1, L1所有者范围写端口& 写入端口) {
    L1所有者范围写集请求 写集;
    const auto 首次 = 写入端口.读取首次写入材料(
        {L1所有者范围首次写入读取合同版本, 结构登记幂等身份});
    if (首次.状态 == L1所有者范围读取状态::成功 && 首次.首次规范化写集) {
        写集 = *首次.首次规范化写集;
    } else if (首次.状态 == L1所有者范围读取状态::未找到) {
        const auto 当前 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前.状态 != L1中性读取状态::成功 || 当前.事实代次 == 0)
            throw std::runtime_error("L2 hard denial registration cutoff unavailable");
        写集.期望事实代次 = 当前.事实代次;
        写集.写入幂等身份 = 结构登记幂等身份;
        写集.节点 = {
            {键(宇宙登记锚点键), 节点种类::普通, std::nullopt},
            {键(当前宇宙版本关系键), 节点种类::普通, std::nullopt},
            {键(宇宙规则版本键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(成员集合版本键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(宇宙成员关系键), 节点种类::普通, std::nullopt},
            {键(规则语义身份键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(self约束模式键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(self约束成员关系键), 节点种类::普通, std::nullopt},
            {键(场景约束模式键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(场景约束成员关系键), 节点种类::普通, std::nullopt},
            {键(动作作用范围键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(物理来源事实键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(版本切换原因键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组},
            {键(切换依据事件键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组}};
    } else {
        throw std::runtime_error("L2 hard denial registration read failed");
    }
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.状态 != L1所有者范围写入状态::成功
        && 写入.状态 != L1所有者范围写入状态::精确重复)
        throw std::runtime_error("L2 hard denial registration failed");
    const auto 取 = [&](std::uint32_t 本地键) -> 稳定编码 {
        const auto 编码 = 查找映射(写入.新编码映射, 本地键);
        if (!编码) throw std::runtime_error("L2 hard denial registration mapping missing");
        return *编码;
    };
    return {取(宇宙登记锚点键), 取(当前宇宙版本关系键),
        取(宇宙规则版本键), 取(成员集合版本键), 取(宇宙成员关系键),
        取(规则语义身份键), 取(self约束模式键), 取(self约束成员关系键),
        取(场景约束模式键), 取(场景约束成员关系键),
        取(动作作用范围键), 取(物理来源事实键),
        取(版本切换原因键), 取(切换依据事件键)};
}

inline bool 存在身份严格升序(const std::vector<L2存在身份>& 组) noexcept {
    std::uint64_t 前 = 0;
    for (const auto& 值 : 组) {
        if (!有效(值.值) || 值.值.值 <= 前) return false;
        前 = 值.值.值;
    }
    return true;
}

inline bool 场景身份严格升序(const std::vector<L2场景身份>& 组) noexcept {
    std::uint64_t 前 = 0;
    for (const auto& 值 : 组) {
        if (!有效(值.值) || 值.值.值 <= 前) return false;
        前 = 值.值.值;
    }
    return true;
}

inline bool 编码严格升序(const std::vector<稳定编码>& 组) noexcept {
    std::uint64_t 前 = 0;
    for (const auto 值 : 组) {
        if (!有效(值) || 值.值 <= 前) return false;
        前 = 值.值;
    }
    return true;
}

inline bool 范围严格升序(const std::vector<任务动作作用范围>& 组) noexcept {
    if (组.empty()) return false;
    std::uint8_t 前 = 0;
    for (const auto 值 : 组) {
        const auto 原值 = static_cast<std::uint8_t>(值);
        if ((值 != 任务动作作用范围::内部治理
                && 值 != 任务动作作用范围::纯现实观察
                && 值 != 任务动作作用范围::现实改变)
            || 原值 <= 前)
            return false;
        前 = 原值;
    }
    return true;
}

template<class T>
inline bool 约束有效(L2硬否决约束模式 模式, const std::vector<T>& 成员,
    bool (*严格升序)(const std::vector<T>&)) noexcept {
    if (模式 == L2硬否决约束模式::任意) return 成员.empty();
    return 模式 == L2硬否决约束模式::精确集合
        && !成员.empty() && 严格升序(成员);
}

inline bool 定义材料有效(
    const L2任务现实执行硬否决规则定义材料_v2& 定义) noexcept {
    return 有效(定义.语义身份.值)
        && 约束有效(定义.self约束.模式, 定义.self约束.成员,
            &存在身份严格升序)
        && 约束有效(定义.场景约束.模式, 定义.场景约束.成员,
            &场景身份严格升序)
        && 范围严格升序(定义.动作作用范围约束.包含范围)
        && !定义.归一物理来源事实组.empty()
        && 编码严格升序(定义.归一物理来源事实组);
}

enum class 规则组规范化状态 : std::uint8_t { 成功, 不闭合, 引用冲突, 资源失败 };

inline 规则组规范化状态 规范化规则组(
    const std::vector<L2任务现实执行硬否决规则定义材料_v2>& 输入,
    std::vector<L2任务现实执行硬否决规则定义材料_v2>& 输出) {
    if (输入.size() > 100000U) return 规则组规范化状态::资源失败;
    for (const auto& 项 : 输入)
        if (!定义材料有效(项)) return 规则组规范化状态::不闭合;
    输出 = 输入;
    std::sort(输出.begin(), 输出.end(), [](const auto& 左, const auto& 右) {
        return 左.语义身份.值.值 < 右.语义身份.值.值;
    });
    std::vector<L2任务现实执行硬否决规则定义材料_v2> 归一;
    for (auto& 项 : 输出) {
        if (归一.empty() || 归一.back().语义身份 != 项.语义身份) {
            归一.push_back(std::move(项));
            continue;
        }
        auto& 既有 = 归一.back();
        if (既有.self约束 != 项.self约束 || 既有.场景约束 != 项.场景约束
            || 既有.动作作用范围约束 != 项.动作作用范围约束)
            return 规则组规范化状态::引用冲突;
        既有.归一物理来源事实组.insert(既有.归一物理来源事实组.end(),
            项.归一物理来源事实组.begin(), 项.归一物理来源事实组.end());
        std::sort(既有.归一物理来源事实组.begin(), 既有.归一物理来源事实组.end(),
            [](稳定编码 左, 稳定编码 右) { return 左.值 < 右.值; });
        既有.归一物理来源事实组.erase(
            std::unique(既有.归一物理来源事实组.begin(),
                既有.归一物理来源事实组.end()),
            既有.归一物理来源事实组.end());
    }
    输出 = std::move(归一);
    return 规则组规范化状态::成功;
}

inline bool 动作范围有效(const std::vector<任务冻结动作项>& 动作组) noexcept {
    if (动作组.empty()) return false;
    for (std::size_t i = 0; i < 动作组.size(); ++i) {
        const auto& 动作 = 动作组[i];
        if (动作.顺序 != i + 1 || !有效(动作.动作入口.值)
            || !L2方法稳定动作键有效(动作.稳定动作键)
            || !有效(动作.作用主体.值) || !有效(动作.动作范围材料)
            || !有效(动作.预期结果材料) || !有效(动作.结果验证合同)
            || !有效(动作.动作归因合同)
            || (动作.作用场景 && !有效(动作.作用场景->值))
            || (动作.作用范围 != 任务动作作用范围::内部治理
                && 动作.作用范围 != 任务动作作用范围::纯现实观察
                && 动作.作用范围 != 任务动作作用范围::现实改变))
            return false;
    }
    return true;
}

inline bool 切换原因有效(
    L2任务现实执行硬否决规则版本切换原因_v2 原因) noexcept {
    return 原因 == L2任务现实执行硬否决规则版本切换原因_v2::首次发布
        || 原因 == L2任务现实执行硬否决规则版本切换原因_v2::撤销
        || 原因 == L2任务现实执行硬否决规则版本切换原因_v2::失效
        || 原因 == L2任务现实执行硬否决规则版本切换原因_v2::替代
        || 原因 == L2任务现实执行硬否决规则版本切换原因_v2::组合修订;
}

inline bool 活动于(const L2生命周期& 生命周期, std::uint64_t 截止) noexcept {
    return 生命周期.创建事实代次 != 0
        && 生命周期.创建事实代次 <= 截止
        && (!生命周期.退出事实代次 || *生命周期.退出事实代次 > 截止);
}

inline const std::vector<std::uint64_t>* U64载荷(
    const L1所有者范围值事实& 值) noexcept {
    return std::get_if<std::vector<std::uint64_t>>(&值.材料);
}

inline const L1所有者范围一致属性值投影* 查找属性投影(
    const std::vector<L1所有者范围一致属性值读取结果项>& 组,
    稳定编码 节点, 稳定编码 属性类型) noexcept {
    for (const auto& 项 : 组)
        if (项.节点 == 节点 && 项.属性类型 == 属性类型
            && 项.状态 == L1所有者范围一致当前读取项目状态::成功 && 项.投影)
            return &*项.投影;
    return nullptr;
}

inline const L1所有者范围一致闭包端点关系组读取结果项* 查找源关系组(
    const std::vector<L1所有者范围一致闭包端点关系组读取结果项>& 组,
    稳定编码 节点, 稳定编码 类型) noexcept {
    for (const auto& 项 : 组)
        if (项.端点节点 == 节点 && 项.关系类型节点 == 类型
            && 项.状态 == L1所有者范围一致当前读取项目状态::成功)
            return &项;
    return nullptr;
}

enum class 当前宇宙状态 : std::uint8_t {
    成功, 未发布, 当前性漂移, 许可拒绝, 规则宇宙不闭合,
    引用冲突, 资源失败, 内部错误
};

struct 当前宇宙读取 final {
    当前宇宙状态 状态 = 当前宇宙状态::内部错误;
    std::optional<L2任务现实执行硬否决规则宇宙事实_v2> 宇宙;
    std::vector<L2任务现实执行硬否决规则事实_v2> 规则组;
    std::vector<稳定编码> 退出事实;
    std::uint64_t 截止 = 0;
};

inline L2任务现实执行硬否决规则宇宙发布状态_v2 映射写入状态(
    L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::已发布;
    case L1所有者范围写入状态::精确重复:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::精确重复;
    case L1所有者范围写入状态::入口拒绝:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::入口拒绝;
    case L1所有者范围写入状态::许可拒绝:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::当前性漂移;
    case L1所有者范围写入状态::幂等冲突:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::幂等冲突;
    case L1所有者范围写入状态::引用冲突:
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::引用冲突;
    case L1所有者范围写入状态::资源失败:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::资源失败;
    default:
        return L2任务现实执行硬否决规则宇宙发布状态_v2::内部错误;
    }
}

} // namespace 海中鱼巣::L2任务现实执行硬否决规则结构内部

export namespace 海中鱼巣 {

inline std::optional<L2任务现实执行硬否决规则结构所有者交付>
尝试形成L2任务现实执行硬否决规则结构所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 任务现实执行硬否决规则所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务))
            return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2任务现实执行硬否决规则结构所有者交付{
            std::move(*原始交付.写入端口)};
    } catch (...) { return std::nullopt; }
}

class L2任务现实执行硬否决规则结构服务 final {
public:
    explicit L2任务现实执行硬否决规则结构服务(
        const L1事实基座服务& 第一层服务,
        const L2场景结构服务& 场景服务,
        L2任务现实执行硬否决规则结构所有者交付&& 交付)
        : L1_(第一层服务), 场景服务_(场景服务),
          第一层写入端口_(验证并移动交付(第一层服务, 交付)),
          登记_(L2任务现实执行硬否决规则结构内部::初始化结构登记(
              L1_, 第一层写入端口_)) {}

    L2任务现实执行硬否决规则结构服务(
        const L2任务现实执行硬否决规则结构服务&) = delete;
    L2任务现实执行硬否决规则结构服务& operator=(
        const L2任务现实执行硬否决规则结构服务&) = delete;

    L2任务现实执行硬否决规则宇宙发布结果_v2
    发布或读取任务现实执行硬否决规则宇宙_v2(
        const L2任务现实执行硬否决规则宇宙发布请求_v2& 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [](L2任务现实执行硬否决规则宇宙发布状态_v2 状态) {
            L2任务现实执行硬否决规则宇宙发布结果_v2 结果;
            结果.状态 = 状态;
            return 结果;
        };
        try {
            if (请求.合同版本 != L2任务现实执行硬否决规则结构专属合同版本_v2
                || !L2结构请求头合同有效(请求.请求头)
                || 请求.请求头.期望事实代次 == 0 || 请求.幂等身份.值 == 0
                || 请求.新规则版本 == 0 || 请求.新成员集合版本 == 0
                || !L2任务现实执行硬否决规则结构内部::切换原因有效(
                    请求.切换原因) || !有效(请求.切换依据事件))
                return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::入口拒绝);

            std::vector<L2任务现实执行硬否决规则定义材料_v2> 规范规则组;
            const auto 规范化 = L2任务现实执行硬否决规则结构内部::规范化规则组(
                请求.完整规则组, 规范规则组);
            if (规范化 == L2任务现实执行硬否决规则结构内部::规则组规范化状态::不闭合)
                return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::规则集合不闭合);
            if (规范化 == L2任务现实执行硬否决规则结构内部::规则组规范化状态::引用冲突)
                return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::引用冲突);
            if (规范化 == L2任务现实执行硬否决规则结构内部::规则组规范化状态::资源失败)
                return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::资源失败);

            const L1所有者范围写入幂等身份 L1幂等{请求.幂等身份.值};
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, L1幂等});
            L1所有者范围写集请求 写集;
            写集布局 布局;
            if (首次.状态 == L1所有者范围读取状态::成功) {
                if (!首次.首次规范化写集 || !首次.首次写入结果)
                    return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::内部错误);
                写集 = 形成发布写集(请求, 规范规则组,
                    首次.首次规范化写集->退出事实, 布局);
                if (写集 != *首次.首次规范化写集)
                    return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::幂等冲突);
            } else if (首次.状态 == L1所有者范围读取状态::未找到) {
                const auto 当前 = 读取当前宇宙_已锁定(请求.请求头.期望事实代次);
                if (当前.状态 != L2任务现实执行硬否决规则结构内部::当前宇宙状态::成功
                    && 当前.状态 != L2任务现实执行硬否决规则结构内部::当前宇宙状态::未发布)
                    return 失败(映射当前宇宙到发布状态(当前.状态));
                if (!版本迁移有效(请求, 当前.宇宙))
                    return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::版本漂移);
                写集 = 形成发布写集(请求, 规范规则组, 当前.退出事实, 布局);
            } else {
                return 失败(首次.状态 == L1所有者范围读取状态::许可拒绝
                    ? L2任务现实执行硬否决规则宇宙发布状态_v2::许可拒绝
                    : 首次.状态 == L1所有者范围读取状态::资源失败
                        ? L2任务现实执行硬否决规则宇宙发布状态_v2::资源失败
                        : L2任务现实执行硬否决规则宇宙发布状态_v2::内部错误);
            }

            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2任务现实执行硬否决规则结构内部::映射写入状态(
                写入.状态);
            if (状态 != L2任务现实执行硬否决规则宇宙发布状态_v2::已发布
                && 状态 != L2任务现实执行硬否决规则宇宙发布状态_v2::精确重复)
                return 失败(状态);

            const auto 读回 = 读取提交版本历史(请求, 规范规则组, 写集, 布局, 写入);
            if (!读回.成功()) {
                auto 结果 = 失败(
                    L2任务现实执行硬否决规则宇宙发布状态_v2::已可能发布);
                结果.提交见证 = L2任务现实执行硬否决规则宇宙提交见证_v2{
                    第一层写入端口_.所有者身份(), 请求.幂等身份,
                    写入.事实代次, 请求.新规则版本};
                return 结果;
            }
            auto 结果 = 读回;
            结果.状态 = 状态;
            return 结果;
        } catch (const std::bad_alloc&) {
            return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::资源失败);
        } catch (...) {
            return 失败(L2任务现实执行硬否决规则宇宙发布状态_v2::内部错误);
        }
    }

    L2任务现实执行硬否决规则全集读取结果_v2
    读取任务现实执行硬否决规则全集_v2(
        const L2任务现实执行硬否决规则全集读取请求_v2& 请求) const noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [](L2任务现实执行硬否决规则全集读取状态_v2 状态) {
            L2任务现实执行硬否决规则全集读取结果_v2 结果;
            结果.状态 = 状态;
            return 结果;
        };
        try {
            if (请求.合同版本 != L2任务现实执行硬否决规则结构专属合同版本_v2
                || !L2结构请求头合同有效(请求.请求头)
                || 请求.请求头.期望事实代次 == 0 || !有效(请求.自我.值)
                || !L2任务现实执行硬否决规则结构内部::动作范围有效(
                    请求.完整有序冻结动作范围))
                return 失败(L2任务现实执行硬否决规则全集读取状态_v2::入口拒绝);

            const auto 场景 = 验证共同作用场景(请求);
            if (场景.状态 != 共同场景状态::成功)
                return 失败(映射共同场景状态(场景.状态));

            const auto 当前 = 读取当前宇宙_已锁定(请求.请求头.期望事实代次);
            if (当前.状态 != L2任务现实执行硬否决规则结构内部::当前宇宙状态::成功)
                return 失败(映射当前宇宙到读取状态(当前.状态));
            if (!当前.宇宙
                || 当前.宇宙->规范成员语义身份组.size() != 当前.规则组.size())
                return 失败(L2任务现实执行硬否决规则全集读取状态_v2::规则宇宙不闭合);

            L2任务现实执行硬否决规则全集读取结果_v2 结果;
            结果.状态 = L2任务现实执行硬否决规则全集读取状态_v2::已读取;
            结果.宇宙 = 当前.宇宙;
            结果.完整规则组 = 当前.规则组;
            L2任务现实执行硬否决规则完整集合见证_v2 见证;
            见证.宇宙 = 当前.宇宙->宇宙;
            见证.规则版本 = 当前.宇宙->规则版本;
            见证.成员集合版本 = 当前.宇宙->成员集合版本;
            见证.声明成员数 = 当前.规则组.size();
            见证.Gnow = 当前.截止;

            for (const auto& 规则 : 当前.规则组) {
                L2任务现实执行硬否决规则覆盖项_v2 项;
                项.规则语义身份 = 规则.定义.语义身份;
                项.规则事实身份 = 规则.身份;
                项.规则版本一致 = 规则.规则版本 == 当前.宇宙->规则版本
                    && 规则.成员集合版本 == 当前.宇宙->成员集合版本;
                项.Gnow生命周期有效 =
                    L2任务现实执行硬否决规则结构内部::活动于(
                        当前.宇宙->生命周期, 当前.截止)
                    && L2任务现实执行硬否决规则结构内部::活动于(
                        规则.生命周期, 当前.截止);
                项.self匹配 = self匹配(规则.定义.self约束, 请求.自我);
                项.场景匹配 = 场景匹配(规则.定义.场景约束, 场景.共同场景);
                项.动作作用范围包含 = 动作范围包含(
                    规则.定义.动作作用范围约束,
                    请求.完整有序冻结动作范围);
                if (项.适用()) 结果.适用规则事实身份组.push_back(规则.身份);
                见证.覆盖项组.push_back(项);
            }
            结果.完整集合见证 = std::move(见证);
            结果.本次正式读回截止 = 当前.截止;
            if (!结果.成功())
                return 失败(L2任务现实执行硬否决规则全集读取状态_v2::适用性未裁定);
            return 结果;
        } catch (const std::bad_alloc&) {
            return 失败(L2任务现实执行硬否决规则全集读取状态_v2::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2任务现实执行硬否决规则全集读取状态_v2::资源失败);
        } catch (...) {
            return 失败(L2任务现实执行硬否决规则全集读取状态_v2::内部错误);
        }
    }

private:
    struct 写集布局 final {
        std::uint32_t 宇宙节点键 = 0;
        std::vector<std::uint32_t> 规则节点键组;
    };

    enum class 共同场景状态 : std::uint8_t {
        成功, 许可拒绝, 当前性漂移, 场景范围不闭合, 资源失败, 内部错误
    };

    struct 共同场景结果 final {
        共同场景状态 状态 = 共同场景状态::内部错误;
        std::optional<L2场景身份> 共同场景;
    };

    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 服务,
        L2任务现实执行硬否决规则结构所有者交付& 交付) {
        if (!交付.有效() || !交付.绑定于(服务))
            throw std::invalid_argument("invalid L2 hard denial owner delivery");
        return std::move(交付.写入端口_);
    }

    static bool 版本迁移有效(
        const L2任务现实执行硬否决规则宇宙发布请求_v2& 请求,
        const std::optional<L2任务现实执行硬否决规则宇宙事实_v2>& 当前) noexcept {
        if (!当前) {
            return 请求.新规则版本 == 1 && 请求.新成员集合版本 == 1
                && 请求.切换原因
                    == L2任务现实执行硬否决规则版本切换原因_v2::首次发布;
        }
        if (请求.切换原因
            == L2任务现实执行硬否决规则版本切换原因_v2::首次发布)
            return false;
        if (当前->规则版本 == std::numeric_limits<std::uint64_t>::max()
            || 当前->成员集合版本 == std::numeric_limits<std::uint64_t>::max())
            return false;
        return 请求.新规则版本 == 当前->规则版本 + 1
            && 请求.新成员集合版本 == 当前->成员集合版本 + 1;
    }

    static std::vector<std::uint64_t> 编码范围(
        const std::vector<任务动作作用范围>& 组) {
        std::vector<std::uint64_t> 结果;
        结果.reserve(组.size());
        for (const auto 值 : 组)
            结果.push_back(static_cast<std::uint64_t>(值));
        return 结果;
    }

    L1所有者范围写集请求 形成发布写集(
        const L2任务现实执行硬否决规则宇宙发布请求_v2& 请求,
        const std::vector<L2任务现实执行硬否决规则定义材料_v2>& 规则组,
        const std::vector<稳定编码>& 旧退出事实, 写集布局& 布局) const {
        using namespace L2任务现实执行硬否决规则结构内部;
        L1所有者范围写集请求 写集;
        写集.期望事实代次 = 请求.请求头.期望事实代次;
        写集.写入幂等身份 = {请求.幂等身份.值};
        std::uint32_t 下一个 = 1;
        布局 = {};
        布局.宇宙节点键 = 下一个++;
        const auto 宇宙键 = 键(布局.宇宙节点键);
        写集.节点.push_back({宇宙键, 节点种类::普通, std::nullopt});
        auto 加属性 = [&](L1所有者范围事实引用 节点, 稳定编码 类型,
            std::vector<std::uint64_t> 材料, L1所有者范围事实引用 来源) {
            const auto 值键 = 键(下一个++);
            写集.值.push_back({值键, 节点, 类型, std::move(材料), 来源});
            写集.属性槽变更.push_back({节点, 类型, 值键});
        };
        加属性(宇宙键, 登记_.宇宙规则版本, {请求.新规则版本}, 宇宙键);
        加属性(宇宙键, 登记_.成员集合版本, {请求.新成员集合版本}, 宇宙键);
        加属性(宇宙键, 登记_.版本切换原因,
            {static_cast<std::uint64_t>(请求.切换原因)}, 宇宙键);
        加属性(宇宙键, 登记_.切换依据事件, {请求.切换依据事件.值}, 宇宙键);
        写集.关系.push_back({键(下一个++), 登记_.宇宙登记锚点, 宇宙键,
            登记_.当前宇宙版本关系, 1});

        布局.规则节点键组.reserve(规则组.size());
        for (std::size_t i = 0; i < 规则组.size(); ++i) {
            const auto& 定义 = 规则组[i];
            const auto 规则节点值 = 下一个++;
            布局.规则节点键组.push_back(规则节点值);
            const auto 规则键 = 键(规则节点值);
            写集.节点.push_back({规则键, 节点种类::普通, std::nullopt});
            加属性(规则键, 登记_.规则语义身份, {定义.语义身份.值.值}, 规则键);
            加属性(规则键, 登记_.self约束模式,
                {static_cast<std::uint64_t>(定义.self约束.模式)}, 规则键);
            加属性(规则键, 登记_.场景约束模式,
                {static_cast<std::uint64_t>(定义.场景约束.模式)}, 规则键);
            加属性(规则键, 登记_.动作作用范围,
                编码范围(定义.动作作用范围约束.包含范围), 规则键);
            std::vector<std::uint64_t> 来源;
            来源.reserve(定义.归一物理来源事实组.size());
            for (const auto 值 : 定义.归一物理来源事实组) 来源.push_back(值.值);
            加属性(规则键, 登记_.物理来源事实, std::move(来源), 规则键);
            写集.关系.push_back({键(下一个++), 宇宙键, 规则键,
                登记_.宇宙成员关系, static_cast<std::int64_t>(i + 1)});
            for (std::size_t j = 0; j < 定义.self约束.成员.size(); ++j)
                写集.关系.push_back({键(下一个++), 规则键,
                    定义.self约束.成员[j].值, 登记_.self约束成员关系,
                    static_cast<std::int64_t>(j + 1)});
            for (std::size_t j = 0; j < 定义.场景约束.成员.size(); ++j)
                写集.关系.push_back({键(下一个++), 规则键,
                    定义.场景约束.成员[j].值, 登记_.场景约束成员关系,
                    static_cast<std::int64_t>(j + 1)});
        }
        写集.退出事实 = 旧退出事实;
        std::sort(写集.退出事实.begin(), 写集.退出事实.end());
        写集.退出事实.erase(
            std::unique(写集.退出事实.begin(), 写集.退出事实.end()),
            写集.退出事实.end());
        return 写集;
    }

    static std::optional<稳定编码> 解析引用(
        const L1所有者范围事实引用& 引用,
        const std::vector<std::pair<L1所有者范围写集本地键, 稳定编码>>& 映射) noexcept {
        if (const auto* 稳定 = std::get_if<稳定编码>(&引用)) return *稳定;
        const auto* 本地 = std::get_if<L1所有者范围写集本地键>(&引用);
        return 本地 ? L2任务现实执行硬否决规则结构内部::查找映射(
            映射, 本地->值) : std::nullopt;
    }

    bool 验证历史事实与退出(
        const L1所有者范围写集请求& 写集,
        const L1所有者范围写入结果& 写入) const {
        const auto G1 = 写入.事实代次;
        for (const auto& 节点 : 写集.节点) {
            const auto 编码 = L2任务现实执行硬否决规则结构内部::查找映射(
                写入.新编码映射, 节点.本地键.值);
            if (!编码) return false;
            const auto 读 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, *编码});
            const auto* 事实 = 读.事实 ? std::get_if<L1所有者范围节点事实>(&*读.事实) : nullptr;
            if (读.状态 != L1所有者范围读取状态::成功 || !事实
                || 事实->编码 != *编码 || 事实->种类 != 节点.种类
                || 事实->属性类型表示 != 节点.属性类型表示
                || 事实->写入所有者 != 第一层写入端口_.所有者身份()
                || 事实->创建事实代次 != G1
                || (事实->退出事实代次 && *事实->退出事实代次 <= G1))
                return false;
        }
        for (const auto& 值 : 写集.值) {
            const auto 编码 = L2任务现实执行硬否决规则结构内部::查找映射(
                写入.新编码映射, 值.本地键.值);
            const auto 所属 = 解析引用(值.所属节点, 写入.新编码映射);
            const auto 类型 = 解析引用(值.属性类型节点, 写入.新编码映射);
            const auto 来源 = 解析引用(值.来源节点, 写入.新编码映射);
            if (!编码 || !所属 || !类型 || !来源) return false;
            const auto 读 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, *编码});
            const auto* 事实 = 读.事实 ? std::get_if<L1所有者范围值事实>(&*读.事实) : nullptr;
            if (读.状态 != L1所有者范围读取状态::成功 || !事实
                || 事实->编码 != *编码 || 事实->所属节点 != *所属
                || 事实->属性类型节点 != *类型 || 事实->来源节点 != *来源
                || 事实->材料 != 值.材料
                || 事实->写入所有者 != 第一层写入端口_.所有者身份()
                || 事实->创建事实代次 != G1
                || (事实->退出事实代次 && *事实->退出事实代次 <= G1))
                return false;
        }
        for (const auto& 关系 : 写集.关系) {
            const auto 编码 = L2任务现实执行硬否决规则结构内部::查找映射(
                写入.新编码映射, 关系.本地键.值);
            const auto 源 = 解析引用(关系.源节点, 写入.新编码映射);
            const auto 目标 = 解析引用(关系.目标节点, 写入.新编码映射);
            const auto 类型 = 解析引用(关系.关系类型节点, 写入.新编码映射);
            if (!编码 || !源 || !目标 || !类型) return false;
            const auto 读 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, *编码});
            const auto* 事实 = 读.事实 ? std::get_if<L1所有者范围关系事实>(&*读.事实) : nullptr;
            if (读.状态 != L1所有者范围读取状态::成功 || !事实
                || 事实->编码 != *编码 || 事实->源节点 != *源
                || 事实->目标节点 != *目标 || 事实->关系类型节点 != *类型
                || 事实->角色或顺序 != 关系.角色或顺序
                || 事实->写入所有者 != 第一层写入端口_.所有者身份()
                || 事实->创建事实代次 != G1
                || (事实->退出事实代次 && *事实->退出事实代次 <= G1))
                return false;
        }
        for (const auto 编码 : 写集.退出事实) {
            const auto 读 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
            if (读.状态 != L1所有者范围读取状态::成功 || !读.事实) return false;
            bool 已退出 = std::visit([&](const auto& 事实) {
                return 事实.退出事实代次 && *事实.退出事实代次 == G1;
            }, *读.事实);
            if (!已退出) return false;
        }
        return true;
    }

    L2任务现实执行硬否决规则宇宙发布结果_v2 读取提交版本历史(
        const L2任务现实执行硬否决规则宇宙发布请求_v2& 请求,
        const std::vector<L2任务现实执行硬否决规则定义材料_v2>& 规则组,
        const L1所有者范围写集请求& 写集, const 写集布局& 布局,
        const L1所有者范围写入结果& 写入) const {
        L2任务现实执行硬否决规则宇宙发布结果_v2 失败;
        if (写入.事实代次 == 0 || 写入.新编码映射.empty()) return 失败;
        const auto 前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (前.状态 != L1中性读取状态::成功 || 前.事实代次 < 写入.事实代次)
            return 失败;
        if (!验证历史事实与退出(写集, 写入)) return 失败;
        const auto 宇宙编码 = L2任务现实执行硬否决规则结构内部::查找映射(
            写入.新编码映射, 布局.宇宙节点键);
        if (!宇宙编码 || 布局.规则节点键组.size() != 规则组.size()) return 失败;

        L2任务现实执行硬否决规则宇宙发布结果_v2 结果;
        结果.宇宙 = L2任务现实执行硬否决规则宇宙事实_v2{
            {*宇宙编码}, 请求.新规则版本, 请求.新成员集合版本, {},
            {写入.事实代次, std::nullopt}};
        for (std::size_t i = 0; i < 规则组.size(); ++i) {
            const auto 规则编码 = L2任务现实执行硬否决规则结构内部::查找映射(
                写入.新编码映射, 布局.规则节点键组[i]);
            if (!规则编码) return 失败;
            结果.宇宙->规范成员语义身份组.push_back(规则组[i].语义身份);
            结果.完整规则组.push_back({{*规则编码}, {*宇宙编码},
                请求.新规则版本, 请求.新成员集合版本, 规则组[i],
                {写入.事实代次, std::nullopt}});
        }
        const auto 后 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (后.状态 != L1中性读取状态::成功 || 后.事实代次 != 前.事实代次)
            return 失败;
        结果.本次正式读回截止 = 写入.事实代次;
        结果.状态 = L2任务现实执行硬否决规则宇宙发布状态_v2::已发布;
        return 结果;
    }

    L2任务现实执行硬否决规则结构内部::当前宇宙读取
    读取当前宇宙_已锁定(std::uint64_t 截止) const {
        using namespace L2任务现实执行硬否决规则结构内部;
        当前宇宙读取 输出;
        L1所有者范围一致当前读取请求 当前请求;
        当前请求.期望事实代次 = 截止;
        当前请求.所有者 = {第一层写入端口_.所有者身份()};
        当前请求.节点 = {登记_.宇宙登记锚点};
        当前请求.源关系组 = {{登记_.宇宙登记锚点, 登记_.当前宇宙版本关系}};
        const auto 当前读 = L1_.尝试读取所有者范围一致当前投影(当前请求);
        输出.截止 = 当前读.读取事实代次;
        if (当前读.状态 == L1所有者范围一致当前读取状态::事实代次漂移) {
            输出.状态 = 当前宇宙状态::当前性漂移; return 输出;
        }
        if (当前读.状态 == L1所有者范围一致当前读取状态::许可拒绝) {
            输出.状态 = 当前宇宙状态::许可拒绝; return 输出;
        }
        if (当前读.状态 == L1所有者范围一致当前读取状态::资源失败) {
            输出.状态 = 当前宇宙状态::资源失败; return 输出;
        }
        if (当前读.状态 != L1所有者范围一致当前读取状态::成功
            || 当前读.读取事实代次 != 截止 || 当前读.源关系组.size() != 1U) {
            输出.状态 = 当前宇宙状态::内部错误; return 输出;
        }
        const auto& 当前组 = 当前读.源关系组.front().成员;
        if (当前组.empty()) { 输出.状态 = 当前宇宙状态::未发布; return 输出; }
        if (当前组.size() != 1U) {
            输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
        }
        const auto& 当前关系 = 当前组.front();
        if (当前关系.关系.源节点 != 登记_.宇宙登记锚点
            || 当前关系.关系.关系类型节点 != 登记_.当前宇宙版本关系
            || 当前关系.关系.写入所有者 != 第一层写入端口_.所有者身份()
            || 当前关系.关系.角色或顺序 != 1
            || !活动于({当前关系.关系.创建事实代次,
                当前关系.关系.退出事实代次}, 截止)) {
            输出.状态 = 当前宇宙状态::引用冲突; return 输出;
        }
        const auto 宇宙编码 = 当前关系.对端节点.编码;
        输出.退出事实.push_back(当前关系.关系.编码);

        L1所有者范围一致关系类型闭包读取请求 请求;
        请求.期望事实代次 = 截止;
        请求.所有者 = {第一层写入端口_.所有者身份()};
        请求.节点 = {宇宙编码};
        请求.属性值 = {{宇宙编码, 登记_.宇宙规则版本},
            {宇宙编码, 登记_.成员集合版本},
            {宇宙编码, 登记_.版本切换原因},
            {宇宙编码, 登记_.切换依据事件}};
        L1所有者范围一致关系类型闭包选择项 闭包;
        闭包.入口关系类型节点 = 登记_.宇宙成员关系;
        闭包.源节点属性类型 = {登记_.宇宙规则版本, 登记_.成员集合版本,
            登记_.版本切换原因, 登记_.切换依据事件};
        闭包.目标节点属性类型 = {登记_.规则语义身份, 登记_.self约束模式,
            登记_.场景约束模式, 登记_.动作作用范围, 登记_.物理来源事实};
        闭包.目标节点源关系类型 = {
            登记_.self约束成员关系, 登记_.场景约束成员关系};
        请求.关系类型闭包 = {std::move(闭包)};
        const auto 读取 = L1_.尝试读取所有者范围一致关系类型闭包投影(请求);
        输出.截止 = 读取.读取事实代次;
        if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移) {
            输出.状态 = 当前宇宙状态::当前性漂移; return 输出;
        }
        if (读取.状态 == L1所有者范围一致当前读取状态::许可拒绝) {
            输出.状态 = 当前宇宙状态::许可拒绝; return 输出;
        }
        if (读取.状态 == L1所有者范围一致当前读取状态::资源失败) {
            输出.状态 = 当前宇宙状态::资源失败; return 输出;
        }
        if (读取.状态 != L1所有者范围一致当前读取状态::成功
            || 读取.读取事实代次 != 截止 || 读取.节点.size() != 1U
            || 读取.关系类型闭包.size() != 1U
            || 读取.节点.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.节点.front().事实
            || 读取.关系类型闭包.front().状态
                != L1所有者范围一致当前读取项目状态::成功) {
            输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
        }
        const auto& 宇宙节点 = *读取.节点.front().事实;
        if (宇宙节点.编码 != 宇宙编码
            || 宇宙节点.写入所有者 != 第一层写入端口_.所有者身份()
            || !活动于({宇宙节点.创建事实代次, 宇宙节点.退出事实代次}, 截止)) {
            输出.状态 = 当前宇宙状态::引用冲突; return 输出;
        }

        const auto 读取单数 = [&](稳定编码 类型, std::uint64_t& 值) {
            const auto* 投影 = 查找属性投影(读取.属性值, 宇宙编码, 类型);
            const auto* 载荷 = 投影 ? U64载荷(投影->当前值事实) : nullptr;
            if (!投影 || !载荷 || 载荷->size() != 1U || (*载荷)[0] == 0
                || 投影->当前值事实.写入所有者 != 第一层写入端口_.所有者身份()
                || 投影->当前值事实.来源节点 != 宇宙编码
                || !活动于({投影->当前值事实.创建事实代次,
                    投影->当前值事实.退出事实代次}, 截止))
                return false;
            值 = (*载荷)[0];
            输出.退出事实.push_back(投影->当前值事实.编码);
            return true;
        };
        std::uint64_t 规则版本 = 0, 成员版本 = 0, 原因 = 0, 事件 = 0;
        if (!读取单数(登记_.宇宙规则版本, 规则版本)
            || !读取单数(登记_.成员集合版本, 成员版本)
            || !读取单数(登记_.版本切换原因, 原因)
            || !读取单数(登记_.切换依据事件, 事件)
            || !切换原因有效(
                static_cast<L2任务现实执行硬否决规则版本切换原因_v2>(原因))) {
            输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
        }

        struct 有序规则 final {
            std::int64_t 顺序 = 0;
            L2任务现实执行硬否决规则事实_v2 事实;
        };
        std::vector<有序规则> 有序组;
        const auto& 闭包结果 = 读取.关系类型闭包.front();
        for (const auto& 成员 : 闭包结果.成员) {
            if (成员.源节点.编码 != 宇宙编码) {
                输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
            }
            const auto 规则编码 = 成员.目标节点.编码;
            if (成员.关系.关系类型节点 != 登记_.宇宙成员关系
                || 成员.关系.写入所有者 != 第一层写入端口_.所有者身份()
                || 成员.关系.角色或顺序 <= 0
                || 成员.目标节点.写入所有者 != 第一层写入端口_.所有者身份()
                || !活动于({成员.关系.创建事实代次,
                    成员.关系.退出事实代次}, 截止)
                || !活动于({成员.目标节点.创建事实代次,
                    成员.目标节点.退出事实代次}, 截止)) {
                输出.状态 = 当前宇宙状态::引用冲突; return 输出;
            }
            const auto 取规则载荷 = [&](稳定编码 类型,
                const std::vector<std::uint64_t>*& 载荷,
                const L1所有者范围值事实*& 值事实) {
                const auto* 投影 = 查找属性投影(
                    成员.目标节点属性值, 规则编码, 类型);
                载荷 = 投影 ? U64载荷(投影->当前值事实) : nullptr;
                值事实 = 投影 ? &投影->当前值事实 : nullptr;
                return 载荷 && 值事实
                    && 值事实->写入所有者 == 第一层写入端口_.所有者身份()
                    && 值事实->来源节点 == 规则编码
                    && 活动于({值事实->创建事实代次,
                        值事实->退出事实代次}, 截止);
            };
            const std::vector<std::uint64_t> *语义载荷, *self模式载荷,
                *场景模式载荷, *范围载荷, *来源载荷;
            const L1所有者范围值事实 *语义值, *self模式值, *场景模式值,
                *范围值, *来源值;
            if (!取规则载荷(登记_.规则语义身份, 语义载荷, 语义值)
                || !取规则载荷(登记_.self约束模式, self模式载荷, self模式值)
                || !取规则载荷(登记_.场景约束模式, 场景模式载荷, 场景模式值)
                || !取规则载荷(登记_.动作作用范围, 范围载荷, 范围值)
                || !取规则载荷(登记_.物理来源事实, 来源载荷, 来源值)
                || 语义载荷->size() != 1U || self模式载荷->size() != 1U
                || 场景模式载荷->size() != 1U) {
                输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
            }
            L2任务现实执行硬否决规则定义材料_v2 定义;
            定义.语义身份 = {稳定编码{语义载荷->front()}};
            定义.self约束.模式 = static_cast<L2硬否决约束模式>(
                self模式载荷->front());
            定义.场景约束.模式 = static_cast<L2硬否决约束模式>(
                场景模式载荷->front());
            for (const auto 值 : *范围载荷)
                定义.动作作用范围约束.包含范围.push_back(
                    static_cast<任务动作作用范围>(值));
            for (const auto 值 : *来源载荷)
                定义.归一物理来源事实组.push_back({值});

            const auto* self组 = 查找源关系组(成员.目标节点源关系组,
                规则编码, 登记_.self约束成员关系);
            const auto* 场景组 = 查找源关系组(成员.目标节点源关系组,
                规则编码, 登记_.场景约束成员关系);
            if (!self组 || !场景组) {
                输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
            }
            auto 读取约束成员 = [&](const auto& 关系组, auto& 目标组,
                稳定编码 类型) {
                using 目标类型 = typename std::decay_t<decltype(目标组)>::value_type;
                std::vector<std::pair<std::int64_t, 目标类型>> 临时;
                for (const auto& 关系项 : 关系组.成员) {
                    if (关系项.关系.源节点 != 规则编码
                        || 关系项.关系.关系类型节点 != 类型
                        || 关系项.关系.写入所有者 != 第一层写入端口_.所有者身份()
                        || 关系项.关系.角色或顺序 <= 0
                        || !活动于({关系项.关系.创建事实代次,
                            关系项.关系.退出事实代次}, 截止))
                        return false;
                    临时.push_back({关系项.关系.角色或顺序,
                        目标类型{关系项.对端节点.编码}});
                    输出.退出事实.push_back(关系项.关系.编码);
                }
                std::sort(临时.begin(), 临时.end(), [](const auto& 左, const auto& 右) {
                    return 左.first < 右.first;
                });
                for (std::size_t i = 0; i < 临时.size(); ++i) {
                    if (临时[i].first != static_cast<std::int64_t>(i + 1)) return false;
                    目标组.push_back(临时[i].second);
                }
                return true;
            };
            if (!读取约束成员(*self组, 定义.self约束.成员,
                    登记_.self约束成员关系)
                || !读取约束成员(*场景组, 定义.场景约束.成员,
                    登记_.场景约束成员关系)
                || !定义材料有效(定义)) {
                输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
            }
            输出.退出事实.insert(输出.退出事实.end(),
                {成员.关系.编码, 规则编码, 语义值->编码, self模式值->编码,
                    场景模式值->编码, 范围值->编码, 来源值->编码});
            有序组.push_back({成员.关系.角色或顺序,
                {{规则编码}, {宇宙编码}, 规则版本, 成员版本,
                    std::move(定义),
                    {成员.目标节点.创建事实代次,
                        成员.目标节点.退出事实代次}}});
        }
        std::sort(有序组.begin(), 有序组.end(), [](const auto& 左, const auto& 右) {
            return 左.顺序 < 右.顺序;
        });
        L2任务现实执行硬否决规则宇宙事实_v2 宇宙{{宇宙编码},
            规则版本, 成员版本, {},
            {宇宙节点.创建事实代次, 宇宙节点.退出事实代次}};
        std::uint64_t 前语义 = 0;
        for (std::size_t i = 0; i < 有序组.size(); ++i) {
            if (有序组[i].顺序 != static_cast<std::int64_t>(i + 1)
                || 有序组[i].事实.定义.语义身份.值.值 <= 前语义) {
                输出.状态 = 当前宇宙状态::规则宇宙不闭合; return 输出;
            }
            前语义 = 有序组[i].事实.定义.语义身份.值.值;
            宇宙.规范成员语义身份组.push_back(有序组[i].事实.定义.语义身份);
            输出.规则组.push_back(std::move(有序组[i].事实));
        }
        输出.退出事实.push_back(宇宙编码);
        std::sort(输出.退出事实.begin(), 输出.退出事实.end());
        输出.退出事实.erase(
            std::unique(输出.退出事实.begin(), 输出.退出事实.end()),
            输出.退出事实.end());
        输出.宇宙 = std::move(宇宙);
        输出.状态 = 当前宇宙状态::成功;
        return 输出;
    }

    共同场景结果 验证共同作用场景(
        const L2任务现实执行硬否决规则全集读取请求_v2& 请求) const {
        共同场景结果 结果{共同场景状态::成功, std::nullopt};
        std::vector<L2存在身份> 必须成员{请求.自我};
        for (const auto& 动作 : 请求.完整有序冻结动作范围) {
            if (动作.作用范围 != 任务动作作用范围::现实改变) continue;
            if (!动作.作用场景) return {共同场景状态::场景范围不闭合, std::nullopt};
            if (!结果.共同场景) 结果.共同场景 = *动作.作用场景;
            else if (*结果.共同场景 != *动作.作用场景)
                return {共同场景状态::场景范围不闭合, std::nullopt};
            必须成员.push_back(动作.作用主体);
        }
        if (!结果.共同场景) return 结果;
        std::sort(必须成员.begin(), 必须成员.end(), [](const auto& 左, const auto& 右) {
            return 左.值.值 < 右.值.值;
        });
        必须成员.erase(std::unique(必须成员.begin(), 必须成员.end()), 必须成员.end());
        const auto 读取 = 场景服务_.读取完整场景({请求.请求头,
            L2读取类别::当前, *结果.共同场景, 0});
        if (读取.结果头.状态 != L2结构状态::已读取
            || 读取.结果头.事实截止代次 != 请求.请求头.期望事实代次
            || !读取.场景 || 读取.场景->身份 != *结果.共同场景)
            return {映射场景读取失败(读取.结果头.状态), std::nullopt};
        for (const auto 身份 : 必须成员) {
            const auto 数量 = std::count_if(读取.场景->直接成员.begin(),
                读取.场景->直接成员.end(), [&](const auto& 关系) {
                    return 关系.场景 == *结果.共同场景 && 关系.存在 == 身份
                        && L2任务现实执行硬否决规则结构内部::活动于(
                            关系.生命周期, 请求.请求头.期望事实代次);
                });
            if (数量 != 1)
                return {共同场景状态::场景范围不闭合, std::nullopt};
        }
        return 结果;
    }

    static 共同场景状态 映射场景读取失败(L2结构状态 状态) noexcept {
        switch (状态) {
        case L2结构状态::许可拒绝: return 共同场景状态::许可拒绝;
        case L2结构状态::事实代次漂移: return 共同场景状态::当前性漂移;
        case L2结构状态::资源失败: return 共同场景状态::资源失败;
        case L2结构状态::内部不一致: return 共同场景状态::内部错误;
        default: return 共同场景状态::场景范围不闭合;
        }
    }

    static L2任务现实执行硬否决规则全集读取状态_v2 映射共同场景状态(
        共同场景状态 状态) noexcept {
        switch (状态) {
        case 共同场景状态::许可拒绝:
            return L2任务现实执行硬否决规则全集读取状态_v2::许可拒绝;
        case 共同场景状态::当前性漂移:
            return L2任务现实执行硬否决规则全集读取状态_v2::当前性漂移;
        case 共同场景状态::场景范围不闭合:
            return L2任务现实执行硬否决规则全集读取状态_v2::场景范围不闭合;
        case 共同场景状态::资源失败:
            return L2任务现实执行硬否决规则全集读取状态_v2::资源失败;
        default:
            return L2任务现实执行硬否决规则全集读取状态_v2::内部错误;
        }
    }

    static bool self匹配(const L2硬否决self约束_v2& 约束,
        L2存在身份 自我) noexcept {
        return 约束.模式 == L2硬否决约束模式::任意
            || std::binary_search(约束.成员.begin(), 约束.成员.end(), 自我,
                [](const auto& 左, const auto& 右) {
                    return 左.值.值 < 右.值.值;
                });
    }

    static bool 场景匹配(const L2硬否决场景约束_v2& 约束,
        const std::optional<L2场景身份>& 共同场景) noexcept {
        if (约束.模式 == L2硬否决约束模式::任意) return true;
        return 共同场景 && std::binary_search(
            约束.成员.begin(), 约束.成员.end(), *共同场景,
            [](const auto& 左, const auto& 右) {
                return 左.值.值 < 右.值.值;
            });
    }

    static bool 动作范围包含(const L2硬否决动作作用范围约束_v2& 约束,
        const std::vector<任务冻结动作项>& 动作组) noexcept {
        for (const auto& 动作 : 动作组) {
            if (动作.作用范围 != 任务动作作用范围::现实改变) continue;
            if (!std::binary_search(约束.包含范围.begin(), 约束.包含范围.end(),
                    动作.作用范围, [](const auto 左, const auto 右) {
                        return static_cast<std::uint8_t>(左)
                            < static_cast<std::uint8_t>(右);
                    }))
                return false;
        }
        return true;
    }

    static L2任务现实执行硬否决规则宇宙发布状态_v2 映射当前宇宙到发布状态(
        L2任务现实执行硬否决规则结构内部::当前宇宙状态 状态) noexcept {
        using S = L2任务现实执行硬否决规则结构内部::当前宇宙状态;
        switch (状态) {
        case S::当前性漂移:
            return L2任务现实执行硬否决规则宇宙发布状态_v2::当前性漂移;
        case S::许可拒绝:
            return L2任务现实执行硬否决规则宇宙发布状态_v2::许可拒绝;
        case S::规则宇宙不闭合:
            return L2任务现实执行硬否决规则宇宙发布状态_v2::规则集合不闭合;
        case S::引用冲突:
            return L2任务现实执行硬否决规则宇宙发布状态_v2::引用冲突;
        case S::资源失败:
            return L2任务现实执行硬否决规则宇宙发布状态_v2::资源失败;
        default:
            return L2任务现实执行硬否决规则宇宙发布状态_v2::内部错误;
        }
    }

    static L2任务现实执行硬否决规则全集读取状态_v2 映射当前宇宙到读取状态(
        L2任务现实执行硬否决规则结构内部::当前宇宙状态 状态) noexcept {
        using S = L2任务现实执行硬否决规则结构内部::当前宇宙状态;
        switch (状态) {
        case S::未发布:
            return L2任务现实执行硬否决规则全集读取状态_v2::未发布;
        case S::当前性漂移:
            return L2任务现实执行硬否决规则全集读取状态_v2::当前性漂移;
        case S::许可拒绝:
            return L2任务现实执行硬否决规则全集读取状态_v2::许可拒绝;
        case S::规则宇宙不闭合:
            return L2任务现实执行硬否决规则全集读取状态_v2::规则宇宙不闭合;
        case S::引用冲突:
            return L2任务现实执行硬否决规则全集读取状态_v2::引用冲突;
        case S::资源失败:
            return L2任务现实执行硬否决规则全集读取状态_v2::资源失败;
        default:
            return L2任务现实执行硬否决规则全集读取状态_v2::内部错误;
        }
    }

    const L1事实基座服务& L1_;
    const L2场景结构服务& 场景服务_;
    L1所有者范围写端口 第一层写入端口_;
    L2任务现实执行硬否决规则结构内部::结构登记定位 登记_;
    mutable std::mutex 互斥体_;
};

} // namespace 海中鱼巣
