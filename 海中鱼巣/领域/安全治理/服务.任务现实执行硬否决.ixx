module;

#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <vector>

#define TASK_REALITY_EXECUTION_HARD_DENIAL_NO_INCLUDES

export module 海中鱼巣.领域.安全治理.服务.任务现实执行硬否决;

export import 海中鱼巣.领域.服务.L2任务结构;
export import 海中鱼巣.领域.安全治理.服务.L2任务现实执行硬否决规则结构;

export {
#include "任务现实执行硬否决.数据.h"
}

export namespace 海中鱼巣 {

class 任务现实执行硬否决提供者 final {
public:
    任务现实执行硬否决结果 复核任务现实执行硬否决(
        const 任务现实执行硬否决请求& 请求) const noexcept {
        const auto 失败 = [&](任务现实执行硬否决状态 状态) {
            任务现实执行硬否决结果 结果;
            结果.状态 = 状态;
            结果.复核阶段 = 请求.复核阶段;
            结果.现实影响 = 请求.现实影响;
            return 结果;
        };
        try {
            任务现实执行硬否决作用范围证据 范围;
            if (!形成作用范围证据(请求, 范围))
                return 失败(任务现实执行硬否决状态::材料不足);

            任务现实执行硬否决结果 结果;
            结果.复核阶段 = 请求.复核阶段;
            结果.现实影响 = 请求.现实影响;
            结果.作用范围证据 = 范围;
            结果.本次裁决截止 = 请求.来源共同事实截止;

            if (请求.现实影响 == 任务现实影响分类::零现实改变) {
                结果.状态 = 任务现实执行硬否决状态::不适用;
                return 结果;
            }

            if (!正式规则全集有效(请求.正式规则全集, 请求.来源共同事实截止))
                return 失败(任务现实执行硬否决状态::材料不足);
            const auto& 全集 = 请求.正式规则全集;
            结果.安全读回见证 = 任务现实执行硬否决安全读回见证{
                全集.宇宙->宇宙, 全集.宇宙->规则版本,
                全集.宇宙->成员集合版本, 全集.适用规则事实身份组,
                *全集.完整集合见证, 请求.来源共同事实截止};
            if (全集.适用规则事实身份组.empty()) {
                结果.状态 = 任务现实执行硬否决状态::未命中;
            } else {
                结果.状态 = 任务现实执行硬否决状态::已命中;
                结果.命中证据 = 全集.适用规则事实身份组;
            }
            if (!结果.结果形状有效())
                return 失败(任务现实执行硬否决状态::内部错误);
            return 结果;
        } catch (const std::bad_alloc&) {
            return 失败(任务现实执行硬否决状态::资源失败);
        } catch (...) {
            return 失败(任务现实执行硬否决状态::内部错误);
        }
    }

private:
    static bool 形成作用范围证据(const 任务现实执行硬否决请求& 请求,
        任务现实执行硬否决作用范围证据& 证据) noexcept {
        if (请求.合同版本 != 任务现实执行硬否决合同版本
            || (请求.复核阶段 != 任务现实执行硬否决复核阶段::授权前预检
                && 请求.复核阶段 != 任务现实执行硬否决复核阶段::动作前最终复核)
            || !有效(请求.自我.值) || !有效(请求.任务.值)
            || !有效(请求.任务轮次.值) || !有效(请求.筹办轮次.值)
            || !有效(请求.执行轮次.值) || !有效(请求.冻结.值)
            || 请求.冻结版本 == 0 || !有效(请求.实例方法.值)
            || !有效(请求.方法.值) || !有效(请求.方法内容版本)
            || 请求.完整有序冻结动作范围.empty()
            || 请求.来源共同事实截止 == 0)
            return false;

        证据.冻结 = 请求.冻结;
        证据.冻结版本 = 请求.冻结版本;
        证据.动作总数 = 请求.完整有序冻结动作范围.size();
        证据.作用范围正式读回截止 = 请求.来源共同事实截止;
        for (std::size_t i = 0; i < 请求.完整有序冻结动作范围.size(); ++i) {
            const auto& 动作 = 请求.完整有序冻结动作范围[i];
            if (动作.顺序 != i + 1 || !有效(动作.动作入口.值)
                || !L2方法稳定动作键有效(动作.稳定动作键)
                || !有效(动作.作用主体.值) || !有效(动作.动作范围材料)
                || !有效(动作.预期结果材料)
                || !有效(动作.结果验证合同)
                || !有效(动作.动作归因合同)
                || (动作.作用场景 && !有效(动作.作用场景->值)))
                return false;
            switch (动作.作用范围) {
            case 任务动作作用范围::内部治理: ++证据.内部治理动作数; break;
            case 任务动作作用范围::纯现实观察: ++证据.纯观察动作数; break;
            case 任务动作作用范围::现实改变: ++证据.现实改变动作数; break;
            default: return false;
            }
        }
        if (证据.内部治理动作数 + 证据.纯观察动作数 + 证据.现实改变动作数
            != 证据.动作总数)
            return false;
        if (请求.现实影响 == 任务现实影响分类::零现实改变)
            return 证据.现实改变动作数 == 0;
        if (请求.现实影响 == 任务现实影响分类::含现实改变)
            return 证据.现实改变动作数 != 0;
        return false;
    }

    static bool 正式规则全集有效(
        const L2任务现实执行硬否决规则全集读取结果_v2& 全集,
        std::uint64_t Gnow) noexcept {
        if (!全集.成功() || 全集.本次正式读回截止 != Gnow
            || !全集.宇宙 || !全集.完整集合见证
            || 全集.完整集合见证->宇宙 != 全集.宇宙->宇宙
            || 全集.完整集合见证->规则版本 != 全集.宇宙->规则版本
            || 全集.完整集合见证->成员集合版本
                != 全集.宇宙->成员集合版本
            || 全集.完整集合见证->Gnow != Gnow
            || 全集.完整集合见证->声明成员数 != 全集.完整规则组.size())
            return false;
        std::uint64_t 前 = 0;
        for (const auto 身份 : 全集.适用规则事实身份组) {
            if (!有效(身份.值) || 身份.值.值 <= 前) return false;
            前 = 身份.值.值;
        }
        return true;
    }
};

} // namespace 海中鱼巣
