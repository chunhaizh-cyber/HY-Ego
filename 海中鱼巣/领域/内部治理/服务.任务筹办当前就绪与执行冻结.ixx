namespace 海中鱼巣::任务筹办当前就绪内部 {

任务筹办当前就绪结果 当前就绪失败(
    任务筹办当前就绪结论 结论,
    std::uint64_t 共同事实截止 = 0) noexcept {
    任务筹办当前就绪结果 结果;
    结果.结论 = 结论;
    结果.共同事实截止 = 共同事实截止;
    return 结果;
}

任务筹办推进结果 推进失败(
    任务筹办收束类别 类别,
    std::uint64_t 最终事实截止 = 0) noexcept {
    任务筹办推进结果 结果;
    结果.类别 = 类别;
    结果.最终事实截止 = 最终事实截止;
    任务筹办非成功承接材料 承接;
    承接.类别 = 类别;
    结果.非成功承接 = std::move(承接);
    return 结果;
}

constexpr 任务筹办当前就绪结论 映射当前就绪状态(
    L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::数量预算不足:
        return 任务筹办当前就绪结论::数量预算不足;
    case L2结构状态::事实代次漂移:
        return 任务筹办当前就绪结论::当前性漂移;
    case L2结构状态::引用冲突:
    case L2结构状态::幂等冲突:
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::属性未设置:
        return 任务筹办当前就绪结论::引用冲突;
    case L2结构状态::资源失败:
        return 任务筹办当前就绪结论::资源失败;
    case L2结构状态::入口拒绝:
    case L2结构状态::许可拒绝:
    case L2结构状态::未实现:
    case L2结构状态::内部不一致:
    case L2结构状态::已提交:
    case L2结构状态::精确重复:
    case L2结构状态::已读取:
    default:
        return 任务筹办当前就绪结论::内部错误;
    }
}

constexpr 任务筹办收束类别 映射推进状态(
    任务特征方法查找状态 状态) noexcept {
    switch (状态) {
    case 任务特征方法查找状态::数量预算不足:
        return 任务筹办收束类别::数量预算不足;
    case 任务特征方法查找状态::当前性漂移:
        return 任务筹办收束类别::当前性漂移;
    case 任务特征方法查找状态::引用冲突:
        return 任务筹办收束类别::引用冲突;
    case 任务特征方法查找状态::资源失败:
        return 任务筹办收束类别::资源失败;
    case 任务特征方法查找状态::入口拒绝:
    case 任务特征方法查找状态::内部错误:
    case 任务特征方法查找状态::已评估:
    default:
        return 任务筹办收束类别::内部错误;
    }
}

constexpr 任务筹办收束类别 映射推进结论(
    任务筹办当前就绪结论 结论) noexcept {
    switch (结论) {
    case 任务筹办当前就绪结论::当前性漂移:
        return 任务筹办收束类别::当前性漂移;
    case 任务筹办当前就绪结论::引用冲突:
        return 任务筹办收束类别::引用冲突;
    case 任务筹办当前就绪结论::数量预算不足:
        return 任务筹办收束类别::数量预算不足;
    case 任务筹办当前就绪结论::资源失败:
        return 任务筹办收束类别::资源失败;
    case 任务筹办当前就绪结论::内部错误:
        return 任务筹办收束类别::内部错误;
    default:
        return 任务筹办收束类别::合法等待;
    }
}

std::optional<std::uint8_t> 关系位(
    L2特征比较具名关系 关系) noexcept {
    switch (关系) {
    case L2特征比较具名关系::当前低于目标: return 0x01U;
    case L2特征比较具名关系::当前达到目标: return 0x02U;
    case L2特征比较具名关系::当前高于目标: return 0x04U;
    default: return std::nullopt;
    }
}

任务筹办当前就绪结论 比较状态与合同(
    const L2状态事实& 状态,
    L2特征定义身份 特征,
    L2目标状态合同身份 合同身份,
    std::uint64_t 请求身份,
    std::uint64_t 共同事实截止,
    const L2状态结构服务& 状态服务,
    const L2特征结构服务& 特征服务,
    L2特征比较具名关系& 具名关系,
    std::uint8_t& 允许关系位) {
    const L2结构请求头 请求头{L2结构合同版本, 共同事实截止};
    const auto 合同读取 = 状态服务.读取完整目标状态合同(
        {请求头, L2读取类别::当前, 合同身份, 0});
    if (合同读取.结果头.事实截止代次 != 共同事实截止)
        return 任务筹办当前就绪结论::当前性漂移;
    if (!合同读取.成功() || !合同读取.合同)
        return 映射当前就绪状态(合同读取.结果头.状态);
    const auto& 合同 = *合同读取.合同;
    if (合同.身份 != 合同身份 || 合同.特征定义 != 特征
        || 合同.比较用途 != L2特征比较用途::目标判断)
        return 任务筹办当前就绪结论::引用冲突;
    const auto 注册读取 = 特征服务.读取当前特征比较注册(
        {请求头, 特征, L2特征比较用途::目标判断});
    if (注册读取.结果头.事实截止代次 != 共同事实截止)
        return 任务筹办当前就绪结论::当前性漂移;
    if (!注册读取.成功() || !注册读取.注册)
        return 映射当前就绪状态(注册读取.结果头.状态);
    const auto& 注册 = *注册读取.注册;
    if (合同.比较注册 != 注册.身份 || 注册.特征定义 != 特征
        || !std::holds_alternative<std::int64_t>(
            状态.精确值.类型化不可变材料))
        return 任务筹办当前就绪结论::引用冲突;
    L2特征比较请求 比较请求;
    比较请求.请求头 = 请求头;
    比较请求.请求身份 = 请求身份;
    比较请求.特征定义 = 特征;
    比较请求.用途 = L2特征比较用途::目标判断;
    比较请求.预期算法族 = 注册.合同.算法族;
    比较请求.预期算法版本 = 注册.合同.算法版本;
    比较请求.左 = {状态.精确值.值稳定编码,
        状态.精确值.类型化不可变材料, 状态.精确值.来源稳定编码,
        状态.精确值.创建事实代次,
        {状态.精确值.创建事实代次, 状态.精确值.退出事实代次},
        L2特征比较原始类型::I64, 注册.合同.单位, 注册.合同.维度,
        注册.合同.分量角色, L2特征比较角色::当前事实};
    比较请求.右 = {合同.目标值稳定编码, L2原始值材料{合同.目标I64},
        合同.来源稳定编码, 合同.生命周期.创建事实代次,
        合同.生命周期, L2特征比较原始类型::I64, 注册.合同.单位,
        注册.合同.维度, 注册.合同.分量角色,
        L2特征比较角色::目标状态};
    比较请求.要求结果位 =
        static_cast<std::uint8_t>(L2特征比较结果要求::具名关系);
    const auto 比较 = 特征服务.比较特征(比较请求);
    if (比较.事实截止代次 != 共同事实截止
        || 比较.状态 == L2特征比较状态::版本漂移)
        return 任务筹办当前就绪结论::当前性漂移;
    if (比较.状态 == L2特征比较状态::资源失败)
        return 任务筹办当前就绪结论::资源失败;
    if (!比较.成功() || !比较.具名关系
        || 比较.注册身份 != 注册.身份)
        return 任务筹办当前就绪结论::内部错误;
    const auto 当前关系位 = 关系位(*比较.具名关系);
    if (!当前关系位) return 任务筹办当前就绪结论::内部错误;
    具名关系 = *比较.具名关系;
    允许关系位 = 合同.允许关系位;
    return 任务筹办当前就绪结论::已就绪;
}

bool 请求有效(const 任务筹办当前就绪请求& 请求) noexcept {
    const auto 最大值 = static_cast<std::uint64_t>(
        (std::numeric_limits<std::size_t>::max)());
    return 请求.合同版本 == 任务筹办当前就绪合同版本
        && L2结构请求头合同有效(请求.请求头)
        && 请求.请求头.期望事实代次 != 0
        && 下一筹办工作包完整(请求.工作包)
        && 请求.请求头.期望事实代次 == 请求.工作包.迁移后事实代次
        && 请求.最大来源需求成员数 != 0
        && 请求.最大条件状态数 != 0
        && 请求.最大场景成员数 != 0
        && 请求.最大来源需求成员数 <= 最大值
        && 请求.最大条件状态数 <= 最大值
        && 请求.最大场景成员数 <= 最大值;
}

bool 请求有效(const 任务筹办推进请求& 请求) noexcept {
    const auto 最大值 = static_cast<std::uint64_t>(
        (std::numeric_limits<std::size_t>::max)());
    return 请求.合同版本 == 任务筹办当前就绪合同版本
        && L2结构请求头合同有效(请求.请求头)
        && 请求.请求头.期望事实代次 != 0
        && 下一筹办工作包完整(请求.工作包)
        && 请求.请求头.期望事实代次 == 请求.工作包.迁移后事实代次
        && 请求.最大扫描用途事实数 != 0
        && 请求.最大粗召回方法数 != 0
        && 请求.最大概念支持扫描事实数 != 0
        && 请求.最大概念支持关系数 != 0
        && 请求.最大概念祖先关系数 != 0
        && 请求.最大主体状态数 != 0
        && 请求.最大场景成员数 != 0
        && 请求.最大方法条件数 != 0
        && 请求.最大来源需求成员数 != 0
        && 请求.最大概念支持扫描事实数 <= 最大值
        && 请求.最大概念支持关系数 <= 最大值
        && 请求.最大概念祖先关系数 <= 最大值
        && 请求.最大主体状态数 <= 最大值
        && 请求.最大场景成员数 <= 最大值
        && 请求.最大方法条件数 <= 最大值
        && 请求.最大来源需求成员数 <= 最大值;
}

bool 来源需求小于(const L2需求身份& 左,
    const L2需求身份& 右) noexcept {
    return 左.值.值 < 右.值.值;
}

bool 授权安全材料完整(
    const L2任务授权安全复判材料& 材料,
    const std::vector<L2需求身份>& 来源需求组) noexcept {
    if (材料.来源需求组 != 来源需求组) return false;
    for (std::size_t 索引 = 0; 索引 < 材料.强类型来源证据组.size(); ++索引) {
        const auto& 证据 = 材料.强类型来源证据组[索引];
        if (证据.valueless_by_exception()) return false;
        const auto 身份有效 = std::visit([](const auto& 身份) {
            return 有效(身份.值);
        }, 证据);
        if (!身份有效) return false;
        for (std::size_t 前 = 0; 前 < 索引; ++前)
            if (L2任务授权安全来源证据相同(
                    材料.强类型来源证据组[前], 证据)) return false;
    }
    switch (材料.结论) {
    case L2任务授权安全复判结论::已授权: {
        if (材料.最高权限 <= 0 || 材料.授权版本 == 0
            || 材料.安全图版本 == 0 || 材料.阈值版本 == 0
            || 材料.权限规则版本 == 0
            || 材料.强类型来源证据组.empty()) return false;
        const auto 授权证据数 = std::count_if(
            材料.强类型来源证据组.begin(), 材料.强类型来源证据组.end(),
            [](const auto& 证据) {
                return std::holds_alternative<L2来源需求授权事实身份>(证据);
            });
        return static_cast<std::size_t>(授权证据数) >= 来源需求组.size();
    }
    case L2任务授权安全复判结论::不适用已证明:
        return 材料.适用性分类规则版本 != 0
            && std::any_of(材料.强类型来源证据组.begin(),
                材料.强类型来源证据组.end(), [](const auto& 证据) {
                    return std::holds_alternative<
                        L2适用性分类规则事实身份>(证据);
                });
    case L2任务授权安全复判结论::权限为零:
    case L2任务授权安全复判结论::材料缺失:
        return true;
    }
    return false;
}

std::optional<任务筹办等待合同> 查找等待合同(
    const 任务筹办等待合同登记& 登记,
    const 下一筹办工作包& 工作包,
    std::optional<任务特征方法查找结论> 方法查找结论,
    std::optional<任务筹办当前就绪结论> 当前就绪结论) {
    for (const auto& 项 : 登记.项) {
        if (项.方法查找结论 == 方法查找结论
            && 项.当前就绪结论 == 当前就绪结论)
            return 任务筹办等待合同{项.等待对象, 项.合法生产者,
                项.重新触发条件, 工作包};
    }
    return std::nullopt;
}

任务筹办推进结果 形成等待(
    const 任务筹办等待合同登记& 登记,
    const 下一筹办工作包& 工作包,
    std::optional<任务特征方法查找结论> 方法查找结论,
    std::optional<任务筹办当前就绪结论> 当前就绪结论,
    std::uint64_t 最终事实截止) {
    const auto 等待合同 = 查找等待合同(
        登记, 工作包, 方法查找结论, 当前就绪结论);
    if (!等待合同)
        return 推进失败(任务筹办收束类别::内部错误, 最终事实截止);
    auto 结果 = 推进失败(任务筹办收束类别::合法等待, 最终事实截止);
    结果.非成功承接->等待合同 = *等待合同;
    return 结果;
}

L2任务筹办规范化来源材料 规范化来源(
    const 下一筹办工作包& 工作包) noexcept {
    return L2任务重筹办规范化来源材料{L2任务方法选择合同版本,
        L2任务重筹办意图幂等身份{工作包.原重筹办意图幂等键},
        工作包.任务, 工作包.旧路径,
        工作包.旧实例, 工作包.旧执行轮次, 工作包.旧实际结果,
        工作包.正式目标裁决证据, 工作包.正式待重筹办状态,
        工作包.原共同事实截止, 工作包.迁移后事实代次,
        工作包.旧筹办轮次, 工作包.新筹办轮次, 工作包.运行代次};
}

std::uint64_t 混合幂等键(
    std::uint64_t 原键,
    std::uint64_t 父需求,
    std::uint64_t 条件,
    std::uint64_t 用途) noexcept {
    auto 值 = 原键 ^ 0x9E37'79B9'7F4A'7C15ULL;
    const auto 混入 = [&](std::uint64_t 材料) noexcept {
        值 ^= 材料 + 0x9E37'79B9'7F4A'7C15ULL + (值 << 6) + (值 >> 2);
    };
    混入(父需求);
    混入(条件);
    混入(用途);
    return 值 == 0 ? 用途 : 值;
}

任务筹办收束类别 映射记录写入状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::事实代次漂移:
        return 任务筹办收束类别::当前性漂移;
    case L2结构状态::数量预算不足:
        return 任务筹办收束类别::数量预算不足;
    case L2结构状态::资源失败:
        return 任务筹办收束类别::资源失败;
    case L2结构状态::引用冲突:
    case L2结构状态::幂等冲突:
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::属性未设置:
        return 任务筹办收束类别::引用冲突;
    default:
        return 任务筹办收束类别::内部错误;
    }
}

任务筹办收束类别 映射需求承接状态(
    需求任务子目标承接状态 状态) noexcept {
    switch (状态) {
    case 需求任务子目标承接状态::事实代次漂移:
        return 任务筹办收束类别::当前性漂移;
    case 需求任务子目标承接状态::资源失败:
        return 任务筹办收束类别::资源失败;
    case 需求任务子目标承接状态::父域冲突:
    case 需求任务子目标承接状态::目标冲突:
    case 需求任务子目标承接状态::父子顺序冲突:
    case 需求任务子目标承接状态::幂等冲突:
    case 需求任务子目标承接状态::引用冲突:
    case 需求任务子目标承接状态::记录不可承接:
        return 任务筹办收束类别::引用冲突;
    default:
        return 任务筹办收束类别::内部错误;
    }
}

} // namespace 海中鱼巣::任务筹办当前就绪内部

export namespace 海中鱼巣 {

class 任务筹办授权安全材料来源 {
public:
    virtual ~任务筹办授权安全材料来源() = default;
    virtual L2任务授权安全复判材料 读取任务筹办授权安全材料(
        const 下一筹办工作包& 工作包,
        const std::vector<L2需求事实>& 来源需求组,
        std::uint64_t 事实截止) const noexcept = 0;
};

class 任务筹办授权安全材料缺失来源 final
    : public 任务筹办授权安全材料来源 {
public:
    L2任务授权安全复判材料 读取任务筹办授权安全材料(
        const 下一筹办工作包&,
        const std::vector<L2需求事实>&,
        std::uint64_t) const noexcept override {
        return {};
    }
};

class 任务筹办当前就绪与执行冻结提供者 final {
public:
    任务筹办当前就绪与执行冻结提供者(
        L2任务结构服务& 任务服务,
        L2任务子目标承接记录结构服务& 子目标记录服务,
        需求任务子目标承接服务& 子目标承接服务,
        const L2需求结构服务& 需求服务,
        const L2方法结构服务& 方法服务,
        const L2状态结构服务& 状态服务,
        const L2特征结构服务& 特征服务,
        const L2场景结构服务& 场景服务,
        const 任务特征方法查找与条件提议提供者& 方法查找提供者,
        const 任务筹办授权安全材料来源& 授权安全来源,
        const 任务筹办等待合同登记& 等待合同登记) noexcept
        : 任务服务_(任务服务), 子目标记录服务_(子目标记录服务),
          子目标承接服务_(子目标承接服务), 需求服务_(需求服务),
          方法服务_(方法服务), 状态服务_(状态服务), 特征服务_(特征服务),
          场景服务_(场景服务), 方法查找提供者_(方法查找提供者),
          授权安全来源_(授权安全来源), 等待合同登记_(等待合同登记) {}

    任务筹办当前就绪与执行冻结提供者(
        const 任务筹办当前就绪与执行冻结提供者&) = delete;
    任务筹办当前就绪与执行冻结提供者& operator=(
        const 任务筹办当前就绪与执行冻结提供者&) = delete;
    任务筹办当前就绪与执行冻结提供者(
        任务筹办当前就绪与执行冻结提供者&&) = delete;
    任务筹办当前就绪与执行冻结提供者& operator=(
        任务筹办当前就绪与执行冻结提供者&&) = delete;

    任务筹办当前就绪结果 复判任务筹办当前就绪(
        const 任务筹办当前就绪请求& 请求) const noexcept;

    任务筹办推进结果 推进下一筹办工作包(
        const 任务筹办推进请求& 请求) noexcept;

private:
    L2任务结构服务& 任务服务_;
    L2任务子目标承接记录结构服务& 子目标记录服务_;
    需求任务子目标承接服务& 子目标承接服务_;
    const L2需求结构服务& 需求服务_;
    const L2方法结构服务& 方法服务_;
    const L2状态结构服务& 状态服务_;
    const L2特征结构服务& 特征服务_;
    const L2场景结构服务& 场景服务_;
    const 任务特征方法查找与条件提议提供者& 方法查找提供者_;
    const 任务筹办授权安全材料来源& 授权安全来源_;
    const 任务筹办等待合同登记& 等待合同登记_;
};

} // namespace 海中鱼巣

namespace 海中鱼巣 {

任务筹办当前就绪结果
任务筹办当前就绪与执行冻结提供者::复判任务筹办当前就绪(
    const 任务筹办当前就绪请求& 请求) const noexcept {
    using namespace 任务筹办当前就绪内部;
    if (!请求有效(请求))
        return 当前就绪失败(任务筹办当前就绪结论::内部错误);
    try {
        const auto 共同事实截止 = 请求.请求头.期望事实代次;
        const auto& 查找 = 请求.方法查找结果;
        if (!查找.成功() || !查找.结论
            || *查找.结论 != 任务特征方法查找结论::已采用且无需条件提议
            || 查找.共同事实截止 != 共同事实截止
            || !查找.已互证工作包 || *查找.已互证工作包 != 请求.工作包
            || !查找.采用方案 || !查找.任务目标)
            return 当前就绪失败(任务筹办当前就绪结论::引用冲突,
                共同事实截止);
        const auto& 采用方案 = *查找.采用方案;
        const auto 任务读取 = 任务服务_.读取任务(
            {请求.请求头, L2读取类别::当前, 请求.工作包.任务, 0});
        if (任务读取.结果头.事实截止代次 != 共同事实截止)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                任务读取.结果头.事实截止代次);
        if (!任务读取.成功() || !任务读取.任务)
            return 当前就绪失败(映射当前就绪状态(任务读取.结果头.状态),
                共同事实截止);
        const auto 身份来源读取 = 任务服务_.读取任务身份来源(
            {请求.请求头, L2读取类别::当前, 请求.工作包.任务, 0});
        if (身份来源读取.结果头.事实截止代次 != 共同事实截止)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                身份来源读取.结果头.事实截止代次);
        if (!身份来源读取.成功() || !身份来源读取.身份来源)
            return 当前就绪失败(
                映射当前就绪状态(身份来源读取.结果头.状态),
                共同事实截止);
        const auto 治理读取 = 任务服务_.读取任务治理状态(
            {请求.请求头, L2读取类别::当前,
                请求.工作包.正式待重筹办状态, 0});
        if (治理读取.结果头.事实截止代次 != 共同事实截止)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                治理读取.结果头.事实截止代次);
        if (!治理读取.成功() || !治理读取.状态
            || !治理读取.目标裁决证据)
            return 当前就绪失败(映射当前就绪状态(治理读取.结果头.状态),
                共同事实截止);
        if (治理读取.状态->任务 != 请求.工作包.任务
            || 治理读取.状态->来源方法路径 != 请求.工作包.旧路径
            || 治理读取.状态->来源实例方法 != 请求.工作包.旧实例
            || 治理读取.状态->来源执行轮次 != 请求.工作包.旧执行轮次
            || 治理读取.状态->来源任务实际结果
                != 请求.工作包.旧实际结果
            || 治理读取.目标裁决证据->身份
                != 请求.工作包.正式目标裁决证据)
            return 当前就绪失败(任务筹办当前就绪结论::引用冲突,
                共同事实截止);
        const auto& 目标材料 = 治理读取.目标裁决证据->材料;
        if (目标材料.目标宿主 != 查找.任务目标->目标宿主
            || 目标材料.目标特征 != 查找.任务目标->目标特征
            || 目标材料.目标状态合同 != 查找.任务目标->目标状态合同)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                共同事实截止);
        const auto 方法读取 = 方法服务_.读取普通方法({请求.请求头,
            L2普通方法结构合同版本, L2读取类别::当前, 采用方案.方法, 0});
        if (方法读取.结果头.事实截止代次 != 共同事实截止)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                方法读取.结果头.事实截止代次);
        if (!方法读取.成功() || !方法读取.方法)
            return 当前就绪失败(映射当前就绪状态(方法读取.结果头.状态),
                共同事实截止);
        const auto& 方法 = *方法读取.方法;
        if (方法.方法 != 采用方案.方法 || 方法.内容版本 != 采用方案.内容版本
            || 方法.规格版本 != 采用方案.规格版本
            || 方法.生命周期事实.方法 != 方法.方法
            || 方法.生命周期事实.生命周期.退出事实代次)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                共同事实截止);
        const auto 成员读取 = 需求服务_.读取需求列表成员({请求.请求头,
            L2读取类别::当前, 任务读取.任务->需求列表项, 0});
        if (成员读取.结果头.事实截止代次 != 共同事实截止)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                成员读取.结果头.事实截止代次);
        if (!成员读取.成功())
            return 当前就绪失败(映射当前就绪状态(成员读取.结果头.状态),
                共同事实截止);
        if (成员读取.成员需求组.empty())
            return 当前就绪失败(任务筹办当前就绪结论::引用冲突,
                共同事实截止);
        if (成员读取.成员需求组.size() > 请求.最大来源需求成员数)
            return 当前就绪失败(任务筹办当前就绪结论::数量预算不足,
                共同事实截止);

        const auto 主轴 = std::find_if(方法.结果.begin(), 方法.结果.end(),
            [&](const auto& 结果) { return 结果.身份 == 采用方案.主轴结果; });
        if (主轴 == 方法.结果.end())
            return 当前就绪失败(任务筹办当前就绪结论::引用冲突,
                共同事实截止);
        std::vector<L2方法条件身份> 条件身份组;
        for (const auto& 关系 : 方法.条件结果关系)
            if (关系.结果 == 主轴->身份
                && std::find(条件身份组.begin(), 条件身份组.end(), 关系.条件)
                    == 条件身份组.end())
                条件身份组.push_back(关系.条件);
        if (条件身份组.size() > 请求.最大条件状态数)
            return 当前就绪失败(任务筹办当前就绪结论::数量预算不足,
                共同事实截止);
        const auto 属于主轴 = [&](const auto& 项) {
            return !项.条件 || std::find(条件身份组.begin(), 条件身份组.end(),
                *项.条件) != 条件身份组.end();
        };
        任务筹办当前就绪结果 结果;
        结果.结论 = 任务筹办当前就绪结论::已就绪;
        结果.共同事实截止 = 共同事实截止;
        结果.当前方法 = 方法;
        结果.来源需求组 = 成员读取.成员需求组;
        结果.主轴结果 = *主轴;
        结果.动作入口 = 方法.动作入口;

        std::vector<L2状态事实> 主体当前状态;
        if (!条件身份组.empty()) {
            const auto 状态组 = 状态服务_.按主体读取全部当前状态(
                {请求.请求头, 查找.任务目标->目标宿主,
                    请求.最大条件状态数});
            if (状态组.结果头.事实截止代次 != 共同事实截止)
                return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                    状态组.结果头.事实截止代次);
            if (!状态组.成功())
                return 当前就绪失败(映射当前就绪状态(状态组.结果头.状态),
                    共同事实截止);
            主体当前状态 = 状态组.状态;
        }
        for (const auto 条件身份 : 条件身份组) {
            const auto 条件 = std::find_if(方法.条件.begin(), 方法.条件.end(),
                [&](const auto& 项) { return 项.身份 == 条件身份; });
            if (条件 == 方法.条件.end() || 条件->作用对象角色 != 主轴->作用对象角色)
                return 当前就绪失败(任务筹办当前就绪结论::输入待绑定,
                    共同事实截止);
            std::vector<L2状态事实> 匹配状态;
            for (const auto& 当前状态 : 主体当前状态) {
                const auto 特征实例读取 = 特征服务_.读取完整特征实例(
                    {请求.请求头, L2读取类别::当前, 当前状态.特征实例, 0});
                if (特征实例读取.结果头.事实截止代次 != 共同事实截止)
                    return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                        特征实例读取.结果头.事实截止代次);
                if (特征实例读取.结果头.状态 != L2结构状态::已读取
                    || !特征实例读取.特征实例)
                    return 当前就绪失败(
                        映射当前就绪状态(特征实例读取.结果头.状态),
                        共同事实截止);
                if (特征实例读取.特征实例->特征定义 == 条件->特征定义)
                    匹配状态.push_back(当前状态);
            }
            if (匹配状态.size() != 1)
                return 当前就绪失败(匹配状态.empty()
                    ? 任务筹办当前就绪结论::条件未满足
                    : 任务筹办当前就绪结论::引用冲突, 共同事实截止);
            L2特征比较具名关系 具名关系{};
            std::uint8_t 允许关系位 = 0;
            const auto 比较结论 = 比较状态与合同(匹配状态.front(),
                条件->特征定义, 条件->条件状态合同,
                请求.工作包.原重筹办意图幂等键 ^ 条件->身份.值.值,
                共同事实截止, 状态服务_, 特征服务_, 具名关系, 允许关系位);
            if (比较结论 != 任务筹办当前就绪结论::已就绪)
                return 当前就绪失败(比较结论, 共同事实截止);
            const auto 当前关系位 = 关系位(具名关系);
            if (!当前关系位 || (允许关系位 & *当前关系位) == 0)
                return 当前就绪失败(任务筹办当前就绪结论::条件未满足,
                    共同事实截止);
            std::optional<L2存在场景成员引用事实> 场景成员;
            if (条件->场景) {
                const auto 场景读取 = 场景服务_.读取存在当前场景成员引用(
                    {请求.请求头, 查找.任务目标->目标宿主});
                if (场景读取.结果头.事实截止代次 != 共同事实截止)
                    return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                        场景读取.结果头.事实截止代次);
                if (!场景读取.成功())
                    return 当前就绪失败(
                        映射当前就绪状态(场景读取.结果头.状态),
                        共同事实截止);
                if (场景读取.引用.size() > 请求.最大场景成员数)
                    return 当前就绪失败(
                        任务筹办当前就绪结论::数量预算不足,
                        共同事实截止);
                const auto 成员 = std::find_if(场景读取.引用.begin(),
                    场景读取.引用.end(), [&](const auto& 引用) {
                        return 引用.场景 == *条件->场景
                            && 引用.存在 == 查找.任务目标->目标宿主;
                    });
                if (成员 == 场景读取.引用.end())
                    return 当前就绪失败(任务筹办当前就绪结论::条件未满足,
                        共同事实截止);
                场景成员 = *成员;
            }
            结果.条件证据组.push_back({*条件, 查找.任务目标->目标宿主,
                条件->场景, 场景成员, 匹配状态.front(), 具名关系,
                允许关系位});
        }

        for (const auto& 输入 : 方法.输入规格) if (属于主轴(输入)) {
            const auto 绑定 = std::find_if(查找.采用方案输入规格.begin(),
                查找.采用方案输入规格.end(), [&](const auto& 项) {
                    return 项.输入规格 == 输入.身份;
                });
            if (绑定 == 查找.采用方案输入规格.end() || !绑定->绑定目标存在
                || 绑定->语义.作用对象角色 != 输入.作用对象角色
                || 绑定->语义.顺序 != 输入.顺序
                || !L2任务冻结方法规格材料相同(绑定->语义.规格, 输入.规格))
                return 当前就绪失败(任务筹办当前就绪结论::输入待绑定,
                    共同事实截止);
            结果.输入冻结组.push_back({输入, *绑定->绑定目标存在});
            结果.参数冻结组.push_back({输入.身份, 输入.作用对象角色,
                输入.规格, *绑定->绑定目标存在});
        }
        for (const auto& 限制 : 方法.限制条件) if (属于主轴(限制)) {
            const auto 绑定 = std::find_if(查找.采用方案限制条件.begin(),
                查找.采用方案限制条件.end(), [&](const auto& 项) {
                    return 项.限制条件 == 限制.身份;
                });
            if (绑定 == 查找.采用方案限制条件.end() || !绑定->绑定目标存在)
                return 当前就绪失败(任务筹办当前就绪结论::输入待绑定,
                    共同事实截止);
            return 当前就绪失败(任务筹办当前就绪结论::限制待解释,
                共同事实截止);
        }

        std::vector<L2需求身份> 来源需求身份组;
        for (const auto& 需求 : 结果.来源需求组)
            来源需求身份组.push_back(需求.身份);
        std::sort(来源需求身份组.begin(), 来源需求身份组.end(), 来源需求小于);
        auto 授权安全材料 = 授权安全来源_.读取任务筹办授权安全材料(
            请求.工作包, 结果.来源需求组, 共同事实截止);
        std::sort(授权安全材料.来源需求组.begin(),
            授权安全材料.来源需求组.end(), 来源需求小于);
        if (!授权安全材料完整(授权安全材料, 来源需求身份组))
            return 当前就绪失败(任务筹办当前就绪结论::引用冲突,
                共同事实截止);
        if (授权安全材料.结论 == L2任务授权安全复判结论::权限为零
            || 授权安全材料.结论 == L2任务授权安全复判结论::材料缺失)
            return 当前就绪失败(任务筹办当前就绪结论::授权安全等待,
                共同事实截止);
        结果.授权安全材料 = std::move(授权安全材料);

        const auto 尾任务 = 任务服务_.读取任务(
            {请求.请求头, L2读取类别::当前, 请求.工作包.任务, 0});
        const auto 尾方法 = 方法服务_.读取普通方法({请求.请求头,
            L2普通方法结构合同版本, L2读取类别::当前, 方法.方法, 0});
        if (尾任务.结果头.事实截止代次 != 共同事实截止
            || 尾方法.结果头.事实截止代次 != 共同事实截止)
            return 当前就绪失败(任务筹办当前就绪结论::当前性漂移,
                共同事实截止);
        if (!尾任务.成功() || !尾任务.任务 || *尾任务.任务 != *任务读取.任务
            || !尾方法.成功() || !尾方法.方法 || *尾方法.方法 != 方法)
            return 当前就绪失败(任务筹办当前就绪结论::引用冲突,
                共同事实截止);
        return 结果;
    } catch (const std::bad_alloc&) {
        return 当前就绪失败(任务筹办当前就绪结论::资源失败);
    } catch (const std::length_error&) {
        return 当前就绪失败(任务筹办当前就绪结论::资源失败);
    } catch (...) {
        return 当前就绪失败(任务筹办当前就绪结论::内部错误);
    }
}

任务筹办推进结果
任务筹办当前就绪与执行冻结提供者::推进下一筹办工作包(
    const 任务筹办推进请求& 请求) noexcept {
    using namespace 任务筹办当前就绪内部;
    if (!请求有效(请求) || !任务筹办等待合同登记完整(等待合同登记_))
        return 推进失败(任务筹办收束类别::内部错误);
    try {
        任务特征方法查找请求 查找请求;
        查找请求.请求头 = 请求.请求头;
        查找请求.工作包 = 请求.工作包;
        查找请求.最大扫描用途事实数 = 请求.最大扫描用途事实数;
        查找请求.最大粗召回方法数 = 请求.最大粗召回方法数;
        查找请求.最大概念支持扫描事实数 = 请求.最大概念支持扫描事实数;
        查找请求.最大概念支持关系数 = 请求.最大概念支持关系数;
        查找请求.最大概念祖先关系数 = 请求.最大概念祖先关系数;
        查找请求.最大主体状态数 = 请求.最大主体状态数;
        查找请求.最大场景成员数 = 请求.最大场景成员数;
        查找请求.最大方法条件数 = 请求.最大方法条件数;
        const auto 查找结果 = 方法查找提供者_.评估下一筹办方法候选并形成条件提议(
            查找请求);
        if (!查找结果.成功() || !查找结果.结论)
            return 推进失败(映射推进状态(查找结果.状态),
                查找结果.共同事实截止);
        const auto 查找结论 = *查找结果.结论;
        switch (查找结论) {
        case 任务特征方法查找结论::方法能力缺失:
        case 任务特征方法查找结论::当前无适用方法:
        case 任务特征方法查找结论::对象概念待形成:
        case 任务特征方法查找结论::所需方向不唯一:
        case 任务特征方法查找结论::多候选待选择证据:
        case 任务特征方法查找结论::已采用且输入限制待绑定:
            return 形成等待(等待合同登记_, 请求.工作包, 查找结论,
                std::nullopt, 查找结果.共同事实截止);
        case 任务特征方法查找结论::方法结构待补齐: {
            auto 结果 = 推进失败(任务筹办收束类别::方法补齐承接,
                查找结果.共同事实截止);
            const auto 合同 = 查找等待合同(等待合同登记_, 请求.工作包,
                查找结论, std::nullopt);
            if (!合同 || 查找结果.结构缺口.empty())
                return 推进失败(任务筹办收束类别::内部错误,
                    查找结果.共同事实截止);
            const auto& 首项 = 查找结果.结构缺口.front();
            任务方法补齐承接草案 草案;
            草案.来源任务 = 请求.工作包.任务;
            草案.筹办轮次 = 请求.工作包.新筹办轮次;
            草案.方法 = 首项.方法;
            if (查找结果.采用方案) {
                草案.内容版本 = 查找结果.采用方案->内容版本;
                草案.规格版本 = 查找结果.采用方案->规格版本;
            }
            草案.结构缺口组 = 首项.结构缺口;
            草案.合法补齐处理方 = 合同->合法生产者;
            结果.非成功承接->方法补齐草案 = std::move(草案);
            return 结果;
        }
        case 任务特征方法查找结论::已采用且存在缺失条件: {
            auto 结果 = 推进失败(任务筹办收束类别::子目标承接,
                查找结果.共同事实截止);
            结果.非成功承接->子目标草案组 = 查找结果.缺失条件草案;
            if (查找结果.缺失条件草案.empty())
                return 推进失败(任务筹办收束类别::内部错误,
                    查找结果.共同事实截止);
            auto 当前截止 = 查找结果.共同事实截止;
            const L2结构请求头 初始头{L2结构合同版本, 当前截止};
            const auto 任务读取 = 任务服务_.读取任务(
                {初始头, L2读取类别::当前, 请求.工作包.任务, 0});
            if (!任务读取.成功() || !任务读取.任务
                || 任务读取.结果头.事实截止代次 != 当前截止)
                return 推进失败(任务读取.结果头.事实截止代次 != 当前截止
                    ? 任务筹办收束类别::当前性漂移
                    : 映射记录写入状态(任务读取.结果头.状态),
                    任务读取.结果头.事实截止代次);
            const auto 成员读取 = 需求服务_.读取需求列表成员({初始头,
                L2读取类别::当前, 任务读取.任务->需求列表项, 0});
            if (!成员读取.成功()
                || 成员读取.结果头.事实截止代次 != 当前截止
                || 成员读取.成员需求组.empty())
                return 推进失败(
                    成员读取.结果头.事实截止代次 != 当前截止
                        ? 任务筹办收束类别::当前性漂移
                        : 映射记录写入状态(成员读取.结果头.状态),
                    成员读取.结果头.事实截止代次);
            if (成员读取.成员需求组.size() > 请求.最大来源需求成员数)
                return 推进失败(任务筹办收束类别::数量预算不足,
                    当前截止);
            for (std::size_t 条件索引 = 0;
                条件索引 < 查找结果.缺失条件草案.size(); ++条件索引) {
                const auto& 草案 = 查找结果.缺失条件草案[条件索引];
                if (草案.来源任务 != 请求.工作包.任务
                    || 草案.共同事实截止 != 查找结果.共同事实截止)
                    return 推进失败(任务筹办收束类别::引用冲突,
                        当前截止);
                for (const auto& 父需求 : 成员读取.成员需求组) {
                    const auto 建立键值 = 混合幂等键(
                        请求.工作包.原重筹办意图幂等键,
                        父需求.身份.值.值, 草案.条件.值.值,
                        0x5355'4247'4F41'4C01ULL);
                    L2新增任务子目标承接记录请求 记录请求;
                    记录请求.请求头 = {L2结构合同版本, 当前截止};
                    记录请求.幂等身份 = {建立键值};
                    记录请求.任务 = 请求.工作包.任务;
                    记录请求.任务虚拟存在 = 任务读取.任务->任务虚拟存在;
                    记录请求.筹办轮次 = 请求.工作包.新筹办轮次;
                    记录请求.父需求 = 父需求.身份;
                    记录请求.来源 = {草案.方法, 草案.内容版本,
                        草案.规格版本, 草案.主轴结果, 草案.条件,
                        草案.作用对象角色, 草案.来源稳定编码};
                    记录请求.子目标 = {草案.绑定目标存在,
                        草案.条件特征, 草案.条件状态合同, 草案.场景};
                    记录请求.来源共同事实截止 = 草案.共同事实截止;
                    const auto 记录建立 = 子目标记录服务_.新增任务子目标承接记录(
                        记录请求);
                    if (!记录建立.成功() || !记录建立.记录)
                        return 推进失败(
                            映射记录写入状态(记录建立.结果头.状态),
                            记录建立.结果头.事实截止代次);
                    当前截止 = 记录建立.结果头.事实截止代次;
                    const auto 需求发布键值 = 混合幂等键(
                        请求.工作包.原重筹办意图幂等键,
                        父需求.身份.值.值, 草案.条件.值.值,
                        0x5355'4247'4F41'4C02ULL);
                    const auto 任务绑定键值 = 混合幂等键(
                        请求.工作包.原重筹办意图幂等键,
                        父需求.身份.值.值, 草案.条件.值.值,
                        0x5355'4247'4F41'4C03ULL);
                    const auto 父子顺序 =
                        (请求.工作包.新筹办轮次 << 32)
                        | static_cast<std::uint64_t>(条件索引 + 1);
                    const auto 承接 = 子目标承接服务_.承接任务子目标记录({
                        需求任务子目标承接合同版本,
                        {L2结构合同版本, 当前截止},
                        记录建立.记录->身份, 父子顺序,
                        {需求发布键值}, {任务绑定键值}});
                    if (!承接.成功())
                        return 推进失败(映射需求承接状态(承接.状态),
                            承接.最终共同事实截止);
                    当前截止 = 承接.最终共同事实截止;
                }
            }
            结果.最终事实截止 = 当前截止;
            return 结果;
        }
        case 任务特征方法查找结论::已采用且无需条件提议:
            break;
        }

        任务筹办当前就绪请求 当前就绪请求;
        当前就绪请求.请求头 = 请求.请求头;
        当前就绪请求.工作包 = 请求.工作包;
        当前就绪请求.方法查找结果 = 查找结果;
        当前就绪请求.最大来源需求成员数 = 请求.最大来源需求成员数;
        当前就绪请求.最大条件状态数 = 请求.最大方法条件数;
        当前就绪请求.最大场景成员数 = 请求.最大场景成员数;
        const auto 当前就绪 = 复判任务筹办当前就绪(当前就绪请求);
        if (当前就绪.结论 != 任务筹办当前就绪结论::已就绪)
            return 映射推进结论(当前就绪.结论)
                    == 任务筹办收束类别::合法等待
                ? 形成等待(等待合同登记_, 请求.工作包, std::nullopt,
                    当前就绪.结论, 当前就绪.共同事实截止)
                : 推进失败(映射推进结论(当前就绪.结论),
                    当前就绪.共同事实截止);
        if (!当前就绪.当前方法 || !当前就绪.授权安全材料
            || !当前就绪.主轴结果 || !当前就绪.动作入口)
            return 推进失败(任务筹办收束类别::内部错误,
                当前就绪.共同事实截止);

        const auto 身份来源读取 = 任务服务_.读取任务身份来源(
            {请求.请求头, L2读取类别::当前, 请求.工作包.任务, 0});
        if (!身份来源读取.成功() || !身份来源读取.身份来源
            || 身份来源读取.结果头.事实截止代次 != 当前就绪.共同事实截止)
            return 推进失败(任务筹办收束类别::当前性漂移,
                身份来源读取.结果头.事实截止代次);
        std::vector<L2需求身份> 来源需求身份组;
        for (const auto& 需求 : 当前就绪.来源需求组)
            来源需求身份组.push_back(需求.身份);
        std::sort(来源需求身份组.begin(), 来源需求身份组.end(), 来源需求小于);

        L2发布任务筹办正式选择请求 发布请求;
        发布请求.请求头 = 请求.请求头;
        发布请求.来源材料 = 规范化来源(请求.工作包);
        发布请求.任务身份来源 = *身份来源读取.身份来源;
        发布请求.方法生命周期 = 当前就绪.当前方法->生命周期事实;
        发布请求.选择规则版本 = 任务筹办当前就绪合同版本;
        发布请求.召回规则版本 = 任务特征方法查找合同版本;
        发布请求.来源需求组 = 来源需求身份组;
        发布请求.稳定证据组 = {
            {L2任务选择稳定证据类别::目标裁决证据,
                请求.工作包.正式目标裁决证据.值},
            {L2任务选择稳定证据类别::任务治理状态,
                请求.工作包.正式待重筹办状态.值}};
        发布请求.冻结材料.任务 = 请求.工作包.任务;
        发布请求.冻结材料.筹办轮次 = 请求.工作包.新筹办轮次;
        发布请求.冻结材料.方法 = 当前就绪.当前方法->方法;
        发布请求.冻结材料.方法内容版本 = 当前就绪.当前方法->内容版本;
        for (const auto& 证据 : 当前就绪.条件证据组)
            发布请求.冻结材料.条件证据组.push_back({证据.条件,
                证据.绑定目标, 证据.场景, 证据.场景成员, 证据.当前状态,
                证据.具名关系, 证据.允许关系位});
        for (const auto& 输入 : 当前就绪.输入冻结组)
            发布请求.冻结材料.输入冻结组.push_back(
                {输入.输入规格, 输入.绑定目标});
        for (const auto& 参数 : 当前就绪.参数冻结组)
            发布请求.冻结材料.参数冻结组.push_back({参数.来源输入规格,
                参数.作用对象角色, 参数.参数规格, 参数.绑定目标});
        for (const auto& 限制 : 当前就绪.限制证据组)
            发布请求.冻结材料.限制证据组.push_back({限制.限制条件,
                限制.绑定目标, 限制.解释器, 限制.解释规则版本,
                限制.当前事实证据, 限制.已满足});
        发布请求.冻结材料.授权安全材料 = *当前就绪.授权安全材料;
        发布请求.冻结材料.动作入口 = *当前就绪.动作入口;
        发布请求.冻结材料.主轴结果 = *当前就绪.主轴结果;
        发布请求.冻结材料.验证合同 = 查找结果.任务目标->目标状态合同;
        发布请求.冻结材料.归因证据 = 请求.工作包.正式目标裁决证据;

        const auto 发布 = 任务服务_.发布任务筹办正式选择(发布请求);
        const auto 读回截止 = 发布.结果头.事实截止代次;
        if (读回截止 == 0)
            return 推进失败(发布.结果头.状态 == L2结构状态::资源失败
                ? 任务筹办收束类别::资源失败
                : 任务筹办收束类别::内部错误);
        const L2结构请求头 读回头{L2结构合同版本, 读回截止};
        const auto 读回 = 任务服务_.按筹办来源幂等身份读取正式选择(
            {读回头, L2任务重筹办意图幂等身份{
                请求.工作包.原重筹办意图幂等键}, 发布请求});
        if (!读回.成功() || !读回.首次完整请求
            || *读回.首次完整请求 != 发布请求 || !读回.正式选择
            || !读回.冻结材料 || !读回.实例方法)
            return 推进失败(读回.结果头.状态 == L2结构状态::资源失败
                ? 任务筹办收束类别::资源失败
                : 读回.结果头.状态 == L2结构状态::事实代次漂移
                    ? 任务筹办收束类别::当前性漂移
                    : 读回.结果头.状态 == L2结构状态::引用冲突
                        || 读回.结果头.状态 == L2结构状态::幂等冲突
                        ? 任务筹办收束类别::引用冲突
                        : 任务筹办收束类别::内部错误,
                读回.结果头.事实截止代次);
        任务筹办推进结果 结果;
        结果.类别 = 任务筹办收束类别::执行冻结候选;
        结果.最终事实截止 = 读回.结果头.事实截止代次;
        结果.执行冻结材料 = 任务执行冻结形成材料{请求.工作包,
            *读回.正式选择, *读回.冻结材料, *读回.实例方法,
            读回.结果头.事实截止代次};
        return 结果;
    } catch (const std::bad_alloc&) {
        return 推进失败(任务筹办收束类别::资源失败);
    } catch (const std::length_error&) {
        return 推进失败(任务筹办收束类别::资源失败);
    } catch (...) {
        return 推进失败(任务筹办收束类别::内部错误);
    }
}

} // namespace 海中鱼巣
