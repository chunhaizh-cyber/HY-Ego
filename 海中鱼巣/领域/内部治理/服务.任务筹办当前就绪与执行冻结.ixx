bool 海中鱼巣::operator==(const 任务筹办当前就绪请求_v2& 左,
    const 任务筹办当前就绪请求_v2& 右) noexcept {
    if (左.合同版本 != 右.合同版本 || 左.请求头 != 右.请求头
        || 左.任务 != 右.任务 || 左.任务轮次 != 右.任务轮次
        || 左.筹办轮次 != 右.筹办轮次
        || !(左.方法查找结果 == 右.方法查找结果))
        return false;
    const auto& 左基础 = 左.正式选择基础材料;
    const auto& 右基础 = 右.正式选择基础材料;
    if (左基础.合同版本 != 右基础.合同版本
        || 左基础.来源材料 != 右基础.来源材料
        || 左基础.任务身份来源 != 右基础.任务身份来源
        || 左基础.方法生命周期 != 右基础.方法生命周期
        || 左基础.选择规则版本 != 右基础.选择规则版本
        || 左基础.召回规则版本 != 右基础.召回规则版本
        || 左基础.来源需求组 != 右基础.来源需求组
        || 左基础.稳定证据组 != 右基础.稳定证据组)
        return false;
    return 左.最大来源需求成员数 == 右.最大来源需求成员数
        && 左.最大条件状态数 == 右.最大条件状态数
        && 左.最大场景成员数 == 右.最大场景成员数;
}

namespace 海中鱼巣::任务筹办当前就绪内部 {

bool 生命周期逐项相同(const L2生命周期& 左,
    const L2生命周期& 右) noexcept {
    if (左.创建事实代次 != 右.创建事实代次
        || 左.退出事实代次.has_value() != 右.退出事实代次.has_value())
        return false;
    return !左.退出事实代次
        || *左.退出事实代次 == *右.退出事实代次;
}

bool 任务事实逐项相同(const L2任务事实& 左,
    const L2任务事实& 右) noexcept {
    return 左.身份 == 右.身份
        && 左.需求列表项 == 右.需求列表项
        && 左.任务虚拟存在 == 右.任务虚拟存在
        && 生命周期逐项相同(左.生命周期, 右.生命周期);
}

bool 任务轮次事实逐项相同(const L2任务轮次事实& 左,
    const L2任务轮次事实& 右) noexcept {
    return 左.身份 == 右.身份
        && 左.任务 == 右.任务
        && 左.轮次序号 == 右.轮次序号
        && 生命周期逐项相同(左.生命周期, 右.生命周期);
}

bool 任务身份来源事实逐项相同(const L2任务身份来源事实& 左,
    const L2任务身份来源事实& 右) noexcept {
    return 左.任务所有者 == 右.任务所有者
        && 左.任务节点 == 右.任务节点
        && 左.任务族锚点 == 右.任务族锚点
        && 左.任务族归属关系类型 == 右.任务族归属关系类型
        && 左.任务族归属关系 == 右.任务族归属关系
        && 生命周期逐项相同(左.任务节点生命周期, 右.任务节点生命周期)
        && 生命周期逐项相同(左.族归属关系生命周期, 右.族归属关系生命周期);
}

任务筹办当前就绪结果_v2 形成结果(
    任务筹办当前就绪结论 结论,
    std::uint64_t 共同事实截止 = 0) noexcept {
    任务筹办当前就绪结果_v2 结果;
    结果.结论 = 结论;
    结果.共同事实截止 = 共同事实截止;
    return 结果;
}

constexpr 任务筹办当前就绪结论 映射结构读取状态(
    L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::数量预算不足:
        return 任务筹办当前就绪结论::数量预算不足;
    case L2结构状态::事实代次漂移:
        return 任务筹办当前就绪结论::当前性漂移;
    case L2结构状态::入口拒绝:
        return 任务筹办当前就绪结论::入口拒绝;
    case L2结构状态::许可拒绝:
        return 任务筹办当前就绪结论::许可拒绝;
    case L2结构状态::幂等冲突:
        return 任务筹办当前就绪结论::幂等冲突;
    case L2结构状态::引用冲突:
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::属性未设置:
        return 任务筹办当前就绪结论::引用冲突;
    case L2结构状态::资源失败:
        return 任务筹办当前就绪结论::资源失败;
    default:
        return 任务筹办当前就绪结论::内部错误;
    }
}

constexpr 任务筹办当前就绪结论 映射查找状态(
    任务特征方法查找状态 状态) noexcept {
    switch (状态) {
    case 任务特征方法查找状态::数量预算不足:
        return 任务筹办当前就绪结论::数量预算不足;
    case 任务特征方法查找状态::当前性漂移:
        return 任务筹办当前就绪结论::当前性漂移;
    case 任务特征方法查找状态::引用冲突:
        return 任务筹办当前就绪结论::引用冲突;
    case 任务特征方法查找状态::入口拒绝:
        return 任务筹办当前就绪结论::入口拒绝;
    case 任务特征方法查找状态::资源失败:
        return 任务筹办当前就绪结论::资源失败;
    default:
        return 任务筹办当前就绪结论::内部错误;
    }
}

std::optional<std::uint8_t> 关系位(
    L2特征比较具名关系 关系) noexcept {
    switch (关系) {
    case L2特征比较具名关系::当前低于目标: return 0x01U;
    case L2特征比较具名关系::当前达到目标: return 0x02U;
    case L2特征比较具名关系::当前高于目标: return 0x04U;
    default: return std::nullopt;
    }
}

任务筹办当前就绪结论 比较状态与合同(
    const L2状态事实& 状态,
    L2特征定义身份 特征,
    L2目标状态合同身份 合同身份,
    std::uint64_t 请求身份,
    std::uint64_t 共同事实截止,
    const L2状态结构服务& 状态服务,
    const L2特征结构服务& 特征服务,
    L2特征比较具名关系& 具名关系,
    std::uint8_t& 允许关系位) {
    const L2结构请求头 请求头{L2结构合同版本, 共同事实截止};
    const auto 合同读取 = 状态服务.读取完整目标状态合同(
        {请求头, L2读取类别::当前, 合同身份, 0});
    if (合同读取.结果头.事实截止代次 != 共同事实截止)
        return 任务筹办当前就绪结论::当前性漂移;
    if (!合同读取.成功() || !合同读取.合同)
        return 映射结构读取状态(合同读取.结果头.状态);
    const auto& 合同 = *合同读取.合同;
    if (合同.身份 != 合同身份 || 合同.特征定义 != 特征
        || 合同.比较用途 != L2特征比较用途::目标判断)
        return 任务筹办当前就绪结论::引用冲突;
    const auto 注册读取 = 特征服务.读取当前特征比较注册(
        {请求头, 特征, L2特征比较用途::目标判断});
    if (注册读取.结果头.事实截止代次 != 共同事实截止)
        return 任务筹办当前就绪结论::当前性漂移;
    if (!注册读取.成功() || !注册读取.注册)
        return 映射结构读取状态(注册读取.结果头.状态);
    const auto& 注册 = *注册读取.注册;
    if (合同.比较注册 != 注册.身份 || 注册.特征定义 != 特征
        || !std::holds_alternative<std::int64_t>(
            状态.精确值.类型化不可变材料))
        return 任务筹办当前就绪结论::引用冲突;
    L2特征比较请求 比较请求;
    比较请求.请求头 = 请求头;
    比较请求.请求身份 = 请求身份;
    比较请求.特征定义 = 特征;
    比较请求.用途 = L2特征比较用途::目标判断;
    比较请求.预期算法族 = 注册.合同.算法族;
    比较请求.预期算法版本 = 注册.合同.算法版本;
    比较请求.左 = {状态.精确值.值稳定编码,
        状态.精确值.类型化不可变材料, 状态.精确值.来源稳定编码,
        状态.精确值.创建事实代次,
        {状态.精确值.创建事实代次, 状态.精确值.退出事实代次},
        L2特征比较原始类型::I64, 注册.合同.单位, 注册.合同.维度,
        注册.合同.分量角色, L2特征比较角色::当前事实};
    比较请求.右 = {合同.目标值稳定编码, L2原始值材料{合同.目标I64},
        合同.来源稳定编码, 合同.生命周期.创建事实代次,
        合同.生命周期, L2特征比较原始类型::I64, 注册.合同.单位,
        注册.合同.维度, 注册.合同.分量角色,
        L2特征比较角色::目标状态};
    比较请求.要求结果位 =
        static_cast<std::uint8_t>(L2特征比较结果要求::具名关系);
    const auto 比较 = 特征服务.比较特征(比较请求);
    if (比较.事实截止代次 != 共同事实截止
        || 比较.状态 == L2特征比较状态::版本漂移)
        return 任务筹办当前就绪结论::当前性漂移;
    if (比较.状态 == L2特征比较状态::资源失败)
        return 任务筹办当前就绪结论::资源失败;
    if (!比较.成功() || !比较.具名关系 || 比较.注册身份 != 注册.身份)
        return 任务筹办当前就绪结论::内部错误;
    const auto 当前关系位 = 关系位(*比较.具名关系);
    if (!当前关系位) return 任务筹办当前就绪结论::内部错误;
    具名关系 = *比较.具名关系;
    允许关系位 = 合同.允许关系位;
    return 任务筹办当前就绪结论::已就绪;
}

bool 来源需求事实小于(const L2需求事实& 左,
    const L2需求事实& 右) noexcept {
    return 左.身份.值.值 < 右.身份.值.值;
}

std::uint64_t 来源幂等键值(
    const L2任务筹办来源幂等身份& 身份) noexcept {
    return std::visit([](const auto& 值) noexcept -> std::uint64_t {
        using 身份类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<身份类型,
                L2任务初次筹办准备记录身份>)
            return 值.值.值;
        else
            return 值.值;
    }, 身份);
}

bool 请求有效(const 任务筹办当前就绪请求_v2& 请求) noexcept {
    const auto 最大值 = static_cast<std::uint64_t>(
        (std::numeric_limits<std::size_t>::max)());
    return 请求.合同版本 == 任务筹办当前就绪合同版本_v2
        && L2结构请求头合同有效(请求.请求头)
        && 请求.请求头.期望事实代次 != 0
        && 有效(请求.任务.值) && 有效(请求.任务轮次.值)
        && 有效(请求.筹办轮次.值)
        && L2任务筹办正式选择基础材料_v2完整(
            请求.正式选择基础材料)
        && 请求.最大来源需求成员数 != 0
        && 请求.最大条件状态数 != 0
        && 请求.最大场景成员数 != 0
        && 请求.最大来源需求成员数 <= 最大值
        && 请求.最大条件状态数 <= 最大值
        && 请求.最大场景成员数 <= 最大值;
}

constexpr 任务筹办当前就绪结论 映射动作组读取状态(
    L2方法完整有序动作组读取状态 状态) noexcept {
    switch (状态) {
    case L2方法完整有序动作组读取状态::已读取:
        return 任务筹办当前就绪结论::已就绪;
    case L2方法完整有序动作组读取状态::未找到:
    case L2方法完整有序动作组读取状态::动作范围不闭合:
        return 任务筹办当前就绪结论::方法结构待补齐;
    case L2方法完整有序动作组读取状态::当前性漂移:
    case L2方法完整有序动作组读取状态::方法版本漂移:
        return 任务筹办当前就绪结论::当前性漂移;
    case L2方法完整有序动作组读取状态::引用冲突:
        return 任务筹办当前就绪结论::引用冲突;
    case L2方法完整有序动作组读取状态::资源失败:
        return 任务筹办当前就绪结论::资源失败;
    case L2方法完整有序动作组读取状态::入口拒绝:
        return 任务筹办当前就绪结论::入口拒绝;
    case L2方法完整有序动作组读取状态::许可拒绝:
        return 任务筹办当前就绪结论::许可拒绝;
    case L2方法完整有序动作组读取状态::内部错误:
    default:
        return 任务筹办当前就绪结论::内部错误;
    }
}

constexpr 任务筹办当前就绪结论 映射正式选择状态(
    L2任务筹办正式选择状态_v2 状态) noexcept {
    switch (状态) {
    case L2任务筹办正式选择状态_v2::已形成:
    case L2任务筹办正式选择状态_v2::精确重复:
        return 任务筹办当前就绪结论::已就绪;
    case L2任务筹办正式选择状态_v2::已可能发布:
        return 任务筹办当前就绪结论::正式选择待收束;
    case L2任务筹办正式选择状态_v2::幂等冲突:
        return 任务筹办当前就绪结论::幂等冲突;
    case L2任务筹办正式选择状态_v2::入口拒绝:
        return 任务筹办当前就绪结论::入口拒绝;
    case L2任务筹办正式选择状态_v2::许可拒绝:
        return 任务筹办当前就绪结论::许可拒绝;
    case L2任务筹办正式选择状态_v2::当前性漂移:
        return 任务筹办当前就绪结论::当前性漂移;
    case L2任务筹办正式选择状态_v2::引用冲突:
        return 任务筹办当前就绪结论::引用冲突;
    case L2任务筹办正式选择状态_v2::资源失败:
        return 任务筹办当前就绪结论::资源失败;
    case L2任务筹办正式选择状态_v2::内部错误:
    default:
        return 任务筹办当前就绪结论::内部错误;
    }
}

L2任务筹办归因证据引用 取得归因证据(
    const L2任务筹办规范化来源材料& 来源材料) {
    return std::visit([](const auto& 来源) -> L2任务筹办归因证据引用 {
        using 来源类型 = std::decay_t<decltype(来源)>;
        if constexpr (std::is_same_v<来源类型,
                L2任务初次筹办规范化来源材料>)
            return 来源.首次准备记录;
        // 只保留 legacy 来源的源码兼容；current 普通入口已在任何正式读取前阻断该分支。
        else
            return 来源.正式目标裁决证据;
    }, 来源材料);
}

