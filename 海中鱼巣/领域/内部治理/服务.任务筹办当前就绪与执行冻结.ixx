namespace 海中鱼巣 {

任务筹办当前就绪结果_v2
任务筹办当前就绪与执行冻结提供者::形成当前可执行冻结_v2(
    const 任务筹办当前就绪请求_v2& 请求) noexcept {
    任务筹办当前就绪内部::任务筹办当前就绪上下文 上下文{
        任务服务_, 需求服务_, 方法服务_, 状态服务_, 特征服务_, 场景服务_};
    return 任务筹办当前就绪内部::执行(上下文, 请求);
}

任务筹办当前就绪结果_v2
任务筹办当前就绪内部::执行(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求) noexcept {
    using namespace 任务筹办当前就绪内部;
    if (!请求有效(请求))
        return 形成结果(任务筹办当前就绪结论::入口拒绝);
    if (!std::holds_alternative<L2任务初次筹办规范化来源材料>(
            请求.正式选择基础材料.来源材料))
        return 形成结果(任务筹办当前就绪结论::入口拒绝);
    try {
        任务筹办当前就绪结果_v2 结果;
        L2按任务读取当前任务与轮次结果 任务读取;
        L2任务身份来源读取结果 身份来源读取;
        L2普通方法事实 方法;
        L2方法结果事实 主轴;
        if (!读取初始材料(上下文, 请求, 结果, 任务读取, 身份来源读取,
                方法, 主轴))
            return 结果;
        const auto& 查找 = 请求.方法查找结果;
        结果 = 形成条件与输入冻结(上下文, 请求, 查找, 方法, 主轴,
            std::move(结果));
        if (结果.结论 != 任务筹办当前就绪结论::已就绪)
            return 结果;
        return 完成动作冻结与正式选择(上下文, 请求, 任务读取, 身份来源读取,
            查找, 方法, 主轴, std::move(结果));
    } catch (const std::bad_alloc&) {
        return 形成结果(任务筹办当前就绪结论::资源失败);
    } catch (const std::length_error&) {
        return 形成结果(任务筹办当前就绪结论::资源失败);
    } catch (...) {
        return 形成结果(任务筹办当前就绪结论::内部错误);
    }
}

bool 任务筹办当前就绪内部::读取初始材料(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    任务筹办当前就绪结果_v2& 结果,
    L2按任务读取当前任务与轮次结果& 任务读取,
    L2任务身份来源读取结果& 身份来源读取,
    L2普通方法事实& 方法,
    L2方法结果事实& 主轴) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    const auto& 查找 = 请求.方法查找结果;
    if (!查找.成功()) {
        结果 = 形成结果(映射查找状态(查找.状态), 查找.共同事实截止);
        return false;
    }
    if (!查找.结论
        || *查找.结论 != 任务特征方法查找结论::已采用且无需条件提议
        || 查找.共同事实截止 != G || 查找.任务 != 请求.任务
        || 查找.任务轮次 != 请求.任务轮次
        || 查找.筹办轮次 != 请求.筹办轮次
        || !查找.采用方案 || !查找.任务目标) {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }
    if (!读取任务与筹办材料(上下文, 请求, 查找, 结果, 任务读取, 身份来源读取))
        return false;
    return 读取方法与来源需求材料(
        上下文, 请求, 查找, 任务读取, 结果, 方法, 主轴);
}

bool 任务筹办当前就绪内部::读取任务与筹办材料(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    const 任务特征方法查找结果& 查找,
    任务筹办当前就绪结果_v2& 结果,
    L2按任务读取当前任务与轮次结果& 任务读取,
    L2任务身份来源读取结果& 身份来源读取) {
    if (!读取任务当前轮次材料(上下文, 请求, 结果, 任务读取))
        return false;
    return 读取身份与筹办材料(
        上下文, 请求, 查找, 任务读取, 结果, 身份来源读取);
}

bool 任务筹办当前就绪内部::读取任务当前轮次材料(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    任务筹办当前就绪结果_v2& 结果,
    L2按任务读取当前任务与轮次结果& 任务读取) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    任务读取 = 上下文.任务服务.按任务读取当前任务与轮次({
        L2按任务读取当前任务与轮次合同版本, 请求.请求头, 请求.任务});
    if (任务读取.结果头.事实截止代次 != G
        || 任务读取.本次正式读回截止 != G) {
        结果 = 形成结果(任务筹办当前就绪结论::当前性漂移,
            任务读取.结果头.事实截止代次);
        return false;
    }
    if (任务读取.状态 != L2按任务读取当前任务与轮次状态::已读取
        || !任务读取.成功() || !任务读取.任务 || !任务读取.当前任务轮次) {
        结果 = 形成结果(映射结构读取状态(任务读取.结果头.状态), G);
        return false;
    }
    if (任务读取.任务->身份 != 请求.任务
        || 任务读取.当前任务轮次->身份 != 请求.任务轮次
        || 任务读取.当前任务轮次->任务 != 请求.任务) {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }

    return true;
}

bool 任务筹办当前就绪内部::读取身份与筹办材料(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    const 任务特征方法查找结果& 查找,
    const L2按任务读取当前任务与轮次结果& 任务读取,
    任务筹办当前就绪结果_v2& 结果,
    L2任务身份来源读取结果& 身份来源读取) {
    if (!读取身份来源材料(上下文, 请求, 结果, 身份来源读取))
        return false;
    return 读取筹办分区材料(
        上下文.任务服务, 请求, 查找, 任务读取, 结果);
}

bool 任务筹办当前就绪内部::读取身份来源材料(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    任务筹办当前就绪结果_v2& 结果,
    L2任务身份来源读取结果& 身份来源读取) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    身份来源读取 = 上下文.任务服务.读取任务身份来源(
        {请求.请求头, L2读取类别::当前, 请求.任务, 0});
    if (身份来源读取.结果头.事实截止代次 != G) {
        结果 = 形成结果(任务筹办当前就绪结论::当前性漂移,
            身份来源读取.结果头.事实截止代次);
        return false;
    }
    if (!身份来源读取.成功() || !身份来源读取.身份来源) {
        结果 = 形成结果(映射结构读取状态(身份来源读取.结果头.状态), G);
        return false;
    }
    if (身份来源读取.身份来源->任务节点 != 请求.任务.值
        || !任务身份来源事实逐项相同(*身份来源读取.身份来源,
            请求.正式选择基础材料.任务身份来源)) {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }

    return true;
}

bool 任务筹办当前就绪内部::读取筹办分区材料(
    L2任务结构服务& 任务服务,
    const 任务筹办当前就绪请求_v2& 请求,
    const 任务特征方法查找结果& 查找,
    const L2按任务读取当前任务与轮次结果& 任务读取,
    任务筹办当前就绪结果_v2& 结果) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    L2按任务读取筹办轮次分区请求 筹办读取请求;
    筹办读取请求.请求头 = 请求.请求头;
    筹办读取请求.读取类别 = L2读取类别::当前;
    筹办读取请求.任务 = 请求.任务;
    筹办读取请求.历史截止事实代次 = 0;
    return [&](const auto& 筹办分区) -> bool {
        if (筹办分区.结果头.事实截止代次 != G) {
            结果 = 形成结果(任务筹办当前就绪结论::当前性漂移,
                筹办分区.结果头.事实截止代次);
            return false;
        }
        if (筹办分区.结果头.状态 != L2结构状态::已读取) {
            结果 = 形成结果(映射结构读取状态(筹办分区.结果头.状态), G);
            return false;
        }
        if (筹办分区.结果头.变更事实代次
            || 筹办分区.分区 != L2任务筹办轮次分区::统一轮次权威
            || !筹办分区.统一当前准备) {
            结果 = 形成结果(任务筹办当前就绪结论::内部错误, G);
            return false;
        }
        const auto& 当前准备 = *筹办分区.统一当前准备;
        if (当前准备.任务.身份 != 请求.任务
            || 当前准备.任务.需求列表项 != 任务读取.任务->需求列表项
            || !当前准备.轮次权威.任务轮次
            || *当前准备.轮次权威.任务轮次 != 请求.任务轮次
            || 当前准备.轮次权威.身份 != 请求.筹办轮次
            || 当前准备.当前筹办轮次 != 查找.筹办轮次序号) {
            结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
            return false;
        }
        return true;
    }(任务服务.按任务读取筹办轮次分区(筹办读取请求));
}

bool 任务筹办当前就绪内部::读取方法与来源需求材料(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    const 任务特征方法查找结果& 查找,
    const L2按任务读取当前任务与轮次结果& 任务读取,
    任务筹办当前就绪结果_v2& 结果,
    L2普通方法事实& 方法,
    L2方法结果事实& 主轴) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    const auto& 采用方案 = *查找.采用方案;
    const auto 方法读取 = 上下文.方法服务.读取普通方法({请求.请求头,
        L2普通方法结构合同版本, L2读取类别::当前, 采用方案.方法, 0});
    if (方法读取.结果头.事实截止代次 != G) {
        结果 = 形成结果(任务筹办当前就绪结论::当前性漂移,
            方法读取.结果头.事实截止代次);
        return false;
    }
    if (!方法读取.成功() || !方法读取.方法) {
        结果 = 形成结果(映射结构读取状态(方法读取.结果头.状态), G);
        return false;
    }
    方法 = *方法读取.方法;
    if (方法.方法 != 采用方案.方法 || 方法.内容版本 != 采用方案.内容版本
        || 方法.规格版本 != 采用方案.规格版本
        || 方法.生命周期事实.方法 != 方法.方法
        || 方法.生命周期事实.生命周期.退出事实代次) {
        结果 = 形成结果(任务筹办当前就绪结论::当前性漂移, G);
        return false;
    }

    const auto 成员读取 = 上下文.需求服务.读取需求列表成员({请求.请求头,
        L2读取类别::当前, 任务读取.任务->需求列表项, 0});
    if (成员读取.结果头.事实截止代次 != G) {
        结果 = 形成结果(任务筹办当前就绪结论::当前性漂移,
            成员读取.结果头.事实截止代次);
        return false;
    }
    if (!成员读取.成功()) {
        结果 = 形成结果(映射结构读取状态(成员读取.结果头.状态), G);
        return false;
    }
    if (成员读取.成员需求组.empty()) {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }
    if (成员读取.成员需求组.size() > 请求.最大来源需求成员数) {
        结果 = 形成结果(任务筹办当前就绪结论::数量预算不足, G);
        return false;
    }
    auto 来源需求组 = 成员读取.成员需求组;
    std::sort(来源需求组.begin(), 来源需求组.end(), 来源需求事实小于);
    if (std::adjacent_find(来源需求组.begin(), 来源需求组.end(),
            [](const auto& 左, const auto& 右) {
                return 左.身份 == 右.身份;
            }) != 来源需求组.end()) {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }
    std::vector<L2需求身份> 来源需求身份组;
    来源需求身份组.reserve(来源需求组.size());
    for (const auto& 来源需求 : 来源需求组)
        来源需求身份组.push_back(来源需求.身份);
    const auto 主轴位置 = std::find_if(方法.结果.begin(), 方法.结果.end(),
        [&](const auto& 项) { return 项.身份 == 采用方案.主轴结果; });
    if (主轴位置 == 方法.结果.end()) {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }
    const auto& 选择基础 = 请求.正式选择基础材料;
    if (选择基础.方法生命周期 != 方法.生命周期事实
        || 选择基础.来源需求组 != 来源需求身份组
        || L2取得任务筹办任务(选择基础.来源材料) != 请求.任务
        || L2取得任务筹办轮次(选择基础.来源材料) != 查找.筹办轮次序号) {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }
    主轴 = *主轴位置;
    结果.结论 = 任务筹办当前就绪结论::已就绪;
    结果.共同事实截止 = G;
    结果.当前方法 = 方法;
    结果.来源需求组 = std::move(来源需求组);
    结果.主轴结果 = 主轴;
    return true;
}

任务筹办当前就绪结果_v2
任务筹办当前就绪内部::形成条件与输入冻结(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    const 任务特征方法查找结果& 查找,
    const L2普通方法事实& 方法,
    const L2方法结果事实& 主轴,
    任务筹办当前就绪结果_v2 结果) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    const auto& 选择基础 = 请求.正式选择基础材料;
    std::vector<L2方法条件身份> 条件身份组;
    for (const auto& 关系 : 方法.条件结果关系)
        if (关系.结果 == 主轴.身份
            && std::find(条件身份组.begin(), 条件身份组.end(), 关系.条件)
                == 条件身份组.end())
            条件身份组.push_back(关系.条件);
    if (条件身份组.size() > 请求.最大条件状态数) {
        结果.结论 = 任务筹办当前就绪结论::数量预算不足;
        return 结果;
    }
    const auto 属于主轴 = [&](const auto& 项) {
        return !项.条件 || std::find(条件身份组.begin(), 条件身份组.end(),
            *项.条件) != 条件身份组.end();
    };

    std::vector<L2状态事实> 主体当前状态;
    if (!条件身份组.empty()) {
        const auto 状态组 = 上下文.状态服务.按主体读取全部当前状态(
            {请求.请求头, 查找.任务目标->目标宿主,
                请求.最大条件状态数});
        if (状态组.结果头.事实截止代次 != G)
            return 形成结果(任务筹办当前就绪结论::当前性漂移,
                状态组.结果头.事实截止代次);
        if (!状态组.成功())
            return 形成结果(映射结构读取状态(状态组.结果头.状态), G);
        主体当前状态 = 状态组.状态;
    }
    for (const auto 条件身份 : 条件身份组) {
        const auto 条件 = std::find_if(方法.条件.begin(), 方法.条件.end(),
            [&](const auto& 项) { return 项.身份 == 条件身份; });
        if (条件 == 方法.条件.end()
            || 条件->作用对象角色 != 主轴.作用对象角色) {
            结果.结论 = 任务筹办当前就绪结论::输入待绑定;
            return 结果;
        }
        std::vector<L2状态事实> 匹配状态;
        for (const auto& 当前状态 : 主体当前状态) {
            const auto 特征实例读取 = 上下文.特征服务.读取完整特征实例(
                {请求.请求头, L2读取类别::当前, 当前状态.特征实例, 0});
            if (特征实例读取.结果头.事实截止代次 != G)
                return 形成结果(任务筹办当前就绪结论::当前性漂移,
                    特征实例读取.结果头.事实截止代次);
            if (特征实例读取.结果头.状态 != L2结构状态::已读取
                || !特征实例读取.特征实例)
                return 形成结果(
                    映射结构读取状态(特征实例读取.结果头.状态), G);
            if (特征实例读取.特征实例->特征定义 == 条件->特征定义)
                匹配状态.push_back(当前状态);
        }
        if (匹配状态.size() != 1) {
            结果.结论 = 匹配状态.empty()
                ? 任务筹办当前就绪结论::条件未满足
                : 任务筹办当前就绪结论::引用冲突;
            return 结果;
        }
        L2特征比较具名关系 具名关系{};
        std::uint8_t 允许关系位 = 0;
        const auto 比较结论 = 比较状态与合同(匹配状态.front(),
            条件->特征定义, 条件->条件状态合同,
            来源幂等键值(L2取得任务筹办来源幂等身份(
                选择基础.来源材料))
                ^ 条件->身份.值.值,
            G, 上下文.状态服务, 上下文.特征服务, 具名关系, 允许关系位);
        if (比较结论 != 任务筹办当前就绪结论::已就绪) {
            结果.结论 = 比较结论;
            return 结果;
        }
        const auto 当前关系位 = 关系位(具名关系);
        if (!当前关系位 || (允许关系位 & *当前关系位) == 0) {
            结果.结论 = 任务筹办当前就绪结论::条件未满足;
            return 结果;
        }
        std::optional<L2存在场景成员引用事实> 场景成员;
        if (条件->场景) {
            const auto 场景读取 = 上下文.场景服务.读取存在当前场景成员引用(
                {请求.请求头, 查找.任务目标->目标宿主});
            if (场景读取.结果头.事实截止代次 != G)
                return 形成结果(任务筹办当前就绪结论::当前性漂移,
                    场景读取.结果头.事实截止代次);
            if (!场景读取.成功())
                return 形成结果(映射结构读取状态(场景读取.结果头.状态), G);
            if (场景读取.引用.size() > 请求.最大场景成员数) {
                结果.结论 = 任务筹办当前就绪结论::数量预算不足;
                return 结果;
            }
            const auto 成员 = std::find_if(场景读取.引用.begin(),
                场景读取.引用.end(), [&](const auto& 引用) {
                    return 引用.场景 == *条件->场景
                        && 引用.存在 == 查找.任务目标->目标宿主;
                });
            if (成员 == 场景读取.引用.end()) {
                结果.结论 = 任务筹办当前就绪结论::条件未满足;
                return 结果;
            }
            场景成员 = *成员;
        }
        结果.条件证据组.push_back({*条件, 查找.任务目标->目标宿主,
            条件->场景, 场景成员, 匹配状态.front(), 具名关系,
            允许关系位});
    }

    for (const auto& 输入 : 方法.输入规格) if (属于主轴(输入)) {
        const auto 绑定 = std::find_if(查找.采用方案输入规格.begin(),
            查找.采用方案输入规格.end(), [&](const auto& 项) {
                return 项.输入规格 == 输入.身份;
            });
        if (绑定 == 查找.采用方案输入规格.end() || !绑定->绑定目标存在
            || 绑定->语义.作用对象角色 != 输入.作用对象角色
            || 绑定->语义.顺序 != 输入.顺序
            || !L2任务冻结方法规格材料相同(绑定->语义.规格, 输入.规格)) {
            结果.结论 = 任务筹办当前就绪结论::输入待绑定;
            return 结果;
        }
        结果.输入冻结组.push_back({输入, *绑定->绑定目标存在});
        结果.参数冻结组.push_back({输入.身份, 输入.作用对象角色,
            输入.规格, *绑定->绑定目标存在});
    }
    for (const auto& 限制 : 方法.限制条件) if (属于主轴(限制)) {
        const auto 绑定 = std::find_if(查找.采用方案限制条件.begin(),
            查找.采用方案限制条件.end(), [&](const auto& 项) {
                return 项.限制条件 == 限制.身份;
            });
        if (绑定 == 查找.采用方案限制条件.end() || !绑定->绑定目标存在) {
            结果.结论 = 任务筹办当前就绪结论::输入待绑定;
            return 结果;
        }
        结果.结论 = 任务筹办当前就绪结论::限制待解释;
        return 结果;
    }
    return 结果;
}

bool 任务筹办当前就绪内部::形成动作范围与任务冻结(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    const 任务特征方法查找结果& 查找,
    const L2普通方法事实& 方法,
    const L2方法结果事实& 主轴,
    任务筹办当前就绪结果_v2& 结果,
    L2任务执行绑定冻结材料提交项_v2& 任务冻结) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    const auto& 选择基础 = 请求.正式选择基础材料;
    const auto 动作组读取 = 上下文.方法服务.读取完整有序方法动作入口组_v2({
        L2方法完整有序动作组读取合同版本_v2, 请求.请求头,
        方法.方法, 方法.内容版本});
    结果.方法动作组正式读回 = 动作组读取;
    if (动作组读取.本次正式读回截止 != 0
        && 动作组读取.本次正式读回截止 != G) {
        结果.结论 = 任务筹办当前就绪结论::当前性漂移;
        return false;
    }
    if (!动作组读取.成功()) {
        结果.结论 = 动作组读取.状态
                == L2方法完整有序动作组读取状态::已读取
            ? 任务筹办当前就绪结论::内部错误
            : 映射动作组读取状态(动作组读取.状态);
        return false;
    }
    if (动作组读取.本次正式读回截止 != G) {
        结果.结论 = 任务筹办当前就绪结论::当前性漂移;
        return false;
    }
    for (const auto& 动作 : 动作组读取.完整有序动作入口组) {
        if (动作.方法 != 方法.方法 || 动作.方法内容版本 != 方法.内容版本) {
            结果.结论 = 任务筹办当前就绪结论::引用冲突;
            return false;
        }
    }

    结果.完整有序冻结动作范围.reserve(
        动作组读取.完整有序动作入口组.size());
    std::vector<L2任务执行路径动作冻结项_v2> task动作组;
    task动作组.reserve(动作组读取.完整有序动作入口组.size());
    for (const auto& 动作 : 动作组读取.完整有序动作入口组) {
        结果.完整有序冻结动作范围.push_back({动作.顺序, 动作.身份,
            动作.稳定动作键,
            static_cast<任务动作作用范围>(动作.作用范围),
            动作.作用主体约束,
            动作.场景约束, 动作.动作范围材料, 动作.预期结果材料,
            动作.结果验证合同, 动作.动作归因合同});
        task动作组.push_back({动作.身份, 动作.方法, 动作.方法内容版本,
            动作.顺序, 动作.稳定动作键, 动作.作用范围,
            动作.作用主体约束, 动作.场景约束, 动作.动作范围材料,
            动作.技术许可合同版本, 动作.预期结果材料,
            动作.结果验证合同, 动作.动作归因合同, 动作.生命周期});
    }

    任务冻结.任务 = 请求.任务;
    任务冻结.筹办轮次 = 查找.筹办轮次序号;
    任务冻结.方法 = 方法.方法;
    任务冻结.方法内容版本 = 方法.内容版本;
    任务冻结.条件证据组.reserve(结果.条件证据组.size());
    for (const auto& 项 : 结果.条件证据组)
        任务冻结.条件证据组.push_back({项.条件, 项.绑定目标, 项.场景,
            项.场景成员, 项.当前状态, 项.具名关系, 项.允许关系位});
    任务冻结.输入冻结组.reserve(结果.输入冻结组.size());
    for (const auto& 项 : 结果.输入冻结组)
        任务冻结.输入冻结组.push_back({项.输入规格, 项.绑定目标});
    任务冻结.参数冻结组.reserve(结果.参数冻结组.size());
    for (const auto& 项 : 结果.参数冻结组)
        任务冻结.参数冻结组.push_back({项.来源输入规格, 项.作用对象角色,
            项.参数规格, 项.绑定目标});
    任务冻结.限制证据组.reserve(结果.限制证据组.size());
    for (const auto& 项 : 结果.限制证据组)
        任务冻结.限制证据组.push_back({项.限制条件, 项.绑定目标,
            项.解释器, 项.解释规则版本, 项.当前事实证据, 项.已满足});
    任务冻结.完整有序动作组 = std::move(task动作组);
    任务冻结.主轴结果 = 主轴;
    任务冻结.验证合同 = 查找.任务目标->目标状态合同;
    任务冻结.归因证据 = 取得归因证据(选择基础.来源材料);
    任务冻结.失效事实截止 = G;
    return true;
}

bool 任务筹办当前就绪内部::尾部当前性仍一致(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    const L2按任务读取当前任务与轮次结果& 任务读取,
    const L2任务身份来源读取结果& 身份来源读取,
    const L2普通方法事实& 方法,
    任务筹办当前就绪结果_v2& 结果) {
    using namespace 任务筹办当前就绪内部;
    const auto G = 请求.请求头.期望事实代次;
    const auto 尾任务 = 上下文.任务服务.按任务读取当前任务与轮次(
        {L2按任务读取当前任务与轮次合同版本,
            请求.请求头, 请求.任务});
    const auto 尾身份来源 = 上下文.任务服务.读取任务身份来源(
        {请求.请求头, L2读取类别::当前, 请求.任务, 0});
    const auto 尾方法 = 上下文.方法服务.读取普通方法({请求.请求头,
        L2普通方法结构合同版本, L2读取类别::当前, 方法.方法, 0});
    if (尾任务.结果头.事实截止代次 != G
        || 尾任务.本次正式读回截止 != G
        || 尾身份来源.结果头.事实截止代次 != G
        || 尾方法.结果头.事实截止代次 != G) {
        结果 = 形成结果(任务筹办当前就绪结论::当前性漂移, G);
        return false;
    }
    if (尾任务.状态 != L2按任务读取当前任务与轮次状态::已读取
        || !尾任务.成功() || !尾任务.任务 || !尾任务.当前任务轮次
        || !任务事实逐项相同(*尾任务.任务, *任务读取.任务)
        || !任务轮次事实逐项相同(*尾任务.当前任务轮次,
            *任务读取.当前任务轮次)
        || !尾身份来源.成功() || !尾身份来源.身份来源
        || !任务身份来源事实逐项相同(*尾身份来源.身份来源,
            *身份来源读取.身份来源)
        || !尾方法.成功() || !尾方法.方法 || *尾方法.方法 != 方法)
    {
        结果 = 形成结果(任务筹办当前就绪结论::引用冲突, G);
        return false;
    }
    return true;
}

任务筹办当前就绪结果_v2
任务筹办当前就绪内部::完成动作冻结与正式选择(
    任务筹办当前就绪上下文& 上下文,
    const 任务筹办当前就绪请求_v2& 请求,
    const L2按任务读取当前任务与轮次结果& 任务读取,
    const L2任务身份来源读取结果& 身份来源读取,
    const 任务特征方法查找结果& 查找,
    const L2普通方法事实& 方法,
    const L2方法结果事实& 主轴,
    任务筹办当前就绪结果_v2 结果) {
    using namespace 任务筹办当前就绪内部;
    L2任务执行绑定冻结材料提交项_v2 任务冻结;
    if (!形成动作范围与任务冻结(
            上下文, 请求, 查找, 方法, 主轴, 结果, 任务冻结))
        return 结果;
    if (!尾部当前性仍一致(
            上下文, 请求, 任务读取, 身份来源读取, 方法, 结果))
        return 结果;

    const auto 正式选择 = 上下文.任务服务.发布任务筹办正式选择_v2({
        L2任务筹办正式选择合同版本_v2, 请求.请求头,
        请求.正式选择基础材料, *结果.方法动作组正式读回,
        std::move(任务冻结)});
    结果.正式选择结果 = 正式选择;
    if (正式选择.成功())
        结果.结论 = 任务筹办当前就绪结论::已就绪;
    else {
        结果.结论 = 映射正式选择状态(正式选择.状态);
        if (结果.结论 == 任务筹办当前就绪结论::已就绪)
            结果.结论 = 任务筹办当前就绪结论::内部错误;
    }
    return 结果;
}

} // namespace 海中鱼巣
