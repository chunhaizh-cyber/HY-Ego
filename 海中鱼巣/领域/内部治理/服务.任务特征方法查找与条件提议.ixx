export {
#include "任务特征方法查找与条件提议.数据.h"
}

bool 海中鱼巣::任务特征方法查找结果::成功() const noexcept {
    if (状态 != 任务特征方法查找状态::已评估) return false;
    if (!结论 || 共同事实截止 == 0 || !已互证工作包 || !任务目标
        || !下一筹办工作包完整(*已互证工作包)
        || 已互证工作包->迁移后事实代次 != 共同事实截止
        || !有效(任务目标->目标宿主.值) || !有效(任务目标->目标特征.值)
        || !有效(任务目标->目标状态合同.值)) return false;
    const bool 有当前比较 = 当前实际状态 && 目标比较具名关系
        && 允许关系位 >= 1 && 允许关系位 <= 7;
    if (!有当前比较) return false;
    const bool 无方法侧载荷 = 当前对象概念.empty()
        && 对象概念祖先闭包.empty() && !完整粗召回
        && 不兼容证据.empty() && 适用候选.empty() && 结构缺口.empty()
        && !采用方案 && 采用方案输入规格.empty()
        && 采用方案限制条件.empty() && 未绑定输入限制.empty()
        && 缺失条件草案.empty() && 实际扫描用途事实数 == 0;
    const bool 无采用侧载荷 = !采用方案 && 采用方案输入规格.empty()
        && 采用方案限制条件.empty() && 未绑定输入限制.empty()
        && 缺失条件草案.empty();
    switch (*结论) {
    case 任务特征方法查找结论::所需方向不唯一:
        return !所需方向 && 无方法侧载荷;
    case 任务特征方法查找结论::对象概念待形成:
        return 所需方向 && 当前对象概念.empty()
            && 对象概念祖先闭包.empty() && !完整粗召回
            && 不兼容证据.empty() && 适用候选.empty()
            && 结构缺口.empty() && 无采用侧载荷
            && 实际扫描用途事实数 == 0;
    case 任务特征方法查找结论::方法能力缺失:
        return 所需方向 && !当前对象概念.empty()
            && !对象概念祖先闭包.empty() && 完整粗召回
            && 完整粗召回->empty() && 不兼容证据.empty()
            && 适用候选.empty() && 结构缺口.empty() && 无采用侧载荷;
    case 任务特征方法查找结论::当前无适用方法:
        return 所需方向 && !当前对象概念.empty()
            && !对象概念祖先闭包.empty()
            && 完整粗召回 && !完整粗召回->empty()
            && !不兼容证据.empty() && 适用候选.empty()
            && 结构缺口.empty() && 无采用侧载荷;
    case 任务特征方法查找结论::方法结构待补齐:
        return 所需方向 && !当前对象概念.empty()
            && !对象概念祖先闭包.empty()
            && 完整粗召回 && !完整粗召回->empty()
            && 适用候选.empty() && !结构缺口.empty() && 无采用侧载荷;
    case 任务特征方法查找结论::多候选待选择证据:
        return 所需方向 && !当前对象概念.empty()
            && !对象概念祖先闭包.empty()
            && 完整粗召回 && !完整粗召回->empty()
            && 适用候选.size() >= 2 && 无采用侧载荷;
    case 任务特征方法查找结论::已采用且无需条件提议:
        return 所需方向 && !当前对象概念.empty()
            && !对象概念祖先闭包.empty()
            && 完整粗召回 && !完整粗召回->empty()
            && 适用候选.size() == 1 && 采用方案
            && *采用方案 == 适用候选.front()
            && 未绑定输入限制.empty() && 缺失条件草案.empty();
    case 任务特征方法查找结论::已采用且存在缺失条件:
        return 所需方向 && !当前对象概念.empty()
            && !对象概念祖先闭包.empty()
            && 完整粗召回 && !完整粗召回->empty()
            && 适用候选.size() == 1 && 采用方案
            && *采用方案 == 适用候选.front() && !缺失条件草案.empty();
    case 任务特征方法查找结论::已采用且输入限制待绑定:
        return 所需方向 && !当前对象概念.empty()
            && !对象概念祖先闭包.empty()
            && 完整粗召回 && !完整粗召回->empty()
            && 适用候选.size() == 1 && 采用方案
            && *采用方案 == 适用候选.front()
            && !未绑定输入限制.empty() && 缺失条件草案.empty();
    }
    return false;
}

namespace 海中鱼巣::任务特征方法查找内部 {

任务特征方法查找结果 失败(任务特征方法查找状态 状态) noexcept {
    任务特征方法查找结果 结果;
    结果.状态 = 状态;
    return 结果;
}

constexpr 任务特征方法查找状态 映射状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::数量预算不足:
        return 任务特征方法查找状态::数量预算不足;
    case L2结构状态::事实代次漂移:
        return 任务特征方法查找状态::当前性漂移;
    case L2结构状态::引用冲突:
    case L2结构状态::幂等冲突:
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::属性未设置:
        return 任务特征方法查找状态::引用冲突;
    case L2结构状态::入口拒绝:
    case L2结构状态::许可拒绝:
        return 任务特征方法查找状态::入口拒绝;
    case L2结构状态::资源失败:
        return 任务特征方法查找状态::资源失败;
    case L2结构状态::未实现:
    case L2结构状态::内部不一致:
    case L2结构状态::已提交:
    case L2结构状态::精确重复:
    case L2结构状态::已读取:
    default:
        return 任务特征方法查找状态::内部错误;
    }
}

static_assert(映射状态(L2结构状态::数量预算不足)
    == 任务特征方法查找状态::数量预算不足);
static_assert(映射状态(L2结构状态::事实代次漂移)
    == 任务特征方法查找状态::当前性漂移);
static_assert(映射状态(L2结构状态::引用冲突)
    == 任务特征方法查找状态::引用冲突);
static_assert(映射状态(L2结构状态::幂等冲突)
    == 任务特征方法查找状态::引用冲突);
static_assert(映射状态(L2结构状态::入口拒绝)
    == 任务特征方法查找状态::入口拒绝);
static_assert(映射状态(L2结构状态::许可拒绝)
    == 任务特征方法查找状态::入口拒绝);
static_assert(映射状态(L2结构状态::资源失败)
    == 任务特征方法查找状态::资源失败);
static_assert(映射状态(L2结构状态::未实现)
    == 任务特征方法查找状态::内部错误);
static_assert(映射状态(L2结构状态::内部不一致)
    == 任务特征方法查找状态::内部错误);
static_assert(映射状态(L2结构状态::未找到)
    == 任务特征方法查找状态::引用冲突);
static_assert(映射状态(L2结构状态::已退出)
    == 任务特征方法查找状态::引用冲突);
static_assert(映射状态(L2结构状态::属性未设置)
    == 任务特征方法查找状态::引用冲突);
static_assert(映射状态(L2结构状态::已提交)
    == 任务特征方法查找状态::内部错误);
static_assert(映射状态(L2结构状态::精确重复)
    == 任务特征方法查找状态::内部错误);
static_assert(映射状态(L2结构状态::已读取)
    == 任务特征方法查找状态::内部错误);

bool 请求有效(const 任务特征方法查找请求& 请求) noexcept {
    const auto 最大值 = static_cast<std::uint64_t>(
        (std::numeric_limits<std::size_t>::max)());
    return 请求.合同版本 == 任务特征方法查找合同版本
        && L2结构请求头合同有效(请求.请求头)
        && 请求.请求头.期望事实代次 != 0
        && 下一筹办工作包完整(请求.工作包)
        && 请求.请求头.期望事实代次 == 请求.工作包.迁移后事实代次
        && 请求.最大扫描用途事实数 != 0
        && 请求.最大粗召回方法数 != 0
        && 请求.最大概念支持扫描事实数 != 0
        && 请求.最大概念支持关系数 != 0
        && 请求.最大概念祖先关系数 != 0
        && 请求.最大主体状态数 != 0
        && 请求.最大场景成员数 != 0
        && 请求.最大方法条件数 != 0
        && 请求.最大概念支持扫描事实数 <= 最大值
        && 请求.最大概念支持关系数 <= 最大值
        && 请求.最大概念祖先关系数 <= 最大值;
}

std::optional<std::uint8_t> 关系位(L2特征比较具名关系 关系) noexcept {
    switch (关系) {
    case L2特征比较具名关系::当前低于目标: return 0x01U;
    case L2特征比较具名关系::当前达到目标: return 0x02U;
    case L2特征比较具名关系::当前高于目标: return 0x04U;
    default: return std::nullopt;
    }
}

bool 候选小于(const 任务方法适用候选& 左,
    const 任务方法适用候选& 右) noexcept {
    if (左.方法.值.值 != 右.方法.值.值)
        return 左.方法.值.值 < 右.方法.值.值;
    if (左.主轴结果.值.值 != 右.主轴结果.值.值)
        return 左.主轴结果.值.值 < 右.主轴结果.值.值;
    return 左.匹配用途.值.值 < 右.匹配用途.值.值;
}

bool 缺口小于(const L2方法结构缺口& 左,
    const L2方法结构缺口& 右) noexcept {
    if (左.类型 != 右.类型)
        return static_cast<std::uint8_t>(左.类型)
            < static_cast<std::uint8_t>(右.类型);
    const auto 左条件 = 左.条件 ? 左.条件->值.值 : 0;
    const auto 右条件 = 右.条件 ? 右.条件->值.值 : 0;
    if (左条件 != 右条件) return 左条件 < 右条件;
    return 左.结果.value_or(L2方法结果身份{}).值.值
        < 右.结果.value_or(L2方法结果身份{}).值.值;
}

任务特征方法查找状态 比较状态与合同(
    const L2状态事实& 状态,
    L2特征定义身份 特征,
    L2目标状态合同身份 合同身份,
    std::uint64_t 请求身份,
    std::uint64_t G,
    const L2状态结构服务& 状态服务,
    const L2特征结构服务& 特征服务,
    L2特征比较具名关系& 具名关系,
    std::uint8_t& 允许关系位) {
    const L2结构请求头 头{L2结构合同版本, G};
    const auto 合同读取 = 状态服务.读取完整目标状态合同(
        {头, L2读取类别::当前, 合同身份, 0});
    if (合同读取.结果头.事实截止代次 != G)
        return 任务特征方法查找状态::当前性漂移;
    if (!合同读取.成功() || !合同读取.合同)
        return 映射状态(合同读取.结果头.状态);
    const auto& 合同 = *合同读取.合同;
    if (合同.身份 != 合同身份 || 合同.特征定义 != 特征
        || 合同.比较用途 != L2特征比较用途::目标判断)
        return 任务特征方法查找状态::引用冲突;
    const auto 注册读取 = 特征服务.读取当前特征比较注册(
        {头, 特征, L2特征比较用途::目标判断});
    if (注册读取.结果头.事实截止代次 != G)
        return 任务特征方法查找状态::当前性漂移;
    if (!注册读取.成功() || !注册读取.注册)
        return 映射状态(注册读取.结果头.状态);
    const auto& 注册 = *注册读取.注册;
    if (合同.比较注册 != 注册.身份 || 注册.特征定义 != 特征
        || !std::holds_alternative<std::int64_t>(
            状态.精确值.类型化不可变材料))
        return 任务特征方法查找状态::引用冲突;
    L2特征比较请求 比较请求;
    比较请求.请求头 = 头;
    比较请求.请求身份 = 请求身份;
    比较请求.特征定义 = 特征;
    比较请求.用途 = L2特征比较用途::目标判断;
    比较请求.预期算法族 = 注册.合同.算法族;
    比较请求.预期算法版本 = 注册.合同.算法版本;
    比较请求.左 = {状态.精确值.值稳定编码,
        状态.精确值.类型化不可变材料, 状态.精确值.来源稳定编码,
        状态.精确值.创建事实代次,
        {状态.精确值.创建事实代次, 状态.精确值.退出事实代次},
        L2特征比较原始类型::I64, 注册.合同.单位, 注册.合同.维度,
        注册.合同.分量角色, L2特征比较角色::当前事实};
    比较请求.右 = {合同.目标值稳定编码, L2原始值材料{合同.目标I64},
        合同.来源稳定编码, 合同.生命周期.创建事实代次,
        合同.生命周期, L2特征比较原始类型::I64, 注册.合同.单位,
        注册.合同.维度, 注册.合同.分量角色,
        L2特征比较角色::目标状态};
    比较请求.要求结果位 =
        static_cast<std::uint8_t>(L2特征比较结果要求::具名关系);
    const auto 比较 = 特征服务.比较特征(比较请求);
    if (比较.事实截止代次 != G
        || 比较.状态 == L2特征比较状态::版本漂移)
        return 任务特征方法查找状态::当前性漂移;
    if (比较.状态 == L2特征比较状态::资源失败)
        return 任务特征方法查找状态::资源失败;
    if (比较.状态 == L2特征比较状态::入口拒绝
        || 比较.状态 == L2特征比较状态::许可拒绝)
        return 任务特征方法查找状态::入口拒绝;
    if (!比较.成功() || !比较.具名关系
        || 比较.注册身份 != 注册.身份)
        return 任务特征方法查找状态::内部错误;
    const auto 位 = 关系位(*比较.具名关系);
    if (!位) return 任务特征方法查找状态::内部错误;
    具名关系 = *比较.具名关系;
    允许关系位 = 合同.允许关系位;
    return 任务特征方法查找状态::已评估;
}

} // namespace 海中鱼巣::任务特征方法查找内部

export namespace 海中鱼巣 {

class 任务特征方法查找与条件提议提供者 final {
public:
    任务特征方法查找与条件提议提供者(
        const L2任务结构服务& 任务服务,
        const L2需求结构服务& 需求服务,
        const L2状态结构服务& 状态服务,
        const L2特征结构服务& 特征服务,
        const L2概念结构服务& 概念服务,
        const L2场景结构服务& 场景服务,
        const L2方法结构服务& 方法服务) noexcept
        : 任务服务_(任务服务), 需求服务_(需求服务), 状态服务_(状态服务),
          特征服务_(特征服务), 概念服务_(概念服务), 场景服务_(场景服务),
          方法服务_(方法服务) {}

    任务特征方法查找与条件提议提供者(
        const 任务特征方法查找与条件提议提供者&) = delete;
    任务特征方法查找与条件提议提供者& operator=(
        const 任务特征方法查找与条件提议提供者&) = delete;
    任务特征方法查找与条件提议提供者(
        任务特征方法查找与条件提议提供者&&) = delete;
    任务特征方法查找与条件提议提供者& operator=(
        任务特征方法查找与条件提议提供者&&) = delete;

    任务特征方法查找结果 评估下一筹办方法候选并形成条件提议(
        const 任务特征方法查找请求& 请求) const noexcept;

private:
    const L2任务结构服务& 任务服务_;
    const L2需求结构服务& 需求服务_;
    const L2状态结构服务& 状态服务_;
    const L2特征结构服务& 特征服务_;
    const L2概念结构服务& 概念服务_;
    const L2场景结构服务& 场景服务_;
    const L2方法结构服务& 方法服务_;
};

} // namespace 海中鱼巣

namespace 海中鱼巣 {

任务特征方法查找结果
任务特征方法查找与条件提议提供者::评估下一筹办方法候选并形成条件提议(
    const 任务特征方法查找请求& 请求) const noexcept {
    using namespace 任务特征方法查找内部;
    if (!请求有效(请求)) return 失败(任务特征方法查找状态::入口拒绝);
    try {
        const auto G = 请求.请求头.期望事实代次;
        const L2结构请求头 头{L2结构合同版本, G};
        const auto 任务读取 = 任务服务_.读取任务(
            {头, L2读取类别::当前, 请求.工作包.任务, 0});
        if (任务读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!任务读取.成功() || !任务读取.任务)
            return 失败(映射状态(任务读取.结果头.状态));
        const auto& 任务 = *任务读取.任务;
        const auto 列表项读取 = 需求服务_.读取需求列表项完整(
            {头, L2读取类别::当前, 任务.需求列表项, 0});
        if (列表项读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!列表项读取.成功() || !列表项读取.列表项)
            return 失败(映射状态(列表项读取.结果头.状态));
        const auto& 列表项 = *列表项读取.列表项;

        const auto 实际结果读取 = 任务服务_.按任务与执行轮次读取实际结果(
            {头, L2读取类别::当前, 请求.工作包.任务,
                请求.工作包.旧执行轮次, 0});
        if (实际结果读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!实际结果读取.成功() || !实际结果读取.实际结果)
            return 失败(映射状态(实际结果读取.结果头.状态));
        const auto& 实际结果 = *实际结果读取.实际结果;
        const auto 治理读取 = 任务服务_.读取任务治理状态(
            {头, L2读取类别::当前, 请求.工作包.正式待重筹办状态, 0});
        if (治理读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!治理读取.成功() || !治理读取.状态 || !治理读取.目标裁决证据)
            return 失败(映射状态(治理读取.结果头.状态));
        const auto& 治理 = *治理读取.状态;
        const auto& 裁决 = *治理读取.目标裁决证据;
        if (任务.身份 != 请求.工作包.任务 || 列表项.身份 != 任务.需求列表项
            || 实际结果.身份 != 请求.工作包.旧实际结果
            || 实际结果.实例方法 != 请求.工作包.旧实例
            || 实际结果.执行轮次 != 请求.工作包.旧执行轮次
            || 实际结果.运行代次 != 请求.工作包.运行代次
            || 治理.身份 != 请求.工作包.正式待重筹办状态
            || 治理.任务 != 任务.身份
            || 治理.业务状态段 != L2任务业务状态段::目标未达成待重筹办
            || 治理.目标达成状态 != L2任务目标达成状态::未达成
            || 治理.来源方法路径 != 请求.工作包.旧路径
            || 治理.来源实例方法 != 请求.工作包.旧实例
            || 治理.来源执行轮次 != 请求.工作包.旧执行轮次
            || 治理.来源任务实际结果 != 请求.工作包.旧实际结果
            || 治理.目标裁决证据 != 请求.工作包.正式目标裁决证据
            || 裁决.身份 != 请求.工作包.正式目标裁决证据
            || 裁决.材料.任务目标来源 != 列表项.身份
            || 裁决.材料.目标宿主 != 列表项.目标宿主存在
            || 裁决.材料.目标特征 != 列表项.目标特征定义
            || 裁决.材料.目标状态合同 != 列表项.目标状态合同
            || 裁决.材料.实际状态 != 实际结果.实际状态
            || 裁决.材料.目标达成状态 != L2任务目标达成状态::未达成
            || 裁决.材料.后继准备
                != L2任务目标裁决后继准备::目标未达成待重筹办)
            return 失败(任务特征方法查找状态::引用冲突);

        任务特征方法查找结果 结果;
        结果.状态 = 任务特征方法查找状态::已评估;
        结果.共同事实截止 = G;
        结果.已互证工作包 = 请求.工作包;
        结果.任务目标 = 任务筹办目标三元组{列表项.目标宿主存在,
            列表项.目标特征定义, 列表项.目标状态合同};

        const auto 状态读取 = 状态服务_.读取完整状态(
            {头, L2读取类别::当前, 实际结果.实际状态, 0});
        if (状态读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (状态读取.结果头.状态 != L2结构状态::已读取 || !状态读取.状态) {
            if (状态读取.结果头.状态 == L2结构状态::未找到
                || 状态读取.结果头.状态 == L2结构状态::已退出
                || 状态读取.结果头.状态 == L2结构状态::属性未设置)
                return 失败(任务特征方法查找状态::引用冲突);
            return 失败(映射状态(状态读取.结果头.状态));
        }
        结果.当前实际状态 = *状态读取.状态;
        const auto 特征实例读取 = 特征服务_.读取完整特征实例(
            {头, L2读取类别::当前, 状态读取.状态->特征实例, 0});
        if (特征实例读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (特征实例读取.结果头.状态 != L2结构状态::已读取
            || !特征实例读取.特征实例) {
            if (特征实例读取.结果头.状态 == L2结构状态::未找到
                || 特征实例读取.结果头.状态 == L2结构状态::已退出
                || 特征实例读取.结果头.状态 == L2结构状态::属性未设置)
                return 失败(任务特征方法查找状态::引用冲突);
            return 失败(映射状态(特征实例读取.结果头.状态));
        }
        if (状态读取.状态->主体存在 != 列表项.目标宿主存在
            || 特征实例读取.特征实例->身份 != 状态读取.状态->特征实例
            || 特征实例读取.特征实例->宿主存在 != 列表项.目标宿主存在
            || 特征实例读取.特征实例->特征定义 != 列表项.目标特征定义)
            return 失败(任务特征方法查找状态::引用冲突);
        L2特征比较具名关系 目标关系{};
        std::uint8_t 允许位 = 0;
        const auto 比较状态 = 比较状态与合同(*状态读取.状态,
            列表项.目标特征定义, 列表项.目标状态合同,
            请求.工作包.原重筹办意图幂等键, G, 状态服务_, 特征服务_,
            目标关系, 允许位);
        if (比较状态 != 任务特征方法查找状态::已评估)
            return 失败(比较状态);
        结果.目标比较具名关系 = 目标关系;
        结果.允许关系位 = 允许位;
        const auto 位 = *关系位(目标关系);
        if (裁决.材料.具名关系 != 目标关系
            || 裁决.材料.允许关系位 != 允许位
            || (允许位 & 位) != 0)
            return 失败(任务特征方法查找状态::引用冲突);
        if (目标关系 == L2特征比较具名关系::当前低于目标)
            结果.所需方向 = L2方法变化方向::正方向;
        else if (目标关系 == L2特征比较具名关系::当前高于目标)
            结果.所需方向 = L2方法变化方向::负方向;
        else if ((允许位 & 0x01U) != 0 && (允许位 & 0x04U) != 0) {
            结果.结论 = 任务特征方法查找结论::所需方向不唯一;
            return 结果.成功() ? 结果 : 失败(任务特征方法查找状态::内部错误);
        } else if ((允许位 & 0x01U) != 0)
            结果.所需方向 = L2方法变化方向::负方向;
        else if ((允许位 & 0x04U) != 0)
            结果.所需方向 = L2方法变化方向::正方向;
        else return 失败(任务特征方法查找状态::内部错误);

        const auto 根读取 = 概念服务_.按角色读取当前概念本体根(
            {头, L2概念本体根角色::存在});
        if (根读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!根读取.成功() || !根读取.本体根)
            return 失败(映射状态(根读取.结果头.状态));
        const auto 存在根 = 根读取.本体根->根概念;
        const auto 支持读取 = 概念服务_.按世界事实读取概念支持关系组({
            头, L2概念世界事实支持关系合同版本, L2读取类别::当前,
            L2世界事实引用{列表项.目标宿主存在}, 0,
            static_cast<std::size_t>(请求.最大概念支持扫描事实数),
            static_cast<std::size_t>(请求.最大概念支持关系数)});
        if (支持读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!支持读取.成功()) return 失败(映射状态(支持读取.结果头.状态));
        for (const auto& 支持 : 支持读取.关系组)
            结果.当前对象概念.push_back(支持.概念);
        std::sort(结果.当前对象概念.begin(), 结果.当前对象概念.end(),
            [](const auto& 左, const auto& 右) { return 左.值.值 < 右.值.值; });
        结果.当前对象概念.erase(std::unique(结果.当前对象概念.begin(),
            结果.当前对象概念.end()), 结果.当前对象概念.end());
        if (结果.当前对象概念.empty()) {
            结果.结论 = 任务特征方法查找结论::对象概念待形成;
            return 结果.成功() ? 结果 : 失败(任务特征方法查找状态::内部错误);
        }

        std::size_t 已用祖先边 = 0;
        for (const auto 当前概念 : 结果.当前对象概念) {
            if (当前概念 == 存在根) {
                结果.对象概念祖先闭包.push_back({当前概念, 存在根});
                continue;
            }
            const auto 概念读取 = 概念服务_.读取普通概念(
                {头, L2普通概念结构合同版本, L2读取类别::当前, 当前概念, 0});
            if (概念读取.结果头.事实截止代次 != G)
                return 失败(任务特征方法查找状态::当前性漂移);
            if (!概念读取.成功() || !概念读取.概念)
                return 失败(映射状态(概念读取.结果头.状态));
            if (概念读取.概念->本体根归属.本体根 != 存在根)
                return 失败(任务特征方法查找状态::引用冲突);
            struct 待查概念项 final {
                L2概念身份 概念;
                std::vector<L2概念身份> 路径;
            };
            std::vector<待查概念项> 待查{{当前概念, {当前概念}}};
            std::vector<L2概念身份> 已查;
            bool 到根 = false;
            while (!待查.empty()) {
                auto 当前项 = std::move(待查.back());
                待查.pop_back();
                const auto 下位 = 当前项.概念;
                if (下位 == 存在根) { 到根 = true; continue; }
                if (std::find(已查.begin(), 已查.end(), 下位) != 已查.end())
                    continue;
                已查.push_back(下位);
                const auto 剩余 = 请求.最大概念祖先关系数 - 已用祖先边;
                if (剩余 == 0)
                    return 失败(任务特征方法查找状态::数量预算不足);
                const auto 上位读取 = 概念服务_.读取概念直接上位关系组(
                    {头, L2概念直接上下位关系合同版本, L2读取类别::当前,
                        下位, 0, static_cast<std::size_t>(剩余)});
                if (上位读取.结果头.事实截止代次 != G)
                    return 失败(任务特征方法查找状态::当前性漂移);
                if (!上位读取.成功()) return 失败(映射状态(上位读取.结果头.状态));
                for (const auto& 边 : 上位读取.关系组) {
                    if (++已用祖先边 > 请求.最大概念祖先关系数)
                        return 失败(任务特征方法查找状态::数量预算不足);
                    if (std::find(当前项.路径.begin(), 当前项.路径.end(),
                            边.上位概念) != 当前项.路径.end())
                        return 失败(任务特征方法查找状态::引用冲突);
                    auto 新路径 = 当前项.路径;
                    新路径.push_back(边.上位概念);
                    待查.push_back({边.上位概念, std::move(新路径)});
                }
            }
            if (!到根) return 失败(任务特征方法查找状态::引用冲突);
            结果.对象概念祖先闭包.push_back({当前概念, 存在根});
        }

        const auto 粗召回 = 方法服务_.按特征读取方法用途粗召回组({
            头, L2普通方法结构合同版本, L2读取类别::当前, 0,
            列表项.目标特征定义, 请求.最大扫描用途事实数,
            请求.最大粗召回方法数});
        if (粗召回.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!粗召回.成功()) return 失败(映射状态(粗召回.结果头.状态));
        结果.实际扫描用途事实数 = 粗召回.实际扫描用途事实数;
        结果.完整粗召回 = 粗召回.粗召回;
        if (粗召回.粗召回.empty()) {
            结果.结论 = 任务特征方法查找结论::方法能力缺失;
            return 结果.成功() ? 结果 : 失败(任务特征方法查找状态::内部错误);
        }

        std::vector<L2方法身份> 已读方法;
        for (const auto& 粗项 : 粗召回.粗召回) {
            if (std::find(已读方法.begin(), 已读方法.end(), 粗项.方法)
                != 已读方法.end()) continue;
            已读方法.push_back(粗项.方法);
            const auto 投影读取 = 方法服务_.读取方法六项静态能力投影组(
                {头, L2普通方法结构合同版本, L2读取类别::当前,
                    粗项.方法, 0});
            if (投影读取.结果头.事实截止代次 != G)
                return 失败(任务特征方法查找状态::当前性漂移);
            if (!投影读取.成功()) return 失败(映射状态(投影读取.结果头.状态));
            if (!投影读取.结构缺口.empty()) {
                auto 缺口 = 投影读取.结构缺口;
                std::sort(缺口.begin(), 缺口.end(), 缺口小于);
                缺口.erase(std::unique(缺口.begin(), 缺口.end()), 缺口.end());
                结果.结构缺口.push_back({粗项.方法, std::move(缺口)});
            }
            for (const auto& 投影 : 投影读取.投影) {
                if (投影.签名.可改变特征类型 != 列表项.目标特征定义)
                    continue;
                std::vector<任务方法不兼容原因> 原因;
                const bool 对象兼容 = 投影.签名.目标对象类型 == 存在根
                    || std::find(结果.当前对象概念.begin(),
                        结果.当前对象概念.end(), 投影.签名.目标对象类型)
                        != 结果.当前对象概念.end();
                if (!对象兼容)
                    原因.push_back(任务方法不兼容原因::对象类型不兼容);
                if (投影.签名.变化方向 != *结果.所需方向)
                    原因.push_back(任务方法不兼容原因::所需方向不兼容);
                const auto* 状态结果 = std::get_if<L2目标状态合同身份>(
                    &投影.签名.结果类型);
                if (!状态结果)
                    原因.push_back(任务方法不兼容原因::结果类型不是目标状态合同);
                else if (*状态结果 != 列表项.目标状态合同)
                    原因.push_back(任务方法不兼容原因::目标状态合同不相同);
                if (!原因.empty()) {
                    结果.不兼容证据.push_back({投影.方法, 投影.内容版本,
                        投影.规格版本, 投影.主轴结果, 投影.匹配用途,
                        std::move(原因)});
                    continue;
                }
                结果.适用候选.push_back({投影.方法, 投影.内容版本,
                    投影.规格版本, 投影.主轴结果, 投影.匹配用途,
                    投影.签名});
            }
        }
        std::sort(结果.适用候选.begin(), 结果.适用候选.end(), 候选小于);
        结果.适用候选.erase(std::unique(结果.适用候选.begin(),
            结果.适用候选.end()), 结果.适用候选.end());
        if (结果.适用候选.empty()) {
            结果.结论 = 结果.结构缺口.empty()
                ? 任务特征方法查找结论::当前无适用方法
                : 任务特征方法查找结论::方法结构待补齐;
            return 结果.成功() ? 结果 : 失败(任务特征方法查找状态::内部错误);
        }
        if (结果.适用候选.size() > 1) {
            结果.结论 = 任务特征方法查找结论::多候选待选择证据;
            return 结果.成功() ? 结果 : 失败(任务特征方法查找状态::内部错误);
        }

        结果.采用方案 = 结果.适用候选.front();
        const auto 方法读取 = 方法服务_.读取普通方法({头,
            L2普通方法结构合同版本, L2读取类别::当前,
            结果.采用方案->方法, 0});
        if (方法读取.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!方法读取.成功() || !方法读取.方法)
            return 失败(映射状态(方法读取.结果头.状态));
        const auto& 方法 = *方法读取.方法;
        if (方法.内容版本 != 结果.采用方案->内容版本
            || 方法.规格版本 != 结果.采用方案->规格版本)
            return 失败(任务特征方法查找状态::引用冲突);
        const auto 主轴 = std::find_if(方法.结果.begin(), 方法.结果.end(),
            [&](const auto& 项) { return 项.身份 == 结果.采用方案->主轴结果; });
        const auto 用途 = std::find_if(方法.用途.begin(), 方法.用途.end(),
            [&](const auto& 项) { return 项.身份 == 结果.采用方案->匹配用途; });
        if (主轴 == 方法.结果.end() || 用途 == 方法.用途.end()
            || 主轴->作用对象角色 != 用途->作用对象角色)
            return 失败(任务特征方法查找状态::引用冲突);
        std::vector<L2方法条件身份> 条件身份;
        for (const auto& 关系 : 方法.条件结果关系)
            if (关系.结果 == 主轴->身份
                && std::find(条件身份.begin(), 条件身份.end(), 关系.条件)
                    == 条件身份.end()) 条件身份.push_back(关系.条件);
        const auto 属于主轴 = [&](const auto& 项) {
            return !项.条件 || std::find(条件身份.begin(), 条件身份.end(),
                *项.条件) != 条件身份.end();
        };
        const auto 输入数 = std::count_if(方法.输入规格.begin(), 方法.输入规格.end(), 属于主轴);
        const auto 限制数 = std::count_if(方法.限制条件.begin(), 方法.限制条件.end(), 属于主轴);
        if (条件身份.size() + static_cast<std::size_t>(输入数 + 限制数)
            > 请求.最大方法条件数)
            return 失败(任务特征方法查找状态::数量预算不足);
        for (const auto& 输入 : 方法.输入规格) if (属于主轴(输入)) {
            const L2方法输入规格语义项 语义{输入.作用对象角色,
                输入.顺序, 输入.规格};
            const bool 已绑定 = 输入.作用对象角色 == 主轴->作用对象角色;
            结果.采用方案输入规格.push_back({输入.身份, 语义,
                已绑定 ? std::optional<L2存在身份>{列表项.目标宿主存在}
                    : std::nullopt});
            if (!已绑定) 结果.未绑定输入限制.push_back({
                任务未绑定材料类别::输入规格, 输入.作用对象角色,
                std::nullopt, 输入.身份, std::nullopt});
        }
        for (const auto& 限制 : 方法.限制条件) if (属于主轴(限制)) {
            const L2方法限制条件语义项 语义{限制.类别,
                限制.作用对象角色, 限制.顺序, 限制.规格};
            const bool 已绑定 = 限制.作用对象角色 == 主轴->作用对象角色;
            结果.采用方案限制条件.push_back({限制.身份, 语义,
                已绑定 ? std::optional<L2存在身份>{列表项.目标宿主存在}
                    : std::nullopt});
            if (!已绑定) 结果.未绑定输入限制.push_back({
                任务未绑定材料类别::限制条件, 限制.作用对象角色,
                std::nullopt, std::nullopt, 限制.身份});
        }

        std::vector<const L2方法条件事实*> 已绑定条件;
        for (const auto 条件号 : 条件身份) {
            const auto 条件 = std::find_if(方法.条件.begin(), 方法.条件.end(),
                [&](const auto& 项) { return 项.身份 == 条件号; });
            if (条件 == 方法.条件.end())
                return 失败(任务特征方法查找状态::引用冲突);
            if (条件->作用对象角色 != 主轴->作用对象角色) {
                结果.未绑定输入限制.push_back({任务未绑定材料类别::条件,
                    条件->作用对象角色, 条件->身份, std::nullopt, std::nullopt});
                continue;
            }
            已绑定条件.push_back(&*条件);
        }
        std::vector<L2状态事实> 主体当前状态;
        if (!已绑定条件.empty()) {
            const auto 状态组 = 状态服务_.按主体读取全部当前状态(
                {头, 列表项.目标宿主存在, 请求.最大主体状态数});
            if (状态组.结果头.事实截止代次 != G)
                return 失败(任务特征方法查找状态::当前性漂移);
            if (!状态组.成功())
                return 失败(映射状态(状态组.结果头.状态));
            主体当前状态 = 状态组.状态;
        }
        for (const auto* 条件 : 已绑定条件) {
            std::vector<L2状态事实> 匹配状态;
            for (const auto& 当前状态 : 主体当前状态) {
                const auto 实例读取 = 特征服务_.读取完整特征实例(
                    {头, L2读取类别::当前, 当前状态.特征实例, 0});
                if (实例读取.结果头.事实截止代次 != G)
                    return 失败(任务特征方法查找状态::当前性漂移);
                if (实例读取.结果头.状态 != L2结构状态::已读取
                    || !实例读取.特征实例)
                    return 失败(映射状态(实例读取.结果头.状态));
                if (实例读取.特征实例->特征定义 == 条件->特征定义)
                    匹配状态.push_back(当前状态);
            }
            if (匹配状态.size() > 1)
                return 失败(任务特征方法查找状态::引用冲突);
            bool 满足 = false;
            if (匹配状态.size() == 1) {
                L2特征比较具名关系 条件关系{};
                std::uint8_t 条件允许位 = 0;
                const auto 条件比较 = 比较状态与合同(匹配状态.front(),
                    条件->特征定义, 条件->条件状态合同,
                    请求.工作包.原重筹办意图幂等键 ^ 条件->身份.值.值,
                    G, 状态服务_, 特征服务_, 条件关系, 条件允许位);
                if (条件比较 != 任务特征方法查找状态::已评估)
                    return 失败(条件比较);
                满足 = (条件允许位 & *关系位(条件关系)) != 0;
            }
            if (满足 && 条件->场景) {
                const auto 场景读取 = 场景服务_.读取存在当前场景成员引用(
                    {头, 列表项.目标宿主存在});
                if (场景读取.结果头.事实截止代次 != G)
                    return 失败(任务特征方法查找状态::当前性漂移);
                if (!场景读取.成功()) return 失败(映射状态(场景读取.结果头.状态));
                if (场景读取.引用.size() > 请求.最大场景成员数)
                    return 失败(任务特征方法查找状态::数量预算不足);
                满足 = std::any_of(场景读取.引用.begin(), 场景读取.引用.end(),
                    [&](const auto& 引用) {
                        return 引用.场景 == *条件->场景
                            && 引用.存在 == 列表项.目标宿主存在;
                    });
            }
            if (!满足) 结果.缺失条件草案.push_back({任务.身份, 方法.方法,
                方法.内容版本, 方法.规格版本, 主轴->身份, 条件->身份,
                条件->作用对象角色, 列表项.目标宿主存在, 条件->场景,
                条件->特征定义, 条件->条件状态合同,
                条件->来源稳定编码, G});
        }
        const auto 尾任务 = 任务服务_.读取任务(
            {头, L2读取类别::当前, 请求.工作包.任务, 0});
        if (尾任务.结果头.事实截止代次 != G)
            return 失败(任务特征方法查找状态::当前性漂移);
        if (!尾任务.成功() || !尾任务.任务 || *尾任务.任务 != 任务)
            return 失败(任务特征方法查找状态::引用冲突);
        结果.结论 = !结果.缺失条件草案.empty()
            ? 任务特征方法查找结论::已采用且存在缺失条件
            : !结果.未绑定输入限制.empty()
                ? 任务特征方法查找结论::已采用且输入限制待绑定
                : 任务特征方法查找结论::已采用且无需条件提议;
        return 结果.成功() ? 结果 : 失败(任务特征方法查找状态::内部错误);
    } catch (const std::bad_alloc&) {
        return 失败(任务特征方法查找状态::资源失败);
    } catch (const std::length_error&) {
        return 失败(任务特征方法查找状态::资源失败);
    } catch (...) {
        return 失败(任务特征方法查找状态::内部错误);
    }
}

} // namespace 海中鱼巣
