module;

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <variant>
#include <vector>

#define 实例方法执行数据_NO_INCLUDES
#define 任务执行派发门控数据_NO_INCLUDES

export module 海中鱼巣.领域.内部治理.服务.任务执行派发门控;

import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2自我治理结构;
import 海中鱼巣.领域.组合.运行期只读查询;
import 海中鱼巣.领域.安全治理.服务.任务现实执行硬否决;
import 海中鱼巣.领域.内部治理.服务.任务阶段结构消费端口;

