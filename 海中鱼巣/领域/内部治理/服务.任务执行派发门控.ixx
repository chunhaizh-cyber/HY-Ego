namespace 海中鱼巣::任务执行派发门控内部 {

任务执行派发门控结果 失败(任务执行派发门控状态 状态) noexcept {
    return {状态, std::nullopt};
}

bool 身份与共同截止有效(const 任务执行派发门控请求& 请求) noexcept {
    return 请求.合同版本 == 任务执行派发门控合同版本
        && 有效(请求.任务.值) && 有效(请求.任务轮次.值)
        && 有效(请求.筹办轮次.值) && 有效(请求.执行轮次.值)
        && 有效(请求.冻结.值) && 请求.冻结版本 != 0
        && 有效(请求.实例方法.值) && 有效(请求.方法.值)
        && L2方法内容版本有效(请求.方法内容版本)
        && 实例方法技术许可动作范围有效(请求.完整有序冻结动作范围)
        && 请求.共同事实截止 != 0 && 请求.派发规则版本 != 0;
}

bool 阶段证据绑定(const 任务执行派发门控请求& 请求) noexcept {
    const auto& 证据 = 请求.当前阶段证据;
    return 任务执行派发当前阶段证据有效(证据)
        && 证据.正式读回截止 == 请求.共同事实截止
        && 证据.当前阶段.主阶段 == 任务主阶段::筹办
        && (证据.当前阶段.状态段 == 任务业务状态段::可执行已冻结
            || 证据.当前阶段.状态段
                == 任务业务状态段::待自我现实执行授权);
}

bool 调度证据绑定(const 任务执行派发门控请求& 请求) noexcept {
    const auto& 证据 = 请求.调度资格证据;
    if (!任务执行派发调度资格证据有效(证据)
        || 证据.正式读回截止 != 请求.共同事实截止)
        return false;
    for (std::size_t i = 1; i < 证据.当前任务需求来源组.size(); ++i)
        if (证据.当前任务需求来源组[i - 1].需求.值.值
            >= 证据.当前任务需求来源组[i].需求.值.值)
            return false;
    return true;
}

bool 技术许可证据绑定(const 任务执行派发门控请求& 请求) noexcept {
    const auto& 证据 = 请求.技术许可证据;
    if (证据.正式读回截止 != 请求.共同事实截止
        || 证据.逐项许可见证.size() != 请求.完整有序冻结动作范围.size())
        return false;
    for (std::size_t i = 0; i < 证据.逐项许可见证.size(); ++i) {
        const auto& 见证 = 证据.逐项许可见证[i];
        const auto& 动作 = 请求.完整有序冻结动作范围[i];
        if (见证.合同版本 != 实例方法技术许可合同版本
            || 见证.任务 != 请求.任务 || 见证.任务轮次 != 请求.任务轮次
            || 见证.筹办轮次 != 请求.筹办轮次
            || 见证.执行轮次 != 请求.执行轮次
            || 见证.冻结 != 请求.冻结 || 见证.冻结版本 != 请求.冻结版本
            || 见证.实例方法 != 请求.实例方法 || 见证.方法 != 请求.方法
            || 见证.方法内容版本 != 请求.方法内容版本
            || 见证.动作入口 != 动作.动作入口
            || !L2方法稳定动作键有效(见证.稳定动作键)
            || 见证.稳定动作键 != 动作.稳定动作键
            || 见证.端口技术许可合同版本 == 0
            || 见证.正式读回截止 != 请求.共同事实截止)
            return false;
        for (std::size_t j = 0; j < i; ++j)
            if (证据.逐项许可见证[j].动作入口 == 见证.动作入口
                || 证据.逐项许可见证[j].稳定动作键 == 见证.稳定动作键)
                return false;
    }
    return true;
}

bool 含现实改变(const std::vector<任务冻结动作项>& 动作范围) noexcept {
    return std::any_of(动作范围.begin(), 动作范围.end(), [](const auto& 动作) {
        return 动作.作用范围 == 任务动作作用范围::现实改变;
    });
}

bool 硬否决请求共同绑定(const 任务现实执行硬否决请求& 请求,
    const 任务执行派发门控请求& 派发,
    任务现实执行硬否决复核阶段 阶段,
    任务现实影响分类 影响) noexcept {
    return 请求.合同版本 == 任务现实执行硬否决合同版本
        && 请求.复核阶段 == 阶段 && 有效(请求.自我.值)
        && 请求.任务 == 派发.任务 && 请求.任务轮次 == 派发.任务轮次
        && 请求.筹办轮次 == 派发.筹办轮次
        && 请求.执行轮次 == 派发.执行轮次
        && 请求.冻结 == 派发.冻结 && 请求.冻结版本 == 派发.冻结版本
        && 请求.实例方法 == 派发.实例方法 && 请求.方法 == 派发.方法
        && 请求.方法内容版本.值 == 派发.方法内容版本.值
        && 请求.完整有序冻结动作范围 == 派发.完整有序冻结动作范围
        && 请求.现实影响 == 影响
        && 请求.来源共同事实截止 == 派发.共同事实截止
        && (影响 == 任务现实影响分类::零现实改变
            || (请求.正式规则全集.成功()
                && 请求.正式规则全集.本次正式读回截止
                    == 派发.共同事实截止));
}

bool 两轮硬否决请求一致(const 任务执行派发门控请求& 请求) noexcept {
    const auto& 前 = 请求.授权前硬否决请求;
    const auto& 后 = 请求.动作前最终硬否决请求;
    return 前.自我 == 后.自我
        && 前.正式规则全集 == 后.正式规则全集;
}

任务执行派发门控状态 映射硬否决非成功(
    任务现实执行硬否决状态 状态) noexcept {
    switch (状态) {
    case 任务现实执行硬否决状态::已命中:
        return 任务执行派发门控状态::安全硬否决;
    case 任务现实执行硬否决状态::材料不足:
        return 任务执行派发门控状态::材料不足;
    case 任务现实执行硬否决状态::当前性漂移:
        return 任务执行派发门控状态::当前性漂移;
    case 任务现实执行硬否决状态::资源失败:
        return 任务执行派发门控状态::资源失败;
    default:
        return 任务执行派发门控状态::内部错误;
    }
}

bool 硬否决结果绑定(const 任务现实执行硬否决结果& 结果,
    const 任务现实执行硬否决请求& 请求,
    任务现实执行硬否决复核阶段 阶段,
    任务现实影响分类 影响,
    std::uint64_t 共同截止) noexcept {
    if (!结果.结果形状有效() || 结果.复核阶段 != 阶段
        || 结果.现实影响 != 影响)
        return false;
    if (结果.状态 != 任务现实执行硬否决状态::不适用
        && 结果.状态 != 任务现实执行硬否决状态::未命中
        && 结果.状态 != 任务现实执行硬否决状态::已命中)
        return 结果.本次裁决截止 == 0;
    if (结果.本次裁决截止 != 共同截止 || !结果.作用范围证据)
        return false;
    const auto& 范围 = *结果.作用范围证据;
    std::uint64_t 内部 = 0;
    std::uint64_t 观察 = 0;
    std::uint64_t 改变 = 0;
    for (const auto& 动作 : 请求.完整有序冻结动作范围) {
        if (动作.作用范围 == 任务动作作用范围::内部治理) ++内部;
        else if (动作.作用范围 == 任务动作作用范围::纯现实观察) ++观察;
        else if (动作.作用范围 == 任务动作作用范围::现实改变) ++改变;
        else return false;
    }
    return 范围.冻结 == 请求.冻结 && 范围.冻结版本 == 请求.冻结版本
        && 范围.动作总数 == 请求.完整有序冻结动作范围.size()
        && 范围.内部治理动作数 == 内部 && 范围.纯观察动作数 == 观察
        && 范围.现实改变动作数 == 改变
        && 范围.作用范围正式读回截止 == 共同截止
        && (!结果.安全读回见证
            || (请求.正式规则全集.宇宙
                && 请求.正式规则全集.完整集合见证
                && 结果.安全读回见证->规则宇宙
                    == 请求.正式规则全集.宇宙->宇宙
                && 结果.安全读回见证->硬否决规则版本
                    == 请求.正式规则全集.宇宙->规则版本
                && 结果.安全读回见证->成员集合版本
                    == 请求.正式规则全集.宇宙->成员集合版本
                && 结果.安全读回见证->适用规则事实身份组
                    == 请求.正式规则全集.适用规则事实身份组
                && 结果.安全读回见证->完整集合见证
                    == *请求.正式规则全集.完整集合见证));
}

任务执行派发冻结 形成冻结(const 任务执行派发门控请求& 请求) {
    return {任务执行派发门控合同版本, 请求.任务, 请求.任务轮次,
        请求.筹办轮次, 请求.执行轮次, 请求.冻结, 请求.冻结版本,
        请求.实例方法, 请求.方法, 请求.方法内容版本,
        请求.当前阶段证据, 请求.控制态证据, 请求.调度资格证据,
        请求.技术许可证据, 请求.适用授权, 请求.授权前硬否决结果,
        请求.动作前最终硬否决结果, 请求.共同事实截止,
        请求.派发规则版本};
}

} // namespace 海中鱼巣::任务执行派发门控内部

namespace 海中鱼巣 {

namespace {

bool 现实执行授权事实相同(
    const L2自我现实执行授权事实& 左,
    const L2自我现实执行授权事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.自我 == 右.自我
        && 左.任务 == 右.任务 && 左.任务轮次 == 右.任务轮次
        && 左.筹办轮次 == 右.筹办轮次 && 左.执行轮次 == 右.执行轮次
        && 左.冻结 == 右.冻结 && 左.冻结版本 == 右.冻结版本
        && 左.实例方法 == 右.实例方法 && 左.方法 == 右.方法
        && 左.方法内容版本 == 右.方法内容版本
        && 左.有序冻结动作范围 == 右.有序冻结动作范围
        && 左.来源共同事实截止 == 右.来源共同事实截止
        && 左.授权规则版本 == 右.授权规则版本
        && 左.发生时间 == 右.发生时间
        && 左.有效截止时间 == 右.有效截止时间
        && 左.生命周期 == 右.生命周期;
}

bool 可选现实执行授权相同(
    const std::optional<L2自我现实执行授权事实>& 左,
    const std::optional<L2自我现实执行授权事实>& 右) noexcept {
    if (static_cast<bool>(左) != static_cast<bool>(右)) return false;
    return !左 || 现实执行授权事实相同(*左, *右);
}

bool 派发冻结相同(const 任务执行派发冻结& 左,
    const 任务执行派发冻结& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.任务 == 右.任务
        && 左.任务轮次 == 右.任务轮次 && 左.筹办轮次 == 右.筹办轮次
        && 左.执行轮次 == 右.执行轮次 && 左.冻结 == 右.冻结
        && 左.冻结版本 == 右.冻结版本 && 左.实例方法 == 右.实例方法
        && 左.方法 == 右.方法 && 左.方法内容版本 == 右.方法内容版本
        && 左.当前阶段证据 == 右.当前阶段证据 && 左.控制态证据 == 右.控制态证据
        && 左.调度资格证据 == 右.调度资格证据 && 左.技术许可证据 == 右.技术许可证据
        && 可选现实执行授权相同(左.适用授权, 右.适用授权)
        && 左.授权前硬否决证据 == 右.授权前硬否决证据
        && 左.动作前最终硬否决证据 == 右.动作前最终硬否决证据
        && 左.共同事实截止 == 右.共同事实截止
        && 左.派发规则版本 == 右.派发规则版本;
}

} // namespace

bool operator==(const 任务强类型执行请求& 左,
    const 任务强类型执行请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本
        && 左.执行幂等身份 == 右.执行幂等身份
        && 左.任务 == 右.任务
        && 左.任务轮次 == 右.任务轮次
        && 左.筹办轮次 == 右.筹办轮次
        && 左.执行轮次 == 右.执行轮次
        && 左.冻结 == 右.冻结
        && 左.冻结版本 == 右.冻结版本
        && 左.实例方法 == 右.实例方法
        && 左.方法 == 右.方法
        && 左.方法内容版本 == 右.方法内容版本
        && 左.完整有序冻结动作范围 == 右.完整有序冻结动作范围
        && 左.执行进入治理动作 == 右.执行进入治理动作
        && 派发冻结相同(左.派发冻结, 右.派发冻结)
        && 可选现实执行授权相同(左.适用授权, 右.适用授权)
        && 左.授权收口幂等身份 == 右.授权收口幂等身份
        && 左.运行代次 == 右.运行代次;
}

} // namespace 海中鱼巣

export namespace 海中鱼巣 {

class 任务执行派发门控提供者 final {
public:
    任务执行派发门控结果 裁决任务执行派发(
        const 任务执行派发门控请求& 请求) const noexcept {
        using namespace 任务执行派发门控内部;
        if (!身份与共同截止有效(请求))
            return 失败(任务执行派发门控状态::材料不足);
        try {
            if (!阶段证据绑定(请求))
                return 失败(请求.当前阶段证据.正式读回截止 != 请求.共同事实截止
                    ? 任务执行派发门控状态::当前性漂移
                    : 任务执行派发门控状态::材料不足);
            if (!任务执行派发生存控制态证据有效(请求.控制态证据)
                || 请求.控制态证据.正式读回截止 != 请求.共同事实截止)
                return 失败(任务执行派发门控状态::当前性漂移);
            if (请求.控制态证据.控制态 != 生存安全控制态::主动运行
                || 请求.控制态证据.普通任务竞争
                    != 任务普通竞争适用性::适用)
                return 失败(任务执行派发门控状态::控制态阻断);
            if (!调度证据绑定(请求))
                return 失败(任务执行派发门控状态::材料不足);
            if (请求.调度资格证据.最终调度资格 == 0)
                return 失败(任务执行派发门控状态::无调度资格);
            if (!技术许可证据绑定(请求))
                return 失败(任务执行派发门控状态::技术许可拒绝);

            const bool 现实改变 = 含现实改变(请求.完整有序冻结动作范围);
            const auto 影响 = 现实改变 ? 任务现实影响分类::含现实改变
                : 任务现实影响分类::零现实改变;
            if (!两轮硬否决请求一致(请求)
                || !硬否决请求共同绑定(请求.授权前硬否决请求, 请求,
                    任务现实执行硬否决复核阶段::授权前预检, 影响)
                || !硬否决结果绑定(请求.授权前硬否决结果,
                    请求.授权前硬否决请求,
                    任务现实执行硬否决复核阶段::授权前预检,
                    影响, 请求.共同事实截止))
                return 失败(任务执行派发门控状态::材料不足);
            if (!请求.授权前硬否决结果.允许继续())
                return 失败(映射硬否决非成功(请求.授权前硬否决结果.状态));

            if (现实改变) {
                if (!请求.适用授权)
                    return 失败(任务执行派发门控状态::缺少适用授权);
                if (!任务执行授权绑定派发(*请求.适用授权, 请求))
                    return 失败(任务执行派发门控状态::授权无效);
            } else if (请求.适用授权) {
                return 失败(任务执行派发门控状态::授权无效);
            }

            if (!硬否决请求共同绑定(请求.动作前最终硬否决请求, 请求,
                    任务现实执行硬否决复核阶段::动作前最终复核, 影响)
                || !硬否决结果绑定(请求.动作前最终硬否决结果,
                    请求.动作前最终硬否决请求,
                    任务现实执行硬否决复核阶段::动作前最终复核,
                    影响, 请求.共同事实截止))
                return 失败(任务执行派发门控状态::当前性漂移);
            if (!请求.动作前最终硬否决结果.允许继续())
                return 失败(映射硬否决非成功(
                    请求.动作前最终硬否决结果.状态));

            任务执行派发门控结果 结果;
            结果.状态 = 任务执行派发门控状态::可派发;
            结果.派发冻结 = 形成冻结(请求);
            return 结果.成功() ? 结果
                : 失败(任务执行派发门控状态::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(任务执行派发门控状态::资源失败);
        } catch (...) {
            return 失败(任务执行派发门控状态::内部错误);
        }
    }
};

} // namespace 海中鱼巣
