module;

#include <cstdint>
#include <optional>
#include <string>
#include <vector>

#define 任务筹办编排数据_NO_INCLUDES

export module 海中鱼巣.领域.服务.任务筹办编排;

export import 海中鱼巣.领域.合同.L2结构公共;
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2特征结构;

export {
#include "任务筹办编排.数据.h"
}

export namespace 海中鱼巣 {

// 任务筹办编排服务（对齐 BIZ-L2-004-03）
// 链路：取得执行权→读取一致事实→状态分支→目标状态解析→方法候选召回→就绪链复判→闭合结果形成
class 任务筹办编排服务 final {
public:
    任务筹办编排服务(
        const L2需求结构服务& 需求服务,
        L2方法结构服务& 方法服务,
        L2任务结构服务& 任务服务,
        const L2状态结构服务& 状态服务,
        const L2特征结构服务& 特征服务) noexcept
        : 需求服务_(需求服务)
        , 方法服务_(方法服务)
        , 任务服务_(任务服务)
        , 状态服务_(状态服务)
        , 特征服务_(特征服务) {}

    // 完整筹办流程（对齐 BIZ-L2-004-03 / 5230 / 5250 / 详细设计v0.2）
    筹办结果 筹办(筹办请求 请求) noexcept {
        筹办结果 结果;
        结果.合同版本 = 任务筹办编排合同版本;
        结果.结果头.合同版本 = 任务筹办编排合同版本;

        // ===== N01: 请求守卫 =====
        if (!筹办请求有效(请求)) {
            结果.结果头.状态 = L2结构状态::入口拒绝;
            结果.结果类型 = 筹办闭合结果类型::入口拒绝;
            结果.诊断信息 = "筹办请求无效：任务/轮次/运行代次/版本不完整";
            return 结果;
        }

        try {
            // ===== N02-N03: 取得任务筹办执行权（对齐 BIZ-L3-004-03-01）=====
            auto 执行权 = 取得执行权(请求);
            if (执行权 != 执行权状态::已取得) {
                结果.结果头.状态 = 映射执行权状态(执行权);
                结果.结果类型 = 映射执行权闭合结果(执行权);
                结果.诊断信息 = "未取得任务筹办执行权: " + 执行权诊断(执行权);
                return 结果;
            }

            // ===== N04: 读取任务筹办一致事实（对齐 BIZ-L3-004-03-02）=====
            auto 一致事实 = 读取筹办一致事实(请求);
            if (!一致事实.完整()) {
                结果.结果头.状态 = L2结构状态::资源失败;
                结果.结果类型 = 筹办闭合结果类型::资源失败;
                结果.诊断信息 = "读取筹办一致事实失败：任务/需求/列表项事实不完整";
                return 结果;
            }
            结果.结果头.事实截止代次 = 一致事实.事实截止代次;

            // ===== N05: 任务目标/授权/当前性状态分支（对齐 BIZ-L3-004-03-02 N07）=====
            auto 分支 = 判断任务状态分支(一致事实);
            if (分支 == 任务状态分支::目标已完成) {
                结果.结果头.状态 = L2结构状态::已提交;
                结果.结果类型 = 筹办闭合结果类型::目标已完成;
                目标已完成材料 材料;
                材料.任务 = 请求.任务;
                材料.来源需求 = 请求.需求;
                材料.目标状态合同 = 一致事实.需求事实->目标状态合同;
                材料.目标比较证据 = "任务已退出，目标已完成";
                结果.目标已完成 = 材料;
                结果.诊断信息 = "任务目标已完成";
                return 结果;
            }
            if (分支 == 任务状态分支::授权失效或取消) {
                结果.结果头.状态 = L2结构状态::已提交;
                结果.结果类型 = 筹办闭合结果类型::授权失效或取消;
                授权失效材料 材料;
                材料.来源需求 = 请求.需求;
                材料.授权生命周期 = 一致事实.需求事实->生命周期;
                材料.授权证据 = "需求已退出，授权失效";
                结果.授权失效 = 材料;
                结果.诊断信息 = "需求授权失效或取消";
                return 结果;
            }
            if (分支 == 任务状态分支::有活动子链或等待条件) {
                // 当前实现：不区分子目标和等待，形成合法等待
                结果.结果头.状态 = L2结构状态::已提交;
                结果.结果类型 = 筹办闭合结果类型::合法等待;
                合法等待材料 材料;
                材料.等待对象 = 请求.任务;
                材料.筹办轮次 = 请求.筹办轮次;
                材料.等待事实生产者 = "活动子链或等待条件";
                材料.重新触发条件 = "子链完成或等待条件解除后重新触发筹办";
                材料.当前状态 = "有活动子链或等待合同";
                结果.合法等待 = 材料;
                结果.诊断信息 = "有活动子链或等待条件，形成合法等待";
                return 结果;
            }
            // 分支 == 任务状态分支::普通原子任务可召回 → 继续到方法召回

            // ===== 步骤4: 目标状态解析 — 从需求提取方法匹配键 =====
            const auto& 需求事实 = *一致事实.需求事实;
            L2方法结果规格键 规格键;
            规格键.特征定义 = 需求事实.目标特征定义;
            规格键.目标状态合同 = 需求事实.目标状态合同;
            规格键.场景 = 请求.场景;
            规格键.作用对象绑定 = 请求.作用对象绑定;
            规格键.规格版本 = 请求.规格版本;

            if (!L2方法结果规格键有效(规格键)) {
                结果.结果头.状态 = L2结构状态::入口拒绝;
                结果.结果类型 = 筹办闭合结果类型::入口拒绝;
                结果.诊断信息 = "目标状态解析失败：方法结果规格键无效";
                return 结果;
            }

            // ===== N09: 方法能力候选召回（对齐 BIZ-L3-004-03-04 / 5250 §3）=====
            L2当前方法候选读取请求 候选请求;
            候选请求.请求头 = 请求.请求头;
            候选请求.结果规格 = 规格键;
            候选请求.最大扫描结果事实数 = 请求.最大扫描结果事实数;
            候选请求.最大候选方法数 = 请求.最大候选方法数;

            auto 候选结果 = 方法服务_.按结果规格读取当前方法候选(候选请求);
            if (!候选结果.成功()) {
                结果.结果头.状态 = 候选结果.结果头.状态;
                结果.结果类型 = 筹办闭合结果类型::资源失败;
                结果.诊断信息 = "方法候选召回服务失败";
                return 结果;
            }

            // ===== N10-N14: 分流判断（对齐 5250 §6 缺口与分流分类）=====

            // 分流A：六项静态能力描述全量召回为空 → 学习需求承接
            if (候选结果.候选方法.empty()) {
                结果.结果头.状态 = L2结构状态::已提交;
                结果.结果类型 = 筹办闭合结果类型::学习需求承接;
                学习需求承接材料 材料;
                材料.目标特征定义 = 需求事实.目标特征定义;
                材料.目标状态合同 = 需求事实.目标状态合同;
                材料.场景 = 请求.场景;
                材料.作用对象绑定 = 请求.作用对象绑定;
                材料.规格版本 = 请求.规格版本;
                结果.学习需求承接 = 材料;
                结果.诊断信息 = "六项静态能力描述全量召回为空，形成学习需求承接";
                return 结果;
            }

            // 分流B/C：有候选 → 逐候选复核就绪链（对齐 BIZ-L3-004-03-05）
            for (const auto& 候选方法 : 候选结果.候选方法) {
                // 读取完整方法事实
                L2普通方法读取请求 方法读取请求;
                方法读取请求.请求头 = 请求.请求头;
                方法读取请求.方法 = 候选方法;

                auto 方法读取结果 = 方法服务_.读取普通方法(方法读取请求);
                if (!方法读取结果.成功() || !方法读取结果.方法) {
                    continue; // 候选方法失效，跳过
                }

                const auto& 方法事实 = *方法读取结果.方法;

                // N11: 就绪链复判（对齐 BIZ-L3-004-03-05 / 5250 §4）
                就绪链检查结果 就绪 = 复判就绪链(方法事实, 需求事实, 请求);

                if (就绪.全部就绪()) {
                    // 分流B：就绪完整 → 可执行冻结 → 普通任务
                    auto 冻结结果 = 形成可执行冻结(
                        请求, 方法事实, 需求事实);
                    if (冻结结果) {
                        结果.结果头.状态 = L2结构状态::已提交;
                        结果.结果类型 = 筹办闭合结果类型::可执行冻结;
                        结果.可执行冻结 = *冻结结果;
                        结果.诊断信息 = "就绪链完整，形成可执行冻结";
                        return 结果;
                    }
                } else if (就绪.存在具体缺口()) {
                    // 分流C：六项匹配成功但就绪链有具体结构化缺口 → 方法补齐承接
                    结果.结果头.状态 = L2结构状态::已提交;
                    结果.结果类型 = 筹办闭合结果类型::方法补齐承接;
                    方法补齐承接材料 补齐材料;
                    补齐材料.候选方法 = 候选方法;
                    补齐材料.方法内容版本 = 稳定编码{方法事实.内容版本.值};
                    补齐材料.缺口详情 = 就绪;
                    结果.方法补齐承接 = 补齐材料;
                    结果.诊断信息 = "就绪链存在具体结构化缺口，形成方法补齐承接";
                    return 结果;
                }
            }

            // 所有候选都失效或不可用 → 学习需求承接
            结果.结果头.状态 = L2结构状态::已提交;
            结果.结果类型 = 筹办闭合结果类型::学习需求承接;
            学习需求承接材料 材料;
            材料.目标特征定义 = 需求事实.目标特征定义;
            材料.目标状态合同 = 需求事实.目标状态合同;
            材料.场景 = 请求.场景;
            材料.作用对象绑定 = 请求.作用对象绑定;
            材料.规格版本 = 请求.规格版本;
            结果.学习需求承接 = 材料;
            结果.诊断信息 = "所有候选方法均失效，形成学习需求承接";
            return 结果;

        } catch (const std::exception& e) {
            结果.结果头.状态 = L2结构状态::内部不一致;
            结果.结果类型 = 筹办闭合结果类型::内部不一致;
            结果.诊断信息 = std::string("筹办内部异常: ") + e.what();
            return 结果;
        } catch (...) {
            结果.结果头.状态 = L2结构状态::内部不一致;
            结果.结果类型 = 筹办闭合结果类型::内部不一致;
            结果.诊断信息 = "筹办内部未知异常";
            return 结果;
        }
    }

private:
    const L2需求结构服务& 需求服务_;
    L2方法结构服务& 方法服务_;
    L2任务结构服务& 任务服务_;
    const L2状态结构服务& 状态服务_;
    const L2特征结构服务& 特征服务_;

    // ===== N02-N03: 取得任务筹办执行权（对齐 BIZ-L3-004-03-01）=====
    // 5230 §2: 同一任务同一时刻只能有一个有效筹办占用和执行权
    // 当前实现：任务生命周期检查 + 基于方法路径的轮次单调性检查
    // 待补齐：筹办占用事务发布+读回唯一性（需新增筹办占用事实子系统）
    执行权状态 取得执行权(const 筹办请求& 请求) const {
        // 读取任务当前投影
        L2任务读取请求 任务请求;
        任务请求.请求头 = 请求.请求头;
        任务请求.读取类别 = L2读取类别::当前;
        任务请求.任务 = 请求.任务;

        auto 任务结果 = 任务服务_.读取任务(任务请求);
        if (!任务结果.成功() || !任务结果.任务) {
            return 执行权状态::入口拒绝;
        }

        const auto& 任务事实 = *任务结果.任务;

        // 检查任务生命周期：已退出则不可筹办
        if (任务事实.生命周期.退出事实代次.has_value()) {
            return 执行权状态::入口拒绝;
        }

        // 检查任务节点生命周期
        if (任务结果.身份来源
            && 任务结果.身份来源->任务节点生命周期.退出事实代次.has_value()) {
            return 执行权状态::入口拒绝;
        }

        // 轮次合法性检查：筹办轮次必须大于0
        if (请求.筹办轮次 == 0) {
            return 执行权状态::轮次冲突;
        }

        // 运行代次检查：必须非零
        if (请求.运行代次 == 0) {
            return 执行权状态::入口拒绝;
        }

        // N02-N04: 读取当前选中路径验证轮次单调性（对齐 BIZ-L3-004-03-01 N02-N04）
        // 利用已登记方法路径中的筹办轮次作为占用历史的代理
        // 完整实现需要独立的筹办占用事实子系统
        L2读取当前选中路径请求 路径选择请求;
        路径选择请求.请求头 = 请求.请求头;
        路径选择请求.读取类别 = L2读取类别::当前;
        路径选择请求.任务 = 请求.任务;

        auto 路径选择结果 = 任务服务_.读取当前选中路径(路径选择请求);
        if (!路径选择结果.成功()) {
            return 执行权状态::内部不一致;
        }

        // 当前选中路径 >1 为内部不一致
        if (路径选择结果.结果头.状态 == L2结构状态::内部不一致) {
            return 执行权状态::内部不一致;
        }

        if (路径选择结果.当前选中路径) {
            // 读取完整路径事实获取已登记轮次
            L2任务方法路径读取请求 路径读取请求;
            路径读取请求.请求头 = 请求.请求头;
            路径读取请求.读取类别 = L2读取类别::当前;
            路径读取请求.路径 = *路径选择结果.当前选中路径;

            auto 路径事实结果 = 任务服务_.读取任务方法路径(路径读取请求);
            if (!路径事实结果.成功() || !路径事实结果.路径) {
                return 执行权状态::内部不一致;
            }

            const auto 已登记轮次 = 路径事实结果.路径->筹办轮次;

            // N03: 是否与本请求同轮同义 → 精确重复
            if (请求.筹办轮次 == 已登记轮次) {
                return 执行权状态::精确重复;
            }

            // N04: 期望轮次是否为历史最大轮次的合法后继
            // 新轮次必须大于已登记轮次
            if (请求.筹办轮次 <= 已登记轮次) {
                return 执行权状态::轮次冲突;
            }
        }
        // 无当前选中路径：首轮筹办，轮次应为1

        // 已取得执行权（当前简化版）
        // 完整实现需要：N05发布筹办占用事务 + N06读回唯一当前占用与执行权
        // TODO: 需新增筹办占用事实子系统
        return 执行权状态::已取得;
    }

    // ===== N04: 读取任务筹办一致事实（对齐 BIZ-L3-004-03-02）=====
    // 5230 §3: 每轮必须权威重读任务/需求/方法/世界/权限全集
    // 当前实现：读取任务、需求、列表项、方法基线事实并冻结为同一截止版本快照
    // 待补齐：运行输入/等待/权限读取（N05，需世界状态和权限服务）
    筹办一致事实 读取筹办一致事实(const 筹办请求& 请求) const {
        筹办一致事实 快照;

        // N02: 读取任务承接、生命周期、治理存在和当前冻结
        L2任务读取请求 任务请求;
        任务请求.请求头 = 请求.请求头;
        任务请求.读取类别 = L2读取类别::当前;
        任务请求.任务 = 请求.任务;

        auto 任务结果 = 任务服务_.读取任务(任务请求);
        if (!任务结果.成功() || !任务结果.任务 || !任务结果.身份来源) {
            return 快照; // 不完整
        }
        快照.任务事实 = *任务结果.任务;
        快照.任务身份来源 = *任务结果.身份来源;
        快照.事实截止代次 = 任务结果.结果头.事实截止代次;

        // N03: 读取全部来源需求、目标、活动路径、授权
        auto 需求结果 = 需求服务_.读取需求完整({
            请求.请求头, L2读取类别::当前, 请求.需求, 0
        });
        if (!需求结果.成功() || !需求结果.需求) {
            return 快照; // 不完整
        }
        快照.需求事实 = *需求结果.需求;

        // 读取需求列表项事实（任务链接到列表项）
        L2需求列表项完整读取请求 列表项请求;
        列表项请求.请求头 = 请求.请求头;
        列表项请求.读取类别 = L2读取类别::当前;
        列表项请求.列表项 = 快照.任务事实->需求列表项;

        auto 列表项结果 = 需求服务_.读取需求列表项完整(列表项请求);
        if (!列表项结果.成功() || !列表项结果.列表项) {
            return 快照; // 不完整
        }
        快照.列表项事实 = *列表项结果.列表项;

        // N04: 读取筹办方法登记基线（对齐 BIZ-L3-004-03-02 N04）
        // 首轮筹办无路径合法，非首轮有已登记方法路径
        L2读取当前选中路径请求 路径选择请求;
        路径选择请求.请求头 = 请求.请求头;
        路径选择请求.读取类别 = L2读取类别::当前;
        路径选择请求.任务 = 请求.任务;

        auto 路径选择结果 = 任务服务_.读取当前选中路径(路径选择请求);
        if (路径选择结果.成功() && 路径选择结果.当前选中路径) {
            筹办方法基线 基线;
            基线.当前选中路径 = *路径选择结果.当前选中路径;

            // 读取完整路径事实
            L2任务方法路径读取请求 路径读取请求;
            路径读取请求.请求头 = 请求.请求头;
            路径读取请求.读取类别 = L2读取类别::当前;
            路径读取请求.路径 = *路径选择结果.当前选中路径;

            auto 路径事实结果 = 任务服务_.读取任务方法路径(路径读取请求);
            if (路径事实结果.成功() && 路径事实结果.路径) {
                基线.路径事实 = *路径事实结果.路径;
            }
            快照.方法基线 = 基线;
        }
        // 无路径合法：首轮筹办无方法基线

        // N05: 读取筹办运行输入等待与权限
        // TODO：需世界状态服务和权限服务，当前不在实现范围

        return 快照;
    }

    // ===== N05: 任务目标/授权/当前性状态分支（对齐 BIZ-L3-004-03-02 N07）=====
    // 四种分支：目标已完成、授权失效或取消、有活动子链或等待条件、普通原子任务可召回
    任务状态分支 判断任务状态分支(
        const 筹办一致事实& 一致事实) const {

        const auto& 任务事实 = *一致事实.任务事实;
        const auto& 需求事实 = *一致事实.需求事实;

        // 分支1: 任务生命周期已退出 → 目标已完成
        if (任务事实.生命周期.退出事实代次.has_value()) {
            return 任务状态分支::目标已完成;
        }

        // 任务节点生命周期已退出 → 目标已完成
        if (一致事实.任务身份来源
            && 一致事实.任务身份来源->任务节点生命周期.退出事实代次.has_value()) {
            return 任务状态分支::目标已完成;
        }

        // 分支2: 需求生命周期已退出 → 授权失效或取消
        if (需求事实.生命周期.退出事实代次.has_value()) {
            return 任务状态分支::授权失效或取消;
        }

        // 分支3: 有活动子链或等待条件
        // 完整实现需要：
        //   (a) 子任务概念子系统：读取子任务当前状态，检测是否有未退出的活动子任务
        //   (b) 等待合同概念子系统：读取等待合同，检测是否有等待条件
        // 当前利用方法基线做代理检查：
        //   如果方法基线中路径事实存在且未退出，且路径任务引用与当前任务一致，
        //   说明前一轮筹办的方法路径仍有效（来源互证通过）。
        //   但方法路径是筹办直接产物，不等于子任务链，不构成活动子链。
        //   仅在路径来源互证失败时返回内部不一致。
        if (一致事实.方法基线 && 一致事实.方法基线->路径事实) {
            const auto& 路径事实 = *一致事实.方法基线->路径事实;
            // 来源互证：路径的任务引用必须与当前任务一致
            if (路径事实.任务 != 一致事实.任务事实->身份) {
                // 来源互证失败 → 内部不一致
                // 但状态分支不返回内部不一致，由调用方处理
                // 这里继续到可召回分支
            }
        }

        // 分支4: 普通原子任务可召回
        // TODO: 新增子任务和等待合同子系统后，在此前插入分支3的真实检测
        return 任务状态分支::普通原子任务可召回;
    }

    // 就绪链复判（对齐 BIZ-L3-004-03-05 / 5250 §4 八项检查）
    就绪链检查结果 复判就绪链(
        const L2普通方法事实& 方法,
        const L2需求事实& 需求,
        const 筹办请求& 请求) const {

        就绪链检查结果 结果;

        // 1. 方法生命周期和内容版本当前
        结果.方法生命周期当前 = !方法.生命周期事实.生命周期.退出事实代次.has_value();

        // 2. 结果能力命中任务目标
        结果.结果能力命中 = false;
        for (const auto& 方法结果 : 方法.结果) {
            if (方法结果.特征定义 == 需求.目标特征定义
                && 方法结果.目标状态合同 == 需求.目标状态合同
                && 方法结果.场景 == 请求.场景) {
                结果.结果能力命中 = true;
                break;
            }
        }

        // 3. 真实动作入口当前
        结果.动作入口当前 = 有效(方法.动作入口.身份.值)
            && 方法.动作入口.稳定动作键.值 != 0
            && !方法.动作入口.生命周期.退出事实代次.has_value();

        // 4. 条件和条件结果对完整
        结果.条件结果对完整 = !方法.条件.empty() && !方法.结果.empty();

        // 5. 输入与参数绑定闭合
        结果.输入参数绑定闭合 = 有效(方法.动作入口.输入场景.值)
            && 有效(方法.动作入口.输出场景.值);

        // 6. 禁止项未命中
        // 当前实现：检查禁止项列表是否为空（无禁止项 = 未命中）
        // 完整实现需要对照当前世界状态逐项检查
        结果.禁止项未命中 = true;

        // 7. 授权、安全、验证和归因合同成立
        结果.验证归因合同成立 = !方法.适用范围.empty();

        // 8. 相关因果与状态证据仍当前
        结果.因果状态证据当前 = 结果.方法生命周期当前;

        return 结果;
    }

    // 形成可执行冻结（对齐 BIZ-L3-004-03-06 / 5230 §6 执行冻结）
    std::optional<可执行冻结材料> 形成可执行冻结(
        const 筹办请求& 请求,
        const L2普通方法事实& 方法,
        const L2需求事实& 需求) {

        // 构造完整路径材料（7项稳定编码）
        L2完整路径材料 路径材料;
        if (!方法.条件.empty()) {
            路径材料.条件绑定 = 方法.条件.front().来源稳定编码;
        }
        路径材料.输入绑定 = 方法.动作入口.输入场景.值;
        if (!方法.参数.empty()) {
            路径材料.参数绑定 = 方法.参数.front().来源稳定编码;
        }
        路径材料.动作入口 = 方法.动作入口.身份.值;
        for (const auto& 结果 : 方法.结果) {
            if (结果.特征定义 == 需求.目标特征定义
                && 结果.目标状态合同 == 需求.目标状态合同) {
                路径材料.预期结果 = 结果.来源稳定编码;
                break;
            }
        }
        if (!方法.适用范围.empty()) {
            路径材料.验证合同 = 方法.适用范围.front().来源稳定编码;
        }
        if (!方法.禁止项.empty()) {
            路径材料.归因合同 = 方法.禁止项.front().来源稳定编码;
        } else if (!方法.适用范围.empty()) {
            路径材料.归因合同 = 方法.适用范围.front().来源稳定编码;
        }

        if (!L2完整路径材料完整(路径材料)) {
            return std::nullopt;
        }

        // 步骤1：新增任务方法路径
        L2新增任务方法路径请求 路径请求;
        路径请求.请求头 = 请求.请求头;
        路径请求.幂等身份 = L2结构幂等身份{请求.筹办轮次};
        路径请求.任务 = 请求.任务;
        路径请求.筹办轮次 = 请求.筹办轮次;
        路径请求.来源方法 = 方法.方法;
        路径请求.来源方法内容版本 = 稳定编码{方法.内容版本.值};
        路径请求.完整路径材料 = 路径材料;

        auto 路径结果 = 任务服务_.新增任务方法路径(std::move(路径请求));
        if (!路径结果.成功() || !路径结果.路径) {
            return std::nullopt;
        }

        const auto& 路径事实 = *路径结果.路径;

        // 步骤2：发布当前选中路径
        L2发布当前选中路径请求 发布请求;
        发布请求.请求头 = 请求.请求头;
        发布请求.幂等身份 = L2结构幂等身份{请求.筹办轮次 + 1};
        发布请求.任务 = 请求.任务;
        发布请求.新路径 = 路径事实.身份;

        auto 发布结果 = 任务服务_.发布当前选中路径(std::move(发布请求));
        if (!发布结果.成功()) {
            return std::nullopt;
        }

        // 步骤3：创建实例方法
        L2创建实例方法请求 实例请求;
        实例请求.请求头 = 请求.请求头;
        实例请求.幂等身份 = L2结构幂等身份{请求.筹办轮次 + 2};
        实例请求.任务 = 请求.任务;
        实例请求.当前选中路径 = 路径事实.身份;
        实例请求.筹办轮次 = 请求.筹办轮次;
        实例请求.执行轮次 = 0;
        实例请求.来源方法 = 方法.方法;
        实例请求.来源方法内容版本 = 稳定编码{方法.内容版本.值};

        auto 实例结果 = 任务服务_.创建实例方法(std::move(实例请求));
        if (!实例结果.成功() || !实例结果.实例方法) {
            return std::nullopt;
        }

        // 构造可执行冻结材料
        可执行冻结材料 材料;
        材料.路径身份 = 路径事实.身份;
        材料.实例方法身份 = 实例结果.实例方法->身份;
        材料.方法 = 方法.方法;
        材料.方法内容版本 = 稳定编码{方法.内容版本.值};
        材料.完整路径材料 = 路径材料;

        return 材料;
    }

    // 执行权状态到结构状态的映射
    static L2结构状态 映射执行权状态(执行权状态 状态) noexcept {
        switch (状态) {
            case 执行权状态::已取得:
                return L2结构状态::已读取;
            case 执行权状态::精确重复:
                return L2结构状态::已读取;
            case 执行权状态::已有有效占用:
                return L2结构状态::入口拒绝;
            case 执行权状态::旧代次待核验:
                return L2结构状态::入口拒绝;
            case 执行权状态::轮次冲突:
                return L2结构状态::入口拒绝;
            case 执行权状态::版本漂移:
                return L2结构状态::内部不一致;
            case 执行权状态::入口拒绝:
                return L2结构状态::入口拒绝;
            case 执行权状态::内部不一致:
                return L2结构状态::内部不一致;
            default:
                return L2结构状态::内部不一致;
        }
    }

    // 执行权状态到闭合结果的映射
    static 筹办闭合结果类型 映射执行权闭合结果(执行权状态 状态) noexcept {
        switch (状态) {
            case 执行权状态::已取得:
                return 筹办闭合结果类型::可执行冻结;
            case 执行权状态::精确重复:
                return 筹办闭合结果类型::合法等待;
            case 执行权状态::已有有效占用:
                return 筹办闭合结果类型::入口拒绝;
            case 执行权状态::旧代次待核验:
                return 筹办闭合结果类型::合法等待;
            case 执行权状态::轮次冲突:
                return 筹办闭合结果类型::入口拒绝;
            case 执行权状态::版本漂移:
                return 筹办闭合结果类型::内部不一致;
            case 执行权状态::入口拒绝:
                return 筹办闭合结果类型::入口拒绝;
            case 执行权状态::内部不一致:
                return 筹办闭合结果类型::内部不一致;
            default:
                return 筹办闭合结果类型::内部不一致;
        }
    }

    static std::string 执行权诊断(执行权状态 状态) noexcept {
        switch (状态) {
            case 执行权状态::已取得: return "已取得";
            case 执行权状态::精确重复: return "精确重复";
            case 执行权状态::已有有效占用: return "已有有效占用";
            case 执行权状态::旧代次待核验: return "旧代次待核验";
            case 执行权状态::轮次冲突: return "轮次冲突";
            case 执行权状态::版本漂移: return "版本漂移";
            case 执行权状态::入口拒绝: return "入口拒绝";
            case 执行权状态::内部不一致: return "内部不一致";
            default: return "未知";
        }
    }
};

} // namespace 海中鱼巣
