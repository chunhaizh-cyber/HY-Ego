namespace 海中鱼巣::任务重筹办触发内部 {

任务重筹办触发状态 映射状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::已提交: return 任务重筹办触发状态::已形成;
    case L2结构状态::精确重复: return 任务重筹办触发状态::精确重复;
    case L2结构状态::事实代次漂移:
        return 任务重筹办触发状态::当前性漂移;
    case L2结构状态::幂等冲突:
    case L2结构状态::引用冲突:
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::属性未设置:
        return 任务重筹办触发状态::引用冲突;
    case L2结构状态::入口拒绝:
    case L2结构状态::许可拒绝:
    case L2结构状态::未实现:
        return 任务重筹办触发状态::入口拒绝;
    case L2结构状态::资源失败:
    case L2结构状态::数量预算不足:
        return 任务重筹办触发状态::资源失败;
    case L2结构状态::已读取:
    case L2结构状态::内部不一致:
    default:
        return 任务重筹办触发状态::内部错误;
    }
}

L2任务目标裁决结构材料 映射裁决(
    const 任务目标达成裁决快照& 裁决) noexcept {
    L2任务目标裁决结构材料 材料;
    材料.治理输入幂等键 = 裁决.治理输入幂等键;
    材料.任务 = 裁决.任务;
    材料.实例方法 = 裁决.实例方法;
    材料.执行轮次 = 裁决.执行轮次;
    材料.任务实际结果 = 裁决.任务实际结果;
    材料.任务目标来源 = 裁决.任务目标来源;
    材料.目标宿主 = 裁决.目标宿主;
    材料.目标特征 = 裁决.目标特征;
    材料.目标状态合同 = 裁决.目标状态合同;
    材料.实际状态 = 裁决.实际状态;
    材料.动态证据 = 裁决.动态证据;
    材料.方法 = 裁决.方法;
    材料.路径预期结果 = 裁决.路径预期结果;
    材料.路径验证合同 = 裁决.路径验证合同;
    材料.比较注册 = 裁决.比较注册;
    材料.比较算法版本 = 裁决.比较算法版本;
    材料.具名关系 = 裁决.具名关系;
    材料.允许关系位 = 裁决.允许关系位;
    材料.目标达成状态 = L2任务目标达成状态::未达成;
    材料.后继准备 = L2任务目标裁决后继准备::目标未达成待重筹办;
    材料.来源共同事实截止 = 裁决.事实截止代次;
    return 材料;
}

bool 生命周期相同(const L2生命周期& 左, const L2生命周期& 右) noexcept {
    return 左.创建事实代次 == 右.创建事实代次
        && 左.退出事实代次 == 右.退出事实代次;
}

bool 路径材料相同(
    const L2完整路径材料& 左,
    const L2完整路径材料& 右) noexcept {
    return 左.条件绑定 == 右.条件绑定
        && 左.输入绑定 == 右.输入绑定
        && 左.参数绑定 == 右.参数绑定
        && 左.动作入口 == 右.动作入口
        && 左.预期结果 == 右.预期结果
        && 左.验证合同 == 右.验证合同
        && 左.归因合同 == 右.归因合同;
}

bool 路径事实相同(
    const L2任务方法路径事实& 左,
    const L2任务方法路径事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.任务 == 右.任务
        && 左.筹办轮次 == 右.筹办轮次
        && 左.来源方法 == 右.来源方法
        && 左.来源方法内容版本 == 右.来源方法内容版本
        && 路径材料相同(左.完整路径材料, 右.完整路径材料)
        && 生命周期相同(左.生命周期, 右.生命周期);
}

bool 实例事实相同(
    const L2实例方法事实& 左,
    const L2实例方法事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.任务 == 右.任务
        && 左.当前选中路径 == 右.当前选中路径
        && 左.筹办轮次 == 右.筹办轮次
        && 左.执行轮次 == 右.执行轮次
        && 左.来源方法 == 右.来源方法
        && 左.来源方法内容版本 == 右.来源方法内容版本
        && 生命周期相同(左.生命周期, 右.生命周期);
}

bool 实际结果事实相同(
    const L2任务实际结果事实& 左,
    const L2任务实际结果事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.任务 == 右.任务
        && 左.实例方法 == 右.实例方法
        && 左.执行轮次 == 右.执行轮次
        && 左.方法 == 右.方法 && 左.动作入口 == 右.动作入口
        && 左.场景 == 右.场景 && 左.主体 == 右.主体
        && 左.实际状态 == 右.实际状态
        && 左.动态证据 == 右.动态证据
        && 左.来源材料版本 == 右.来源材料版本
        && 左.运行代次 == 右.运行代次
        && 生命周期相同(左.生命周期, 右.生命周期);
}

} // namespace 海中鱼巣::任务重筹办触发内部

export namespace 海中鱼巣 {

class 任务目标未达成重筹办触发提供者 final {
public:
    explicit 任务目标未达成重筹办触发提供者(
        L2任务结构服务& 任务服务) noexcept
        : 任务服务_(任务服务) {}

    任务重筹办触发结果 形成待重筹办与下一筹办工作包(
        const 任务重筹办意图& 意图) noexcept;

private:
    L2任务结构服务& 任务服务_;
};

} // namespace 海中鱼巣

namespace 海中鱼巣 {

namespace 任务重筹办触发内部 {

任务重筹办触发结果 读回并形成工作包(
    L2任务结构服务& 任务服务_,
    const 任务重筹办意图& 意图,
    const L2任务方法路径事实& 路径,
    const L2实例方法事实& 实例,
    const L2任务实际结果事实& 实际结果,
    const L2提交目标未达成待重筹办迁移结果& 迁移) noexcept {
    const auto G2 = 迁移.结果头.事实截止代次;
    const auto 当前状态 = 任务服务_.读取任务当前治理状态(
        {{L2结构合同版本, G2}, 意图.任务});
    const auto 当前路径 = 任务服务_.读取当前选中路径({
        {L2结构合同版本, G2}, L2读取类别::当前, 意图.任务, 0});
    const auto 当前实例 = 任务服务_.按任务读取当前实例方法({
        {L2结构合同版本, G2}, L2读取类别::当前, 意图.任务, 0});
    const auto 结果读回 = 任务服务_.读取任务实际结果({
        {L2结构合同版本, G2}, L2读取类别::当前,
        意图.旧任务实际结果, 0});
    const auto 分区读回 = 任务服务_.按任务读取筹办轮次分区({
        {L2结构合同版本, G2}, L2读取类别::当前, 意图.任务, 0});
    if (!当前状态.成功() || !当前状态.当前状态
        || 当前状态.当前状态->身份 != 迁移.目标状态->身份
        || !当前路径.成功() || 当前路径.当前选中路径
        || !当前实例.成功() || 当前实例.当前实例方法
        || !结果读回.成功() || !结果读回.实际结果
        || !实际结果事实相同(*结果读回.实际结果, 实际结果)
        || !路径事实相同(*迁移.旧路径, 路径)
        || !实例事实相同(*迁移.旧实例, 实例)) {
        return {任务重筹办触发状态::内部错误, std::nullopt};
    }
    if (!分区读回.成功() || 分区读回.分区 != 迁移.轮次分区
        || (迁移.轮次分区 == L2任务筹办轮次分区::统一轮次权威
            && (!分区读回.统一当前准备 || !迁移.后继准备记录
                || !分区读回.统一当前准备->当前后继准备记录
                || 分区读回.统一当前准备->当前后继准备记录->身份
                    != 迁移.后继准备记录->身份)))
        return {任务重筹办触发状态::内部错误, std::nullopt};

    if (实例.筹办轮次 == (std::numeric_limits<std::uint64_t>::max)())
        return {任务重筹办触发状态::内部错误, std::nullopt};
    下一筹办工作包 工作包;
    工作包.任务 = 意图.任务;
    工作包.旧路径 = 路径.身份;
    工作包.旧实例 = 实例.身份;
    工作包.旧执行轮次 = 实例.执行轮次;
    工作包.旧实际结果 = 实际结果.身份;
    工作包.正式目标裁决证据 = 迁移.目标裁决证据->身份;
    工作包.正式待重筹办状态 = 迁移.目标状态->身份;
    工作包.原共同事实截止 = 意图.原共同事实截止;
    工作包.迁移后事实代次 = G2;
    if (迁移.轮次分区 == L2任务筹办轮次分区::统一轮次权威) {
        if (!迁移.后继准备记录
            || 迁移.后继准备记录->触发事实 != 实际结果.身份.值
            || 迁移.后继准备记录->旧路径 != 路径.身份
            || 迁移.后继准备记录->旧实例 != 实例.身份
            || 迁移.后继准备记录->目标裁决证据
                != 迁移.目标裁决证据->身份
            || 迁移.后继准备记录->正式待重筹办状态
                != 迁移.目标状态->身份)
            return {任务重筹办触发状态::内部错误, std::nullopt};
        工作包.旧筹办轮次 = 迁移.后继准备记录->前一筹办轮次;
        工作包.新筹办轮次 = 迁移.后继准备记录->新筹办轮次;
    } else if (迁移.轮次分区 == L2任务筹办轮次分区::遗留实例轮次
        && !迁移.后继准备记录) {
        工作包.旧筹办轮次 = 实例.筹办轮次;
        工作包.新筹办轮次 = 实例.筹办轮次 + 1;
    } else {
        return {任务重筹办触发状态::内部错误, std::nullopt};
    }
    工作包.运行代次 = 意图.运行代次;
    工作包.原重筹办意图幂等键 = 意图.意图幂等键;
    if (!下一筹办工作包完整(工作包))
        return {任务重筹办触发状态::内部错误, std::nullopt};
    return {迁移.结果头.状态 == L2结构状态::精确重复
            ? 任务重筹办触发状态::精确重复
            : 任务重筹办触发状态::已形成,
        std::move(工作包)};
}

struct 当前任务绑定材料 final {
    L2任务事实 任务;
    L2任务方法路径事实 路径;
    L2实例方法事实 实例;
    L2任务实际结果事实 实际结果;
    L2任务筹办轮次分区 轮次分区 = L2任务筹办轮次分区::内部不一致;
    std::optional<L2任务当前筹办准备事实> 统一当前准备;
};

任务重筹办触发状态 读取并互证当前任务绑定(
    L2任务结构服务& 任务服务,
    const 任务重筹办意图& 意图,
    当前任务绑定材料& 材料) noexcept {
    const auto 任务读取 = 任务服务.读取任务({
        {L2结构合同版本, 意图.原共同事实截止},
        L2读取类别::当前, 意图.任务, 0});
    if (!任务读取.成功() || !任务读取.任务)
        return 映射状态(任务读取.结果头.状态);

    const auto 当前代次 = 任务读取.结果头.事实截止代次;
    const auto 分区读取 = 任务服务.按任务读取筹办轮次分区({
        {L2结构合同版本, 当前代次}, L2读取类别::当前, 意图.任务, 0});
    if (!分区读取.成功())
        return 映射状态(分区读取.结果头.状态);
    const auto 实例读取 = 任务服务.读取实例方法({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        意图.旧实例方法, 0});
    if (!实例读取.成功() || !实例读取.实例方法)
        return 映射状态(实例读取.结果头.状态);

    const auto 路径读取 = 任务服务.读取任务方法路径({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        实例读取.实例方法->当前选中路径, 0});
    const auto 结果读取 = 任务服务.读取任务实际结果({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        意图.旧任务实际结果, 0});
    if (!路径读取.成功() || !路径读取.路径
        || !结果读取.成功() || !结果读取.实际结果) {
        return 映射状态(!路径读取.成功()
            ? 路径读取.结果头.状态 : 结果读取.结果头.状态);
    }

    const auto& 任务 = *任务读取.任务;
    const auto& 实例 = *实例读取.实例方法;
    const auto& 路径 = *路径读取.路径;
    const auto& 实际结果 = *结果读取.实际结果;
    if (实例.任务 != 意图.任务 || 路径.任务 != 意图.任务
        || 实例.执行轮次 != 意图.旧执行轮次
        || 实际结果.任务 != 意图.任务
        || 实际结果.实例方法 != 意图.旧实例方法
        || 实际结果.执行轮次 != 意图.旧执行轮次
        || 路径.完整路径材料.预期结果 != 意图.目标裁决.路径预期结果
        || 路径.完整路径材料.验证合同 != 意图.目标裁决.路径验证合同
        || 实际结果.实际状态 != 意图.目标裁决.实际状态
        || 实际结果.动态证据 != 意图.目标裁决.动态证据
        || 实际结果.方法 != 意图.目标裁决.方法
        || 任务.需求列表项 != 意图.目标裁决.任务目标来源
        || 实例.生命周期.创建事实代次 > 意图.原共同事实截止
        || 路径.生命周期.创建事实代次 > 意图.原共同事实截止
        || 实际结果.生命周期.创建事实代次 > 意图.原共同事实截止) {
        return 任务重筹办触发状态::引用冲突;
    }
    if (分区读取.分区 == L2任务筹办轮次分区::统一轮次权威) {
        if (!分区读取.统一当前准备
            || 实例.筹办轮次 != 分区读取.统一当前准备->当前筹办轮次)
            return 任务重筹办触发状态::引用冲突;
        材料.统一当前准备 = *分区读取.统一当前准备;
    } else if (分区读取.分区 != L2任务筹办轮次分区::遗留实例轮次) {
        return 任务重筹办触发状态::内部错误;
    }
    材料.任务 = 任务;
    材料.路径 = 路径;
    材料.实例 = 实例;
    材料.实际结果 = 实际结果;
    材料.轮次分区 = 分区读取.分区;
    return 任务重筹办触发状态::已形成;
}

任务重筹办触发状态 读取并互证已推进统一任务绑定(
    L2任务结构服务& 任务服务,
    const 任务重筹办意图& 意图,
    当前任务绑定材料& 材料) noexcept {
    const auto 代次探测 = 任务服务.读取任务({
        {L2结构合同版本, 意图.原共同事实截止},
        L2读取类别::当前, 意图.任务, 0});
    const auto 当前代次 = 代次探测.结果头.事实截止代次;
    if (当前代次 <= 意图.原共同事实截止)
        return 映射状态(代次探测.结果头.状态);

    const auto 任务读取 = 任务服务.读取任务({
        {L2结构合同版本, 当前代次},
        L2读取类别::当前, 意图.任务, 0});
    const auto 分区读取 = 任务服务.按任务读取筹办轮次分区({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        意图.任务, 0});
    const auto 实例读取 = 任务服务.读取实例方法({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        意图.旧实例方法, 0});
    const auto 结果读取 = 任务服务.读取任务实际结果({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        意图.旧任务实际结果, 0});
    if (!任务读取.成功() || !任务读取.任务
        || !分区读取.成功()
        || 分区读取.分区 != L2任务筹办轮次分区::统一轮次权威
        || !分区读取.统一当前准备
        || !实例读取.成功() || !实例读取.实例方法
        || !结果读取.成功() || !结果读取.实际结果)
        return 任务重筹办触发状态::当前性漂移;

    const auto 路径读取 = 任务服务.读取任务方法路径({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        实例读取.实例方法->当前选中路径, 0});
    if (!路径读取.成功() || !路径读取.路径)
        return 映射状态(路径读取.结果头.状态);

    const auto& 任务 = *任务读取.任务;
    const auto& 实例 = *实例读取.实例方法;
    const auto& 路径 = *路径读取.路径;
    const auto& 实际结果 = *结果读取.实际结果;
    if (实例.任务 != 意图.任务 || 路径.任务 != 意图.任务
        || 实例.执行轮次 != 意图.旧执行轮次
        || 实际结果.任务 != 意图.任务
        || 实际结果.实例方法 != 意图.旧实例方法
        || 实际结果.执行轮次 != 意图.旧执行轮次
        || 路径.完整路径材料.预期结果 != 意图.目标裁决.路径预期结果
        || 路径.完整路径材料.验证合同 != 意图.目标裁决.路径验证合同
        || 实际结果.实际状态 != 意图.目标裁决.实际状态
        || 实际结果.动态证据 != 意图.目标裁决.动态证据
        || 实际结果.方法 != 意图.目标裁决.方法
        || 任务.需求列表项 != 意图.目标裁决.任务目标来源)
        return 任务重筹办触发状态::引用冲突;

    const auto 按键读取 = 任务服务.按后继筹办准备幂等身份读取记录({
        {L2结构合同版本, 当前代次},
        意图.待重筹办迁移写入幂等身份});
    if (!按键读取.成功()) return 映射状态(按键读取.结果头.状态);
    std::optional<L2任务后继筹办准备记录事实> 已推进记录 =
        按键读取.后继准备记录;
    if (!已推进记录) {
        const auto& 当前准备 = *分区读取.统一当前准备;
        if (当前准备.当前后继准备记录
            && 当前准备.当前后继准备记录->触发事实
                == 意图.旧任务实际结果.值)
            已推进记录 = *当前准备.当前后继准备记录;
    }
    if (!已推进记录
        || 已推进记录->任务 != 意图.任务
        || 已推进记录->触发类型 !=
            L2任务后继筹办触发类型::实际结果未达成
        || 已推进记录->触发事实 != 意图.旧任务实际结果.值
        || 已推进记录->旧路径 != 路径.身份
        || 已推进记录->旧实例 != 实例.身份)
        return 任务重筹办触发状态::当前性漂移;

    auto 原准备 = *分区读取.统一当前准备;
    if (已推进记录->轮次权威 != 原准备.轮次权威.身份
        || 已推进记录->首次准备记录 != 原准备.首次准备记录.身份)
        return 任务重筹办触发状态::内部错误;
    原准备.当前筹办轮次 = 已推进记录->前一筹办轮次;
    原准备.当前后继准备记录.reset();
    if (已推进记录->前一后继准备记录) {
        const auto 前一记录读取 = 任务服务.读取后继筹办准备记录({
            {L2结构合同版本, 当前代次}, L2读取类别::当前,
            *已推进记录->前一后继准备记录, 0});
        if (!前一记录读取.成功() || !前一记录读取.后继准备记录
            || 前一记录读取.后继准备记录->新筹办轮次
                != 已推进记录->前一筹办轮次)
            return 任务重筹办触发状态::内部错误;
        原准备.当前后继准备记录 = *前一记录读取.后继准备记录;
    } else if (已推进记录->前一筹办轮次 != 1) {
        return 任务重筹办触发状态::内部错误;
    }

    材料.任务 = 任务;
    材料.路径 = 路径;
    材料.实例 = 实例;
    材料.实际结果 = 实际结果;
    材料.轮次分区 = L2任务筹办轮次分区::统一轮次权威;
    材料.统一当前准备 = std::move(原准备);
    return 任务重筹办触发状态::已形成;
}

任务重筹办触发结果 提交结构并形成工作包(
    L2任务结构服务& 任务服务,
    const 任务重筹办意图& 意图,
    const 当前任务绑定材料& 材料) noexcept {
    L2新增执行结果待验证状态请求 首态请求;
    首态请求.请求头 = {L2结构合同版本, 意图.原共同事实截止};
    首态请求.幂等身份 = 意图.裁决首态写入幂等身份;
    首态请求.任务 = 意图.任务;
    首态请求.任务虚拟存在 = 材料.任务.任务虚拟存在;
    首态请求.生命周期发生时间 = 意图.生命周期发生时间;
    首态请求.来源方法路径 = 材料.路径.身份;
    首态请求.来源实例方法 = 材料.实例.身份;
    首态请求.来源任务实际结果 = 材料.实际结果.身份;
    首态请求.目标裁决 = 映射裁决(意图.目标裁决);
    const auto 首态 = 任务服务.新增执行结果待验证状态(首态请求);
    if (!首态.成功() || !首态.已登记状态 || !首态.目标裁决证据)
        return {映射状态(首态.结果头.状态), std::nullopt};

    L2提交目标未达成待重筹办迁移请求 迁移请求;
    迁移请求.请求头 = {L2结构合同版本, 首态.结果头.事实截止代次};
    迁移请求.幂等身份 = 意图.待重筹办迁移写入幂等身份;
    迁移请求.任务 = 意图.任务;
    迁移请求.任务虚拟存在 = 材料.任务.任务虚拟存在;
    迁移请求.生命周期发生时间 = 意图.生命周期发生时间;
    迁移请求.前一治理状态 = 首态.已登记状态->身份;
    迁移请求.目标裁决证据 = 首态.目标裁决证据->身份;
    迁移请求.旧当前路径 = 材料.路径.身份;
    迁移请求.旧当前实例 = 材料.实例.身份;
    迁移请求.轮次分区 = 材料.轮次分区;
    if (材料.轮次分区 == L2任务筹办轮次分区::统一轮次权威) {
        if (!材料.统一当前准备)
            return {任务重筹办触发状态::内部错误, std::nullopt};
        L2提交统一轮次推进材料 推进;
        推进.轮次权威 = 材料.统一当前准备->轮次权威.身份;
        推进.首次准备记录 = 材料.统一当前准备->首次准备记录.身份;
        if (材料.统一当前准备->当前后继准备记录)
            推进.期望前一后继准备记录 =
                材料.统一当前准备->当前后继准备记录->身份;
        推进.期望前一筹办轮次 = 材料.统一当前准备->当前筹办轮次;
        推进.准备幂等身份 = 意图.待重筹办迁移写入幂等身份;
        推进.触发请求身份 = 意图.治理消息编号;
        推进.运行代次 = 意图.运行代次;
        推进.触发业务幂等身份 = L2结构幂等身份{意图.意图幂等键};
        推进.来源共同事实截止 = 首态.结果头.事实截止代次;
        迁移请求.统一轮次推进 = std::move(推进);
    }
    const auto 迁移 = 任务服务.提交目标未达成待重筹办迁移(迁移请求);
    if (迁移.结果头.状态 == L2结构状态::引用冲突
        && 迁移.轮次分区 == L2任务筹办轮次分区::统一轮次权威
        && 迁移.后继准备记录) {
        return {任务重筹办触发状态::触发已消费, std::nullopt,
            迁移.后继准备记录->身份};
    }
    if (!迁移.成功() || !迁移.目标状态 || !迁移.目标裁决证据
        || !迁移.旧路径 || !迁移.旧实例)
        return {映射状态(迁移.结果头.状态), std::nullopt};

    return 读回并形成工作包(
        任务服务, 意图, 材料.路径, 材料.实例, 材料.实际结果, 迁移);
}

} // namespace 任务重筹办触发内部

任务重筹办触发结果
任务目标未达成重筹办触发提供者::形成待重筹办与下一筹办工作包(
    const 任务重筹办意图& 意图) noexcept {
    if (!任务重筹办意图完整(意图))
        return {任务重筹办触发状态::入口拒绝, std::nullopt};
    任务重筹办触发内部::当前任务绑定材料 材料;
    auto 读取状态 =
        任务重筹办触发内部::读取并互证当前任务绑定(
            任务服务_, 意图, 材料);
    if (读取状态 != 任务重筹办触发状态::已形成)
        读取状态 = 任务重筹办触发内部::读取并互证已推进统一任务绑定(
            任务服务_, 意图, 材料);
    if (读取状态 != 任务重筹办触发状态::已形成)
        return {读取状态, std::nullopt};
    return 任务重筹办触发内部::提交结构并形成工作包(
        任务服务_, 意图, 材料);
}

} // namespace 海中鱼巣
