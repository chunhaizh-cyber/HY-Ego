// 文件规则：本模块只解释目标未达成裁决并组合任务 DATA 公开入口。
module;

#include <cstdint>
#include <limits>
#include <optional>
#include <utility>

#define 任务重筹办数据_NO_INCLUDES

export module 海中鱼巣.领域.服务.任务目标未达成重筹办触发;

import 海中鱼巣.线程.协议.任务重筹办意图;
