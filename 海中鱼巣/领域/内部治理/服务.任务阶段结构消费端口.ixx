module;

#include <cstdint>
#include <limits>
#include <new>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

#define 任务阶段治理数据_NO_INCLUDES
#define 任务阶段治理数据_排除治理尾段

export module 海中鱼巣.领域.内部治理.服务.任务阶段结构消费端口;

import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2动态结构;

export {
#include "任务阶段治理.数据.h"
}

namespace 海中鱼巣::任务阶段结构消费内部 {

任务阶段结构状态 映射中性状态(
    L2中性结构状态_v1 状态) noexcept {
    switch (状态) {
    case L2中性结构状态_v1::已提交:
        return 任务阶段结构状态::已形成;
    case L2中性结构状态_v1::精确重复:
        return 任务阶段结构状态::精确重复;
    case L2中性结构状态_v1::已读取:
        return 任务阶段结构状态::已读取;
    case L2中性结构状态_v1::未找到:
    case L2中性结构状态_v1::历史材料已清理:
        return 任务阶段结构状态::待迁移;
    case L2中性结构状态_v1::入口拒绝:
        return 任务阶段结构状态::入口拒绝;
    case L2中性结构状态_v1::事实代次漂移:
        return 任务阶段结构状态::当前性漂移;
    case L2中性结构状态_v1::幂等冲突:
        return 任务阶段结构状态::幂等冲突;
    case L2中性结构状态_v1::引用冲突:
    case L2中性结构状态_v1::动态不闭合:
        return 任务阶段结构状态::引用冲突;
    case L2中性结构状态_v1::资源失败:
        return 任务阶段结构状态::资源失败;
    default:
        return 任务阶段结构状态::内部不一致;
    }
}

任务阶段结构状态 映射特征状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::入口拒绝:
        return 任务阶段结构状态::入口拒绝;
    case L2结构状态::许可拒绝:
        return 任务阶段结构状态::许可拒绝;
    case L2结构状态::事实代次漂移:
        return 任务阶段结构状态::当前性漂移;
    case L2结构状态::幂等冲突:
        return 任务阶段结构状态::幂等冲突;
    case L2结构状态::引用冲突:
        return 任务阶段结构状态::引用冲突;
    case L2结构状态::资源失败:
        return 任务阶段结构状态::资源失败;
    default:
        return 任务阶段结构状态::内部不一致;
    }
}

任务阶段写入结果 形成写入失败(
    任务阶段写入种类 种类, 任务阶段结构状态 状态) noexcept {
    任务阶段写入结果 结果;
    结果.写入种类 = 种类;
    结果.状态 = 状态;
    return 结果;
}

bool 已形成变更(const std::optional<L2中性结构结果头_v1>& 头) noexcept {
    return 头 && 头->变更事实代次.has_value();
}

任务阶段写入结果 形成步骤失败(
    任务阶段写入种类 种类, 任务阶段结构状态 状态,
    std::optional<L2中性结构结果头_v1> 状态头 = {},
    std::optional<L2中性结构结果头_v1> 动态头 = {},
    std::optional<L2中性结构结果头_v1> 引用头 = {}) noexcept {
    auto 结果 = 形成写入失败(种类, 状态);
    if (已形成变更(状态头) || 已形成变更(动态头) || 已形成变更(引用头)) {
        结果.状态 = 任务阶段结构状态::已可能发布;
        结果.提交见证 = 任务阶段提供者提交见证{
            种类, std::move(状态头), std::move(动态头), std::move(引用头)};
    }
    return 结果;
}

bool 发生时间可表示(std::uint64_t 时间) noexcept {
    return 时间 != 0 && 时间 <= static_cast<std::uint64_t>(
        (std::numeric_limits<std::int64_t>::max)());
}

L2原始值材料 形成阶段值材料(const 任务阶段值& 阶段,
    任务阶段来源种类 来源种类, std::uint64_t 任务轮次序号,
    稳定编码 来源) {
    return L2原始值材料{std::vector<std::uint64_t>{
        static_cast<std::uint64_t>(阶段.主阶段),
        static_cast<std::uint64_t>(阶段.状态段),
        static_cast<std::uint64_t>(来源种类),
        任务轮次序号, 来源.值}};
}

bool 特征实例绑定(const L2特征实例事实& 实例,
    L2存在身份 任务正式存在, L2特征实例身份 阶段特征实例,
    std::uint64_t 截止) noexcept {
    return L2特征实例事实完整(实例, 截止) && 截止 != 0
        && 实例.身份 == 阶段特征实例
        && 实例.宿主存在 == 任务正式存在
        && 实例.生命周期.创建事实代次 <= 截止
        && (!实例.生命周期.退出事实代次
            || *实例.生命周期.退出事实代次 > 截止);
}

bool 当前选择绑定(const L2中性状态引用事实_v1& 引用,
    L2存在身份 任务正式存在, L2特征实例身份 阶段特征实例,
    L2状态身份 状态, std::uint64_t 截止) noexcept {
    return 截止 != 0 && L2中性状态引用事实完整_v1(引用)
        && 引用.类别 == L2中性状态引用类别_v1::当前选择
        && 引用.引用方 == 任务正式存在.值
        && 引用.引用角色 == 阶段特征实例.值
        && 引用.目标状态 == 状态
        && 引用.生命周期.创建事实代次 <= 截止
        && (!引用.生命周期.退出事实代次
            || *引用.生命周期.退出事实代次 > 截止);
}

bool 阶段状态绑定(const L2中性状态事实_v1& 状态,
    L2特征定义身份 特征类型, const 任务阶段值& 阶段,
    任务阶段来源种类 来源种类, std::uint64_t 发生时间,
    std::uint64_t 任务轮次序号, 稳定编码 来源) noexcept {
    const auto 载荷 = 解码任务阶段中性状态_v2(状态);
    return 载荷 && 状态.特征类型 == 特征类型
        && 载荷->阶段 == 阶段 && 载荷->来源种类 == 来源种类
        && 载荷->发生时间 == 发生时间
        && 载荷->任务轮次序号 == 任务轮次序号
        && 载荷->来源 == 来源;
}

bool 中性写入为精确重复(const L2中性结构结果头_v1& 头) noexcept {
    return 头.状态 == L2中性结构状态_v1::精确重复;
}

} // namespace 海中鱼巣::任务阶段结构消费内部

export namespace 海中鱼巣 {

class ARCHL2任务阶段结构消费适配器 final : public 任务阶段结构消费端口 {
public:
    ARCHL2任务阶段结构消费适配器(
        L2特征结构服务& 特征服务,
        L2状态结构服务& 状态服务,
        L2动态结构服务& 动态服务) noexcept
        : 特征服务_(特征服务), 状态服务_(状态服务), 动态服务_(动态服务) {}

    任务阶段写入结果 建立无动态首态(
        const 任务阶段无动态首态请求& 请求) noexcept override {
        using namespace 任务阶段结构消费内部;
        if (!任务阶段无动态首态请求有效(请求)
            || !发生时间可表示(请求.发生时间))
            return 形成写入失败(任务阶段写入种类::无动态首态,
                任务阶段结构状态::入口拒绝);
        try {
            const auto 实例读取 = 特征服务_.读取完整特征实例({
                请求.请求头, L2读取类别::当前, 请求.阶段特征实例, 0});
            if (实例读取.结果头.状态 != L2结构状态::已读取
                || !实例读取.特征实例)
                return 形成写入失败(任务阶段写入种类::无动态首态,
                    映射特征状态(实例读取.结果头.状态));
            if (!特征实例绑定(*实例读取.特征实例, 请求.任务正式存在,
                    请求.阶段特征实例, 请求.请求头.期望事实代次))
                return 形成写入失败(任务阶段写入种类::无动态首态,
                    任务阶段结构状态::引用冲突);

            const auto 状态写入 = 状态服务_.新增中性状态_v1({
                请求.请求头, L2中性状态动态合同版本_v1, 请求.幂等身份,
                L2中性材料类别_v1::实例, 实例读取.特征实例->特征定义,
                形成阶段值材料(请求.首态,
                    任务阶段来源种类::首态任务轮次,
                    请求.任务轮次序号, 请求.来源任务轮次),
                {L2中性时间语义_v1::绝对UTC纳秒,
                    static_cast<std::int64_t>(请求.发生时间)}});
            if (!状态写入.成功() || !状态写入.状态
                || !状态写入.结果头.变更事实代次)
                return 形成步骤失败(任务阶段写入种类::无动态首态,
                    映射中性状态(状态写入.结果头.状态), 状态写入.结果头);
            if (!阶段状态绑定(*状态写入.状态,
                    实例读取.特征实例->特征定义, 请求.首态,
                    任务阶段来源种类::首态任务轮次, 请求.发生时间,
                    请求.任务轮次序号, 请求.来源任务轮次))
                return 形成步骤失败(任务阶段写入种类::无动态首态,
                    任务阶段结构状态::内部不一致, 状态写入.结果头);

            const L2结构请求头 引用头{
                L2结构合同版本, *状态写入.结果头.变更事实代次};
            const auto 引用写入 = 状态服务_.设置中性状态当前选择_v1({
                引用头, L2中性状态动态合同版本_v1, 请求.幂等身份,
                请求.任务正式存在.值, 请求.阶段特征实例.值,
                {}, 状态写入.状态->身份});
            if (!引用写入.成功() || !引用写入.当前引用
                || !引用写入.结果头.变更事实代次)
                return 形成步骤失败(任务阶段写入种类::无动态首态,
                    映射中性状态(引用写入.结果头.状态),
                    状态写入.结果头, {}, 引用写入.结果头);

            const auto 读回 = 状态服务_.读取中性状态当前选择_v1({
                {L2结构合同版本, 引用写入.结果头.事实截止代次},
                L2中性状态动态合同版本_v1, L2读取类别::当前,
                请求.任务正式存在.值, 请求.阶段特征实例.值, 0});
            if (!读回.成功() || !读回.引用 || !读回.目标状态
                || *读回.引用 != *引用写入.当前引用
                || 读回.目标状态->身份 != 状态写入.状态->身份
                || !阶段状态绑定(*读回.目标状态,
                    实例读取.特征实例->特征定义, 请求.首态,
                    任务阶段来源种类::首态任务轮次, 请求.发生时间,
                    请求.任务轮次序号, 请求.来源任务轮次))
                return 形成步骤失败(任务阶段写入种类::无动态首态,
                    映射中性状态(读回.结果头.状态),
                    状态写入.结果头, std::nullopt, 引用写入.结果头);

            任务阶段写入结果 结果;
            结果.写入种类 = 任务阶段写入种类::无动态首态;
            结果.状态 = 中性写入为精确重复(状态写入.结果头)
                    && 中性写入为精确重复(引用写入.结果头)
                ? 任务阶段结构状态::精确重复 : 任务阶段结构状态::已形成;
            结果.首态证据 = 任务阶段首态证据{
                *读回.目标状态, *读回.引用,
                *状态写入.结果头.变更事实代次,
                *引用写入.结果头.变更事实代次};
            结果.本次正式读回截止 = 读回.结果头.事实截止代次;
            return 结果.成功() ? 结果 : 形成步骤失败(
                任务阶段写入种类::无动态首态,
                任务阶段结构状态::内部不一致,
                状态写入.结果头, {}, 引用写入.结果头);
        } catch (const std::bad_alloc&) {
            return 形成写入失败(任务阶段写入种类::无动态首态,
                任务阶段结构状态::资源失败);
        } catch (const std::length_error&) {
            return 形成写入失败(任务阶段写入种类::无动态首态,
                任务阶段结构状态::资源失败);
        } catch (...) {
            return 形成写入失败(任务阶段写入种类::无动态首态,
                任务阶段结构状态::内部不一致);
        }
    }

    任务阶段写入结果 发布阶段迁移(
        const 任务阶段迁移请求& 请求) noexcept override {
        using namespace 任务阶段结构消费内部;
        if (!任务阶段迁移请求有效(请求)
            || !发生时间可表示(请求.当前阶段发生时间)
            || !发生时间可表示(请求.目标阶段发生时间))
            return 形成写入失败(任务阶段写入种类::阶段迁移,
                任务阶段结构状态::入口拒绝);
        try {
            const auto 实例读取 = 特征服务_.读取完整特征实例({
                请求.请求头, L2读取类别::当前, 请求.阶段特征实例, 0});
            if (实例读取.结果头.状态 != L2结构状态::已读取
                || !实例读取.特征实例)
                return 形成写入失败(任务阶段写入种类::阶段迁移,
                    映射特征状态(实例读取.结果头.状态));
            if (!特征实例绑定(*实例读取.特征实例, 请求.任务正式存在,
                    请求.阶段特征实例, 请求.请求头.期望事实代次))
                return 形成写入失败(任务阶段写入种类::阶段迁移,
                    任务阶段结构状态::引用冲突);

            const auto 旧选择读取 = 状态服务_.读取中性状态当前选择_v1({
                请求.请求头, L2中性状态动态合同版本_v1,
                L2读取类别::当前, 请求.任务正式存在.值,
                请求.阶段特征实例.值, 0});
            if (!旧选择读取.成功() || !旧选择读取.引用
                || !旧选择读取.目标状态)
                return 形成写入失败(任务阶段写入种类::阶段迁移,
                    映射中性状态(旧选择读取.结果头.状态));
            const auto 旧载荷 = 解码任务阶段中性状态_v2(
                *旧选择读取.目标状态);
            if (*旧选择读取.引用 != 请求.旧当前选择
                || !当前选择绑定(*旧选择读取.引用, 请求.任务正式存在,
                    请求.阶段特征实例, 请求.当前状态,
                    请求.请求头.期望事实代次)
                || 旧选择读取.目标状态->身份 != 请求.当前状态
                || 旧选择读取.目标状态->特征类型
                    != 实例读取.特征实例->特征定义
                || !旧载荷
                || 旧载荷->任务轮次序号 != 请求.任务轮次序号
                || 旧载荷->发生时间 != 请求.当前阶段发生时间)
                return 形成写入失败(任务阶段写入种类::阶段迁移,
                    任务阶段结构状态::引用冲突);

            const auto 状态写入 = 状态服务_.新增中性状态_v1({
                请求.请求头, L2中性状态动态合同版本_v1, 请求.幂等身份,
                L2中性材料类别_v1::实例, 实例读取.特征实例->特征定义,
                形成阶段值材料(请求.目标阶段,
                    任务阶段来源种类::迁移治理动作,
                    请求.任务轮次序号, 请求.来源治理动作),
                {L2中性时间语义_v1::绝对UTC纳秒,
                    static_cast<std::int64_t>(请求.目标阶段发生时间)}});
            if (!状态写入.成功() || !状态写入.状态
                || !状态写入.结果头.变更事实代次)
                return 形成步骤失败(任务阶段写入种类::阶段迁移,
                    映射中性状态(状态写入.结果头.状态), 状态写入.结果头);
            if (!阶段状态绑定(*状态写入.状态,
                    实例读取.特征实例->特征定义, 请求.目标阶段,
                    任务阶段来源种类::迁移治理动作,
                    请求.目标阶段发生时间, 请求.任务轮次序号,
                    请求.来源治理动作))
                return 形成步骤失败(任务阶段写入种类::阶段迁移,
                    任务阶段结构状态::内部不一致, 状态写入.结果头);

            const auto 动态写入 = 动态服务_.新增中性动态_v1({
                {L2结构合同版本, *状态写入.结果头.变更事实代次},
                L2中性状态动态合同版本_v1, 请求.幂等身份,
                L2中性材料类别_v1::实例,
                {请求.当前状态, 状态写入.状态->身份}});
            if (!动态写入.成功() || !动态写入.动态
                || !动态写入.结果头.变更事实代次)
                return 形成步骤失败(任务阶段写入种类::阶段迁移,
                    映射中性状态(动态写入.结果头.状态),
                    状态写入.结果头, 动态写入.结果头);

            const auto 引用写入 = 状态服务_.设置中性状态当前选择_v1({
                {L2结构合同版本, *动态写入.结果头.变更事实代次},
                L2中性状态动态合同版本_v1, 请求.幂等身份,
                请求.任务正式存在.值, 请求.阶段特征实例.值,
                请求.旧当前选择.身份, 状态写入.状态->身份});
            if (!引用写入.成功() || !引用写入.当前引用
                || !引用写入.已退出旧当前选择
                || !引用写入.结果头.变更事实代次)
                return 形成步骤失败(任务阶段写入种类::阶段迁移,
                    映射中性状态(引用写入.结果头.状态),
                    状态写入.结果头, 动态写入.结果头,
                    引用写入.结果头);

            const auto 读回 = 状态服务_.读取中性状态当前选择_v1({
                {L2结构合同版本, 引用写入.结果头.事实截止代次},
                L2中性状态动态合同版本_v1, L2读取类别::当前,
                请求.任务正式存在.值, 请求.阶段特征实例.值, 0});
            if (!读回.成功() || !读回.引用 || !读回.目标状态
                || *读回.引用 != *引用写入.当前引用
                || 读回.目标状态->身份 != 状态写入.状态->身份
                || !阶段状态绑定(*读回.目标状态,
                    实例读取.特征实例->特征定义, 请求.目标阶段,
                    任务阶段来源种类::迁移治理动作,
                    请求.目标阶段发生时间, 请求.任务轮次序号,
                    请求.来源治理动作))
                return 形成步骤失败(任务阶段写入种类::阶段迁移,
                    映射中性状态(读回.结果头.状态),
                    状态写入.结果头, 动态写入.结果头,
                    引用写入.结果头);

            任务阶段写入结果 结果;
            结果.写入种类 = 任务阶段写入种类::阶段迁移;
            结果.状态 = 中性写入为精确重复(状态写入.结果头)
                    && 中性写入为精确重复(动态写入.结果头)
                    && 中性写入为精确重复(引用写入.结果头)
                ? 任务阶段结构状态::精确重复 : 任务阶段结构状态::已形成;
            结果.迁移证据 = 任务阶段迁移证据{
                *读回.目标状态, *动态写入.动态, *读回.引用,
                *引用写入.已退出旧当前选择,
                *状态写入.结果头.变更事实代次,
                *动态写入.结果头.变更事实代次,
                *引用写入.结果头.变更事实代次};
            结果.本次正式读回截止 = 读回.结果头.事实截止代次;
            return 结果.成功() ? 结果 : 形成步骤失败(
                任务阶段写入种类::阶段迁移,
                任务阶段结构状态::内部不一致,
                状态写入.结果头, 动态写入.结果头, 引用写入.结果头);
        } catch (const std::bad_alloc&) {
            return 形成写入失败(任务阶段写入种类::阶段迁移,
                任务阶段结构状态::资源失败);
        } catch (const std::length_error&) {
            return 形成写入失败(任务阶段写入种类::阶段迁移,
                任务阶段结构状态::资源失败);
        } catch (...) {
            return 形成写入失败(任务阶段写入种类::阶段迁移,
                任务阶段结构状态::内部不一致);
        }
    }

    任务阶段当前读取结果 读取当前阶段(
        const 任务阶段当前读取请求& 请求) const noexcept override {
        using namespace 任务阶段结构消费内部;
        任务阶段当前读取结果 结果;
        if (!任务阶段当前读取请求有效(请求)) {
            结果.状态 = 任务阶段结构状态::入口拒绝;
            return 结果;
        }
        try {
            const auto 实例读取 = 特征服务_.读取完整特征实例({
                请求.请求头, L2读取类别::当前, 请求.阶段特征实例, 0});
            if (实例读取.结果头.状态 != L2结构状态::已读取
                || !实例读取.特征实例) {
                结果.状态 = 映射特征状态(实例读取.结果头.状态);
                return 结果;
            }
            if (!特征实例绑定(*实例读取.特征实例, 请求.任务正式存在,
                    请求.阶段特征实例, 请求.请求头.期望事实代次)) {
                结果.状态 = 任务阶段结构状态::引用冲突;
                return 结果;
            }
            const auto 读取 = 状态服务_.读取中性状态当前选择_v1({
                请求.请求头, L2中性状态动态合同版本_v1,
                L2读取类别::当前, 请求.任务正式存在.值,
                请求.阶段特征实例.值, 0});
            结果.提供者结果头 = 读取.结果头;
            结果.本次正式读回截止 = 读取.结果头.事实截止代次;
            结果.状态 = 映射中性状态(读取.结果头.状态);
            if (!读取.成功() || !读取.引用 || !读取.目标状态)
                return 结果;
            if (!当前选择绑定(*读取.引用, 请求.任务正式存在,
                    请求.阶段特征实例, 读取.目标状态->身份,
                    请求.请求头.期望事实代次)
                || 读取.目标状态->特征类型
                    != 实例读取.特征实例->特征定义
                || !解码任务阶段中性状态_v2(*读取.目标状态)) {
                结果.状态 = 任务阶段结构状态::引用冲突;
                结果.当前选择.reset();
                结果.当前状态.reset();
                return 结果;
            }
            结果.状态 = 任务阶段结构状态::已读取;
            结果.当前选择 = *读取.引用;
            结果.当前状态 = *读取.目标状态;
            return 结果.成功() ? 结果 : 任务阶段当前读取结果{};
        } catch (const std::bad_alloc&) {
            结果.状态 = 任务阶段结构状态::资源失败;
            return 结果;
        } catch (const std::length_error&) {
            结果.状态 = 任务阶段结构状态::资源失败;
            return 结果;
        } catch (...) {
            结果.状态 = 任务阶段结构状态::内部不一致;
            return 结果;
        }
    }

    任务阶段历史读取结果 读取历史阶段(
        const 任务阶段历史读取请求& 请求) const noexcept override {
        using namespace 任务阶段结构消费内部;
        任务阶段历史读取结果 结果;
        结果.历史截止事实代次 = 请求.历史截止事实代次;
        if (!任务阶段历史读取请求有效(请求)) {
            结果.状态 = 任务阶段结构状态::入口拒绝;
            return 结果;
        }
        try {
            const auto 实例读取 = 特征服务_.读取完整特征实例({
                请求.请求头, L2读取类别::历史, 请求.阶段特征实例,
                请求.历史截止事实代次});
            if (实例读取.结果头.状态 != L2结构状态::已读取
                || !实例读取.特征实例) {
                结果.状态 = 映射特征状态(实例读取.结果头.状态);
                return 结果;
            }
            if (!特征实例绑定(*实例读取.特征实例, 请求.任务正式存在,
                    请求.阶段特征实例, 请求.历史截止事实代次)) {
                结果.状态 = 任务阶段结构状态::引用冲突;
                return 结果;
            }
            const auto 读取 = 状态服务_.读取中性状态当前选择_v1({
                请求.请求头, L2中性状态动态合同版本_v1,
                L2读取类别::历史, 请求.任务正式存在.值,
                请求.阶段特征实例.值, 请求.历史截止事实代次});
            结果.提供者结果头 = 读取.结果头;
            结果.本次正式读回截止 = 读取.结果头.事实截止代次;
            if (读取.结果头.状态 == L2中性结构状态_v1::未找到) {
                结果.状态 = 任务阶段结构状态::已读取空集;
                return 结果.成功() ? 结果 : 任务阶段历史读取结果{};
            }
            结果.状态 = 映射中性状态(读取.结果头.状态);
            if (!读取.成功() || !读取.引用 || !读取.目标状态)
                return 结果;
            if (!当前选择绑定(*读取.引用, 请求.任务正式存在,
                    请求.阶段特征实例, 读取.目标状态->身份,
                    请求.历史截止事实代次)
                || 读取.目标状态->特征类型
                    != 实例读取.特征实例->特征定义
                || !解码任务阶段中性状态_v2(*读取.目标状态)) {
                结果.状态 = 任务阶段结构状态::引用冲突;
                return 结果;
            }
            结果.状态 = 任务阶段结构状态::已读取;
            结果.当前选择 = *读取.引用;
            结果.状态事实 = *读取.目标状态;
            return 结果.成功() ? 结果 : 任务阶段历史读取结果{};
        } catch (const std::bad_alloc&) {
            结果.状态 = 任务阶段结构状态::资源失败;
            return 结果;
        } catch (const std::length_error&) {
            结果.状态 = 任务阶段结构状态::资源失败;
            return 结果;
        } catch (...) {
            结果.状态 = 任务阶段结构状态::内部不一致;
            return 结果;
        }
    }

private:
    L2特征结构服务& 特征服务_;
    L2状态结构服务& 状态服务_;
    L2动态结构服务& 动态服务_;
};

} // namespace 海中鱼巣
