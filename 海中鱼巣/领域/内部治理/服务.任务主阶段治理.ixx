namespace 海中鱼巣::任务主阶段治理内部 {

template <class 状态类型>
任务后继消费状态 映射Task状态(状态类型 状态) noexcept {
    switch (状态) {
    case 状态类型::入口拒绝: return 任务后继消费状态::入口拒绝;
    case 状态类型::许可拒绝: return 任务后继消费状态::许可拒绝;
    case 状态类型::当前性漂移: return 任务后继消费状态::当前性漂移;
    case 状态类型::幂等冲突: return 任务后继消费状态::幂等冲突;
    case 状态类型::引用冲突: return 任务后继消费状态::引用冲突;
    case 状态类型::资源失败: return 任务后继消费状态::资源失败;
    case 状态类型::已可能发布: return 任务后继消费状态::已可能发布;
    default: return 任务后继消费状态::内部不一致;
    }
}

任务后继消费状态 映射决议读取状态(
    自我任务后继决议状态 状态) noexcept {
    switch (状态) {
    case 自我任务后继决议状态::未找到:
        return 任务后继消费状态::决议未找到;
    case 自我任务后继决议状态::入口拒绝:
        return 任务后继消费状态::入口拒绝;
    case 自我任务后继决议状态::许可拒绝:
        return 任务后继消费状态::许可拒绝;
    case 自我任务后继决议状态::当前性漂移:
        return 任务后继消费状态::当前性漂移;
    case 自我任务后继决议状态::幂等冲突:
        return 任务后继消费状态::幂等冲突;
    case 自我任务后继决议状态::资源失败:
        return 任务后继消费状态::资源失败;
    case 自我任务后继决议状态::已可能发布:
        return 任务后继消费状态::已可能发布;
    default:
        return 任务后继消费状态::内部不一致;
    }
}

任务后继消费状态 映射阶段状态(任务阶段结构状态 状态) noexcept {
    switch (状态) {
    case 任务阶段结构状态::入口拒绝:
        return 任务后继消费状态::入口拒绝;
    case 任务阶段结构状态::许可拒绝:
        return 任务后继消费状态::许可拒绝;
    case 任务阶段结构状态::当前性漂移:
    case 任务阶段结构状态::已有当前选择:
    case 任务阶段结构状态::待迁移:
        return 任务后继消费状态::当前性漂移;
    case 任务阶段结构状态::幂等冲突:
        return 任务后继消费状态::幂等冲突;
    case 任务阶段结构状态::引用冲突:
        return 任务后继消费状态::引用冲突;
    case 任务阶段结构状态::资源失败:
        return 任务后继消费状态::资源失败;
    case 任务阶段结构状态::已可能发布:
        return 任务后继消费状态::已可能发布;
    default:
        return 任务后继消费状态::内部不一致;
    }
}

bool 当前选择引用相同(const L2中性状态引用事实_v1& 左,
    const L2中性状态引用事实_v1& 右) noexcept {
    return 左 == 右;
}

bool task继续结果成功等价(const L2任务后继继续写入结果& 结果) noexcept {
    return (结果.状态 == L2任务后继继续状态::已形成
            || 结果.状态 == L2任务后继继续状态::精确重复)
        && 结果.新任务轮次 && 结果.新筹办轮次
        && 结果.继续治理动作 && 结果.决议引用
        && !结果.提交见证 && 结果.本次正式读回截止 != 0
        && L2任务轮次事实完整(*结果.新任务轮次)
        && L2任务筹办轮次权威记录事实完整(*结果.新筹办轮次)
        && L2任务治理动作调用事实完整(*结果.继续治理动作)
        && L2任务后继决议引用事实完整(*结果.决议引用);
}

bool 阶段当前读取成功等价(const 任务阶段当前读取结果& 结果) noexcept {
    return 结果.成功();
}

bool 阶段写入结果成功等价(const 任务阶段写入结果& 结果) noexcept {
    return 结果.成功();
}

任务主阶段治理状态 映射当前任务轮次状态(
    L2按任务读取当前任务与轮次状态 状态) noexcept {
    switch (状态) {
    case L2按任务读取当前任务与轮次状态::任务未找到:
    case L2按任务读取当前任务与轮次状态::当前轮次未找到:
    case L2按任务读取当前任务与轮次状态::事实代次漂移:
        return 任务主阶段治理状态::当前性漂移;
    case L2按任务读取当前任务与轮次状态::入口拒绝:
        return 任务主阶段治理状态::入口拒绝;
    case L2按任务读取当前任务与轮次状态::许可拒绝:
        return 任务主阶段治理状态::许可拒绝;
    case L2按任务读取当前任务与轮次状态::引用冲突:
        return 任务主阶段治理状态::引用冲突;
    case L2按任务读取当前任务与轮次状态::资源失败:
        return 任务主阶段治理状态::资源失败;
    default:
        return 任务主阶段治理状态::内部不一致;
    }
}

任务主阶段治理状态 映射治理动作统一读取状态(
    L2任务治理动作统一读取状态_v2 状态) noexcept {
    switch (状态) {
    case L2任务治理动作统一读取状态_v2::入口拒绝:
        return 任务主阶段治理状态::入口拒绝;
    case L2任务治理动作统一读取状态_v2::许可拒绝:
        return 任务主阶段治理状态::许可拒绝;
    case L2任务治理动作统一读取状态_v2::当前性漂移:
        return 任务主阶段治理状态::当前性漂移;
    case L2任务治理动作统一读取状态_v2::未找到:
    case L2任务治理动作统一读取状态_v2::动作合同不支持:
    case L2任务治理动作统一读取状态_v2::多义:
    case L2任务治理动作统一读取状态_v2::引用冲突:
        return 任务主阶段治理状态::引用冲突;
    case L2任务治理动作统一读取状态_v2::资源失败:
        return 任务主阶段治理状态::资源失败;
    default:
        return 任务主阶段治理状态::内部不一致;
    }
}

任务主阶段治理状态 映射主阶段读取状态(
    任务阶段结构状态 状态) noexcept {
    switch (状态) {
    case 任务阶段结构状态::已读取空集:
    case 任务阶段结构状态::待迁移:
        return 任务主阶段治理状态::阶段待迁移;
    case 任务阶段结构状态::入口拒绝:
        return 任务主阶段治理状态::入口拒绝;
    case 任务阶段结构状态::许可拒绝:
        return 任务主阶段治理状态::许可拒绝;
    case 任务阶段结构状态::当前性漂移:
        return 任务主阶段治理状态::当前性漂移;
    case 任务阶段结构状态::幂等冲突:
        return 任务主阶段治理状态::幂等冲突;
    case 任务阶段结构状态::引用冲突:
        return 任务主阶段治理状态::引用冲突;
    case 任务阶段结构状态::资源失败:
        return 任务主阶段治理状态::资源失败;
    case 任务阶段结构状态::已可能发布:
        return 任务主阶段治理状态::已可能发布;
    default:
        return 任务主阶段治理状态::内部不一致;
    }
}

任务主阶段治理状态 映射主阶段写入状态(
    任务阶段结构状态 状态) noexcept {
    switch (状态) {
    case 任务阶段结构状态::入口拒绝:
        return 任务主阶段治理状态::入口拒绝;
    case 任务阶段结构状态::许可拒绝:
        return 任务主阶段治理状态::许可拒绝;
    case 任务阶段结构状态::当前性漂移:
    case 任务阶段结构状态::已有当前选择:
    case 任务阶段结构状态::待迁移:
        return 任务主阶段治理状态::当前性漂移;
    case 任务阶段结构状态::幂等冲突:
        return 任务主阶段治理状态::幂等冲突;
    case 任务阶段结构状态::引用冲突:
        return 任务主阶段治理状态::引用冲突;
    case 任务阶段结构状态::资源失败:
        return 任务主阶段治理状态::资源失败;
    case 任务阶段结构状态::已可能发布:
        return 任务主阶段治理状态::已可能发布;
    default:
        return 任务主阶段治理状态::内部不一致;
    }
}

任务主阶段治理状态 映射筹办状态(
    任务筹办当前就绪结论 结论) noexcept {
    switch (结论) {
    case 任务筹办当前就绪结论::当前性漂移:
        return 任务主阶段治理状态::当前性漂移;
    case 任务筹办当前就绪结论::引用冲突:
        return 任务主阶段治理状态::引用冲突;
    case 任务筹办当前就绪结论::资源失败:
        return 任务主阶段治理状态::资源失败;
    default:
        return 任务主阶段治理状态::内部不一致;
    }
}

bool 合法筹办等待(任务筹办当前就绪结论 结论) noexcept {
    return 结论 == 任务筹办当前就绪结论::条件未满足
        || 结论 == 任务筹办当前就绪结论::输入待绑定
        || 结论 == 任务筹办当前就绪结论::限制待解释
        || 结论 == 任务筹办当前就绪结论::方法结构待补齐
        || 结论 == 任务筹办当前就绪结论::数量预算不足;
}

任务主阶段治理状态 映射后继状态(任务后继消费状态 状态) noexcept {
    switch (状态) {
    case 任务后继消费状态::决议未找到:
        return 任务主阶段治理状态::后继决议未找到;
    case 任务后继消费状态::决议不适用:
        return 任务主阶段治理状态::后继决议不适用;
    case 任务后继消费状态::入口拒绝:
        return 任务主阶段治理状态::入口拒绝;
    case 任务后继消费状态::许可拒绝:
        return 任务主阶段治理状态::许可拒绝;
    case 任务后继消费状态::当前性漂移:
        return 任务主阶段治理状态::当前性漂移;
    case 任务后继消费状态::幂等冲突:
        return 任务主阶段治理状态::幂等冲突;
    case 任务后继消费状态::引用冲突:
        return 任务主阶段治理状态::引用冲突;
    case 任务后继消费状态::资源失败:
        return 任务主阶段治理状态::资源失败;
    case 任务后继消费状态::已可能发布:
        return 任务主阶段治理状态::已可能发布;
    default:
        return 任务主阶段治理状态::内部不一致;
    }
}

bool 主阶段请求基本有效(const 任务主阶段治理请求& 请求) noexcept {
    return 请求.合同版本 == 任务主阶段治理合同版本
        && L2结构请求头合同有效(请求.请求头)
        && 请求.请求头.期望事实代次 != 0
        && 有效(请求.任务.值) && 有效(请求.当前任务轮次.值)
        && 有效(请求.任务正式存在.值) && 有效(请求.阶段特征实例.值)
        && 任务阶段值有效(请求.期望阶段);
}

bool 分支材料形状有效(const 任务主阶段治理请求& 请求) noexcept {
    const bool 有筹办 = 请求.筹办请求.has_value();
    const bool 有等待迁移 = 请求.转入筹办等待材料.has_value();
    const bool 有冻结迁移 = 请求.转入可执行已冻结材料.has_value();
    const bool 有后继 = 请求.后继消费请求.has_value();
    switch (请求.期望阶段.状态段) {
    case 任务业务状态段::筹办中:
        return 有筹办 && 有等待迁移 && 有冻结迁移 && !有后继;
    case 任务业务状态段::筹办等待:
        return 有筹办 && !有等待迁移 && 有冻结迁移 && !有后继;
    case 任务业务状态段::轮次已收束待自我决议:
        return !有筹办 && !有等待迁移 && !有冻结迁移 && 有后继;
    default:
        return !有筹办 && !有等待迁移 && !有冻结迁移 && !有后继;
    }
}

struct 已解码阶段 final {
    任务阶段值 阶段;
    任务阶段来源种类 来源种类 = 任务阶段来源种类::无效;
    std::uint64_t 当前阶段发生时间 = 0;
    std::uint64_t 任务轮次序号 = 0;
    稳定编码 来源;
};

std::optional<已解码阶段> 解码当前阶段(
    const 任务阶段当前读取结果& 读取) noexcept {
    if (!阶段当前读取成功等价(读取) || !读取.当前状态)
        return std::nullopt;
    const auto 载荷 = 解码任务阶段中性状态_v2(*读取.当前状态);
    return 载荷 ? std::optional<已解码阶段>{已解码阶段{
        载荷->阶段, 载荷->来源种类, 载荷->发生时间,
        载荷->任务轮次序号, 载荷->来源}} : std::nullopt;
}

bool 筹办请求绑定主请求(const 任务筹办当前就绪请求_v2& 筹办,
    const 任务主阶段治理请求& 请求,
    const L2任务轮次事实& 当前轮次) noexcept {
    return 筹办.合同版本 == 任务筹办当前就绪合同版本_v2
        && 筹办.请求头 == 请求.请求头
        && 筹办.任务 == 请求.任务
        && 筹办.任务轮次 == 请求.当前任务轮次
        && 当前轮次.身份 == 请求.当前任务轮次;
}

任务阶段迁移请求 形成主阶段迁移请求(
    const 任务主阶段治理请求& 请求,
    const 任务阶段当前读取结果& 当前,
    const 已解码阶段& 解码,
    const 任务主阶段迁移材料& 材料,
    任务阶段值 目标阶段,
    std::uint64_t 期望事实代次) noexcept {
    任务阶段迁移请求 迁移;
    迁移.合同版本 = 任务阶段结构消费合同版本;
    迁移.请求头 = {L2结构合同版本, 期望事实代次};
    迁移.幂等身份 = 材料.幂等身份;
    迁移.任务正式存在 = 请求.任务正式存在;
    迁移.阶段特征实例 = 请求.阶段特征实例;
    迁移.当前状态 = 当前.当前状态->身份;
    迁移.旧当前选择 = *当前.当前选择;
    迁移.目标阶段 = 目标阶段;
    迁移.来源治理动作 = 材料.来源治理动作;
    迁移.任务轮次序号 = 解码.任务轮次序号;
    迁移.当前阶段发生时间 = 解码.当前阶段发生时间;
    迁移.目标阶段发生时间 = 材料.目标阶段发生时间;
    return 迁移;
}

bool 决议在截止有效(const L2自我任务后继决议事实& 决议,
    std::uint64_t 截止) noexcept {
    return 截止 != 0 && 决议.生命周期.创建事实代次 != 0
        && 决议.生命周期.创建事实代次 <= 截止
        && (!决议.生命周期.退出事实代次
            || *决议.生命周期.退出事实代次 > 截止);
}

bool 请求基本有效(const 任务后继消费请求& 请求) noexcept {
    return 请求.合同版本 == 任务后继消费合同版本
        && L2结构请求头合同有效(请求.task请求头)
        && 请求.task请求头.期望事实代次 != 0
        && 有效(请求.自我.值) && 有效(请求.决议身份)
        && 有效(请求.任务.值) && 有效(请求.已收束任务轮次.值)
        && 有效(请求.轮次结算.值)
        && 请求.来源共同事实截止 != 0
        && 请求.发生时间 != 0
        && 请求.规则版本 == 任务后继消费规则版本;
}

bool 决议绑定请求(const L2自我任务后继决议事实& 决议,
    const 任务后继消费请求& 请求) noexcept {
    return 决议.身份 == 请求.决议身份 && 决议.自我 == 请求.自我
        && 决议.任务 == 请求.任务
        && 决议.已收束任务轮次 == 请求.已收束任务轮次
        && 决议.轮次结算 == 请求.轮次结算
        && 决议.来源共同事实截止 == 请求.来源共同事实截止
        && 决议.决议规则版本 == 请求.规则版本
        && 决议在截止有效(决议, 请求.来源共同事实截止);
}

bool 继续请求形状有效(const 任务后继消费请求& 请求) noexcept {
    if (!L2结构幂等身份有效(请求.task写入幂等身份)
        || !L2结构幂等身份有效(请求.阶段迁移幂等身份)
        || 有效(请求.任务运行停止证据.值)
        || 请求.新任务轮次序号 == 0 || 请求.新筹办轮次序号 == 0
        || !请求.继续阶段迁移)
        return false;
    const auto& 迁移 = *请求.继续阶段迁移;
    return 任务阶段迁移请求有效(迁移)
        && 迁移.幂等身份 == 请求.阶段迁移幂等身份
        && 迁移.目标阶段.主阶段 == 任务主阶段::筹办
        && 迁移.目标阶段.状态段 == 任务业务状态段::筹办中;
}

bool 收口请求形状有效(const 任务后继消费请求& 请求) noexcept {
    return L2结构幂等身份有效(请求.task写入幂等身份)
        && !L2结构幂等身份有效(请求.阶段迁移幂等身份)
        && 有效(请求.任务运行停止证据.值)
        && 请求.新任务轮次序号 == 0 && 请求.新筹办轮次序号 == 0
        && !请求.继续阶段迁移;
}

bool 后继消费结果成功等价(const 任务后继消费结果& 结果) noexcept {
    if (结果.合同版本 != 任务后继消费合同版本
        || 结果.task提交见证 || 结果.阶段提交见证)
        return false;
    switch (结果.指令) {
    case 自我任务后继指令::继续当前任务:
        return (结果.状态 == 任务后继消费状态::已继续
                || 结果.状态 == 任务后继消费状态::精确重复)
            && 结果.新任务轮次 && 结果.新筹办轮次
            && 结果.继续治理动作 && 结果.决议引用
            && 结果.阶段迁移证据 && !结果.生命周期收口
            && 结果.task正式读回截止 != 0
            && 结果.阶段正式读回截止 != 0;
    case 自我任务后继指令::结束当前任务:
        return (结果.状态 == 任务后继消费状态::已结束
                || 结果.状态 == 任务后继消费状态::精确重复)
            && !结果.新任务轮次 && !结果.新筹办轮次
            && !结果.继续治理动作 && 结果.决议引用
            && !结果.阶段迁移证据 && 结果.生命周期收口
            && 结果.生命周期收口->种类
                == L2任务生命周期收口种类::正常结束
            && 结果.task正式读回截止 != 0
            && 结果.阶段正式读回截止 == 0;
    case 自我任务后继指令::保持等待:
        return 结果.状态 == 任务后继消费状态::已等待
            && !结果.新任务轮次 && !结果.新筹办轮次
            && !结果.继续治理动作 && !结果.决议引用
            && !结果.阶段迁移证据 && !结果.生命周期收口
            && 结果.task正式读回截止 == 0
            && 结果.阶段正式读回截止 == 0;
    case 自我任务后继指令::取消任务:
        return (结果.状态 == 任务后继消费状态::已取消
                || 结果.状态 == 任务后继消费状态::精确重复)
            && !结果.新任务轮次 && !结果.新筹办轮次
            && !结果.继续治理动作 && 结果.决议引用
            && !结果.阶段迁移证据 && 结果.生命周期收口
            && 结果.生命周期收口->种类
                == L2任务生命周期收口种类::取消收口
            && 结果.task正式读回截止 != 0
            && 结果.阶段正式读回截止 == 0;
    default:
        return false;
    }
}

bool 等待请求形状有效(const 任务后继消费请求& 请求) noexcept {
    return !L2结构幂等身份有效(请求.task写入幂等身份)
        && !L2结构幂等身份有效(请求.阶段迁移幂等身份)
        && !有效(请求.任务运行停止证据.值)
        && 请求.新任务轮次序号 == 0 && 请求.新筹办轮次序号 == 0
        && !请求.继续阶段迁移;
}

template <class Task结果类型>
bool 继续Task事实绑定(const Task结果类型& 结果,
    const 任务后继消费请求& 请求,
    const L2自我任务后继决议事实& 决议) noexcept {
    if (!结果.新任务轮次 || !结果.新筹办轮次
        || !结果.继续治理动作 || !结果.决议引用
        || 结果.本次正式读回截止 == 0)
        return false;
    const auto& R = *结果.新任务轮次;
    const auto& P = *结果.新筹办轮次;
    const auto& 调用 = *结果.继续治理动作;
    const auto& 引用 = *结果.决议引用;
    return R.任务 == 请求.任务 && R.轮次序号 == 请求.新任务轮次序号
        && P.任务 == 请求.任务 && P.任务轮次 && *P.任务轮次 == R.身份
        && P.正式存在 && P.阶段特征实例
        && 调用.任务 == 请求.任务 && 调用.任务轮次 == R.身份
        && 调用.筹办轮次 == P.身份
        && 引用.任务 == 请求.任务
        && 引用.已收束任务轮次 == 请求.已收束任务轮次
        && 引用.自我后继决议 == 决议.身份
        && 引用.指令 == 自我任务后继指令::继续当前任务;
}

template <class Task结果类型>
bool 收口Task事实绑定(const Task结果类型& 结果,
    const 任务后继消费请求& 请求,
    const L2自我任务后继决议事实& 决议,
    L2任务生命周期收口种类 种类) noexcept {
    if (!结果.决议引用 || !结果.生命周期收口
        || 结果.本次正式读回截止 == 0)
        return false;
    const auto& 引用 = *结果.决议引用;
    const auto& 收口 = *结果.生命周期收口;
    return 引用.任务 == 请求.任务
        && 引用.已收束任务轮次 == 请求.已收束任务轮次
        && 引用.自我后继决议 == 决议.身份 && 引用.指令 == 决议.指令
        && 收口.种类 == 种类 && 收口.任务 == 请求.任务
        && 收口.已收束任务轮次 == 请求.已收束任务轮次
        && 收口.轮次结算 == 请求.轮次结算
        && 收口.自我后继决议 == 决议.身份
        && 收口.任务运行停止证据 == 请求.任务运行停止证据
        && 收口.发生时间 == 请求.发生时间
        && 收口.规则版本 == 请求.规则版本;
}

bool 主阶段共同结果形状有效(const 任务主阶段治理结果& 结果) noexcept {
    if (结果.合同版本 != 任务主阶段治理合同版本
        || !结果.任务事实 || !结果.当前任务轮次事实
        || !结果.当前阶段 || !结果.当前阶段读回
        || 结果.共同选择事实截止 == 0)
        return false;
    if (!任务阶段值有效(*结果.当前阶段)
        || 结果.当前任务轮次事实->任务 != 结果.任务事实->身份
        || !L2任务轮次事实完整(*结果.当前任务轮次事实))
        return false;
    return 结果.当前阶段读回->成功()
        && 结果.当前阶段读回->本次正式读回截止
            == 结果.共同选择事实截止;
}

bool 主阶段只选择结果形状有效(const 任务主阶段治理结果& 结果) noexcept {
    if (结果.筹办结果 || 结果.阶段迁移结果 || 结果.后继消费结果)
        return false;
    const auto 阶段 = 结果.当前阶段->状态段;
    return 阶段 == 任务业务状态段::待初次筹办
        || 阶段 == 任务业务状态段::可执行已冻结
        || 阶段 == 任务业务状态段::待自我现实执行授权
        || 阶段 == 任务业务状态段::执行动作中
        || 阶段 == 任务业务状态段::执行结果待结算
        || 阶段 == 任务业务状态段::任务轮次结算中;
}

bool 主阶段筹办冻结结果形状有效(const 任务主阶段治理结果& 结果) noexcept {
    if (!结果.筹办结果 || !结果.阶段迁移结果 || 结果.后继消费结果)
        return false;
    return 结果.筹办结果->结论 == 任务筹办当前就绪结论::已就绪
        && 结果.筹办结果->共同事实截止 == 结果.共同选择事实截止
        && 阶段写入结果成功等价(*结果.阶段迁移结果)
        && 结果.阶段迁移结果->本次正式读回截止
            >= 结果.共同选择事实截止;
}

bool 主阶段筹办等待结果形状有效(const 任务主阶段治理结果& 结果) noexcept {
    if (!结果.筹办结果
        || 结果.筹办结果->共同事实截止 != 结果.共同选择事实截止
        || 结果.后继消费结果)
        return false;
    const auto 结论 = 结果.筹办结果->结论;
    const bool 合法等待 = 结论 == 任务筹办当前就绪结论::条件未满足
        || 结论 == 任务筹办当前就绪结论::输入待绑定
        || 结论 == 任务筹办当前就绪结论::限制待解释
        || 结论 == 任务筹办当前就绪结论::方法结构待补齐
        || 结论 == 任务筹办当前就绪结论::数量预算不足;
    if (!合法等待) return false;
    if (结果.当前阶段->状态段 == 任务业务状态段::筹办等待)
        return !结果.阶段迁移结果;
    return 结果.当前阶段->状态段 == 任务业务状态段::筹办中
        && 结果.阶段迁移结果
        && 阶段写入结果成功等价(*结果.阶段迁移结果);
}

bool 主阶段后继结果形状有效(const 任务主阶段治理结果& 结果) noexcept {
    return !结果.筹办结果 && !结果.阶段迁移结果
        && 结果.后继消费结果 && 结果.后继消费结果->成功()
        && 结果.当前阶段->状态段
            == 任务业务状态段::轮次已收束待自我决议;
}

bool 主阶段治理结果成功(const 任务主阶段治理结果& 结果) noexcept {
    if (!主阶段共同结果形状有效(结果)) return false;
    switch (结果.状态) {
    case 任务主阶段治理状态::已选择阶段:
        return 主阶段只选择结果形状有效(结果);
    case 任务主阶段治理状态::筹办已冻结:
        return 主阶段筹办冻结结果形状有效(结果);
    case 任务主阶段治理状态::筹办已等待:
        return 主阶段筹办等待结果形状有效(结果);
    case 任务主阶段治理状态::后继已消费:
        return 主阶段后继结果形状有效(结果);
    default:
        return false;
    }
}

} // namespace 海中鱼巣::任务主阶段治理内部

export namespace 海中鱼巣 {

bool 任务后继消费结果::成功() const noexcept {
    if (合同版本 != 任务后继消费合同版本 || task提交见证 || 阶段提交见证)
        return false;
    const bool 无新轮次 = !新任务轮次 && !新筹办轮次 && !继续治理动作;
    const bool 无阶段迁移 = !阶段迁移证据 && 阶段正式读回截止 == 0;
    switch (指令) {
    case 自我任务后继指令::继续当前任务:
        return (状态 == 任务后继消费状态::已继续
                || 状态 == 任务后继消费状态::精确重复)
            && 新任务轮次 && 新筹办轮次 && 继续治理动作 && 决议引用
            && 阶段迁移证据 && !生命周期收口
            && task正式读回截止 != 0 && 阶段正式读回截止 != 0;
    case 自我任务后继指令::结束当前任务:
        return (状态 == 任务后继消费状态::已结束
                || 状态 == 任务后继消费状态::精确重复)
            && 无新轮次 && 决议引用 && 无阶段迁移 && 生命周期收口
            && 生命周期收口->种类 == L2任务生命周期收口种类::正常结束
            && task正式读回截止 != 0;
    case 自我任务后继指令::保持等待:
        return 状态 == 任务后继消费状态::已等待
            && 无新轮次 && !决议引用 && 无阶段迁移 && !生命周期收口
            && task正式读回截止 == 0;
    case 自我任务后继指令::取消任务:
        return (状态 == 任务后继消费状态::已取消
                || 状态 == 任务后继消费状态::精确重复)
            && 无新轮次 && 决议引用 && 无阶段迁移 && 生命周期收口
            && 生命周期收口->种类 == L2任务生命周期收口种类::取消收口
            && task正式读回截止 != 0;
    default:
        return false;
    }
}

bool 任务主阶段治理结果::成功() const noexcept {
    return 任务主阶段治理内部::主阶段治理结果成功(*this);
}

class 任务主阶段治理提供者 final {
public:
    任务主阶段治理提供者(
        L2任务结构服务& 任务结构服务,
        任务筹办当前就绪与执行冻结提供者& 筹办提供者,
        自我任务后继决议提供者& 自我后继决议提供者,
        任务阶段结构消费端口& 阶段端口) noexcept;

    任务主阶段治理结果 治理当前任务阶段(
        const 任务主阶段治理请求& 请求) noexcept;

    任务后继消费结果 消费自我任务后继决议(
        const 任务后继消费请求& 请求) noexcept;

private:
    任务后继消费结果 消费继续决议(
        const 任务后继消费请求& 请求,
        const L2自我任务后继决议事实& 决议) noexcept;

    任务后继消费结果 消费收口决议(
        const 任务后继消费请求& 请求,
        const L2自我任务后继决议事实& 决议,
        L2任务生命周期收口种类 种类) noexcept;

    L2任务结构服务& 任务结构服务_;
    任务筹办当前就绪与执行冻结提供者& 筹办提供者_;
    自我任务后继决议提供者& 自我后继决议提供者_;
    任务阶段结构消费端口& 阶段端口_;
};

} // namespace 海中鱼巣

module :private;

namespace 海中鱼巣 {

任务主阶段治理提供者::任务主阶段治理提供者(
    L2任务结构服务& 任务结构服务,
    任务筹办当前就绪与执行冻结提供者& 筹办提供者,
    自我任务后继决议提供者& 自我后继决议提供者,
    任务阶段结构消费端口& 阶段端口) noexcept
    : 任务结构服务_(任务结构服务), 筹办提供者_(筹办提供者),
      自我后继决议提供者_(自我后继决议提供者), 阶段端口_(阶段端口) {}

任务主阶段治理结果 任务主阶段治理提供者::治理当前任务阶段(
    const 任务主阶段治理请求& 请求) noexcept {
    using namespace 任务主阶段治理内部;
    任务主阶段治理结果 结果;
    if (!主阶段请求基本有效(请求) || !分支材料形状有效(请求)) {
        结果.状态 = 任务主阶段治理状态::入口拒绝;
        return 结果;
    }
    try {
        const auto owner读取 = 任务结构服务_.按任务读取当前任务与轮次({
            L2按任务读取当前任务与轮次合同版本, 请求.请求头, 请求.任务});
        if (!owner读取.成功()) {
            结果.状态 = 映射当前任务轮次状态(owner读取.状态);
            return 结果;
        }
        if (!owner读取.任务 || !owner读取.当前任务轮次
            || owner读取.任务->身份 != 请求.任务
            || owner读取.当前任务轮次->身份 != 请求.当前任务轮次
            || owner读取.当前任务轮次->任务 != 请求.任务
            || owner读取.本次正式读回截止 != 请求.请求头.期望事实代次) {
            结果.状态 = 任务主阶段治理状态::引用冲突;
            return 结果;
        }
        结果.任务事实 = owner读取.任务;
        结果.当前任务轮次事实 = owner读取.当前任务轮次;

        const auto 阶段读取 = 阶段端口_.读取当前阶段({
            任务阶段结构消费合同版本, 请求.请求头,
            请求.任务正式存在, 请求.阶段特征实例});
        结果.当前阶段读回 = 阶段读取;
        if (!阶段当前读取成功等价(阶段读取)) {
            结果.状态 = 映射主阶段读取状态(阶段读取.状态);
            return 结果;
        }
        const auto 解码 = 解码当前阶段(阶段读取);
        if (!解码 || !阶段读取.当前状态 || !阶段读取.当前选择
            || 阶段读取.当前状态->材料类别 != L2中性材料类别_v1::实例
            || 阶段读取.当前状态->时间.语义
                != L2中性时间语义_v1::绝对UTC纳秒
            || 解码->任务轮次序号 != owner读取.当前任务轮次->轮次序号
            || !有效(解码->来源)) {
            结果.状态 = 任务主阶段治理状态::引用冲突;
            return 结果;
        }
        const auto G0 = 请求.请求头.期望事实代次;
        if (阶段读取.当前选择->引用方 != 请求.任务正式存在.值
            || 阶段读取.当前选择->引用角色 != 请求.阶段特征实例.值) {
            结果.状态 = 任务主阶段治理状态::引用冲突;
            return 结果;
        }
        if (解码->来源种类 == 任务阶段来源种类::首态任务轮次) {
            if (解码->来源 != owner读取.当前任务轮次->身份.值) {
                结果.状态 = 任务主阶段治理状态::引用冲突;
                return 结果;
            }
        } else {
            const auto 动作读取 = 任务结构服务_.按身份读取任务治理动作调用_v2({
                L2任务治理动作统一读取合同版本_v2,
                {L2结构合同版本, G0},
                L2任务治理动作调用身份{解码->来源}});
            if (!动作读取.成功()) {
                结果.状态 = 映射治理动作统一读取状态(动作读取.状态);
                return 结果;
            }
            if (!动作读取.治理动作 || 动作读取.本次正式读回截止 != G0) {
                结果.状态 = 任务主阶段治理状态::当前性漂移;
                return 结果;
            }
            const auto& 动作 = *动作读取.治理动作;
            if (动作.身份.值 != 解码->来源
                || 动作.任务 != 请求.任务
                || 动作.任务轮次 != owner读取.当前任务轮次->身份
                || 动作.生命周期.创建事实代次 == 0
                || 动作.生命周期.创建事实代次 > G0
                || (动作.生命周期.退出事实代次
                    && *动作.生命周期.退出事实代次 <= G0)) {
                结果.状态 = 任务主阶段治理状态::引用冲突;
                return 结果;
            }
        }
        结果.当前阶段 = 解码->阶段;
        结果.共同选择事实截止 = G0;
        if (解码->阶段 != 请求.期望阶段) {
            结果.状态 = 任务主阶段治理状态::当前性漂移;
            return 结果;
        }

        switch (解码->阶段.状态段) {
        case 任务业务状态段::待初次筹办:
        case 任务业务状态段::可执行已冻结:
        case 任务业务状态段::待自我现实执行授权:
        case 任务业务状态段::执行动作中:
        case 任务业务状态段::执行结果待结算:
        case 任务业务状态段::任务轮次结算中:
            结果.状态 = 任务主阶段治理状态::已选择阶段;
            return 结果;
        case 任务业务状态段::筹办中:
        case 任务业务状态段::筹办等待: {
            if (!请求.筹办请求
                || !筹办请求绑定主请求(
                    *请求.筹办请求, 请求, *owner读取.当前任务轮次)) {
                结果.状态 = 任务主阶段治理状态::引用冲突;
                return 结果;
            }
            const auto 筹办结果 = 筹办提供者_.形成当前可执行冻结_v2(
                *请求.筹办请求);
            结果.筹办结果 = 筹办结果;
            if (筹办结果.共同事实截止 != 请求.请求头.期望事实代次) {
                结果.状态 = 筹办结果.共同事实截止 == 0
                    ? 映射筹办状态(筹办结果.结论)
                    : 任务主阶段治理状态::当前性漂移;
                return 结果;
            }

            const 任务主阶段迁移材料* 迁移材料 = nullptr;
            任务阶段值 目标阶段;
            std::uint64_t 迁移前截止 = 请求.请求头.期望事实代次;
            任务主阶段治理状态 成功状态 = 任务主阶段治理状态::内部不一致;
            if (筹办结果.结论 == 任务筹办当前就绪结论::已就绪) {
                if (!请求.转入可执行已冻结材料) {
                    结果.状态 = 任务主阶段治理状态::入口拒绝;
                    return 结果;
                }
                迁移材料 = &*请求.转入可执行已冻结材料;
                目标阶段 = {任务主阶段::筹办, 任务业务状态段::可执行已冻结};
                成功状态 = 任务主阶段治理状态::筹办已冻结;
            } else if (合法筹办等待(筹办结果.结论)) {
                if (解码->阶段.状态段 == 任务业务状态段::筹办等待) {
                    结果.状态 = 任务主阶段治理状态::筹办已等待;
                    return 结果;
                }
                if (!请求.转入筹办等待材料) {
                    结果.状态 = 任务主阶段治理状态::入口拒绝;
                    return 结果;
                }
                迁移材料 = &*请求.转入筹办等待材料;
                目标阶段 = {任务主阶段::筹办, 任务业务状态段::筹办等待};
                成功状态 = 任务主阶段治理状态::筹办已等待;
            } else {
                结果.状态 = 映射筹办状态(筹办结果.结论);
                return 结果;
            }
            if (!L2结构幂等身份有效(迁移材料->幂等身份)
                || !有效(迁移材料->来源治理动作)
                || 迁移材料->目标阶段发生时间 == 0) {
                结果.状态 = 任务主阶段治理状态::入口拒绝;
                return 结果;
            }
            const auto 迁移请求 = 形成主阶段迁移请求(
                请求, 阶段读取, *解码, *迁移材料, 目标阶段, 迁移前截止);
            const auto 迁移结果 = 阶段端口_.发布阶段迁移(迁移请求);
            结果.阶段迁移结果 = 迁移结果;
            if (!阶段写入结果成功等价(迁移结果)) {
                结果.状态 = 映射主阶段写入状态(迁移结果.状态);
                return 结果;
            }
            结果.状态 = 成功状态;
            return 结果;
        }
        case 任务业务状态段::轮次已收束待自我决议: {
            const auto 后继 = 消费自我任务后继决议(*请求.后继消费请求);
            结果.后继消费结果 = 后继;
            if (!后继.成功()) {
                结果.状态 = 映射后继状态(后继.状态);
                return 结果;
            }
            结果.状态 = 任务主阶段治理状态::后继已消费;
            return 结果;
        }
        default:
            return 结果;
        }
    } catch (const std::bad_alloc&) {
        结果.状态 = 任务主阶段治理状态::资源失败;
        return 结果;
    } catch (...) {
        结果.状态 = 任务主阶段治理状态::内部不一致;
        return 结果;
    }
}

任务后继消费结果 任务主阶段治理提供者::消费自我任务后继决议(
    const 任务后继消费请求& 请求) noexcept {
    任务后继消费结果 失败;
    if (!任务主阶段治理内部::请求基本有效(请求)) {
        失败.状态 = 任务后继消费状态::入口拒绝;
        return 失败;
    }
    try {
        const auto 决议读取 = 自我后继决议提供者_.读取自我任务后继决议({
            自我任务后继决议合同版本, 请求.自我, 请求.任务,
            请求.已收束任务轮次, 请求.决议身份,
            请求.来源共同事实截止});
        if (!决议读取.成功() || !决议读取.决议) {
            失败.状态 = 任务主阶段治理内部::映射决议读取状态(
                决议读取.状态);
            return 失败;
        }
        const auto& 决议 = *决议读取.决议;
        失败.指令 = 决议.指令;
        if (!任务主阶段治理内部::决议绑定请求(决议, 请求)) {
            失败.状态 = 任务后继消费状态::决议不适用;
            return 失败;
        }
        switch (决议.指令) {
        case 自我任务后继指令::继续当前任务:
            return 消费继续决议(请求, 决议);
        case 自我任务后继指令::结束当前任务:
            return 消费收口决议(
                请求, 决议, L2任务生命周期收口种类::正常结束);
        case 自我任务后继指令::保持等待:
            if (!任务主阶段治理内部::等待请求形状有效(请求)) {
                失败.状态 = 任务后继消费状态::入口拒绝;
                return 失败;
            }
            失败.状态 = 任务后继消费状态::已等待;
            return 失败;
        case 自我任务后继指令::取消任务:
            return 消费收口决议(
                请求, 决议, L2任务生命周期收口种类::取消收口);
        default:
            失败.状态 = 任务后继消费状态::决议不适用;
            return 失败;
        }
    } catch (const std::bad_alloc&) {
        失败.状态 = 任务后继消费状态::资源失败;
        return 失败;
    } catch (...) {
        失败.状态 = 任务后继消费状态::内部不一致;
        return 失败;
    }
}

任务后继消费结果 任务主阶段治理提供者::消费继续决议(
    const 任务后继消费请求& 请求,
    const L2自我任务后继决议事实& 决议) noexcept {
    任务后继消费结果 结果;
    结果.指令 = 自我任务后继指令::继续当前任务;
    if (!任务主阶段治理内部::继续请求形状有效(请求)) {
        结果.状态 = 任务后继消费状态::入口拒绝;
        return 结果;
    }
    const auto& 迁移 = *请求.继续阶段迁移;
    L2任务后继继续写入请求 task请求;
    task请求.请求头 = 请求.task请求头;
    task请求.幂等身份 = 请求.task写入幂等身份;
    task请求.自我后继决议 = 决议.身份;
    task请求.指令 = 决议.指令;
    task请求.任务 = 请求.任务;
    task请求.已收束任务轮次 = 请求.已收束任务轮次;
    task请求.轮次结算 = 请求.轮次结算;
    task请求.新任务轮次序号 = 请求.新任务轮次序号;
    task请求.新筹办轮次序号 = 请求.新筹办轮次序号;
    task请求.触发前态 = 迁移.当前状态;
    task请求.来源共同事实截止 = 请求.来源共同事实截止;
    task请求.发生时间 = 请求.发生时间;
    task请求.规则版本 = 请求.规则版本;
    const auto task结果 =
        任务结构服务_.写入或读取任务后继继续事实(task请求);
    if (!任务主阶段治理内部::task继续结果成功等价(task结果)) {
        结果.状态 = 任务主阶段治理内部::映射Task状态(task结果.状态);
        if (结果.状态 == 任务后继消费状态::已可能发布)
            结果.task提交见证 = task结果.提交见证;
        return 结果;
    }
    if (!任务主阶段治理内部::继续Task事实绑定(task结果, 请求, 决议)) {
        结果.状态 = 任务后继消费状态::内部不一致;
        return 结果;
    }
    if (!task结果.新筹办轮次->正式存在
        || !task结果.新筹办轮次->阶段特征实例
        || 迁移.任务正式存在 != *task结果.新筹办轮次->正式存在
        || 迁移.阶段特征实例 != *task结果.新筹办轮次->阶段特征实例
        || 迁移.来源治理动作 != task结果.继续治理动作->身份.值
        || 迁移.任务轮次序号 != 请求.新任务轮次序号) {
        结果.状态 = 任务后继消费状态::引用冲突;
        return 结果;
    }
    const auto 当前 = 阶段端口_.读取当前阶段({
        任务阶段结构消费合同版本, 迁移.请求头,
        迁移.任务正式存在, 迁移.阶段特征实例});
    const bool 当前成功 = 任务主阶段治理内部::阶段当前读取成功等价(当前);
    if (!当前成功 || !当前.当前状态 || !当前.当前选择
        || 当前.当前状态->身份 != 迁移.当前状态
        || !任务主阶段治理内部::当前选择引用相同(
            *当前.当前选择, 迁移.旧当前选择)) {
        结果.状态 = 当前成功
            ? 任务后继消费状态::引用冲突
            : 任务主阶段治理内部::映射阶段状态(当前.状态);
        return 结果;
    }
    const auto 阶段结果 = 阶段端口_.发布阶段迁移(迁移);
    if (!任务主阶段治理内部::阶段写入结果成功等价(阶段结果)) {
        结果.状态 = 任务主阶段治理内部::映射阶段状态(阶段结果.状态);
        if (结果.状态 == 任务后继消费状态::已可能发布) {
            结果.新任务轮次 = task结果.新任务轮次;
            结果.新筹办轮次 = task结果.新筹办轮次;
            结果.继续治理动作 = task结果.继续治理动作;
            结果.决议引用 = task结果.决议引用;
            结果.阶段提交见证 = 阶段结果.提交见证;
            结果.task正式读回截止 = task结果.本次正式读回截止;
        }
        return 结果;
    }
    结果.新任务轮次 = task结果.新任务轮次;
    结果.新筹办轮次 = task结果.新筹办轮次;
    结果.继续治理动作 = task结果.继续治理动作;
    结果.决议引用 = task结果.决议引用;
    结果.阶段迁移证据 = 阶段结果.迁移证据;
    结果.task正式读回截止 = task结果.本次正式读回截止;
    结果.阶段正式读回截止 = 阶段结果.本次正式读回截止;
    const bool 双重放 = task结果.状态 == decltype(task结果.状态)::精确重复
        && 阶段结果.状态 == 任务阶段结构状态::精确重复;
    结果.状态 = 双重放
        ? 任务后继消费状态::精确重复
        : 任务后继消费状态::已继续;
    return 任务主阶段治理内部::后继消费结果成功等价(结果) ? 结果 : 任务后继消费结果{
        任务后继消费合同版本, 任务后继消费状态::内部不一致,
        自我任务后继指令::继续当前任务};
}

任务后继消费结果 任务主阶段治理提供者::消费收口决议(
    const 任务后继消费请求& 请求,
    const L2自我任务后继决议事实& 决议,
    L2任务生命周期收口种类 种类) noexcept {
    任务后继消费结果 结果;
    结果.指令 = 决议.指令;
    if (!任务主阶段治理内部::收口请求形状有效(请求)) {
        结果.状态 = 任务后继消费状态::入口拒绝;
        return 结果;
    }
    L2任务生命周期收口写入请求 task请求;
    task请求.请求头 = 请求.task请求头;
    task请求.幂等身份 = 请求.task写入幂等身份;
    task请求.自我后继决议 = 决议.身份;
    task请求.指令 = 决议.指令;
    task请求.种类 = 种类;
    task请求.任务 = 请求.任务;
    task请求.已收束任务轮次 = 请求.已收束任务轮次;
    task请求.轮次结算 = 请求.轮次结算;
    task请求.任务运行停止证据 = 请求.任务运行停止证据;
    task请求.发生时间 = 请求.发生时间;
    task请求.规则版本 = 请求.规则版本;
    const auto task结果 =
        任务结构服务_.写入或读取任务生命周期收口(task请求);
    if (!task结果.成功()) {
        结果.状态 = 任务主阶段治理内部::映射Task状态(task结果.状态);
        if (结果.状态 == 任务后继消费状态::已可能发布)
            结果.task提交见证 = task结果.提交见证;
        return 结果;
    }
    结果.决议引用 = task结果.决议引用;
    结果.生命周期收口 = task结果.生命周期收口;
    结果.task正式读回截止 = task结果.本次正式读回截止;
    if (task结果.状态 == decltype(task结果.状态)::精确重复)
        结果.状态 = 任务后继消费状态::精确重复;
    else
        结果.状态 = 种类 == L2任务生命周期收口种类::正常结束
            ? 任务后继消费状态::已结束
            : 任务后继消费状态::已取消;
    return 任务主阶段治理内部::后继消费结果成功等价(结果) ? 结果 : 任务后继消费结果{
        任务后继消费合同版本, 任务后继消费状态::内部不一致,
        决议.指令};
}

} // namespace 海中鱼巣
