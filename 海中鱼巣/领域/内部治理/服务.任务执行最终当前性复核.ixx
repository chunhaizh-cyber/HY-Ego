module;

#include <cstdint>
#include <algorithm>
#include <new>
#include <optional>
#include <vector>

export module 海中鱼巣.领域.内部治理.服务.任务执行最终当前性复核;

export import 海中鱼巣.领域.内部治理.服务.任务执行派发门控;
import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.组合.运行期只读查询;
import 海中鱼巣.领域.内部治理.服务.任务阶段结构消费端口;
import 海中鱼巣.领域.内部治理.服务.实例方法执行;
import 海中鱼巣.领域.自我治理.服务.自我现实执行授权;
import 海中鱼巣.领域.安全治理.服务.任务现实执行硬否决;

export namespace 海中鱼巣 {

enum class 任务动作前最终证据读取状态 : std::uint8_t {
    已读取 = 1,
    当前性漂移 = 2,
    技术许可拒绝 = 3,
    授权无效 = 4,
    安全硬否决 = 5,
    材料不足 = 6,
    资源失败 = 7,
    内部错误 = 8
};

struct 任务动作前最终证据读取结果 final {
    任务动作前最终证据读取状态 状态 =
        任务动作前最终证据读取状态::材料不足;
    std::optional<任务执行派发门控请求> fresh门控请求;
    std::uint64_t 共同事实截止 = 0;

    bool 成功() const noexcept {
        return 状态 == 任务动作前最终证据读取状态::已读取
            && fresh门控请求.has_value() && 共同事实截止 != 0
            && fresh门控请求->共同事实截止 == 共同事实截止;
    }
};

class 任务动作前最终证据读取端口 {
public:
    virtual ~任务动作前最终证据读取端口() = default;
    virtual 任务动作前最终证据读取结果 读取动作前最终证据(
        const 任务强类型执行请求&) const noexcept = 0;
};

class 任务动作前最终证据读取提供者 final
    : public 任务动作前最终证据读取端口 {
public:
    任务动作前最终证据读取提供者(
        const L1事实基座服务& 第一层服务,
        const 任务阶段结构消费端口& 阶段端口,
        const L2任务结构服务& 任务服务,
        const L2方法结构服务& 方法服务,
        const 运行期只读查询组合器& 运行期只读查询,
        const 实例方法执行提供者& 实例执行,
        const 自我现实执行授权提供者& 授权提供者,
        const 任务现实执行硬否决提供者& 硬否决提供者) noexcept
        : 第一层服务_(第一层服务), 阶段端口_(阶段端口),
          任务服务_(任务服务), 方法服务_(方法服务),
          运行期只读查询_(运行期只读查询), 实例执行_(实例执行),
          授权提供者_(授权提供者), 硬否决提供者_(硬否决提供者) {}

    任务动作前最终证据读取结果 读取动作前最终证据(
        const 任务强类型执行请求& 原请求) const noexcept override {
        if (!任务执行强类型请求基本有效(原请求))
            return 失败(任务动作前最终证据读取状态::材料不足);
        try {
            const auto 当前代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 == L1中性读取状态::资源失败)
                return 失败(任务动作前最终证据读取状态::资源失败);
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 == 0)
                return 失败(任务动作前最终证据读取状态::内部错误);
            const auto Gnow = 当前代次.事实代次;

            // 当前代码没有第二个调度资格权威。只有全局事实代次未发生任何推进时，
            // 原冻结中的控制/调度值式裁决材料才仍是 Gnow 的当前证据；否则硬拒绝。
            if (Gnow != 原请求.派发冻结.共同事实截止)
                return 失败(任务动作前最终证据读取状态::当前性漂移);

            const auto& 原阶段 = 原请求.派发冻结.当前阶段证据;
            const auto 阶段 = 阶段端口_.读取当前阶段({
                任务阶段结构消费合同版本,
                {L2结构合同版本, Gnow},
                原阶段.任务正式存在,
                原阶段.阶段特征实例});
            if (阶段.状态 == 任务阶段结构状态::资源失败)
                return 失败(任务动作前最终证据读取状态::资源失败);
            if (!阶段.成功() || !阶段.当前状态 || !阶段.当前选择
                || 阶段.当前状态->身份 != 原阶段.当前阶段状态
                || 阶段.当前选择->身份 != 原阶段.当前选择
                || 阶段.当前状态->形成事实代次 != 原阶段.状态事实代次
                || 阶段.当前选择->生命周期.创建事实代次
                    != 原阶段.引用事实代次)
                return 失败(任务动作前最终证据读取状态::当前性漂移);
            const auto fresh阶段载荷 =
                解码任务阶段中性状态_v2(*阶段.当前状态);
            if (!fresh阶段载荷 || fresh阶段载荷->阶段 != 原阶段.当前阶段)
                return 失败(任务动作前最终证据读取状态::当前性漂移);

            const auto 实例 = 任务服务_.读取实例方法({
                {L2结构合同版本, Gnow}, L2读取类别::当前,
                原请求.实例方法, 0});
            if (实例.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务动作前最终证据读取状态::资源失败);
            if (!实例.成功() || !实例.实例方法
                || 实例.实例方法->任务 != 原请求.任务
                || 实例.实例方法->身份 != 原请求.实例方法
                || 实例.实例方法->执行轮次 != 原请求.执行轮次.值.值
                || 实例.实例方法->来源方法 != 原请求.方法
                || 实例.实例方法->来源方法内容版本.值
                    != 原请求.方法内容版本.值)
                return 失败(任务动作前最终证据读取状态::当前性漂移);

            std::vector<L2方法动作入口事实_v2> fresh动作入口;
            std::vector<实例方法技术许可见证> fresh许可;
            fresh动作入口.reserve(原请求.完整有序冻结动作范围.size());
            fresh许可.reserve(原请求.完整有序冻结动作范围.size());
            for (const auto& 冻结动作 : 原请求.完整有序冻结动作范围) {
                const auto 动作读取 = 方法服务_.读取方法动作入口_v2({
                    L2方法动作入口合同版本_v2,
                    {L2结构合同版本, Gnow}, 原请求.方法,
                    原请求.方法内容版本, 冻结动作.顺序,
                    冻结动作.稳定动作键});
                if (动作读取.状态 == L2方法动作入口读取状态::资源失败)
                    return 失败(任务动作前最终证据读取状态::资源失败);
                if (!动作读取.成功() || !动作读取.动作入口事实
                    || 动作读取.本次正式读回截止 != Gnow
                    || !动作绑定冻结(*动作读取.动作入口事实, 冻结动作))
                    return 失败(任务动作前最终证据读取状态::当前性漂移);
                fresh动作入口.push_back(*动作读取.动作入口事实);
                实例方法技术许可请求 许可请求{
                    实例方法技术许可合同版本, 原请求.任务,
                    原请求.任务轮次, 原请求.筹办轮次, 原请求.执行轮次,
                    原请求.冻结, 原请求.冻结版本, 原请求.实例方法,
                    原请求.方法, 原请求.方法内容版本,
                    fresh动作入口.back(), 原请求.完整有序冻结动作范围,
                    Gnow};
                const auto 许可 = 实例执行_.读取动作技术许可(许可请求);
                if (许可.状态 == 实例方法技术许可状态::资源失败)
                    return 失败(任务动作前最终证据读取状态::资源失败);
                if (!许可.成功() || !许可.许可见证
                    || 许可.本次正式读回截止 != Gnow)
                    return 失败(任务动作前最终证据读取状态::技术许可拒绝);
                fresh许可.push_back(*许可.许可见证);
            }

            std::optional<L2自我现实执行授权事实> fresh授权;
            if (原请求.适用授权) {
                const auto 授权读取 = 授权提供者_.读取自我现实执行授权({
                    自我现实执行授权合同版本,
                    原请求.适用授权->自我,
                    原请求.任务, 原请求.任务轮次, 原请求.执行轮次,
                    原请求.适用授权->身份, Gnow});
                if (授权读取.状态 == 自我现实执行授权状态::资源失败)
                    return 失败(任务动作前最终证据读取状态::资源失败);
                if (!授权读取.成功() || !授权读取.授权
                    || 授权读取.本次正式读回截止 != Gnow
                    || !授权仍绑定(*授权读取.授权, 原请求, Gnow))
                    return 失败(任务动作前最终证据读取状态::授权无效);
                fresh授权 = *授权读取.授权;
            }

            const auto fresh阶段证据 = 任务执行当前阶段证据{
                原阶段.当前阶段, 原阶段.任务正式存在,
                原阶段.阶段特征实例, 阶段.当前状态->身份,
                阶段.当前选择->身份, 阶段.当前状态->形成事实代次,
                阶段.当前选择->生命周期.创建事实代次, Gnow};
            const auto fresh控制证据 = 任务执行生存控制态证据{
                原请求.派发冻结.控制态证据.控制态,
                原请求.派发冻结.控制态证据.普通任务竞争,
                原请求.派发冻结.控制态证据.来源事实或快照身份,
                原请求.派发冻结.控制态证据.控制态规则版本, Gnow};
            auto fresh调度证据 = 原请求.派发冻结.调度资格证据;
            fresh调度证据.正式读回截止 = Gnow;
            const 任务执行技术许可证据 fresh技术证据{fresh许可, Gnow};

            const auto 自我 = 原请求.适用授权
                ? 原请求.适用授权->自我
                : 原请求.完整有序冻结动作范围.front().作用主体;
            // 旧冻结证据不能重建 fresh 规则全集。完整 FRESH composer 接线前，
            // 现实改变必须以空全集 fail-closed，禁止回退裸编码或规则版本 1。
            const L2任务现实执行硬否决规则全集读取结果_v2 空规则全集;
            auto 授权前请求 = 重建硬否决请求(
                原请求, 自我, 空规则全集, Gnow,
                任务现实执行硬否决复核阶段::授权前预检);
            auto 动作前请求 = 重建硬否决请求(
                原请求, 自我, 空规则全集, Gnow,
                任务现实执行硬否决复核阶段::动作前最终复核);
            const auto 授权前结果 = 硬否决提供者_.复核任务现实执行硬否决(
                授权前请求);
            const auto 动作前结果 = 硬否决提供者_.复核任务现实执行硬否决(
                动作前请求);
            if (授权前结果.状态 == 任务现实执行硬否决状态::资源失败
                || 动作前结果.状态 == 任务现实执行硬否决状态::资源失败)
                return 失败(任务动作前最终证据读取状态::资源失败);
            if (!授权前结果.允许继续() || !动作前结果.允许继续())
                return 失败(任务动作前最终证据读取状态::安全硬否决);

            任务执行派发门控请求 fresh;
            fresh.任务 = 原请求.任务;
            fresh.任务轮次 = 原请求.任务轮次;
            fresh.筹办轮次 = 原请求.筹办轮次;
            fresh.执行轮次 = 原请求.执行轮次;
            fresh.冻结 = 原请求.冻结;
            fresh.冻结版本 = 原请求.冻结版本;
            fresh.实例方法 = 原请求.实例方法;
            fresh.方法 = 原请求.方法;
            fresh.方法内容版本 = 原请求.方法内容版本;
            fresh.完整有序冻结动作范围 = 原请求.完整有序冻结动作范围;
            fresh.当前阶段证据 = fresh阶段证据;
            fresh.控制态证据 = fresh控制证据;
            fresh.调度资格证据 = std::move(fresh调度证据);
            fresh.技术许可证据 = fresh技术证据;
            fresh.适用授权 = std::move(fresh授权);
            fresh.授权前硬否决请求 = std::move(授权前请求);
            fresh.授权前硬否决结果 = 授权前结果;
            fresh.动作前最终硬否决请求 = std::move(动作前请求);
            fresh.动作前最终硬否决结果 = 动作前结果;
            fresh.共同事实截止 = Gnow;
            fresh.派发规则版本 = 原请求.派发冻结.派发规则版本;
            return {任务动作前最终证据读取状态::已读取,
                std::move(fresh), Gnow};
        } catch (const std::bad_alloc&) {
            return 失败(任务动作前最终证据读取状态::资源失败);
        } catch (...) {
            return 失败(任务动作前最终证据读取状态::内部错误);
        }
    }

private:
    static 任务动作前最终证据读取结果 失败(
        任务动作前最终证据读取状态 状态) noexcept {
        return {状态, std::nullopt, 0};
    }

    static bool 动作绑定冻结(const L2方法动作入口事实_v2& 动作,
        const 任务冻结动作项& 冻结) noexcept {
        return 动作.身份 == 冻结.动作入口 && 动作.顺序 == 冻结.顺序
            && 动作.稳定动作键 == 冻结.稳定动作键
            && 动作.作用范围 == 冻结.作用范围
            && 动作.作用主体约束 == 冻结.作用主体
            && 动作.场景约束 == 冻结.作用场景
            && 动作.动作范围材料 == 冻结.动作范围材料
            && 动作.预期结果材料 == 冻结.预期结果材料
            && 动作.结果验证合同 == 冻结.结果验证合同
            && 动作.动作归因合同 == 冻结.动作归因合同
            && !动作.生命周期.退出事实代次;
    }

    static bool 授权仍绑定(const L2自我现实执行授权事实& 授权,
        const 任务强类型执行请求& 请求, std::uint64_t Gnow) noexcept {
        return 授权.任务 == 请求.任务 && 授权.任务轮次 == 请求.任务轮次
            && 授权.筹办轮次 == 请求.筹办轮次
            && 授权.执行轮次 == 请求.执行轮次 && 授权.冻结 == 请求.冻结
            && 授权.冻结版本 == 请求.冻结版本
            && 授权.实例方法 == 请求.实例方法 && 授权.方法 == 请求.方法
            && 授权.方法内容版本.值 == 请求.方法内容版本.值
            && 授权.有序冻结动作范围 == 请求.完整有序冻结动作范围
            && 授权.来源共同事实截止 == Gnow
            && 授权.生命周期.创建事实代次 <= Gnow
            && !授权.生命周期.退出事实代次
            && 授权.有效截止时间 >= 授权.发生时间;
    }

    static 任务现实执行硬否决请求 重建硬否决请求(
        const 任务强类型执行请求& 请求, L2存在身份 自我,
        const L2任务现实执行硬否决规则全集读取结果_v2& 正式规则全集,
        std::uint64_t Gnow,
        任务现实执行硬否决复核阶段 阶段) {
        任务现实执行硬否决请求 结果;
        结果.复核阶段 = 阶段;
        结果.自我 = 自我;
        结果.任务 = 请求.任务;
        结果.任务轮次 = 请求.任务轮次;
        结果.筹办轮次 = 请求.筹办轮次;
        结果.执行轮次 = 请求.执行轮次;
        结果.冻结 = 请求.冻结;
        结果.冻结版本 = 请求.冻结版本;
        结果.实例方法 = 请求.实例方法;
        结果.方法 = 请求.方法;
        结果.方法内容版本 = 稳定编码{请求.方法内容版本.值};
        结果.完整有序冻结动作范围 = 请求.完整有序冻结动作范围;
        结果.现实影响 = std::any_of(
            请求.完整有序冻结动作范围.begin(),
            请求.完整有序冻结动作范围.end(), [](const auto& 动作) {
                return 动作.作用范围 == 任务动作作用范围::现实改变;
            }) ? 任务现实影响分类::含现实改变
               : 任务现实影响分类::零现实改变;
        结果.正式规则全集 = 正式规则全集;
        结果.来源共同事实截止 = Gnow;
        return 结果;
    }

    const L1事实基座服务& 第一层服务_;
    const 任务阶段结构消费端口& 阶段端口_;
    const L2任务结构服务& 任务服务_;
    const L2方法结构服务& 方法服务_;
    const 运行期只读查询组合器& 运行期只读查询_;
    const 实例方法执行提供者& 实例执行_;
    const 自我现实执行授权提供者& 授权提供者_;
    const 任务现实执行硬否决提供者& 硬否决提供者_;
};

enum class 任务执行最终当前性复核状态 : std::uint8_t {
    可执行 = 1,
    当前性漂移 = 2,
    技术许可拒绝 = 3,
    授权无效 = 4,
    安全硬否决 = 5,
    材料不足 = 6,
    资源失败 = 7,
    内部错误 = 8
};

struct 任务执行最终当前性复核结果 final {
    任务执行最终当前性复核状态 状态 =
        任务执行最终当前性复核状态::材料不足;
    std::optional<任务强类型执行请求> 已复核请求;

    bool 成功() const noexcept {
        return 状态 == 任务执行最终当前性复核状态::可执行
            && 已复核请求.has_value();
    }
};

class 任务执行最终当前性复核提供者 final {
public:
    任务执行最终当前性复核提供者(
        const 任务动作前最终证据读取端口& 最终证据读取端口,
        const 任务执行派发门控提供者& 派发门控) noexcept
        : 最终证据读取端口_(最终证据读取端口), 派发门控_(派发门控) {}

    任务执行最终当前性复核结果 复核即将执行的强类型请求(
        const 任务强类型执行请求& 原请求) const noexcept {
        if (!任务执行强类型请求基本有效(原请求))
            return 失败(任务执行最终当前性复核状态::材料不足);
        try {
            const auto fresh = 最终证据读取端口_.读取动作前最终证据(原请求);
            if (!fresh.成功()) return 失败(映射读取状态(fresh.状态));
            const auto& 门控请求 = *fresh.fresh门控请求;
            const auto 门控 = 派发门控_.裁决任务执行派发(门控请求);
            if (!门控.成功() || !门控.派发冻结)
                return 失败(映射门控状态(门控.状态));
            if (!请求绑定保持(原请求, 门控请求, *门控.派发冻结))
                return 失败(任务执行最终当前性复核状态::当前性漂移);

            auto 已复核 = 原请求;
            已复核.派发冻结 = *门控.派发冻结;
            已复核.适用授权 = 门控请求.适用授权;
            任务执行最终当前性复核结果 结果{
                任务执行最终当前性复核状态::可执行, std::move(已复核)};
            return 结果.成功() ? 结果
                : 失败(任务执行最终当前性复核状态::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(任务执行最终当前性复核状态::资源失败);
        } catch (...) {
            return 失败(任务执行最终当前性复核状态::内部错误);
        }
    }

private:
    const 任务动作前最终证据读取端口& 最终证据读取端口_;
    const 任务执行派发门控提供者& 派发门控_;

    static 任务执行最终当前性复核结果 失败(
        任务执行最终当前性复核状态 状态) noexcept {
        return {状态, std::nullopt};
    }

    static 任务执行最终当前性复核状态 映射读取状态(
        任务动作前最终证据读取状态 状态) noexcept {
        switch (状态) {
        case 任务动作前最终证据读取状态::当前性漂移:
            return 任务执行最终当前性复核状态::当前性漂移;
        case 任务动作前最终证据读取状态::技术许可拒绝:
            return 任务执行最终当前性复核状态::技术许可拒绝;
        case 任务动作前最终证据读取状态::授权无效:
            return 任务执行最终当前性复核状态::授权无效;
        case 任务动作前最终证据读取状态::安全硬否决:
            return 任务执行最终当前性复核状态::安全硬否决;
        case 任务动作前最终证据读取状态::资源失败:
            return 任务执行最终当前性复核状态::资源失败;
        case 任务动作前最终证据读取状态::材料不足:
            return 任务执行最终当前性复核状态::材料不足;
        default:
            return 任务执行最终当前性复核状态::内部错误;
        }
    }

    static 任务执行最终当前性复核状态 映射门控状态(
        任务执行派发门控状态 状态) noexcept {
        switch (状态) {
        case 任务执行派发门控状态::当前性漂移:
            return 任务执行最终当前性复核状态::当前性漂移;
        case 任务执行派发门控状态::技术许可拒绝:
            return 任务执行最终当前性复核状态::技术许可拒绝;
        case 任务执行派发门控状态::缺少适用授权:
        case 任务执行派发门控状态::授权无效:
            return 任务执行最终当前性复核状态::授权无效;
        case 任务执行派发门控状态::安全硬否决:
            return 任务执行最终当前性复核状态::安全硬否决;
        case 任务执行派发门控状态::资源失败:
            return 任务执行最终当前性复核状态::资源失败;
        case 任务执行派发门控状态::材料不足:
        case 任务执行派发门控状态::控制态阻断:
        case 任务执行派发门控状态::无调度资格:
            return 任务执行最终当前性复核状态::材料不足;
        default:
            return 任务执行最终当前性复核状态::内部错误;
        }
    }

    static bool 请求绑定保持(const 任务强类型执行请求& 原请求,
        const 任务执行派发门控请求& fresh,
        const 任务执行派发冻结& 新冻结) noexcept {
        if (原请求.任务 != fresh.任务 || 原请求.任务轮次 != fresh.任务轮次
            || 原请求.筹办轮次 != fresh.筹办轮次
            || 原请求.执行轮次 != fresh.执行轮次
            || 原请求.冻结 != fresh.冻结
            || 原请求.冻结版本 != fresh.冻结版本
            || 原请求.实例方法 != fresh.实例方法
            || 原请求.方法 != fresh.方法
            || 原请求.方法内容版本 != fresh.方法内容版本
            || 原请求.完整有序冻结动作范围 != fresh.完整有序冻结动作范围
            || 原请求.执行幂等身份.值 == 0 || 原请求.运行代次 == 0)
            return false;
        if (原请求.适用授权.has_value() != fresh.适用授权.has_value())
            return false;
        if (原请求.适用授权
            && 原请求.适用授权->身份 != fresh.适用授权->身份)
            return false;
        return 新冻结.任务 == 原请求.任务
            && 新冻结.任务轮次 == 原请求.任务轮次
            && 新冻结.筹办轮次 == 原请求.筹办轮次
            && 新冻结.执行轮次 == 原请求.执行轮次
            && 新冻结.冻结 == 原请求.冻结
            && 新冻结.冻结版本 == 原请求.冻结版本
            && 新冻结.实例方法 == 原请求.实例方法
            && 新冻结.方法 == 原请求.方法
            && 新冻结.方法内容版本 == 原请求.方法内容版本
            && 新冻结.共同事实截止 == fresh.共同事实截止;
    }
};

} // namespace 海中鱼巣
