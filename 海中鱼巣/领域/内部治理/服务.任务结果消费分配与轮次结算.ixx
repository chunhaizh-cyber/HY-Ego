module;

#include <algorithm>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.内部治理.服务.任务结果消费分配与轮次结算;

export import 海中鱼巣.领域.服务.L2任务结果消费结构;
export import 海中鱼巣.领域.服务.L2需求结算结构;
export import 海中鱼巣.领域.服务.L2任务结构;
export import 海中鱼巣.领域.内部治理.服务.任务阶段结构消费端口;

export {
#include "任务结果消费分配与轮次结算.数据.h"
}

export namespace 海中鱼巣 {

class 任务结果消费分配与轮次结算提供者 final {
public:
    任务结果消费分配与轮次结算提供者(
        L2任务结果消费结构服务& 结果结构服务,
        L2需求结算结构服务& 需求结算服务,
        L2任务结构服务& 任务结构服务,
        任务阶段结构消费端口& 阶段端口) noexcept;

    任务结果消费分配结果 形成任务结果消费分配(
        const 任务结果消费分配请求& 请求) noexcept;

    需求本轮核算结果 核算一个来源需求(
        const 需求本轮核算请求& 请求) noexcept;

    任务轮次收束结果 形成任务轮次结算并收束(
        const 任务轮次收束请求& 请求) noexcept;

private:
    static bool 轮次收束请求有效(const 任务轮次收束请求& 请求) noexcept;

    static 任务轮次收束状态 映射task状态(L2结构状态 状态) noexcept;

    static 任务轮次收束状态 映射阶段状态(
        任务阶段结构状态 状态) noexcept;

    static std::optional<任务结果消费分配状态> 验证分配请求(
        const 任务结果消费分配请求& 请求) noexcept;

    static bool 核算请求有效(const 需求本轮核算请求& 请求) noexcept;

    static std::uint64_t 形成逐成员结果(
        const L2任务结果消费分配记录事实& 候选,
        std::vector<L2成员消费分配结果事实>& 输出);

    static bool 记录绑定候选(const L2任务结果消费分配记录事实& 记录,
        const L2任务结果消费分配记录事实& 候选) noexcept;

    static bool 核算事实绑定请求(const L2需求本轮核算事实& 事实,
        const 需求本轮核算请求& 请求) noexcept;

    static 任务结果消费分配状态 映射状态(
        L2任务结果消费分配记录状态 状态) noexcept;

    L2任务结果消费结构服务& 结果结构服务_;
    L2需求结算结构服务& 需求结算服务_;
    L2任务结构服务& 任务结构服务_;
    任务阶段结构消费端口& 阶段端口_;
};

}

module :private;

namespace 海中鱼巣 {

namespace {

bool 当前选择引用相同(const L2中性状态引用事实_v1& 左,
    const L2中性状态引用事实_v1& 右) noexcept {
    return 左 == 右;
}

bool task轮次结算结果成功等价(const L2任务轮次结算结果& 结果) noexcept {
    return (结果.结果头.状态 == L2结构状态::已提交
            || 结果.结果头.状态 == L2结构状态::精确重复)
        && 结果.结果头.事实截止代次 != 0 && 结果.结果头.变更事实代次
        && 结果.结算 && 结果.轮次收束治理动作 && !结果.提交见证
        && 结果.本次正式读回截止 != 0
        && L2任务轮次结算事实完整(*结果.结算)
        && L2任务治理动作调用事实完整(*结果.轮次收束治理动作)
        && 结果.本次正式读回截止 == 结果.结果头.事实截止代次;
}

bool 阶段当前读取成功等价(const 任务阶段当前读取结果& 结果) noexcept {
    return 结果.成功();
}

bool 阶段迁移写入成功等价(const 任务阶段写入结果& 结果) noexcept {
    return 结果.写入种类 == 任务阶段写入种类::阶段迁移
        && 结果.成功();
}

bool 轮次收束结果成功等价(const 任务轮次收束结果& 结果) noexcept {
    const auto 阶段载荷 = 结果.阶段迁移证据
        ? 解码任务阶段中性状态_v2(结果.阶段迁移证据->新状态)
        : std::nullopt;
    return (结果.状态 == 任务轮次收束状态::已收束
            || 结果.状态 == 任务轮次收束状态::精确重复)
        && 结果.轮次结算 && 结果.轮次收束治理动作 && 结果.阶段迁移证据
        && !结果.task提交见证 && !结果.阶段提交见证
        && 结果.task正式读回截止 != 0 && 结果.阶段正式读回截止 != 0
        && L2任务轮次结算事实完整(*结果.轮次结算)
        && L2任务治理动作调用事实完整(*结果.轮次收束治理动作)
        && 阶段载荷
        && 阶段载荷->来源 == 结果.轮次收束治理动作->身份.值;
}

} // namespace

任务结果消费分配与轮次结算提供者::任务结果消费分配与轮次结算提供者(
    L2任务结果消费结构服务& 结果结构服务,
    L2需求结算结构服务& 需求结算服务,
    L2任务结构服务& 任务结构服务,
    任务阶段结构消费端口& 阶段端口) noexcept
    : 结果结构服务_(结果结构服务), 需求结算服务_(需求结算服务),
      任务结构服务_(任务结构服务), 阶段端口_(阶段端口) {}

任务结果消费分配结果 任务结果消费分配与轮次结算提供者::形成任务结果消费分配(
    const 任务结果消费分配请求& 请求) noexcept {
    if (const auto 非成功 = 验证分配请求(请求)) return {*非成功};
    try {
        L2任务结果消费分配记录事实 候选;
        候选.任务 = 请求.任务;
        候选.任务轮次 = 请求.任务轮次;
        候选.正式结果 = 请求.正式结果;
        候选.消费形态 = 请求.容量合同.消费形态;
        候选.冻结成员集合版本 = 请求.冻结成员集合版本;
        候选.容量合同 = 请求.容量合同;
        候选.冻结成员 = 请求.冻结成员;
        std::sort(候选.冻结成员.begin(), 候选.冻结成员.end(),
            [](const auto& 左, const auto& 右) {
                return 左.成员.关系稳定编码.值
                    < 右.成员.关系稳定编码.值;
            });
        候选.优先级批次 = 请求.正式优先级批次;
        候选.正式优先级组 = 请求.正式优先级组;
        std::sort(候选.正式优先级组.begin(), 候选.正式优先级组.end(),
            [](const auto& 左, const auto& 右) {
                return 左.优先级序号 != 右.优先级序号
                    ? 左.优先级序号 < 右.优先级序号
                    : 左.同级顺序序号 < 右.同级顺序序号;
            });
        候选.来源共同事实截止 = 请求.来源共同事实截止;
        候选.关系规则版本 = 请求.关系规则版本;
        候选.优先级规则版本 = 请求.优先级规则版本;
        候选.同级规则版本 = 请求.同级规则版本;
        候选.初始剩余 = 请求.容量合同.初始可用单位;
        候选.最终剩余 = 形成逐成员结果(候选, 候选.逐成员结果);
        const auto 写入 = 结果结构服务_.发布或读取任务结果消费分配记录(
            {请求.结果owner请求头, 请求.结果owner幂等身份, 候选});
        任务结果消费分配结果 结果;
        结果.记录 = 写入.记录;
        结果.提交见证 = 写入.提交见证;
        结果.本次正式读回截止 = 写入.本次正式读回截止;
        if (写入.状态 == L2任务结果消费分配记录状态::已形成)
            结果.状态 = 请求.容量合同.消费形态
                == L2任务结果消费形态::可重复引用
                ? 任务结果消费分配状态::已形成可共用记录
                : 任务结果消费分配状态::已形成争用分配;
        else 结果.状态 = 映射状态(写入.状态);
        if (结果.成功()
            && (!结果.记录 || !记录绑定候选(*结果.记录, 候选)))
            return {任务结果消费分配状态::内部错误};
        return 结果;
    } catch (const std::bad_alloc&) {
        return {任务结果消费分配状态::资源失败};
    } catch (...) {
        return {任务结果消费分配状态::内部错误};
    }
}

需求本轮核算结果 任务结果消费分配与轮次结算提供者::核算一个来源需求(
    const 需求本轮核算请求& 请求) noexcept {
    if (!核算请求有效(请求)) return {L2需求本轮核算写入状态::入口拒绝};
    L2需求本轮核算事实 候选;
    候选.需求 = 请求.需求;
    候选.来源任务 = 请求.来源任务;
    候选.来源任务轮次 = 请求.来源任务轮次;
    候选.来源正式结果 = 请求.来源正式结果;
    候选.消费分配记录 = 请求.消费分配记录;
    候选.消费资格 = 请求.消费资格;
    候选.分配状态 = 请求.分配状态;
    候选.结论 = 请求.结论;
    候选.正式满足记录 = 请求.正式满足记录;
    候选.比较时实际状态 = 请求.比较时实际状态;
    候选.目标状态合同 = 请求.目标状态合同;
    候选.比较注册 = 请求.比较注册;
    候选.来源共同事实截止 = 请求.来源共同事实截止;
    候选.核算规则版本 = 请求.核算规则版本;
    const auto 写入 = 需求结算服务_.写入或读取需求本轮核算(
        {请求.结算owner请求头, 请求.结算owner幂等身份, 候选});
    需求本轮核算结果 结果{写入.状态, 写入.核算事实, 写入.提交见证,
        写入.本次正式读回截止};
    if (结果.成功()
        && (!结果.核算事实 || !核算事实绑定请求(*结果.核算事实, 请求)))
        return {L2需求本轮核算写入状态::内部错误};
    return 结果;
}

任务轮次收束结果 任务结果消费分配与轮次结算提供者::形成任务轮次结算并收束(
    const 任务轮次收束请求& 请求) noexcept {
    任务轮次收束结果 结果;
    if (!轮次收束请求有效(请求)) {
        结果.状态 = 任务轮次收束状态::入口拒绝;
        return 结果;
    }
    try {
        const auto 记录 = 结果结构服务_.读取任务结果消费分配记录(
            {1, 请求.消费分配记录, *请求.正式结果,
                请求.来源共同事实截止});
        if (!记录.成功() || !记录.记录
            || 记录.记录->任务 != 请求.任务
            || 记录.记录->任务轮次 != 请求.任务轮次
            || 记录.记录->正式结果 != *请求.正式结果
            || 记录.记录->来源共同事实截止 != 请求.来源共同事实截止) {
            结果.状态 = 任务轮次收束状态::分配记录未收束;
            return 结果;
        }
        const auto& 成员组 = 记录.记录->冻结成员;
        if (成员组.size() != 请求.稳定核算身份组.size()) {
            结果.状态 = 任务轮次收束状态::核算缺项;
            return 结果;
        }
        for (std::size_t i = 0; i < 请求.稳定核算身份组.size(); ++i) {
            const auto 身份 = 请求.稳定核算身份组[i];
            if (!有效(身份.值)) {
                结果.状态 = 任务轮次收束状态::核算缺项;
                return 结果;
            }
            if (std::find(请求.稳定核算身份组.begin(),
                    请求.稳定核算身份组.begin() + i, 身份)
                != 请求.稳定核算身份组.begin() + i) {
                结果.状态 = 任务轮次收束状态::核算多义;
                return 结果;
            }
        }
        std::vector<bool> 已匹配核算(请求.稳定核算身份组.size(), false);
        for (const auto& 成员 : 成员组) {
            std::optional<std::size_t> 唯一匹配;
            for (std::size_t i = 0; i < 请求.稳定核算身份组.size(); ++i) {
                if (已匹配核算[i]) continue;
                const auto 核算 = 需求结算服务_.读取需求本轮核算({1,
                    请求.稳定核算身份组[i], 成员.成员.来源需求,
                    请求.任务, 请求.任务轮次, 请求.来源共同事实截止});
                if (核算.成功() && 核算.核算事实
                    && 核算.核算事实->消费分配记录 == 请求.消费分配记录
                    && 核算.核算事实->需求 == 成员.成员.来源需求
                    && 核算.核算事实->消费资格.成员.关系稳定编码
                        == 成员.成员.关系稳定编码
                    && 核算.核算事实->消费资格 == 成员) {
                    if (唯一匹配) {
                        结果.状态 = 任务轮次收束状态::核算多义;
                        return 结果;
                    }
                    唯一匹配 = i;
                } else if (核算.状态 == L2需求本轮核算读取状态::许可拒绝) {
                    结果.状态 = 任务轮次收束状态::许可拒绝;
                    return 结果;
                } else if (核算.状态 == L2需求本轮核算读取状态::资源失败) {
                    结果.状态 = 任务轮次收束状态::资源失败;
                    return 结果;
                }
            }
            if (!唯一匹配) {
                结果.状态 = 任务轮次收束状态::核算缺项;
                return 结果;
            }
            已匹配核算[*唯一匹配] = true;
        }

        L2任务轮次结算事实 候选;
        候选.任务 = 请求.任务;
        候选.任务轮次 = 请求.任务轮次;
        候选.实际结果 = 请求.正式结果;
        候选.结论 = 请求.结论;
        候选.验证归因收口 = 请求.验证归因收口;
        候选.结果消费分配记录 = 请求.消费分配记录;
        候选.需求核算结果组 = 请求.稳定核算身份组;
        候选.适用后继结果组 = 请求.稳定适用后继结果组;
        候选.执行冻结收口 = 请求.执行冻结收口;
        候选.授权收口 = 请求.授权收口;
        候选.任务运行停止证据 = 请求.任务运行停止证据;
        候选.来源共同事实截止 = 请求.来源共同事实截止;
        候选.结算规则版本 = 请求.结算规则版本;
        const auto task结果 = 任务结构服务_.建立或读取任务轮次结算({
            请求.task请求头, 请求.task写入幂等身份, 候选,
            请求.当前阶段});
        if (!task轮次结算结果成功等价(task结果)) {
            结果.状态 = task结果.提交见证
                ? 任务轮次收束状态::已可能发布
                : 映射task状态(task结果.结果头.状态);
            结果.task提交见证 = task结果.提交见证;
            return 结果;
        }
        if (!task结果.结算 || !task结果.轮次收束治理动作
            || task结果.结算->任务 != 请求.任务
            || task结果.结算->任务轮次 != 请求.任务轮次
            || task结果.轮次收束治理动作->任务 != 请求.任务
            || task结果.轮次收束治理动作->任务轮次 != 请求.任务轮次
            || task结果.轮次收束治理动作->触发前态.值
                != 请求.当前阶段.值
            || task结果.轮次收束治理动作->来源共同事实截止
                != 请求.来源共同事实截止) {
            结果.状态 = 任务轮次收束状态::内部错误;
            return 结果;
        }
        结果.轮次结算 = task结果.结算;
        结果.轮次收束治理动作 = task结果.轮次收束治理动作;
        结果.task正式读回截止 = task结果.本次正式读回截止;

        auto 阶段头 = 请求.阶段请求头;
        // 阶段迁移从 task-owner 本次写入形成的截止继续；
        // 中性状态、动态和当前选择随后分别形成自己的事实代次。
        阶段头.期望事实代次 = *task结果.结果头.变更事实代次;
        const auto 当前 = 阶段端口_.读取当前阶段({
            任务阶段结构消费合同版本, 阶段头, 请求.任务正式存在,
            请求.阶段特征实例});
        const bool 当前成功 = 阶段当前读取成功等价(当前);
        if (!当前成功 || !当前.当前状态 || !当前.当前选择
            || 当前.当前状态->身份 != 请求.当前阶段
            || !当前选择引用相同(*当前.当前选择, 请求.旧当前选择)) {
            结果.状态 = 当前成功
                ? 任务轮次收束状态::引用冲突
                : 映射阶段状态(当前.状态);
            return 结果;
        }
        任务阶段迁移请求 迁移;
        迁移.请求头 = 阶段头;
        迁移.幂等身份 = 请求.阶段迁移幂等身份;
        迁移.任务正式存在 = 请求.任务正式存在;
        迁移.阶段特征实例 = 请求.阶段特征实例;
        迁移.当前状态 = 请求.当前阶段;
        迁移.旧当前选择 = 请求.旧当前选择;
        迁移.目标阶段 = {任务主阶段::轮次已收束,
            任务业务状态段::轮次已收束待自我决议};
        迁移.来源治理动作 = task结果.轮次收束治理动作->身份.值;
        迁移.任务轮次序号 = 请求.任务轮次序号;
        迁移.当前阶段发生时间 = 请求.当前阶段发生时间;
        迁移.目标阶段发生时间 = 请求.收束阶段发生时间;
        const auto 阶段结果 = 阶段端口_.发布阶段迁移(迁移);
        if (!阶段迁移写入成功等价(阶段结果)) {
            结果.状态 = 映射阶段状态(阶段结果.状态);
            if (结果.状态 == 任务轮次收束状态::已可能发布)
                结果.阶段提交见证 = 阶段结果.提交见证;
            return 结果;
        }
        结果.阶段迁移证据 = 阶段结果.迁移证据;
        结果.阶段正式读回截止 = 阶段结果.本次正式读回截止;
        const bool 双重放 = task结果.结果头.状态 == L2结构状态::精确重复
            && 阶段结果.状态 == 任务阶段结构状态::精确重复;
        结果.状态 = 双重放 ? 任务轮次收束状态::精确重复
            : 任务轮次收束状态::已收束;
        return 轮次收束结果成功等价(结果) ? 结果 : 任务轮次收束结果{};
    } catch (const std::bad_alloc&) {
        结果.状态 = 任务轮次收束状态::资源失败;
        return 结果;
    } catch (const std::length_error&) {
        结果.状态 = 任务轮次收束状态::资源失败;
        return 结果;
    } catch (...) {
        结果.状态 = 任务轮次收束状态::内部错误;
        return 结果;
    }
}

bool 任务结果消费分配与轮次结算提供者::轮次收束请求有效(const 任务轮次收束请求& 请求) noexcept {
    if (请求.合同版本 != 1
        || !L2结构请求头合同有效(请求.task请求头)
        || !L2结构请求头合同有效(请求.阶段请求头)
        || !L2结构幂等身份有效(请求.task写入幂等身份)
        || !L2结构幂等身份有效(请求.阶段迁移幂等身份)
        || !有效(请求.任务.值) || !有效(请求.任务轮次.值)
        || !请求.正式结果 || !有效(请求.正式结果->值)
        || !有效(请求.验证归因收口.值)
        || !有效(请求.消费分配记录.值)
        || 请求.稳定核算身份组.empty()
        || !有效(请求.执行冻结收口.值)
        || !L2任务轮次授权收口引用完整(请求.授权收口)
        || !有效(请求.任务运行停止证据.值)
        || !有效(请求.任务正式存在.值)
        || !有效(请求.阶段特征实例.值)
        || !有效(请求.当前阶段.值)
        || !L2中性状态引用事实完整_v1(请求.旧当前选择)
        || 请求.旧当前选择.类别 != L2中性状态引用类别_v1::当前选择
        || 请求.旧当前选择.目标状态 != 请求.当前阶段
        || 请求.旧当前选择.引用方 != 请求.任务正式存在.值
        || 请求.旧当前选择.引用角色 != 请求.阶段特征实例.值
        || 请求.旧当前选择.生命周期.创建事实代次
            > 请求.来源共同事实截止
        || (请求.旧当前选择.生命周期.退出事实代次
            && *请求.旧当前选择.生命周期.退出事实代次
                <= 请求.来源共同事实截止)
        || 请求.任务轮次序号 == 0
        || 请求.当前阶段发生时间 == 0
        || 请求.收束阶段发生时间 == 0
        || 请求.收束阶段发生时间 < 请求.当前阶段发生时间
        || 请求.来源共同事实截止 == 0
        || 请求.结算规则版本 != L2任务轮次结算规则版本)
        return false;
    switch (请求.结论) {
    case 任务轮次结论::目标已达成:
    case 任务轮次结论::目标未达成:
    case 任务轮次结论::合法业务失败:
    case 任务轮次结论::取消:
        break;
    default:
        return false;
    }
    for (std::size_t i = 0; i < 请求.稳定核算身份组.size(); ++i) {
        if (!有效(请求.稳定核算身份组[i].值)) return false;
        for (std::size_t j = 0; j < i; ++j)
            if (请求.稳定核算身份组[j] == 请求.稳定核算身份组[i])
                return false;
    }
    std::uint8_t 前分支 = 0;
    std::uint64_t 前值 = 0;
    for (const auto& 项 : 请求.稳定适用后继结果组) {
        const auto 分支 = static_cast<std::uint8_t>(项.index() + 1U);
        const auto 值 = std::visit([](const auto& 身份) {
            return 身份.值.值;
        }, 项);
        if (值 == 0 || (前分支 != 0 && (分支 < 前分支
            || (分支 == 前分支 && 值 <= 前值)))) return false;
        前分支 = 分支;
        前值 = 值;
    }
    return true;
}

任务轮次收束状态 任务结果消费分配与轮次结算提供者::映射task状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::入口拒绝:
        return 任务轮次收束状态::入口拒绝;
    case L2结构状态::许可拒绝:
        return 任务轮次收束状态::许可拒绝;
    case L2结构状态::事实代次漂移:
        return 任务轮次收束状态::当前性漂移;
    case L2结构状态::幂等冲突:
        return 任务轮次收束状态::幂等冲突;
    case L2结构状态::引用冲突:
        return 任务轮次收束状态::引用冲突;
    case L2结构状态::资源失败:
    case L2结构状态::数量预算不足:
        return 任务轮次收束状态::资源失败;
    default:
        return 任务轮次收束状态::内部错误;
    }
}

任务轮次收束状态 任务结果消费分配与轮次结算提供者::映射阶段状态(
    任务阶段结构状态 状态) noexcept {
    switch (状态) {
    case 任务阶段结构状态::入口拒绝:
        return 任务轮次收束状态::入口拒绝;
    case 任务阶段结构状态::许可拒绝:
        return 任务轮次收束状态::许可拒绝;
    case 任务阶段结构状态::当前性漂移:
    case 任务阶段结构状态::已有当前选择:
    case 任务阶段结构状态::待迁移:
        return 任务轮次收束状态::当前性漂移;
    case 任务阶段结构状态::幂等冲突:
        return 任务轮次收束状态::幂等冲突;
    case 任务阶段结构状态::引用冲突:
        return 任务轮次收束状态::引用冲突;
    case 任务阶段结构状态::资源失败:
        return 任务轮次收束状态::资源失败;
    case 任务阶段结构状态::已可能发布:
        return 任务轮次收束状态::已可能发布;
    default:
        return 任务轮次收束状态::内部错误;
    }
}

std::optional<任务结果消费分配状态> 任务结果消费分配与轮次结算提供者::验证分配请求(
    const 任务结果消费分配请求& 请求) noexcept {
    if (请求.合同版本 != 1
        || !L2结构请求头合同有效(请求.结果owner请求头)
        || !L2结构幂等身份有效(请求.结果owner幂等身份)
        || !有效(请求.任务.值) || !有效(请求.任务轮次.值)
        || !有效(请求.正式结果.值) || 请求.冻结成员集合版本 == 0
        || 请求.来源共同事实截止 == 0 || 请求.关系规则版本 != 1
        || 请求.优先级规则版本 != 1 || 请求.同级规则版本 != 1)
        return 任务结果消费分配状态::入口拒绝;
    if (请求.容量合同.扣减维度组.size() > 1)
        return 任务结果消费分配状态::关系不可裁决;
    if (!L2任务结果消费容量合同有效(请求.容量合同)
        || !有效(请求.容量合同.范围合同身份)
        || !有效(请求.容量合同.所有权合同身份)
        || !有效(请求.容量合同.有效性合同身份))
        return 任务结果消费分配状态::容量合同缺失;
    if (请求.冻结成员.empty())
        return 任务结果消费分配状态::成员漂移;
    for (std::size_t i = 0; i < 请求.冻结成员.size(); ++i) {
        const auto& 成员 = 请求.冻结成员[i];
        if (!L2成员消费资格材料有效(成员)
            || 成员.成员.任务 != 请求.任务
            || 成员.范围合同身份 != 请求.容量合同.范围合同身份
            || 成员.所有权合同身份 != 请求.容量合同.所有权合同身份
            || 成员.有效性合同身份 != 请求.容量合同.有效性合同身份)
            return 任务结果消费分配状态::成员漂移;
        for (std::size_t j = 0; j < i; ++j)
            if (请求.冻结成员[j].成员.关系稳定编码
                == 成员.成员.关系稳定编码)
                return 任务结果消费分配状态::成员漂移;
    }
    const bool 可共用 = 请求.容量合同.消费形态
        == L2任务结果消费形态::可重复引用;
    if (可共用) {
        if (请求.正式优先级批次 || !请求.正式优先级组.empty())
            return 任务结果消费分配状态::优先级合同缺失;
        if (std::any_of(请求.冻结成员.begin(), 请求.冻结成员.end(),
                [](const auto& 成员) {
                    return 成员.最低合法分配单位 != 0
                        || 成员.期望分配单位 != 0;
                }))
            return 任务结果消费分配状态::容量合同缺失;
        return std::nullopt;
    }
    const bool 可分割 = 请求.容量合同.消费形态
        == L2任务结果消费形态::可分割单位;
    const bool 不可分割 = 请求.容量合同.消费形态
        == L2任务结果消费形态::不可分割资格;
    if (!可分割 && !不可分割)
        return 任务结果消费分配状态::关系不可裁决;
    if (!请求.正式优先级批次 || !有效(请求.正式优先级批次->值)
        || 请求.正式优先级组.size() != 请求.冻结成员.size())
        return 任务结果消费分配状态::优先级合同缺失;
    if (不可分割 && 请求.容量合同.初始可用单位 != 1)
        return 任务结果消费分配状态::容量合同缺失;
    for (const auto& 成员 : 请求.冻结成员) {
        if (成员.最低合法分配单位 == 0
            || 成员.最低合法分配单位 > 成员.期望分配单位
            || (不可分割 && (成员.最低合法分配单位 != 1
                || 成员.期望分配单位 != 1)))
            return 任务结果消费分配状态::容量合同缺失;
    }
    for (std::size_t i = 0; i < 请求.正式优先级组.size(); ++i) {
        const auto& 优先级 = 请求.正式优先级组[i];
        if (!有效(优先级.身份.值) || 优先级.优先级序号 == 0
            || 优先级.同级顺序序号 == 0
            || std::count(请求.冻结成员.begin(), 请求.冻结成员.end(),
                优先级.消费资格) != 1)
            return 任务结果消费分配状态::优先级合同缺失;
        for (std::size_t j = 0; j < i; ++j) {
            const auto& 已有 = 请求.正式优先级组[j];
            if (已有.身份 == 优先级.身份
                || (已有.优先级序号 == 优先级.优先级序号
                    && 已有.同级顺序序号 == 优先级.同级顺序序号))
                return 任务结果消费分配状态::优先级合同缺失;
        }
    }
    return std::nullopt;
}

bool 任务结果消费分配与轮次结算提供者::核算请求有效(const 需求本轮核算请求& 请求) noexcept {
    const bool 可比较 = 请求.分配状态 == L2成员消费分配状态::共同引用
        || 请求.分配状态 == L2成员消费分配状态::已分配;
    const bool 未获分配 = 请求.分配状态 == L2成员消费分配状态::未获分配
        || 请求.分配状态 == L2成员消费分配状态::结果已耗尽;
    const bool 比较材料完整 = 有效(请求.比较时实际状态.值)
        && 有效(请求.目标状态合同.值) && 有效(请求.比较注册)
        && 请求.目标状态合同 == 请求.消费资格.目标合同;
    bool 结论形状 = false;
    if (未获分配) {
        结论形状 = 请求.结论 == L2需求本轮核算结论::未获分配
            && !有效(请求.比较时实际状态.值)
            && !有效(请求.目标状态合同.值) && !有效(请求.比较注册)
            && !请求.正式满足记录;
    } else if (可比较) {
        switch (请求.结论) {
        case L2需求本轮核算结论::已满足:
            结论形状 = 比较材料完整 && 请求.正式满足记录
                && 请求.正式满足记录->有效();
            break;
        case L2需求本轮核算结论::未满足:
        case L2需求本轮核算结论::不可比较:
            结论形状 = 比较材料完整 && !请求.正式满足记录;
            break;
        case L2需求本轮核算结论::材料不足:
            结论形状 = !比较材料完整 && !请求.正式满足记录;
            break;
        default:
            break;
        }
    }
    return 请求.合同版本 == 1 && L2结构请求头合同有效(请求.结算owner请求头)
        && L2结构幂等身份有效(请求.结算owner幂等身份)
        && 有效(请求.需求.值)
        && 请求.消费资格.成员.来源需求 == 请求.需求
        && 请求.消费资格.成员.任务 == 请求.来源任务
        && 有效(请求.来源任务.值) && 有效(请求.来源任务轮次.值)
        && 有效(请求.来源正式结果.值) && 有效(请求.消费分配记录.值)
        && L2成员消费资格材料有效(请求.消费资格)
        && 请求.来源共同事实截止 != 0 && 请求.核算规则版本 == 1
        && 结论形状;
}

std::uint64_t 任务结果消费分配与轮次结算提供者::形成逐成员结果(
    const L2任务结果消费分配记录事实& 候选,
    std::vector<L2成员消费分配结果事实>& 输出) {
    const bool 可共用 = 候选.消费形态 == L2任务结果消费形态::可重复引用;
    const auto 成员数 = 可共用 ? 候选.冻结成员.size()
        : 候选.正式优先级组.size();
    std::uint64_t 剩余 = 候选.容量合同.初始可用单位;
    for (std::size_t i = 0; i < 成员数; ++i) {
        L2成员消费分配结果事实 项;
        项.消费资格 = 可共用 ? 候选.冻结成员[i]
            : 候选.正式优先级组[i].消费资格;
        项.处理顺序 = i + 1;
        if (可共用) {
            项.成员状态 = L2成员消费分配状态::共同引用;
        } else {
            项.正式优先级 = 候选.正式优先级组[i];
            项.分配前剩余 = 剩余;
            if (剩余 == 0) 项.成员状态 = L2成员消费分配状态::结果已耗尽;
            else if (剩余 < 项.消费资格.最低合法分配单位)
                项.成员状态 = L2成员消费分配状态::未获分配;
            else {
                项.成员状态 = L2成员消费分配状态::已分配;
                项.实际分配单位 = std::min(
                    剩余, 项.消费资格.期望分配单位);
                剩余 -= 项.实际分配单位;
            }
            项.分配后剩余 = 剩余;
        }
        输出.push_back(std::move(项));
    }
    return 剩余;
}

bool 任务结果消费分配与轮次结算提供者::记录绑定候选(const L2任务结果消费分配记录事实& 记录,
    const L2任务结果消费分配记录事实& 候选) noexcept {
    return 记录.任务 == 候选.任务 && 记录.任务轮次 == 候选.任务轮次
        && 记录.正式结果 == 候选.正式结果
        && 记录.消费形态 == 候选.消费形态
        && 记录.冻结成员集合版本 == 候选.冻结成员集合版本
        && 记录.容量合同 == 候选.容量合同
        && 记录.冻结成员 == 候选.冻结成员
        && 记录.优先级批次 == 候选.优先级批次
        && 记录.正式优先级组 == 候选.正式优先级组
        && 记录.逐成员结果 == 候选.逐成员结果
        && 记录.初始剩余 == 候选.初始剩余
        && 记录.最终剩余 == 候选.最终剩余
        && 记录.来源共同事实截止 == 候选.来源共同事实截止
        && 记录.关系规则版本 == 候选.关系规则版本
        && 记录.优先级规则版本 == 候选.优先级规则版本
        && 记录.同级规则版本 == 候选.同级规则版本;
}

bool 任务结果消费分配与轮次结算提供者::核算事实绑定请求(const L2需求本轮核算事实& 事实,
    const 需求本轮核算请求& 请求) noexcept {
    return 事实.需求 == 请求.需求 && 事实.来源任务 == 请求.来源任务
        && 事实.来源任务轮次 == 请求.来源任务轮次
        && 事实.来源正式结果 == 请求.来源正式结果
        && 事实.消费分配记录 == 请求.消费分配记录
        && 事实.消费资格 == 请求.消费资格
        && 事实.分配状态 == 请求.分配状态
        && 事实.比较时实际状态 == 请求.比较时实际状态
        && 事实.目标状态合同 == 请求.目标状态合同
        && 事实.比较注册 == 请求.比较注册
        && 事实.正式满足记录 == 请求.正式满足记录
        && 事实.结论 == 请求.结论
        && 事实.来源共同事实截止 == 请求.来源共同事实截止
        && 事实.核算规则版本 == 请求.核算规则版本;
}

任务结果消费分配状态 任务结果消费分配与轮次结算提供者::映射状态(
    L2任务结果消费分配记录状态 状态) noexcept {
    switch (状态) {
    case L2任务结果消费分配记录状态::精确重复:
        return 任务结果消费分配状态::精确重复;
    case L2任务结果消费分配记录状态::幂等冲突:
    case L2任务结果消费分配记录状态::成员漂移:
        return 任务结果消费分配状态::成员漂移;
    case L2任务结果消费分配记录状态::当前性漂移:
        return 任务结果消费分配状态::当前性漂移;
    case L2任务结果消费分配记录状态::入口拒绝:
        return 任务结果消费分配状态::入口拒绝;
    case L2任务结果消费分配记录状态::许可拒绝:
        return 任务结果消费分配状态::许可拒绝;
    case L2任务结果消费分配记录状态::资源失败:
        return 任务结果消费分配状态::资源失败;
    case L2任务结果消费分配记录状态::已可能发布:
        return 任务结果消费分配状态::已可能发布;
    default: return 任务结果消费分配状态::内部错误;
    }
}

}
