#define 任务初次筹办数据_NO_INCLUDES

export module 海中鱼巣.领域.内部治理.服务.需求初次筹办准备;

import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.组合.运行期只读查询;

export {
#include "任务初次筹办.数据.h"
}

namespace 海中鱼巣::需求初次筹办准备内部 {

L2任务初次筹办准备完整请求材料 转换完整请求(
    const 需求初次筹办准备请求& 请求) noexcept {
    return {请求.合同版本, 请求.准备幂等身份.值,
        请求.请求身份, 请求.运行代次, 请求.请求头,
        请求.需求, 请求.任务建立幂等身份};
}

L2任务初次筹办首次需求裁决材料 转换首次裁决(
    const 需求当前满足裁决快照& 裁决) {
    L2任务初次筹办首次需求裁决材料 材料;
    材料.裁决规则版本 = 裁决.规则版本;
    材料.裁决请求身份 = 裁决.裁决请求身份;
    材料.需求事实 = 裁决.需求事实;
    材料.当前成员关系 = 裁决.当前成员关系;
    材料.所属列表项 = 裁决.所属列表项;
    材料.当前特征实例 = 裁决.当前特征实例;
    材料.当前特征值 = 裁决.当前特征值;
    材料.目标合同 = 裁决.目标合同;
    材料.比较注册 = 裁决.比较注册;
    材料.比较算法版本 = 裁决.比较算法版本;
    材料.具名关系 = 裁决.具名关系;
    材料.允许关系位 = 裁决.允许关系位;
    材料.首次共同事实截止G0 = 裁决.事实截止代次;
    return 材料;
}

需求当前满足裁决快照 重构首次裁决(
    const L2任务初次筹办首次需求裁决材料& 材料) {
    需求当前满足裁决快照 裁决;
    裁决.规则版本 = 材料.裁决规则版本;
    裁决.裁决请求身份 = 材料.裁决请求身份;
    裁决.需求事实 = 材料.需求事实;
    裁决.当前成员关系 = 材料.当前成员关系;
    裁决.所属列表项 = 材料.所属列表项;
    裁决.当前特征实例 = 材料.当前特征实例;
    裁决.当前特征值 = 材料.当前特征值;
    裁决.目标合同 = 材料.目标合同;
    裁决.比较注册 = 材料.比较注册;
    裁决.比较算法版本 = 材料.比较算法版本;
    裁决.具名关系 = 材料.具名关系;
    裁决.允许关系位 = 材料.允许关系位;
    裁决.事实截止代次 = 材料.首次共同事实截止G0;
    return 裁决;
}

需求初次筹办准备状态 映射读取失败(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::事实代次漂移:
        return 需求初次筹办准备状态::当前性漂移;
    case L2结构状态::许可拒绝:
        return 需求初次筹办准备状态::许可拒绝;
    case L2结构状态::资源失败:
    case L2结构状态::数量预算不足:
        return 需求初次筹办准备状态::资源失败;
    case L2结构状态::入口拒绝:
        return 需求初次筹办准备状态::入口拒绝;
    case L2结构状态::引用冲突:
        return 需求初次筹办准备状态::引用冲突;
    default:
        return 需求初次筹办准备状态::内部错误;
    }
}

需求初次筹办准备状态 映射裁决失败(
    需求当前满足裁决状态 状态) noexcept {
    switch (状态) {
    case 需求当前满足裁决状态::证据不足:
        return 需求初次筹办准备状态::证据不足;
    case 需求当前满足裁决状态::当前性漂移:
        return 需求初次筹办准备状态::当前性漂移;
    case 需求当前满足裁决状态::引用冲突:
        return 需求初次筹办准备状态::引用冲突;
    case 需求当前满足裁决状态::不可比较:
        return 需求初次筹办准备状态::不可比较;
    case 需求当前满足裁决状态::入口拒绝:
        return 需求初次筹办准备状态::入口拒绝;
    case 需求当前满足裁决状态::许可拒绝:
        return 需求初次筹办准备状态::许可拒绝;
    case 需求当前满足裁决状态::资源失败:
        return 需求初次筹办准备状态::资源失败;
    default:
        return 需求初次筹办准备状态::内部错误;
    }
}

需求初次筹办准备结果 形成首次结果(
    需求初次筹办准备状态 状态,
    const L2任务初次筹办准备记录事实& 记录,
    const L2任务事实& 任务,
    const L2任务身份来源事实& 身份来源) {
    需求初次筹办准备结果 结果;
    结果.状态 = 状态;
    结果.需求裁决 = 重构首次裁决(记录.首次需求裁决);
    结果.首次准备记录 = 记录.身份;
    任务初次筹办工作包 工作包;
    工作包.合同版本 = 需求初次筹办准备合同版本;
    工作包.运行代次 = 记录.完整请求.运行代次;
    工作包.任务 = 任务;
    工作包.任务身份来源 = 身份来源;
    工作包.来源需求 = 记录.首次需求裁决.需求事实;
    工作包.当前成员关系 = 记录.首次需求裁决.当前成员关系;
    工作包.需求列表项 = 记录.首次需求裁决.所属列表项;
    工作包.筹办轮次 = 记录.筹办轮次;
    工作包.原共同事实截止G0 =
        记录.首次需求裁决.首次共同事实截止G0;
    工作包.任务建立事实代次G1 = 记录.首次任务建立代次G1;
    结果.工作包 = std::move(工作包);
    if (!结果.成功()) {
        需求初次筹办准备结果 内部错误;
        内部错误.状态 = 需求初次筹办准备状态::内部错误;
        return 内部错误;
    }
    return 结果;
}

} // namespace 海中鱼巣::需求初次筹办准备内部

export namespace 海中鱼巣 {

class 需求初次筹办准备提供者 final {
public:
    需求初次筹办准备提供者(
        const 运行期只读查询组合器& 查询组合器,
        L2任务结构服务& 任务结构服务) noexcept
        : 查询组合器_(查询组合器), 任务结构服务_(任务结构服务) {}
    需求初次筹办准备提供者(const 需求初次筹办准备提供者&) = delete;
    需求初次筹办准备提供者& operator=(
        const 需求初次筹办准备提供者&) = delete;

    需求初次筹办准备结果 形成唯一任务与初次筹办工作包(
        需求初次筹办准备请求 请求) noexcept {
        const auto 失败 = [](需求初次筹办准备状态 状态) noexcept {
            需求初次筹办准备结果 结果;
            结果.状态 = 状态;
            return 结果;
        };
        try {
            if (!需求初次筹办准备请求有效(请求))
                return 失败(需求初次筹办准备状态::入口拒绝);
            const auto 完整请求 =
                需求初次筹办准备内部::转换完整请求(请求);

            // 外层幂等记录必须先于实时需求裁决读取。
            const auto 首次读取 =
                任务结构服务_.按初次筹办准备幂等身份读取首次记录(
                    {请求.请求头, 请求.准备幂等身份.值});
            if (!首次读取.成功())
                return 失败(需求初次筹办准备内部::映射读取失败(
                    首次读取.结果头.状态));
            if (首次读取.首次准备记录) {
                if (!首次读取.首次任务 || !首次读取.首次任务身份来源)
                    return 失败(需求初次筹办准备状态::内部错误);
                if (首次读取.首次准备记录->完整请求 != 完整请求) {
                    auto 冲突 = 失败(需求初次筹办准备状态::幂等冲突);
                    冲突.首次准备记录 = 首次读取.首次准备记录->身份;
                    return 冲突;
                }
                return 需求初次筹办准备内部::形成首次结果(
                    需求初次筹办准备状态::精确重复,
                    *首次读取.首次准备记录, *首次读取.首次任务,
                    *首次读取.首次任务身份来源);
            }
            if (首次读取.结果头.事实截止代次
                != 请求.请求头.期望事实代次)
                return 失败(需求初次筹办准备状态::当前性漂移);

            const auto 裁决结果 = 查询组合器_.裁决需求当前满足(
                {运行期只读查询合同版本, 请求.请求身份,
                    请求.需求, 请求.请求头.期望事实代次});
            if (裁决结果.状态 == 需求当前满足裁决状态::已满足)
                return 失败(需求初次筹办准备状态::目标已满足);
            if (裁决结果.状态 != 需求当前满足裁决状态::未满足
                || !裁决结果.裁决)
                return 失败(需求初次筹办准备内部::映射裁决失败(
                    裁决结果.状态));
            const auto 首次裁决 =
                需求初次筹办准备内部::转换首次裁决(*裁决结果.裁决);
            if (!L2任务初次筹办首次需求裁决材料完整(首次裁决))
                return 失败(需求初次筹办准备状态::内部错误);

            const auto 写入 =
                任务结构服务_.新增任务与首次初次筹办准备记录(
                    {请求.请求头, 完整请求, 首次裁决});
            if (写入.成功()) {
                return 需求初次筹办准备内部::形成首次结果(
                    写入.结果头.状态 == L2结构状态::已提交
                        ? 需求初次筹办准备状态::已形成
                        : 需求初次筹办准备状态::精确重复,
                    *写入.首次准备记录, *写入.任务, *写入.身份来源);
            }
            if (写入.结果头.状态 == L2结构状态::幂等冲突)
                return 失败(需求初次筹办准备状态::幂等冲突);
            if (写入.结果头.状态 == L2结构状态::引用冲突)
                return 失败(需求初次筹办准备状态::已有当前任务);

            // 写入端返回非成功但携带非零截止时，先按原键原请求收敛
            // 发布未知；不得换键、刷新请求或重新裁决。
            if (写入.结果头.事实截止代次 != 0) {
                const auto 收敛 =
                    任务结构服务_.按初次筹办准备幂等身份读取首次记录(
                        {{L2结构合同版本,
                            写入.结果头.事实截止代次},
                            请求.准备幂等身份.值});
                if (收敛.成功() && 收敛.首次准备记录
                    && 收敛.首次任务 && 收敛.首次任务身份来源) {
                    if (收敛.首次准备记录->完整请求 != 完整请求)
                        return 失败(需求初次筹办准备状态::幂等冲突);
                    return 需求初次筹办准备内部::形成首次结果(
                        需求初次筹办准备状态::精确重复,
                        *收敛.首次准备记录, *收敛.首次任务,
                        *收敛.首次任务身份来源);
                }
            }
            return 失败(需求初次筹办准备内部::映射读取失败(
                写入.结果头.状态));
        } catch (const std::bad_alloc&) {
            return 失败(需求初次筹办准备状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(需求初次筹办准备状态::资源失败);
        } catch (...) {
            return 失败(需求初次筹办准备状态::内部错误);
        }
    }

private:
    const 运行期只读查询组合器& 查询组合器_;
    L2任务结构服务& 任务结构服务_;
};

} // namespace 海中鱼巣
