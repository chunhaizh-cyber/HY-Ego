module;

#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>

#define 任务子目标回流重判数据_NO_INCLUDES

export module 海中鱼巣.领域.内部治理.服务.任务子目标回流重判;

import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2任务子目标承接记录结构;
import 海中鱼巣.领域.组合.运行期只读查询;
import 海中鱼巣.领域.内部治理.服务.需求初次筹办准备;

export {
#include "任务子目标回流重判.数据.h"
}

namespace 海中鱼巣::任务子目标回流重判内部 {

任务子目标回流重判状态 映射结构状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::事实代次漂移:
        return 任务子目标回流重判状态::当前性漂移;
    case L2结构状态::幂等冲突:
        return 任务子目标回流重判状态::幂等冲突;
    case L2结构状态::引用冲突:
        return 任务子目标回流重判状态::引用冲突;
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::属性未设置:
        return 任务子目标回流重判状态::记录不可消费;
    case L2结构状态::入口拒绝:
        return 任务子目标回流重判状态::入口拒绝;
    case L2结构状态::许可拒绝:
        return 任务子目标回流重判状态::许可拒绝;
    case L2结构状态::资源失败:
    case L2结构状态::数量预算不足:
        return 任务子目标回流重判状态::资源失败;
    default:
        return 任务子目标回流重判状态::内部错误;
    }
}

任务子目标回流重判状态 映射裁决状态(
    需求当前满足裁决状态 状态) noexcept {
    switch (状态) {
    case 需求当前满足裁决状态::证据不足:
        return 任务子目标回流重判状态::证据不足;
    case 需求当前满足裁决状态::当前性漂移:
        return 任务子目标回流重判状态::当前性漂移;
    case 需求当前满足裁决状态::引用冲突:
        return 任务子目标回流重判状态::引用冲突;
    case 需求当前满足裁决状态::不可比较:
        return 任务子目标回流重判状态::不可比较;
    case 需求当前满足裁决状态::入口拒绝:
        return 任务子目标回流重判状态::入口拒绝;
    case 需求当前满足裁决状态::许可拒绝:
        return 任务子目标回流重判状态::许可拒绝;
    case 需求当前满足裁决状态::资源失败:
        return 任务子目标回流重判状态::资源失败;
    default:
        return 任务子目标回流重判状态::内部错误;
    }
}

任务子目标回流重判状态 映射初次状态(
    需求初次筹办准备状态 状态) noexcept {
    switch (状态) {
    case 需求初次筹办准备状态::幂等冲突:
        return 任务子目标回流重判状态::幂等冲突;
    case 需求初次筹办准备状态::已有当前任务:
        return 任务子目标回流重判状态::当前任务冲突;
    case 需求初次筹办准备状态::证据不足:
        return 任务子目标回流重判状态::证据不足;
    case 需求初次筹办准备状态::当前性漂移:
        return 任务子目标回流重判状态::当前性漂移;
    case 需求初次筹办准备状态::引用冲突:
        return 任务子目标回流重判状态::引用冲突;
    case 需求初次筹办准备状态::不可比较:
        return 任务子目标回流重判状态::不可比较;
    case 需求初次筹办准备状态::入口拒绝:
        return 任务子目标回流重判状态::入口拒绝;
    case 需求初次筹办准备状态::许可拒绝:
        return 任务子目标回流重判状态::许可拒绝;
    case 需求初次筹办准备状态::资源失败:
        return 任务子目标回流重判状态::资源失败;
    default:
        return 任务子目标回流重判状态::内部错误;
    }
}

bool 回流记录可消费(const L2任务子目标承接记录事实& 记录) noexcept {
    return 记录.状态 ==
            L2任务子目标承接记录状态::子需求已回流待父需求重判
        && 有效(记录.身份.值) && 有效(记录.任务.值)
        && 有效(记录.父需求.值)
        && 记录.子需求 && 有效(记录.子需求->值)
        && 记录.回流 && L2任务子目标回流材料有效(*记录.回流)
        && !记录.生命周期.退出事实代次;
}

任务子目标回流重判结果 失败结果(
    任务子目标回流重判状态 状态) noexcept {
    任务子目标回流重判结果 结果;
    结果.状态 = 状态;
    return 结果;
}

std::optional<任务子目标回流后继筹办工作包> 重构后继工作包(
    L2任务结构服务& 任务服务,
    const L2任务子目标承接记录结构服务& 记录服务,
    const 任务子目标回流重判请求& 请求,
    const L2任务后继筹办准备记录事实& 后继,
    std::uint64_t 观察代次) noexcept {
    if (观察代次 == 0 || !有效(后继.身份.值)
        || 后继.触发请求身份 != 请求.请求身份
        || 后继.运行代次 != 请求.运行代次
        || 后继.准备幂等身份.值 != 请求.回流记录.值.值)
        return std::nullopt;
    const auto 记录历史 = 记录服务.读取任务子目标承接记录({
        {L2结构合同版本, 观察代次}, L2读取类别::历史,
        请求.回流记录, 后继.来源共同事实截止});
    const auto 后继历史 = 任务服务.读取后继筹办准备记录({
        {L2结构合同版本, 观察代次}, L2读取类别::历史,
        后继.身份, 后继.准备发布事实代次});
    const auto 权威历史 = 任务服务.读取筹办轮次权威记录({
        {L2结构合同版本, 观察代次}, L2读取类别::历史,
        后继.轮次权威, 后继.准备发布事实代次});
    const auto 首次历史 = 任务服务.读取首次初次筹办准备记录({
        {L2结构合同版本, 观察代次}, L2读取类别::历史,
        后继.首次准备记录, 后继.准备发布事实代次});
    if (!记录历史.成功() || !记录历史.记录
        || !回流记录可消费(*记录历史.记录)
        || 记录历史.记录->任务 != 后继.任务
        || !后继历史.成功() || !后继历史.后继准备记录
        || *后继历史.后继准备记录 != 后继
        || !权威历史.成功() || !权威历史.轮次权威
        || 权威历史.轮次权威->任务 != 后继.任务
        || 权威历史.轮次权威->需求列表项 != 后继.需求列表项
        || 权威历史.轮次权威->首次准备记录 != 后继.首次准备记录
        || !首次历史.成功() || !首次历史.首次准备记录
        || 首次历史.首次准备记录->任务 != 后继.任务
        || 首次历史.首次准备记录->需求列表项 != 后继.需求列表项)
        return std::nullopt;

    任务子目标回流后继筹办工作包 工作包;
    工作包.合同版本 = 任务子目标回流重判合同版本;
    工作包.运行代次 = 请求.运行代次;
    工作包.任务 = 后继.任务;
    工作包.回流记录 = 请求.回流记录;
    工作包.父需求 = 记录历史.记录->父需求;
    工作包.需求列表项 = 后继.需求列表项;
    工作包.后继准备记录 = 后继;
    工作包.原共同事实截止G0 = 后继.来源共同事实截止;
    工作包.准备发布事实代次G1 = 后继.准备发布事实代次;
    return 任务子目标回流后继筹办工作包完整(工作包)
        ? std::optional{工作包} : std::nullopt;
}

} // namespace 海中鱼巣::任务子目标回流重判内部

export namespace 海中鱼巣 {

class 任务子目标回流重判提供者 final {
public:
    任务子目标回流重判提供者(
        const L2需求结构服务& 需求服务,
        L2任务结构服务& 任务服务,
        const L2任务子目标承接记录结构服务& 记录服务,
        const 运行期只读查询组合器& 查询组合器,
        需求初次筹办准备提供者& 初次筹办提供者) noexcept
        : 需求服务_(需求服务), 任务服务_(任务服务),
          记录服务_(记录服务), 查询组合器_(查询组合器),
          初次筹办提供者_(初次筹办提供者) {}

    任务子目标回流重判提供者(const 任务子目标回流重判提供者&) = delete;
    任务子目标回流重判提供者& operator=(
        const 任务子目标回流重判提供者&) = delete;
    任务子目标回流重判提供者(任务子目标回流重判提供者&&) = delete;
    任务子目标回流重判提供者& operator=(
        任务子目标回流重判提供者&&) = delete;

    任务子目标回流重判结果 重判父需求并准备筹办(
        任务子目标回流重判请求 请求) noexcept {
        using namespace 任务子目标回流重判内部;
        try {
            if (!任务子目标回流重判请求有效(请求))
                return 失败结果(任务子目标回流重判状态::入口拒绝);
            const L2结构幂等身份 处理幂等身份{请求.回流记录.值.值};

            auto 恢复请求头 = 请求.请求头;
            auto 后继读取 = 任务服务_.按后继筹办准备幂等身份读取记录(
                {恢复请求头, 处理幂等身份});
            if (!后继读取.成功()
                && 后继读取.结果头.状态 == L2结构状态::入口拒绝
                && 后继读取.结果头.事实截止代次 != 0
                && 后继读取.结果头.事实截止代次
                    != 恢复请求头.期望事实代次) {
                恢复请求头.期望事实代次 = 后继读取.结果头.事实截止代次;
                后继读取 = 任务服务_.按后继筹办准备幂等身份读取记录(
                    {恢复请求头, 处理幂等身份});
            }
            if (!后继读取.成功())
                return 失败结果(映射结构状态(后继读取.结果头.状态));
            if (后继读取.后继准备记录) {
                const auto 工作包 = 重构后继工作包(任务服务_, 记录服务_,
                    请求, *后继读取.后继准备记录,
                    后继读取.结果头.事实截止代次);
                if (!工作包)
                    return 失败结果(任务子目标回流重判状态::幂等冲突);
                任务子目标回流重判结果 结果;
                结果.状态 = 任务子目标回流重判状态::后继筹办精确重复;
                结果.后继筹办工作包 = *工作包;
                return 结果.已处理() ? 结果
                    : 失败结果(任务子目标回流重判状态::内部错误);
            }

            const auto 初次读取 =
                任务服务_.按初次筹办准备幂等身份读取首次记录(
                    {恢复请求头, 处理幂等身份.值});
            if (!初次读取.成功())
                return 失败结果(映射结构状态(初次读取.结果头.状态));
            if (初次读取.首次准备记录) {
                const auto 记录读取 = 记录服务_.读取任务子目标承接记录({
                    恢复请求头, L2读取类别::当前, 请求.回流记录, 0});
                if (!记录读取.成功() || !记录读取.记录
                    || !回流记录可消费(*记录读取.记录))
                    return 失败结果(任务子目标回流重判状态::记录不可消费);
                const auto& 首次记录 = *初次读取.首次准备记录;
                if (首次记录.完整请求.需求 != 记录读取.记录->父需求
                    || 首次记录.完整请求.请求身份 != 请求.请求身份
                    || 首次记录.完整请求.运行代次 != 请求.运行代次
                    || 首次记录.完整请求.准备幂等身份 != 处理幂等身份.值
                    || 首次记录.完整请求.任务建立幂等身份 != 处理幂等身份)
                    return 失败结果(任务子目标回流重判状态::幂等冲突);
                需求初次筹办准备请求 原请求;
                原请求.合同版本 = 首次记录.完整请求.外层合同版本;
                原请求.准备幂等身份 = {
                    首次记录.完整请求.准备幂等身份};
                原请求.请求身份 = 首次记录.完整请求.请求身份;
                原请求.运行代次 = 首次记录.完整请求.运行代次;
                原请求.请求头 = 首次记录.完整请求.请求头;
                原请求.需求 = 首次记录.完整请求.需求;
                原请求.任务建立幂等身份 =
                    首次记录.完整请求.任务建立幂等身份;
                const auto 初次结果 =
                    初次筹办提供者_.形成唯一任务与初次筹办工作包(原请求);
                if (!初次结果.成功() || !初次结果.工作包)
                    return 失败结果(映射初次状态(初次结果.状态));
                任务子目标回流重判结果 结果;
                结果.状态 = 任务子目标回流重判状态::初次筹办精确重复;
                结果.初次筹办工作包 = *初次结果.工作包;
                return 结果.已处理() ? 结果
                    : 失败结果(任务子目标回流重判状态::内部错误);
            }

            const auto G0 = 恢复请求头.期望事实代次;
            if (G0 != 请求.请求头.期望事实代次)
                return 失败结果(任务子目标回流重判状态::当前性漂移);
            const auto 记录读取 = 记录服务_.读取任务子目标承接记录({
                请求.请求头, L2读取类别::当前, 请求.回流记录, 0});
            if (!记录读取.成功() || !记录读取.记录)
                return 失败结果(记录读取.结果头.状态 == L2结构状态::未找到
                    || 记录读取.结果头.状态 == L2结构状态::已退出
                    ? 任务子目标回流重判状态::记录不可消费
                    : 映射结构状态(记录读取.结果头.状态));
            const auto& 记录 = *记录读取.记录;
            if (!回流记录可消费(记录))
                return 失败结果(任务子目标回流重判状态::记录不可消费);

            const auto 需求读取 = 需求服务_.读取需求完整({
                请求.请求头, L2读取类别::当前, 记录.父需求, 0});
            const auto 成员读取 = 需求服务_.读取需求成员列表({
                请求.请求头, L2读取类别::当前, 记录.父需求, 0});
            if (!需求读取.成功() || !需求读取.需求
                || !成员读取.成功() || !成员读取.当前成员关系
                || !成员读取.所属列表项)
                return 失败结果(映射结构状态(!需求读取.成功()
                    ? 需求读取.结果头.状态 : 成员读取.结果头.状态));
            const auto 列表项读取 = 需求服务_.读取需求列表项完整({
                请求.请求头, L2读取类别::当前,
                成员读取.所属列表项->身份, 0});
            if (!列表项读取.成功() || !列表项读取.列表项)
                return 失败结果(映射结构状态(列表项读取.结果头.状态));
            const auto 当前任务读取 = 任务服务_.按需求列表项读取当前任务({
                请求.请求头, 列表项读取.列表项->身份});
            if (!当前任务读取.成功())
                return 失败结果(映射结构状态(当前任务读取.结果头.状态));

            const auto 裁决结果 = 查询组合器_.裁决需求当前满足({
                运行期只读查询合同版本, 请求.请求身份,
                记录.父需求, G0});
            if (!裁决结果.成功() || !裁决结果.裁决)
                return 失败结果(映射裁决状态(裁决结果.状态));
            const auto& 裁决 = *裁决结果.裁决;
            if (需求读取.需求->身份 != 记录.父需求
                || 成员读取.当前成员关系->需求 != 记录.父需求
                || 成员读取.当前成员关系->列表项
                    != 列表项读取.列表项->身份
                || 裁决.事实截止代次 != G0
                || 裁决.需求事实 != *需求读取.需求
                || 裁决.当前成员关系 != *成员读取.当前成员关系
                || 裁决.所属列表项 != *列表项读取.列表项)
                return 失败结果(任务子目标回流重判状态::内部错误);
            if (裁决结果.状态 == 需求当前满足裁决状态::已满足) {
                任务子目标回流重判结果 结果;
                结果.状态 = 任务子目标回流重判状态::目标已满足不筹办;
                结果.已满足裁决 = 裁决;
                return 结果.已处理() ? 结果
                    : 失败结果(任务子目标回流重判状态::内部错误);
            }

            if (!当前任务读取.任务) {
                需求初次筹办准备请求 初次请求;
                初次请求.准备幂等身份 = {处理幂等身份.值};
                初次请求.请求身份 = 请求.请求身份;
                初次请求.运行代次 = 请求.运行代次;
                初次请求.请求头 = 请求.请求头;
                初次请求.需求 = 记录.父需求;
                初次请求.任务建立幂等身份 = 处理幂等身份;
                const auto 初次结果 =
                    初次筹办提供者_.形成唯一任务与初次筹办工作包(初次请求);
                if (!初次结果.成功() || !初次结果.工作包)
                    return 失败结果(映射初次状态(初次结果.状态));
                任务子目标回流重判结果 结果;
                结果.状态 = 初次结果.状态 == 需求初次筹办准备状态::已形成
                    ? 任务子目标回流重判状态::已形成初次筹办
                    : 任务子目标回流重判状态::初次筹办精确重复;
                结果.初次筹办工作包 = *初次结果.工作包;
                return 结果.已处理() ? 结果
                    : 失败结果(任务子目标回流重判状态::内部错误);
            }
            if (当前任务读取.任务->身份 != 记录.任务)
                return 失败结果(任务子目标回流重判状态::当前任务冲突);

            const auto 分区 = 任务服务_.按任务读取筹办轮次分区({
                请求.请求头, L2读取类别::当前, 记录.任务, 0});
            if (!分区.成功())
                return 失败结果(映射结构状态(分区.结果头.状态));
            if (分区.分区 == L2任务筹办轮次分区::遗留实例轮次)
                return 失败结果(任务子目标回流重判状态::轮次权威待迁移);
            if (分区.分区 != L2任务筹办轮次分区::统一轮次权威
                || !分区.统一当前准备)
                return 失败结果(任务子目标回流重判状态::内部错误);

            L2提交任务子目标回流后继筹办准备请求 提交请求;
            提交请求.请求头 = 请求.请求头;
            提交请求.幂等身份 = 处理幂等身份;
            提交请求.任务 = 记录.任务;
            提交请求.回流记录 = 请求.回流记录;
            提交请求.统一轮次推进.轮次权威 =
                分区.统一当前准备->轮次权威.身份;
            提交请求.统一轮次推进.首次准备记录 =
                分区.统一当前准备->首次准备记录.身份;
            if (分区.统一当前准备->当前后继准备记录) {
                提交请求.统一轮次推进.期望前一后继准备记录 =
                    分区.统一当前准备->当前后继准备记录->身份;
            }
            提交请求.统一轮次推进.期望前一筹办轮次 =
                分区.统一当前准备->当前筹办轮次;
            提交请求.统一轮次推进.准备幂等身份 = 处理幂等身份;
            提交请求.统一轮次推进.触发请求身份 = 请求.请求身份;
            提交请求.统一轮次推进.运行代次 = 请求.运行代次;
            提交请求.统一轮次推进.触发业务幂等身份 = 处理幂等身份;
            提交请求.统一轮次推进.来源共同事实截止 = G0;
            const auto 提交 =
                任务服务_.提交任务子目标回流后继筹办准备(提交请求);
            if (提交.结果头.状态 == L2结构状态::引用冲突
                && 提交.后继准备记录) {
                任务子目标回流重判结果 冲突;
                冲突.状态 = 任务子目标回流重判状态::回流触发冲突;
                冲突.冲突后继准备记录 = 提交.后继准备记录->身份;
                return 冲突;
            }
            if (!提交.成功() || !提交.后继准备记录)
                return 失败结果(映射结构状态(提交.结果头.状态));
            const auto 工作包 = 重构后继工作包(任务服务_, 记录服务_,
                请求, *提交.后继准备记录, 提交.结果头.事实截止代次);
            if (!工作包)
                return 失败结果(任务子目标回流重判状态::内部错误);
            任务子目标回流重判结果 结果;
            结果.状态 = 提交.结果头.状态 == L2结构状态::已提交
                ? 任务子目标回流重判状态::已形成后继筹办
                : 任务子目标回流重判状态::后继筹办精确重复;
            结果.后继筹办工作包 = *工作包;
            return 结果.已处理() ? 结果
                : 失败结果(任务子目标回流重判状态::内部错误);
        } catch (const std::bad_alloc&) {
            return 任务子目标回流重判内部::失败结果(
                任务子目标回流重判状态::资源失败);
        } catch (const std::length_error&) {
            return 任务子目标回流重判内部::失败结果(
                任务子目标回流重判状态::资源失败);
        } catch (...) {
            return 任务子目标回流重判内部::失败结果(
                任务子目标回流重判状态::内部错误);
        }
    }

private:
    const L2需求结构服务& 需求服务_;
    L2任务结构服务& 任务服务_;
    const L2任务子目标承接记录结构服务& 记录服务_;
    const 运行期只读查询组合器& 查询组合器_;
    需求初次筹办准备提供者& 初次筹办提供者_;
};

} // namespace 海中鱼巣
