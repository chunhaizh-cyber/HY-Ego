module;

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <functional>
#include <mutex>
#include <new>
#include <optional>
#include <span>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.内部治理.服务.实例方法执行;

import 海中鱼巣.领域.服务.L2方法结构;

export import 海中鱼巣.领域.内部治理.服务.任务执行派发门控;

export namespace 海中鱼巣 {

class 实例方法稳定动作端口 {
public:
    virtual ~实例方法稳定动作端口() = default;
    virtual L2方法稳定动作键 稳定动作键() const noexcept = 0;
    virtual 实例方法技术许可结果 读取技术许可(
        const 实例方法技术许可请求&) const noexcept = 0;
    virtual 实例方法动作返回 执行动作(
        const 实例方法动作调用&) noexcept = 0;
};

class 实例方法执行提供者 final {
public:
    explicit 实例方法执行提供者(
        std::span<std::reference_wrapper<实例方法稳定动作端口>> 动作端口组) noexcept {
        try {
            if (动作端口组.empty()) {
                可用_ = true;
                return;
            }
            动作端口组_.reserve(动作端口组.size());
            for (auto 端口 : 动作端口组) {
                const auto 键 = 端口.get().稳定动作键();
                if (!L2方法稳定动作键有效(键)
                    || std::any_of(动作端口组_.begin(), 动作端口组_.end(),
                        [&](const auto& 已有) { return 已有.first == 键; })) {
                    动作端口组_.clear();
                    return;
                }
                动作端口组_.emplace_back(键, 端口);
            }
            可用_ = 动作端口组_.size() == 动作端口组.size();
        } catch (...) {
            动作端口组_.clear();
            可用_ = false;
        }
    }

    实例方法技术许可结果 读取动作技术许可(
        const 实例方法技术许可请求& 请求) const noexcept {
        if (!可用_) return 许可失败(实例方法技术许可状态::端口冲突);
        if (!实例方法技术许可请求有效(请求))
            return 许可失败(实例方法技术许可状态::合同不匹配);
        try {
            std::lock_guard 锁(互斥_);
            const auto 端口 = 查找端口_已锁定(请求.当前动作入口.稳定动作键);
            if (!端口) return 许可失败(实例方法技术许可状态::端口不存在);
            const auto 结果 = 端口->get().读取技术许可(请求);
            if (!实例方法技术许可结果形状有效(结果))
                return 许可失败(实例方法技术许可状态::内部错误);
            if (!结果.成功()) return 结果;
            if (!实例方法技术许可见证绑定请求(*结果.许可见证, 请求))
                return 许可失败(实例方法技术许可状态::当前性漂移);
            const auto 冲突 = std::find_if(许可缓存_.begin(), 许可缓存_.end(),
                [&](const auto& 已有) { return 同一冻结动作(已有.请求, 请求); });
            if (冲突 != 许可缓存_.end()) {
                if (冲突->请求 != 请求 || 冲突->结果 != 结果)
                    return 许可失败(实例方法技术许可状态::当前性漂移);
            } else {
                许可缓存_.push_back({请求, 结果});
            }
            return 结果;
        } catch (const std::bad_alloc&) {
            return 许可失败(实例方法技术许可状态::资源失败);
        } catch (...) {
            return 许可失败(实例方法技术许可状态::内部错误);
        }
    }

    任务动作预计动态形成结果 形成逐动作预计动态(
        const 任务强类型执行请求& 请求) const noexcept {
        if (!任务执行强类型请求基本有效(请求)) return {};
        try {
            任务动作预计动态形成结果 结果;
            结果.预计动态组.reserve(请求.完整有序冻结动作范围.size());
            for (const auto& 动作 : 请求.完整有序冻结动作范围) {
                结果.预计动态组.push_back({1, 请求.执行幂等身份,
                    动作.顺序, 动作.动作入口, 动作.稳定动作键,
                    动作.作用主体, 动作.作用场景, 动作.预期结果材料,
                    动作.结果验证合同, 动作.动作归因合同});
            }
            结果.已形成 = !结果.预计动态组.empty();
            return 结果.成功() ? 结果 : 任务动作预计动态形成结果{};
        } catch (...) {
            return {};
        }
    }

    实例方法执行结果 执行已冻结实例方法(
        const 实例方法执行请求& 请求) noexcept {
        if (!可用_) return 执行失败(实例方法动作返回状态::技术拒绝);
        if (!任务执行强类型请求基本有效(请求))
            return 执行失败(实例方法动作返回状态::技术拒绝);
        const auto 预计动态 = 形成逐动作预计动态(请求);
        if (!预计动态.成功())
            return 执行失败(实例方法动作返回状态::技术拒绝);
        try {
            std::lock_guard 锁(互斥_);
            const auto 已有 = std::find_if(执行缓存_.begin(), 执行缓存_.end(),
                [&](const auto& 项) {
                    return 项.请求.执行幂等身份 == 请求.执行幂等身份;
                });
            if (已有 != 执行缓存_.end()) {
                if (已有->请求 != 请求)
                    return 执行失败(实例方法动作返回状态::幂等冲突);
                if (!已有->结果.成功()) return 已有->结果;
                auto 重放 = 已有->结果;
                重放.状态 = 实例方法动作返回状态::精确重复;
                重放.待验证材料->执行提供者状态 =
                    实例方法动作返回状态::精确重复;
                return 重放.成功() ? 重放
                    : 执行失败(实例方法动作返回状态::内部错误);
            }

            std::vector<任务动作键返回> 返回组;
            返回组.reserve(请求.完整有序冻结动作范围.size());
            任务动作待验证材料 材料;
            材料.合同版本 = 1;
            材料.执行幂等身份 = 请求.执行幂等身份;
            材料.任务 = 请求.任务;
            材料.任务轮次 = 请求.任务轮次;
            材料.筹办轮次 = 请求.筹办轮次;
            材料.执行轮次 = 请求.执行轮次;
            材料.冻结 = 请求.冻结;
            材料.冻结版本 = 请求.冻结版本;
            材料.实例方法 = 请求.实例方法;
            材料.方法 = 请求.方法;
            材料.方法内容版本 = 请求.方法内容版本;
            材料.执行进入治理动作 = 请求.执行进入治理动作.身份;
            材料.派发冻结 = 请求.派发冻结;
            材料.预计动态组 = 预计动态.预计动态组;
            材料.运行代次 = 请求.运行代次;
            执行缓存_.push_back({请求,
                执行失败(实例方法动作返回状态::内部错误)});
            auto& 缓存 = 执行缓存_.back();
            for (std::size_t i = 0; i < 请求.完整有序冻结动作范围.size(); ++i) {
                const auto& 冻结动作 = 请求.完整有序冻结动作范围[i];
                const auto& 许可见证 = 请求.派发冻结.技术许可证据.逐项许可见证[i];
                const auto 许可 = std::find_if(许可缓存_.begin(), 许可缓存_.end(),
                    [&](const auto& 项) {
                        return 项.请求.任务 == 请求.任务
                            && 项.请求.任务轮次 == 请求.任务轮次
                            && 项.请求.筹办轮次 == 请求.筹办轮次
                            && 项.请求.执行轮次 == 请求.执行轮次
                            && 项.请求.冻结 == 请求.冻结
                            && 项.请求.冻结版本 == 请求.冻结版本
                            && 项.请求.实例方法 == 请求.实例方法
                            && 项.请求.方法 == 请求.方法
                            && 项.请求.方法内容版本 == 请求.方法内容版本
                            && 项.请求.完整有序冻结动作范围
                                == 请求.完整有序冻结动作范围
                            && 项.请求.当前动作入口.身份 == 冻结动作.动作入口
                            && 项.结果.许可见证
                            && *项.结果.许可见证 == 许可见证;
                    });
                if (许可 == 许可缓存_.end()) {
                    缓存.结果 = 执行失败(实例方法动作返回状态::技术拒绝);
                    return 缓存.结果;
                }
                const auto 端口 = 查找端口_已锁定(许可见证.稳定动作键);
                if (!端口) {
                    缓存.结果 = 执行失败(实例方法动作返回状态::技术拒绝);
                    return 缓存.结果;
                }
                实例方法动作调用 调用{许可->请求, 许可见证,
                    请求.执行进入治理动作, 请求.派发冻结,
                    请求.适用授权, 请求.授权收口幂等身份,
                    请求.执行幂等身份};
                实例方法动作返回 返回;
                try {
                    返回 = 端口->get().执行动作(调用);
                } catch (...) {
                    缓存.结果 = 执行失败(实例方法动作返回状态::内部错误);
                    return 缓存.结果;
                }
                if (!返回.成功()) {
                    缓存.结果 = 执行失败(返回.状态);
                    return 缓存.结果;
                }
                if (!返回.动作键返回
                    || 返回.动作键返回->顺序 != 冻结动作.顺序
                    || 返回.动作键返回->动作入口 != 冻结动作.动作入口
                    || 返回.动作键返回->稳定动作键 != 许可见证.稳定动作键
                    || (i != 0 && 返回.动作键返回->动作开始时间
                        < 返回组.back().动作结束时间)) {
                    缓存.结果 = 执行失败(实例方法动作返回状态::内部错误);
                    return 缓存.结果;
                }
                返回组.push_back(*返回.动作键返回);
            }

            const bool 全部精确重复 = std::all_of(返回组.begin(), 返回组.end(),
                [](const auto& 返回) {
                    return 返回.状态 == 实例方法动作返回状态::精确重复;
                });
            const auto 提供者状态 = 全部精确重复
                ? 实例方法动作返回状态::精确重复
                : 实例方法动作返回状态::动作已结束;
            材料.动作键逐项返回 = std::move(返回组);
            材料.动作开始时间 = 材料.动作键逐项返回.front().动作开始时间;
            材料.动作结束时间 = 材料.动作键逐项返回.back().动作结束时间;
            材料.执行提供者状态 = 提供者状态;
            缓存.结果 = {提供者状态, std::move(材料)};
            return 缓存.结果.成功() ? 缓存.结果
                : (缓存.结果 = 执行失败(实例方法动作返回状态::内部错误));
        } catch (const std::bad_alloc&) {
            return 执行失败(实例方法动作返回状态::资源失败);
        } catch (...) {
            return 执行失败(实例方法动作返回状态::内部错误);
        }
    }

private:
    struct 许可缓存项 final {
        实例方法技术许可请求 请求;
        实例方法技术许可结果 结果;
    };

    struct 执行缓存项 final {
        实例方法执行请求 请求;
        实例方法执行结果 结果;
    };

    static 实例方法技术许可结果 许可失败(
        实例方法技术许可状态 状态) noexcept {
        return {状态, std::nullopt, 0};
    }

    static 实例方法执行结果 执行失败(
        实例方法动作返回状态 状态) noexcept {
        return {状态, std::nullopt};
    }

    static bool 同一冻结动作(const 实例方法技术许可请求& 左,
        const 实例方法技术许可请求& 右) noexcept {
        return 左.任务 == 右.任务 && 左.任务轮次 == 右.任务轮次
            && 左.筹办轮次 == 右.筹办轮次 && 左.执行轮次 == 右.执行轮次
            && 左.冻结 == 右.冻结 && 左.冻结版本 == 右.冻结版本
            && 左.实例方法 == 右.实例方法 && 左.方法 == 右.方法
            && 左.方法内容版本 == 右.方法内容版本
            && 左.当前动作入口.身份 == 右.当前动作入口.身份;
    }

    std::optional<std::reference_wrapper<实例方法稳定动作端口>>
    查找端口_已锁定(L2方法稳定动作键 键) const noexcept {
        const auto 找到 = std::find_if(动作端口组_.begin(), 动作端口组_.end(),
            [&](const auto& 项) { return 项.first == 键; });
        if (找到 == 动作端口组_.end()) return std::nullopt;
        return 找到->second;
    }

    bool 可用_ = false;
    std::vector<std::pair<L2方法稳定动作键,
        std::reference_wrapper<实例方法稳定动作端口>>> 动作端口组_;
    mutable std::mutex 互斥_;
    mutable std::vector<许可缓存项> 许可缓存_;
    std::vector<执行缓存项> 执行缓存_;
};

} // namespace 海中鱼巣
