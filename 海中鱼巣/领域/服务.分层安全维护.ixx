// 文件规则：本模块只编排已发布安全事实、纯值维护候选和不透明外部事务包，不生成稳定身份。
module;

#include "../核心/句柄.h"

#include <new>
#include <optional>
#include <utility>

export module 海中鱼巣.领域.服务.分层安全维护;

import 海中鱼巣.领域.协议.分层安全维护;
import 海中鱼巣.领域.算法.分层安全维护;
import 海中鱼巣.领域.数据操作.分层安全;

export namespace 海中鱼巣 {

class 安全维护事实提供者 {
public:
    virtual ~安全维护事实提供者() = default;
    virtual 安全维护事实来源结果 读取已发布安全维护事实(
        const 安全维护事实来源请求& 请求) const = 0;
};

class 分层安全维护服务 final {
public:
    分层安全维护服务(
        分层安全数据操作& 数据操作,
        安全维护事实提供者& 事实提供者,
        安全维护外部事实参与提供者& 外部参与提供者) noexcept
        : 数据操作_(数据操作),
          事实提供者_(事实提供者),
          外部参与提供者_(外部参与提供者) {
    }

    分层安全维护服务(const 分层安全维护服务&) = delete;
    分层安全维护服务& operator=(const 分层安全维护服务&) = delete;

    安全维护结果 评估并维护安全层(
        const 安全维护请求& 请求) {
        try {
            const 安全维护事实来源请求 来源请求{
                请求.自我,
                请求.维护族,
                请求.适用场景,
                请求.期望当前值版本,
                请求.事实截止版本};
            auto 事实结果 = 事实提供者_.读取已发布安全维护事实(来源请求);
            if (事实结果.结果分类 != 安全结果分类::已形成) {
                return {事实结果.结果分类, std::nullopt};
            }
            if (!事实结果.载荷) {
                return {安全结果分类::内部不一致, std::nullopt};
            }
            const auto& 事实 = *事实结果.载荷;
            if (事实.自我 != 请求.自我
                || 事实.维护族 != 请求.维护族
                || 事实.适用场景 != 请求.适用场景
                || 事实.当前.自我 != 请求.自我
                || 事实.当前.维护族 != 请求.维护族) {
                return {安全结果分类::内部不一致, std::nullopt};
            }
            if (事实.当前值版本 != 请求.期望当前值版本
                || 事实.事实截止版本 != 请求.事实截止版本) {
                return {安全结果分类::版本漂移, std::nullopt};
            }

            auto 候选结果 = 计算分层安全维护候选(
                事实.定义,
                事实.当前,
                事实,
                请求);
            if (!候选结果.载荷) {
                return {候选结果.结果分类, std::nullopt};
            }
            if (候选结果.载荷->整数变化量 == 0) {
                return 数据操作_.提交安全维护候选(
                    请求,
                    *候选结果.载荷,
                    std::nullopt);
            }
            if (候选结果.结果分类 != 安全结果分类::已维护
                || !请求.外部事实身份规格
                || !身份规格有效(*请求.外部事实身份规格)) {
                return {安全结果分类::入口拒绝, std::nullopt};
            }
            const 安全维护外部事实规格 外部规格{
                请求.幂等主键,
                请求.自我,
                请求.维护族,
                请求.适用场景,
                *请求.外部事实身份规格,
                事实.当前.当前状态,
                候选结果.载荷->前值,
                候选结果.载荷->后值,
                候选结果.载荷->整数变化量,
                候选结果.载荷->维护方向,
                请求.当前单调时间,
                候选结果.载荷->来源已发布事实批次,
                事实.定义.被动维护提交方法,
                事实.来源版本};
            auto 外部结果 =
                外部参与提供者_.形成安全维护外部事实参与包(外部规格);
            if (外部结果.结果分类 != 安全结果分类::已形成) {
                return {外部结果.结果分类, std::nullopt};
            }
            if (!外部结果.载荷 || !外部结果.载荷->参与包) {
                return {安全结果分类::内部不一致, std::nullopt};
            }
            return 数据操作_.提交安全维护候选(
                请求,
                *候选结果.载荷,
                std::move(外部结果.载荷));
        } catch (const std::bad_alloc&) {
            return {安全结果分类::资源失败, std::nullopt};
        } catch (...) {
            return {安全结果分类::内部不一致, std::nullopt};
        }
    }

private:
    static bool 身份规格有效(
        const 安全维护外部事实身份规格& 规格) noexcept {
        return 稳定主键有效(规格.后安全特征值稳定主键)
            && 稳定主键有效(规格.后状态稳定主键)
            && 稳定主键有效(规格.状态变化动态稳定主键)
            && 规格.后安全特征值稳定主键.命名域
                == static_cast<std::uint64_t>(
                    节点稳定主键命名域::特征值身份)
            && 规格.后状态稳定主键.命名域
                == static_cast<std::uint64_t>(
                    节点稳定主键命名域::状态身份)
            && 规格.状态变化动态稳定主键.命名域
                == static_cast<std::uint64_t>(
                    节点稳定主键命名域::动态身份);
    }

    分层安全数据操作& 数据操作_;
    安全维护事实提供者& 事实提供者_;
    安全维护外部事实参与提供者& 外部参与提供者_;
};

}
