export namespace 海中鱼巣 {

inline constexpr L1所有者范围建立幂等身份 方法所有者建立身份{
    0x4C32'4D45'5448'0001ULL};

class L2方法结构服务;

class L2方法所有者交付 final {
public:
    L2方法所有者交付() = delete;
    L2方法所有者交付(const L2方法所有者交付&) = delete;
    L2方法所有者交付& operator=(const L2方法所有者交付&) = delete;
    L2方法所有者交付(L2方法所有者交付&&) noexcept = default;
    L2方法所有者交付& operator=(L2方法所有者交付&&) = delete;

private:
    explicit L2方法所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}

    friend std::optional<L2方法所有者交付> 尝试形成L2方法所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2方法结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2方法所有者交付> 尝试形成L2方法所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

}

namespace 海中鱼巣::L2方法结构内部 {

inline constexpr L1所有者范围写入幂等身份 方法身份来源登记幂等身份{
    0x4C32'4944'5352'430BULL};
inline constexpr L1所有者范围写入幂等身份 方法根结构登记幂等身份{
    0x4C32'4D52'4F4F'0001ULL};

inline constexpr std::uint32_t 方法族锚点本地键值 = 0x020B'6001U;
inline constexpr std::uint32_t 方法族归属关系类型本地键值 = 0x020B'6002U;
inline constexpr std::uint32_t 方法根角色锚点本地键值 = 0x020B'6101U;
inline constexpr std::uint32_t 方法根角色关系类型本地键值 = 0x020B'6102U;
inline constexpr std::uint32_t 首次请求见证属性类型本地键值 = 0x020B'6103U;

inline constexpr std::uint32_t 根方法节点本地键值 = 0x020B'1001U;
inline constexpr std::uint32_t 方法族归属关系本地键值 = 0x020B'1002U;
inline constexpr std::uint32_t 方法根角色关系本地键值 = 0x020B'1003U;
inline constexpr std::uint32_t 首次请求见证值本地键值 = 0x020B'1004U;
inline constexpr std::int64_t 方法族归属角色值 = 1;

// 诊断责任：无适用错误分支；服务内部判断唯一方法登记根角色。
bool 方法登记根角色有效(L2方法登记根角色 角色) noexcept {
    return 角色 == L2方法登记根角色::方法登记根;
}

// 诊断责任：无适用错误分支；服务内部校验组读版本，零守卫保留最新快照语义。
bool 方法登记根组读取请求有效(
    const L2当前方法登记根组读取请求& 请求) noexcept {
    return L2结构请求头合同有效(请求.请求头);
}

// 诊断责任：无适用错误分支；服务内部校验单根读取版本、守卫和角色。
bool 方法登记根读取请求有效(
    const L2当前方法登记根读取请求& 请求) noexcept {
    return L2结构请求头合同有效(请求.请求头)
        && 请求.请求头.期望事实代次 != 0
        && 方法登记根角色有效(请求.角色);
}

struct 当前代次读取值 final {
    L1所有者范围读取状态 状态 = L1所有者范围读取状态::入口拒绝;
    std::uint64_t 事实代次 = 0;
};

struct 方法身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

struct 方法根结构定位 final {
    L1结构所有者身份 所有者;
    稳定编码 角色锚点;
    稳定编码 角色关系类型;
    稳定编码 首次见证属性类型;
    std::uint64_t 建立事实代次 = 0;
};

// 诊断责任：无适用错误分支；把 L1 当前事实代次读取映射为 owner 读取状态。
当前代次读取值 读取当前事实代次(const L1事实基座服务& 第一层服务) noexcept {
    const auto 读取 = 第一层服务.读取中性当前事实代次({L1中性CRUD合同版本});
    L1所有者范围读取状态 状态 = L1所有者范围读取状态::内部不一致;
    switch (读取.状态) {
    case L1中性读取状态::成功:
        状态 = L1所有者范围读取状态::成功;
        break;
    case L1中性读取状态::入口拒绝:
        状态 = L1所有者范围读取状态::入口拒绝;
        break;
    case L1中性读取状态::未找到:
        状态 = L1所有者范围读取状态::未找到;
        break;
    case L1中性读取状态::已退出:
        状态 = L1所有者范围读取状态::已退出;
        break;
    case L1中性读取状态::属性未设置:
        状态 = L1所有者范围读取状态::属性未设置;
        break;
    case L1中性读取状态::许可拒绝:
        状态 = L1所有者范围读取状态::许可拒绝;
        break;
    case L1中性读取状态::资源失败:
        状态 = L1所有者范围读取状态::资源失败;
        break;
    case L1中性读取状态::内部不一致:
        break;
    }
    if (读取.合同版本 != L1中性CRUD合同版本)
        状态 = L1所有者范围读取状态::内部不一致;
    return {状态, 读取.事实代次};
}

// 诊断责任：无适用错误分支；判断登记首次或精确重复回显是否完整。
bool 登记写入结果完整(const L1所有者范围写入结果& 写入,
    L1结构所有者身份 所有者, L1所有者范围写入幂等身份 幂等身份,
    std::size_t 映射数量) noexcept {
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    return 写入.合同版本 == L1所有者范围CRUD合同版本
        && 写入.所有者 == 所有者 && 写入.写入幂等身份 == 幂等身份
        && 写入.事实代次 != 0 && (首次完整 || 重复完整)
        && 写入.新编码映射.size() == 映射数量;
}

// 诊断责任：向上送出；未知、重复或零编码映射令构造失败。
稳定编码 取得唯一登记编码(const L1所有者范围写入结果& 写入,
    std::uint32_t 本地键值) {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 写入.新编码映射) {
        if (键.值 != 本地键值) continue;
        if (找到 || !有效(编码))
            throw std::runtime_error("L2 method registration mapping is invalid");
        找到 = 编码;
    }
    if (!找到)
        throw std::runtime_error("L2 method registration mapping is missing");
    return *找到;
}

// 诊断责任：向上送出；登记节点历史读回不完整令构造失败。
L1所有者范围节点事实 读取登记节点(const L1事实基座服务& 第一层服务,
    L1结构所有者身份 所有者, 稳定编码 编码, 节点种类 种类,
    std::optional<L1所有者范围值表示种类> 表示,
    std::uint64_t 建立事实代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    if (读取.状态 != L1所有者范围读取状态::成功
        || 读取.合同版本 != L1所有者范围CRUD合同版本
        || 读取.查询编码 != 编码 || 读取.读取事实代次 < 建立事实代次
        || !节点 || 节点->编码 != 编码 || 节点->写入所有者 != 所有者
        || 节点->种类 != 种类 || 节点->属性类型表示 != 表示
        || 节点->创建事实代次 != 建立事实代次
        || 节点->退出事实代次 || !节点->当前属性.empty())
        throw std::runtime_error("L2 method registration readback is invalid");
    return *节点;
}

// 诊断责任：向上送出；方法 owner 或族来源登记不完整令服务构造失败。
方法身份来源定位 初始化方法身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 method owner fact is invalid");

    const auto 当前 = 读取当前事实代次(第一层服务);
    if (当前.状态 != L1所有者范围读取状态::成功 || 当前.事实代次 == 0)
        throw std::runtime_error("L2 method identity registration generation failed");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 当前.事实代次;
    写集.写入幂等身份 = 方法身份来源登记幂等身份;
    写集.节点 = {
        {{方法族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{方法族归属关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (!登记写入结果完整(写入, 所有者,
            方法身份来源登记幂等身份, 2))
        throw std::runtime_error("L2 method identity registration failed");
    const auto 锚点 = 取得唯一登记编码(写入, 方法族锚点本地键值);
    const auto 类型 = 取得唯一登记编码(写入, 方法族归属关系类型本地键值);
    if (锚点 == 类型)
        throw std::runtime_error("L2 method identity registration aliases facts");
    (void)读取登记节点(第一层服务, 所有者, 锚点, 节点种类::普通,
        std::nullopt, 写入.事实代次);
    (void)读取登记节点(第一层服务, 所有者, 类型, 节点种类::普通,
        std::nullopt, 写入.事实代次);
    return {所有者, 锚点, 类型, 写入.事实代次};
}

// 诊断责任：向上送出；方法根角色和首次见证类型必须同 owner 原子登记并正式读回。
方法根结构定位 初始化方法根结构(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 当前 = 读取当前事实代次(第一层服务);
    if (当前.状态 != L1所有者范围读取状态::成功 || 当前.事实代次 == 0)
        throw std::runtime_error("L2 method root registration generation failed");
    const auto 所有者 = 写入端口.所有者身份();
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 当前.事实代次;
    写集.写入幂等身份 = 方法根结构登记幂等身份;
    写集.节点 = {
        {{方法根角色锚点本地键值}, 节点种类::普通, std::nullopt},
        {{方法根角色关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{首次请求见证属性类型本地键值}, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (!登记写入结果完整(写入, 所有者,
            方法根结构登记幂等身份, 3))
        throw std::runtime_error("L2 method root registration failed");
    const auto 角色锚点 = 取得唯一登记编码(写入, 方法根角色锚点本地键值);
    const auto 角色类型 = 取得唯一登记编码(写入, 方法根角色关系类型本地键值);
    const auto 见证类型 = 取得唯一登记编码(写入, 首次请求见证属性类型本地键值);
    const std::vector<std::uint64_t> 编码组{
        角色锚点.值, 角色类型.值, 见证类型.值};
    auto 排序编码 = 编码组;
    std::sort(排序编码.begin(), 排序编码.end());
    if (std::adjacent_find(排序编码.begin(), 排序编码.end()) != 排序编码.end())
        throw std::runtime_error("L2 method root registration aliases facts");
    (void)读取登记节点(第一层服务, 所有者, 角色锚点,
        节点种类::普通, std::nullopt, 写入.事实代次);
    (void)读取登记节点(第一层服务, 所有者, 角色类型,
        节点种类::普通, std::nullopt, 写入.事实代次);
    (void)读取登记节点(第一层服务, 所有者, 见证类型,
        节点种类::属性类型, L1所有者范围值表示种类::U64组,
        写入.事实代次);
    return {所有者, 角色锚点, 角色类型, 见证类型,
        写入.事实代次};
}

// 诊断责任：无适用错误分支；纯值映射覆盖全部 L1 一致读取状态。
L2结构状态 映射一致读取状态(L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::成功:
        return L2结构状态::已读取;
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值映射覆盖全部 owner 写入状态。
L2结构状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功:
        return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝:
        return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝:
        return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突:
        return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突:
        return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；所有非成功根组结果保持空载荷和零变更。
L2当前方法登记根组读取结果 形成根组失败(
    L2结构状态 状态, std::uint64_t 事实截止代次 = 0) noexcept {
    return {{L2结构合同版本, 状态, 事实截止代次, std::nullopt}, {}};
}

// 诊断责任：无适用错误分支；登记节点在当前闭包中的固定形状只作纯值校验。
bool 登记节点当前完整(const L1所有者范围节点事实& 节点,
    L1结构所有者身份 所有者, 稳定编码 编码, 节点种类 种类,
    std::optional<L1所有者范围值表示种类> 表示,
    std::uint64_t 建立事实代次) noexcept {
    return 节点.编码 == 编码 && 节点.写入所有者 == 所有者
        && 节点.种类 == 种类 && 节点.属性类型表示 == 表示
        && 节点.创建事实代次 == 建立事实代次
        && !节点.退出事实代次 && 节点.当前属性.empty();
}

// 诊断责任：向上送出；一次 L1 闭包许可内形成 0—1 个方法登记根的同截止正式负载。
L2当前方法登记根组读取结果 读取全部当前方法登记根核心(
    const L1事实基座服务& 第一层服务,
    const 方法身份来源定位& 来源定位,
    const 方法根结构定位& 本体定位,
    const L2当前方法登记根组读取请求& 请求) {
    L1所有者范围一致关系类型闭包读取请求 L1请求;
    L1请求.合同版本 = L1所有者范围一致关系类型闭包读取合同版本;
    L1请求.期望事实代次 = 请求.请求头.期望事实代次;
    L1请求.所有者 = {来源定位.所有者};
    L1请求.关系类型闭包 = {{本体定位.角色关系类型,
        {本体定位.首次见证属性类型}, {来源定位.族归属关系类型},
        {}, {}, {}, {}}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致关系类型闭包投影(
        L1请求);
    const bool 顶层空载荷 = 读取.所有者.empty() && 读取.节点.empty()
        && 读取.关系.empty() && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty()
        && 读取.关系类型闭包.empty();
    if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
        const bool 头完整 = 读取.合同版本
                == L1所有者范围一致关系类型闭包读取合同版本
            && 读取.期望事实代次 == 请求.请求头.期望事实代次;
        return 形成根组失败(头完整 && 顶层空载荷
                ? 映射一致读取状态(读取.状态)
                : L2结构状态::内部不一致,
            读取.读取事实代次);
    }
    if (读取.合同版本 != L1所有者范围一致关系类型闭包读取合同版本
        || 读取.期望事实代次 != 请求.请求头.期望事实代次
        || 读取.读取事实代次 == 0
        || (请求.请求头.期望事实代次 != 0
            && 读取.读取事实代次 != 请求.请求头.期望事实代次)
        || 读取.所有者.size() != 1 || !读取.节点.empty()
        || !读取.关系.empty() || !读取.值.empty() || !读取.属性值.empty()
        || !读取.源关系组.empty() || !读取.目标关系组.empty()
        || 读取.关系类型闭包.size() != 1)
        return 形成根组失败(L2结构状态::内部不一致, 读取.读取事实代次);

    const auto 截止 = 读取.读取事实代次;
    const auto& 所有者项 = 读取.所有者.front();
    if (所有者项.查询所有者 != 来源定位.所有者
        || 所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实
        || 所有者项.所有者事实->所有者 != 来源定位.所有者
        || 所有者项.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者项.所有者事实->创建事实代次 == 0
        || 所有者项.所有者事实->创建事实代次 > 截止
        || 所有者项.所有者事实->退出事实代次)
        return 形成根组失败(L2结构状态::内部不一致, 截止);

    const auto& 闭包 = 读取.关系类型闭包.front();
    if (闭包.入口关系类型节点 != 本体定位.角色关系类型
        || 闭包.状态 != L1所有者范围一致当前读取项目状态::成功
        || !闭包.关系类型事实
        || !登记节点当前完整(*闭包.关系类型事实, 来源定位.所有者,
            本体定位.角色关系类型, 节点种类::普通, std::nullopt,
            本体定位.建立事实代次))
        return 形成根组失败(L2结构状态::内部不一致, 截止);

    if (闭包.成员.size() > 1)
        return 形成根组失败(L2结构状态::内部不一致, 截止);
    std::vector<L2方法登记根事实> 根组;
    根组.reserve(闭包.成员.size());
    for (const auto& 成员 : 闭包.成员) {
        if (成员.关系.写入所有者 != 来源定位.所有者
            || 成员.关系.关系类型节点 != 本体定位.角色关系类型
            || 成员.关系.源节点 != 成员.源节点.编码
            || 成员.关系.目标节点 != 成员.目标节点.编码
            || 成员.关系.目标节点 != 本体定位.角色锚点
            || 成员.关系.退出事实代次
            || 成员.源节点.写入所有者 != 来源定位.所有者
            || 成员.源节点.种类 != 节点种类::普通
            || 成员.源节点.属性类型表示 || 成员.源节点.退出事实代次
            || 成员.源节点.创建事实代次 != 成员.关系.创建事实代次
            || !登记节点当前完整(成员.目标节点, 来源定位.所有者,
                本体定位.角色锚点, 节点种类::普通, std::nullopt,
                本体定位.建立事实代次)
            || 成员.源节点属性值.size() != 1
            || 成员.源节点源关系组.size() != 1
            || !成员.源节点目标关系组.empty()
            || !成员.目标节点属性值.empty()
            || !成员.目标节点源关系组.empty()
            || !成员.目标节点目标关系组.empty())
            return 形成根组失败(L2结构状态::内部不一致, 截止);

        const auto 角色值 = 成员.关系.角色或顺序;
        if (角色值 != 1)
            return 形成根组失败(L2结构状态::内部不一致, 截止);
        const auto 角色 = static_cast<L2方法登记根角色>(角色值);
        if (!方法登记根角色有效(角色))
            return 形成根组失败(L2结构状态::内部不一致, 截止);

        const auto& 属性项 = 成员.源节点属性值.front();
        if (属性项.节点 != 成员.源节点.编码
            || 属性项.属性类型 != 本体定位.首次见证属性类型
            || 属性项.状态 != L1所有者范围一致当前读取项目状态::成功
            || !属性项.投影)
            return 形成根组失败(L2结构状态::内部不一致, 截止);
        const auto& 属性槽 = 属性项.投影->属性槽;
        const auto& 见证值 = 属性项.投影->当前值事实;
        const auto* 见证材料 = std::get_if<std::vector<std::uint64_t>>(
            &见证值.材料);
        if (成员.源节点.当前属性.size() != 1
            || 成员.源节点.当前属性.front() != 属性槽
            || 属性槽.属性类型节点 != 本体定位.首次见证属性类型
            || 属性槽.当前值 != 见证值.编码
            || 见证值.写入所有者 != 来源定位.所有者
            || 见证值.所属节点 != 成员.源节点.编码
            || 见证值.属性类型节点 != 本体定位.首次见证属性类型
            || 见证值.来源节点 != 成员.源节点.编码
            || 见证值.创建事实代次 != 成员.源节点.创建事实代次
            || 见证值.退出事实代次 || !见证材料
            || 见证材料->size() != 2 || (*见证材料)[0] == 0
            || (*见证材料)[1] == 0)
            return 形成根组失败(L2结构状态::内部不一致, 截止);

        const auto& 族组 = 成员.源节点源关系组.front();
        if (族组.端点节点 != 成员.源节点.编码
            || 族组.关系类型节点 != 来源定位.族归属关系类型
            || 族组.状态 != L1所有者范围一致当前读取项目状态::成功
            || !族组.关系类型事实
            || !登记节点当前完整(*族组.关系类型事实,
                来源定位.所有者, 来源定位.族归属关系类型,
                节点种类::普通, std::nullopt, 来源定位.建立事实代次)
            || 族组.成员.size() != 1)
            return 形成根组失败(L2结构状态::内部不一致, 截止);
        const auto& 族投影 = 族组.成员.front();
        if (族投影.关系.写入所有者 != 来源定位.所有者
            || 族投影.关系.源节点 != 成员.源节点.编码
            || 族投影.关系.目标节点 != 来源定位.族锚点
            || 族投影.关系.关系类型节点 != 来源定位.族归属关系类型
            || 族投影.关系.角色或顺序 != 方法族归属角色值
            || 族投影.关系.创建事实代次 != 成员.源节点.创建事实代次
            || 族投影.关系.退出事实代次
            || !登记节点当前完整(族投影.对端节点, 来源定位.所有者,
                来源定位.族锚点, 节点种类::普通, std::nullopt,
                来源定位.建立事实代次))
            return 形成根组失败(L2结构状态::内部不一致, 截止);

        L2节点族身份来源事实 身份来源{
            L2节点族::方法, 成员.源节点.编码, 来源定位.所有者,
            来源定位.族锚点, 来源定位.族归属关系类型,
            族投影.关系.编码, 族投影.关系.角色或顺序,
            {所有者项.所有者事实->创建事实代次,
                所有者项.所有者事实->退出事实代次},
            {成员.源节点.创建事实代次, 成员.源节点.退出事实代次},
            {族投影.对端节点.创建事实代次,
                族投影.对端节点.退出事实代次},
            {族组.关系类型事实->创建事实代次,
                族组.关系类型事实->退出事实代次},
            {族投影.关系.创建事实代次, 族投影.关系.退出事实代次}};
        L2方法登记根事实 根{
            L2方法身份{成员.源节点.编码}, std::move(身份来源),
            {角色}, {(*见证材料)[0]}, (*见证材料)[1]};
        if (!L2方法登记根事实完整(根, 截止))
            return 形成根组失败(L2结构状态::内部不一致, 截止);
        根组.push_back(std::move(根));
    }

    L2当前方法登记根组读取结果 结果{
        {L2结构合同版本, L2结构状态::已读取, 截止, std::nullopt},
        std::move(根组)};
    return 结果.成功() ? 结果
        : 形成根组失败(L2结构状态::内部不一致, 截止);
}

// 诊断责任：无适用错误分支；两项私有登记身份不进入公开幂等域。
bool 是方法保留登记幂等身份(L2结构幂等身份 身份) noexcept {
    return 身份.值 == 方法身份来源登记幂等身份.值
        || 身份.值 == 方法根结构登记幂等身份.值;
}

// 诊断责任：无适用错误分支；公开幂等身份逐值无损映射到唯一 owner 域。
L1所有者范围写入幂等身份 映射方法幂等身份(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；形成一根固定、可重放的 owner-scoped 写集。
L1所有者范围写集请求 形成方法根写集(
    const L2方法登记根建立请求& 请求,
    const 方法身份来源定位& 来源定位,
    const 方法根结构定位& 本体定位) {
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 请求.请求头.期望事实代次;
    写集.写入幂等身份 = 映射方法幂等身份(请求.幂等身份);
    写集.节点 = {{{根方法节点本地键值}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{方法族归属关系本地键值}, L1所有者范围写集本地键{根方法节点本地键值},
            来源定位.族锚点, 来源定位.族归属关系类型,
            方法族归属角色值},
        {{方法根角色关系本地键值}, L1所有者范围写集本地键{根方法节点本地键值},
            本体定位.角色锚点, 本体定位.角色关系类型,
            static_cast<std::int64_t>(请求.角色)}};
    写集.值 = {{{首次请求见证值本地键值},
        L1所有者范围写集本地键{根方法节点本地键值},
        本体定位.首次见证属性类型,
        std::vector<std::uint64_t>{请求.幂等身份.值,
            请求.请求头.期望事实代次},
        L1所有者范围写集本地键{根方法节点本地键值}}};
    写集.属性槽变更 = {{L1所有者范围写集本地键{根方法节点本地键值},
        本体定位.首次见证属性类型,
        {首次请求见证值本地键值}}};
    return 写集;
}

// 诊断责任：无适用错误分支；写失败保持空根和零变更形状。
L2方法登记根写入结果 形成根写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

struct 根写入映射 final {
    稳定编码 根节点;
    稳定编码 族归属关系;
    稳定编码 角色关系;
    稳定编码 见证值;
};

// 诊断责任：向上送出；首次写入的四项映射必须完整、互异且零额外项。
std::optional<根写入映射> 读取根写入映射(
    const L1所有者范围写入结果& 写入) {
    if (写入.新编码映射.size() != 4) return std::nullopt;
    根写入映射 映射;
    for (const auto& [键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) return std::nullopt;
        稳定编码* 目标 = nullptr;
        switch (键.值) {
        case 根方法节点本地键值: 目标 = &映射.根节点; break;
        case 方法族归属关系本地键值: 目标 = &映射.族归属关系; break;
        case 方法根角色关系本地键值: 目标 = &映射.角色关系; break;
        case 首次请求见证值本地键值: 目标 = &映射.见证值; break;
        default: return std::nullopt;
        }
        if (有效(*目标)) return std::nullopt;
        *目标 = 编码;
    }
    if (!有效(映射.根节点) || !有效(映射.族归属关系)
        || !有效(映射.角色关系) || !有效(映射.见证值))
        return std::nullopt;
    std::vector<std::uint64_t> 编码组{映射.根节点.值, 映射.族归属关系.值,
        映射.角色关系.值, 映射.见证值.值};
    std::sort(编码组.begin(), 编码组.end());
    if (std::adjacent_find(编码组.begin(), 编码组.end()) != 编码组.end())
        return std::nullopt;
    return 映射;
}

// 诊断责任：向上送出；首次规范化写集与首次结果必须由唯一写端口正式回显。
L2方法登记根写入结果 重建首次方法根(
    const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 写入端口,
    const 方法身份来源定位& 来源定位,
    const 方法根结构定位& 本体定位,
    const L2方法登记根建立请求& 请求,
    const L1所有者范围写集请求& 固定写集,
    const L1所有者范围写入结果& 提交结果) {
    const auto 首次读取 = 写入端口.读取首次写入材料(
        {L1所有者范围首次写入读取合同版本, 固定写集.写入幂等身份});
    if (首次读取.状态 != L1所有者范围读取状态::成功) {
        return 形成根写入失败(
            首次读取.状态 == L1所有者范围读取状态::资源失败
                ? L2结构状态::资源失败 : L2结构状态::内部不一致,
            首次读取.读取事实代次);
    }
    if (首次读取.合同版本 != L1所有者范围首次写入读取合同版本
        || 首次读取.所有者 != 来源定位.所有者
        || 首次读取.写入幂等身份 != 固定写集.写入幂等身份
        || 首次读取.读取事实代次 == 0
        || !首次读取.首次规范化写集 || !首次读取.首次写入结果
        || *首次读取.首次规范化写集 != 固定写集)
        return 形成根写入失败(L2结构状态::内部不一致,
            首次读取.读取事实代次);

    const auto& 首次结果 = *首次读取.首次写入结果;
    const bool 首次结果完整 = 首次结果.状态 == L1所有者范围写入状态::成功
        && 首次结果.合同版本 == L1所有者范围CRUD合同版本
        && 首次结果.所有者 == 来源定位.所有者
        && 首次结果.写入幂等身份 == 固定写集.写入幂等身份
        && 首次结果.事实代次 != 0
        && 首次结果.事实代次 <= 首次读取.读取事实代次
        && 首次结果.是否形成内存权威发布
        && 首次结果.重试边界 == L1所有者范围重试边界::不适用;
    const bool 提交首次完整 = 提交结果.状态 == L1所有者范围写入状态::成功
        && 提交结果.是否形成内存权威发布
        && 提交结果.重试边界 == L1所有者范围重试边界::不适用;
    const bool 提交重复完整 = 提交结果.状态
            == L1所有者范围写入状态::精确重复
        && !提交结果.是否形成内存权威发布
        && 提交结果.重试边界
            == L1所有者范围重试边界::原幂等身份读回收敛;
    if (!首次结果完整 || (!提交首次完整 && !提交重复完整)
        || 提交结果.合同版本 != L1所有者范围CRUD合同版本
        || 提交结果.所有者 != 首次结果.所有者
        || 提交结果.写入幂等身份 != 首次结果.写入幂等身份
        || 提交结果.事实代次 != 首次结果.事实代次
        || 提交结果.新编码映射 != 首次结果.新编码映射)
        return 形成根写入失败(L2结构状态::内部不一致,
            首次结果.事实代次);
    const auto 映射 = 读取根写入映射(首次结果);
    if (!映射)
        return 形成根写入失败(L2结构状态::内部不一致,
            首次结果.事实代次);
    const auto 截止 = 首次结果.事实代次;

    const auto 所有者读 = 第一层服务.读取历史结构所有者(
        {L1所有者范围CRUD合同版本, 来源定位.所有者});
    if (所有者读.状态 != L1所有者范围读取状态::成功
        || 所有者读.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读.查询所有者 != 来源定位.所有者
        || 所有者读.读取事实代次 < 截止 || !所有者读.所有者事实
        || 所有者读.所有者事实->所有者 != 来源定位.所有者
        || 所有者读.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读.所有者事实->创建事实代次 == 0
        || 所有者读.所有者事实->创建事实代次 > 截止
        || 所有者读.所有者事实->退出事实代次)
        return 形成根写入失败(L2结构状态::内部不一致, 截止);

    const auto 读节点 = [&](稳定编码 编码)
        -> std::optional<L1所有者范围节点事实> {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 编码 || 读取.读取事实代次 < 截止
            || !节点 || 节点->编码 != 编码
            || 节点->写入所有者 != 来源定位.所有者
            || 节点->创建事实代次 > 截止 || 节点->退出事实代次)
            return std::nullopt;
        return *节点;
    };
    const auto 读关系 = [&](稳定编码 编码)
        -> std::optional<L1所有者范围关系事实> {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 编码 || 读取.读取事实代次 < 截止
            || !关系 || 关系->编码 != 编码
            || 关系->写入所有者 != 来源定位.所有者
            || 关系->创建事实代次 > 截止 || 关系->退出事实代次)
            return std::nullopt;
        return *关系;
    };
    const auto 读值 = [&](稳定编码 编码)
        -> std::optional<L1所有者范围值事实> {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 值 = 读取.事实
            ? std::get_if<L1所有者范围值事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 编码 || 读取.读取事实代次 < 截止
            || !值 || 值->编码 != 编码
            || 值->写入所有者 != 来源定位.所有者
            || 值->创建事实代次 > 截止 || 值->退出事实代次)
            return std::nullopt;
        return *值;
    };

    const auto 根节点 = 读节点(映射->根节点);
    const auto 族锚点 = 读节点(来源定位.族锚点);
    const auto 族类型 = 读节点(来源定位.族归属关系类型);
    const auto 族关系 = 读关系(映射->族归属关系);
    const auto 角色锚点 = 读节点(本体定位.角色锚点);
    const auto 角色类型 = 读节点(本体定位.角色关系类型);
    const auto 角色关系 = 读关系(映射->角色关系);
    const auto 见证类型 = 读节点(本体定位.首次见证属性类型);
    const auto 见证值 = 读值(映射->见证值);
    if (!根节点 || !族锚点 || !族类型 || !族关系 || !角色锚点
        || !角色类型 || !角色关系 || !见证类型 || !见证值)
        return 形成根写入失败(L2结构状态::内部不一致, 截止);

    const auto* 见证材料 = std::get_if<std::vector<std::uint64_t>>(
        &见证值->材料);
    if (根节点->种类 != 节点种类::普通 || 根节点->属性类型表示
        || 根节点->创建事实代次 != 截止 || 根节点->当前属性.size() != 1
        || 根节点->当前属性.front().属性类型节点
            != 本体定位.首次见证属性类型
        || 根节点->当前属性.front().当前值 != 映射->见证值
        || !登记节点当前完整(*族锚点, 来源定位.所有者,
            来源定位.族锚点, 节点种类::普通, std::nullopt,
            来源定位.建立事实代次)
        || !登记节点当前完整(*族类型, 来源定位.所有者,
            来源定位.族归属关系类型, 节点种类::普通,
            std::nullopt, 来源定位.建立事实代次)
        || 族关系->源节点 != 映射->根节点
        || 族关系->目标节点 != 来源定位.族锚点
        || 族关系->关系类型节点 != 来源定位.族归属关系类型
        || 族关系->角色或顺序 != 方法族归属角色值
        || 族关系->创建事实代次 != 截止
        || !登记节点当前完整(*角色锚点, 来源定位.所有者,
            本体定位.角色锚点, 节点种类::普通, std::nullopt,
            本体定位.建立事实代次)
        || !登记节点当前完整(*角色类型, 来源定位.所有者,
            本体定位.角色关系类型, 节点种类::普通,
            std::nullopt, 本体定位.建立事实代次)
        || 角色关系->源节点 != 映射->根节点
        || 角色关系->目标节点 != 本体定位.角色锚点
        || 角色关系->关系类型节点 != 本体定位.角色关系类型
        || 角色关系->角色或顺序 != static_cast<std::int64_t>(请求.角色)
        || 角色关系->创建事实代次 != 截止
        || !登记节点当前完整(*见证类型, 来源定位.所有者,
            本体定位.首次见证属性类型, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组, 本体定位.建立事实代次)
        || 见证值->所属节点 != 映射->根节点
        || 见证值->属性类型节点 != 本体定位.首次见证属性类型
        || 见证值->来源节点 != 映射->根节点
        || 见证值->创建事实代次 != 截止 || !见证材料
        || *见证材料 != std::vector<std::uint64_t>{请求.幂等身份.值,
            请求.请求头.期望事实代次})
        return 形成根写入失败(L2结构状态::内部不一致, 截止);

    L2节点族身份来源事实 身份来源{
        L2节点族::方法, 映射->根节点, 来源定位.所有者,
        来源定位.族锚点, 来源定位.族归属关系类型,
        映射->族归属关系, 方法族归属角色值,
        {所有者读.所有者事实->创建事实代次,
            所有者读.所有者事实->退出事实代次},
        {根节点->创建事实代次, 根节点->退出事实代次},
        {族锚点->创建事实代次, 族锚点->退出事实代次},
        {族类型->创建事实代次, 族类型->退出事实代次},
        {族关系->创建事实代次, 族关系->退出事实代次}};
    L2方法登记根事实 根{
        L2方法身份{映射->根节点}, std::move(身份来源),
        {请求.角色}, 请求.幂等身份, 请求.请求头.期望事实代次};
    const auto 状态 = 提交结果.状态 == L1所有者范围写入状态::成功
        ? L2结构状态::已提交 : L2结构状态::精确重复;
    L2方法登记根写入结果 结果{
        {L2结构合同版本, 状态, 截止, 截止}, std::move(根)};
    return 结果.成功() ? 结果
        : 形成根写入失败(L2结构状态::内部不一致, 截止);
}

inline constexpr L1所有者范围写入幂等身份 普通方法结构登记幂等身份{
    0x4C32'4D53'5452'0001ULL};
inline constexpr std::uint32_t 普通方法锚点本地键值 = 0x020B'6201U;
inline constexpr std::uint32_t 普通方法标记关系类型本地键值 = 0x020B'6202U;
inline constexpr std::uint32_t 普通方法子事实关系类型本地键值 = 0x020B'6203U;
inline constexpr std::uint32_t 普通方法事实属性类型本地键值 = 0x020B'6204U;
inline constexpr std::uint32_t 普通方法结果键属性类型本地键值 = 0x020B'6205U;

struct 普通方法结构定位 final {
    L1结构所有者身份 所有者;
    稳定编码 普通方法锚点;
    稳定编码 标记关系类型;
    稳定编码 子事实关系类型;
    稳定编码 事实属性类型;
    稳定编码 结果键属性类型;
    std::uint64_t 建立事实代次 = 0;
};

enum class 普通方法子事实类别 : std::uint8_t {
    治理虚拟存在 = 1,
    作用对象绑定 = 2,
    参数 = 3,
    禁止项 = 4,
    适用范围 = 5,
    条件 = 6,
    结果 = 7,
    动作入口 = 8,
    生命周期 = 9
};

struct 普通方法子事实内部 final {
    普通方法子事实类别 类别 = 普通方法子事实类别::治理虚拟存在;
    std::uint64_t 位置 = 0;
    稳定编码 节点;
    稳定编码 关系;
    std::vector<稳定编码> 值;
};

struct 普通方法内部事实 final {
    L2普通方法事实 公开事实;
    稳定编码 方法节点;
    稳定编码 族关系;
    稳定编码 标记关系;
    稳定编码 元数据值;
    std::vector<普通方法子事实内部> 子事实;
};

struct 普通方法内部读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    std::optional<普通方法内部事实> 事实;
};

// 诊断责任：无适用错误分支；完整 64 位幂等身份一对一映射。
L1所有者范围写入幂等身份 映射普通方法幂等身份(
    L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：向上送出；五项普通方法私有登记必须首次或精确重复完整读回。
普通方法结构定位 初始化普通方法结构(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 当前 = 读取当前事实代次(第一层服务);
    if (当前.状态 != L1所有者范围读取状态::成功 || 当前.事实代次 == 0)
        throw std::runtime_error("L2 ordinary method registration generation failed");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 当前.事实代次;
    写集.写入幂等身份 = 普通方法结构登记幂等身份;
    写集.节点 = {
        {{普通方法锚点本地键值}, 节点种类::普通, std::nullopt},
        {{普通方法标记关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{普通方法子事实关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{普通方法事实属性类型本地键值}, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组},
        {{普通方法结果键属性类型本地键值}, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (!登记写入结果完整(写入, 所有者,
            普通方法结构登记幂等身份, 5))
        throw std::runtime_error("L2 ordinary method registration failed");
    普通方法结构定位 定位{所有者,
        取得唯一登记编码(写入, 普通方法锚点本地键值),
        取得唯一登记编码(写入, 普通方法标记关系类型本地键值),
        取得唯一登记编码(写入, 普通方法子事实关系类型本地键值),
        取得唯一登记编码(写入, 普通方法事实属性类型本地键值),
        取得唯一登记编码(写入, 普通方法结果键属性类型本地键值),
        写入.事实代次};
    std::vector<std::uint64_t> 编码{定位.普通方法锚点.值,
        定位.标记关系类型.值, 定位.子事实关系类型.值,
        定位.事实属性类型.值, 定位.结果键属性类型.值};
    std::sort(编码.begin(), 编码.end());
    if (std::adjacent_find(编码.begin(), 编码.end()) != 编码.end())
        throw std::runtime_error("L2 ordinary method registration aliases facts");
    (void)读取登记节点(第一层服务, 所有者, 定位.普通方法锚点,
        节点种类::普通, std::nullopt, 写入.事实代次);
    (void)读取登记节点(第一层服务, 所有者, 定位.标记关系类型,
        节点种类::普通, std::nullopt, 写入.事实代次);
    (void)读取登记节点(第一层服务, 所有者, 定位.子事实关系类型,
        节点种类::普通, std::nullopt, 写入.事实代次);
    (void)读取登记节点(第一层服务, 所有者, 定位.事实属性类型,
        节点种类::属性类型, L1所有者范围值表示种类::U64组,
        写入.事实代次);
    (void)读取登记节点(第一层服务, 所有者, 定位.结果键属性类型,
        节点种类::属性类型, L1所有者范围值表示种类::U64组,
        写入.事实代次);
    return 定位;
}

std::int64_t 形成子事实关系角色(
    普通方法子事实类别 类别, std::uint64_t 位置) {
    constexpr std::uint64_t 位置掩码 = (1ULL << 56U) - 1U;
    if (位置 >= 位置掩码) throw std::length_error("ordinary method group is too large");
    return static_cast<std::int64_t>(
        (static_cast<std::uint64_t>(类别) << 56U) | (位置 + 1U));
}

bool 解析子事实关系角色(std::int64_t 角色,
    普通方法子事实类别& 类别, std::uint64_t& 位置) noexcept {
    if (角色 <= 0) return false;
    const auto 无符号角色 = static_cast<std::uint64_t>(角色);
    const auto 类别值 = static_cast<std::uint8_t>(无符号角色 >> 56U);
    const auto 位置值 = 无符号角色 & ((1ULL << 56U) - 1U);
    if (类别值 < static_cast<std::uint8_t>(普通方法子事实类别::治理虚拟存在)
        || 类别值 > static_cast<std::uint8_t>(普通方法子事实类别::生命周期)
        || 位置值 == 0) return false;
    类别 = static_cast<普通方法子事实类别>(类别值);
    位置 = 位置值 - 1U;
    return true;
}

void 加入原始值负载(std::vector<std::uint64_t>& 负载,
    const L2原始值材料& 材料) {
    std::visit([&](const auto& 值) {
        using 值类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<值类型, std::int64_t>) {
            负载.push_back(1); 负载.push_back(1);
            负载.push_back(std::bit_cast<std::uint64_t>(值));
        } else if constexpr (std::is_same_v<值类型, std::vector<std::int64_t>>) {
            负载.push_back(2); 负载.push_back(值.size());
            for (const auto 项 : 值)
                负载.push_back(std::bit_cast<std::uint64_t>(项));
        } else if constexpr (std::is_same_v<值类型, std::vector<std::uint64_t>>) {
            负载.push_back(3); 负载.push_back(值.size());
            负载.insert(负载.end(), 值.begin(), 值.end());
        } else {
            负载.push_back(4); 负载.push_back(1); 负载.push_back(值.编码.值);
        }
    }, 材料);
}

bool 读取原始值负载(const std::vector<std::uint64_t>& 负载,
    std::size_t& 位置, L2原始值材料& 材料) {
    if (位置 + 2 > 负载.size()) return false;
    const auto 标签 = 负载[位置++];
    const auto 数量 = 负载[位置++];
    if (数量 > 负载.size() - 位置) return false;
    if (标签 == 1 && 数量 == 1) {
        材料 = std::bit_cast<std::int64_t>(负载[位置++]);
    } else if (标签 == 2) {
        std::vector<std::int64_t> 值;
        值.reserve(static_cast<std::size_t>(数量));
        for (std::uint64_t i = 0; i < 数量; ++i)
            值.push_back(std::bit_cast<std::int64_t>(负载[位置++]));
        材料 = std::move(值);
    } else if (标签 == 3) {
        std::vector<std::uint64_t> 值;
        值.reserve(static_cast<std::size_t>(数量));
        for (std::uint64_t i = 0; i < 数量; ++i) 值.push_back(负载[位置++]);
        材料 = std::move(值);
    } else if (标签 == 4 && 数量 == 1 && 负载[位置] != 0) {
        材料 = L2独立材料引用{稳定编码{负载[位置++]}};
    } else return false;
    return true;
}

std::vector<std::uint64_t> 形成规格负载(
    const L2方法规格材料& 规格, 稳定编码 来源) {
    std::vector<std::uint64_t> 负载{1, 规格.角色, 规格.顺序};
    加入原始值负载(负载, 规格.值);
    负载.push_back(来源.值);
    return 负载;
}

bool 解析规格负载(const std::vector<std::uint64_t>& 负载,
    L2方法规格材料& 规格, 稳定编码& 来源) {
    if (负载.size() < 7 || 负载[0] != 1) return false;
    规格.角色 = 负载[1]; 规格.顺序 = 负载[2];
    std::size_t 位置 = 3;
    if (!读取原始值负载(负载, 位置, 规格.值)
        || 位置 + 1 != 负载.size()) return false;
    来源 = 稳定编码{负载[位置]};
    return L2方法规格材料有效(规格) && 有效(来源);
}

std::vector<std::uint64_t> 形成结果规格键负载(
    const L2方法结果规格键& 键) {
    auto 负载 = 形成规格负载(键.作用对象绑定, 稳定编码{1});
    负载.back() = 键.场景.值.值;
    负载.push_back(键.特征定义.值.值);
    负载.push_back(键.目标状态合同.值.值);
    负载.push_back(键.规格版本.值);
    return 负载;
}

struct 普通方法写集构造结果 final {
    L1所有者范围写集请求 写集;
    L1所有者范围写集本地键 方法节点键;
};

L1所有者范围写集本地键 分配普通方法本地键(std::uint32_t& 下一个) {
    if (下一个 == std::numeric_limits<std::uint32_t>::max())
        throw std::length_error("ordinary method write set is too large");
    return {下一个++};
}

普通方法写集构造结果 形成普通方法新增写集(
    std::uint64_t 期望代次, L1所有者范围写入幂等身份 幂等身份,
    const 方法身份来源定位& 来源定位, const 普通方法结构定位& 定位,
    const L2普通方法提交材料& 方法) {
    普通方法写集构造结果 构造;
    auto& 写集 = 构造.写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 期望代次;
    写集.写入幂等身份 = 幂等身份;
    std::uint32_t 下一个 = 0x020B'2000U;
    构造.方法节点键 = 分配普通方法本地键(下一个);
    写集.节点.push_back({构造.方法节点键, 节点种类::普通, std::nullopt});

    const auto 族关系键 = 分配普通方法本地键(下一个);
    写集.关系.push_back({族关系键, 构造.方法节点键, 来源定位.族锚点,
        来源定位.族归属关系类型, 方法族归属角色值});
    const auto 标记关系键 = 分配普通方法本地键(下一个);
    写集.关系.push_back({标记关系键, 构造.方法节点键, 定位.普通方法锚点,
        定位.标记关系类型, 1});

    const auto 元数据值键 = 分配普通方法本地键(下一个);
    std::vector<std::uint64_t> 元数据{1, 方法.内容版本.值,
        方法.规格版本.值, 方法.生命周期版本.值,
        std::bit_cast<std::uint64_t>(方法.生命周期发生时间),
        方法.生命周期来源稳定编码.值};
    写集.值.push_back({元数据值键, 构造.方法节点键, 定位.事实属性类型,
        std::move(元数据), 构造.方法节点键});
    写集.属性槽变更.push_back(
        {构造.方法节点键, 定位.事实属性类型, 元数据值键});

    auto 加入子事实 = [&](普通方法子事实类别 类别,
        std::uint64_t 位置, std::vector<std::uint64_t> 负载,
        std::optional<std::vector<std::uint64_t>> 结果键 = std::nullopt) {
        const auto 节点键 = 分配普通方法本地键(下一个);
        const auto 关系键 = 分配普通方法本地键(下一个);
        const auto 值键 = 分配普通方法本地键(下一个);
        写集.节点.push_back({节点键, 节点种类::普通, std::nullopt});
        写集.关系.push_back({关系键, 构造.方法节点键, 节点键,
            定位.子事实关系类型, 形成子事实关系角色(类别, 位置)});
        写集.值.push_back({值键, 节点键, 定位.事实属性类型,
            std::move(负载), 构造.方法节点键});
        写集.属性槽变更.push_back({节点键, 定位.事实属性类型, 值键});
        if (结果键) {
            const auto 键值键 = 分配普通方法本地键(下一个);
            写集.值.push_back({键值键, 节点键, 定位.结果键属性类型,
                std::move(*结果键), 构造.方法节点键});
            写集.属性槽变更.push_back(
                {节点键, 定位.结果键属性类型, 键值键});
        }
    };

    加入子事实(普通方法子事实类别::治理虚拟存在, 0, {1});
    for (std::size_t i = 0; i < 方法.作用对象绑定.size(); ++i)
        加入子事实(普通方法子事实类别::作用对象绑定, i,
            形成规格负载(方法.作用对象绑定[i].规格,
                方法.作用对象绑定[i].来源稳定编码));
    for (std::size_t i = 0; i < 方法.参数.size(); ++i)
        加入子事实(普通方法子事实类别::参数, i,
            形成规格负载(方法.参数[i].规格, 方法.参数[i].来源稳定编码));
    for (std::size_t i = 0; i < 方法.禁止项.size(); ++i)
        加入子事实(普通方法子事实类别::禁止项, i,
            形成规格负载(方法.禁止项[i].规格, 方法.禁止项[i].来源稳定编码));
    for (std::size_t i = 0; i < 方法.适用范围.size(); ++i)
        加入子事实(普通方法子事实类别::适用范围, i,
            形成规格负载(方法.适用范围[i].规格,
                方法.适用范围[i].来源稳定编码));
    for (std::size_t i = 0; i < 方法.条件.size(); ++i) {
        const auto& 项 = 方法.条件[i];
        加入子事实(普通方法子事实类别::条件, i, {1,
            项.作用对象绑定角色, 项.场景.值.值, 项.特征定义.值.值,
            项.目标状态合同.值.值, 项.来源稳定编码.值});
    }
    for (std::size_t i = 0; i < 方法.结果.size(); ++i) {
        const auto& 项 = 方法.结果[i];
        const auto* 绑定 = L2普通方法数据内部::按角色查找绑定(
            方法.作用对象绑定, 项.作用对象绑定角色);
        if (!绑定) throw std::invalid_argument("ordinary method result binding is ambiguous");
        L2方法结果规格键 键{绑定->规格, 项.场景, 项.特征定义,
            项.目标状态合同, 方法.规格版本};
        加入子事实(普通方法子事实类别::结果, i, {1,
            项.作用对象绑定角色, 项.场景.值.值, 项.特征定义.值.值,
            项.目标状态合同.值.值, 项.来源稳定编码.值},
            形成结果规格键负载(键));
    }
    加入子事实(普通方法子事实类别::动作入口, 0, {1,
        方法.动作入口.输入场景.值.值,
        方法.动作入口.输出场景.值.值,
        方法.动作入口.稳定动作键.值,
        方法.动作入口.来源稳定编码.值});
    加入子事实(普通方法子事实类别::生命周期, 0, {1,
        方法.生命周期版本.值,
        std::bit_cast<std::uint64_t>(方法.生命周期发生时间),
        方法.生命周期来源稳定编码.值});
    return 构造;
}

std::optional<稳定编码> 取得普通方法节点编码(
    const L1所有者范围写入结果& 写入,
    L1所有者范围写集本地键 方法节点键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 写入.新编码映射) {
        if (键 != 方法节点键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

void 加入普通方法退出写集(L1所有者范围写集请求& 写集,
    const 普通方法内部事实& 事实) {
    写集.退出事实.push_back(事实.方法节点);
    写集.退出事实.push_back(事实.族关系);
    写集.退出事实.push_back(事实.标记关系);
    写集.退出事实.push_back(事实.元数据值);
    for (const auto& 子 : 事实.子事实) {
        写集.退出事实.push_back(子.节点);
        写集.退出事实.push_back(子.关系);
        写集.退出事实.insert(
            写集.退出事实.end(), 子.值.begin(), 子.值.end());
    }
    std::sort(写集.退出事实.begin(), 写集.退出事实.end(),
        [](稳定编码 左, 稳定编码 右) { return 左.值 < 右.值; });
}

L2生命周期 投影普通方法生命周期(std::uint64_t 创建,
    std::optional<std::uint64_t> 退出, std::uint64_t 截止) noexcept {
    if (退出 && *退出 > 截止) 退出.reset();
    return {创建, 退出};
}

L2结构状态 映射普通方法读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::已退出: return L2结构状态::已退出;
    case L1所有者范围读取状态::属性未设置:
        return L2结构状态::属性未设置;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

普通方法内部读取结果 读取普通方法核心(
    const L1事实基座服务& 第一层服务,
    const 方法身份来源定位& 来源定位,
    const 普通方法结构定位& 定位, L2方法身份 身份,
    std::uint64_t 截止, std::uint64_t 观察代次, bool 要求当前活动) {
    const auto 失败 = [截止](L2结构状态 状态) {
        return 普通方法内部读取结果{状态, 截止, std::nullopt};
    };
    const auto 根读 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 身份.值});
    const auto* 根 = 根读.事实
        ? std::get_if<L1所有者范围节点事实>(&*根读.事实) : nullptr;
    if (根读.合同版本 != L1所有者范围CRUD合同版本
        || 根读.查询编码 != 身份.值 || 根读.读取事实代次 != 观察代次)
        return 失败(L2结构状态::内部不一致);
    if (根读.状态 != L1所有者范围读取状态::成功)
        return 失败(映射普通方法读取状态(根读.状态));
    if (!根 || 根->编码 != 身份.值 || 根->写入所有者 != 定位.所有者
        || 根->种类 != 节点种类::普通 || 根->属性类型表示
        || 根->创建事实代次 == 0)
        return 失败(L2结构状态::内部不一致);
    if (根->创建事实代次 > 截止) return 失败(L2结构状态::未找到);
    if (要求当前活动 && 根->退出事实代次
        && *根->退出事实代次 <= 截止) return 失败(L2结构状态::已退出);
    if (根->退出事实代次 && *根->退出事实代次 == 0)
        return 失败(L2结构状态::内部不一致);
    const auto 结构截止 = 根->退出事实代次 && *根->退出事实代次 <= 截止
        ? *根->退出事实代次 - 1U : 截止;

    const auto 读关系组 = [&](稳定编码 类型) {
        return 第一层服务.读取所有者范围历史关系组({
            L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 身份.值, 类型, 结构截止});
    };
    const auto 族组 = 读关系组(来源定位.族归属关系类型);
    const auto 标记组 = 读关系组(定位.标记关系类型);
    const auto 子组 = 读关系组(定位.子事实关系类型);
    const auto 关系组有效 = [&](const auto& 读取, 稳定编码 类型) {
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.方向 == L1所有者范围关系端点方向::源
            && 读取.端点节点 == 身份.值 && 读取.关系类型节点 == 类型
            && 读取.历史截止事实代次 == 结构截止
            && 读取.读取事实代次 == 观察代次;
    };
    if (!关系组有效(族组, 来源定位.族归属关系类型)
        || !关系组有效(标记组, 定位.标记关系类型)
        || !关系组有效(子组, 定位.子事实关系类型)
        || 族组.关系组.size() != 1 || 标记组.关系组.size() != 1)
        return 失败(L2结构状态::内部不一致);
    const auto& 族关系 = 族组.关系组.front();
    const auto& 标记关系 = 标记组.关系组.front();
    if (族关系.源节点 != 身份.值 || 族关系.目标节点 != 来源定位.族锚点
        || 族关系.关系类型节点 != 来源定位.族归属关系类型
        || 族关系.角色或顺序 != 方法族归属角色值
        || 标记关系.源节点 != 身份.值
        || 标记关系.目标节点 != 定位.普通方法锚点
        || 标记关系.关系类型节点 != 定位.标记关系类型
        || 标记关系.角色或顺序 != 1)
        return 失败(L2结构状态::内部不一致);

    const auto 读取负载组 = [&](稳定编码 节点, std::uint64_t 节点截止,
        std::vector<L1所有者范围值事实>& 值组) -> bool {
        const auto 读取 = 第一层服务.读取所有者范围历史属性值组(
            {L1所有者范围CRUD合同版本, 节点, 节点截止});
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.所属节点 != 节点
            || 读取.历史截止事实代次 != 节点截止
            || 读取.读取事实代次 != 观察代次) return false;
        值组 = 读取.属性值组;
        return true;
    };
    std::vector<L1所有者范围值事实> 根值组;
    if (!读取负载组(身份.值, 结构截止, 根值组) || 根值组.size() != 1)
        return 失败(L2结构状态::内部不一致);
    const auto& 元数据值 = 根值组.front();
    const auto* 元数据 = std::get_if<std::vector<std::uint64_t>>(&元数据值.材料);
    if (元数据值.所属节点 != 身份.值
        || 元数据值.属性类型节点 != 定位.事实属性类型
        || 元数据值.来源节点 != 身份.值 || !元数据 || 元数据->size() != 6
        || (*元数据)[0] != 1 || (*元数据)[1] == 0 || (*元数据)[2] == 0
        || (*元数据)[3] == 0 || (*元数据)[5] == 0)
        return 失败(L2结构状态::内部不一致);

    const auto 所有者读 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 定位.所有者});
    if (所有者读.状态 != L1所有者范围读取状态::成功
        || 所有者读.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读.读取事实代次 != 观察代次 || !所有者读.所有者事实
        || 所有者读.所有者事实->所有者 != 定位.所有者
        || 所有者读.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读.所有者事实->退出事实代次)
        return 失败(L2结构状态::内部不一致);
    const auto 族锚点 = 读取登记节点(第一层服务, 定位.所有者,
        来源定位.族锚点, 节点种类::普通, std::nullopt,
        来源定位.建立事实代次);
    const auto 族类型 = 读取登记节点(第一层服务, 定位.所有者,
        来源定位.族归属关系类型, 节点种类::普通, std::nullopt,
        来源定位.建立事实代次);
    L2节点族身份来源事实 身份来源{L2节点族::方法, 身份.值,
        定位.所有者, 来源定位.族锚点, 来源定位.族归属关系类型,
        族关系.编码, 方法族归属角色值,
        {所有者读.所有者事实->创建事实代次, std::nullopt},
        投影普通方法生命周期(根->创建事实代次, 根->退出事实代次, 截止),
        投影普通方法生命周期(族锚点.创建事实代次,
            族锚点.退出事实代次, 截止),
        投影普通方法生命周期(族类型.创建事实代次,
            族类型.退出事实代次, 截止),
        投影普通方法生命周期(族关系.创建事实代次,
            族关系.退出事实代次, 截止)};

    L2普通方法事实 公开;
    公开.方法 = 身份;
    公开.身份来源 = std::move(身份来源);
    公开.内容版本 = {(*元数据)[1]};
    公开.规格版本 = {(*元数据)[2]};
    普通方法内部事实 内部;
    内部.方法节点 = 身份.值;
    内部.族关系 = 族关系.编码;
    内部.标记关系 = 标记关系.编码;
    内部.元数据值 = 元数据值.编码;

    auto 排序关系 = 子组.关系组;
    std::sort(排序关系.begin(), 排序关系.end(),
        [](const auto& 左, const auto& 右) {
            return 左.角色或顺序 < 右.角色或顺序;
        });
    std::optional<std::pair<普通方法子事实类别, std::uint64_t>> 前一角色;
    for (const auto& 关系 : 排序关系) {
        普通方法子事实类别 类别;
        std::uint64_t 位置 = 0;
        if (!解析子事实关系角色(关系.角色或顺序, 类别, 位置)
            || 关系.源节点 != 身份.值
            || 关系.关系类型节点 != 定位.子事实关系类型
            || (前一角色 && 前一角色->first == 类别
                && 前一角色->second == 位置))
            return 失败(L2结构状态::内部不一致);
        前一角色 = std::pair{类别, 位置};
        const auto 节点读 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 关系.目标节点});
        const auto* 节点 = 节点读.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读.事实) : nullptr;
        if (节点读.状态 != L1所有者范围读取状态::成功
            || 节点读.合同版本 != L1所有者范围CRUD合同版本
            || 节点读.读取事实代次 != 观察代次 || !节点
            || 节点->编码 != 关系.目标节点
            || 节点->写入所有者 != 定位.所有者
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 != 关系.创建事实代次
            || 节点->退出事实代次 != 关系.退出事实代次)
            return 失败(L2结构状态::内部不一致);
        const auto 节点截止 = 节点->退出事实代次
                && *节点->退出事实代次 <= 截止
            ? *节点->退出事实代次 - 1U : 截止;
        std::vector<L1所有者范围值事实> 值组;
        if (!读取负载组(节点->编码, 节点截止, 值组))
            return 失败(L2结构状态::内部不一致);
        const L1所有者范围值事实* 事实值 = nullptr;
        const L1所有者范围值事实* 键值 = nullptr;
        for (const auto& 值 : 值组) {
            if (值.所属节点 != 节点->编码 || 值.来源节点 != 身份.值
                || 值.创建事实代次 != 节点->创建事实代次
                || 值.退出事实代次 != 节点->退出事实代次)
                return 失败(L2结构状态::内部不一致);
            if (值.属性类型节点 == 定位.事实属性类型) {
                if (事实值) return 失败(L2结构状态::内部不一致);
                事实值 = &值;
            } else if (值.属性类型节点 == 定位.结果键属性类型) {
                if (键值) return 失败(L2结构状态::内部不一致);
                键值 = &值;
            } else return 失败(L2结构状态::内部不一致);
        }
        const auto* 负载 = 事实值
            ? std::get_if<std::vector<std::uint64_t>>(&事实值->材料) : nullptr;
        if (!事实值 || !负载 || 负载->empty() || (*负载)[0] != 1)
            return 失败(L2结构状态::内部不一致);
        const auto 生命周期 = 投影普通方法生命周期(
            节点->创建事实代次, 节点->退出事实代次, 截止);
        普通方法子事实内部 子{类别, 位置, 节点->编码, 关系.编码,
            {事实值->编码}};
        if (键值) 子.值.push_back(键值->编码);

        if (类别 == 普通方法子事实类别::治理虚拟存在) {
            if (位置 != 0 || 负载->size() != 1
                || 有效(公开.治理虚拟存在.值))
                return 失败(L2结构状态::内部不一致);
            公开.治理虚拟存在 = L2方法治理虚拟存在身份{节点->编码};
        } else if (类别 == 普通方法子事实类别::作用对象绑定
            || 类别 == 普通方法子事实类别::参数
            || 类别 == 普通方法子事实类别::禁止项
            || 类别 == 普通方法子事实类别::适用范围) {
            L2方法规格材料 规格;
            稳定编码 来源;
            if (!解析规格负载(*负载, 规格, 来源) || 键值)
                return 失败(L2结构状态::内部不一致);
            if (类别 == 普通方法子事实类别::作用对象绑定)
                公开.作用对象绑定.push_back(L2方法作用对象绑定事实{
                    L2方法作用对象绑定身份{节点->编码}, 身份,
                    std::move(规格), 来源, 生命周期});
            else if (类别 == 普通方法子事实类别::参数)
                公开.参数.push_back(L2方法参数规格事实{
                    L2方法参数规格身份{节点->编码}, 身份,
                    std::move(规格), 来源, 生命周期});
            else if (类别 == 普通方法子事实类别::禁止项)
                公开.禁止项.push_back(L2方法禁止项规格事实{
                    L2方法禁止项规格身份{节点->编码}, 身份,
                    std::move(规格), 来源, 生命周期});
            else
                公开.适用范围.push_back(L2方法适用范围事实{
                    L2方法适用范围身份{节点->编码}, 身份,
                    std::move(规格), 来源, 生命周期});
        } else if (类别 == 普通方法子事实类别::条件
            || 类别 == 普通方法子事实类别::结果) {
            if (负载->size() != 6 || (*负载)[1] == 0 || (*负载)[2] == 0
                || (*负载)[3] == 0 || (*负载)[4] == 0 || (*负载)[5] == 0)
                return 失败(L2结构状态::内部不一致);
            const L2方法作用对象绑定事实* 绑定 = nullptr;
            for (const auto& 项 : 公开.作用对象绑定) {
                if (项.规格.角色 != (*负载)[1]) continue;
                if (绑定) return 失败(L2结构状态::内部不一致);
                绑定 = &项;
            }
            if (!绑定) return 失败(L2结构状态::内部不一致);
            if (类别 == 普通方法子事实类别::条件) {
                if (键值) return 失败(L2结构状态::内部不一致);
                公开.条件.push_back(L2方法条件事实{
                    L2方法条件身份{节点->编码}, 身份, 绑定->身份,
                    L2场景身份{稳定编码{(*负载)[2]}},
                    L2特征定义身份{稳定编码{(*负载)[3]}},
                    L2目标状态合同身份{稳定编码{(*负载)[4]}},
                    公开.规格版本, 稳定编码{(*负载)[5]}, 生命周期});
            } else {
                const auto* 键负载 = 键值
                    ? std::get_if<std::vector<std::uint64_t>>(&键值->材料) : nullptr;
                L2方法结果规格键 键{绑定->规格,
                    L2场景身份{稳定编码{(*负载)[2]}},
                    L2特征定义身份{稳定编码{(*负载)[3]}},
                    L2目标状态合同身份{稳定编码{(*负载)[4]}},
                    公开.规格版本};
                if (!键负载 || *键负载 != 形成结果规格键负载(键))
                    return 失败(L2结构状态::内部不一致);
                公开.结果.push_back(L2方法结果事实{
                    L2方法结果身份{节点->编码}, 身份, 绑定->身份,
                    键.场景, 键.特征定义, 键.目标状态合同,
                    公开.规格版本, 稳定编码{(*负载)[5]}, 生命周期});
            }
        } else if (类别 == 普通方法子事实类别::动作入口) {
            if (位置 != 0 || 负载->size() != 5 || 键值
                || L2方法动作入口身份有效(公开.动作入口.身份))
                return 失败(L2结构状态::内部不一致);
            公开.动作入口 = L2方法动作入口事实{
                L2方法动作入口身份{节点->编码}, 身份,
                L2场景身份{稳定编码{(*负载)[1]}},
                L2场景身份{稳定编码{(*负载)[2]}},
                L2方法稳定动作键{(*负载)[3]}, 公开.规格版本,
                稳定编码{(*负载)[4]}, 生命周期};
        } else if (类别 == 普通方法子事实类别::生命周期) {
            if (位置 != 0 || 负载->size() != 4 || 键值
                || L2方法生命周期版本有效(
                    公开.生命周期事实.生命周期版本))
                return 失败(L2结构状态::内部不一致);
            公开.生命周期事实 = {身份, {(*负载)[1]},
                std::bit_cast<std::int64_t>((*负载)[2]),
                {(*负载)[3]}, 生命周期};
        }
        内部.子事实.push_back(std::move(子));
    }
    const auto 按身份排序 = [](auto& 组) {
        std::sort(组.begin(), 组.end(), [](const auto& 左, const auto& 右) {
            return 左.身份.值.值 < 右.身份.值.值;
        });
    };
    按身份排序(公开.作用对象绑定); 按身份排序(公开.参数);
    按身份排序(公开.禁止项); 按身份排序(公开.适用范围);
    按身份排序(公开.条件); 按身份排序(公开.结果);
    if (公开.生命周期事实.生命周期版本.值 != (*元数据)[3]
        || std::bit_cast<std::uint64_t>(公开.生命周期事实.发生时间)
            != (*元数据)[4]
        || 公开.生命周期事实.来源稳定编码.值 != (*元数据)[5]
        || !L2普通方法事实完整(公开, 截止))
        return 失败(L2结构状态::内部不一致);
    内部.公开事实 = std::move(公开);
    return {L2结构状态::已读取, 截止, std::move(内部)};
}

} // namespace 海中鱼巣::L2方法结构内部

export namespace 海中鱼巣 {

// 诊断责任：向上送出；交付、端口或实例绑定不成立时返回空 optional。
std::optional<L2方法所有者交付> 尝试形成L2方法所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 方法所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份()
                != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务))
            return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2方法所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class L2方法结构服务 final {
public:
    // 诊断责任：向上送出；交付无效或两份私有登记失败时抛出构造异常。
    explicit L2方法结构服务(
        const L1事实基座服务& 第一层服务,
        const L2场景结构服务& 场景服务,
        const L2特征结构服务& 特征服务,
        const L2状态结构服务& 状态服务,
        L2方法所有者交付&& 方法所有者交付)
        : 第一层服务_(第一层服务),
          场景服务_(场景服务),
          特征服务_(特征服务),
          状态服务_(状态服务),
          第一层写入端口_(验证并移动交付(第一层服务, 方法所有者交付)),
          身份来源定位_(L2方法结构内部::初始化方法身份来源(
              第一层服务_, 第一层写入端口_)),
          本体结构定位_(L2方法结构内部::初始化方法根结构(
              第一层服务_, 第一层写入端口_)),
          普通方法结构定位_(L2方法结构内部::初始化普通方法结构(
              第一层服务_, 第一层写入端口_)) {}

    L2方法结构服务() = delete;
    L2方法结构服务(const L2方法结构服务&) = delete;
    L2方法结构服务& operator=(const L2方法结构服务&) = delete;
    L2方法结构服务(L2方法结构服务&&) = delete;
    L2方法结构服务& operator=(L2方法结构服务&&) = delete;

    // 诊断责任：向上送出；全部失败只经结构化结果返回，发布未知保留原请求重放。
    L2方法登记根写入结果 建立方法登记根(
        const L2方法登记根建立请求& 请求) {
        if (!L2方法登记根建立请求有效(请求)
            || L2方法结构内部::是方法保留登记幂等身份(请求.幂等身份))
            return L2方法结构内部::形成根写入失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(方法登记根写入锁_);
            const auto 预读 = L2方法结构内部::读取全部当前方法登记根核心(
                第一层服务_, 身份来源定位_, 本体结构定位_,
                {请求.请求头});
            if (预读.成功()) {
                const L2方法登记根事实* 目标角色根 = nullptr;
                for (const auto& 根 : 预读.方法根) {
                    if (根.首次幂等身份 == 请求.幂等身份) {
                        if (根.根角色.角色 != 请求.角色
                            || 根.首次期望事实代次
                                != 请求.请求头.期望事实代次)
                            return L2方法结构内部::形成根写入失败(
                                L2结构状态::幂等冲突,
                                预读.结果头.事实截止代次);
                    }
                    if (根.根角色.角色 == 请求.角色) 目标角色根 = &根;
                }
                if (目标角色根) {
                    if (目标角色根->首次幂等身份 != 请求.幂等身份)
                        return L2方法结构内部::形成根写入失败(
                            L2结构状态::引用冲突,
                            预读.结果头.事实截止代次);
                    const auto 首次截止 =
                        目标角色根->身份来源.节点生命周期.创建事实代次;
                    L2方法登记根写入结果 结果{{L2结构合同版本,
                        L2结构状态::精确重复, 首次截止, 首次截止},
                        *目标角色根};
                    return 结果.成功() ? 结果
                        : L2方法结构内部::形成根写入失败(
                            L2结构状态::内部不一致, 首次截止);
                }
            } else if (预读.结果头.状态 != L2结构状态::事实代次漂移) {
                return L2方法结构内部::形成根写入失败(
                    预读.结果头.状态, 预读.结果头.事实截止代次);
            }

            const auto 写集 = L2方法结构内部::形成方法根写集(
                请求, 身份来源定位_, 本体结构定位_);
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2方法结构内部::形成根写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2方法结构内部::映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2方法结构内部::形成根写入失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2方法结构内部::形成根写入失败(状态, 写入.事实代次);
            }
            return L2方法结构内部::重建首次方法根(
                第一层服务_, 第一层写入端口_, 身份来源定位_,
                本体结构定位_, 请求, 写集, 写入);
        } catch (const std::bad_alloc&) {
            return L2方法结构内部::形成根写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2方法结构内部::形成根写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2方法结构内部::形成根写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；单根读取复用一次全组许可且同代缺失为未找到。
    L2当前方法登记根读取结果 按角色读取当前方法登记根(
        const L2当前方法登记根读取请求& 请求) const {
        const auto 失败 = [](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2当前方法登记根读取结果{
                {L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
        };
        if (!L2方法结构内部::方法登记根读取请求有效(请求))
            return 失败(L2结构状态::入口拒绝);
        try {
            const auto 全组 = L2方法结构内部::读取全部当前方法登记根核心(
                第一层服务_, 身份来源定位_, 本体结构定位_,
                {请求.请求头});
            if (!全组.成功())
                return 失败(全组.结果头.状态, 全组.结果头.事实截止代次);
            const L2方法登记根事实* 找到 = nullptr;
            for (const auto& 根 : 全组.方法根) {
                if (根.根角色.角色 != 请求.角色) continue;
                if (找到)
                    return 失败(L2结构状态::内部不一致,
                        全组.结果头.事实截止代次);
                找到 = &根;
            }
            if (!找到)
                return 失败(L2结构状态::未找到,
                    全组.结果头.事实截止代次);
            L2当前方法登记根读取结果 结果{全组.结果头, *找到};
            return 结果.成功() && 结果.方法根->根角色.角色 == 请求.角色
                ? 结果 : 失败(L2结构状态::内部不一致,
                    全组.结果头.事实截止代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；只返回一次 L1 同许可形成的当前根组结构化结果。
    L2当前方法登记根组读取结果 读取全部当前方法登记根(
        const L2当前方法登记根组读取请求& 请求) const {
        if (!L2方法结构内部::方法登记根组读取请求有效(请求))
            return L2方法结构内部::形成根组失败(L2结构状态::入口拒绝);
        try {
            return L2方法结构内部::读取全部当前方法登记根核心(
                第一层服务_, 身份来源定位_, 本体结构定位_, 请求);
        } catch (const std::bad_alloc&) {
            return L2方法结构内部::形成根组失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2方法结构内部::形成根组失败(L2结构状态::资源失败);
        } catch (...) {
            return L2方法结构内部::形成根组失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；公开新增只接受完整材料并返回完整权威读回。
    L2普通方法写入结果 新增普通方法(const L2普通方法新增请求& 请求) {
        using namespace L2方法结构内部;
        const auto 失败 = [](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2普通方法写入结果{{L2结构合同版本, 状态, 截止,
                std::nullopt}, std::nullopt};
        };
        if (!L2普通方法新增请求有效(请求)
            || 是方法保留登记幂等身份(请求.幂等身份)
            || 请求.幂等身份.值 == 普通方法结构登记幂等身份.值)
            return 失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(普通方法写入锁_);
            const auto 幂等 = 映射普通方法幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功) {
                if (!首次.首次规范化写集 || !首次.首次写入结果)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                const auto 期望 = 形成普通方法新增写集(
                    请求.请求头.期望事实代次, 幂等, 身份来源定位_,
                    普通方法结构定位_, 请求.方法);
                if (*首次.首次规范化写集 != 期望.写集)
                    return 失败(L2结构状态::幂等冲突, 首次.读取事实代次);
                const auto 身份 = 取得普通方法节点编码(
                    *首次.首次写入结果, 期望.方法节点键);
                if (!身份 || 首次.首次写入结果->事实代次 == 0)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                const auto 读回 = 读取普通方法核心(第一层服务_,
                    身份来源定位_, 普通方法结构定位_, L2方法身份{*身份},
                    首次.首次写入结果->事实代次, 首次.读取事实代次, false);
                if (读回.状态 != L2结构状态::已读取 || !读回.事实)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                L2普通方法写入结果 结果{{L2结构合同版本,
                    L2结构状态::精确重复,
                    首次.首次写入结果->事实代次,
                    首次.首次写入结果->事实代次},
                    std::move(读回.事实->公开事实)};
                return 结果.成功() ? 结果
                    : 失败(L2结构状态::内部不一致, 首次.读取事实代次);
            }
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 失败(映射普通方法读取状态(首次.状态),
                    首次.读取事实代次);
            const auto 端点状态 = 验证普通方法端点(
                请求.方法, 请求.请求头.期望事实代次);
            if (端点状态 != L2结构状态::已读取)
                return 失败(端点状态, 请求.请求头.期望事实代次);
            const auto 构造 = 形成普通方法新增写集(
                请求.请求头.期望事实代次, 幂等, 身份来源定位_,
                普通方法结构定位_, 请求.方法);
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(
                构造.写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 失败(状态, 写入.事实代次);
            const auto 身份 = 取得普通方法节点编码(写入, 构造.方法节点键);
            const auto 观察 = 读取当前事实代次(第一层服务_);
            if (!身份 || 写入.事实代次 == 0
                || 观察.状态 != L1所有者范围读取状态::成功
                || 观察.事实代次 < 写入.事实代次)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 读回 = 读取普通方法核心(第一层服务_,
                身份来源定位_, 普通方法结构定位_, L2方法身份{*身份},
                写入.事实代次, 观察.事实代次, false);
            if (读回.状态 != L2结构状态::已读取 || !读回.事实)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            L2普通方法写入结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次},
                std::move(读回.事实->公开事实)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；替换建立新身份并原子退出旧方法完整结构。
    L2普通方法替换结果 替换普通方法(const L2普通方法替换请求& 请求) {
        using namespace L2方法结构内部;
        const auto 失败 = [](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2普通方法替换结果{{L2结构合同版本, 状态, 截止,
                std::nullopt}, std::nullopt, std::nullopt};
        };
        if (!L2普通方法替换请求有效(请求)
            || 是方法保留登记幂等身份(请求.幂等身份)
            || 请求.幂等身份.值 == 普通方法结构登记幂等身份.值)
            return 失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(普通方法写入锁_);
            const auto 幂等 = 映射普通方法幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            const auto 形成期望 = [&](std::uint64_t 观察代次)
                -> std::optional<普通方法写集构造结果> {
                const auto 旧 = 读取普通方法核心(第一层服务_, 身份来源定位_,
                    普通方法结构定位_, 请求.旧方法,
                    请求.请求头.期望事实代次, 观察代次, false);
                if (旧.状态 != L2结构状态::已读取 || !旧.事实
                    || 旧.事实->公开事实.内容版本 != 请求.旧内容版本
                    || 旧.事实->公开事实.规格版本 != 请求.旧规格版本
                    || 旧.事实->公开事实.生命周期事实.生命周期版本
                        != 请求.旧生命周期版本) return std::nullopt;
                auto 构造 = 形成普通方法新增写集(
                    请求.请求头.期望事实代次, 幂等, 身份来源定位_,
                    普通方法结构定位_, 请求.新方法);
                加入普通方法退出写集(构造.写集, *旧.事实);
                return 构造;
            };
            if (首次.状态 == L1所有者范围读取状态::成功) {
                if (!首次.首次规范化写集 || !首次.首次写入结果)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                const auto 期望 = 形成期望(首次.读取事实代次);
                if (!期望 || *首次.首次规范化写集 != 期望->写集)
                    return 失败(L2结构状态::幂等冲突, 首次.读取事实代次);
                const auto 新编码 = 取得普通方法节点编码(
                    *首次.首次写入结果, 期望->方法节点键);
                if (!新编码 || 首次.首次写入结果->事实代次 == 0)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                const auto 新读 = 读取普通方法核心(第一层服务_,
                    身份来源定位_, 普通方法结构定位_, L2方法身份{*新编码},
                    首次.首次写入结果->事实代次, 首次.读取事实代次, false);
                const auto 旧读 = 读取普通方法核心(第一层服务_,
                    身份来源定位_, 普通方法结构定位_, 请求.旧方法,
                    首次.首次写入结果->事实代次, 首次.读取事实代次, false);
                if (新读.状态 != L2结构状态::已读取 || !新读.事实
                    || 旧读.状态 != L2结构状态::已读取 || !旧读.事实)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                L2普通方法替换结果 结果{{L2结构合同版本,
                    L2结构状态::精确重复,
                    首次.首次写入结果->事实代次,
                    首次.首次写入结果->事实代次},
                    std::move(新读.事实->公开事实),
                    std::move(旧读.事实->公开事实)};
                return 结果.成功() ? 结果
                    : 失败(L2结构状态::内部不一致, 首次.读取事实代次);
            }
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 失败(映射普通方法读取状态(首次.状态),
                    首次.读取事实代次);
            if (首次.读取事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2结构状态::事实代次漂移, 首次.读取事实代次);
            const auto 旧 = 读取普通方法核心(第一层服务_, 身份来源定位_,
                普通方法结构定位_, 请求.旧方法,
                请求.请求头.期望事实代次, 首次.读取事实代次, true);
            if (旧.状态 != L2结构状态::已读取 || !旧.事实)
                return 失败(旧.状态, 旧.截止);
            if (旧.事实->公开事实.内容版本 != 请求.旧内容版本
                || 旧.事实->公开事实.规格版本 != 请求.旧规格版本
                || 旧.事实->公开事实.生命周期事实.生命周期版本
                    != 请求.旧生命周期版本)
                return 失败(L2结构状态::引用冲突, 旧.截止);
            const auto 端点状态 = 验证普通方法端点(
                请求.新方法, 请求.请求头.期望事实代次);
            if (端点状态 != L2结构状态::已读取)
                return 失败(端点状态, 请求.请求头.期望事实代次);
            auto 构造 = 形成普通方法新增写集(
                请求.请求头.期望事实代次, 幂等, 身份来源定位_,
                普通方法结构定位_, 请求.新方法);
            加入普通方法退出写集(构造.写集, *旧.事实);
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(
                构造.写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 失败(状态, 写入.事实代次);
            const auto 新编码 = 取得普通方法节点编码(写入, 构造.方法节点键);
            const auto 观察 = 读取当前事实代次(第一层服务_);
            if (!新编码 || 写入.事实代次 == 0
                || 观察.状态 != L1所有者范围读取状态::成功
                || 观察.事实代次 < 写入.事实代次)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 新读 = 读取普通方法核心(第一层服务_,
                身份来源定位_, 普通方法结构定位_, L2方法身份{*新编码},
                写入.事实代次, 观察.事实代次, false);
            const auto 旧读 = 读取普通方法核心(第一层服务_,
                身份来源定位_, 普通方法结构定位_, 请求.旧方法,
                写入.事实代次, 观察.事实代次, false);
            if (新读.状态 != L2结构状态::已读取 || !新读.事实
                || 旧读.状态 != L2结构状态::已读取 || !旧读.事实)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            L2普通方法替换结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次},
                std::move(新读.事实->公开事实),
                std::move(旧读.事实->公开事实)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；退出保留全部历史并保持 L1 引用保护结果。
    L2普通方法退出结果 退出普通方法(const L2普通方法退出请求& 请求) {
        using namespace L2方法结构内部;
        const auto 失败 = [](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2普通方法退出结果{{L2结构合同版本, 状态, 截止,
                std::nullopt}, std::nullopt};
        };
        if (!L2普通方法退出请求有效(请求)
            || 是方法保留登记幂等身份(请求.幂等身份)
            || 请求.幂等身份.值 == 普通方法结构登记幂等身份.值)
            return 失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(普通方法写入锁_);
            const auto 幂等 = 映射普通方法幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            const auto 形成期望 = [&](std::uint64_t 观察代次)
                -> std::optional<L1所有者范围写集请求> {
                const auto 原事实 = 读取普通方法核心(第一层服务_,
                    身份来源定位_, 普通方法结构定位_, 请求.方法,
                    请求.请求头.期望事实代次, 观察代次, false);
                if (原事实.状态 != L2结构状态::已读取 || !原事实.事实
                    || 原事实.事实->公开事实.内容版本 != 请求.内容版本
                    || 原事实.事实->公开事实.规格版本 != 请求.规格版本
                    || 原事实.事实->公开事实.生命周期事实.生命周期版本
                        != 请求.生命周期版本) return std::nullopt;
                L1所有者范围写集请求 写集;
                写集.合同版本 = L1所有者范围CRUD合同版本;
                写集.期望事实代次 = 请求.请求头.期望事实代次;
                写集.写入幂等身份 = 幂等;
                加入普通方法退出写集(写集, *原事实.事实);
                return 写集;
            };
            if (首次.状态 == L1所有者范围读取状态::成功) {
                if (!首次.首次规范化写集 || !首次.首次写入结果)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                const auto 期望 = 形成期望(首次.读取事实代次);
                if (!期望 || *首次.首次规范化写集 != *期望)
                    return 失败(L2结构状态::幂等冲突, 首次.读取事实代次);
                const auto 读回 = 读取普通方法核心(第一层服务_,
                    身份来源定位_, 普通方法结构定位_, 请求.方法,
                    首次.首次写入结果->事实代次, 首次.读取事实代次, false);
                if (读回.状态 != L2结构状态::已读取 || !读回.事实)
                    return 失败(L2结构状态::内部不一致, 首次.读取事实代次);
                L2普通方法退出结果 结果{{L2结构合同版本,
                    L2结构状态::精确重复,
                    首次.首次写入结果->事实代次,
                    首次.首次写入结果->事实代次},
                    std::move(读回.事实->公开事实)};
                return 结果.成功() ? 结果
                    : 失败(L2结构状态::内部不一致, 首次.读取事实代次);
            }
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 失败(映射普通方法读取状态(首次.状态),
                    首次.读取事实代次);
            if (首次.读取事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2结构状态::事实代次漂移, 首次.读取事实代次);
            const auto 当前 = 读取普通方法核心(第一层服务_, 身份来源定位_,
                普通方法结构定位_, 请求.方法,
                请求.请求头.期望事实代次, 首次.读取事实代次, true);
            if (当前.状态 != L2结构状态::已读取 || !当前.事实)
                return 失败(当前.状态, 当前.截止);
            if (当前.事实->公开事实.内容版本 != 请求.内容版本
                || 当前.事实->公开事实.规格版本 != 请求.规格版本
                || 当前.事实->公开事实.生命周期事实.生命周期版本
                    != 请求.生命周期版本)
                return 失败(L2结构状态::引用冲突, 当前.截止);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 幂等;
            加入普通方法退出写集(写集, *当前.事实);
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 失败(状态, 写入.事实代次);
            if (!写入.新编码映射.empty() || 写入.事实代次 == 0)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 观察 = 读取当前事实代次(第一层服务_);
            if (观察.状态 != L1所有者范围读取状态::成功
                || 观察.事实代次 < 写入.事实代次)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 读回 = 读取普通方法核心(第一层服务_,
                身份来源定位_, 普通方法结构定位_, 请求.方法,
                写入.事实代次, 观察.事实代次, false);
            if (读回.状态 != L2结构状态::已读取 || !读回.事实)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            L2普通方法退出结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次},
                std::move(读回.事实->公开事实)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；当前与历史读取均以前后同代守卫返回完整值。
    L2普通方法读取结果 读取普通方法(const L2普通方法读取请求& 请求) const {
        using namespace L2方法结构内部;
        const auto 失败 = [&请求](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2普通方法读取结果{{L2结构合同版本, 状态, 截止,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次,
                std::nullopt};
        };
        if (!L2普通方法读取请求有效(请求))
            return 失败(L2结构状态::入口拒绝);
        try {
            const auto 前 = 读取当前事实代次(第一层服务_);
            if (前.状态 != L1所有者范围读取状态::成功)
                return 失败(映射普通方法读取状态(前.状态), 前.事实代次);
            if (前.事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2结构状态::事实代次漂移, 前.事实代次);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            const auto 核心 = 读取普通方法核心(第一层服务_, 身份来源定位_,
                普通方法结构定位_, 请求.方法, 截止, 前.事实代次,
                请求.读取类别 == L2读取类别::当前);
            if (核心.状态 != L2结构状态::已读取 || !核心.事实)
                return 失败(核心.状态, 核心.截止);
            const auto 后 = 读取当前事实代次(第一层服务_);
            if (后.状态 != L1所有者范围读取状态::成功)
                return 失败(映射普通方法读取状态(后.状态), 后.事实代次);
            if (后.事实代次 != 前.事实代次)
                return 失败(L2结构状态::事实代次漂移, 后.事实代次);
            L2普通方法读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次,
                std::move(核心.事实->公开事实)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；候选入口只按完整结果规格键和两个预算读取。
    L2当前方法候选读取结果 按结果规格读取当前方法候选(
        const L2当前方法候选读取请求& 请求) const {
        using namespace L2方法结构内部;
        const auto 失败 = [](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2当前方法候选读取结果{{L2结构合同版本, 状态,
                截止, std::nullopt}, {}};
        };
        if (!L2当前方法候选读取请求有效(请求))
            return 失败(L2结构状态::入口拒绝);
        try {
            const auto 键负载 = 形成结果规格键负载(请求.结果规格);
            const auto 索引 = 第一层服务_.按属性类型读取所有者范围全部当前值({
                L1所有者范围属性类型当前值组读取合同版本,
                普通方法结构定位_.所有者,
                普通方法结构定位_.结果键属性类型,
                请求.请求头.期望事实代次,
                请求.最大扫描结果事实数});
            if (索引.合同版本
                    != L1所有者范围属性类型当前值组读取合同版本
                || 索引.所有者 != 普通方法结构定位_.所有者
                || 索引.属性类型节点 != 普通方法结构定位_.结果键属性类型
                || 索引.期望事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2结构状态::内部不一致, 索引.读取事实代次);
            if (索引.状态 != L1所有者范围属性类型当前值组读取状态::成功) {
                L2结构状态 状态 = L2结构状态::内部不一致;
                switch (索引.状态) {
                case L1所有者范围属性类型当前值组读取状态::入口拒绝:
                    状态 = L2结构状态::入口拒绝; break;
                case L1所有者范围属性类型当前值组读取状态::事实代次漂移:
                    状态 = L2结构状态::事实代次漂移; break;
                case L1所有者范围属性类型当前值组读取状态::数量预算不足:
                    状态 = L2结构状态::数量预算不足; break;
                case L1所有者范围属性类型当前值组读取状态::资源失败:
                    状态 = L2结构状态::资源失败; break;
                default: break;
                }
                return 失败(状态, 索引.读取事实代次);
            }
            if (索引.读取事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2结构状态::事实代次漂移, 索引.读取事实代次);
            std::vector<L2方法身份> 候选;
            for (const auto& 值 : 索引.当前值) {
                const auto* 材料 = std::get_if<std::vector<std::uint64_t>>(
                    &值.材料);
                if (值.写入所有者 != 普通方法结构定位_.所有者
                    || 值.属性类型节点 != 普通方法结构定位_.结果键属性类型
                    || 值.退出事实代次 || !材料)
                    return 失败(L2结构状态::内部不一致, 索引.读取事实代次);
                if (*材料 != 键负载) continue;
                const auto 关系组 = 第一层服务_.读取所有者范围当前目标关系组({
                    L1所有者范围CRUD合同版本, 值.所属节点,
                    普通方法结构定位_.子事实关系类型});
                if (关系组.状态 != L1所有者范围读取状态::成功
                    || 关系组.合同版本 != L1所有者范围CRUD合同版本
                    || 关系组.目标节点 != 值.所属节点
                    || 关系组.关系类型节点
                        != 普通方法结构定位_.子事实关系类型
                    || 关系组.读取事实代次 != 索引.读取事实代次
                    || 关系组.关系组.size() != 1)
                    return 失败(L2结构状态::内部不一致, 索引.读取事实代次);
                普通方法子事实类别 类别;
                std::uint64_t 位置 = 0;
                const auto& 关系 = 关系组.关系组.front();
                if (!解析子事实关系角色(关系.角色或顺序, 类别, 位置)
                    || 类别 != 普通方法子事实类别::结果
                    || 关系.写入所有者 != 普通方法结构定位_.所有者
                    || 关系.目标节点 != 值.所属节点 || 关系.退出事实代次
                    || 值.来源节点 != 关系.源节点)
                    return 失败(L2结构状态::内部不一致, 索引.读取事实代次);
                const L2方法身份 方法{关系.源节点};
                if (std::none_of(候选.begin(), 候选.end(),
                        [&](const auto& 已有) { return 已有 == 方法; })) {
                    if (候选.size() >= 请求.最大候选方法数)
                        return 失败(L2结构状态::数量预算不足,
                            索引.读取事实代次);
                    候选.push_back(方法);
                }
            }
            std::sort(候选.begin(), 候选.end(), [](const auto& 左,
                const auto& 右) { return 左.值.值 < 右.值.值; });
            for (const auto 方法 : 候选) {
                const auto 读回 = 读取普通方法({请求.请求头,
                    L2普通方法结构合同版本, L2读取类别::当前, 方法, 0});
                if (!读回.成功() || !读回.方法)
                    return 失败(规范端点读取失败(读回.结果头.状态),
                        读回.结果头.事实截止代次);
                bool 匹配 = false;
                for (const auto& 结果 : 读回.方法->结果) {
                    const L2方法作用对象绑定事实* 绑定 = nullptr;
                    for (const auto& 项 : 读回.方法->作用对象绑定)
                        if (项.身份 == 结果.作用对象绑定) {
                            if (绑定) return 失败(L2结构状态::内部不一致,
                                索引.读取事实代次);
                            绑定 = &项;
                        }
                    if (!绑定) return 失败(L2结构状态::内部不一致,
                        索引.读取事实代次);
                    if (L2方法结果规格键{绑定->规格, 结果.场景,
                            结果.特征定义, 结果.目标状态合同,
                            结果.规格版本} == 请求.结果规格)
                        匹配 = true;
                }
                if (!匹配) return 失败(
                    L2结构状态::内部不一致, 索引.读取事实代次);
            }
            const auto 后 = 读取当前事实代次(第一层服务_);
            if (后.状态 != L1所有者范围读取状态::成功)
                return 失败(映射普通方法读取状态(后.状态), 后.事实代次);
            if (后.事实代次 != 索引.读取事实代次)
                return 失败(L2结构状态::事实代次漂移, 后.事实代次);
            L2当前方法候选读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 索引.读取事实代次, std::nullopt},
                std::move(候选)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 索引.读取事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

private:
    static L2结构状态 规范端点读取失败(L2结构状态 状态) noexcept {
        switch (状态) {
        case L2结构状态::入口拒绝:
        case L2结构状态::许可拒绝:
        case L2结构状态::未找到:
        case L2结构状态::已退出:
        case L2结构状态::事实代次漂移:
        case L2结构状态::资源失败:
            return 状态;
        default:
            return L2结构状态::内部不一致;
        }
    }

    L2结构状态 验证普通方法端点(
        const L2普通方法提交材料& 方法, std::uint64_t 守卫) const {
        const L2结构请求头 请求头{L2结构合同版本, 守卫};
        const auto 验证场景 = [&](L2场景身份 身份) {
            const auto 读取 = 场景服务_.读取完整场景(
                {请求头, L2读取类别::当前, 身份, 0});
            if (读取.结果头.状态 != L2结构状态::已读取)
                return 规范端点读取失败(读取.结果头.状态);
            return 读取.结果头.合同版本 == L2结构合同版本
                    && 读取.结果头.事实截止代次 == 守卫
                    && !读取.结果头.变更事实代次 && 读取.场景
                    && 读取.场景->身份 == 身份
                ? L2结构状态::已读取 : L2结构状态::内部不一致;
        };
        const auto 验证特征 = [&](L2特征定义身份 身份) {
            const auto 读取 = 特征服务_.读取完整统一特征定义(
                {请求头, L2读取类别::当前, 身份, 0});
            if (读取.结果头.状态 != L2结构状态::已读取)
                return 规范端点读取失败(读取.结果头.状态);
            return 读取.成功() && 读取.结果头.事实截止代次 == 守卫
                    && 读取.特征定义 && 读取.特征定义->身份 == 身份
                ? L2结构状态::已读取 : L2结构状态::内部不一致;
        };
        const auto 验证合同 = [&](L2目标状态合同身份 身份) {
            const auto 读取 = 状态服务_.读取完整目标状态合同(
                {请求头, L2读取类别::当前, 身份, 0});
            if (读取.结果头.状态 != L2结构状态::已读取)
                return 规范端点读取失败(读取.结果头.状态);
            return 读取.成功() && 读取.结果头.事实截止代次 == 守卫
                    && 读取.合同 && 读取.合同->身份 == 身份
                ? L2结构状态::已读取 : L2结构状态::内部不一致;
        };
        auto 状态 = 验证场景(方法.动作入口.输入场景);
        if (状态 != L2结构状态::已读取) return 状态;
        状态 = 验证场景(方法.动作入口.输出场景);
        if (状态 != L2结构状态::已读取) return 状态;
        const auto 验证条件结果 = [&](const auto& 组) {
            for (const auto& 项 : 组) {
                auto 当前 = 验证场景(项.场景);
                if (当前 != L2结构状态::已读取) return 当前;
                当前 = 验证特征(项.特征定义);
                if (当前 != L2结构状态::已读取) return 当前;
                当前 = 验证合同(项.目标状态合同);
                if (当前 != L2结构状态::已读取) return 当前;
            }
            return L2结构状态::已读取;
        };
        状态 = 验证条件结果(方法.条件);
        return 状态 == L2结构状态::已读取
            ? 验证条件结果(方法.结果) : 状态;
    }

    // 诊断责任：向上送出；交付必须有效且绑定同一 L1 实例。
    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务, L2方法所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument("L2 method owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    const L1事实基座服务& 第一层服务_;
    const L2场景结构服务& 场景服务_;
    const L2特征结构服务& 特征服务_;
    const L2状态结构服务& 状态服务_;
    L1所有者范围写端口 第一层写入端口_;
    L2方法结构内部::方法身份来源定位 身份来源定位_;
    L2方法结构内部::方法根结构定位 本体结构定位_;
    L2方法结构内部::普通方法结构定位 普通方法结构定位_;
    std::mutex 方法登记根写入锁_;
    std::mutex 普通方法写入锁_;
};

} // namespace 海中鱼巣
