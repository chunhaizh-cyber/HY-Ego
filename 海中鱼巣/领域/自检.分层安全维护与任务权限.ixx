struct 隔离权限服务夹具 final {
    隔离安全因果图提供者 图提供者;
    隔离安全维护事实提供者 维护提供者;
    隔离安全任务事实提供者 任务提供者;
    安全因果分层服务 因果服务{图提供者};
    安全任务权限服务 权限服务{因果服务, 维护提供者, 任务提供者};

    安全权限层来源选择 形成选择() const noexcept {
        return {
            形成句柄(102),
            形成句柄(103),
            形成句柄(104),
            形成句柄(105),
            8};
    }

    权限读取请求 形成权限请求() const {
        return {
            形成句柄(100),
            形成句柄(101),
            {形成选择()},
            20,
            5,
            安全权限规则版本};
    }
};

inline bool SP_A13_单层权限边界与来源形成() noexcept {
    try {
        隔离权限服务夹具 夹具;
        const auto 请求 = 夹具.形成权限请求();
        const auto 低位结果 = 夹具.权限服务.读取安全权限快照(请求);
        if (低位结果.结果分类 != 安全结果分类::已形成
            || !低位结果.载荷
            || 低位结果.载荷->保留权限[0] != 安全权限满刻度
            || 低位结果.载荷->释放倍率[0] != 0
            || 夹具.图提供者.调用次数 != 1
            || 夹具.维护提供者.调用次数 != 1
            || !夹具.图提供者.最后请求
            || !夹具.维护提供者.最后请求
            || 夹具.图提供者.最后请求->自我 != 请求.自我
            || 夹具.图提供者.最后请求->目标安全结果
                != 请求.安全层来源选择组.front().最终安全结果
            || 夹具.图提供者.最后请求->适用场景 != 请求.适用场景
            || 夹具.图提供者.最后请求->期望图版本 != 请求.图版本
            || 夹具.图提供者.最后请求->事实截止版本 != 请求.事实截止版本
            || 夹具.维护提供者.最后请求->自我 != 请求.自我
            || 夹具.维护提供者.最后请求->维护族
                != 请求.安全层来源选择组.front().维护族
            || 夹具.维护提供者.最后请求->适用场景 != 请求.适用场景
            || 夹具.维护提供者.最后请求->期望当前值版本
                != 请求.安全层来源选择组.front().期望当前值版本
            || 夹具.维护提供者.最后请求->事实截止版本
                != 请求.事实截止版本) {
            return false;
        }
        夹具.维护提供者.当前值 = 90;
        const auto 高位结果 = 夹具.权限服务.读取安全权限快照(请求);
        return 高位结果.结果分类 == 安全结果分类::已形成
            && 高位结果.载荷
            && 高位结果.载荷->释放倍率[0] == 安全最大释放倍率
            && 夹具.图提供者.调用次数 == 2
            && 夹具.维护提供者.调用次数 == 2;
    } catch (...) {
        return false;
    }
}

inline bool SP_A14_递归闭合与缺口分账() noexcept {
    const 安全权限层来源选择 选择{
        形成句柄(11),
        形成句柄(12),
        形成句柄(13),
        形成句柄(14),
        8};
    const 权限读取请求 请求{
        形成句柄(9),
        形成句柄(10),
        {选择},
        20,
        30,
        安全权限规则版本};
    const 安全权限材料缺口 缺口{
        1,
        选择.维护族,
        选择.期望当前值版本,
        std::nullopt};
    const auto 结果 = 计算安全五组权限({}, {缺口}, {}, 请求);
    return 结果.结果分类 == 安全结果分类::材料缺失
        && 结果.载荷
        && 结果.载荷->材料缺口.size() == 1
        && 结果.载荷->五组已形成权限总量 == 0;
}

inline bool SP_A17_零权限边界() noexcept {
    const 安全权限层来源选择 选择{
        形成句柄(21),
        形成句柄(22),
        形成句柄(23),
        形成句柄(24),
        3};
    const 权限读取请求 请求{
        形成句柄(19),
        形成句柄(20),
        {选择},
        4,
        5,
        安全权限规则版本};
    const auto 结果 = 计算安全五组权限({}, {}, {选择}, 请求);
    return 结果.结果分类 == 安全结果分类::权限为零
        && 结果.载荷
        && 结果.载荷->未归层来源组.size() == 1
        && 结果.载荷->五组已形成权限总量 == 0;
}

inline bool SP_A15_单任务来源请求与一次读取() noexcept {
    try {
        隔离权限服务夹具 夹具;
        const auto 选择 = 夹具.形成选择();
        const 任务权限请求 请求{
            形成句柄(100),
            形成句柄(101),
            形成句柄(115),
            {选择},
            20,
            5,
            9,
            安全权限规则版本};
        const auto 结果 = 夹具.权限服务.计算任务安全权限(请求);
        return 结果.结果分类 == 安全结果分类::已形成
            && 结果.载荷
            && 结果.载荷->任务稳定句柄 == 请求.任务稳定句柄
            && 夹具.图提供者.调用次数 == 1
            && 夹具.维护提供者.调用次数 == 1
            && 夹具.任务提供者.调用次数 == 1
            && 夹具.任务提供者.最后请求
            && 夹具.任务提供者.最后请求->自我 == 请求.自我
            && 夹具.任务提供者.最后请求->适用场景 == 请求.适用场景
            && 夹具.任务提供者.最后请求->事实截止版本
                == 请求.事实截止版本
            && 夹具.任务提供者.最后请求->任务集合版本
                == 请求.任务集合版本;
    } catch (...) {
        return false;
    }
}

inline bool SP_A16_排序来源各读取一次() noexcept {
    try {
        隔离权限服务夹具 夹具;
        const auto 选择 = 夹具.形成选择();
        const 任务排序请求 请求{
            形成句柄(100),
            形成句柄(101),
            {选择},
            {{
                形成句柄(115),
                1,
                1,
                100,
                1,
                1}},
            20,
            5,
            9,
            安全权限规则版本,
            安全任务排序规则版本};
        const auto 结果 = 夹具.权限服务.排序任务执行候选(请求);
        return 结果.结果分类 == 安全结果分类::已形成
            && 结果.载荷
            && 结果.载荷->有序任务权限载荷组.size() == 1
            && 夹具.图提供者.调用次数 == 1
            && 夹具.维护提供者.调用次数 == 1
            && 夹具.任务提供者.调用次数 == 1
            && 夹具.任务提供者.最后请求
            && 夹具.任务提供者.最后请求->适用场景 == 请求.适用场景
            && 夹具.任务提供者.最后请求->事实截止版本
                == 请求.事实截止版本
            && 夹具.任务提供者.最后请求->任务集合版本
                == 请求.任务集合版本;
    } catch (...) {
        return false;
    }
}

}

分层安全维护与任务权限专项自检结果
运行分层安全维护与任务权限专项源码自检() noexcept {
    using namespace 分层安全专项自检细节;
    std::array<bool, 20> 验收{};

    // SP-A01—A05：图入口、环、路径、深度与未归层函数合同存在。
    验收[0] = std::is_same_v<
        decltype(&计算安全因果层级),
        安全分层读取结果 (*)(
            const 安全因果图快照&,
            const 安全分层读取请求&) noexcept>;
    验收[1] = 安全因果信息类型::安全根结果 != 安全因果信息类型::普通因果结果;
    验收[2] = std::is_same_v<
        decltype(&安全分层读取载荷::全部并列最短路径),
        std::vector<安全因果路径快照> 安全分层读取载荷::*>;
    验收[3] = std::is_same_v<
        decltype(&安全分层读取载荷::优先级组),
        std::optional<std::int64_t> 安全分层读取载荷::*>;
    验收[4] = 安全结果分类::未归层 != 安全结果分类::结构拒绝;

    // SP-A06—A11：维护算法、整数版本与来源批次合同存在。
    验收[5] = std::is_same_v<
        decltype(&计算分层安全维护候选),
        安全维护结果 (*)(
            const 安全层定义快照&,
            const 安全层当前快照&,
            const 安全维护事实来源载荷&,
            const 安全维护请求&) noexcept>;
    验收[6] = std::is_same_v<
        decltype(&安全维护载荷::来源已发布事实批次),
        std::optional<节点句柄> 安全维护载荷::*>;
    验收[7] = 安全最小保留倍率 == 10'000;
    验收[8] = 安全最大释放倍率 == 990'000;
    验收[9] = 安全维护方向::无变化 != 安全维护方向::主动事实优先;
    验收[10] = std::is_same_v<
        decltype(&安全维护请求::外部事实身份规格),
        std::optional<安全维护外部事实身份规格> 安全维护请求::*>;

    // SP-A12：事务包只移动且双路读回合同存在。
    验收[11] = !std::is_copy_constructible_v<安全维护外部事实参与载荷>
        && std::is_move_constructible_v<安全维护外部事实参与载荷>
        && !std::is_copy_constructible_v<安全维护外部事实参与结果>;

    // SP-A13—A17：来源选择、缺口、任务版本和零权限分账。
    验收[12] = SP_A13_单层权限边界与来源形成();
    验收[13] = SP_A14_递归闭合与缺口分账();
    验收[14] = SP_A15_单任务来源请求与一次读取()
        && std::is_same_v<
        decltype(&任务权限请求::安全层来源选择组),
        std::vector<安全权限层来源选择> 任务权限请求::*>
        && std::is_same_v<
            decltype(&任务权限请求::任务集合版本),
            std::uint64_t 任务权限请求::*>;
    验收[15] = SP_A16_排序来源各读取一次()
        && std::is_same_v<
        decltype(&任务排序请求::安全层来源选择组),
        std::vector<安全权限层来源选择> 任务排序请求::*>
        && std::is_same_v<
            decltype(&任务排序请求::任务集合版本),
            std::uint64_t 任务排序请求::*>;
    验收[16] = SP_A17_零权限边界();

    // SP-A18 只确认线程边界未进入本候选，真实循环由 #359 验证。
    验收[17] = std::is_nothrow_destructible_v<安全任务权限服务>;

    // SP-A19—A20：恢复字段与服务域隔离保持为值式合同。
    验收[18] = std::is_same_v<
        decltype(&安全层当前快照::事实处理游标),
        std::uint64_t 安全层当前快照::*>
        && std::is_same_v<
            decltype(&安全层当前快照::方向维护纪元),
            std::uint64_t 安全层当前快照::*>;
    验收[19] = 分层安全维护合同ABI == 1
        && 安全权限规则版本 == 1
        && 安全任务排序规则版本 == 1;

    std::uint32_t 通过项数 = 0;
    for (const bool 通过 : 验收) {
        if (通过) ++通过项数;
    }
    return {1, 377, 1, static_cast<std::uint32_t>(验收.size()), 通过项数};
}

}
