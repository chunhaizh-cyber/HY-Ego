inline 节点句柄 形成句柄(std::uint64_t 编号) noexcept {
    return {1, 编号, 1};
}

class 隔离安全因果图提供者 final : public 安全直接因果图提供者 {
public:
    mutable std::uint32_t 调用次数 = 0;
    mutable std::optional<安全因果图来源请求> 最后请求;

    安全因果图来源结果 读取安全直接因果图(
        const 安全因果图来源请求& 请求) const override {
        ++调用次数;
        最后请求 = 请求;
        安全因果图快照 图;
        图.自我 = 请求.自我;
        图.目标安全结果 = 请求.目标安全结果;
        图.适用场景 = 请求.适用场景;
        图.图版本 = 请求.期望图版本;
        图.节点集合版本 = 1;
        图.边集合版本 = 1;
        图.场景版本 = 1;
        图.发布时间 = 1;
        图.因果信息组 = {
            {
                形成句柄(104),
                形成句柄(109),
                安全因果信息类型::普通因果结果,
                请求.适用场景,
                1,
                记录当前性::当前},
            {
                形成句柄(106),
                请求.目标安全结果,
                安全因果信息类型::具体安全结果,
                请求.适用场景,
                1,
                记录当前性::当前}};
        图.直接因果边组 = {{
            形成句柄(107),
            形成句柄(104),
            形成句柄(106),
            形成句柄(108),
            请求.适用场景,
            1,
            1,
            记录当前性::当前}};
        安全因果图来源载荷 载荷{
            std::move(图),
            请求.期望图版本,
            请求.事实截止版本};
        return {安全结果分类::已形成, std::move(载荷)};
    }
};

class 隔离安全维护事实提供者 final : public 安全维护事实提供者 {
public:
    mutable std::uint32_t 调用次数 = 0;
    mutable std::optional<安全维护事实来源请求> 最后请求;
    std::int64_t 当前值 = 10;

    安全维护事实来源结果 读取已发布安全维护事实(
        const 安全维护事实来源请求& 请求) const override {
        ++调用次数;
        最后请求 = 请求;
        安全维护事实来源载荷 载荷;
        载荷.自我 = 请求.自我;
        载荷.维护族 = 请求.维护族;
        载荷.适用场景 = 请求.适用场景;
        载荷.当前值版本 = 请求.期望当前值版本;
        载荷.事实截止版本 = 请求.事实截止版本;
        载荷.定义.定义身份 = 形成句柄(113);
        载荷.定义.值域下界 = 0;
        载荷.定义.值域上界 = 100;
        载荷.定义.低位阈值 = 10;
        载荷.定义.高位阈值 = 90;
        载荷.定义.低位回升速率 = 1;
        载荷.定义.高位回落速率 = 1;
        载荷.定义.维护时间单位 = 1;
        载荷.定义.被动维护提交方法 = 形成句柄(114);
        载荷.定义.定义版本 = 7;
        载荷.定义.规则版本 = 分层安全维护规则版本;
        载荷.当前.维护族 = 请求.维护族;
        载荷.当前.自我 = 请求.自我;
        载荷.当前.来源因果信息 = 形成句柄(104);
        载荷.当前.目标安全结果 = 形成句柄(109);
        载荷.当前.最终安全结果 = 形成句柄(105);
        载荷.当前.图版本 = 5;
        载荷.当前.定义快照 = 载荷.定义;
        载荷.当前.当前状态 = 形成句柄(110);
        载荷.当前.当前安全值 = 当前值;
        载荷.当前.值版本 = 请求.期望当前值版本;
        载荷.当前.残余约束版本 = 1;
        载荷.当前.方向维护纪元 = 1;
        载荷.当前.累计有效时间 = 1;
        载荷.当前.事实处理游标 = 请求.事实截止版本;
        载荷.当前.来源当前性 = 记录当前性::当前;
        载荷.来源版本.图版本 = 5;
        载荷.来源版本.事实截止版本 = 请求.事实截止版本;
        载荷.来源版本.值集合版本 = 请求.期望当前值版本;
        载荷.来源版本.阈值集合版本 = 载荷.定义.定义版本;
        载荷.来源版本.维护规则版本 = 载荷.定义.规则版本;
        return {安全结果分类::已形成, std::move(载荷)};
    }
};

