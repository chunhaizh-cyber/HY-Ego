module;

#include <optional>
#include <utility>

#define L2_STATE_DYNAMIC_ATOMIC_PUBLISH_NO_INCLUDES

export module 海中鱼巣.领域.服务.L2状态动态原子发布;
export import 海中鱼巣.领域.合同.L2结构公共;
import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.L2通用虚拟存在结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2动态结构;

export {
#include "L2状态动态原子发布.数据.h"
}

export namespace 海中鱼巣 {

class L1跨所有者原子事务凭证 final {
public:
    L1跨所有者原子事务凭证() = delete;
    L1跨所有者原子事务凭证(const L1跨所有者原子事务凭证&) = delete;
    L1跨所有者原子事务凭证& operator=(
        const L1跨所有者原子事务凭证&) = delete;
    L1跨所有者原子事务凭证(
        L1跨所有者原子事务凭证&&) noexcept = default;
    L1跨所有者原子事务凭证& operator=(
        L1跨所有者原子事务凭证&&) noexcept = default;

    bool 有效() const noexcept {
        return 第一层服务_ && 状态端口_ && 动态端口_
            && 状态端口_->有效() && 动态端口_->有效()
            && 状态端口_->绑定于(*第一层服务_)
            && 动态端口_->绑定于(*第一层服务_)
            && 状态端口_->所有者身份() != 动态端口_->所有者身份();
    }

    L1跨所有者原子事务结果 提交(
        const L1跨所有者原子事务请求& 请求) noexcept {
        if (!有效())
            return {L1跨所有者原子事务状态::许可拒绝,
                L1跨所有者原子事务合同版本, 0, false,
                L1所有者范围重试边界::修正请求后可重试, {}, {}};
        if (请求.状态写集.所有者 != 状态端口_->所有者身份()
            || 请求.动态写集.所有者 != 动态端口_->所有者身份())
            return {L1跨所有者原子事务状态::许可拒绝,
                L1跨所有者原子事务合同版本, 0, false,
                L1所有者范围重试边界::修正请求后可重试, {}, {}};
        return 状态端口_->提交跨所有者原子事务(请求, *动态端口_);
    }

private:
    L1跨所有者原子事务凭证(const L1事实基座服务& 第一层服务,
        L1所有者范围写端口& 状态端口,
        L1所有者范围写端口& 动态端口) noexcept
        : 第一层服务_(&第一层服务), 状态端口_(&状态端口),
          动态端口_(&动态端口) {}
    friend std::optional<L1跨所有者原子事务凭证>
    尝试形成L1跨所有者原子事务凭证(
        const L1事实基座服务&, L1所有者范围写端口&,
        L1所有者范围写端口&) noexcept;

    const L1事实基座服务* 第一层服务_ = nullptr;
    L1所有者范围写端口* 状态端口_ = nullptr;
    L1所有者范围写端口* 动态端口_ = nullptr;
};

std::optional<L1跨所有者原子事务凭证>
尝试形成L1跨所有者原子事务凭证(
    const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 状态端口,
    L1所有者范围写端口& 动态端口) noexcept {
    try {
        if (!状态端口.有效() || !动态端口.有效()
            || !状态端口.绑定于(第一层服务)
            || !动态端口.绑定于(第一层服务)
            || 状态端口.所有者身份() == 动态端口.所有者身份())
            return std::nullopt;
        return L1跨所有者原子事务凭证{第一层服务, 状态端口, 动态端口};
    } catch (...) {
        return std::nullopt;
    }
}

class L2状态动态原子发布服务 final {
public:
    L2状态动态原子发布服务() = delete;
    L2状态动态原子发布服务(const L2状态动态原子发布服务&) = delete;
    L2状态动态原子发布服务& operator=(
        const L2状态动态原子发布服务&) = delete;

    L2状态动态原子发布服务(
        const L1事实基座服务& 第一层服务,
        const L2通用虚拟存在结构服务& 存在服务,
        const L2状态结构服务& 状态服务,
        const L2动态结构服务& 动态服务,
        L1跨所有者原子事务凭证&& 事务凭证) noexcept
        : 第一层服务_(第一层服务), 存在服务_(存在服务),
          状态服务_(状态服务), 动态服务_(动态服务),
          事务凭证_(std::move(事务凭证)) {}

    bool 事务凭证有效() const noexcept { return 事务凭证_.有效(); }

    L2状态动态原子发布结果 发布状态动态原子迁移(
        const L2状态动态原子发布请求& 请求) noexcept {
        if (!L2状态动态原子发布请求有效(请求))
            return {{L2结构合同版本, L2结构状态::入口拒绝, 0,
                std::nullopt}, std::nullopt, std::nullopt, std::nullopt,
                std::nullopt, std::nullopt};
        const auto 失败 = [&](L2结构状态 状态,
            std::uint64_t 截止 = 0) {
            return L2状态动态原子发布结果{{L2结构合同版本, 状态,
                截止, std::nullopt}, std::nullopt, std::nullopt,
                std::nullopt, std::nullopt, std::nullopt};
        };
        const auto 映射状态 = [](L1跨所有者原子事务状态 状态) {
            switch (状态) {
            case L1跨所有者原子事务状态::已提交:
                return L2结构状态::已提交;
            case L1跨所有者原子事务状态::精确重复:
                return L2结构状态::精确重复;
            case L1跨所有者原子事务状态::入口拒绝:
                return L2结构状态::入口拒绝;
            case L1跨所有者原子事务状态::许可拒绝:
                return L2结构状态::许可拒绝;
            case L1跨所有者原子事务状态::未找到:
                return L2结构状态::未找到;
            case L1跨所有者原子事务状态::已退出:
                return L2结构状态::已退出;
            case L1跨所有者原子事务状态::事实代次漂移:
                return L2结构状态::事实代次漂移;
            case L1跨所有者原子事务状态::幂等冲突:
                return L2结构状态::幂等冲突;
            case L1跨所有者原子事务状态::引用冲突:
                return L2结构状态::引用冲突;
            case L1跨所有者原子事务状态::资源失败:
                return L2结构状态::资源失败;
            case L1跨所有者原子事务状态::内部不一致:
                return L2结构状态::内部不一致;
            }
            return L2结构状态::内部不一致;
        };
        try {
            const L1所有者范围写入幂等身份 组合身份{
                L2状态动态原子发布幂等域 ^ 请求.幂等身份.值};
            const auto 状态形成 = 状态服务_.形成状态原子参与者写集({
                L2结构合同版本, 请求.请求头.期望事实代次, 组合身份,
                请求.主体存在, 请求.旧当前状态, 请求.新状态特征实例,
                请求.新状态精确值材料, 请求.新状态时间值材料,
                请求.来源方法稳定编码});
            if (状态形成.状态 != L2结构状态::已读取
                || !状态形成.参与者)
                return 失败(状态形成.状态, 状态形成.共同期望事实代次);
            const auto 动态形成 = 动态服务_.形成动态原子参与者写集({
                L2结构合同版本, 请求.请求头.期望事实代次, 组合身份,
                请求.主体存在, 请求.新状态特征实例, 请求.旧当前状态,
                L2状态身份{}, {L1跨所有者原子事务参与者序号::状态,
                    状态形成.局部键.状态节点}, 请求.动态起始时间材料,
                请求.动态结束时间材料, 请求.来源方法稳定编码});
            if (动态形成.状态 != L2结构状态::已读取
                || !动态形成.参与者)
                return 失败(动态形成.状态, 动态形成.共同期望事实代次);
            L1跨所有者原子事务请求 事务;
            事务.合同版本 = L1跨所有者原子事务合同版本;
            事务.共同期望事实代次 = 请求.请求头.期望事实代次;
            事务.组合写入幂等身份 = 组合身份;
            事务.状态写集 = *状态形成.参与者;
            事务.动态写集 = *动态形成.参与者;
            const auto 提交 = 事务凭证_.提交(事务);
            if (提交.状态 != L1跨所有者原子事务状态::已提交
                && 提交.状态 != L1跨所有者原子事务状态::精确重复)
                return 失败(映射状态(提交.状态), 提交.共同事实代次);
            const auto 查映射 = [](const auto& 映射,
                std::uint32_t 局部值) -> std::optional<稳定编码> {
                for (const auto& [键, 编码] : 映射)
                    if (键.值 == 局部值) return 编码;
                return std::nullopt;
            };
            const auto 新状态编码 = 查映射(提交.状态编码映射, 0x02041001);
            const auto 新动态编码 = 查映射(提交.动态编码映射, 0x02051001);
            if (!新状态编码 || !新动态编码)
                return 失败(L2结构状态::内部不一致, 提交.共同事实代次);
            const L2状态身份 新状态{*新状态编码};
            const L2动态身份 新动态{*新动态编码};
            const L2结构请求头 读回头{L2结构合同版本,
                提交.共同事实代次};
            const auto 新状态读回 = 状态服务_.读取完整状态({读回头,
                L2读取类别::当前, 新状态, 0});
            const auto 新动态读回 = 动态服务_.读取完整动态({读回头,
                L2读取类别::当前, 新动态, 0});
            const auto 旧历史 = 状态服务_.读取完整状态({读回头,
                L2读取类别::历史, 请求.旧当前状态,
                提交.共同事实代次});
            const auto 旧当前 = 状态服务_.读取完整状态({读回头,
                L2读取类别::当前, 请求.旧当前状态, 0});
            if (新状态读回.结果头.状态 != L2结构状态::已读取
                || 新状态读回.结果头.事实截止代次 != 提交.共同事实代次
                || !新状态读回.状态 || !新状态读回.自有关系
                || 新状态读回.状态->主体存在 != 请求.主体存在
                || 新状态读回.状态->特征实例 != 请求.新状态特征实例
                || 新动态读回.结果头.状态 != L2结构状态::已读取
                || 新动态读回.结果头.事实截止代次 != 提交.共同事实代次
                || !新动态读回.动态 || !新动态读回.自有关系
                || 新动态读回.动态->主体存在 != 请求.主体存在
                || 新动态读回.动态->前状态 != 请求.旧当前状态
                || 新动态读回.动态->后状态 != 新状态
                || 旧历史.结果头.状态 != L2结构状态::已读取
                || !旧历史.状态 || !旧历史.自有关系
                || 旧当前.结果头.状态 != L2结构状态::已退出)
                return 失败(L2结构状态::内部不一致, 提交.共同事实代次);
            return {{L2结构合同版本,
                    提交.状态 == L1跨所有者原子事务状态::精确重复
                        ? L2结构状态::精确重复 : L2结构状态::已提交,
                    提交.共同事实代次, std::nullopt},
                *新状态读回.状态, *新状态读回.自有关系,
                *新动态读回.动态, *新动态读回.自有关系,
                状态形成.旧状态退出闭包};
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

private:
    const L1事实基座服务& 第一层服务_;
    const L2通用虚拟存在结构服务& 存在服务_;
    const L2状态结构服务& 状态服务_;
    const L2动态结构服务& 动态服务_;
    L1跨所有者原子事务凭证 事务凭证_;
};

} // namespace 海中鱼巣
