bool L2特征当前值变化记录结果_v1::成功() const noexcept {
    if (合同版本 != L2特征当前值变化记录合同版本_v1)
        return false;
    const bool 四键有效 = L2结构幂等身份有效(组合幂等身份)
        && L2结构幂等身份有效(特征参与者幂等身份)
        && L2结构幂等身份有效(状态参与者幂等身份)
        && L2结构幂等身份有效(动态参与者幂等身份)
        && 组合幂等身份 != 特征参与者幂等身份
        && 组合幂等身份 != 状态参与者幂等身份
        && 组合幂等身份 != 动态参与者幂等身份
        && 特征参与者幂等身份 != 状态参与者幂等身份
        && 特征参与者幂等身份 != 动态参与者幂等身份
        && 状态参与者幂等身份 != 动态参与者幂等身份;
    if (状态 == L2特征当前值变化记录状态_v1::无变化)
        return 四键有效 && 当前值 && 本次正式读回截止 != 0
            && !前状态 && !后状态 && !当前选择 && !已退出旧选择
            && !状态迁移动能 && !动作致变动态
            && 状态上下文组.empty() && 动态上下文组.empty()
            && !legacy基线兼容;
    if (状态 != L2特征当前值变化记录状态_v1::已提交
        && 状态 != L2特征当前值变化记录状态_v1::精确重复)
        return false;
    if (!四键有效 || 本次正式读回截止 == 0 || !当前值 || !前状态
        || !后状态 || !当前选择 || !状态迁移动能
        || 状态上下文组.size() != 2
        || 动态上下文组.size() != (动作致变动态 ? 2U : 1U))
        return false;
    return 当前选择->目标状态 == 后状态->身份
        && 当前值->类型化不可变材料 == 后状态->特征值
        && 状态迁移动能->有序状态组.size() == 2
        && 状态迁移动能->有序状态组[0].状态 == 前状态->身份
        && 状态迁移动能->有序状态组[1].状态 == 后状态->身份
        && (!已退出旧选择
            || 已退出旧选择->生命周期.退出事实代次
                == 本次正式读回截止);
}

bool L2特征当前值变化记录读取结果_v1::成功() const noexcept {
    if (合同版本 != L2特征当前值变化记录合同版本_v1
        || 状态 != L2特征当前值变化记录读取状态_v1::已读取
        || 本次正式读回截止 == 0 || !当前值 || !前状态 || !后状态
        || !当前选择 || !状态迁移动能 || 状态上下文组.size() != 2
        || 动态上下文组.size() != (动作致变动态 ? 2U : 1U))
        return false;
    return 当前选择->目标状态 == 后状态->身份
        && 当前值->类型化不可变材料 == 后状态->特征值
        && 状态迁移动能->有序状态组.size() == 2
        && 状态迁移动能->有序状态组[0].状态 == 前状态->身份
        && 状态迁移动能->有序状态组[1].状态 == 后状态->身份;
}

bool L2特征当前值变化账登记结果_v2::成功() const noexcept {
    return 合同版本 == L2特征当前值变化永久账合同版本_v2
        && (状态 == L2特征当前值变化账登记状态_v2::已登记
            || 状态 == L2特征当前值变化账登记状态_v2::精确重复)
        && 账锚点 && 有效(*账锚点) && 首次登记事实代次 != 0
        && 本次正式读回截止 >= 首次登记事实代次;
}

bool L2特征当前值变化记录结果_v2::成功() const noexcept {
    if (合同版本 != L2特征当前值变化永久账合同版本_v2)
        return false;
    const bool 四键有效 = L2结构幂等身份有效(组合幂等身份)
        && L2结构幂等身份有效(特征参与者幂等身份)
        && L2结构幂等身份有效(状态参与者幂等身份)
        && L2结构幂等身份有效(动态参与者幂等身份)
        && 组合幂等身份 != 特征参与者幂等身份
        && 组合幂等身份 != 状态参与者幂等身份
        && 组合幂等身份 != 动态参与者幂等身份
        && 特征参与者幂等身份 != 状态参与者幂等身份
        && 特征参与者幂等身份 != 动态参与者幂等身份
        && 状态参与者幂等身份 != 动态参与者幂等身份;
    if (状态 == L2特征当前值变化记录状态_v2::无变化)
        return 四键有效 && 当前值 && 本次正式读回截止 != 0
            && !前状态 && !后状态 && !当前选择 && !已退出旧选择
            && !状态迁移动能 && !动作致变动态 && !变化账事实
            && 状态上下文组.empty() && 动态上下文组.empty()
            && !legacy基线兼容;
    if (状态 != L2特征当前值变化记录状态_v2::已提交
        && 状态 != L2特征当前值变化记录状态_v2::精确重复)
        return false;
    if (!四键有效 || 本次正式读回截止 == 0 || !当前值 || !前状态
        || !后状态 || !当前选择 || !状态迁移动能 || !变化账事实
        || 状态上下文组.size() != 2
        || 动态上下文组.size() != (动作致变动态 ? 2U : 1U))
        return false;
    const auto& 账 = *变化账事实;
    return 当前选择->目标状态 == 后状态->身份
        && 当前值->类型化不可变材料 == 后状态->特征值
        && 状态迁移动能->有序状态组.size() == 2
        && 状态迁移动能->有序状态组[0].状态 == 前状态->身份
        && 状态迁移动能->有序状态组[1].状态 == 后状态->身份
        && 账.特征实例 == 当前值->特征实例
        && 账.新当前值稳定编码 == 当前值->值稳定编码
        && 账.旧当前值稳定编码 != 账.新当前值稳定编码
        && 账.组合幂等身份 == 组合幂等身份
        && 账.特征参与者幂等身份 == 特征参与者幂等身份
        && 账.状态参与者幂等身份 == 状态参与者幂等身份
        && 账.动态参与者幂等身份 == 动态参与者幂等身份
        && 账.形成事实代次 == 本次正式读回截止
        && (!已退出旧选择
            || 已退出旧选择->生命周期.退出事实代次
                == 本次正式读回截止);
}

bool L2特征当前值变化组读取结果_v2::成功() const noexcept {
    if (合同版本 != L2特征当前值变化永久账合同版本_v2
        || 状态 != L2特征当前值变化组读取状态_v2::已读取
        || !完整集合见证 || 本次正式读回截止 == 0)
        return false;
    const auto& 见证 = *完整集合见证;
    if (见证.G0 != 本次正式读回截止 || 见证.账登记事实代次 == 0
        || 见证.声明成员数 != 完整变化组.size()
        || 见证.规范成员身份组.size() != 完整变化组.size())
        return false;
    for (std::size_t i = 0; i != 完整变化组.size(); ++i) {
        if (完整变化组[i].身份 != 见证.规范成员身份组[i]
            || 完整变化组[i].特征实例 != 见证.特征实例
            || 完整变化组[i].变化UTC纳秒 < 见证.包含起始UTC纳秒
            || 完整变化组[i].变化UTC纳秒 >= 见证.排除结束UTC纳秒)
            return false;
        if (i != 0) {
            const auto& 前 = 完整变化组[i - 1];
            const auto& 后 = 完整变化组[i];
            if (前.变化UTC纳秒 > 后.变化UTC纳秒
                || (前.变化UTC纳秒 == 后.变化UTC纳秒
                    && !(前.身份.值 < 后.身份.值)))
                return false;
        }
    }
    return true;
}

bool L2状态动态迁移结果_v2::成功() const noexcept {
    const bool 状态配对 =
        (结果头.状态 == L2结构状态::已提交
            && 迁移操作状态 == L2状态动态迁移操作状态_v2::已提交)
        || (结果头.状态 == L2结构状态::精确重复
            && 迁移操作状态 == L2状态动态迁移操作状态_v2::精确重复);
    if (原子发布合同版本 != L2状态动态迁移专属合同版本_v2
        || 结果头.合同版本 != L2结构合同版本 || !状态配对
        || 结果头.事实截止代次 == 0 || !结果头.变更事实代次
        || *结果头.变更事实代次 == 0
        || *结果头.变更事实代次 > 结果头.事实截止代次
        || 共同事实截止代次 != *结果头.变更事实代次
        || !新状态 || !新状态自有关系 || !新动态 || !新动态自有关系
        || !新当前选择关系 || !已退出旧当前选择关系)
        return false;

    const auto G1 = 共同事实截止代次;
    const auto& 状态 = *新状态;
    const auto& 动态 = *新动态;
    const auto& 当前选择 = *新当前选择关系;
    const auto& 旧选择退出 = *已退出旧当前选择关系;
    return 有效(状态.身份.值) && 有效(动态.身份.值)
        && 状态.生命周期.创建事实代次 == G1
        && !状态.生命周期.退出事实代次
        && 动态.生命周期.创建事实代次 == G1
        && !动态.生命周期.退出事实代次
        && L2状态当前选择关系引用完整(当前选择, G1)
        && L2状态当前选择关系引用完整(旧选择退出, G1)
        && 当前选择.生命周期.创建事实代次 == G1
        && !当前选择.生命周期.退出事实代次
        && 旧选择退出.生命周期.退出事实代次 == G1
        && 当前选择.关系稳定编码 != 旧选择退出.关系稳定编码
        && 当前选择.特征实例 == 状态.特征实例
        && 当前选择.状态 == 状态.身份
        && 旧选择退出.特征实例 == 当前选择.特征实例
        && 旧选择退出.状态 == 动态.前状态
        && 当前选择.关系类型 == 旧选择退出.关系类型
        && 当前选择.写入所有者 == 旧选择退出.写入所有者
        && 当前选择.角色或顺序 == 1
        && 旧选择退出.角色或顺序 == 1
        && 动态.主体存在 == 状态.主体存在
        && 动态.后状态 == 状态.身份
        && 动态.来源稳定编码 == 状态.来源稳定编码
        && 有效(新状态自有关系->族归属关系稳定编码)
        && 有效(新状态自有关系->主体关系稳定编码)
        && 有效(新状态自有关系->特征实例关系稳定编码)
        && 当前选择.关系稳定编码
            != 新状态自有关系->族归属关系稳定编码
        && 当前选择.关系稳定编码
            != 新状态自有关系->主体关系稳定编码
        && 当前选择.关系稳定编码
            != 新状态自有关系->特征实例关系稳定编码
        && 有效(新动态自有关系->族归属关系稳定编码)
        && 有效(新动态自有关系->主体关系稳定编码)
        && 有效(新动态自有关系->前状态关系稳定编码)
        && 有效(新动态自有关系->后状态关系稳定编码);
}

class L1跨所有者原子事务凭证 final {
public:
    L1跨所有者原子事务凭证() = delete;
    L1跨所有者原子事务凭证(const L1跨所有者原子事务凭证&) = delete;
    L1跨所有者原子事务凭证& operator=(
        const L1跨所有者原子事务凭证&) = delete;
    L1跨所有者原子事务凭证(
        L1跨所有者原子事务凭证&&) noexcept = default;
    L1跨所有者原子事务凭证& operator=(
        L1跨所有者原子事务凭证&&) noexcept = default;

    bool 有效() const noexcept {
        return 第一层服务_ && 状态端口_ && 动态端口_
            && 状态端口_->有效() && 动态端口_->有效()
            && 状态端口_->绑定于(*第一层服务_)
            && 动态端口_->绑定于(*第一层服务_)
            && 状态端口_->所有者身份() != 动态端口_->所有者身份();
    }

    L1跨所有者原子事务结果 提交(
        const L1跨所有者原子事务请求& 请求) noexcept {
        if (!有效())
            return {L1跨所有者原子事务状态::内部不一致,
                L1跨所有者原子事务合同版本, 0, false,
                L1所有者范围重试边界::修正请求后可重试, {}, {}};
        if (请求.状态写集.所有者 != 状态端口_->所有者身份()
            || 请求.动态写集.所有者 != 动态端口_->所有者身份())
            return {L1跨所有者原子事务状态::引用冲突,
                L1跨所有者原子事务合同版本, 0, false,
                L1所有者范围重试边界::修正请求后可重试, {}, {}};
        return 状态端口_->提交跨所有者原子事务(请求, *动态端口_);
    }

private:
    L1跨所有者原子事务凭证(const L1事实基座服务& 第一层服务,
        L1所有者范围写端口& 状态端口,
        L1所有者范围写端口& 动态端口) noexcept
        : 第一层服务_(&第一层服务), 状态端口_(&状态端口),
          动态端口_(&动态端口) {}
    friend std::optional<L1跨所有者原子事务凭证>
    尝试形成L1跨所有者原子事务凭证(
        const L1事实基座服务&, L1所有者范围写端口&,
        L1所有者范围写端口&) noexcept;

    const L1事实基座服务* 第一层服务_ = nullptr;
    L1所有者范围写端口* 状态端口_ = nullptr;
    L1所有者范围写端口* 动态端口_ = nullptr;
};

std::optional<L1跨所有者原子事务凭证>
尝试形成L1跨所有者原子事务凭证(
    const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 状态端口,
    L1所有者范围写端口& 动态端口) noexcept {
    try {
        if (!状态端口.有效() || !动态端口.有效()
            || !状态端口.绑定于(第一层服务)
            || !动态端口.绑定于(第一层服务)
            || 状态端口.所有者身份() == 动态端口.所有者身份())
            return std::nullopt;
        return L1跨所有者原子事务凭证{第一层服务, 状态端口, 动态端口};
    } catch (...) {
        return std::nullopt;
    }
}

class L1三分区原子事务凭证_v2 final {
public:
    L1三分区原子事务凭证_v2() = delete;
    L1三分区原子事务凭证_v2(const L1三分区原子事务凭证_v2&) = delete;
    L1三分区原子事务凭证_v2& operator=(
        const L1三分区原子事务凭证_v2&) = delete;
    L1三分区原子事务凭证_v2(L1三分区原子事务凭证_v2&&) noexcept = default;
    L1三分区原子事务凭证_v2& operator=(
        L1三分区原子事务凭证_v2&&) noexcept = default;

    bool 有效() const noexcept {
        return 第一层服务_ && 第一端口_ && 第二端口_ && 第三端口_
            && 第一端口_->有效() && 第二端口_->有效() && 第三端口_->有效()
            && 第一端口_->绑定于(*第一层服务_)
            && 第二端口_->绑定于(*第一层服务_)
            && 第三端口_->绑定于(*第一层服务_)
            && 第一端口_->所有者身份() != 第二端口_->所有者身份()
            && 第一端口_->所有者身份() != 第三端口_->所有者身份()
            && 第二端口_->所有者身份() != 第三端口_->所有者身份();
    }

    L1三分区原子事务结果_v2 提交(
        const L1三分区原子事务请求_v2& 请求) noexcept {
        if (!有效()) return {};
        return 第一端口_->提交三分区原子事务_v2(
            请求, *第二端口_, *第三端口_);
    }

private:
    L1三分区原子事务凭证_v2(const L1事实基座服务& 第一层服务,
        L1所有者范围写端口& 第一端口,
        L1所有者范围写端口& 第二端口,
        L1所有者范围写端口& 第三端口) noexcept
        : 第一层服务_(&第一层服务), 第一端口_(&第一端口),
          第二端口_(&第二端口), 第三端口_(&第三端口) {}
    friend std::optional<L1三分区原子事务凭证_v2>
    尝试形成L1三分区原子事务凭证_v2(const L1事实基座服务&,
        L1所有者范围写端口&, L1所有者范围写端口&,
        L1所有者范围写端口&) noexcept;
    const L1事实基座服务* 第一层服务_ = nullptr;
    L1所有者范围写端口* 第一端口_ = nullptr;
    L1所有者范围写端口* 第二端口_ = nullptr;
    L1所有者范围写端口* 第三端口_ = nullptr;
};

std::optional<L1三分区原子事务凭证_v2>
尝试形成L1三分区原子事务凭证_v2(
    const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 第一端口,
    L1所有者范围写端口& 第二端口,
    L1所有者范围写端口& 第三端口) noexcept {
    try {
        L1三分区原子事务凭证_v2 凭证{
            第一层服务, 第一端口, 第二端口, 第三端口};
        return 凭证.有效()
            ? std::optional<L1三分区原子事务凭证_v2>{std::move(凭证)}
            : std::nullopt;
    } catch (...) {
        return std::nullopt;
    }
}

class L2状态动态原子发布服务 final {
public:
    L2状态动态原子发布服务() = delete;
    L2状态动态原子发布服务(const L2状态动态原子发布服务&) = delete;
    L2状态动态原子发布服务& operator=(
        const L2状态动态原子发布服务&) = delete;

    L2状态动态原子发布服务(
        const L1事实基座服务& 第一层服务,
        const L2存在结构服务& 存在服务,
        const L2场景结构服务& 场景服务,
        L2特征结构服务& 特征服务,
        const L2状态结构服务& 状态服务,
        const L2动态结构服务& 动态服务,
        L1三分区原子事务凭证_v2&& 事务凭证) noexcept
        : 第一层服务_(第一层服务), 存在服务_(存在服务),
          场景服务_(场景服务), 特征服务_(特征服务),
          状态服务_(状态服务), 动态服务_(动态服务),
          事务凭证_(std::move(事务凭证)) {}

    bool 事务凭证有效() const noexcept { return 事务凭证_.有效(); }

#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
    void ARCH_注入迁移提交后首次读回失败一次() noexcept {
        ARCH_迁移提交后首次读回失败一次_ = true;
    }
    void ARCH_注入变化账登记提交后首次读回失败一次() noexcept {
        ARCH_变化账登记提交后首次读回失败一次_ = true;
    }
#endif

    L2状态动态原子发布结果 发布状态动态原子迁移(
        const L2状态动态原子发布请求&) noexcept {
        return {{L2结构合同版本, L2结构状态::入口拒绝, 0,
            std::nullopt}, std::nullopt, std::nullopt, std::nullopt,
            std::nullopt, std::nullopt};
    }

    L2状态动态迁移结果_v2 发布状态动态原子迁移_v2(
        const L2状态动态迁移请求_v2&) noexcept {
        L2状态动态迁移结果_v2 结果;
        结果.结果头 = {L2结构合同版本, L2结构状态::入口拒绝,
            0, std::nullopt};
        结果.迁移操作状态 = L2状态动态迁移操作状态_v2::入口拒绝;
        结果.共同事实截止代次 = 0;
        return 结果;
    }

    L2特征当前值变化账登记结果_v2 确保特征当前值变化永久账登记_v2(
        const L2特征当前值变化账登记请求_v2& 请求) noexcept {
        const auto 失败 = [&](L2特征当前值变化账登记状态_v2 状态,
            std::uint64_t 首次代次 = 0) noexcept {
            L2特征当前值变化账登记结果_v2 结果;
            结果.状态 = 状态;
            结果.首次登记事实代次 = 首次代次;
            return 结果;
        };
        if (请求.合同版本 != L2特征当前值变化永久账合同版本_v2
            || !L2结构请求头合同有效(请求.请求头)
            || 请求.请求头.期望事实代次 == 0)
            return 失败(L2特征当前值变化账登记状态_v2::入口拒绝);
        const auto 登记 = 特征服务_.确保当前值变化账登记_v2(请求.请求头);
#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
        if (登记.状态 == L2结构状态::已提交
            && ARCH_变化账登记提交后首次读回失败一次_) {
            ARCH_变化账登记提交后首次读回失败一次_ = false;
            return 失败(L2特征当前值变化账登记状态_v2::已可能登记,
                登记.首次登记事实代次);
        }
#endif
        if (登记.状态 != L2结构状态::已提交
            && 登记.状态 != L2结构状态::精确重复) {
            const auto 状态 = 登记.状态 == L2结构状态::入口拒绝
                ? L2特征当前值变化账登记状态_v2::入口拒绝
                : 登记.状态 == L2结构状态::许可拒绝
                    ? L2特征当前值变化账登记状态_v2::许可拒绝
                    : 登记.状态 == L2结构状态::事实代次漂移
                        ? L2特征当前值变化账登记状态_v2::当前性漂移
                        : 登记.状态 == L2结构状态::幂等冲突
                            ? L2特征当前值变化账登记状态_v2::幂等冲突
                            : 登记.状态 == L2结构状态::引用冲突
                                ? L2特征当前值变化账登记状态_v2::引用冲突
                                : 登记.状态 == L2结构状态::资源失败
                                    ? L2特征当前值变化账登记状态_v2::资源失败
                                    : L2特征当前值变化账登记状态_v2::内部错误;
            return 失败(状态, 登记.首次登记事实代次);
        }
        L2特征当前值变化账登记结果_v2 结果;
        结果.状态 = 登记.状态 == L2结构状态::已提交
            ? L2特征当前值变化账登记状态_v2::已登记
            : L2特征当前值变化账登记状态_v2::精确重复;
        结果.账锚点 = 登记.账锚点;
        结果.首次登记事实代次 = 登记.首次登记事实代次;
        结果.本次正式读回截止 = 登记.本次正式读回截止;
        return 结果.成功() ? 结果
            : 失败(L2特征当前值变化账登记状态_v2::内部错误);
    }

private:
    struct 当前值变化v2发布上下文 final { 稳定编码 账锚点{}; };

public:
    L2特征当前值变化记录结果_v1 发布特征当前值变化与中性记录_v1(
        const L2特征当前值变化记录请求_v1& 请求) noexcept {
        return 发布特征当前值变化与中性记录核心_v1(请求, std::nullopt);
    }

    L2特征当前值变化记录结果_v2 发布特征当前值变化与中性记录_v2(
        const L2特征当前值变化记录请求_v2& 请求) noexcept {
        const auto 失败 = [&](L2特征当前值变化记录状态_v2 状态,
            std::uint64_t 截止 = 0) noexcept {
            L2特征当前值变化记录结果_v2 结果;
            结果.状态 = 状态;
            结果.组合幂等身份 = 请求.组合幂等身份;
            结果.特征参与者幂等身份 = 请求.特征参与者幂等身份;
            结果.状态参与者幂等身份 = 请求.状态参与者幂等身份;
            结果.动态参与者幂等身份 = 请求.动态参与者幂等身份;
            结果.本次正式读回截止 = 截止;
            return 结果;
        };
        const bool 四键有效 = L2结构幂等身份有效(请求.组合幂等身份)
            && L2结构幂等身份有效(请求.特征参与者幂等身份)
            && L2结构幂等身份有效(请求.状态参与者幂等身份)
            && L2结构幂等身份有效(请求.动态参与者幂等身份)
            && 请求.组合幂等身份 != 请求.特征参与者幂等身份
            && 请求.组合幂等身份 != 请求.状态参与者幂等身份
            && 请求.组合幂等身份 != 请求.动态参与者幂等身份
            && 请求.特征参与者幂等身份 != 请求.状态参与者幂等身份
            && 请求.特征参与者幂等身份 != 请求.动态参与者幂等身份
            && 请求.状态参与者幂等身份 != 请求.动态参与者幂等身份;
        if (请求.合同版本 != L2特征当前值变化永久账合同版本_v2
            || !L2结构请求头合同有效(请求.请求头)
            || 请求.请求头.期望事实代次 == 0 || !四键有效
            || !事务凭证_.有效() || !有效(请求.特征实例.值)
            || !有效(请求.预期旧当前值.值稳定编码)
            || 请求.预期旧当前值.特征实例 != 请求.特征实例
            || !L2特征值事实截止投影完整(
                请求.预期旧当前值, 请求.请求头.期望事实代次)
            || 请求.预期旧当前值.生命周期.退出事实代次
            || !L2特征当前值材料有效(请求.新值材料)
            || 请求.变化UTC纳秒 <= 0 || !有效(请求.主体存在.值)
            || !有效(请求.共同场景.值) || !有效(请求.来源存在.值)
            || (请求.来源方法 && !有效(请求.来源方法->值)))
            return 失败(L2特征当前值变化记录状态_v2::入口拒绝);
        try {
            const auto 当前代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < 请求.请求头.期望事实代次)
                return 失败(当前代次.状态 == L1中性读取状态::资源失败
                    ? L2特征当前值变化记录状态_v2::资源失败
                    : L2特征当前值变化记录状态_v2::当前性漂移);
            const auto 登记 = 特征服务_.读取当前值变化账登记_v2(
                {L2结构合同版本, 当前代次.事实代次});
            if (登记.状态 != L2结构状态::已读取 || !登记.账锚点) {
                const auto 状态 = 登记.状态 == L2结构状态::事实代次漂移
                    ? L2特征当前值变化记录状态_v2::当前性漂移
                    : 登记.状态 == L2结构状态::资源失败
                        ? L2特征当前值变化记录状态_v2::资源失败
                        : 登记.状态 == L2结构状态::未找到
                            ? L2特征当前值变化记录状态_v2::材料不足
                            : L2特征当前值变化记录状态_v2::内部错误;
                return 失败(状态);
            }
            const L2特征当前值变化记录请求_v1 v1请求{
                L2特征当前值变化记录合同版本_v1, 请求.请求头,
                请求.组合幂等身份, 请求.特征参与者幂等身份,
                请求.状态参与者幂等身份, 请求.动态参与者幂等身份,
                请求.特征实例, 请求.预期旧当前值, 请求.新值材料,
                请求.变化UTC纳秒, 请求.主体存在, 请求.共同场景,
                请求.来源存在, 请求.来源方法};
            const auto v1 = 发布特征当前值变化与中性记录核心_v1(
                v1请求, 当前值变化v2发布上下文{*登记.账锚点});
            L2特征当前值变化记录结果_v2 结果;
            结果.状态 = v1.状态;
            结果.组合幂等身份 = v1.组合幂等身份;
            结果.特征参与者幂等身份 = v1.特征参与者幂等身份;
            结果.状态参与者幂等身份 = v1.状态参与者幂等身份;
            结果.动态参与者幂等身份 = v1.动态参与者幂等身份;
            结果.当前值 = v1.当前值;
            结果.前状态 = v1.前状态;
            结果.后状态 = v1.后状态;
            结果.当前选择 = v1.当前选择;
            结果.已退出旧选择 = v1.已退出旧选择;
            结果.状态迁移动能 = v1.状态迁移动能;
            结果.动作致变动态 = v1.动作致变动态;
            结果.状态上下文组 = v1.状态上下文组;
            结果.动态上下文组 = v1.动态上下文组;
            结果.legacy基线兼容 = v1.legacy基线兼容;
            结果.本次正式读回截止 = v1.本次正式读回截止;
            if (v1.状态 == L2特征当前值变化记录状态_v1::无变化)
                return 结果.成功() ? 结果
                    : 失败(L2特征当前值变化记录状态_v2::内部错误);
            if (v1.状态 != L2特征当前值变化记录状态_v1::已提交
                && v1.状态 != L2特征当前值变化记录状态_v1::精确重复)
                return 结果;
            const auto 扫描代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (扫描代次.状态 != L1中性读取状态::成功
                || 扫描代次.事实代次 < v1.本次正式读回截止)
                return 失败(L2特征当前值变化记录状态_v2::已可能发布,
                    v1.本次正式读回截止);
            const auto 扫描 = 特征服务_.扫描全部当前值变化账_v2(
                {L2结构合同版本, 扫描代次.事实代次}, *登记.账锚点);
            if (扫描.状态 != L2结构状态::已读取)
                return 失败(L2特征当前值变化记录状态_v2::已可能发布,
                    v1.本次正式读回截止);
            for (const auto& 账 : 扫描.变化组) {
                if (账.特征参与者幂等身份 != 请求.特征参与者幂等身份)
                    continue;
                if (结果.变化账事实)
                    return 失败(L2特征当前值变化记录状态_v2::已可能发布,
                        v1.本次正式读回截止);
                结果.变化账事实 = 账;
            }
            if (!结果.变化账事实
                || 结果.变化账事实->组合幂等身份 != 请求.组合幂等身份
                || 结果.变化账事实->状态参与者幂等身份
                    != 请求.状态参与者幂等身份
                || 结果.变化账事实->动态参与者幂等身份
                    != 请求.动态参与者幂等身份
                || 结果.变化账事实->变化UTC纳秒 != 请求.变化UTC纳秒
                || 结果.变化账事实->来源存在 != 请求.来源存在
                || 结果.变化账事实->来源方法 != 请求.来源方法)
                return 失败(L2特征当前值变化记录状态_v2::已可能发布,
                    v1.本次正式读回截止);
            return 结果.成功() ? 结果
                : 失败(L2特征当前值变化记录状态_v2::已可能发布,
                    v1.本次正式读回截止);
        } catch (const std::bad_alloc&) {
            return 失败(L2特征当前值变化记录状态_v2::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2特征当前值变化记录状态_v2::资源失败);
        } catch (...) {
            return 失败(L2特征当前值变化记录状态_v2::内部错误);
        }
    }

private:
    L2特征当前值变化记录结果_v1 发布特征当前值变化与中性记录核心_v1(
        const L2特征当前值变化记录请求_v1& 请求,
        std::optional<当前值变化v2发布上下文> v2上下文) noexcept {
        const auto 失败 = [&](L2特征当前值变化记录状态_v1 状态,
            std::uint64_t 事实截止 = 0) {
            L2特征当前值变化记录结果_v1 结果;
            结果.状态 = 状态;
            结果.组合幂等身份 = 请求.组合幂等身份;
            结果.特征参与者幂等身份 = 请求.特征参与者幂等身份;
            结果.状态参与者幂等身份 = 请求.状态参与者幂等身份;
            结果.动态参与者幂等身份 = 请求.动态参与者幂等身份;
            结果.本次正式读回截止 = 事实截止;
            return 结果;
        };
        const auto 映射结构失败 = [&](L2结构状态 状态) {
            switch (状态) {
            case L2结构状态::入口拒绝:
                return L2特征当前值变化记录状态_v1::入口拒绝;
            case L2结构状态::事实代次漂移:
                return L2特征当前值变化记录状态_v1::当前性漂移;
            case L2结构状态::幂等冲突:
                return L2特征当前值变化记录状态_v1::幂等冲突;
            case L2结构状态::未找到:
            case L2结构状态::已退出:
            case L2结构状态::属性未设置:
                return L2特征当前值变化记录状态_v1::材料不足;
            case L2结构状态::引用冲突:
                return L2特征当前值变化记录状态_v1::引用冲突;
            case L2结构状态::资源失败:
                return L2特征当前值变化记录状态_v1::资源失败;
            default:
                return L2特征当前值变化记录状态_v1::内部错误;
            }
        };
        const bool 四键有效 = L2结构幂等身份有效(请求.组合幂等身份)
            && L2结构幂等身份有效(请求.特征参与者幂等身份)
            && L2结构幂等身份有效(请求.状态参与者幂等身份)
            && L2结构幂等身份有效(请求.动态参与者幂等身份)
            && 请求.组合幂等身份 != 请求.特征参与者幂等身份
            && 请求.组合幂等身份 != 请求.状态参与者幂等身份
            && 请求.组合幂等身份 != 请求.动态参与者幂等身份
            && 请求.特征参与者幂等身份 != 请求.状态参与者幂等身份
            && 请求.特征参与者幂等身份 != 请求.动态参与者幂等身份
            && 请求.状态参与者幂等身份 != 请求.动态参与者幂等身份;
        if (请求.合同版本 != L2特征当前值变化记录合同版本_v1
            || !L2结构请求头合同有效(请求.请求头)
            || 请求.请求头.期望事实代次 == 0 || !四键有效
            || !事务凭证_.有效() || !有效(请求.特征实例.值)
            || !有效(请求.预期旧当前值.值稳定编码)
            || 请求.预期旧当前值.特征实例 != 请求.特征实例
            || !L2特征值事实截止投影完整(
                请求.预期旧当前值, 请求.请求头.期望事实代次)
            || 请求.预期旧当前值.生命周期.退出事实代次
            || !L2特征当前值材料有效(请求.新值材料)
            || 请求.变化UTC纳秒 <= 0 || !有效(请求.主体存在.值)
            || !有效(请求.共同场景.值) || !有效(请求.来源存在.值)
            || (请求.来源方法 && !有效(请求.来源方法->值)))
            return 失败(L2特征当前值变化记录状态_v1::入口拒绝);
        try {
            const auto G0 = 请求.请求头.期望事实代次;
            const auto 当前代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.合同版本 != L1中性CRUD合同版本
                || 当前代次.事实代次 == 0)
                return 失败(当前代次.状态 == L1中性读取状态::资源失败
                    ? L2特征当前值变化记录状态_v1::资源失败
                    : L2特征当前值变化记录状态_v1::内部错误);
            if (当前代次.事实代次 < G0)
                return 失败(L2特征当前值变化记录状态_v1::当前性漂移);
            const auto Gnow = 当前代次.事实代次;
            const bool 首次候选 = Gnow == G0;
            const auto 读取类别 = 首次候选
                ? L2读取类别::当前 : L2读取类别::历史;
            const auto 历史截止 = 首次候选 ? 0ULL : G0;
            const L2结构请求头 当前请求头{L2结构合同版本, Gnow};

            const auto 实例 = 特征服务_.读取完整特征实例({当前请求头,
                读取类别, 请求.特征实例, 历史截止});
            if (实例.结果头.状态 != L2结构状态::已读取
                || !实例.特征实例 || !实例.特征实例->当前值)
                return 失败(映射结构失败(实例.结果头.状态));
            if (实例.特征实例->身份 != 请求.特征实例
                || 实例.特征实例->生命周期.退出事实代次
                || 实例.特征实例->宿主存在 != 请求.主体存在
                || *实例.特征实例->当前值 != 请求.预期旧当前值)
                return 失败(L2特征当前值变化记录状态_v1::当前性漂移);

            const auto 主体 = 存在服务_.读取存在身份来源({当前请求头,
                读取类别, 请求.主体存在, 历史截止});
            const auto 来源 = 存在服务_.读取存在身份来源({当前请求头,
                读取类别, 请求.来源存在, 历史截止});
            const auto 场景 = 场景服务_.读取场景身份来源({当前请求头,
                读取类别, 请求.共同场景, 历史截止});
            if (!主体.成功() || !主体.身份来源
                || !来源.成功() || !来源.身份来源
                || !场景.成功() || !场景.身份来源) {
                const bool 资源失败 =
                    主体.结果头.状态 == L2结构状态::资源失败
                    || 来源.结果头.状态 == L2结构状态::资源失败
                    || 场景.结果头.状态 == L2结构状态::资源失败;
                return 失败(资源失败
                    ? L2特征当前值变化记录状态_v1::资源失败
                    : L2特征当前值变化记录状态_v1::材料不足);
            }
            if (主体.身份来源->节点稳定编码 != 请求.主体存在.值
                || 来源.身份来源->节点稳定编码 != 请求.来源存在.值
                || 场景.身份来源->节点稳定编码 != 请求.共同场景.值)
                return 失败(L2特征当前值变化记录状态_v1::引用冲突);

            if (首次候选
                && 请求.预期旧当前值.类型化不可变材料 == 请求.新值材料) {
                auto 结果 = 失败(L2特征当前值变化记录状态_v1::无变化, G0);
                结果.当前值 = 请求.预期旧当前值;
                return 结果.成功() ? 结果
                    : 失败(L2特征当前值变化记录状态_v1::内部错误);
            }

            if (!状态服务_.结构类型登记定位_
                || !有效(状态服务_.状态上下文关系类型定位_.关系类型)
                || !动态服务_.结构类型登记定位_
                || !有效(动态服务_.动态上下文关系类型定位_.关系类型))
                return 失败(L2特征当前值变化记录状态_v1::材料不足);

            std::optional<L2中性状态引用事实_v1> 旧中性选择;
            bool legacy基线兼容 = false;
            const auto 中性选择 = 状态服务_.读取中性状态当前选择_v1({
                当前请求头, L2中性状态动态合同版本_v1, 读取类别,
                请求.特征实例.值, L2特征当前值记录状态角色_v1,
                历史截止});
            if (中性选择.成功() && 中性选择.引用 && 中性选择.目标状态) {
                const auto& 选择 = *中性选择.引用;
                const auto& 前状态 = *中性选择.目标状态;
                if (选择.引用方 != 请求.特征实例.值
                    || 选择.引用角色 != L2特征当前值记录状态角色_v1
                    || 选择.目标状态 != 前状态.身份
                    || 前状态.材料类别 != L2中性材料类别_v1::实例
                    || 前状态.特征类型 != 实例.特征实例->特征定义
                    || 前状态.特征值
                        != 请求.预期旧当前值.类型化不可变材料)
                    return 失败(L2特征当前值变化记录状态_v1::引用冲突);
                const auto 前上下文 = 状态服务_.读取中性状态上下文_v1({
                    当前请求头, L2中性状态动态合同版本_v1, 读取类别,
                    前状态.身份, 历史截止});
                if (!前上下文.成功() || !前上下文.上下文)
                    return 失败(前上下文.结果头.状态
                            == L2中性结构状态_v1::资源失败
                        ? L2特征当前值变化记录状态_v1::资源失败
                        : L2特征当前值变化记录状态_v1::材料不足);
                if (前上下文.上下文->状态 != 前状态.身份
                    || 前上下文.上下文->主体存在 != 请求.主体存在
                    || 前上下文.上下文->共同场景 != 请求.共同场景
                    || 前上下文.上下文->特征实例 != 请求.特征实例)
                    return 失败(L2特征当前值变化记录状态_v1::引用冲突);
                旧中性选择 = 选择;
            } else if (中性选择.结果头.状态
                == L2中性结构状态_v1::未找到) {
                legacy基线兼容 = true;
                if (首次候选) {
                    const auto legacy = 状态服务_.读取特征实例当前状态选择(
                        {当前请求头, 请求.特征实例});
                    if (!legacy.成功() || !legacy.当前状态
                        || !legacy.当前选择关系
                        || legacy.当前状态->主体存在 != 请求.主体存在
                        || legacy.当前状态->特征实例 != 请求.特征实例
                        || legacy.当前状态->精确值.类型化不可变材料
                            != 请求.预期旧当前值.类型化不可变材料)
                        return 失败(legacy.结果头.状态
                                == L2结构状态::资源失败
                            ? L2特征当前值变化记录状态_v1::资源失败
                            : L2特征当前值变化记录状态_v1::材料不足);
                } else {
                    const auto legacy = 状态服务_.读取特征实例历史状态选择(
                        {当前请求头, 请求.特征实例, G0});
                    if (!legacy.成功() || !legacy.状态
                        || !legacy.当前选择关系
                        || legacy.状态->主体存在 != 请求.主体存在
                        || legacy.状态->特征实例 != 请求.特征实例
                        || legacy.状态->精确值.类型化不可变材料
                            != 请求.预期旧当前值.类型化不可变材料)
                        return 失败(legacy.结果头.状态
                                == L2结构状态::资源失败
                            ? L2特征当前值变化记录状态_v1::资源失败
                            : L2特征当前值变化记录状态_v1::材料不足);
                }
            } else {
                return 失败(中性选择.结果头.状态
                        == L2中性结构状态_v1::资源失败
                    ? L2特征当前值变化记录状态_v1::资源失败
                    : 中性选择.结果头.状态
                            == L2中性结构状态_v1::事实代次漂移
                        ? L2特征当前值变化记录状态_v1::当前性漂移
                        : L2特征当前值变化记录状态_v1::引用冲突);
            }

            const auto 值来源 = 请求.来源方法
                ? 请求.来源方法->值 : 请求.来源存在.值;
            L2结构状态 特征参与者状态 = L2结构状态::内部不一致;
            std::optional<L1三分区原子参与者写集_v2> 特征参与者写集;
            L1所有者范围写集本地键 新当前值本地键{0x0203'1201U};
            if (v2上下文) {
                const auto 特征参与者 =
                    特征服务_.形成当前值变化三分区参与者_v2(
                        请求.请求头, 请求.特征参与者幂等身份,
                        请求.特征实例, 请求.预期旧当前值,
                        请求.新值材料, 值来源, v2上下文->账锚点,
                        请求.变化UTC纳秒, 请求.来源存在, 请求.来源方法,
                        请求.组合幂等身份, 请求.状态参与者幂等身份,
                        请求.动态参与者幂等身份);
                特征参与者状态 = 特征参与者.状态;
                特征参与者写集 = 特征参与者.参与者;
                新当前值本地键 = 特征参与者.新当前值本地键;
            } else {
                const auto 特征参与者 =
                    特征服务_.形成当前值变化三分区参与者_v1(
                        请求.请求头, 请求.特征参与者幂等身份,
                        请求.特征实例, 请求.预期旧当前值,
                        请求.新值材料, 值来源);
                特征参与者状态 = 特征参与者.状态;
                特征参与者写集 = 特征参与者.参与者;
                新当前值本地键 = 特征参与者.新当前值本地键;
            }
            if (特征参与者状态 != L2结构状态::已读取
                || !特征参与者写集)
                return 失败(映射结构失败(特征参与者状态));
            const auto 状态参与者 =
                状态服务_.中性状态提供者_.形成当前值记录状态参与者_v1(
                    请求.请求头, 请求.状态参与者幂等身份,
                    实例.特征实例->特征定义,
                    请求.预期旧当前值.类型化不可变材料,
                    请求.新值材料, 请求.变化UTC纳秒,
                    请求.主体存在, 请求.共同场景, 请求.特征实例,
                    请求.来源存在, L2特征当前值记录状态角色_v1,
                    状态服务_.状态上下文关系类型定位_.关系类型,
                    状态服务_.结构类型登记定位_->当前选择关系类型,
                    状态服务_.第一层写入端口_.所有者身份(),
                    旧中性选择, legacy基线兼容);
            if (状态参与者.状态 != L2结构状态::已读取
                || !状态参与者.参与者)
                return 失败(映射结构失败(状态参与者.状态));

            const L1三分区原子事实引用值_v2 前状态引用 =
                legacy基线兼容
                ? L1三分区原子事实引用_v2{{2},
                    状态参与者.前状态本地键}
                : L1三分区原子事实引用值_v2{
                    旧中性选择->目标状态.值};
            const L1三分区原子事实引用值_v2 后状态引用 =
                L1三分区原子事实引用_v2{{2},
                    状态参与者.后状态本地键};
            const auto 动态参与者 =
                动态服务_.中性动态提供者_.形成当前值记录动态参与者_v1(
                    请求.请求头, 请求.动态参与者幂等身份,
                    请求.主体存在, 请求.共同场景, 请求.特征实例,
                    请求.来源存在, 请求.来源方法, 前状态引用, 后状态引用,
                    动态服务_.动态上下文关系类型定位_.关系类型,
                    请求.变化UTC纳秒,
                    动态服务_.第一层写入端口_.所有者身份());
            if (动态参与者.状态 != L2结构状态::已读取
                || !动态参与者.参与者)
                return 失败(映射结构失败(动态参与者.状态));

            L1三分区原子事务请求_v2 L1请求;
            L1请求.合同版本 = L1三分区原子事务合同版本_v2;
            L1请求.共同期望事实代次 = G0;
            L1请求.组合写入幂等身份 = {请求.组合幂等身份.值};
            L1请求.参与者写集组.push_back(*特征参与者写集);
            L1请求.参与者写集组.push_back(*状态参与者.参与者);
            L1请求.参与者写集组.push_back(*动态参与者.参与者);
            const auto 写入 = 事务凭证_.提交(L1请求);
            const bool 写入状态成功 =
                写入.状态 == L1三分区原子事务状态_v2::已提交
                || 写入.状态 == L1三分区原子事务状态_v2::精确重复;
            if (写入.合同版本 != L1三分区原子事务合同版本_v2
                || 写入.组合写入幂等身份 != L1请求.组合写入幂等身份)
                return 失败(写入.是否已确认形成内存权威发布
                    ? L2特征当前值变化记录状态_v1::已可能发布
                    : L2特征当前值变化记录状态_v1::内部错误,
                    写入.共同事实代次);
            if (!写入状态成功) {
                if (写入.是否已确认形成内存权威发布
                    || 写入.状态 == L1三分区原子事务状态_v2::已可能发布
                    || !写入.参与者结果组.empty())
                    return 失败(L2特征当前值变化记录状态_v1::已可能发布,
                        写入.共同事实代次);
                switch (写入.状态) {
                case L1三分区原子事务状态_v2::入口拒绝:
                    return 失败(L2特征当前值变化记录状态_v1::入口拒绝);
                case L1三分区原子事务状态_v2::事实代次漂移:
                    return 失败(L2特征当前值变化记录状态_v1::当前性漂移);
                case L1三分区原子事务状态_v2::幂等冲突:
                    return 失败(L2特征当前值变化记录状态_v1::幂等冲突);
                case L1三分区原子事务状态_v2::引用冲突:
                    return 失败(L2特征当前值变化记录状态_v1::引用冲突);
                case L1三分区原子事务状态_v2::资源失败:
                    return 失败(L2特征当前值变化记录状态_v1::资源失败);
                default:
                    return 失败(L2特征当前值变化记录状态_v1::内部错误);
                }
            }
            const bool 首次完整 =
                写入.状态 == L1三分区原子事务状态_v2::已提交
                && 写入.是否已确认形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 =
                写入.状态 == L1三分区原子事务状态_v2::精确重复
                && !写入.是否已确认形成内存权威发布
                && 写入.重试边界
                    == L1所有者范围重试边界::原幂等身份读回收敛;
            const auto G1 = 写入.共同事实代次;
            if (G1 == 0 || 写入.参与者结果组.size() != 3
                || (!首次完整 && !重复完整))
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);

            const auto 参与者结果唯一匹配 = [&](std::uint8_t 参与者,
                L1结构所有者身份 所有者) noexcept {
                std::size_t 匹配数 = 0;
                for (const auto& 分区 : 写入.参与者结果组) {
                    if (分区.参与者.值 == 参与者 && 分区.所有者 == 所有者)
                        ++匹配数;
                }
                return 匹配数 == 1;
            };
            if (!参与者结果唯一匹配(
                    1, 特征参与者写集->所有者)
                || !参与者结果唯一匹配(
                    2, 状态参与者.参与者->所有者)
                || !参与者结果唯一匹配(
                    3, 动态参与者.参与者->所有者))
                return 失败(
                    L2特征当前值变化记录状态_v1::已可能发布, G1);

            const auto 查找编码 = [&](std::uint8_t 参与者,
                L1所有者范围写集本地键 本地键) -> std::optional<稳定编码> {
                std::optional<稳定编码> 结果;
                for (const auto& 分区 : 写入.参与者结果组) {
                    if (分区.参与者.值 != 参与者) continue;
                    for (const auto& [键, 编码] : 分区.新编码映射) {
                        if (键 != 本地键) continue;
                        if (结果 || !有效(编码)) return std::nullopt;
                        结果 = 编码;
                    }
                }
                return 结果;
            };
            const auto 新当前值 = 查找编码(1, 新当前值本地键);
            const auto 前状态 = legacy基线兼容
                ? 查找编码(2, 状态参与者.前状态本地键)
                : std::optional<稳定编码>{旧中性选择->目标状态.值};
            const auto 后状态 = 查找编码(2, 状态参与者.后状态本地键);
            const auto 新选择 = 查找编码(2, 状态参与者.新选择本地键);
            const auto 迁移动能 = 查找编码(
                3, 动态参与者.状态迁移动能本地键);
            const auto 动作动态 = 动态参与者.动作致变动态本地键
                ? 查找编码(3, *动态参与者.动作致变动态本地键)
                : std::optional<稳定编码>{};
            if (!新当前值 || !前状态 || !后状态 || !新选择 || !迁移动能
                || (请求.来源方法 && !动作动态)
                || (!请求.来源方法 && 动作动态))
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);

#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
            if (ARCH_迁移提交后首次读回失败一次_) {
                ARCH_迁移提交后首次读回失败一次_ = false;
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);
            }
#endif
            const auto 读回代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (读回代次.状态 != L1中性读取状态::成功
                || 读回代次.事实代次 < G1)
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);
            const L2特征当前值变化记录读取请求_v1 读回请求{
                L2特征当前值变化记录合同版本_v1,
                {L2结构合同版本, 读回代次.事实代次}, 请求.特征实例,
                *新当前值, L2中性状态引用身份_v1{*新选择},
                L2状态身份{*前状态}, L2状态身份{*后状态},
                L2动态身份{*迁移动能},
                动作动态 ? std::optional<L2动态身份>{L2动态身份{*动作动态}}
                    : std::nullopt,
                G1};
            const auto 读回 = 读取特征当前值变化记录_v1(读回请求);
            if (!读回.成功())
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);

            std::optional<L2中性状态引用事实_v1> 已退出旧选择;
            if (旧中性选择) {
                const auto 旧选择读回 = 状态服务_.读取中性状态引用_v1({
                    {L2结构合同版本, 读回代次.事实代次},
                    L2中性状态动态合同版本_v1, L2读取类别::历史,
                    旧中性选择->身份, G1});
                if (!旧选择读回.成功() || !旧选择读回.引用
                    || !旧选择读回.引用->生命周期.退出事实代次
                    || *旧选择读回.引用->生命周期.退出事实代次 != G1)
                    return 失败(
                        L2特征当前值变化记录状态_v1::已可能发布, G1);
                已退出旧选择 = *旧选择读回.引用;
            }

            if (!读回.当前值 || !读回.前状态 || !读回.后状态
                || !读回.当前选择 || !读回.状态迁移动能
                || 读回.当前值->特征实例 != 请求.特征实例
                || 读回.当前值->类型化不可变材料 != 请求.新值材料
                || 读回.当前值->来源稳定编码 != 值来源
                || 读回.前状态->特征值
                    != 请求.预期旧当前值.类型化不可变材料
                || 读回.后状态->特征值 != 请求.新值材料
                || 读回.后状态->首次形成UTC纳秒 != 请求.变化UTC纳秒
                || 读回.legacy基线兼容 != legacy基线兼容
                || 读回.状态上下文组.size() != 2
                || 读回.状态上下文组[0].主体存在 != 请求.主体存在
                || 读回.状态上下文组[0].共同场景 != 请求.共同场景
                || 读回.状态上下文组[0].特征实例 != 请求.特征实例
                || 读回.状态上下文组[1].主体存在 != 请求.主体存在
                || 读回.状态上下文组[1].共同场景 != 请求.共同场景
                || 读回.状态上下文组[1].特征实例 != 请求.特征实例
                || 读回.状态上下文组[1].来源存在 != 请求.来源存在
                || 读回.动态上下文组.empty())
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);
            const auto& 迁移上下文 = 读回.动态上下文组.front();
            if (迁移上下文.类别 != L2中性动态记录类别_v1::状态迁移
                || 迁移上下文.主体存在 != 请求.主体存在
                || 迁移上下文.共同场景 != 请求.共同场景
                || 迁移上下文.被改变特征实例 != 请求.特征实例
                || 迁移上下文.前状态 != 读回.前状态->身份
                || 迁移上下文.后状态 != 读回.后状态->身份
                || 迁移上下文.来源方法
                || 迁移上下文.同源状态迁移动能
                || 迁移上下文.来源存在 != 请求.来源存在)
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);
            if (请求.来源方法) {
                if (!读回.动作致变动态 || 读回.动态上下文组.size() != 2)
                    return 失败(
                        L2特征当前值变化记录状态_v1::已可能发布, G1);
                const auto& 动作上下文 = 读回.动态上下文组[1];
                if (动作上下文.类别
                        != L2中性动态记录类别_v1::动作致变
                    || 动作上下文.主体存在 != 请求.主体存在
                    || 动作上下文.共同场景 != 请求.共同场景
                    || 动作上下文.被改变特征实例 != 请求.特征实例
                    || 动作上下文.前状态 != 读回.前状态->身份
                    || 动作上下文.后状态 != 读回.后状态->身份
                    || 动作上下文.来源方法 != 请求.来源方法
                    || 动作上下文.同源状态迁移动能
                        != std::optional<L2动态身份>{
                            读回.状态迁移动能->身份}
                    || 动作上下文.来源存在 != 请求.来源存在)
                    return 失败(
                        L2特征当前值变化记录状态_v1::已可能发布, G1);
            } else if (读回.动作致变动态
                || 读回.动态上下文组.size() != 1) {
                return 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);
            }

            L2特征当前值变化记录结果_v1 结果;
            结果.状态 = 写入.状态 == L1三分区原子事务状态_v2::已提交
                ? L2特征当前值变化记录状态_v1::已提交
                : L2特征当前值变化记录状态_v1::精确重复;
            结果.组合幂等身份 = 请求.组合幂等身份;
            结果.特征参与者幂等身份 = 请求.特征参与者幂等身份;
            结果.状态参与者幂等身份 = 请求.状态参与者幂等身份;
            结果.动态参与者幂等身份 = 请求.动态参与者幂等身份;
            结果.当前值 = *读回.当前值;
            结果.前状态 = *读回.前状态;
            结果.后状态 = *读回.后状态;
            结果.当前选择 = *读回.当前选择;
            结果.已退出旧选择 = std::move(已退出旧选择);
            结果.状态迁移动能 = *读回.状态迁移动能;
            结果.动作致变动态 = 读回.动作致变动态;
            结果.状态上下文组 = 读回.状态上下文组;
            结果.动态上下文组 = 读回.动态上下文组;
            结果.legacy基线兼容 = legacy基线兼容;
            结果.本次正式读回截止 = G1;
            return 结果.成功() ? 结果
                : 失败(L2特征当前值变化记录状态_v1::已可能发布, G1);
        } catch (const std::bad_alloc&) {
            return 失败(L2特征当前值变化记录状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2特征当前值变化记录状态_v1::资源失败);
        } catch (...) {
            return 失败(L2特征当前值变化记录状态_v1::内部错误);
        }
    }

public:
    L2特征当前值变化记录读取结果_v1 读取特征当前值变化记录_v1(
        const L2特征当前值变化记录读取请求_v1& 请求) const noexcept {
        const auto 失败 = [&](L2特征当前值变化记录读取状态_v1 状态) {
            L2特征当前值变化记录读取结果_v1 结果;
            结果.状态 = 状态;
            return 结果;
        };
        if (请求.合同版本 != L2特征当前值变化记录合同版本_v1
            || !L2结构请求头合同有效(请求.请求头)
            || 请求.请求头.期望事实代次 == 0
            || !有效(请求.特征实例.值)
            || !有效(请求.新当前值稳定编码)
            || !有效(请求.新当前选择.值)
            || !有效(请求.前状态.值) || !有效(请求.后状态.值)
            || !有效(请求.状态迁移动能.值)
            || (请求.动作致变动态 && !有效(请求.动作致变动态->值))
            || 请求.首次事实代次 == 0
            || 请求.首次事实代次 > 请求.请求头.期望事实代次)
            return 失败(L2特征当前值变化记录读取状态_v1::入口拒绝);
        try {
            const auto Gread = 请求.请求头.期望事实代次;
            const auto 前守卫 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (前守卫.状态 != L1中性读取状态::成功)
                return 失败(前守卫.状态 == L1中性读取状态::资源失败
                    ? L2特征当前值变化记录读取状态_v1::资源失败
                    : L2特征当前值变化记录读取状态_v1::内部错误);
            if (前守卫.事实代次 != Gread)
                return 失败(L2特征当前值变化记录读取状态_v1::当前性漂移);
            const L2结构请求头 读回头{L2结构合同版本, Gread};
            const auto 实例 = 特征服务_.读取完整特征实例({读回头,
                L2读取类别::历史, 请求.特征实例, 请求.首次事实代次});
            if (实例.结果头.状态 != L2结构状态::已读取
                || !实例.特征实例 || !实例.特征实例->当前值
                || 实例.特征实例->当前值->值稳定编码
                    != 请求.新当前值稳定编码)
                return 失败(实例.结果头.状态 == L2结构状态::资源失败
                    ? L2特征当前值变化记录读取状态_v1::资源失败
                    : L2特征当前值变化记录读取状态_v1::材料不足);
            const auto 前状态 = 状态服务_.读取中性状态_v1({读回头,
                L2中性状态动态合同版本_v1, L2读取类别::历史,
                请求.前状态, 请求.首次事实代次});
            const auto 后状态 = 状态服务_.读取中性状态_v1({读回头,
                L2中性状态动态合同版本_v1, L2读取类别::历史,
                请求.后状态, 请求.首次事实代次});
            const auto 选择 = 状态服务_.读取中性状态引用_v1({读回头,
                L2中性状态动态合同版本_v1, L2读取类别::历史,
                请求.新当前选择, 请求.首次事实代次});
            const auto 迁移 = 动态服务_.读取中性动态_v1({读回头,
                L2中性状态动态合同版本_v1, L2读取类别::历史,
                请求.状态迁移动能, 请求.首次事实代次});
            if (!前状态.成功() || !后状态.成功() || !选择.成功()
                || !迁移.成功() || !前状态.状态 || !后状态.状态
                || !选择.引用 || !迁移.动态)
                return 失败(L2特征当前值变化记录读取状态_v1::材料不足);
            std::optional<L2中性动态事实_v1> 动作动态;
            if (请求.动作致变动态) {
                const auto 动作 = 动态服务_.读取中性动态_v1({读回头,
                    L2中性状态动态合同版本_v1, L2读取类别::历史,
                    *请求.动作致变动态, 请求.首次事实代次});
                if (!动作.成功() || !动作.动态)
                    return 失败(L2特征当前值变化记录读取状态_v1::材料不足);
                动作动态 = *动作.动态;
            }
            std::vector<L2中性状态上下文事实_v1> 状态上下文组;
            for (const auto 状态身份 : {请求.前状态, 请求.后状态}) {
                const auto 上下文 = 状态服务_.读取中性状态上下文_v1({
                    读回头, L2中性状态动态合同版本_v1,
                    L2读取类别::历史, 状态身份, 请求.首次事实代次});
                if (!上下文.成功() || !上下文.上下文)
                    return 失败(L2特征当前值变化记录读取状态_v1::材料不足);
                状态上下文组.push_back(*上下文.上下文);
            }
            std::vector<L2中性动态上下文事实_v1> 动态上下文组;
            std::vector<L2动态身份> 动态身份组{请求.状态迁移动能};
            if (请求.动作致变动态) 动态身份组.push_back(*请求.动作致变动态);
            for (const auto 动态身份 : 动态身份组) {
                const auto 上下文 = 动态服务_.读取中性动态上下文_v1({
                    读回头, L2中性状态动态合同版本_v1,
                    L2读取类别::历史, 动态身份, 请求.首次事实代次});
                if (!上下文.成功() || !上下文.上下文)
                    return 失败(L2特征当前值变化记录读取状态_v1::材料不足);
                动态上下文组.push_back(*上下文.上下文);
            }
            const auto 后守卫 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (后守卫.状态 != L1中性读取状态::成功
                || 后守卫.事实代次 != Gread)
                return 失败(后守卫.状态 == L1中性读取状态::资源失败
                    ? L2特征当前值变化记录读取状态_v1::资源失败
                    : L2特征当前值变化记录读取状态_v1::当前性漂移);
            L2特征当前值变化记录读取结果_v1 结果;
            结果.状态 = L2特征当前值变化记录读取状态_v1::已读取;
            结果.当前值 = *实例.特征实例->当前值;
            结果.前状态 = *前状态.状态;
            结果.后状态 = *后状态.状态;
            结果.当前选择 = *选择.引用;
            结果.状态迁移动能 = *迁移.动态;
            结果.动作致变动态 = std::move(动作动态);
            结果.状态上下文组 = std::move(状态上下文组);
            结果.动态上下文组 = std::move(动态上下文组);
            结果.legacy基线兼容 =
                结果.前状态->形成事实代次 == 请求.首次事实代次;
            结果.本次正式读回截止 = Gread;
            return 结果.成功() ? 结果
                : 失败(L2特征当前值变化记录读取状态_v1::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(L2特征当前值变化记录读取状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2特征当前值变化记录读取状态_v1::资源失败);
        } catch (...) {
            return 失败(L2特征当前值变化记录读取状态_v1::内部错误);
        }
    }

    L2特征当前值变化组读取结果_v2 按特征实例与UTC范围读取完整变化组_v2(
        const L2特征当前值变化组读取请求_v2& 请求) const noexcept {
        const auto 失败 = [&](L2特征当前值变化组读取状态_v2 状态) noexcept {
            L2特征当前值变化组读取结果_v2 结果;
            结果.状态 = 状态;
            return 结果;
        };
        if (请求.合同版本 != L2特征当前值变化永久账合同版本_v2
            || !L2结构请求头合同有效(请求.请求头)
            || 请求.请求头.期望事实代次 == 0 || !有效(请求.特征实例.值)
            || 请求.包含起始UTC纳秒 <= 0
            || 请求.排除结束UTC纳秒 <= 请求.包含起始UTC纳秒
            || 请求.数量预算 == 0)
            return 失败(L2特征当前值变化组读取状态_v2::入口拒绝);
        try {
            const auto G0 = 请求.请求头.期望事实代次;
            const auto 读前 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (读前.状态 != L1中性读取状态::成功)
                return 失败(读前.状态 == L1中性读取状态::资源失败
                    ? L2特征当前值变化组读取状态_v2::资源失败
                    : L2特征当前值变化组读取状态_v2::内部错误);
            if (读前.事实代次 != G0)
                return 失败(L2特征当前值变化组读取状态_v2::当前性漂移);
            const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            if (实例.结果头.状态 != L2结构状态::已读取
                || !实例.特征实例
                || 实例.特征实例->身份 != 请求.特征实例
                || 实例.特征实例->生命周期.退出事实代次)
                return 失败(实例.结果头.状态 == L2结构状态::资源失败
                    ? L2特征当前值变化组读取状态_v2::资源失败
                    : L2特征当前值变化组读取状态_v2::引用冲突);
            const auto 登记 = 特征服务_.读取当前值变化账登记_v2(请求.请求头);
            if (登记.状态 == L2结构状态::未找到)
                return 失败(L2特征当前值变化组读取状态_v2::账未登记);
            if (登记.状态 != L2结构状态::已读取 || !登记.账锚点
                || 登记.首次登记事实代次 == 0)
                return 失败(登记.状态 == L2结构状态::事实代次漂移
                    ? L2特征当前值变化组读取状态_v2::当前性漂移
                    : 登记.状态 == L2结构状态::资源失败
                        ? L2特征当前值变化组读取状态_v2::资源失败
                        : L2特征当前值变化组读取状态_v2::集合不闭合);
            const auto 扫描 = 特征服务_.扫描全部当前值变化账_v2(
                请求.请求头, *登记.账锚点);
            if (扫描.状态 != L2结构状态::已读取)
                return 失败(扫描.状态 == L2结构状态::事实代次漂移
                    ? L2特征当前值变化组读取状态_v2::当前性漂移
                    : 扫描.状态 == L2结构状态::资源失败
                        ? L2特征当前值变化组读取状态_v2::资源失败
                        : L2特征当前值变化组读取状态_v2::集合不闭合);
            const auto 参与者首次完整 = [&](const L1所有者范围写端口& 端口,
                L2结构幂等身份 身份, std::uint64_t G1) noexcept {
                const auto 首次 = 端口.读取首次写入材料({
                    L1所有者范围首次写入读取合同版本,
                    L1所有者范围写入幂等身份{身份.值}});
                return 首次.状态 == L1所有者范围读取状态::成功
                    && 首次.合同版本 == L1所有者范围首次写入读取合同版本
                    && 首次.所有者 == 端口.所有者身份()
                    && 首次.写入幂等身份.值 == 身份.值
                    && 首次.读取事实代次 == G0
                    && 首次.首次规范化写集 && 首次.首次写入结果
                    && 首次.首次写入结果->状态
                        == L1所有者范围写入状态::成功
                    && 首次.首次写入结果->所有者 == 端口.所有者身份()
                    && 首次.首次写入结果->写入幂等身份.值 == 身份.值
                    && 首次.首次写入结果->事实代次 == G1
                    && 首次.首次写入结果->是否形成内存权威发布;
            };
            auto 全部 = 扫描.变化组;
            std::sort(全部.begin(), 全部.end(), [](const auto& 左,
                const auto& 右) noexcept {
                if (左.身份.值 != 右.身份.值) return 左.身份.值 < 右.身份.值;
                return 左.形成事实代次 < 右.形成事实代次;
            });
            for (std::size_t i = 0; i != 全部.size(); ++i) {
                const auto& 账 = 全部[i];
                const bool 四键有效 =
                    L2结构幂等身份有效(账.组合幂等身份)
                    && L2结构幂等身份有效(账.特征参与者幂等身份)
                    && L2结构幂等身份有效(账.状态参与者幂等身份)
                    && L2结构幂等身份有效(账.动态参与者幂等身份)
                    && 账.组合幂等身份 != 账.特征参与者幂等身份
                    && 账.组合幂等身份 != 账.状态参与者幂等身份
                    && 账.组合幂等身份 != 账.动态参与者幂等身份
                    && 账.特征参与者幂等身份 != 账.状态参与者幂等身份
                    && 账.特征参与者幂等身份 != 账.动态参与者幂等身份
                    && 账.状态参与者幂等身份 != 账.动态参与者幂等身份;
                const bool 状态参与者完整 = 参与者首次完整(
                    状态服务_.第一层写入端口_,
                    账.状态参与者幂等身份, 账.形成事实代次);
                const bool 动态参与者完整 = 参与者首次完整(
                    动态服务_.第一层写入端口_,
                    账.动态参与者幂等身份, 账.形成事实代次);
                if (!四键有效 || 账.形成事实代次 == 0
                    || 账.形成事实代次 <= 登记.首次登记事实代次
                    || !状态参与者完整 || !动态参与者完整) {
                    return 失败(L2特征当前值变化组读取状态_v2::集合不闭合);
                }
                if (i != 0 && 全部[i - 1].身份 == 账.身份)
                    return 失败(L2特征当前值变化组读取状态_v2::集合不闭合);
                for (std::size_t j = 0; j != i; ++j) {
                    if (全部[j].特征实例 == 账.特征实例
                        && 全部[j].形成事实代次 == 账.形成事实代次)
                        return 失败(
                            L2特征当前值变化组读取状态_v2::集合不闭合);
                }
            }
            std::vector<L2特征当前值变化账事实_v2> 命中;
            for (const auto& 账 : 全部) {
                if (账.特征实例 == 请求.特征实例
                    && 账.变化UTC纳秒 >= 请求.包含起始UTC纳秒
                    && 账.变化UTC纳秒 < 请求.排除结束UTC纳秒)
                    命中.push_back(账);
            }
            std::sort(命中.begin(), 命中.end(), [](const auto& 左,
                const auto& 右) noexcept {
                if (左.变化UTC纳秒 != 右.变化UTC纳秒)
                    return 左.变化UTC纳秒 < 右.变化UTC纳秒;
                return 左.身份.值 < 右.身份.值;
            });
            if (命中.size() > 请求.数量预算)
                return 失败(L2特征当前值变化组读取状态_v2::数量预算不足);
            L2特征当前值变化完整集合见证_v2 见证;
            见证.账登记事实代次 = 登记.首次登记事实代次;
            见证.特征实例 = 请求.特征实例;
            见证.包含起始UTC纳秒 = 请求.包含起始UTC纳秒;
            见证.排除结束UTC纳秒 = 请求.排除结束UTC纳秒;
            见证.声明成员数 = 命中.size();
            见证.G0 = G0;
            for (const auto& 账 : 命中) 见证.规范成员身份组.push_back(账.身份);
            const auto 读后 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (读后.状态 != L1中性读取状态::成功
                || 读后.事实代次 != G0)
                return 失败(读后.状态 == L1中性读取状态::资源失败
                    ? L2特征当前值变化组读取状态_v2::资源失败
                    : L2特征当前值变化组读取状态_v2::当前性漂移);
            L2特征当前值变化组读取结果_v2 结果;
            结果.状态 = L2特征当前值变化组读取状态_v2::已读取;
            结果.完整变化组 = std::move(命中);
            结果.完整集合见证 = std::move(见证);
            结果.本次正式读回截止 = G0;
            return 结果.成功() ? 结果
                : 失败(L2特征当前值变化组读取状态_v2::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(L2特征当前值变化组读取状态_v2::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2特征当前值变化组读取状态_v2::资源失败);
        } catch (...) {
            return 失败(L2特征当前值变化组读取状态_v2::内部错误);
        }
    }

private:
    const L1事实基座服务& 第一层服务_;
    const L2存在结构服务& 存在服务_;
    const L2场景结构服务& 场景服务_;
    L2特征结构服务& 特征服务_;
    const L2状态结构服务& 状态服务_;
    const L2动态结构服务& 动态服务_;
    L1三分区原子事务凭证_v2 事务凭证_;
#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
    bool ARCH_迁移提交后首次读回失败一次_ = false;
    bool ARCH_变化账登记提交后首次读回失败一次_ = false;
#endif
};

} // namespace 海中鱼巣
