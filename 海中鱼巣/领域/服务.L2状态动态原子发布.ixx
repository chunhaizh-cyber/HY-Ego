module;

#include <optional>
#include <new>
#include <utility>

#define L2_STATE_DYNAMIC_ATOMIC_PUBLISH_NO_INCLUDES

export module 海中鱼巣.领域.服务.L2状态动态原子发布;
export import 海中鱼巣.领域.合同.L2结构公共;
import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2动态结构;

export {
#include "L2状态动态原子发布.数据.h"
}

export namespace 海中鱼巣 {

bool L2状态动态迁移结果_v2::成功() const noexcept {
    const bool 状态配对 =
        (结果头.状态 == L2结构状态::已提交
            && 迁移操作状态 == L2状态动态迁移操作状态_v2::已提交)
        || (结果头.状态 == L2结构状态::精确重复
            && 迁移操作状态 == L2状态动态迁移操作状态_v2::精确重复);
    if (原子发布合同版本 != L2状态动态迁移专属合同版本_v2
        || 结果头.合同版本 != L2结构合同版本 || !状态配对
        || 结果头.事实截止代次 == 0 || !结果头.变更事实代次
        || *结果头.变更事实代次 == 0
        || *结果头.变更事实代次 > 结果头.事实截止代次
        || 共同事实截止代次 != *结果头.变更事实代次
        || !新状态 || !新状态自有关系 || !新动态 || !新动态自有关系
        || !新当前选择关系 || !已退出旧当前选择关系)
        return false;

    const auto G1 = 共同事实截止代次;
    const auto& 状态 = *新状态;
    const auto& 动态 = *新动态;
    const auto& 当前选择 = *新当前选择关系;
    const auto& 旧选择退出 = *已退出旧当前选择关系;
    return 有效(状态.身份.值) && 有效(动态.身份.值)
        && 状态.生命周期.创建事实代次 == G1
        && !状态.生命周期.退出事实代次
        && 动态.生命周期.创建事实代次 == G1
        && !动态.生命周期.退出事实代次
        && L2状态当前选择关系引用完整(当前选择, G1)
        && L2状态当前选择关系引用完整(旧选择退出, G1)
        && 当前选择.生命周期.创建事实代次 == G1
        && !当前选择.生命周期.退出事实代次
        && 旧选择退出.生命周期.退出事实代次 == G1
        && 当前选择.关系稳定编码 != 旧选择退出.关系稳定编码
        && 当前选择.特征实例 == 状态.特征实例
        && 当前选择.状态 == 状态.身份
        && 旧选择退出.特征实例 == 当前选择.特征实例
        && 旧选择退出.状态 == 动态.前状态
        && 当前选择.关系类型 == 旧选择退出.关系类型
        && 当前选择.写入所有者 == 旧选择退出.写入所有者
        && 当前选择.角色或顺序 == 1
        && 旧选择退出.角色或顺序 == 1
        && 动态.主体存在 == 状态.主体存在
        && 动态.后状态 == 状态.身份
        && 动态.来源稳定编码 == 状态.来源稳定编码
        && 有效(新状态自有关系->族归属关系稳定编码)
        && 有效(新状态自有关系->主体关系稳定编码)
        && 有效(新状态自有关系->特征实例关系稳定编码)
        && 当前选择.关系稳定编码
            != 新状态自有关系->族归属关系稳定编码
        && 当前选择.关系稳定编码
            != 新状态自有关系->主体关系稳定编码
        && 当前选择.关系稳定编码
            != 新状态自有关系->特征实例关系稳定编码
        && 有效(新动态自有关系->族归属关系稳定编码)
        && 有效(新动态自有关系->主体关系稳定编码)
        && 有效(新动态自有关系->前状态关系稳定编码)
        && 有效(新动态自有关系->后状态关系稳定编码);
}

class L1跨所有者原子事务凭证 final {
public:
    L1跨所有者原子事务凭证() = delete;
    L1跨所有者原子事务凭证(const L1跨所有者原子事务凭证&) = delete;
    L1跨所有者原子事务凭证& operator=(
        const L1跨所有者原子事务凭证&) = delete;
    L1跨所有者原子事务凭证(
        L1跨所有者原子事务凭证&&) noexcept = default;
    L1跨所有者原子事务凭证& operator=(
        L1跨所有者原子事务凭证&&) noexcept = default;

    bool 有效() const noexcept {
        return 第一层服务_ && 状态端口_ && 动态端口_
            && 状态端口_->有效() && 动态端口_->有效()
            && 状态端口_->绑定于(*第一层服务_)
            && 动态端口_->绑定于(*第一层服务_)
            && 状态端口_->所有者身份() != 动态端口_->所有者身份();
    }

    L1跨所有者原子事务结果 提交(
        const L1跨所有者原子事务请求& 请求) noexcept {
        if (!有效())
            return {L1跨所有者原子事务状态::许可拒绝,
                L1跨所有者原子事务合同版本, 0, false,
                L1所有者范围重试边界::修正请求后可重试, {}, {}};
        if (请求.状态写集.所有者 != 状态端口_->所有者身份()
            || 请求.动态写集.所有者 != 动态端口_->所有者身份())
            return {L1跨所有者原子事务状态::许可拒绝,
                L1跨所有者原子事务合同版本, 0, false,
                L1所有者范围重试边界::修正请求后可重试, {}, {}};
        return 状态端口_->提交跨所有者原子事务(请求, *动态端口_);
    }

private:
    L1跨所有者原子事务凭证(const L1事实基座服务& 第一层服务,
        L1所有者范围写端口& 状态端口,
        L1所有者范围写端口& 动态端口) noexcept
        : 第一层服务_(&第一层服务), 状态端口_(&状态端口),
          动态端口_(&动态端口) {}
    friend std::optional<L1跨所有者原子事务凭证>
    尝试形成L1跨所有者原子事务凭证(
        const L1事实基座服务&, L1所有者范围写端口&,
        L1所有者范围写端口&) noexcept;

    const L1事实基座服务* 第一层服务_ = nullptr;
    L1所有者范围写端口* 状态端口_ = nullptr;
    L1所有者范围写端口* 动态端口_ = nullptr;
};

std::optional<L1跨所有者原子事务凭证>
尝试形成L1跨所有者原子事务凭证(
    const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 状态端口,
    L1所有者范围写端口& 动态端口) noexcept {
    try {
        if (!状态端口.有效() || !动态端口.有效()
            || !状态端口.绑定于(第一层服务)
            || !动态端口.绑定于(第一层服务)
            || 状态端口.所有者身份() == 动态端口.所有者身份())
            return std::nullopt;
        return L1跨所有者原子事务凭证{第一层服务, 状态端口, 动态端口};
    } catch (...) {
        return std::nullopt;
    }
}

class L2状态动态原子发布服务 final {
public:
    L2状态动态原子发布服务() = delete;
    L2状态动态原子发布服务(const L2状态动态原子发布服务&) = delete;
    L2状态动态原子发布服务& operator=(
        const L2状态动态原子发布服务&) = delete;

    L2状态动态原子发布服务(
        const L1事实基座服务& 第一层服务,
        const L2状态结构服务& 状态服务,
        const L2动态结构服务& 动态服务,
        L1跨所有者原子事务凭证&& 事务凭证) noexcept
        : 第一层服务_(第一层服务), 状态服务_(状态服务),
          动态服务_(动态服务),
          事务凭证_(std::move(事务凭证)) {}

    bool 事务凭证有效() const noexcept { return 事务凭证_.有效(); }

#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
    void ARCH_注入迁移提交后首次读回失败一次() noexcept {
        ARCH_迁移提交后首次读回失败一次_ = true;
    }
#endif

    L2状态动态原子发布结果 发布状态动态原子迁移(
        const L2状态动态原子发布请求&) noexcept {
        return {{L2结构合同版本, L2结构状态::入口拒绝, 0,
            std::nullopt}, std::nullopt, std::nullopt, std::nullopt,
            std::nullopt, std::nullopt};
    }

    L2状态动态迁移结果_v2 发布状态动态原子迁移_v2(
        const L2状态动态迁移请求_v2& 请求) noexcept {
        const auto 交换前失败 = [](L2结构状态 公共状态,
            L2状态动态迁移操作状态_v2 专用状态) {
            L2状态动态迁移结果_v2 结果;
            结果.结果头 = {L2结构合同版本, 公共状态, 0, std::nullopt};
            结果.迁移操作状态 = 专用状态;
            return 结果;
        };
        const auto 形成提交后失败 = [](L2状态动态迁移结果_v2 结果) {
            结果.结果头.合同版本 = L2结构合同版本;
            结果.结果头.状态 = L2结构状态::内部不一致;
            结果.结果头.事实截止代次 = 结果.共同事实截止代次;
            结果.结果头.变更事实代次 = 结果.共同事实截止代次;
            结果.迁移操作状态 = L2状态动态迁移操作状态_v2::已可能发布;
            结果.新状态.reset();
            结果.新状态自有关系.reset();
            结果.新动态.reset();
            结果.新动态自有关系.reset();
            结果.新当前选择关系.reset();
            结果.已退出旧当前选择关系.reset();
            return 结果;
        };
        const auto 映射交换前失败 = [&](L2结构状态 状态) {
            switch (状态) {
            case L2结构状态::许可拒绝:
                return 交换前失败(状态, L2状态动态迁移操作状态_v2::许可拒绝);
            case L2结构状态::事实代次漂移:
                return 交换前失败(状态,
                    L2状态动态迁移操作状态_v2::事实代次漂移);
            case L2结构状态::幂等冲突:
                return 交换前失败(状态, L2状态动态迁移操作状态_v2::幂等冲突);
            case L2结构状态::引用冲突:
                return 交换前失败(状态, L2状态动态迁移操作状态_v2::引用冲突);
            case L2结构状态::资源失败:
                return 交换前失败(状态, L2状态动态迁移操作状态_v2::资源失败);
            case L2结构状态::未找到:
            case L2结构状态::已退出:
                return 交换前失败(L2结构状态::入口拒绝,
                    L2状态动态迁移操作状态_v2::待迁移);
            case L2结构状态::入口拒绝:
                return 交换前失败(状态, L2状态动态迁移操作状态_v2::入口拒绝);
            default:
                return 交换前失败(L2结构状态::内部不一致,
                    L2状态动态迁移操作状态_v2::内部不一致);
            }
        };
        const auto 映射L1失败 = [&](L1跨所有者原子事务状态 状态) {
            switch (状态) {
            case L1跨所有者原子事务状态::入口拒绝:
                return 交换前失败(L2结构状态::入口拒绝,
                    L2状态动态迁移操作状态_v2::入口拒绝);
            case L1跨所有者原子事务状态::许可拒绝:
                return 交换前失败(L2结构状态::许可拒绝,
                    L2状态动态迁移操作状态_v2::许可拒绝);
            case L1跨所有者原子事务状态::事实代次漂移:
                return 交换前失败(L2结构状态::事实代次漂移,
                    L2状态动态迁移操作状态_v2::事实代次漂移);
            case L1跨所有者原子事务状态::幂等冲突:
                return 交换前失败(L2结构状态::幂等冲突,
                    L2状态动态迁移操作状态_v2::幂等冲突);
            case L1跨所有者原子事务状态::引用冲突:
                return 交换前失败(L2结构状态::引用冲突,
                    L2状态动态迁移操作状态_v2::引用冲突);
            case L1跨所有者原子事务状态::资源失败:
                return 交换前失败(L2结构状态::资源失败,
                    L2状态动态迁移操作状态_v2::资源失败);
            case L1跨所有者原子事务状态::未找到:
            case L1跨所有者原子事务状态::已退出:
                return 交换前失败(L2结构状态::入口拒绝,
                    L2状态动态迁移操作状态_v2::待迁移);
            default:
                return 交换前失败(L2结构状态::内部不一致,
                    L2状态动态迁移操作状态_v2::内部不一致);
            }
        };

        if (!请求.有效())
            return 交换前失败(L2结构状态::入口拒绝,
                L2状态动态迁移操作状态_v2::入口拒绝);
        if (!事务凭证_.有效())
            return 交换前失败(L2结构状态::许可拒绝,
                L2状态动态迁移操作状态_v2::许可拒绝);

        bool 提交已确认 = false;
        L2状态动态迁移结果_v2 结果;
        try {
            const auto 形成代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (形成代次.状态 != L1中性读取状态::成功
                || 形成代次.合同版本 != L1中性CRUD合同版本
                || 形成代次.事实代次 == 0)
                return 交换前失败(
                    形成代次.状态 == L1中性读取状态::资源失败
                        ? L2结构状态::资源失败 : L2结构状态::内部不一致,
                    形成代次.状态 == L1中性读取状态::资源失败
                        ? L2状态动态迁移操作状态_v2::资源失败
                        : L2状态动态迁移操作状态_v2::内部不一致);
            auto 组合身份值 = L2状态动态原子发布幂等域 ^ 请求.幂等身份.值;
            // XOR 在唯一输入等于域常量时会产生零；零是无效身份。该输出原本
            // 只对应无效输入零，因此映射回域常量仍保持全部合法输入的一一性。
            if (组合身份值 == 0) 组合身份值 = L2状态动态原子发布幂等域;
            const L1所有者范围写入幂等身份 组合身份{组合身份值};
            L2状态原子参与者请求 状态参与者请求;
            状态参与者请求.合同版本 = L2结构合同版本;
            状态参与者请求.共同期望事实代次 =
                请求.请求头.共同请求头.期望事实代次;
            状态参与者请求.组合写入幂等身份 = 组合身份;
            状态参与者请求.主体存在 = 请求.主体存在;
            状态参与者请求.旧当前状态 = 请求.旧当前状态;
            状态参与者请求.新状态特征实例 = 请求.新状态特征实例;
            状态参与者请求.新状态精确值材料 = 请求.新状态精确值材料;
            状态参与者请求.新状态时间值材料 = 请求.新状态时间值材料;
            状态参与者请求.来源方法稳定编码 = 请求.来源方法稳定编码;
            状态参与者请求.旧当前选择 = 请求.旧当前选择;
            const auto 状态形成 =
                状态服务_.形成状态原子参与者写集(状态参与者请求);
            if (状态形成.状态 != L2结构状态::已读取
                || !状态形成.参与者)
                return 映射交换前失败(状态形成.状态);

            L2动态原子参与者请求 动态参与者请求;
            动态参与者请求.合同版本 = L2结构合同版本;
            动态参与者请求.共同期望事实代次 =
                形成代次.事实代次;
            动态参与者请求.组合写入幂等身份 = 组合身份;
            动态参与者请求.主体存在 = 请求.主体存在;
            动态参与者请求.变化特征实例 = 请求.新状态特征实例;
            动态参与者请求.前状态 = 请求.旧当前状态;
            动态参与者请求.后状态 = L2状态身份{};
            动态参与者请求.后状态局部引用 = {
                L1跨所有者原子事务参与者序号::状态,
                状态形成.局部键.状态节点};
            动态参与者请求.起始时间材料 = 请求.动态起始时间材料;
            动态参与者请求.结束时间材料 = 请求.动态结束时间材料;
            动态参与者请求.来源方法稳定编码 = 请求.来源方法稳定编码;
            auto 动态形成 =
                动态服务_.形成动态原子参与者写集(动态参与者请求);
            if (动态形成.状态 != L2结构状态::已读取
                || !动态形成.参与者)
                return 映射交换前失败(动态形成.状态);
            // 动态 helper 只以 Gread 验证永久旧状态和主体。提交请求仍必须
            // 恢复原始 G0，才能与首次 L1 事务逐字段相等并由幂等账裁决。
            动态形成.参与者->写集.期望事实代次 =
                请求.请求头.共同请求头.期望事实代次;

            const auto 状态所有者 = 状态形成.参与者->所有者;
            L1跨所有者原子事务请求 事务;
            事务.合同版本 = L1跨所有者原子事务合同版本;
            事务.共同期望事实代次 =
                请求.请求头.共同请求头.期望事实代次;
            事务.组合写入幂等身份 = 组合身份;
            事务.状态写集 = *状态形成.参与者;
            事务.动态写集 = *动态形成.参与者;
            const auto 提交 = 事务凭证_.提交(事务);
            if (提交.状态 != L1跨所有者原子事务状态::已提交
                && 提交.状态 != L1跨所有者原子事务状态::精确重复)
                return 映射L1失败(提交.状态);

            提交已确认 = true;
            结果.结果头 = {L2结构合同版本,
                提交.状态 == L1跨所有者原子事务状态::精确重复
                    ? L2结构状态::精确重复 : L2结构状态::已提交,
                提交.共同事实代次, 提交.共同事实代次};
            结果.迁移操作状态 =
                提交.状态 == L1跨所有者原子事务状态::精确重复
                    ? L2状态动态迁移操作状态_v2::精确重复
                    : L2状态动态迁移操作状态_v2::已提交;
            结果.共同事实截止代次 = 提交.共同事实代次;

            const auto 当前代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.合同版本 != L1中性CRUD合同版本
                || 当前代次.事实代次 < 提交.共同事实代次)
                return 形成提交后失败(std::move(结果));
            const auto Gnow = 当前代次.事实代次;
            const auto Gread = 提交.共同事实代次;
            结果.结果头.事实截止代次 = Gread;

            const auto 查映射 = [](const auto& 映射,
                std::uint32_t 局部值) -> std::optional<稳定编码> {
                for (const auto& [键, 编码] : 映射)
                    if (键.值 == 局部值) return 编码;
                return std::nullopt;
            };
            const auto 新状态编码 = 查映射(提交.状态编码映射,
                状态形成.局部键.状态节点.值);
            const auto 新动态编码 = 查映射(提交.动态编码映射,
                动态形成.局部键.动态节点.值);
            const auto 新选择编码 = 查映射(提交.状态编码映射,
                状态形成.局部键.当前选择关系.值);
            if (!新状态编码 || !新动态编码 || !新选择编码)
                return 形成提交后失败(std::move(结果));

            const L2状态身份 新状态{*新状态编码};
            const L2动态身份 新动态{*新动态编码};
            if (提交.状态 == L1跨所有者原子事务状态::已提交) {
                if (Gnow != Gread)
                    return 形成提交后失败(std::move(结果));
#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
                if (ARCH_迁移提交后首次读回失败一次_) {
                    ARCH_迁移提交后首次读回失败一次_ = false;
                    return 形成提交后失败(std::move(结果));
                }
#endif
                const auto 正式当前选择 = 状态服务_.读取特征实例当前状态选择({
                    {L2结构合同版本, Gread}, 请求.新状态特征实例});
                if (!正式当前选择.成功() || !正式当前选择.当前选择关系
                    || !正式当前选择.当前状态
                    || 正式当前选择.结果头.事实截止代次 != Gread
                    || 正式当前选择.当前选择关系->关系稳定编码 != *新选择编码
                    || 正式当前选择.当前选择关系->状态 != 新状态
                    || 正式当前选择.当前状态->身份 != 新状态)
                    return 形成提交后失败(std::move(结果));
            }
            const L2结构请求头 读回头{L2结构合同版本, Gnow};
            const auto 新状态读回 = 状态服务_.读取完整状态({读回头,
                L2读取类别::历史, 新状态, Gread});
            const auto 新动态读回 = 动态服务_.读取完整动态({读回头,
                L2读取类别::历史, 新动态, Gread});
            const auto 新选择读回 = 状态服务_.读取特征实例历史状态选择({
                读回头, 请求.新状态特征实例, 提交.共同事实代次});
            const auto 旧选择读回 = 状态服务_.读取特征实例历史状态选择({
                读回头, 请求.新状态特征实例,
                请求.请求头.共同请求头.期望事实代次});
            const auto 旧状态读回 = 状态服务_.读取完整状态({读回头,
                L2读取类别::历史, 请求.旧当前状态, Gread});

            const bool 新状态有效 =
                新状态读回.结果头.状态 == L2结构状态::已读取
                && 新状态读回.结果头.事实截止代次 == Gread
                && 新状态读回.状态 && 新状态读回.自有关系
                && 新状态读回.状态->身份 == 新状态
                && 新状态读回.状态->主体存在 == 请求.主体存在
                && 新状态读回.状态->特征实例 == 请求.新状态特征实例
                && !新状态读回.状态->生命周期.退出事实代次;
            const bool 新动态有效 =
                新动态读回.结果头.状态 == L2结构状态::已读取
                && 新动态读回.结果头.事实截止代次 == Gread
                && 新动态读回.动态 && 新动态读回.自有关系
                && 新动态读回.动态->身份 == 新动态
                && 新动态读回.动态->主体存在 == 请求.主体存在
                && 新动态读回.动态->前状态 == 请求.旧当前状态
                && 新动态读回.动态->后状态 == 新状态
                && 新动态读回.动态->来源稳定编码 == 请求.来源方法稳定编码
                && !新动态读回.动态->生命周期.退出事实代次;
            const bool 新选择有效 = 新选择读回.成功()
                && 新选择读回.结果头.事实截止代次 == 提交.共同事实代次
                && 新选择读回.当前选择关系 && 新选择读回.状态
                && 新选择读回.当前选择关系->关系稳定编码 == *新选择编码
                && 新选择读回.当前选择关系->特征实例
                    == 请求.新状态特征实例
                && 新选择读回.当前选择关系->状态 == 新状态
                && 新选择读回.当前选择关系->写入所有者 == 状态所有者
                && 新选择读回.当前选择关系->生命周期.创建事实代次
                    == 提交.共同事实代次
                && !新选择读回.当前选择关系->生命周期.退出事实代次
                && 新选择读回.状态->身份 == 新状态;
            const bool 旧选择有效 = 旧选择读回.成功()
                && 旧选择读回.结果头.事实截止代次
                    == 请求.请求头.共同请求头.期望事实代次
                && 旧选择读回.当前选择关系 && 旧选择读回.状态
                && *旧选择读回.当前选择关系 == 请求.旧当前选择
                && 旧选择读回.状态->身份 == 请求.旧当前状态
                && 状态形成.旧当前选择
                && *状态形成.旧当前选择 == 请求.旧当前选择;
            const bool 旧状态永久 =
                旧状态读回.结果头.状态 == L2结构状态::已读取
                && 旧状态读回.结果头.事实截止代次 == Gread
                && 旧状态读回.状态 && 旧状态读回.自有关系
                && 旧状态读回.状态->身份 == 请求.旧当前状态
                && 旧状态读回.状态->主体存在 == 请求.主体存在
                && !旧状态读回.状态->生命周期.退出事实代次;

            if (新状态有效) {
                结果.新状态 = *新状态读回.状态;
                结果.新状态自有关系 = *新状态读回.自有关系;
            }
            if (新动态有效) {
                结果.新动态 = *新动态读回.动态;
                结果.新动态自有关系 = *新动态读回.自有关系;
            }
            if (新选择有效)
                结果.新当前选择关系 = *新选择读回.当前选择关系;
            if (旧选择有效 && 旧状态永久) {
                auto 旧选择退出 = 请求.旧当前选择;
                旧选择退出.生命周期.退出事实代次 = 提交.共同事实代次;
                结果.已退出旧当前选择关系 = std::move(旧选择退出);
            }
            if (!新状态有效 || !新动态有效 || !新选择有效
                || !旧选择有效 || !旧状态永久 || !结果.成功())
                return 形成提交后失败(std::move(结果));
            return 结果;
        } catch (const std::bad_alloc&) {
            if (提交已确认)
                return 形成提交后失败(std::move(结果));
            return 交换前失败(L2结构状态::资源失败,
                L2状态动态迁移操作状态_v2::资源失败);
        } catch (...) {
            if (提交已确认)
                return 形成提交后失败(std::move(结果));
            return 交换前失败(L2结构状态::内部不一致,
                L2状态动态迁移操作状态_v2::内部不一致);
        }
    }

private:
    const L1事实基座服务& 第一层服务_;
    const L2状态结构服务& 状态服务_;
    const L2动态结构服务& 动态服务_;
    L1跨所有者原子事务凭证 事务凭证_;
#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
    bool ARCH_迁移提交后首次读回失败一次_ = false;
#endif
};

} // namespace 海中鱼巣
