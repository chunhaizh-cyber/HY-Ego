namespace 海中鱼巣::L1状态内部 {

L1中性写集幂等键 映射状态登记幂等键(状态操作幂等身份 身份) noexcept {
    return {(L1状态登记幂等域 << 56) | 身份.值};
}

L1中性写集幂等键 映射首态幂等键(状态操作幂等身份 身份) noexcept {
    return {(L1首个基准状态幂等域 << 56) | 身份.值};
}

L1基准状态状态 映射中性写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return L1基准状态状态::已提交;
    case L1中性写入状态::精确重复: return L1基准状态状态::幂等读回;
    case L1中性写入状态::幂等冲突: return L1基准状态状态::幂等冲突;
    case L1中性写入状态::事实代次漂移: return L1基准状态状态::版本漂移;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出: return L1基准状态状态::未找到;
    case L1中性写入状态::资源失败: return L1基准状态状态::资源失败;
    case L1中性写入状态::内部不一致: return L1基准状态状态::内部不一致;
    case L1中性写入状态::入口拒绝: return L1基准状态状态::入口拒绝;
    default: return L1基准状态状态::入口拒绝;
    }
}

L1基准状态状态 映射读取状态(L1读取状态 状态) noexcept {
    switch (状态) {
    case L1读取状态::未找到:
    case L1读取状态::属性未设置: return L1基准状态状态::未找到;
    case L1读取状态::事实代次漂移: return L1基准状态状态::版本漂移;
    case L1读取状态::资源失败: return L1基准状态状态::资源失败;
    case L1读取状态::内部不一致: return L1基准状态状态::内部不一致;
    case L1读取状态::已退出: return L1基准状态状态::未找到;
    default: return L1基准状态状态::入口拒绝;
    }
}

L1基准状态状态 映射中性读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::未找到:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::已退出: return L1基准状态状态::未找到;
    case L1中性读取状态::资源失败: return L1基准状态状态::资源失败;
    case L1中性读取状态::内部不一致: return L1基准状态状态::内部不一致;
    case L1中性读取状态::入口拒绝: return L1基准状态状态::入口拒绝;
    default: return L1基准状态状态::内部不一致;
    }
}

L1基准状态状态 映射实例状态(实例特征状态 状态) noexcept {
    switch (状态) {
    case 实例特征状态::已读取: return L1基准状态状态::已读取;
    case 实例特征状态::未找到: return L1基准状态状态::未找到;
    case 实例特征状态::事实代次漂移: return L1基准状态状态::版本漂移;
    case 实例特征状态::资源失败: return L1基准状态状态::资源失败;
    case 实例特征状态::内部不一致: return L1基准状态状态::内部不一致;
    default: return L1基准状态状态::入口拒绝;
    }
}

L1基准状态状态 映射存在状态(实际存在状态 状态) noexcept {
    switch (状态) {
    case 实际存在状态::已读取: return L1基准状态状态::已读取;
    case 实际存在状态::未找到: return L1基准状态状态::未找到;
    case 实际存在状态::版本漂移: return L1基准状态状态::版本漂移;
    case 实际存在状态::资源失败: return L1基准状态状态::资源失败;
    case 实际存在状态::内部不一致: return L1基准状态状态::内部不一致;
    default: return L1基准状态状态::入口拒绝;
    }
}

std::optional<稳定编码> 查找中性映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

bool 中性映射完整唯一(const L1中性写入结果& 结果,
    std::uint32_t 数量) noexcept {
    if (结果.新编码映射.size() != 数量) return false;
    for (std::uint32_t i = 1; i <= 数量; ++i) {
        const auto 编码 = 查找中性映射(结果, i);
        if (!编码 || !有效(*编码)) return false;
        for (std::uint32_t j = i + 1; j <= 数量; ++j) {
            const auto 另一个 = 查找中性映射(结果, j);
            if (!另一个 || *另一个 == *编码) return false;
        }
    }
    return true;
}

bool 中性登记节点形状符合(const L1中性节点事实& 节点,
    std::size_t 索引) noexcept {
    if (索引 < 2)
        return 节点.种类 == 节点种类::普通 && !节点.属性类型表示;
    const std::array<L1中性值表示种类, 5> 表示{L1中性值表示种类::I64,
        L1中性值表示种类::U64组, L1中性值表示种类::I64,
        L1中性值表示种类::U64组, L1中性值表示种类::I64};
    return 节点.种类 == 节点种类::属性类型
        && 节点.属性类型表示 == std::optional{表示[索引 - 2]};
}

bool 状态登记定位相同(const L1状态结构登记& 左,
    const L1状态结构登记& 右) noexcept {
    return 左.服务身份 == 右.服务身份
        && 左.关系19状态组成关系类型 == 右.关系19状态组成关系类型
        && 左.状态节点资格属性类型 == 右.状态节点资格属性类型
        && 左.状态发生时间属性类型 == 右.状态发生时间属性类型
        && 左.状态特征值见证资格属性类型 == 右.状态特征值见证资格属性类型
        && 左.被采样P8值引用属性类型 == 右.被采样P8值引用属性类型
        && 左.状态采样I64值属性类型 == 右.状态采样I64值属性类型;
}

bool 发布请求相同(const 实际存在I64首个基准状态发布请求& 左,
    const 实际存在I64首个基准状态发布请求& 右) noexcept {
    return 左 == 右;
}

void 散列加入(std::uint64_t& 摘要, std::uint64_t 值) noexcept {
    for (int i = 0; i < 8; ++i) {
        摘要 ^= static_cast<std::uint8_t>(值 >> (i * 8));
        摘要 *= 1099511628211ULL;
    }
}

void 散列加入(std::uint64_t& 摘要, 稳定编码 编码) noexcept {
    散列加入(摘要, 编码.值);
}

bool 节点在代次有效(const L1中性节点事实& 事实, std::uint64_t 代次) noexcept {
    return 事实.创建事实代次 != 0 && 事实.创建事实代次 <= 代次
        && (!事实.退出事实代次 || *事实.退出事实代次 > 代次);
}

bool 值在代次有效(const L1中性值事实& 事实, std::uint64_t 代次) noexcept {
    return 事实.创建事实代次 != 0 && 事实.创建事实代次 <= 代次
        && (!事实.退出事实代次 || *事实.退出事实代次 > 代次);
}

template<class 事实类型, class 当前读取器>
bool 读取中性当前或历史(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 当前代次, 当前读取器&& 读取当前, 事实类型& 输出,
    L1基准状态状态& 失败) {
    const auto 当前 = 读取当前();
    if (当前.合同版本 != L1中性CRUD合同版本 || 当前.查询编码 != 编码) {
        失败 = L1基准状态状态::内部不一致;
        return false;
    }
    if (当前.状态 == L1中性读取状态::成功 && 当前.事实) {
        if (当前.事实->编码 != 编码 || 当前.读取事实代次 != 当前代次
            || 当前.事实->退出事实代次) {
            失败 = 当前.读取事实代次 == 当前代次
                ? L1基准状态状态::内部不一致 : L1基准状态状态::版本漂移;
            return false;
        }
        输出 = *当前.事实;
        return true;
    }
    if (当前.状态 != L1中性读取状态::已退出) {
        失败 = 映射中性读取状态(当前.状态);
        return false;
    }
    const auto 历史 = L1.读取中性历史事实({L1中性CRUD合同版本, 编码});
    if (历史.合同版本 != L1中性CRUD合同版本 || 历史.查询编码 != 编码
        || 历史.状态 != L1中性读取状态::成功 || !历史.事实) {
        失败 = 历史.状态 == L1中性读取状态::成功
            ? L1基准状态状态::内部不一致 : 映射中性读取状态(历史.状态);
        return false;
    }
    const auto* 事实 = std::get_if<事实类型>(&*历史.事实);
    if (!事实 || 事实->编码 != 编码 || !事实->退出事实代次
        || *事实->退出事实代次 > 当前代次 || 事实->创建事实代次 == 0
        || 事实->创建事实代次 > 当前代次) {
        失败 = L1基准状态状态::内部不一致;
        return false;
    }
    输出 = *事实;
    return true;
}

bool 读取中性节点(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 当前代次, L1中性节点事实& 输出, L1基准状态状态& 失败) {
    return 读取中性当前或历史<L1中性节点事实>(L1, 编码, 当前代次,
        [&] { return L1.读取中性当前节点({L1中性CRUD合同版本, 编码}); }, 输出, 失败);
}

bool 读取中性关系(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 当前代次, L1中性关系事实& 输出, L1基准状态状态& 失败) {
    return 读取中性当前或历史<L1中性关系事实>(L1, 编码, 当前代次,
        [&] { return L1.读取中性当前关系({L1中性CRUD合同版本, 编码}); }, 输出, 失败);
}

bool 读取中性值(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 当前代次, L1中性值事实& 输出, L1基准状态状态& 失败) {
    return 读取中性当前或历史<L1中性值事实>(L1, 编码, 当前代次,
        [&] { return L1.读取中性当前值({L1中性CRUD合同版本, 编码}); }, 输出, 失败);
}

bool 中性属性槽精确(const L1中性节点事实& 节点,
    稳定编码 类型, 稳定编码 值) noexcept {
    std::size_t 数量 = 0;
    for (const auto& 槽 : 节点.当前属性) {
        if (槽.属性类型节点 != 类型) continue;
        ++数量;
        if (槽.当前值 != 值) return false;
    }
    return 数量 == 1;
}

状态节点见证 形成中性节点见证(const L1中性节点事实& 事实) noexcept {
    return {事实.编码, 事实.创建事实代次, 事实.退出事实代次};
}

状态关系见证 形成中性关系见证(const L1中性关系事实& 事实) noexcept {
    return {事实.编码, 事实.关系类型节点, 事实.源节点, 事实.目标节点,
        事实.角色或顺序, 事实.创建事实代次, 事实.退出事实代次};
}

状态I64事实见证 形成中性I64见证(const L1中性值事实& 事实) {
    return {事实.编码, 事实.所属节点, 事实.属性类型节点,
        std::get<std::int64_t>(事实.材料), 事实.来源节点, std::nullopt,
        事实.创建事实代次, 事实.退出事实代次, 事实.创建事实代次};
}

状态U64组事实见证 形成中性U64组见证(const L1中性值事实& 事实) {
    return {事实.编码, 事实.所属节点, 事实.属性类型节点,
        std::get<std::vector<std::uint64_t>>(事实.材料), 事实.来源节点, std::nullopt,
        事实.创建事实代次, 事实.退出事实代次, 事实.创建事实代次};
}

} // namespace 海中鱼巣::L1状态内部

export namespace 海中鱼巣 {

class L1状态服务 final {
public:
    L1状态服务(L1事实基座服务& L1, L1实际存在场景组合服务& 实际存在,
        L1实例特征服务& 实例特征) noexcept
        : L1_(L1), 实际存在_(实际存在), 实例特征_(实例特征) {}
    L1状态服务(const L1状态服务&) = delete;
    L1状态服务& operator=(const L1状态服务&) = delete;

    L1状态登记结果 建立登记(const L1状态登记请求& 请求) {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1状态合同版本 || 请求.规则版本 != L1状态规则版本
                || !状态操作幂等身份有效(请求.幂等身份) || 请求.期望事实代次 == 0)
                return {};

            const auto 预读 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (预读.合同版本 != L1中性CRUD合同版本)
                return {L1基准状态状态::内部不一致, std::nullopt};
            if (预读.状态 != L1中性读取状态::成功)
                return {L1状态内部::映射中性读取状态(预读.状态), std::nullopt};
            if (预读.事实代次 == 0)
                return {L1基准状态状态::内部不一致, std::nullopt};

            const auto 幂等键 = L1状态内部::映射状态登记幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::普通, std::nullopt},
                {{3}, 节点种类::属性类型, L1中性值表示种类::I64},
                {{4}, 节点种类::属性类型, L1中性值表示种类::U64组},
                {{5}, 节点种类::属性类型, L1中性值表示种类::I64},
                {{6}, 节点种类::属性类型, L1中性值表示种类::U64组},
                {{7}, 节点种类::属性类型, L1中性值表示种类::I64}};

            const auto 写入 = L1_.提交中性写集(写集);
            if (写入.状态 != L1中性写入状态::成功
                && 写入.状态 != L1中性写入状态::精确重复)
                return {L1状态内部::映射中性写入状态(写入.状态), std::nullopt};

            const auto 状态 = L1状态内部::映射中性写入状态(写入.状态);
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 幂等键
                || 写入.事实代次 == 0 || !L1状态内部::中性映射完整唯一(写入, 7))
                return {L1基准状态状态::内部不一致, std::nullopt};
            if (写入.状态 == L1中性写入状态::成功) {
                if (预读.事实代次 != 请求.期望事实代次
                    || !写入.是否形成内存权威发布
                    || 写入.重试边界 != L1中性重试边界::不适用)
                    return {L1基准状态状态::内部不一致, std::nullopt};
            } else if (写入.是否形成内存权威发布
                || 写入.重试边界 != L1中性重试边界::原幂等键读回收敛) {
                return {L1基准状态状态::内部不一致, std::nullopt};
            }

            std::array<稳定编码, 7> 编码组{};
            for (std::uint32_t i = 1; i <= 编码组.size(); ++i) {
                const auto 编码 = L1状态内部::查找中性映射(写入, i);
                if (!编码) return {L1基准状态状态::内部不一致, std::nullopt};
                编码组[i - 1] = *编码;
            }
            auto 读回 = 精确读回状态登记(编码组, 写入.事实代次);
            if (读回.状态 != L1基准状态状态::已读取 || !读回.登记)
                return 读回;
            if (登记_ && !L1状态内部::状态登记定位相同(*登记_, *读回.登记))
                return {L1基准状态状态::内部不一致, std::nullopt};
            登记_ = *读回.登记;
            return {状态, 登记_};
        } catch (const std::bad_alloc&) { return {L1基准状态状态::资源失败, std::nullopt}; }
        catch (...) { return {L1基准状态状态::内部不一致, std::nullopt}; }
    }

    L1状态登记结果 读取当前登记() const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        if (!登记_ || !L1状态结构登记完整(*登记_))
            return {L1基准状态状态::未找到, std::nullopt};
        const auto& 定位 = *登记_;
        const std::array<稳定编码, 7> 编码组{定位.服务身份,
            定位.关系19状态组成关系类型, 定位.状态节点资格属性类型,
            定位.状态发生时间属性类型, 定位.状态特征值见证资格属性类型,
            定位.被采样P8值引用属性类型, 定位.状态采样I64值属性类型};
        return 精确读回状态登记(编码组, std::nullopt);
    }

    实际存在I64基准状态结果 发布实际存在I64首个基准状态(
        const 实际存在I64首个基准状态发布请求& 请求) {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1状态合同版本 || 请求.规则版本 != L1状态规则版本
                || !状态操作幂等身份有效(请求.幂等身份)
                || 请求.期望事实代次 == 0 || 请求.发生时间戳 == 0)
                return {};
            if (!登记_ || !L1状态结构登记完整(*登记_)) return {};

            const auto 幂等键 = L1状态内部::映射首态幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            实际存在I64基准状态读取请求 读取请求;
            std::uint64_t G = 0;
            bool 首次路径 = false;
            const auto 已有 = 首态账_.find(请求.幂等身份.值);
            if (已有 != 首态账_.end()) {
                if (!L1状态内部::发布请求相同(已有->second.请求, 请求))
                    return {L1基准状态状态::幂等冲突, std::nullopt};
                写集 = 已有->second.中性写集;
                读取请求 = 已有->second.读取请求;
            } else {
                首次路径 = true;
                const auto 代次读取 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
                if (代次读取.合同版本 != L1中性CRUD合同版本)
                    return {L1基准状态状态::内部不一致, std::nullopt};
                if (代次读取.状态 != L1中性读取状态::成功)
                    return {L1状态内部::映射中性读取状态(代次读取.状态), std::nullopt};
                G = 代次读取.事实代次;
                if (G == 0) return {L1基准状态状态::内部不一致, std::nullopt};
                if (G != 请求.期望事实代次)
                    return {L1基准状态状态::版本漂移, std::nullopt};

                const auto P8 = 实例特征_.读取实际存在I64实例特征(请求.当前特征);
                if (P8.状态 != 实例特征状态::已读取)
                    return {L1状态内部::映射实例状态(P8.状态), std::nullopt};
                if (!P8.事实) return {L1基准状态状态::内部不一致, std::nullopt};
                const auto P7 = 实际存在_.读取实际存在(请求.当前特征.宿主);
                if (P7.状态 != 实际存在状态::已读取)
                    return {L1状态内部::映射存在状态(P7.状态), std::nullopt};
                if (!P7.事实) return {L1基准状态状态::内部不一致, std::nullopt};
                if (!I64实例特征事实完整(*P8.事实) || !实际存在事实完整(*P7.事实))
                    return {L1基准状态状态::内部不一致, std::nullopt};
                if (P8.事实->事实截止代次 != G || P7.事实->事实截止代次 != G)
                    return {L1基准状态状态::版本漂移, std::nullopt};
                if (P8.事实->宿主 != P7.事实->存在.编码
                    || P8.事实->实例槽 != 请求.当前特征.实例槽
                    || P8.事实->当前值 != 请求.当前特征.当前值
                    || P8.事实->来源节点 != 请求.当前特征.来源节点)
                    return {L1基准状态状态::版本漂移, std::nullopt};

                const auto 当前值读取 = L1_.读取中性当前值(
                    {L1中性CRUD合同版本, P8.事实->当前值});
                if (当前值读取.合同版本 != L1中性CRUD合同版本
                    || 当前值读取.查询编码 != P8.事实->当前值)
                    return {L1基准状态状态::内部不一致, std::nullopt};
                if (当前值读取.状态 != L1中性读取状态::成功 || !当前值读取.事实)
                    return {L1状态内部::映射中性读取状态(当前值读取.状态), std::nullopt};
                if (当前值读取.读取事实代次 != G)
                    return {L1基准状态状态::版本漂移, std::nullopt};
                const auto& 当前值 = *当前值读取.事实;
                if (当前值.编码 != P8.事实->当前值
                    || 当前值.所属节点 != P8.事实->实例槽
                    || 当前值.来源节点 != P8.事实->来源节点
                    || !有效(当前值.属性类型节点) || 当前值.退出事实代次
                    || !std::holds_alternative<std::int64_t>(当前值.材料)
                    || std::get<std::int64_t>(当前值.材料) != P8.事实->I64值)
                    return {L1基准状态状态::内部不一致, std::nullopt};

                const auto 主体组 = L1_.读取中性当前目标关系组({L1中性CRUD合同版本,
                    P7.事实->存在.编码, 登记_->关系19状态组成关系类型});
                const auto 特征组 = L1_.读取中性当前目标关系组({L1中性CRUD合同版本,
                    P8.事实->实例槽, 登记_->关系19状态组成关系类型});
                const auto 目标组有效 = [&](const L1中性目标关系读取结果& 结果,
                    稳定编码 目标) {
                    return 结果.合同版本 == L1中性CRUD合同版本
                        && 结果.目标节点 == 目标
                        && 结果.关系类型节点 == 登记_->关系19状态组成关系类型;
                };
                if (!目标组有效(主体组, P7.事实->存在.编码)
                    || !目标组有效(特征组, P8.事实->实例槽))
                    return {L1基准状态状态::内部不一致, std::nullopt};
                if (主体组.状态 != L1中性读取状态::成功)
                    return {L1状态内部::映射中性读取状态(主体组.状态), std::nullopt};
                if (特征组.状态 != L1中性读取状态::成功)
                    return {L1状态内部::映射中性读取状态(特征组.状态), std::nullopt};
                if (主体组.读取事实代次 != G || 特征组.读取事实代次 != G)
                    return {L1基准状态状态::版本漂移, std::nullopt};

                std::map<稳定编码, std::uint8_t> 相关状态源;
                const auto 收集相关源 = [&](const L1中性目标关系读取结果& 结果,
                    稳定编码 目标, std::int64_t 角色, std::uint8_t 标志) {
                    for (const auto& 关系 : 结果.关系组) {
                        if (关系.退出事实代次 || 关系.目标节点 != 目标
                            || 关系.关系类型节点 != 登记_->关系19状态组成关系类型
                            || !有效(关系.源节点) || !有效(关系.目标节点)
                            || 关系.角色或顺序 < 1 || 关系.角色或顺序 > 5)
                            return false;
                        if (关系.角色或顺序 == 角色) 相关状态源[关系.源节点] |= 标志;
                    }
                    return true;
                };
                if (!收集相关源(主体组, P7.事实->存在.编码, 1, 1)
                    || !收集相关源(特征组, P8.事实->实例槽, 3, 2))
                    return {L1基准状态状态::内部不一致, std::nullopt};

                for (const auto& [状态源, 匹配标志] : 相关状态源) {
                    const auto 状态节点 = L1_.读取中性当前节点(
                        {L1中性CRUD合同版本, 状态源});
                    if (状态节点.合同版本 != L1中性CRUD合同版本
                        || 状态节点.查询编码 != 状态源)
                        return {L1基准状态状态::内部不一致, std::nullopt};
                    if (状态节点.状态 != L1中性读取状态::成功)
                        return {L1状态内部::映射中性读取状态(状态节点.状态), std::nullopt};
                    if (!状态节点.事实)
                        return {L1基准状态状态::内部不一致, std::nullopt};
                    if (状态节点.读取事实代次 != G)
                        return {L1基准状态状态::版本漂移, std::nullopt};
                    if (状态节点.事实->编码 != 状态源 || 状态节点.事实->退出事实代次
                        || 状态节点.事实->种类 != 节点种类::普通)
                        return {L1基准状态状态::内部不一致, std::nullopt};

                    const auto 关系组 = L1_.读取中性当前源关系组({L1中性CRUD合同版本,
                        状态源, 登记_->关系19状态组成关系类型});
                    if (关系组.合同版本 != L1中性CRUD合同版本
                        || 关系组.源节点 != 状态源
                        || 关系组.关系类型节点 != 登记_->关系19状态组成关系类型)
                        return {L1基准状态状态::内部不一致, std::nullopt};
                    if (关系组.状态 != L1中性读取状态::成功)
                        return {L1状态内部::映射中性读取状态(关系组.状态), std::nullopt};
                    if (关系组.读取事实代次 != G)
                        return {L1基准状态状态::版本漂移, std::nullopt};
                    std::array<std::optional<稳定编码>, 5> 角色目标{};
                    for (const auto& 关系 : 关系组.关系组) {
                        if (关系.退出事实代次 || 关系.源节点 != 状态源
                            || 关系.关系类型节点 != 登记_->关系19状态组成关系类型
                            || 关系.角色或顺序 < 1 || 关系.角色或顺序 > 5)
                            return {L1基准状态状态::内部不一致, std::nullopt};
                        const auto 索引 = static_cast<std::size_t>(关系.角色或顺序 - 1);
                        if (角色目标[索引])
                            return {L1基准状态状态::内部不一致, std::nullopt};
                        const auto 端点 = L1_.读取中性当前节点(
                            {L1中性CRUD合同版本, 关系.目标节点});
                        if (端点.合同版本 != L1中性CRUD合同版本
                            || 端点.查询编码 != 关系.目标节点)
                            return {L1基准状态状态::内部不一致, std::nullopt};
                        if (端点.状态 != L1中性读取状态::成功)
                            return {L1状态内部::映射中性读取状态(端点.状态), std::nullopt};
                        if (!端点.事实)
                            return {L1基准状态状态::内部不一致, std::nullopt};
                        if (端点.读取事实代次 != G)
                            return {L1基准状态状态::版本漂移, std::nullopt};
                        if (端点.事实->编码 != 关系.目标节点
                            || 端点.事实->种类 != 节点种类::普通 || 端点.事实->退出事实代次)
                            return {L1基准状态状态::内部不一致, std::nullopt};
                        角色目标[索引] = 关系.目标节点;
                    }
                    for (const auto& 目标 : 角色目标)
                        if (!目标) return {L1基准状态状态::内部不一致, std::nullopt};
                    if (匹配标志 == 3
                        && *角色目标[0] == P7.事实->存在.编码
                        && *角色目标[2] == P8.事实->实例槽)
                        return {L1基准状态状态::入口拒绝, std::nullopt};
                }

                写集.合同版本 = L1中性CRUD合同版本;
                写集.期望事实代次 = 请求.期望事实代次;
                写集.幂等键 = 幂等键;
                写集.节点 = {{{1}, 节点种类::普通, std::nullopt},
                    {{2}, 节点种类::普通, std::nullopt}};
                写集.值 = {
                    {{3}, L1中性写集本地键{1}, 登记_->状态节点资格属性类型,
                        std::int64_t{状态节点资格值}, 登记_->服务身份},
                    {{4}, L1中性写集本地键{1}, 登记_->状态发生时间属性类型,
                        std::vector<std::uint64_t>{请求.发生时间戳}, 登记_->服务身份},
                    {{5}, L1中性写集本地键{2}, 登记_->状态特征值见证资格属性类型,
                        std::int64_t{状态特征值见证资格值}, 登记_->服务身份},
                    {{6}, L1中性写集本地键{2}, 登记_->被采样P8值引用属性类型,
                        std::vector<std::uint64_t>{P8.事实->当前值.值, 当前值.创建事实代次,
                            G, P8.事实->来源节点.值}, P7.事实->存在.编码},
                    {{7}, L1中性写集本地键{2}, 登记_->状态采样I64值属性类型,
                        std::int64_t{P8.事实->I64值}, P7.事实->存在.编码}};
                写集.关系 = {
                    {{8}, L1中性写集本地键{1}, P7.事实->存在.编码,
                        登记_->关系19状态组成关系类型, 1},
                    {{9}, L1中性写集本地键{1}, P7.事实->当前场景.编码,
                        登记_->关系19状态组成关系类型, 2},
                    {{10}, L1中性写集本地键{1}, P8.事实->实例槽,
                        登记_->关系19状态组成关系类型, 3},
                    {{11}, L1中性写集本地键{1}, L1中性写集本地键{2},
                        登记_->关系19状态组成关系类型, 4},
                    {{12}, L1中性写集本地键{1}, P7.事实->存在.编码,
                        登记_->关系19状态组成关系类型, 5}};
                写集.属性槽变更 = {
                    {L1中性写集本地键{1}, 登记_->状态节点资格属性类型, {3}},
                    {L1中性写集本地键{1}, 登记_->状态发生时间属性类型, {4}},
                    {L1中性写集本地键{2}, 登记_->状态特征值见证资格属性类型, {5}},
                    {L1中性写集本地键{2}, 登记_->被采样P8值引用属性类型, {6}},
                    {L1中性写集本地键{2}, 登记_->状态采样I64值属性类型, {7}}};
            }

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1状态内部::映射中性写入状态(写入.状态);
            if (状态 != L1基准状态状态::已提交 && 状态 != L1基准状态状态::幂等读回)
                return {状态, std::nullopt};
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 幂等键
                || 写入.事实代次 == 0 || !L1状态内部::中性映射完整唯一(写入, 12))
                return {L1基准状态状态::内部不一致, std::nullopt};
            if (写入.状态 == L1中性写入状态::成功) {
                if (!首次路径 || G != 请求.期望事实代次
                    || 写入.事实代次 != G + 1 || !写入.是否形成内存权威发布
                    || 写入.重试边界 != L1中性重试边界::不适用)
                    return {L1基准状态状态::内部不一致, std::nullopt};
            } else if (写入.是否形成内存权威发布
                || 写入.重试边界 != L1中性重试边界::原幂等键读回收敛) {
                return {L1基准状态状态::内部不一致, std::nullopt};
            }
            实际存在I64基准状态读取请求 本次读取请求;
            const auto 取 = [&](std::uint32_t 键) {
                return *L1状态内部::查找中性映射(写入, 键);
            };
            本次读取请求.状态 = 取(1); 本次读取请求.特征值见证 = 取(2);
            本次读取请求.状态资格值 = 取(3); 本次读取请求.发生时间值 = 取(4);
            本次读取请求.特征值见证资格值 = 取(5);
            本次读取请求.被采样P8值引用值 = 取(6);
            本次读取请求.状态采样I64值 = 取(7); 本次读取请求.主体关系 = 取(8);
            本次读取请求.场景关系 = 取(9); 本次读取请求.特征关系 = 取(10);
            本次读取请求.值关系 = 取(11); 本次读取请求.来源存在关系 = 取(12);
            if (!首次路径 && 本次读取请求 != 读取请求)
                return {L1基准状态状态::内部不一致, std::nullopt};
            读取请求 = 本次读取请求;

            auto [记录位置, 已插入] = 首态账_.try_emplace(请求.幂等身份.值,
                首态记录{请求, 写集, 读取请求, {}});
            if ((!已插入 && (!L1状态内部::发布请求相同(记录位置->second.请求, 请求)
                    || 记录位置->second.中性写集 != 写集
                    || 记录位置->second.读取请求 != 读取请求)))
                return {L1基准状态状态::内部不一致, std::nullopt};

            auto 读回 = 读取实际存在I64基准状态(读取请求);
            if (读回.状态 != L1基准状态状态::已读取 || !读回.事实
                || 读回.事实->读取事实截止代次 < 写入.事实代次
                || (写入.状态 == L1中性写入状态::成功
                    && 读回.事实->读取事实截止代次 != 写入.事实代次))
                return {读回.状态 == L1基准状态状态::已读取
                    ? L1基准状态状态::内部不一致 : 读回.状态, std::nullopt};
            读回.状态 = 状态;
            if (!记录位置->second.首次结果.事实)
                记录位置->second.首次结果 = 读回;
            else if (记录位置->second.首次结果.事实->状态.编码 != 读回.事实->状态.编码
                || 记录位置->second.首次结果.事实->特征值.编码 != 读回.事实->特征值.编码
                || 记录位置->second.首次结果.事实->状态采样事实截止代次
                    != 读回.事实->状态采样事实截止代次)
                return {L1基准状态状态::内部不一致, std::nullopt};
            return 读回;
        } catch (const std::bad_alloc&) { return {L1基准状态状态::资源失败, std::nullopt}; }
        catch (...) { return {L1基准状态状态::内部不一致, std::nullopt}; }
    }

    实际存在I64基准状态结果 读取实际存在I64基准状态(
        const 实际存在I64基准状态读取请求& 请求) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!实际存在I64基准状态读取请求有效(请求)
                || !登记_ || !L1状态结构登记完整(*登记_)) return {};
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const auto 结果 = 读取一次(请求);
                if (结果.状态 != L1基准状态状态::版本漂移 || 尝试 == 1) return 结果;
            }
            return {L1基准状态状态::版本漂移, std::nullopt};
        } catch (const std::bad_alloc&) { return {L1基准状态状态::资源失败, std::nullopt}; }
        catch (...) { return {L1基准状态状态::内部不一致, std::nullopt}; }
    }

    // PRE1-诊断责任：向上送出；结构化形成状态由P13公开组合边界继续传播。
    实际存在I64后继状态规格形成结果 形成已校准实际存在I64后继状态规格(
        const 已校准实际存在I64后继状态材料& 材料) const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!登记_ || 材料.规格版本 != I64后继状态规格版本
                || 材料.业务请求身份 == 0 || 材料.整理幂等身份 == 0
                || 材料.事实截止代次 == 0 || 材料.新状态发生时间 == 0
                || !有效(材料.主体) || !有效(材料.当前场景)
                || !有效(材料.当前场景归属关系) || !有效(材料.实例槽)
                || !有效(材料.特征定义) || !有效(材料.定义关系)
                || !有效(材料.新当前值) || !有效(材料.新当前值属性类型)
                || !有效(材料.新当前来源) || 材料.新当前值创建代次 == 0
                || !有效(材料.比较注册身份) || 材料.比较算法版本 == 0)
                return {};

            const auto& 前 = 材料.前状态;
            const auto& 选择 = 材料.前态选择;
            if (前.合同版本 != L1状态合同版本 || 前.规则版本 != L1状态规则版本
                || 前.读取事实截止代次 != 材料.事实截止代次
                || 前.发生时间.材料.size() != 1
                || 前.发生时间.材料.front() == 0
                || 前.发生时间.材料.front() >= 材料.新状态发生时间
                || 前.主体.编码 != 材料.主体 || 前.场景.编码 != 材料.当前场景
                || 前.特征.编码 != 材料.实例槽 || 前.来源存在.编码 != 材料.主体
                || 前.被采样P8值.属性类型 != 材料.新当前值属性类型
                || 选择.选择规则版本 != I64相邻前状态选择规则版本
                || 选择.业务查询身份 != 材料.业务请求身份
                || 选择.读取事实截止代次 != 材料.事实截止代次
                || 选择.主体 != 材料.主体 || 选择.实例槽 != 材料.实例槽
                || 选择.拟发布后状态发生时间 != 材料.新状态发生时间
                || 选择.前状态 != 前.状态.编码
                || 选择.前状态发生时间 != 前.发生时间.材料.front())
                return {I64后继状态规格形成状态::入口拒绝, std::nullopt};

            const bool 等价合法 = 材料.等价 && 材料.排序三态 == 0
                && 材料.迁移具名关系数值 == 5 && 材料.差异 == 0;
            const bool 增加合法 = !材料.等价 && 材料.排序三态 == -1
                && 材料.迁移具名关系数值 == 4 && 材料.差异 > 0;
            const bool 减少合法 = !材料.等价 && 材料.排序三态 == 1
                && 材料.迁移具名关系数值 == 6 && 材料.差异 < 0;
            if (!等价合法 && !增加合法 && !减少合法)
                return {I64后继状态规格形成状态::内部不一致, std::nullopt};

            实际存在I64后继状态写入规格 规格;
            规格.整理幂等身份 = 材料.整理幂等身份;
            规格.事实截止代次 = 材料.事实截止代次;
            规格.动态准入 = 材料.等价
                ? 后继状态动态准入::禁止生成迁移动能
                : 后继状态动态准入::允许形成迁移动能规格;
            规格.请求意图 = {材料.业务请求身份, 材料.整理幂等身份,
                材料.新状态发生时间, 材料.主体, 材料.当前场景,
                材料.实例槽, 材料.新当前值, 前.状态.编码,
                材料.比较注册身份, 材料.比较算法版本};

            constexpr 写集本地键 状态键{0x53000001};
            constexpr 写集本地键 见证键{0x53000002};
            auto& 写集 = 规格.写集;
            写集.期望事实代次 = 材料.事实截止代次;
            写集.节点 = {{状态键, 节点种类::普通, std::nullopt},
                {见证键, 节点种类::普通, std::nullopt}};
            写集.值 = {
                {{0x53000003}, 状态键, 登记_->状态节点资格属性类型,
                    std::int64_t{状态节点资格值}, 登记_->服务身份},
                {{0x53000004}, 状态键, 登记_->状态发生时间属性类型,
                    std::vector<std::uint64_t>{材料.新状态发生时间}, 登记_->服务身份},
                {{0x53000005}, 见证键, 登记_->状态特征值见证资格属性类型,
                    std::int64_t{状态特征值见证资格值}, 登记_->服务身份},
                {{0x53000006}, 见证键, 登记_->被采样P8值引用属性类型,
                    std::vector<std::uint64_t>{材料.新当前值.值,
                        材料.新当前值创建代次, 材料.事实截止代次,
                        材料.新当前来源.值}, 材料.主体},
                {{0x53000007}, 见证键, 登记_->状态采样I64值属性类型,
                    std::int64_t{材料.新当前I64}, 材料.主体}};
            写集.关系 = {
                {{0x53000008}, 状态键, 材料.主体,
                    登记_->关系19状态组成关系类型, 1},
                {{0x53000009}, 状态键, 材料.当前场景,
                    登记_->关系19状态组成关系类型, 2},
                {{0x5300000A}, 状态键, 材料.实例槽,
                    登记_->关系19状态组成关系类型, 3},
                {{0x5300000B}, 状态键, 见证键,
                    登记_->关系19状态组成关系类型, 4},
                {{0x5300000C}, 状态键, 材料.主体,
                    登记_->关系19状态组成关系类型, 5}};
            写集.属性槽变更 = {
                {状态键, 登记_->状态节点资格属性类型, {0x53000003}},
                {状态键, 登记_->状态发生时间属性类型, {0x53000004}},
                {见证键, 登记_->状态特征值见证资格属性类型, {0x53000005}},
                {见证键, 登记_->被采样P8值引用属性类型, {0x53000006}},
                {见证键, 登记_->状态采样I64值属性类型, {0x53000007}}};

            std::uint64_t 摘要 = 1469598103934665603ULL;
            L1状态内部::散列加入(摘要, 材料.规格版本);
            L1状态内部::散列加入(摘要, 材料.业务请求身份);
            L1状态内部::散列加入(摘要, 材料.整理幂等身份);
            L1状态内部::散列加入(摘要, 材料.事实截止代次);
            L1状态内部::散列加入(摘要, 材料.新状态发生时间);
            L1状态内部::散列加入(摘要, 材料.主体);
            L1状态内部::散列加入(摘要, 材料.当前场景);
            L1状态内部::散列加入(摘要, 材料.实例槽);
            L1状态内部::散列加入(摘要, 材料.特征定义);
            L1状态内部::散列加入(摘要, 材料.新当前值);
            L1状态内部::散列加入(摘要, 材料.新当前值属性类型);
            L1状态内部::散列加入(摘要, 材料.新当前来源);
            L1状态内部::散列加入(摘要, 材料.新当前值创建代次);
            L1状态内部::散列加入(摘要, static_cast<std::uint64_t>(材料.新当前I64));
            L1状态内部::散列加入(摘要, 前.状态.编码);
            L1状态内部::散列加入(摘要, 材料.比较注册身份);
            L1状态内部::散列加入(摘要, 材料.比较算法版本);
            L1状态内部::散列加入(摘要, static_cast<std::uint8_t>(材料.排序三态));
            L1状态内部::散列加入(摘要, 材料.迁移具名关系数值);
            L1状态内部::散列加入(摘要, static_cast<std::uint64_t>(材料.差异));
            规格.确定性摘要 = 摘要 == 0 ? 1 : 摘要;
            return {I64后继状态规格形成状态::已形成,
                std::move(规格), *登记_};
        } catch (const std::bad_alloc&) {
            return {I64后继状态规格形成状态::资源失败, std::nullopt};
        } catch (...) {
            return {I64后继状态规格形成状态::内部不一致, std::nullopt};
        }
    }

    I64相邻前状态选择结果 选择实际存在I64相邻前状态(
        const I64相邻前状态选择请求& 请求) const {
        try {
            if (请求.合同版本 != L1状态合同版本 || 请求.规则版本 != L1状态规则版本
                || 请求.选择规则版本 != I64相邻前状态选择规则版本
                || 请求.业务查询身份 == 0 || !有效(请求.主体) || !有效(请求.实例槽)
                || 请求.拟发布后状态发生时间 == 0)
                return {};
            std::optional<L1状态结构登记> 登记;
            {
                std::lock_guard<std::recursive_mutex> 锁(锁_);
                登记 = 登记_;
            }
            if (!登记 || !L1状态结构登记完整(*登记)) return {};
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                auto 结果 = 选择一次(请求, *登记);
                if (结果.状态 != I64相邻前状态选择状态::版本漂移 || 尝试 == 1)
                    return 结果;
            }
            return 选择失败(I64相邻前状态选择状态::版本漂移);
        } catch (const std::bad_alloc&) {
            return 选择失败(I64相邻前状态选择状态::资源失败);
        } catch (...) {
            return 选择失败(I64相邻前状态选择状态::内部不一致);
        }
    }

    // P16-诊断责任：向上送出；只做所有者冻结的0x53局部键到读取DTO机械映射。
    后继状态读回请求形成结果 从后继状态新编码映射形成读取请求(
        const std::vector<std::pair<写集本地键, 稳定编码>>& 映射) const {
        try {
            std::array<稳定编码, 12> 编码组{};
            std::array<std::uint32_t, 12> 数量{};
            for (const auto& [键, 编码] : 映射) {
                if (键.值 < 0x53000001U || 键.值 > 0x5300000CU) continue;
                const auto 索引 = static_cast<std::size_t>(键.值 - 0x53000001U);
                ++数量[索引];
                编码组[索引] = 编码;
            }
            for (std::size_t i = 0; i < 编码组.size(); ++i)
                if (数量[i] != 1 || !有效(编码组[i]))
                    return {后继状态读回请求形成状态::内部不一致, std::nullopt};
            return {后继状态读回请求形成状态::已形成,
                实际存在I64基准状态读取请求{L1状态合同版本, L1状态规则版本,
                    编码组[0], 编码组[1], 编码组[2], 编码组[3], 编码组[4], 编码组[5],
                    编码组[6], 编码组[7], 编码组[8], 编码组[9], 编码组[10], 编码组[11]}};
        } catch (const std::bad_alloc&) {
            return {后继状态读回请求形成状态::内部不一致, std::nullopt};
        } catch (...) {
            return {后继状态读回请求形成状态::内部不一致, std::nullopt};
        }
    }

private:
    L1状态登记结果 精确读回状态登记(const std::array<稳定编码, 7>& 编码组,
        std::optional<std::uint64_t> 首次创建代次) const {
        for (std::size_t i = 0; i < 编码组.size(); ++i) {
            if (!有效(编码组[i]))
                return {L1基准状态状态::内部不一致, std::nullopt};
            for (std::size_t j = i + 1; j < 编码组.size(); ++j)
                if (编码组[i] == 编码组[j])
                    return {L1基准状态状态::内部不一致, std::nullopt};
        }
        if (首次创建代次 && *首次创建代次 == 0)
            return {L1基准状态状态::内部不一致, std::nullopt};

        const auto G0 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (G0.合同版本 != L1中性CRUD合同版本)
            return {L1基准状态状态::内部不一致, std::nullopt};
        if (G0.状态 != L1中性读取状态::成功)
            return {L1状态内部::映射中性读取状态(G0.状态), std::nullopt};
        if (G0.事实代次 == 0)
            return {L1基准状态状态::内部不一致, std::nullopt};

        std::array<L1中性节点事实, 7> 节点组{};
        std::uint64_t 共同创建代次 = 0;
        for (std::size_t i = 0; i < 编码组.size(); ++i) {
            const auto 读取 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 编码组[i]});
            if (读取.合同版本 != L1中性CRUD合同版本 || 读取.查询编码 != 编码组[i])
                return {L1基准状态状态::内部不一致, std::nullopt};
            if (读取.状态 != L1中性读取状态::成功)
                return {L1状态内部::映射中性读取状态(读取.状态), std::nullopt};
            if (读取.读取事实代次 != G0.事实代次)
                return {L1基准状态状态::版本漂移, std::nullopt};
            if (!读取.事实 || 读取.事实->编码 != 编码组[i]
                || 读取.事实->退出事实代次 || !读取.事实->当前属性.empty()
                || !L1状态内部::中性登记节点形状符合(*读取.事实, i)
                || 读取.事实->创建事实代次 == 0
                || 读取.事实->创建事实代次 > G0.事实代次)
                return {L1基准状态状态::内部不一致, std::nullopt};
            if (共同创建代次 == 0) 共同创建代次 = 读取.事实->创建事实代次;
            else if (读取.事实->创建事实代次 != 共同创建代次)
                return {L1基准状态状态::内部不一致, std::nullopt};
            节点组[i] = *读取.事实;
        }
        if (首次创建代次 && 共同创建代次 != *首次创建代次)
            return {L1基准状态状态::内部不一致, std::nullopt};

        const auto G1 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (G1.合同版本 != L1中性CRUD合同版本)
            return {L1基准状态状态::内部不一致, std::nullopt};
        if (G1.状态 != L1中性读取状态::成功)
            return {L1状态内部::映射中性读取状态(G1.状态), std::nullopt};
        if (G1.事实代次 == 0)
            return {L1基准状态状态::内部不一致, std::nullopt};
        if (G1.事实代次 != G0.事实代次)
            return {L1基准状态状态::版本漂移, std::nullopt};

        L1状态结构登记 登记;
        登记.事实截止代次 = G0.事实代次;
        登记.服务身份 = 节点组[0].编码;
        登记.关系19状态组成关系类型 = 节点组[1].编码;
        登记.状态节点资格属性类型 = 节点组[2].编码;
        登记.状态发生时间属性类型 = 节点组[3].编码;
        登记.状态特征值见证资格属性类型 = 节点组[4].编码;
        登记.被采样P8值引用属性类型 = 节点组[5].编码;
        登记.状态采样I64值属性类型 = 节点组[6].编码;
        if (!L1状态结构登记完整(登记))
            return {L1基准状态状态::内部不一致, std::nullopt};
        return {L1基准状态状态::已读取, 登记};
    }

    static I64相邻前状态选择结果 选择失败(I64相邻前状态选择状态 状态) noexcept {
        return {状态, std::nullopt, std::nullopt};
    }

    static I64相邻前状态选择状态 映射选择读取状态(L1读取状态 状态) noexcept {
        switch (状态) {
        case L1读取状态::未找到:
        case L1读取状态::已退出:
        case L1读取状态::属性未设置:
            return I64相邻前状态选择状态::未找到;
        case L1读取状态::事实代次漂移:
            return I64相邻前状态选择状态::版本漂移;
        case L1读取状态::资源失败:
            return I64相邻前状态选择状态::资源失败;
        case L1读取状态::内部不一致:
            return I64相邻前状态选择状态::内部不一致;
        case L1读取状态::入口拒绝:
            return I64相邻前状态选择状态::入口拒绝;
        case L1读取状态::成功:
            return I64相邻前状态选择状态::内部不一致;
        default:
            return I64相邻前状态选择状态::内部不一致;
        }
    }

    static I64相邻前状态选择状态 映射P9选择状态(L1基准状态状态 状态) noexcept {
        switch (状态) {
        case L1基准状态状态::未找到:
            return I64相邻前状态选择状态::未找到;
        case L1基准状态状态::入口拒绝:
        case L1基准状态状态::幂等冲突:
            return I64相邻前状态选择状态::入口拒绝;
        case L1基准状态状态::版本漂移:
            return I64相邻前状态选择状态::版本漂移;
        case L1基准状态状态::许可拒绝:
            return I64相邻前状态选择状态::许可拒绝;
        case L1基准状态状态::资源失败:
            return I64相邻前状态选择状态::资源失败;
        case L1基准状态状态::内部不一致:
        case L1基准状态状态::已提交:
        case L1基准状态状态::幂等读回:
        case L1基准状态状态::已读取:
            return I64相邻前状态选择状态::内部不一致;
        default:
            return I64相邻前状态选择状态::内部不一致;
        }
    }

    static const 节点事实* 找当前节点(const L1完整快照& 快照, 稳定编码 编码) noexcept {
        const 节点事实* 结果 = nullptr;
        for (const auto& 节点 : 快照.当前节点) {
            if (节点.编码 != 编码) continue;
            if (结果) return nullptr;
            结果 = &节点;
        }
        return 结果;
    }

    static const 值事实* 找当前值(const L1完整快照& 快照, 稳定编码 编码) noexcept {
        const 值事实* 结果 = nullptr;
        for (const auto& 值 : 快照.当前值) {
            if (值.编码 != 编码) continue;
            if (结果) return nullptr;
            结果 = &值;
        }
        return 结果;
    }

    static std::optional<稳定编码> 找唯一当前槽(
        const 节点事实& 节点, 稳定编码 属性类型) noexcept {
        std::optional<稳定编码> 结果;
        for (const auto& 槽 : 节点.当前属性) {
            if (槽.属性类型节点 != 属性类型) continue;
            if (结果) return std::nullopt;
            结果 = 槽.当前值;
        }
        return 结果;
    }

    enum class 端点解析状态 : std::uint8_t {
        当前存在, 后来退出, 从未存在, 入口拒绝, 版本漂移, 资源失败, 内部不一致
    };

    struct 端点解析结果 final {
        端点解析状态 状态 = 端点解析状态::内部不一致;
        std::optional<节点事实> 见证;
    };

    static I64相邻前状态选择状态 映射端点状态(端点解析状态 状态) noexcept {
        switch (状态) {
        case 端点解析状态::从未存在: return I64相邻前状态选择状态::未找到;
        case 端点解析状态::入口拒绝: return I64相邻前状态选择状态::入口拒绝;
        case 端点解析状态::版本漂移: return I64相邻前状态选择状态::版本漂移;
        case 端点解析状态::资源失败: return I64相邻前状态选择状态::资源失败;
        default: return I64相邻前状态选择状态::内部不一致;
        }
    }

    端点解析结果 解析端点(稳定编码 编码, std::uint64_t G) const {
        const auto 当前 = L1_.读取当前节点({L1事实基座合同版本, 编码});
        if (当前.状态 == L1读取状态::成功) {
            const auto* 节点 = 当前.事实 ? std::get_if<节点事实>(&*当前.事实) : nullptr;
            if (当前.读取事实代次 != G) return {端点解析状态::版本漂移, std::nullopt};
            if (!节点 || 节点->编码 != 编码 || 节点->种类 != 节点种类::普通
                || 节点->创建事实代次 == 0 || 节点->创建事实代次 > G
                || 节点->退出事实代次)
                return {端点解析状态::内部不一致, std::nullopt};
            return {端点解析状态::当前存在, *节点};
        }
        if (当前.状态 == L1读取状态::未找到) {
            const auto 历史 = L1_.读取历史事实({L1事实基座合同版本, 编码});
            if (历史.状态 == L1读取状态::未找到 && !历史.历史)
                return {端点解析状态::从未存在, std::nullopt};
            if (历史.状态 == L1读取状态::资源失败)
                return {端点解析状态::资源失败, std::nullopt};
            if (历史.状态 == L1读取状态::入口拒绝)
                return {端点解析状态::入口拒绝, std::nullopt};
            return {端点解析状态::内部不一致, std::nullopt};
        }
        if (当前.状态 == L1读取状态::已退出) {
            const auto 历史 = L1_.读取历史事实({L1事实基座合同版本, 编码});
            const auto* 节点 = 历史.历史
                ? std::get_if<节点事实>(&历史.历史->事实) : nullptr;
            if (历史.状态 == L1读取状态::资源失败)
                return {端点解析状态::资源失败, std::nullopt};
            if (历史.状态 != L1读取状态::成功 || !历史.历史 || !节点
                || 历史.历史->查询编码 != 编码 || 历史.历史->当前有效
                || 节点->编码 != 编码 || 节点->种类 != 节点种类::普通
                || 节点->创建事实代次 == 0 || !节点->退出事实代次
                || 节点->创建事实代次 > *节点->退出事实代次
                || *节点->退出事实代次 > G)
                return {端点解析状态::内部不一致, std::nullopt};
            return {端点解析状态::后来退出, *节点};
        }
        if (当前.状态 == L1读取状态::资源失败)
            return {端点解析状态::资源失败, std::nullopt};
        if (当前.状态 == L1读取状态::事实代次漂移)
            return {端点解析状态::版本漂移, std::nullopt};
        if (当前.状态 == L1读取状态::入口拒绝)
            return {端点解析状态::入口拒绝, std::nullopt};
        return {端点解析状态::内部不一致, std::nullopt};
    }

    I64相邻前状态选择结果 选择一次(const I64相邻前状态选择请求& 请求,
        const L1状态结构登记& 登记) const {
        const auto 起始 = L1_.读取完整快照({});
        if (起始.状态 != L1读取状态::成功 || !起始.快照)
            return 选择失败(映射选择读取状态(起始.状态));
        const auto& 快照 = *起始.快照;
        const auto G = 快照.事实代次;
        if (G == 0) return 选择失败(I64相邻前状态选择状态::内部不一致);
        const auto 主体端点 = 解析端点(请求.主体, G);
        if (主体端点.状态 == 端点解析状态::后来退出)
            return 选择失败(I64相邻前状态选择状态::未找到);
        if (主体端点.状态 != 端点解析状态::当前存在)
            return 选择失败(映射端点状态(主体端点.状态));
        const auto 实例槽端点 = 解析端点(请求.实例槽, G);
        if (实例槽端点.状态 == 端点解析状态::后来退出)
            return 选择失败(I64相邻前状态选择状态::未找到);
        if (实例槽端点.状态 != 端点解析状态::当前存在)
            return 选择失败(映射端点状态(实例槽端点.状态));

        std::map<稳定编码, std::array<const 关系事实*, 5>> 状态组;
        for (const auto& 关系 : 快照.当前关系) {
            if (关系.关系类型节点 != 登记.关系19状态组成关系类型) continue;
            if (关系.角色或顺序 < 1 || 关系.角色或顺序 > 5)
                return 选择失败(I64相邻前状态选择状态::内部不一致);
            auto& 角色 = 状态组[关系.源节点][static_cast<std::size_t>(关系.角色或顺序 - 1)];
            if (角色) return 选择失败(I64相邻前状态选择状态::内部不一致);
            角色 = &关系;
        }

        struct 候选材料 final {
            稳定编码 状态;
            std::uint64_t 发生时间 = 0;
            实际存在I64基准状态读取请求 读取请求;
        };
        std::optional<候选材料> 最大候选;
        std::map<std::uint64_t, 稳定编码> 时间状态;
        for (const auto& [状态编码, 角色] : 状态组) {
            for (const auto* 关系 : 角色)
                if (!关系) return 选择失败(I64相邻前状态选择状态::内部不一致);
            const auto* 状态节点 = 找当前节点(快照, 状态编码);
            if (!状态节点 || 状态节点->种类 != 节点种类::普通)
                return 选择失败(I64相邻前状态选择状态::内部不一致);
            if (角色[0]->目标节点 != 请求.主体 || 角色[2]->目标节点 != 请求.实例槽)
                continue;

            const auto 资格编码 = 找唯一当前槽(*状态节点, 登记.状态节点资格属性类型);
            const auto 时间编码 = 找唯一当前槽(*状态节点, 登记.状态发生时间属性类型);
            if (!资格编码 || !时间编码)
                return 选择失败(I64相邻前状态选择状态::内部不一致);
            const auto* 资格 = 找当前值(快照, *资格编码);
            const auto* 时间 = 找当前值(快照, *时间编码);
            if (!资格 || !时间 || 资格->所属节点 != 状态编码 || 时间->所属节点 != 状态编码
                || 资格->属性类型节点 != 登记.状态节点资格属性类型
                || 时间->属性类型节点 != 登记.状态发生时间属性类型
                || 资格->来源节点 != 登记.服务身份 || 时间->来源节点 != 登记.服务身份
                || !std::holds_alternative<std::int64_t>(资格->材料)
                || std::get<std::int64_t>(资格->材料) != 状态节点资格值
                || !std::holds_alternative<std::vector<std::uint64_t>>(时间->材料)
                || std::get<std::vector<std::uint64_t>>(时间->材料).size() != 1
                || std::get<std::vector<std::uint64_t>>(时间->材料).front() == 0)
                return 选择失败(I64相邻前状态选择状态::内部不一致);
            const auto 发生时间 = std::get<std::vector<std::uint64_t>>(时间->材料).front();
            if (发生时间 >= 请求.拟发布后状态发生时间) continue;
            const auto [已有时间, 新增] = 时间状态.try_emplace(发生时间, 状态编码);
            if (!新增 && 已有时间->second != 状态编码)
                return 选择失败(I64相邻前状态选择状态::冲突);

            const auto* 见证节点 = 找当前节点(快照, 角色[3]->目标节点);
            if (!见证节点 || 见证节点->种类 != 节点种类::普通)
                return 选择失败(I64相邻前状态选择状态::内部不一致);
            const auto 见证资格 = 找唯一当前槽(*见证节点, 登记.状态特征值见证资格属性类型);
            const auto 被采样引用 = 找唯一当前槽(*见证节点, 登记.被采样P8值引用属性类型);
            const auto 采样I64 = 找唯一当前槽(*见证节点, 登记.状态采样I64值属性类型);
            if (!见证资格 || !被采样引用 || !采样I64)
                return 选择失败(I64相邻前状态选择状态::内部不一致);
            实际存在I64基准状态读取请求 读取请求;
            读取请求.状态 = 状态编码; 读取请求.特征值见证 = 见证节点->编码;
            读取请求.状态资格值 = *资格编码; 读取请求.发生时间值 = *时间编码;
            读取请求.特征值见证资格值 = *见证资格;
            读取请求.被采样P8值引用值 = *被采样引用;
            读取请求.状态采样I64值 = *采样I64;
            读取请求.主体关系 = 角色[0]->编码; 读取请求.场景关系 = 角色[1]->编码;
            读取请求.特征关系 = 角色[2]->编码; 读取请求.值关系 = 角色[3]->编码;
            读取请求.来源存在关系 = 角色[4]->编码;
            if (!最大候选 || 发生时间 > 最大候选->发生时间)
                最大候选 = 候选材料{状态编码, 发生时间, 读取请求};
        }

        std::optional<实际存在I64基准状态事实> 前状态;
        if (最大候选) {
            const auto P9 = 读取实际存在I64基准状态(最大候选->读取请求);
            if (P9.状态 != L1基准状态状态::已读取 || !P9.事实)
                return 选择失败(映射P9选择状态(P9.状态));
            const auto& 事实 = *P9.事实;
            if (事实.读取事实截止代次 != G || 事实.状态.编码 != 最大候选->状态
                || 事实.主体.编码 != 请求.主体 || 事实.特征.编码 != 请求.实例槽
                || !主体端点.见证 || !实例槽端点.见证
                || 事实.主体.创建事实代次 != 主体端点.见证->创建事实代次
                || 事实.主体.退出事实代次 != 主体端点.见证->退出事实代次
                || 事实.特征.创建事实代次 != 实例槽端点.见证->创建事实代次
                || 事实.特征.退出事实代次 != 实例槽端点.见证->退出事实代次
                || 事实.发生时间.材料.size() != 1
                || 事实.发生时间.材料.front() != 最大候选->发生时间)
                return 选择失败(事实.读取事实截止代次 == G
                    ? I64相邻前状态选择状态::内部不一致
                    : I64相邻前状态选择状态::版本漂移);
            前状态 = 事实;
        }
        const auto 结束 = L1_.读取完整快照({});
        if (结束.状态 != L1读取状态::成功 || !结束.快照)
            return 选择失败(映射选择读取状态(结束.状态));
        if (结束.快照->事实代次 != G)
            return 选择失败(I64相邻前状态选择状态::版本漂移);
        I64相邻前状态选择证据 证据;
        证据.业务查询身份 = 请求.业务查询身份; 证据.读取事实截止代次 = G;
        证据.主体 = 请求.主体; 证据.实例槽 = 请求.实例槽;
        证据.拟发布后状态发生时间 = 请求.拟发布后状态发生时间;
        if (最大候选) {
            证据.前状态 = 最大候选->状态;
            证据.前状态发生时间 = 最大候选->发生时间;
            return {I64相邻前状态选择状态::已选择, std::move(前状态), 证据};
        }
        return {I64相邻前状态选择状态::无前状态, std::nullopt, 证据};
    }

    实际存在I64基准状态结果 读取一次(const 实际存在I64基准状态读取请求& 请求) const {
        const auto 起始 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (起始.合同版本 != L1中性CRUD合同版本)
            return {L1基准状态状态::内部不一致, std::nullopt};
        if (起始.状态 != L1中性读取状态::成功)
            return {L1状态内部::映射中性读取状态(起始.状态), std::nullopt};
        const auto G = 起始.事实代次;
        if (G == 0) return {L1基准状态状态::内部不一致, std::nullopt};
        L1基准状态状态 失败 = L1基准状态状态::内部不一致;
        L1中性节点事实 状态, 特征值, 主体, 场景, 特征, 来源;
        if (!L1状态内部::读取中性节点(L1_, 请求.状态, G, 状态, 失败)
            || !L1状态内部::读取中性节点(L1_, 请求.特征值见证, G, 特征值, 失败))
            return {失败, std::nullopt};
        std::array<L1中性关系事实, 5> 关系组;
        const 稳定编码 关系编码[] = {请求.主体关系, 请求.场景关系, 请求.特征关系,
            请求.值关系, 请求.来源存在关系};
        for (std::size_t i = 0; i < 5; ++i)
            if (!L1状态内部::读取中性关系(L1_, 关系编码[i], G, 关系组[i], 失败))
                return {失败, std::nullopt};
        if (状态.种类 != 节点种类::普通 || 特征值.种类 != 节点种类::普通)
            return {L1基准状态状态::内部不一致, std::nullopt};
        for (std::size_t i = 0; i < 5; ++i) {
            if (关系组[i].源节点 != 请求.状态
                || 关系组[i].关系类型节点 != 登记_->关系19状态组成关系类型
                || 关系组[i].角色或顺序 != static_cast<std::int64_t>(i + 1))
                return {L1基准状态状态::内部不一致, std::nullopt};
        }
        const auto 当前关系组 = L1_.读取中性当前源关系组({L1中性CRUD合同版本,
            请求.状态, 登记_->关系19状态组成关系类型});
        if (当前关系组.合同版本 != L1中性CRUD合同版本
            || 当前关系组.源节点 != 请求.状态
            || 当前关系组.关系类型节点 != 登记_->关系19状态组成关系类型)
            return {L1基准状态状态::内部不一致, std::nullopt};
        if (当前关系组.状态 != L1中性读取状态::成功)
            return {L1状态内部::映射中性读取状态(当前关系组.状态), std::nullopt};
        if (当前关系组.读取事实代次 != G)
            return {L1基准状态状态::版本漂移, std::nullopt};
        std::array<std::uint32_t, 5> 当前角色数量{};
        for (const auto& 关系 : 当前关系组.关系组) {
            if (关系.退出事实代次 || 关系.源节点 != 请求.状态
                || 关系.关系类型节点 != 登记_->关系19状态组成关系类型
                || 关系.角色或顺序 < 1 || 关系.角色或顺序 > 5)
                return {L1基准状态状态::内部不一致, std::nullopt};
            const auto 索引 = static_cast<std::size_t>(关系.角色或顺序 - 1);
            ++当前角色数量[索引];
            if (关系.编码 != 关系编码[索引])
                return {L1基准状态状态::内部不一致, std::nullopt};
        }
        for (const auto 数量 : 当前角色数量)
            if (数量 > 1) return {L1基准状态状态::内部不一致, std::nullopt};
        if (关系组[3].目标节点 != 请求.特征值见证
            || 关系组[0].目标节点 != 关系组[4].目标节点)
            return {L1基准状态状态::内部不一致, std::nullopt};
        for (std::size_t i = 0; i < 5; ++i) {
            const auto 应为当前 = !关系组[i].退出事实代次;
            if ((应为当前 && 当前角色数量[i] != 1)
                || (!应为当前 && 当前角色数量[i] != 0))
                return {L1基准状态状态::内部不一致, std::nullopt};
        }
        if (!L1状态内部::读取中性节点(L1_, 关系组[0].目标节点, G, 主体, 失败)
            || !L1状态内部::读取中性节点(L1_, 关系组[1].目标节点, G, 场景, 失败)
            || !L1状态内部::读取中性节点(L1_, 关系组[2].目标节点, G, 特征, 失败)
            || !L1状态内部::读取中性节点(L1_, 关系组[4].目标节点, G, 来源, 失败))
            return {失败, std::nullopt};
        if (主体.种类 != 节点种类::普通 || 场景.种类 != 节点种类::普通
            || 特征.种类 != 节点种类::普通 || 来源.种类 != 节点种类::普通)
            return {L1基准状态状态::内部不一致, std::nullopt};
        std::array<L1中性值事实, 5> 值组;
        const 稳定编码 值编码[] = {请求.状态资格值, 请求.发生时间值,
            请求.特征值见证资格值, 请求.被采样P8值引用值, 请求.状态采样I64值};
        for (std::size_t i = 0; i < 5; ++i)
            if (!L1状态内部::读取中性值(L1_, 值编码[i], G, 值组[i], 失败))
                return {失败, std::nullopt};
        const 稳定编码 类型组[] = {登记_->状态节点资格属性类型,
            登记_->状态发生时间属性类型, 登记_->状态特征值见证资格属性类型,
            登记_->被采样P8值引用属性类型, 登记_->状态采样I64值属性类型};
        for (std::size_t i = 0; i < 5; ++i) {
            const auto& 节点 = i < 2 ? 状态 : 特征值;
            if (值组[i].所属节点 != 节点.编码 || 值组[i].属性类型节点 != 类型组[i]
                || !L1状态内部::中性属性槽精确(节点, 类型组[i], 值组[i].编码))
                return {L1基准状态状态::内部不一致, std::nullopt};
        }
        if (!std::holds_alternative<std::int64_t>(值组[0].材料)
            || std::get<std::int64_t>(值组[0].材料) != 状态节点资格值
            || !std::holds_alternative<std::vector<std::uint64_t>>(值组[1].材料)
            || std::get<std::vector<std::uint64_t>>(值组[1].材料).size() != 1
            || std::get<std::vector<std::uint64_t>>(值组[1].材料).front() == 0
            || !std::holds_alternative<std::int64_t>(值组[2].材料)
            || std::get<std::int64_t>(值组[2].材料) != 状态特征值见证资格值
            || !std::holds_alternative<std::vector<std::uint64_t>>(值组[3].材料)
            || std::get<std::vector<std::uint64_t>>(值组[3].材料).size() != 4
            || !std::holds_alternative<std::int64_t>(值组[4].材料))
            return {L1基准状态状态::内部不一致, std::nullopt};
        if (值组[0].来源节点 != 登记_->服务身份 || 值组[1].来源节点 != 登记_->服务身份
            || 值组[2].来源节点 != 登记_->服务身份
            || 值组[3].来源节点 != 来源.编码 || 值组[4].来源节点 != 来源.编码)
            return {L1基准状态状态::内部不一致, std::nullopt};
        const auto& 引用 = std::get<std::vector<std::uint64_t>>(值组[3].材料);
        const std::uint64_t 采样代次 = 引用[2];
        if (采样代次 == 0 || 引用[0] == 0 || 引用[1] == 0 || 引用[3] == 0
            || G < 采样代次 + 1 || 状态.创建事实代次 != 采样代次 + 1
            || 特征值.创建事实代次 != 采样代次 + 1)
            return {L1基准状态状态::内部不一致, std::nullopt};
        for (const auto& 关系 : 关系组)
            if (关系.创建事实代次 != 采样代次 + 1)
                return {L1基准状态状态::内部不一致, std::nullopt};
        for (const auto& 值 : 值组)
            if (值.创建事实代次 != 采样代次 + 1)
                return {L1基准状态状态::内部不一致, std::nullopt};
        if (!L1状态内部::节点在代次有效(主体, 采样代次)
            || !L1状态内部::节点在代次有效(场景, 采样代次)
            || !L1状态内部::节点在代次有效(特征, 采样代次)
            || !L1状态内部::节点在代次有效(来源, 采样代次))
            return {L1基准状态状态::内部不一致, std::nullopt};
        L1中性值事实 被采样值;
        const 稳定编码 被采样编码{引用[0]};
        if (!L1状态内部::读取中性值(L1_, 被采样编码, G, 被采样值, 失败))
            return {失败, std::nullopt};
        L1中性节点事实 被采样属性类型;
        if (!L1状态内部::读取中性节点(L1_, 被采样值.属性类型节点, G,
            被采样属性类型, 失败)) return {失败, std::nullopt};
        if (被采样值.所属节点 != 特征.编码 || !有效(被采样值.属性类型节点)
            || 被采样属性类型.种类 != 节点种类::属性类型
            || 被采样属性类型.属性类型表示 != std::optional{L1中性值表示种类::I64}
            || !L1状态内部::节点在代次有效(被采样属性类型, 采样代次)
            || 被采样值.来源节点.值 != 引用[3] || 被采样值.创建事实代次 != 引用[1]
            || !L1状态内部::值在代次有效(被采样值, 采样代次)
            || !std::holds_alternative<std::int64_t>(被采样值.材料)
            || std::get<std::int64_t>(被采样值.材料) != std::get<std::int64_t>(值组[4].材料))
            return {L1基准状态状态::内部不一致, std::nullopt};
        const auto 结束 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (结束.合同版本 != L1中性CRUD合同版本)
            return {L1基准状态状态::内部不一致, std::nullopt};
        if (结束.状态 != L1中性读取状态::成功)
            return {L1状态内部::映射中性读取状态(结束.状态), std::nullopt};
        if (结束.事实代次 != G) return {L1基准状态状态::版本漂移, std::nullopt};
        实际存在I64基准状态事实 事实;
        事实.读取事实截止代次 = G;
        事实.状态采样事实截止代次 = 采样代次;
        事实.状态 = L1状态内部::形成中性节点见证(状态);
        事实.场景 = L1状态内部::形成中性节点见证(场景);
        事实.主体 = L1状态内部::形成中性节点见证(主体);
        事实.特征 = L1状态内部::形成中性节点见证(特征);
        事实.特征值 = L1状态内部::形成中性节点见证(特征值);
        事实.来源存在 = L1状态内部::形成中性节点见证(来源);
        事实.主体关系 = L1状态内部::形成中性关系见证(关系组[0]);
        事实.场景关系 = L1状态内部::形成中性关系见证(关系组[1]);
        事实.特征关系 = L1状态内部::形成中性关系见证(关系组[2]);
        事实.值关系 = L1状态内部::形成中性关系见证(关系组[3]);
        事实.来源存在关系 = L1状态内部::形成中性关系见证(关系组[4]);
        事实.状态资格 = L1状态内部::形成中性I64见证(值组[0]);
        事实.发生时间 = L1状态内部::形成中性U64组见证(值组[1]);
        事实.特征值见证资格 = L1状态内部::形成中性I64见证(值组[2]);
        事实.被采样P8值引用 = L1状态内部::形成中性U64组见证(值组[3]);
        事实.采样I64值 = L1状态内部::形成中性I64见证(值组[4]);
        事实.被采样P8值 = L1状态内部::形成中性I64见证(被采样值);
        return {L1基准状态状态::已读取, std::move(事实)};
    }

    L1事实基座服务& L1_;
    L1实际存在场景组合服务& 实际存在_;
    L1实例特征服务& 实例特征_;
    mutable std::recursive_mutex 锁_;
    std::optional<L1状态结构登记> 登记_;
    struct 首态记录 final {
        实际存在I64首个基准状态发布请求 请求;
        L1中性写集请求 中性写集;
        实际存在I64基准状态读取请求 读取请求;
        实际存在I64基准状态结果 首次结果;
    };
    std::map<std::uint64_t, 首态记录> 首态账_;
};

} // namespace 海中鱼巣
