inline constexpr L1所有者范围建立幂等身份 自我治理所有者建立身份{
    0x4C31'5345'4C46'4F57ULL};

class L2自我治理结构服务;

class L2自我治理所有者交付 final {
public:
    L2自我治理所有者交付() = delete;
    L2自我治理所有者交付(const L2自我治理所有者交付&) = delete;
    L2自我治理所有者交付& operator=(const L2自我治理所有者交付&) = delete;
    L2自我治理所有者交付(L2自我治理所有者交付&&) noexcept = default;
    L2自我治理所有者交付& operator=(L2自我治理所有者交付&&) = delete;

    bool 有效() const noexcept { return 写入端口_.有效(); }
    bool 绑定于(const L1事实基座服务& 服务) const noexcept {
        return 写入端口_.绑定于(服务);
    }
    L1结构所有者身份 所有者身份() const noexcept {
        return 写入端口_.所有者身份();
    }

private:
    explicit L2自我治理所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2自我治理所有者交付>
    尝试形成L2自我治理所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2自我治理结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2自我治理所有者交付> 尝试形成L2自我治理所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

} // namespace 海中鱼巣

namespace 海中鱼巣::L2自我治理结构内部 {

inline constexpr L1所有者范围写入幂等身份 结构登记幂等身份{
    0x4C32'5345'4C46'5247ULL};
inline constexpr std::uint32_t 授权载荷登记键 = 0x0304'200EU;
inline constexpr std::uint32_t 授权收口载荷登记键 = 0x0304'2017U;
inline constexpr std::uint32_t 后继决议载荷登记键 = 0x0304'202CU;
inline constexpr std::uint32_t 优先级成员载荷登记键 = 0x0304'206DU;
inline constexpr std::uint32_t 优先级批次载荷登记键 = 0x0304'206EU;
inline constexpr std::uint32_t 优先级批次成员关系登记键 = 0x0304'206FU;

struct 结构登记定位 final {
    稳定编码 授权载荷;
    稳定编码 授权收口载荷;
    稳定编码 后继决议载荷;
    稳定编码 优先级成员载荷;
    稳定编码 优先级批次载荷;
    稳定编码 优先级批次成员关系;
};

inline L1所有者范围写集本地键 键(std::uint32_t 值) noexcept { return {值}; }

inline std::optional<稳定编码> 查找映射(
    const std::vector<std::pair<L1所有者范围写集本地键, 稳定编码>>& 映射,
    std::uint32_t 本地键) noexcept {
    for (const auto& [键值, 编码] : 映射)
        if (键值.值 == 本地键) return 编码;
    return std::nullopt;
}

inline L2结构状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::未找到: return L2结构状态::未找到;
    case L1所有者范围写入状态::已退出: return L2结构状态::已退出;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    default: return L2结构状态::内部不一致;
    }
}

inline L2结构状态 映射读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::已退出: return L2结构状态::已退出;
    case L1所有者范围读取状态::属性未设置: return L2结构状态::属性未设置;
    case L1所有者范围读取状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    default: return L2结构状态::内部不一致;
    }
}

inline bool 登记定位有效(const 结构登记定位& 定位) noexcept {
    return 海中鱼巣::有效(定位.授权载荷)
        && 海中鱼巣::有效(定位.授权收口载荷)
        && 海中鱼巣::有效(定位.后继决议载荷)
        && 海中鱼巣::有效(定位.优先级成员载荷)
        && 海中鱼巣::有效(定位.优先级批次载荷)
        && 海中鱼巣::有效(定位.优先级批次成员关系);
}

结构登记定位 初始化结构登记(
    const L1事实基座服务& L1, L1所有者范围写端口& 写入端口) {
    L1所有者范围写集请求 写集;
    const auto 首次 = 写入端口.读取首次写入材料(
        {L1所有者范围首次写入读取合同版本, 结构登记幂等身份});
    if (首次.状态 == L1所有者范围读取状态::成功
        && 首次.首次规范化写集) {
        写集 = *首次.首次规范化写集;
    } else {
        const auto 当前 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前.状态 != L1中性读取状态::成功 || 当前.事实代次 == 0)
            throw std::runtime_error("L2 self governance registration cutoff unavailable");
        写集.期望事实代次 = 当前.事实代次;
        写集.写入幂等身份 = 结构登记幂等身份;
        const auto 属性类型 = [&](std::uint32_t 本地键) {
            写集.节点.push_back({键(本地键), 节点种类::属性类型,
                L1所有者范围值表示种类::U64组});
        };
        属性类型(授权载荷登记键);
        属性类型(授权收口载荷登记键);
        属性类型(后继决议载荷登记键);
        属性类型(优先级成员载荷登记键);
        属性类型(优先级批次载荷登记键);
        写集.节点.push_back({键(优先级批次成员关系登记键),
            节点种类::普通, std::nullopt});
    }
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.状态 != L1所有者范围写入状态::成功
        && 写入.状态 != L1所有者范围写入状态::精确重复)
        throw std::runtime_error("L2 self governance registration failed");
    结构登记定位 定位;
    const auto 取 = [&](std::uint32_t 本地键) -> 稳定编码 {
        const auto 编码 = 查找映射(写入.新编码映射, 本地键);
        if (!编码) throw std::runtime_error("L2 self governance registration mapping missing");
        return *编码;
    };
    定位.授权载荷 = 取(授权载荷登记键);
    定位.授权收口载荷 = 取(授权收口载荷登记键);
    定位.后继决议载荷 = 取(后继决议载荷登记键);
    定位.优先级成员载荷 = 取(优先级成员载荷登记键);
    定位.优先级批次载荷 = 取(优先级批次载荷登记键);
    定位.优先级批次成员关系 = 取(优先级批次成员关系登记键);
    if (!登记定位有效(定位))
        throw std::runtime_error("L2 self governance registration invalid");
    return 定位;
}

inline void 推入(std::vector<std::uint64_t>& 输出, 稳定编码 值) {
    输出.push_back(值.值);
}
inline void 推入生命周期(std::vector<std::uint64_t>& 输出,
    const L2生命周期& 生命周期) {
    输出.push_back(生命周期.创建事实代次);
    输出.push_back(生命周期.退出事实代次.value_or(0));
}
inline bool 读取数(const std::vector<std::uint64_t>& 输入,
    std::size_t& 位置, std::uint64_t& 值) noexcept {
    if (位置 >= 输入.size()) return false;
    值 = 输入[位置++];
    return true;
}
inline bool 读取编码(const std::vector<std::uint64_t>& 输入,
    std::size_t& 位置, 稳定编码& 值) noexcept {
    std::uint64_t 原值 = 0;
    if (!读取数(输入, 位置, 原值)) return false;
    值 = {原值};
    return true;
}
inline bool 读取生命周期(const std::vector<std::uint64_t>& 输入,
    std::size_t& 位置, L2生命周期& 生命周期) noexcept {
    std::uint64_t 创建 = 0, 退出 = 0;
    if (!读取数(输入, 位置, 创建) || !读取数(输入, 位置, 退出)) return false;
    生命周期 = {创建, 退出 == 0 ? std::nullopt : std::optional<std::uint64_t>{退出}};
    return true;
}

inline bool 动作范围有效(const std::vector<任务冻结动作项>& 动作组) noexcept {
    if (动作组.empty()) return false;
    for (std::size_t i = 0; i < 动作组.size(); ++i) {
        const auto& 动作 = 动作组[i];
        if (动作.顺序 != i + 1 || !有效(动作.动作入口.值)
            || !L2方法稳定动作键有效(动作.稳定动作键)
            || !有效(动作.作用主体.值) || !有效(动作.动作范围材料)
            || !有效(动作.预期结果材料)
            || !有效(动作.结果验证合同)
            || !有效(动作.动作归因合同)
            || (动作.作用场景 && !有效(动作.作用场景->值))
            || (动作.作用范围 != 任务动作作用范围::内部治理
                && 动作.作用范围 != 任务动作作用范围::纯现实观察
                && 动作.作用范围 != 任务动作作用范围::现实改变))
            return false;
    }
    return true;
}

inline void 编码动作组(std::vector<std::uint64_t>& 输出,
    const std::vector<任务冻结动作项>& 动作组) {
    输出.push_back(static_cast<std::uint64_t>(动作组.size()));
    for (const auto& 动作 : 动作组) {
        输出.push_back(动作.顺序);
        推入(输出, 动作.动作入口.值);
        输出.push_back(动作.稳定动作键.值);
        输出.push_back(static_cast<std::uint64_t>(动作.作用范围));
        推入(输出, 动作.作用主体.值);
        输出.push_back(动作.作用场景 ? 动作.作用场景->值.值 : 0);
        推入(输出, 动作.动作范围材料);
        推入(输出, 动作.预期结果材料);
        推入(输出, 动作.结果验证合同);
        推入(输出, 动作.动作归因合同);
    }
}

inline bool 解码动作组(const std::vector<std::uint64_t>& 输入,
    std::size_t& 位置, std::vector<任务冻结动作项>& 动作组) {
    std::uint64_t 数量 = 0;
    if (!读取数(输入, 位置, 数量) || 数量 > 输入.size() - 位置) return false;
    动作组.clear();
    动作组.reserve(static_cast<std::size_t>(数量));
    for (std::uint64_t i = 0; i < 数量; ++i) {
        任务冻结动作项 动作;
        std::uint64_t 范围 = 0, 场景 = 0;
        if (!读取数(输入, 位置, 动作.顺序)
            || !读取编码(输入, 位置, 动作.动作入口.值)
            || !读取数(输入, 位置, 动作.稳定动作键.值)
            || !读取数(输入, 位置, 范围)
            || !读取编码(输入, 位置, 动作.作用主体.值)
            || !读取数(输入, 位置, 场景)
            || !读取编码(输入, 位置, 动作.动作范围材料)
            || !读取编码(输入, 位置, 动作.预期结果材料)
            || !读取编码(输入, 位置, 动作.结果验证合同)
            || !读取编码(输入, 位置, 动作.动作归因合同))
            return false;
        动作.作用范围 = static_cast<任务动作作用范围>(范围);
        if (场景 != 0) 动作.作用场景 = L2场景身份{稳定编码{场景}};
        动作组.push_back(std::move(动作));
    }
    return 动作范围有效(动作组);
}

inline void 编码容量(std::vector<std::uint64_t>& 输出,
    const L2任务结果消费容量合同& 容量) {
    推入(输出, 容量.合同身份);
    输出.push_back(容量.合同版本);
    输出.push_back(static_cast<std::uint64_t>(容量.消费形态));
    输出.push_back(容量.初始可用单位);
    输出.push_back(static_cast<std::uint64_t>(容量.扣减维度组.size()));
    for (const auto 维度 : 容量.扣减维度组)
        输出.push_back(static_cast<std::uint64_t>(维度));
    推入(输出, 容量.范围合同身份);
    推入(输出, 容量.所有权合同身份);
    推入(输出, 容量.有效性合同身份);
}

inline bool 解码容量(const std::vector<std::uint64_t>& 输入,
    std::size_t& 位置, L2任务结果消费容量合同& 容量) {
    std::uint64_t 版本 = 0, 形态 = 0, 维度数 = 0;
    if (!读取编码(输入, 位置, 容量.合同身份)
        || !读取数(输入, 位置, 版本)
        || !读取数(输入, 位置, 形态)
        || !读取数(输入, 位置, 容量.初始可用单位)
        || !读取数(输入, 位置, 维度数)
        || 维度数 > 输入.size() - 位置)
        return false;
    容量.合同版本 = static_cast<std::uint32_t>(版本);
    容量.消费形态 = static_cast<L2任务结果消费形态>(形态);
    容量.扣减维度组.clear();
    for (std::uint64_t i = 0; i < 维度数; ++i) {
        std::uint64_t 维度 = 0;
        if (!读取数(输入, 位置, 维度)) return false;
        容量.扣减维度组.push_back(static_cast<L2结果消费扣减维度>(维度));
    }
    return 读取编码(输入, 位置, 容量.范围合同身份)
        && 读取编码(输入, 位置, 容量.所有权合同身份)
        && 读取编码(输入, 位置, 容量.有效性合同身份);
}

inline void 编码资格(std::vector<std::uint64_t>& 输出,
    const L2成员消费资格材料& 资格) {
    推入(输出, 资格.成员.关系稳定编码);
    推入(输出, 资格.成员.任务.值);
    推入(输出, 资格.成员.来源需求.值);
    输出.push_back(资格.成员.来源顺序);
    推入生命周期(输出, 资格.成员.生命周期);
    推入(输出, 资格.目标合同.值);
    推入(输出, 资格.资格证据身份);
    输出.push_back(资格.资格规则版本);
    推入(输出, 资格.范围合同身份);
    推入(输出, 资格.所有权合同身份);
    推入(输出, 资格.有效性合同身份);
    输出.push_back(资格.最低合法分配单位);
    输出.push_back(资格.期望分配单位);
}

inline bool 解码资格(const std::vector<std::uint64_t>& 输入,
    std::size_t& 位置, L2成员消费资格材料& 资格) {
    std::uint64_t 版本 = 0;
    if (!读取编码(输入, 位置, 资格.成员.关系稳定编码)
        || !读取编码(输入, 位置, 资格.成员.任务.值)
        || !读取编码(输入, 位置, 资格.成员.来源需求.值)
        || !读取数(输入, 位置, 资格.成员.来源顺序)
        || !读取生命周期(输入, 位置, 资格.成员.生命周期)
        || !读取编码(输入, 位置, 资格.目标合同.值)
        || !读取编码(输入, 位置, 资格.资格证据身份)
        || !读取数(输入, 位置, 版本)
        || !读取编码(输入, 位置, 资格.范围合同身份)
        || !读取编码(输入, 位置, 资格.所有权合同身份)
        || !读取编码(输入, 位置, 资格.有效性合同身份)
        || !读取数(输入, 位置, 资格.最低合法分配单位)
        || !读取数(输入, 位置, 资格.期望分配单位))
        return false;
    资格.资格规则版本 = static_cast<std::uint32_t>(版本);
    return true;
}

inline std::vector<std::uint64_t> 编码授权(const L2自我现实执行授权事实& 事实) {
    std::vector<std::uint64_t> 输出;
    推入(输出, 事实.自我.值); 推入(输出, 事实.任务.值);
    推入(输出, 事实.任务轮次.值); 推入(输出, 事实.筹办轮次.值);
    推入(输出, 事实.执行轮次.值); 推入(输出, 事实.冻结.值);
    输出.push_back(事实.冻结版本); 推入(输出, 事实.实例方法.值);
    推入(输出, 事实.方法.值); 推入(输出, 事实.方法内容版本);
    编码动作组(输出, 事实.有序冻结动作范围);
    输出.push_back(事实.来源共同事实截止);
    输出.push_back(事实.授权规则版本);
    输出.push_back(事实.发生时间); 输出.push_back(事实.有效截止时间);
    return 输出;
}

inline bool 解码授权(const std::vector<std::uint64_t>& 输入,
    L2自我现实执行授权事实& 事实) {
    std::size_t 位置 = 0; std::uint64_t 版本 = 0;
    if (!读取编码(输入, 位置, 事实.自我.值)
        || !读取编码(输入, 位置, 事实.任务.值)
        || !读取编码(输入, 位置, 事实.任务轮次.值)
        || !读取编码(输入, 位置, 事实.筹办轮次.值)
        || !读取编码(输入, 位置, 事实.执行轮次.值)
        || !读取编码(输入, 位置, 事实.冻结.值)
        || !读取数(输入, 位置, 事实.冻结版本)
        || !读取编码(输入, 位置, 事实.实例方法.值)
        || !读取编码(输入, 位置, 事实.方法.值)
        || !读取编码(输入, 位置, 事实.方法内容版本)
        || !解码动作组(输入, 位置, 事实.有序冻结动作范围)
        || !读取数(输入, 位置, 事实.来源共同事实截止)
        || !读取数(输入, 位置, 版本)
        || !读取数(输入, 位置, 事实.发生时间)
        || !读取数(输入, 位置, 事实.有效截止时间)
        || 位置 != 输入.size()) return false;
    事实.授权规则版本 = static_cast<std::uint32_t>(版本);
    return true;
}

inline std::vector<std::uint64_t> 编码授权收口(
    const L2自我现实执行授权收口事实& 事实) {
    return {事实.授权.值.值, 事实.任务.值.值, 事实.任务轮次.值.值,
        事实.执行轮次.值.值, static_cast<std::uint64_t>(事实.种类),
        事实.发生时间, 事实.收口规则版本};
}

inline bool 解码授权收口(const std::vector<std::uint64_t>& 输入,
    L2自我现实执行授权收口事实& 事实) {
    if (输入.size() != 7) return false;
    事实.授权.值 = {输入[0]}; 事实.任务.值 = {输入[1]};
    事实.任务轮次.值 = {输入[2]}; 事实.执行轮次.值 = {输入[3]};
    事实.种类 = static_cast<自我现实执行授权收口种类>(输入[4]);
    事实.发生时间 = 输入[5]; 事实.收口规则版本 = static_cast<std::uint32_t>(输入[6]);
    return true;
}

inline std::vector<std::uint64_t> 编码优先级批次(
    const 自我结果争用优先级批次事实& 事实) {
    std::vector<std::uint64_t> 输出;
    推入(输出, 事实.自我.值); 推入(输出, 事实.任务.值);
    推入(输出, 事实.任务轮次.值); 推入(输出, 事实.正式结果.值);
    输出.push_back(事实.冻结成员集合版本); 编码容量(输出, 事实.容量合同);
    推入(输出, 事实.来源规则身份); 输出.push_back(事实.关系规则版本);
    输出.push_back(事实.优先级规则版本); 输出.push_back(事实.同级规则版本);
    输出.push_back(事实.来源共同事实截止);
    return 输出;
}

inline bool 解码优先级批次(const std::vector<std::uint64_t>& 输入,
    自我结果争用优先级批次事实& 事实) {
    std::size_t 位置 = 0; std::uint64_t 关系 = 0, 优先级 = 0, 同级 = 0;
    if (!读取编码(输入, 位置, 事实.自我.值)
        || !读取编码(输入, 位置, 事实.任务.值)
        || !读取编码(输入, 位置, 事实.任务轮次.值)
        || !读取编码(输入, 位置, 事实.正式结果.值)
        || !读取数(输入, 位置, 事实.冻结成员集合版本)
        || !解码容量(输入, 位置, 事实.容量合同)
        || !读取编码(输入, 位置, 事实.来源规则身份)
        || !读取数(输入, 位置, 关系)
        || !读取数(输入, 位置, 优先级)
        || !读取数(输入, 位置, 同级)
        || !读取数(输入, 位置, 事实.来源共同事实截止)
        || 位置 != 输入.size()) return false;
    事实.关系规则版本 = static_cast<std::uint32_t>(关系);
    事实.优先级规则版本 = static_cast<std::uint32_t>(优先级);
    事实.同级规则版本 = static_cast<std::uint32_t>(同级);
    return true;
}

inline std::vector<std::uint64_t> 编码优先级成员(
    const 自我结果争用成员优先级事实& 事实) {
    std::vector<std::uint64_t> 输出;
    编码资格(输出, 事实.消费资格);
    输出.push_back(事实.优先级序号); 输出.push_back(事实.同级顺序序号);
    输出.push_back(static_cast<std::uint64_t>(事实.理由证据组.size()));
    for (const auto 理由 : 事实.理由证据组) 推入(输出, 理由);
    return 输出;
}

inline bool 解码优先级成员(const std::vector<std::uint64_t>& 输入,
    自我结果争用成员优先级事实& 事实) {
    std::size_t 位置 = 0; std::uint64_t 数量 = 0;
    if (!解码资格(输入, 位置, 事实.消费资格)
        || !读取数(输入, 位置, 事实.优先级序号)
        || !读取数(输入, 位置, 事实.同级顺序序号)
        || !读取数(输入, 位置, 数量) || 数量 > 输入.size() - 位置)
        return false;
    事实.理由证据组.clear();
    for (std::uint64_t i = 0; i < 数量; ++i) {
        稳定编码 理由;
        if (!读取编码(输入, 位置, 理由)) return false;
        事实.理由证据组.push_back(理由);
    }
    return 位置 == 输入.size();
}

inline std::vector<std::uint64_t> 编码后继决议(
    const L2自我任务后继决议事实& 事实) {
    std::vector<std::uint64_t> 输出;
    推入(输出, 事实.自我.值); 推入(输出, 事实.任务.值);
    推入(输出, 事实.已收束任务轮次.值); 推入(输出, 事实.轮次结算.值);
    输出.push_back(static_cast<std::uint64_t>(事实.指令));
    输出.push_back(static_cast<std::uint64_t>(事实.当前需求依据.size()));
    for (const auto& 依据 : 事实.当前需求依据) {
        推入(输出, 依据.需求.值); 推入(输出, 依据.当前状态.值);
        推入(输出, 依据.当前优先级事实);
    }
    输出.push_back(static_cast<std::uint64_t>(事实.当前安全依据.size()));
    for (const auto& 依据 : 事实.当前安全依据) 推入(输出, 依据.安全事实);
    输出.push_back(static_cast<std::uint64_t>(事实.当前整体治理依据.size()));
    for (const auto& 依据 : 事实.当前整体治理依据) 推入(输出, 依据.治理事实);
    输出.push_back(事实.来源共同事实截止);
    输出.push_back(事实.决议规则版本); 输出.push_back(事实.发生时间);
    return 输出;
}

inline bool 解码后继决议(const std::vector<std::uint64_t>& 输入,
    L2自我任务后继决议事实& 事实) {
    事实.当前需求依据.clear();
    事实.当前安全依据.clear();
    事实.当前整体治理依据.clear();
    std::size_t 位置 = 0; std::uint64_t 指令 = 0, 数量 = 0, 版本 = 0;
    if (!读取编码(输入, 位置, 事实.自我.值)
        || !读取编码(输入, 位置, 事实.任务.值)
        || !读取编码(输入, 位置, 事实.已收束任务轮次.值)
        || !读取编码(输入, 位置, 事实.轮次结算.值)
        || !读取数(输入, 位置, 指令)
        || !读取数(输入, 位置, 数量) || 数量 > 输入.size() - 位置)
        return false;
    事实.指令 = static_cast<自我任务后继指令>(指令);
    for (std::uint64_t i = 0; i < 数量; ++i) {
        自我任务后继需求依据 依据;
        if (!读取编码(输入, 位置, 依据.需求.值)
            || !读取编码(输入, 位置, 依据.当前状态.值)
            || !读取编码(输入, 位置, 依据.当前优先级事实)) return false;
        事实.当前需求依据.push_back(依据);
    }
    if (!读取数(输入, 位置, 数量) || 数量 > 输入.size() - 位置) return false;
    for (std::uint64_t i = 0; i < 数量; ++i) {
        自我任务后继安全依据 依据;
        if (!读取编码(输入, 位置, 依据.安全事实)) return false;
        事实.当前安全依据.push_back(依据);
    }
    if (!读取数(输入, 位置, 数量) || 数量 > 输入.size() - 位置) return false;
    for (std::uint64_t i = 0; i < 数量; ++i) {
        自我任务后继整体治理依据 依据;
        if (!读取编码(输入, 位置, 依据.治理事实)) return false;
        事实.当前整体治理依据.push_back(依据);
    }
    if (!读取数(输入, 位置, 事实.来源共同事实截止)
        || !读取数(输入, 位置, 版本)
        || !读取数(输入, 位置, 事实.发生时间)
        || 位置 != 输入.size()) return false;
    事实.决议规则版本 = static_cast<std::uint32_t>(版本);
    return true;
}

inline bool 基本事实有效(const L2自我治理结构事实载荷& 载荷,
    L2自我治理结构事实种类 种类) noexcept {
    if (种类 == L2自我治理结构事实种类::现实执行授权) {
        const auto* 事实 = std::get_if<L2自我现实执行授权事实>(&载荷);
        return 事实 && !有效(事实->身份.值) && 有效(事实->自我.值)
            && 有效(事实->任务.值) && 有效(事实->任务轮次.值)
            && 有效(事实->筹办轮次.值) && 有效(事实->执行轮次.值)
            && 有效(事实->冻结.值) && 事实->冻结版本 != 0
            && 有效(事实->实例方法.值) && 有效(事实->方法.值)
            && 有效(事实->方法内容版本) && 动作范围有效(事实->有序冻结动作范围)
            && 事实->来源共同事实截止 != 0 && 事实->授权规则版本 != 0
            && 事实->发生时间 != 0 && 事实->有效截止时间 >= 事实->发生时间
            && 事实->生命周期.创建事实代次 == 0 && !事实->生命周期.退出事实代次;
    }
    if (种类 == L2自我治理结构事实种类::现实执行授权收口) {
        const auto* 事实 = std::get_if<L2自我现实执行授权收口事实>(&载荷);
        return 事实 && !有效(事实->身份.值) && 有效(事实->授权.值)
            && 有效(事实->任务.值) && 有效(事实->任务轮次.值)
            && 有效(事实->执行轮次.值) && 事实->发生时间 != 0
            && 事实->收口规则版本 != 0
            && 事实->种类 >= 自我现实执行授权收口种类::已消费
            && 事实->种类 <= 自我现实执行授权收口种类::已失效
            && 事实->生命周期.创建事实代次 == 0 && !事实->生命周期.退出事实代次;
    }
    if (种类 == L2自我治理结构事实种类::结果争用优先级批次) {
        const auto* 完整 = std::get_if<L2自我结果争用优先级完整事实>(&载荷);
        return 完整 && !有效(完整->批次.身份.值) && 有效(完整->批次.自我.值)
            && 有效(完整->批次.任务.值) && 有效(完整->批次.任务轮次.值)
            && 有效(完整->批次.正式结果.值) && 完整->批次.冻结成员集合版本 != 0
            && 有效(完整->批次.容量合同.合同身份)
            && 完整->批次.容量合同.消费形态 != L2任务结果消费形态::可重复引用
            && 完整->批次.成员优先级.empty() && !完整->成员事实组.empty()
            && 有效(完整->批次.来源规则身份) && 完整->批次.关系规则版本 != 0
            && 完整->批次.优先级规则版本 != 0 && 完整->批次.同级规则版本 != 0
            && 完整->批次.来源共同事实截止 != 0;
    }
    const auto* 事实 = std::get_if<L2自我任务后继决议事实>(&载荷);
    return 种类 == L2自我治理结构事实种类::任务后继决议 && 事实
        && !有效(事实->身份) && 有效(事实->自我.值) && 有效(事实->任务.值)
        && 有效(事实->已收束任务轮次.值) && 有效(事实->轮次结算.值)
        && 事实->指令 >= 自我任务后继指令::继续当前任务
        && 事实->指令 <= 自我任务后继指令::取消任务
        && 事实->来源共同事实截止 != 0 && 事实->决议规则版本 != 0
        && 事实->发生时间 != 0 && 事实->生命周期.创建事实代次 == 0
        && !事实->生命周期.退出事实代次;
}

inline 稳定编码 事实身份(const L2自我治理结构事实载荷& 载荷) noexcept {
    return std::visit([](const auto& 事实) -> 稳定编码 {
        using T = std::decay_t<decltype(事实)>;
        if constexpr (std::is_same_v<T, L2自我结果争用优先级完整事实>)
            return 事实.批次.身份.值;
        else if constexpr (std::is_same_v<T, L2自我现实执行授权事实>)
            return 事实.身份.值;
        else if constexpr (std::is_same_v<T, L2自我现实执行授权收口事实>)
            return 事实.身份.值;
        else return 事实.身份;
    }, 载荷);
}

} // namespace 海中鱼巣::L2自我治理结构内部

export namespace 海中鱼巣 {

inline std::optional<L2自我治理所有者交付> 尝试形成L2自我治理所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 自我治理所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务))
            return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2自我治理所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) { return std::nullopt; }
}

class L2自我治理结构服务 final {
public:
    explicit L2自我治理结构服务(const L1事实基座服务& 第一层服务,
        L2自我治理所有者交付&& 交付)
        : L1_(第一层服务), 第一层写入端口_(验证并移动交付(第一层服务, 交付)),
          登记_(L2自我治理结构内部::初始化结构登记(L1_, 第一层写入端口_)) {}

    L2自我治理结构服务(const L2自我治理结构服务&) = delete;
    L2自我治理结构服务& operator=(const L2自我治理结构服务&) = delete;

    L2自我治理结构提交结果 提交自我治理结构事实(
        const L2自我治理结构提交请求& 请求) noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        const auto 失败 = [&](L2结构状态 状态) {
            L2自我治理结构提交结果 结果;
            结果.结果头 = {L2结构合同版本, 状态, 0, std::nullopt};
            return 结果;
        };
        try {
            if (请求.请求头.合同版本 != L2结构合同版本
                || 请求.幂等身份.值 == 0
                || !L2自我治理结构内部::基本事实有效(请求.候选事实, 请求.种类))
                return 失败(L2结构状态::入口拒绝);

            L1所有者范围写集请求 写集;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            constexpr std::uint32_t 主节点键 = 1, 主值键 = 2;
            写集.节点.push_back({L2自我治理结构内部::键(主节点键),
                节点种类::普通, std::nullopt});

            稳定编码 属性类型;
            std::vector<std::uint64_t> 主载荷;
            if (请求.种类 == L2自我治理结构事实种类::现实执行授权) {
                属性类型 = 登记_.授权载荷;
                主载荷 = L2自我治理结构内部::编码授权(
                    std::get<L2自我现实执行授权事实>(请求.候选事实));
            } else if (请求.种类 == L2自我治理结构事实种类::现实执行授权收口) {
                属性类型 = 登记_.授权收口载荷;
                主载荷 = L2自我治理结构内部::编码授权收口(
                    std::get<L2自我现实执行授权收口事实>(请求.候选事实));
            } else if (请求.种类 == L2自我治理结构事实种类::任务后继决议) {
                属性类型 = 登记_.后继决议载荷;
                主载荷 = L2自我治理结构内部::编码后继决议(
                    std::get<L2自我任务后继决议事实>(请求.候选事实));
            } else {
                属性类型 = 登记_.优先级批次载荷;
                const auto& 完整 = std::get<L2自我结果争用优先级完整事实>(请求.候选事实);
                主载荷 = L2自我治理结构内部::编码优先级批次(完整.批次);
                if (完整.成员事实组.size() > 100000U)
                    return 失败(L2结构状态::数量预算不足);
                for (std::size_t i = 0; i < 完整.成员事实组.size(); ++i) {
                    const auto 节点键 = static_cast<std::uint32_t>(10U + i);
                    const auto 值键 = static_cast<std::uint32_t>(100010U + i);
                    const auto 关系键 = static_cast<std::uint32_t>(200010U + i);
                    写集.节点.push_back({L2自我治理结构内部::键(节点键),
                        节点种类::普通, std::nullopt});
                    写集.值.push_back({L2自我治理结构内部::键(值键),
                        L2自我治理结构内部::键(节点键), 登记_.优先级成员载荷,
                        L2自我治理结构内部::编码优先级成员(完整.成员事实组[i]),
                        L2自我治理结构内部::键(节点键)});
                    写集.属性槽变更.push_back({L2自我治理结构内部::键(节点键),
                        登记_.优先级成员载荷, L2自我治理结构内部::键(值键)});
                    写集.关系.push_back({L2自我治理结构内部::键(关系键),
                        L2自我治理结构内部::键(主节点键),
                        L2自我治理结构内部::键(节点键),
                        登记_.优先级批次成员关系, static_cast<std::int64_t>(i + 1)});
                }
            }
            写集.值.push_back({L2自我治理结构内部::键(主值键),
                L2自我治理结构内部::键(主节点键), 属性类型, std::move(主载荷),
                L2自我治理结构内部::键(主节点键)});
            写集.属性槽变更.push_back({L2自我治理结构内部::键(主节点键),
                属性类型, L2自我治理结构内部::键(主值键)});

            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2自我治理结构内部::映射写入状态(写入.状态);
            L2自我治理结构提交结果 结果;
            结果.结果头 = {L2结构合同版本, 状态, 写入.事实代次,
                (状态 == L2结构状态::已提交 || 状态 == L2结构状态::精确重复)
                    ? std::optional<std::uint64_t>{写入.事实代次} : std::nullopt};
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 结果;
            const auto 主编码 = L2自我治理结构内部::查找映射(
                写入.新编码映射, 主节点键);
            if (!主编码) {
                结果.结果头.状态 = L2结构状态::内部不一致;
                结果.结果头.变更事实代次.reset();
                结果.提交见证 = L2自我治理结构提交见证{
                    第一层写入端口_.所有者身份(), 请求.幂等身份, 写入.事实代次, 1};
                return 结果;
            }
            const auto 读回 = 读取自我治理结构事实_已锁定(
                {1, 提取自我(请求.候选事实), 请求.种类, *主编码, 写入.事实代次});
            if (!读回.成功()) {
                结果.结果头.状态 = L2结构状态::内部不一致;
                结果.结果头.变更事实代次.reset();
                结果.提交见证 = L2自我治理结构提交见证{
                    第一层写入端口_.所有者身份(), 请求.幂等身份, 写入.事实代次, 1};
                return 结果;
            }
            结果.事实 = 读回.事实;
            结果.本次正式读回截止 = 读回.本次正式读回截止;
            return 结果;
        } catch (const std::bad_alloc&) { return 失败(L2结构状态::资源失败); }
        catch (const std::length_error&) { return 失败(L2结构状态::资源失败); }
        catch (...) { return 失败(L2结构状态::内部不一致); }
    }

    L2自我治理结构读取结果 读取自我治理结构事实(
        const L2自我治理结构读取请求& 请求) const noexcept {
        std::lock_guard<std::mutex> 锁(互斥体_);
        return 读取自我治理结构事实_已锁定(请求);
    }

private:
    static L2存在身份 提取自我(const L2自我治理结构事实载荷& 载荷) noexcept {
        return std::visit([](const auto& 事实) -> L2存在身份 {
            using T = std::decay_t<decltype(事实)>;
            if constexpr (std::is_same_v<T, L2自我结果争用优先级完整事实>)
                return 事实.批次.自我;
            else if constexpr (std::is_same_v<T, L2自我现实执行授权事实>
                || std::is_same_v<T, L2自我任务后继决议事实>)
                return 事实.自我;
            else return L2存在身份{稳定编码{}};
        }, 载荷);
    }

    std::optional<std::pair<L1所有者范围节点事实, std::vector<std::uint64_t>>>
    读取节点载荷(稳定编码 身份, 稳定编码 属性类型,
        std::uint64_t 截止) const {
        const auto 节点读 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 身份});
        if (节点读.状态 != L1所有者范围读取状态::成功 || !节点读.事实)
            return std::nullopt;
        const auto* 节点 = std::get_if<L1所有者范围节点事实>(&*节点读.事实);
        if (!节点 || 节点->写入所有者 != 第一层写入端口_.所有者身份()
            || 节点->创建事实代次 == 0 || 节点->创建事实代次 > 截止
            || (节点->退出事实代次 && *节点->退出事实代次 <= 截止))
            return std::nullopt;
        const auto 值组 = L1_.读取所有者范围历史属性值组(
            {L1所有者范围CRUD合同版本, 身份, 截止});
        if (值组.状态 != L1所有者范围读取状态::成功) return std::nullopt;
        const L1所有者范围值事实* 命中 = nullptr;
        for (const auto& 值 : 值组.属性值组) {
            if (值.写入所有者 == 第一层写入端口_.所有者身份()
                && 值.属性类型节点 == 属性类型 && !值.退出事实代次) {
                if (命中) return std::nullopt;
                命中 = &值;
            }
        }
        if (!命中) return std::nullopt;
        const auto* 材料 = std::get_if<std::vector<std::uint64_t>>(&命中->材料);
        if (!材料) return std::nullopt;
        return std::pair{*节点, *材料};
    }

    L2自我治理结构读取结果 读取自我治理结构事实_已锁定(
        const L2自我治理结构读取请求& 请求) const noexcept {
        L2自我治理结构读取结果 结果;
        const auto 失败 = [&](L2结构状态 状态) {
            L2自我治理结构读取结果 失败结果;
            失败结果.结果头 = {L2结构合同版本, 状态, 0, std::nullopt};
            return 失败结果;
        };
        try {
            if (请求.合同版本 != 1 || !有效(请求.自我.值)
                || !有效(请求.事实身份) || 请求.非零读取截止 == 0)
                return 失败(L2结构状态::入口拒绝);
            稳定编码 属性类型;
            if (请求.种类 == L2自我治理结构事实种类::现实执行授权)
                属性类型 = 登记_.授权载荷;
            else if (请求.种类 == L2自我治理结构事实种类::现实执行授权收口)
                属性类型 = 登记_.授权收口载荷;
            else if (请求.种类 == L2自我治理结构事实种类::结果争用优先级批次)
                属性类型 = 登记_.优先级批次载荷;
            else if (请求.种类 == L2自我治理结构事实种类::任务后继决议)
                属性类型 = 登记_.后继决议载荷;
            else return 失败(L2结构状态::入口拒绝);
            const auto 节点载荷 = 读取节点载荷(请求.事实身份, 属性类型,
                请求.非零读取截止);
            if (!节点载荷) return 失败(L2结构状态::未找到);
            const auto& [节点, 材料] = *节点载荷;
            if (请求.种类 == L2自我治理结构事实种类::现实执行授权) {
                L2自我现实执行授权事实 事实;
                if (!L2自我治理结构内部::解码授权(材料, 事实))
                    return 失败(L2结构状态::内部不一致);
                事实.身份 = L2自我现实执行授权身份{节点.编码};
                事实.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
                if (事实.自我 != 请求.自我) return 失败(L2结构状态::引用冲突);
                结果.事实 = std::move(事实);
            } else if (请求.种类 == L2自我治理结构事实种类::现实执行授权收口) {
                L2自我现实执行授权收口事实 事实;
                if (!L2自我治理结构内部::解码授权收口(材料, 事实))
                    return 失败(L2结构状态::内部不一致);
                事实.身份 = L2自我现实执行授权收口身份{节点.编码};
                事实.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
                结果.事实 = std::move(事实);
            } else if (请求.种类 == L2自我治理结构事实种类::任务后继决议) {
                L2自我任务后继决议事实 事实;
                if (!L2自我治理结构内部::解码后继决议(材料, 事实))
                    return 失败(L2结构状态::内部不一致);
                事实.身份 = 节点.编码;
                事实.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
                if (事实.自我 != 请求.自我) return 失败(L2结构状态::引用冲突);
                结果.事实 = std::move(事实);
            } else {
                L2自我结果争用优先级完整事实 完整;
                if (!L2自我治理结构内部::解码优先级批次(材料, 完整.批次))
                    return 失败(L2结构状态::内部不一致);
                完整.批次.身份 = L2自我结果争用优先级批次身份{节点.编码};
                完整.批次.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
                if (完整.批次.自我 != 请求.自我) return 失败(L2结构状态::引用冲突);
                const auto 关系组 = L1_.读取所有者范围历史关系组(
                    {L1所有者范围CRUD合同版本,
                        L1所有者范围关系端点方向::源, 节点.编码,
                        登记_.优先级批次成员关系, 请求.非零读取截止});
                if (关系组.状态 != L1所有者范围读取状态::成功
                    || 关系组.关系组.empty()) return 失败(L2结构状态::内部不一致);
                auto 关系 = 关系组.关系组;
                std::sort(关系.begin(), 关系.end(), [](const auto& 左, const auto& 右) {
                    return 左.角色或顺序 < 右.角色或顺序;
                });
                for (std::size_t i = 0; i < 关系.size(); ++i) {
                    if (关系[i].写入所有者 != 第一层写入端口_.所有者身份()
                        || 关系[i].角色或顺序 != static_cast<std::int64_t>(i + 1)
                        || 关系[i].源节点 != 节点.编码 || 关系[i].退出事实代次)
                        return 失败(L2结构状态::内部不一致);
                    const auto 成员载荷 = 读取节点载荷(关系[i].目标节点,
                        登记_.优先级成员载荷, 请求.非零读取截止);
                    if (!成员载荷) return 失败(L2结构状态::内部不一致);
                    自我结果争用成员优先级事实 成员;
                    if (!L2自我治理结构内部::解码优先级成员(成员载荷->second, 成员))
                        return 失败(L2结构状态::内部不一致);
                    成员.身份 = L2自我结果争用成员优先级身份{成员载荷->first.编码};
                    成员.批次 = 完整.批次.身份;
                    成员.生命周期 = {成员载荷->first.创建事实代次,
                        成员载荷->first.退出事实代次};
                    完整.批次.成员优先级.push_back(成员.身份);
                    完整.成员事实组.push_back(std::move(成员));
                }
                结果.事实 = std::move(完整);
            }
            结果.结果头 = {L2结构合同版本, L2结构状态::已读取,
                请求.非零读取截止, std::nullopt};
            结果.本次正式读回截止 = 请求.非零读取截止;
            return 结果;
        } catch (const std::bad_alloc&) { return 失败(L2结构状态::资源失败); }
        catch (const std::length_error&) { return 失败(L2结构状态::资源失败); }
        catch (...) { return 失败(L2结构状态::内部不一致); }
    }

    static L1所有者范围写端口 验证并移动交付(
        const L1事实基座服务& 第一层服务,
        L2自我治理所有者交付& 交付) {
        if (!交付.有效() || !交付.绑定于(第一层服务))
            throw std::runtime_error("L2 self governance owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    const L1事实基座服务& L1_;
    L1所有者范围写端口 第一层写入端口_;
    L2自我治理结构内部::结构登记定位 登记_;
    mutable std::mutex 互斥体_;
};

} // namespace 海中鱼巣
