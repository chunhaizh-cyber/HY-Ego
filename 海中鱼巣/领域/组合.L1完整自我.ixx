module;

#include <cstddef>
#include <cstdint>
#include <mutex>
#include <new>
#include <optional>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.组合.L1完整自我;

export import 海中鱼巣.领域.数据操作.L1完整自我发布;
import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1实际存在;
import 海中鱼巣.领域.服务.L1自我结构登记;

namespace 海中鱼巣::L1完整自我组合内部 {

完整自我状态 映射世界登记状态(世界登记状态 状态) noexcept {
    switch (状态) {
    case 世界登记状态::登记未加载: return 完整自我状态::前置不满足;
    case 世界登记状态::入口拒绝: return 完整自我状态::入口拒绝;
    case 世界登记状态::事实代次漂移: return 完整自我状态::事实代次漂移;
    case 世界登记状态::许可拒绝: return 完整自我状态::许可拒绝;
    case 世界登记状态::资源失败: return 完整自我状态::资源失败;
    case 世界登记状态::已提交:
    case 世界登记状态::幂等读回:
    case 世界登记状态::已读取:
    case 世界登记状态::幂等冲突:
    case 世界登记状态::内部不一致:
        return 完整自我状态::内部不一致;
    }
    return 完整自我状态::内部不一致;
}

完整自我状态 映射实际存在状态(实际存在状态 状态) noexcept {
    switch (状态) {
    case 实际存在状态::未找到: return 完整自我状态::前置不满足;
    case 实际存在状态::入口拒绝: return 完整自我状态::入口拒绝;
    case 实际存在状态::版本漂移: return 完整自我状态::事实代次漂移;
    case 实际存在状态::许可拒绝: return 完整自我状态::许可拒绝;
    case 实际存在状态::资源失败: return 完整自我状态::资源失败;
    case 实际存在状态::已提交:
    case 实际存在状态::幂等读回:
    case 实际存在状态::已读取:
    case 实际存在状态::幂等冲突:
    case 实际存在状态::内部不一致:
        return 完整自我状态::内部不一致;
    }
    return 完整自我状态::内部不一致;
}

完整自我状态 映射自我结构登记状态(自我结构登记状态 状态) noexcept {
    switch (状态) {
    case 自我结构登记状态::登记未加载: return 完整自我状态::前置不满足;
    case 自我结构登记状态::入口拒绝: return 完整自我状态::入口拒绝;
    case 自我结构登记状态::事实代次漂移: return 完整自我状态::事实代次漂移;
    case 自我结构登记状态::许可拒绝: return 完整自我状态::许可拒绝;
    case 自我结构登记状态::资源失败: return 完整自我状态::资源失败;
    case 自我结构登记状态::已提交:
    case 自我结构登记状态::幂等读回:
    case 自我结构登记状态::已读取:
    case 自我结构登记状态::幂等冲突:
    case 自我结构登记状态::内部不一致:
        return 完整自我状态::内部不一致;
    }
    return 完整自我状态::内部不一致;
}

完整自我状态 映射存在准入状态(完整自我存在准入状态 状态) noexcept {
    switch (状态) {
    case 完整自我存在准入状态::入口拒绝: return 完整自我状态::入口拒绝;
    case 完整自我存在准入状态::事实代次漂移: return 完整自我状态::事实代次漂移;
    case 完整自我存在准入状态::已批准:
    case 完整自我存在准入状态::内部不一致:
        return 完整自我状态::内部不一致;
    }
    return 完整自我状态::内部不一致;
}

完整自我状态 映射场景准入状态(完整自我场景准入状态 状态) noexcept {
    switch (状态) {
    case 完整自我场景准入状态::入口拒绝: return 完整自我状态::入口拒绝;
    case 完整自我场景准入状态::出生期成员不合格:
        return 完整自我状态::前置不满足;
    case 完整自我场景准入状态::事实代次漂移:
        return 完整自我状态::事实代次漂移;
    case 完整自我场景准入状态::资源失败: return 完整自我状态::资源失败;
    case 完整自我场景准入状态::已批准:
    case 完整自我场景准入状态::内部不一致:
        return 完整自我状态::内部不一致;
    }
    return 完整自我状态::内部不一致;
}

bool 两域规格互证(const 完整自我存在准入规格& 存在,
    const 完整自我场景准入规格& 场景) noexcept {
    return 完整自我存在准入规格完整(存在) && 完整自我场景准入规格完整(场景)
        && 存在.合同版本 == 场景.合同版本 && 存在.规则版本 == 场景.规则版本
        && 存在.共同事实截止代次 == 场景.共同事实截止代次
        && 存在.世界根 == 场景.世界根
        && 存在.自我结构登记服务 == 场景.自我结构登记服务
        && 存在.自我结构关系类型 == 场景.自我结构关系类型
        && 存在.自我存在角色 == 场景.自我存在角色
        && 存在.自我内部世界场景角色 == 场景.自我内部世界场景角色
        && 存在.自我存在节点键 == 场景.自我存在节点键
        && 存在.自我内部世界场景节点键 == 场景.自我内部世界场景节点键;
}

} // namespace 海中鱼巣::L1完整自我组合内部

export namespace 海中鱼巣 {

class L1完整自我组合服务 final {
public:
    L1完整自我组合服务(世界登记服务& 世界登记,
        L1实际存在服务& 实际存在,
        L1自我结构登记服务& 自我结构登记,
        L1完整自我存在准入服务& 存在准入,
        L1完整自我场景准入服务& 场景准入,
        L1完整自我发布数据操作& 数据操作) noexcept
        : 世界登记_(世界登记), 实际存在_(实际存在), 自我结构登记_(自我结构登记),
          存在准入_(存在准入), 场景准入_(场景准入), 数据操作_(数据操作) {}
    L1完整自我组合服务() = delete;
    L1完整自我组合服务(const L1完整自我组合服务&) = delete;
    L1完整自我组合服务& operator=(const L1完整自我组合服务&) = delete;
    L1完整自我组合服务(L1完整自我组合服务&&) = delete;
    L1完整自我组合服务& operator=(L1完整自我组合服务&&) = delete;

    // 诊断责任：向上送出；跨域拒绝、漂移和发布结果均结构化返回运行期边界。
    完整自我结果 发布完整自我(const 完整自我发布请求& 请求) {
        if (!完整自我发布请求有效(请求)) return {};
        std::lock_guard<std::mutex> 锁(锁_);
        auto 已有 = 数据操作_.尝试收敛已有完整自我(请求);
        if (已有.状态 != 完整自我状态::尚无完整自我) return 已有;
        try {
            const auto 世界结果 = 世界登记_.读取当前登记();
            if (世界结果.状态 != 世界登记状态::已读取 || !世界结果.登记
                || !世界结构登记完整(*世界结果.登记)) {
                return {L1完整自我组合内部::映射世界登记状态(世界结果.状态),
                    请求.幂等身份, false, std::nullopt};
            }
            const auto 自我结构结果 = 自我结构登记_.读取当前登记();
            if (自我结构结果.状态 != 自我结构登记状态::已读取
                || !自我结构结果.登记
                || !自我结构关系登记完整(*自我结构结果.登记)) {
                return {L1完整自我组合内部::映射自我结构登记状态(
                    自我结构结果.状态), 请求.幂等身份, false, std::nullopt};
            }
            const 实际存在写入规格请求 规格请求{
                L1实际存在合同版本, L1实际存在规则版本, 请求.期望事实代次};
            const auto 实际存在规格结果 = 实际存在_.形成实际存在写入规格(规格请求);
            if (实际存在规格结果.状态 != 实际存在状态::已读取
                || !实际存在规格结果.规格
                || !实际存在写入规格完整(*实际存在规格结果.规格)) {
                return {L1完整自我组合内部::映射实际存在状态(
                    实际存在规格结果.状态), 请求.幂等身份, false, std::nullopt};
            }
            if (世界结果.登记->已验证事实代次 != 请求.期望事实代次
                || 自我结构结果.登记->事实截止代次 != 请求.期望事实代次
                || 实际存在规格结果.规格->事实截止代次 != 请求.期望事实代次) {
                return {完整自我状态::事实代次漂移, 请求.幂等身份,
                    false, std::nullopt};
            }

            std::vector<实际存在资格事实> 成员资格组;
            成员资格组.reserve(请求.出生期成员稳定编码组.size());
            for (const auto 成员编码 : 请求.出生期成员稳定编码组) {
                const 实际存在资格定位读取请求 资格请求{
                    L1实际存在合同版本, L1实际存在规则版本, 成员编码};
                const auto 资格结果 = 实际存在_.读取当前实际存在资格(资格请求);
                if (资格结果.状态 != 实际存在状态::已读取 || !资格结果.事实
                    || !实际存在资格事实完整(*资格结果.事实)) {
                    return {L1完整自我组合内部::映射实际存在状态(资格结果.状态),
                        请求.幂等身份, false, std::nullopt};
                }
                if (资格结果.事实->事实截止代次 != 请求.期望事实代次
                    || 资格结果.事实->存在.编码 != 成员编码
                    || 资格结果.事实->资格.I64值 != 实际存在资格值) {
                    return {完整自我状态::事实代次漂移, 请求.幂等身份,
                        false, std::nullopt};
                }
                成员资格组.push_back(*资格结果.事实);
            }

            const 完整自我存在准入请求 存在请求{
                L1完整自我合同版本, L1完整自我规则版本, 请求.期望事实代次,
                *世界结果.登记, *实际存在规格结果.规格, *自我结构结果.登记};
            const auto 存在结果 = 存在准入_.形成完整自我存在准入(存在请求);
            if (!存在结果.成功() || !存在结果.规格) {
                return {L1完整自我组合内部::映射存在准入状态(存在结果.状态),
                    请求.幂等身份, false, std::nullopt};
            }
            const 完整自我场景准入请求 场景请求{
                L1完整自我合同版本, L1完整自我规则版本, 请求.期望事实代次,
                *世界结果.登记, *实际存在规格结果.规格, *自我结构结果.登记,
                std::move(成员资格组)};
            const auto 场景结果 = 场景准入_.形成完整自我场景准入(场景请求);
            if (!场景结果.成功() || !场景结果.规格) {
                return {L1完整自我组合内部::映射场景准入状态(场景结果.状态),
                    请求.幂等身份, false, std::nullopt};
            }
            if (!L1完整自我组合内部::两域规格互证(
                    *存在结果.规格, *场景结果.规格)
                || 场景结果.规格->出生期成员资格组.size()
                    != 请求.出生期成员稳定编码组.size()) {
                return {完整自我状态::内部不一致, 请求.幂等身份,
                    false, std::nullopt};
            }
            return 数据操作_.提交完整自我(
                请求, *存在结果.规格, *场景结果.规格);
        } catch (const std::bad_alloc&) {
            return {完整自我状态::资源失败, 请求.幂等身份,
                false, std::nullopt};
        } catch (...) {
            return {完整自我状态::内部不一致, 请求.幂等身份,
                false, std::nullopt};
        }
    }

    // 诊断责任：向上送出；只转发唯一数据操作的正式当前读回。
    完整自我结果 读取当前完整自我() const {
        std::lock_guard<std::mutex> 锁(锁_);
        auto 结果 = 数据操作_.读取当前完整自我();
        if (结果.状态 == 完整自我状态::已读取 && !完整自我结果完整(结果))
            return {完整自我状态::内部不一致, 结果.首次幂等身份,
                结果.L1发布已存在, std::nullopt};
        return 结果;
    }

private:
    世界登记服务& 世界登记_;
    L1实际存在服务& 实际存在_;
    L1自我结构登记服务& 自我结构登记_;
    L1完整自我存在准入服务& 存在准入_;
    L1完整自我场景准入服务& 场景准入_;
    L1完整自我发布数据操作& 数据操作_;
    mutable std::mutex 锁_;
};

} // namespace 海中鱼巣
