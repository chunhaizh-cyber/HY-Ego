inline std::optional<本能被动维护游标事实_v4> 解码游标_v4(
    const L1所有者范围值事实& 值,
    const 登记定位& 定位,
    L1结构所有者身份 所有者) noexcept {
    const auto* 材料 = std::get_if<std::vector<std::uint64_t>>(&值.材料);
    if (!材料 || 材料->size() != 11
        || 值.写入所有者 != 所有者 || 值.所属节点 != 定位.当前游标节点
        || 值.属性类型节点 != 定位.当前游标属性类型
        || 值.来源节点 != 定位.登记锚点
        || 值.创建事实代次 == 0 || 值.退出事实代次
        || (*材料)[0] == 0 || (*材料)[1] == 0 || (*材料)[2] == 0
        || (*材料)[3] == 0
        || (*材料)[4] > static_cast<std::uint64_t>(INT64_MAX)
        || (*材料)[5] == 0 || (*材料)[6] == 0 || (*材料)[7] == 0
        || (*材料)[6] < (*材料)[7]
        || (*材料)[9] == 0 || (*材料)[9] > UINT32_MAX
        || (*材料)[10] == 0 || (*材料)[10] > UINT32_MAX)
        return std::nullopt;
    本能被动维护游标事实_v4 游标;
    游标.自我 = L2存在身份{稳定编码{(*材料)[0]}};
    游标.运行代次 = (*材料)[1];
    游标.时间纪元身份 = (*材料)[2];
    游标.维护纪元身份 = (*材料)[3];
    游标.上一已维护完整秒边界 = static_cast<std::int64_t>((*材料)[4]);
    游标.已消费主动安全变化事实代次 = (*材料)[5];
    游标.已消费服务维护历史事实代次 = (*材料)[6];
    游标.服务历史v2覆盖种子事实代次 = (*材料)[7];
    游标.成功维护提交序号 = (*材料)[8];
    游标.时间源版本 = static_cast<std::uint32_t>((*材料)[9]);
    游标.服务时间维护规则版本 = static_cast<std::uint32_t>((*材料)[10]);
    游标.形成事实代次 = 值.创建事实代次;
    return 本能被动维护游标事实完整_v4(游标)
        ? std::optional<本能被动维护游标事实_v4>{游标}
        : std::nullopt;
}

} // namespace 海中鱼巣::本能被动维护游标内部

export namespace 海中鱼巣 {

class 本能被动维护游标服务;

class 本能被动维护游标所有者交付 final {
public:
    本能被动维护游标所有者交付() = delete;
    本能被动维护游标所有者交付(
        const 本能被动维护游标所有者交付&) = delete;
    本能被动维护游标所有者交付& operator=(
        const 本能被动维护游标所有者交付&) = delete;
    本能被动维护游标所有者交付(
        本能被动维护游标所有者交付&&) noexcept = default;
    本能被动维护游标所有者交付& operator=(
        本能被动维护游标所有者交付&&) = delete;

private:
    本能被动维护游标所有者交付(
        L1结构所有者事实 所有者事实,
        L1所有者范围写端口&& 写入端口) noexcept
        : 所有者事实_(所有者事实), 写入端口_(std::move(写入端口)) {}

    L1结构所有者事实 所有者事实_{};
    L1所有者范围写端口 写入端口_;

    friend std::optional<本能被动维护游标所有者交付>
    尝试形成本能被动维护游标所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class 本能被动维护游标服务;
};

std::optional<本能被动维护游标所有者交付>
尝试形成本能被动维护游标所有者交付(
    const L1事实基座服务& 第一层服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        if (!原始交付.建立结果.所有者事实 || !原始交付.写入端口)
            return std::nullopt;
        const auto& 建立 = 原始交付.建立结果;
        const auto& 事实 = *原始交付.建立结果.所有者事实;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份
                != 本能被动维护游标所有者建立身份_v1
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !有效(事实.所有者) || 事实.退出事实代次
            || 事实.范围种类 != L1所有者范围种类::独占结构范围
            || 原始交付.写入端口->所有者身份() != 事实.所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层服务))
            return std::nullopt;
        const auto 当前 = 第一层服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 事实.所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 事实.所有者
            || !当前.所有者事实 || *当前.所有者事实 != 事实)
            return std::nullopt;
        return 本能被动维护游标所有者交付{
            事实, std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class 本能被动维护游标服务 final {
public:
    本能被动维护游标服务() = delete;
    本能被动维护游标服务(const 本能被动维护游标服务&) = delete;
