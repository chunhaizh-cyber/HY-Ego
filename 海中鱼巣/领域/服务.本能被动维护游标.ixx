namespace 海中鱼巣::本能被动维护游标内部 {

inline constexpr L1所有者范围写入幂等身份 登记写入幂等身份{
    0x494E'5354'4355'5201ULL};
inline constexpr L1所有者范围写集本地键 登记锚点键{0x0307'1001U};
inline constexpr L1所有者范围写集本地键 当前游标节点键{0x0307'1002U};
inline constexpr L1所有者范围写集本地键 当前游标属性类型键{0x0307'1003U};
inline constexpr L1所有者范围写集本地键 游标值键{0x0307'1004U};

struct 登记定位 final {
    稳定编码 登记锚点{};
    稳定编码 当前游标节点{};
    稳定编码 当前游标属性类型{};

    bool 完整() const noexcept {
        return 有效(登记锚点) && 有效(当前游标节点)
            && 有效(当前游标属性类型)
            && 登记锚点 != 当前游标节点
            && 登记锚点 != 当前游标属性类型
            && 当前游标节点 != 当前游标属性类型;
    }
};

inline std::optional<稳定编码> 查找映射(
    const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 键) noexcept {
    std::optional<稳定编码> 命中;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键 != 键) continue;
        if (命中) return std::nullopt;
        命中 = 编码;
    }
    return 命中;
}

inline std::optional<登记定位> 投影登记定位(
    const L1所有者范围首次写入读取结果& 首次,
    L1结构所有者身份 所有者) noexcept {
    if (首次.状态 != L1所有者范围读取状态::成功
        || 首次.合同版本 != L1所有者范围首次写入读取合同版本
        || 首次.所有者 != 所有者
        || 首次.写入幂等身份 != 登记写入幂等身份
        || !首次.首次规范化写集 || !首次.首次写入结果)
        return std::nullopt;
    const auto& 请求 = *首次.首次规范化写集;
    const auto& 结果 = *首次.首次写入结果;
    if (请求.合同版本 != L1所有者范围CRUD合同版本
        || 请求.写入幂等身份 != 登记写入幂等身份
        || 请求.节点.size() != 3 || !请求.关系.empty()
        || !请求.值.empty() || !请求.属性槽变更.empty()
        || !请求.退出事实.empty()
        || 结果.状态 != L1所有者范围写入状态::成功
        || 结果.合同版本 != L1所有者范围CRUD合同版本
        || 结果.所有者 != 所有者
        || 结果.写入幂等身份 != 登记写入幂等身份
        || 结果.事实代次 == 0 || !结果.是否形成内存权威发布)
        return std::nullopt;
    if (请求.节点[0] != L1所有者范围节点新建项{
            登记锚点键, 节点种类::普通, std::nullopt}
        || 请求.节点[1] != L1所有者范围节点新建项{
            当前游标节点键, 节点种类::普通, std::nullopt}
        || 请求.节点[2] != L1所有者范围节点新建项{
            当前游标属性类型键, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组})
        return std::nullopt;
    const auto 锚点 = 查找映射(结果, 登记锚点键);
    const auto 游标节点 = 查找映射(结果, 当前游标节点键);
    const auto 属性类型 = 查找映射(结果, 当前游标属性类型键);
    if (!锚点 || !游标节点 || !属性类型) return std::nullopt;
    登记定位 定位{*锚点, *游标节点, *属性类型};
    return 定位.完整() ? std::optional<登记定位>{定位} : std::nullopt;
}

inline std::vector<std::uint64_t> 编码游标(
    const 建立或恢复本能被动维护游标请求_v1& 请求) {
    return {请求.本能根锚点.唯一自我.值.值,
        请求.运行代次, 请求.时间纪元身份,
        static_cast<std::uint64_t>(请求.当前完整秒边界),
        请求.时间源版本, 请求.服务时间维护规则版本};
}

inline std::vector<std::uint64_t> 编码游标(
    const 建立或恢复本能被动维护游标请求_v2& 请求) {
    return {请求.本能根锚点.唯一自我.值.值,
        请求.运行代次, 请求.时间纪元身份,
        static_cast<std::uint64_t>(请求.当前完整秒边界),
        请求.目标已消费主动安全变化事实代次,
        请求.时间源版本, 请求.服务时间维护规则版本};
}

inline std::vector<std::uint64_t> 编码游标(
    const 建立或恢复本能被动维护游标请求_v3& 请求) {
    return {请求.本能根锚点.唯一自我.值.值,
        请求.运行代次, 请求.时间纪元身份,
        static_cast<std::uint64_t>(请求.当前完整秒边界),
        请求.目标已消费主动安全变化事实代次,
        请求.目标已消费服务维护历史事实代次,
        请求.时间源版本, 请求.服务时间维护规则版本};
}

inline std::vector<std::uint64_t> 编码游标_v4(
    const 显式激活或恢复本能被动维护纪元请求_v1& 请求) {
    const auto Gseed = 请求.服务历史v2边界见证.快照->v2覆盖登记事实代次;
    return {请求.本能根锚点.唯一自我.值.值,
        请求.运行代次, 请求.时间纪元身份, 请求.幂等身份.值,
        static_cast<std::uint64_t>(请求.当前完整秒边界),
        请求.主动安全变化账登记见证.首次登记事实代次,
        Gseed, Gseed, 0,
        请求.时间源版本, 请求.服务时间维护规则版本};
}

inline std::optional<本能被动维护游标事实_v1> 解码游标(
    const L1所有者范围值事实& 值,
    const 登记定位& 定位,
    L1结构所有者身份 所有者) noexcept {
    const auto* 材料 = std::get_if<std::vector<std::uint64_t>>(&值.材料);
    if (!材料 || (材料->size() != 6 && 材料->size() != 7
            && 材料->size() != 8 && 材料->size() != 11)
        || 值.写入所有者 != 所有者 || 值.所属节点 != 定位.当前游标节点
        || 值.属性类型节点 != 定位.当前游标属性类型
        || 值.来源节点 != 定位.登记锚点
        || 值.创建事实代次 == 0 || 值.退出事实代次
        || (*材料)[0] == 0 || (*材料)[1] == 0 || (*材料)[2] == 0
        || (*材料)[材料->size() == 11 ? 4 : 3]
            > static_cast<std::uint64_t>(INT64_MAX)
        || (*材料)[材料->size() - 2] == 0
        || (*材料)[材料->size() - 2] > UINT32_MAX
        || (*材料)[材料->size() - 1] == 0
        || (*材料)[材料->size() - 1] > UINT32_MAX)
        return std::nullopt;
    本能被动维护游标事实_v1 游标;
    游标.自我 = L2存在身份{稳定编码{(*材料)[0]}};
    游标.运行代次 = (*材料)[1];
    游标.时间纪元身份 = (*材料)[2];
    游标.上一已维护完整秒边界 = static_cast<std::int64_t>(
        (*材料)[材料->size() == 11 ? 4 : 3]);
    const auto 版本偏移 = 材料->size() - 2;
    游标.时间源版本 = static_cast<std::uint32_t>((*材料)[版本偏移]);
    游标.服务时间维护规则版本 =
        static_cast<std::uint32_t>((*材料)[版本偏移 + 1]);
    游标.形成事实代次 = 值.创建事实代次;
    return 本能被动维护游标事实完整_v1(游标)
        ? std::optional<本能被动维护游标事实_v1>{游标}
        : std::nullopt;
}

