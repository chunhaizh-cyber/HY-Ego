                : 迁移 ? 本能被动维护游标建立状态_v2::已迁移
                    : 本能被动维护游标建立状态_v2::已建立;
            结果.幂等身份 = 请求.幂等身份;
            结果.提交游标 = *正式.游标;
            结果.首次提交事实代次 = 写入.事实代次;
            结果.本次正式读回截止 = 正式.本次正式读回截止;
            return 结果.成功() ? 结果
                : 失败(本能被动维护游标建立状态_v2::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(本能被动维护游标建立状态_v2::资源失败);
        } catch (const std::length_error&) {
            return 失败(本能被动维护游标建立状态_v2::资源失败);
        } catch (...) {
            return 失败(本能被动维护游标建立状态_v2::内部错误);
        }
    }

    本能被动维护游标建立结果_v3 建立或恢复本能被动维护游标_v3(
        const 建立或恢复本能被动维护游标请求_v3& 请求) noexcept {
        using 建立状态 = 本能被动维护游标建立状态_v3;
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        const auto 失败 = [&](建立状态 状态, std::uint64_t 首次提交 = 0) {
            本能被动维护游标建立结果_v3 结果;
            结果.状态 = 状态;
            结果.幂等身份 = 请求.幂等身份;
            结果.首次提交事实代次 = 首次提交;
            return 结果;
        };
        if (!请求有效(请求)) return 失败(建立状态::入口拒绝);
        try {
            const auto 目标材料 = 本能被动维护游标内部::编码游标(请求);
            const auto 重放 = 写入端口_.读取首次写入材料({
                L1所有者范围首次写入读取合同版本, {请求.幂等身份.值}});
            if (重放.状态 == L1所有者范围读取状态::成功) {
                if (!重放.首次规范化写集 || !重放.首次写入结果
                    || 重放.首次写入结果->事实代次 == 0)
                    return 失败(建立状态::内部错误);
                const auto* 首次材料 = 重放游标材料(*重放.首次规范化写集);
                if (!首次材料 || *首次材料 != 目标材料)
                    return 失败(建立状态::幂等冲突);
                const auto 当前G = 读取当前代次();
                if (!当前G) return 失败(建立状态::内部错误);
                本能被动维护游标事实_v3 首次游标{
                    请求.本能根锚点.唯一自我, 请求.运行代次,
                    请求.时间纪元身份, 请求.当前完整秒边界,
                    请求.目标已消费主动安全变化事实代次,
                    请求.目标已消费服务维护历史事实代次,
                    请求.时间源版本, 请求.服务时间维护规则版本,
                    重放.首次写入结果->事实代次};
                本能被动维护游标建立结果_v3 结果;
                结果.状态 = 建立状态::精确重复;
                结果.幂等身份 = 请求.幂等身份;
                结果.提交游标 = 首次游标;
                结果.首次提交事实代次 = 首次游标.形成事实代次;
                结果.本次正式读回截止 = *当前G;
                return 结果.成功() ? 结果 : 失败(建立状态::内部错误);
            }
            if (重放.状态 != L1所有者范围读取状态::未找到)
                return 失败(映射首次读取失败_v3(重放.状态));

            const auto G0 = 读取当前代次();
            if (!G0 || *G0 != 请求.请求头.期望事实代次)
                return 失败(建立状态::当前性漂移);
            建立或恢复本能被动维护游标请求_v1 v1绑定请求{
                本能被动维护游标合同版本_v1, 请求.请求头,
                请求.幂等身份, 请求.本能根锚点, 请求.运行代次,
                请求.时间纪元身份, 请求.当前完整秒边界,
                请求.时间源版本, 请求.服务时间维护规则版本};
            if (!锚点绑定有效(v1绑定请求, *G0))
                return 失败(建立状态::引用冲突);
            const auto 登记状态 = 确保登记(*G0);
            if (登记状态 != 本能被动维护游标建立状态_v1::已恢复)
                return 失败(映射v1建立状态_v3(登记状态));

            const auto 当前G = 读取当前代次();
            if (!当前G) return 失败(建立状态::内部错误);
            const auto 当前v3 = 读取当前本能被动维护游标_v3({
                本能被动维护游标合同版本_v3,
                {L2结构合同版本, *当前G}, 请求.本能根锚点.唯一自我});
            bool 新纪元 = false;
            bool 迁移 = false;
            if (当前v3.成功()) {
                const auto& 当前 = *当前v3.游标;
                if (游标等于请求(当前, 请求)) {
                    本能被动维护游标建立结果_v3 结果;
                    结果.状态 = 建立状态::已恢复;
                    结果.幂等身份 = 请求.幂等身份;
                    结果.提交游标 = 当前;
                    结果.首次提交事实代次 = 当前.形成事实代次;
                    结果.本次正式读回截止 = 当前v3.本次正式读回截止;
                    return 结果.成功() ? 结果 : 失败(建立状态::内部错误);
                }
                const bool 运行变化 = 当前.运行代次 != 请求.运行代次;
                const bool 纪元变化 = 当前.时间纪元身份 != 请求.时间纪元身份;
                if (运行变化 != 纪元变化 || !运行变化
                    || 当前.自我 != 请求.本能根锚点.唯一自我
                    || 当前.已消费主动安全变化事实代次
                        != 请求.目标已消费主动安全变化事实代次
                    || 当前.已消费服务维护历史事实代次
                        != 请求.目标已消费服务维护历史事实代次
                    || 当前.时间源版本 != 请求.时间源版本
                    || 当前.服务时间维护规则版本
                        != 请求.服务时间维护规则版本)
                    return 失败(建立状态::引用冲突);
                新纪元 = true;
            } else if (当前v3.状态 == 本能被动维护游标读取状态_v3::待迁移) {
                const auto 当前v2 = 读取当前本能被动维护游标_v2({
                    本能被动维护游标合同版本_v2,
                    {L2结构合同版本, *当前G}, 请求.本能根锚点.唯一自我});
                if (当前v2.成功() && 当前v2.游标) {
                    const auto& 当前 = *当前v2.游标;
                    const bool 运行变化 = 当前.运行代次 != 请求.运行代次;
                    const bool 纪元变化 = 当前.时间纪元身份 != 请求.时间纪元身份;
                    if (运行变化 != 纪元变化
                        || (!运行变化 && 当前.上一已维护完整秒边界
                            != 请求.当前完整秒边界)
                        || 当前.自我 != 请求.本能根锚点.唯一自我
                        || 当前.已消费主动安全变化事实代次
                            != 请求.目标已消费主动安全变化事实代次
                        || 请求.目标已消费服务维护历史事实代次
                            != 请求.服务历史覆盖起点见证.快照->历史账登记事实代次
                        || 当前.时间源版本 != 请求.时间源版本
                        || 当前.服务时间维护规则版本
                            != 请求.服务时间维护规则版本)
                        return 失败(建立状态::引用冲突);
                    新纪元 = 运行变化 && 纪元变化;
                    迁移 = true;
                } else if (当前v2.状态 == 本能被动维护游标读取状态_v2::待迁移) {
                    const auto 当前v1 = 读取当前本能被动维护游标_v1({
                        本能被动维护游标合同版本_v1,
                        {L2结构合同版本, *当前G}, 请求.本能根锚点.唯一自我});
                    if (!当前v1.成功() || !当前v1.游标)
                        return 失败(建立状态::内部错误);
                    const auto& 当前 = *当前v1.游标;
                    const bool 运行变化 = 当前.运行代次 != 请求.运行代次;
                    const bool 纪元变化 = 当前.时间纪元身份 != 请求.时间纪元身份;
                    if (运行变化 != 纪元变化
                        || (!运行变化 && 当前.上一已维护完整秒边界
                            != 请求.当前完整秒边界)
                        || 当前.自我 != 请求.本能根锚点.唯一自我
                        || 请求.目标已消费主动安全变化事实代次
                            != 请求.变化账登记见证.首次登记事实代次
                        || 请求.目标已消费服务维护历史事实代次
                            != 请求.服务历史覆盖起点见证.快照->历史账登记事实代次
                        || 当前.时间源版本 != 请求.时间源版本
                        || 当前.服务时间维护规则版本
                            != 请求.服务时间维护规则版本)
                        return 失败(建立状态::引用冲突);
                    新纪元 = 运行变化 && 纪元变化;
                    迁移 = true;
                } else {
                    return 失败(映射读取失败_v2到v3(当前v2.状态));
                }
            } else if (当前v3.状态 == 本能被动维护游标读取状态_v3::未建立) {
                if (请求.目标已消费主动安全变化事实代次
                        != 请求.变化账登记见证.首次登记事实代次
                    || 请求.目标已消费服务维护历史事实代次
                        != 请求.服务历史覆盖起点见证.快照->历史账登记事实代次)
                    return 失败(建立状态::引用冲突);
            } else {
                return 失败(映射读取失败_v3(当前v3.状态));
            }

            const auto Gwrite = 读取当前代次();
            if (!Gwrite) return 失败(建立状态::内部错误);
            L1所有者范围写集请求 写入请求;
            写入请求.期望事实代次 = *Gwrite;
            写入请求.写入幂等身份 = {请求.幂等身份.值};
            写入请求.值 = {{本能被动维护游标内部::游标值键,
                定位_->当前游标节点, 定位_->当前游标属性类型,
                目标材料, 定位_->登记锚点}};
            写入请求.属性槽变更 = {{定位_->当前游标节点,
                定位_->当前游标属性类型,
                本能被动维护游标内部::游标值键}};
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写入请求);
            if (写入.状态 != L1所有者范围写入状态::成功
                && 写入.状态 != L1所有者范围写入状态::精确重复) {
                const auto 状态 = 映射写入失败_v3(写入);
                return 失败(状态, 状态 == 建立状态::已可能发布
                    ? 写入.事实代次 : 0);
            }
            const bool 首次发布完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布;
            const bool 重复收敛完整 =
                写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布;
            if (写入.事实代次 == 0 || (!首次发布完整 && !重复收敛完整))
                return 失败(建立状态::内部错误);
            const auto 正式 = 读取当前本能被动维护游标_v3({
                本能被动维护游标合同版本_v3,
                {L2结构合同版本, 写入.事实代次},
                请求.本能根锚点.唯一自我});
            if (!正式.成功() || !正式.游标
                || !游标等于请求(*正式.游标, 请求))
                return 失败(建立状态::已可能发布, 写入.事实代次);
            本能被动维护游标建立结果_v3 结果;
            结果.状态 = 新纪元 ? 建立状态::已建立新纪元
                : 迁移 ? 建立状态::已迁移 : 建立状态::已建立;
            结果.幂等身份 = 请求.幂等身份;
            结果.提交游标 = *正式.游标;
            结果.首次提交事实代次 = 写入.事实代次;
            结果.本次正式读回截止 = 正式.本次正式读回截止;
            return 结果.成功() ? 结果 : 失败(建立状态::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(建立状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(建立状态::资源失败);
        } catch (...) {
            return 失败(建立状态::内部错误);
        }
    }

    本能被动维护纪元激活结果_v1 显式激活或恢复本能被动维护纪元_v1(
        const 显式激活或恢复本能被动维护纪元请求_v1& 请求) noexcept {
        using 激活状态 = 本能被动维护纪元激活状态_v1;
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        const auto 失败 = [&](激活状态 状态, std::uint64_t 首次提交 = 0) {
            本能被动维护纪元激活结果_v1 结果;
            结果.状态 = 状态;
            结果.幂等身份 = 请求.幂等身份;
            结果.首次提交事实代次 = 首次提交;
            return 结果;
        };
        if (!请求有效(请求)) return 失败(激活状态::入口拒绝);
        try {
            const auto 目标材料 = 本能被动维护游标内部::编码游标_v4(请求);
            const auto 重放 = 写入端口_.读取首次写入材料({
                L1所有者范围首次写入读取合同版本, {请求.幂等身份.值}});
            if (重放.状态 == L1所有者范围读取状态::成功) {
                if (!重放.首次规范化写集 || !重放.首次写入结果
                    || 重放.首次写入结果->事实代次 == 0)
                    return 失败(激活状态::内部错误);
                const auto* 首次材料 = 重放游标材料(*重放.首次规范化写集);
                if (!首次材料 || *首次材料 != 目标材料)
                    return 失败(激活状态::幂等冲突);
                const auto 当前G = 读取当前代次();
                if (!当前G) return 失败(激活状态::内部错误);
                const auto 当前 = 读取当前本能被动维护游标_v4({
                    本能被动维护游标合同版本_v4,
                    {L2结构合同版本, *当前G}, 请求.本能根锚点.唯一自我});
                const auto 首次游标 = 形成v4游标(
                    请求, 重放.首次写入结果->事实代次);
                if (!当前.成功() || !当前.游标 || *当前.游标 != 首次游标)
                    return 失败(激活状态::已可能发布,
                        重放.首次写入结果->事实代次);
                return 形成激活成功结果(激活状态::精确重复, 请求,
                    首次游标, 重放.首次写入结果->事实代次,
                    当前.本次正式读回截止);
            }
            if (重放.状态 != L1所有者范围读取状态::未找到)
                return 失败(映射首次读取失败_v4(重放.状态));

            const auto G0 = 读取当前代次();
            if (!G0 || *G0 != 请求.请求头.期望事实代次)
                return 失败(激活状态::当前性漂移);
            建立或恢复本能被动维护游标请求_v1 锚点请求{
                本能被动维护游标合同版本_v1, 请求.请求头,
                请求.幂等身份, 请求.本能根锚点, 请求.运行代次,
                请求.时间纪元身份, 请求.当前完整秒边界,
                请求.时间源版本, 请求.服务时间维护规则版本};
            if (!锚点绑定有效(锚点请求, *G0))
                return 失败(激活状态::引用冲突);
            const auto 登记状态 = 确保登记(*G0);
            if (登记状态 != 本能被动维护游标建立状态_v1::已恢复)
                return 失败(映射v1建立状态_v4(登记状态));

            const auto 当前G = 读取当前代次();
            if (!当前G) return 失败(激活状态::内部错误);
            const auto 当前 = 读取当前本能被动维护游标_v4({
                本能被动维护游标合同版本_v4,
                {L2结构合同版本, *当前G}, 请求.本能根锚点.唯一自我});
            if (当前.成功() && 当前.游标) {
                const auto& 游标 = *当前.游标;
                if (游标.成功维护提交序号 > 0)
                    return 失败(激活状态::已有成功维护需完整迁移);
                if (游标.服务历史v2覆盖种子事实代次
                        != 请求.服务历史v2边界见证.快照->v2覆盖登记事实代次)
                    return 失败(激活状态::覆盖种子漂移);
                if (!v4游标与请求同义(游标, 请求))
                    return 失败(激活状态::引用冲突);
                return 形成激活成功结果(激活状态::已恢复, 请求, 游标,
                    游标.形成事实代次, 当前.本次正式读回截止);
            }
            if (当前.状态 == 本能被动维护游标读取状态_v4::旧格式待裁决)
                return 失败(激活状态::旧格式成功维护历史不可证明);
            if (当前.状态 != 本能被动维护游标读取状态_v4::未建立)
                return 失败(映射读取失败_v4(当前.状态));

            const auto 历史 = 第一层服务_.读取所有者范围历史属性值组({
                L1所有者范围CRUD合同版本, 定位_->当前游标节点, *当前G});
            if (历史.状态 != L1所有者范围读取状态::成功
                || 历史.读取事实代次 != *当前G
                || 历史.历史截止事实代次 != *当前G)
                return 失败(历史.状态 == L1所有者范围读取状态::资源失败
                    ? 激活状态::资源失败
                    : 历史.状态 == L1所有者范围读取状态::事实代次漂移
                        ? 激活状态::当前性漂移 : 激活状态::内部错误);
            if (!历史.属性值组.empty()) return 失败(激活状态::材料不足);

            const auto Gwrite = 读取当前代次();
            if (!Gwrite || *Gwrite != *当前G)
                return 失败(激活状态::当前性漂移);
            L1所有者范围写集请求 写入请求;
            写入请求.期望事实代次 = *Gwrite;
            写入请求.写入幂等身份 = {请求.幂等身份.值};
            写入请求.值 = {{本能被动维护游标内部::游标值键,
                定位_->当前游标节点, 定位_->当前游标属性类型,
                目标材料, 定位_->登记锚点}};
            写入请求.属性槽变更 = {{定位_->当前游标节点,
                定位_->当前游标属性类型,
                本能被动维护游标内部::游标值键}};
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写入请求);
            if (写入.状态 != L1所有者范围写入状态::成功
                && 写入.状态 != L1所有者范围写入状态::精确重复) {
                const auto 状态 = 映射写入失败_v4(写入);
                return 失败(状态, 状态 == 激活状态::已可能发布
                    ? 写入.事实代次 : 0);
            }
            const bool 首次发布完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布;
            const bool 重复收敛完整 =
                写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布;
            if (写入.事实代次 == 0 || (!首次发布完整 && !重复收敛完整))
                return 失败(激活状态::内部错误);
            const auto 正式 = 读取当前本能被动维护游标_v4({
                本能被动维护游标合同版本_v4,
                {L2结构合同版本, 写入.事实代次},
                请求.本能根锚点.唯一自我});
            const auto 目标游标 = 形成v4游标(请求, 写入.事实代次);
            if (!正式.成功() || !正式.游标 || *正式.游标 != 目标游标)
                return 失败(激活状态::已可能发布, 写入.事实代次);
            return 形成激活成功结果(激活状态::已激活, 请求,
                *正式.游标, 写入.事实代次, 正式.本次正式读回截止);
        } catch (const std::bad_alloc&) {
            return 失败(激活状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(激活状态::资源失败);
        } catch (...) {
            return 失败(激活状态::内部错误);
        }
    }

