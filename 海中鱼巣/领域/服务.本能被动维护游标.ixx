        } catch (...) {
            return 失败(读取状态::内部错误);
        }
    }

private:
    static bool 请求有效(
        const 建立或恢复本能被动维护游标请求_v1& 请求) noexcept {
        return 请求.合同版本 == 本能被动维护游标合同版本_v1
            && L2结构请求头合同有效(请求.请求头)
            && 请求.请求头.期望事实代次 != 0
            && L2结构幂等身份有效(请求.幂等身份)
            && 请求.本能根锚点.完整()
            && 请求.本能根锚点.事实截止代次
                <= 请求.请求头.期望事实代次
            && 请求.运行代次 != 0 && 请求.时间纪元身份 != 0
            && 请求.当前完整秒边界 >= 0
            && 请求.时间源版本 != 0
            && 请求.服务时间维护规则版本 != 0;
    }

    static bool 请求有效(
        const 建立或恢复本能被动维护游标请求_v2& 请求) noexcept {
        return 请求.合同版本 == 本能被动维护游标合同版本_v2
            && L2结构请求头合同有效(请求.请求头)
            && 请求.请求头.期望事实代次 != 0
            && L2结构幂等身份有效(请求.幂等身份)
            && 请求.本能根锚点.完整()
            && 请求.本能根锚点.事实截止代次
                <= 请求.请求头.期望事实代次
            && 请求.运行代次 != 0 && 请求.时间纪元身份 != 0
            && 请求.当前完整秒边界 >= 0
            && 请求.目标已消费主动安全变化事实代次 != 0
            && 请求.变化账登记见证.成功()
            && 请求.变化账登记见证.首次登记事实代次
                <= 请求.变化账登记见证.本次正式读回截止
            && 请求.变化账登记见证.本次正式读回截止
                <= 请求.请求头.期望事实代次
            && 请求.时间源版本 != 0
            && 请求.服务时间维护规则版本 != 0;
    }

    static bool 请求有效(
        const 建立或恢复本能被动维护游标请求_v3& 请求) noexcept {
        const auto G0 = 请求.请求头.期望事实代次;
        return 请求.合同版本 == 本能被动维护游标合同版本_v3
            && L2结构请求头合同有效(请求.请求头) && G0 != 0
            && L2结构幂等身份有效(请求.幂等身份)
            && 请求.本能根锚点.完整()
            && 请求.本能根锚点.事实截止代次 <= G0
            && 请求.运行代次 != 0 && 请求.时间纪元身份 != 0
            && 请求.当前完整秒边界 >= 0
            && 请求.目标已消费主动安全变化事实代次 != 0
            && 请求.变化账登记见证.成功()
            && 请求.变化账登记见证.首次登记事实代次
                <= 请求.目标已消费主动安全变化事实代次
            && 请求.目标已消费主动安全变化事实代次 <= G0
            && 请求.变化账登记见证.本次正式读回截止 <= G0
            && 请求.目标已消费服务维护历史事实代次 != 0
            && 请求.服务历史覆盖起点见证.成功()
            && 请求.服务历史覆盖起点见证.快照
            && 请求.服务历史覆盖起点见证.快照->自我
                == 请求.本能根锚点.唯一自我
            && 请求.服务历史覆盖起点见证.快照->历史账登记事实代次
                <= 请求.目标已消费服务维护历史事实代次
            && 请求.目标已消费服务维护历史事实代次 <= G0
            && 请求.服务历史覆盖起点见证.本次正式读回截止 <= G0
            && 请求.时间源版本 != 0
            && 请求.服务时间维护规则版本 != 0;
    }

    static bool 请求有效(
        const 显式激活或恢复本能被动维护纪元请求_v1& 请求) noexcept {
        const auto G0 = 请求.请求头.期望事实代次;
        return 请求.合同版本 == 本能被动维护纪元激活合同版本_v1
            && L2结构请求头合同有效(请求.请求头) && G0 != 0
            && L2结构幂等身份有效(请求.幂等身份)
            && 请求.本能根锚点.完整()
            && 请求.本能根锚点.事实截止代次 <= G0
            && 请求.运行代次 != 0 && 请求.时间纪元身份 != 0
            && 请求.当前完整秒边界 >= 0
            && 请求.主动安全变化账登记见证.成功()
            && 请求.主动安全变化账登记见证.首次登记事实代次 != 0
            && 请求.主动安全变化账登记见证.首次登记事实代次
                <= 请求.主动安全变化账登记见证.本次正式读回截止
            && 请求.主动安全变化账登记见证.本次正式读回截止 <= G0
            && 请求.服务历史v2边界见证.成功()
            && 请求.服务历史v2边界见证.快照
            && 请求.服务历史v2边界见证.快照->自我
                == 请求.本能根锚点.唯一自我
            && 请求.服务历史v2边界见证.快照->v2覆盖登记事实代次 != 0
            && 请求.服务历史v2边界见证.快照->左边界事实代次 == G0
            && 请求.服务历史v2边界见证.快照->包含结束事实代次 == G0
            && 请求.服务历史v2边界见证.本次正式读回截止 == G0
            && 请求.时间源版本 != 0
            && 请求.服务时间维护规则版本 != 0;
    }

    std::optional<std::uint64_t> 读取当前代次() const noexcept {
        const auto 结果 = 第一层服务_.读取中性当前事实代次(
            {L1中性CRUD合同版本});
        return 结果.状态 == L1中性读取状态::成功 && 结果.事实代次 != 0
            ? std::optional<std::uint64_t>{结果.事实代次} : std::nullopt;
    }

    bool 锚点绑定有效(
        const 建立或恢复本能被动维护游标请求_v1& 请求,
        std::uint64_t G) const noexcept {
        const auto 检查实例 = [&](L2特征实例身份 身份) {
            const auto 读取 = 特征服务_.读取完整特征实例({
                {L2结构合同版本, G}, L2读取类别::当前, 身份, 0});
            return 读取.结果头.状态 == L2结构状态::已读取
                && 读取.结果头.事实截止代次 == G && 读取.特征实例
                && 读取.特征实例->身份 == 身份
                && 读取.特征实例->宿主存在 == 请求.本能根锚点.唯一自我
                && !读取.特征实例->生命周期.退出事实代次;
        };
        return 检查实例(请求.本能根锚点.安全根特征实例)
            && 检查实例(请求.本能根锚点.服务根特征实例);
    }

    本能被动维护游标建立状态_v1 确保登记(std::uint64_t G0) {
        if (确保登记定位只读())
            return 本能被动维护游标建立状态_v1::已恢复;
        L1所有者范围写集请求 请求;
        请求.期望事实代次 = G0;
        请求.写入幂等身份 = 本能被动维护游标内部::登记写入幂等身份;
        请求.节点 = {
            {本能被动维护游标内部::登记锚点键, 节点种类::普通,
                std::nullopt},
            {本能被动维护游标内部::当前游标节点键, 节点种类::普通,
                std::nullopt},
            {本能被动维护游标内部::当前游标属性类型键,
                节点种类::属性类型, L1所有者范围值表示种类::U64组}};
        const auto 写入 = 写入端口_.提交所有者范围中性写集(请求);
        if (写入.状态 != L1所有者范围写入状态::成功
            && 写入.状态 != L1所有者范围写入状态::精确重复)
            return 映射写入失败(写入);
        return 确保登记定位只读()
            ? 本能被动维护游标建立状态_v1::已恢复
            : 本能被动维护游标建立状态_v1::已可能发布;
    }

    bool 确保登记定位只读() const {
        if (定位_ && 定位_->完整()) return true;
        const auto 首次 = 写入端口_.读取首次写入材料({
            L1所有者范围首次写入读取合同版本,
            本能被动维护游标内部::登记写入幂等身份});
        const auto 定位 = 本能被动维护游标内部::投影登记定位(
            首次, 所有者事实_.所有者);
        if (!定位) return false;
        定位_ = *定位;
        return true;
    }

    static const std::vector<std::uint64_t>* 重放游标材料(
        const L1所有者范围写集请求& 写集) noexcept {
        if (写集.值.size() != 1 || 写集.属性槽变更.size() != 1
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.退出事实.empty()) return nullptr;
        return std::get_if<std::vector<std::uint64_t>>(&写集.值[0].材料);
    }

    static bool 游标等于请求(
        const 本能被动维护游标事实_v1& 游标,
        const 建立或恢复本能被动维护游标请求_v1& 请求) noexcept {
        return 游标.自我 == 请求.本能根锚点.唯一自我
            && 游标.运行代次 == 请求.运行代次
            && 游标.时间纪元身份 == 请求.时间纪元身份
            && 游标.上一已维护完整秒边界 == 请求.当前完整秒边界
            && 游标.时间源版本 == 请求.时间源版本
            && 游标.服务时间维护规则版本
                == 请求.服务时间维护规则版本;
    }

    static bool 游标等于请求(
        const 本能被动维护游标事实_v2& 游标,
        const 建立或恢复本能被动维护游标请求_v2& 请求) noexcept {
        return 游标.自我 == 请求.本能根锚点.唯一自我
            && 游标.运行代次 == 请求.运行代次
            && 游标.时间纪元身份 == 请求.时间纪元身份
            && 游标.上一已维护完整秒边界 == 请求.当前完整秒边界
            && 游标.已消费主动安全变化事实代次
                == 请求.目标已消费主动安全变化事实代次
            && 游标.时间源版本 == 请求.时间源版本
            && 游标.服务时间维护规则版本
                == 请求.服务时间维护规则版本;
    }

    static bool 游标等于请求(
        const 本能被动维护游标事实_v3& 游标,
        const 建立或恢复本能被动维护游标请求_v3& 请求) noexcept {
        return 游标.自我 == 请求.本能根锚点.唯一自我
            && 游标.运行代次 == 请求.运行代次
            && 游标.时间纪元身份 == 请求.时间纪元身份
            && 游标.上一已维护完整秒边界 == 请求.当前完整秒边界
            && 游标.已消费主动安全变化事实代次
                == 请求.目标已消费主动安全变化事实代次
            && 游标.已消费服务维护历史事实代次
                == 请求.目标已消费服务维护历史事实代次
            && 游标.时间源版本 == 请求.时间源版本
            && 游标.服务时间维护规则版本
                == 请求.服务时间维护规则版本;
    }

    static 本能被动维护游标事实_v4 形成v4游标(
        const 显式激活或恢复本能被动维护纪元请求_v1& 请求,
        std::uint64_t 形成事实代次) noexcept {
        const auto Gseed = 请求.服务历史v2边界见证.快照->v2覆盖登记事实代次;
        return {请求.本能根锚点.唯一自我, 请求.运行代次,
            请求.时间纪元身份, 请求.幂等身份.值,
            请求.当前完整秒边界,
            请求.主动安全变化账登记见证.首次登记事实代次,
            Gseed, Gseed, 0, 请求.时间源版本,
            请求.服务时间维护规则版本, 形成事实代次};
    }

    static bool v4游标与请求同义(
        const 本能被动维护游标事实_v4& 游标,
        const 显式激活或恢复本能被动维护纪元请求_v1& 请求) noexcept {
        const auto Gseed = 请求.服务历史v2边界见证.快照->v2覆盖登记事实代次;
        return 游标.自我 == 请求.本能根锚点.唯一自我
            && 游标.运行代次 == 请求.运行代次
            && 游标.时间纪元身份 == 请求.时间纪元身份
            && 游标.上一已维护完整秒边界 == 请求.当前完整秒边界
            && 游标.已消费主动安全变化事实代次
                == 请求.主动安全变化账登记见证.首次登记事实代次
            && 游标.已消费服务维护历史事实代次 == Gseed
            && 游标.服务历史v2覆盖种子事实代次 == Gseed
            && 游标.成功维护提交序号 == 0
            && 游标.时间源版本 == 请求.时间源版本
            && 游标.服务时间维护规则版本
                == 请求.服务时间维护规则版本;
    }

    static 本能被动维护纪元激活结果_v1 形成激活成功结果(
        本能被动维护纪元激活状态_v1 状态,
        const 显式激活或恢复本能被动维护纪元请求_v1& 请求,
        const 本能被动维护游标事实_v4& 游标,
        std::uint64_t 首次提交事实代次,
        std::uint64_t 本次正式读回截止) noexcept {
        本能被动维护纪元激活结果_v1 结果;
        结果.状态 = 状态;
        结果.幂等身份 = 请求.幂等身份;
        结果.提交游标 = 游标;
        结果.激活见证 = 本能被动维护纪元激活见证_v1{
            游标.维护纪元身份, 游标.服务历史v2覆盖种子事实代次,
            游标.服务历史v2覆盖种子事实代次,
            游标.上一已维护完整秒边界};
        结果.首次提交事实代次 = 首次提交事实代次;
        结果.本次正式读回截止 = 本次正式读回截止;
        if (结果.成功()) return 结果;
        本能被动维护纪元激活结果_v1 失败;
        失败.状态 = 本能被动维护纪元激活状态_v1::内部错误;
        失败.幂等身份 = 请求.幂等身份;
        return 失败;
    }

    static 本能被动维护纪元激活状态_v1 映射v1建立状态_v4(
        本能被动维护游标建立状态_v1 状态) noexcept {
        switch (状态) {
        case 本能被动维护游标建立状态_v1::当前性漂移:
            return 本能被动维护纪元激活状态_v1::当前性漂移;
        case 本能被动维护游标建立状态_v1::幂等冲突:
            return 本能被动维护纪元激活状态_v1::幂等冲突;
        case 本能被动维护游标建立状态_v1::引用冲突:
            return 本能被动维护纪元激活状态_v1::引用冲突;
        case 本能被动维护游标建立状态_v1::资源失败:
            return 本能被动维护纪元激活状态_v1::资源失败;
        case 本能被动维护游标建立状态_v1::已可能发布:
            return 本能被动维护纪元激活状态_v1::已可能发布;
        default: return 本能被动维护纪元激活状态_v1::内部错误;
        }
    }

    static 本能被动维护纪元激活状态_v1 映射首次读取失败_v4(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::事实代次漂移:
            return 本能被动维护纪元激活状态_v1::当前性漂移;
        case L1所有者范围读取状态::资源失败:
            return 本能被动维护纪元激活状态_v1::资源失败;
        default: return 本能被动维护纪元激活状态_v1::内部错误;
        }
    }

    static 本能被动维护纪元激活状态_v1 映射读取失败_v4(
        本能被动维护游标读取状态_v4 状态) noexcept {
        switch (状态) {
        case 本能被动维护游标读取状态_v4::当前性漂移:
            return 本能被动维护纪元激活状态_v1::当前性漂移;
        case 本能被动维护游标读取状态_v4::引用冲突:
        case 本能被动维护游标读取状态_v4::版本漂移:
            return 本能被动维护纪元激活状态_v1::引用冲突;
        case 本能被动维护游标读取状态_v4::资源失败:
            return 本能被动维护纪元激活状态_v1::资源失败;
        default: return 本能被动维护纪元激活状态_v1::内部错误;
        }
    }

    static 本能被动维护纪元激活状态_v1 映射写入失败_v4(
        const L1所有者范围写入结果& 结果) noexcept {
        if (结果.是否形成内存权威发布)
            return 本能被动维护纪元激活状态_v1::已可能发布;
        switch (结果.状态) {
        case L1所有者范围写入状态::事实代次漂移:
            return 本能被动维护纪元激活状态_v1::当前性漂移;
        case L1所有者范围写入状态::幂等冲突:
            return 本能被动维护纪元激活状态_v1::幂等冲突;
        case L1所有者范围写入状态::引用冲突:
            return 本能被动维护纪元激活状态_v1::引用冲突;
        case L1所有者范围写入状态::资源失败:
            return 本能被动维护纪元激活状态_v1::资源失败;
        default: return 本能被动维护纪元激活状态_v1::内部错误;
        }
    }

    static 本能被动维护游标建立状态_v3 映射v1建立状态_v3(
        本能被动维护游标建立状态_v1 状态) noexcept {
        switch (状态) {
        case 本能被动维护游标建立状态_v1::当前性漂移:
            return 本能被动维护游标建立状态_v3::当前性漂移;
        case 本能被动维护游标建立状态_v1::幂等冲突:
            return 本能被动维护游标建立状态_v3::幂等冲突;
        case 本能被动维护游标建立状态_v1::引用冲突:
            return 本能被动维护游标建立状态_v3::引用冲突;
        case 本能被动维护游标建立状态_v1::资源失败:
            return 本能被动维护游标建立状态_v3::资源失败;
