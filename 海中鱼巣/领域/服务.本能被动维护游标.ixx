    本能被动维护游标服务(
        const L1事实基座服务& 第一层服务,
        const L2特征结构服务& 特征服务,
        本能被动维护游标所有者交付&& 交付)
        : 第一层服务_(第一层服务), 特征服务_(特征服务),
          所有者事实_(交付.所有者事实_), 写入端口_(std::move(交付.写入端口_)) {
        if (!写入端口_.有效()
            || !写入端口_.绑定于(第一层服务_)
            || 写入端口_.所有者身份() != 所有者事实_.所有者)
            throw std::invalid_argument("本能被动维护游标 owner 交付无效");
    }

