// 文件规则：本模块只编排显式安全层来源、任务事实与纯值权限算法，不枚举仓库或保存来源引用。
module;

#include "../核心/句柄.h"

#include <algorithm>
#include <new>
#include <optional>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.服务.安全任务权限;

import 海中鱼巣.领域.协议.分层安全维护;
import 海中鱼巣.领域.算法.安全任务权限;
import 海中鱼巣.领域.服务.安全因果分层;
import 海中鱼巣.领域.服务.分层安全维护;

export namespace 海中鱼巣 {

class 安全任务事实提供者 {
public:
    virtual ~安全任务事实提供者() = default;
    virtual 安全任务事实来源结果 读取安全任务事实(
        const 安全任务事实来源请求& 请求) const = 0;
};

class 安全任务权限服务 final {
public:
    安全任务权限服务(
        安全因果分层服务& 因果分层服务,
        安全维护事实提供者& 安全事实提供者,
        安全任务事实提供者& 任务事实提供者) noexcept
        : 因果分层服务_(因果分层服务),
          安全事实提供者_(安全事实提供者),
          任务事实提供者_(任务事实提供者) {
    }

    安全任务权限服务(const 安全任务权限服务&) = delete;
    安全任务权限服务& operator=(const 安全任务权限服务&) = delete;

    权限读取结果 读取安全权限快照(
        const 权限读取请求& 请求) const {
        try {
            const auto 入口结果 = 复核权限请求(请求);
            if (入口结果 != 安全结果分类::已形成) {
                return {入口结果, std::nullopt};
            }
            std::vector<安全组层输入快照> 完整层组;
            std::vector<安全权限材料缺口> 缺口组;
            std::vector<安全权限层来源选择> 未归层组;
            for (const auto& 选择 : 请求.安全层来源选择组) {
                const 安全分层读取请求 分层请求{
                    请求.自我,
                    选择.来源因果信息,
                    选择.最终安全结果,
                    请求.适用场景,
                    请求.图版本,
                    请求.事实截止版本};
                auto 分层结果 = 因果分层服务_.读取安全因果分层(分层请求);
                if ((分层结果.结果分类 == 安全结果分类::未归层
                        || 分层结果.结果分类 == 安全结果分类::已形成)
                    && !分层结果.载荷) {
                    return {安全结果分类::内部不一致, std::nullopt};
                }
                if (分层结果.结果分类 == 安全结果分类::未归层) {
                    未归层组.push_back(选择);
                    continue;
                }
                if (分层结果.结果分类 != 安全结果分类::已形成) {
                    return {分层结果.结果分类, std::nullopt};
                }
                const auto& 分层 = *分层结果.载荷;
                if (分层.自我 != 请求.自我
                    || 分层.来源因果信息 != 选择.来源因果信息
                    || 分层.目标安全结果 != 选择.最终安全结果) {
                    return {安全结果分类::内部不一致, std::nullopt};
                }
                if (分层.图版本 != 请求.图版本
                    || 分层.事实截止版本 != 请求.事实截止版本) {
                    return {安全结果分类::版本漂移, std::nullopt};
                }
                if (分层.精确深度适用性 != 适用性::适用
                    || 分层.精确深度 < 0) {
                    return {安全结果分类::内部不一致, std::nullopt};
                }
                if (分层.精确深度 == 0) {
                    if (分层.分组适用性 != 适用性::不适用
                        || 分层.优先级组) {
                        return {安全结果分类::内部不一致, std::nullopt};
                    }
                    未归层组.push_back(选择);
                    continue;
                }
                if (分层.分组适用性 != 适用性::适用
                    || !分层.优先级组
                    || *分层.优先级组
                        != (std::min)(分层.精确深度, std::int64_t{5})) {
                    return {安全结果分类::内部不一致, std::nullopt};
                }

                const 安全维护事实来源请求 来源请求{
                    请求.自我,
                    选择.维护族,
                    请求.适用场景,
                    选择.期望当前值版本,
                    请求.事实截止版本};
                auto 来源结果 =
                    安全事实提供者_.读取已发布安全维护事实(来源请求);
                if (来源结果.结果分类 == 安全结果分类::材料缺失) {
                    缺口组.push_back({
                        *分层.优先级组,
                        选择.维护族,
                        选择.期望当前值版本,
                        std::nullopt});
                    continue;
                }
                if (来源结果.结果分类 != 安全结果分类::已形成) {
                    return {来源结果.结果分类, std::nullopt};
                }
                if (!来源结果.载荷) {
                    return {安全结果分类::内部不一致, std::nullopt};
                }
                const auto& 来源 = *来源结果.载荷;
                if (来源.自我 != 请求.自我
                    || 来源.维护族 != 选择.维护族
                    || 来源.适用场景 != 请求.适用场景
                    || 来源.当前.自我 != 请求.自我
                    || 来源.当前.维护族 != 选择.维护族
                    || 来源.当前.来源因果信息 != 选择.来源因果信息
                    || 来源.当前.最终安全结果 != 选择.最终安全结果) {
                    return {安全结果分类::内部不一致, std::nullopt};
                }
                if (来源.当前值版本 != 选择.期望当前值版本
                    || 来源.事实截止版本 != 请求.事实截止版本
                    || 来源.当前.值版本 != 选择.期望当前值版本
                    || 来源.当前.图版本 != 请求.图版本
                    || 来源.定义.定义版本 == 0
                    || 来源.定义.规则版本 == 0
                    || 来源.来源版本.图版本 != 请求.图版本
                    || 来源.来源版本.事实截止版本 != 请求.事实截止版本
                    || 来源.来源版本.值集合版本 != 选择.期望当前值版本
                    || 来源.来源版本.阈值集合版本 != 来源.定义.定义版本
                    || 来源.来源版本.维护规则版本 != 来源.定义.规则版本) {
                    return {安全结果分类::版本漂移, std::nullopt};
                }
                完整层组.push_back({
                    选择.来源需求,
                    选择.维护族,
                    选择.来源因果信息,
                    来源.当前.目标安全结果,
                    选择.最终安全结果,
                    分层.精确深度,
                    *分层.优先级组,
                    来源.当前.当前安全值,
                    来源.定义.值域下界,
                    来源.定义.值域上界,
                    来源.定义.低位阈值,
                    来源.定义.高位阈值,
                    请求.图版本,
                    来源.当前.值版本,
                    来源.定义.定义版本,
                    来源.定义.规则版本});
            }
            std::sort(完整层组.begin(), 完整层组.end(), 层小于);
            std::sort(缺口组.begin(), 缺口组.end(), 缺口小于);
            std::sort(未归层组.begin(), 未归层组.end(), 选择小于);
            auto 结果 = 计算安全五组权限(
                完整层组,
                缺口组,
                未归层组,
                请求);
            const bool 应有载荷 =
                结果.结果分类 == 安全结果分类::已形成
                || 结果.结果分类 == 安全结果分类::权限为零
                || 结果.结果分类 == 安全结果分类::材料缺失;
            if (应有载荷 != 结果.载荷.has_value()) {
                return {安全结果分类::内部不一致, std::nullopt};
            }
            return 结果;
        } catch (const std::bad_alloc&) {
            return {安全结果分类::资源失败, std::nullopt};
        } catch (...) {
            return {安全结果分类::内部不一致, std::nullopt};
        }
    }

    任务权限结果 计算任务安全权限(
        const 任务权限请求& 请求) const {
        try {
            const auto 入口结果 = 复核任务请求(请求);
            if (入口结果 != 安全结果分类::已形成) {
                return {入口结果, std::nullopt};
            }
            const 权限读取请求 权限请求{
                请求.自我,
                请求.适用场景,
                请求.安全层来源选择组,
                请求.事实截止版本,
                请求.图版本,
                请求.权限规则版本};
            auto 权限结果 = 读取安全权限快照(权限请求);
            if (!可消费权限结果(权限结果)) {
                return {
                    权限结果.结果分类 == 安全结果分类::已形成
                        || 权限结果.结果分类 == 安全结果分类::权限为零
                        || 权限结果.结果分类 == 安全结果分类::材料缺失
                        ? 安全结果分类::内部不一致
                        : 权限结果.结果分类,
                    std::nullopt};
            }
            const 安全任务事实来源请求 来源请求{
                请求.自我,
                请求.适用场景,
                请求.事实截止版本,
                请求.任务集合版本};
            auto 来源结果 = 任务事实提供者_.读取安全任务事实(来源请求);
            if (来源结果.结果分类 != 安全结果分类::已形成) {
                return {来源结果.结果分类, std::nullopt};
            }
            if (!来源结果.载荷) {
                return {安全结果分类::内部不一致, std::nullopt};
            }
            const auto 复核结果 = 复核任务来源(
                *来源结果.载荷,
                请求.自我,
                请求.适用场景,
                请求.事实截止版本,
                请求.任务集合版本,
                *权限结果.载荷,
                请求.图版本,
                请求.权限规则版本);
            if (复核结果 != 安全结果分类::已形成) {
                return {复核结果, std::nullopt};
            }
            return 计算单任务安全权限(
                *来源结果.载荷,
                *权限结果.载荷,
                请求);
        } catch (const std::bad_alloc&) {
            return {安全结果分类::资源失败, std::nullopt};
        } catch (...) {
            return {安全结果分类::内部不一致, std::nullopt};
        }
    }

    任务排序结果 排序任务执行候选(
        const 任务排序请求& 请求) const {
        try {
            const auto 入口结果 = 复核排序请求(请求);
            if (入口结果 != 安全结果分类::已形成) {
                return {入口结果, std::nullopt};
            }
            const 权限读取请求 权限请求{
                请求.自我,
                请求.适用场景,
                请求.安全层来源选择组,
                请求.事实截止版本,
                请求.图版本,
                请求.权限规则版本};
            auto 权限结果 = 读取安全权限快照(权限请求);
            if (!可消费权限结果(权限结果)) {
                return {
                    权限结果.结果分类 == 安全结果分类::已形成
                        || 权限结果.结果分类 == 安全结果分类::权限为零
                        || 权限结果.结果分类 == 安全结果分类::材料缺失
                        ? 安全结果分类::内部不一致
                        : 权限结果.结果分类,
                    std::nullopt};
            }
            const 安全任务事实来源请求 来源请求{
                请求.自我,
                请求.适用场景,
                请求.事实截止版本,
                请求.任务集合版本};
            auto 来源结果 = 任务事实提供者_.读取安全任务事实(来源请求);
            if (来源结果.结果分类 != 安全结果分类::已形成) {
                return {来源结果.结果分类, std::nullopt};
            }
            if (!来源结果.载荷) {
                return {安全结果分类::内部不一致, std::nullopt};
            }
            const auto 复核结果 = 复核任务来源(
                *来源结果.载荷,
                请求.自我,
                请求.适用场景,
                请求.事实截止版本,
                请求.任务集合版本,
                *权限结果.载荷,
                请求.图版本,
                请求.权限规则版本);
            if (复核结果 != 安全结果分类::已形成) {
                return {复核结果, std::nullopt};
            }
            return 排序安全任务执行候选(
                *来源结果.载荷,
                *权限结果.载荷,
                请求);
        } catch (const std::bad_alloc&) {
            return {安全结果分类::资源失败, std::nullopt};
        } catch (...) {
            return {安全结果分类::内部不一致, std::nullopt};
        }
    }

private:
    static bool 句柄小于(
        const 节点句柄& 左,
        const 节点句柄& 右) noexcept {
        if (左.仓库编号 != 右.仓库编号) return 左.仓库编号 < 右.仓库编号;
        if (左.节点编号 != 右.节点编号) return 左.节点编号 < 右.节点编号;
        return 左.版本号 < 右.版本号;
    }

    static bool 选择小于(
        const 安全权限层来源选择& 左,
        const 安全权限层来源选择& 右) noexcept {
        if (左.来源需求 != 右.来源需求) return 句柄小于(左.来源需求, 右.来源需求);
        if (左.维护族 != 右.维护族) return 句柄小于(左.维护族, 右.维护族);
        if (左.来源因果信息 != 右.来源因果信息) {
            return 句柄小于(左.来源因果信息, 右.来源因果信息);
        }
        return 句柄小于(左.最终安全结果, 右.最终安全结果);
    }

    static bool 层小于(
        const 安全组层输入快照& 左,
        const 安全组层输入快照& 右) noexcept {
        if (左.优先级组 != 右.优先级组) return 左.优先级组 < 右.优先级组;
        if (左.来源需求 != 右.来源需求) return 句柄小于(左.来源需求, 右.来源需求);
        if (左.维护族 != 右.维护族) return 句柄小于(左.维护族, 右.维护族);
        if (左.来源因果信息 != 右.来源因果信息) {
            return 句柄小于(左.来源因果信息, 右.来源因果信息);
        }
        return 句柄小于(左.最终安全结果, 右.最终安全结果);
    }

    static bool 缺口小于(
        const 安全权限材料缺口& 左,
        const 安全权限材料缺口& 右) noexcept {
        if (左.首个受影响组 != 右.首个受影响组) {
            return 左.首个受影响组 < 右.首个受影响组;
        }
        return 句柄小于(左.缺口来源, 右.缺口来源);
    }

    static 安全结果分类 复核选择组(
        const std::vector<安全权限层来源选择>& 选择组) noexcept {
        for (std::size_t 序号 = 0; 序号 < 选择组.size(); ++序号) {
            const auto& 选择 = 选择组[序号];
            if (!句柄有效(选择.来源需求)
                || !句柄有效(选择.维护族)
                || !句柄有效(选择.来源因果信息)
                || !句柄有效(选择.最终安全结果)
                || 选择.期望当前值版本 == 0
                || (序号 != 0 && !选择小于(选择组[序号 - 1], 选择))) {
                return 安全结果分类::结构拒绝;
            }
        }
        return 安全结果分类::已形成;
    }

    static 安全结果分类 复核权限请求(
        const 权限读取请求& 请求) noexcept {
        if (!句柄有效(请求.自我)
            || !句柄有效(请求.适用场景)
            || 请求.事实截止版本 == 0
            || 请求.图版本 == 0
            || 请求.权限规则版本 != 安全权限规则版本) {
            return 安全结果分类::入口拒绝;
        }
        return 复核选择组(请求.安全层来源选择组);
    }

    static 安全结果分类 复核任务请求(
        const 任务权限请求& 请求) noexcept {
        if (!句柄有效(请求.自我)
            || !句柄有效(请求.适用场景)
            || !句柄有效(请求.任务稳定句柄)
            || 请求.事实截止版本 == 0
            || 请求.图版本 == 0
            || 请求.任务集合版本 == 0
            || 请求.权限规则版本 != 安全权限规则版本) {
            return 安全结果分类::入口拒绝;
        }
        return 复核选择组(请求.安全层来源选择组);
    }

    static 安全结果分类 复核排序请求(
        const 任务排序请求& 请求) noexcept {
        if (!句柄有效(请求.自我)
            || !句柄有效(请求.适用场景)
            || 请求.事实截止版本 == 0
            || 请求.图版本 == 0
            || 请求.任务集合版本 == 0
            || 请求.权限规则版本 != 安全权限规则版本
            || 请求.排序规则版本 != 安全任务排序规则版本) {
            return 安全结果分类::入口拒绝;
        }
        const auto 选择结果 = 复核选择组(请求.安全层来源选择组);
        if (选择结果 != 安全结果分类::已形成) return 选择结果;
        for (std::size_t 序号 = 0; 序号 < 请求.候选任务组.size(); ++序号) {
            const auto& 候选 = 请求.候选任务组[序号];
            if (!句柄有效(候选.任务稳定句柄)
                || 候选.授权版本 == 0
                || 候选.状态版本 == 0
                || 候选.基础优先级 < 0
                || 候选.方法冻结版本 == 0
                || (序号 != 0
                    && (请求.候选任务组[序号 - 1].任务稳定句柄
                            == 候选.任务稳定句柄
                        || 句柄小于(
                            候选.任务稳定句柄,
                            请求.候选任务组[序号 - 1].任务稳定句柄)))) {
                return 安全结果分类::结构拒绝;
            }
        }
        return 安全结果分类::已形成;
    }

    static bool 可消费权限结果(
        const 权限读取结果& 结果) noexcept {
        const bool 分类可消费 =
            结果.结果分类 == 安全结果分类::已形成
            || 结果.结果分类 == 安全结果分类::权限为零
            || 结果.结果分类 == 安全结果分类::材料缺失;
        return 分类可消费 && 结果.载荷.has_value();
    }

    static 安全结果分类 复核任务来源(
        const 安全任务事实来源载荷& 来源,
        const 节点句柄& 自我,
        const 节点句柄& 场景,
        std::uint64_t 截止版本,
        std::uint64_t 任务集合版本,
        const 权限读取载荷& 权限,
        std::uint64_t 图版本,
        std::uint32_t 权限规则版本) noexcept {
        if (来源.自我 != 自我 || 来源.适用场景 != 场景) {
            return 安全结果分类::内部不一致;
        }
        if (来源.事实截止版本 != 截止版本
            || 来源.任务集合版本 != 任务集合版本
            || 来源.来源版本.事实截止版本 != 截止版本
            || 来源.来源版本.任务集合版本 != 任务集合版本
            || 权限.全部来源版本.图版本 != 图版本
            || 权限.全部来源版本.事实截止版本 != 截止版本
            || 权限.全部来源版本.权限规则版本 != 权限规则版本) {
            return 安全结果分类::版本漂移;
        }
        return 安全结果分类::已形成;
    }

    安全因果分层服务& 因果分层服务_;
    安全维护事实提供者& 安全事实提供者_;
    安全任务事实提供者& 任务事实提供者_;
};

}
