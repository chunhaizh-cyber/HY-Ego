module;

#include <algorithm>
#include <cstdint>
#include <new>
#include <optional>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.服务.需求任务子目标承接;

import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2任务子目标承接记录结构;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 需求任务子目标承接合同版本 = 1;

struct 需求任务子目标承接请求 final {
    std::uint32_t 合同版本 = 需求任务子目标承接合同版本;
    L2结构请求头 请求头;
    L2任务子目标承接记录身份 记录;
    std::uint64_t 父子顺序 = 0;
    L2结构幂等身份 需求发布幂等身份;
    L2结构幂等身份 任务绑定幂等身份;
    friend bool operator==(const 需求任务子目标承接请求&,
        const 需求任务子目标承接请求&) = default;
};

enum class 需求任务子目标承接状态 : std::uint8_t {
    已承接 = 1,
    精确重复 = 2,
    入口拒绝 = 3,
    许可拒绝 = 4,
    记录不可承接 = 5,
    父域冲突 = 6,
    目标冲突 = 7,
    父子顺序冲突 = 8,
    需求已发布待任务绑定 = 9,
    事实代次漂移 = 10,
    幂等冲突 = 11,
    引用冲突 = 12,
    资源失败 = 13,
    内部不一致 = 14
};

enum class 需求任务子目标承接来源 : std::uint8_t {
    新建列表项与子需求 = 1,
    复用列表项并新建子需求 = 2,
    复用当前子需求 = 3,
    需求侧事实已存在 = 4,
    已有双向事实 = 5
};

struct 需求任务子目标承接结果 final {
    需求任务子目标承接状态 状态 = 需求任务子目标承接状态::入口拒绝;
    std::optional<需求任务子目标承接来源> 来源;
    std::optional<L2需求事实> 子需求;
    std::optional<L2需求事实> 父需求;
    std::optional<L2需求列表项事实> 所属列表项;
    std::optional<L2需求列表成员关系事实> 当前成员关系;
    std::optional<L2需求父子关系事实> 当前父关系;
    std::optional<L2需求任务子目标来源关系事实> 需求来源关系;
    std::optional<L2任务子目标承接记录事实> 任务记录;
    std::optional<L2绑定任务子目标承接记录子需求请求> 待重试任务绑定;
    std::uint64_t 最终共同事实截止 = 0;
    bool 成功() const noexcept;
    friend bool operator==(const 需求任务子目标承接结果&,
        const 需求任务子目标承接结果&) = default;
};

class 需求任务子目标承接服务 final {
public:
    需求任务子目标承接服务(L2需求结构服务& 需求服务,
        L2任务子目标承接记录结构服务& 记录服务) noexcept;
    需求任务子目标承接服务(const 需求任务子目标承接服务&) = delete;
    需求任务子目标承接服务& operator=(const 需求任务子目标承接服务&) = delete;
    需求任务子目标承接服务(需求任务子目标承接服务&&) = delete;
    需求任务子目标承接服务& operator=(需求任务子目标承接服务&&) = delete;

    需求任务子目标承接结果 承接任务子目标记录(
        const 需求任务子目标承接请求& 请求) noexcept;

private:
    L2需求结构服务& 需求服务_;
    L2任务子目标承接记录结构服务& 记录服务_;
};

} // namespace 海中鱼巣

namespace 海中鱼巣::需求任务子目标承接内部 {

struct 需求侧材料 final {
    L2需求事实 子需求;
    L2需求事实 父需求;
    L2需求列表项事实 所属列表项;
    L2需求列表成员关系事实 当前成员关系;
    L2需求父子关系事实 当前父关系;
    L2需求任务子目标来源关系事实 来源关系;
    std::uint64_t 事实截止 = 0;
};

struct 需求侧材料读取结果 final {
    需求任务子目标承接状态 状态 = 需求任务子目标承接状态::内部不一致;
    std::optional<需求侧材料> 材料;
    std::uint64_t 回显截止 = 0;
};

inline bool 请求有效(const 需求任务子目标承接请求& 请求) noexcept {
    return 请求.合同版本 == 需求任务子目标承接合同版本
        && L2结构请求头合同有效(请求.请求头)
        && 请求.请求头.期望事实代次 != 0 && 有效(请求.记录.值)
        && L2需求关系顺序有效(请求.父子顺序)
        && L2结构幂等身份有效(请求.需求发布幂等身份)
        && L2结构幂等身份有效(请求.任务绑定幂等身份)
        && 请求.需求发布幂等身份 != 请求.任务绑定幂等身份;
}

inline 需求任务子目标承接状态 映射状态(
    L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::入口拒绝: return 需求任务子目标承接状态::入口拒绝;
    case L2结构状态::许可拒绝: return 需求任务子目标承接状态::许可拒绝;
    case L2结构状态::事实代次漂移: return 需求任务子目标承接状态::事实代次漂移;
    case L2结构状态::幂等冲突: return 需求任务子目标承接状态::幂等冲突;
    case L2结构状态::引用冲突: return 需求任务子目标承接状态::引用冲突;
    case L2结构状态::资源失败: return 需求任务子目标承接状态::资源失败;
    case L2结构状态::未找到:
    case L2结构状态::已退出:
        return 需求任务子目标承接状态::记录不可承接;
    default: return 需求任务子目标承接状态::内部不一致;
    }
}

inline 需求任务子目标承接结果 失败(
    需求任务子目标承接状态 状态) noexcept {
    需求任务子目标承接结果 结果;
    结果.状态 = 状态;
    return 结果;
}

inline bool 目标相同(const L2需求事实& 需求,
    const L2任务子目标承接记录事实& 记录) noexcept {
    return 需求.目标宿主存在 == 记录.子目标.目标宿主
        && 需求.目标特征定义 == 记录.子目标.目标特征
        && 需求.目标状态合同 == 记录.子目标.目标状态合同;
}

需求侧材料读取结果 读取需求侧材料组(
    L2需求结构服务& 服务,
    const L2任务子目标承接记录事实& 记录,
    const L2需求任务子目标来源关系事实& 来源,
    std::uint64_t 截止) {
    const L2结构请求头 头{L2结构合同版本, 截止};
    const auto 子 = 服务.读取需求完整(
        {头, L2读取类别::当前, 来源.子需求, 0});
    const auto 父 = 服务.读取需求完整(
        {头, L2读取类别::当前, 记录.父需求, 0});
    const auto 父关系 = 服务.按子需求读取当前父需求({头, 来源.子需求});
    const auto 成员 = 服务.读取需求成员列表(
        {头, L2读取类别::当前, 来源.子需求, 0});
    if (子.结果头.状态 == L2结构状态::事实代次漂移)
        return {需求任务子目标承接状态::事实代次漂移, std::nullopt,
            子.结果头.事实截止代次};
    if (父.结果头.状态 == L2结构状态::事实代次漂移)
        return {需求任务子目标承接状态::事实代次漂移, std::nullopt,
            父.结果头.事实截止代次};
    if (父关系.结果头.状态 == L2结构状态::事实代次漂移)
        return {需求任务子目标承接状态::事实代次漂移, std::nullopt,
            父关系.结果头.事实截止代次};
    if (成员.结果头.状态 == L2结构状态::事实代次漂移)
        return {需求任务子目标承接状态::事实代次漂移, std::nullopt,
            成员.结果头.事实截止代次};
    if (!子.成功() || !子.需求 || !父.成功() || !父.需求
        || !父关系.成功() || !父关系.当前父关系 || !父关系.父需求
        || !成员.成功() || !成员.当前成员关系)
        return {};
    const auto 列表项 = 服务.读取需求列表项完整({头, L2读取类别::当前,
        成员.当前成员关系->列表项, 0});
    if (列表项.结果头.状态 == L2结构状态::事实代次漂移)
        return {需求任务子目标承接状态::事实代次漂移, std::nullopt,
            列表项.结果头.事实截止代次};
    if (!列表项.成功() || !列表项.列表项) return {};
    const bool 一致 = 来源.来源记录.值 == 记录.身份.值
        && 父关系.当前父关系->父需求 == 记录.父需求
        && 父关系.当前父关系->子需求 == 来源.子需求
        && 成员.当前成员关系->需求 == 来源.子需求
        && 子.需求->所属存在 == 父.需求->所属存在
        && 子.需求->所属存在 == 列表项.列表项->所属存在
        && 目标相同(*子.需求, 记录)
        && 子.需求->目标宿主存在 == 列表项.列表项->目标宿主存在
        && 子.需求->目标特征定义 == 列表项.列表项->目标特征定义
        && 子.需求->目标状态合同 == 列表项.列表项->目标状态合同;
    if (!一致) return {};
    return {需求任务子目标承接状态::精确重复,
        需求侧材料{*子.需求, *父.需求, *列表项.列表项,
            *成员.当前成员关系, *父关系.当前父关系, 来源, 截止}, 截止};
}

template <typename 写结果类型>
std::optional<需求侧材料> 提取写结果(
    const 写结果类型& 写入) noexcept {
    if (!写入.成功()) return std::nullopt;
    return 需求侧材料{*写入.子需求, *写入.父需求, *写入.所属列表项,
        *写入.当前成员关系, *写入.当前父关系, *写入.来源关系,
        写入.结果头.事实截止代次};
}

inline 需求任务子目标承接结果 形成等待(
    需求任务子目标承接来源 来源,
    const 需求侧材料& 材料,
    const L2绑定任务子目标承接记录子需求请求& 绑定) noexcept {
    需求任务子目标承接结果 结果;
    结果.状态 = 需求任务子目标承接状态::需求已发布待任务绑定;
    结果.来源 = 来源;
    结果.子需求 = 材料.子需求;
    结果.父需求 = 材料.父需求;
    结果.所属列表项 = 材料.所属列表项;
    结果.当前成员关系 = 材料.当前成员关系;
    结果.当前父关系 = 材料.当前父关系;
    结果.需求来源关系 = 材料.来源关系;
    结果.待重试任务绑定 = 绑定;
    结果.最终共同事实截止 = 材料.事实截止;
    return 结果;
}

需求任务子目标承接结果 最终读回(
    L2需求结构服务& 需求服务,
    L2任务子目标承接记录结构服务& 记录服务,
    L2任务子目标承接记录身份 记录身份,
    需求任务子目标承接来源 来源分类,
    需求任务子目标承接状态 成功状态,
    std::uint64_t 截止,
    bool 允许重读 = true) {
    const L2结构请求头 头{L2结构合同版本, 截止};
    const auto 记录读取 = 记录服务.读取任务子目标承接记录(
        {头, L2读取类别::当前, 记录身份, 0});
    const auto 来源读取 = 需求服务.按任务子目标记录读取需求来源(
        {头, L2需求任务子目标记录引用{记录身份.值}});
    std::uint64_t 最新截止 = 0;
    if (记录读取.结果头.状态 == L2结构状态::事实代次漂移)
        最新截止 = 记录读取.结果头.事实截止代次;
    if (来源读取.结果头.状态 == L2结构状态::事实代次漂移)
        最新截止 = 来源读取.结果头.事实截止代次;
    if (最新截止 != 0 && 允许重读)
        return 最终读回(需求服务, 记录服务, 记录身份, 来源分类,
            成功状态, 最新截止, false);
    if (!记录读取.成功() || !记录读取.记录 || !来源读取.唯一结果())
        return 失败(最新截止 != 0
            ? 需求任务子目标承接状态::事实代次漂移
            : 需求任务子目标承接状态::内部不一致);
    const auto& 记录 = *记录读取.记录;
    const auto& 来源 = 来源读取.来源关系组.front();
    if (!记录.子需求 || *记录.子需求 != 来源.子需求
        || (记录.状态 != L2任务子目标承接记录状态::等待子需求
            && 记录.状态
                != L2任务子目标承接记录状态::子需求已回流待父需求重判))
        return 失败(需求任务子目标承接状态::内部不一致);
    const auto 材料读取 = 读取需求侧材料组(需求服务, 记录, 来源, 截止);
    if (!材料读取.材料 && 材料读取.状态
            == 需求任务子目标承接状态::事实代次漂移 && 允许重读
        && 材料读取.回显截止 != 0)
        return 最终读回(需求服务, 记录服务, 记录身份, 来源分类,
            成功状态, 材料读取.回显截止, false);
    if (!材料读取.材料) return 失败(材料读取.状态);
    const auto& 材料 = *材料读取.材料;
    需求任务子目标承接结果 结果;
    结果.状态 = 成功状态;
    结果.来源 = 来源分类;
    结果.子需求 = 材料.子需求;
    结果.父需求 = 材料.父需求;
    结果.所属列表项 = 材料.所属列表项;
    结果.当前成员关系 = 材料.当前成员关系;
    结果.当前父关系 = 材料.当前父关系;
    结果.需求来源关系 = 材料.来源关系;
    结果.任务记录 = 记录;
    结果.最终共同事实截止 = 截止;
    return 结果.成功() ? 结果 : 失败(需求任务子目标承接状态::内部不一致);
}

} // namespace 海中鱼巣::需求任务子目标承接内部

export namespace 海中鱼巣 {

bool 需求任务子目标承接结果::成功() const noexcept {
    if ((状态 != 需求任务子目标承接状态::已承接
            && 状态 != 需求任务子目标承接状态::精确重复)
        || !来源 || !子需求 || !父需求 || !所属列表项
        || !当前成员关系 || !当前父关系 || !需求来源关系 || !任务记录
        || 待重试任务绑定 || 最终共同事实截止 == 0)
        return false;
    return L2需求事实完整(*子需求, 最终共同事实截止)
        && L2需求事实完整(*父需求, 最终共同事实截止)
        && L2需求列表项事实完整(*所属列表项, 最终共同事实截止)
        && L2需求列表成员关系事实截止投影完整(
            *当前成员关系, 最终共同事实截止)
        && L2需求父子关系事实截止投影完整(
            *当前父关系, 最终共同事实截止)
        && L2需求任务子目标来源关系事实截止投影完整(
            *需求来源关系, 最终共同事实截止)
        && 任务记录->子需求 && *任务记录->子需求 == 子需求->身份
        && 需求来源关系->子需求 == 子需求->身份
        && 当前父关系->子需求 == 子需求->身份
        && 当前父关系->父需求 == 父需求->身份
        && 当前成员关系->需求 == 子需求->身份
        && 当前成员关系->列表项 == 所属列表项->身份
        && 子需求->所属存在 == 父需求->所属存在
        && 子需求->所属存在 == 所属列表项->所属存在;
}

需求任务子目标承接服务::需求任务子目标承接服务(
    L2需求结构服务& 需求服务,
    L2任务子目标承接记录结构服务& 记录服务) noexcept
    : 需求服务_(需求服务), 记录服务_(记录服务) {}

需求任务子目标承接结果 需求任务子目标承接服务::承接任务子目标记录(
    const 需求任务子目标承接请求& 请求) noexcept {
    using namespace 需求任务子目标承接内部;
    if (!请求有效(请求)) return 失败(需求任务子目标承接状态::入口拒绝);
    try {
        auto 截止 = 请求.请求头.期望事实代次;
        auto 记录读取 = 记录服务_.读取任务子目标承接记录(
            {{L2结构合同版本, 截止}, L2读取类别::当前, 请求.记录, 0});
        if (记录读取.结果头.状态 == L2结构状态::事实代次漂移
            && 记录读取.结果头.事实截止代次 != 0) {
            截止 = 记录读取.结果头.事实截止代次;
            记录读取 = 记录服务_.读取任务子目标承接记录(
                {{L2结构合同版本, 截止}, L2读取类别::当前, 请求.记录, 0});
        }
        if (!记录读取.成功() || !记录读取.记录)
            return 失败(记录读取.结果头.状态 == L2结构状态::已读取
                ? 需求任务子目标承接状态::记录不可承接
                : 映射状态(记录读取.结果头.状态));

        auto 来源读取 = 需求服务_.按任务子目标记录读取需求来源(
            {{L2结构合同版本, 截止},
                L2需求任务子目标记录引用{请求.记录.值}});
        if (来源读取.结果头.状态 == L2结构状态::事实代次漂移
            && 来源读取.结果头.事实截止代次 != 0) {
            截止 = 来源读取.结果头.事实截止代次;
            记录读取 = 记录服务_.读取任务子目标承接记录(
                {{L2结构合同版本, 截止}, L2读取类别::当前, 请求.记录, 0});
            来源读取 = 需求服务_.按任务子目标记录读取需求来源(
                {{L2结构合同版本, 截止},
                    L2需求任务子目标记录引用{请求.记录.值}});
        }
        if (!记录读取.成功() || !记录读取.记录 || !来源读取.成功())
            return 失败(!来源读取.成功()
                ? 映射状态(来源读取.结果头.状态)
                : 映射状态(记录读取.结果头.状态));
        const auto& 记录 = *记录读取.记录;
        const bool 来源存在 = 来源读取.唯一结果();
        if (记录.状态 == L2任务子目标承接记录状态::待绑定子需求
            && !记录.子需求 && 来源存在) {
            const auto 材料读取 = 读取需求侧材料组(
                需求服务_, 记录, 来源读取.来源关系组.front(), 截止);
            if (!材料读取.材料) return 失败(材料读取.状态);
            const auto& 材料 = *材料读取.材料;
            const L2绑定任务子目标承接记录子需求请求 绑定{
                {L2结构合同版本, 材料.事实截止}, 请求.任务绑定幂等身份,
                请求.记录, 材料.子需求.身份};
            const auto 绑定结果 = 记录服务_.绑定任务子目标承接记录子需求(绑定);
            if (绑定结果.结果头.状态 == L2结构状态::事实代次漂移
                || 绑定结果.结果头.状态 == L2结构状态::资源失败)
                return 形成等待(需求任务子目标承接来源::需求侧事实已存在,
                    材料, 绑定);
            if (!绑定结果.成功()) return 失败(映射状态(绑定结果.结果头.状态));
            return 最终读回(需求服务_, 记录服务_, 请求.记录,
                需求任务子目标承接来源::需求侧事实已存在,
                绑定结果.结果头.状态 == L2结构状态::已提交
                    ? 需求任务子目标承接状态::已承接
                    : 需求任务子目标承接状态::精确重复,
                绑定结果.结果头.事实截止代次);
        }
        if ((记录.状态 == L2任务子目标承接记录状态::等待子需求
                || 记录.状态
                    == L2任务子目标承接记录状态::子需求已回流待父需求重判)
            && 记录.子需求 && 来源存在
            && *记录.子需求 == 来源读取.来源关系组.front().子需求)
            return 最终读回(需求服务_, 记录服务_, 请求.记录,
                需求任务子目标承接来源::已有双向事实,
                需求任务子目标承接状态::精确重复, 截止);
        if (记录.子需求 || 来源存在)
            return 失败(需求任务子目标承接状态::内部不一致);
        if (记录.状态 != L2任务子目标承接记录状态::待绑定子需求)
            return 失败(需求任务子目标承接状态::记录不可承接);

        const L2结构请求头 头{L2结构合同版本, 截止};
        const auto 父 = 需求服务_.读取需求完整(
            {头, L2读取类别::当前, 记录.父需求, 0});
        const auto 父成员 = 需求服务_.读取需求成员列表(
            {头, L2读取类别::当前, 记录.父需求, 0});
        if (!父.成功() || !父.需求 || !父成员.成功()
            || !父成员.当前成员关系)
            return 失败(需求任务子目标承接状态::父域冲突);
        const auto 父列表项 = 需求服务_.读取需求列表项完整({头,
            L2读取类别::当前, 父成员.当前成员关系->列表项, 0});
        if (!父列表项.成功() || !父列表项.列表项
            || 父列表项.列表项->所属存在 != 父.需求->所属存在)
            return 失败(需求任务子目标承接状态::父域冲突);
        const auto 列表查询 = 需求服务_.按精确目标查询需求列表项({头,
            父.需求->所属存在, 记录.子目标.目标宿主,
            记录.子目标.目标特征, 记录.子目标.目标状态合同});
        const auto 子组 = 需求服务_.读取需求直接子(
            {头, L2读取类别::当前, 记录.父需求, 0});
        if (!列表查询.成功() || !子组.成功())
            return 失败(需求任务子目标承接状态::内部不一致);
        std::vector<std::pair<L2需求事实, L2需求父子关系事实>> 匹配子组;
        for (std::size_t 索引 = 0; 索引 < 子组.直接子需求组.size(); ++索引) {
            const auto 子完整 = 需求服务_.读取需求完整({头,
                L2读取类别::当前, 子组.直接子需求组[索引].身份, 0});
            if (!子完整.成功() || !子完整.需求)
                return 失败(需求任务子目标承接状态::内部不一致);
            if (目标相同(*子完整.需求, 记录))
                匹配子组.push_back({*子完整.需求, 子组.直接子关系组[索引]});
        }
        if (匹配子组.size() > 1 || 列表查询.列表项组.size() > 1)
            return 失败(需求任务子目标承接状态::内部不一致);

        需求任务子目标承接来源 来源分类;
        std::optional<需求侧材料> 需求材料;
        if (匹配子组.size() == 1) {
            if (匹配子组.front().second.顺序 != 请求.父子顺序)
                return 失败(需求任务子目标承接状态::父子顺序冲突);
            const auto 成员 = 需求服务_.读取需求成员列表({头,
                L2读取类别::当前, 匹配子组.front().first.身份, 0});
            if (!成员.成功() || !成员.当前成员关系
                || !列表查询.唯一结果()
                || 成员.当前成员关系->列表项 != 列表查询.列表项组.front().身份)
                return 失败(需求任务子目标承接状态::目标冲突);
            const auto 写入 = 需求服务_.为既有需求建立任务子目标来源({头,
                请求.需求发布幂等身份, 匹配子组.front().first.身份,
                成员.当前成员关系->列表项, 记录.父需求, 请求.父子顺序,
                请求.记录.值, L2需求任务子目标记录引用{请求.记录.值}});
            if (!写入.成功()) return 失败(映射状态(写入.结果头.状态));
            需求材料 = 提取写结果(写入);
            来源分类 = 需求任务子目标承接来源::复用当前子需求;
        } else if (列表查询.唯一结果()) {
            const auto 写入 = 需求服务_.新增需求并加入既有列表项及任务子目标来源(
                {头, 请求.需求发布幂等身份, 列表查询.列表项组.front().身份,
                    记录.父需求, 请求.父子顺序, 请求.记录.值,
                    L2需求任务子目标记录引用{请求.记录.值}});
            if (!写入.成功()) return 失败(映射状态(写入.结果头.状态));
            需求材料 = 提取写结果(写入);
            来源分类 = 需求任务子目标承接来源::复用列表项并新建子需求;
        } else {
            const auto 写入 = 需求服务_.新增需求并建立列表项及任务子目标来源(
                {头, 请求.需求发布幂等身份, 父.需求->所属存在,
                    记录.子目标.目标宿主, 记录.子目标.目标特征,
                    记录.子目标.目标状态合同, 记录.父需求, 请求.父子顺序,
                    请求.记录.值, L2需求任务子目标记录引用{请求.记录.值}});
            if (!写入.成功()) return 失败(映射状态(写入.结果头.状态));
            需求材料 = 提取写结果(写入);
            来源分类 = 需求任务子目标承接来源::新建列表项与子需求;
        }
        if (!需求材料) return 失败(需求任务子目标承接状态::内部不一致);
        const L2绑定任务子目标承接记录子需求请求 绑定{
            {L2结构合同版本, 需求材料->事实截止}, 请求.任务绑定幂等身份,
            请求.记录, 需求材料->子需求.身份};
        const auto 绑定结果 = 记录服务_.绑定任务子目标承接记录子需求(绑定);
        if (绑定结果.结果头.状态 == L2结构状态::事实代次漂移
            || 绑定结果.结果头.状态 == L2结构状态::资源失败)
            return 形成等待(来源分类, *需求材料, 绑定);
        if (!绑定结果.成功()) return 失败(映射状态(绑定结果.结果头.状态));
        return 最终读回(需求服务_, 记录服务_, 请求.记录, 来源分类,
            绑定结果.结果头.状态 == L2结构状态::已提交
                ? 需求任务子目标承接状态::已承接
                : 需求任务子目标承接状态::精确重复,
            绑定结果.结果头.事实截止代次);
    } catch (const std::bad_alloc&) {
        return 失败(需求任务子目标承接状态::资源失败);
    } catch (...) {
        return 失败(需求任务子目标承接状态::内部不一致);
    }
}

} // namespace 海中鱼巣
