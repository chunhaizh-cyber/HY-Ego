namespace 海中鱼巣::安全根定义内部 {

inline constexpr L1所有者范围写入幂等身份 登记写入幂等身份{
    0x494E'5354'5341'4601ULL};
inline constexpr L1所有者范围写集本地键 登记锚点键{0x0307'1201U};
inline constexpr L1所有者范围写集本地键 当前定义节点键{0x0307'1202U};
inline constexpr L1所有者范围写集本地键 当前定义属性类型键{0x0307'1203U};
inline constexpr L1所有者范围写集本地键 定义值键{0x0307'1204U};

struct 登记定位 final {
    稳定编码 登记锚点{};
    稳定编码 当前定义节点{};
    稳定编码 当前定义属性类型{};

    bool 完整() const noexcept {
        return 有效(登记锚点) && 有效(当前定义节点)
            && 有效(当前定义属性类型)
            && 登记锚点 != 当前定义节点
            && 登记锚点 != 当前定义属性类型
            && 当前定义节点 != 当前定义属性类型;
    }
};

inline std::optional<稳定编码> 查找映射(
    const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 键) noexcept {
    std::optional<稳定编码> 命中;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键 != 键) continue;
        if (命中) return std::nullopt;
        命中 = 编码;
    }
    return 命中;
}

inline std::optional<登记定位> 投影登记定位(
    const L1所有者范围首次写入读取结果& 首次,
    L1结构所有者身份 所有者) noexcept {
    if (首次.状态 != L1所有者范围读取状态::成功
        || 首次.合同版本 != L1所有者范围首次写入读取合同版本
        || 首次.所有者 != 所有者
        || 首次.写入幂等身份 != 登记写入幂等身份
        || !首次.首次规范化写集 || !首次.首次写入结果)
        return std::nullopt;
    const auto& 请求 = *首次.首次规范化写集;
    const auto& 结果 = *首次.首次写入结果;
    if (请求.合同版本 != L1所有者范围CRUD合同版本
        || 请求.写入幂等身份 != 登记写入幂等身份
        || 请求.节点.size() != 3 || !请求.关系.empty()
        || !请求.值.empty() || !请求.属性槽变更.empty()
        || !请求.退出事实.empty()
        || 结果.状态 != L1所有者范围写入状态::成功
        || 结果.合同版本 != L1所有者范围CRUD合同版本
        || 结果.所有者 != 所有者
        || 结果.写入幂等身份 != 登记写入幂等身份
        || 结果.事实代次 == 0 || !结果.是否形成内存权威发布)
        return std::nullopt;
    if (请求.节点[0] != L1所有者范围节点新建项{
            登记锚点键, 节点种类::普通, std::nullopt}
        || 请求.节点[1] != L1所有者范围节点新建项{
            当前定义节点键, 节点种类::普通, std::nullopt}
        || 请求.节点[2] != L1所有者范围节点新建项{
            当前定义属性类型键, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组})
        return std::nullopt;
    const auto 锚点 = 查找映射(结果, 登记锚点键);
    const auto 节点 = 查找映射(结果, 当前定义节点键);
    const auto 类型 = 查找映射(结果, 当前定义属性类型键);
    if (!锚点 || !节点 || !类型) return std::nullopt;
    登记定位 定位{*锚点, *节点, *类型};
    return 定位.完整() ? std::optional<登记定位>{定位} : std::nullopt;
}

inline std::vector<std::uint64_t> 编码定义(
    const 发布安全根定义请求_v1& 请求) {
    return {请求.本能根锚点.唯一自我.值.值,
        请求.本能根锚点.安全根特征定义.值.值,
        请求.本能根锚点.安全根特征实例.值.值,
        static_cast<std::uint64_t>(请求.低位阈值),
        static_cast<std::uint64_t>(请求.高位阈值),
        请求.新定义版本, 请求.主动安全结算规则版本,
        请求.被动服务维护规则版本, 请求.来源稳定编码.值};
}

inline std::optional<安全根定义事实_v1> 解码定义(
    const L1所有者范围值事实& 值, const 登记定位& 定位,
    L1结构所有者身份 所有者) noexcept {
    const auto* 材料 = std::get_if<std::vector<std::uint64_t>>(&值.材料);
    if (!材料 || 材料->size() != 9 || 值.写入所有者 != 所有者
        || 值.所属节点 != 定位.当前定义节点
        || 值.属性类型节点 != 定位.当前定义属性类型
        || 值.来源节点 != 定位.登记锚点
        || 值.创建事实代次 == 0
        || (*材料)[0] == 0 || (*材料)[1] == 0 || (*材料)[2] == 0
        || (*材料)[3] > static_cast<std::uint64_t>(INT64_MAX)
        || (*材料)[4] > static_cast<std::uint64_t>(INT64_MAX)
        || (*材料)[5] == 0 || (*材料)[5] > UINT32_MAX
        || (*材料)[6] == 0 || (*材料)[6] > UINT32_MAX
        || (*材料)[7] == 0 || (*材料)[7] > UINT32_MAX
        || (*材料)[8] == 0)
        return std::nullopt;
    安全根定义事实_v1 定义;
    定义.身份 = {值.编码};
    定义.自我 = L2存在身份{稳定编码{(*材料)[0]}};
    定义.安全根特征定义 = L2特征定义身份{稳定编码{(*材料)[1]}};
    定义.安全根特征实例 = L2特征实例身份{稳定编码{(*材料)[2]}};
    定义.低位阈值 = static_cast<std::int64_t>((*材料)[3]);
    定义.高位阈值 = static_cast<std::int64_t>((*材料)[4]);
    定义.定义版本 = static_cast<std::uint32_t>((*材料)[5]);
    定义.主动安全结算规则版本 = static_cast<std::uint32_t>((*材料)[6]);
    定义.被动服务维护规则版本 = static_cast<std::uint32_t>((*材料)[7]);
    定义.来源稳定编码 = 稳定编码{(*材料)[8]};
    定义.形成事实代次 = 值.创建事实代次;
    return 安全根定义事实完整_v1(定义)
        ? std::optional<安全根定义事实_v1>{定义} : std::nullopt;
}

} // namespace 海中鱼巣::安全根定义内部

export namespace 海中鱼巣 {

class 安全根定义与当前值服务;

class 安全根定义所有者交付_v1 final {
public:
    安全根定义所有者交付_v1() = delete;
    安全根定义所有者交付_v1(const 安全根定义所有者交付_v1&) = delete;
    安全根定义所有者交付_v1& operator=(
        const 安全根定义所有者交付_v1&) = delete;
    安全根定义所有者交付_v1(安全根定义所有者交付_v1&&) noexcept = default;
    安全根定义所有者交付_v1& operator=(安全根定义所有者交付_v1&&) = delete;

private:
    安全根定义所有者交付_v1(L1结构所有者事实 所有者事实,
        L1所有者范围写端口&& 写入端口) noexcept
        : 所有者事实_(所有者事实), 写入端口_(std::move(写入端口)) {}

    L1结构所有者事实 所有者事实_{};
    L1所有者范围写端口 写入端口_;

    friend std::optional<安全根定义所有者交付_v1>
    尝试形成安全根定义所有者交付_v1(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class 安全根定义与当前值服务;
};

std::optional<安全根定义所有者交付_v1>
尝试形成安全根定义所有者交付_v1(
    const L1事实基座服务& 第一层服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        if (!原始交付.建立结果.所有者事实 || !原始交付.写入端口)
            return std::nullopt;
        const auto& 建立 = 原始交付.建立结果;
        const auto& 事实 = *建立.所有者事实;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 安全根定义所有者建立身份_v1
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !有效(事实.所有者) || 事实.退出事实代次
            || 事实.范围种类 != L1所有者范围种类::独占结构范围
            || 原始交付.写入端口->所有者身份() != 事实.所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层服务))
            return std::nullopt;
        const auto 当前 = 第一层服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 事实.所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 事实.所有者
            || !当前.所有者事实 || *当前.所有者事实 != 事实)
            return std::nullopt;
        return 安全根定义所有者交付_v1{
            事实, std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class 安全根定义与当前值服务 final {
public:
    安全根定义与当前值服务() = delete;
    安全根定义与当前值服务(const 安全根定义与当前值服务&) = delete;
    安全根定义与当前值服务& operator=(const 安全根定义与当前值服务&) = delete;

    安全根定义与当前值服务(const L1事实基座服务& 第一层服务,
        const L2特征结构服务& 特征服务,
        安全根定义所有者交付_v1&& 交付)
        : 第一层服务_(第一层服务), 特征服务_(特征服务),
          所有者事实_(交付.所有者事实_), 写入端口_(std::move(交付.写入端口_)) {
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || 写入端口_.所有者身份() != 所有者事实_.所有者)
            throw std::invalid_argument("安全根定义 owner 交付无效");
    }

#if defined(ARCH_INSTINCT_SAFETY_DEFINITION_VALIDATION)
    void ARCH_注入发布提交后首次读回失败一次() noexcept {
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        ARCH_发布提交后首次读回失败一次_ = true;
    }

    void ARCH_注入当前值坏材料一次() noexcept {
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        ARCH_当前值坏材料一次_ = true;
    }

    void ARCH_注入组合读取后守卫发布一次(
        发布安全根定义请求_v1 请求) noexcept {
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        ARCH_组合读取后守卫发布请求_ = std::move(请求);
    }
#endif

    安全根定义发布结果_v1 发布安全根定义_v1(
        const 发布安全根定义请求_v1& 请求) noexcept {
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        const auto 失败 = [&](安全根定义发布状态_v1 状态,
                            std::uint64_t 首次提交 = 0) {
            安全根定义发布结果_v1 结果;
            结果.状态 = 状态;
            结果.幂等身份 = 请求.幂等身份;
            结果.首次提交事实代次 = 首次提交;
            return 结果;
        };
        if (!发布请求有效(请求))
            return 失败(安全根定义发布状态_v1::入口拒绝);
        try {
            const auto 重放 = 写入端口_.读取首次写入材料({
                L1所有者范围首次写入读取合同版本, {请求.幂等身份.值}});
            if (重放.状态 == L1所有者范围读取状态::成功) {
                if (!重放.首次规范化写集 || !重放.首次写入结果)
                    return 失败(安全根定义发布状态_v1::内部错误);
                const auto* 首次材料 = 重放定义材料(*重放.首次规范化写集);
                if (!首次材料 || *首次材料 != 安全根定义内部::编码定义(请求))
                    return 失败(安全根定义发布状态_v1::幂等冲突);
                const auto 身份 = 安全根定义内部::查找映射(
                    *重放.首次写入结果, 安全根定义内部::定义值键);
                if (!身份 || !确保登记定位只读())
                    return 失败(安全根定义发布状态_v1::内部错误);
                const auto 历史 = 第一层服务_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, *身份});
                const auto* 值 = 历史.状态 == L1所有者范围读取状态::成功
                    && 历史.事实 ? std::get_if<L1所有者范围值事实>(&*历史.事实)
                    : nullptr;
                const auto 定义 = 值 ? 安全根定义内部::解码定义(
                    *值, *定位_, 所有者事实_.所有者) : std::nullopt;
                const auto Gread = 读取当前代次();
                if (!定义 || !Gread)
                    return 失败(安全根定义发布状态_v1::已可能发布,
                        重放.首次写入结果->事实代次);
                安全根定义发布结果_v1 结果;
                结果.状态 = 安全根定义发布状态_v1::精确重复;
                结果.幂等身份 = 请求.幂等身份;
                结果.定义 = *定义;
                结果.首次提交事实代次 = 重放.首次写入结果->事实代次;
                结果.本次正式读回截止 = *Gread;
                return 结果.成功() ? 结果
                    : 失败(安全根定义发布状态_v1::内部错误);
            }
            if (重放.状态 != L1所有者范围读取状态::未找到)
                return 失败(映射首次读取失败(重放.状态));

            const auto G0 = 读取当前代次();
            if (!G0 || *G0 != 请求.请求头.期望事实代次)
                return 失败(安全根定义发布状态_v1::当前性漂移);
            if (!锚点绑定有效(请求.本能根锚点, *G0))
                return 失败(安全根定义发布状态_v1::引用冲突);
            const auto 登记状态 = 确保登记(*G0);
            if (登记状态 != 安全根定义发布状态_v1::精确重复)
                return 失败(登记状态);

            const auto Gcurrent = 读取当前代次();
            if (!Gcurrent)
                return 失败(安全根定义发布状态_v1::内部错误);
            const auto 当前 = 读取当前安全根定义_v1({
                安全根定义合同版本_v1, {L2结构合同版本, *Gcurrent},
                请求.本能根锚点});
            if (当前.成功()) {
                if (!当前.定义 || 请求.新定义版本 != 当前.定义->定义版本 + 1)
                    return 失败(安全根定义发布状态_v1::版本漂移);
            } else if (当前.状态 == 安全根定义读取状态_v1::未发布) {
                if (请求.新定义版本 != 1)
                    return 失败(安全根定义发布状态_v1::版本漂移);
            } else {
                return 失败(映射定义读取失败(当前.状态));
            }

            const auto Gwrite = 读取当前代次();
            if (!Gwrite)
                return 失败(安全根定义发布状态_v1::内部错误);
            L1所有者范围写集请求 写入请求;
            写入请求.期望事实代次 = *Gwrite;
            写入请求.写入幂等身份 = {请求.幂等身份.值};
            写入请求.值 = {{安全根定义内部::定义值键,
                定位_->当前定义节点, 定位_->当前定义属性类型,
                安全根定义内部::编码定义(请求), 定位_->登记锚点}};
            写入请求.属性槽变更 = {{定位_->当前定义节点,
                定位_->当前定义属性类型, 安全根定义内部::定义值键}};
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写入请求);
            if (写入.状态 != L1所有者范围写入状态::成功
                && 写入.状态 != L1所有者范围写入状态::精确重复) {
                const auto 状态 = 映射写入失败(写入);
                return 失败(状态, 状态 == 安全根定义发布状态_v1::已可能发布
                    ? 写入.事实代次 : 0);
            }
            const bool 成功写 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布;
            const bool 重复写 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布;
            if (写入.事实代次 == 0 || (!成功写 && !重复写))
                return 失败(安全根定义发布状态_v1::内部错误);
#if defined(ARCH_INSTINCT_SAFETY_DEFINITION_VALIDATION)
            if (ARCH_发布提交后首次读回失败一次_) {
                ARCH_发布提交后首次读回失败一次_ = false;
                return 失败(安全根定义发布状态_v1::已可能发布,
                    写入.事实代次);
            }
#endif
            const auto 正式 = 读取当前安全根定义_v1({
                安全根定义合同版本_v1,
                {L2结构合同版本, 写入.事实代次}, 请求.本能根锚点});
            if (!正式.成功() || !正式.定义
                || !定义等于请求(*正式.定义, 请求))
                return 失败(安全根定义发布状态_v1::已可能发布,
                    写入.事实代次);
            安全根定义发布结果_v1 结果;
            结果.状态 = 写入.状态 == L1所有者范围写入状态::成功
                ? 安全根定义发布状态_v1::已发布
                : 安全根定义发布状态_v1::精确重复;
            结果.幂等身份 = 请求.幂等身份;
            结果.定义 = *正式.定义;
            结果.首次提交事实代次 = 写入.事实代次;
            结果.本次正式读回截止 = 正式.本次正式读回截止;
            return 结果.成功() ? 结果
                : 失败(安全根定义发布状态_v1::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(安全根定义发布状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(安全根定义发布状态_v1::资源失败);
        } catch (...) {
            return 失败(安全根定义发布状态_v1::内部错误);
        }
    }

    安全根定义读取结果_v1 读取当前安全根定义_v1(
        const 安全根定义读取请求_v1& 请求) const noexcept {
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        const auto 失败 = [](安全根定义读取状态_v1 状态) {
            安全根定义读取结果_v1 结果;
            结果.状态 = 状态;
            return 结果;
        };
        if (!读取请求有效(请求))
            return 失败(安全根定义读取状态_v1::入口拒绝);
        try {
            const auto Gread = 请求.请求头.期望事实代次;
            const auto 前 = 读取当前代次();
            if (!前 || *前 != Gread)
                return 失败(安全根定义读取状态_v1::当前性漂移);
            if (!锚点绑定有效(请求.本能根锚点, Gread))
                return 失败(安全根定义读取状态_v1::引用冲突);
            if (!确保登记定位只读())
                return 失败(安全根定义读取状态_v1::未发布);
            const auto 节点读 = 第一层服务_.读取所有者范围当前节点(
                {L1所有者范围CRUD合同版本, 定位_->当前定义节点});
            if (节点读.状态 != L1所有者范围读取状态::成功
                || 节点读.读取事实代次 != Gread || !节点读.事实)
                return 失败(节点读.状态 == L1所有者范围读取状态::资源失败
                    ? 安全根定义读取状态_v1::资源失败
                    : 安全根定义读取状态_v1::内部错误);
            const auto* 节点 = std::get_if<L1所有者范围节点事实>(&*节点读.事实);
            if (!节点 || 节点->编码 != 定位_->当前定义节点
                || 节点->写入所有者 != 所有者事实_.所有者
                || 节点->退出事实代次)
                return 失败(安全根定义读取状态_v1::引用冲突);
            std::optional<稳定编码> 当前值;
            for (const auto& 槽 : 节点->当前属性) {
                if (槽.属性类型节点 != 定位_->当前定义属性类型) continue;
                if (当前值)
                    return 失败(安全根定义读取状态_v1::引用冲突);
                当前值 = 槽.当前值;
            }
            if (!当前值) return 失败(安全根定义读取状态_v1::未发布);
            const auto 值读 = 第一层服务_.读取所有者范围当前值(
                {L1所有者范围CRUD合同版本, *当前值});
            if (值读.状态 != L1所有者范围读取状态::成功
                || 值读.读取事实代次 != Gread || !值读.事实)
                return 失败(值读.状态 == L1所有者范围读取状态::资源失败
                    ? 安全根定义读取状态_v1::资源失败
                    : 安全根定义读取状态_v1::内部错误);
            const auto* 值 = std::get_if<L1所有者范围值事实>(&*值读.事实);
            const auto 定义 = 值 ? 安全根定义内部::解码定义(
                *值, *定位_, 所有者事实_.所有者) : std::nullopt;
            if (!定义 || 定义->自我 != 请求.本能根锚点.唯一自我
                || 定义->安全根特征定义
                    != 请求.本能根锚点.安全根特征定义
                || 定义->安全根特征实例
                    != 请求.本能根锚点.安全根特征实例)
                return 失败(安全根定义读取状态_v1::引用冲突);
            const auto 后 = 读取当前代次();
            if (!后 || *后 != Gread)
                return 失败(安全根定义读取状态_v1::当前性漂移);
            安全根定义读取结果_v1 结果;
            结果.状态 = 安全根定义读取状态_v1::已读取;
            结果.定义 = *定义;
            结果.本次正式读回截止 = Gread;
            return 结果.成功() ? 结果
                : 失败(安全根定义读取状态_v1::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(安全根定义读取状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(安全根定义读取状态_v1::资源失败);
        } catch (...) {
            return 失败(安全根定义读取状态_v1::内部错误);
        }
    }

    安全根定义与当前值读取结果_v1 读取安全根定义与当前值_v1(
        const 安全根定义与当前值读取请求_v1& 请求) const noexcept {
        std::lock_guard<std::recursive_mutex> 锁(互斥体_);
        const auto 失败 = [](安全根定义与当前值读取状态_v1 状态) {
            安全根定义与当前值读取结果_v1 结果;
            结果.状态 = 状态;
            return 结果;
        };
        if (请求.合同版本 != 安全根定义合同版本_v1
            || 请求.请求头.合同版本 != L2结构合同版本
            || 请求.请求头.期望事实代次 == 0 || !请求.本能根锚点.完整())
            return 失败(安全根定义与当前值读取状态_v1::入口拒绝);
        try {
            const auto Gread = 请求.请求头.期望事实代次;
            const auto 前 = 读取当前代次();
            if (!前 || *前 != Gread)
                return 失败(安全根定义与当前值读取状态_v1::当前性漂移);
            const auto 定义 = 读取当前安全根定义_v1({
                安全根定义合同版本_v1, 请求.请求头, 请求.本能根锚点});
            if (!定义.成功() || !定义.定义)
                return 失败(映射组合定义失败(定义.状态));
            const auto 当前值 = 特征服务_.读取特征当前值({
                请求.请求头, 请求.本能根锚点.安全根特征实例});
            if (当前值.结果头.状态 != L2结构状态::已读取
                || 当前值.结果头.事实截止代次 != Gread || !当前值.当前值)
                return 失败(映射当前值失败(当前值.结果头.状态));
#if defined(ARCH_INSTINCT_SAFETY_DEFINITION_VALIDATION)
            if (ARCH_当前值坏材料一次_) {
                ARCH_当前值坏材料一次_ = false;
                return 失败(安全根定义与当前值读取状态_v1::引用冲突);
            }
#endif
            const auto* A = std::get_if<std::int64_t>(
                &当前值.当前值->类型化不可变材料);
            if (!A || *A < 0 || *A > 本能根I64最大目标_v1
                || 当前值.当前值->特征实例
                    != 请求.本能根锚点.安全根特征实例
                || 当前值.当前值->生命周期.退出事实代次)
                return 失败(安全根定义与当前值读取状态_v1::引用冲突);
#if defined(ARCH_INSTINCT_SAFETY_DEFINITION_VALIDATION)
            if (ARCH_组合读取后守卫发布请求_) {
                auto 发布请求 = std::move(*ARCH_组合读取后守卫发布请求_);
                ARCH_组合读取后守卫发布请求_.reset();
                const auto 发布 = const_cast<安全根定义与当前值服务*>(this)
                    ->发布安全根定义_v1(发布请求);
                if (!发布.成功())
                    return 失败(安全根定义与当前值读取状态_v1::内部错误);
            }
#endif
            const auto 后 = 读取当前代次();
            if (!后 || *后 != Gread)
                return 失败(安全根定义与当前值读取状态_v1::当前性漂移);
            安全根定义与当前值快照_v1 快照{
                *定义.定义, *当前值.当前值, *A, Gread};
            安全根定义与当前值读取结果_v1 结果;
            结果.状态 = 安全根定义与当前值读取状态_v1::已读取;
            结果.快照 = std::move(快照);
            结果.本次正式读回截止 = Gread;
            return 结果.成功() ? 结果
                : 失败(安全根定义与当前值读取状态_v1::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(安全根定义与当前值读取状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(安全根定义与当前值读取状态_v1::资源失败);
        } catch (...) {
            return 失败(安全根定义与当前值读取状态_v1::内部错误);
        }
    }

private:
    static bool 发布请求有效(const 发布安全根定义请求_v1& 请求) noexcept {
        return 请求.合同版本 == 安全根定义合同版本_v1
            && 请求.请求头.合同版本 == L2结构合同版本
            && 请求.请求头.期望事实代次 != 0
            && L2结构幂等身份有效(请求.幂等身份)
            && 请求.本能根锚点.完整()
            && 请求.低位阈值 > 1 && 请求.低位阈值 < 请求.高位阈值
            && 请求.高位阈值 <= 本能根I64最大目标_v1
            && 请求.新定义版本 != 0
            && 请求.主动安全结算规则版本 != 0
            && 请求.被动服务维护规则版本 != 0
            && 有效(请求.来源稳定编码);
    }

    static bool 读取请求有效(const 安全根定义读取请求_v1& 请求) noexcept {
        return 请求.合同版本 == 安全根定义合同版本_v1
            && 请求.请求头.合同版本 == L2结构合同版本
            && 请求.请求头.期望事实代次 != 0
            && 请求.本能根锚点.完整();
    }

    std::optional<std::uint64_t> 读取当前代次() const noexcept {
        const auto 结果 = 第一层服务_.读取中性当前事实代次({L1中性CRUD合同版本});
        return 结果.状态 == L1中性读取状态::成功 && 结果.事实代次 != 0
            ? std::optional<std::uint64_t>{结果.事实代次} : std::nullopt;
    }

    bool 锚点绑定有效(const 本能根运行锚点_v1& 锚点,
        std::uint64_t G) const noexcept {
        if (!锚点.完整() || 锚点.事实截止代次 > G) return false;
        const auto 读取 = 特征服务_.读取完整特征实例({
            {L2结构合同版本, G}, L2读取类别::当前,
            锚点.安全根特征实例, 0});
        return 读取.结果头.状态 == L2结构状态::已读取
            && 读取.结果头.事实截止代次 == G && 读取.特征实例
            && 读取.特征实例->身份 == 锚点.安全根特征实例
            && 读取.特征实例->宿主存在 == 锚点.唯一自我
            && 读取.特征实例->特征定义 == 锚点.安全根特征定义
            && !读取.特征实例->生命周期.退出事实代次;
    }

    安全根定义发布状态_v1 确保登记(std::uint64_t G0) {
        if (确保登记定位只读()) return 安全根定义发布状态_v1::精确重复;
        L1所有者范围写集请求 请求;
        请求.期望事实代次 = G0;
        请求.写入幂等身份 = 安全根定义内部::登记写入幂等身份;
        请求.节点 = {
            {安全根定义内部::登记锚点键, 节点种类::普通, std::nullopt},
            {安全根定义内部::当前定义节点键, 节点种类::普通, std::nullopt},
            {安全根定义内部::当前定义属性类型键, 节点种类::属性类型,
                L1所有者范围值表示种类::U64组}};
        const auto 写入 = 写入端口_.提交所有者范围中性写集(请求);
        if (写入.状态 != L1所有者范围写入状态::成功
            && 写入.状态 != L1所有者范围写入状态::精确重复)
            return 映射写入失败(写入);
        return 确保登记定位只读()
            ? 安全根定义发布状态_v1::精确重复
            : 安全根定义发布状态_v1::已可能发布;
    }

    bool 确保登记定位只读() const {
        if (定位_ && 定位_->完整()) return true;
        const auto 首次 = 写入端口_.读取首次写入材料({
            L1所有者范围首次写入读取合同版本,
            安全根定义内部::登记写入幂等身份});
        const auto 定位 = 安全根定义内部::投影登记定位(
            首次, 所有者事实_.所有者);
        if (!定位) return false;
        定位_ = *定位;
        return true;
    }

    static const std::vector<std::uint64_t>* 重放定义材料(
        const L1所有者范围写集请求& 写集) noexcept {
        if (写集.值.size() != 1 || 写集.属性槽变更.size() != 1
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.退出事实.empty()) return nullptr;
        return std::get_if<std::vector<std::uint64_t>>(&写集.值[0].材料);
    }

    static bool 定义等于请求(const 安全根定义事实_v1& 定义,
        const 发布安全根定义请求_v1& 请求) noexcept {
        return 定义.自我 == 请求.本能根锚点.唯一自我
            && 定义.安全根特征定义 == 请求.本能根锚点.安全根特征定义
            && 定义.安全根特征实例 == 请求.本能根锚点.安全根特征实例
            && 定义.低位阈值 == 请求.低位阈值
            && 定义.高位阈值 == 请求.高位阈值
            && 定义.定义版本 == 请求.新定义版本
            && 定义.主动安全结算规则版本 == 请求.主动安全结算规则版本
            && 定义.被动服务维护规则版本 == 请求.被动服务维护规则版本
            && 定义.来源稳定编码 == 请求.来源稳定编码;
    }

    static 安全根定义发布状态_v1 映射首次读取失败(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::许可拒绝:
            return 安全根定义发布状态_v1::许可拒绝;
        case L1所有者范围读取状态::事实代次漂移:
            return 安全根定义发布状态_v1::当前性漂移;
        case L1所有者范围读取状态::资源失败:
            return 安全根定义发布状态_v1::资源失败;
        default: return 安全根定义发布状态_v1::内部错误;
        }
    }

    static 安全根定义发布状态_v1 映射写入失败(
        const L1所有者范围写入结果& 结果) noexcept {
        switch (结果.状态) {
        case L1所有者范围写入状态::入口拒绝:
            return 安全根定义发布状态_v1::入口拒绝;
        case L1所有者范围写入状态::许可拒绝:
            return 安全根定义发布状态_v1::许可拒绝;
        case L1所有者范围写入状态::事实代次漂移:
            return 安全根定义发布状态_v1::当前性漂移;
        case L1所有者范围写入状态::幂等冲突:
            return 安全根定义发布状态_v1::幂等冲突;
        case L1所有者范围写入状态::引用冲突:
        case L1所有者范围写入状态::未找到:
        case L1所有者范围写入状态::已退出:
            return 安全根定义发布状态_v1::引用冲突;
        case L1所有者范围写入状态::资源失败:
            return 安全根定义发布状态_v1::资源失败;
        case L1所有者范围写入状态::内部不一致:
            return 结果.事实代次 != 0
                ? 安全根定义发布状态_v1::已可能发布
                : 安全根定义发布状态_v1::内部错误;
        default: return 安全根定义发布状态_v1::内部错误;
        }
    }

    static 安全根定义发布状态_v1 映射定义读取失败(
        安全根定义读取状态_v1 状态) noexcept {
        switch (状态) {
        case 安全根定义读取状态_v1::许可拒绝:
            return 安全根定义发布状态_v1::许可拒绝;
        case 安全根定义读取状态_v1::当前性漂移:
            return 安全根定义发布状态_v1::当前性漂移;
        case 安全根定义读取状态_v1::引用冲突:
            return 安全根定义发布状态_v1::引用冲突;
        case 安全根定义读取状态_v1::资源失败:
            return 安全根定义发布状态_v1::资源失败;
        default: return 安全根定义发布状态_v1::内部错误;
        }
    }

    static 安全根定义与当前值读取状态_v1 映射组合定义失败(
        安全根定义读取状态_v1 状态) noexcept {
        switch (状态) {
        case 安全根定义读取状态_v1::未发布:
            return 安全根定义与当前值读取状态_v1::定义未发布;
        case 安全根定义读取状态_v1::入口拒绝:
            return 安全根定义与当前值读取状态_v1::入口拒绝;
        case 安全根定义读取状态_v1::许可拒绝:
            return 安全根定义与当前值读取状态_v1::许可拒绝;
        case 安全根定义读取状态_v1::当前性漂移:
            return 安全根定义与当前值读取状态_v1::当前性漂移;
        case 安全根定义读取状态_v1::引用冲突:
            return 安全根定义与当前值读取状态_v1::引用冲突;
        case 安全根定义读取状态_v1::资源失败:
            return 安全根定义与当前值读取状态_v1::资源失败;
        default: return 安全根定义与当前值读取状态_v1::内部错误;
        }
    }

    static 安全根定义与当前值读取状态_v1 映射当前值失败(
        L2结构状态 状态) noexcept {
        switch (状态) {
        case L2结构状态::未找到:
        case L2结构状态::属性未设置:
            return 安全根定义与当前值读取状态_v1::当前值未设置;
        case L2结构状态::入口拒绝:
            return 安全根定义与当前值读取状态_v1::入口拒绝;
        case L2结构状态::许可拒绝:
            return 安全根定义与当前值读取状态_v1::许可拒绝;
        case L2结构状态::事实代次漂移:
            return 安全根定义与当前值读取状态_v1::当前性漂移;
        case L2结构状态::引用冲突:
        case L2结构状态::已退出:
            return 安全根定义与当前值读取状态_v1::引用冲突;
        case L2结构状态::资源失败:
            return 安全根定义与当前值读取状态_v1::资源失败;
        default: return 安全根定义与当前值读取状态_v1::内部错误;
        }
    }

    const L1事实基座服务& 第一层服务_;
    const L2特征结构服务& 特征服务_;
    L1结构所有者事实 所有者事实_{};
    L1所有者范围写端口 写入端口_;
    mutable std::optional<安全根定义内部::登记定位> 定位_;
    mutable std::recursive_mutex 互斥体_;
#if defined(ARCH_INSTINCT_SAFETY_DEFINITION_VALIDATION)
    bool ARCH_发布提交后首次读回失败一次_ = false;
    mutable bool ARCH_当前值坏材料一次_ = false;
    mutable std::optional<发布安全根定义请求_v1>
        ARCH_组合读取后守卫发布请求_{};
#endif
};

} // namespace 海中鱼巣
