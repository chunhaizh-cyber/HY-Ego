module;

#include <algorithm>
#include <array>
#include <atomic>
#include <cstdint>
#include <optional>
#include <thread>
#include <type_traits>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.自检.L1状态;

import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1场景结构;
import 海中鱼巣.领域.服务.L1特征定义;
import 海中鱼巣.领域.服务.L1实际存在;
import 海中鱼巣.领域.组合.L1实际存在场景;
import 海中鱼巣.领域.服务.L1实例特征;
import 海中鱼巣.领域.服务.L1状态;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

template<class T>
concept 含特征定义字段 = requires(T 事实) { 事实.特征定义; };

template<class T>
concept 含P12禁入字段 = requires(T 请求) {
    请求.前状态; 请求.候选; 请求.事实截止; 请求.算法;
    请求.注册; 请求.动态; 请求.许可; 请求.事务;
};

namespace L1状态自检内部 {

稳定编码 找编码(const L1写入结果& 结果, std::uint32_t 键) {
    for (const auto& [本地, 编码] : 结果.新编码映射)
        if (本地.值 == 键) return 编码;
    return {};
}

struct P12夹具 final {
    L1事实基座服务 L1;
    世界登记服务 世界{L1};
    L1场景结构服务 场景{L1, 世界};
    L1特征定义服务 定义{L1};
    L1实际存在服务 存在{L1};
    L1实际存在场景组合服务 组合{L1, 存在, 场景};
    L1实例特征服务 实例{L1, 场景, 定义, 组合};
    L1状态服务 状态{L1, 组合, 实例};
    L1状态结构登记 登记;
    稳定编码 主体;
    稳定编码 场景节点;
    稳定编码 实例槽;
    稳定编码 采样值;
    稳定编码 采样值类型;

    bool 初始化(std::uint64_t 身份偏移) {
        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0xA100 + 身份偏移};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        if (世界结果.状态 != 世界登记状态::已提交 || !世界结果.登记) return false;
        L1状态登记请求 登记请求;
        登记请求.幂等身份 = {0xA200 + 身份偏移};
        登记请求.期望事实代次 = 世界结果.登记->已验证事实代次;
        const auto 登记结果 = 状态.建立登记(登记请求);
        if (登记结果.状态 != L1基准状态状态::已提交 || !登记结果.登记) return false;
        登记 = *登记结果.登记;
        L1写集请求 基础;
        基础.期望事实代次 = 登记.事实截止代次;
        基础.幂等键 = {0xFC00000000000000ULL + 身份偏移};
        基础.节点 = {{{1}, 节点种类::普通, std::nullopt},
            {{2}, 节点种类::普通, std::nullopt}, {{3}, 节点种类::普通, std::nullopt},
            {{4}, 节点种类::属性类型, 值表示种类::I64}};
        基础.值 = {{{5}, 写集本地键{3}, 写集本地键{4}, std::int64_t{12}, 写集本地键{1}}};
        基础.属性槽变更 = {{写集本地键{3}, 写集本地键{4}, 写集本地键{5}}};
        const auto 写入 = L1.提交写集(基础);
        if (写入.状态 != L1写入状态::成功 || 写入.新编码映射.size() != 5) return false;
        主体 = 找编码(写入, 1); 场景节点 = 找编码(写入, 2);
        实例槽 = 找编码(写入, 3); 采样值类型 = 找编码(写入, 4);
        采样值 = 找编码(写入, 5);
        return 有效(主体) && 有效(场景节点) && 有效(实例槽)
            && 有效(采样值类型) && 有效(采样值);
    }

    std::optional<实际存在I64基准状态读取请求> 写状态(
        std::uint64_t 时间, std::uint64_t 幂等键, bool 完整 = true) {
        const auto 快照 = L1.读取完整快照({});
        const auto 当前值 = L1.读取当前值({L1事实基座合同版本, 采样值});
        const auto* 值 = 当前值.事实 ? std::get_if<值事实>(&*当前值.事实) : nullptr;
        if (!快照.快照 || 当前值.状态 != L1读取状态::成功 || !值) return std::nullopt;
        L1写集请求 写集;
        写集.期望事实代次 = 快照.快照->事实代次;
        写集.幂等键 = {幂等键};
        写集.节点 = {{{1}, 节点种类::普通, std::nullopt},
            {{2}, 节点种类::普通, std::nullopt}};
        写集.值 = {{{3}, 写集本地键{1}, 登记.状态节点资格属性类型,
                std::int64_t{状态节点资格值}, 登记.服务身份},
            {{4}, 写集本地键{1}, 登记.状态发生时间属性类型,
                std::vector<std::uint64_t>{时间}, 登记.服务身份},
            {{5}, 写集本地键{2}, 登记.状态特征值见证资格属性类型,
                std::int64_t{状态特征值见证资格值}, 登记.服务身份},
            {{6}, 写集本地键{2}, 登记.被采样P8值引用属性类型,
                std::vector<std::uint64_t>{采样值.值, 值->创建事实代次,
                    写集.期望事实代次, 主体.值}, 主体},
            {{7}, 写集本地键{2}, 登记.状态采样I64值属性类型,
                std::int64_t{12}, 主体}};
        写集.关系 = {{{8}, 写集本地键{1}, 主体,
                登记.关系19状态组成关系类型, 1},
            {{9}, 写集本地键{1}, 场景节点,
                登记.关系19状态组成关系类型, 2},
            {{10}, 写集本地键{1}, 实例槽,
                登记.关系19状态组成关系类型, 3},
            {{11}, 写集本地键{1}, 写集本地键{2},
                登记.关系19状态组成关系类型, 4},
            {{12}, 写集本地键{1}, 主体,
                登记.关系19状态组成关系类型, 5}};
        if (!完整) 写集.关系.pop_back();
        写集.属性槽变更 = {{写集本地键{1}, 登记.状态节点资格属性类型, {3}},
            {写集本地键{1}, 登记.状态发生时间属性类型, {4}},
            {写集本地键{2}, 登记.状态特征值见证资格属性类型, {5}},
            {写集本地键{2}, 登记.被采样P8值引用属性类型, {6}},
            {写集本地键{2}, 登记.状态采样I64值属性类型, {7}}};
        const auto 写入 = L1.提交写集(写集);
        if (写入.状态 != L1写入状态::成功) return std::nullopt;
        实际存在I64基准状态读取请求 请求;
        请求.状态 = 找编码(写入, 1); 请求.特征值见证 = 找编码(写入, 2);
        请求.状态资格值 = 找编码(写入, 3); 请求.发生时间值 = 找编码(写入, 4);
        请求.特征值见证资格值 = 找编码(写入, 5);
        请求.被采样P8值引用值 = 找编码(写入, 6);
        请求.状态采样I64值 = 找编码(写入, 7);
        请求.主体关系 = 找编码(写入, 8); 请求.场景关系 = 找编码(写入, 9);
        请求.特征关系 = 找编码(写入, 10); 请求.值关系 = 找编码(写入, 11);
        请求.来源存在关系 = 找编码(写入, 12);
        return 请求;
    }

    I64相邻前状态选择请求 选择请求(std::uint64_t 时间) const {
        I64相邻前状态选择请求 请求;
        请求.业务查询身份 = 0xAA01;
        请求.主体 = 主体; 请求.实例槽 = 实例槽;
        请求.拟发布后状态发生时间 = 时间;
        return 请求;
    }
};

std::array<bool, 13> 运行P12矩阵() {
    std::array<bool, 13> 验收{};
    P12夹具 主夹具;
    const bool 初始化 = 主夹具.初始化(1);
    auto 请求 = 主夹具.选择请求(25);
    const auto 零候选 = 主夹具.状态.选择实际存在I64相邻前状态(请求);
    验收[0] = 初始化 && 零候选.状态 == I64相邻前状态选择状态::无前状态
        && !零候选.前状态 && 零候选.选择证据
        && 零候选.选择证据->读取事实截止代次 != 0
        && !有效(零候选.选择证据->前状态);
    auto 未找到请求 = 请求; 未找到请求.主体 = {0xFFFF'FFFFULL};
    const auto 未找到 = 主夹具.状态.选择实际存在I64相邻前状态(未找到请求);
    验收[1] = 未找到.状态 == I64相邻前状态选择状态::未找到
        && !未找到.前状态 && !未找到.选择证据;
    const auto 状态30 = 主夹具.写状态(30, 0xFC10000000000001ULL);
    const auto 状态10 = 主夹具.写状态(10, 0xFC10000000000002ULL);
    const auto 状态20 = 主夹具.写状态(20, 0xFC10000000000003ULL);
    const auto 选择20 = 主夹具.状态.选择实际存在I64相邻前状态(请求);
    验收[2] = 状态30 && 状态10 && 状态20
        && 选择20.状态 == I64相邻前状态选择状态::已选择
        && 选择20.前状态 && 选择20.选择证据
        && 选择20.前状态->状态.编码 == 状态20->状态
        && 选择20.选择证据->前状态发生时间 == 20;
    auto 等时请求 = 请求; 等时请求.拟发布后状态发生时间 = 10;
    const auto 等时排除 = 主夹具.状态.选择实际存在I64相邻前状态(等时请求);
    验收[3] = 等时排除.状态 == I64相邻前状态选择状态::无前状态
        && !等时排除.前状态 && 等时排除.选择证据;
    auto 跨主体请求 = 请求; 跨主体请求.主体 = 主夹具.场景节点;
    auto 跨槽请求 = 请求; 跨槽请求.实例槽 = 主夹具.场景节点;
    验收[4] = 主夹具.状态.选择实际存在I64相邻前状态(跨主体请求).状态
            == I64相邻前状态选择状态::无前状态
        && 主夹具.状态.选择实际存在I64相邻前状态(跨槽请求).状态
            == I64相邻前状态选择状态::无前状态;
    const auto 拒绝前 = 主夹具.L1.读取完整快照({});
    L1写集请求 非法退出端点;
    非法退出端点.期望事实代次 = 拒绝前.快照 ? 拒绝前.快照->事实代次 : 0;
    非法退出端点.幂等键 = {0xFC10000000000004ULL};
    非法退出端点.退出事实 = {主夹具.主体};
    const auto 非法退出 = 主夹具.L1.提交写集(非法退出端点);
    验收[5] = 非法退出.状态 == L1写入状态::入口拒绝;

    const auto 退出前 = 主夹具.L1.读取完整快照({});
    L1写集请求 退出端点;
    退出端点.期望事实代次 = 退出前.快照 ? 退出前.快照->事实代次 : 0;
    退出端点.幂等键 = {0xFC10000000000005ULL};
    if (退出前.快照) {
        for (const auto& 关系 : 退出前.快照->当前关系)
            if (关系.关系类型节点 == 主夹具.登记.关系19状态组成关系类型)
                退出端点.退出事实.push_back(关系.编码);
    }
    退出端点.退出事实.push_back(主夹具.实例槽);
    if (std::find(退出端点.退出事实.begin(), 退出端点.退出事实.end(), 主夹具.采样值)
        == 退出端点.退出事实.end())
        退出端点.退出事实.push_back(主夹具.采样值);
    const auto 退出 = 主夹具.L1.提交写集(退出端点);
    const auto 历史选择 = 主夹具.状态.选择实际存在I64相邻前状态(请求);
    验收[6] = 退出.状态 == L1写入状态::成功
        && 历史选择.状态 == I64相邻前状态选择状态::未找到
        && !历史选择.前状态 && !历史选择.选择证据;
    const auto P9历史 = 状态20
        ? 主夹具.状态.读取实际存在I64基准状态(*状态20)
        : 实际存在I64基准状态结果{};
    验收[7] = P9历史.状态 == L1基准状态状态::已读取 && P9历史.事实
        && P9历史.事实->特征.退出事实代次
        && !P9历史.事实->主体.退出事实代次
        && P9历史.事实->被采样P8值.退出事实代次;
    const auto 非法 = 主夹具.状态.选择实际存在I64相邻前状态({});
    验收[8] = 非法.状态 == I64相邻前状态选择状态::入口拒绝
        && !非法.前状态 && !非法.选择证据;

    P12夹具 冲突夹具;
    const bool 冲突初始化 = 冲突夹具.初始化(2);
    const auto 冲突1 = 冲突夹具.写状态(20, 0xFC20000000000001ULL);
    const auto 冲突2 = 冲突夹具.写状态(20, 0xFC20000000000002ULL);
    const auto 冲突 = 冲突夹具.状态.选择实际存在I64相邻前状态(冲突夹具.选择请求(25));
    验收[9] = 冲突初始化 && 冲突1 && 冲突2
        && 冲突.状态 == I64相邻前状态选择状态::冲突
        && !冲突.前状态 && !冲突.选择证据;

    P12夹具 损坏夹具;
    const bool 损坏初始化 = 损坏夹具.初始化(3);
    const auto 残缺 = 损坏夹具.写状态(10, 0xFC30000000000001ULL, false);
    const auto 损坏 = 损坏夹具.状态.选择实际存在I64相邻前状态(损坏夹具.选择请求(20));
    验收[10] = 损坏初始化 && 残缺
        && 损坏.状态 == I64相邻前状态选择状态::内部不一致
        && !损坏.前状态 && !损坏.选择证据;
    验收[11] = !含P12禁入字段<I64相邻前状态选择请求>
        && std::is_same_v<decltype(I64相邻前状态选择请求{}.主体), 稳定编码>
        && std::is_same_v<decltype(I64相邻前状态选择请求{}.实例槽), 稳定编码>;
    验收[12] = I64相邻前状态选择规则版本 == 1
        && 零候选.选择证据 && 零候选.选择证据->选择规则版本 == 1
        && 选择20.选择证据 && 选择20.选择证据->业务查询身份 == 请求.业务查询身份;
    return 验收;
}

} // namespace L1状态自检内部

struct L1状态自检报告 final {
    bool 总通过 = false;
    std::array<bool, 45> 验收{};
    std::size_t 失败数量 = 0;
};

L1状态自检报告 运行L1状态自检() {
    L1状态自检报告 报告;
    try {
        static_assert(!含特征定义字段<实际存在I64基准状态事实>);
        L1事实基座服务 L1;
        世界登记服务 世界(L1);
        L1场景结构服务 场景(L1, 世界);
        L1特征定义服务 定义(L1);
        L1实际存在服务 存在(L1);
        L1实际存在场景组合服务 组合(L1, 存在, 场景);
        L1实例特征服务 实例(L1, 场景, 定义, 组合);
        L1状态服务 状态(L1, 组合, 实例);

        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0x9101};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        初始场景创建请求 场景请求;
        场景请求.幂等身份 = {0x9102};
        if (世界结果.登记) {
            场景请求.世界根 = {世界结果.登记->世界根场景, 节点种类::普通};
            场景请求.期望事实代次 = 世界结果.登记->已验证事实代次;
        }
        const auto 场景结果 = 场景.创建初始场景(场景请求);
        报告.验收[0] = 世界结果.状态 == 世界登记状态::已提交
            && 场景结果.状态 == 世界结构状态::已提交 && 场景结果.事实
            && 场景结果.事实->事实截止代次 == 2;

        初始场景读取请求 场景读取;
        if (场景结果.事实) {
            场景读取.世界根 = 场景结果.事实->世界根;
            场景读取.初始场景 = 场景结果.事实->初始场景.编码;
            场景读取.场景标记值 = 场景结果.事实->场景标记.编码;
            场景读取.直接父关系 = 场景结果.事实->直接父关系.编码;
        }
        特征定义登记请求 定义登记请求;
        定义登记请求.幂等身份 = {0x9103};
        定义登记请求.期望事实代次 = 2;
        const auto 定义登记 = 定义.建立登记(定义登记请求);
        I64特征定义建立请求 定义请求;
        定义请求.幂等身份 = {0x9104};
        定义请求.期望事实代次 = 3;
        定义请求.下界 = -50;
        定义请求.上界 = 50;
        const auto 定义结果 = 定义.建立I64特征定义(定义请求);
        报告.验收[1] = 定义登记.状态 == 特征定义状态::已提交
            && 定义结果.状态 == 特征定义状态::已提交 && 定义结果.事实
            && 定义结果.事实->事实截止代次 == 4;

        I64特征定义读取请求 定义读取;
        if (定义结果.事实) {
            定义读取.特征定义 = 定义结果.事实->特征定义;
            定义读取.定义标记值 = 定义结果.定义标记值;
            定义读取.下界值 = 定义结果.下界值;
            定义读取.上界值 = 定义结果.上界值;
        }
        实例特征登记请求 实例登记请求;
        实例登记请求.幂等身份 = {0x9105};
        实例登记请求.期望事实代次 = 4;
        const auto 实例登记 = 实例.建立登记(实例登记请求);
        实际存在登记请求 存在登记请求;
        存在登记请求.幂等身份 = {0x9106};
        存在登记请求.期望事实代次 = 5;
        const auto 存在登记 = 存在.建立登记(存在登记请求);
        报告.验收[2] = 实例登记.状态 == 实例特征状态::已提交
            && 存在登记.状态 == 实际存在状态::已提交;

        实际存在创建请求 存在请求;
        存在请求.目标场景 = 场景读取;
        存在请求.幂等身份 = {0x9107};
        存在请求.期望事实代次 = 6;
        const auto 存在结果 = 组合.在初始场景创建实际存在(存在请求);
        实际存在读取请求 存在读取;
        if (存在结果.事实) {
            存在读取.当前场景 = 场景读取;
            存在读取.存在 = 存在结果.事实->存在.编码;
            存在读取.资格值 = 存在结果.事实->资格.编码;
            存在读取.当前场景归属关系 = 存在结果.事实->当前场景归属关系.编码;
        }
        报告.验收[3] = 存在结果.状态 == 实际存在状态::已提交
            && 存在结果.事实 && 存在结果.事实->事实截止代次 == 7;

        实际存在I64实例特征建立请求 特征请求;
        特征请求.幂等身份 = {0x9108};
        特征请求.期望事实代次 = 7;
        特征请求.宿主 = 存在读取;
        特征请求.定义 = 定义读取;
        特征请求.初始值 = 12;
        特征请求.来源节点 = 定义结果.事实 ? 定义结果.事实->来源服务 : 稳定编码{};
        const auto 特征结果 = 实例.建立实际存在I64实例特征(特征请求);
        实际存在I64实例特征读取请求 特征读取;
        特征读取.宿主 = 存在读取;
        特征读取.定义 = 定义读取;
        if (特征结果.事实) {
            特征读取.实例槽 = 特征结果.事实->实例槽;
            特征读取.当前值 = 特征结果.事实->当前值;
            特征读取.来源节点 = 特征结果.事实->来源节点;
        }
        特征读取.宿主关系 = 特征结果.宿主关系;
        特征读取.定义关系 = 特征结果.定义关系;
        报告.验收[4] = 特征结果.状态 == 实例特征状态::已提交
            && 特征结果.事实 && 特征结果.事实->事实截止代次 == 8
            && 实例.读取实际存在I64实例特征(特征读取).状态 == 实例特征状态::已读取;

        L1状态登记请求 状态登记请求;
        状态登记请求.幂等身份 = {0x9109};
        状态登记请求.期望事实代次 = 8;
        const auto 登记前 = L1.读取完整快照({});
        const auto 状态登记 = 状态.建立登记(状态登记请求);
        const auto 登记后 = L1.读取完整快照({});
        报告.验收[5] = 状态登记.状态 == L1基准状态状态::已提交
            && 状态登记.登记 && L1状态结构登记完整(*状态登记.登记)
            && 状态登记.登记->事实截止代次 == 9;
        报告.验收[6] = 登记前.快照 && 登记后.快照
            && 登记后.快照->当前节点.size() == 登记前.快照->当前节点.size() + 7
            && 登记后.快照->当前关系.size() == 登记前.快照->当前关系.size()
            && 登记后.快照->当前值.size() == 登记前.快照->当前值.size();
        const auto 状态登记重复 = 状态.建立登记(状态登记请求);
        auto 状态登记冲突 = 状态登记请求;
        状态登记冲突.幂等身份 = {0x9110};
        报告.验收[7] = 状态登记重复.状态 == L1基准状态状态::幂等读回
            && 状态.建立登记(状态登记冲突).状态 == L1基准状态状态::幂等冲突
            && 状态.读取当前登记().状态 == L1基准状态状态::已读取;

        实际存在I64首个基准状态发布请求 发布请求;
        发布请求.幂等身份 = {0x9201};
        发布请求.期望事实代次 = 9;
        发布请求.当前特征 = 特征读取;
        发布请求.发生时间戳 = 0x1234'5678ULL;
        const auto 发布前 = L1.读取完整快照({});
        const auto 发布结果 = 状态.发布实际存在I64首个基准状态(发布请求);
        const auto 发布后 = L1.读取完整快照({});
        报告.验收[8] = 发布结果.状态 == L1基准状态状态::已提交
            && 发布结果.事实 && 发布结果.事实->读取事实截止代次 == 10
            && 发布结果.事实->状态采样事实截止代次 == 9;
        报告.验收[9] = 发布前.快照 && 发布后.快照
            && 发布后.快照->当前节点.size() == 发布前.快照->当前节点.size() + 2
            && 发布后.快照->当前关系.size() == 发布前.快照->当前关系.size() + 5
            && 发布后.快照->当前值.size() == 发布前.快照->当前值.size() + 5;
        if (发布结果.事实) {
            const auto& 事实 = *发布结果.事实;
            报告.验收[10] = 事实.主体.编码 == 存在读取.存在
                && 事实.场景.编码 == 场景读取.初始场景
                && 事实.特征.编码 == 特征读取.实例槽
                && 事实.来源存在.编码 == 存在读取.存在;
            报告.验收[11] = 事实.主体关系.顺序号 == 1 && 事实.场景关系.顺序号 == 2
                && 事实.特征关系.顺序号 == 3 && 事实.值关系.顺序号 == 4
                && 事实.来源存在关系.顺序号 == 5;
            报告.验收[12] = 事实.状态资格.材料 == 状态节点资格值
                && 事实.发生时间.材料 == std::vector<std::uint64_t>{发布请求.发生时间戳}
                && 事实.特征值见证资格.材料 == 状态特征值见证资格值
                && 事实.采样I64值.材料 == 12 && 事实.被采样P8值.材料 == 12;
            报告.验收[13] = 事实.被采样P8值引用.材料.size() == 4
                && 事实.被采样P8值引用.材料[0] == 特征读取.当前值.值
                && 事实.被采样P8值引用.材料[2] == 9
                && 事实.被采样P8值.属性类型 == 实例登记.登记->当前I64值属性类型
                && 事实.被采样P8值.属性类型 != 定义结果.事实->特征定义;
            报告.验收[14] = 事实.状态.创建事实代次 == 10
                && 事实.特征值.创建事实代次 == 10
                && !事实.状态.退出事实代次 && !事实.特征值.退出事实代次;
        }
        const auto 读取请求 = 发布结果.事实 ? 实际存在I64基准状态读取请求{
            L1状态合同版本, L1状态规则版本, 发布结果.事实->状态.编码,
            发布结果.事实->特征值.编码, 发布结果.事实->状态资格.编码,
            发布结果.事实->发生时间.编码, 发布结果.事实->特征值见证资格.编码,
            发布结果.事实->被采样P8值引用.编码, 发布结果.事实->采样I64值.编码,
            发布结果.事实->主体关系.编码, 发布结果.事实->场景关系.编码,
            发布结果.事实->特征关系.编码, 发布结果.事实->值关系.编码,
            发布结果.事实->来源存在关系.编码} : 实际存在I64基准状态读取请求{};
        const auto 独立读取 = 状态.读取实际存在I64基准状态(读取请求);
        报告.验收[15] = 独立读取.状态 == L1基准状态状态::已读取
            && 独立读取.事实 && 独立读取.事实->采样I64值.材料 == 12;
        const auto 重复前 = L1.读取完整快照({});
        const auto 发布重复 = 状态.发布实际存在I64首个基准状态(发布请求);
        const auto 重复后 = L1.读取完整快照({});
        报告.验收[16] = 发布重复.状态 == L1基准状态状态::幂等读回
            && 发布重复.事实 && 重复前.快照 && 重复后.快照
            && 重复前.快照->事实代次 == 重复后.快照->事实代次;
        auto 同键异义 = 发布请求;
        同键异义.发生时间戳++;
        报告.验收[17] = 状态.发布实际存在I64首个基准状态(同键异义).状态
            == L1基准状态状态::幂等冲突;
        auto 第二键 = 发布请求;
        第二键.幂等身份 = {0x9202};
        第二键.期望事实代次 = 10;
        报告.验收[18] = 状态.发布实际存在I64首个基准状态(第二键).状态
            == L1基准状态状态::入口拒绝;

        auto 错读取 = 读取请求;
        错读取.值关系 = 错读取.主体关系;
        auto 错发布 = 发布请求;
        错发布.幂等身份 = {};
        报告.验收[19] = 状态.读取实际存在I64基准状态({}).状态
                == L1基准状态状态::入口拒绝
            && 状态.读取实际存在I64基准状态(错读取).状态
                == L1基准状态状态::入口拒绝
            && 状态.发布实际存在I64首个基准状态(错发布).状态
                == L1基准状态状态::入口拒绝;

        std::atomic<std::uint32_t> 并发失败 = 0;
        std::vector<std::thread> 线程组;
        for (int i = 0; i < 8; ++i) 线程组.emplace_back([&] {
            const auto 读 = 状态.读取实际存在I64基准状态(读取请求);
            if (读.状态 != L1基准状态状态::已读取 || !读.事实
                || 读.事实->状态.编码 != 读取请求.状态) ++并发失败;
        });
        for (auto& 线程 : 线程组) 线程.join();
        报告.验收[20] = 并发失败 == 0;

        L1写集请求 退出采样值;
        退出采样值.期望事实代次 = 10;
        退出采样值.幂等键 = {0xFB00000000000001ULL};
        退出采样值.退出事实 = {特征读取.当前值};
        const auto 退出结果 = L1.提交写集(退出采样值);
        const auto 历史读取 = 状态.读取实际存在I64基准状态(读取请求);
        报告.验收[21] = 退出结果.状态 == L1写入状态::成功
            && 历史读取.状态 == L1基准状态状态::已读取 && 历史读取.事实
            && 历史读取.事实->读取事实截止代次 == 11
            && 历史读取.事实->被采样P8值.退出事实代次 == std::optional<std::uint64_t>{11}
            && 历史读取.事实->被采样P8值.材料 == 12;
        const auto 历史直接 = L1.读取历史事实({L1事实基座合同版本, 特征读取.当前值});
        报告.验收[22] = 历史直接.状态 == L1读取状态::成功 && 历史直接.历史
            && !历史直接.历史->当前有效;
        报告.验收[23] = 历史读取.事实
            && 历史读取.事实->特征.编码 == 特征读取.实例槽
            && 历史读取.事实->被采样P8值.属性类型 == 实例登记.登记->当前I64值属性类型;

        L1状态服务 未登记状态(L1, 组合, 实例);
        报告.验收[24] = 未登记状态.读取当前登记().状态 == L1基准状态状态::未找到
            && 未登记状态.发布实际存在I64首个基准状态(发布请求).状态
                == L1基准状态状态::入口拒绝;
        报告.验收[25] = 实际存在I64基准状态读取请求有效(读取请求)
            && !实际存在I64基准状态读取请求有效(错读取)
            && 状态操作幂等身份有效({1}) && !状态操作幂等身份有效({});
        报告.验收[26] = 发布结果.事实
            && 发布结果.事实->主体关系.关系类型
                == 状态登记.登记->关系19状态组成关系类型
            && 发布结果.事实->来源存在关系.关系类型
                == 状态登记.登记->关系19状态组成关系类型;
        报告.验收[27] = 发布后.快照 && 发布后.快照->事实代次 == 10
            && 发布结果.事实 && 发布结果.事实->状态资格.前一值 == std::nullopt
            && 发布结果.事实->被采样P8值引用.前一值 == std::nullopt;

        L1写集请求 重复角色写集;
        重复角色写集.期望事实代次 = 11;
        重复角色写集.幂等键 = {0xFB00000000000002ULL};
        重复角色写集.关系 = {{{1}, 读取请求.状态,
            发布结果.事实->主体.编码, 状态登记.登记->关系19状态组成关系类型, 1}};
        const auto 重复角色写入 = L1.提交写集(重复角色写集);
        报告.验收[28] = 重复角色写入.状态 == L1写入状态::成功
            && 状态.读取实际存在I64基准状态(读取请求).状态
                == L1基准状态状态::内部不一致;
        L1写集请求 清理重复角色;
        清理重复角色.期望事实代次 = 12;
        清理重复角色.幂等键 = {0xFB00000000000003ULL};
        if (!重复角色写入.新编码映射.empty())
            清理重复角色.退出事实 = {重复角色写入.新编码映射.front().second};
        const auto 清理重复结果 = L1.提交写集(清理重复角色);
        const auto 清理后读取 = 状态.读取实际存在I64基准状态(读取请求);
        报告.验收[29] = 清理重复结果.状态 == L1写入状态::成功
            && 清理后读取.状态 == L1基准状态状态::已读取 && 清理后读取.事实
            && 清理后读取.事实->读取事实截止代次 == 13;
        L1写集请求 退出状态关系;
        退出状态关系.期望事实代次 = 13;
        退出状态关系.幂等键 = {0xFB00000000000004ULL};
        退出状态关系.退出事实 = {读取请求.场景关系};
        const auto 退出关系结果 = L1.提交写集(退出状态关系);
        const auto 关系历史读取 = 状态.读取实际存在I64基准状态(读取请求);
        报告.验收[30] = 退出关系结果.状态 == L1写入状态::成功
            && 关系历史读取.状态 == L1基准状态状态::已读取 && 关系历史读取.事实
            && 关系历史读取.事实->场景关系.退出事实代次
                == std::optional<std::uint64_t>{14};
        const auto 最终快照 = L1.读取完整快照({});
        报告.验收[31] = 最终快照.快照 && 最终快照.快照->事实代次 == 14
            && 关系历史读取.事实 && 关系历史读取.事实->状态采样事实截止代次 == 9;
        const auto P12矩阵 = L1状态自检内部::运行P12矩阵();
        for (std::size_t i = 0; i < P12矩阵.size(); ++i) 报告.验收[32 + i] = P12矩阵[i];
    } catch (...) {
    }
    for (const bool 通过 : 报告.验收) if (!通过) ++报告.失败数量;
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
