// 文件规则：只读组合现有权威事实，不发布、缓存或补造任何值。
module;

#include <cstdint>
#include <limits>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>

#define INSTINCT_PASSIVE_MAINTENANCE_BASE_SNAPSHOT_NO_INCLUDES

export module 海中鱼巣.领域.组合.本能被动维护基础快照;

import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.安全根定义与当前值;
import 海中鱼巣.领域.服务.本能被动维护游标;
import 海中鱼巣.领域.服务.完整秒时钟;
import 海中鱼巣.业务.提供者.本能根运行初始化;

export {
#include "本能被动维护基础快照.数据.h"
}

export namespace 海中鱼巣 {

class 本能被动维护基础快照组合器 final {
public:
    本能被动维护基础快照组合器(
        const L2特征结构服务& 特征服务,
        const 安全根定义与当前值服务& 安全根服务,
        const 本能被动维护游标服务& 游标服务,
        const 完整秒时钟服务& 时钟服务) noexcept
        : 特征服务_(特征服务), 安全根服务_(安全根服务),
          游标服务_(游标服务), 时钟服务_(时钟服务) {}

    本能被动维护基础快照读取结果_v1
    读取本能被动维护基础快照_v1(
        const 本能被动维护基础快照读取请求_v1& 请求) const noexcept {
        const auto 失败 = [](本能被动维护基础快照读取状态_v1 状态) {
            return 本能被动维护基础快照读取结果_v1{
                本能被动维护基础快照合同版本_v1, 状态, std::nullopt, 0};
        };
        try {
            const auto G0 = 请求.请求头.期望事实代次;
            if (请求.合同版本 != 本能被动维护基础快照合同版本_v1
                || 请求.请求头.合同版本 != L2结构合同版本 || G0 == 0
                || !请求.本能根锚点.完整()
                || 请求.本能根锚点.事实截止代次 > G0
                || 请求.期望运行代次 == 0)
                return 失败(本能被动维护基础快照读取状态_v1::入口拒绝);

            const auto 游标请求 = 本能被动维护游标读取请求_v1{
                本能被动维护游标合同版本_v1, 请求.请求头,
                请求.本能根锚点.唯一自我};
            const auto 首次游标 = 游标服务_.读取当前本能被动维护游标_v1(游标请求);
            if (!首次游标.成功() || !首次游标.游标) {
                switch (首次游标.状态) {
                case 本能被动维护游标读取状态_v1::未建立:
                    return 失败(本能被动维护基础快照读取状态_v1::游标未建立);
                case 本能被动维护游标读取状态_v1::当前性漂移:
                    return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
                case 本能被动维护游标读取状态_v1::引用冲突:
                    return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
                case 本能被动维护游标读取状态_v1::资源失败:
                    return 失败(本能被动维护基础快照读取状态_v1::资源失败);
                case 本能被动维护游标读取状态_v1::入口拒绝:
                    return 失败(本能被动维护基础快照读取状态_v1::入口拒绝);
                default:
                    return 失败(本能被动维护基础快照读取状态_v1::内部错误);
                }
            }
            if (首次游标.本次正式读回截止 != G0)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
            const auto& 游标 = *首次游标.游标;
            if (游标.自我 != 请求.本能根锚点.唯一自我)
                return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
            if (游标.运行代次 != 请求.期望运行代次)
                return 失败(本能被动维护基础快照读取状态_v1::运行代次漂移);

            const auto 时间 = 时钟服务_.读取当前完整秒边界({
                完整秒边界读取合同版本, 游标.运行代次,
                游标.时间纪元身份, 游标.上一已维护完整秒边界,
                游标.时间源版本});
            switch (时间.状态) {
            case 完整秒边界读取状态::已读取:
            case 完整秒边界读取状态::无新完整秒:
                break;
            case 完整秒边界读取状态::纪元错配:
                return 失败(本能被动维护基础快照读取状态_v1::时间纪元漂移);
            case 完整秒边界读取状态::时间源版本漂移:
                return 失败(本能被动维护基础快照读取状态_v1::时间源版本漂移);
            case 完整秒边界读取状态::时间倒退:
                return 失败(本能被动维护基础快照读取状态_v1::时间倒退);
            case 完整秒边界读取状态::请求拒绝:
                return 失败(本能被动维护基础快照读取状态_v1::材料不闭合);
            default:
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);
            }
            if (!时间.观察)
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);

            const auto 安全 = 安全根服务_.读取安全根定义与当前值_v1({
                安全根定义合同版本_v1, 请求.请求头, 请求.本能根锚点});
            if (!安全.成功() || !安全.快照) {
                switch (安全.状态) {
                case 安全根定义与当前值读取状态_v1::定义未发布:
                    return 失败(本能被动维护基础快照读取状态_v1::定义未发布);
                case 安全根定义与当前值读取状态_v1::当前值未设置:
                    return 失败(本能被动维护基础快照读取状态_v1::当前值未设置);
                case 安全根定义与当前值读取状态_v1::当前性漂移:
                    return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
                case 安全根定义与当前值读取状态_v1::引用冲突:
                    return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
                case 安全根定义与当前值读取状态_v1::资源失败:
                    return 失败(本能被动维护基础快照读取状态_v1::资源失败);
                case 安全根定义与当前值读取状态_v1::入口拒绝:
                case 安全根定义与当前值读取状态_v1::许可拒绝:
                    return 失败(本能被动维护基础快照读取状态_v1::入口拒绝);
                default:
                    return 失败(本能被动维护基础快照读取状态_v1::内部错误);
                }
            }
            if (安全.本次正式读回截止 != G0)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);

            const auto 服务值 = 特征服务_.读取特征当前值({
                请求.请求头, 请求.本能根锚点.服务根特征实例});
            if (!服务值.成功() || !服务值.当前值) {
                if (服务值.结果头.状态 == L2结构状态::事实代次漂移)
                    return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
                if (服务值.结果头.状态 == L2结构状态::未找到
                    || 服务值.结果头.状态 == L2结构状态::属性未设置
                    || 服务值.结果头.状态 == L2结构状态::已退出)
                    return 失败(本能被动维护基础快照读取状态_v1::当前值未设置);
                if (服务值.结果头.状态 == L2结构状态::引用冲突)
                    return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
                if (服务值.结果头.状态 == L2结构状态::资源失败)
                    return 失败(本能被动维护基础快照读取状态_v1::资源失败);
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);
            }
            if (服务值.结果头.事实截止代次 != G0)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
            const auto* 当前服务值 = std::get_if<std::int64_t>(
                &服务值.当前值->类型化不可变材料);
            if (!当前服务值 || *当前服务值 < 0
                || *当前服务值 > 本能根I64最大目标_v1)
                return 失败(本能被动维护基础快照读取状态_v1::材料不闭合);

            const auto 末次游标 = 游标服务_.读取当前本能被动维护游标_v1(游标请求);
            if (!末次游标.成功() || !末次游标.游标
                || 末次游标.本次正式读回截止 != G0
                || *末次游标.游标 != 游标)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);

            本能被动维护基础快照_v1 快照{
                请求.本能根锚点, *安全.快照, *服务值.当前值,
                *当前服务值, 游标, 时间.状态, *时间.观察,
                时间.区间, G0};
            if (!本能被动维护基础快照完整_v1(快照))
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);
            const auto 状态 = 时间.状态 == 完整秒边界读取状态::已读取
                ? 本能被动维护基础快照读取状态_v1::已读取
                : 本能被动维护基础快照读取状态_v1::无新完整秒;
            return {本能被动维护基础快照合同版本_v1,
                状态, std::move(快照), G0};
        } catch (const std::bad_alloc&) {
            return 失败(本能被动维护基础快照读取状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(本能被动维护基础快照读取状态_v1::资源失败);
        } catch (...) {
            return 失败(本能被动维护基础快照读取状态_v1::内部错误);
        }
    }

private:
    const L2特征结构服务& 特征服务_;
    const 安全根定义与当前值服务& 安全根服务_;
    const 本能被动维护游标服务& 游标服务_;
    const 完整秒时钟服务& 时钟服务_;
};

} // namespace 海中鱼巣
