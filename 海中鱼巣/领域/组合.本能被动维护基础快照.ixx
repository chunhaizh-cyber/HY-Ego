export {
#include "本能被动维护基础快照.数据.h"
}

namespace 海中鱼巣::本能被动维护基础快照内部 {

inline bool 稳定权威字段相同_v1(
    const 本能被动维护基础快照_v1& 左,
    const 本能被动维护基础快照_v1& 右) noexcept {
    const auto 特征值事实相同 = [](const L2特征值事实& a,
        const L2特征值事实& b) noexcept {
        const auto* av = std::get_if<std::int64_t>(&a.类型化不可变材料);
        const auto* bv = std::get_if<std::int64_t>(&b.类型化不可变材料);
        return a.值稳定编码 == b.值稳定编码 && a.特征实例 == b.特征实例
            && av && bv && *av == *bv && a.来源稳定编码 == b.来源稳定编码
            && a.生命周期 == b.生命周期;
    };
    const auto 安全根相同 = [&](const 安全根定义与当前值快照_v1& a,
        const 安全根定义与当前值快照_v1& b) noexcept {
        return a.定义 == b.定义
            && 特征值事实相同(a.当前值事实, b.当前值事实)
            && a.当前安全根值 == b.当前安全根值
            && a.本次正式读回截止 == b.本次正式读回截止;
    };
    const auto 时间相同 = 左.时间观察.合同版本 == 右.时间观察.合同版本
        && 左.时间观察.运行代次 == 右.时间观察.运行代次
        && 左.时间观察.时间纪元身份 == 右.时间观察.时间纪元身份
        && 左.时间观察.上一已消费完整秒边界
            == 右.时间观察.上一已消费完整秒边界
        && 左.时间观察.当前完整秒边界 == 右.时间观察.当前完整秒边界
        && 左.时间观察.时间源版本 == 右.时间观察.时间源版本;
    const auto 区间相同 = [&]() noexcept {
        if (左.待维护区间.has_value() != 右.待维护区间.has_value()) return false;
        if (!左.待维护区间) return true;
        return 左.待维护区间->首个未消费完整秒边界
                == 右.待维护区间->首个未消费完整秒边界
            && 左.待维护区间->最后完整秒边界
                == 右.待维护区间->最后完整秒边界
            && 左.待维护区间->完整秒数量 == 右.待维护区间->完整秒数量;
    }();
    return 左.本能根锚点 == 右.本能根锚点
        && 安全根相同(左.安全根, 右.安全根)
        && 特征值事实相同(左.服务值当前值事实, 右.服务值当前值事实)
        && 左.当前服务值 == 右.当前服务值 && 左.游标 == 右.游标
        && 左.时间状态 == 右.时间状态 && 时间相同 && 区间相同
        && 左.本次正式读回截止 == 右.本次正式读回截止;
}

} // namespace 海中鱼巣::本能被动维护基础快照内部

export namespace 海中鱼巣 {

class 本能被动维护基础快照组合器 final {
public:
    本能被动维护基础快照组合器(
        const L2特征结构服务& 特征服务,
        const 安全根定义与当前值服务& 安全根服务,
        const 本能被动维护游标服务& 游标服务,
        const 完整秒时钟服务& 时钟服务) noexcept
        : 特征服务_(特征服务), 安全根服务_(安全根服务),
          游标服务_(游标服务), 时钟服务_(时钟服务) {}

    本能被动维护基础快照读取结果_v1
    读取本能被动维护基础快照_v1(
        const 本能被动维护基础快照读取请求_v1& 请求) const noexcept {
        const auto 失败 = [](本能被动维护基础快照读取状态_v1 状态) {
            return 本能被动维护基础快照读取结果_v1{
                本能被动维护基础快照合同版本_v1, 状态, std::nullopt, 0};
        };
        try {
            const auto G0 = 请求.请求头.期望事实代次;
            if (请求.合同版本 != 本能被动维护基础快照合同版本_v1
                || 请求.请求头.合同版本 != L2结构合同版本 || G0 == 0
                || !请求.本能根锚点.完整()
                || 请求.本能根锚点.事实截止代次 > G0
                || 请求.期望运行代次 == 0)
                return 失败(本能被动维护基础快照读取状态_v1::入口拒绝);

            const auto 游标请求 = 本能被动维护游标读取请求_v1{
                本能被动维护游标合同版本_v1, 请求.请求头,
                请求.本能根锚点.唯一自我};
            const auto 首次游标 = 游标服务_.读取当前本能被动维护游标_v1(游标请求);
            if (!首次游标.成功() || !首次游标.游标) {
                switch (首次游标.状态) {
                case 本能被动维护游标读取状态_v1::未建立:
                    return 失败(本能被动维护基础快照读取状态_v1::游标未建立);
                case 本能被动维护游标读取状态_v1::当前性漂移:
                    return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
                case 本能被动维护游标读取状态_v1::引用冲突:
                    return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
                case 本能被动维护游标读取状态_v1::资源失败:
                    return 失败(本能被动维护基础快照读取状态_v1::资源失败);
                case 本能被动维护游标读取状态_v1::入口拒绝:
                    return 失败(本能被动维护基础快照读取状态_v1::入口拒绝);
                default:
                    return 失败(本能被动维护基础快照读取状态_v1::内部错误);
                }
            }
            if (首次游标.本次正式读回截止 != G0)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
            const auto& 游标 = *首次游标.游标;
            if (游标.自我 != 请求.本能根锚点.唯一自我)
                return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
            if (游标.运行代次 != 请求.期望运行代次)
                return 失败(本能被动维护基础快照读取状态_v1::运行代次漂移);

            const auto 时间 = 时钟服务_.读取当前完整秒边界({
                完整秒边界读取合同版本, 游标.运行代次,
                游标.时间纪元身份, 游标.上一已维护完整秒边界,
                游标.时间源版本});
            switch (时间.状态) {
            case 完整秒边界读取状态::已读取:
            case 完整秒边界读取状态::无新完整秒:
                break;
            case 完整秒边界读取状态::纪元错配:
                return 失败(本能被动维护基础快照读取状态_v1::时间纪元漂移);
            case 完整秒边界读取状态::时间源版本漂移:
                return 失败(本能被动维护基础快照读取状态_v1::时间源版本漂移);
            case 完整秒边界读取状态::时间倒退:
                return 失败(本能被动维护基础快照读取状态_v1::时间倒退);
            case 完整秒边界读取状态::请求拒绝:
                return 失败(本能被动维护基础快照读取状态_v1::材料不闭合);
            default:
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);
            }
            if (!时间.观察)
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);

            const auto 安全 = 安全根服务_.读取安全根定义与当前值_v1({
                安全根定义合同版本_v1, 请求.请求头, 请求.本能根锚点});
            if (!安全.成功() || !安全.快照) {
                switch (安全.状态) {
                case 安全根定义与当前值读取状态_v1::定义未发布:
                    return 失败(本能被动维护基础快照读取状态_v1::定义未发布);
                case 安全根定义与当前值读取状态_v1::当前值未设置:
                    return 失败(本能被动维护基础快照读取状态_v1::当前值未设置);
                case 安全根定义与当前值读取状态_v1::当前性漂移:
                    return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
                case 安全根定义与当前值读取状态_v1::引用冲突:
                    return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
                case 安全根定义与当前值读取状态_v1::资源失败:
                    return 失败(本能被动维护基础快照读取状态_v1::资源失败);
                case 安全根定义与当前值读取状态_v1::入口拒绝:
                case 安全根定义与当前值读取状态_v1::许可拒绝:
                    return 失败(本能被动维护基础快照读取状态_v1::入口拒绝);
                default:
                    return 失败(本能被动维护基础快照读取状态_v1::内部错误);
                }
            }
            if (安全.本次正式读回截止 != G0)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);

            const auto 服务值 = 特征服务_.读取特征当前值({
                请求.请求头, 请求.本能根锚点.服务根特征实例});
            if (!服务值.成功() || !服务值.当前值) {
                if (服务值.结果头.状态 == L2结构状态::事实代次漂移)
                    return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
                if (服务值.结果头.状态 == L2结构状态::未找到
                    || 服务值.结果头.状态 == L2结构状态::属性未设置
                    || 服务值.结果头.状态 == L2结构状态::已退出)
                    return 失败(本能被动维护基础快照读取状态_v1::当前值未设置);
                if (服务值.结果头.状态 == L2结构状态::引用冲突)
                    return 失败(本能被动维护基础快照读取状态_v1::引用冲突);
                if (服务值.结果头.状态 == L2结构状态::资源失败)
                    return 失败(本能被动维护基础快照读取状态_v1::资源失败);
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);
            }
            if (服务值.结果头.事实截止代次 != G0)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);
            const auto* 当前服务值 = std::get_if<std::int64_t>(
                &服务值.当前值->类型化不可变材料);
            if (!当前服务值 || *当前服务值 < 0
                || *当前服务值 > 本能根I64最大目标_v1)
                return 失败(本能被动维护基础快照读取状态_v1::材料不闭合);

            const auto 末次游标 = 游标服务_.读取当前本能被动维护游标_v1(游标请求);
            if (!末次游标.成功() || !末次游标.游标
                || 末次游标.本次正式读回截止 != G0
                || *末次游标.游标 != 游标)
                return 失败(本能被动维护基础快照读取状态_v1::当前性漂移);

            本能被动维护基础快照_v1 快照{
                请求.本能根锚点, *安全.快照, *服务值.当前值,
                *当前服务值, 游标, 时间.状态, *时间.观察,
                时间.区间, G0};
            if (!本能被动维护基础快照完整_v1(快照))
                return 失败(本能被动维护基础快照读取状态_v1::内部错误);
            const auto 状态 = 时间.状态 == 完整秒边界读取状态::已读取
                ? 本能被动维护基础快照读取状态_v1::已读取
                : 本能被动维护基础快照读取状态_v1::无新完整秒;
            return {本能被动维护基础快照合同版本_v1,
                状态, std::move(快照), G0};
        } catch (const std::bad_alloc&) {
            return 失败(本能被动维护基础快照读取状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(本能被动维护基础快照读取状态_v1::资源失败);
        } catch (...) {
            return 失败(本能被动维护基础快照读取状态_v1::内部错误);
        }
    }

private:
    const L2特征结构服务& 特征服务_;
    const 安全根定义与当前值服务& 安全根服务_;
    const 本能被动维护游标服务& 游标服务_;
    const 完整秒时钟服务& 时钟服务_;
};

namespace 本能单完整秒服务需求时间裁决内部 {

inline 本能单完整秒服务需求时间裁决读取状态_v1 映射基础状态(
    本能被动维护基础快照读取状态_v1 状态) noexcept {
    using 目标 = 本能单完整秒服务需求时间裁决读取状态_v1;
    switch (状态) {
    case 本能被动维护基础快照读取状态_v1::入口拒绝: return 目标::入口拒绝;
    case 本能被动维护基础快照读取状态_v1::定义未发布: return 目标::定义未发布;
    case 本能被动维护基础快照读取状态_v1::当前值未设置: return 目标::当前值未设置;
    case 本能被动维护基础快照读取状态_v1::游标未建立: return 目标::游标未建立;
    case 本能被动维护基础快照读取状态_v1::当前性漂移: return 目标::当前性漂移;
    case 本能被动维护基础快照读取状态_v1::运行代次漂移: return 目标::运行代次漂移;
    case 本能被动维护基础快照读取状态_v1::时间纪元漂移: return 目标::时间纪元漂移;
    case 本能被动维护基础快照读取状态_v1::时间源版本漂移:
        return 目标::时间源版本漂移;
    case 本能被动维护基础快照读取状态_v1::时间倒退: return 目标::时间倒退;
    case 本能被动维护基础快照读取状态_v1::引用冲突: return 目标::引用冲突;
    case 本能被动维护基础快照读取状态_v1::材料不闭合:
        return 目标::时间材料不闭合;
    case 本能被动维护基础快照读取状态_v1::资源失败: return 目标::资源失败;
    default: return 目标::内部错误;
    }
}

inline 本能单完整秒服务需求时间裁决读取状态_v1 映射合同状态(
    服务合同事实权威读取状态_v1 状态) noexcept {
    using 目标 = 本能单完整秒服务需求时间裁决读取状态_v1;
    switch (状态) {
    case 服务合同事实权威读取状态_v1::入口拒绝:
    case 服务合同事实权威读取状态_v1::许可拒绝: return 目标::入口拒绝;
    case 服务合同事实权威读取状态_v1::当前性漂移: return 目标::当前性漂移;
    case 服务合同事实权威读取状态_v1::结构未登记: return 目标::结构未登记;
    case 服务合同事实权威读取状态_v1::集合不闭合: return 目标::集合不闭合;
    case 服务合同事实权威读取状态_v1::引用冲突: return 目标::引用冲突;
    case 服务合同事实权威读取状态_v1::资源失败: return 目标::资源失败;
    default: return 目标::内部错误;
    }
}

} // namespace 本能单完整秒服务需求时间裁决内部

class 本能单完整秒服务需求时间裁决组合器 final {
public:
    本能单完整秒服务需求时间裁决组合器(
        const 本能被动维护基础快照组合器& 基础快照组合器,
        const 服务合同事实权威服务& 服务合同服务) noexcept
        : 基础快照组合器_(基础快照组合器), 服务合同服务_(服务合同服务) {}

    本能单完整秒服务需求时间裁决读取结果_v1
    读取当前维护秒服务需求时间裁决_v1(
        const 本能单完整秒服务需求时间裁决读取请求_v1& 请求) const noexcept {
        using 状态 = 本能单完整秒服务需求时间裁决读取状态_v1;
        const auto 失败 = [](状态 值) {
            return 本能单完整秒服务需求时间裁决读取结果_v1{
                本能单完整秒服务需求时间裁决合同版本_v1,
                值, std::nullopt, 0};
        };
        try {
            if (请求.合同版本 != 本能单完整秒服务需求时间裁决合同版本_v1
                || 请求.基础快照请求.合同版本
                    != 本能被动维护基础快照合同版本_v1
                || 请求.基础快照请求.请求头.合同版本 != L2结构合同版本
                || 请求.基础快照请求.请求头.期望事实代次 == 0
                || !请求.基础快照请求.本能根锚点.完整()
                || 请求.基础快照请求.期望运行代次 == 0)
                return 失败(状态::入口拒绝);

            const auto 首次 = 基础快照组合器_.读取本能被动维护基础快照_v1(
                请求.基础快照请求);
            if (!首次.成功() || !首次.快照)
                return 失败(本能单完整秒服务需求时间裁决内部::映射基础状态(
                    首次.状态));
            const auto G0 = 首次.本次正式读回截止;
            const auto 自我 = 首次.快照->本能根锚点.唯一自我;
            const auto 读取头 = L2结构请求头{L2结构合同版本, G0};
            auto 合同 = 服务合同服务_.读取当前有效未满足服务合同完整集合_v1({
                服务合同事实权威合同版本_v1, 读取头, 自我});
            if (!合同.成功())
                return 失败(本能单完整秒服务需求时间裁决内部::映射合同状态(
                    合同.状态));
            auto 事件 = 服务合同服务_.读取到期未满足事件合同终态完整集合_v1({
                服务合同事实权威合同版本_v1, 读取头, 自我});
            if (!事件.成功())
                return 失败(本能单完整秒服务需求时间裁决内部::映射合同状态(
                    事件.状态));
            const auto 末次 = 基础快照组合器_.读取本能被动维护基础快照_v1(
                请求.基础快照请求);
            if (!末次.成功() || !末次.快照
                || 首次.状态 != 末次.状态
                || !本能被动维护基础快照内部::稳定权威字段相同_v1(
                    *首次.快照, *末次.快照))
                return 失败(状态::当前性漂移);

            const auto 当前秒 = 首次.快照->时间观察.当前完整秒边界;
            const auto 当前纪元 = 首次.快照->游标.时间纪元身份;
            std::optional<std::int64_t> 最长{};
            std::vector<服务需求最长等待来源_v1> 并列;
            for (std::size_t i = 0; i < 合同.完整合同事实组.size(); ++i) {
                const auto& 事实 = 合同.完整合同事实组[i];
                const auto& 当前状态 = 合同.当前状态事实组[i];
                if (事实.合同规则版本
                    != 服务需求时间裁决支持合同规则版本_v1)
                    return 失败(状态::版本漂移);
                if (事实.时间纪元身份.值 != 当前纪元)
                    return 失败(状态::时间纪元漂移);
                if (事实.提出完整秒边界 > 当前秒
                    || 事实.有效开始完整秒边界 > 当前秒
                    || 当前状态.最后已结算完整秒边界 > 当前秒)
                    return 失败(状态::时间材料不闭合);
                for (std::size_t j = 0; j < i; ++j)
                    if (合同.完整合同事实组[j].需求 == 事实.需求)
                        return 失败(状态::集合不闭合);
                const auto 等待 = 当前秒 - 事实.提出完整秒边界;
                服务需求最长等待来源_v1 来源{
                    事实.身份, 事实.提出者, 事实.需求,
                    事实.提出完整秒边界, 等待};
                if (!最长 || 等待 > *最长) {
                    最长 = 等待;
                    并列.clear();
                    并列.push_back(来源);
                } else if (等待 == *最长) {
                    并列.push_back(来源);
                }
            }
            std::sort(并列.begin(), 并列.end(),
                服务需求最长等待来源严格小于_v1);

            std::vector<服务到期未满足事件身份_v1> 本秒事件;
            std::vector<服务合同身份_v1> 本秒事件合同;
            for (const auto& 投影 : 事件.完整投影组) {
                if (投影.原合同.时间纪元身份.值 != 当前纪元) continue;
                if (投影.事件.到期完整秒边界 > 当前秒)
                    return 失败(状态::时间材料不闭合);
                if (投影.事件.到期完整秒边界 != 当前秒) continue;
                if (投影.原合同.合同规则版本
                        != 服务需求时间裁决支持合同规则版本_v1
                    || 投影.事件.规则版本
                        != 服务需求时间裁决支持合同规则版本_v1)
                    return 失败(状态::版本漂移);
                for (const auto& 活动合同 : 合同.完整合同事实组)
                    if (活动合同.身份 == 投影.原合同.身份)
                        return 失败(状态::引用冲突);
                for (const auto& 已有 : 本秒事件合同)
                    if (已有 == 投影.原合同.身份)
                        return 失败(状态::集合不闭合);
                本秒事件合同.push_back(投影.原合同.身份);
                本秒事件.push_back(投影.事件.身份);
            }

            const auto 需求裁决 = !本秒事件.empty()
                    || (最长 && *最长 >= 服务观察窗完整秒_v1)
                ? 服务维护需求裁决_v1::三十天门禁已成立
                : 合同.完整合同事实组.empty()
                    ? 服务维护需求裁决_v1::无有效未满足且无到期事件
                    : 服务维护需求裁决_v1::存在未满观察窗需求;
            const auto 有效需求数量 = static_cast<std::uint64_t>(
                合同.完整合同事实组.size());
            本能单完整秒服务需求时间裁决快照_v1 快照{
                *首次.快照, std::move(合同), std::move(事件), 当前秒,
                需求裁决, 有效需求数量,
                最长, std::move(并列),
                static_cast<std::uint64_t>(本秒事件.size()),
                std::move(本秒事件), G0};
            if (!本能单完整秒服务需求时间裁决快照完整_v1(快照))
                return 失败(状态::内部错误);
            const auto 结果状态 = 首次.状态
                    == 本能被动维护基础快照读取状态_v1::已读取
                ? 状态::已读取 : 状态::无新完整秒;
            return {本能单完整秒服务需求时间裁决合同版本_v1,
                结果状态, std::move(快照), G0};
        } catch (const std::bad_alloc&) {
            return 失败(状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(状态::资源失败);
        } catch (...) {
            return 失败(状态::内部错误);
        }
    }

private:
    const 本能被动维护基础快照组合器& 基础快照组合器_;
    const 服务合同事实权威服务& 服务合同服务_;
};

} // namespace 海中鱼巣
