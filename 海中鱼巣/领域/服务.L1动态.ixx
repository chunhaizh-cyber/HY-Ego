namespace 海中鱼巣::L1动态内部 {

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
写集幂等键 映射登记幂等键(动态操作幂等身份 身份) noexcept {
    return {(L1动态登记幂等域 << 56) | 身份.值};
}

// P14-诊断责任：向上送出；最终责任边界：建立登记调用边。
L1领域意图凭证 形成登记意图凭证(const L1动态登记请求& 请求) {
    std::vector<std::uint8_t> 编码{'H','Z','Y','-','L','1','G','7'};
    L1确定性编码内部::写U32(编码, L1请求意图格式版本);
    L1确定性编码内部::写U32(编码, L1动态登记操作标签);
    L1确定性编码内部::写U8(编码, L1动态登记入口变体);
    L1确定性编码内部::写U32(编码, 请求.合同版本);
    L1确定性编码内部::写U32(编码, 请求.规则版本);
    L1确定性编码内部::写U64(编码, 请求.幂等身份.值);
    L1确定性编码内部::写U64(编码, 请求.期望事实代次);
    return {L1动态登记意图组, L1请求意图格式版本, L1动态登记操作标签,
        L1确定性编码内部::哈希(std::move(编码)), {}};
}

// P14-诊断责任：向上送出；最终责任边界：建立登记调用边。
L1动态状态 映射写入状态(L1写入状态 状态) noexcept {
    switch (状态) {
    case L1写入状态::成功: return L1动态状态::已登记;
    case L1写入状态::精确重复: return L1动态状态::已登记;
    case L1写入状态::幂等冲突: return L1动态状态::幂等冲突;
    case L1写入状态::事实代次漂移: return L1动态状态::版本漂移;
    case L1写入状态::未找到:
    case L1写入状态::已退出: return L1动态状态::未找到;
    case L1写入状态::资源失败: return L1动态状态::资源失败;
    case L1写入状态::内部不一致: return L1动态状态::内部不一致;
    default: return L1动态状态::入口拒绝;
    }
}

// P14-诊断责任：向上送出；最终责任边界：读回调用边。
L1动态状态 映射读取状态(L1读取状态 状态) noexcept {
    switch (状态) {
    case L1读取状态::未找到:
    case L1读取状态::属性未设置: return L1动态状态::未找到;
    case L1读取状态::已退出: return L1动态状态::未找到;
    case L1读取状态::事实代次漂移: return L1动态状态::版本漂移;
    case L1读取状态::资源失败: return L1动态状态::资源失败;
    case L1读取状态::内部不一致: return L1动态状态::内部不一致;
    default: return L1动态状态::入口拒绝;
    }
}

// P14-诊断责任：向上送出；最终责任边界：上游结果调用边。
L1动态状态 映射上游状态(I64后继状态规格状态 状态) noexcept {
    switch (状态) {
    case I64后继状态规格状态::无前状态: return L1动态状态::无需形成;
    case I64后继状态规格状态::未找到: return L1动态状态::未找到;
    case I64后继状态规格状态::版本漂移: return L1动态状态::版本漂移;
    case I64后继状态规格状态::许可拒绝: return L1动态状态::许可拒绝;
    case I64后继状态规格状态::资源失败: return L1动态状态::资源失败;
    case I64后继状态规格状态::入口拒绝:
    case I64后继状态规格状态::冲突:
    case I64后继状态规格状态::不可比较: return L1动态状态::入口拒绝;
    default: return L1动态状态::内部不一致;
    }
}

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
std::optional<稳定编码> 查找映射(
    const std::vector<std::pair<写集本地键, 稳定编码>>& 映射, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 映射) {
        if (键.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
bool 映射完整唯一(const std::vector<std::pair<写集本地键, 稳定编码>>& 映射,
    std::uint32_t 数量) noexcept {
    if (映射.size() != 数量) return false;
    for (std::uint32_t i = 1; i <= 数量; ++i) {
        const auto 编码 = 查找映射(映射, i);
        if (!编码 || !有效(*编码)) return false;
        for (std::uint32_t j = i + 1; j <= 数量; ++j) {
            const auto 另一个 = 查找映射(映射, j);
            if (!另一个 || *另一个 == *编码) return false;
        }
    }
    return true;
}

// P14-诊断责任：向上送出；最终责任边界：读回调用边。
template<class T, class 读取当前函数>
bool 读取当前或历史(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t 当前代次, 读取当前函数&& 读取当前,
    T& 输出, L1动态状态& 失败) {
    const auto 当前 = 读取当前();
    if (当前.状态 == L1读取状态::成功 && 当前.事实) {
        if (当前.读取事实代次 != 当前代次) {
            失败 = L1动态状态::版本漂移;
            return false;
        }
        const auto* 事实 = std::get_if<T>(&*当前.事实);
        if (!事实 || 事实->退出事实代次) {
            失败 = L1动态状态::内部不一致;
            return false;
        }
        输出 = *事实;
        return true;
    }
    if (当前.状态 != L1读取状态::已退出) {
        失败 = 映射读取状态(当前.状态);
        return false;
    }
    const auto 历史 = L1.读取历史事实({L1事实基座合同版本, 编码});
    if (历史.状态 != L1读取状态::成功 || !历史.历史
        || 历史.历史->查询编码 != 编码 || 历史.历史->当前有效) {
        失败 = 历史.状态 == L1读取状态::成功
            ? L1动态状态::内部不一致 : 映射读取状态(历史.状态);
        return false;
    }
    const auto* 事实 = std::get_if<T>(&历史.历史->事实);
    if (!事实 || !事实->退出事实代次) {
        失败 = L1动态状态::内部不一致;
        return false;
    }
    输出 = *事实;
    return true;
}

// P14-诊断责任：向上送出；最终责任边界：读回调用边。
bool 读取节点(const L1事实基座服务& L1, 稳定编码 编码, std::uint64_t 代次,
    节点事实& 输出, L1动态状态& 失败) {
    return 读取当前或历史<节点事实>(L1, 编码, 代次,
        [&] { return L1.读取当前节点({L1事实基座合同版本, 编码}); }, 输出, 失败);
}

// P14-诊断责任：向上送出；最终责任边界：读回调用边。
bool 读取关系(const L1事实基座服务& L1, 稳定编码 编码, std::uint64_t 代次,
    关系事实& 输出, L1动态状态& 失败) {
    return 读取当前或历史<关系事实>(L1, 编码, 代次,
        [&] { return L1.读取当前关系({L1事实基座合同版本, 编码}); }, 输出, 失败);
}

// P14-诊断责任：向上送出；最终责任边界：读回调用边。
bool 读取值(const L1事实基座服务& L1, 稳定编码 编码, std::uint64_t 代次,
    值事实& 输出, L1动态状态& 失败) {
    return 读取当前或历史<值事实>(L1, 编码, 代次,
        [&] { return L1.读取当前值({L1事实基座合同版本, 编码}); }, 输出, 失败);
}

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
bool 属性槽精确(const 节点事实& 节点, 稳定编码 类型, 稳定编码 值) noexcept {
    std::size_t 数量 = 0;
    for (const auto& 槽 : 节点.当前属性) {
        if (槽.属性类型节点 != 类型) continue;
        ++数量;
        if (槽.当前值 != 值) return false;
    }
    return 数量 == 1;
}

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
bool checked差异(std::int64_t 旧值, std::int64_t 新值, std::int64_t& 差异) noexcept {
    if ((旧值 > 0 && 新值 < std::numeric_limits<std::int64_t>::min() + 旧值)
        || (旧值 < 0 && 新值 > std::numeric_limits<std::int64_t>::max() + 旧值))
        return false;
    差异 = 新值 - 旧值;
    return true;
}

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
std::uint8_t 三态编码(std::int8_t 三态) noexcept {
    return 三态 < 0 ? 1 : 三态 == 0 ? 2 : 3;
}

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
template<class T>
void 散列加入(std::uint64_t& 摘要, T 值) noexcept {
    for (std::size_t i = 0; i < sizeof(T); ++i) {
        摘要 ^= static_cast<std::uint8_t>(static_cast<std::uint64_t>(值) >> (i * 8));
        摘要 *= 1099511628211ULL;
    }
}

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
void 散列加入(std::uint64_t& 摘要, 稳定编码 编码) noexcept { 散列加入(摘要, 编码.值); }

// P14-诊断责任：无适用错误分支；最终责任边界：调用服务。
bool 节点类型符合(const 节点事实& 节点, std::size_t 索引) noexcept {
    if (索引 < 2) return 节点.种类 == 节点种类::普通 && !节点.属性类型表示;
    const std::array<值表示种类, 8> 表示{值表示种类::I64, 值表示种类::I64,
        值表示种类::I64, 值表示种类::U64组, 值表示种类::U64组,
        值表示种类::I64, 值表示种类::U64组, 值表示种类::I64组};
    return 节点.种类 == 节点种类::属性类型
        && 节点.属性类型表示 == std::optional{表示[索引 - 2]};
}

// PRE2-诊断责任：无适用错误分支；纯常量身份读取由公开服务入口转发。
状态迁移动能规格提供者身份凭证 固定规格提供者身份() noexcept { return {}; }

// PRE2-诊断责任：无适用错误分支；证据副本形状谓词。
状态迁移动能规格写前事实种类 副本种类(const L1事实副本& 副本) noexcept {
    return std::visit([](const auto& 事实) {
        using T = std::decay_t<decltype(事实)>;
        if constexpr (std::is_same_v<T, 节点事实>)
            return 状态迁移动能规格写前事实种类::节点;
        if constexpr (std::is_same_v<T, 关系事实>)
            return 状态迁移动能规格写前事实种类::关系;
        return 状态迁移动能规格写前事实种类::值;
    }, 副本);
}

// PRE2-诊断责任：无适用错误分支；证据副本身份谓词。
稳定编码 副本身份(const L1事实副本& 副本) noexcept {
    return std::visit([](const auto& 事实) { return 事实.编码; }, 副本);
}

// PRE2-诊断责任：无适用错误分支；当前/历史生命周期谓词。
bool 副本已退出(const L1事实副本& 副本) noexcept {
    return std::visit([](const auto& 事实) { return 事实.退出事实代次.has_value(); }, 副本);
}

// PRE2-诊断责任：无适用错误分支；当前快照唯一事实查找。
std::optional<L1事实副本> 找唯一当前副本(const L1完整快照& 快照,
    状态迁移动能规格写前事实种类 种类, 稳定编码 身份) {
    std::optional<L1事实副本> 找到;
    std::size_t 数量 = 0;
    const auto 查找 = [&](const auto& 组, 状态迁移动能规格写前事实种类 当前种类) {
        for (const auto& 事实 : 组) {
            if (事实.编码 != 身份) continue;
            ++数量;
            if (当前种类 == 种类) 找到 = L1事实副本{事实};
        }
    };
    查找(快照.当前节点, 状态迁移动能规格写前事实种类::节点);
    查找(快照.当前关系, 状态迁移动能规格写前事实种类::关系);
    查找(快照.当前值, 状态迁移动能规格写前事实种类::值);
    return 数量 == 1 ? 找到 : std::nullopt;
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 状态节点相同(const 状态节点见证& 左, const 状态节点见证& 右) noexcept {
    return 左.编码 == 右.编码 && 左.创建事实代次 == 右.创建事实代次
        && 左.退出事实代次 == 右.退出事实代次;
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 状态关系相同(const 状态关系见证& 左, const 状态关系见证& 右) noexcept {
    return 左.编码 == 右.编码 && 左.关系类型 == 右.关系类型 && 左.源 == 右.源
        && 左.目标 == 右.目标 && 左.顺序号 == 右.顺序号
        && 左.创建事实代次 == 右.创建事实代次 && 左.退出事实代次 == 右.退出事实代次;
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 状态I64相同(const 状态I64事实见证& 左, const 状态I64事实见证& 右) noexcept {
    return 左.编码 == 右.编码 && 左.所属节点 == 右.所属节点
        && 左.属性类型 == 右.属性类型 && 左.材料 == 右.材料
        && 左.来源节点 == 右.来源节点 && 左.前一值 == 右.前一值
        && 左.创建事实代次 == 右.创建事实代次 && 左.退出事实代次 == 右.退出事实代次
        && 左.当前状态发布代次 == 右.当前状态发布代次;
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 状态U64相同(const 状态U64组事实见证& 左, const 状态U64组事实见证& 右) noexcept {
    return 左.编码 == 右.编码 && 左.所属节点 == 右.所属节点
        && 左.属性类型 == 右.属性类型 && 左.材料 == 右.材料
        && 左.来源节点 == 右.来源节点 && 左.前一值 == 右.前一值
        && 左.创建事实代次 == 右.创建事实代次 && 左.退出事实代次 == 右.退出事实代次
        && 左.当前状态发布代次 == 右.当前状态发布代次;
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 前状态相同(const 实际存在I64基准状态事实& 左,
    const 实际存在I64基准状态事实& 右) noexcept {
    return 左.合同版本 == 右.合同版本 && 左.规则版本 == 右.规则版本
        && 左.读取事实截止代次 == 右.读取事实截止代次
        && 左.状态采样事实截止代次 == 右.状态采样事实截止代次
        && 状态节点相同(左.状态, 右.状态) && 状态节点相同(左.场景, 右.场景)
        && 状态节点相同(左.主体, 右.主体) && 状态节点相同(左.特征, 右.特征)
        && 状态节点相同(左.特征值, 右.特征值) && 状态节点相同(左.来源存在, 右.来源存在)
        && 状态关系相同(左.主体关系, 右.主体关系) && 状态关系相同(左.场景关系, 右.场景关系)
        && 状态关系相同(左.特征关系, 右.特征关系) && 状态关系相同(左.值关系, 右.值关系)
        && 状态关系相同(左.来源存在关系, 右.来源存在关系)
        && 状态I64相同(左.状态资格, 右.状态资格) && 状态U64相同(左.发生时间, 右.发生时间)
        && 状态I64相同(左.特征值见证资格, 右.特征值见证资格)
        && 状态U64相同(左.被采样P8值引用, 右.被采样P8值引用)
        && 状态I64相同(左.采样I64值, 右.采样I64值)
        && 状态I64相同(左.被采样P8值, 右.被采样P8值);
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 后当前相同(const I64状态迁移后当前见证& 左,
    const I64状态迁移后当前见证& 右) noexcept {
    return 左.事实截止代次 == 右.事实截止代次 && 左.主体 == 右.主体
        && 左.当前场景 == 右.当前场景 && 左.当前场景归属关系 == 右.当前场景归属关系
        && 左.实例槽 == 右.实例槽 && 左.特征定义 == 右.特征定义
        && 左.宿主关系 == 右.宿主关系 && 左.定义关系 == 右.定义关系
        && 状态I64相同(左.当前值, 右.当前值);
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 前态选择相同(const I64相邻前状态选择证据& 左,
    const I64相邻前状态选择证据& 右) noexcept {
    return 左.选择规则版本 == 右.选择规则版本 && 左.业务查询身份 == 右.业务查询身份
        && 左.读取事实截止代次 == 右.读取事实截止代次 && 左.主体 == 右.主体
        && 左.实例槽 == 右.实例槽 && 左.拟发布后状态发生时间 == 右.拟发布后状态发生时间
        && 左.前状态 == 右.前状态 && 左.前状态发生时间 == 右.前状态发生时间;
}

// PRE2-诊断责任：无适用错误分支；PRE1传递见证逐字段互证。
bool 比较相同(const 特征比较结果& 左, const 特征比较结果& 右) noexcept {
    const auto 差异相同 = [&] {
        if (左.差异材料.has_value() != 右.差异材料.has_value()) return false;
        if (!左.差异材料) return true;
        const auto& a = *左.差异材料; const auto& b = *右.差异材料;
        return a.原始类型 == b.原始类型 && a.值 == b.值 && a.单位 == b.单位
            && a.维度 == b.维度 && a.分量角色 == b.分量角色 && a.方向 == b.方向
            && a.算法版本 == b.算法版本 && a.可表示 == b.可表示;
    };
    const auto 回执相同 = [](const auto& a, const auto& b) {
        if (a.has_value() != b.has_value()) return false;
        return !a || (a->事实身份 == b->事实身份 && a->来源节点 == b->来源节点
            && a->创建事实代次 == b->创建事实代次);
    };
    return 左.请求身份 == 右.请求身份 && 左.状态 == 右.状态 && 左.拒绝原因 == 右.拒绝原因
        && 左.事实截止代次 == 右.事实截止代次 && 左.注册身份 == 右.注册身份
        && 左.算法版本 == 右.算法版本 && 左.排序三态 == 右.排序三态
        && 左.具名关系 == 右.具名关系 && 差异相同()
        && 左.误差预算 == 右.误差预算 && 左.相等容差 == 右.相等容差
        && 左.边界包含 == 右.边界包含 && 左.量化规则 == 右.量化规则
        && 左.误差合同版本 == 右.误差合同版本 && 左.实际单位 == 右.实际单位
        && 左.实际维度 == 右.实际维度 && 左.实际分量角色 == 右.实际分量角色
        && 左.实际左角色 == 右.实际左角色 && 左.实际右角色 == 右.实际右角色
        && 左.实际方向 == 右.实际方向 && 回执相同(左.左输入回执, 右.左输入回执)
        && 回执相同(左.右输入回执, 右.右输入回执);
}

// PRE2-诊断责任：无适用错误分支；PRE1强类型凭证完整性谓词。
bool PRE1凭证完整(const 实际存在I64后继状态规格结果& 后继状态) noexcept {
    if (!后继状态.状态规格 || !后继状态.迁移证据 || !后继状态.提供者证据)
        return false;
    const auto& 凭证 = *后继状态.提供者证据;
    const auto& 迁移 = *后继状态.迁移证据;
    const auto 身份 = 读取后继状态规格提供者身份();
    if (凭证.合同版本 != 后继状态规格提供者证据合同版本
        || 凭证.规则版本 != 后继状态规格提供者证据规则版本
        || !(凭证.直接提供者 == 身份) || 凭证.直接调用次数 != 1
        || 凭证.去重后提供者见证数量 != 1 || 凭证.共同事实截止代次 == 0
        || !L1状态结构登记完整(凭证.状态登记)
        || 凭证.共同事实截止代次 != 后继状态.状态规格->事实截止代次
        || !后当前相同(凭证.后当前, 迁移.输入.后当前)
        || !前状态相同(凭证.前状态, 迁移.输入.前状态)
        || !前态选择相同(凭证.前态选择, 迁移.前态选择)
        || !比较相同(凭证.比较, 迁移.比较)
        || 凭证.写前事实身份组.empty()
        || 凭证.写前事实身份组.size() != 凭证.写前事实副本组.size()
        || 凭证.去重后写前事实见证数量 != 凭证.写前事实身份组.size())
        return false;
    for (std::size_t i = 0; i < 凭证.写前事实身份组.size(); ++i) {
        const auto& 项 = 凭证.写前事实身份组[i];
        const auto& 副本 = 凭证.写前事实副本组[i];
        if (!有效(项.身份) || 项.观察事实代次 != 凭证.共同事实截止代次
            || static_cast<std::uint8_t>(项.种类)
                != static_cast<std::uint8_t>(副本种类(副本))
            || 项.身份 != 副本身份(副本)
            || (项.副本来源 != 后继状态规格写前事实副本来源::最终G1当前事实
                && 项.副本来源 != 后继状态规格写前事实副本来源::P12前状态历史事实)
            || (项.副本来源 == 后继状态规格写前事实副本来源::最终G1当前事实
                && 副本已退出(副本))
            || (项.副本来源 == 后继状态规格写前事实副本来源::P12前状态历史事实
                && !副本已退出(副本)))
            return false;
        if (i != 0) {
            const auto& 前 = 凭证.写前事实身份组[i - 1];
            const auto 前种类 = static_cast<std::uint8_t>(前.种类);
            const auto 当前种类 = static_cast<std::uint8_t>(项.种类);
            if (前种类 > 当前种类 || (前种类 == 当前种类 && !(前.身份 < 项.身份)))
                return false;
        }
    }
    return true;
}

struct 规格证据候选 final {
    状态迁移动能规格写前事实身份 身份;
    L1事实副本 副本;
};

// PRE2-诊断责任：无适用错误分支；写集只读覆盖谓词。
bool 规格写集引用已覆盖(const L1写集请求& 写集,
    const std::vector<规格证据候选>& 候选组) noexcept {
    const auto 有节点 = [&](稳定编码 身份) {
        return std::any_of(候选组.begin(), 候选组.end(), [&](const auto& 候选) {
            return 候选.身份.种类 == 状态迁移动能规格写前事实种类::节点
                && 候选.身份.身份 == 身份;
        });
    };
    const auto 覆盖 = [&](const 事实引用& 引用) {
        const auto* 编码 = std::get_if<稳定编码>(&引用);
        return !编码 || 有节点(*编码);
    };
    for (const auto& 项 : 写集.关系)
        if (!覆盖(项.源节点) || !覆盖(项.目标节点) || !覆盖(项.关系类型节点)) return false;
    for (const auto& 项 : 写集.值)
        if (!覆盖(项.所属节点) || !覆盖(项.属性类型节点) || !覆盖(项.来源节点)) return false;
    for (const auto& 项 : 写集.属性槽变更)
        if (!覆盖(项.所属节点) || !覆盖(项.属性类型节点)) return false;
    return true;
}

// PRE2-诊断责任：向上送出；分配异常由公开P14边界分类。
std::optional<状态迁移动能规格提供者证据凭证> 形成规格提供者证据(
    const L1完整快照& G0, const L1动态结构登记& 登记,
    const 后继状态规格提供者证据凭证& PRE1,
    const L1写集请求& 写集) {
    std::vector<规格证据候选> 候选组;
    const 稳定编码 登记身份[] = {登记.服务身份, 登记.关系20动态组成关系类型,
        登记.动态资格属性类型, 登记.动态种类属性类型, 登记.聚合规则版本属性类型,
        登记.时间范围属性类型, 登记.迁移比较合同属性类型,
        登记.迁移差异I64属性类型, 登记.比较输入引用属性类型,
        登记.比较输入I64组属性类型};
    for (std::size_t i = 0; i < std::size(登记身份); ++i) {
        const auto 身份 = 登记身份[i];
        auto 副本 = 找唯一当前副本(G0, 状态迁移动能规格写前事实种类::节点, 身份);
        const auto* 节点 = 副本 ? std::get_if<节点事实>(&*副本) : nullptr;
        if (!节点 || !节点类型符合(*节点, i)) return std::nullopt;
        候选组.push_back({{状态迁移动能规格写前事实种类::节点, 身份,
            G0.事实代次, 状态迁移动能规格写前事实副本来源::动态登记当前事实},
            std::move(*副本)});
    }
    for (std::size_t i = 0; i < PRE1.写前事实身份组.size(); ++i) {
        const auto& 身份 = PRE1.写前事实身份组[i];
        const auto 来源 = 身份.副本来源 == 后继状态规格写前事实副本来源::最终G1当前事实
            ? 状态迁移动能规格写前事实副本来源::P13传递当前事实
            : 状态迁移动能规格写前事实副本来源::P13传递历史事实;
        候选组.push_back({{static_cast<状态迁移动能规格写前事实种类>(身份.种类),
            身份.身份, G0.事实代次, 来源}, PRE1.写前事实副本组[i]});
    }
    std::sort(候选组.begin(), 候选组.end(), [](const auto& 左, const auto& 右) {
        const auto 左种类 = static_cast<std::uint8_t>(左.身份.种类);
        const auto 右种类 = static_cast<std::uint8_t>(右.身份.种类);
        if (左种类 != 右种类) return 左种类 < 右种类;
        if (左.身份.身份 != 右.身份.身份) return 左.身份.身份 < 右.身份.身份;
        return static_cast<std::uint8_t>(左.身份.副本来源)
            < static_cast<std::uint8_t>(右.身份.副本来源);
    });
    for (std::size_t i = 0; i < 候选组.size(); ++i)
        for (std::size_t j = i + 1; j < 候选组.size(); ++j)
            if (候选组[i].身份.身份 == 候选组[j].身份.身份
                && 候选组[i].身份.种类 != 候选组[j].身份.种类) return std::nullopt;
    std::vector<规格证据候选> 去重组;
    for (auto& 候选 : 候选组) {
        if (!去重组.empty() && 去重组.back().身份.种类 == 候选.身份.种类
            && 去重组.back().身份.身份 == 候选.身份.身份) {
            if (!(去重组.back().副本 == 候选.副本)) return std::nullopt;
            continue;
        }
        去重组.push_back(std::move(候选));
    }
    if (去重组.empty() || !规格写集引用已覆盖(写集, 去重组)) return std::nullopt;
    状态迁移动能规格提供者证据凭证 凭证;
    凭证.共同事实截止代次 = G0.事实代次;
    凭证.动态登记 = 登记;
    for (auto& 候选 : 去重组) {
        凭证.写前事实身份组.push_back(候选.身份);
        凭证.写前事实副本组.push_back(std::move(候选.副本));
    }
    凭证.去重后写前事实见证数量 =
        static_cast<std::uint32_t>(凭证.写前事实身份组.size());
    if (凭证.写前事实身份组.size() != 凭证.写前事实副本组.size()
        || 凭证.去重后写前事实见证数量 == 0) return std::nullopt;
    return 凭证;
}

} // namespace 海中鱼巣::L1动态内部

export namespace 海中鱼巣 {

class L1动态服务 final {
public:
    // P14-诊断责任：无适用错误分支；最终责任边界：构造调用边。
    explicit L1动态服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L1动态服务(const L1动态服务&) = delete;
    L1动态服务& operator=(const L1动态服务&) = delete;

    // PRE2-诊断责任：无适用错误分支；纯常量身份读取，无锁、无事实读取或分配。
    状态迁移动能规格提供者身份凭证
    读取状态迁移动能规格提供者身份() const noexcept {
        return L1动态内部::固定规格提供者身份();
    }

    // P14-诊断责任：向上送出；最终责任边界：公开结构化结果或未来合法消费者。
    L1动态登记结果 建立登记(const L1动态登记请求& 请求) {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1动态合同版本 || 请求.规则版本 != L1动态规则版本
                || !动态操作幂等身份有效(请求.幂等身份) || 请求.期望事实代次 == 0)
                return {};
            const auto 凭证 = L1动态内部::形成登记意图凭证(请求);
            const auto 幂等键 = L1动态内部::映射登记幂等键(请求.幂等身份);
            const auto 探测 = L1_.探测幂等({L1事实基座合同版本,
                L1幂等摘要合同版本, 幂等键, 凭证.请求意图摘要, 凭证});
            if (探测.状态 == L1幂等探测状态::同义已发布) {
                if (!探测.首次结果 || !L1动态内部::映射完整唯一(
                    探测.首次结果->首次新编码映射, 10))
                    return {L1动态状态::内部不一致, std::nullopt};
                auto 登记 = 从映射读回登记(请求.幂等身份,
                    探测.首次结果->首次发布事实代次,
                    探测.首次结果->首次新编码映射);
                if (!登记) return {L1动态状态::内部不一致, std::nullopt};
                if (首次登记请求_ && *首次登记请求_ != 请求)
                    return {L1动态状态::内部不一致, std::nullopt};
                首次登记请求_ = 请求;
                登记_ = *登记;
                return {L1动态状态::已登记, 登记_};
            }
            if (探测.状态 == L1幂等探测状态::异义冲突)
                return {L1动态状态::幂等冲突, std::nullopt};
            if (探测.状态 == L1幂等探测状态::已隔离
                || 探测.状态 == L1幂等探测状态::内部不一致)
                return {L1动态状态::内部不一致, std::nullopt};
            if (探测.状态 != L1幂等探测状态::未找到)
                return {L1动态状态::入口拒绝, std::nullopt};
            if (首次登记请求_) return *首次登记请求_ == 请求
                ? L1动态登记结果{L1动态状态::已登记, 登记_}
                : L1动态登记结果{L1动态状态::幂等冲突, std::nullopt};

            const auto 快照 = L1_.读取完整快照({});
            if (快照.状态 != L1读取状态::成功 || !快照.快照)
                return {L1动态内部::映射读取状态(快照.状态), std::nullopt};
            if (快照.快照->事实代次 == 0 || 快照.快照->事实代次 != 请求.期望事实代次)
                return {L1动态状态::版本漂移, std::nullopt};
            if (快照.快照->当前节点.empty() && 快照.快照->当前关系.empty()
                && 快照.快照->当前值.empty())
                return {L1动态状态::入口拒绝, std::nullopt};

            L1写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.领域意图凭证 = 凭证;
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::普通, std::nullopt},
                {{3}, 节点种类::属性类型, 值表示种类::I64},
                {{4}, 节点种类::属性类型, 值表示种类::I64},
                {{5}, 节点种类::属性类型, 值表示种类::I64},
                {{6}, 节点种类::属性类型, 值表示种类::U64组},
                {{7}, 节点种类::属性类型, 值表示种类::U64组},
                {{8}, 节点种类::属性类型, 值表示种类::I64},
                {{9}, 节点种类::属性类型, 值表示种类::U64组},
                {{10}, 节点种类::属性类型, 值表示种类::I64组}};
            const auto 写入 = L1_.提交写集(写集, L1动态登记操作标签);
            const auto 状态 = L1动态内部::映射写入状态(写入.状态);
            if (状态 != L1动态状态::已登记)
                return {状态, std::nullopt};
            if (写入.事实代次 == 0 || !L1动态内部::映射完整唯一(写入.新编码映射, 10))
                return {L1动态状态::内部不一致, std::nullopt};
            auto 登记 = 从映射读回登记(请求.幂等身份, 写入.事实代次, 写入.新编码映射);
            if (!登记) return {L1动态状态::内部不一致, std::nullopt};
            首次登记请求_ = 请求;
            登记_ = *登记;
            return {状态, 登记_};
        } catch (const std::bad_alloc&) {
            return {L1动态状态::资源失败, std::nullopt};
        } catch (...) {
            return {L1动态状态::内部不一致, std::nullopt};
        }
    }

    // P14-诊断责任：向上送出；最终责任边界：公开结构化结果或未来合法消费者。
    L1动态登记结果 读取当前登记() const {
        std::lock_guard<std::recursive_mutex> 锁(锁_);
        try {
            if (!登记_ || !L1动态结构登记完整(*登记_))
                return {L1动态状态::登记未加载, std::nullopt};
            const std::array<稳定编码, 10> 编码组{登记_->服务身份,
                登记_->关系20动态组成关系类型, 登记_->动态资格属性类型,
                登记_->动态种类属性类型, 登记_->聚合规则版本属性类型,
                登记_->时间范围属性类型, 登记_->迁移比较合同属性类型,
                登记_->迁移差异I64属性类型, 登记_->比较输入引用属性类型,
                登记_->比较输入I64组属性类型};
            for (std::size_t i = 0; i < 编码组.size(); ++i) {
                const auto 读取 = L1_.读取当前节点({L1事实基座合同版本, 编码组[i]});
                const auto* 节点 = 读取.事实 ? std::get_if<节点事实>(&*读取.事实) : nullptr;
                if (读取.状态 != L1读取状态::成功 || !节点 || 节点->退出事实代次
                    || !L1动态内部::节点类型符合(*节点, i))
                    return {读取.状态 == L1读取状态::成功
                        ? L1动态状态::内部不一致
                        : L1动态内部::映射读取状态(读取.状态), std::nullopt};
            }
            return {L1动态状态::已读取, 登记_};
        } catch (const std::bad_alloc&) {
            return {L1动态状态::资源失败, std::nullopt};
        } catch (...) {
            return {L1动态状态::内部不一致, std::nullopt};
        }
    }

    // P14-诊断责任：向上送出；最终责任边界：公开结构化结果或未来合法消费者。
    状态迁移动能规格结果 形成状态迁移动能规格(
        const 实际存在I64后继状态规格结果& 后继状态) const {
        try {
            if (后继状态.状态 == I64后继状态规格状态::无前状态)
                return {L1动态状态::无需形成, 状态迁移动能规格原因::无前状态, std::nullopt};
            if (后继状态.状态 != I64后继状态规格状态::已形成)
                return {L1动态内部::映射上游状态(后继状态.状态),
                    状态迁移动能规格原因::上游非成功, std::nullopt};
            if (!L1动态内部::PRE1凭证完整(后继状态))
                return {L1动态状态::内部不一致,
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt};
            std::optional<L1动态结构登记> 登记;
            {
                std::lock_guard<std::recursive_mutex> 锁(锁_);
                登记 = 登记_;
            }
            if (!登记 || !L1动态结构登记完整(*登记))
                return {L1动态状态::登记未加载, 状态迁移动能规格原因::无, std::nullopt};

            const auto G0 = L1_.读取完整快照({});
            if (G0.状态 != L1读取状态::成功 || !G0.快照)
                return {L1动态内部::映射读取状态(G0.状态),
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt};
            if (G0.快照->事实代次 == 0
                || G0.快照->事实代次 != 后继状态.状态规格->事实截止代次
                || G0.快照->事实代次 != 后继状态.提供者证据->共同事实截止代次)
                return {L1动态状态::内部不一致,
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt};

            const auto& 状态规格 = *后继状态.状态规格;
            const auto& 迁移 = *后继状态.迁移证据;
            const auto& 比较 = 迁移.比较;
            const auto& 输入 = 迁移.输入;
            const auto& 前 = 输入.前状态;
            const auto& 后 = 输入.后当前;
            if (!比较.具名关系 || !比较.排序三态 || !比较.差异材料
                || !比较.左输入回执 || !比较.右输入回执
                || 状态规格.规格版本 != I64后继状态规格版本
                || 状态规格.事实截止代次 == 0
                || 状态规格.事实截止代次 != 比较.事实截止代次
                || 状态规格.事实截止代次 != 前.读取事实截止代次
                || 状态规格.事实截止代次 != 后.事实截止代次
                || 状态规格.请求意图.业务请求身份 == 0
                || 状态规格.请求意图.整理幂等身份 == 0
                || 状态规格.请求意图.新状态发生时间 == 0
                || 状态规格.请求意图.主体 != 后.主体
                || 状态规格.请求意图.场景 != 后.当前场景
                || 状态规格.请求意图.实例槽 != 后.实例槽
                || 状态规格.请求意图.新当前值 != 后.当前值.编码
                || 状态规格.请求意图.前状态 != 前.状态.编码
                || 状态规格.请求意图.比较注册身份 != 比较.注册身份
                || 状态规格.请求意图.比较算法版本 != 比较.算法版本
                || 前.发生时间.材料.size() != 1 || 前.发生时间.材料.front() == 0
                || 前.发生时间.材料.front() >= 状态规格.请求意图.新状态发生时间
                || 前.主体.编码 != 后.主体 || 前.场景.编码 != 后.当前场景
                || 前.特征.编码 != 后.实例槽 || 前.来源存在.编码 != 后.主体
                || 迁移.前态选择.读取事实截止代次 != 状态规格.事实截止代次
                || 迁移.前态选择.前状态 != 前.状态.编码
                || 迁移.前态选择.前状态发生时间 != 前.发生时间.材料.front())
                return {L1动态状态::内部不一致,
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt};

            const auto 具名关系 = *比较.具名关系;
            const auto 三态 = *比较.排序三态;
            const auto 差异材料 = *比较.差异材料;
            const bool 等价合法 = 迁移.等价 && 三态 == 0 && 差异材料.值 == 0
                && 具名关系 == 特征比较具名关系::状态迁移等价;
            if (状态规格.动态准入 == 后继状态动态准入::禁止生成迁移动能) {
                return 等价合法
                    ? 状态迁移动能规格结果{L1动态状态::禁止形成,
                        状态迁移动能规格原因::材料等价, std::nullopt}
                    : 状态迁移动能规格结果{L1动态状态::内部不一致,
                        状态迁移动能规格原因::迁移证据不完整, std::nullopt};
            }
            const bool 增加 = !迁移.等价 && 三态 == -1 && 差异材料.值 > 0
                && 具名关系 == 特征比较具名关系::状态迁移增加;
            const bool 减少 = !迁移.等价 && 三态 == 1 && 差异材料.值 < 0
                && 具名关系 == 特征比较具名关系::状态迁移减少;
            if (状态规格.动态准入 != 后继状态动态准入::允许形成迁移动能规格
                || (!增加 && !减少) || !差异材料.可表示
                || 差异材料.原始类型 != 特征比较原始类型::I64
                || 差异材料.方向 != 特征比较方向::右减左
                || 比较.实际左角色 != 特征比较角色::前状态
                || 比较.实际右角色 != 特征比较角色::后当前事实
                || 比较.实际方向 != 特征比较方向::右减左
                || 比较.误差合同版本 == 0 || 比较.算法版本 == 0
                || !有效(比较.注册身份) || !有效(比较.实际单位)
                || !有效(比较.实际维度) || !有效(比较.实际分量角色))
                return {L1动态状态::内部不一致,
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt};
            std::int64_t 计算差异 = 0;
            if (!L1动态内部::checked差异(前.采样I64值.材料, 后.当前值.材料, 计算差异)
                || 计算差异 != 差异材料.值)
                return {L1动态状态::内部不一致,
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt};

            状态迁移动能写入规格 规格;
            规格.事实截止代次 = 状态规格.事实截止代次;
            规格.请求意图 = {状态规格.请求意图.业务请求身份,
                状态规格.请求意图.整理幂等身份, 前.发生时间.材料.front(),
                状态规格.请求意图.新状态发生时间, 后.主体, 后.当前场景,
                后.实例槽, 前.状态.编码, {0x53000001}};
            auto& 写集 = 规格.写集;
            写集.合同版本 = 1;
            写集.期望事实代次 = 状态规格.事实截止代次;
            写集.幂等键 = {};
            constexpr 写集本地键 动态键{0x44000001};
            写集.节点 = {{动态键, 节点种类::普通, std::nullopt}};
            const std::vector<std::uint64_t> 比较合同{
                状态迁移动能比较证据版本, 后.特征定义.值, 比较.注册身份.值,
                比较.算法版本, static_cast<std::uint8_t>(特征比较用途::状态迁移),
                static_cast<std::uint8_t>(特征比较原始类型::I64),
                static_cast<std::uint8_t>(具名关系), L1动态内部::三态编码(三态), 0,
                比较.实际单位.值, 比较.实际维度.值, 比较.实际分量角色.值,
                static_cast<std::uint8_t>(特征比较方向::右减左), 1,
                static_cast<std::uint8_t>(比较.边界包含),
                static_cast<std::uint8_t>(比较.量化规则), 比较.误差合同版本,
                比较.事实截止代次, 登记->迁移差异I64属性类型.值, 1};
            const std::vector<std::uint64_t> 输入引用{
                前.状态.编码.值, 前.被采样P8值.编码.值,
                前.被采样P8值.属性类型.值, 前.被采样P8值.创建事实代次,
                前.被采样P8值.退出事实代次.value_or(0), 前.被采样P8值.来源节点.值,
                后.当前值.编码.值, 后.当前值.属性类型.值,
                后.当前值.创建事实代次, 后.当前值.来源节点.值,
                后.实例槽.值, 后.特征定义.值, 状态规格.事实截止代次};
            写集.值 = {
                {{0x44000002}, 动态键, 登记->动态资格属性类型, std::int64_t{1}, 登记->服务身份},
                {{0x44000003}, 动态键, 登记->动态种类属性类型,
                    std::int64_t{static_cast<std::int64_t>(动态种类::状态迁移)}, 登记->服务身份},
                {{0x44000004}, 动态键, 登记->聚合规则版本属性类型, std::int64_t{0}, 登记->服务身份},
                {{0x44000005}, 动态键, 登记->时间范围属性类型,
                    std::vector<std::uint64_t>{前.发生时间.材料.front(), 状态规格.请求意图.新状态发生时间}, 后.主体},
                {{0x44000006}, 动态键, 登记->迁移比较合同属性类型, 比较合同, 后.主体},
                {{0x44000007}, 动态键, 登记->迁移差异I64属性类型, 差异材料.值, 后.主体},
                {{0x44000008}, 动态键, 登记->比较输入引用属性类型, 输入引用, 后.主体},
                {{0x44000009}, 动态键, 登记->比较输入I64组属性类型,
                    std::vector<std::int64_t>{前.采样I64值.材料, 后.当前值.材料}, 后.主体}};
            写集.关系 = {
                {{0x4400000A}, 动态键, 后.主体, 登记->关系20动态组成关系类型, 1},
                {{0x4400000B}, 动态键, 后.当前场景, 登记->关系20动态组成关系类型, 2},
                {{0x4400000C}, 动态键, 后.实例槽, 登记->关系20动态组成关系类型, 3},
                {{0x4400000D}, 动态键, 前.状态.编码, 登记->关系20动态组成关系类型, 4},
                {{0x4400000E}, 动态键, 写集本地键{0x53000001}, 登记->关系20动态组成关系类型, 5},
                {{0x4400000F}, 动态键, 前.来源存在.编码, 登记->关系20动态组成关系类型, 9}};
            写集.属性槽变更 = {
                {动态键, 登记->动态资格属性类型, {0x44000002}},
                {动态键, 登记->动态种类属性类型, {0x44000003}},
                {动态键, 登记->聚合规则版本属性类型, {0x44000004}},
                {动态键, 登记->时间范围属性类型, {0x44000005}},
                {动态键, 登记->迁移比较合同属性类型, {0x44000006}},
                {动态键, 登记->迁移差异I64属性类型, {0x44000007}},
                {动态键, 登记->比较输入引用属性类型, {0x44000008}},
                {动态键, 登记->比较输入I64组属性类型, {0x44000009}}};
            std::uint64_t 摘要 = 1469598103934665603ULL;
            L1动态内部::散列加入(摘要, 规格.事实截止代次);
            L1动态内部::散列加入(摘要, 规格.请求意图.业务请求身份);
            L1动态内部::散列加入(摘要, 规格.请求意图.整理幂等身份);
            L1动态内部::散列加入(摘要, 规格.请求意图.前状态发生时间);
            L1动态内部::散列加入(摘要, 规格.请求意图.后状态发生时间);
            L1动态内部::散列加入(摘要, 规格.请求意图.主体);
            L1动态内部::散列加入(摘要, 规格.请求意图.场景);
            L1动态内部::散列加入(摘要, 规格.请求意图.实例槽);
            L1动态内部::散列加入(摘要, 规格.请求意图.前状态);
            L1动态内部::散列加入(摘要, static_cast<std::uint64_t>(差异材料.值));
            规格.确定性摘要 = 摘要 == 0 ? 1 : 摘要;
            auto 提供者证据 = L1动态内部::形成规格提供者证据(
                *G0.快照, *登记, *后继状态.提供者证据, 规格.写集);
            if (!提供者证据)
                return {L1动态状态::内部不一致,
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt, std::nullopt};
            const auto G1 = L1_.读取完整快照({});
            if (G1.状态 != L1读取状态::成功 || !G1.快照)
                return {L1动态内部::映射读取状态(G1.状态),
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt, std::nullopt};
            if (G1.快照->事实代次 != G0.快照->事实代次)
                return {L1动态状态::版本漂移,
                    状态迁移动能规格原因::迁移证据不完整, std::nullopt, std::nullopt};
            return {L1动态状态::已形成, 状态迁移动能规格原因::无,
                std::move(规格), std::move(提供者证据)};
        } catch (const std::bad_alloc&) {
            return {L1动态状态::资源失败, 状态迁移动能规格原因::无, std::nullopt};
        } catch (...) {
            return {L1动态状态::内部不一致,
                状态迁移动能规格原因::迁移证据不完整, std::nullopt};
        }
    }

    // P14-诊断责任：向上送出；最终责任边界：公开结构化结果或未来合法消费者。
    状态迁移动能结果 读取状态迁移动能(const 状态迁移动能读取请求& 请求) const {
        if (!状态迁移动能读取请求有效(请求)) return {};
        try {
            std::optional<L1动态结构登记> 登记;
            {
                std::lock_guard<std::recursive_mutex> 锁(锁_);
                登记 = 登记_;
            }
            if (!登记 || !L1动态结构登记完整(*登记))
                return {L1动态状态::登记未加载, std::nullopt};
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const auto G0 = L1_.读取完整快照({});
                if (G0.状态 != L1读取状态::成功 || !G0.快照)
                    return {L1动态内部::映射读取状态(G0.状态), std::nullopt};
                const auto 代次 = G0.快照->事实代次;
                状态迁移动能事实 事实;
                事实.读取事实截止代次 = 代次;
                节点事实 动态节点;
                std::array<关系事实, 6> 关系组;
                std::array<值事实, 8> 值组;
                L1动态状态 失败 = L1动态状态::内部不一致;
                if (!L1动态内部::读取节点(L1_, 请求.动态, 代次, 动态节点, 失败))
                    return {失败, std::nullopt};
                const std::array<稳定编码, 6> 关系编码{请求.主体关系, 请求.场景关系,
                    请求.被改变目标关系, 请求.前状态关系, 请求.后状态关系, 请求.来源存在关系};
                for (std::size_t i = 0; i < 6; ++i)
                    if (!L1动态内部::读取关系(L1_, 关系编码[i], 代次, 关系组[i], 失败))
                        return {失败, std::nullopt};
                const std::array<稳定编码, 8> 值编码{请求.动态资格值, 请求.动态种类值,
                    请求.聚合规则版本值, 请求.时间范围值, 请求.迁移比较合同值,
                    请求.迁移差异值, 请求.比较输入引用值, 请求.比较输入I64组值};
                for (std::size_t i = 0; i < 8; ++i)
                    if (!L1动态内部::读取值(L1_, 值编码[i], 代次, 值组[i], 失败))
                        return {失败, std::nullopt};

                const std::array<std::int64_t, 6> 角色{1,2,3,4,5,9};
                bool 形状完整 = 动态节点.种类 == 节点种类::普通;
                for (std::size_t i = 0; i < 6; ++i)
                    形状完整 = 形状完整 && 关系组[i].源节点 == 请求.动态
                        && 关系组[i].关系类型节点 == 登记->关系20动态组成关系类型
                        && 关系组[i].角色或顺序 == 角色[i];
                const std::array<稳定编码, 8> 属性类型{登记->动态资格属性类型,
                    登记->动态种类属性类型, 登记->聚合规则版本属性类型,
                    登记->时间范围属性类型, 登记->迁移比较合同属性类型,
                    登记->迁移差异I64属性类型, 登记->比较输入引用属性类型,
                    登记->比较输入I64组属性类型};
                for (std::size_t i = 0; i < 8; ++i)
                    形状完整 = 形状完整 && 值组[i].所属节点 == 请求.动态
                        && 值组[i].属性类型节点 == 属性类型[i]
                        && L1动态内部::属性槽精确(动态节点, 属性类型[i], 值组[i].编码);
                if (!形状完整) return {L1动态状态::内部不一致, std::nullopt};

                const auto* 资格 = std::get_if<std::int64_t>(&值组[0].材料);
                const auto* 种类 = std::get_if<std::int64_t>(&值组[1].材料);
                const auto* 聚合 = std::get_if<std::int64_t>(&值组[2].材料);
                const auto* 时间 = std::get_if<std::vector<std::uint64_t>>(&值组[3].材料);
                const auto* 合同 = std::get_if<std::vector<std::uint64_t>>(&值组[4].材料);
                const auto* 差异 = std::get_if<std::int64_t>(&值组[5].材料);
                const auto* 引用 = std::get_if<std::vector<std::uint64_t>>(&值组[6].材料);
                const auto* 输入 = std::get_if<std::vector<std::int64_t>>(&值组[7].材料);
                if (!资格 || *资格 != 1 || !种类 || *种类 != 1 || !聚合 || *聚合 != 0
                    || !时间 || 时间->size() != 2 || (*时间)[0] == 0 || (*时间)[0] >= (*时间)[1]
                    || !合同 || 合同->size() != 20 || !差异 || *差异 == 0
                    || !引用 || 引用->size() != 13 || !输入 || 输入->size() != 2)
                    return {L1动态状态::内部不一致, std::nullopt};
                std::int64_t 重算差异 = 0;
                if (!L1动态内部::checked差异((*输入)[0], (*输入)[1], 重算差异)
                    || 重算差异 != *差异 || (*合同)[0] != 状态迁移动能比较证据版本
                    || (*合同)[4] != static_cast<std::uint8_t>(特征比较用途::状态迁移)
                    || (*合同)[5] != static_cast<std::uint8_t>(特征比较原始类型::I64)
                    || ((*合同)[6] != static_cast<std::uint8_t>(特征比较具名关系::状态迁移增加)
                        && (*合同)[6] != static_cast<std::uint8_t>(特征比较具名关系::状态迁移减少))
                    || (*合同)[8] != 0 || (*合同)[12] != static_cast<std::uint8_t>(特征比较方向::右减左)
                    || (*合同)[13] != 1 || (*合同)[17] != (*引用)[12]
                    || (*合同)[18] != 登记->迁移差异I64属性类型.值 || (*合同)[19] != 1
                    || (*引用)[0] != 关系组[3].目标节点.值
                    || (*引用)[10] != 关系组[2].目标节点.值
                    || (*引用)[11] != (*合同)[1]
                    || 关系组[0].目标节点 != 关系组[5].目标节点
                    || 值组[0].来源节点 != 登记->服务身份
                    || 值组[1].来源节点 != 登记->服务身份
                    || 值组[2].来源节点 != 登记->服务身份)
                    return {L1动态状态::内部不一致, std::nullopt};
                for (std::size_t i = 3; i < 8; ++i)
                    if (值组[i].来源节点 != 关系组[5].目标节点)
                        return {L1动态状态::内部不一致, std::nullopt};

                事实.动态 = {动态节点.编码, 动态节点.创建事实代次,
                    动态节点.退出事实代次, 代次};
                auto 关系见证 = [&](const 关系事实& r) {
                    return 动态关系见证{r.编码, r.源节点, r.目标节点, r.关系类型节点,
                        r.角色或顺序, r.创建事实代次, r.退出事实代次, 代次};
                };
                事实.主体关系 = 关系见证(关系组[0]); 事实.场景关系 = 关系见证(关系组[1]);
                事实.被改变目标关系 = 关系见证(关系组[2]); 事实.前状态关系 = 关系见证(关系组[3]);
                事实.后状态关系 = 关系见证(关系组[4]); 事实.来源存在关系 = 关系见证(关系组[5]);
                auto I64见证 = [&](const 值事实& v) {
                    return 动态I64事实见证{v.编码, v.所属节点, v.属性类型节点,
                        std::get<std::int64_t>(v.材料), v.来源节点, std::nullopt,
                        v.创建事实代次, v.退出事实代次, 代次};
                };
                auto U64见证 = [&](const 值事实& v) {
                    return 动态U64组事实见证{v.编码, v.所属节点, v.属性类型节点,
                        std::get<std::vector<std::uint64_t>>(v.材料), v.来源节点, std::nullopt,
                        v.创建事实代次, v.退出事实代次, 代次};
                };
                事实.动态资格 = I64见证(值组[0]); 事实.动态种类值 = I64见证(值组[1]);
                事实.聚合规则版本值 = I64见证(值组[2]); 事实.时间范围值 = U64见证(值组[3]);
                事实.迁移比较合同值 = U64见证(值组[4]); 事实.迁移差异值 = I64见证(值组[5]);
                事实.比较输入引用值 = U64见证(值组[6]);
                事实.比较输入I64组值 = {值组[7].编码, 值组[7].所属节点,
                    值组[7].属性类型节点, *输入, 值组[7].来源节点, std::nullopt,
                    值组[7].创建事实代次, 值组[7].退出事实代次, 代次};
                事实.前状态发生时间 = (*时间)[0]; 事实.后状态发生时间 = (*时间)[1];
                事实.比较证据 = {static_cast<std::uint32_t>((*合同)[0]), {(*合同)[1]},
                    {(*合同)[2]}, static_cast<std::uint32_t>((*合同)[3]),
                    static_cast<std::uint8_t>((*合同)[4]), static_cast<std::uint8_t>((*合同)[5]),
                    static_cast<std::uint8_t>((*合同)[6]), static_cast<std::uint8_t>((*合同)[7]), false,
                    {(*合同)[9]}, {(*合同)[10]}, {(*合同)[11]}, static_cast<std::uint8_t>((*合同)[12]),
                    true, static_cast<std::uint8_t>((*合同)[14]), static_cast<std::uint8_t>((*合同)[15]),
                    static_cast<std::uint32_t>((*合同)[16]), (*合同)[17], {(*合同)[18]},
                    static_cast<std::uint32_t>((*合同)[19])};
                事实.输入见证 = {{(*引用)[0]}, {(*引用)[1]}, {(*引用)[2]}, (*引用)[3],
                    (*引用)[4] == 0 ? std::nullopt : std::optional<std::uint64_t>{(*引用)[4]},
                    {(*引用)[5]}, (*输入)[0], {(*引用)[6]}, {(*引用)[7]}, (*引用)[8],
                    {(*引用)[9]}, (*输入)[1], {(*引用)[10]}, {(*引用)[11]}, (*引用)[12]};
                const auto G1 = L1_.读取完整快照({});
                if (G1.状态 != L1读取状态::成功 || !G1.快照)
                    return {L1动态内部::映射读取状态(G1.状态), std::nullopt};
                if (G1.快照->事实代次 != 代次) {
                    if (尝试 == 0) continue;
                    return {L1动态状态::版本漂移, std::nullopt};
                }
                return {L1动态状态::已读取, std::move(事实)};
            }
            return {L1动态状态::版本漂移, std::nullopt};
        } catch (const std::bad_alloc&) {
            return {L1动态状态::资源失败, std::nullopt};
        } catch (...) {
            return {L1动态状态::内部不一致, std::nullopt};
        }
    }

    // P16-诊断责任：向上送出；只做所有者冻结的0x44局部键到读取DTO机械映射。
    迁移动能读回请求形成结果 从迁移动能新编码映射形成读取请求(
        const std::vector<std::pair<写集本地键, 稳定编码>>& 映射) const {
        try {
            std::array<稳定编码, 15> 编码组{};
            std::array<std::uint32_t, 15> 数量{};
            for (const auto& [键, 编码] : 映射) {
                if (键.值 < 0x44000001U || 键.值 > 0x4400000FU) continue;
                const auto 索引 = static_cast<std::size_t>(键.值 - 0x44000001U);
                ++数量[索引];
                编码组[索引] = 编码;
            }
            for (std::size_t i = 0; i < 编码组.size(); ++i)
                if (数量[i] != 1 || !有效(编码组[i]))
                    return {迁移动能读回请求形成状态::内部不一致, std::nullopt};
            return {迁移动能读回请求形成状态::已形成,
                状态迁移动能读取请求{L1动态合同版本, L1动态规则版本,
                    编码组[0], 编码组[1], 编码组[2], 编码组[3], 编码组[4],
                    编码组[5], 编码组[6], 编码组[7], 编码组[8], 编码组[9],
                    编码组[10], 编码组[11], 编码组[12], 编码组[13], 编码组[14]}};
        } catch (const std::bad_alloc&) {
            return {迁移动能读回请求形成状态::内部不一致, std::nullopt};
        } catch (...) {
            return {迁移动能读回请求形成状态::内部不一致, std::nullopt};
        }
    }

private:
    // P14-诊断责任：向上送出；最终责任边界：建立登记调用边。
    std::optional<L1动态结构登记> 从映射读回登记(动态操作幂等身份 身份,
        std::uint64_t 事实代次,
        const std::vector<std::pair<写集本地键, 稳定编码>>& 映射) const {
        if (事实代次 == 0 || !L1动态内部::映射完整唯一(映射, 10)) return std::nullopt;
        std::array<节点事实, 10> 节点组;
        L1动态状态 失败 = L1动态状态::内部不一致;
        for (std::uint32_t i = 1; i <= 10; ++i) {
            const auto 编码 = L1动态内部::查找映射(映射, i);
            if (!编码 || !L1动态内部::读取节点(L1_, *编码, 事实代次,
                节点组[i - 1], 失败) || !L1动态内部::节点类型符合(节点组[i - 1], i - 1))
                return std::nullopt;
        }
        L1动态结构登记 登记;
        登记.首次幂等身份 = 身份;
        登记.事实截止代次 = 事实代次;
        登记.服务身份 = 节点组[0].编码;
        登记.关系20动态组成关系类型 = 节点组[1].编码;
        登记.动态资格属性类型 = 节点组[2].编码;
        登记.动态种类属性类型 = 节点组[3].编码;
        登记.聚合规则版本属性类型 = 节点组[4].编码;
        登记.时间范围属性类型 = 节点组[5].编码;
        登记.迁移比较合同属性类型 = 节点组[6].编码;
        登记.迁移差异I64属性类型 = 节点组[7].编码;
        登记.比较输入引用属性类型 = 节点组[8].编码;
        登记.比较输入I64组属性类型 = 节点组[9].编码;
        return L1动态结构登记完整(登记) ? std::optional{登记} : std::nullopt;
    }

    L1事实基座服务& L1_;
    mutable std::recursive_mutex 锁_;
    std::optional<L1动态登记请求> 首次登记请求_;
    std::optional<L1动态结构登记> 登记_;
};

} // namespace 海中鱼巣
