module;

#include <cstdint>
#include <mutex>
#include <new>
#include <optional>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.服务.L1实际存在;

export import 海中鱼巣.领域.服务.L1场景结构;
import 海中鱼巣.核心.服务.L1事实基座;

export {
#include "L1实际存在.数据.h"
}

namespace 海中鱼巣::L1实际存在内部 {

inline constexpr std::uint64_t 登记幂等域 = 0x0AULL;

写集幂等键 映射幂等键(实际存在操作幂等身份 身份) noexcept {
    return {(登记幂等域 << 56) | 身份.值};
}

L1领域结果见证计划 形成实际存在登记结果计划() {
    return {L1领域结果计划格式版本, 0x15000301U,
        L1实际存在合同版本, L1实际存在规则版本, 1,
        {{1, {1}, 节点种类::普通, std::nullopt},
         {2, {2}, 节点种类::属性类型, 值表示种类::I64}}};
}

L1领域意图凭证 形成G6实际存在登记意图凭证(const 实际存在登记请求& 请求) {
    const auto 计划摘要 = 形成L1领域结果计划摘要(形成实际存在登记结果计划());
    std::vector<std::uint8_t> 编码{'H','Z','Y','-','L','1','G','6'};
    L1确定性编码内部::写U32(编码, L1请求意图格式版本);
    L1确定性编码内部::写U32(编码, 0x15000301U);
    L1确定性编码内部::写U8(编码, 1);
    编码.insert(编码.end(), 计划摘要.字节.begin(), 计划摘要.字节.end());
    L1确定性编码内部::写U32(编码, 请求.合同版本);
    L1确定性编码内部::写U32(编码, 请求.规则版本);
    L1确定性编码内部::写U64(编码, 请求.幂等身份.值);
    L1确定性编码内部::写U64(编码, 请求.期望事实代次);
    return {6, L1请求意图格式版本, 0x15000301U,
        L1确定性编码内部::哈希(std::move(编码)), 计划摘要};
}

std::optional<实际存在结构登记> 从结果见证形成登记(
    const L1领域结果见证段& 见证, 实际存在操作幂等身份 幂等身份) {
    const auto 计划 = 形成实际存在登记结果计划();
    if (见证.格式版本 != L1领域结果见证摘要版本
        || 见证.业务操作标签 != 计划.业务操作标签
        || 见证.领域合同版本 != 计划.领域合同版本
        || 见证.领域规则版本 != 计划.领域规则版本
        || 见证.入口变体 != 计划.入口变体 || 见证.发布事实代次 == 0
        || 见证.字段组.size() != 2) return std::nullopt;
    std::optional<稳定编码> 服务, 类型;
    for (const auto& 字段 : 见证.字段组) {
        if (字段.字段标签 == 1 && 字段.写集本地键值.值 == 1
            && 字段.对象种类 == 节点种类::普通 && !字段.属性类型表示) 服务 = 字段.本次新编码;
        else if (字段.字段标签 == 2 && 字段.写集本地键值.值 == 2
            && 字段.对象种类 == 节点种类::属性类型
            && 字段.属性类型表示 == std::optional{值表示种类::I64}) 类型 = 字段.本次新编码;
        else return std::nullopt;
    }
    if (!服务 || !类型 || !有效(*服务) || !有效(*类型) || *服务 == *类型) return std::nullopt;
    实际存在结构登记 登记;
    登记.首次幂等身份 = 幂等身份;
    登记.事实截止代次 = 见证.发布事实代次;
    登记.服务身份 = *服务;
    登记.实际存在资格属性类型 = *类型;
    return 实际存在结构登记完整(登记) ? std::optional{登记} : std::nullopt;
}

实际存在状态 映射写入状态(L1写入状态 状态) noexcept {
    switch (状态) {
    case L1写入状态::成功: return 实际存在状态::已提交;
    case L1写入状态::精确重复: return 实际存在状态::幂等读回;
    case L1写入状态::幂等冲突: return 实际存在状态::幂等冲突;
    case L1写入状态::事实代次漂移: return 实际存在状态::版本漂移;
    case L1写入状态::资源失败: return 实际存在状态::资源失败;
    case L1写入状态::内部不一致: return 实际存在状态::内部不一致;
    case L1写入状态::未找到:
    case L1写入状态::已退出: return 实际存在状态::未找到;
    default: return 实际存在状态::入口拒绝;
    }
}

实际存在状态 映射读取状态(L1读取状态 状态) noexcept {
    switch (状态) {
    case L1读取状态::未找到:
    case L1读取状态::属性未设置: return 实际存在状态::未找到;
    case L1读取状态::事实代次漂移: return 实际存在状态::版本漂移;
    case L1读取状态::资源失败: return 实际存在状态::资源失败;
    case L1读取状态::内部不一致:
    case L1读取状态::已退出: return 实际存在状态::内部不一致;
    default: return 实际存在状态::入口拒绝;
    }
}

std::optional<稳定编码> 查找映射(const L1写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

bool 读取节点(const L1事实基座服务& L1, 稳定编码 编码,
    std::uint64_t& 代次, 节点事实& 输出, 实际存在状态& 失败) {
    const auto 结果 = L1.读取当前节点({L1事实基座合同版本, 编码});
    if (结果.状态 != L1读取状态::成功 || !结果.事实) {
        失败 = 映射读取状态(结果.状态); return false;
    }
    const auto* 节点 = std::get_if<节点事实>(&*结果.事实);
    if (!节点 || 结果.读取事实代次 == 0) {
        失败 = 实际存在状态::内部不一致; return false;
    }
    if (代次 == 0) 代次 = 结果.读取事实代次;
    else if (代次 != 结果.读取事实代次) {
        失败 = 实际存在状态::版本漂移; return false;
    }
    输出 = *节点; return true;
}

} // namespace 海中鱼巣::L1实际存在内部

export namespace 海中鱼巣 {

class L1实际存在服务 final {
public:
    explicit L1实际存在服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L1实际存在服务(const L1实际存在服务&) = delete;
    L1实际存在服务& operator=(const L1实际存在服务&) = delete;

    实际存在登记结果 建立登记(const 实际存在登记请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1实际存在合同版本
                || 请求.规则版本 != L1实际存在规则版本
                || !实际存在操作幂等身份有效(请求.幂等身份)
                || 请求.期望事实代次 == 0) return {};
            const auto 凭证 = L1实际存在内部::形成G6实际存在登记意图凭证(请求);
            const auto 幂等键 = L1实际存在内部::映射幂等键(请求.幂等身份);
            const auto 探测 = L1_.探测幂等({L1事实基座合同版本,
                L1幂等摘要合同版本, 幂等键, 凭证.请求意图摘要, 凭证});
            if (探测.状态 == L1幂等探测状态::同义已发布) {
                if (!探测.首次结果 || !探测.首次结果->领域结果见证)
                    return {实际存在状态::内部不一致, std::nullopt};
                const auto 登记 = L1实际存在内部::从结果见证形成登记(
                    *探测.首次结果->领域结果见证, 请求.幂等身份);
                return 登记 ? 实际存在登记结果{实际存在状态::幂等读回, 登记}
                    : 实际存在登记结果{实际存在状态::内部不一致, std::nullopt};
            }
            if (探测.状态 == L1幂等探测状态::异义冲突)
                return {实际存在状态::幂等冲突, std::nullopt};
            if (探测.状态 == L1幂等探测状态::已隔离
                || 探测.状态 == L1幂等探测状态::内部不一致)
                return {实际存在状态::内部不一致, std::nullopt};
            if (探测.状态 != L1幂等探测状态::未找到)
                return {实际存在状态::入口拒绝, std::nullopt};
            if (登记_ && (!首次登记请求_ || *首次登记请求_ != 请求))
                return {实际存在状态::幂等冲突, std::nullopt};
            const auto 快照 = L1_.读取完整快照({});
            if (快照.状态 != L1读取状态::成功 || !快照.快照)
                return {L1实际存在内部::映射读取状态(快照.状态), std::nullopt};
            if (快照.快照->事实代次 != 请求.期望事实代次)
                return {实际存在状态::版本漂移, std::nullopt};
            L1写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.领域意图凭证 = 凭证;
            写集.领域结果见证计划 = L1实际存在内部::形成实际存在登记结果计划();
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::属性类型, 值表示种类::I64}};
            const auto 写入 = L1_.提交写集(写集, 0x15000301U);
            const auto 状态 = L1实际存在内部::映射写入状态(写入.状态);
            if (状态 != 实际存在状态::已提交 && 状态 != 实际存在状态::幂等读回)
                return {状态, std::nullopt};
            if (写入.事实代次 == 0 || 写入.新编码映射.size() != 2
                || !写入.领域结果见证)
                return {实际存在状态::内部不一致, std::nullopt};
            const auto 新登记 = L1实际存在内部::从结果见证形成登记(
                *写入.领域结果见证, 请求.幂等身份);
            if (!新登记)
                return {实际存在状态::内部不一致, std::nullopt};
            const auto 服务 = 新登记->服务身份;
            const auto 类型 = 新登记->实际存在资格属性类型;
            std::uint64_t 代次 = 0;
            节点事实 服务节点, 类型节点;
            实际存在状态 失败 = 实际存在状态::内部不一致;
            if (!L1实际存在内部::读取节点(L1_, 服务, 代次, 服务节点, 失败)
                || !L1实际存在内部::读取节点(L1_, 类型, 代次, 类型节点, 失败)
                || 代次 != 写入.事实代次 || 服务节点.种类 != 节点种类::普通
                || 服务节点.退出事实代次 || 类型节点.种类 != 节点种类::属性类型
                || 类型节点.退出事实代次
                || 类型节点.属性类型表示 != std::optional{值表示种类::I64})
                return {失败, std::nullopt};
            auto 登记值 = *新登记;
            if (登记值.事实截止代次 != 代次 || !实际存在结构登记完整(登记值))
                return {实际存在状态::内部不一致, std::nullopt};
            首次登记请求_ = 请求; 登记_ = 登记值;
            return {状态, 登记_};
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

    实际存在登记结果 读取当前登记() const {
        std::lock_guard<std::mutex> 锁(锁_);
        return 登记_ ? 实际存在登记结果{实际存在状态::已读取, 登记_}
            : 实际存在登记结果{实际存在状态::未找到, std::nullopt};
    }

    实际存在写入规格结果 形成实际存在写入规格(
        const 实际存在写入规格请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1实际存在合同版本
                || 请求.规则版本 != L1实际存在规则版本
                || 请求.期望事实代次 == 0) return {};
            if (!登记_) return {实际存在状态::未找到, std::nullopt};
            std::uint64_t 代次 = 0;
            节点事实 服务, 类型;
            实际存在状态 失败 = 实际存在状态::内部不一致;
            if (!L1实际存在内部::读取节点(L1_, 登记_->服务身份, 代次, 服务, 失败)
                || !L1实际存在内部::读取节点(L1_, 登记_->实际存在资格属性类型,
                    代次, 类型, 失败)) return {失败, std::nullopt};
            if (代次 != 请求.期望事实代次) return {实际存在状态::版本漂移, std::nullopt};
            if (服务.种类 != 节点种类::普通 || 服务.退出事实代次
                || 类型.种类 != 节点种类::属性类型 || 类型.退出事实代次
                || 类型.属性类型表示 != std::optional{值表示种类::I64})
                return {实际存在状态::内部不一致, std::nullopt};
            实际存在写入规格 规格{代次, {服务.编码, 服务.种类},
                {类型.编码, 类型.种类}, 实际存在资格值};
            return 实际存在写入规格完整(规格)
                ? 实际存在写入规格结果{实际存在状态::已读取, 规格}
                : 实际存在写入规格结果{实际存在状态::内部不一致, std::nullopt};
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

    实际存在资格结果 读取实际存在资格(const 实际存在资格读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1实际存在合同版本
                || 请求.规则版本 != L1实际存在规则版本
                || !有效(请求.存在) || !有效(请求.资格值)) return {};
            if (!登记_) return {实际存在状态::未找到, std::nullopt};
            std::uint64_t 代次 = 0;
            节点事实 存在, 类型, 来源;
            实际存在状态 失败 = 实际存在状态::内部不一致;
            if (!L1实际存在内部::读取节点(L1_, 请求.存在, 代次, 存在, 失败)
                || !L1实际存在内部::读取节点(L1_, 登记_->实际存在资格属性类型,
                    代次, 类型, 失败)
                || !L1实际存在内部::读取节点(L1_, 登记_->服务身份, 代次, 来源, 失败))
                return {失败, std::nullopt};
            const auto 属性 = L1_.读取当前属性({L1事实基座合同版本,
                请求.存在, 登记_->实际存在资格属性类型});
            const auto 值结果 = L1_.读取当前值({L1事实基座合同版本, 请求.资格值});
            if (属性.状态 != L1读取状态::成功 || !属性.属性)
                return {L1实际存在内部::映射读取状态(属性.状态), std::nullopt};
            if (值结果.状态 != L1读取状态::成功 || !值结果.事实)
                return {L1实际存在内部::映射读取状态(值结果.状态), std::nullopt};
            const auto* 值 = std::get_if<值事实>(&*值结果.事实);
            if (!值) return {实际存在状态::内部不一致, std::nullopt};
            if (属性.读取事实代次 != 代次 || 值结果.读取事实代次 != 代次)
                return {实际存在状态::版本漂移, std::nullopt};
            if (存在.种类 != 节点种类::普通 || 存在.退出事实代次
                || 类型.种类 != 节点种类::属性类型 || 类型.退出事实代次
                || 类型.属性类型表示 != std::optional{值表示种类::I64}
                || 来源.种类 != 节点种类::普通 || 来源.退出事实代次
                || 属性.属性->当前值 != 请求.资格值 || 值->退出事实代次
                || 值->所属节点 != 请求.存在
                || 值->属性类型节点 != 登记_->实际存在资格属性类型
                || 值->来源节点 != 登记_->服务身份
                || !std::holds_alternative<std::int64_t>(值->材料)
                || std::get<std::int64_t>(值->材料) != 实际存在资格值)
                return {实际存在状态::内部不一致, std::nullopt};
            实际存在资格事实 事实;
            事实.事实截止代次 = 代次;
            事实.存在 = {存在.编码, 存在.种类};
            事实.资格 = {值->编码, {值->所属节点, 存在.种类},
                {值->属性类型节点, 类型.种类}, std::get<std::int64_t>(值->材料),
                {值->来源节点, 来源.种类}, 值->创建事实代次};
            return 实际存在资格事实完整(事实)
                ? 实际存在资格结果{实际存在状态::已读取, 事实}
                : 实际存在资格结果{实际存在状态::内部不一致, std::nullopt};
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

private:
    L1事实基座服务& L1_;
    mutable std::mutex 锁_;
    std::optional<实际存在登记请求> 首次登记请求_;
    std::optional<实际存在结构登记> 登记_;
};

} // namespace 海中鱼巣
