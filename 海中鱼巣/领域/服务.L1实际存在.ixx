module;

#include <cstdint>
#include <cstddef>
#include <mutex>
#include <new>
#include <optional>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.服务.L1实际存在;

export import 海中鱼巣.领域.服务.L1场景结构;
import 海中鱼巣.核心.服务.L1事实基座;

export {
#include "L1实际存在.数据.h"
}

namespace 海中鱼巣::L1实际存在内部 {

inline constexpr std::uint64_t 登记幂等域 = 0x0AULL;

// 诊断责任：无适用错误分支；纯值键映射不读取状态、不产生副作用。
L1中性写集幂等键 映射幂等键(实际存在操作幂等身份 身份) noexcept {
    return {(登记幂等域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；纯值状态映射覆盖全部枚举并收敛未知值。
实际存在状态 映射写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 实际存在状态::已提交;
    case L1中性写入状态::精确重复: return 实际存在状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 实际存在状态::入口拒绝;
    case L1中性写入状态::事实代次漂移: return 实际存在状态::版本漂移;
    case L1中性写入状态::幂等冲突: return 实际存在状态::幂等冲突;
    case L1中性写入状态::资源失败: return 实际存在状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return 实际存在状态::内部不一致;
    }
    return 实际存在状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值状态映射只形成结构化上送状态。
实际存在状态 映射读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::未找到:
    case L1中性读取状态::属性未设置:
        return 实际存在状态::未找到;
    case L1中性读取状态::入口拒绝:
        return 实际存在状态::入口拒绝;
    case L1中性读取状态::资源失败:
        return 实际存在状态::资源失败;
    case L1中性读取状态::已退出:
    case L1中性读取状态::内部不一致:
        return 实际存在状态::内部不一致;
    case L1中性读取状态::成功:
        break;
    }
    return 实际存在状态::内部不一致;
}

// 诊断责任：无适用错误分支；未找到或重复映射均以空值返回，不产生副作用。
std::optional<稳定编码> 查找映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值唯一性判断不读取状态、不产生副作用。
bool 映射唯一(const L1中性写入结果& 结果) noexcept {
    for (std::size_t i = 0; i < 结果.新编码映射.size(); ++i) {
        if (!有效(结果.新编码映射[i].first)
            || !有效(结果.新编码映射[i].second)) return false;
        for (std::size_t j = i + 1; j < 结果.新编码映射.size(); ++j) {
            if (结果.新编码映射[i].first == 结果.新编码映射[j].first
                || 结果.新编码映射[i].second == 结果.新编码映射[j].second) {
                return false;
            }
        }
    }
    return true;
}

} // namespace 海中鱼巣::L1实际存在内部

export namespace 海中鱼巣 {

class L1实际存在服务 final {
public:
    explicit L1实际存在服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L1实际存在服务(const L1实际存在服务&) = delete;
    L1实际存在服务& operator=(const L1实际存在服务&) = delete;

    // 诊断责任：向上送出；所有拒绝、资源失败和内部不一致均以结构化结果返回调用方。
    实际存在登记结果 建立登记(const 实际存在登记请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!实际存在登记请求有效(请求)) return {};
            const auto 幂等键 = L1实际存在内部::映射幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::属性类型, L1中性值表示种类::I64}};

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1实际存在内部::映射写入状态(写入.状态);
            if (状态 != 实际存在状态::已提交
                && 状态 != 实际存在状态::幂等读回) {
                return {状态, std::nullopt};
            }

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            if (写入.合同版本 != L1中性CRUD合同版本
                || !(写入.幂等键 == 幂等键) || 写入.事实代次 == 0
                || 写入.新编码映射.size() != 2
                || (!首次成功完整 && !重复成功完整)
                || !L1实际存在内部::映射唯一(写入)) {
                return {实际存在状态::内部不一致, std::nullopt};
            }

            const auto 服务 = L1实际存在内部::查找映射(写入, 1);
            const auto 类型 = L1实际存在内部::查找映射(写入, 2);
            if (!服务 || !类型 || *服务 == *类型) {
                return {实际存在状态::内部不一致, std::nullopt};
            }

            实际存在结构登记 新定位;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.服务身份 = *服务;
            新定位.实际存在资格属性类型 = *类型;
            if (!实际存在结构登记完整(新定位)) {
                return {实际存在状态::内部不一致, std::nullopt};
            }

            const auto 读回 = 按登记读取权威事实(新定位, 写入.事实代次);
            if (!读回.成功()) return {读回.状态, std::nullopt};
            if (登记定位_
                && (登记定位_->首次幂等身份 != 新定位.首次幂等身份
                    || 登记定位_->服务身份 != 新定位.服务身份
                    || 登记定位_->实际存在资格属性类型
                        != 新定位.实际存在资格属性类型)) {
                return {实际存在状态::内部不一致, std::nullopt};
            }
            登记定位_ = 新定位;
            return {状态, 读回.登记};
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

    // 诊断责任：向上送出；未找到、资源失败和内部不一致均以结构化结果返回调用方。
    实际存在登记结果 读取当前登记() const {
        std::lock_guard<std::mutex> 锁(锁_);
        if (!登记定位_) return {实际存在状态::未找到, std::nullopt};
        try { return 按登记读取权威事实(*登记定位_); }
        catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

    // 诊断责任：向上送出；规格拒绝、漂移和内部不一致均以结构化结果返回调用方。
    实际存在写入规格结果 形成实际存在写入规格(
        const 实际存在写入规格请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1实际存在合同版本
                || 请求.规则版本 != L1实际存在规则版本
                || 请求.期望事实代次 == 0) return {};
            if (!登记定位_) return {实际存在状态::未找到, std::nullopt};
            const auto 当前登记 = 按登记读取权威事实(*登记定位_);
            if (!当前登记.成功() || !当前登记.登记)
                return {当前登记.状态, std::nullopt};
            if (当前登记.状态 != 实际存在状态::已读取
                || 当前登记.登记->事实截止代次 != 请求.期望事实代次)
                return {实际存在状态::版本漂移, std::nullopt};
            实际存在写入规格 规格{当前登记.登记->事实截止代次,
                {当前登记.登记->服务身份, 节点种类::普通},
                {当前登记.登记->实际存在资格属性类型, 节点种类::属性类型},
                实际存在资格值};
            return 实际存在写入规格完整(规格)
                ? 实际存在写入规格结果{实际存在状态::已读取, 规格}
                : 实际存在写入规格结果{实际存在状态::内部不一致, std::nullopt};
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

    // 诊断责任：向上送出；资格读取失败和事实矛盾均以结构化结果返回调用方。
    实际存在资格结果 读取实际存在资格(const 实际存在资格读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!实际存在资格读取请求有效(请求)) return {};
            if (!登记定位_) return {实际存在状态::未找到, std::nullopt};
            const auto 当前登记 = 按登记读取权威事实(*登记定位_);
            if (!当前登记.成功() || !当前登记.登记)
                return {当前登记.状态, std::nullopt};

            const auto 起始 = L1_.读取中性当前事实代次({});
            const auto 存在 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 请求.存在});
            const auto 类型 = L1_.读取中性当前节点({L1中性CRUD合同版本,
                当前登记.登记->实际存在资格属性类型});
            const auto 来源 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 当前登记.登记->服务身份});
            const auto 属性 = L1_.读取中性当前属性({L1中性CRUD合同版本,
                请求.存在, 当前登记.登记->实际存在资格属性类型});
            const auto 值结果 = L1_.读取中性当前值(
                {L1中性CRUD合同版本, 请求.资格值});
            const auto 结束 = L1_.读取中性当前事实代次({});

            const auto* 失败结果 = [&]() -> const L1中性读取状态* {
                if (起始.状态 != L1中性读取状态::成功) return &起始.状态;
                if (存在.状态 != L1中性读取状态::成功) return &存在.状态;
                if (类型.状态 != L1中性读取状态::成功) return &类型.状态;
                if (来源.状态 != L1中性读取状态::成功) return &来源.状态;
                if (属性.状态 != L1中性读取状态::成功) return &属性.状态;
                if (值结果.状态 != L1中性读取状态::成功) return &值结果.状态;
                if (结束.状态 != L1中性读取状态::成功) return &结束.状态;
                return nullptr;
            }();
            if (失败结果)
                return {L1实际存在内部::映射读取状态(*失败结果), std::nullopt};

            const auto 代次 = 起始.事实代次;
            if (起始.合同版本 != L1中性CRUD合同版本
                || 结束.合同版本 != L1中性CRUD合同版本
                || 代次 == 0 || 结束.事实代次 != 代次
                || 当前登记.登记->事实截止代次 != 代次
                || 存在.合同版本 != L1中性CRUD合同版本
                || 类型.合同版本 != L1中性CRUD合同版本
                || 来源.合同版本 != L1中性CRUD合同版本
                || 属性.合同版本 != L1中性CRUD合同版本
                || 值结果.合同版本 != L1中性CRUD合同版本
                || 存在.读取事实代次 != 代次 || 类型.读取事实代次 != 代次
                || 来源.读取事实代次 != 代次 || 属性.读取事实代次 != 代次
                || 值结果.读取事实代次 != 代次)
                return {实际存在状态::版本漂移, std::nullopt};
            if (!存在.事实 || !类型.事实 || !来源.事实 || !属性.当前值
                || !值结果.事实)
                return {实际存在状态::内部不一致, std::nullopt};

            const auto& 存在事实值 = *存在.事实;
            const auto& 类型事实值 = *类型.事实;
            const auto& 来源事实值 = *来源.事实;
            const auto& 值 = *值结果.事实;
            std::size_t 资格槽数 = 0;
            bool 节点槽匹配 = false;
            for (const auto& 槽 : 存在事实值.当前属性) {
                if (槽.属性类型节点
                    != 当前登记.登记->实际存在资格属性类型) continue;
                ++资格槽数;
                节点槽匹配 = 槽.当前值 == 请求.资格值;
            }
            if (存在.查询编码 != 请求.存在 || 存在事实值.编码 != 请求.存在
                || 类型.查询编码 != 当前登记.登记->实际存在资格属性类型
                || 类型事实值.编码 != 当前登记.登记->实际存在资格属性类型
                || 来源.查询编码 != 当前登记.登记->服务身份
                || 来源事实值.编码 != 当前登记.登记->服务身份
                || 属性.节点 != 请求.存在
                || 属性.属性类型 != 当前登记.登记->实际存在资格属性类型
                || 值结果.查询编码 != 请求.资格值
                || 存在事实值.种类 != 节点种类::普通
                || 存在事实值.属性类型表示.has_value()
                || 存在事实值.退出事实代次.has_value()
                || 类型事实值.种类 != 节点种类::属性类型
                || 类型事实值.属性类型表示
                    != std::optional<L1中性值表示种类>{L1中性值表示种类::I64}
                || 类型事实值.退出事实代次.has_value()
                || 来源事实值.种类 != 节点种类::普通
                || 来源事实值.属性类型表示.has_value()
                || 来源事实值.退出事实代次.has_value()
                || 资格槽数 != 1 || !节点槽匹配
                || *属性.当前值 != 请求.资格值
                || 值.编码 != 请求.资格值 || 值.退出事实代次.has_value()
                || 值.所属节点 != 请求.存在
                || 值.属性类型节点 != 当前登记.登记->实际存在资格属性类型
                || 值.来源节点 != 当前登记.登记->服务身份
                || !std::holds_alternative<std::int64_t>(值.材料)
                || std::get<std::int64_t>(值.材料) != 实际存在资格值)
                return {实际存在状态::内部不一致, std::nullopt};
            实际存在资格事实 事实;
            事实.事实截止代次 = 代次;
            事实.存在 = {存在事实值.编码, 存在事实值.种类};
            事实.资格 = {值.编码, {值.所属节点, 存在事实值.种类},
                {值.属性类型节点, 类型事实值.种类},
                std::get<std::int64_t>(值.材料),
                {值.来源节点, 来源事实值.种类}, 值.创建事实代次};
            return 实际存在资格事实完整(事实)
                ? 实际存在资格结果{实际存在状态::已读取, 事实}
                : 实际存在资格结果{实际存在状态::内部不一致, std::nullopt};
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

private:
    // 诊断责任：向上送出；精确读回的许可、漂移和结构错误均形成结构化结果。
    实际存在登记结果 按登记读取权威事实(
        const 实际存在结构登记& 定位,
        std::optional<std::uint64_t> 期望创建代次 = std::nullopt) const {
        if (!实际存在结构登记完整(定位)) {
            return {实际存在状态::内部不一致, std::nullopt};
        }

        const auto 起始 = L1_.读取中性当前事实代次({});
        if (起始.状态 != L1中性读取状态::成功) {
            return {L1实际存在内部::映射读取状态(起始.状态), std::nullopt};
        }
        const auto 服务 = L1_.读取中性当前节点(
            {L1中性CRUD合同版本, 定位.服务身份});
        if (服务.状态 != L1中性读取状态::成功) {
            return {L1实际存在内部::映射读取状态(服务.状态), std::nullopt};
        }
        const auto 类型 = L1_.读取中性当前节点(
            {L1中性CRUD合同版本, 定位.实际存在资格属性类型});
        if (类型.状态 != L1中性读取状态::成功) {
            return {L1实际存在内部::映射读取状态(类型.状态), std::nullopt};
        }
        const auto 结束 = L1_.读取中性当前事实代次({});
        if (结束.状态 != L1中性读取状态::成功) {
            return {L1实际存在内部::映射读取状态(结束.状态), std::nullopt};
        }

        const auto 代次 = 起始.事实代次;
        if (起始.合同版本 != L1中性CRUD合同版本
            || 结束.合同版本 != L1中性CRUD合同版本
            || 代次 == 0 || 结束.事实代次 != 代次
            || 服务.合同版本 != L1中性CRUD合同版本
            || 类型.合同版本 != L1中性CRUD合同版本
            || 服务.查询编码 != 定位.服务身份
            || 类型.查询编码 != 定位.实际存在资格属性类型
            || 服务.读取事实代次 != 代次 || 类型.读取事实代次 != 代次
            || !服务.事实.has_value() || !类型.事实.has_value()) {
            return {服务.读取事实代次 != 代次 || 类型.读取事实代次 != 代次
                    || 结束.事实代次 != 代次
                    ? 实际存在状态::版本漂移
                    : 实际存在状态::内部不一致,
                std::nullopt};
        }

        const auto& 服务事实 = *服务.事实;
        const auto& 类型事实 = *类型.事实;
        if (服务事实.编码 != 定位.服务身份
            || 类型事实.编码 != 定位.实际存在资格属性类型
            || 服务事实.种类 != 节点种类::普通
            || 类型事实.种类 != 节点种类::属性类型
            || 服务事实.属性类型表示.has_value()
            || 类型事实.属性类型表示
                != std::optional<L1中性值表示种类>{L1中性值表示种类::I64}
            || 服务事实.创建事实代次 == 0
            || 服务事实.创建事实代次 != 类型事实.创建事实代次
            || 服务事实.创建事实代次 > 代次
            || 服务事实.退出事实代次.has_value()
            || 类型事实.退出事实代次.has_value()
            || !服务事实.当前属性.empty() || !类型事实.当前属性.empty()
            || (期望创建代次.has_value()
                && 服务事实.创建事实代次 != *期望创建代次)) {
            return {实际存在状态::内部不一致, std::nullopt};
        }

        auto 当前登记 = 定位;
        当前登记.事实截止代次 = 代次;
        return 实际存在结构登记完整(当前登记)
            ? 实际存在登记结果{实际存在状态::已读取, 当前登记}
            : 实际存在登记结果{实际存在状态::内部不一致, std::nullopt};
    }

    L1事实基座服务& L1_;
    mutable std::mutex 锁_;
    std::optional<实际存在结构登记> 登记定位_;
};

} // namespace 海中鱼巣
