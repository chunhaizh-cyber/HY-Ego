struct 语言定位 final {
    L1结构所有者身份 所有者;
    L1结构所有者事实 所有者事实;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    稳定编码 登记键关系类型;
    稳定编码 来源关系类型;
    std::uint64_t 登记事实代次 = 0;
};

struct 语言内部事实 final {
    L2语言事实 公开事实;
    稳定编码 节点编码;
    稳定编码 族关系编码;
    稳定编码 登记关系编码;
    稳定编码 来源关系编码;
};

struct 语言内部读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    std::optional<语言内部事实> 事实;
};

struct 材料对读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::optional<不可变材料事实> 登记键;
    std::optional<不可变材料事实> 来源;
};

struct 词条定位 final {
    L1结构所有者身份 所有者;
    L1结构所有者事实 所有者事实;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    稳定编码 语言归属关系类型;
    稳定编码 规范化合同关系类型;
    稳定编码 规范化词面关系类型;
    稳定编码 来源关系类型;
    std::uint64_t 登记事实代次 = 0;
};

struct 词条内部事实 final {
    L2词条事实 公开事实;
    稳定编码 节点编码;
    稳定编码 族关系编码;
    稳定编码 语言关系编码;
    稳定编码 合同关系编码;
    稳定编码 词面关系编码;
    稳定编码 来源关系编码;
};

struct 词条内部读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    std::optional<词条内部事实> 事实;
};

struct 词条材料组读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::optional<不可变材料事实> 规范化合同;
    std::optional<不可变材料事实> 规范化词面;
    std::optional<不可变材料事实> 来源;
};

// 诊断责任：无适用错误分支；完整 64 位幂等身份一对一映射。
L1所有者范围写入幂等身份 映射幂等身份(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；覆盖 L1 写入状态的公开结构映射。
L2结构状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；覆盖 owner 普通读取状态。
L2结构状态 映射读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::已退出: return L2结构状态::已退出;
    case L1所有者范围读取状态::属性未设置:
        return L2结构状态::属性未设置;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；材料服务结构状态保持到语言服务。
L2结构状态 映射材料状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::事实代次漂移:
    case L2结构状态::资源失败:
    case L2结构状态::入口拒绝:
    case L2结构状态::许可拒绝:
        return 状态;
    default:
        return L2结构状态::内部不一致;
    }
}

// 诊断责任：向上送出；读取当前事实代次异常由调用者结构化映射。
std::pair<L2结构状态, std::uint64_t> 读取当前事实代次(
    const L1事实基座服务& 第一层服务) {
    const auto 读取 = 第一层服务.读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (读取.合同版本 != L1中性CRUD合同版本)
        return {L2结构状态::内部不一致, 读取.事实代次};
    if (读取.状态 == L1中性读取状态::成功 && 读取.事实代次 != 0)
        return {L2结构状态::已读取, 读取.事实代次};
    if (读取.状态 == L1中性读取状态::许可拒绝)
        return {L2结构状态::许可拒绝, 读取.事实代次};
    if (读取.状态 == L1中性读取状态::资源失败)
        return {L2结构状态::资源失败, 读取.事实代次};
    return {L2结构状态::内部不一致, 读取.事实代次};
}

// 诊断责任：向上送出；缺失、重复或零登记映射令服务构造失败。
稳定编码 取得唯一映射(const L1所有者范围写入结果& 写入,
    std::uint32_t 本地键) {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 写入.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到 || !有效(编码))
            throw std::runtime_error("L2 language registration mapping is invalid");
        找到 = 编码;
    }
    if (!找到)
        throw std::runtime_error("L2 language registration mapping is missing");
    return *找到;
}

// 诊断责任：向上送出；登记节点必须由同一 owner 在同一代次建立并保持活动。
L1所有者范围节点事实 读取登记节点(const L1事实基座服务& 第一层服务,
    const 语言定位& 定位, 稳定编码 编码, std::uint64_t 代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    if (读取.状态 != L1所有者范围读取状态::成功
        || 读取.合同版本 != L1所有者范围CRUD合同版本
        || 读取.查询编码 != 编码 || 读取.读取事实代次 < 代次
        || !节点 || 节点->编码 != 编码 || 节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || 节点->创建事实代次 != 代次 || 节点->退出事实代次
        || !节点->当前属性.empty())
        throw std::runtime_error("L2 language registration readback is invalid");
    return *节点;
}

// 诊断责任：向上送出；固定四项登记只接受首次或精确重复的完整回显。
语言定位 初始化语言登记(const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 写入端口) {
    语言定位 定位;
    定位.所有者 = 写入端口.所有者身份();
    const auto 所有者 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 定位.所有者});
    if (所有者.状态 != L1所有者范围读取状态::成功
        || 所有者.合同版本 != L1所有者范围CRUD合同版本
        || !所有者.所有者事实
        || 所有者.所有者事实->所有者 != 定位.所有者
        || 所有者.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者.所有者事实->创建事实代次 == 0
        || 所有者.所有者事实->退出事实代次)
        throw std::runtime_error("L2 language owner fact is invalid");
    定位.所有者事实 = *所有者.所有者事实;
    const auto [状态, 当前代次] = 读取当前事实代次(第一层服务);
    if (状态 != L2结构状态::已读取)
        throw std::runtime_error("L2 language registration generation failed");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 当前代次;
    写集.写入幂等身份 = 语言登记幂等身份;
    写集.节点 = {
        {{语言族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{语言族归属关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{语言登记键关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{语言来源关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界
            == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 定位.所有者
        || 写入.写入幂等身份 != 语言登记幂等身份
        || 写入.事实代次 == 0 || (!首次 && !重复)
        || 写入.新编码映射.size() != 4)
        throw std::runtime_error("L2 language registration failed");
    定位.族锚点 = 取得唯一映射(写入, 语言族锚点本地键值);
    定位.族归属关系类型 = 取得唯一映射(
        写入, 语言族归属关系类型本地键值);
    定位.登记键关系类型 = 取得唯一映射(
        写入, 语言登记键关系类型本地键值);
    定位.来源关系类型 = 取得唯一映射(
        写入, 语言来源关系类型本地键值);
    std::vector<std::uint64_t> 编码{定位.族锚点.值,
        定位.族归属关系类型.值, 定位.登记键关系类型.值,
        定位.来源关系类型.值};
    std::sort(编码.begin(), 编码.end());
    if (std::adjacent_find(编码.begin(), 编码.end()) != 编码.end())
        throw std::runtime_error("L2 language registration aliases facts");
    定位.登记事实代次 = 写入.事实代次;
    (void)读取登记节点(第一层服务, 定位, 定位.族锚点, 写入.事实代次);
    (void)读取登记节点(
        第一层服务, 定位, 定位.族归属关系类型, 写入.事实代次);
    (void)读取登记节点(
        第一层服务, 定位, 定位.登记键关系类型, 写入.事实代次);
    (void)读取登记节点(
        第一层服务, 定位, 定位.来源关系类型, 写入.事实代次);
    return 定位;
}

// 诊断责任：向上送出；词条登记节点必须同 owner、同代建立并保持活动。
L1所有者范围节点事实 读取词条登记节点(
    const L1事实基座服务& 第一层服务, const 词条定位& 定位,
    稳定编码 编码, std::uint64_t 代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    if (读取.状态 != L1所有者范围读取状态::成功
        || 读取.合同版本 != L1所有者范围CRUD合同版本
        || 读取.查询编码 != 编码 || 读取.读取事实代次 < 代次
        || !节点 || 节点->编码 != 编码 || 节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || 节点->创建事实代次 != 代次 || 节点->退出事实代次
        || !节点->当前属性.empty())
        throw std::runtime_error("L2 lexeme registration readback is invalid");
    return *节点;
}

// 诊断责任：向上送出；固定六项词条登记只接受首次或精确重复回显。
词条定位 初始化词条登记(const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 写入端口) {
    词条定位 定位;
    定位.所有者 = 写入端口.所有者身份();
    const auto 所有者 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 定位.所有者});
    if (所有者.状态 != L1所有者范围读取状态::成功
        || 所有者.合同版本 != L1所有者范围CRUD合同版本
        || !所有者.所有者事实
        || 所有者.所有者事实->所有者 != 定位.所有者
        || 所有者.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者.所有者事实->创建事实代次 == 0
        || 所有者.所有者事实->退出事实代次)
        throw std::runtime_error("L2 lexeme owner fact is invalid");
    定位.所有者事实 = *所有者.所有者事实;
    const auto [状态, 当前代次] = 读取当前事实代次(第一层服务);
    if (状态 != L2结构状态::已读取)
        throw std::runtime_error("L2 lexeme registration generation failed");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 当前代次;
    写集.写入幂等身份 = 词条登记幂等身份;
    写集.节点 = {
        {{词条族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{词条族归属关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{词条语言归属关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{词条规范化合同关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{词条规范化词面关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{词条来源关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界
            == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 定位.所有者
        || 写入.写入幂等身份 != 词条登记幂等身份
        || 写入.事实代次 == 0 || (!首次 && !重复)
        || 写入.新编码映射.size() != 6)
        throw std::runtime_error("L2 lexeme registration failed");
    定位.族锚点 = 取得唯一映射(写入, 词条族锚点本地键值);
    定位.族归属关系类型 = 取得唯一映射(
        写入, 词条族归属关系类型本地键值);
    定位.语言归属关系类型 = 取得唯一映射(
        写入, 词条语言归属关系类型本地键值);
    定位.规范化合同关系类型 = 取得唯一映射(
        写入, 词条规范化合同关系类型本地键值);
    定位.规范化词面关系类型 = 取得唯一映射(
        写入, 词条规范化词面关系类型本地键值);
    定位.来源关系类型 = 取得唯一映射(写入, 词条来源关系类型本地键值);
    std::vector<std::uint64_t> 编码{定位.族锚点.值,
        定位.族归属关系类型.值, 定位.语言归属关系类型.值,
        定位.规范化合同关系类型.值, 定位.规范化词面关系类型.值,
        定位.来源关系类型.值};
    std::sort(编码.begin(), 编码.end());
    if (std::adjacent_find(编码.begin(), 编码.end()) != 编码.end())
        throw std::runtime_error("L2 lexeme registration aliases facts");
    定位.登记事实代次 = 写入.事实代次;
    (void)读取词条登记节点(第一层服务, 定位, 定位.族锚点, 写入.事实代次);
    (void)读取词条登记节点(
        第一层服务, 定位, 定位.族归属关系类型, 写入.事实代次);
    (void)读取词条登记节点(
        第一层服务, 定位, 定位.语言归属关系类型, 写入.事实代次);
    (void)读取词条登记节点(
        第一层服务, 定位, 定位.规范化合同关系类型, 写入.事实代次);
    (void)读取词条登记节点(
        第一层服务, 定位, 定位.规范化词面关系类型, 写入.事实代次);
    (void)读取词条登记节点(
        第一层服务, 定位, 定位.来源关系类型, 写入.事实代次);
    return 定位;
}

// 诊断责任：无适用错误分支；把晚于截止的退出从历史值式投影移除。
L2生命周期 投影生命周期(std::uint64_t 创建,
    std::optional<std::uint64_t> 退出, std::uint64_t 截止) noexcept {
    if (退出 && *退出 > 截止) 退出.reset();
    return {创建, 退出};
}

// 诊断责任：向上送出；材料读回与登记读回必须同截止、同请求守卫。
材料对读取结果 读取材料对(const 不可变材料服务& 材料服务,
    不可变材料身份 登记键, 不可变材料身份 来源,
    L2读取类别 类别, std::uint64_t 守卫, std::uint64_t 截止) {
    const std::uint64_t 历史截止 = 类别 == L2读取类别::历史 ? 截止 : 0;
    const auto 登记材料 = 材料服务.读取不可变材料(
        {{L2结构合同版本, 守卫}, 类别, 登记键, 历史截止});
    if (登记材料.结果头.状态 != L2结构状态::已读取
        || 登记材料.结果头.合同版本 != L2结构合同版本
        || 登记材料.结果头.事实截止代次 != 截止
        || 登记材料.结果头.变更事实代次 || !登记材料.材料)
        return {映射材料状态(登记材料.结果头.状态), std::nullopt,
            std::nullopt};
    const auto 来源材料 = 登记键 == 来源 ? 登记材料
        : 材料服务.读取不可变材料(
            {{L2结构合同版本, 守卫}, 类别, 来源, 历史截止});
    if (来源材料.结果头.状态 != L2结构状态::已读取
        || 来源材料.结果头.合同版本 != L2结构合同版本
        || 来源材料.结果头.事实截止代次 != 截止
        || 来源材料.结果头.变更事实代次 || !来源材料.材料)
        return {映射材料状态(来源材料.结果头.状态), std::nullopt,
            std::nullopt};
    const auto 登记 = 材料服务.读取不可变材料登记(
        {{L2结构合同版本, 守卫}, 类别, 历史截止});
    if (!登记.成功() || 登记.结果头.事实截止代次 != 截止
        || 登记材料.材料->身份 != 登记键
        || 来源材料.材料->身份 != 来源
        || 登记材料.材料->格式角色 != 不可变材料格式角色::严格UTF8
        || 登记材料.材料->格式身份 != 登记.登记->严格UTF8格式身份)
        return {L2结构状态::内部不一致, std::nullopt, std::nullopt};
    return {L2结构状态::已读取, 登记材料.材料, 来源材料.材料};
}

// 诊断责任：向上送出；三份词条材料必须在同一截止完整正式读回。
词条材料组读取结果 读取词条材料组(const 不可变材料服务& 材料服务,
    不可变材料身份 规范化合同, 不可变材料身份 规范化词面,
    不可变材料身份 来源, L2读取类别 类别,
    std::uint64_t 守卫, std::uint64_t 截止) {
    const std::uint64_t 历史截止 = 类别 == L2读取类别::历史 ? 截止 : 0;
    const auto 读 = [&](不可变材料身份 身份) {
        return 材料服务.读取不可变材料(
            {{L2结构合同版本, 守卫}, 类别, 身份, 历史截止});
    };
    const auto 合同读 = 读(规范化合同);
    if (合同读.结果头.状态 != L2结构状态::已读取
        || 合同读.结果头.合同版本 != L2结构合同版本
        || 合同读.结果头.事实截止代次 != 截止
        || 合同读.结果头.变更事实代次 || !合同读.材料)
        return {映射材料状态(合同读.结果头.状态), std::nullopt,
            std::nullopt, std::nullopt};
    const auto 词面读 = 规范化词面 == 规范化合同 ? 合同读 : 读(规范化词面);
    if (词面读.结果头.状态 != L2结构状态::已读取
        || 词面读.结果头.合同版本 != L2结构合同版本
        || 词面读.结果头.事实截止代次 != 截止
        || 词面读.结果头.变更事实代次 || !词面读.材料)
        return {映射材料状态(词面读.结果头.状态), std::nullopt,
            std::nullopt, std::nullopt};
    const auto 来源读 = 来源 == 规范化合同 ? 合同读
        : 来源 == 规范化词面 ? 词面读 : 读(来源);
    if (来源读.结果头.状态 != L2结构状态::已读取
        || 来源读.结果头.合同版本 != L2结构合同版本
        || 来源读.结果头.事实截止代次 != 截止
        || 来源读.结果头.变更事实代次 || !来源读.材料)
        return {映射材料状态(来源读.结果头.状态), std::nullopt,
            std::nullopt, std::nullopt};
    const auto 登记 = 材料服务.读取不可变材料登记(
        {{L2结构合同版本, 守卫}, 类别, 历史截止});
    const auto 格式匹配 = [&](const 不可变材料事实& 材料) noexcept {
        return (材料.格式角色 == 不可变材料格式角色::严格UTF8
                && 材料.格式身份 == 登记.登记->严格UTF8格式身份)
            || (材料.格式角色 == 不可变材料格式角色::通用字节
                && 材料.格式身份 == 登记.登记->通用字节格式身份);
    };
    if (!登记.成功() || 登记.结果头.事实截止代次 != 截止
        || 合同读.材料->身份 != 规范化合同
        || 词面读.材料->身份 != 规范化词面
        || 来源读.材料->身份 != 来源
        || !格式匹配(*合同读.材料) || !格式匹配(*来源读.材料)
        || 词面读.材料->格式角色 != 不可变材料格式角色::严格UTF8
        || 词面读.材料->格式身份 != 登记.登记->严格UTF8格式身份)
        return {L2结构状态::内部不一致, std::nullopt,
            std::nullopt, std::nullopt};
    return {L2结构状态::已读取, 合同读.材料, 词面读.材料, 来源读.材料};
}

// 诊断责任：向上送出；指定端点和关系类型在截止上必须形成唯一关系。
std::optional<L1所有者范围关系事实> 读取唯一历史关系(
    const L1事实基座服务& 第一层服务, const 语言定位& 定位,
    L1所有者范围关系端点方向 方向, 稳定编码 端点,
    稳定编码 类型, std::uint64_t 截止, std::uint64_t 观察代次,
    bool 允许空 = false) {
    const auto 读取 = 第一层服务.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, 方向, 端点, 类型, 截止});
    if (读取.状态 != L1所有者范围读取状态::成功
        || 读取.合同版本 != L1所有者范围CRUD合同版本
        || 读取.方向 != 方向 || 读取.端点节点 != 端点
        || 读取.关系类型节点 != 类型
        || 读取.历史截止事实代次 != 截止
        || 读取.读取事实代次 != 观察代次 || 读取.关系组.size() > 1)
        throw std::runtime_error("L2 language relation projection is invalid");
    if (读取.关系组.empty()) return 允许空
        ? std::optional<L1所有者范围关系事实>{} : throw std::runtime_error(
            "L2 language relation projection is missing");
    const auto& 关系 = 读取.关系组.front();
    if (关系.写入所有者 != 定位.所有者 || 关系.关系类型节点 != 类型)
        throw std::runtime_error("L2 language relation owner is invalid");
    return 关系;
}

// 诊断责任：向上送出；词条指定端点和类型在截止上必须形成唯一关系。
std::optional<L1所有者范围关系事实> 读取词条唯一历史关系(
    const L1事实基座服务& 第一层服务, const 词条定位& 定位,
    L1所有者范围关系端点方向 方向, 稳定编码 端点,
    稳定编码 类型, std::uint64_t 截止, std::uint64_t 观察代次,
    bool 允许空 = false) {
    const auto 读取 = 第一层服务.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, 方向, 端点, 类型, 截止});
    if (读取.状态 != L1所有者范围读取状态::成功
        || 读取.合同版本 != L1所有者范围CRUD合同版本
        || 读取.方向 != 方向 || 读取.端点节点 != 端点
        || 读取.关系类型节点 != 类型
        || 读取.历史截止事实代次 != 截止
        || 读取.读取事实代次 != 观察代次 || 读取.关系组.size() > 1)
        throw std::runtime_error("L2 lexeme relation projection is invalid");
    if (读取.关系组.empty()) return 允许空
        ? std::optional<L1所有者范围关系事实>{} : throw std::runtime_error(
            "L2 lexeme relation projection is missing");
    const auto& 关系 = 读取.关系组.front();
    if (关系.写入所有者 != 定位.所有者 || 关系.关系类型节点 != 类型)
        throw std::runtime_error("L2 lexeme relation owner is invalid");
    return 关系;
}

// 诊断责任：向上送出；owner 历史事实与三关系在同一截止重建语言。
语言内部读取结果 读取历史语言核心(const L1事实基座服务& 第一层服务,
    const 不可变材料服务& 材料服务, const 语言定位& 定位,
    L2语言身份 身份, std::uint64_t 截止, std::uint64_t 观察代次,
    bool 要求当前活动) {
    const auto 节点读 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 身份.值});
    if (节点读.合同版本 != L1所有者范围CRUD合同版本
        || 节点读.查询编码 != 身份.值
        || 节点读.读取事实代次 != 观察代次)
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    if (节点读.状态 != L1所有者范围读取状态::成功)
        return {映射读取状态(节点读.状态), 截止, std::nullopt};
    const auto* 节点 = 节点读.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读.事实) : nullptr;
    if (!节点 || 节点->编码 != 身份.值
        || 节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || !节点->当前属性.empty())
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    if (节点->创建事实代次 > 截止)
        return {L2结构状态::未找到, 截止, std::nullopt};
    if (要求当前活动 && 节点->退出事实代次
        && *节点->退出事实代次 <= 截止)
        return {L2结构状态::已退出, 截止, std::nullopt};
    const std::uint64_t 关系截止 = 节点->退出事实代次
            && *节点->退出事实代次 <= 截止
        ? *节点->退出事实代次 - 1 : 截止;
    try {
        const auto 族关系 = 读取唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::目标, 身份.值,
            定位.族归属关系类型, 关系截止, 观察代次);
        const auto 键关系 = 读取唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.登记键关系类型, 关系截止, 观察代次);
        const auto 来源关系 = 读取唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.来源关系类型, 关系截止, 观察代次);
        if (!族关系 || !键关系 || !来源关系
            || 族关系->源节点 != 定位.族锚点
            || 族关系->目标节点 != 身份.值
            || 键关系->源节点 != 身份.值
            || 来源关系->源节点 != 身份.值
            || 族关系->角色或顺序 != 1
            || 键关系->角色或顺序 != 1 || 来源关系->角色或顺序 != 1
            || 节点->创建事实代次 != 族关系->创建事实代次
            || 节点->创建事实代次 != 键关系->创建事实代次
            || 节点->创建事实代次 != 来源关系->创建事实代次
            || 节点->退出事实代次 != 族关系->退出事实代次
            || 节点->退出事实代次 != 键关系->退出事实代次
            || 节点->退出事实代次 != 来源关系->退出事实代次)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 材料 = 读取材料对(材料服务,
            {键关系->目标节点}, {来源关系->目标节点},
            L2读取类别::历史, 观察代次, 关系截止);
        if (材料.状态 != L2结构状态::已读取)
            return {材料.状态, 截止, std::nullopt};
        const auto 锚点读 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 定位.族锚点});
        const auto 类型读 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 定位.族归属关系类型});
        const auto* 锚点 = 锚点读.事实
            ? std::get_if<L1所有者范围节点事实>(&*锚点读.事实) : nullptr;
        const auto* 类型 = 类型读.事实
            ? std::get_if<L1所有者范围节点事实>(&*类型读.事实) : nullptr;
        if (锚点读.状态 != L1所有者范围读取状态::成功
            || 类型读.状态 != L1所有者范围读取状态::成功
            || 锚点读.读取事实代次 != 观察代次
            || 类型读.读取事实代次 != 观察代次 || !锚点 || !类型
            || 锚点->编码 != 定位.族锚点
            || 类型->编码 != 定位.族归属关系类型
            || 锚点->写入所有者 != 定位.所有者
            || 类型->写入所有者 != 定位.所有者)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 生命周期 = 投影生命周期(节点->创建事实代次,
            节点->退出事实代次, 截止);
        L2节点族身份来源事实 身份来源{L2节点族::语言, 身份.值,
            定位.所有者, 定位.族锚点, 定位.族归属关系类型,
            族关系->编码, 族关系->角色或顺序,
            投影生命周期(定位.所有者事实.创建事实代次,
                定位.所有者事实.退出事实代次, 截止),
            生命周期,
            投影生命周期(锚点->创建事实代次, 锚点->退出事实代次, 截止),
            投影生命周期(类型->创建事实代次, 类型->退出事实代次, 截止),
            生命周期};
        L2语言事实 事实{身份, std::move(身份来源),
            {身份, {{键关系->目标节点}}, 键关系->编码, 生命周期},
            {身份, {来源关系->目标节点}, 来源关系->编码, 生命周期},
            生命周期};
        if (!L2语言事实完整(事实, 截止))
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        return {L2结构状态::已读取, 截止,
            语言内部事实{std::move(事实), 身份.值, 族关系->编码,
                键关系->编码, 来源关系->编码}};
    } catch (const std::bad_alloc&) {
        return {L2结构状态::资源失败, 截止, std::nullopt};
    } catch (const std::length_error&) {
        return {L2结构状态::资源失败, 截止, std::nullopt};
    } catch (...) {
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    }
}

// 诊断责任：向上送出；当前入口先消费 owner 一致投影，再按同代正式重建。
语言内部读取结果 读取当前语言核心(const L1事实基座服务& 第一层服务,
    const 不可变材料服务& 材料服务, const 语言定位& 定位,
    L2语言身份 身份, std::uint64_t 守卫) {
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 守卫;
    请求.所有者 = {定位.所有者};
    请求.节点 = {身份.值, 定位.族锚点, 定位.族归属关系类型,
        定位.登记键关系类型, 定位.来源关系类型};
    请求.源关系组 = {{身份.值, 定位.登记键关系类型},
        {身份.值, 定位.来源关系类型}};
    请求.目标关系组 = {{身份.值, 定位.族归属关系类型}};
    const auto 一致 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    if (一致.合同版本 != L1所有者范围一致当前读取合同版本
        || 一致.期望事实代次 != 守卫)
        return {L2结构状态::内部不一致, 守卫, std::nullopt};
    if (一致.状态 != L1所有者范围一致当前读取状态::成功) {
        if (一致.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
            return {L2结构状态::事实代次漂移, 一致.读取事实代次,
                std::nullopt};
        if (一致.状态 == L1所有者范围一致当前读取状态::资源失败)
            return {L2结构状态::资源失败, 一致.读取事实代次, std::nullopt};
        return {L2结构状态::内部不一致, 一致.读取事实代次, std::nullopt};
    }
    if (一致.读取事实代次 != 守卫 || 一致.所有者.size() != 1
        || 一致.节点.size() != 5 || 一致.源关系组.size() != 2
        || 一致.目标关系组.size() != 1)
        return {L2结构状态::内部不一致, 一致.读取事实代次, std::nullopt};
    return 读取历史语言核心(
        第一层服务, 材料服务, 定位, 身份, 守卫, 守卫, true);
}

// 诊断责任：向上送出；登记键关系组只能选出零或一个截止上活动语言。
语言内部读取结果 按登记键读取核心(const L1事实基座服务& 第一层服务,
    const 不可变材料服务& 材料服务, const 语言定位& 定位,
    不可变材料身份 登记键, std::uint64_t 截止, std::uint64_t 观察代次,
    bool 当前) {
    const auto 材料 = 读取材料对(材料服务, 登记键, 登记键,
        当前 ? L2读取类别::当前 : L2读取类别::历史, 观察代次, 截止);
    if (材料.状态 != L2结构状态::已读取)
        return {材料.状态, 截止, std::nullopt};
    const auto 关系组 = 第一层服务.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::目标,
            登记键.值, 定位.登记键关系类型, 截止});
    if (关系组.状态 != L1所有者范围读取状态::成功
        || 关系组.合同版本 != L1所有者范围CRUD合同版本
        || 关系组.读取事实代次 != 观察代次
        || 关系组.历史截止事实代次 != 截止)
        return {关系组.状态 == L1所有者范围读取状态::资源失败
                ? L2结构状态::资源失败 : L2结构状态::内部不一致,
            截止, std::nullopt};
    std::optional<语言内部事实> 找到;
    for (const auto& 关系 : 关系组.关系组) {
        if (关系.写入所有者 != 定位.所有者
            || 关系.目标节点 != 登记键.值
            || 关系.关系类型节点 != 定位.登记键关系类型)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 候选 = 读取历史语言核心(第一层服务, 材料服务,
            定位, L2语言身份{关系.源节点}, 截止, 观察代次, true);
        if (候选.状态 == L2结构状态::已退出
            || 候选.状态 == L2结构状态::未找到) continue;
        if (候选.状态 != L2结构状态::已读取 || !候选.事实
            || 候选.事实->登记关系编码 != 关系.编码)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        if (找到)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        找到 = 候选.事实;
    }
    return 找到 ? 语言内部读取结果{L2结构状态::已读取, 截止, 找到}
        : 语言内部读取结果{L2结构状态::未找到, 截止, std::nullopt};
}

// 诊断责任：向上送出；词条 owner 与五关系在同一截止重建完整词条。
词条内部读取结果 读取历史词条核心(const L1事实基座服务& 第一层服务,
    const 不可变材料服务& 材料服务, const 语言定位& 语言位置,
    const 词条定位& 定位, L2词条身份 身份, std::uint64_t 截止,
    std::uint64_t 观察代次, bool 要求当前活动) {
    const auto 节点读 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 身份.值});
    if (节点读.合同版本 != L1所有者范围CRUD合同版本
        || 节点读.查询编码 != 身份.值
        || 节点读.读取事实代次 != 观察代次)
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    if (节点读.状态 != L1所有者范围读取状态::成功)
        return {映射读取状态(节点读.状态), 截止, std::nullopt};
    const auto* 节点 = 节点读.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读.事实) : nullptr;
    if (!节点 || 节点->编码 != 身份.值
        || 节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || !节点->当前属性.empty())
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    if (节点->创建事实代次 > 截止)
        return {L2结构状态::未找到, 截止, std::nullopt};
    if (要求当前活动 && 节点->退出事实代次
        && *节点->退出事实代次 <= 截止)
        return {L2结构状态::已退出, 截止, std::nullopt};
    const std::uint64_t 关系截止 = 节点->退出事实代次
            && *节点->退出事实代次 <= 截止
        ? *节点->退出事实代次 - 1 : 截止;
    try {
        const auto 族关系 = 读取词条唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::目标, 身份.值,
            定位.族归属关系类型, 关系截止, 观察代次);
        const auto 语言关系 = 读取词条唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.语言归属关系类型, 关系截止, 观察代次);
        const auto 合同关系 = 读取词条唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.规范化合同关系类型, 关系截止, 观察代次);
        const auto 词面关系 = 读取词条唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.规范化词面关系类型, 关系截止, 观察代次);
        const auto 来源关系 = 读取词条唯一历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.来源关系类型, 关系截止, 观察代次);
        if (!族关系 || !语言关系 || !合同关系 || !词面关系 || !来源关系
            || 族关系->源节点 != 定位.族锚点
            || 族关系->目标节点 != 身份.值
            || 语言关系->源节点 != 身份.值
            || 合同关系->源节点 != 身份.值
            || 词面关系->源节点 != 身份.值
            || 来源关系->源节点 != 身份.值
            || 族关系->角色或顺序 != 1 || 语言关系->角色或顺序 != 1
            || 合同关系->角色或顺序 != 1 || 词面关系->角色或顺序 != 1
            || 来源关系->角色或顺序 != 1
            || 节点->创建事实代次 != 族关系->创建事实代次
            || 节点->创建事实代次 != 语言关系->创建事实代次
            || 节点->创建事实代次 != 合同关系->创建事实代次
            || 节点->创建事实代次 != 词面关系->创建事实代次
            || 节点->创建事实代次 != 来源关系->创建事实代次
            || 节点->退出事实代次 != 族关系->退出事实代次
            || 节点->退出事实代次 != 语言关系->退出事实代次
            || 节点->退出事实代次 != 合同关系->退出事实代次
            || 节点->退出事实代次 != 词面关系->退出事实代次
            || 节点->退出事实代次 != 来源关系->退出事实代次)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 语言 = 读取历史语言核心(第一层服务, 材料服务,
            语言位置, L2语言身份{语言关系->目标节点}, 关系截止,
            观察代次, true);
        if (语言.状态 != L2结构状态::已读取 || !语言.事实)
            return {语言.状态 == L2结构状态::资源失败 ? 语言.状态
                : L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 材料 = 读取词条材料组(材料服务,
            {合同关系->目标节点}, {词面关系->目标节点},
            {来源关系->目标节点}, L2读取类别::历史,
            观察代次, 关系截止);
        if (材料.状态 != L2结构状态::已读取)
            return {材料.状态, 截止, std::nullopt};
        const auto 锚点读 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 定位.族锚点});
        const auto 类型读 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 定位.族归属关系类型});
        const auto* 锚点 = 锚点读.事实
            ? std::get_if<L1所有者范围节点事实>(&*锚点读.事实) : nullptr;
        const auto* 类型 = 类型读.事实
            ? std::get_if<L1所有者范围节点事实>(&*类型读.事实) : nullptr;
        if (锚点读.状态 != L1所有者范围读取状态::成功
            || 类型读.状态 != L1所有者范围读取状态::成功
            || 锚点读.读取事实代次 != 观察代次
            || 类型读.读取事实代次 != 观察代次 || !锚点 || !类型
            || 锚点->编码 != 定位.族锚点
            || 类型->编码 != 定位.族归属关系类型
            || 锚点->写入所有者 != 定位.所有者
            || 类型->写入所有者 != 定位.所有者)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 生命周期 = 投影生命周期(
            节点->创建事实代次, 节点->退出事实代次, 截止);
        L2节点族身份来源事实 身份来源{L2节点族::词条, 身份.值,
            定位.所有者, 定位.族锚点, 定位.族归属关系类型,
            族关系->编码, 族关系->角色或顺序,
            投影生命周期(定位.所有者事实.创建事实代次,
                定位.所有者事实.退出事实代次, 截止),
            生命周期,
            投影生命周期(锚点->创建事实代次, 锚点->退出事实代次, 截止),
            投影生命周期(类型->创建事实代次, 类型->退出事实代次, 截止),
            生命周期};
        const L2语言身份 语言身份{语言关系->目标节点};
        const 不可变材料身份 合同身份{合同关系->目标节点};
        const 不可变材料身份 词面身份{词面关系->目标节点};
        L2词条事实 事实{身份, std::move(身份来源),
            {语言身份, 合同身份, 词面身份},
            {身份, 语言身份, 语言关系->编码, 生命周期},
            {身份, 合同身份, 合同关系->编码, 生命周期},
            {身份, 词面身份, 词面关系->编码, 生命周期},
            {身份, {来源关系->目标节点}, 来源关系->编码, 生命周期},
            生命周期};
        if (!L2词条事实完整(事实, 截止))
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        return {L2结构状态::已读取, 截止,
            词条内部事实{std::move(事实), 身份.值, 族关系->编码,
                语言关系->编码, 合同关系->编码, 词面关系->编码,
                来源关系->编码}};
    } catch (const std::bad_alloc&) {
        return {L2结构状态::资源失败, 截止, std::nullopt};
    } catch (const std::length_error&) {
        return {L2结构状态::资源失败, 截止, std::nullopt};
    } catch (...) {
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    }
}

// 诊断责任：向上送出；当前词条先消费 owner 一致投影再同代重建。
词条内部读取结果 读取当前词条核心(const L1事实基座服务& 第一层服务,
    const 不可变材料服务& 材料服务, const 语言定位& 语言位置,
    const 词条定位& 定位, L2词条身份 身份, std::uint64_t 守卫) {
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 守卫;
    请求.所有者 = {定位.所有者};
    请求.节点 = {身份.值, 定位.族锚点, 定位.族归属关系类型,
        定位.语言归属关系类型, 定位.规范化合同关系类型,
        定位.规范化词面关系类型, 定位.来源关系类型};
    请求.源关系组 = {{身份.值, 定位.语言归属关系类型},
        {身份.值, 定位.规范化合同关系类型},
        {身份.值, 定位.规范化词面关系类型},
        {身份.值, 定位.来源关系类型}};
    请求.目标关系组 = {{身份.值, 定位.族归属关系类型}};
    const auto 一致 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    if (一致.合同版本 != L1所有者范围一致当前读取合同版本
        || 一致.期望事实代次 != 守卫)
        return {L2结构状态::内部不一致, 守卫, std::nullopt};
    if (一致.状态 != L1所有者范围一致当前读取状态::成功) {
        if (一致.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
            return {L2结构状态::事实代次漂移, 一致.读取事实代次,
                std::nullopt};
        if (一致.状态 == L1所有者范围一致当前读取状态::资源失败)
            return {L2结构状态::资源失败, 一致.读取事实代次, std::nullopt};
        return {L2结构状态::内部不一致, 一致.读取事实代次, std::nullopt};
    }
    if (一致.读取事实代次 != 守卫 || 一致.所有者.size() != 1
        || 一致.节点.size() != 7 || 一致.源关系组.size() != 4
        || 一致.目标关系组.size() != 1)
        return {L2结构状态::内部不一致, 一致.读取事实代次, std::nullopt};
    return 读取历史词条核心(第一层服务, 材料服务, 语言位置,
        定位, 身份, 守卫, 守卫, true);
}

// 诊断责任：向上送出；规范化键只选出零或一个截止上活动词条。
词条内部读取结果 按词条规范化键读取核心(
    const L1事实基座服务& 第一层服务,
    const 不可变材料服务& 材料服务, const 语言定位& 语言位置,
    const 词条定位& 定位, const L2词条规范化键& 规范化键,
    std::uint64_t 截止, std::uint64_t 观察代次, bool 当前) {
    const auto 语言 = 读取历史语言核心(第一层服务, 材料服务,
        语言位置, 规范化键.语言, 截止, 观察代次, true);
    if (语言.状态 != L2结构状态::已读取 || !语言.事实)
        return {语言.状态, 截止, std::nullopt};
    const auto 材料 = 读取词条材料组(材料服务,
        规范化键.规范化合同材料, 规范化键.规范化词面材料,
        规范化键.规范化合同材料,
        当前 ? L2读取类别::当前 : L2读取类别::历史,
        观察代次, 截止);
    if (材料.状态 != L2结构状态::已读取)
        return {材料.状态, 截止, std::nullopt};
    const auto 关系组 = 第一层服务.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::目标,
            规范化键.规范化词面材料.值,
            定位.规范化词面关系类型, 截止});
    if (关系组.状态 != L1所有者范围读取状态::成功
        || 关系组.合同版本 != L1所有者范围CRUD合同版本
        || 关系组.读取事实代次 != 观察代次
        || 关系组.历史截止事实代次 != 截止)
        return {关系组.状态 == L1所有者范围读取状态::资源失败
                ? L2结构状态::资源失败 : L2结构状态::内部不一致,
            截止, std::nullopt};
    std::optional<词条内部事实> 找到;
    for (const auto& 关系 : 关系组.关系组) {
        if (关系.写入所有者 != 定位.所有者
            || 关系.目标节点 != 规范化键.规范化词面材料.值
            || 关系.关系类型节点 != 定位.规范化词面关系类型)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 候选 = 读取历史词条核心(第一层服务, 材料服务,
            语言位置, 定位, L2词条身份{关系.源节点}, 截止,
            观察代次, true);
        if (候选.状态 == L2结构状态::已退出
            || 候选.状态 == L2结构状态::未找到) continue;
        if (候选.状态 != L2结构状态::已读取 || !候选.事实
            || 候选.事实->词面关系编码 != 关系.编码)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        if (候选.事实->公开事实.规范化键 != 规范化键) continue;
        if (找到)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        找到 = 候选.事实;
    }
    return 找到 ? 词条内部读取结果{L2结构状态::已读取, 截止, 找到}
        : 词条内部读取结果{L2结构状态::未找到, 截止, std::nullopt};
}

// 诊断责任：无适用错误分支；形成新增空载荷失败。
L2语言新增结果 新增失败(L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
