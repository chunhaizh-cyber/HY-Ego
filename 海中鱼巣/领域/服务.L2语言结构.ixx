inline constexpr L1所有者范围建立幂等身份 语言所有者建立身份{
    0x4C32'4C41'4E47'0001ULL};
inline constexpr L1所有者范围建立幂等身份 词条所有者建立身份{
    0x4C32'4C45'5845'0001ULL};

class L2语言结构服务;

class L2语言所有者交付 final {
public:
    L2语言所有者交付() = delete;
    L2语言所有者交付(const L2语言所有者交付&) = delete;
    L2语言所有者交付& operator=(const L2语言所有者交付&) = delete;
    L2语言所有者交付(L2语言所有者交付&&) noexcept = default;
    L2语言所有者交付& operator=(L2语言所有者交付&&) = delete;

private:
    explicit L2语言所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2语言所有者交付> 尝试形成L2语言所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2语言结构服务;
    L1所有者范围写端口 写入端口_;
};

class L2词条所有者交付 final {
public:
    L2词条所有者交付() = delete;
    L2词条所有者交付(const L2词条所有者交付&) = delete;
    L2词条所有者交付& operator=(const L2词条所有者交付&) = delete;
    L2词条所有者交付(L2词条所有者交付&&) noexcept = default;
    L2词条所有者交付& operator=(L2词条所有者交付&&) = delete;

private:
    explicit L2词条所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2词条所有者交付> 尝试形成L2词条所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2语言结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2语言所有者交付> 尝试形成L2语言所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;
std::optional<L2词条所有者交付> 尝试形成L2词条所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

}

