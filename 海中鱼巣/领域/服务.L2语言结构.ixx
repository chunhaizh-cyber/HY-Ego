inline constexpr L1所有者范围写入幂等身份 词条登记幂等身份{
    0x4C32'4944'5352'4309ULL};
inline constexpr std::uint32_t 语言族锚点本地键值 = 0x0208'6001U;
inline constexpr std::uint32_t 语言族归属关系类型本地键值 = 0x0208'6002U;
inline constexpr std::uint32_t 语言登记键关系类型本地键值 = 0x0208'6101U;
inline constexpr std::uint32_t 语言来源关系类型本地键值 = 0x0208'6102U;
inline constexpr std::uint32_t 语言节点本地键值 = 0x0208'1001U;
inline constexpr std::uint32_t 语言族归属关系本地键值 = 0x0208'1002U;
inline constexpr std::uint32_t 语言登记键关系本地键值 = 0x0208'1003U;
inline constexpr std::uint32_t 语言来源关系本地键值 = 0x0208'1004U;
inline constexpr std::uint32_t 词条族锚点本地键值 = 0x0209'6001U;
inline constexpr std::uint32_t 词条族归属关系类型本地键值 = 0x0209'6002U;
inline constexpr std::uint32_t 词条语言归属关系类型本地键值 = 0x0209'6101U;
inline constexpr std::uint32_t 词条规范化合同关系类型本地键值 = 0x0209'6102U;
inline constexpr std::uint32_t 词条规范化词面关系类型本地键值 = 0x0209'6103U;
inline constexpr std::uint32_t 词条来源关系类型本地键值 = 0x0209'6104U;
inline constexpr std::uint32_t 词条节点本地键值 = 0x0209'1001U;
inline constexpr std::uint32_t 词条族归属关系本地键值 = 0x0209'1002U;
inline constexpr std::uint32_t 词条语言归属关系本地键值 = 0x0209'1003U;
inline constexpr std::uint32_t 词条规范化合同关系本地键值 = 0x0209'1004U;
inline constexpr std::uint32_t 词条规范化词面关系本地键值 = 0x0209'1005U;
