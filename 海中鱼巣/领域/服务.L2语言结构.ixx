// 诊断责任：无适用错误分支；形成四事实新增规范化写集。
L1所有者范围写集请求 形成新增写集(std::uint64_t 守卫,
    L1所有者范围写入幂等身份 幂等, const 语言定位& 定位,
    不可变材料身份 登记键, 不可变材料身份 来源) {
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 守卫;
    写集.写入幂等身份 = 幂等;
    写集.节点 = {{{语言节点本地键值}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{语言族归属关系本地键值}, 定位.族锚点,
            L1所有者范围写集本地键{语言节点本地键值},
            定位.族归属关系类型, 1},
        {{语言登记键关系本地键值},
            L1所有者范围写集本地键{语言节点本地键值}, 登记键.值,
            定位.登记键关系类型, 1},
        {{语言来源关系本地键值},
            L1所有者范围写集本地键{语言节点本地键值}, 来源.值,
            定位.来源关系类型, 1}};
    return 写集;
}

// 诊断责任：无适用错误分支；四事实退出编码按稳定顺序形成写集。
void 加入退出写集(L1所有者范围写集请求& 写集,
    const 语言内部事实& 事实) {
    写集.退出事实 = {事实.节点编码, 事实.族关系编码,
        事实.登记关系编码, 事实.来源关系编码};
}

// 诊断责任：无适用错误分支；从首次结果取得唯一新语言编码。
std::optional<稳定编码> 取得新语言编码(
    const L1所有者范围写入结果& 结果) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 语言节点本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

