// 诊断责任：无适用错误分支；形成节点、族归属与四关系原子写集。
L1所有者范围写集请求 形成词条新增写集(std::uint64_t 守卫,
    L1所有者范围写入幂等身份 幂等, const 词条定位& 定位,
    const L2词条规范化键& 规范化键, 不可变材料身份 来源) {
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 守卫;
    写集.写入幂等身份 = 幂等;
    写集.节点 = {{{词条节点本地键值}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{词条族归属关系本地键值}, 定位.族锚点,
            L1所有者范围写集本地键{词条节点本地键值},
            定位.族归属关系类型, 1},
        {{词条语言归属关系本地键值},
            L1所有者范围写集本地键{词条节点本地键值},
            规范化键.语言.值, 定位.语言归属关系类型, 1},
        {{词条规范化合同关系本地键值},
            L1所有者范围写集本地键{词条节点本地键值},
            规范化键.规范化合同材料.值, 定位.规范化合同关系类型, 1},
        {{词条规范化词面关系本地键值},
            L1所有者范围写集本地键{词条节点本地键值},
            规范化键.规范化词面材料.值, 定位.规范化词面关系类型, 1},
        {{词条来源关系本地键值},
            L1所有者范围写集本地键{词条节点本地键值}, 来源.值,
            定位.来源关系类型, 1}};
    return 写集;
}

// 诊断责任：无适用错误分支；六事实退出编码按稳定顺序形成写集。
void 加入词条退出写集(L1所有者范围写集请求& 写集,
    const 词条内部事实& 事实) {
    写集.退出事实 = {事实.节点编码, 事实.族关系编码,
        事实.语言关系编码, 事实.合同关系编码,
        事实.词面关系编码, 事实.来源关系编码};
}

// 诊断责任：无适用错误分支；从首次结果取得唯一新词条编码。
std::optional<稳定编码> 取得新词条编码(
    const L1所有者范围写入结果& 结果) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 词条节点本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

} // namespace 海中鱼巣::L2语言结构内部

export namespace 海中鱼巣 {

// 诊断责任：向上送出；交付或实例绑定不完整时只返回空 optional。
std::optional<L2语言所有者交付> 尝试形成L2语言所有者交付(
    const L1事实基座服务& 第一层服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 语言所有者建立身份
            || 建立.事实代次 == 0 || (!首次 && !重复)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份()
                != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层服务))
            return std::nullopt;
        const auto 当前 = 第一层服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2语言所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

// 诊断责任：向上送出；词条交付或实例绑定不完整时只返回空 optional。
std::optional<L2词条所有者交付> 尝试形成L2词条所有者交付(
    const L1事实基座服务& 第一层服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 词条所有者建立身份
            || 建立.事实代次 == 0 || (!首次 && !重复)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份()
                != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层服务))
            return std::nullopt;
        const auto 当前 = 第一层服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2词条所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class L2语言结构服务 final {
private:
    struct 双所有者写端口 final {
        L1所有者范围写端口 语言;
        L1所有者范围写端口 词条;
    };

public:
    // 诊断责任：向上送出；同 L1、双 owner 和固定登记失败时抛出。
    explicit L2语言结构服务(const L1事实基座服务& 第一层服务,
        const 不可变材料服务& 材料服务,
        L2语言所有者交付&& 语言所有者交付,
        L2词条所有者交付&& 词条所有者交付)
        : L2语言结构服务(第一层服务, 材料服务,
            验证并移动双所有者交付(第一层服务, 材料服务,
                语言所有者交付, 词条所有者交付)) {}

    L2语言结构服务() = delete;
    L2语言结构服务(const L2语言结构服务&) = delete;
    L2语言结构服务& operator=(const L2语言结构服务&) = delete;
    L2语言结构服务(L2语言结构服务&&) = delete;
    L2语言结构服务& operator=(L2语言结构服务&&) = delete;

    // 诊断责任：本地记录；异常映射不泄漏半载荷或伪造发布成功。
    L2语言新增结果 新增语言(const L2语言新增请求& 请求) {
        using namespace L2语言结构内部;
        if (!L2语言新增请求有效(请求)
            || 请求.幂等身份.值 == 语言登记幂等身份.值)
            return 新增失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放新增(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 新增失败(映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 材料 = 读取材料对(材料服务_, 请求.登记键.材料,
                请求.来源材料, L2读取类别::当前,
                请求.请求头.期望事实代次, 请求.请求头.期望事实代次);
            if (材料.状态 != L2结构状态::已读取)
                return 新增失败(材料.状态, 请求.请求头.期望事实代次);
            const auto 占用 = 按登记键读取核心(第一层服务_, 材料服务_, 定位_,
                请求.登记键.材料, 请求.请求头.期望事实代次,
                请求.请求头.期望事实代次, true);
            if (占用.状态 == L2结构状态::已读取)
                return 新增失败(L2结构状态::引用冲突, 占用.截止);
            if (占用.状态 != L2结构状态::未找到)
                return 新增失败(占用.状态, 占用.截止);
            const auto 写集 = 形成新增写集(请求.请求头.期望事实代次,
                幂等, 定位_, 请求.登记键.材料, 请求.来源材料);
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 新增失败(状态, 写入.事实代次);
            const auto 新身份 = 取得新语言编码(写入);
            if (!新身份 || 写入.事实代次 <= 请求.请求头.期望事实代次)
                return 新增失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 读回 = 读取历史语言核心(第一层服务_, 材料服务_,
                定位_, L2语言身份{*新身份}, 写入.事实代次,
                写入.事实代次, false);
            if (读回.状态 != L2结构状态::已读取 || !读回.事实)
                return 新增失败(L2结构状态::内部不一致, 写入.事实代次);
            L2语言新增结果 结果{{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(读回.事实->公开事实)};
            return 结果.成功() ? 结果
                : 新增失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 新增失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 新增失败(L2结构状态::资源失败);
        } catch (...) {
            return 新增失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；替换始终由一份退出旧四事实并新增四事实的写集完成。
    L2语言替换结果 替换语言(const L2语言替换请求& 请求) {
        using namespace L2语言结构内部;
        if (!L2语言替换请求有效(请求)
            || 请求.幂等身份.值 == 语言登记幂等身份.值)
            return 替换失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放替换(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 替换失败(映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 旧读 = 读取当前语言核心(第一层服务_, 材料服务_,
                定位_, 请求.旧语言, 请求.请求头.期望事实代次);
            if (旧读.状态 != L2结构状态::已读取 || !旧读.事实)
                return 替换失败(旧读.状态, 旧读.截止);
            if (旧读.事实->公开事实.登记键.登记键 != 请求.旧登记键
                || 旧读.事实->公开事实.来源.来源材料 != 请求.旧来源材料)
                return 替换失败(L2结构状态::引用冲突, 旧读.截止);
            const auto 材料 = 读取材料对(材料服务_, 请求.新登记键.材料,
                请求.新来源材料, L2读取类别::当前,
                请求.请求头.期望事实代次, 请求.请求头.期望事实代次);
            if (材料.状态 != L2结构状态::已读取)
                return 替换失败(材料.状态, 请求.请求头.期望事实代次);
            const auto 占用 = 按登记键读取核心(第一层服务_, 材料服务_, 定位_,
                请求.新登记键.材料, 请求.请求头.期望事实代次,
                请求.请求头.期望事实代次, true);
            if (占用.状态 == L2结构状态::已读取
                && (!占用.事实 || 占用.事实->公开事实.语言 != 请求.旧语言))
                return 替换失败(L2结构状态::引用冲突, 占用.截止);
            if (占用.状态 != L2结构状态::已读取
                && 占用.状态 != L2结构状态::未找到)
                return 替换失败(占用.状态, 占用.截止);
            auto 写集 = 形成新增写集(请求.请求头.期望事实代次,
                幂等, 定位_, 请求.新登记键.材料, 请求.新来源材料);
            加入退出写集(写集, *旧读.事实);
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 替换失败(状态, 写入.事实代次);
            const auto 新身份 = 取得新语言编码(写入);
            if (!新身份 || *新身份 == 请求.旧语言.值
                || 写入.事实代次 <= 请求.请求头.期望事实代次)
                return 替换失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 新读 = 读取历史语言核心(第一层服务_, 材料服务_,
                定位_, L2语言身份{*新身份}, 写入.事实代次,
                写入.事实代次, false);
            const auto 旧历史 = 读取历史语言核心(第一层服务_, 材料服务_,
                定位_, 请求.旧语言, 写入.事实代次, 写入.事实代次, false);
            if (新读.状态 != L2结构状态::已读取 || !新读.事实
                || 旧历史.状态 != L2结构状态::已读取 || !旧历史.事实)
                return 替换失败(L2结构状态::内部不一致, 写入.事实代次);
            L2语言替换结果 结果{{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(新读.事实->公开事实),
                std::move(旧历史.事实->公开事实)};
            return 结果.成功() ? 结果
                : 替换失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 替换失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 替换失败(L2结构状态::资源失败);
        } catch (...) {
            return 替换失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；L1 引用保护结果保持为结构化引用冲突。
    L2语言退出结果 退出语言(const L2语言退出请求& 请求) {
        using namespace L2语言结构内部;
        if (!L2语言退出请求有效(请求)
            || 请求.幂等身份.值 == 语言登记幂等身份.值)
            return 退出失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放退出(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 退出失败(映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 当前 = 读取当前语言核心(第一层服务_, 材料服务_,
                定位_, 请求.语言, 请求.请求头.期望事实代次);
            if (当前.状态 != L2结构状态::已读取 || !当前.事实)
                return 退出失败(当前.状态, 当前.截止);
            if (当前.事实->公开事实.登记键.登记键 != 请求.登记键
                || 当前.事实->公开事实.来源.来源材料 != 请求.来源材料)
                return 退出失败(L2结构状态::引用冲突, 当前.截止);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 幂等;
            加入退出写集(写集, *当前.事实);
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 退出失败(状态, 写入.事实代次);
            if (!写入.新编码映射.empty()
                || 写入.事实代次 <= 请求.请求头.期望事实代次)
                return 退出失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 历史 = 读取历史语言核心(第一层服务_, 材料服务_,
                定位_, 请求.语言, 写入.事实代次, 写入.事实代次, false);
            if (历史.状态 != L2结构状态::已读取 || !历史.事实)
                return 退出失败(L2结构状态::内部不一致, 写入.事实代次);
            L2语言退出结果 结果{{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(历史.事实->公开事实)};
            return 结果.成功() ? 结果
                : 退出失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 退出失败(L2结构状态::资源失败);
        } catch (...) {
            return 退出失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；当前与历史均以前后同代守卫返回值式结果。
    L2语言读取结果 读取语言(const L2语言读取请求& 请求) const {
        using namespace L2语言结构内部;
        if (!L2语言读取请求有效(请求))
            return 读取失败(请求, L2结构状态::入口拒绝);
        try {
            const auto [前状态, 前代次] = 读取当前事实代次(第一层服务_);
            if (前状态 != L2结构状态::已读取)
                return 读取失败(请求, 前状态, 前代次);
            if (前代次 != 请求.请求头.期望事实代次)
                return 读取失败(请求, L2结构状态::事实代次漂移, 前代次);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            const auto 核心 = 请求.读取类别 == L2读取类别::当前
                ? 读取当前语言核心(第一层服务_, 材料服务_, 定位_,
                    请求.语言, 截止)
                : 读取历史语言核心(第一层服务_, 材料服务_, 定位_,
                    请求.语言, 截止, 前代次, false);
            if (核心.状态 != L2结构状态::已读取 || !核心.事实)
                return 读取失败(请求, 核心.状态, 核心.截止);
            const auto [后状态, 后代次] = 读取当前事实代次(第一层服务_);
            if (后状态 != L2结构状态::已读取)
                return 读取失败(请求, 后状态, 后代次);
            if (后代次 != 前代次)
                return 读取失败(请求, L2结构状态::事实代次漂移, 后代次);
            L2语言读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
                截止, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(核心.事实->公开事实)};
            return 结果.成功() ? 结果
                : 读取失败(请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return 读取失败(请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 读取失败(请求, L2结构状态::资源失败);
        } catch (...) {
            return 读取失败(请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；按键当前或历史只返回对应截止的唯一活动语言。
    L2语言按登记键读取结果 按登记键读取语言(
        const L2语言按登记键读取请求& 请求) const {
        using namespace L2语言结构内部;
        if (!L2语言按登记键读取请求有效(请求))
            return 按键读取失败(请求, L2结构状态::入口拒绝);
        try {
            const auto [前状态, 前代次] = 读取当前事实代次(第一层服务_);
            if (前状态 != L2结构状态::已读取)
                return 按键读取失败(请求, 前状态, 前代次);
            if (前代次 != 请求.请求头.期望事实代次)
                return 按键读取失败(
                    请求, L2结构状态::事实代次漂移, 前代次);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            const auto 核心 = 按登记键读取核心(第一层服务_, 材料服务_,
                定位_, 请求.登记键.材料, 截止, 前代次,
                请求.读取类别 == L2读取类别::当前);
            if (核心.状态 != L2结构状态::已读取 || !核心.事实)
                return 按键读取失败(请求, 核心.状态, 核心.截止);
            const auto [后状态, 后代次] = 读取当前事实代次(第一层服务_);
            if (后状态 != L2结构状态::已读取)
                return 按键读取失败(请求, 后状态, 后代次);
            if (后代次 != 前代次)
                return 按键读取失败(
                    请求, L2结构状态::事实代次漂移, 后代次);
            L2语言按登记键读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(核心.事实->公开事实)};
            return 结果.成功() ? 结果
                : 按键读取失败(请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return 按键读取失败(请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 按键读取失败(请求, L2结构状态::资源失败);
        } catch (...) {
            return 按键读取失败(请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；词条新增异常映射为空载荷结构化结果。
    L2词条新增结果 新增词条(const L2词条新增请求& 请求) {
        using namespace L2语言结构内部;
        if (!L2词条新增请求有效(请求)
            || 请求.幂等身份.值 == 词条登记幂等身份.值)
            return 词条新增失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(词条写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 词条写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放词条新增(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 词条新增失败(
                    映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 语言 = 读取当前语言核心(第一层服务_, 材料服务_,
                定位_, 请求.规范化键.语言, 请求.请求头.期望事实代次);
            if (语言.状态 != L2结构状态::已读取 || !语言.事实)
                return 词条新增失败(语言.状态, 语言.截止);
            const auto 材料 = 读取词条材料组(材料服务_,
                请求.规范化键.规范化合同材料,
                请求.规范化键.规范化词面材料, 请求.来源材料,
                L2读取类别::当前, 请求.请求头.期望事实代次,
                请求.请求头.期望事实代次);
            if (材料.状态 != L2结构状态::已读取)
                return 词条新增失败(材料.状态, 请求.请求头.期望事实代次);
            const auto 占用 = 按词条规范化键读取核心(第一层服务_,
                材料服务_, 定位_, 词条定位_, 请求.规范化键,
                请求.请求头.期望事实代次,
                请求.请求头.期望事实代次, true);
            if (占用.状态 == L2结构状态::已读取)
                return 词条新增失败(L2结构状态::引用冲突, 占用.截止);
            if (占用.状态 != L2结构状态::未找到)
                return 词条新增失败(占用.状态, 占用.截止);
            const auto 写集 = 形成词条新增写集(
                请求.请求头.期望事实代次, 幂等, 词条定位_,
                请求.规范化键, 请求.来源材料);
            const auto 写入 = 词条写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 词条新增失败(状态, 写入.事实代次);
            const auto 新身份 = 取得新词条编码(写入);
            if (!新身份 || 写入.事实代次 <= 请求.请求头.期望事实代次)
                return 词条新增失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 读回 = 读取历史词条核心(第一层服务_, 材料服务_,
                定位_, 词条定位_, L2词条身份{*新身份}, 写入.事实代次,
                写入.事实代次, false);
            if (读回.状态 != L2结构状态::已读取 || !读回.事实)
                return 词条新增失败(L2结构状态::内部不一致, 写入.事实代次);
            L2词条新增结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次},
                std::move(读回.事实->公开事实)};
            return 结果.成功() ? 结果
                : 词条新增失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 词条新增失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 词条新增失败(L2结构状态::资源失败);
        } catch (...) {
            return 词条新增失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；引用保护与异常均保持为空载荷结构化结果。
    L2词条退出结果 退出词条(const L2词条退出请求& 请求) {
        using namespace L2语言结构内部;
        if (!L2词条退出请求有效(请求)
            || 请求.幂等身份.值 == 词条登记幂等身份.值)
            return 词条退出失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(词条写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 词条写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放词条退出(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 词条退出失败(
                    映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 当前 = 读取当前词条核心(第一层服务_, 材料服务_,
                定位_, 词条定位_, 请求.词条, 请求.请求头.期望事实代次);
            if (当前.状态 != L2结构状态::已读取 || !当前.事实)
                return 词条退出失败(当前.状态, 当前.截止);
            if (当前.事实->公开事实.规范化键 != 请求.规范化键
                || 当前.事实->公开事实.来源.来源材料 != 请求.来源材料)
                return 词条退出失败(L2结构状态::引用冲突, 当前.截止);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 幂等;
            加入词条退出写集(写集, *当前.事实);
            const auto 写入 = 词条写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 词条退出失败(状态, 写入.事实代次);
            if (!写入.新编码映射.empty()
                || 写入.事实代次 <= 请求.请求头.期望事实代次)
                return 词条退出失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 历史 = 读取历史词条核心(第一层服务_, 材料服务_,
                定位_, 词条定位_, 请求.词条, 写入.事实代次,
                写入.事实代次, false);
            if (历史.状态 != L2结构状态::已读取 || !历史.事实)
                return 词条退出失败(L2结构状态::内部不一致, 写入.事实代次);
            L2词条退出结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次},
                std::move(历史.事实->公开事实)};
            return 结果.成功() ? 结果
                : 词条退出失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 词条退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 词条退出失败(L2结构状态::资源失败);
        } catch (...) {
            return 词条退出失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前与历史读取以前后同代守卫返回值式结果。
    L2词条读取结果 读取词条(const L2词条读取请求& 请求) const {
        using namespace L2语言结构内部;
        if (!L2词条读取请求有效(请求))
            return 词条读取失败(请求, L2结构状态::入口拒绝);
        try {
            const auto [前状态, 前代次] = 读取当前事实代次(第一层服务_);
            if (前状态 != L2结构状态::已读取)
                return 词条读取失败(请求, 前状态, 前代次);
            if (前代次 != 请求.请求头.期望事实代次)
                return 词条读取失败(请求, L2结构状态::事实代次漂移, 前代次);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            const auto 核心 = 请求.读取类别 == L2读取类别::当前
                ? 读取当前词条核心(第一层服务_, 材料服务_, 定位_,
                    词条定位_, 请求.词条, 截止)
                : 读取历史词条核心(第一层服务_, 材料服务_, 定位_,
                    词条定位_, 请求.词条, 截止, 前代次, false);
            if (核心.状态 != L2结构状态::已读取 || !核心.事实)
                return 词条读取失败(请求, 核心.状态, 核心.截止);
            const auto [后状态, 后代次] = 读取当前事实代次(第一层服务_);
            if (后状态 != L2结构状态::已读取)
                return 词条读取失败(请求, 后状态, 后代次);
            if (后代次 != 前代次)
                return 词条读取失败(
                    请求, L2结构状态::事实代次漂移, 后代次);
            L2词条读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
                截止, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(核心.事实->公开事实)};
            return 结果.成功() ? 结果
                : 词条读取失败(请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return 词条读取失败(请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 词条读取失败(请求, L2结构状态::资源失败);
        } catch (...) {
            return 词条读取失败(请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；按键读取只返回对应截止唯一活动词条。
    L2词条按规范化键读取结果 按规范化键读取词条(
        const L2词条按规范化键读取请求& 请求) const {
        using namespace L2语言结构内部;
        if (!L2词条按规范化键读取请求有效(请求))
            return 词条按键读取失败(请求, L2结构状态::入口拒绝);
        try {
            const auto [前状态, 前代次] = 读取当前事实代次(第一层服务_);
            if (前状态 != L2结构状态::已读取)
                return 词条按键读取失败(请求, 前状态, 前代次);
            if (前代次 != 请求.请求头.期望事实代次)
                return 词条按键读取失败(
                    请求, L2结构状态::事实代次漂移, 前代次);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            const auto 核心 = 按词条规范化键读取核心(第一层服务_,
                材料服务_, 定位_, 词条定位_, 请求.规范化键,
                截止, 前代次, 请求.读取类别 == L2读取类别::当前);
            if (核心.状态 != L2结构状态::已读取 || !核心.事实)
                return 词条按键读取失败(请求, 核心.状态, 核心.截止);
            const auto [后状态, 后代次] = 读取当前事实代次(第一层服务_);
            if (后状态 != L2结构状态::已读取)
                return 词条按键读取失败(请求, 后状态, 后代次);
            if (后代次 != 前代次)
                return 词条按键读取失败(
                    请求, L2结构状态::事实代次漂移, 后代次);
            L2词条按规范化键读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(核心.事实->公开事实)};
            return 结果.成功() ? 结果
                : 词条按键读取失败(请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return 词条按键读取失败(请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 词条按键读取失败(请求, L2结构状态::资源失败);
        } catch (...) {
            return 词条按键读取失败(请求, L2结构状态::内部不一致);
        }
    }

private:
    // 诊断责任：向上送出；双 owner 登记失败由公开构造函数继续送出。
    L2语言结构服务(const L1事实基座服务& 第一层服务,
        const 不可变材料服务& 材料服务, 双所有者写端口&& 端口)
        : 第一层服务_(第一层服务), 材料服务_(材料服务),
          第一层写入端口_(std::move(端口.语言)),
          词条写入端口_(std::move(端口.词条)),
          定位_(L2语言结构内部::初始化语言登记(
              第一层服务_, 第一层写入端口_)),
          词条定位_(L2语言结构内部::初始化词条登记(
              第一层服务_, 词条写入端口_)) {}

    // 诊断责任：向上送出；材料与双 owner 必须同 L1 且 owner 不同。
    static 双所有者写端口 验证并移动双所有者交付(
        const L1事实基座服务& 第一层服务,
        const 不可变材料服务& 材料服务,
        L2语言所有者交付& 语言交付, L2词条所有者交付& 词条交付) {
        if (!材料服务.使用同一L1事实基座实例(第一层服务)
            || !语言交付.写入端口_.有效()
            || !词条交付.写入端口_.有效()
            || !语言交付.写入端口_.绑定于(第一层服务)
            || !词条交付.写入端口_.绑定于(第一层服务)
            || 语言交付.写入端口_.所有者身份()
                == 词条交付.写入端口_.所有者身份())
            throw std::invalid_argument("L2 language dependencies are not co-bound");
        return {std::move(语言交付.写入端口_),
            std::move(词条交付.写入端口_)};
    }

    // 诊断责任：向上送出；首次新增材料唯一裁决原请求与原结果。
    L2语言新增结果 重放新增(const L2语言新增请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2语言结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果
            || 首次.写入幂等身份 != 映射幂等身份(请求.幂等身份))
            return 新增失败(L2结构状态::内部不一致, 首次.读取事实代次);
        const auto& 写集 = *首次.首次规范化写集;
        const auto 期望 = 形成新增写集(请求.请求头.期望事实代次,
            映射幂等身份(请求.幂等身份), 定位_,
            请求.登记键.材料, 请求.来源材料);
        if (写集 != 期望)
            return 新增失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 身份 = 取得新语言编码(首次结果);
        if (!身份 || 首次结果.事实代次 == 0)
            return 新增失败(L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 读回 = 读取历史语言核心(第一层服务_, 材料服务_,
            定位_, L2语言身份{*身份}, 首次结果.事实代次,
            首次.读取事实代次, false);
        if (读回.状态 != L2结构状态::已读取 || !读回.事实)
            return 新增失败(L2结构状态::内部不一致, 首次.读取事实代次);
        L2语言新增结果 结果{{L2结构合同版本, L2结构状态::精确重复,
            首次结果.事实代次, 首次结果.事实代次},
            std::move(读回.事实->公开事实)};
        return 结果.成功() ? 结果
            : 新增失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    // 诊断责任：向上送出；首次替换材料唯一裁决旧、新完整请求与原结果。
    L2语言替换结果 重放替换(const L2语言替换请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2语言结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果)
            return 替换失败(L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 原旧 = 读取历史语言核心(第一层服务_, 材料服务_, 定位_,
            请求.旧语言, 请求.请求头.期望事实代次,
            首次.读取事实代次, true);
        if (原旧.状态 != L2结构状态::已读取 || !原旧.事实)
            return 替换失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        auto 期望 = 形成新增写集(请求.请求头.期望事实代次,
            映射幂等身份(请求.幂等身份), 定位_,
            请求.新登记键.材料, 请求.新来源材料);
        加入退出写集(期望, *原旧.事实);
        if (*首次.首次规范化写集 != 期望
            || 原旧.事实->公开事实.登记键.登记键 != 请求.旧登记键
            || 原旧.事实->公开事实.来源.来源材料 != 请求.旧来源材料)
            return 替换失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 新身份 = 取得新语言编码(首次结果);
        if (!新身份 || 首次结果.事实代次 == 0)
            return 替换失败(L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 新读 = 读取历史语言核心(第一层服务_, 材料服务_, 定位_,
            L2语言身份{*新身份}, 首次结果.事实代次,
            首次.读取事实代次, false);
        const auto 旧读 = 读取历史语言核心(第一层服务_, 材料服务_, 定位_,
            请求.旧语言, 首次结果.事实代次, 首次.读取事实代次, false);
        if (新读.状态 != L2结构状态::已读取 || !新读.事实
            || 旧读.状态 != L2结构状态::已读取 || !旧读.事实)
            return 替换失败(L2结构状态::内部不一致, 首次.读取事实代次);
        L2语言替换结果 结果{{L2结构合同版本, L2结构状态::精确重复,
            首次结果.事实代次, 首次结果.事实代次},
            std::move(新读.事实->公开事实),
            std::move(旧读.事实->公开事实)};
        return 结果.成功() ? 结果
            : 替换失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    // 诊断责任：向上送出；首次退出材料唯一裁决原请求与原退出投影。
    L2语言退出结果 重放退出(const L2语言退出请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2语言结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果)
            return 退出失败(L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 原事实 = 读取历史语言核心(第一层服务_, 材料服务_, 定位_,
            请求.语言, 请求.请求头.期望事实代次,
            首次.读取事实代次, true);
        if (原事实.状态 != L2结构状态::已读取 || !原事实.事实)
            return 退出失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        L1所有者范围写集请求 期望;
        期望.合同版本 = L1所有者范围CRUD合同版本;
        期望.期望事实代次 = 请求.请求头.期望事实代次;
        期望.写入幂等身份 = 映射幂等身份(请求.幂等身份);
        加入退出写集(期望, *原事实.事实);
        if (*首次.首次规范化写集 != 期望
            || 原事实.事实->公开事实.登记键.登记键 != 请求.登记键
            || 原事实.事实->公开事实.来源.来源材料 != 请求.来源材料)
            return 退出失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 读回 = 读取历史语言核心(第一层服务_, 材料服务_, 定位_,
            请求.语言, 首次结果.事实代次,
            首次.读取事实代次, false);
        if (读回.状态 != L2结构状态::已读取 || !读回.事实)
            return 退出失败(L2结构状态::内部不一致, 首次.读取事实代次);
        L2语言退出结果 结果{{L2结构合同版本, L2结构状态::精确重复,
            首次结果.事实代次, 首次结果.事实代次},
            std::move(读回.事实->公开事实)};
        return 结果.成功() ? 结果
            : 退出失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    // 诊断责任：向上送出；首次词条新增材料唯一裁决原请求和原结果。
    L2词条新增结果 重放词条新增(const L2词条新增请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2语言结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果
            || 首次.写入幂等身份 != 映射幂等身份(请求.幂等身份))
            return 词条新增失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 期望 = 形成词条新增写集(请求.请求头.期望事实代次,
            映射幂等身份(请求.幂等身份), 词条定位_,
            请求.规范化键, 请求.来源材料);
        if (*首次.首次规范化写集 != 期望)
            return 词条新增失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 身份 = 取得新词条编码(首次结果);
        if (!身份 || 首次结果.事实代次 == 0)
            return 词条新增失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 读回 = 读取历史词条核心(第一层服务_, 材料服务_,
            定位_, 词条定位_, L2词条身份{*身份}, 首次结果.事实代次,
            首次.读取事实代次, false);
        if (读回.状态 != L2结构状态::已读取 || !读回.事实)
            return 词条新增失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        L2词条新增结果 结果{{L2结构合同版本, L2结构状态::精确重复,
            首次结果.事实代次, 首次结果.事实代次},
            std::move(读回.事实->公开事实)};
        return 结果.成功() ? 结果
            : 词条新增失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    // 诊断责任：向上送出；首次词条退出材料唯一裁决原请求和退出投影。
    L2词条退出结果 重放词条退出(const L2词条退出请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2语言结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果)
            return 词条退出失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 原事实 = 读取历史词条核心(第一层服务_, 材料服务_,
            定位_, 词条定位_, 请求.词条, 请求.请求头.期望事实代次,
            首次.读取事实代次, true);
        if (原事实.状态 != L2结构状态::已读取 || !原事实.事实)
            return 词条退出失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        L1所有者范围写集请求 期望;
        期望.合同版本 = L1所有者范围CRUD合同版本;
        期望.期望事实代次 = 请求.请求头.期望事实代次;
        期望.写入幂等身份 = 映射幂等身份(请求.幂等身份);
        加入词条退出写集(期望, *原事实.事实);
        if (*首次.首次规范化写集 != 期望
            || 原事实.事实->公开事实.规范化键 != 请求.规范化键
            || 原事实.事实->公开事实.来源.来源材料 != 请求.来源材料)
            return 词条退出失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 读回 = 读取历史词条核心(第一层服务_, 材料服务_,
            定位_, 词条定位_, 请求.词条, 首次结果.事实代次,
            首次.读取事实代次, false);
        if (读回.状态 != L2结构状态::已读取 || !读回.事实)
            return 词条退出失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        L2词条退出结果 结果{{L2结构合同版本, L2结构状态::精确重复,
            首次结果.事实代次, 首次结果.事实代次},
            std::move(读回.事实->公开事实)};
        return 结果.成功() ? 结果
            : 词条退出失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    const L1事实基座服务& 第一层服务_;
    const 不可变材料服务& 材料服务_;
    L1所有者范围写端口 第一层写入端口_;
    L1所有者范围写端口 词条写入端口_;
    L2语言结构内部::语言定位 定位_;
    L2语言结构内部::词条定位 词条定位_;
    std::mutex 写入锁_;
    std::mutex 词条写入锁_;
};

} // namespace 海中鱼巣
