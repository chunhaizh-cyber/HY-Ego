export namespace 海中鱼巣 {

inline constexpr L1所有者范围建立幂等身份 因果所有者建立身份{
    0x4C31'4F57'4E45'5236ULL};

class L2因果结构服务;

class L2因果所有者交付 final {
public:
    L2因果所有者交付() = delete;
    L2因果所有者交付(const L2因果所有者交付&) = delete;
    L2因果所有者交付& operator=(const L2因果所有者交付&) = delete;
    L2因果所有者交付(L2因果所有者交付&&) noexcept = default;
    L2因果所有者交付& operator=(L2因果所有者交付&&) = delete;
private:
    explicit L2因果所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2因果所有者交付> 尝试形成L2因果所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2因果结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2因果所有者交付> 尝试形成L2因果所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept;

}

namespace 海中鱼巣::L2因果结构内部 {

inline constexpr std::uint64_t 因果结构类型登记幂等域 = 0x22ULL;
inline constexpr std::uint32_t 条件关系类型本地键 = 0x0206'0101U;
inline constexpr std::uint32_t 动作关系类型本地键 = 0x0206'0102U;
inline constexpr std::uint32_t 结果关系类型本地键 = 0x0206'0103U;
inline constexpr std::uint32_t 来源属性类型本地键 = 0x0206'0201U;
inline constexpr std::uint32_t 因果节点本地键 = 0x0206'1001U;
inline constexpr std::uint32_t 因果族归属关系本地键 = 0x0206'1002U;
inline constexpr std::uint32_t 条件关系本地键基值 = 0x0206'2000U;
inline constexpr std::uint32_t 动作关系本地键 = 0x0206'3001U;
inline constexpr std::uint32_t 结果关系本地键基值 = 0x0206'4000U;
inline constexpr std::uint32_t 来源值本地键 = 0x0206'5001U;
inline constexpr std::int64_t 固定角色 = 1;
inline constexpr L1所有者范围写入幂等身份 因果身份来源登记幂等身份{
    0x4C32'4944'5352'4306ULL};
inline constexpr std::uint32_t 因果族锚点本地键 = 0x0206'6001U;
inline constexpr std::uint32_t 因果族归属关系类型本地键 = 0x0206'6002U;

struct 因果身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

L1所有者范围写入幂等身份 映射登记幂等键(L2结构幂等身份 身份) noexcept {
    return {(因果结构类型登记幂等域 << 56) | 身份.值};
}

// 诊断责任：向上送出；固定登记恢复只复用 L1 首次请求的原 G0。
std::uint64_t 读取固定登记期望代次(const L1事实基座服务& L1,
    L1所有者范围写端口& 端口,
    L1所有者范围写入幂等身份 幂等身份) {
    const auto 首次 = 端口.读取首次写入材料(
        {L1所有者范围首次写入读取合同版本, 幂等身份});
    if (首次.状态 == L1所有者范围读取状态::成功) {
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 端口.所有者身份()
            || 首次.写入幂等身份 != 幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果
            || 首次.首次规范化写集->写入幂等身份 != 幂等身份
            || 首次.首次规范化写集->期望事实代次 == 0
            || 首次.首次写入结果->所有者 != 端口.所有者身份()
            || 首次.首次写入结果->写入幂等身份 != 幂等身份
            || 首次.首次写入结果->事实代次 == 0)
            throw std::runtime_error(
                "L2 causal fixed registration first material invalid");
        return 首次.首次规范化写集->期望事实代次;
    }
    if (首次.状态 != L1所有者范围读取状态::未找到)
        throw std::runtime_error("L2 causal fixed registration first read failed");
    const auto 当前 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (当前.状态 != L1中性读取状态::成功 || 当前.事实代次 == 0)
        throw std::runtime_error("L2 causal fixed registration generation failed");
    return 当前.事实代次;
}

L2结构状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::内部不一致;
    case L1所有者范围写入状态::未找到: return L2结构状态::未找到;
    case L1所有者范围写入状态::已退出: return L2结构状态::已退出;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

constexpr L2结构状态 映射一致失败(L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

constexpr L2结构状态 映射历史失败(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::已退出: return L2结构状态::已退出;
    case L1所有者范围读取状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

constexpr L2结构状态 映射事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功: return L2结构状态::已读取;
    default: return L2结构状态::内部不一致;
    }
}

static_assert(映射历史失败(L1所有者范围读取状态::成功)
    == L2结构状态::已读取);
static_assert(映射历史失败(L1所有者范围读取状态::入口拒绝)
    == L2结构状态::入口拒绝);
static_assert(映射历史失败(L1所有者范围读取状态::许可拒绝)
    == L2结构状态::资源失败);
static_assert(映射历史失败(L1所有者范围读取状态::未找到)
    == L2结构状态::未找到);
static_assert(映射历史失败(L1所有者范围读取状态::已退出)
    == L2结构状态::已退出);
static_assert(映射历史失败(L1所有者范围读取状态::事实代次漂移)
    == L2结构状态::事实代次漂移);
static_assert(映射历史失败(L1所有者范围读取状态::资源失败)
    == L2结构状态::资源失败);
static_assert(映射历史失败(L1所有者范围读取状态::属性未设置)
    == L2结构状态::内部不一致);
static_assert(映射历史失败(L1所有者范围读取状态::内部不一致)
    == L2结构状态::内部不一致);

L2结构状态 解释事实代次探测(const L1中性事实代次读取结果& 探测,
    std::uint64_t 期望) noexcept {
    if (探测.状态 != L1中性读取状态::成功)
        return 映射事实代次探测失败(探测.状态);
    return 探测.事实代次 == 期望 ? L2结构状态::已读取
        : L2结构状态::事实代次漂移;
}

L2结构状态 解释发布后事实代次探测(const L1中性事实代次读取结果& 探测,
    std::uint64_t 首次写入代次) noexcept {
    if (探测.状态 != L1中性读取状态::成功)
        return 映射事实代次探测失败(探测.状态);
    return 探测.事实代次 >= 首次写入代次 ? L2结构状态::已读取
        : L2结构状态::内部不一致;
}

L2因果结构类型登记状态 映射登记写入(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2因果结构类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2因果结构类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2因果结构类型登记状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2因果结构类型登记状态::内部不一致;
    case L1所有者范围写入状态::事实代次漂移: return L2因果结构类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2因果结构类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2因果结构类型登记状态::资源失败;
    default: return L2因果结构类型登记状态::内部不一致;
    }
}

L2结构状态 登记失败转结构(L2因果结构类型登记状态 状态) noexcept {
    switch (状态) {
    case L2因果结构类型登记状态::登记未加载:
    case L2因果结构类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2因果结构类型登记状态::许可拒绝: return L2结构状态::内部不一致;
    case L2因果结构类型登记状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L2因果结构类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2因果结构类型登记状态::资源失败: return L2结构状态::资源失败;
    default: return L2结构状态::内部不一致;
    }
}

L2结构状态 映射来源值组读取失败(
    L1所有者范围来源当前值组读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围来源当前值组读取状态::入口拒绝:
        return L2结构状态::入口拒绝;
    case L1所有者范围来源当前值组读取状态::未找到:
        return L2结构状态::未找到;
    case L1所有者范围来源当前值组读取状态::已退出:
        return L2结构状态::已退出;
    case L1所有者范围来源当前值组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围来源当前值组读取状态::数量预算不足:
        return L2结构状态::数量预算不足;
    case L1所有者范围来源当前值组读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围来源当前值组读取状态::成功:
    case L1所有者范围来源当前值组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构结果头 失败头(L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {L2结构合同版本, 状态, 截止, 变更};
}

L2因果结构类型登记结果 登记失败(L2因果结构类型登记状态 状态,
    std::uint64_t 截止 = 0) noexcept { return {状态, 截止, std::nullopt}; }
L2因果写入结果 写入失败(L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {失败头(状态, 截止, 变更), std::nullopt, std::nullopt};
}
L2因果完整读取结果 完整失败(const L2因果完整读取请求& 请求,
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {失败头(状态, 截止), 请求.读取类别,
        请求.历史截止事实代次, std::nullopt, std::nullopt};
}
L2当前因果组读取结果 组失败(L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept { return {失败头(状态, 截止), {}}; }
L2因果状态引用组替换结果 组替换失败(L2结构状态 状态,
    L2因果状态引用组角色 角色, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {失败头(状态, 截止, 变更), 角色, std::nullopt, std::nullopt, {}};
}
L2因果动作引用替换结果 动作替换失败(L2结构状态 状态,
    std::uint64_t 截止 = 0, std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {失败头(状态, 截止, 变更), std::nullopt, std::nullopt, std::nullopt};
}
L2因果来源换代结果 来源换代失败(L2结构状态 状态,
    std::uint64_t 截止 = 0, std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {失败头(状态, 截止, 变更), std::nullopt, std::nullopt, std::nullopt};
}
L2因果退出结果 因果退出失败(L2结构状态 状态,
    std::uint64_t 截止 = 0, std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {失败头(状态, 截止, 变更), std::nullopt, std::nullopt};
}

struct 发布后异常代次边界 final {
    std::uint64_t 事实截止代次 = 0;
    std::optional<std::uint64_t> 变更事实代次;
};

constexpr 发布后异常代次边界 形成发布后异常代次边界(
    std::optional<std::uint64_t> 已发布首次代次) noexcept {
    return {已发布首次代次.value_or(0), 已发布首次代次};
}

static_assert(形成发布后异常代次边界(std::nullopt).事实截止代次 == 0
    && !形成发布后异常代次边界(std::nullopt).变更事实代次);
static_assert(形成发布后异常代次边界(std::uint64_t{42}).事实截止代次 == 42
    && 形成发布后异常代次边界(std::uint64_t{42}).变更事实代次 == 42);

bool 写入成功边界完整(const L1所有者范围写入结果& 写入) noexcept {
    const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    return 写入.事实代次 != 0 && (首次 || 重复);
}

std::optional<稳定编码> 查找编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

std::vector<稳定编码> 展平自有事实(const L2因果自有关系引用& 自有) {
    std::vector<稳定编码> 编码{自有.族归属关系稳定编码};
    编码.insert(编码.end(), 自有.条件关系稳定编码.begin(),
        自有.条件关系稳定编码.end());
    if (自有.动作关系稳定编码) 编码.push_back(*自有.动作关系稳定编码);
    编码.insert(编码.end(), 自有.结果关系稳定编码.begin(),
        自有.结果关系稳定编码.end());
    编码.push_back(自有.来源值稳定编码);
    std::sort(编码.begin(), 编码.end());
    return 编码;
}

bool 非成功写入边界完整(const L1所有者范围写入结果& 写入) noexcept {
    return 写入.新编码映射.empty() && !写入.是否形成内存权威发布;
}

struct 一致顶层 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

一致顶层 解释一致顶层(const L1所有者范围一致当前读取结果& 读取,
    std::uint64_t 期望) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        return 读取.合同版本 == L1所有者范围一致当前读取合同版本
                && 读取.期望事实代次 == 期望 && 读取.读取事实代次 == 期望
            ? 一致顶层{L2结构状态::已读取, 读取.读取事实代次}
            : 一致顶层{L2结构状态::内部不一致, 读取.读取事实代次};
    }
    return {映射一致失败(读取.状态), 读取.读取事实代次};
}

const L1所有者范围一致节点读取结果项* 找节点(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    for (const auto& 项 : 读取.节点) if (项.查询编码 == 编码) return &项;
    return nullptr;
}
const L1所有者范围一致源关系组读取结果项* 找源组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 源,
    稳定编码 类型) noexcept {
    for (const auto& 项 : 读取.源关系组)
        if (项.源节点 == 源 && 项.关系类型节点 == 类型) return &项;
    return nullptr;
}
const L1所有者范围一致目标关系组读取结果项* 找目标组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 目标,
    稳定编码 类型) noexcept {
    for (const auto& 项 : 读取.目标关系组)
        if (项.目标节点 == 目标 && 项.关系类型节点 == 类型) return &项;
    return nullptr;
}
const L1所有者范围一致属性值读取结果项* 找属性(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 节点,
    稳定编码 类型) noexcept {
    for (const auto& 项 : 读取.属性值)
        if (项.节点 == 节点 && 项.属性类型 == 类型) return &项;
    return nullptr;
}

bool 普通节点有效(const L1所有者范围节点事实& 节点,
    稳定编码 编码, std::uint64_t 截止) noexcept {
    return 节点.编码 == 编码 && 节点.种类 == 节点种类::普通
        && !节点.属性类型表示 && 节点.创建事实代次 <= 截止
        && !节点.退出事实代次;
}

因果身份来源定位 初始化身份来源(const L1事实基座服务& L1,
    L1所有者范围写端口& 端口) {
    const auto 所有者 = 端口.所有者身份();
    const auto 所有者读 = L1.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读.状态 != L1所有者范围读取状态::成功
        || !所有者读.所有者事实 || 所有者读.所有者事实->退出事实代次)
        throw std::runtime_error("L2 causal owner invalid");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读.所有者事实->创建事实代次;
    写集.写入幂等身份 = 因果身份来源登记幂等身份;
    写集.节点 = {{{因果族锚点本地键}, 节点种类::普通, std::nullopt},
        {{因果族归属关系类型本地键}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 端口.提交所有者范围中性写集(写集);
    if ((写入.状态 != L1所有者范围写入状态::成功
            && 写入.状态 != L1所有者范围写入状态::精确重复)
        || 写入.新编码映射.size() != 2 || 写入.事实代次 == 0)
        throw std::runtime_error("L2 causal source initialization failed");
    稳定编码 锚点, 类型;
    for (const auto& [键, 编码] : 写入.新编码映射) {
        if (键.值 == 因果族锚点本地键) 锚点 = 编码;
        else if (键.值 == 因果族归属关系类型本地键) 类型 = 编码;
    }
    if (!有效(锚点) || !有效(类型) || 锚点 == 类型)
        throw std::runtime_error("L2 causal source mapping invalid");
    return {所有者, 锚点, 类型, 写入.事实代次};
}

} // namespace 海中鱼巣::L2因果结构内部

export namespace 海中鱼巣 {

std::optional<L2因果所有者交付> 尝试形成L2因果所有者交付(
    const L1事实基座服务& L1, L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        if ((建立.状态 != L1所有者范围管理状态::成功
                && 建立.状态 != L1所有者范围管理状态::精确重复)
            || 建立.建立幂等身份 != 因果所有者建立身份
            || !建立.所有者事实 || !原始交付.写入端口
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(L1)
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者)
            return std::nullopt;
        return L2因果所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) { return std::nullopt; }
}

class L2因果结构服务 final {
public:
    explicit L2因果结构服务(const L1事实基座服务& L1,
        const L2状态结构服务& 状态服务, L2因果所有者交付&& 交付)
        : L1_(L1), 状态服务_(状态服务), 第一层写入端口_(验证并移动交付(L1, 交付)),
          因果身份来源定位_(L2因果结构内部::初始化身份来源(L1_, 第一层写入端口_)) {
        const auto 登记幂等身份 = L2因果结构内部::映射登记幂等键({1});
        const auto 固定登记代次 = L2因果结构内部::读取固定登记期望代次(
            L1_, 第一层写入端口_, 登记幂等身份);
        if (!建立因果结构类型登记({{L2结构合同版本, 固定登记代次},
                L2因果结构类型登记规则版本, {1}}).成功())
            throw std::runtime_error("L2 causal registration failed");
    }
    L2因果结构服务(const L2因果结构服务&) = delete;
    L2因果结构服务& operator=(const L2因果结构服务&) = delete;

    L2因果结构类型登记结果 建立因果结构类型登记(
        const L2因果结构类型登记请求& 请求) {
        using namespace L2因果结构内部;
        try {
            if (!L2因果结构类型登记请求有效(请求)) return 登记失败(
                L2因果结构类型登记状态::入口拒绝);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 映射登记幂等键(请求.幂等身份);
            写集.节点 = {{{条件关系类型本地键}, 节点种类::普通, std::nullopt},
                {{动作关系类型本地键}, 节点种类::普通, std::nullopt},
                {{结果关系类型本地键}, 节点种类::普通, std::nullopt},
                {{来源属性类型本地键}, 节点种类::属性类型,
                    L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射登记写入(写入.状态);
            if (状态 != L2因果结构类型登记状态::已提交
                && 状态 != L2因果结构类型登记状态::精确重复)
                return 登记失败(状态, 写入.事实代次);
            L2因果结构类型登记 登记;
            登记.首次期望事实代次 = 请求.请求头.期望事实代次;
            登记.建立事实代次 = 写入.事实代次;
            登记.事实截止代次 = 写入.事实代次;
            for (const auto& [键, 编码] : 写入.新编码映射) {
                if (键.值 == 条件关系类型本地键) 登记.条件关系类型 = L2因果条件关系类型身份{编码};
                else if (键.值 == 动作关系类型本地键) 登记.动作关系类型 = L2因果动作关系类型身份{编码};
                else if (键.值 == 结果关系类型本地键) 登记.结果关系类型 = L2因果结果关系类型身份{编码};
                else if (键.值 == 来源属性类型本地键) 登记.来源属性类型 = L2因果来源属性类型身份{编码};
            }
            if (!L2因果结构类型登记完整(登记))
                return 登记失败(L2因果结构类型登记状态::内部不一致, 写入.事实代次);
            结构类型登记定位_ = 登记;
            return {状态, 写入.事实代次, 登记};
        } catch (const std::bad_alloc&) { return 登记失败(L2因果结构类型登记状态::资源失败); }
        catch (...) { return 登记失败(L2因果结构类型登记状态::内部不一致); }
    }

    L2因果结构类型登记结果 读取当前因果结构类型登记() const {
        using namespace L2因果结构内部;
        try {
            if (!结构类型登记定位_) return 登记失败(L2因果结构类型登记状态::登记未加载);
            if (!L2因果结构类型登记完整(*结构类型登记定位_))
                return 登记失败(L2因果结构类型登记状态::内部不一致);
            std::uint64_t 期望 = 结构类型登记定位_->事实截止代次;
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const 稳定编码 编码[] = {结构类型登记定位_->条件关系类型.值,
                    结构类型登记定位_->动作关系类型.值,
                    结构类型登记定位_->结果关系类型.值,
                    结构类型登记定位_->来源属性类型.值};
                L1所有者范围一致当前读取请求 请求;
                请求.合同版本 = L1所有者范围一致当前读取合同版本;
                请求.期望事实代次 = 期望;
                请求.所有者 = {因果身份来源定位_.所有者};
                请求.节点.assign(std::begin(编码), std::end(编码));
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
                const auto 顶层 = 解释一致顶层(读取, 期望);
                if (!顶层.成功()) {
                    if (顶层.状态 == L2结构状态::事实代次漂移 && 尝试 == 0) {
                        期望 = 顶层.截止; continue;
                    }
                    return 登记失败(顶层.状态 == L2结构状态::许可拒绝
                        ? L2因果结构类型登记状态::内部不一致
                        : 顶层.状态 == L2结构状态::事实代次漂移
                            ? L2因果结构类型登记状态::事实代次漂移
                        : 顶层.状态 == L2结构状态::资源失败
                            ? L2因果结构类型登记状态::资源失败
                            : L2因果结构类型登记状态::内部不一致, 顶层.截止);
                }
                for (std::size_t i = 0; i < std::size(编码); ++i) {
                    const auto* 项 = 找节点(读取, 编码[i]);
                    const bool 来源类型 = i == 3;
                    if (!项 || !项->事实
                        || 项->事实->写入所有者 != 因果身份来源定位_.所有者
                        || 项->事实->种类 != (来源类型 ? 节点种类::属性类型 : 节点种类::普通)
                        || 项->事实->属性类型表示 != (来源类型
                            ? std::optional<L1所有者范围值表示种类>{L1所有者范围值表示种类::独立材料引用}
                            : std::nullopt)
                        || 项->事实->创建事实代次 != 结构类型登记定位_->建立事实代次
                        || 项->事实->退出事实代次)
                        return 登记失败(L2因果结构类型登记状态::内部不一致, 顶层.截止);
                }
                auto 登记 = *结构类型登记定位_;
                登记.事实截止代次 = 顶层.截止;
                return {L2因果结构类型登记状态::已读取, 顶层.截止, 登记};
            }
            return 登记失败(L2因果结构类型登记状态::事实代次漂移, 期望);
        } catch (const std::bad_alloc&) { return 登记失败(L2因果结构类型登记状态::资源失败); }
        catch (...) { return 登记失败(L2因果结构类型登记状态::内部不一致); }
    }

    L2因果身份来源读取结果 读取因果身份来源(
        const L2因果身份来源读取请求& 请求) const {
        using namespace L2因果结构内部;
        if (!L2因果身份来源读取请求有效(请求)) return {};
        try {
            if (请求.读取类别 == L2读取类别::历史) {
                const auto 当前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
                if (当前.状态 != L1中性读取状态::成功
                    || 当前.事实代次 != 请求.请求头.期望事实代次)
                    return {失败头(当前.状态 == L1中性读取状态::成功
                            ? L2结构状态::事实代次漂移
                            : 映射事实代次探测失败(当前.状态), 当前.事实代次),
                        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
                const auto 节点读 = L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 请求.因果.值});
                const auto* 节点 = 节点读.事实
                    ? std::get_if<L1所有者范围节点事实>(&*节点读.事实) : nullptr;
                if (节点读.状态 != L1所有者范围读取状态::成功)
                    return {失败头(映射历史失败(节点读.状态), 请求.历史截止事实代次),
                        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
                if (!节点 || 节点读.读取事实代次 != 请求.请求头.期望事实代次)
                    return {失败头(L2结构状态::内部不一致,
                            请求.历史截止事实代次), 请求.读取类别,
                        请求.历史截止事实代次, std::nullopt};
                const std::uint64_t 关系截止 = 节点->退出事实代次
                        && *节点->退出事实代次 <= 请求.历史截止事实代次
                    ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
                const auto 关系组 = L1_.读取所有者范围历史关系组({
                    L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                    请求.因果.值, 因果身份来源定位_.族归属关系类型,
                    关系截止});
                const auto 所有者读 = L1_.读取历史结构所有者(
                    {L1所有者范围CRUD合同版本, 因果身份来源定位_.所有者});
                const auto 锚点读 = L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 因果身份来源定位_.族锚点});
                const auto 类型读 = L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 因果身份来源定位_.族归属关系类型});
                const auto* 锚点 = 锚点读.事实 ? std::get_if<L1所有者范围节点事实>(&*锚点读.事实) : nullptr;
                const auto* 类型 = 类型读.事实 ? std::get_if<L1所有者范围节点事实>(&*类型读.事实) : nullptr;
                for (const auto [状态, 读取代次] : {
                        std::pair{关系组.状态, 关系组.读取事实代次},
                        std::pair{所有者读.状态, 所有者读.读取事实代次},
                        std::pair{锚点读.状态, 锚点读.读取事实代次},
                        std::pair{类型读.状态, 类型读.读取事实代次}}) {
                    if (状态 != L1所有者范围读取状态::成功)
                        return {失败头(映射历史失败(状态),
                                请求.历史截止事实代次), 请求.读取类别,
                            请求.历史截止事实代次, std::nullopt};
                    if (读取代次 != 请求.请求头.期望事实代次)
                        return {失败头(L2结构状态::内部不一致,
                                请求.历史截止事实代次), 请求.读取类别,
                            请求.历史截止事实代次, std::nullopt};
                }
                if (!所有者读.所有者事实 || !锚点 || !类型
                    || 关系组.关系组.size() != 1)
                    return {失败头(关系组.关系组.empty()
                            ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                        请求.历史截止事实代次), 请求.读取类别,
                        请求.历史截止事实代次, std::nullopt};
                const auto& 关系 = 关系组.关系组.front();
                if (节点->写入所有者 != 因果身份来源定位_.所有者
                    || 节点->种类 != 节点种类::普通 || 节点->属性类型表示)
                    return {失败头(L2结构状态::入口拒绝,
                        请求.历史截止事实代次), 请求.读取类别,
                        请求.历史截止事实代次, std::nullopt};
                if (锚点->编码 != 因果身份来源定位_.族锚点
                    || 类型->编码 != 因果身份来源定位_.族归属关系类型
                    || 锚点->写入所有者 != 因果身份来源定位_.所有者
                    || 类型->写入所有者 != 因果身份来源定位_.所有者
                    || 关系.写入所有者 != 因果身份来源定位_.所有者
                    || 关系.源节点 != 请求.因果.值
                    || 关系.目标节点 != 因果身份来源定位_.族锚点
                    || 关系.关系类型节点 != 因果身份来源定位_.族归属关系类型
                    || 关系.角色或顺序 != 固定角色
                    || 关系.创建事实代次 != 节点->创建事实代次)
                    return {失败头(L2结构状态::内部不一致, 请求.历史截止事实代次),
                        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
                const auto 投影生命周期 = [&](std::uint64_t 创建,
                    std::optional<std::uint64_t> 退出) noexcept {
                    if (退出 && *退出 > 请求.历史截止事实代次) 退出.reset();
                    return L2生命周期{创建, 退出};
                };
                L2节点族身份来源事实 来源{L2节点族::因果, 节点->编码,
                    因果身份来源定位_.所有者, 锚点->编码, 类型->编码, 关系.编码,
                    关系.角色或顺序,
                    投影生命周期(所有者读.所有者事实->创建事实代次,
                        所有者读.所有者事实->退出事实代次),
                    投影生命周期(节点->创建事实代次, 节点->退出事实代次),
                    投影生命周期(锚点->创建事实代次, 锚点->退出事实代次),
                    投影生命周期(类型->创建事实代次, 类型->退出事实代次),
                    投影生命周期(关系.创建事实代次, 关系.退出事实代次)};
                const auto 最终 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
                if (最终.状态 != L1中性读取状态::成功
                    || 最终.事实代次 != 请求.请求头.期望事实代次)
                    return {失败头(最终.状态 == L1中性读取状态::成功
                            ? L2结构状态::事实代次漂移
                            : 映射事实代次探测失败(最终.状态), 最终.事实代次),
                        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
                L2因果身份来源读取结果 结果{
                    失败头(L2结构状态::已读取, 请求.历史截止事实代次),
                    请求.读取类别, 请求.历史截止事实代次, std::move(来源)};
                return 结果.成功() ? 结果 : L2因果身份来源读取结果{
                    失败头(L2结构状态::内部不一致, 请求.历史截止事实代次),
                    请求.读取类别, 请求.历史截止事实代次, std::nullopt};
            }
            L1所有者范围一致当前读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.所有者 = {因果身份来源定位_.所有者};
            L1请求.节点 = {请求.因果.值, 因果身份来源定位_.族锚点,
                因果身份来源定位_.族归属关系类型};
            L1请求.源关系组 = {{请求.因果.值, 因果身份来源定位_.族归属关系类型}};
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
            const auto 顶层 = 解释一致顶层(读取, 请求.请求头.期望事实代次);
            if (!顶层.成功()) return {失败头(顶层.状态, 顶层.截止),
                请求.读取类别, 0, std::nullopt};
            const auto* 节点项 = 找节点(读取, 请求.因果.值);
            const auto* 锚点项 = 找节点(读取, 因果身份来源定位_.族锚点);
            const auto* 类型项 = 找节点(读取, 因果身份来源定位_.族归属关系类型);
            const auto* 关系组 = 找源组(读取, 请求.因果.值, 因果身份来源定位_.族归属关系类型);
            if (!节点项 || !锚点项 || !类型项 || !关系组)
                return {失败头(L2结构状态::内部不一致, 顶层.截止),
                    请求.读取类别, 0, std::nullopt};
            if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功)
                return {失败头(节点项->状态
                            == L1所有者范围一致当前读取项目状态::未找到
                        ? L2结构状态::未找到
                        : 节点项->状态
                            == L1所有者范围一致当前读取项目状态::已退出
                            ? L2结构状态::已退出 : L2结构状态::入口拒绝,
                    顶层.截止), 请求.读取类别, 0, std::nullopt};
            if (!节点项->事实 || !锚点项->事实 || !类型项->事实
                || 关系组->成员.size() != 1 || 读取.所有者.size() != 1
                || !读取.所有者.front().所有者事实)
                return {失败头(关系组->成员.empty() ? L2结构状态::入口拒绝
                    : L2结构状态::内部不一致, 顶层.截止),
                    请求.读取类别, 0, std::nullopt};
            const auto& 节点 = *节点项->事实;
            const auto& 锚点 = *锚点项->事实;
            const auto& 类型 = *类型项->事实;
            const auto& 关系 = 关系组->成员.front().关系;
            if (节点.写入所有者 != 因果身份来源定位_.所有者
                || 节点.种类 != 节点种类::普通 || 节点.属性类型表示)
                return {失败头(L2结构状态::入口拒绝, 顶层.截止),
                    请求.读取类别, 0, std::nullopt};
            if (节点.退出事实代次 || 锚点.编码 != 因果身份来源定位_.族锚点
                || 类型.编码 != 因果身份来源定位_.族归属关系类型
                || 锚点.写入所有者 != 因果身份来源定位_.所有者
                || 类型.写入所有者 != 因果身份来源定位_.所有者
                || 关系.写入所有者 != 因果身份来源定位_.所有者
                || 关系.源节点 != 请求.因果.值
                || 关系.目标节点 != 锚点.编码 || 关系.关系类型节点 != 类型.编码
                || 关系.角色或顺序 != 固定角色 || 关系.退出事实代次
                || 关系.创建事实代次 != 节点.创建事实代次)
                return {失败头(L2结构状态::内部不一致, 顶层.截止),
                    请求.读取类别, 0, std::nullopt};
            const auto& 所有者 = *读取.所有者.front().所有者事实;
            L2节点族身份来源事实 来源{L2节点族::因果, 节点.编码,
                因果身份来源定位_.所有者, 锚点.编码, 类型.编码, 关系.编码,
                关系.角色或顺序, {所有者.创建事实代次, 所有者.退出事实代次},
                {节点.创建事实代次, 节点.退出事实代次},
                {锚点.创建事实代次, 锚点.退出事实代次},
                {类型.创建事实代次, 类型.退出事实代次},
                {关系.创建事实代次, 关系.退出事实代次}};
            L2因果身份来源读取结果 结果{失败头(L2结构状态::已读取, 顶层.截止),
                请求.读取类别, 0, std::move(来源)};
            return 结果.成功() ? 结果 : L2因果身份来源读取结果{
                失败头(L2结构状态::内部不一致, 顶层.截止),
                请求.读取类别, 0, std::nullopt};
        } catch (const std::bad_alloc&) { return {失败头(L2结构状态::资源失败),
            请求.读取类别, 请求.历史截止事实代次, std::nullopt}; }
        catch (...) { return {失败头(L2结构状态::内部不一致),
            请求.读取类别, 请求.历史截止事实代次, std::nullopt}; }
    }

    L2因果写入结果 新增因果(const L2因果新增请求& 请求) {
        using namespace L2因果结构内部;
        if (!L2因果新增请求有效(请求)) return 写入失败(L2结构状态::入口拒绝);
        try {
            const auto 登记读 = 读取当前因果结构类型登记();
            if (!登记读.成功() || !登记读.登记)
                return 写入失败(登记失败转结构(登记读.状态), 登记读.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.节点 = {{{因果节点本地键}, 节点种类::普通, std::nullopt}};
            写集.关系.push_back({{因果族归属关系本地键}, L1所有者范围写集本地键{因果节点本地键},
                因果身份来源定位_.族锚点, 因果身份来源定位_.族归属关系类型, 固定角色});
            for (std::size_t i = 0; i < 请求.条件状态.size(); ++i)
                写集.关系.push_back({{条件关系本地键基值 + static_cast<std::uint32_t>(i + 1)},
                    L1所有者范围写集本地键{因果节点本地键}, 请求.条件状态[i].目标,
                    登记读.登记->条件关系类型.值,
                    static_cast<std::int64_t>(请求.条件状态[i].顺序)});
            if (请求.动作) 写集.关系.push_back({{动作关系本地键}, L1所有者范围写集本地键{因果节点本地键},
                *请求.动作, 登记读.登记->动作关系类型.值, 固定角色});
            for (std::size_t i = 0; i < 请求.结果状态.size(); ++i)
                写集.关系.push_back({{结果关系本地键基值 + static_cast<std::uint32_t>(i + 1)},
                    L1所有者范围写集本地键{因果节点本地键}, 请求.结果状态[i].目标,
                    登记读.登记->结果关系类型.值,
                    static_cast<std::int64_t>(请求.结果状态[i].顺序)});
            写集.值 = {{{来源值本地键}, L1所有者范围写集本地键{因果节点本地键},
                登记读.登记->来源属性类型.值,
                L1所有者范围独立材料引用{请求.来源稳定编码}, 请求.来源稳定编码}};
            写集.属性槽变更 = {{L1所有者范围写集本地键{因果节点本地键}, 登记读.登记->来源属性类型.值,
                {来源值本地键}}};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功)
                return 写入失败(映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                for (const auto& 项 : 请求.条件状态) {
                    const auto 来源 = 状态服务_.读取状态身份来源({请求.请求头,
                        L2读取类别::当前, L2状态身份{项.目标}, 0});
                    if (!来源.成功()) return 写入失败(来源.结果头.状态, 来源.结果头.事实截止代次);
                }
                for (const auto& 项 : 请求.结果状态) {
                    const auto 来源 = 状态服务_.读取状态身份来源({请求.请求头,
                        L2读取类别::当前, L2状态身份{项.目标}, 0});
                    if (!来源.成功()) return 写入失败(来源.结果头.状态, 来源.结果头.事实截止代次);
                }
                std::vector<稳定编码> 普通节点{请求.来源稳定编码};
                if (请求.动作) 普通节点.push_back(*请求.动作);
                L1所有者范围一致当前读取请求 节点请求;
                节点请求.合同版本 = L1所有者范围一致当前读取合同版本;
                节点请求.期望事实代次 = 请求.请求头.期望事实代次;
                节点请求.节点 = 普通节点;
                const auto 节点读 = L1_.尝试读取所有者范围一致当前投影(节点请求);
                const auto 顶层 = 解释一致顶层(节点读, 请求.请求头.期望事实代次);
                if (!顶层.成功()) return 写入失败(顶层.状态, 顶层.截止);
                for (auto 编码 : 普通节点) {
                    const auto* 项 = 找节点(节点读, 编码);
                    if (!项 || !项->事实 || !普通节点有效(*项->事实, 编码, 顶层.截止))
                        return 写入失败(项 && 项->状态 == L1所有者范围一致当前读取项目状态::已退出
                            ? L2结构状态::已退出 : L2结构状态::未找到, 顶层.截止);
                }
            }
            return 提交并读回(写集, 请求);
        } catch (const std::bad_alloc&) { return 写入失败(L2结构状态::资源失败); }
        catch (...) { return 写入失败(L2结构状态::内部不一致); }
    }

    L2因果完整读取结果 读取完整因果(const L2因果完整读取请求& 请求) const {
        if (!L2因果完整读取请求有效(请求)) return {};
        try {
            return 请求.读取类别 == L2读取类别::当前
                ? 读取当前完整(请求) : 读取历史完整(请求);
        } catch (const std::bad_alloc&) { return L2因果结构内部::完整失败(
            请求, L2结构状态::资源失败); }
        catch (...) { return L2因果结构内部::完整失败(请求, L2结构状态::内部不一致); }
    }

    L2当前因果组读取结果 按条件状态读取全部当前因果(
        const L2按条件状态当前因果读取请求& 请求) const {
        if (!L2按条件状态当前因果读取请求有效(请求)) return {};
        const auto 来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, 请求.条件状态, 0});
        if (!来源.成功()) return L2因果结构内部::组失败(来源.结果头.状态,
            来源.结果头.事实截止代次);
        return 按端点读取(请求.请求头, 请求.条件状态.值,
            端点角色::条件, 请求.最大数量);
    }
    L2当前因果组读取结果 按动作读取全部当前因果(
        const L2按动作当前因果读取请求& 请求) const {
        if (!L2按动作当前因果读取请求有效(请求)) return {};
        L1所有者范围一致当前读取请求 节点请求;
        节点请求.合同版本 = L1所有者范围一致当前读取合同版本;
        节点请求.期望事实代次 = 请求.请求头.期望事实代次;
        节点请求.节点 = {请求.动作};
        const auto 读 = L1_.尝试读取所有者范围一致当前投影(节点请求);
        const auto 顶层 = L2因果结构内部::解释一致顶层(读, 请求.请求头.期望事实代次);
        const auto* 项 = L2因果结构内部::找节点(读, 请求.动作);
        if (!顶层.成功() || !项 || !项->事实
            || !L2因果结构内部::普通节点有效(*项->事实, 请求.动作, 顶层.截止))
            return L2因果结构内部::组失败(顶层.成功() ? L2结构状态::未找到
                : 顶层.状态, 顶层.截止);
        return 按端点读取(请求.请求头, 请求.动作,
            端点角色::动作, 请求.最大数量);
    }
    L2当前因果组读取结果 按结果状态读取全部当前因果(
        const L2按结果状态当前因果读取请求& 请求) const {
        if (!L2按结果状态当前因果读取请求有效(请求)) return {};
        const auto 来源 = 状态服务_.读取状态身份来源({请求.请求头,
            L2读取类别::当前, 请求.结果状态, 0});
        if (!来源.成功()) return L2因果结构内部::组失败(来源.结果头.状态,
            来源.结果头.事实截止代次);
        return 按端点读取(请求.请求头, 请求.结果状态.值,
            端点角色::结果, 请求.最大数量);
    }

    L2当前因果组读取结果 按来源读取全部当前因果(
        const L2按来源当前因果读取请求& 请求) const {
        using namespace L2因果结构内部;
        if (!L2按来源当前因果读取请求有效(请求))
            return 组失败(L2结构状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前因果结构类型登记();
            if (登记结果.状态 != L2因果结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return 组失败(登记失败转结构(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            constexpr auto 最大整数 = (std::numeric_limits<std::uint64_t>::max)();
            const auto 第一层预算 = 请求.最大数量 == 最大整数
                ? 最大整数 : 请求.最大数量 + 1;
            const auto 读取 = L1_.按来源读取所有者范围全部当前值({
                L1所有者范围来源当前值组读取合同版本,
                因果身份来源定位_.所有者, 请求.来源稳定编码,
                请求.请求头.期望事实代次, 第一层预算});
            if (读取.合同版本 != L1所有者范围来源当前值组读取合同版本
                || 读取.所有者 != 因果身份来源定位_.所有者
                || 读取.来源节点 != 请求.来源稳定编码
                || 读取.期望事实代次 != 请求.请求头.期望事实代次)
                return 组失败(L2结构状态::内部不一致, 读取.读取事实代次);
            if (读取.状态 != L1所有者范围来源当前值组读取状态::成功) {
                if (!读取.当前值.empty())
                    return 组失败(L2结构状态::内部不一致, 读取.读取事实代次);
                return 组失败(映射来源值组读取失败(读取.状态),
                    读取.读取事实代次);
            }
            if (读取.读取事实代次 != 请求.请求头.期望事实代次
                || 读取.读取事实代次 == 0
                || 读取.当前值.size() > 第一层预算)
                return 组失败(L2结构状态::内部不一致, 读取.读取事实代次);

            std::vector<稳定编码> 因果编码组;
            因果编码组.reserve(读取.当前值.size());
            for (const auto& 值 : 读取.当前值) {
                const auto* 材料 = std::get_if<L1所有者范围独立材料引用>(
                    &值.材料);
                if (!有效(值.编码) || !有效(值.所属节点)
                    || 值.属性类型节点 != 登记.来源属性类型.值
                    || 值.来源节点 != 请求.来源稳定编码
                    || 值.写入所有者 != 因果身份来源定位_.所有者
                    || 值.创建事实代次 == 0
                    || 值.创建事实代次 > 读取.读取事实代次
                    || 值.退出事实代次 || !材料
                    || 材料->编码 != 请求.来源稳定编码)
                    return 组失败(L2结构状态::内部不一致,
                        读取.读取事实代次);
                因果编码组.push_back(值.所属节点);
            }
            std::sort(因果编码组.begin(), 因果编码组.end());
            if (std::adjacent_find(因果编码组.begin(), 因果编码组.end())
                    != 因果编码组.end())
                return 组失败(L2结构状态::内部不一致, 读取.读取事实代次);

            L2当前因果组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 读取.读取事实代次, std::nullopt}, {}};
            结果.因果.reserve(因果编码组.size());
            for (const auto 编码 : 因果编码组) {
                const auto 单项 = 读取完整因果({请求.请求头,
                    L2读取类别::当前, L2因果身份{编码}, 0});
                if (单项.结果头.状态 != L2结构状态::已读取
                    || !单项.因果
                    || 单项.结果头.事实截止代次 != 读取.读取事实代次) {
                    const auto 状态 = 单项.结果头.状态
                            == L2结构状态::事实代次漂移
                        || 单项.结果头.状态 == L2结构状态::资源失败
                        ? 单项.结果头.状态 : L2结构状态::内部不一致;
                    return 组失败(状态, 单项.结果头.事实截止代次);
                }
                if (单项.因果->身份 != L2因果身份{编码}
                    || 单项.因果->来源稳定编码 != 请求.来源稳定编码
                    || 单项.因果->生命周期.退出事实代次
                    || !L2因果事实完整(*单项.因果, 读取.读取事实代次))
                    return 组失败(L2结构状态::内部不一致,
                        读取.读取事实代次);
                结果.因果.push_back(*单项.因果);
            }
            if (结果.因果.size() > 请求.最大数量)
                return 组失败(L2结构状态::数量预算不足,
                    读取.读取事实代次);
            return 结果.成功() ? 结果
                : 组失败(L2结构状态::内部不一致, 读取.读取事实代次);
        } catch (const std::bad_alloc&) {
            return 组失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 组失败(L2结构状态::资源失败);
        } catch (...) {
            return 组失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；条件或结果整组在一份 owner 写集中原子替换。
    L2因果状态引用组替换结果 替换因果状态引用组(
        const L2因果状态引用组替换请求& 请求) {
        using namespace L2因果结构内部;
        if (!L2因果状态引用组替换请求有效(请求))
            return 组替换失败(L2结构状态::入口拒绝, 请求.角色);
        std::optional<std::uint64_t> 已发布首次代次;
        try {
            const auto 登记读 = 读取当前因果结构类型登记();
            if (!登记读.成功() || !登记读.登记) return 组替换失败(
                登记失败转结构(登记读.状态), 请求.角色, 登记读.事实截止代次);
            const bool 条件 = 请求.角色 == L2因果状态引用组角色::条件;
            const auto 类型 = 条件 ? 登记读.登记->条件关系类型.值
                : 登记读.登记->结果关系类型.值;
            const auto 基值 = 条件 ? 条件关系本地键基值 : 结果关系本地键基值;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            for (std::size_t 索引 = 0; 索引 < 请求.新状态引用组.size(); ++索引)
                写集.关系.push_back({{基值 + static_cast<std::uint32_t>(索引 + 1)},
                    请求.因果.值, 请求.新状态引用组[索引].目标, 类型,
                    static_cast<std::int64_t>(请求.新状态引用组[索引].顺序)});
            写集.退出事实 = 请求.旧关系闭包;
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
                return 组替换失败(映射事实代次探测失败(代次.状态), 请求.角色,
                    代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整因果({请求.请求头, L2读取类别::当前,
                    请求.因果, 0});
                if (当前.结果头.状态 != L2结构状态::已读取 || !当前.因果
                    || !当前.自有事实) return 组替换失败(当前.结果头.状态,
                        请求.角色, 当前.结果头.事实截止代次);
                auto 当前闭包 = 条件 ? 当前.自有事实->条件关系稳定编码
                    : 当前.自有事实->结果关系稳定编码;
                std::sort(当前闭包.begin(), 当前闭包.end());
                const auto& 当前组 = 条件 ? 当前.因果->条件状态 : 当前.因果->结果状态;
                if (当前闭包 != 请求.旧关系闭包 || 当前组 == 请求.新状态引用组)
                    return 组替换失败(L2结构状态::引用冲突, 请求.角色, 代次.事实代次);
                for (const auto& 引用 : 请求.新状态引用组) {
                    const auto 来源 = 状态服务_.读取状态身份来源({请求.请求头,
                        L2读取类别::当前, L2状态身份{引用.目标}, 0});
                    if (!来源.成功()) return 组替换失败(来源.结果头.状态,
                        请求.角色, 来源.结果头.事实截止代次);
                }
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 非成功写入边界完整(写入)
                    ? 组替换失败(状态, 请求.角色, 写入.事实代次)
                    : 组替换失败(L2结构状态::内部不一致, 请求.角色, 写入.事实代次);
            if (!写入成功边界完整(写入))
                return 组替换失败(L2结构状态::内部不一致, 请求.角色,
                    写入.事实代次, 写入.事实代次);
            已发布首次代次 = 写入.事实代次;
            if (写入.新编码映射.size() != 请求.新状态引用组.size())
                return 组替换失败(L2结构状态::内部不一致, 请求.角色,
                    *已发布首次代次, 已发布首次代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            const auto 探测状态 = 解释发布后事实代次探测(当前代次, 写入.事实代次);
            if (探测状态 != L2结构状态::已读取)
                return 组替换失败(探测状态, 请求.角色,
                    写入.事实代次, 写入.事实代次);
            const auto 首次 = 读取完整因果({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.因果, 写入.事实代次});
            if (首次.结果头.状态 != L2结构状态::已读取)
                return 组替换失败(首次.结果头.状态, 请求.角色,
                    写入.事实代次, 写入.事实代次);
            const auto& 首次组 = 首次.因果
                ? (条件 ? 首次.因果->条件状态 : 首次.因果->结果状态)
                : 请求.新状态引用组;
            if (!首次.因果 || !首次.自有事实 || 首次组 != 请求.新状态引用组)
                return 组替换失败(L2结构状态::内部不一致, 请求.角色,
                    写入.事实代次, 写入.事实代次);
            for (auto 编码 : 请求.旧关系闭包) {
                const auto 旧读 = L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 编码});
                if (旧读.状态 != L1所有者范围读取状态::成功)
                    return 组替换失败(映射历史失败(旧读.状态), 请求.角色,
                        写入.事实代次, 写入.事实代次);
                const auto* 旧 = 旧读.事实
                    ? std::get_if<L1所有者范围关系事实>(&*旧读.事实) : nullptr;
                if (!旧 || 旧->退出事实代次 != 写入.事实代次)
                    return 组替换失败(L2结构状态::内部不一致, 请求.角色,
                        写入.事实代次, 写入.事实代次);
            }
            L2因果状态引用组替换结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, 请求.角色, *首次.因果,
                *首次.自有事实, 请求.旧关系闭包};
            return 结果.成功() ? 结果 : 组替换失败(L2结构状态::内部不一致,
                请求.角色, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 组替换失败(
                L2结构状态::资源失败, 请求.角色, 边界.事实截止代次,
                边界.变更事实代次); }
        catch (const std::length_error&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 组替换失败(
                L2结构状态::资源失败, 请求.角色, 边界.事实截止代次,
                边界.变更事实代次); }
        catch (...) { const auto 边界 = 形成发布后异常代次边界(已发布首次代次);
            return 组替换失败(L2结构状态::内部不一致, 请求.角色,
                边界.事实截止代次, 边界.变更事实代次); }
    }

    // 诊断责任：向上送出；可空动作关系以一份写集原子替换。
    L2因果动作引用替换结果 替换因果动作引用(
        const L2因果动作引用替换请求& 请求) {
        using namespace L2因果结构内部;
        if (!L2因果动作引用替换请求有效(请求))
            return 动作替换失败(L2结构状态::入口拒绝);
        std::optional<std::uint64_t> 已发布首次代次;
        try {
            const auto 登记读 = 读取当前因果结构类型登记();
            if (!登记读.成功() || !登记读.登记) return 动作替换失败(
                登记失败转结构(登记读.状态), 登记读.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            if (请求.新动作) 写集.关系 = {{{动作关系本地键}, 请求.因果.值,
                *请求.新动作, 登记读.登记->动作关系类型.值, 固定角色}};
            if (请求.旧动作关系) 写集.退出事实 = {*请求.旧动作关系};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
                return 动作替换失败(映射事实代次探测失败(代次.状态), 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整因果({请求.请求头, L2读取类别::当前,
                    请求.因果, 0});
                if (当前.结果头.状态 != L2结构状态::已读取 || !当前.因果
                    || !当前.自有事实) return 动作替换失败(当前.结果头.状态,
                        当前.结果头.事实截止代次);
                if (当前.自有事实->动作关系稳定编码 != 请求.旧动作关系
                    || 当前.因果->动作 == 请求.新动作)
                    return 动作替换失败(L2结构状态::引用冲突, 代次.事实代次);
                if (请求.新动作) {
                    L1所有者范围一致当前读取请求 节点请求;
                    节点请求.合同版本 = L1所有者范围一致当前读取合同版本;
                    节点请求.期望事实代次 = 请求.请求头.期望事实代次;
                    节点请求.节点 = {*请求.新动作};
                    const auto 读 = L1_.尝试读取所有者范围一致当前投影(节点请求);
                    const auto 顶层 = 解释一致顶层(读, 请求.请求头.期望事实代次);
                    const auto* 项 = 找节点(读, *请求.新动作);
                    if (!顶层.成功()) return 动作替换失败(顶层.状态, 顶层.截止);
                    if (!项 || !项->事实 || !普通节点有效(*项->事实,
                            *请求.新动作, 顶层.截止))
                        return 动作替换失败(项 && 项->状态
                                == L1所有者范围一致当前读取项目状态::已退出
                            ? L2结构状态::已退出 : L2结构状态::未找到, 顶层.截止);
                }
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 非成功写入边界完整(写入) ? 动作替换失败(状态, 写入.事实代次)
                    : 动作替换失败(L2结构状态::内部不一致, 写入.事实代次);
            if (!写入成功边界完整(写入))
                return 动作替换失败(L2结构状态::内部不一致,
                    写入.事实代次, 写入.事实代次);
            已发布首次代次 = 写入.事实代次;
            if (写入.新编码映射.size() != (请求.新动作 ? 1U : 0U))
                return 动作替换失败(L2结构状态::内部不一致,
                    *已发布首次代次, 已发布首次代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            const auto 探测状态 = 解释发布后事实代次探测(当前代次, 写入.事实代次);
            if (探测状态 != L2结构状态::已读取)
                return 动作替换失败(探测状态, 写入.事实代次, 写入.事实代次);
            const auto 首次 = 读取完整因果({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.因果, 写入.事实代次});
            if (首次.结果头.状态 != L2结构状态::已读取)
                return 动作替换失败(首次.结果头.状态,
                    写入.事实代次, 写入.事实代次);
            if (!首次.因果 || !首次.自有事实 || 首次.因果->动作 != 请求.新动作)
                return 动作替换失败(L2结构状态::内部不一致,
                    写入.事实代次, 写入.事实代次);
            if (请求.旧动作关系) {
                const auto 旧读 = L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, *请求.旧动作关系});
                if (旧读.状态 != L1所有者范围读取状态::成功)
                    return 动作替换失败(映射历史失败(旧读.状态),
                        写入.事实代次, 写入.事实代次);
                const auto* 旧 = 旧读.事实
                    ? std::get_if<L1所有者范围关系事实>(&*旧读.事实) : nullptr;
                if (!旧 || 旧->退出事实代次 != 写入.事实代次)
                    return 动作替换失败(L2结构状态::内部不一致,
                        写入.事实代次, 写入.事实代次);
            }
            L2因果动作引用替换结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, *首次.因果, *首次.自有事实,
                请求.旧动作关系};
            return 结果.成功() ? 结果 : 动作替换失败(L2结构状态::内部不一致,
                写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 动作替换失败(
                L2结构状态::资源失败, 边界.事实截止代次, 边界.变更事实代次); }
        catch (const std::length_error&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 动作替换失败(
                L2结构状态::资源失败, 边界.事实截止代次, 边界.变更事实代次); }
        catch (...) { const auto 边界 = 形成发布后异常代次边界(已发布首次代次);
            return 动作替换失败(L2结构状态::内部不一致,
                边界.事实截止代次, 边界.变更事实代次); }
    }

    // 诊断责任：向上送出；来源值、属性槽和旧值退出同代原子发布。
    L2因果来源换代结果 换代因果来源(const L2因果来源换代请求& 请求) {
        using namespace L2因果结构内部;
        if (!L2因果来源换代请求有效(请求))
            return 来源换代失败(L2结构状态::入口拒绝);
        std::optional<std::uint64_t> 已发布首次代次;
        try {
            const auto 登记读 = 读取当前因果结构类型登记();
            if (!登记读.成功() || !登记读.登记) return 来源换代失败(
                登记失败转结构(登记读.状态), 登记读.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.值 = {{{来源值本地键}, 请求.因果.值,
                登记读.登记->来源属性类型.值,
                L1所有者范围独立材料引用{请求.新来源}, 请求.新来源}};
            写集.属性槽变更 = {{请求.因果.值, 登记读.登记->来源属性类型.值,
                {来源值本地键}}};
            写集.退出事实 = {请求.旧来源值};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
                return 来源换代失败(映射事实代次探测失败(代次.状态), 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整因果({请求.请求头, L2读取类别::当前,
                    请求.因果, 0});
                if (当前.结果头.状态 != L2结构状态::已读取 || !当前.因果
                    || !当前.自有事实) return 来源换代失败(当前.结果头.状态,
                        当前.结果头.事实截止代次);
                if (当前.自有事实->来源值稳定编码 != 请求.旧来源值)
                    return 来源换代失败(L2结构状态::引用冲突, 代次.事实代次);
                L1所有者范围一致当前读取请求 节点请求;
                节点请求.合同版本 = L1所有者范围一致当前读取合同版本;
                节点请求.期望事实代次 = 请求.请求头.期望事实代次;
                节点请求.节点 = {请求.新来源};
                const auto 读 = L1_.尝试读取所有者范围一致当前投影(节点请求);
                const auto 顶层 = 解释一致顶层(读, 请求.请求头.期望事实代次);
                const auto* 项 = 找节点(读, 请求.新来源);
                if (!顶层.成功()) return 来源换代失败(顶层.状态, 顶层.截止);
                if (!项 || !项->事实 || !普通节点有效(*项->事实,
                        请求.新来源, 顶层.截止))
                    return 来源换代失败(项 && 项->状态
                            == L1所有者范围一致当前读取项目状态::已退出
                        ? L2结构状态::已退出 : L2结构状态::未找到, 顶层.截止);
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 非成功写入边界完整(写入) ? 来源换代失败(状态, 写入.事实代次)
                    : 来源换代失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 新值 = 查找编码映射(写入, 来源值本地键);
            if (!写入成功边界完整(写入))
                return 来源换代失败(L2结构状态::内部不一致,
                    写入.事实代次, 写入.事实代次);
            已发布首次代次 = 写入.事实代次;
            if (写入.新编码映射.size() != 1 || !新值)
                return 来源换代失败(L2结构状态::内部不一致,
                    *已发布首次代次, 已发布首次代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            const auto 探测状态 = 解释发布后事实代次探测(当前代次, 写入.事实代次);
            if (探测状态 != L2结构状态::已读取)
                return 来源换代失败(探测状态, 写入.事实代次, 写入.事实代次);
            const auto 首次 = 读取完整因果({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.因果, 写入.事实代次});
            if (首次.结果头.状态 != L2结构状态::已读取)
                return 来源换代失败(首次.结果头.状态,
                    写入.事实代次, 写入.事实代次);
            const auto 旧读 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.旧来源值});
            if (旧读.状态 != L1所有者范围读取状态::成功)
                return 来源换代失败(映射历史失败(旧读.状态),
                    写入.事实代次, 写入.事实代次);
            const auto* 旧 = 旧读.事实
                ? std::get_if<L1所有者范围值事实>(&*旧读.事实) : nullptr;
            const auto* 旧材料 = 旧 ? std::get_if<L1所有者范围独立材料引用>(&旧->材料) : nullptr;
            if (!首次.因果 || !首次.自有事实
                || 首次.因果->来源稳定编码 != 请求.新来源
                || 首次.自有事实->来源值稳定编码 != *新值 || !旧 || !旧材料
                || 旧->所属节点 != 请求.因果.值
                || 旧->属性类型节点 != 登记读.登记->来源属性类型.值
                || 旧材料->编码 != 旧->来源节点
                || 旧->退出事实代次 != 写入.事实代次)
                return 来源换代失败(L2结构状态::内部不一致,
                    写入.事实代次, 写入.事实代次);
            L2属性事实 已退出{旧->属性类型节点, 旧->编码,
                L2独立材料引用{旧材料->编码}, 旧->来源节点,
                旧->创建事实代次, 旧->退出事实代次};
            L2因果来源换代结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, *首次.因果,
                *首次.自有事实, std::move(已退出)};
            return 结果.成功() ? 结果 : 来源换代失败(L2结构状态::内部不一致,
                写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 来源换代失败(
                L2结构状态::资源失败, 边界.事实截止代次, 边界.变更事实代次); }
        catch (const std::length_error&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 来源换代失败(
                L2结构状态::资源失败, 边界.事实截止代次, 边界.变更事实代次); }
        catch (...) { const auto 边界 = 形成发布后异常代次边界(已发布首次代次);
            return 来源换代失败(L2结构状态::内部不一致,
                边界.事实截止代次, 边界.变更事实代次); }
    }

    // 诊断责任：向上送出；因果节点与扁平自有闭包同代退出。
    L2因果退出结果 退出因果(const L2因果退出请求& 请求) {
        using namespace L2因果结构内部;
        if (!L2因果退出请求有效(请求))
            return 因果退出失败(L2结构状态::入口拒绝);
        std::optional<std::uint64_t> 已发布首次代次;
        try {
            const auto 登记读 = 读取当前因果结构类型登记();
            if (!登记读.成功() || !登记读.登记) return 因果退出失败(
                登记失败转结构(登记读.状态), 登记读.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = {请求.幂等身份.值};
            写集.退出事实 = 请求.自有事实闭包;
            写集.退出事实.push_back(请求.因果.值);
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
                return 因果退出失败(映射事实代次探测失败(代次.状态), 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整因果({请求.请求头, L2读取类别::当前,
                    请求.因果, 0});
                if (当前.结果头.状态 != L2结构状态::已读取 || !当前.因果
                    || !当前.自有事实) return 因果退出失败(当前.结果头.状态,
                        当前.结果头.事实截止代次);
                if (展平自有事实(*当前.自有事实) != 请求.自有事实闭包)
                    return 因果退出失败(L2结构状态::引用冲突, 代次.事实代次);
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
                return 非成功写入边界完整(写入) ? 因果退出失败(状态, 写入.事实代次)
                    : 因果退出失败(L2结构状态::内部不一致, 写入.事实代次);
            if (!写入成功边界完整(写入))
                return 因果退出失败(L2结构状态::内部不一致,
                    写入.事实代次, 写入.事实代次);
            已发布首次代次 = 写入.事实代次;
            if (!写入.新编码映射.empty())
                return 因果退出失败(L2结构状态::内部不一致,
                    *已发布首次代次, 已发布首次代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            const auto 探测状态 = 解释发布后事实代次探测(当前代次, 写入.事实代次);
            if (探测状态 != L2结构状态::已读取)
                return 因果退出失败(探测状态, 写入.事实代次, 写入.事实代次);
            const auto 历史 = 读取完整因果({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.因果, 写入.事实代次});
            if (历史.结果头.状态 != L2结构状态::已读取)
                return 因果退出失败(历史.结果头.状态,
                    写入.事实代次, 写入.事实代次);
            if (!历史.因果 || !历史.自有事实
                || 历史.因果->生命周期.退出事实代次 != 写入.事实代次
                || 展平自有事实(*历史.自有事实) != 请求.自有事实闭包)
                return 因果退出失败(L2结构状态::内部不一致,
                    写入.事实代次, 写入.事实代次);
            for (auto 编码 : 请求.自有事实闭包) {
                const auto 读 = L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 编码});
                if (读.状态 != L1所有者范围读取状态::成功)
                    return 因果退出失败(映射历史失败(读.状态),
                        写入.事实代次, 写入.事实代次);
                bool 同代退出 = false;
                if (读.事实) std::visit([&](const auto& 事实) {
                    同代退出 = 事实.退出事实代次 == 写入.事实代次;
                }, *读.事实);
                if (!同代退出)
                    return 因果退出失败(L2结构状态::内部不一致,
                        写入.事实代次, 写入.事实代次);
            }
            L2因果退出结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, *历史.因果, *历史.自有事实};
            return 结果.成功() ? 结果 : 因果退出失败(L2结构状态::内部不一致,
                写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 因果退出失败(
                L2结构状态::资源失败, 边界.事实截止代次, 边界.变更事实代次); }
        catch (const std::length_error&) { const auto 边界 =
            形成发布后异常代次边界(已发布首次代次); return 因果退出失败(
                L2结构状态::资源失败, 边界.事实截止代次, 边界.变更事实代次); }
        catch (...) { const auto 边界 = 形成发布后异常代次边界(已发布首次代次);
            return 因果退出失败(L2结构状态::内部不一致,
                边界.事实截止代次, 边界.变更事实代次); }
    }

private:
    enum class 端点角色 : std::uint8_t { 条件, 动作, 结果 };
    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& L1, L2因果所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(L1))
            throw std::invalid_argument("L2 causal owner delivery invalid");
        return std::move(交付.写入端口_);
    }

    L2因果写入结果 提交并读回(const L1所有者范围写集请求& 写集,
        const L2因果新增请求& 请求) {
        using namespace L2因果结构内部;
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射写入状态(写入.状态);
        if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复)
            return 写入失败(状态, 写入.事实代次);
        稳定编码 因果编码;
        L2因果自有关系引用 自有;
        for (const auto& [键, 编码] : 写入.新编码映射) {
            if (键.值 == 因果节点本地键) 因果编码 = 编码;
            else if (键.值 == 因果族归属关系本地键) 自有.族归属关系稳定编码 = 编码;
            else if (键.值 > 条件关系本地键基值 && 键.值 <= 条件关系本地键基值 + 0x0FFF)
                自有.条件关系稳定编码.push_back(编码);
            else if (键.值 == 动作关系本地键) 自有.动作关系稳定编码 = 编码;
            else if (键.值 > 结果关系本地键基值 && 键.值 <= 结果关系本地键基值 + 0x0FFF)
                自有.结果关系稳定编码.push_back(编码);
            else if (键.值 == 来源值本地键) 自有.来源值稳定编码 = 编码;
        }
        std::sort(自有.条件关系稳定编码.begin(), 自有.条件关系稳定编码.end());
        std::sort(自有.结果关系稳定编码.begin(), 自有.结果关系稳定编码.end());
        L2因果事实 因果{L2因果身份{因果编码}, 请求.条件状态, 请求.动作, 请求.结果状态,
            请求.来源稳定编码, {写入.事实代次, std::nullopt}};
        const auto 当前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前.状态 != L1中性读取状态::成功 || 当前.事实代次 == 0)
            return 写入失败(L2结构状态::内部不一致, 写入.事实代次,
                写入.事实代次);
        const auto 首次读回 = 读取完整因果({{L2结构合同版本, 当前.事实代次},
            L2读取类别::历史, L2因果身份{因果编码}, 写入.事实代次});
        if (首次读回.结果头.状态 != L2结构状态::已读取
            || !首次读回.因果 || !首次读回.自有事实
            || *首次读回.因果 != 因果 || *首次读回.自有事实 != 自有)
            return 写入失败(L2结构状态::内部不一致, 写入.事实代次,
                写入.事实代次);
        L2因果写入结果 结果{{L2结构合同版本, 状态, 写入.事实代次,
            写入.事实代次}, *首次读回.因果, *首次读回.自有事实};
        return 结果.成功() ? 结果 : 写入失败(L2结构状态::内部不一致, 写入.事实代次,
            写入.事实代次);
    }

    L2因果完整读取结果 读取当前完整(const L2因果完整读取请求& 请求) const {
        using namespace L2因果结构内部;
        const auto 登记 = 读取当前因果结构类型登记();
        if (!登记.成功() || !登记.登记)
            return 完整失败(请求, 登记失败转结构(登记.状态), 登记.事实截止代次);
        L1所有者范围一致当前读取请求 L1请求;
        L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
        L1请求.期望事实代次 = 请求.请求头.期望事实代次;
        L1请求.所有者 = {因果身份来源定位_.所有者};
        L1请求.节点 = {请求.因果.值, 因果身份来源定位_.族锚点,
            因果身份来源定位_.族归属关系类型};
        L1请求.源关系组 = {{请求.因果.值,
                因果身份来源定位_.族归属关系类型},
            {请求.因果.值, 登记.登记->条件关系类型.值},
            {请求.因果.值, 登记.登记->动作关系类型.值},
            {请求.因果.值, 登记.登记->结果关系类型.值}};
        L1请求.属性值 = {{请求.因果.值, 登记.登记->来源属性类型.值}};
        const auto 读 = L1_.尝试读取所有者范围一致当前投影(L1请求);
        const auto 顶层 = 解释一致顶层(读, 请求.请求头.期望事实代次);
        if (!顶层.成功()) return 完整失败(请求, 顶层.状态, 顶层.截止);
        const auto* 节点项 = 找节点(读, 请求.因果.值);
        const auto* 锚点项 = 找节点(读, 因果身份来源定位_.族锚点);
        const auto* 类型项 = 找节点(读, 因果身份来源定位_.族归属关系类型);
        const auto* 归属 = 找源组(读, 请求.因果.值,
            因果身份来源定位_.族归属关系类型);
        const auto* 条件 = 找源组(读, 请求.因果.值, 登记.登记->条件关系类型.值);
        const auto* 动作 = 找源组(读, 请求.因果.值, 登记.登记->动作关系类型.值);
        const auto* 结果 = 找源组(读, 请求.因果.值, 登记.登记->结果关系类型.值);
        const auto* 属性 = 找属性(读, 请求.因果.值, 登记.登记->来源属性类型.值);
        if (!节点项 || !锚点项 || !类型项 || !归属 || !条件 || !动作
            || !结果 || !属性)
            return 完整失败(请求, L2结构状态::内部不一致, 顶层.截止);
        if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功)
            return 完整失败(请求, 节点项->状态
                    == L1所有者范围一致当前读取项目状态::未找到
                ? L2结构状态::未找到 : 节点项->状态
                    == L1所有者范围一致当前读取项目状态::已退出
                    ? L2结构状态::已退出 : L2结构状态::入口拒绝,
                顶层.截止);
        if (条件->成员.empty() || 结果->成员.empty()
            || 动作->成员.size() > 1 || !属性->投影)
            return 完整失败(请求, L2结构状态::内部不一致, 顶层.截止);
        if (!节点项->事实 || !锚点项->事实 || !类型项->事实
            || 归属->成员.size() != 1 || 读.所有者.size() != 1
            || !读.所有者.front().所有者事实)
            return 完整失败(请求, 归属->成员.empty()
                ? L2结构状态::入口拒绝 : L2结构状态::内部不一致, 顶层.截止);
        const auto& 节点 = *节点项->事实;
        const auto& 锚点 = *锚点项->事实;
        const auto& 类型 = *类型项->事实;
        const auto& 归属关系 = 归属->成员.front().关系;
        if (节点.写入所有者 != 因果身份来源定位_.所有者
            || 节点.种类 != 节点种类::普通 || 节点.属性类型表示
            || 节点.退出事实代次 || 锚点.编码 != 因果身份来源定位_.族锚点
            || 类型.编码 != 因果身份来源定位_.族归属关系类型
            || 锚点.写入所有者 != 因果身份来源定位_.所有者
            || 类型.写入所有者 != 因果身份来源定位_.所有者
            || 归属关系.写入所有者 != 因果身份来源定位_.所有者
            || 归属关系.源节点 != 请求.因果.值
            || 归属关系.目标节点 != 锚点.编码
            || 归属关系.关系类型节点 != 类型.编码
            || 归属关系.角色或顺序 != 固定角色 || 归属关系.退出事实代次
            || 归属关系.创建事实代次 != 节点.创建事实代次)
            return 完整失败(请求, L2结构状态::内部不一致, 顶层.截止);
        L2因果事实 因果; 因果.身份 = 请求.因果;
        L2因果自有关系引用 自有;
        自有.族归属关系稳定编码 = 归属关系.编码;
        for (const auto& 项 : 条件->成员) {
            因果.条件状态.push_back({static_cast<std::uint64_t>(项.关系.角色或顺序), 项.关系.目标节点});
            自有.条件关系稳定编码.push_back(项.关系.编码);
        }
        if (!动作->成员.empty()) {
            因果.动作 = 动作->成员.front().关系.目标节点;
            自有.动作关系稳定编码 = 动作->成员.front().关系.编码;
        }
        for (const auto& 项 : 结果->成员) {
            因果.结果状态.push_back({static_cast<std::uint64_t>(项.关系.角色或顺序), 项.关系.目标节点});
            自有.结果关系稳定编码.push_back(项.关系.编码);
        }
        const auto* 材料 = std::get_if<L1所有者范围独立材料引用>(
            &属性->投影->当前值事实.材料);
        if (!材料 || 材料->编码 != 属性->投影->当前值事实.来源节点)
            return 完整失败(请求, L2结构状态::内部不一致, 顶层.截止);
        因果.来源稳定编码 = 材料->编码;
        因果.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
        自有.来源值稳定编码 = 属性->投影->当前值事实.编码;
        for (const auto& 引用 : 因果.条件状态) {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::当前, L2状态身份{引用.目标}, 0});
            if (!状态来源.成功()) return 完整失败(请求,
                状态来源.结果头.状态, 状态来源.结果头.事实截止代次);
        }
        for (const auto& 引用 : 因果.结果状态) {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::当前, L2状态身份{引用.目标}, 0});
            if (!状态来源.成功()) return 完整失败(请求,
                状态来源.结果头.状态, 状态来源.结果头.事实截止代次);
        }
        std::vector<稳定编码> 普通引用{因果.来源稳定编码};
        if (因果.动作) 普通引用.push_back(*因果.动作);
        L1所有者范围一致当前读取请求 引用请求;
        引用请求.合同版本 = L1所有者范围一致当前读取合同版本;
        引用请求.期望事实代次 = 请求.请求头.期望事实代次;
        引用请求.节点 = 普通引用;
        const auto 引用读取 = L1_.尝试读取所有者范围一致当前投影(引用请求);
        const auto 引用顶层 = 解释一致顶层(引用读取, 请求.请求头.期望事实代次);
        if (!引用顶层.成功()) return 完整失败(请求, 引用顶层.状态, 引用顶层.截止);
        for (auto 编码 : 普通引用) {
            const auto* 项 = 找节点(引用读取, 编码);
            if (!项 || !项->事实 || !普通节点有效(*项->事实, 编码, 引用顶层.截止))
                return 完整失败(请求, L2结构状态::内部不一致, 引用顶层.截止);
        }
        if (!L2因果事实完整(因果, 顶层.截止))
            return 完整失败(请求, L2结构状态::内部不一致, 顶层.截止);
        return {失败头(L2结构状态::已读取, 顶层.截止), 请求.读取类别, 0,
            因果, 自有};
    }

    L2因果完整读取结果 读取历史完整(const L2因果完整读取请求& 请求) const {
        using namespace L2因果结构内部;
        const auto 当前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        const auto 首探状态 = 解释事实代次探测(当前, 请求.请求头.期望事实代次);
        if (首探状态 != L2结构状态::已读取)
            return 完整失败(请求, 首探状态, 当前.事实代次);
        const auto 登记 = 读取当前因果结构类型登记();
        if (!登记.成功() || !登记.登记) return 完整失败(请求,
            登记失败转结构(登记.状态), 登记.事实截止代次);
        const auto 来源 = 读取因果身份来源({请求.请求头, L2读取类别::历史,
            请求.因果, 请求.历史截止事实代次});
        if (!来源.成功() || !来源.身份来源) return 完整失败(请求,
            来源.结果头.状态, 来源.结果头.事实截止代次);
        const auto 节点读 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 请求.因果.值});
        const auto* 节点 = 节点读.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读.事实) : nullptr;
        if (节点读.状态 != L1所有者范围读取状态::成功)
            return 完整失败(请求, 映射历史失败(节点读.状态),
                请求.历史截止事实代次);
        if (!节点 || 节点读.读取事实代次 != 请求.请求头.期望事实代次)
            return 完整失败(请求, L2结构状态::内部不一致,
                请求.历史截止事实代次);
        if (节点->创建事实代次 > 请求.历史截止事实代次)
            return 完整失败(请求, L2结构状态::未找到,
                请求.历史截止事实代次);
        const std::uint64_t 结构发现截止 = 节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次
            ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
        const auto 读组 = [&](稳定编码 类型) { return L1_.读取所有者范围历史关系组({
            L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
            请求.因果.值, 类型, 结构发现截止}); };
        const auto 条件 = 读组(登记.登记->条件关系类型.值);
        const auto 动作 = 读组(登记.登记->动作关系类型.值);
        const auto 结果 = 读组(登记.登记->结果关系类型.值);
        const auto 属性 = L1_.读取所有者范围历史属性值组({L1所有者范围CRUD合同版本,
            请求.因果.值, 结构发现截止});
        for (const auto [状态, 读取代次] : {
                std::pair{条件.状态, 条件.读取事实代次},
                std::pair{动作.状态, 动作.读取事实代次},
                std::pair{结果.状态, 结果.读取事实代次},
                std::pair{属性.状态, 属性.读取事实代次}}) {
            if (状态 != L1所有者范围读取状态::成功)
                return 完整失败(请求, 映射历史失败(状态),
                    请求.历史截止事实代次);
            if (读取代次 != 请求.请求头.期望事实代次)
                return 完整失败(请求, L2结构状态::内部不一致,
                    请求.历史截止事实代次);
        }
        if (条件.关系组.empty() || 结果.关系组.empty()
            || 动作.关系组.size() > 1 || 属性.属性值组.size() != 1)
            return 完整失败(请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        L2因果事实 因果; 因果.身份 = 请求.因果;
        L2因果自有关系引用 自有{来源.身份来源->族归属关系稳定编码};
        for (const auto& 关系 : 条件.关系组) {
            因果.条件状态.push_back({static_cast<std::uint64_t>(关系.角色或顺序), 关系.目标节点});
            自有.条件关系稳定编码.push_back(关系.编码);
        }
        if (!动作.关系组.empty()) { 因果.动作 = 动作.关系组.front().目标节点;
            自有.动作关系稳定编码 = 动作.关系组.front().编码; }
        for (const auto& 关系 : 结果.关系组) {
            因果.结果状态.push_back({static_cast<std::uint64_t>(关系.角色或顺序), 关系.目标节点});
            自有.结果关系稳定编码.push_back(关系.编码);
        }
        const auto* 材料 = std::get_if<L1所有者范围独立材料引用>(&属性.属性值组.front().材料);
        if (!材料 || 材料->编码 != 属性.属性值组.front().来源节点
            || 属性.属性值组.front().属性类型节点 != 登记.登记->来源属性类型.值)
            return 完整失败(请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        因果.来源稳定编码 = 材料->编码;
        因果.生命周期 = 来源.身份来源->节点生命周期;
        自有.来源值稳定编码 = 属性.属性值组.front().编码;
        for (const auto& 引用 : 因果.条件状态) {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::历史, L2状态身份{引用.目标}, 请求.历史截止事实代次});
            if (!状态来源.成功()) return 完整失败(请求,
                状态来源.结果头.状态, 状态来源.结果头.事实截止代次);
        }
        for (const auto& 引用 : 因果.结果状态) {
            const auto 状态来源 = 状态服务_.读取状态身份来源({请求.请求头,
                L2读取类别::历史, L2状态身份{引用.目标}, 请求.历史截止事实代次});
            if (!状态来源.成功()) return 完整失败(请求,
                状态来源.结果头.状态, 状态来源.结果头.事实截止代次);
        }
        std::vector<稳定编码> 普通引用{因果.来源稳定编码};
        if (因果.动作) 普通引用.push_back(*因果.动作);
        for (auto 编码 : 普通引用) {
            const auto 引用读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
            const auto* 节点 = 引用读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*引用读取.事实) : nullptr;
            if (引用读取.状态 != L1所有者范围读取状态::成功)
                return 完整失败(请求, 映射历史失败(引用读取.状态),
                    请求.历史截止事实代次);
            if (!节点 || 引用读取.读取事实代次 != 请求.请求头.期望事实代次
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 > 请求.历史截止事实代次
                || (节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次))
                return 完整失败(请求, L2结构状态::内部不一致,
                    请求.历史截止事实代次);
        }
        const auto 最终代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        const auto 尾探状态 = 解释事实代次探测(最终代次,
            请求.请求头.期望事实代次);
        if (尾探状态 != L2结构状态::已读取)
            return 完整失败(请求, 尾探状态, 最终代次.事实代次);
        if (!L2因果事实完整(因果, 请求.历史截止事实代次))
            return 完整失败(请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return {失败头(L2结构状态::已读取, 请求.历史截止事实代次),
            请求.读取类别, 请求.历史截止事实代次, 因果, 自有};
    }

    L2当前因果组读取结果 按端点读取(const L2结构请求头& 请求头,
        稳定编码 端点, 端点角色 角色, std::uint64_t 最大数量) const {
        using namespace L2因果结构内部;
        try {
            const auto 登记 = 读取当前因果结构类型登记();
            if (!登记.成功() || !登记.登记)
                return 组失败(登记失败转结构(登记.状态), 登记.事实截止代次);
            const 稳定编码 类型 = 角色 == 端点角色::条件 ? 登记.登记->条件关系类型.值
                : 角色 == 端点角色::动作 ? 登记.登记->动作关系类型.值
                : 登记.登记->结果关系类型.值;
            L1所有者范围一致当前读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
            L1请求.期望事实代次 = 请求头.期望事实代次;
            L1请求.所有者 = {因果身份来源定位_.所有者};
            L1请求.目标关系组 = {{端点, 类型}};
            const auto 读 = L1_.尝试读取所有者范围一致当前投影(L1请求);
            const auto 顶层 = 解释一致顶层(读, 请求头.期望事实代次);
            if (!顶层.成功()) return 组失败(顶层.状态, 顶层.截止);
            const auto* 组 = 找目标组(读, 端点, 类型);
            if (!组) return 组失败(L2结构状态::内部不一致, 顶层.截止);
            std::vector<稳定编码> 源;
            for (const auto& 项 : 组->成员) {
                const auto& 关系 = 项.关系;
                const bool 角色有效 = 角色 == 端点角色::动作
                    ? 关系.角色或顺序 == 固定角色 : 关系.角色或顺序 > 0;
                if (关系.目标节点 != 端点 || 关系.关系类型节点 != 类型
                    || !角色有效 || 关系.退出事实代次)
                    return 组失败(L2结构状态::内部不一致, 顶层.截止);
                源.push_back(关系.源节点);
            }
            std::sort(源.begin(), 源.end());
            源.erase(std::unique(源.begin(), 源.end()), 源.end());
            if (源.size() > 最大数量)
                return 组失败(L2结构状态::数量预算不足, 顶层.截止);
            L2当前因果组读取结果 结果{失败头(L2结构状态::已读取, 顶层.截止), {}};
            for (auto 编码 : 源) {
                const auto 完整 = 读取完整因果({请求头, L2读取类别::当前,
                    L2因果身份{编码}, 0});
                if (完整.结果头.状态 != L2结构状态::已读取 || !完整.因果)
                    return 组失败(完整.结果头.状态, 完整.结果头.事实截止代次);
                const bool 含端点 = 角色 == 端点角色::条件
                    ? std::any_of(完整.因果->条件状态.begin(), 完整.因果->条件状态.end(),
                        [&](const auto& 引用) { return 引用.目标 == 端点; })
                    : 角色 == 端点角色::动作
                        ? 完整.因果->动作 && *完整.因果->动作 == 端点
                        : std::any_of(完整.因果->结果状态.begin(), 完整.因果->结果状态.end(),
                            [&](const auto& 引用) { return 引用.目标 == 端点; });
                if (!含端点) return 组失败(L2结构状态::内部不一致, 顶层.截止);
                结果.因果.push_back(*完整.因果);
            }
            return 结果.成功() ? 结果 : 组失败(L2结构状态::内部不一致, 顶层.截止);
        } catch (const std::bad_alloc&) { return 组失败(L2结构状态::资源失败); }
        catch (...) { return 组失败(L2结构状态::内部不一致); }
    }

    const L1事实基座服务& L1_;
    const L2状态结构服务& 状态服务_;
    L1所有者范围写端口 第一层写入端口_;
    L2因果结构内部::因果身份来源定位 因果身份来源定位_;
    std::optional<L2因果结构类型登记> 结构类型登记定位_;
};

}
