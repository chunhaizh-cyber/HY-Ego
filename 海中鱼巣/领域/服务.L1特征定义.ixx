module;

#include <array>
#include <cstdint>
#include <mutex>
#include <new>
#include <optional>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.服务.L1特征定义;

export import 海中鱼巣.核心.合同.L1公共事实;
import 海中鱼巣.核心.服务.L1事实基座;

export {
#include "L1特征定义.数据.h"
}

export namespace 海中鱼巣 {

namespace L1特征定义内部 {

inline constexpr std::uint64_t 登记幂等域 = 0x03ULL;
inline constexpr std::uint64_t 定义幂等域 = 0x04ULL;

// 诊断责任：无适用错误分支；纯值映射不访问外部状态。
L1中性写集幂等键 映射幂等键(
    std::uint64_t 域, 特征操作幂等身份 身份) noexcept {
    return {(域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；只在结构化映射中查找唯一键。
std::optional<稳定编码> 查找映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到.has_value()) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只验证结构化映射的键和值唯一。
bool 映射唯一(const L1中性写入结果& 结果) noexcept {
    for (std::size_t 左 = 0; 左 < 结果.新编码映射.size(); ++左) {
        if (!有效(结果.新编码映射[左].first)
            || !有效(结果.新编码映射[左].second)) return false;
        for (std::size_t 右 = 左 + 1; 右 < 结果.新编码映射.size(); ++右) {
            if (结果.新编码映射[左].first == 结果.新编码映射[右].first
                || 结果.新编码映射[左].second == 结果.新编码映射[右].second) {
                return false;
            }
        }
    }
    return true;
}

// 诊断责任：无适用错误分支；纯值状态映射保留中性失败类别。
特征定义状态 映射写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 特征定义状态::已提交;
    case L1中性写入状态::精确重复: return 特征定义状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 特征定义状态::入口拒绝;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出: return 特征定义状态::未找到;
    case L1中性写入状态::事实代次漂移: return 特征定义状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return 特征定义状态::幂等冲突;
    case L1中性写入状态::资源失败: return 特征定义状态::资源失败;
    case L1中性写入状态::内部不一致: return 特征定义状态::内部不一致;
    }
    return 特征定义状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值状态映射保留中性失败类别。
特征定义状态 映射读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::成功: return 特征定义状态::已读取;
    case L1中性读取状态::入口拒绝: return 特征定义状态::入口拒绝;
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置: return 特征定义状态::未找到;
    case L1中性读取状态::资源失败: return 特征定义状态::资源失败;
    case L1中性读取状态::内部不一致: return 特征定义状态::内部不一致;
    }
    return 特征定义状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对成功类结构化合同。
bool 写入成功合同完整(const L1中性写入结果& 结果,
    L1中性写集幂等键 期望键, std::size_t 期望映射数量) noexcept {
    if (结果.合同版本 != L1中性CRUD合同版本
        || 结果.幂等键 != 期望键 || 结果.事实代次 == 0
        || 结果.新编码映射.size() != 期望映射数量
        || !映射唯一(结果)) return false;
    if (结果.状态 == L1中性写入状态::成功) {
        return 结果.是否形成内存权威发布
            && 结果.重试边界 == L1中性重试边界::不适用;
    }
    if (结果.状态 == L1中性写入状态::精确重复) {
        return !结果.是否形成内存权威发布
            && 结果.重试边界 == L1中性重试边界::原幂等键读回收敛;
    }
    return false;
}

} // namespace L1特征定义内部

class L1特征定义服务 final {
public:
    explicit L1特征定义服务(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L1特征定义服务(const L1特征定义服务&) = delete;
    L1特征定义服务& operator=(const L1特征定义服务&) = delete;

    // 诊断责任：向上送出；兼容入口只转发同对象的正式 const 写重载。
    // 诊断责任：向上送出；所有失败由结构化特征定义状态返回。
    特征定义登记结果 建立登记(const 特征定义登记请求& 请求) {
        return static_cast<const L1特征定义服务&>(*this).建立登记(请求);
    }

    // 诊断责任：向上送出；所有失败由结构化特征定义状态返回。
    特征定义登记结果 建立登记(const 特征定义登记请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!特征定义登记请求有效(请求) || 请求.期望事实代次 == 0)
                return {特征定义状态::入口拒绝, std::nullopt};

            const auto 幂等键 = L1特征定义内部::映射幂等键(
                L1特征定义内部::登记幂等域, 请求.幂等身份);

            L1中性写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {
                {{1}, 节点种类::普通, std::nullopt},
                {{2}, 节点种类::属性类型, L1中性值表示种类::I64},
                {{3}, 节点种类::属性类型, L1中性值表示种类::I64},
                {{4}, 节点种类::属性类型, L1中性值表示种类::I64}};

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1特征定义内部::映射写入状态(写入.状态);
            if (状态 != 特征定义状态::已提交
                && 状态 != 特征定义状态::幂等读回)
                return {状态, std::nullopt};
            if (!L1特征定义内部::写入成功合同完整(写入, 幂等键, 4))
                return {特征定义状态::内部不一致, std::nullopt};

            const auto 服务 = L1特征定义内部::查找映射(写入, 1);
            const auto 标记 = L1特征定义内部::查找映射(写入, 2);
            const auto 下界 = L1特征定义内部::查找映射(写入, 3);
            const auto 上界 = L1特征定义内部::查找映射(写入, 4);
            if (!服务 || !标记 || !下界 || !上界)
                return {特征定义状态::内部不一致, std::nullopt};

            const std::array<稳定编码, 4> 新定位{*服务, *标记, *下界, *上界};
            auto 读回 = 读取当前登记已持锁(新定位, 写入.事实代次);
            if (读回.状态 != 特征定义状态::已读取 || !读回.登记)
                return {读回.状态 == 特征定义状态::已读取
                        ? 特征定义状态::内部不一致 : 读回.状态,
                    std::nullopt};
            if (登记定位_.has_value() && *登记定位_ != 新定位)
                return {特征定义状态::内部不一致, std::nullopt};
            登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return {特征定义状态::资源失败, std::nullopt};
        } catch (...) {
            return {特征定义状态::内部不一致, std::nullopt};
        }
    }

    // 诊断责任：向上送出；定位缺失、读取失败和混代均结构化返回。
    特征定义登记结果 读取当前登记() const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!登记定位_)
                return {特征定义状态::登记未加载, std::nullopt};
            return 读取当前登记已持锁(*登记定位_, std::nullopt);
        } catch (const std::bad_alloc&) {
            return {特征定义状态::资源失败, std::nullopt};
        } catch (...) {
            return {特征定义状态::内部不一致, std::nullopt};
        }
    }

    // 诊断责任：向上送出；兼容入口只转发同对象的正式 const 写重载。
    // 诊断责任：向上送出；所有失败由结构化特征定义状态返回。
    I64特征定义结果 建立I64特征定义(const I64特征定义建立请求& 请求) {
        return static_cast<const L1特征定义服务&>(*this).建立I64特征定义(请求);
    }

    // 诊断责任：向上送出；所有失败由结构化特征定义状态返回。
    I64特征定义结果 建立I64特征定义(const I64特征定义建立请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (!I64特征定义建立请求有效(请求) || 请求.期望事实代次 == 0)
                return {特征定义状态::入口拒绝, std::nullopt, {}, {}, {}};

            if (!登记定位_)
                return {特征定义状态::登记未加载, std::nullopt, {}, {}, {}};
            const auto 登记结果 = 读取当前登记已持锁(*登记定位_, std::nullopt);
            if (登记结果.状态 != 特征定义状态::已读取 || !登记结果.登记)
                return {登记结果.状态, std::nullopt, {}, {}, {}};

            const auto 幂等键 = L1特征定义内部::映射幂等键(
                L1特征定义内部::定义幂等域, 请求.幂等身份);

            L1中性写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
            写集.值 = {
                {{2}, L1中性写集本地键{1}, 登记结果.登记->定义标记属性类型,
                    std::int64_t{1}, 登记结果.登记->服务身份},
                {{3}, L1中性写集本地键{1}, 登记结果.登记->I64下界属性类型,
                    请求.下界, 登记结果.登记->服务身份},
                {{4}, L1中性写集本地键{1}, 登记结果.登记->I64上界属性类型,
                    请求.上界, 登记结果.登记->服务身份}};
            写集.属性槽变更 = {
                {L1中性写集本地键{1}, 登记结果.登记->定义标记属性类型,
                    L1中性写集本地键{2}},
                {L1中性写集本地键{1}, 登记结果.登记->I64下界属性类型,
                    L1中性写集本地键{3}},
                {L1中性写集本地键{1}, 登记结果.登记->I64上界属性类型,
                    L1中性写集本地键{4}}};

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = L1特征定义内部::映射写入状态(写入.状态);
            if (状态 != 特征定义状态::已提交
                && 状态 != 特征定义状态::幂等读回)
                return {状态, std::nullopt, {}, {}, {}};
            if (!L1特征定义内部::写入成功合同完整(写入, 幂等键, 4))
                return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};

            const auto 定义 = L1特征定义内部::查找映射(写入, 1);
            const auto 标记 = L1特征定义内部::查找映射(写入, 2);
            const auto 下界 = L1特征定义内部::查找映射(写入, 3);
            const auto 上界 = L1特征定义内部::查找映射(写入, 4);
            if (!定义 || !标记 || !下界 || !上界)
                return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};

            I64特征定义读取请求 新定位;
            新定位.特征定义 = *定义;
            新定位.定义标记值 = *标记;
            新定位.下界值 = *下界;
            新定位.上界值 = *上界;

            auto 读回 = 读取I64特征定义已持锁(新定位, 写入.事实代次);
            if (读回.状态 != 特征定义状态::已读取 || !读回.事实)
                return {读回.状态 == 特征定义状态::已读取
                        ? 特征定义状态::内部不一致 : 读回.状态,
                    std::nullopt, {}, {}, {}};
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return {特征定义状态::资源失败, std::nullopt, {}, {}, {}};
        } catch (...) {
            return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};
        }
    }

    // 诊断责任：向上送出；正式读取不返回部分定义事实。
    I64特征定义结果 读取I64特征定义(
        const I64特征定义读取请求& 请求) const {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            return 读取I64特征定义已持锁(请求, std::nullopt);
        } catch (const std::bad_alloc&) {
            return {特征定义状态::资源失败, std::nullopt, {}, {}, {}};
        } catch (...) {
            return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};
        }
    }

private:
    // 诊断责任：向上送出；读取失败保留为结构化状态。
    std::optional<std::uint64_t> 读取当前代次(特征定义状态& 失败) const {
        const auto 结果 = L1_.读取中性当前事实代次({});
        if (结果.状态 != L1中性读取状态::成功 || 结果.事实代次 == 0) {
            失败 = L1特征定义内部::映射读取状态(结果.状态);
            if (结果.状态 == L1中性读取状态::成功)
                失败 = 特征定义状态::内部不一致;
            return std::nullopt;
        }
        return 结果.事实代次;
    }

    // 诊断责任：向上送出；编码或代次不匹配不降级为成功。
    std::optional<L1中性节点事实> 读取节点(稳定编码 编码,
        std::uint64_t 期望代次, 特征定义状态& 失败) const {
        const auto 结果 = L1_.读取中性当前节点({L1中性CRUD合同版本, 编码});
        if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
            失败 = L1特征定义内部::映射读取状态(结果.状态);
            return std::nullopt;
        }
        if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
            || 结果.事实->编码 != 编码) {
            失败 = 结果.读取事实代次 == 期望代次
                ? 特征定义状态::内部不一致 : 特征定义状态::事实代次漂移;
            return std::nullopt;
        }
        return 结果.事实;
    }

    // 诊断责任：向上送出；编码或代次不匹配不降级为成功。
    std::optional<L1中性值事实> 读取值(稳定编码 编码,
        std::uint64_t 期望代次, 特征定义状态& 失败) const {
        const auto 结果 = L1_.读取中性当前值({L1中性CRUD合同版本, 编码});
        if (结果.状态 != L1中性读取状态::成功 || !结果.事实) {
            失败 = L1特征定义内部::映射读取状态(结果.状态);
            return std::nullopt;
        }
        if (结果.查询编码 != 编码 || 结果.读取事实代次 != 期望代次
            || 结果.事实->编码 != 编码) {
            失败 = 结果.读取事实代次 == 期望代次
                ? 特征定义状态::内部不一致 : 特征定义状态::事实代次漂移;
            return std::nullopt;
        }
        return 结果.事实;
    }

    // 诊断责任：向上送出；槽位缺失和代次漂移保留为具名状态。
    std::optional<稳定编码> 读取属性(稳定编码 节点, 稳定编码 属性类型,
        std::uint64_t 期望代次, 特征定义状态& 失败) const {
        const auto 结果 = L1_.读取中性当前属性(
            {L1中性CRUD合同版本, 节点, 属性类型});
        if (结果.状态 != L1中性读取状态::成功 || !结果.当前值) {
            失败 = L1特征定义内部::映射读取状态(结果.状态);
            return std::nullopt;
        }
        if (结果.节点 != 节点 || 结果.属性类型 != 属性类型
            || 结果.读取事实代次 != 期望代次) {
            失败 = 结果.读取事实代次 == 期望代次
                ? 特征定义状态::内部不一致 : 特征定义状态::事实代次漂移;
            return std::nullopt;
        }
        return 结果.当前值;
    }

    struct 登记读取材料 final {
        特征定义登记 登记;
        std::array<L1中性节点事实, 4> 节点;
    };

    // 诊断责任：向上送出；四节点任一不完整即整项失败。
    std::optional<登记读取材料> 读取登记材料(
        const std::array<稳定编码, 4>& 定位, std::uint64_t 期望代次,
        std::optional<std::uint64_t> 期望创建代次, 特征定义状态& 失败) const {
        登记读取材料 材料;
        for (std::size_t 索引 = 0; 索引 < 定位.size(); ++索引) {
            const auto 节点 = 读取节点(定位[索引], 期望代次, 失败);
            if (!节点) return std::nullopt;
            材料.节点[索引] = *节点;
        }
        const auto& 服务 = 材料.节点[0];
        if (服务.种类 != 节点种类::普通 || 服务.属性类型表示
            || 服务.退出事实代次 || !服务.当前属性.empty()) {
            失败 = 特征定义状态::内部不一致;
            return std::nullopt;
        }
        for (std::size_t 索引 = 1; 索引 < 材料.节点.size(); ++索引) {
            const auto& 节点 = 材料.节点[索引];
            if (节点.种类 != 节点种类::属性类型
                || 节点.属性类型表示 != std::optional{L1中性值表示种类::I64}
                || 节点.退出事实代次 || !节点.当前属性.empty()) {
                失败 = 特征定义状态::内部不一致;
                return std::nullopt;
            }
        }
        if (期望创建代次) {
            for (const auto& 节点 : 材料.节点) {
                if (节点.创建事实代次 != *期望创建代次) {
                    失败 = 特征定义状态::内部不一致;
                    return std::nullopt;
                }
            }
        }
        材料.登记.事实截止代次 = 期望代次;
        材料.登记.服务身份 = 定位[0];
        材料.登记.定义标记属性类型 = 定位[1];
        材料.登记.I64下界属性类型 = 定位[2];
        材料.登记.I64上界属性类型 = 定位[3];
        if (!特征定义登记完整(材料.登记)) {
            失败 = 特征定义状态::内部不一致;
            return std::nullopt;
        }
        return 材料;
    }

    // 诊断责任：向上送出；首末代次不一致返回事实代次漂移。
    特征定义登记结果 读取当前登记已持锁(
        const std::array<稳定编码, 4>& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        特征定义状态 失败 = 特征定义状态::内部不一致;
        const auto 起始 = 读取当前代次(失败);
        if (!起始) return {失败, std::nullopt};
        const auto 材料 = 读取登记材料(定位, *起始, 期望创建代次, 失败);
        if (!材料) return {失败, std::nullopt};
        const auto 结束 = 读取当前代次(失败);
        if (!结束) return {失败, std::nullopt};
        if (*结束 != *起始)
            return {特征定义状态::事实代次漂移, std::nullopt};
        return {特征定义状态::已读取, 材料->登记};
    }

    // 诊断责任：向上送出；节点、槽和值任一不完整即整项失败。
    I64特征定义结果 读取I64特征定义已持锁(
        const I64特征定义读取请求& 请求,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (请求.合同版本 != L1特征定义合同版本
            || 请求.规则版本 != L1特征定义规则版本
            || !有效(请求.特征定义) || !有效(请求.定义标记值)
            || !有效(请求.下界值) || !有效(请求.上界值)) return {};

        特征定义状态 失败 = 特征定义状态::内部不一致;
        const auto 起始 = 读取当前代次(失败);
        if (!起始) return {失败, std::nullopt, {}, {}, {}};
        if (!登记定位_)
            return {特征定义状态::登记未加载, std::nullopt, {}, {}, {}};
        const auto 登记材料 = 读取登记材料(
            *登记定位_, *起始, std::nullopt, 失败);
        if (!登记材料) return {失败, std::nullopt, {}, {}, {}};

        const auto 定义 = 读取节点(请求.特征定义, *起始, 失败);
        if (!定义) return {失败, std::nullopt, {}, {}, {}};
        if (定义->种类 != 节点种类::普通 || 定义->属性类型表示
            || 定义->退出事实代次 || 定义->当前属性.size() != 3)
            return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};

        const auto 标记槽 = 读取属性(请求.特征定义,
            登记材料->登记.定义标记属性类型, *起始, 失败);
        const auto 下界槽 = 读取属性(请求.特征定义,
            登记材料->登记.I64下界属性类型, *起始, 失败);
        const auto 上界槽 = 读取属性(请求.特征定义,
            登记材料->登记.I64上界属性类型, *起始, 失败);
        if (!标记槽 || !下界槽 || !上界槽)
            return {失败, std::nullopt, {}, {}, {}};
        if (*标记槽 != 请求.定义标记值 || *下界槽 != 请求.下界值
            || *上界槽 != 请求.上界值)
            return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};

        std::array<L1中性属性槽, 3> 期望槽{{
            {登记材料->登记.定义标记属性类型, 请求.定义标记值},
            {登记材料->登记.I64下界属性类型, 请求.下界值},
            {登记材料->登记.I64上界属性类型, 请求.上界值}}};
        for (const auto& 期望 : 期望槽) {
            std::size_t 数量 = 0;
            for (const auto& 实际 : 定义->当前属性)
                if (实际 == 期望) ++数量;
            if (数量 != 1)
                return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};
        }

        const auto 标记 = 读取值(请求.定义标记值, *起始, 失败);
        const auto 下界 = 读取值(请求.下界值, *起始, 失败);
        const auto 上界 = 读取值(请求.上界值, *起始, 失败);
        if (!标记 || !下界 || !上界)
            return {失败, std::nullopt, {}, {}, {}};

        const std::array<L1中性值事实, 3> 值组{*标记, *下界, *上界};
        const std::array<稳定编码, 3> 类型组{
            登记材料->登记.定义标记属性类型,
            登记材料->登记.I64下界属性类型,
            登记材料->登记.I64上界属性类型};
        for (std::size_t 索引 = 0; 索引 < 值组.size(); ++索引) {
            const auto& 值 = 值组[索引];
            if (值.所属节点 != 请求.特征定义 || 值.属性类型节点 != 类型组[索引]
                || 值.来源节点 != 登记材料->登记.服务身份
                || 值.退出事实代次 || !std::holds_alternative<std::int64_t>(值.材料))
                return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};
        }
        if (期望创建代次) {
            if (定义->创建事实代次 != *期望创建代次)
                return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};
            for (const auto& 值 : 值组)
                if (值.创建事实代次 != *期望创建代次)
                    return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};
        }

        const auto 标记值 = std::get<std::int64_t>(标记->材料);
        const auto 下界值 = std::get<std::int64_t>(下界->材料);
        const auto 上界值 = std::get<std::int64_t>(上界->材料);
        if (标记值 != 1 || 下界值 > 上界值)
            return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};

        const auto 结束 = 读取当前代次(失败);
        if (!结束) return {失败, std::nullopt, {}, {}, {}};
        if (*结束 != *起始)
            return {特征定义状态::事实代次漂移, std::nullopt, {}, {}, {}};

        I64特征定义事实 事实;
        事实.事实截止代次 = *起始;
        事实.特征定义 = 请求.特征定义;
        事实.下界 = 下界值;
        事实.上界 = 上界值;
        事实.来源服务 = 登记材料->登记.服务身份;
        if (!I64特征定义事实完整(事实))
            return {特征定义状态::内部不一致, std::nullopt, {}, {}, {}};
        return {特征定义状态::已读取, 事实,
            请求.定义标记值, 请求.下界值, 请求.上界值};
    }

    L1事实基座服务& L1_;
    mutable std::mutex 锁_;
    mutable std::optional<std::array<稳定编码, 4>> 登记定位_;
};

} // namespace 海中鱼巣
