module;

#include <cstdint>
#include <algorithm>
#include <cstdio>
#include <memory>
#include <new>
#include <limits>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

#define 运行期只读查询_NO_INCLUDES
export module 海中鱼巣.领域.组合.运行期只读查询;
#undef 运行期只读查询_NO_INCLUDES

// 各 L2 服务模块（通过 export import 提供 L2结构公共 / L2需求 / L2任务 / L2状态 / L2特征 类型）
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2动态结构;

export {
#include "运行期只读查询.数据.h"
}

namespace 海中鱼巣::运行期只读查询细节 {

constexpr std::optional<std::uint8_t> 目标判断关系位(
    L2特征比较具名关系 关系) noexcept {
    switch (关系) {
    case L2特征比较具名关系::当前低于目标: return 0x01U;
    case L2特征比较具名关系::当前达到目标: return 0x02U;
    case L2特征比较具名关系::当前高于目标: return 0x04U;
    default: return std::nullopt;
    }
}

static_assert(目标判断关系位(
    L2特征比较具名关系::当前低于目标) == 0x01U);
static_assert(目标判断关系位(
    L2特征比较具名关系::当前达到目标) == 0x02U);
static_assert(目标判断关系位(
    L2特征比较具名关系::当前高于目标) == 0x04U);

} // namespace 海中鱼巣::运行期只读查询细节

export namespace 海中鱼巣 {

// ===== 运行期只读查询组合器 =====
// 职责：跨 L2 需求/任务/状态/特征正式服务做只读 BIZ 组合；
// 全部读取使用调用方传入的同一共享事实截止 G0，任一结果截止漂移整体漂移。
// 不写事实、不缓存、不持有 L1/仓库端口，仅保存稳定 const 引用。
class 运行期只读查询组合器 final {
public:
    explicit 运行期只读查询组合器(
        const L2需求结构服务& 需求服务,
        const L2任务结构服务& 任务服务,
        const L2状态结构服务& 状态服务,
        const L2特征结构服务& 特征服务,
        const L2存在结构服务& 存在服务,
        const L2场景结构服务& 场景服务,
        const L2动态结构服务& 动态服务) noexcept
        : 需求服务_(需求服务),
          任务服务_(任务服务),
          状态服务_(状态服务),
          特征服务_(特征服务),
          存在服务_(存在服务),
          场景服务_(场景服务),
          动态服务_(动态服务) {}
    运行期只读查询组合器(
        const L2需求结构服务& 需求服务,
        const L2任务结构服务& 任务服务,
        const L2方法结构服务& 方法服务,
        const L2状态结构服务& 状态服务,
        const L2特征结构服务& 特征服务,
        const L2存在结构服务& 存在服务,
        const L2场景结构服务& 场景服务,
        const L2动态结构服务& 动态服务) noexcept
        : 需求服务_(需求服务),
          任务服务_(任务服务),
          方法服务_(std::addressof(方法服务)),
          状态服务_(状态服务),
          特征服务_(特征服务),
          存在服务_(存在服务),
          场景服务_(场景服务),
          动态服务_(动态服务) {}
    运行期只读查询组合器() = delete;
    运行期只读查询组合器(const 运行期只读查询组合器&) = delete;
    运行期只读查询组合器& operator=(const 运行期只读查询组合器&) = delete;
    运行期只读查询组合器(运行期只读查询组合器&&) = delete;
    运行期只读查询组合器& operator=(运行期只读查询组合器&&) = delete;

    // 诊断责任：向上送出；同一 G0 实时裁决一份具名需求，零事实写入。
    需求当前满足裁决结果 裁决需求当前满足(
        const 需求当前满足裁决请求& 请求) const noexcept {
        const auto 失败 = [](需求当前满足裁决状态 状态) noexcept {
            return 需求当前满足裁决结果{状态, std::nullopt};
        };
        const auto 映射结构失败 = [&](L2结构状态 状态,
            需求当前满足裁决状态 缺失状态) noexcept {
            switch (状态) {
            case L2结构状态::未找到:
            case L2结构状态::已退出:
            case L2结构状态::属性未设置:
                return 失败(缺失状态);
            case L2结构状态::事实代次漂移:
                return 失败(需求当前满足裁决状态::当前性漂移);
            case L2结构状态::入口拒绝:
                return 失败(需求当前满足裁决状态::入口拒绝);
            case L2结构状态::许可拒绝:
                return 失败(需求当前满足裁决状态::许可拒绝);
            case L2结构状态::引用冲突:
                return 失败(需求当前满足裁决状态::引用冲突);
            case L2结构状态::资源失败:
            case L2结构状态::数量预算不足:
                return 失败(需求当前满足裁决状态::资源失败);
            default:
                return 失败(需求当前满足裁决状态::内部错误);
            }
        };
        try {
            if (请求.合同版本 != 运行期只读查询合同版本
                || 请求.裁决请求身份 == 0 || !有效(请求.需求.值)
                || 请求.共享事实截止G0 == 0)
                return 失败(需求当前满足裁决状态::入口拒绝);

            const auto G0 = 请求.共享事实截止G0;
            const L2结构请求头 头{L2结构合同版本, G0};
            const auto 需求读取 = 需求服务_.读取需求完整(
                {头, L2读取类别::当前, 请求.需求, 0});
            if (需求读取.结果头.事实截止代次 != G0
                || 需求读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(需求当前满足裁决状态::当前性漂移);
            if (!需求读取.成功() || !需求读取.需求)
                return 映射结构失败(需求读取.结果头.状态,
                    需求当前满足裁决状态::证据不足);
            const auto& 需求事实 = *需求读取.需求;
            if (需求事实.身份 != 请求.需求)
                return 失败(需求当前满足裁决状态::引用冲突);

            const auto 成员读取 = 需求服务_.读取需求成员列表(
                {头, L2读取类别::当前, 请求.需求, 0});
            if (成员读取.结果头.事实截止代次 != G0
                || 成员读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(需求当前满足裁决状态::当前性漂移);
            if (!成员读取.成功())
                return 映射结构失败(成员读取.结果头.状态,
                    需求当前满足裁决状态::内部错误);
            if (!成员读取.当前成员关系)
                return 失败(需求当前满足裁决状态::内部错误);
            const auto& 当前成员关系 = *成员读取.当前成员关系;
            if (当前成员关系.需求 != 请求.需求
                || !有效(当前成员关系.列表项.值))
                return 失败(需求当前满足裁决状态::内部错误);

            const auto 列表项读取 = 需求服务_.读取需求列表项完整(
                {头, L2读取类别::当前, 当前成员关系.列表项, 0});
            if (列表项读取.结果头.事实截止代次 != G0
                || 列表项读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(需求当前满足裁决状态::当前性漂移);
            if (!列表项读取.成功() || !列表项读取.列表项)
                return 映射结构失败(列表项读取.结果头.状态,
                    需求当前满足裁决状态::内部错误);
            const auto& 所属列表项 = *列表项读取.列表项;
            if (所属列表项.身份 != 当前成员关系.列表项)
                return 失败(需求当前满足裁决状态::引用冲突);
            if (需求事实.所属存在 != 所属列表项.所属存在
                || 需求事实.目标宿主存在 != 所属列表项.目标宿主存在
                || 需求事实.目标特征定义 != 所属列表项.目标特征定义
                || 需求事实.目标状态合同 != 所属列表项.目标状态合同)
                return 失败(需求当前满足裁决状态::引用冲突);

            const auto 特征读取 = 特征服务_.按存在读取全部当前特征(
                {头, 需求事实.目标宿主存在});
            if (特征读取.结果头.事实截止代次 != G0
                || 特征读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(需求当前满足裁决状态::当前性漂移);
            if (!特征读取.成功())
                return 映射结构失败(特征读取.结果头.状态,
                    需求当前满足裁决状态::证据不足);
            const L2特征实例事实* 唯一实例 = nullptr;
            std::size_t 匹配实例数 = 0;
            for (const auto& 实例 : 特征读取.特征实例组) {
                if (实例.宿主存在 == 需求事实.目标宿主存在
                    && 实例.特征定义 == 需求事实.目标特征定义) {
                    ++匹配实例数;
                    唯一实例 = std::addressof(实例);
                }
            }
            if (匹配实例数 == 0)
                return 失败(需求当前满足裁决状态::证据不足);
            if (匹配实例数 != 1 || !唯一实例)
                return 失败(需求当前满足裁决状态::内部错误);
            if (!唯一实例->当前值)
                return 失败(需求当前满足裁决状态::证据不足);
            const auto& 当前特征值 = *唯一实例->当前值;
            if (当前特征值.特征实例 != 唯一实例->身份)
                return 失败(需求当前满足裁决状态::引用冲突);
            if (!L2特征值事实截止投影完整(当前特征值, G0)
                || 当前特征值.生命周期.退出事实代次)
                return 失败(需求当前满足裁决状态::内部错误);

            const auto 目标合同读取 = 状态服务_.读取完整目标状态合同(
                {头, L2读取类别::当前, 需求事实.目标状态合同, 0});
            if (目标合同读取.结果头.事实截止代次 != G0
                || 目标合同读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(需求当前满足裁决状态::当前性漂移);
            if (!目标合同读取.成功() || !目标合同读取.合同)
                return 映射结构失败(目标合同读取.结果头.状态,
                    需求当前满足裁决状态::证据不足);
            const auto& 目标合同 = *目标合同读取.合同;

            const auto 比较注册读取 = 特征服务_.读取当前特征比较注册(
                {头, 需求事实.目标特征定义,
                    L2特征比较用途::目标判断});
            if (比较注册读取.结果头.事实截止代次 != G0
                || 比较注册读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(需求当前满足裁决状态::当前性漂移);
            if (!比较注册读取.成功() || !比较注册读取.注册)
                return 映射结构失败(比较注册读取.结果头.状态,
                    需求当前满足裁决状态::不可比较);
            const auto& 比较注册 = *比较注册读取.注册;
            if (目标合同.身份 != 需求事实.目标状态合同
                || 目标合同.特征定义 != 需求事实.目标特征定义
                || 目标合同.比较注册 != 比较注册.身份
                || 目标合同.比较用途 != L2特征比较用途::目标判断
                || 比较注册.特征定义 != 需求事实.目标特征定义
                || 比较注册.合同.用途 != L2特征比较用途::目标判断)
                return 失败(需求当前满足裁决状态::引用冲突);
            if (!std::holds_alternative<std::int64_t>(
                    当前特征值.类型化不可变材料))
                return 失败(需求当前满足裁决状态::不可比较);

            L2特征比较请求 比较请求;
            比较请求.请求头 = 头;
            比较请求.请求身份 = 请求.裁决请求身份;
            比较请求.特征定义 = 需求事实.目标特征定义;
            比较请求.用途 = L2特征比较用途::目标判断;
            比较请求.预期算法族 = 比较注册.合同.算法族;
            比较请求.预期算法版本 = 比较注册.合同.算法版本;
            比较请求.左 = {当前特征值.值稳定编码,
                当前特征值.类型化不可变材料,
                当前特征值.来源稳定编码,
                当前特征值.生命周期.创建事实代次,
                当前特征值.生命周期,
                L2特征比较原始类型::I64, 比较注册.合同.单位,
                比较注册.合同.维度, 比较注册.合同.分量角色,
                L2特征比较角色::当前事实};
            比较请求.右 = {目标合同.目标值稳定编码,
                L2原始值材料{目标合同.目标I64},
                目标合同.来源稳定编码,
                目标合同.生命周期.创建事实代次,
                目标合同.生命周期,
                L2特征比较原始类型::I64, 比较注册.合同.单位,
                比较注册.合同.维度, 比较注册.合同.分量角色,
                L2特征比较角色::目标状态};
            比较请求.要求结果位 =
                static_cast<std::uint8_t>(L2特征比较结果要求::具名关系);
            const auto 比较结果 = 特征服务_.比较特征(比较请求);
            switch (比较结果.状态) {
            case L2特征比较状态::已比较: break;
            case L2特征比较状态::版本漂移:
                return 失败(需求当前满足裁决状态::当前性漂移);
            case L2特征比较状态::未注册:
            case L2特征比较状态::未实现:
                return 失败(需求当前满足裁决状态::不可比较);
            case L2特征比较状态::入口拒绝:
                switch (比较结果.拒绝原因) {
                case L2特征比较拒绝原因::原始类型不匹配:
                case L2特征比较拒绝原因::单位不匹配:
                case L2特征比较拒绝原因::维度不匹配:
                case L2特征比较拒绝原因::左右角色不合法:
                case L2特征比较拒绝原因::值域不允许:
                    return 失败(需求当前满足裁决状态::不可比较);
                default:
                    return 失败(需求当前满足裁决状态::入口拒绝);
                }
            case L2特征比较状态::许可拒绝:
                return 失败(需求当前满足裁决状态::许可拒绝);
            case L2特征比较状态::资源失败:
                return 失败(需求当前满足裁决状态::资源失败);
            case L2特征比较状态::内部不一致:
            default:
                return 失败(需求当前满足裁决状态::内部错误);
            }
            if (!比较结果.成功()
                || 比较结果.请求身份 != 请求.裁决请求身份
                || 比较结果.事实截止代次 != G0
                || 比较结果.注册身份 != 比较注册.身份
                || 比较结果.算法版本 != 比较注册.合同.算法版本
                || 比较结果.实际结果位 != 比较请求.要求结果位
                || !比较结果.具名关系 || 比较结果.排序三态
                || 比较结果.差异材料 || !比较结果.左输入回执
                || !比较结果.右输入回执
                || 比较结果.实际单位 != 比较注册.合同.单位
                || 比较结果.实际维度 != 比较注册.合同.维度
                || 比较结果.实际分量角色 != 比较注册.合同.分量角色
                || 比较结果.实际左角色 != L2特征比较角色::当前事实
                || 比较结果.实际右角色 != L2特征比较角色::目标状态
                || 比较结果.左输入回执->事实身份 != 比较请求.左.事实身份
                || 比较结果.左输入回执->来源稳定编码
                    != 比较请求.左.来源稳定编码
                || 比较结果.左输入回执->输入版本 != 比较请求.左.输入版本
                || 比较结果.左输入回执->创建事实代次
                    != 比较请求.左.生命周期.创建事实代次
                || 比较结果.右输入回执->事实身份 != 比较请求.右.事实身份
                || 比较结果.右输入回执->来源稳定编码
                    != 比较请求.右.来源稳定编码
                || 比较结果.右输入回执->输入版本 != 比较请求.右.输入版本
                || 比较结果.右输入回执->创建事实代次
                    != 比较请求.右.生命周期.创建事实代次)
                return 失败(需求当前满足裁决状态::内部错误);
            const auto 关系位 = 运行期只读查询细节::目标判断关系位(
                *比较结果.具名关系);
            if (!关系位)
                return 失败(需求当前满足裁决状态::不可比较);

            需求当前满足裁决快照 裁决;
            裁决.裁决请求身份 = 请求.裁决请求身份;
            裁决.需求事实 = 需求事实;
            裁决.当前成员关系 = 当前成员关系;
            裁决.所属列表项 = 所属列表项;
            裁决.当前特征实例 = *唯一实例;
            裁决.当前特征值 = 当前特征值;
            裁决.目标合同 = 目标合同;
            裁决.比较注册 = 比较结果.注册身份;
            裁决.比较算法版本 = 比较结果.算法版本;
            裁决.具名关系 = *比较结果.具名关系;
            裁决.允许关系位 = 目标合同.允许关系位;
            裁决.事实截止代次 = G0;
            const bool 已满足 = (目标合同.允许关系位 & *关系位) != 0;
            return {已满足 ? 需求当前满足裁决状态::已满足
                    : 需求当前满足裁决状态::未满足,
                std::move(裁决)};
        } catch (const std::bad_alloc&) {
            return 失败(需求当前满足裁决状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(需求当前满足裁决状态::资源失败);
        } catch (...) {
            return 失败(需求当前满足裁决状态::内部错误);
        }
    }

    // ===== BIZ-L3-002-02-02 读取本能根当前快照 =====
    本能根当前快照结果 读取本能根当前快照(
        const 本能根当前快照请求& 请求) const noexcept {
        try {
            if (请求.合同版本 != 运行期只读查询合同版本)
                return {本能根当前快照状态::请求拒绝};
            if (请求.运行代次 == 0 || 请求.事实范围版本 == 0
                || !有效(请求.唯一自我.值)
                || 请求.共享事实截止G0 == 0
                || !有效(请求.安全根特征定义.值)
                || !有效(请求.服务根特征定义.值)
                || 请求.安全根特征定义 == 请求.服务根特征定义)
                return {本能根当前快照状态::请求拒绝};
            const auto G0 = 请求.共享事实截止G0;
            const L2结构请求头 L2头{L2结构合同版本, G0};

            const auto 特征结果 = 特征服务_.按存在读取全部当前特征(
                L2按存在当前特征读取请求{L2头, 请求.唯一自我});
            if (特征结果.结果头.事实截止代次 != 0
                && 特征结果.结果头.事实截止代次 != G0)
                return {本能根当前快照状态::当前性漂移};
            if (特征结果.结果头.状态 == L2结构状态::资源失败)
                return {本能根当前快照状态::资源失败};
            if (!特征结果.成功())
                return {特征结果.结果头.状态 == L2结构状态::未找到
                        || 特征结果.结果头.状态 == L2结构状态::属性未设置
                    ? 本能根当前快照状态::材料缺失
                    : 本能根当前快照状态::尚无权威};

            std::optional<L2特征实例身份> 安全根实例;
            std::optional<L2特征实例身份> 服务根实例;
            for (const auto& 实例 : 特征结果.特征实例组) {
                if (实例.特征定义 == 请求.安全根特征定义) {
                    if (安全根实例)
                        return {本能根当前快照状态::内部不一致};
                    安全根实例 = 实例.身份;
                } else if (实例.特征定义 == 请求.服务根特征定义) {
                    if (服务根实例)
                        return {本能根当前快照状态::内部不一致};
                    服务根实例 = 实例.身份;
                }
            }
            if (!安全根实例 || !服务根实例)
                return {本能根当前快照状态::材料缺失};

            const auto 安全值结果 = 特征服务_.读取特征当前值(
                L2特征当前值读取请求{L2头, *安全根实例});
            if (安全值结果.结果头.事实截止代次 != 0
                && 安全值结果.结果头.事实截止代次 != G0)
                return {本能根当前快照状态::当前性漂移};
            if (安全值结果.结果头.状态 == L2结构状态::资源失败)
                return {本能根当前快照状态::资源失败};
            if (!安全值结果.成功() || !安全值结果.当前值)
                return {本能根当前快照状态::尚无权威};
            const auto* 安全I64组 = std::get_if<std::vector<std::int64_t>>(
                &安全值结果.当前值->类型化不可变材料);
            if (!安全I64组 || 安全I64组->size() != 3)
                return {本能根当前快照状态::材料缺失};
            生存安全根当前值 安全根{
                (*安全I64组)[0], (*安全I64组)[1], (*安全I64组)[2]};
            if (安全根.A == 0) 安全根.控制态 = 生存安全控制态::终止;
            else if (安全根.A == 1) 安全根.控制态 = 生存安全控制态::休眠;
            else 安全根.控制态 = 生存安全控制态::主动运行;
            if (!(安全根.L > 1 && 安全根.L < 安全根.H))
                return {本能根当前快照状态::内部不一致};

            const auto 服务值结果 = 特征服务_.读取特征当前值(
                L2特征当前值读取请求{L2头, *服务根实例});
            if (服务值结果.结果头.事实截止代次 != 0
                && 服务值结果.结果头.事实截止代次 != G0)
                return {本能根当前快照状态::当前性漂移};
            if (服务值结果.结果头.状态 == L2结构状态::资源失败)
                return {本能根当前快照状态::资源失败};
            if (!服务值结果.成功() || !服务值结果.当前值)
                return {本能根当前快照状态::尚无权威};
            const auto* 服务根当前值 = std::get_if<std::int64_t>(
                &服务值结果.当前值->类型化不可变材料);
            if (!服务根当前值)
                return {本能根当前快照状态::材料缺失};

            本能根当前快照 快照;
            快照.安全根 = std::move(安全根);
            快照.服务根当前值 = *服务根当前值;
            快照.事实截止代次 = G0;
            return {本能根当前快照状态::已形成, std::move(快照)};
        } catch (const std::bad_alloc&) {
            return {本能根当前快照状态::资源失败};
        } catch (...) {
            return {本能根当前快照状态::内部不一致};
        }
    }

    // ===== BIZ-L3-002-02-03 读取需求结构与任务后继快照 =====
    需求任务快照结果 读取需求结构与任务后继快照(
        const 需求任务快照请求& 请求) const noexcept {
        try {
            if (请求.合同版本 != 运行期只读查询合同版本)
                return {需求任务快照状态::请求拒绝};
            if (请求.运行代次 == 0 || 请求.事实范围版本 == 0
                || !有效(请求.唯一自我.值)
                || 请求.共享事实截止G0 == 0)
                return {需求任务快照状态::请求拒绝};
            if (请求.最大根需求数 == 0
                || 请求.最大需求节点数 == 0
                || 请求.最大需求结构深度 == 0)
                return {需求任务快照状态::请求拒绝};
            const auto G0 = 请求.共享事实截止G0;
            const L2结构请求头 L2头{L2结构合同版本, G0};
            const auto 映射结构失败 = [&](L2结构状态 状态,
                bool 后继) noexcept {
                if (状态 == L2结构状态::事实代次漂移)
                    return 需求任务快照状态::当前性漂移;
                if (状态 == L2结构状态::数量预算不足)
                    return 需求任务快照状态::数量预算不足;
                if (状态 == L2结构状态::资源失败)
                    return 需求任务快照状态::资源失败;
                if (!后继 && (状态 == L2结构状态::未找到
                    || 状态 == L2结构状态::已退出))
                    return 需求任务快照状态::材料缺失;
                return 需求任务快照状态::内部不一致;
            };
            const auto 检查截止 = [&](const L2结构结果头& 头)
                noexcept -> bool {
                return 头.事实截止代次 == G0 && !头.变更事实代次;
            };

            L2按所属存在读取当前根需求组请求 根请求;
            根请求.请求头 = L2头;
            根请求.所属存在 = 请求.唯一自我;
            根请求.数量预算 = 请求.最大根需求数;
            const auto 根结果 = 需求服务_.按所属存在读取当前根需求组(根请求);
            if (!检查截止(根结果.结果头))
                return {需求任务快照状态::当前性漂移};
            if (!根结果.成功())
                return {映射结构失败(根结果.结果头.状态, false)};

            需求结构与任务后继快照 快照;
            快照.根需求组 = 根结果.根需求组;
            if (快照.根需求组.empty()) {
                快照.事实截止代次 = G0;
                return {需求任务快照状态::已形成, std::move(快照)};
            }

            struct 待展开需求 final {
                L2需求身份 需求;
                std::optional<L2需求父子关系事实> 期望父关系;
                std::uint64_t 深度 = 0;
            };
            std::vector<待展开需求> 待展开;
            for (const auto& 根 : 快照.根需求组) {
                if (根.所属存在 != 请求.唯一自我)
                    return {需求任务快照状态::内部不一致};
                待展开.push_back({根.身份, std::nullopt, 1});
            }
            std::vector<L2需求列表项身份> 列表项身份组;
            std::size_t 下一个 = 0;
            while (下一个 < 待展开.size()) {
                const auto 当前 = 待展开[下一个++];
                if (当前.深度 > 请求.最大需求结构深度
                    || 快照.当前需求结构组.size()
                        >= 请求.最大需求节点数)
                    return {需求任务快照状态::数量预算不足};
                for (const auto& 已有 : 快照.当前需求结构组) {
                    if (已有.需求.身份 == 当前.需求)
                        return {需求任务快照状态::内部不一致};
                }
                L2需求完整读取请求 完整请求;
                完整请求.请求头 = L2头;
                完整请求.读取类别 = L2读取类别::当前;
                完整请求.需求 = 当前.需求;
                const auto 完整结果 = 需求服务_.读取需求完整(完整请求);
                if (!检查截止(完整结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!完整结果.成功() || !完整结果.需求
                    || 完整结果.需求->所属存在 != 请求.唯一自我)
                    return {映射结构失败(完整结果.结果头.状态, true)};

                L2按子需求读取当前父需求请求 父请求;
                父请求.请求头 = L2头;
                父请求.子需求 = 当前.需求;
                const auto 父结果 = 需求服务_.按子需求读取当前父需求(父请求);
                if (!检查截止(父结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!父结果.成功())
                    return {映射结构失败(父结果.结果头.状态, true)};
                if (!当前.期望父关系) {
                    if (父结果.当前父关系 || 父结果.父需求)
                        return {需求任务快照状态::内部不一致};
                } else if (!父结果.当前父关系 || !父结果.父需求
                    || *父结果.当前父关系 != *当前.期望父关系
                    || 父结果.父需求->身份 != 当前.期望父关系->父需求
                    || 父结果.父需求->所属存在 != 请求.唯一自我) {
                    return {需求任务快照状态::内部不一致};
                }

                L2需求成员列表读取请求 成员请求;
                成员请求.请求头 = L2头;
                成员请求.读取类别 = L2读取类别::当前;
                成员请求.需求 = 当前.需求;
                const auto 成员结果 = 需求服务_.读取需求成员列表(成员请求);
                if (!检查截止(成员结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!成员结果.成功() || !成员结果.当前成员关系
                    || !成员结果.所属列表项)
                    return {映射结构失败(成员结果.结果头.状态, true)};
                if (成员结果.当前成员关系->需求 != 当前.需求
                    || 成员结果.当前成员关系->列表项
                        != 成员结果.所属列表项->身份)
                    return {需求任务快照状态::内部不一致};
                快照.当前需求结构组.push_back({*完整结果.需求,
                    父结果.当前父关系, *成员结果.当前成员关系, G0});
                bool 列表项已登记 = false;
                for (const auto& 已有列表项 : 列表项身份组) {
                    if (已有列表项 == 成员结果.所属列表项->身份) {
                        列表项已登记 = true;
                        break;
                    }
                }
                if (!列表项已登记)
                    列表项身份组.push_back(成员结果.所属列表项->身份);

                L2需求直接子读取请求 子请求;
                子请求.请求头 = L2头;
                子请求.读取类别 = L2读取类别::当前;
                子请求.父需求 = 当前.需求;
                const auto 子结果 = 需求服务_.读取需求直接子(子请求);
                if (!检查截止(子结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!子结果.成功())
                    return {映射结构失败(子结果.结果头.状态, true)};
                if (子结果.直接子关系组.size() != 子结果.直接子需求组.size())
                    return {需求任务快照状态::内部不一致};
                for (const auto& 关系 : 子结果.直接子关系组) {
                    if (关系.父需求 != 当前.需求
                        || !有效(关系.子需求.值))
                        return {需求任务快照状态::内部不一致};
                    待展开.push_back({关系.子需求, 关系, 当前.深度 + 1});
                }
            }

            std::sort(快照.当前需求结构组.begin(), 快照.当前需求结构组.end(),
                [](const 需求当前结构项& 左, const 需求当前结构项& 右) noexcept {
                    return 左.需求.身份.值 < 右.需求.身份.值;
                });
            std::sort(列表项身份组.begin(), 列表项身份组.end(),
                [](const L2需求列表项身份& 左, const L2需求列表项身份& 右) noexcept {
                    return 左.值 < 右.值;
                });
            for (std::size_t 索引 = 1; 索引 < 列表项身份组.size(); ++索引) {
                if (列表项身份组[索引 - 1] == 列表项身份组[索引])
                    return {需求任务快照状态::内部不一致};
            }
            for (const auto& 列表项身份 : 列表项身份组) {
                L2需求列表项完整读取请求 列表项请求;
                列表项请求.请求头 = L2头;
                列表项请求.读取类别 = L2读取类别::当前;
                列表项请求.列表项 = 列表项身份;
                const auto 列表项结果 = 需求服务_.读取需求列表项完整(列表项请求);
                if (!检查截止(列表项结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!列表项结果.成功() || !列表项结果.列表项)
                    return {映射结构失败(列表项结果.结果头.状态, true)};
                for (const auto& 需求项 : 快照.当前需求结构组) {
                    if (需求项.当前列表成员关系.列表项 != 列表项身份)
                        continue;
                    const auto& 列表项 = *列表项结果.列表项;
                    if (列表项.所属存在 != 需求项.需求.所属存在
                        || 列表项.目标宿主存在 != 需求项.需求.目标宿主存在
                        || 列表项.目标特征定义 != 需求项.需求.目标特征定义
                        || 列表项.目标状态合同 != 需求项.需求.目标状态合同)
                        return {需求任务快照状态::内部不一致};
                }
                L2按需求列表项读取当前任务请求 任务请求;
                任务请求.请求头 = L2头;
                任务请求.需求列表项 = 列表项身份;
                const auto 任务结果 = 任务服务_.按需求列表项读取当前任务(任务请求);
                if (!检查截止(任务结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!任务结果.成功())
                    return {映射结构失败(任务结果.结果头.状态, true)};
                if (任务结果.任务 && 任务结果.任务->需求列表项 != 列表项身份)
                    return {需求任务快照状态::内部不一致};
                快照.列表任务后继组.push_back({*列表项结果.列表项,
                    任务结果.任务, G0});
            }
            快照.事实截止代次 = G0;
            return {需求任务快照状态::已形成, std::move(快照)};
        } catch (const std::bad_alloc&) {
            return {需求任务快照状态::资源失败};
        } catch (...) {
            return {需求任务快照状态::内部不一致};
        }
    }

    // 任务实际结果 provider 的入口首先固定调用方 G0，绝不在组合器内重新取代次。
    // 后续各公共子读只要截止不等 G0 就必须零快照返回当前性漂移。
    任务实际结果独立读回结果 读取任务本轮实际结果与独立读回(
        const 任务实际结果独立读回请求& 请求) const noexcept {
        try {
            if (请求.合同版本 != 运行期只读查询合同版本
                || !有效(请求.任务.值) || 请求.执行轮次 == 0
                || !有效(请求.方法.值) || !有效(请求.动作入口.值)
                || !有效(请求.场景.值) || !有效(请求.主体.值)
                || !有效(请求.实际状态.值) || !有效(请求.动态证据.值)
                || 请求.来源材料版本 == 0 || 请求.运行代次 == 0
                || 请求.共享事实截止G0 == 0 || 请求.最大需求成员数 == 0)
                return {任务实际结果独立读回状态::请求拒绝};
            const auto G0 = 请求.共享事实截止G0;
            L2按任务与执行轮次读取实际结果请求 结果请求;
            结果请求.请求头 = {L2结构合同版本, G0};
            结果请求.读取类别 = L2读取类别::当前;
            结果请求.任务 = 请求.任务;
            结果请求.执行轮次 = 请求.执行轮次;
            const auto 结果读取 = 任务服务_.按任务与执行轮次读取实际结果(结果请求);
            if (结果读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (结果读取.结果头.状态 != L2结构状态::已读取)
                return {结果读取.结果头.状态 == L2结构状态::资源失败
                    ? 任务实际结果独立读回状态::资源失败
                    : 任务实际结果独立读回状态::内部不一致};
            if (!结果读取.实际结果)
                return {任务实际结果独立读回状态::尚未形成};
            const auto& 结果 = *结果读取.实际结果;
            if (结果.任务 != 请求.任务 || 结果.执行轮次 != 请求.执行轮次)
                return {任务实际结果独立读回状态::轮次不匹配};
            if (结果.方法 != 请求.方法 || 结果.动作入口 != 请求.动作入口
                || 结果.场景 != 请求.场景 || 结果.主体 != 请求.主体
                || 结果.实际状态 != 请求.实际状态 || 结果.动态证据 != 请求.动态证据
                || 结果.来源材料版本 != 请求.来源材料版本
                || 结果.运行代次 != 请求.运行代次)
                return {任务实际结果独立读回状态::引用冲突};
            const L2结构请求头 L2头{L2结构合同版本, G0};
            const auto 实例读取 = 任务服务_.读取实例方法({L2头,L2读取类别::当前,结果.实例方法});
            if (实例读取.结果头.事实截止代次 != G0) return {任务实际结果独立读回状态::当前性漂移};
            if (!实例读取.实例方法) return {任务实际结果独立读回状态::内部不一致};
            const auto 路径读取 = 任务服务_.读取任务方法路径({L2头,L2读取类别::当前,实例读取.实例方法->当前选中路径});
            if (路径读取.结果头.事实截止代次 != G0) return {任务实际结果独立读回状态::当前性漂移};
            if (!路径读取.路径) return {任务实际结果独立读回状态::内部不一致};
            const auto 任务读取 = 任务服务_.读取任务({L2头,L2读取类别::当前,请求.任务});
            if (任务读取.结果头.事实截止代次 != G0) return {任务实际结果独立读回状态::当前性漂移};
            if (!任务读取.任务) return {任务实际结果独立读回状态::内部不一致};
            if (!实例读取.成功() || 实例读取.实例方法->身份 != 结果.实例方法
                || 实例读取.实例方法->任务 != 结果.任务
                || 实例读取.实例方法->执行轮次 != 结果.执行轮次
                || 实例读取.实例方法->来源方法 != 结果.方法)
                return {任务实际结果独立读回状态::引用冲突};
            if (!路径读取.成功() || 路径读取.路径->身份
                    != 实例读取.实例方法->当前选中路径
                || 路径读取.路径->任务 != 结果.任务
                || 路径读取.路径->来源方法 != 结果.方法
                || 路径读取.路径->筹办轮次 != 实例读取.实例方法->筹办轮次
                || 路径读取.路径->来源方法内容版本
                    != 实例读取.实例方法->来源方法内容版本
                || 路径读取.路径->完整路径材料.动作入口 != 结果.动作入口.值)
                return {任务实际结果独立读回状态::引用冲突};
            if (!任务读取.成功() || 任务读取.任务->身份 != 结果.任务)
                return {任务实际结果独立读回状态::内部不一致};

            const auto 状态读取 = 状态服务_.读取完整状态(
                {L2头, L2读取类别::当前, 结果.实际状态, 0});
            if (状态读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (状态读取.结果头.状态 != L2结构状态::已读取
                || 状态读取.结果头.变更事实代次 || !状态读取.状态
                || 状态读取.状态->身份 != 结果.实际状态
                || 状态读取.状态->主体存在 != 结果.主体)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 动态读取 = 动态服务_.读取完整动态(
                {L2头, L2读取类别::当前, 结果.动态证据, 0});
            if (动态读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (动态读取.结果头.状态 != L2结构状态::已读取
                || 动态读取.结果头.变更事实代次 || !动态读取.动态
                || 动态读取.动态->身份 != 结果.动态证据
                || 动态读取.动态->主体存在 != 结果.主体
                || 动态读取.动态->后状态 != 结果.实际状态)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 场景读取 = 场景服务_.读取完整场景(
                {L2头, L2读取类别::当前, 结果.场景, 0});
            if (场景读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (场景读取.结果头.状态 != L2结构状态::已读取
                || 场景读取.结果头.变更事实代次 || !场景读取.场景
                || 场景读取.场景->身份 != 结果.场景)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 主体读取 = 存在服务_.读取完整存在(
                {L2头, L2读取类别::当前, 结果.主体, 0});
            if (主体读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (主体读取.结果头.状态 != L2结构状态::已读取
                || 主体读取.结果头.变更事实代次 || !主体读取.存在
                || 主体读取.存在->身份 != 结果.主体)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 成员引用读取 = 场景服务_.读取存在当前场景成员引用(
                {L2头, 结果.主体});
            if (成员引用读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (!成员引用读取.成功())
                return {任务实际结果独立读回状态::内部不一致};
            const bool 场景包含主体 = std::any_of(
                成员引用读取.引用.begin(), 成员引用读取.引用.end(),
                [&](const L2存在场景成员引用事实& 引用) noexcept {
                    return 引用.场景 == 结果.场景 && 引用.存在 == 结果.主体
                        && !引用.生命周期.退出事实代次;
                });
            if (!场景包含主体)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 列表项读取 = 需求服务_.读取需求列表项完整(
                {L2头, L2读取类别::当前, 任务读取.任务->需求列表项, 0});
            if (列表项读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (!列表项读取.成功() || !列表项读取.列表项
                || 列表项读取.列表项->身份 != 任务读取.任务->需求列表项)
                return {任务实际结果独立读回状态::内部不一致};

            const auto 成员组读取 = 需求服务_.读取需求列表成员(
                {L2头, L2读取类别::当前, 任务读取.任务->需求列表项, 0});
            if (成员组读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (!成员组读取.成功()
                || 成员组读取.成员关系组.size() != 成员组读取.成员需求组.size()
                || 成员组读取.成员关系组.empty())
                return {任务实际结果独立读回状态::内部不一致};
            if (成员组读取.成员关系组.size() > 请求.最大需求成员数)
                return {任务实际结果独立读回状态::数量预算不足};

            struct 成员项 final {
                L2需求列表成员关系事实 关系;
                L2需求事实 需求;
            };
            std::vector<成员项> 成员项组;
            成员项组.reserve(成员组读取.成员关系组.size());
            for (std::size_t 索引 = 0; 索引 < 成员组读取.成员关系组.size(); ++索引) {
                const auto& 关系 = 成员组读取.成员关系组[索引];
                const auto& 需求 = 成员组读取.成员需求组[索引];
                if (关系.列表项 != 任务读取.任务->需求列表项
                    || 关系.需求 != 需求.身份)
                    return {任务实际结果独立读回状态::内部不一致};
                const auto 完整需求读取 = 需求服务_.读取需求完整(
                    {L2头, L2读取类别::当前, 需求.身份, 0});
                if (完整需求读取.结果头.事实截止代次 != G0)
                    return {任务实际结果独立读回状态::当前性漂移};
                if (!完整需求读取.成功() || !完整需求读取.需求
                    || 完整需求读取.需求->身份 != 关系.需求)
                    return {任务实际结果独立读回状态::内部不一致};
                成员项组.push_back({关系, *完整需求读取.需求});
            }
            std::sort(成员项组.begin(), 成员项组.end(),
                [](const 成员项& 左, const 成员项& 右) noexcept {
                    return 左.需求.身份.值 < 右.需求.身份.值;
                });
            for (std::size_t 索引 = 1; 索引 < 成员项组.size(); ++索引) {
                if (成员项组[索引 - 1].需求.身份 == 成员项组[索引].需求.身份)
                    return {任务实际结果独立读回状态::内部不一致};
            }

            任务实际结果独立读回快照 快照;
            快照.结果 = 结果;
            快照.实例方法 = *实例读取.实例方法;
            快照.选中路径 = *路径读取.路径;
            快照.任务 = *任务读取.任务;
            快照.状态 = *状态读取.状态;
            快照.动态 = *动态读取.动态;
            快照.场景 = *场景读取.场景;
            快照.主体 = *主体读取.存在;
            快照.需求列表项 = *列表项读取.列表项;
            快照.来源成员关系组.reserve(成员项组.size());
            快照.来源需求组.reserve(成员项组.size());
            for (auto& 成员项 : 成员项组) {
                快照.来源成员关系组.push_back(std::move(成员项.关系));
                快照.来源需求组.push_back(std::move(成员项.需求));
            }
            快照.事实截止代次 = G0;
            return {任务实际结果独立读回状态::已形成, std::move(快照)};
        } catch (const std::bad_alloc&) {
            return {任务实际结果独立读回状态::资源失败};
        } catch (...) {
            return {任务实际结果独立读回状态::内部不一致};
        }
    }

    // 诊断责任：向上送出；只读组合正式任务结果、目标和比较合同，零事实写入。
    任务目标达成裁决结果 裁决任务目标达成(
        const 任务目标达成裁决请求& 请求) const noexcept {
        const auto 失败 = [](任务目标达成裁决状态 状态) noexcept {
            return 任务目标达成裁决结果{状态, std::nullopt};
        };
        try {
            if (请求.合同版本 != 运行期只读查询合同版本
                || 请求.治理输入幂等键 == 0 || !有效(请求.任务.值)
                || !有效(请求.实例方法.值) || 请求.执行轮次 == 0
                || !有效(请求.任务实际结果.值)
                || 请求.共享事实截止G0 == 0 || !方法服务_)
                return 失败(任务目标达成裁决状态::入口拒绝);

            const auto G0 = 请求.共享事实截止G0;
            const L2结构请求头 头{L2结构合同版本, G0};
            const auto 正式结果读取 = 任务服务_.读取任务实际结果(
                {头, L2读取类别::当前, 请求.任务实际结果, 0});
            if (正式结果读取.结果头.事实截止代次 != G0)
                return 失败(任务目标达成裁决状态::当前性漂移);
            if (正式结果读取.结果头.状态 == L2结构状态::未找到
                || 正式结果读取.结果头.状态 == L2结构状态::已退出
                || (正式结果读取.结果头.状态 == L2结构状态::已读取
                    && !正式结果读取.实际结果))
                return 失败(任务目标达成裁决状态::合法等待);
            if (正式结果读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(任务目标达成裁决状态::当前性漂移);
            if (正式结果读取.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务目标达成裁决状态::资源失败);
            if (正式结果读取.结果头.状态 == L2结构状态::入口拒绝
                || 正式结果读取.结果头.状态 == L2结构状态::许可拒绝)
                return 失败(任务目标达成裁决状态::入口拒绝);
            if (!正式结果读取.成功() || !正式结果读取.实际结果)
                return 失败(任务目标达成裁决状态::内部错误);
            const auto& 正式结果 = *正式结果读取.实际结果;
            if (正式结果.身份 != 请求.任务实际结果
                || 正式结果.任务 != 请求.任务
                || 正式结果.实例方法 != 请求.实例方法
                || 正式结果.执行轮次 != 请求.执行轮次)
                return 失败(任务目标达成裁决状态::引用冲突);

            任务实际结果独立读回请求 读回请求;
            读回请求.任务 = 正式结果.任务;
            读回请求.执行轮次 = 正式结果.执行轮次;
            读回请求.方法 = 正式结果.方法;
            读回请求.动作入口 = 正式结果.动作入口;
            读回请求.场景 = 正式结果.场景;
            读回请求.主体 = 正式结果.主体;
            读回请求.实际状态 = 正式结果.实际状态;
            读回请求.动态证据 = 正式结果.动态证据;
            读回请求.来源材料版本 = 正式结果.来源材料版本;
            读回请求.运行代次 = 正式结果.运行代次;
            读回请求.共享事实截止G0 = G0;
            读回请求.最大需求成员数 =
                (std::numeric_limits<std::uint64_t>::max)();
            const auto 读回 = 读取任务本轮实际结果与独立读回(读回请求);
            switch (读回.状态) {
            case 任务实际结果独立读回状态::已形成: break;
            case 任务实际结果独立读回状态::尚未形成:
                return 失败(任务目标达成裁决状态::合法等待);
            case 任务实际结果独立读回状态::当前性漂移:
                return 失败(任务目标达成裁决状态::当前性漂移);
            case 任务实际结果独立读回状态::轮次不匹配:
            case 任务实际结果独立读回状态::引用冲突:
                return 失败(任务目标达成裁决状态::引用冲突);
            case 任务实际结果独立读回状态::请求拒绝:
                return 失败(任务目标达成裁决状态::入口拒绝);
            case 任务实际结果独立读回状态::资源失败:
                return 失败(任务目标达成裁决状态::资源失败);
            case 任务实际结果独立读回状态::数量预算不足:
            case 任务实际结果独立读回状态::内部不一致:
            default:
                return 失败(任务目标达成裁决状态::内部错误);
            }
            if (!读回.快照 || 读回.快照->事实截止代次 != G0
                || 读回.快照->结果 != 正式结果)
                return 失败(任务目标达成裁决状态::内部错误);
            const auto& 快照 = *读回.快照;

            const auto 方法读取 = 方法服务_->读取普通方法(
                {头, L2普通方法结构合同版本, L2读取类别::当前,
                    正式结果.方法, 0});
            if (方法读取.结果头.事实截止代次 != G0
                || 方法读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(任务目标达成裁决状态::当前性漂移);
            if (方法读取.结果头.状态 == L2结构状态::未找到
                || 方法读取.结果头.状态 == L2结构状态::已退出
                || (方法读取.结果头.状态 == L2结构状态::已读取
                    && !方法读取.方法))
                return 失败(任务目标达成裁决状态::合法等待);
            if (方法读取.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务目标达成裁决状态::资源失败);
            if (!方法读取.成功() || !方法读取.方法)
                return 失败(任务目标达成裁决状态::内部错误);
            const auto& 方法 = *方法读取.方法;
            if (方法.方法 != 正式结果.方法
                || 方法.内容版本.值 == 0
                || 方法.内容版本.值 != 快照.实例方法.来源方法内容版本.值)
                return 失败(任务目标达成裁决状态::引用冲突);

            const auto 特征实例读取 = 特征服务_.读取完整特征实例(
                {头, L2读取类别::当前, 快照.状态.特征实例, 0});
            if (特征实例读取.结果头.事实截止代次 != G0
                || 特征实例读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(任务目标达成裁决状态::当前性漂移);
            if (特征实例读取.结果头.状态 == L2结构状态::未找到
                || 特征实例读取.结果头.状态 == L2结构状态::已退出)
                return 失败(任务目标达成裁决状态::合法等待);
            if (特征实例读取.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务目标达成裁决状态::资源失败);
            if (特征实例读取.结果头.状态 != L2结构状态::已读取
                || !特征实例读取.特征实例)
                return 失败(任务目标达成裁决状态::内部错误);
            const auto& 特征实例 = *特征实例读取.特征实例;

            const auto 目标合同读取 = 状态服务_.读取完整目标状态合同(
                {头, L2读取类别::当前, 快照.需求列表项.目标状态合同, 0});
            if (目标合同读取.结果头.事实截止代次 != G0
                || 目标合同读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(任务目标达成裁决状态::当前性漂移);
            if (目标合同读取.结果头.状态 == L2结构状态::未找到
                || 目标合同读取.结果头.状态 == L2结构状态::已退出
                || (目标合同读取.结果头.状态 == L2结构状态::已读取
                    && !目标合同读取.合同))
                return 失败(任务目标达成裁决状态::合法等待);
            if (目标合同读取.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务目标达成裁决状态::资源失败);
            if (!目标合同读取.成功() || !目标合同读取.合同)
                return 失败(任务目标达成裁决状态::内部错误);
            const auto& 目标合同 = *目标合同读取.合同;

            const auto 比较注册读取 = 特征服务_.读取当前特征比较注册(
                {头, 快照.需求列表项.目标特征定义,
                    L2特征比较用途::目标判断});
            if (比较注册读取.结果头.事实截止代次 != G0
                || 比较注册读取.结果头.状态 == L2结构状态::事实代次漂移)
                return 失败(任务目标达成裁决状态::当前性漂移);
            if (比较注册读取.结果头.状态 == L2结构状态::未找到
                || 比较注册读取.结果头.状态 == L2结构状态::已退出
                || (比较注册读取.结果头.状态 == L2结构状态::已读取
                    && !比较注册读取.注册))
                return 失败(任务目标达成裁决状态::不可比较);
            if (比较注册读取.结果头.状态 == L2结构状态::资源失败)
                return 失败(任务目标达成裁决状态::资源失败);
            if (!比较注册读取.成功() || !比较注册读取.注册)
                return 失败(任务目标达成裁决状态::内部错误);
            const auto& 比较注册 = *比较注册读取.注册;

            std::size_t 预期结果命中数 = 0;
            for (const auto& 结果项 : 方法.结果) {
                const auto* 目标状态结果 =
                    std::get_if<L2目标状态合同身份>(&结果项.结果类型);
                if (结果项.来源稳定编码 == 快照.选中路径.完整路径材料.预期结果
                    && 结果项.特征定义 == 快照.需求列表项.目标特征定义
                    && 目标状态结果
                    && *目标状态结果 == 快照.需求列表项.目标状态合同)
                    ++预期结果命中数;
            }
            if (预期结果命中数 != 1)
                return 失败(任务目标达成裁决状态::内部错误);
            if (快照.任务.需求列表项 != 快照.需求列表项.身份
                || 快照.状态.身份 != 正式结果.实际状态
                || 快照.状态.主体存在 != 快照.需求列表项.目标宿主存在
                || 特征实例.身份 != 快照.状态.特征实例
                || 特征实例.宿主存在 != 快照.需求列表项.目标宿主存在
                || 特征实例.特征定义 != 快照.需求列表项.目标特征定义
                || 快照.动态.身份 != 正式结果.动态证据
                || 快照.动态.主体存在 != 快照.状态.主体存在
                || 快照.动态.后状态 != 快照.状态.身份
                || 目标合同.身份 != 快照.需求列表项.目标状态合同
                || 目标合同.特征定义 != 快照.需求列表项.目标特征定义
                || 目标合同.比较注册 != 比较注册.身份
                || 目标合同.比较用途 != L2特征比较用途::目标判断
                || 比较注册.特征定义 != 快照.需求列表项.目标特征定义
                || 比较注册.合同.用途 != L2特征比较用途::目标判断)
                return 失败(任务目标达成裁决状态::引用冲突);
            if (!std::holds_alternative<std::int64_t>(
                    快照.状态.精确值.类型化不可变材料))
                return 失败(任务目标达成裁决状态::不可比较);

            L2特征比较请求 比较请求;
            比较请求.请求头 = 头;
            比较请求.请求身份 = 请求.治理输入幂等键;
            比较请求.特征定义 = 快照.需求列表项.目标特征定义;
            比较请求.用途 = L2特征比较用途::目标判断;
            比较请求.预期算法族 = 比较注册.合同.算法族;
            比较请求.预期算法版本 = 比较注册.合同.算法版本;
            比较请求.左 = {快照.状态.精确值.值稳定编码,
                快照.状态.精确值.类型化不可变材料,
                快照.状态.精确值.来源稳定编码,
                快照.状态.精确值.创建事实代次,
                {快照.状态.精确值.创建事实代次,
                    快照.状态.精确值.退出事实代次},
                L2特征比较原始类型::I64, 比较注册.合同.单位,
                比较注册.合同.维度, 比较注册.合同.分量角色,
                L2特征比较角色::当前事实};
            比较请求.右 = {目标合同.目标值稳定编码,
                L2原始值材料{目标合同.目标I64}, 目标合同.来源稳定编码,
                目标合同.生命周期.创建事实代次, 目标合同.生命周期,
                L2特征比较原始类型::I64, 比较注册.合同.单位,
                比较注册.合同.维度, 比较注册.合同.分量角色,
                L2特征比较角色::目标状态};
            比较请求.要求结果位 =
                static_cast<std::uint8_t>(L2特征比较结果要求::具名关系);
            const auto 比较结果 = 特征服务_.比较特征(比较请求);
            switch (比较结果.状态) {
            case L2特征比较状态::已比较: break;
            case L2特征比较状态::版本漂移:
                return 失败(任务目标达成裁决状态::当前性漂移);
            case L2特征比较状态::未注册:
            case L2特征比较状态::未实现:
                return 失败(任务目标达成裁决状态::不可比较);
            case L2特征比较状态::入口拒绝:
                switch (比较结果.拒绝原因) {
                case L2特征比较拒绝原因::原始类型不匹配:
                case L2特征比较拒绝原因::单位不匹配:
                case L2特征比较拒绝原因::维度不匹配:
                case L2特征比较拒绝原因::左右角色不合法:
                case L2特征比较拒绝原因::值域不允许:
                    return 失败(任务目标达成裁决状态::不可比较);
                default:
                    return 失败(任务目标达成裁决状态::入口拒绝);
                }
            case L2特征比较状态::许可拒绝:
                return 失败(任务目标达成裁决状态::入口拒绝);
            case L2特征比较状态::资源失败:
                return 失败(任务目标达成裁决状态::资源失败);
            case L2特征比较状态::内部不一致:
            default:
                return 失败(任务目标达成裁决状态::内部错误);
            }
            if (!比较结果.成功() || 比较结果.请求身份 != 请求.治理输入幂等键
                || 比较结果.事实截止代次 != G0
                || 比较结果.注册身份 != 比较注册.身份
                || 比较结果.算法版本 != 比较注册.合同.算法版本
                || 比较结果.实际结果位 != 比较请求.要求结果位
                || !比较结果.具名关系 || 比较结果.排序三态
                || 比较结果.差异材料 || !比较结果.左输入回执
                || !比较结果.右输入回执
                || 比较结果.实际单位 != 比较注册.合同.单位
                || 比较结果.实际维度 != 比较注册.合同.维度
                || 比较结果.实际分量角色 != 比较注册.合同.分量角色
                || 比较结果.实际左角色 != L2特征比较角色::当前事实
                || 比较结果.实际右角色 != L2特征比较角色::目标状态
                || 比较结果.左输入回执->事实身份 != 比较请求.左.事实身份
                || 比较结果.左输入回执->来源稳定编码
                    != 比较请求.左.来源稳定编码
                || 比较结果.左输入回执->输入版本 != 比较请求.左.输入版本
                || 比较结果.右输入回执->事实身份 != 比较请求.右.事实身份
                || 比较结果.右输入回执->来源稳定编码
                    != 比较请求.右.来源稳定编码
                || 比较结果.右输入回执->输入版本 != 比较请求.右.输入版本)
                return 失败(任务目标达成裁决状态::内部错误);
            const auto 关系位 = 运行期只读查询细节::目标判断关系位(
                *比较结果.具名关系);
            if (!关系位)
                return 失败(任务目标达成裁决状态::不可比较);
            const bool 已达成 = (目标合同.允许关系位 & *关系位) != 0;
            任务目标达成裁决快照 裁决;
            裁决.治理输入幂等键 = 请求.治理输入幂等键;
            裁决.任务 = 请求.任务;
            裁决.实例方法 = 请求.实例方法;
            裁决.执行轮次 = 请求.执行轮次;
            裁决.任务实际结果 = 请求.任务实际结果;
            裁决.任务目标来源 = 快照.需求列表项.身份;
            裁决.目标宿主 = 快照.需求列表项.目标宿主存在;
            裁决.目标特征 = 快照.需求列表项.目标特征定义;
            裁决.目标状态合同 = 快照.需求列表项.目标状态合同;
            裁决.实际状态 = 正式结果.实际状态;
            裁决.动态证据 = 正式结果.动态证据;
            裁决.方法 = 正式结果.方法;
            裁决.路径预期结果 = 快照.选中路径.完整路径材料.预期结果;
            裁决.路径验证合同 = 快照.选中路径.完整路径材料.验证合同;
            裁决.比较注册 = 比较结果.注册身份;
            裁决.比较算法版本 = 比较结果.算法版本;
            裁决.具名关系 = *比较结果.具名关系;
            裁决.允许关系位 = 目标合同.允许关系位;
            裁决.生命周期准备 = 已达成
                ? 任务生命周期后继准备::待验证后完成
                : 任务生命周期后继准备::目标未达成待重筹办;
            裁决.事实截止代次 = G0;
            return {已达成 ? 任务目标达成裁决状态::目标已达成
                    : 任务目标达成裁决状态::目标未达成,
                std::move(裁决)};
        } catch (const std::bad_alloc&) {
            return 失败(任务目标达成裁决状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(任务目标达成裁决状态::资源失败);
        } catch (...) {
            return 失败(任务目标达成裁决状态::内部错误);
        }
    }

private:
    const L2需求结构服务& 需求服务_;
    const L2任务结构服务& 任务服务_;
    const L2方法结构服务* 方法服务_ = nullptr;
    const L2状态结构服务& 状态服务_;
    const L2特征结构服务& 特征服务_;
    const L2存在结构服务& 存在服务_;
    const L2场景结构服务& 场景服务_;
    const L2动态结构服务& 动态服务_;
};

} // namespace 海中鱼巣
