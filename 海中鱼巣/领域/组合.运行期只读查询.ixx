module;

#include <cstdint>
#include <algorithm>
#include <cstdio>
#include <memory>
#include <new>
#include <optional>
#include <utility>
#include <variant>
#include <vector>

#define 运行期只读查询_NO_INCLUDES
export module 海中鱼巣.领域.组合.运行期只读查询;
#undef 运行期只读查询_NO_INCLUDES

// 各 L2 服务模块（通过 export import 提供 L2结构公共 / L2需求 / L2任务 / L2状态 / L2特征 类型）
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2动态结构;

export {
#include "运行期只读查询.数据.h"
}

export namespace 海中鱼巣 {

// ===== 运行期只读查询组合器 =====
// 职责：跨 L2 需求/任务/状态/特征正式服务做只读 BIZ 组合；
// 全部读取使用调用方传入的同一共享事实截止 G0，任一结果截止漂移整体漂移。
// 不写事实、不缓存、不持有 L1/仓库端口，仅保存稳定 const 引用。
class 运行期只读查询组合器 final {
public:
    explicit 运行期只读查询组合器(
        const L2需求结构服务& 需求服务,
        const L2任务结构服务& 任务服务,
        const L2状态结构服务& 状态服务,
        const L2特征结构服务& 特征服务,
        const L2存在结构服务& 存在服务,
        const L2场景结构服务& 场景服务,
        const L2动态结构服务& 动态服务) noexcept
        : 需求服务_(需求服务),
          任务服务_(任务服务),
          状态服务_(状态服务),
          特征服务_(特征服务),
          存在服务_(存在服务),
          场景服务_(场景服务),
          动态服务_(动态服务) {}
    运行期只读查询组合器() = delete;
    运行期只读查询组合器(const 运行期只读查询组合器&) = delete;
    运行期只读查询组合器& operator=(const 运行期只读查询组合器&) = delete;
    运行期只读查询组合器(运行期只读查询组合器&&) = delete;
    运行期只读查询组合器& operator=(运行期只读查询组合器&&) = delete;

    // ===== BIZ-L3-002-02-02 读取生存安全与服务维护当前快照 =====
    // 对齐 v0.2 流程图 N01-N11；全部读取必须使用同一 G0。
    生存服务快照结果 读取生存安全与服务维护当前快照(
        const 生存服务快照请求& 请求) const noexcept {
        try {
            // N01 请求守卫
            if (请求.合同版本 != 运行期只读查询合同版本)
                return {生存服务快照状态::请求拒绝};
            if (请求.运行代次 == 0 || 请求.事实范围版本 == 0
                || !有效(请求.唯一自我.值)
                || 请求.共享事实截止G0 == 0)
                return {生存服务快照状态::请求拒绝};
            if (请求.最大合同数 == 0 || 请求.最大准备数 == 0
                || 请求.最大进展数 == 0
                || 请求.最大到期事件数 == 0)
                return {生存服务快照状态::请求拒绝};
            const auto G0 = 请求.共享事实截止G0;
            const L2结构请求头 L2头{L2结构合同版本, G0};

            // N02 读取安全根特征值
            生存安全根当前值 安全根;
            if (有效(请求.安全根特征定义.值)) {
                const L2按存在当前特征读取请求 特征请求{
                    L2头, 请求.唯一自我};
                const auto 特征结果 =
                    特征服务_.按存在读取全部当前特征(特征请求);
                if (特征结果.结果头.事实截止代次 != 0
                    && 特征结果.结果头.事实截止代次 != G0)
                    return {生存服务快照状态::当前性漂移};
                if (特征结果.结果头.状态 == L2结构状态::资源失败)
                    return {生存服务快照状态::资源失败};
                if (特征结果.结果头.状态 != L2结构状态::已读取
                    && 特征结果.结果头.状态 != L2结构状态::未找到
                    && 特征结果.结果头.状态 != L2结构状态::属性未设置)
                    return {生存服务快照状态::尚无权威};
                if (特征结果.成功()) {
                    for (const auto& 实例 : 特征结果.特征实例组) {
                        if (实例.特征定义 != 请求.安全根特征定义)
                            continue;
                        const L2特征当前值读取请求 值请求{
                            L2头, 实例.身份};
                        const auto 值结果 =
                            特征服务_.读取特征当前值(值请求);
                        if (值结果.结果头.事实截止代次 != 0
                            && 值结果.结果头.事实截止代次 != G0)
                            return {生存服务快照状态::当前性漂移};
                        if (值结果.成功() && 值结果.当前值) {
                            const auto* I64组 =
                                std::get_if<std::vector<std::int64_t>>(
                                    &值结果.当前值->类型化不可变材料);
                            const auto* U64组 =
                                std::get_if<std::vector<std::uint64_t>>(
                                    &值结果.当前值->类型化不可变材料);
                            if (I64组) {
                                if (I64组->size() >= 1) 安全根.A = (*I64组)[0];
                                if (I64组->size() >= 2) 安全根.L = (*I64组)[1];
                                if (I64组->size() >= 3) 安全根.H = (*I64组)[2];
                            }
                            (void)U64组;
                            break;
                        }
                    }
                }
            }
            // 派生控制态
            if (安全根.A == 0) 安全根.控制态 = 生存安全控制态::终止;
            else if (安全根.A == 1) 安全根.控制态 = 生存安全控制态::休眠;
            else 安全根.控制态 = 生存安全控制态::主动运行;
            // 边界校验 1 < L < H
            if (!(安全根.L > 1 && 安全根.L < 安全根.H)) {
                if (安全根.A == 0 && 安全根.L == 0 && 安全根.H == 0) {
                    return {生存服务快照状态::材料缺失};
                }
                return {生存服务快照状态::内部不一致};
            }

            // 读取服务值特征
            服务值与维护游标 服务游标;
            if (有效(请求.服务值特征定义.值)) {
                const L2按存在当前特征读取请求 特征请求{
                    L2头, 请求.唯一自我};
                const auto 特征结果 =
                    特征服务_.按存在读取全部当前特征(特征请求);
                if (特征结果.结果头.事实截止代次 != 0
                    && 特征结果.结果头.事实截止代次 != G0)
                    return {生存服务快照状态::当前性漂移};
                if (特征结果.结果头.状态 == L2结构状态::资源失败)
                    return {生存服务快照状态::资源失败};
                if (特征结果.成功()) {
                    for (const auto& 实例 : 特征结果.特征实例组) {
                        if (实例.特征定义 != 请求.服务值特征定义) continue;
                        const L2特征当前值读取请求 值请求{
                            L2头, 实例.身份};
                        const auto 值结果 =
                            特征服务_.读取特征当前值(值请求);
                        if (值结果.结果头.事实截止代次 != 0
                            && 值结果.结果头.事实截止代次 != G0)
                            return {生存服务快照状态::当前性漂移};
                        if (值结果.成功() && 值结果.当前值) {
                            const auto* I64组 =
                                std::get_if<std::vector<std::int64_t>>(
                                    &值结果.当前值->类型化不可变材料);
                            const auto* U64组 =
                                std::get_if<std::vector<std::uint64_t>>(
                                    &值结果.当前值->类型化不可变材料);
                            if (I64组 && !I64组->empty())
                                服务游标.服务值 = (*I64组)[0];
                            if (U64组) {
                                if (U64组->size() >= 1)
                                    服务游标.时间纪元 = (*U64组)[0];
                                if (U64组->size() >= 2)
                                    服务游标.上一已结算完整秒 = (*U64组)[1];
                            }
                            break;
                        }
                    }
                }
            }

            // 四类状态组读取：合同/准备/进展/到期
            auto 读取组 = [&](std::uint64_t 预算) noexcept
                -> std::pair<std::vector<L2状态事实>,
                             std::optional<生存服务快照状态>> {
                const L2按主体当前状态读取请求 组请求{
                    L2头, 请求.唯一自我, 预算};
                const auto 组结果 =
                    状态服务_.按主体读取全部当前状态(组请求);
                if (组结果.结果头.状态 == L2结构状态::数量预算不足)
                    return {{}, 生存服务快照状态::数量预算不足};
                if (组结果.结果头.状态 == L2结构状态::资源失败)
                    return {{}, 生存服务快照状态::资源失败};
                if (组结果.结果头.事实截止代次 != 0
                    && 组结果.结果头.事实截止代次 != G0)
                    return {{}, 生存服务快照状态::当前性漂移};
                if (组结果.结果头.状态 != L2结构状态::已读取
                    && 组结果.结果头.状态 != L2结构状态::未找到
                    && 组结果.结果头.状态 != L2结构状态::属性未设置)
                    return {{}, 生存服务快照状态::内部不一致};
                if (组结果.成功())
                    return {std::move(组结果.状态), std::nullopt};
                return {{}, std::nullopt};
            };
            auto [合同组, 合同错误] = 读取组(请求.最大合同数);
            if (合同错误) return {*合同错误};
            auto [准备组, 准备错误] = 读取组(请求.最大准备数);
            if (准备错误) return {*准备错误};
            auto [进展组, 进展错误] = 读取组(请求.最大进展数);
            if (进展错误) return {*进展错误};
            auto [到期组, 到期错误] = 读取组(请求.最大到期事件数);
            if (到期错误) return {*到期错误};

            // N03/N04 互证与闭合
            if (合同组.size() > 请求.最大合同数
                || 准备组.size() > 请求.最大准备数
                || 进展组.size() > 请求.最大进展数
                || 到期组.size() > 请求.最大到期事件数)
                return {生存服务快照状态::内部不一致};

            // N05/N06 形成快照
            生存服务共享截止快照 快照;
            快照.安全根 = std::move(安全根);
            快照.服务游标 = std::move(服务游标);
            快照.当前合同组 = std::move(合同组);
            快照.当前准备组 = std::move(准备组);
            快照.当前进展组 = std::move(进展组);
            快照.当前到期未满足组 = std::move(到期组);
            快照.事实截止代次 = G0;
            return {生存服务快照状态::已形成, std::move(快照)};
        } catch (const std::bad_alloc&) {
            return {生存服务快照状态::资源失败};
        } catch (...) {
            return {生存服务快照状态::内部不一致};
        }
    }

    // ===== BIZ-L3-002-02-03 读取需求结构与任务后继快照 =====
    需求任务快照结果 读取需求结构与任务后继快照(
        const 需求任务快照请求& 请求) const noexcept {
        try {
            if (请求.合同版本 != 运行期只读查询合同版本)
                return {需求任务快照状态::请求拒绝};
            if (请求.运行代次 == 0 || 请求.事实范围版本 == 0
                || !有效(请求.唯一自我.值)
                || 请求.共享事实截止G0 == 0)
                return {需求任务快照状态::请求拒绝};
            if (请求.最大根需求数 == 0
                || 请求.最大需求节点数 == 0
                || 请求.最大需求结构深度 == 0)
                return {需求任务快照状态::请求拒绝};
            const auto G0 = 请求.共享事实截止G0;
            const L2结构请求头 L2头{L2结构合同版本, G0};
            const auto 映射结构失败 = [&](L2结构状态 状态,
                bool 后继) noexcept {
                if (状态 == L2结构状态::事实代次漂移)
                    return 需求任务快照状态::当前性漂移;
                if (状态 == L2结构状态::数量预算不足)
                    return 需求任务快照状态::数量预算不足;
                if (状态 == L2结构状态::资源失败)
                    return 需求任务快照状态::资源失败;
                if (!后继 && (状态 == L2结构状态::未找到
                    || 状态 == L2结构状态::已退出))
                    return 需求任务快照状态::材料缺失;
                return 需求任务快照状态::内部不一致;
            };
            const auto 检查截止 = [&](const L2结构结果头& 头)
                noexcept -> bool {
                return 头.事实截止代次 == G0 && !头.变更事实代次;
            };

            L2按所属存在读取当前根需求组请求 根请求;
            根请求.请求头 = L2头;
            根请求.所属存在 = 请求.唯一自我;
            根请求.数量预算 = 请求.最大根需求数;
            const auto 根结果 = 需求服务_.按所属存在读取当前根需求组(根请求);
            if (!检查截止(根结果.结果头))
                return {需求任务快照状态::当前性漂移};
            if (!根结果.成功())
                return {映射结构失败(根结果.结果头.状态, false)};

            需求结构与任务后继快照 快照;
            快照.根需求组 = 根结果.根需求组;
            if (快照.根需求组.empty()) {
                快照.事实截止代次 = G0;
                return {需求任务快照状态::已形成, std::move(快照)};
            }

            struct 待展开需求 final {
                L2需求身份 需求;
                std::optional<L2需求父子关系事实> 期望父关系;
                std::uint64_t 深度 = 0;
            };
            std::vector<待展开需求> 待展开;
            for (const auto& 根 : 快照.根需求组) {
                if (根.所属存在 != 请求.唯一自我)
                    return {需求任务快照状态::内部不一致};
                待展开.push_back({根.身份, std::nullopt, 1});
            }
            std::vector<L2需求列表项身份> 列表项身份组;
            std::size_t 下一个 = 0;
            while (下一个 < 待展开.size()) {
                const auto 当前 = 待展开[下一个++];
                if (当前.深度 > 请求.最大需求结构深度
                    || 快照.当前需求结构组.size()
                        >= 请求.最大需求节点数)
                    return {需求任务快照状态::数量预算不足};
                for (const auto& 已有 : 快照.当前需求结构组) {
                    if (已有.需求.身份 == 当前.需求)
                        return {需求任务快照状态::内部不一致};
                }
                L2需求完整读取请求 完整请求;
                完整请求.请求头 = L2头;
                完整请求.读取类别 = L2读取类别::当前;
                完整请求.需求 = 当前.需求;
                const auto 完整结果 = 需求服务_.读取需求完整(完整请求);
                if (!检查截止(完整结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!完整结果.成功() || !完整结果.需求
                    || 完整结果.需求->所属存在 != 请求.唯一自我)
                    return {映射结构失败(完整结果.结果头.状态, true)};

                L2按子需求读取当前父需求请求 父请求;
                父请求.请求头 = L2头;
                父请求.子需求 = 当前.需求;
                const auto 父结果 = 需求服务_.按子需求读取当前父需求(父请求);
                if (!检查截止(父结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!父结果.成功())
                    return {映射结构失败(父结果.结果头.状态, true)};
                if (!当前.期望父关系) {
                    if (父结果.当前父关系 || 父结果.父需求)
                        return {需求任务快照状态::内部不一致};
                } else if (!父结果.当前父关系 || !父结果.父需求
                    || *父结果.当前父关系 != *当前.期望父关系
                    || 父结果.父需求->身份 != 当前.期望父关系->父需求
                    || 父结果.父需求->所属存在 != 请求.唯一自我) {
                    return {需求任务快照状态::内部不一致};
                }

                L2需求成员列表读取请求 成员请求;
                成员请求.请求头 = L2头;
                成员请求.读取类别 = L2读取类别::当前;
                成员请求.需求 = 当前.需求;
                const auto 成员结果 = 需求服务_.读取需求成员列表(成员请求);
                if (!检查截止(成员结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!成员结果.成功() || !成员结果.当前成员关系
                    || !成员结果.所属列表项)
                    return {映射结构失败(成员结果.结果头.状态, true)};
                if (成员结果.当前成员关系->需求 != 当前.需求
                    || 成员结果.当前成员关系->列表项
                        != 成员结果.所属列表项->身份)
                    return {需求任务快照状态::内部不一致};
                快照.当前需求结构组.push_back({*完整结果.需求,
                    父结果.当前父关系, *成员结果.当前成员关系, G0});
                bool 列表项已登记 = false;
                for (const auto& 已有列表项 : 列表项身份组) {
                    if (已有列表项 == 成员结果.所属列表项->身份) {
                        列表项已登记 = true;
                        break;
                    }
                }
                if (!列表项已登记)
                    列表项身份组.push_back(成员结果.所属列表项->身份);

                L2需求直接子读取请求 子请求;
                子请求.请求头 = L2头;
                子请求.读取类别 = L2读取类别::当前;
                子请求.父需求 = 当前.需求;
                const auto 子结果 = 需求服务_.读取需求直接子(子请求);
                if (!检查截止(子结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!子结果.成功())
                    return {映射结构失败(子结果.结果头.状态, true)};
                if (子结果.直接子关系组.size() != 子结果.直接子需求组.size())
                    return {需求任务快照状态::内部不一致};
                for (const auto& 关系 : 子结果.直接子关系组) {
                    if (关系.父需求 != 当前.需求
                        || !有效(关系.子需求.值))
                        return {需求任务快照状态::内部不一致};
                    待展开.push_back({关系.子需求, 关系, 当前.深度 + 1});
                }
            }

            std::sort(快照.当前需求结构组.begin(), 快照.当前需求结构组.end(),
                [](const 需求当前结构项& 左, const 需求当前结构项& 右) noexcept {
                    return 左.需求.身份.值 < 右.需求.身份.值;
                });
            std::sort(列表项身份组.begin(), 列表项身份组.end(),
                [](const L2需求列表项身份& 左, const L2需求列表项身份& 右) noexcept {
                    return 左.值 < 右.值;
                });
            for (std::size_t 索引 = 1; 索引 < 列表项身份组.size(); ++索引) {
                if (列表项身份组[索引 - 1] == 列表项身份组[索引])
                    return {需求任务快照状态::内部不一致};
            }
            for (const auto& 列表项身份 : 列表项身份组) {
                L2需求列表项完整读取请求 列表项请求;
                列表项请求.请求头 = L2头;
                列表项请求.读取类别 = L2读取类别::当前;
                列表项请求.列表项 = 列表项身份;
                const auto 列表项结果 = 需求服务_.读取需求列表项完整(列表项请求);
                if (!检查截止(列表项结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!列表项结果.成功() || !列表项结果.列表项)
                    return {映射结构失败(列表项结果.结果头.状态, true)};
                for (const auto& 需求项 : 快照.当前需求结构组) {
                    if (需求项.当前列表成员关系.列表项 != 列表项身份)
                        continue;
                    const auto& 列表项 = *列表项结果.列表项;
                    if (列表项.所属存在 != 需求项.需求.所属存在
                        || 列表项.目标宿主存在 != 需求项.需求.目标宿主存在
                        || 列表项.目标特征定义 != 需求项.需求.目标特征定义
                        || 列表项.目标状态合同 != 需求项.需求.目标状态合同)
                        return {需求任务快照状态::内部不一致};
                }
                L2按需求列表项读取当前任务请求 任务请求;
                任务请求.请求头 = L2头;
                任务请求.需求列表项 = 列表项身份;
                const auto 任务结果 = 任务服务_.按需求列表项读取当前任务(任务请求);
                if (!检查截止(任务结果.结果头))
                    return {需求任务快照状态::当前性漂移};
                if (!任务结果.成功())
                    return {映射结构失败(任务结果.结果头.状态, true)};
                if (任务结果.任务 && 任务结果.任务->需求列表项 != 列表项身份)
                    return {需求任务快照状态::内部不一致};
                快照.列表任务后继组.push_back({*列表项结果.列表项,
                    任务结果.任务, G0});
            }
            快照.事实截止代次 = G0;
            return {需求任务快照状态::已形成, std::move(快照)};
        } catch (const std::bad_alloc&) {
            return {需求任务快照状态::资源失败};
        } catch (...) {
            return {需求任务快照状态::内部不一致};
        }
    }

    // 任务实际结果 provider 的入口首先固定调用方 G0，绝不在组合器内重新取代次。
    // 后续各公共子读只要截止不等 G0 就必须零快照返回当前性漂移。
    任务实际结果独立读回结果 读取任务本轮实际结果与独立读回(
        const 任务实际结果独立读回请求& 请求) const noexcept {
        try {
            if (请求.合同版本 != 运行期只读查询合同版本
                || !有效(请求.任务.值) || 请求.执行轮次 == 0
                || !有效(请求.方法.值) || !有效(请求.动作入口.值)
                || !有效(请求.场景.值) || !有效(请求.主体.值)
                || !有效(请求.实际状态.值) || !有效(请求.动态证据.值)
                || 请求.来源材料版本 == 0 || 请求.运行代次 == 0
                || 请求.共享事实截止G0 == 0 || 请求.最大需求成员数 == 0)
                return {任务实际结果独立读回状态::请求拒绝};
            const auto G0 = 请求.共享事实截止G0;
            L2按任务与执行轮次读取实际结果请求 结果请求;
            结果请求.请求头 = {L2结构合同版本, G0};
            结果请求.读取类别 = L2读取类别::当前;
            结果请求.任务 = 请求.任务;
            结果请求.执行轮次 = 请求.执行轮次;
            const auto 结果读取 = 任务服务_.按任务与执行轮次读取实际结果(结果请求);
            if (结果读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (结果读取.结果头.状态 != L2结构状态::已读取)
                return {结果读取.结果头.状态 == L2结构状态::资源失败
                    ? 任务实际结果独立读回状态::资源失败
                    : 任务实际结果独立读回状态::内部不一致};
            if (!结果读取.实际结果)
                return {任务实际结果独立读回状态::尚未形成};
            const auto& 结果 = *结果读取.实际结果;
            if (结果.任务 != 请求.任务 || 结果.执行轮次 != 请求.执行轮次)
                return {任务实际结果独立读回状态::轮次不匹配};
            if (结果.方法 != 请求.方法 || 结果.动作入口 != 请求.动作入口
                || 结果.场景 != 请求.场景 || 结果.主体 != 请求.主体
                || 结果.实际状态 != 请求.实际状态 || 结果.动态证据 != 请求.动态证据
                || 结果.来源材料版本 != 请求.来源材料版本
                || 结果.运行代次 != 请求.运行代次)
                return {任务实际结果独立读回状态::引用冲突};
            const L2结构请求头 L2头{L2结构合同版本, G0};
            const auto 实例读取 = 任务服务_.读取实例方法({L2头,L2读取类别::当前,结果.实例方法});
            if (实例读取.结果头.事实截止代次 != G0) return {任务实际结果独立读回状态::当前性漂移};
            if (!实例读取.实例方法) return {任务实际结果独立读回状态::内部不一致};
            const auto 路径读取 = 任务服务_.读取任务方法路径({L2头,L2读取类别::当前,实例读取.实例方法->当前选中路径});
            if (路径读取.结果头.事实截止代次 != G0) return {任务实际结果独立读回状态::当前性漂移};
            if (!路径读取.路径) return {任务实际结果独立读回状态::内部不一致};
            const auto 任务读取 = 任务服务_.读取任务({L2头,L2读取类别::当前,请求.任务});
            if (任务读取.结果头.事实截止代次 != G0) return {任务实际结果独立读回状态::当前性漂移};
            if (!任务读取.任务) return {任务实际结果独立读回状态::内部不一致};
            if (!实例读取.成功() || 实例读取.实例方法->身份 != 结果.实例方法
                || 实例读取.实例方法->任务 != 结果.任务
                || 实例读取.实例方法->执行轮次 != 结果.执行轮次
                || 实例读取.实例方法->来源方法 != 结果.方法)
                return {任务实际结果独立读回状态::引用冲突};
            if (!路径读取.成功() || 路径读取.路径->身份
                    != 实例读取.实例方法->当前选中路径
                || 路径读取.路径->任务 != 结果.任务
                || 路径读取.路径->来源方法 != 结果.方法
                || 路径读取.路径->筹办轮次 != 实例读取.实例方法->筹办轮次
                || 路径读取.路径->来源方法内容版本
                    != 实例读取.实例方法->来源方法内容版本
                || 路径读取.路径->完整路径材料.动作入口 != 结果.动作入口.值)
                return {任务实际结果独立读回状态::引用冲突};
            if (!任务读取.成功() || 任务读取.任务->身份 != 结果.任务)
                return {任务实际结果独立读回状态::内部不一致};

            const auto 状态读取 = 状态服务_.读取完整状态(
                {L2头, L2读取类别::当前, 结果.实际状态, 0});
            if (状态读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (状态读取.结果头.状态 != L2结构状态::已读取
                || 状态读取.结果头.变更事实代次 || !状态读取.状态
                || 状态读取.状态->身份 != 结果.实际状态
                || 状态读取.状态->主体存在 != 结果.主体)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 动态读取 = 动态服务_.读取完整动态(
                {L2头, L2读取类别::当前, 结果.动态证据, 0});
            if (动态读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (动态读取.结果头.状态 != L2结构状态::已读取
                || 动态读取.结果头.变更事实代次 || !动态读取.动态
                || 动态读取.动态->身份 != 结果.动态证据
                || 动态读取.动态->主体存在 != 结果.主体
                || 动态读取.动态->后状态 != 结果.实际状态)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 场景读取 = 场景服务_.读取完整场景(
                {L2头, L2读取类别::当前, 结果.场景, 0});
            if (场景读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (场景读取.结果头.状态 != L2结构状态::已读取
                || 场景读取.结果头.变更事实代次 || !场景读取.场景
                || 场景读取.场景->身份 != 结果.场景)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 主体读取 = 存在服务_.读取完整存在(
                {L2头, L2读取类别::当前, 结果.主体, 0});
            if (主体读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (主体读取.结果头.状态 != L2结构状态::已读取
                || 主体读取.结果头.变更事实代次 || !主体读取.存在
                || 主体读取.存在->身份 != 结果.主体)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 成员引用读取 = 场景服务_.读取存在当前场景成员引用(
                {L2头, 结果.主体});
            if (成员引用读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (!成员引用读取.成功())
                return {任务实际结果独立读回状态::内部不一致};
            const bool 场景包含主体 = std::any_of(
                成员引用读取.引用.begin(), 成员引用读取.引用.end(),
                [&](const L2存在场景成员引用事实& 引用) noexcept {
                    return 引用.场景 == 结果.场景 && 引用.存在 == 结果.主体
                        && !引用.生命周期.退出事实代次;
                });
            if (!场景包含主体)
                return {任务实际结果独立读回状态::引用冲突};

            const auto 列表项读取 = 需求服务_.读取需求列表项完整(
                {L2头, L2读取类别::当前, 任务读取.任务->需求列表项, 0});
            if (列表项读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (!列表项读取.成功() || !列表项读取.列表项
                || 列表项读取.列表项->身份 != 任务读取.任务->需求列表项)
                return {任务实际结果独立读回状态::内部不一致};

            const auto 成员组读取 = 需求服务_.读取需求列表成员(
                {L2头, L2读取类别::当前, 任务读取.任务->需求列表项, 0});
            if (成员组读取.结果头.事实截止代次 != G0)
                return {任务实际结果独立读回状态::当前性漂移};
            if (!成员组读取.成功()
                || 成员组读取.成员关系组.size() != 成员组读取.成员需求组.size()
                || 成员组读取.成员关系组.empty())
                return {任务实际结果独立读回状态::内部不一致};
            if (成员组读取.成员关系组.size() > 请求.最大需求成员数)
                return {任务实际结果独立读回状态::数量预算不足};

            struct 成员项 final {
                L2需求列表成员关系事实 关系;
                L2需求事实 需求;
            };
            std::vector<成员项> 成员项组;
            成员项组.reserve(成员组读取.成员关系组.size());
            for (std::size_t 索引 = 0; 索引 < 成员组读取.成员关系组.size(); ++索引) {
                const auto& 关系 = 成员组读取.成员关系组[索引];
                const auto& 需求 = 成员组读取.成员需求组[索引];
                if (关系.列表项 != 任务读取.任务->需求列表项
                    || 关系.需求 != 需求.身份)
                    return {任务实际结果独立读回状态::内部不一致};
                const auto 完整需求读取 = 需求服务_.读取需求完整(
                    {L2头, L2读取类别::当前, 需求.身份, 0});
                if (完整需求读取.结果头.事实截止代次 != G0)
                    return {任务实际结果独立读回状态::当前性漂移};
                if (!完整需求读取.成功() || !完整需求读取.需求
                    || 完整需求读取.需求->身份 != 关系.需求)
                    return {任务实际结果独立读回状态::内部不一致};
                成员项组.push_back({关系, *完整需求读取.需求});
            }
            std::sort(成员项组.begin(), 成员项组.end(),
                [](const 成员项& 左, const 成员项& 右) noexcept {
                    return 左.需求.身份.值 < 右.需求.身份.值;
                });
            for (std::size_t 索引 = 1; 索引 < 成员项组.size(); ++索引) {
                if (成员项组[索引 - 1].需求.身份 == 成员项组[索引].需求.身份)
                    return {任务实际结果独立读回状态::内部不一致};
            }

            任务实际结果独立读回快照 快照;
            快照.结果 = 结果;
            快照.实例方法 = *实例读取.实例方法;
            快照.选中路径 = *路径读取.路径;
            快照.任务 = *任务读取.任务;
            快照.状态 = *状态读取.状态;
            快照.动态 = *动态读取.动态;
            快照.场景 = *场景读取.场景;
            快照.主体 = *主体读取.存在;
            快照.需求列表项 = *列表项读取.列表项;
            快照.来源成员关系组.reserve(成员项组.size());
            快照.来源需求组.reserve(成员项组.size());
            for (auto& 成员项 : 成员项组) {
                快照.来源成员关系组.push_back(std::move(成员项.关系));
                快照.来源需求组.push_back(std::move(成员项.需求));
            }
            快照.事实截止代次 = G0;
            return {任务实际结果独立读回状态::已形成, std::move(快照)};
        } catch (const std::bad_alloc&) {
            return {任务实际结果独立读回状态::资源失败};
        } catch (...) {
            return {任务实际结果独立读回状态::内部不一致};
        }
    }

private:
    const L2需求结构服务& 需求服务_;
    const L2任务结构服务& 任务服务_;
    const L2状态结构服务& 状态服务_;
    const L2特征结构服务& 特征服务_;
    const L2存在结构服务& 存在服务_;
    const L2场景结构服务& 场景服务_;
    const L2动态结构服务& 动态服务_;
};

} // namespace 海中鱼巣
