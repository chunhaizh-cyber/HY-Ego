module;

#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.组合.运行期只读查询;

import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2结构聚合;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 世界自我共享截止快照合同版本 = 2;

struct 世界自我共享截止快照请求 final {
    std::uint32_t 合同版本 = 世界自我共享截止快照合同版本;
    std::uint64_t 运行代次 = 0;
    std::uint32_t 事实范围版本 = 0;
    L2场景树身份 现实世界树;
    L2场景身份 根场景;
    L2存在单例角色键 自我角色;
    L2存在身份 自我存在;
    稳定编码 自我角色关系编码;
    L2场景身份 自我所在场景;
    稳定编码 所在场景成员关系编码;
    L2场景身份 自我内部世界场景;
    稳定编码 内部世界宿主关系编码;
    std::uint64_t 事实截止代次 = 0;
    // 诊断责任：无适用错误分支；值式默认比较不读取事实。
    friend bool operator==(const 世界自我共享截止快照请求&,
        const 世界自我共享截止快照请求&) = default;
};

enum class 世界自我共享截止快照状态 : std::uint8_t {
    已形成 = 1,
    请求拒绝 = 2,
    材料缺失 = 3,
    当前性漂移 = 4,
    提供者拒绝 = 5,
    资源失败 = 6,
    内部不一致 = 7
};

struct 世界自我共享截止快照 final {
    std::uint32_t 合同版本 = 世界自我共享截止快照合同版本;
    std::uint64_t 运行代次 = 0;
    std::uint32_t 事实范围版本 = 0;
    std::uint64_t 事实截止代次 = 0;
    L2场景树事实 现实世界完整场景树;
    L2存在单例角色事实 自我角色关系;
    L2节点族身份来源事实 自我存在身份来源;
    L2存在事实 完整自我存在;
    L2存在场景成员引用事实 自我所在场景成员引用;
    L2场景宿主存在关系事实 内部世界宿主关系;
    // 诊断责任：无适用错误分支；值式默认比较不读取事实。
    friend bool operator==(const 世界自我共享截止快照&,
        const 世界自我共享截止快照&) = default;
};

struct 世界自我共享截止快照结果 final {
    世界自我共享截止快照状态 状态 =
        世界自我共享截止快照状态::请求拒绝;
    std::optional<世界自我共享截止快照> 快照;

    // 诊断责任：无适用错误分支；纯值谓词只检查成功载荷形状。
    bool 成功() const noexcept {
        return 状态 == 世界自我共享截止快照状态::已形成 && 快照
            && 快照->合同版本 == 世界自我共享截止快照合同版本
            && 快照->运行代次 != 0 && 快照->事实范围版本 != 0
            && 快照->事实截止代次 != 0;
    }

    // 诊断责任：无适用错误分支；值式默认比较不读取事实。
    friend bool operator==(const 世界自我共享截止快照结果&,
        const 世界自我共享截止快照结果&) = default;
};

}

namespace 海中鱼巣::运行期只读查询内部 {

// 诊断责任：无适用错误分支；纯值校验只裁决组合请求形状。
bool 请求有效(const 世界自我共享截止快照请求& 请求) noexcept {
    return 请求.合同版本 == 世界自我共享截止快照合同版本
        && 请求.运行代次 != 0 && 请求.事实范围版本 != 0
        && 有效(请求.现实世界树.值) && 有效(请求.根场景.值)
        && 请求.自我角色.值 > 0 && 有效(请求.自我存在.值)
        && 有效(请求.自我角色关系编码)
        && 有效(请求.自我所在场景.值)
        && 有效(请求.所在场景成员关系编码)
        && 有效(请求.自我内部世界场景.值)
        && 有效(请求.内部世界宿主关系编码)
        && 请求.事实截止代次 != 0
        && 请求.根场景 != 请求.自我所在场景
        && 请求.根场景 != 请求.自我内部世界场景
        && 请求.自我所在场景 != 请求.自我内部世界场景;
}

// 诊断责任：无适用错误分支；完整枚举映射保留公开失败分类。
世界自我共享截止快照状态 映射非成功状态(
    const L2结构结果头& 结果头) noexcept {
    if (结果头.合同版本 != L2结构合同版本)
        return 世界自我共享截止快照状态::内部不一致;
    switch (结果头.状态) {
    case L2结构状态::未找到:
    case L2结构状态::已退出:
        return 世界自我共享截止快照状态::材料缺失;
    case L2结构状态::事实代次漂移:
        return 世界自我共享截止快照状态::当前性漂移;
    case L2结构状态::许可拒绝:
    case L2结构状态::入口拒绝:
    case L2结构状态::引用冲突:
    case L2结构状态::数量预算不足:
        return 世界自我共享截止快照状态::提供者拒绝;
    case L2结构状态::资源失败:
        return 世界自我共享截止快照状态::资源失败;
    default:
        return 世界自我共享截止快照状态::内部不一致;
    }
}

// 诊断责任：无适用错误分支；纯值检查把失败分类向组合入口送出。
bool 读取头有效(const L2结构结果头& 结果头,
    std::uint64_t 事实截止代次,
    世界自我共享截止快照状态& 失败状态) noexcept {
    失败状态 = 世界自我共享截止快照状态::内部不一致;
    if (结果头.合同版本 != L2结构合同版本) return false;
    if (结果头.状态 != L2结构状态::已读取) {
        失败状态 = 映射非成功状态(结果头);
        return false;
    }
    return 结果头.事实截止代次 == 事实截止代次
        && !结果头.变更事实代次;
}

// 诊断责任：无适用错误分支；纯值形成零快照失败结果。
世界自我共享截止快照结果 形成失败(
    世界自我共享截止快照状态 状态) noexcept {
    return {状态, std::nullopt};
}

// 诊断责任：无适用错误分支；纯值查找以空指针表达缺失或复义。
const L2场景树节点事实* 查找唯一场景节点(
    const L2场景树事实& 树, L2场景身份 身份) noexcept {
    const L2场景树节点事实* 找到 = nullptr;
    for (const auto& 节点 : 树.场景组) {
        if (节点.场景.身份 != 身份) continue;
        if (找到) return nullptr;
        找到 = &节点;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值查找以空指针表达缺失或复义。
const L2场景父子关系事实* 查找唯一父子关系(
    const std::vector<L2场景父子关系事实>& 关系组,
    L2场景身份 父场景, L2场景身份 子场景) noexcept {
    const L2场景父子关系事实* 找到 = nullptr;
    for (const auto& 关系 : 关系组) {
        if (关系.父场景 != 父场景 || 关系.子场景 != 子场景) continue;
        if (找到) return nullptr;
        找到 = &关系;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值查找以空指针表达缺失或复义。
const L2场景成员关系事实* 查找唯一成员关系(
    const std::vector<L2场景成员关系事实>& 关系组,
    L2存在身份 存在) noexcept {
    const L2场景成员关系事实* 找到 = nullptr;
    for (const auto& 关系 : 关系组) {
        if (关系.存在 != 存在) continue;
        if (找到) return nullptr;
        找到 = &关系;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值比较不读取或写入事实。
bool 父子关系一致(const L2场景父子关系事实& 左,
    const L2场景父子关系事实& 右) noexcept {
    return 左 == 右;
}

// 诊断责任：无适用错误分支；纯值互证不读取或写入事实。
bool 成员正反向一致(const L2场景成员关系事实& 正向,
    const L2存在场景成员引用事实& 反向) noexcept {
    return 正向.关系稳定编码 == 反向.关系稳定编码
        && 正向.场景 == 反向.场景 && 正向.存在 == 反向.存在
        && 正向.顺序 == 反向.顺序
        && 正向.生命周期 == 反向.生命周期;
}

// 诊断责任：无适用错误分支；纯值互证以 false 向组合入口送出矛盾。
bool 互证现实世界拓扑(const 世界自我共享截止快照请求& 请求,
    const L2场景树事实& 树) noexcept {
    if (树.树 != 请求.现实世界树 || 树.根场景 != 请求.根场景
        || 树.事实截止代次 != 请求.事实截止代次)
        return false;
    const auto* 根节点 = 查找唯一场景节点(树, 请求.根场景);
    const auto* 所在节点 = 查找唯一场景节点(树, 请求.自我所在场景);
    const auto* 内部世界节点 =
        查找唯一场景节点(树, 请求.自我内部世界场景);
    if (!根节点 || !所在节点 || !内部世界节点) return false;

    const auto* 根到所在 = 查找唯一父子关系(
        树.父子关系组, 请求.根场景, 请求.自我所在场景);
    const auto* 所在到内部 = 查找唯一父子关系(
        树.父子关系组, 请求.自我所在场景, 请求.自我内部世界场景);
    const auto* 根节点到所在 = 查找唯一父子关系(
        根节点->场景.直接子场景, 请求.根场景, 请求.自我所在场景);
    const auto* 所在节点到内部 = 查找唯一父子关系(
        所在节点->场景.直接子场景,
        请求.自我所在场景, 请求.自我内部世界场景);
    return 根到所在 && 所在到内部 && 根节点到所在 && 所在节点到内部
        && 父子关系一致(*根到所在, *根节点到所在)
        && 父子关系一致(*所在到内部, *所在节点到内部);
}

// 诊断责任：无适用错误分支；纯值互证以 false 向组合入口送出矛盾。
bool 互证自我角色与存在(const 世界自我共享截止快照请求& 请求,
    const L2存在单例角色事实& 角色关系,
    const L2节点族身份来源事实& 身份来源,
    const L2存在事实& 完整存在) noexcept {
    return 角色关系.角色 == 请求.自我角色
        && 角色关系.存在 == 请求.自我存在
        && 角色关系.关系稳定编码 == 请求.自我角色关系编码
        && !角色关系.生命周期.退出事实代次
        && 身份来源.节点族 == L2节点族::存在
        && 身份来源.节点稳定编码 == 请求.自我存在.值
        && 身份来源.节点生命周期 == 完整存在.生命周期
        && !身份来源.节点生命周期.退出事实代次
        && 完整存在.身份 == 请求.自我存在
        && !完整存在.生命周期.退出事实代次;
}

// 诊断责任：无适用错误分支；纯值互证以 false 向组合入口送出矛盾。
bool 互证自我场景成员(const 世界自我共享截止快照请求& 请求,
    const L2场景树事实& 树,
    const L2存在当前场景成员引用读取结果& 成员读取) noexcept {
    if (成员读取.引用.size() != 1) return false;
    const auto& 反向 = 成员读取.引用.front();
    if (反向.关系稳定编码 != 请求.所在场景成员关系编码
        || 反向.场景 != 请求.自我所在场景
        || 反向.存在 != 请求.自我存在)
        return false;
    const auto* 所在节点 = 查找唯一场景节点(树, 请求.自我所在场景);
    const auto* 内部世界节点 =
        查找唯一场景节点(树, 请求.自我内部世界场景);
    if (!所在节点 || !内部世界节点) return false;
    const auto* 正向 = 查找唯一成员关系(
        所在节点->场景.直接成员, 请求.自我存在);
    if (!正向 || 正向->关系稳定编码 != 请求.所在场景成员关系编码
        || !成员正反向一致(*正向, 反向))
        return false;
    return 查找唯一成员关系(
        内部世界节点->场景.直接成员, 请求.自我存在) == nullptr;
}

// 诊断责任：无适用错误分支；纯值互证以 false 向组合入口送出矛盾。
bool 互证内部世界宿主(const 世界自我共享截止快照请求& 请求,
    const L2场景树事实& 树,
    const L2场景宿主存在关系事实& 正向,
    const L2场景宿主存在关系事实& 反向) noexcept {
    if (正向 != 反向
        || 正向.关系稳定编码 != 请求.内部世界宿主关系编码
        || 正向.场景 != 请求.自我内部世界场景
        || 正向.宿主存在 != 请求.自我存在)
        return false;
    const auto* 内部世界节点 =
        查找唯一场景节点(树, 请求.自我内部世界场景);
    return 内部世界节点 && 内部世界节点->场景.当前宿主关系
        && *内部世界节点->场景.当前宿主关系 == 正向;
}

}

export namespace 海中鱼巣 {

class 运行期只读查询组合器 final {
public:
    // 诊断责任：无适用错误分支；构造只保存同一聚合服务只读借用。
    explicit 运行期只读查询组合器(
        const L2结构聚合服务& 结构聚合服务) noexcept
        : 结构聚合服务_(结构聚合服务) {}

    // 诊断责任：无适用错误分支；默认构造在合同层显式删除。
    运行期只读查询组合器() = delete;
    // 诊断责任：无适用错误分支；复制构造在合同层显式删除。
    运行期只读查询组合器(const 运行期只读查询组合器&) = delete;
    // 诊断责任：无适用错误分支；复制赋值在合同层显式删除。
    运行期只读查询组合器& operator=(const 运行期只读查询组合器&) = delete;
    // 诊断责任：无适用错误分支；移动构造在合同层显式删除。
    运行期只读查询组合器(运行期只读查询组合器&&) = delete;
    // 诊断责任：无适用错误分支；移动赋值在合同层显式删除。
    运行期只读查询组合器& operator=(运行期只读查询组合器&&) = delete;

    // 诊断责任：向上送出；公开结构化状态保留首个失败且不作本地记录。
    世界自我共享截止快照结果 读取共享截止世界与自我快照(
        const 世界自我共享截止快照请求& 请求) const noexcept {
        using namespace 运行期只读查询内部;
        if (!请求有效(请求))
            return 形成失败(世界自我共享截止快照状态::请求拒绝);
        try {
            const auto& 场景服务 = 结构聚合服务_.取得L2场景结构服务();
            const auto& 存在服务 = 结构聚合服务_.取得L2存在结构服务();
            const L2结构请求头 请求头{L2结构合同版本, 请求.事实截止代次};
            世界自我共享截止快照状态 失败状态 =
                世界自我共享截止快照状态::内部不一致;

            auto 现实世界读取 = 场景服务.读取场景树(
                {请求头, L2读取类别::当前, 请求.现实世界树, 0});
            if (!读取头有效(
                    现实世界读取.结果头, 请求.事实截止代次, 失败状态))
                return 形成失败(失败状态);
            if (!现实世界读取.成功() || !现实世界读取.树)
                return 形成失败(世界自我共享截止快照状态::内部不一致);

            auto 自我角色读取 = 存在服务.读取存在单例角色(
                {请求头, L2读取类别::当前, 请求.自我角色, 0});
            if (!读取头有效(
                    自我角色读取.结果头, 请求.事实截止代次, 失败状态))
                return 形成失败(失败状态);
            if (!自我角色读取.成功() || !自我角色读取.角色关系
                || !自我角色读取.存在身份来源)
                return 形成失败(世界自我共享截止快照状态::内部不一致);

            auto 完整存在读取 = 存在服务.读取完整存在(
                {请求头, L2读取类别::当前, 请求.自我存在, 0});
            if (!读取头有效(
                    完整存在读取.结果头, 请求.事实截止代次, 失败状态))
                return 形成失败(失败状态);
            if (!完整存在读取.存在
                || !L2存在事实完整(
                    *完整存在读取.存在, 请求.事实截止代次))
                return 形成失败(世界自我共享截止快照状态::内部不一致);

            auto 成员读取 = 场景服务.读取存在当前场景成员引用(
                {请求头, 请求.自我存在});
            if (!读取头有效(
                    成员读取.结果头, 请求.事实截止代次, 失败状态))
                return 形成失败(失败状态);
            if (!成员读取.成功())
                return 形成失败(世界自我共享截止快照状态::内部不一致);
            if (成员读取.引用.empty())
                return 形成失败(世界自我共享截止快照状态::材料缺失);

            auto 宿主正向读取 = 场景服务.读取场景宿主存在关系(
                {请求头, L2读取类别::当前,
                    请求.自我内部世界场景, 0});
            if (!读取头有效(
                    宿主正向读取.结果头, 请求.事实截止代次, 失败状态))
                return 形成失败(失败状态);
            if (!宿主正向读取.成功() || !宿主正向读取.关系)
                return 形成失败(世界自我共享截止快照状态::内部不一致);

            auto 宿主反向读取 = 场景服务.读取存在当前宿主场景(
                {请求头, 请求.自我存在});
            if (!读取头有效(
                    宿主反向读取.结果头, 请求.事实截止代次, 失败状态))
                return 形成失败(失败状态);
            if (!宿主反向读取.成功() || !宿主反向读取.关系)
                return 形成失败(世界自我共享截止快照状态::内部不一致);

            if (!互证现实世界拓扑(请求, *现实世界读取.树)
                || !互证自我角色与存在(请求,
                    *自我角色读取.角色关系,
                    *自我角色读取.存在身份来源,
                    *完整存在读取.存在)
                || !互证自我场景成员(请求, *现实世界读取.树, 成员读取)
                || !互证内部世界宿主(请求, *现实世界读取.树,
                    *宿主正向读取.关系, *宿主反向读取.关系))
                return 形成失败(世界自我共享截止快照状态::内部不一致);

            世界自我共享截止快照 候选{
                世界自我共享截止快照合同版本,
                请求.运行代次,
                请求.事实范围版本,
                请求.事实截止代次,
                std::move(*现实世界读取.树),
                std::move(*自我角色读取.角色关系),
                std::move(*自我角色读取.存在身份来源),
                std::move(*完整存在读取.存在),
                std::move(成员读取.引用.front()),
                std::move(*宿主正向读取.关系)};
            世界自我共享截止快照结果 结果{
                世界自我共享截止快照状态::已形成, std::move(候选)};
            return 结果.成功() ? std::move(结果)
                : 形成失败(世界自我共享截止快照状态::内部不一致);
        } catch (const std::bad_alloc&) {
            return 形成失败(世界自我共享截止快照状态::资源失败);
        } catch (const std::length_error&) {
            return 形成失败(世界自我共享截止快照状态::资源失败);
        } catch (...) {
            return 形成失败(世界自我共享截止快照状态::内部不一致);
        }
    }

private:
    const L2结构聚合服务& 结构聚合服务_;
};

}
