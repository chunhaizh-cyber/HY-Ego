class L2特征结构服务;

class L2特征定义所有者交付 final {
public:
    L2特征定义所有者交付() = delete;
    L2特征定义所有者交付(const L2特征定义所有者交付&) = delete;
    L2特征定义所有者交付& operator=(const L2特征定义所有者交付&) = delete;
    L2特征定义所有者交付(L2特征定义所有者交付&&) noexcept = default;
    L2特征定义所有者交付& operator=(L2特征定义所有者交付&&) = delete;
private:
    explicit L2特征定义所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2特征定义所有者交付> 尝试形成L2特征定义所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2特征结构服务;
    L1所有者范围写端口 写入端口_;
};

class L2特征实例所有者交付 final {
public:
    L2特征实例所有者交付() = delete;
    L2特征实例所有者交付(const L2特征实例所有者交付&) = delete;
    L2特征实例所有者交付& operator=(const L2特征实例所有者交付&) = delete;
    L2特征实例所有者交付(L2特征实例所有者交付&&) noexcept = default;
    L2特征实例所有者交付& operator=(L2特征实例所有者交付&&) = delete;
private:
    explicit L2特征实例所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2特征实例所有者交付> 尝试形成L2特征实例所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2特征结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2特征定义所有者交付> 尝试形成L2特征定义所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;
std::optional<L2特征实例所有者交付> 尝试形成L2特征实例所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

}

