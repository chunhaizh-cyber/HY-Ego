// 诊断责任：无适用错误分支；事实代次探测失败映射为结构状态。
L2结构状态 映射特征事实代次探测失败(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::未找到:
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；历史关系组失败映射为结构状态。
L2结构状态 映射特征历史关系组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；节点与两条关系形成同截止实例骨架。
std::optional<L2特征实例事实> 形成F2特征实例事实(
    L1所有者范围节点事实 节点, const L1所有者范围关系事实& 宿主关系,
    const L1所有者范围关系事实& 定义关系,
    const L2特征关系类型登记& 登记, std::uint64_t 截止) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (宿主关系.退出事实代次 && *宿主关系.退出事实代次 <= 截止) return std::nullopt;
    if (定义关系.退出事实代次 && *定义关系.退出事实代次 <= 截止) return std::nullopt;
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示
        || 节点.创建事实代次 == 0 || 节点.创建事实代次 > 截止
        || (节点.退出事实代次 && *节点.退出事实代次 < 节点.创建事实代次)
        || !有效(宿主关系.编码) || !有效(定义关系.编码)
        || 宿主关系.编码 == 定义关系.编码
        || 宿主关系.源节点 != 节点.编码 || 定义关系.源节点 != 节点.编码
        || 宿主关系.关系类型节点 != 登记.宿主关系类型.值
        || 定义关系.关系类型节点 != 登记.定义关系类型.值
        || 宿主关系.角色或顺序 != 特征实例端点角色值
        || 定义关系.角色或顺序 != 特征实例端点角色值
        || 宿主关系.创建事实代次 != 节点.创建事实代次
        || 定义关系.创建事实代次 != 节点.创建事实代次)
        return std::nullopt;
    L2特征实例事实 实例;
    实例.身份 = L2特征实例身份{节点.编码};
    实例.宿主存在 = L2存在身份{宿主关系.目标节点};
    实例.特征定义 = L2特征定义身份{定义关系.目标节点};
    实例.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return L2特征实例事实完整(实例, 截止)
        ? std::optional<L2特征实例事实>{实例} : std::nullopt;
}

// 诊断责任：无适用错误分支；实例与三关系必须映射到四个不同非零编码。
bool 特征实例编码映射完整(const L1所有者范围写入结果& 写入,
    稳定编码& 实例编码, 稳定编码& 归属关系编码, 稳定编码& 宿主关系编码,
    稳定编码& 定义关系编码) noexcept {
    if (写入.新编码映射.size() != 4) return false;
    auto 查找 = [&](std::uint32_t 键值) noexcept -> std::optional<稳定编码> {
        std::optional<稳定编码> 找到;
        for (const auto& [键, 编码] : 写入.新编码映射) {
            if (键.值 != 键值) continue;
            if (找到) return std::nullopt;
            找到 = 编码;
        }
        return 找到;
    };
    const auto 实例 = 查找(特征实例节点本地键值);
    const auto 归属 = 查找(特征实例族归属关系本地键值);
    const auto 宿主 = 查找(特征实例宿主关系本地键值);
    const auto 定义 = 查找(特征实例定义关系本地键值);
    if (!实例 || !归属 || !宿主 || !定义 || !有效(*实例) || !有效(*归属)
        || !有效(*宿主) || !有效(*定义))
        return false;
    const std::vector<稳定编码> 编码组{*实例, *归属, *宿主, *定义};
    for (std::size_t 左 = 0; 左 < 编码组.size(); ++左)
        for (std::size_t 右 = 左 + 1; 右 < 编码组.size(); ++右)
            if (编码组[左] == 编码组[右]) return false;
    实例编码 = *实例;
    归属关系编码 = *归属;
    宿主关系编码 = *宿主;
    定义关系编码 = *定义;
    return true;
}

// 诊断责任：无适用错误分支；L1 值事实按登记表示投影为完整特征值。
std::optional<L2特征值事实> 形成截止特征值事实(
    L1所有者范围值事实 值, const L2特征值类型登记& 登记,
    std::uint64_t 截止, bool 保留完整生命周期 = false) {
    if (!保留完整生命周期 && 值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    if (!特征值类型与材料一致(登记, 值.属性类型节点, 值.材料))
        return std::nullopt;
    L2特征值事实 特征值{值.编码, L2特征实例身份{值.所属节点},
        转换为L2材料(值.材料), 值.来源节点,
        {值.创建事实代次, 值.退出事实代次}};
    return L2特征值事实截止投影完整(特征值, 截止)
        ? std::optional<L2特征值事实>{std::move(特征值)} : std::nullopt;
}

// 诊断责任：无适用错误分支；只形成空当前值写入失败。
L2特征当前值写入结果 形成特征当前值写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成实例、自有关系和退出值全空的失败。
L2特征当前值退出结果 形成特征当前值退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成具名历史值空载荷失败。
L2特征值历史读取结果 形成特征值历史读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成实例退出空载荷失败。
L2特征实例退出结果 形成特征实例退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；新值本地键必须唯一映射。
std::optional<稳定编码> 查找唯一特征当前值编码映射(
    const L1所有者范围写入结果& 写入) noexcept {
    if (写入.新编码映射.size() != 1) return std::nullopt;
    const auto& [键, 编码] = 写入.新编码映射.front();
    return 键.值 == 特征当前值本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

// 诊断责任：向上送出；当前值提交按首次代次历史重建新旧值。
L2特征当前值写入结果 提交并读回特征当前值写集(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    const L2特征值类型登记& 登记, L2特征实例身份 实例,
    const L2原始值材料& 新材料, 稳定编码 来源,
    std::optional<稳定编码> 旧值编码) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本 || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射特征定义写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成特征当前值写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成特征当前值写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    const auto 新值编码 = 查找唯一特征当前值编码映射(写入);
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !新值编码)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 属性组 = 第一层服务.读取所有者范围历史属性值组(
        {L1所有者范围CRUD合同版本, 实例.值, 写入.事实代次});
    if (属性组.状态 != L1所有者范围读取状态::成功
        || 属性组.合同版本 != L1所有者范围CRUD合同版本
        || 属性组.所属节点 != 实例.值
        || 属性组.历史截止事实代次 != 写入.事实代次
        || 属性组.读取事实代次 < 写入.事实代次)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const L1所有者范围值事实* 新值 = nullptr;
    for (const auto& 值 : 属性组.属性值组) {
        if (值.编码 != *新值编码) continue;
        if (新值) return 形成特征当前值写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新值 = &值;
    }
    const auto 类型编码 = 选择特征值类型编码(登记, 新材料);
    if (!新值 || 新值->所属节点 != 实例.值
        || 新值->属性类型节点 != 类型编码 || 新值->来源节点 != 来源
        || 转换为L2材料(新值->材料) != 新材料
        || 新值->创建事实代次 != 写入.事实代次 || 新值->退出事实代次)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    auto 当前值 = 形成截止特征值事实(*新值, 登记, 写入.事实代次);
    if (!当前值 || 当前值->生命周期.退出事实代次)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    L2特征当前值写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(当前值), std::nullopt};
    if (旧值编码) {
        const auto 旧读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, *旧值编码});
        const auto* 旧值 = 旧读取.事实
            ? std::get_if<L1所有者范围值事实>(&*旧读取.事实) : nullptr;
        if (旧读取.状态 != L1所有者范围读取状态::成功
            || 旧读取.合同版本 != L1所有者范围CRUD合同版本
            || 旧读取.查询编码 != *旧值编码 || !旧值
            || 旧值->编码 != *旧值编码 || 旧值->所属节点 != 实例.值
            || 旧值->退出事实代次 != 写入.事实代次)
            return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
        结果.已退出值 = 形成截止特征值事实(
            *旧值, 登记, 写入.事实代次, true);
        if (!结果.已退出值
            || 结果.已退出值->生命周期.退出事实代次 != 写入.事实代次)
            return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果
        : 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；显式实例闭包提交后逐项历史证明同代退出。
L2特征实例退出结果 提交并读回特征实例退出写集(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    const L2特征实例退出请求& 请求,
    const L2特征关系类型登记& 关系登记,
    const L2特征值类型登记& 值登记) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本 || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射特征定义写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成特征实例退出失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || !写入.新编码映射.empty())
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.特征实例.值});
    const auto 宿主读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.自有关系.宿主关系稳定编码});
    const auto 定义读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 请求.自有关系.定义关系稳定编码});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
    const auto* 宿主关系 = 宿主读取.事实
        ? std::get_if<L1所有者范围关系事实>(&*宿主读取.事实) : nullptr;
    const auto* 定义关系 = 定义读取.事实
        ? std::get_if<L1所有者范围关系事实>(&*定义读取.事实) : nullptr;
    if (节点读取.状态 != L1所有者范围读取状态::成功
        || 宿主读取.状态 != L1所有者范围读取状态::成功
        || 定义读取.状态 != L1所有者范围读取状态::成功
        || 节点读取.合同版本 != L1所有者范围CRUD合同版本
        || 宿主读取.合同版本 != L1所有者范围CRUD合同版本
        || 定义读取.合同版本 != L1所有者范围CRUD合同版本
        || !节点 || !宿主关系 || !定义关系
        || 节点->编码 != 请求.特征实例.值
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || 节点->退出事实代次 != 写入.事实代次
        || 宿主关系->编码 != 请求.自有关系.宿主关系稳定编码
        || 定义关系->编码 != 请求.自有关系.定义关系稳定编码
        || 宿主关系->源节点 != 请求.特征实例.值
        || 定义关系->源节点 != 请求.特征实例.值
        || 宿主关系->关系类型节点 != 关系登记.宿主关系类型.值
        || 定义关系->关系类型节点 != 关系登记.定义关系类型.值
        || 宿主关系->角色或顺序 != 特征实例端点角色值
        || 定义关系->角色或顺序 != 特征实例端点角色值
        || 宿主关系->退出事实代次 != 写入.事实代次
        || 定义关系->退出事实代次 != 写入.事实代次)
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 宿主节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 宿主关系->目标节点});
    const auto 定义节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 定义关系->目标节点});
    const auto* 宿主节点 = 宿主节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*宿主节点读取.事实) : nullptr;
    const auto* 定义节点 = 定义节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*定义节点读取.事实) : nullptr;
    const auto 端点在截止有效 = [&](const L1所有者范围节点事实* 端点) noexcept {
        return 端点 && 端点->种类 == 节点种类::普通 && !端点->属性类型表示
            && 端点->创建事实代次 != 0 && 端点->创建事实代次 <= 写入.事实代次
            && (!端点->退出事实代次 || *端点->退出事实代次 > 写入.事实代次);
    };
    if (宿主节点读取.状态 != L1所有者范围读取状态::成功
        || 定义节点读取.状态 != L1所有者范围读取状态::成功
        || !端点在截止有效(宿主节点) || !端点在截止有效(定义节点))
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    L2特征实例事实 实例;
    实例.身份 = 请求.特征实例;
    实例.宿主存在 = L2存在身份{宿主关系->目标节点};
    实例.特征定义 = L2特征定义身份{定义关系->目标节点};
    实例.生命周期 = {节点->创建事实代次, 节点->退出事实代次};
    if (!有效(实例.宿主存在.值) || !有效(实例.特征定义.值)
        || !L2生命周期完整(实例.生命周期))
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    if (请求.当前值稳定编码) {
        const auto 值读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, *请求.当前值稳定编码});
        const auto* 值 = 值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*值读取.事实) : nullptr;
        if (值读取.状态 != L1所有者范围读取状态::成功
            || 值读取.合同版本 != L1所有者范围CRUD合同版本 || !值
            || 值->编码 != *请求.当前值稳定编码
            || 值->所属节点 != 请求.特征实例.值
            || 值->退出事实代次 != 写入.事实代次)
            return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
        实例.当前值 = 形成截止特征值事实(
            *值, 值登记, 写入.事实代次, true);
        if (!实例.当前值
            || 实例.当前值->生命周期.退出事实代次 != 写入.事实代次)
            return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    }
    L2特征实例退出结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(实例), 请求.自有关系};
    return 结果.成功() ? 结果
        : 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
}

struct 特征来源读取值 final {
    L2结构结果头 结果头;
    L2读取类别 读取类别 = L2读取类别::当前;
    std::uint64_t 历史截止事实代次 = 0;
    std::optional<L2节点族身份来源事实> 身份来源;
};

特征来源读取值 形成特征来源失败(L2读取类别 类别,
    std::uint64_t 历史截止, L2结构状态 状态,
    std::uint64_t 事实截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 事实截止, std::nullopt},
        类别, 历史截止, std::nullopt};
}

L2生命周期 投影特征来源生命周期(std::uint64_t 创建,
    std::optional<std::uint64_t> 退出, std::uint64_t 截止) noexcept {
    if (退出 && *退出 > 截止) 退出.reset();
    return {创建, 退出};
}

L2结构状态 映射特征来源读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::已退出: return L2结构状态::已退出;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；定义与实例当前来源共用同一投影解释。
特征来源读取值 读取当前特征身份来源(
    const L1事实基座服务& 第一层服务, const 特征身份来源定位& 定位,
    稳定编码 节点编码, L2结构请求头 请求头) {
    if (节点编码 == 定位.族锚点 || 节点编码 == 定位.族归属关系类型)
        return 形成特征来源失败(L2读取类别::当前, 0,
            L2结构状态::入口拒绝, 请求头.期望事实代次);
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 请求头.期望事实代次;
    请求.所有者 = {定位.所有者};
    请求.节点 = {节点编码, 定位.族锚点, 定位.族归属关系类型};
    请求.源关系组 = {{节点编码, 定位.族归属关系类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
        const bool 空载荷 = 读取.所有者.empty() && 读取.节点.empty()
            && 读取.关系.empty() && 读取.值.empty() && 读取.属性值.empty()
            && 读取.源关系组.empty() && 读取.目标关系组.empty();
        const auto 状态 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
            ? L2结构状态::事实代次漂移
            : 读取.状态 == L1所有者范围一致当前读取状态::许可拒绝
                ? L2结构状态::许可拒绝
                : 读取.状态 == L1所有者范围一致当前读取状态::资源失败
                    ? L2结构状态::资源失败
                    : 读取.状态 == L1所有者范围一致当前读取状态::入口拒绝
                        ? L2结构状态::入口拒绝 : L2结构状态::内部不一致;
        const auto 截止 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
            ? 读取.读取事实代次 : 0;
        return 形成特征来源失败(L2读取类别::当前, 0,
            空载荷 ? 状态 : L2结构状态::内部不一致, 截止);
    }
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 请求头.期望事实代次
        || 读取.读取事实代次 != 请求头.期望事实代次
        || 读取.所有者.size() != 1 || 读取.节点.size() != 3
        || !读取.关系.empty() || !读取.值.empty() || !读取.属性值.empty()
        || 读取.源关系组.size() != 1 || !读取.目标关系组.empty())
        return 形成特征来源失败(L2读取类别::当前, 0,
            L2结构状态::内部不一致, 读取.读取事实代次);
    const auto 查找节点 = [&](稳定编码 编码)
        -> const L1所有者范围一致节点读取结果项* {
        const L1所有者范围一致节点读取结果项* 找到 = nullptr;
        for (const auto& 项 : 读取.节点) {
            if (项.查询编码 != 编码) continue;
            if (找到) return nullptr;
            找到 = &项;
        }
        return 找到;
    };
    const auto* 节点项 = 查找节点(节点编码);
    const auto* 锚点项 = 查找节点(定位.族锚点);
    const auto* 类型项 = 查找节点(定位.族归属关系类型);
    if (!节点项 || !锚点项 || !类型项)
        return 形成特征来源失败(L2读取类别::当前, 0,
            L2结构状态::内部不一致, 读取.读取事实代次);
    if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
        if (节点项->事实)
            return 形成特征来源失败(L2读取类别::当前, 0,
                L2结构状态::内部不一致, 读取.读取事实代次);
        const auto 状态 = 节点项->状态 == L1所有者范围一致当前读取项目状态::未找到
            ? L2结构状态::未找到
            : 节点项->状态 == L1所有者范围一致当前读取项目状态::已退出
                ? L2结构状态::已退出 : L2结构状态::入口拒绝;
        return 形成特征来源失败(L2读取类别::当前, 0, 状态,
            读取.读取事实代次);
    }
    const auto& 所有者项 = 读取.所有者.front();
    if (!节点项->事实 || !锚点项->事实 || !类型项->事实
        || 所有者项.查询所有者 != 定位.所有者
        || 所有者项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !所有者项.所有者事实)
        return 形成特征来源失败(L2读取类别::当前, 0,
            L2结构状态::内部不一致, 读取.读取事实代次);
    const auto& 节点 = *节点项->事实;
    const auto& 锚点 = *锚点项->事实;
    const auto& 类型 = *类型项->事实;
    if (节点.写入所有者 != 定位.所有者 || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.退出事实代次)
        return 形成特征来源失败(L2读取类别::当前, 0,
            L2结构状态::入口拒绝, 读取.读取事实代次);
    const auto 内部完整 = [&](const L1所有者范围节点事实& 内部,
        稳定编码 编码) noexcept {
        return 内部.编码 == 编码 && 内部.写入所有者 == 定位.所有者
            && 内部.种类 == 节点种类::普通 && !内部.属性类型表示
            && 内部.当前属性.empty() && !内部.退出事实代次
            && 内部.创建事实代次 == 定位.建立事实代次;
    };
    if (!内部完整(锚点, 定位.族锚点)
        || !内部完整(类型, 定位.族归属关系类型)
        || 读取.源关系组.front().源节点 != 节点编码
        || 读取.源关系组.front().关系类型节点 != 定位.族归属关系类型
        || 读取.源关系组.front().成员.size() != 1)
        return 形成特征来源失败(L2读取类别::当前, 0,
            读取.源关系组.front().成员.empty()
                ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
            读取.读取事实代次);
    const auto& 投影 = 读取.源关系组.front().成员.front();
    const auto& 关系 = 投影.关系;
    if (投影.对端节点 != 锚点 || 关系.写入所有者 != 定位.所有者
        || 关系.源节点 != 节点编码 || 关系.目标节点 != 定位.族锚点
        || 关系.关系类型节点 != 定位.族归属关系类型
        || 关系.角色或顺序 != 特征实例端点角色值 || 关系.退出事实代次
        || 节点.创建事实代次 != 关系.创建事实代次)
        return 形成特征来源失败(L2读取类别::当前, 0,
            L2结构状态::内部不一致, 读取.读取事实代次);
    L2节点族身份来源事实 来源{定位.节点族, 节点.编码, 定位.所有者,
        锚点.编码, 类型.编码, 关系.编码, 关系.角色或顺序,
        {所有者项.所有者事实->创建事实代次,
            所有者项.所有者事实->退出事实代次},
        {节点.创建事实代次, 节点.退出事实代次},
        {锚点.创建事实代次, 锚点.退出事实代次},
        {类型.创建事实代次, 类型.退出事实代次},
        {关系.创建事实代次, 关系.退出事实代次}};
    if (!L2节点族身份来源事实完整(来源, 读取.读取事实代次))
        return 形成特征来源失败(L2读取类别::当前, 0,
            L2结构状态::内部不一致, 读取.读取事实代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        读取.读取事实代次, std::nullopt}, L2读取类别::当前, 0,
        std::move(来源)};
}

// 诊断责任：向上送出；历史来源以同一请求截止夹取节点与归属关系。
特征来源读取值 读取历史特征身份来源(
    const L1事实基座服务& 第一层服务, const 特征身份来源定位& 定位,
    稳定编码 节点编码, L2结构请求头 请求头, std::uint64_t 历史截止) {
    const auto 前代次 = 读取特征事实代次(第一层服务);
    if (前代次.状态 != L1所有者范围读取状态::成功
        || 前代次.事实代次 != 请求头.期望事实代次)
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            前代次.状态 == L1所有者范围读取状态::成功
                ? L2结构状态::事实代次漂移
                : 映射特征来源读取状态(前代次.状态), 前代次.事实代次);
    if (节点编码 == 定位.族锚点 || 节点编码 == 定位.族归属关系类型)
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            L2结构状态::入口拒绝, 历史截止);
    const auto 所有者读取 = 第一层服务.读取历史结构所有者(
        {L1所有者范围CRUD合同版本, 定位.所有者});
    const auto 节点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 节点编码});
    const auto 锚点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 定位.族锚点});
    const auto 类型读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 定位.族归属关系类型});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
    const auto* 锚点 = 锚点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
    const auto* 类型 = 类型读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
    if (节点读取.状态 != L1所有者范围读取状态::成功) {
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            映射特征来源读取状态(节点读取.状态), 历史截止);
    }
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || !所有者读取.所有者事实 || !节点 || !锚点 || !类型
        || 所有者读取.读取事实代次 != 请求头.期望事实代次
        || 节点读取.读取事实代次 != 请求头.期望事实代次
        || 锚点读取.读取事实代次 != 请求头.期望事实代次
        || 类型读取.读取事实代次 != 请求头.期望事实代次
        || 节点->编码 != 节点编码 || 节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || 节点->创建事实代次 > 历史截止
        || 锚点->编码 != 定位.族锚点 || 类型->编码 != 定位.族归属关系类型
        || 锚点->写入所有者 != 定位.所有者 || 类型->写入所有者 != 定位.所有者
        || 锚点->创建事实代次 != 定位.建立事实代次
        || 类型->创建事实代次 != 定位.建立事实代次)
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            L2结构状态::内部不一致, 历史截止);
    const std::uint64_t 关系截止 = 节点->退出事实代次
            && *节点->退出事实代次 <= 历史截止
        ? *节点->退出事实代次 - 1 : 历史截止;
    const auto 关系组 = 第一层服务.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
            节点编码, 定位.族归属关系类型, 关系截止});
    if (关系组.状态 != L1所有者范围读取状态::成功
        || 关系组.读取事实代次 != 请求头.期望事实代次
        || 关系组.关系组.size() != 1)
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            关系组.状态 == L1所有者范围读取状态::成功
                && 关系组.关系组.empty() ? L2结构状态::入口拒绝
                : L2结构状态::内部不一致, 历史截止);
    const auto& 关系 = 关系组.关系组.front();
    if (关系.写入所有者 != 定位.所有者 || 关系.源节点 != 节点编码
        || 关系.目标节点 != 定位.族锚点
        || 关系.关系类型节点 != 定位.族归属关系类型
        || 关系.角色或顺序 != 特征实例端点角色值
        || 关系.创建事实代次 != 节点->创建事实代次
        || 关系.退出事实代次 != 节点->退出事实代次)
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            L2结构状态::内部不一致, 历史截止);
    const auto 后代次 = 读取特征事实代次(第一层服务);
    if (后代次.状态 != L1所有者范围读取状态::成功
        || 后代次.事实代次 != 请求头.期望事实代次)
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            L2结构状态::事实代次漂移, 后代次.事实代次);
    L2节点族身份来源事实 来源{定位.节点族, 节点->编码, 定位.所有者,
        锚点->编码, 类型->编码, 关系.编码, 关系.角色或顺序,
        投影特征来源生命周期(所有者读取.所有者事实->创建事实代次,
            所有者读取.所有者事实->退出事实代次, 历史截止),
        投影特征来源生命周期(节点->创建事实代次,
            节点->退出事实代次, 历史截止),
        投影特征来源生命周期(锚点->创建事实代次,
            锚点->退出事实代次, 历史截止),
        投影特征来源生命周期(类型->创建事实代次,
            类型->退出事实代次, 历史截止),
        投影特征来源生命周期(关系.创建事实代次,
            关系.退出事实代次, 历史截止)};
    if (!L2节点族身份来源事实完整(来源, 历史截止))
        return 形成特征来源失败(L2读取类别::历史, 历史截止,
            L2结构状态::内部不一致, 历史截止);
    return {{L2结构合同版本, L2结构状态::已读取, 历史截止, std::nullopt},
        L2读取类别::历史, 历史截止, std::move(来源)};
}

// 诊断责任：向上送出；定义与实例共用一条参数化来源初始化路径。
特征身份来源定位 初始化特征身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口,
    L2节点族 节点族, L1所有者范围写入幂等身份 幂等身份,
    std::uint32_t 锚点本地键, std::uint32_t 类型本地键) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 feature owner fact is invalid");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    const auto 当前代次 = 读取特征事实代次(第一层服务);
    if (当前代次.状态 != L1所有者范围读取状态::成功
        || 当前代次.事实代次 == 0)
        throw std::runtime_error("L2 feature identity source generation is invalid");
    写集.期望事实代次 = 当前代次.事实代次;
    写集.写入幂等身份 = 幂等身份;
    写集.节点 = {{{锚点本地键}, 节点种类::普通, std::nullopt},
        {{类型本地键}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者 || 写入.写入幂等身份 != 幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 2)
        throw std::runtime_error("L2 feature identity source initialization failed");
    稳定编码 锚点编码;
    稳定编码 类型编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码))
            throw std::runtime_error("L2 feature identity source mapping is invalid");
        if (本地键.值 == 锚点本地键) 锚点编码 = 编码;
        else if (本地键.值 == 类型本地键) 类型编码 = 编码;
        else throw std::runtime_error("L2 feature identity source mapping is unknown");
    }
    if (!有效(锚点编码) || !有效(类型编码) || 锚点编码 == 类型编码)
        throw std::runtime_error("L2 feature identity source mapping is incomplete");
    const auto 锚点读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 锚点编码});
    const auto 类型读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 类型编码});
    const auto* 锚点 = 锚点读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
    const auto* 类型 = 类型读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
    const auto 节点完整 = [&](const auto& 读取,
        const L1所有者范围节点事实* 节点, 稳定编码 编码) noexcept {
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者 && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次
            && !节点->退出事实代次;
    };
    if (!节点完整(锚点读取, 锚点, 锚点编码)
        || !节点完整(类型读取, 类型, 类型编码))
        throw std::runtime_error("L2 feature identity source readback is invalid");
    return {节点族, 所有者, 锚点编码, 类型编码, 写入.事实代次};
}

} // namespace 海中鱼巣::L2特征结构内部

export namespace 海中鱼巣 {

std::optional<L2特征定义所有者交付> 尝试形成L2特征定义所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 特征定义所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务)) return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2特征定义所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) { return std::nullopt; }
}

std::optional<L2特征实例所有者交付> 尝试形成L2特征实例所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 特征实例所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务)) return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2特征实例所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) { return std::nullopt; }
}

class L2特征结构服务 final {
public:
    // 诊断责任：向上送出；两份强类型交付必须有效且绑定同一 L1 实例。
    explicit L2特征结构服务(
        const L1事实基座服务& 第一层服务,
        const L2存在结构服务& 存在服务,
        L2特征定义所有者交付&& 特征定义所有者交付,
        L2特征实例所有者交付&& 特征实例所有者交付)
        : 第一层服务_(第一层服务), 存在服务_(存在服务),
          特征定义写入端口_(验证并移动定义交付(
              第一层服务, 特征定义所有者交付)),
          特征实例写入端口_(验证并移动实例交付(
              第一层服务, 特征实例所有者交付)),
          特征定义身份来源定位_(L2特征结构内部::初始化特征身份来源(
              第一层服务_, 特征定义写入端口_, L2节点族::特征定义,
              L2特征结构内部::特征定义身份来源登记幂等身份,
              L2特征结构内部::特征定义族锚点本地键值,
              L2特征结构内部::特征定义族归属类型本地键值)) {
        const auto 当前代次 = [&]() {
            const auto 读取 = L2特征结构内部::读取特征事实代次(第一层服务_);
            if (读取.状态 != L1所有者范围读取状态::成功)
                throw std::runtime_error("L2 feature initialization generation read failed");
            return 读取.事实代次;
        };
        派生结构定位_ = L2特征结构内部::初始化特征定义派生结构(
            第一层服务_, 特征定义写入端口_, 当前代次());
        const auto 定义属性 = 建立特征定义属性类型登记(
            {{L2结构合同版本, 当前代次()},
                L2特征定义属性类型登记规则版本, {1}});
        if (!定义属性.成功())
            throw std::runtime_error("L2 feature definition attribute types failed");
        特征实例身份来源定位_ = L2特征结构内部::初始化特征身份来源(
            第一层服务_, 特征实例写入端口_, L2节点族::特征实例,
            L2特征结构内部::特征实例身份来源登记幂等身份,
            L2特征结构内部::特征实例族锚点本地键值,
            L2特征结构内部::特征实例族归属类型本地键值);
        const auto 关系 = 建立特征关系类型登记(
            {{L2结构合同版本, 当前代次()}, L2特征关系类型登记规则版本, {1}});
        if (!关系.成功())
            throw std::runtime_error("L2 feature relation types failed");
        const auto 值 = 建立特征值类型登记(
            {{L2结构合同版本, 当前代次()}, L2特征值类型登记规则版本, {1}});
        if (!值.成功()) throw std::runtime_error("L2 feature value types failed");
    }
    L2特征结构服务(const L2特征结构服务&) = delete;
    L2特征结构服务& operator=(const L2特征结构服务&) = delete;

    // 诊断责任：向上送出；定义与实例只传族专属定位，来源算法保持单路径。
    L2特征定义身份来源读取结果 读取特征定义身份来源(
        const L2特征定义身份来源读取请求& 请求) const {
        if (!L2特征定义身份来源读取请求有效(请求)) return {};
        try {
            auto 读取 = 请求.读取类别 == L2读取类别::当前
                ? L2特征结构内部::读取当前特征身份来源(
                    第一层服务_, 特征定义身份来源定位_,
                    请求.特征定义.值, 请求.请求头)
                : L2特征结构内部::读取历史特征身份来源(
                    第一层服务_, 特征定义身份来源定位_,
                    请求.特征定义.值, 请求.请求头,
                    请求.历史截止事实代次);
            return {读取.结果头, 读取.读取类别,
                读取.历史截止事实代次, std::move(读取.身份来源)};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        }
    }

    L2特征实例身份来源读取结果 读取特征实例身份来源(
        const L2特征实例身份来源读取请求& 请求) const {
        if (!L2特征实例身份来源读取请求有效(请求)) return {};
        try {
            if (!特征实例身份来源定位_)
                return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                    std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            auto 读取 = 请求.读取类别 == L2读取类别::当前
                ? L2特征结构内部::读取当前特征身份来源(
                    第一层服务_, *特征实例身份来源定位_,
                    请求.特征实例.值, 请求.请求头)
                : L2特征结构内部::读取历史特征身份来源(
                    第一层服务_, *特征实例身份来源定位_,
                    请求.特征实例.值, 请求.请求头,
                    请求.历史截止事实代次);
            return {读取.结果头, 读取.读取类别,
                读取.历史截止事实代次, std::move(读取.身份来源)};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        }
    }

    // 诊断责任：向上送出；登记拒绝、漂移、冲突和读回矛盾均结构化返回。
    L2特征关系类型登记结果 建立特征关系类型登记(
        const L2特征关系类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(关系类型登记锁_);
            if (!L2特征关系类型登记请求有效(请求))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::入口拒绝);
            if (关系类型登记定位_) {
                if (!L2特征关系类型登记完整(*关系类型登记定位_))
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致);
                if (关系类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 关系类型登记定位_->规则版本 != 请求.规则版本
                    || 关系类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 关系类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::幂等冲突);
            }

            const auto 幂等键 =
                L2特征结构内部::映射特征关系类型登记幂等键(请求.幂等身份);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 幂等键;
            写集.节点 = {
                {{L2特征结构内部::特征宿主关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2特征结构内部::特征定义关系类型本地键值},
                    节点种类::普通, std::nullopt}};
            const auto 写入 = 特征实例写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本 || 写入.写入幂等身份 != 幂等键)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 状态 =
                L2特征结构内部::映射特征关系类型登记写入状态(写入.状态);
            if (状态 != L2特征关系类型登记状态::已提交
                && 状态 != L2特征关系类型登记状态::精确重复) {
                const auto 截止 = 状态 == L2特征关系类型登记状态::事实代次漂移
                    || 状态 == L2特征关系类型登记状态::幂等冲突
                    ? 写入.事实代次 : 0;
                return L2特征结构内部::形成特征关系类型登记失败(状态, 截止);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2特征结构内部::特征关系类型编码映射唯一(写入))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 宿主编码 = L2特征结构内部::查找特征关系类型编码映射(
                写入, L2特征结构内部::特征宿主关系类型本地键值);
            const auto 定义编码 = L2特征结构内部::查找特征关系类型编码映射(
                写入, L2特征结构内部::特征定义关系类型本地键值);
            if (!宿主编码 || !定义编码 || *宿主编码 == *定义编码)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);

            L2特征关系类型登记 新定位;
            新定位.合同版本 = 请求.请求头.合同版本;
            新定位.规则版本 = 请求.规则版本;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            新定位.建立事实代次 = 写入.事实代次;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.宿主关系类型 = {*宿主编码};
            新定位.定义关系类型 = {*定义编码};
            if (!L2特征关系类型登记完整(新定位))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            auto 读回 = 按定位读取当前特征关系类型登记(新定位, 写入.事实代次);
            if (读回.状态 != L2特征关系类型登记状态::已读取
                || !读回.登记 || !读回.成功())
                return 读回.状态 == L2特征关系类型登记状态::已读取
                    ? L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致) : 读回;
            if (关系类型登记定位_ && *关系类型登记定位_ != 新定位)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            关系类型登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；定位在锁内复制，节点在锁外公开读取。
    L2特征关系类型登记结果 读取当前特征关系类型登记() const {
        try {
            std::optional<L2特征关系类型登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(关系类型登记锁_);
                定位 = 关系类型登记定位_;
            }
            if (!定位) return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::登记未加载);
            return 按定位读取当前特征关系类型登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；四种属性类型节点由一份固定登记写集建立。
    L2特征定义属性类型登记结果 建立特征定义属性类型登记(
        const L2特征定义属性类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(定义属性类型登记锁_);
            if (!L2特征定义属性类型登记请求有效(请求))
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    L2特征定义属性类型登记状态::入口拒绝);
            if (定义属性类型登记定位_) {
                if (!L2特征定义属性类型登记完整(*定义属性类型登记定位_)
                    || 定义属性类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2特征结构内部::形成特征定义属性类型登记失败(
                        L2特征定义属性类型登记状态::幂等冲突);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::特征定义属性类型登记幂等身份;
            写集.节点 = {
                {{L2特征结构内部::特征定义I64属性类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2特征结构内部::特征定义I64组属性类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2特征结构内部::特征定义U64组属性类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2特征结构内部::特征定义独立材料属性类型本地键值},
                    节点种类::属性类型,
                    L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 特征定义写入端口_.提交所有者范围中性写集(写集);
            L2特征定义属性类型登记状态 状态 =
                L2特征定义属性类型登记状态::内部不一致;
            switch (写入.状态) {
            case L1所有者范围写入状态::成功:
                状态 = L2特征定义属性类型登记状态::已提交; break;
            case L1所有者范围写入状态::精确重复:
                状态 = L2特征定义属性类型登记状态::精确重复; break;
            case L1所有者范围写入状态::入口拒绝:
                状态 = L2特征定义属性类型登记状态::入口拒绝; break;
            case L1所有者范围写入状态::许可拒绝:
                状态 = L2特征定义属性类型登记状态::许可拒绝; break;
            case L1所有者范围写入状态::事实代次漂移:
                状态 = L2特征定义属性类型登记状态::事实代次漂移; break;
            case L1所有者范围写入状态::幂等冲突:
                状态 = L2特征定义属性类型登记状态::幂等冲突; break;
            case L1所有者范围写入状态::资源失败:
                状态 = L2特征定义属性类型登记状态::资源失败; break;
            default: break;
            }
            if (状态 != L2特征定义属性类型登记状态::已提交
                && 状态 != L2特征定义属性类型登记状态::精确重复)
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    状态, 写入.事实代次);
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 特征定义写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || 写入.新编码映射.size() != 4)
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    L2特征定义属性类型登记状态::内部不一致);
            const auto 查找 = [&](std::uint32_t 键值) -> std::optional<稳定编码> {
                std::optional<稳定编码> 找到;
                for (const auto& [键, 编码] : 写入.新编码映射) {
                    if (键.值 != 键值) continue;
                    if (找到 || !有效(编码)) return std::nullopt;
                    找到 = 编码;
                }
                return 找到;
            };
            const auto 有符号64位 = 查找(L2特征结构内部::特征定义I64属性类型本地键值);
            const auto 有符号64位组 = 查找(L2特征结构内部::特征定义I64组属性类型本地键值);
            const auto 无符号64位组 = 查找(L2特征结构内部::特征定义U64组属性类型本地键值);
            const auto 独立材料 = 查找(
                L2特征结构内部::特征定义独立材料属性类型本地键值);
            if (!有符号64位 || !有符号64位组 || !无符号64位组 || !独立材料)
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    L2特征定义属性类型登记状态::内部不一致);
            L2特征定义属性类型登记 新定位;
            新定位.合同版本 = 请求.请求头.合同版本;
            新定位.规则版本 = 请求.规则版本;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            新定位.建立事实代次 = 写入.事实代次;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.I64属性类型 = {*有符号64位};
            新定位.I64组属性类型 = {*有符号64位组};
            新定位.U64组属性类型 = {*无符号64位组};
            新定位.独立材料属性类型 = {*独立材料};
            if (!L2特征定义属性类型登记完整(新定位))
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    L2特征定义属性类型登记状态::内部不一致);
            定义属性类型登记定位_ = 新定位;
            return {状态, 写入.事实代次, std::move(新定位)};
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征定义属性类型登记失败(
                L2特征定义属性类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征定义属性类型登记失败(
                L2特征定义属性类型登记状态::内部不一致);
        }
    }

    L2特征定义属性类型登记结果 读取当前特征定义属性类型登记() const {
        try {
            std::lock_guard<std::mutex> 锁(定义属性类型登记锁_);
            if (!定义属性类型登记定位_)
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    L2特征定义属性类型登记状态::登记未加载);
            auto 定位 = *定义属性类型登记定位_;
            const auto 代次 = L2特征结构内部::读取特征事实代次(第一层服务_);
            if (代次.状态 != L1所有者范围读取状态::成功)
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    L2特征定义属性类型登记状态::内部不一致, 代次.事实代次);
            定位.事实截止代次 = 代次.事实代次;
            if (!L2特征定义属性类型登记完整(定位))
                return L2特征结构内部::形成特征定义属性类型登记失败(
                    L2特征定义属性类型登记状态::内部不一致, 代次.事实代次);
            return {L2特征定义属性类型登记状态::已读取,
                代次.事实代次, std::move(定位)};
        } catch (...) {
            return L2特征结构内部::形成特征定义属性类型登记失败(
                L2特征定义属性类型登记状态::内部不一致);
        }
    }

    L2特征值类型登记结果 建立特征值类型登记(
        const L2特征值类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(值类型登记锁_);
            if (!L2特征值类型登记请求有效(请求))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::入口拒绝);
            if (值类型登记定位_) {
                if (!L2特征值类型登记完整(*值类型登记定位_))
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致);
                if (值类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 值类型登记定位_->规则版本 != 请求.规则版本
                    || 值类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 值类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::幂等冲突);
            }
            const auto 幂等键 =
                L2特征结构内部::映射特征值类型登记幂等键(请求.幂等身份);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 幂等键;
            写集.节点 = {
                {{L2特征结构内部::特征I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2特征结构内部::特征I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2特征结构内部::特征U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2特征结构内部::特征独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 特征实例写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本 || 写入.写入幂等身份 != 幂等键)
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            const auto 状态 =
                L2特征结构内部::映射特征值类型登记写入状态(写入.状态);
            if (状态 != L2特征值类型登记状态::已提交
                && 状态 != L2特征值类型登记状态::精确重复) {
                const auto 截止 = 状态 == L2特征值类型登记状态::事实代次漂移
                    || 状态 == L2特征值类型登记状态::幂等冲突
                    ? 写入.事实代次 : 0;
                return L2特征结构内部::形成特征值类型登记失败(状态, 截止);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2特征结构内部::特征值类型编码映射唯一(写入))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            const auto 有符号64位 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征I64值类型本地键值);
            const auto 有符号64位组 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征I64组值类型本地键值);
            const auto 无符号64位组 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征U64组值类型本地键值);
            const auto 独立材料 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征独立材料值类型本地键值);
            if (!有符号64位 || !有符号64位组 || !无符号64位组 || !独立材料)
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            L2特征值类型登记 新定位;
            新定位.合同版本 = 请求.请求头.合同版本;
            新定位.规则版本 = 请求.规则版本;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            新定位.建立事实代次 = 写入.事实代次;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.I64值类型 = {*有符号64位};
            新定位.I64组值类型 = {*有符号64位组};
            新定位.U64组值类型 = {*无符号64位组};
            新定位.独立材料值类型 = {*独立材料};
            if (!L2特征值类型登记完整(新定位))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            auto 读回 = 按定位读取当前特征值类型登记(新定位, 写入.事实代次);
            if (读回.状态 != L2特征值类型登记状态::已读取
                || !读回.登记 || !读回.成功())
                return 读回.状态 == L2特征值类型登记状态::已读取
                    ? L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致) : 读回;
            if (值类型登记定位_ && *值类型登记定位_ != 新定位)
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            值类型登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；定位在锁内复制，四节点在锁外一致读取。
    L2特征值类型登记结果 读取当前特征值类型登记() const {
        try {
            std::optional<L2特征值类型登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(值类型登记锁_);
                定位 = 值类型登记定位_;
            }
            if (!定位) return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::登记未加载);
            return 按定位读取当前特征值类型登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；所有异常、拒绝和读回矛盾均映射为结构化状态。
    L2统一特征定义写入结果 新增统一特征定义(
        const L2统一特征定义新增请求& 请求) {
        if (!L2统一特征定义新增请求有效(请求)) return {};
        const auto 失败 = [](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2统一特征定义写入结果{
                {L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
        };
        try {
            if (!派生结构定位_) return 失败(L2结构状态::内部不一致);
            std::uint32_t 最大来源阶次 = 0;
            if (!请求.直接来源.empty()) {
                for (const auto& 来源 : 请求.直接来源) {
                    const auto 来源读取 = 读取完整统一特征定义({请求.请求头,
                        L2读取类别::当前, 来源.来源特征定义, 0});
                    if (!来源读取.成功() || !来源读取.特征定义)
                        return 失败(来源读取.结果头.状态,
                            来源读取.结果头.事实截止代次);
                    const auto* 阶次 = std::get_if<std::int64_t>(
                        &来源读取.特征定义->实际阶次属性.类型化不可变材料);
                    if (!阶次 || *阶次 <= 0
                        || static_cast<std::uint64_t>(*阶次) > 0xffff'ffffULL)
                        return 失败(L2结构状态::内部不一致,
                            来源读取.结果头.事实截止代次);
                    最大来源阶次 = std::max(最大来源阶次,
                        static_cast<std::uint32_t>(*阶次));
                }
                if (最大来源阶次 == 0xffff'ffffU
                    || 请求.实际阶次 != 最大来源阶次 + 1)
                    return 失败(L2结构状态::入口拒绝,
                        请求.请求头.期望事实代次);
            }
            const auto 幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = 幂等键;
            写集.节点 = {{{L2特征结构内部::特征定义节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {{{L2特征结构内部::特征定义族归属关系本地键值},
                L1所有者范围写集本地键{
                    L2特征结构内部::特征定义节点本地键值},
                特征定义身份来源定位_.族锚点,
                特征定义身份来源定位_.族归属关系类型,
                L2特征结构内部::特征实例端点角色值}};
            写集.值 = {{{L2特征结构内部::实际阶次值本地键值},
                L1所有者范围写集本地键{
                    L2特征结构内部::特征定义节点本地键值},
                派生结构定位_->实际阶次属性类型,
                static_cast<std::int64_t>(请求.实际阶次),
                L1所有者范围写集本地键{
                    L2特征结构内部::特征定义节点本地键值}}};
            写集.属性槽变更 = {{
                L1所有者范围写集本地键{
                    L2特征结构内部::特征定义节点本地键值},
                派生结构定位_->实际阶次属性类型,
                {L2特征结构内部::实际阶次值本地键值}}};
            std::vector<std::uint32_t> 已用本地键{
                L2特征结构内部::特征定义节点本地键值,
                L2特征结构内部::特征定义族归属关系本地键值,
                L2特征结构内部::实际阶次值本地键值};
            if (请求.派生规则) {
                已用本地键.push_back(L2特征结构内部::派生规则见证值本地键值);
                写集.值.push_back({
                    {L2特征结构内部::派生规则见证值本地键值},
                    L1所有者范围写集本地键{
                        L2特征结构内部::特征定义节点本地键值},
                    派生结构定位_->派生规则见证属性类型,
                    std::vector<std::uint64_t>{请求.派生规则->规则身份.值.值,
                        请求.派生规则->规则版本},
                    L1所有者范围写集本地键{
                        L2特征结构内部::特征定义节点本地键值}});
                写集.属性槽变更.push_back({
                    L1所有者范围写集本地键{
                        L2特征结构内部::特征定义节点本地键值},
                    派生结构定位_->派生规则见证属性类型,
                    {L2特征结构内部::派生规则见证值本地键值}});
            }
            std::uint32_t 候选本地键 = 1;
            for (const auto& 来源 : 请求.直接来源) {
                while (std::find(已用本地键.begin(), 已用本地键.end(),
                        候选本地键) != 已用本地键.end()) {
                    if (候选本地键 == 0xffff'ffffU)
                        return 失败(L2结构状态::资源失败);
                    ++候选本地键;
                }
                const auto 本地键 = 候选本地键;
                已用本地键.push_back(本地键);
                const auto 编码 = (static_cast<std::uint64_t>(来源.顺序) << 32)
                    | static_cast<std::uint64_t>(来源.输入角色);
                if (编码 == 0 || 编码 > 0x7fff'ffff'ffff'ffffULL)
                    return 失败(L2结构状态::入口拒绝);
                写集.关系.push_back({{本地键},
                    L1所有者范围写集本地键{
                        L2特征结构内部::特征定义节点本地键值},
                    来源.来源特征定义.值,
                    派生结构定位_->直接来源关系类型,
                    static_cast<std::int64_t>(编码)});
                if (候选本地键 == 0xffff'ffffU
                    && &来源 != &请求.直接来源.back())
                    return 失败(L2结构状态::资源失败);
                ++候选本地键;
            }

            const auto 写入 = 特征定义写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2特征结构内部::映射特征定义写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return 失败(L2结构状态::内部不一致, 写入.事实代次);
                return 失败(状态, 写入.事实代次);
            }

            const bool 首次成功完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 特征定义写入端口_.所有者身份()
                || 写入.写入幂等身份 != 幂等键 || 写入.事实代次 == 0
                || (!首次成功完整 && !重复成功完整)
                || 写入.新编码映射.size() != 已用本地键.size())
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 查找编码 = [&](std::uint32_t 键值) -> std::optional<稳定编码> {
                std::optional<稳定编码> 找到;
                for (const auto& [键, 编码] : 写入.新编码映射) {
                    if (键.值 != 键值) continue;
                    if (找到 || !有效(编码)) return std::nullopt;
                    找到 = 编码;
                }
                return 找到;
            };
            for (const auto 键值 : 已用本地键)
                if (!查找编码(键值))
                    return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 定义编码 = 查找编码(
                L2特征结构内部::特征定义节点本地键值);
            if (!定义编码) return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 读回 = 读取完整统一特征定义({
                {L2结构合同版本, 写入.事实代次}, L2读取类别::当前,
                L2特征定义身份{*定义编码}, 0});
            if (!读回.成功() || !读回.特征定义)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto* 阶次 = std::get_if<std::int64_t>(
                &读回.特征定义->实际阶次属性.类型化不可变材料);
            if (!阶次 || *阶次 != 请求.实际阶次
                || 读回.特征定义->直接来源.size() != 请求.直接来源.size()
                || static_cast<bool>(读回.特征定义->派生规则)
                    != static_cast<bool>(请求.派生规则))
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            for (std::size_t i = 0; i < 请求.直接来源.size(); ++i)
                if (读回.特征定义->直接来源[i].顺序 != 请求.直接来源[i].顺序
                    || 读回.特征定义->直接来源[i].输入角色
                        != 请求.直接来源[i].输入角色
                    || 读回.特征定义->直接来源[i].来源特征定义
                        != 请求.直接来源[i].来源特征定义)
                    return 失败(L2结构状态::内部不一致, 写入.事实代次);
            if (请求.派生规则) {
                const auto* 材料 = std::get_if<std::vector<std::uint64_t>>(
                    &读回.特征定义->派生规则->规则见证属性.类型化不可变材料);
                if (!材料 || *材料 != std::vector<std::uint64_t>{
                        请求.派生规则->规则身份.值.值,
                        请求.派生规则->规则版本})
                    return 失败(L2结构状态::内部不一致, 写入.事实代次);
            }
            L2统一特征定义写入结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, std::move(读回.特征定义)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；初始属性由一份写集建值、设槽并按首次代次读回。
    L2特征定义固定属性写入结果 新增特征定义固定属性(
        const L2特征定义固定属性新增请求& 请求) {
        if (!L2特征定义固定属性新增请求有效(请求)) return {};
        try {
            const auto 类型登记 = 读取当前特征定义属性类型登记();
            if (!类型登记.成功() || !类型登记.登记
                || L2特征结构内部::选择特征定义属性类型编码(
                    *类型登记.登记, 请求.新属性.原始值材料)
                    != 请求.新属性.属性类型身份)
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    类型登记.成功() ? L2结构状态::入口拒绝
                        : L2结构状态::内部不一致,
                    类型登记.事实截止代次);
            const auto 定义 = 读取完整统一特征定义({请求.请求头,
                L2读取类别::当前, 请求.特征定义, 0});
            if (!定义.成功())
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    定义.结果头.状态, 定义.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征定义固定属性值本地键值},
                L1所有者范围事实引用{请求.特征定义.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                L2特征结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1所有者范围事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1所有者范围事实引用{请求.特征定义.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                {L2特征结构内部::特征定义固定属性值本地键值}}};
            const auto 代次 = L2特征结构内部::检查特征定义当前代次(
                第一层服务_, 请求.特征定义.值, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2特征结构内部::检查特征定义固定属性前置(
                    第一层服务_, 请求.特征定义, 请求.新属性.属性类型身份,
                    std::nullopt, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2特征结构内部::形成特征定义固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2特征结构内部::提交并读回特征定义固定属性写集(
                第一层服务_, 特征定义写入端口_, 写集,
                请求.特征定义, 请求.新属性, std::nullopt);
            return 结果.成功() && !结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2特征结构内部::形成特征定义固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；换代在一份写集中建立新值、切槽并退出具名旧值。
    L2特征定义固定属性写入结果 换代特征定义固定属性(
        const L2特征定义固定属性换代请求& 请求) {
        if (!L2特征定义固定属性换代请求有效(请求)) return {};
        try {
            const auto 类型登记 = 读取当前特征定义属性类型登记();
            if (!类型登记.成功() || !类型登记.登记
                || L2特征结构内部::选择特征定义属性类型编码(
                    *类型登记.登记, 请求.新属性.原始值材料)
                    != 请求.新属性.属性类型身份)
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    类型登记.成功() ? L2结构状态::入口拒绝
                        : L2结构状态::内部不一致,
                    类型登记.事实截止代次);
            const auto 定义 = 读取完整统一特征定义({请求.请求头,
                L2读取类别::当前, 请求.特征定义, 0});
            if (!定义.成功())
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    定义.结果头.状态, 定义.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征定义固定属性值本地键值},
                L1所有者范围事实引用{请求.特征定义.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                L2特征结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1所有者范围事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1所有者范围事实引用{请求.特征定义.值},
                L1所有者范围事实引用{请求.新属性.属性类型身份},
                {L2特征结构内部::特征定义固定属性值本地键值}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 = L2特征结构内部::检查特征定义当前代次(
                第一层服务_, 请求.特征定义.值, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2特征结构内部::检查特征定义固定属性前置(
                    第一层服务_, 请求.特征定义, 请求.新属性.属性类型身份,
                    请求.旧值稳定编码, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2特征结构内部::形成特征定义固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2特征结构内部::提交并读回特征定义固定属性写集(
                第一层服务_, 特征定义写入端口_, 写集,
                请求.特征定义, 请求.新属性,
                请求.旧值稳定编码);
            return 结果.成功() && 结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2特征结构内部::形成特征定义固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史完整读取失败均不携带部分特征定义。
    L2统一特征定义完整读取结果 读取完整统一特征定义(
        const L2统一特征定义完整读取请求& 请求) const {
        if (!L2统一特征定义完整读取请求有效(请求)) return {};
        const auto 失败 = [&](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2特征结构内部::形成完整特征定义读取失败(
                请求, 状态, 截止);
        };
        try {
            const auto 来源 = 读取特征定义身份来源({请求.请求头,
                请求.读取类别, 请求.特征定义,
                请求.历史截止事实代次});
            if (!来源.成功() || !来源.身份来源)
                return 失败(来源.结果头.状态, 来源.结果头.事实截止代次);
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 组 = 读取全部当前统一特征定义({请求.请求头});
                if (!组.成功()) return 失败(组.结果头.状态,
                    组.结果头.事实截止代次);
                const auto 找到 = std::lower_bound(组.特征定义组.begin(),
                    组.特征定义组.end(), 请求.特征定义.值,
                    [](const auto& 候选, 稳定编码 编码) noexcept {
                        return 候选.身份.值 < 编码;
                    });
                if (找到 == 组.特征定义组.end() || 找到->身份 != 请求.特征定义)
                    return 失败(L2结构状态::内部不一致,
                        组.结果头.事实截止代次);
                L2统一特征定义完整读取结果 结果{组.结果头,
                    L2读取类别::当前, 0, *找到};
                return 结果.成功() ? 结果
                    : 失败(L2结构状态::内部不一致,
                        组.结果头.事实截止代次);
            }
            if (!派生结构定位_)
                return 失败(L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            L2特征定义属性类型登记 公开属性定位;
            {
                std::lock_guard<std::mutex> 锁(定义属性类型登记锁_);
                if (!定义属性类型登记定位_)
                    return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                公开属性定位 = *定义属性类型登记定位_;
            }
            const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.特征定义.值});
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
            if (节点读取.状态 != L1所有者范围读取状态::成功 || !节点)
                return 失败(L2特征结构内部::映射特征定义历史读取状态(
                    节点读取.状态), 请求.历史截止事实代次);
            if (节点读取.合同版本 != L1所有者范围CRUD合同版本
                || 节点读取.读取事实代次 != 请求.请求头.期望事实代次
                || 节点->编码 != 请求.特征定义.值
                || 节点->写入所有者 != 特征定义身份来源定位_.所有者
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 > 请求.历史截止事实代次)
                return 失败(L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            const auto 发现截止 = 节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次
                ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
            if (发现截止 == 0)
                return 失败(L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            const auto 属性组 = 第一层服务_.读取所有者范围历史属性值组(
                {L1所有者范围CRUD合同版本, 请求.特征定义.值, 发现截止});
            const auto 来源组 = 第一层服务_.读取所有者范围历史关系组({
                L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::源, 请求.特征定义.值,
                派生结构定位_->直接来源关系类型, 发现截止});
            if (属性组.状态 != L1所有者范围读取状态::成功
                || 来源组.状态 != L1所有者范围读取状态::成功
                || 属性组.合同版本 != L1所有者范围CRUD合同版本
                || 来源组.合同版本 != L1所有者范围CRUD合同版本
                || 属性组.读取事实代次 != 请求.请求头.期望事实代次
                || 来源组.读取事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            L2统一特征定义事实 定义;
            定义.身份 = 请求.特征定义;
            定义.生命周期 = {节点->创建事实代次,
                节点->退出事实代次 && *节点->退出事实代次
                    <= 请求.历史截止事实代次
                    ? 节点->退出事实代次 : std::nullopt};
            bool 已有阶次 = false;
            bool 已有规则 = false;
            const auto 是固定类型 = [&](稳定编码 类型) noexcept {
                return 类型 == 公开属性定位.I64属性类型.值
                    || 类型 == 公开属性定位.I64组属性类型.值
                    || 类型 == 公开属性定位.U64组属性类型.值
                    || 类型 == 公开属性定位.独立材料属性类型.值;
            };
            for (const auto& 值 : 属性组.属性值组) {
                auto 属性 = L2特征结构内部::形成截止属性事实(
                    值, 请求.历史截止事实代次);
                if (!属性)
                    return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                if (值.属性类型节点 == 派生结构定位_->实际阶次属性类型) {
                    if (已有阶次
                        || 属性->来源稳定编码 != 请求.特征定义.值)
                        return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                    已有阶次 = true;
                    定义.实际阶次属性 = std::move(*属性);
                } else if (值.属性类型节点
                    == 派生结构定位_->派生规则见证属性类型) {
                    if (已有规则
                        || 属性->来源稳定编码 != 请求.特征定义.值)
                        return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                    已有规则 = true;
                    定义.派生规则 = L2特征派生规则事实{std::move(*属性)};
                } else if (是固定类型(值.属性类型节点))
                    定义.固定属性.push_back(std::move(*属性));
                else return 失败(L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            }
            if (!已有阶次) return 失败(L2结构状态::内部不一致,
                请求.历史截止事实代次);
            std::sort(定义.固定属性.begin(), 定义.固定属性.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.属性类型身份 < 右.属性类型身份;
                });
            for (auto 关系 : 来源组.关系组) {
                if (关系.源节点 != 请求.特征定义.值
                    || 关系.关系类型节点 != 派生结构定位_->直接来源关系类型
                    || 关系.写入所有者 != 派生结构定位_->所有者)
                    return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                if (关系.退出事实代次
                    && *关系.退出事实代次 > 请求.历史截止事实代次)
                    关系.退出事实代次.reset();
                const auto 角色值 = static_cast<std::uint64_t>(关系.角色或顺序);
                const auto 顺序 = static_cast<std::uint32_t>(角色值 >> 32);
                const auto 角色 = static_cast<std::uint32_t>(角色值 & 0xffff'ffffULL);
                if (关系.角色或顺序 <= 0 || 顺序 == 0
                    || 顺序 > 0x7fff'ffffU || 角色 == 0)
                    return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                定义.直接来源.push_back({关系.编码, 顺序, 角色,
                    L2特征定义身份{关系.目标节点},
                    {关系.创建事实代次, 关系.退出事实代次}});
            }
            std::sort(定义.直接来源.begin(), 定义.直接来源.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.顺序 < 右.顺序;
                });
            std::uint32_t 最大来源阶次 = 0;
            for (const auto& 直接来源 : 定义.直接来源) {
                const auto 来源定义 = 读取完整统一特征定义({请求.请求头,
                    L2读取类别::历史, 直接来源.来源特征定义,
                    请求.历史截止事实代次});
                if (!来源定义.成功() || !来源定义.特征定义)
                    return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                const auto* 来源阶次 = std::get_if<std::int64_t>(
                    &来源定义.特征定义->实际阶次属性.类型化不可变材料);
                if (!来源阶次 || *来源阶次 <= 0
                    || static_cast<std::uint64_t>(*来源阶次) > 0xffff'ffffULL)
                    return 失败(L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                最大来源阶次 = std::max(最大来源阶次,
                    static_cast<std::uint32_t>(*来源阶次));
            }
            const auto* 阶次 = std::get_if<std::int64_t>(
                &定义.实际阶次属性.类型化不可变材料);
            if (!阶次 || (*阶次 == 1 && 最大来源阶次 != 0)
                || (*阶次 > 1 && (最大来源阶次 == 0
                    || 最大来源阶次 == 0xffff'ffffU
                    || static_cast<std::uint32_t>(*阶次) != 最大来源阶次 + 1))
                || !L2统一特征定义事实完整(
                    定义, 请求.历史截止事实代次))
                return 失败(L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            const auto 后代次 = L2特征结构内部::检查特征定义当前代次(
                第一层服务_, 请求.特征定义.值,
                请求.请求头.期望事实代次);
            if (!后代次.成功()) return 失败(
                后代次.直接提交 ? L2结构状态::事实代次漂移 : 后代次.状态,
                后代次.事实截止代次);
            L2统一特征定义完整读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
                L2读取类别::历史, 请求.历史截止事实代次, std::move(定义)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致,
                    请求.历史截止事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；一次关系类型闭包许可形成全部当前统一定义快照。
    L2当前统一特征定义组读取结果 读取全部当前统一特征定义(
        const L2当前统一特征定义组读取请求& 请求) const {
        const auto 失败 = [&](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2当前统一特征定义组读取结果{
                {L2结构合同版本, 状态, 截止, std::nullopt}, {}};
        };
        if (!L2当前统一特征定义组读取请求有效(请求)) return 失败(
            L2结构状态::入口拒绝);
        try {
            L2特征定义属性类型登记 公开属性定位;
            {
                std::lock_guard<std::mutex> 锁(定义属性类型登记锁_);
                if (!定义属性类型登记定位_)
                    return 失败(L2结构状态::内部不一致);
                公开属性定位 = *定义属性类型登记定位_;
            }
            if (!派生结构定位_
                || !L2特征定义属性类型登记完整(公开属性定位))
                return 失败(L2结构状态::内部不一致);
            std::vector<稳定编码> 属性类型{
                派生结构定位_->实际阶次属性类型,
                派生结构定位_->派生规则见证属性类型,
                公开属性定位.I64属性类型.值,
                公开属性定位.I64组属性类型.值,
                公开属性定位.U64组属性类型.值,
                公开属性定位.独立材料属性类型.值};
            std::sort(属性类型.begin(), 属性类型.end());
            if (std::adjacent_find(属性类型.begin(), 属性类型.end())
                != 属性类型.end()) return 失败(L2结构状态::内部不一致);

            L1所有者范围一致关系类型闭包读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致关系类型闭包读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.关系类型闭包 = {{
                特征定义身份来源定位_.族归属关系类型,
                属性类型, {派生结构定位_->直接来源关系类型}, {}, {}, {}, {}}};
            const auto 读取 = 第一层服务_.尝试读取所有者范围一致关系类型闭包投影(
                L1请求);
            if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
                const bool 空载荷 = 读取.所有者.empty() && 读取.节点.empty()
                    && 读取.关系.empty() && 读取.值.empty()
                    && 读取.属性值.empty() && 读取.源关系组.empty()
                    && 读取.目标关系组.empty() && 读取.关系类型闭包.empty();
                const bool 截止形状 = 读取.状态
                        == L1所有者范围一致当前读取状态::事实代次漂移
                    ? 读取.读取事实代次 != 0
                        && 读取.读取事实代次 != 请求.请求头.期望事实代次
                    : 读取.读取事实代次 == 0;
                if (读取.合同版本
                        != L1所有者范围一致关系类型闭包读取合同版本
                    || 读取.期望事实代次 != 请求.请求头.期望事实代次
                    || !空载荷 || !截止形状)
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                return 失败(L2特征结构内部::映射特征定义一致读取失败状态(
                    读取.状态), 读取.读取事实代次);
            }
            if (读取.合同版本
                    != L1所有者范围一致关系类型闭包读取合同版本
                || 读取.期望事实代次 != 请求.请求头.期望事实代次
                || 读取.读取事实代次 == 0
                || (请求.请求头.期望事实代次 != 0
                    && 读取.读取事实代次 != 请求.请求头.期望事实代次)
                || !读取.所有者.empty() || !读取.节点.empty()
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty() || 读取.关系类型闭包.size() != 1)
                return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
            const auto& 闭包 = 读取.关系类型闭包.front();
            if (闭包.入口关系类型节点 != 特征定义身份来源定位_.族归属关系类型
                || 闭包.状态 != L1所有者范围一致当前读取项目状态::成功
                || !闭包.关系类型事实
                || 闭包.关系类型事实->编码
                    != 特征定义身份来源定位_.族归属关系类型
                || 闭包.关系类型事实->种类 != 节点种类::普通
                || 闭包.关系类型事实->属性类型表示
                || 闭包.关系类型事实->写入所有者
                    != 特征定义身份来源定位_.所有者
                || 闭包.关系类型事实->退出事实代次)
                return 失败(L2结构状态::内部不一致, 读取.读取事实代次);

            L2当前统一特征定义组读取结果 结果{
                {L2结构合同版本, L2结构状态::已读取,
                    读取.读取事实代次, std::nullopt}, {}};
            结果.特征定义组.reserve(闭包.成员.size());
            for (const auto& 成员 : 闭包.成员) {
                if (成员.关系.关系类型节点
                        != 特征定义身份来源定位_.族归属关系类型
                    || 成员.关系.源节点 != 成员.源节点.编码
                    || 成员.关系.目标节点 != 特征定义身份来源定位_.族锚点
                    || 成员.关系.目标节点 != 成员.目标节点.编码
                    || 成员.关系.角色或顺序 != 1
                    || 成员.关系.写入所有者
                        != 特征定义身份来源定位_.所有者
                    || 成员.关系.退出事实代次
                    || 成员.源节点.种类 != 节点种类::普通
                    || 成员.源节点.属性类型表示
                    || 成员.源节点.写入所有者
                        != 特征定义身份来源定位_.所有者
                    || 成员.源节点.退出事实代次
                    || 成员.目标节点.种类 != 节点种类::普通
                    || 成员.目标节点.属性类型表示
                    || 成员.目标节点.写入所有者
                        != 特征定义身份来源定位_.所有者
                    || 成员.目标节点.退出事实代次
                    || 成员.源节点属性值.size() != 属性类型.size()
                    || 成员.源节点源关系组.size() != 1
                    || !成员.源节点目标关系组.empty()
                    || !成员.目标节点属性值.empty()
                    || !成员.目标节点源关系组.empty()
                    || !成员.目标节点目标关系组.empty())
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                L2统一特征定义事实 定义;
                定义.身份 = L2特征定义身份{成员.源节点.编码};
                定义.生命周期 = {成员.源节点.创建事实代次,
                    成员.源节点.退出事实代次};
                const auto 查找属性 = [&](稳定编码 类型)
                    -> const L1所有者范围一致属性值读取结果项* {
                    const L1所有者范围一致属性值读取结果项* 找到 = nullptr;
                    for (const auto& 项 : 成员.源节点属性值) {
                        if (项.节点 != 成员.源节点.编码 || 项.属性类型 != 类型)
                            continue;
                        if (找到) return nullptr;
                        找到 = &项;
                    }
                    return 找到;
                };
                const auto* 阶次项 = 查找属性(派生结构定位_->实际阶次属性类型);
                const auto* 规则项 = 查找属性(派生结构定位_->派生规则见证属性类型);
                if (!阶次项 || 阶次项->状态
                        != L1所有者范围一致当前读取项目状态::成功
                    || !阶次项->投影 || 阶次项->投影->当前值事实.退出事实代次
                    || 阶次项->投影->属性槽.当前值
                        != 阶次项->投影->当前值事实.编码)
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                const auto 阶次属性 = L2特征结构内部::形成截止属性事实(
                    阶次项->投影->当前值事实, 读取.读取事实代次);
                if (!阶次属性 || 阶次属性->退出事实代次
                    || 阶次属性->来源稳定编码 != 定义.身份.值)
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                定义.实际阶次属性 = *阶次属性;
                if (!规则项) return 失败(L2结构状态::内部不一致,
                    读取.读取事实代次);
                if (规则项->状态 == L1所有者范围一致当前读取项目状态::成功) {
                    if (!规则项->投影 || 规则项->投影->当前值事实.退出事实代次
                        || 规则项->投影->属性槽.当前值
                            != 规则项->投影->当前值事实.编码)
                        return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                    auto 属性 = L2特征结构内部::形成截止属性事实(
                        规则项->投影->当前值事实, 读取.读取事实代次);
                    if (!属性 || 属性->退出事实代次
                        || 属性->来源稳定编码 != 定义.身份.值)
                        return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                    定义.派生规则 = L2特征派生规则事实{std::move(*属性)};
                } else if (规则项->状态
                        != L1所有者范围一致当前读取项目状态::属性未设置
                    || 规则项->投影)
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);

                const auto 添加固定属性 = [&](稳定编码 类型) -> bool {
                    const auto* 项 = 查找属性(类型);
                    if (!项) return false;
                    if (项->状态 == L1所有者范围一致当前读取项目状态::属性未设置)
                        return !项->投影;
                    if (项->状态 != L1所有者范围一致当前读取项目状态::成功
                        || !项->投影 || 项->投影->当前值事实.退出事实代次
                        || 项->投影->属性槽.当前值
                            != 项->投影->当前值事实.编码) return false;
                    auto 属性 = L2特征结构内部::形成截止属性事实(
                        项->投影->当前值事实, 读取.读取事实代次);
                    if (!属性 || 属性->退出事实代次) return false;
                    定义.固定属性.push_back(std::move(*属性));
                    return true;
                };
                if (!添加固定属性(公开属性定位.I64属性类型.值)
                    || !添加固定属性(公开属性定位.I64组属性类型.值)
                    || !添加固定属性(公开属性定位.U64组属性类型.值)
                    || !添加固定属性(公开属性定位.独立材料属性类型.值))
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                std::sort(定义.固定属性.begin(), 定义.固定属性.end(),
                    [](const auto& 左, const auto& 右) noexcept {
                        return 左.属性类型身份 < 右.属性类型身份;
                    });
                const auto& 来源组 = 成员.源节点源关系组.front();
                if (来源组.端点节点 != 定义.身份.值
                    || 来源组.关系类型节点 != 派生结构定位_->直接来源关系类型
                    || 来源组.状态 != L1所有者范围一致当前读取项目状态::成功
                    || !来源组.关系类型事实
                    || 来源组.关系类型事实->编码
                        != 派生结构定位_->直接来源关系类型
                    || 来源组.关系类型事实->种类 != 节点种类::普通
                    || 来源组.关系类型事实->退出事实代次)
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                for (const auto& 来源 : 来源组.成员) {
                    const auto 角色值 = static_cast<std::uint64_t>(来源.关系.角色或顺序);
                    const auto 顺序 = static_cast<std::uint32_t>(角色值 >> 32);
                    const auto 角色 = static_cast<std::uint32_t>(角色值 & 0xffff'ffffULL);
                    if (来源.关系.角色或顺序 <= 0 || 顺序 == 0
                        || 顺序 > 0x7fff'ffffU || 角色 == 0
                        || 来源.关系.源节点 != 定义.身份.值
                        || 来源.关系.目标节点 != 来源.对端节点.编码
                        || 来源.关系.关系类型节点
                            != 派生结构定位_->直接来源关系类型
                        || 来源.关系.写入所有者 != 派生结构定位_->所有者
                        || 来源.关系.退出事实代次
                        || 来源.对端节点.种类 != 节点种类::普通
                        || 来源.对端节点.写入所有者
                            != 特征定义身份来源定位_.所有者
                        || 来源.对端节点.退出事实代次)
                        return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                    定义.直接来源.push_back({来源.关系.编码, 顺序, 角色,
                        L2特征定义身份{来源.对端节点.编码},
                        {来源.关系.创建事实代次, 来源.关系.退出事实代次}});
                }
                std::sort(定义.直接来源.begin(), 定义.直接来源.end(),
                    [](const auto& 左, const auto& 右) noexcept {
                        return 左.顺序 < 右.顺序;
                    });
                if (!L2统一特征定义事实完整(定义, 读取.读取事实代次))
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                for (const auto& 既有 : 结果.特征定义组)
                    if (既有.身份 == 定义.身份)
                        return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                结果.特征定义组.push_back(std::move(定义));
            }
            std::sort(结果.特征定义组.begin(), 结果.特征定义组.end(),
                [](const auto& 左, const auto& 右) noexcept {
                    return 左.身份.值 < 右.身份.值;
                });
            for (const auto& 定义 : 结果.特征定义组) {
                const auto* 阶次 = std::get_if<std::int64_t>(
                    &定义.实际阶次属性.类型化不可变材料);
                if (!阶次) return 失败(L2结构状态::内部不一致,
                    读取.读取事实代次);
                std::uint32_t 最大来源阶次 = 0;
                for (const auto& 来源 : 定义.直接来源) {
                    const auto 找到 = std::lower_bound(结果.特征定义组.begin(),
                        结果.特征定义组.end(), 来源.来源特征定义.值,
                        [](const auto& 候选, 稳定编码 编码) noexcept {
                            return 候选.身份.值 < 编码;
                        });
                    if (找到 == 结果.特征定义组.end()
                        || 找到->身份 != 来源.来源特征定义)
                        return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                    const auto* 来源阶次 = std::get_if<std::int64_t>(
                        &找到->实际阶次属性.类型化不可变材料);
                    if (!来源阶次 || *来源阶次 <= 0
                        || static_cast<std::uint64_t>(*来源阶次) > 0xffff'ffffULL)
                        return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
                    最大来源阶次 = std::max(最大来源阶次,
                        static_cast<std::uint32_t>(*来源阶次));
                }
                if ((*阶次 == 1 && 最大来源阶次 != 0)
                    || (*阶次 > 1 && (最大来源阶次 == 0
                        || 最大来源阶次 == 0xffff'ffffU
                        || static_cast<std::uint32_t>(*阶次) != 最大来源阶次 + 1)))
                    return 失败(L2结构状态::内部不一致, 读取.读取事实代次);
            }
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 读取.读取事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；一个实例节点与两条具名端点关系由同一写集原子建立。
    L2特征实例写入结果 新增特征实例(const L2特征实例新增请求& 请求) {
        if (!L2特征实例新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征关系类型登记();
            if (登记结果.状态 != L2特征关系类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征实例写入失败(
                    L2特征结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;

            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.节点 = {{{L2特征结构内部::特征实例节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2特征结构内部::特征实例族归属关系本地键值},
                    L1所有者范围写集本地键{L2特征结构内部::特征实例节点本地键值},
                    特征实例身份来源定位_->族锚点,
                    特征实例身份来源定位_->族归属关系类型,
                    L2特征结构内部::特征实例端点角色值},
                {{L2特征结构内部::特征实例宿主关系本地键值},
                    L1所有者范围写集本地键{L2特征结构内部::特征实例节点本地键值},
                    请求.宿主存在.值, 登记.宿主关系类型.值,
                    L2特征结构内部::特征实例端点角色值},
                {{L2特征结构内部::特征实例定义关系本地键值},
                    L1所有者范围写集本地键{L2特征结构内部::特征实例节点本地键值},
                    请求.特征定义.值, 登记.定义关系类型.值,
                    L2特征结构内部::特征实例端点角色值}};

            const auto 代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (代次.状态 != L1所有者范围读取状态::成功
                || 代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成特征实例写入失败(
                    代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 宿主 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.宿主存在, 0});
                if (宿主.结果头.状态 != L2结构状态::已读取 || !宿主.身份来源)
                    return L2特征结构内部::形成特征实例写入失败(
                        宿主.结果头.状态, 宿主.结果头.事实截止代次);
                if (宿主.结果头.事实截止代次 != 请求.请求头.期望事实代次
                    || 宿主.身份来源->节点稳定编码 != 请求.宿主存在.值
                    || 宿主.身份来源->节点生命周期.退出事实代次)
                    return L2特征结构内部::形成特征实例写入失败(
                        L2结构状态::内部不一致, 宿主.结果头.事实截止代次);
                const auto 定义 = 读取完整统一特征定义({请求.请求头,
                    L2读取类别::当前, 请求.特征定义, 0});
                if (!定义.成功() || !定义.特征定义)
                    return L2特征结构内部::形成特征实例写入失败(
                        定义.结果头.状态, 定义.结果头.事实截止代次);
                if (定义.结果头.事实截止代次 != 请求.请求头.期望事实代次
                    || 定义.特征定义->身份 != 请求.特征定义
                    || 定义.特征定义->生命周期.退出事实代次)
                    return L2特征结构内部::形成特征实例写入失败(
                        L2结构状态::内部不一致, 定义.结果头.事实截止代次);
            }

            const auto 写入 = 特征实例写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2特征结构内部::映射特征定义写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2特征结构内部::形成特征实例写入失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2特征结构内部::形成特征实例写入失败(
                    状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            稳定编码 实例编码, 归属关系编码, 宿主关系编码, 定义关系编码;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2特征结构内部::特征实例编码映射完整(
                    写入, 实例编码, 归属关系编码,
                    宿主关系编码, 定义关系编码))
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);

            const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 实例编码});
            const auto 宿主关系读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 宿主关系编码});
            const auto 定义关系读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 定义关系编码});
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
            const auto* 宿主关系 = 宿主关系读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*宿主关系读取.事实) : nullptr;
            const auto* 定义关系 = 定义关系读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*定义关系读取.事实) : nullptr;
            if (节点读取.状态 != L1所有者范围读取状态::成功
                || 宿主关系读取.状态 != L1所有者范围读取状态::成功
                || 定义关系读取.状态 != L1所有者范围读取状态::成功
                || 节点读取.合同版本 != L1所有者范围CRUD合同版本
                || 宿主关系读取.合同版本 != L1所有者范围CRUD合同版本
                || 定义关系读取.合同版本 != L1所有者范围CRUD合同版本
                || 节点读取.查询编码 != 实例编码
                || 宿主关系读取.查询编码 != 宿主关系编码
                || 定义关系读取.查询编码 != 定义关系编码
                || 节点读取.读取事实代次 < 写入.事实代次
                || 宿主关系读取.读取事实代次 < 写入.事实代次
                || 定义关系读取.读取事实代次 < 写入.事实代次
                || !节点 || !宿主关系 || !定义关系)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            auto 实例 = L2特征结构内部::形成F2特征实例事实(
                *节点, *宿主关系, *定义关系, 登记, 写入.事实代次);
            if (!实例 || !节点->当前属性.empty() || 实例->身份.值 != 实例编码
                || 实例->宿主存在 != 请求.宿主存在
                || 实例->特征定义 != 请求.特征定义
                || 实例->生命周期.创建事实代次 != 写入.事实代次)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);

            const auto 当前代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (当前代次.状态 != L1所有者范围读取状态::成功
                || 当前代次.合同版本 != L1所有者范围CRUD合同版本
                || 当前代次.事实代次 < 写入.事实代次)
                return L2特征结构内部::形成特征实例写入失败(
                    当前代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(当前代次.状态)
                        : L2结构状态::内部不一致, 当前代次.事实代次);
            const L2结构请求头 历史头{L2结构合同版本, 当前代次.事实代次};
            const auto 宿主历史 = 存在服务_.读取存在身份来源({历史头,
                L2读取类别::历史, 请求.宿主存在, 写入.事实代次});
            const auto 定义历史 = 读取特征定义身份来源({历史头,
                L2读取类别::历史, 请求.特征定义, 写入.事实代次});
            if (宿主历史.结果头.状态 != L2结构状态::已读取
                || 定义历史.结果头.状态 != L2结构状态::已读取
                || !宿主历史.身份来源 || !定义历史.身份来源)
                return L2特征结构内部::形成特征实例写入失败(
                    宿主历史.结果头.状态 != L2结构状态::已读取
                        ? 宿主历史.结果头.状态 : 定义历史.结果头.状态,
                    宿主历史.结果头.状态 != L2结构状态::已读取
                        ? 宿主历史.结果头.事实截止代次
                        : 定义历史.结果头.事实截止代次);
            if (宿主历史.身份来源->节点稳定编码 != 请求.宿主存在.值
                || 定义历史.身份来源->节点稳定编码 != 请求.特征定义.值)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return {{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(实例)};
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征实例写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征实例写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征实例写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史失败均返回空实例载荷。
    L2特征实例完整读取结果 读取完整特征实例(
        const L2特征实例完整读取请求& 请求) const {
        if (!L2特征实例完整读取请求有效(请求)) return {};
        try {
            const auto 本族来源 = 读取特征实例身份来源({请求.请求头,
                请求.读取类别, 请求.特征实例,
                请求.历史截止事实代次});
            if (!本族来源.成功() || !本族来源.身份来源)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 本族来源.结果头.状态,
                    本族来源.结果头.事实截止代次);
            const auto 登记结果 = 读取当前特征关系类型登记();
            if (登记结果.状态 != L2特征关系类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 值登记结果 = 读取当前特征值类型登记();
            if (值登记结果.状态 != L2特征值类型登记状态::已读取
                || !值登记结果.登记 || !值登记结果.成功())
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射值类型登记失败为结构状态(
                        值登记结果.状态), 值登记结果.事实截止代次);
            const auto& 值登记 = *值登记结果.登记;
            if (请求.读取类别 == L2读取类别::当前) {
                L1所有者范围一致当前读取请求 首次请求;
                首次请求.合同版本 = L1所有者范围一致当前读取合同版本;
                首次请求.期望事实代次 = 请求.请求头.期望事实代次;
                首次请求.节点 = {请求.特征实例.值};
                const auto 首次读取 =
                    第一层服务_.尝试读取所有者范围一致当前投影(首次请求);
                const auto 首次顶层 = L2特征结构内部::解释特征定义一致读取顶层(
                    首次读取, 请求.请求头.期望事实代次);
                if (!首次顶层.成功())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, 首次顶层.状态, 首次顶层.事实截止代次);
                if (首次读取.节点.size() != 1 || !首次读取.关系.empty()
                    || !首次读取.值.empty() || !首次读取.属性值.empty()
                    || !首次读取.源关系组.empty() || !首次读取.目标关系组.empty())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                const auto& 首次节点项 = 首次读取.节点.front();
                if (首次节点项.查询编码 != 请求.特征实例.值) return
                    L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                if (首次节点项.状态 != L1所有者范围一致当前读取项目状态::成功) {
                    if (首次节点项.事实) return
                        L2特征结构内部::形成完整特征实例读取失败(
                            请求, L2结构状态::内部不一致,
                            首次顶层.事实截止代次);
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2特征结构内部::映射特征定义当前项目状态(
                            首次节点项.状态), 首次顶层.事实截止代次);
                }
                if (!首次节点项.事实 || 首次节点项.事实->退出事实代次
                    || 首次节点项.事实->当前属性.size() > 1)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                const auto 是登记值类型 = [&](稳定编码 类型) noexcept {
                    return 类型 == 值登记.I64值类型.值
                        || 类型 == 值登记.I64组值类型.值
                        || 类型 == 值登记.U64组值类型.值
                        || 类型 == 值登记.独立材料值类型.值;
                };
                if (!首次节点项.事实->当前属性.empty()
                    && !是登记值类型(
                        首次节点项.事实->当前属性.front().属性类型节点))
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                L1所有者范围一致当前读取请求 完整请求;
                完整请求.合同版本 = L1所有者范围一致当前读取合同版本;
                完整请求.期望事实代次 = 请求.请求头.期望事实代次;
                完整请求.节点 = {请求.特征实例.值};
                完整请求.源关系组 = {
                    {请求.特征实例.值, 登记.宿主关系类型.值},
                    {请求.特征实例.值, 登记.定义关系类型.值}};
                if (!首次节点项.事实->当前属性.empty())
                    完整请求.属性值 = {{请求.特征实例.值,
                        首次节点项.事实->当前属性.front().属性类型节点}};
                const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(完整请求);
                const auto 顶层 = L2特征结构内部::解释特征定义一致读取顶层(
                    读取, 请求.请求头.期望事实代次);
                if (!顶层.成功()) return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 顶层.状态, 顶层.事实截止代次);
                if (读取.节点.size() != 1 || !读取.关系.empty()
                    || !读取.值.empty()
                    || 读取.属性值.size() != 完整请求.属性值.size()
                    || 读取.源关系组.size() != 2 || !读取.目标关系组.empty())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto& 节点项 = 读取.节点.front();
                if (节点项.查询编码 != 请求.特征实例.值
                    || 节点项.状态 != L1所有者范围一致当前读取项目状态::成功
                    || !节点项.事实 || 节点项.事实->退出事实代次
                    || *节点项.事实 != *首次节点项.事实)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto 查找组 = [&](稳定编码 类型)
                    -> const L1所有者范围一致源关系组读取结果项* {
                    const L1所有者范围一致源关系组读取结果项* 找到 = nullptr;
                    for (const auto& 组 : 读取.源关系组) {
                        if (组.源节点 != 请求.特征实例.值
                            || 组.关系类型节点 != 类型) continue;
                        if (找到) return nullptr;
                        找到 = &组;
                    }
                    return 找到;
                };
                const auto* 宿主组 = 查找组(登记.宿主关系类型.值);
                const auto* 定义组 = 查找组(登记.定义关系类型.值);
                if (!宿主组 || !定义组 || 宿主组 == 定义组
                    || 宿主组->成员.size() != 1 || 定义组->成员.size() != 1)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto& 宿主投影 = 宿主组->成员.front();
                const auto& 定义投影 = 定义组->成员.front();
                auto 实例 = L2特征结构内部::形成F2特征实例事实(
                    *节点项.事实, 宿主投影.关系, 定义投影.关系,
                    登记, 顶层.事实截止代次);
                if (!实例 || 宿主投影.对端节点.编码 != 实例->宿主存在.值
                    || 定义投影.对端节点.编码 != 实例->特征定义.值
                    || 宿主投影.对端节点.退出事实代次
                    || 定义投影.对端节点.退出事实代次)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                if (!节点项.事实->当前属性.empty()) {
                    const auto& 槽 = 节点项.事实->当前属性.front();
                    const auto& 值项 = 读取.属性值.front();
                    if (值项.节点 != 请求.特征实例.值
                        || 值项.属性类型 != 槽.属性类型节点
                        || 值项.状态 != L1所有者范围一致当前读取项目状态::成功
                        || !值项.投影 || 值项.投影->属性槽 != 槽
                        || 值项.投影->当前值事实.编码 != 槽.当前值
                        || 值项.投影->当前值事实.所属节点 != 请求.特征实例.值
                        || 值项.投影->当前值事实.属性类型节点
                            != 槽.属性类型节点
                        || 值项.投影->当前值事实.退出事实代次)
                        return L2特征结构内部::形成完整特征实例读取失败(
                            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                    实例->当前值 = L2特征结构内部::形成截止特征值事实(
                        值项.投影->当前值事实, 值登记, 顶层.事实截止代次);
                    if (!实例->当前值 || 实例->当前值->特征实例 != 实例->身份)
                        return L2特征结构内部::形成完整特征实例读取失败(
                            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                }
                if (!L2特征实例事实完整(*实例, 顶层.事实截止代次))
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto 宿主 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 实例->宿主存在, 0});
                const auto 定义 = 读取特征定义身份来源({请求.请求头,
                    L2读取类别::当前, 实例->特征定义, 0});
                if (宿主.结果头.状态 != L2结构状态::已读取
                    || 定义.结果头.状态 != L2结构状态::已读取
                    || !宿主.身份来源 || !定义.身份来源)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, 宿主.结果头.状态 != L2结构状态::已读取
                            ? 宿主.结果头.状态 : 定义.结果头.状态,
                        宿主.结果头.状态 != L2结构状态::已读取
                            ? 宿主.结果头.事实截止代次
                            : 定义.结果头.事实截止代次);
                if (宿主.身份来源->节点稳定编码 != 实例->宿主存在.值
                    || 定义.身份来源->节点稳定编码 != 实例->特征定义.值
                    || 宿主.结果头.事实截止代次 != 顶层.事实截止代次
                    || 定义.结果头.事实截止代次 != 顶层.事实截止代次)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                return {{L2结构合同版本, L2结构状态::已读取,
                    顶层.事实截止代次, std::nullopt}, 请求.读取类别, 0,
                    std::move(实例), L2特征实例自有关系引用{
                        宿主投影.关系.编码, 定义投影.关系.编码}};
            }

            const auto 前代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (前代次.状态 != L1所有者范围读取状态::成功
                || 前代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 前代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(前代次.状态)
                        : L2结构状态::内部不一致);
            if (前代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::事实代次漂移, 前代次.事实代次);
            const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.特征实例.值});
            const auto 宿主组 = 第一层服务_.读取所有者范围历史关系组(
                {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                    请求.特征实例.值, 登记.宿主关系类型.值,
                    请求.历史截止事实代次});
            const auto 定义组 = 第一层服务_.读取所有者范围历史关系组(
                {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                    请求.特征实例.值, 登记.定义关系类型.值,
                    请求.历史截止事实代次});
            const auto 属性组 = 第一层服务_.读取所有者范围历史属性值组(
                {L1所有者范围CRUD合同版本, 请求.特征实例.值,
                    请求.历史截止事实代次});
            if (节点读取.合同版本 != L1所有者范围CRUD合同版本
                || 节点读取.查询编码 != 请求.特征实例.值)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (节点读取.状态 != L1所有者范围读取状态::成功) {
                const auto 状态 = 节点读取.状态 == L1所有者范围读取状态::未找到
                    ? L2结构状态::未找到
                    : L2特征结构内部::映射特征定义历史读取状态(节点读取.状态);
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 状态, 请求.历史截止事实代次);
            }
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
            if (!节点 || 节点->创建事实代次 > 请求.历史截止事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 节点 && 节点->创建事实代次 > 请求.历史截止事实代次
                        ? L2结构状态::未找到 : L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            if (节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::已退出, 请求.历史截止事实代次);
            const auto 组完整 = [&](const L1所有者范围历史关系组读取结果& 组,
                L1所有者范围关系端点方向 方向, 稳定编码 类型) noexcept {
                return 组.状态 == L1所有者范围读取状态::成功
                    && 组.合同版本 == L1所有者范围CRUD合同版本 && 组.方向 == 方向
                    && 组.端点节点 == 请求.特征实例.值
                    && 组.关系类型节点 == 类型
                    && 组.历史截止事实代次 == 请求.历史截止事实代次
                    && 组.读取事实代次 == 请求.请求头.期望事实代次;
            };
            if (宿主组.状态 != L1所有者范围读取状态::成功
                || 定义组.状态 != L1所有者范围读取状态::成功) {
                const auto& 失败组 = 宿主组.状态
                    != L1所有者范围读取状态::成功 ? 宿主组 : 定义组;
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射特征历史关系组失败状态(
                        失败组.状态), 失败组.读取事实代次);
            }
            if (!组完整(宿主组, L1所有者范围关系端点方向::源,
                    登记.宿主关系类型.值)
                || !组完整(定义组, L1所有者范围关系端点方向::源,
                    登记.定义关系类型.值)
                || 宿主组.关系组.size() != 1 || 定义组.关系组.size() != 1)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (属性组.合同版本 != L1所有者范围CRUD合同版本
                || 属性组.所属节点 != 请求.特征实例.值
                || 属性组.历史截止事实代次 != 请求.历史截止事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 属性组.读取事实代次);
            if (属性组.状态 != L1所有者范围读取状态::成功) {
                if (!属性组.属性值组.empty())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 属性组.读取事实代次);
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射特征定义历史属性值组失败状态(
                        属性组.状态), 属性组.读取事实代次);
            }
            if (属性组.读取事实代次 != 请求.请求头.期望事实代次
                || 属性组.属性值组.size() > 1)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 属性组.读取事实代次 != 请求.请求头.期望事实代次
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    属性组.读取事实代次);
            auto 实例 = L2特征结构内部::形成F2特征实例事实(
                *节点, 宿主组.关系组.front(), 定义组.关系组.front(),
                登记, 请求.历史截止事实代次);
            if (!实例) return L2特征结构内部::形成完整特征实例读取失败(
                请求, 节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次
                    ? L2结构状态::已退出 : L2结构状态::内部不一致,
                请求.历史截止事实代次);
            if (!属性组.属性值组.empty()) {
                const auto& 原值 = 属性组.属性值组.front();
                if (原值.所属节点 != 请求.特征实例.值
                    || !L2特征结构内部::特征值类型与材料一致(
                        值登记, 原值.属性类型节点, 原值.材料))
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                实例->当前值 = L2特征结构内部::形成截止特征值事实(
                    原值, 值登记, 请求.历史截止事实代次);
                if (!实例->当前值 || 实例->当前值->特征实例 != 实例->身份
                    || 实例->当前值->生命周期.退出事实代次)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致,
                        请求.历史截止事实代次);
            }
            if (!L2特征实例事实完整(*实例, 请求.历史截止事实代次))
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            const auto 宿主 = 存在服务_.读取存在身份来源({请求.请求头,
                L2读取类别::历史, 实例->宿主存在, 请求.历史截止事实代次});
            const auto 定义 = 读取特征定义身份来源({请求.请求头,
                L2读取类别::历史, 实例->特征定义, 请求.历史截止事实代次});
            if (宿主.结果头.状态 != L2结构状态::已读取
                || 定义.结果头.状态 != L2结构状态::已读取
                || !宿主.身份来源 || !定义.身份来源)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 宿主.结果头.状态 != L2结构状态::已读取
                        ? 宿主.结果头.状态 : 定义.结果头.状态,
                    请求.历史截止事实代次);
            if (宿主.身份来源->节点稳定编码 != 实例->宿主存在.值
                || 定义.身份来源->节点稳定编码 != 实例->特征定义.值)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            const auto 后代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (后代次.状态 != L1所有者范围读取状态::成功
                || 后代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 后代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(后代次.状态)
                        : L2结构状态::内部不一致);
            if (后代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::事实代次漂移, 后代次.事实代次);
            return {{L2结构合同版本, L2结构状态::已读取,
                请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(实例),
                L2特征实例自有关系引用{宿主组.关系组.front().编码,
                    定义组.关系组.front().编码}};
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成完整特征实例读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成完整特征实例读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成完整特征实例读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；反向关系与逐项公开读取任一失败均清空整组。
    L2按存在当前特征读取结果 按存在读取全部当前特征(
        const L2按存在当前特征读取请求& 请求) const {
        if (!L2按存在当前特征读取请求有效(请求)) return {};
        try {
            const auto 存在 = 存在服务_.读取存在身份来源({请求.请求头,
                L2读取类别::当前, 请求.存在, 0});
            if (存在.结果头.状态 != L2结构状态::已读取 || !存在.身份来源)
                return L2特征结构内部::形成按存在特征读取失败(
                    存在.结果头.状态, 存在.结果头.事实截止代次);
            if (存在.身份来源->节点稳定编码 != 请求.存在.值
                || 存在.结果头.事实截止代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 存在.结果头.事实截止代次);
            const auto 登记结果 = 读取当前特征关系类型登记();
            if (登记结果.状态 != L2特征关系类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成按存在特征读取失败(
                    L2特征结构内部::映射登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围一致当前读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.所有者 = {存在.身份来源->写入所有者,
                特征实例身份来源定位_->所有者};
            L1请求.节点 = {请求.存在.值};
            L1请求.目标关系组 = {{请求.存在.值, 登记.宿主关系类型.值}};
            const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(L1请求);
            const auto 顶层 = L2特征结构内部::解释特征定义一致读取顶层(
                读取, 请求.请求头.期望事实代次);
            if (!顶层.成功()) return L2特征结构内部::形成按存在特征读取失败(
                顶层.状态, 顶层.事实截止代次);
            if (读取.节点.size() != 1 || !读取.关系.empty()
                || !读取.值.empty() || !读取.属性值.empty()
                || !读取.源关系组.empty() || 读取.目标关系组.size() != 1)
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto& 节点项 = 读取.节点.front();
            const auto& 关系组 = 读取.目标关系组.front();
            if (节点项.查询编码 != 请求.存在.值
                || 节点项.状态 != L1所有者范围一致当前读取项目状态::成功
                || !节点项.事实 || 节点项.事实->退出事实代次
                || 关系组.目标节点 != 请求.存在.值
                || 关系组.关系类型节点 != 登记.宿主关系类型.值)
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            std::vector<稳定编码> 实例编码组;
            for (const auto& 投影 : 关系组.成员) {
                if (投影.关系.目标节点 != 请求.存在.值
                    || 投影.关系.关系类型节点 != 登记.宿主关系类型.值
                    || 投影.关系.角色或顺序
                        != L2特征结构内部::特征实例端点角色值
                    || 投影.关系.退出事实代次 || !有效(投影.关系.源节点)
                    || 投影.对端节点.编码 != 投影.关系.源节点
                    || 投影.对端节点.种类 != 节点种类::普通
                    || 投影.对端节点.属性类型表示
                    || 投影.对端节点.退出事实代次)
                    return L2特征结构内部::形成按存在特征读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                实例编码组.push_back(投影.关系.源节点);
            }
            std::sort(实例编码组.begin(), 实例编码组.end());
            if (std::adjacent_find(实例编码组.begin(), 实例编码组.end())
                != 实例编码组.end())
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            L2按存在当前特征读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 顶层.事实截止代次, std::nullopt}, {}};
            for (const auto 编码 : 实例编码组) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, L2特征实例身份{编码}, 0});
                if (实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例)
                    return L2特征结构内部::形成按存在特征读取失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 顶层.事实截止代次
                    || 实例.特征实例->宿主存在 != 请求.存在)
                    return L2特征结构内部::形成按存在特征读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                结果.特征实例组.push_back(*实例.特征实例);
            }
            return 结果.成功() ? 结果
                : L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成按存在特征读取失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成按存在特征读取失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成按存在特征读取失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；空值实例以一份写集建立值并设置对应登记槽。
    L2特征当前值写入结果 新增特征当前值(
        const L2特征当前值新增请求& 请求) {
        if (!L2特征当前值新增请求有效(请求)) return {};
        try {
            const auto 来源 = 读取特征实例身份来源({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            if (!来源.成功())
                return L2特征结构内部::形成特征当前值写入失败(
                    来源.结果头.状态, 来源.结果头.事实截止代次);
            const auto 登记结果 = 读取当前特征值类型登记();
            if (登记结果.状态 != L2特征值类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征当前值写入失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 类型编码 = L2特征结构内部::选择特征值类型编码(
                登记, 请求.新值材料);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征当前值本地键值},
                请求.特征实例.值, 类型编码,
                L2特征结构内部::转换为L1材料(请求.新值材料),
                请求.来源稳定编码}};
            写集.属性槽变更 = {{请求.特征实例.值, 类型编码,
                {L2特征结构内部::特征当前值本地键值}}};
            const auto 代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (代次.状态 != L1所有者范围读取状态::成功
                || 代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成特征当前值写入失败(
                    代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致, 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征当前值写入失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 代次.事实代次
                    || 实例.特征实例->身份 != 请求.特征实例)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::内部不一致, 代次.事实代次);
                if (实例.特征实例->当前值)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::引用冲突, 代次.事实代次);
            }
            return L2特征结构内部::提交并读回特征当前值写集(
                第一层服务_, 特征实例写入端口_, 写集,
                登记, 请求.特征实例,
                请求.新值材料, 请求.来源稳定编码, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；新值、跨表示切槽和具名旧值退出同写集提交。
    L2特征当前值写入结果 换代特征当前值(
        const L2特征当前值换代请求& 请求) {
        if (!L2特征当前值换代请求有效(请求)) return {};
        try {
            const auto 来源 = 读取特征实例身份来源({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            if (!来源.成功())
                return L2特征结构内部::形成特征当前值写入失败(
                    来源.结果头.状态, 来源.结果头.事实截止代次);
            const auto 登记结果 = 读取当前特征值类型登记();
            if (登记结果.状态 != L2特征值类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征当前值写入失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 类型编码 = L2特征结构内部::选择特征值类型编码(
                登记, 请求.新值材料);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征当前值本地键值},
                请求.特征实例.值, 类型编码,
                L2特征结构内部::转换为L1材料(请求.新值材料),
                请求.来源稳定编码}};
            写集.属性槽变更 = {{请求.特征实例.值, 类型编码,
                {L2特征结构内部::特征当前值本地键值}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (代次.状态 != L1所有者范围读取状态::成功
                || 代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成特征当前值写入失败(
                    代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致, 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征当前值写入失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 代次.事实代次
                    || 实例.特征实例->身份 != 请求.特征实例)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::内部不一致, 代次.事实代次);
                if (!实例.特征实例->当前值)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::属性未设置, 代次.事实代次);
                if (实例.特征实例->当前值->值稳定编码 != 请求.旧值稳定编码)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::引用冲突, 代次.事实代次);
            }
            return L2特征结构内部::提交并读回特征当前值写集(
                第一层服务_, 特征实例写入端口_, 写集,
                登记, 请求.特征实例,
                请求.新值材料, 请求.来源稳定编码, 请求.旧值稳定编码);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；具名当前值退出与属性槽清除由同一写集原子发布。
    L2特征当前值退出结果 退出特征当前值(
        const L2特征当前值退出请求& 请求) {
        if (!L2特征当前值退出请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征值类型登记();
            if (登记结果.状态 != L2特征值类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征当前值退出失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);

            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.退出事实 = {请求.当前值稳定编码};

            const auto 代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (代次.状态 != L1所有者范围读取状态::成功
                || 代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成特征当前值退出失败(
                    代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致, 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征当前值退出失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 代次.事实代次
                    || 实例.特征实例->身份 != 请求.特征实例)
                    return L2特征结构内部::形成特征当前值退出失败(
                        L2结构状态::内部不一致, 代次.事实代次);
                if (!实例.特征实例->当前值)
                    return L2特征结构内部::形成特征当前值退出失败(
                        L2结构状态::属性未设置, 代次.事实代次);
                if (实例.特征实例->当前值->值稳定编码
                    != 请求.当前值稳定编码)
                    return L2特征结构内部::形成特征当前值退出失败(
                        L2结构状态::引用冲突, 代次.事实代次);
            }

            const auto 写入 =
                特征实例写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2特征结构内部::形成特征当前值退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 =
                L2特征结构内部::映射特征定义写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2特征结构内部::形成特征当前值退出失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2特征结构内部::形成特征当前值退出失败(
                    状态, 写入.事实代次);
            }
            const bool 首次完整 =
                写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 =
                写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界
                    == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !写入.新编码映射.empty())
                return L2特征结构内部::形成特征当前值退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);

            const auto 尝试读回 = [&](std::uint64_t 当前代次)
                -> L2特征当前值退出结果 {
                const L2结构请求头 读回请求头{
                    L2结构合同版本, 当前代次};
                const auto 实例 = 读取完整特征实例({读回请求头,
                    L2读取类别::历史, 请求.特征实例, 写入.事实代次});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征当前值退出失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                const auto 值 = 读取特征历史值({读回请求头,
                    请求.特征实例, 请求.当前值稳定编码});
                if (值.结果头.状态 != L2结构状态::已读取 || !值.特征值)
                    return L2特征结构内部::形成特征当前值退出失败(
                        值.结果头.状态, 值.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 写入.事实代次
                    || 实例.特征实例->身份 != 请求.特征实例
                    || 实例.特征实例->当前值
                    || 值.特征值->值稳定编码 != 请求.当前值稳定编码
                    || 值.特征值->特征实例 != 请求.特征实例
                    || 值.特征值->生命周期.退出事实代次
                        != 写入.事实代次)
                    return L2特征结构内部::形成特征当前值退出失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                L2特征当前值退出结果 结果{{L2结构合同版本, 状态,
                    写入.事实代次, 写入.事实代次},
                    *实例.特征实例, *实例.自有关系, *值.特征值};
                return 结果.成功() ? 结果
                    : L2特征结构内部::形成特征当前值退出失败(
                        L2结构状态::内部不一致, 写入.事实代次);
            };

            for (std::uint32_t 次数 = 0; 次数 != 2; ++次数) {
                const auto 当前代次 =
                    L2特征结构内部::读取特征事实代次(第一层服务_);
                if (当前代次.状态 != L1所有者范围读取状态::成功
                    || 当前代次.合同版本 != L1所有者范围CRUD合同版本)
                    return L2特征结构内部::形成特征当前值退出失败(
                        当前代次.合同版本 == L1所有者范围CRUD合同版本
                            ? L2特征结构内部::映射特征事实代次探测失败(
                                当前代次.状态)
                            : L2结构状态::内部不一致,
                        当前代次.事实代次);
                const auto 读回 = 尝试读回(当前代次.事实代次);
                if (读回.成功()) return 读回;
                if (读回.结果头.状态 != L2结构状态::事实代次漂移)
                    return 读回;
            }
            return L2特征结构内部::形成特征当前值退出失败(
                L2结构状态::资源失败);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征当前值退出失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征当前值退出失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征当前值退出失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；具名值按前后代次夹取并保留完整生命周期。
    L2特征值历史读取结果 读取特征历史值(
        const L2特征值历史读取请求& 请求) const {
        if (!L2特征值历史读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征值类型登记();
            if (登记结果.状态 != L2特征值类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征值历史读取失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto 读取代次 = [&]() {
                return L2特征结构内部::读取特征事实代次(第一层服务_);
            };
            const auto 前代次 = 读取代次();
            if (前代次.状态 != L1所有者范围读取状态::成功
                || 前代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成特征值历史读取失败(
                    前代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(前代次.状态)
                        : L2结构状态::内部不一致, 前代次.事实代次);
            if (前代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::事实代次漂移, 前代次.事实代次);
            const auto 读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.值稳定编码});
            if (读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.查询编码 != 请求.值稳定编码)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
            if (读取.状态 != L1所有者范围读取状态::成功) {
                if (读取.事实) return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
                const auto 状态 = 读取.状态 == L1所有者范围读取状态::未找到
                    ? L2结构状态::未找到
                    : L2特征结构内部::映射特征定义历史读取状态(读取.状态);
                return L2特征结构内部::形成特征值历史读取失败(
                    状态, 前代次.事实代次);
            }
            const auto* 值 = 读取.事实
                ? std::get_if<L1所有者范围值事实>(&*读取.事实) : nullptr;
            if (!值 || 值->编码 != 请求.值稳定编码
                || 值->所属节点 != 请求.特征实例.值)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
            const auto 来源 = 读取特征实例身份来源({请求.请求头,
                L2读取类别::历史, 请求.特征实例, 值->创建事实代次});
            if (!来源.成功() || !来源.身份来源)
                return L2特征结构内部::形成特征值历史读取失败(
                    来源.结果头.状态, 来源.结果头.事实截止代次);
            auto 特征值 = L2特征结构内部::形成截止特征值事实(
                *值, *登记结果.登记, 前代次.事实代次, true);
            if (!特征值)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
            const auto 后代次 = 读取代次();
            if (后代次.状态 != L1所有者范围读取状态::成功
                || 后代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成特征值历史读取失败(
                    后代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(后代次.状态)
                        : L2结构状态::内部不一致, 后代次.事实代次);
            if (后代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::事实代次漂移, 后代次.事实代次);
            return {{L2结构合同版本, L2结构状态::已读取,
                后代次.事实代次, std::nullopt}, std::move(特征值)};
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征值历史读取失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征值历史读取失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征值历史读取失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；显式闭包核对后实例、两关系与可选值同代退出。
    L2特征实例退出结果 退出特征实例(
        const L2特征实例退出请求& 请求) {
        if (!L2特征实例退出请求有效(请求)) return {};
        try {
            const auto 来源 = 读取特征实例身份来源({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            if (!来源.成功() || !来源.身份来源)
                return L2特征结构内部::形成特征实例退出失败(
                    来源.结果头.状态, 来源.结果头.事实截止代次);
            if (来源.身份来源->族归属关系稳定编码
                != 请求.族归属关系稳定编码)
                return L2特征结构内部::形成特征实例退出失败(
                    L2结构状态::引用冲突, 来源.结果头.事实截止代次);
            const auto 关系登记结果 = 读取当前特征关系类型登记();
            if (关系登记结果.状态 != L2特征关系类型登记状态::已读取
                || !关系登记结果.登记 || !关系登记结果.成功())
                return L2特征结构内部::形成特征实例退出失败(
                    L2特征结构内部::映射登记失败为结构状态(
                        关系登记结果.状态), 关系登记结果.事实截止代次);
            const auto 值登记结果 = 读取当前特征值类型登记();
            if (值登记结果.状态 != L2特征值类型登记状态::已读取
                || !值登记结果.登记 || !值登记结果.成功())
                return L2特征结构内部::形成特征实例退出失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        值登记结果.状态), 值登记结果.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.退出事实 = {请求.特征实例.值,
                请求.族归属关系稳定编码,
                请求.自有关系.宿主关系稳定编码,
                请求.自有关系.定义关系稳定编码};
            if (请求.当前值稳定编码)
                写集.退出事实.push_back(*请求.当前值稳定编码);
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            if (std::adjacent_find(写集.退出事实.begin(), 写集.退出事实.end())
                != 写集.退出事实.end())
                return L2特征结构内部::形成特征实例退出失败(
                    L2结构状态::入口拒绝);
            const auto 代次 =
                L2特征结构内部::读取特征事实代次(第一层服务_);
            if (代次.状态 != L1所有者范围读取状态::成功
                || 代次.合同版本 != L1所有者范围CRUD合同版本)
                return L2特征结构内部::形成特征实例退出失败(
                    代次.合同版本 == L1所有者范围CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致, 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征实例退出失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                const auto 当前值 = 实例.特征实例->当前值
                    ? std::optional<稳定编码>{实例.特征实例->当前值->值稳定编码}
                    : std::nullopt;
                if (*实例.自有关系 != 请求.自有关系
                    || 当前值 != 请求.当前值稳定编码)
                    return L2特征结构内部::形成特征实例退出失败(
                        L2结构状态::引用冲突, 实例.结果头.事实截止代次);
            }
            return L2特征结构内部::提交并读回特征实例退出写集(
                第一层服务_, 特征实例写入端口_, 写集,
                请求, *关系登记结果.登记,
                *值登记结果.登记);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征实例退出失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征实例退出失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征实例退出失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；显式属性闭包核对后由一份写集退出特征定义及其属性值。
    L2统一特征定义退出结果 退出统一特征定义(
        const L2统一特征定义退出请求& 请求) {
        if (!L2统一特征定义退出请求有效(请求)) return {};
        const auto 失败 = [](L2结构状态 状态, std::uint64_t 截止 = 0) {
            return L2统一特征定义退出结果{
                {L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
        };
        try {
            const auto 来源 = 读取特征定义身份来源({请求.请求头,
                L2读取类别::当前, 请求.特征定义, 0});
            if (!来源.成功() || !来源.身份来源)
                return 失败(
                    来源.结果头.状态, 来源.结果头.事实截止代次);
            if (来源.身份来源->族归属关系稳定编码
                != 请求.族归属关系稳定编码)
                return 失败(
                    L2结构状态::引用冲突, 来源.结果头.事实截止代次);
            const auto 快照 = 读取完整统一特征定义({请求.请求头,
                L2读取类别::当前, 请求.特征定义, 0});
            if (!快照.成功() || !快照.特征定义)
                return 失败(快照.结果头.状态,
                    快照.结果头.事实截止代次);
            if (快照.特征定义->实际阶次属性.值稳定编码
                    != 请求.实际阶次值稳定编码
                || static_cast<bool>(快照.特征定义->派生规则)
                    != static_cast<bool>(请求.派生规则见证值稳定编码))
                return 失败(L2结构状态::引用冲突,
                    快照.结果头.事实截止代次);
            if (请求.派生规则见证值稳定编码
                && 快照.特征定义->派生规则->规则见证属性.值稳定编码
                    != *请求.派生规则见证值稳定编码)
                return 失败(L2结构状态::引用冲突,
                    快照.结果头.事实截止代次);
            std::vector<稳定编码> 来源关系;
            for (const auto& 项 : 快照.特征定义->直接来源)
                来源关系.push_back(项.关系稳定编码);
            std::sort(来源关系.begin(), 来源关系.end());
            std::vector<稳定编码> 固定属性;
            for (const auto& 项 : 快照.特征定义->固定属性)
                固定属性.push_back(项.值稳定编码);
            std::sort(固定属性.begin(), 固定属性.end());
            if (来源关系 != 请求.直接来源关系稳定编码
                || 固定属性 != 请求.当前固定属性值)
                return 失败(L2结构状态::引用冲突,
                    快照.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.退出事实 = {请求.特征定义.值,
                请求.族归属关系稳定编码,
                请求.实际阶次值稳定编码};
            写集.退出事实.insert(写集.退出事实.end(),
                请求.直接来源关系稳定编码.begin(),
                请求.直接来源关系稳定编码.end());
            if (请求.派生规则见证值稳定编码)
                写集.退出事实.push_back(*请求.派生规则见证值稳定编码);
            写集.退出事实.insert(写集.退出事实.end(),
                请求.当前固定属性值.begin(), 请求.当前固定属性值.end());
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            if (std::adjacent_find(写集.退出事实.begin(), 写集.退出事实.end())
                != 写集.退出事实.end())
                return 失败(L2结构状态::入口拒绝,
                    快照.结果头.事实截止代次);
            const auto 写入 = 特征定义写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = L2特征结构内部::映射特征定义写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return 失败(L2结构状态::内部不一致, 写入.事实代次);
                return 失败(状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 特征定义写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份
                || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !写入.新编码映射.empty())
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 当前代次 = L2特征结构内部::读取特征事实代次(第一层服务_);
            if (当前代次.状态 != L1所有者范围读取状态::成功
                || 当前代次.事实代次 < 写入.事实代次)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            const auto 历史 = 读取完整统一特征定义({
                {L2结构合同版本, 当前代次.事实代次}, L2读取类别::历史,
                请求.特征定义, 写入.事实代次});
            if (!历史.成功() || !历史.特征定义
                || 历史.特征定义->生命周期.退出事实代次 != 写入.事实代次)
                return 失败(L2结构状态::内部不一致, 写入.事实代次);
            L2统一特征定义退出结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, std::move(历史.特征定义)};
            return 结果.成功() ? 结果
                : 失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2结构状态::资源失败);
        } catch (...) {
            return 失败(L2结构状态::内部不一致);
        }
    }

private:
    static L1所有者范围写端口&& 验证并移动定义交付(
        const L1事实基座服务& 第一层服务,
        L2特征定义所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument("L2 feature definition owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    static L1所有者范围写端口&& 验证并移动实例交付(
        const L1事实基座服务& 第一层服务,
        L2特征实例所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument("L2 feature instance owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    // 诊断责任：向上送出；许可、漂移和属性类型表示矛盾均结构化返回。
    L2特征值类型登记结果 按定位读取当前特征值类型登记(
        const L2特征值类型登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2特征值类型登记完整(定位))
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::内部不一致);
        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试序号 = 0; 尝试序号 < 最大尝试次数; ++尝试序号) {
            L1所有者范围一致当前读取请求 请求;
            请求.合同版本 = L1所有者范围一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.节点 = {定位.I64值类型.值, 定位.I64组值类型.值,
                定位.U64组值类型.值, 定位.独立材料值类型.值};
            const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(请求);
            if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致);
                if (尝试序号 == 0) {
                    本轮期望代次 = 读取.读取事实代次;
                    continue;
                }
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::事实代次漂移, 读取.读取事实代次);
            }
            if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致);
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征结构内部::映射特征值类型登记读取失败状态(
                        读取.状态));
            }
            if (读取.合同版本 != L1所有者范围一致当前读取合同版本
                || 读取.期望事实代次 != 本轮期望代次
                || 读取.读取事实代次 != 本轮期望代次
                || 读取.读取事实代次 == 0 || 读取.节点.size() != 4
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty())
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            const auto 查找节点 = [&](稳定编码 编码)
                -> const L1所有者范围一致节点读取结果项* {
                const L1所有者范围一致节点读取结果项* 找到 = nullptr;
                for (const auto& 项 : 读取.节点) {
                    if (项.查询编码 != 编码) continue;
                    if (找到) return nullptr;
                    找到 = &项;
                }
                return 找到;
            };
            const auto 节点完整 = [&](稳定编码 编码,
                L1所有者范围值表示种类 表示) noexcept {
                const auto* 项 = 查找节点(编码);
                return 项 && 项->状态 == L1所有者范围一致当前读取项目状态::成功
                    && 项->事实 && 项->事实->编码 == 编码
                    && 项->事实->种类 == 节点种类::属性类型
                    && 项->事实->属性类型表示 == 表示
                    && 项->事实->创建事实代次 == 定位.建立事实代次
                    && !项->事实->退出事实代次 && 项->事实->当前属性.empty()
                    && (!期望创建代次
                        || 项->事实->创建事实代次 == *期望创建代次);
            };
            if (!节点完整(定位.I64值类型.值, L1所有者范围值表示种类::I64)
                || !节点完整(定位.I64组值类型.值, L1所有者范围值表示种类::I64组)
                || !节点完整(定位.U64组值类型.值, L1所有者范围值表示种类::U64组)
                || !节点完整(定位.独立材料值类型.值,
                    L1所有者范围值表示种类::独立材料引用))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            auto 当前登记 = 定位;
            当前登记.事实截止代次 = 读取.读取事实代次;
            if (!L2特征值类型登记完整(当前登记))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            return {L2特征值类型登记状态::已读取,
                当前登记.事实截止代次, std::move(当前登记)};
        }
        return L2特征结构内部::形成特征值类型登记失败(
            L2特征值类型登记状态::内部不一致);
    }

    // 诊断责任：向上送出；许可、漂移、资源失败和登记节点矛盾均结构化返回。
    L2特征关系类型登记结果 按定位读取当前特征关系类型登记(
        const L2特征关系类型登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2特征关系类型登记完整(定位))
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::内部不一致);
        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试序号 = 0; 尝试序号 < 最大尝试次数; ++尝试序号) {
            L1所有者范围一致当前读取请求 请求;
            请求.合同版本 = L1所有者范围一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.节点 = {定位.宿主关系类型.值, 定位.定义关系类型.值};
            const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(请求);
            if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致);
                if (尝试序号 == 0) {
                    本轮期望代次 = 读取.读取事实代次;
                    continue;
                }
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::事实代次漂移,
                    读取.读取事实代次);
            }
            if (读取.状态 != L1所有者范围一致当前读取状态::成功) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致);
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征结构内部::映射特征关系类型登记读取失败状态(
                        读取.状态));
            }
            if (读取.合同版本 != L1所有者范围一致当前读取合同版本
                || 读取.期望事实代次 != 本轮期望代次
                || 读取.读取事实代次 != 本轮期望代次
                || 读取.读取事实代次 == 0 || 读取.节点.size() != 2
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty())
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 查找节点 = [&](稳定编码 编码)
                -> const L1所有者范围一致节点读取结果项* {
                const L1所有者范围一致节点读取结果项* 找到 = nullptr;
                for (const auto& 项 : 读取.节点) {
                    if (项.查询编码 != 编码) continue;
                    if (找到) return nullptr;
                    找到 = &项;
                }
                return 找到;
            };
            const auto* 宿主项 = 查找节点(定位.宿主关系类型.值);
            const auto* 定义项 = 查找节点(定位.定义关系类型.值);
            if (!宿主项 || !定义项 || 宿主项 == 定义项
                || 宿主项->状态 != L1所有者范围一致当前读取项目状态::成功
                || 定义项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !宿主项->事实 || !定义项->事实)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 节点完整 = [&](const L1所有者范围节点事实& 节点,
                稳定编码 编码) noexcept {
                return 节点.编码 == 编码 && 节点.种类 == 节点种类::普通
                    && !节点.属性类型表示
                    && 节点.创建事实代次 == 定位.建立事实代次
                    && !节点.退出事实代次 && 节点.当前属性.empty()
                    && (!期望创建代次
                        || 节点.创建事实代次 == *期望创建代次);
            };
            if (!节点完整(*宿主项->事实, 定位.宿主关系类型.值)
                || !节点完整(*定义项->事实, 定位.定义关系类型.值))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            auto 当前登记 = 定位;
            当前登记.事实截止代次 = 读取.读取事实代次;
            if (!L2特征关系类型登记完整(当前登记))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            return {L2特征关系类型登记状态::已读取,
                当前登记.事实截止代次, std::move(当前登记)};
        }
        return L2特征结构内部::形成特征关系类型登记失败(
            L2特征关系类型登记状态::内部不一致);
    }

    const L1事实基座服务& 第一层服务_;
    const L2存在结构服务& 存在服务_;
    L1所有者范围写端口 特征定义写入端口_;
    L1所有者范围写端口 特征实例写入端口_;
    const L2特征结构内部::特征身份来源定位 特征定义身份来源定位_;
    std::optional<L2特征结构内部::特征身份来源定位> 特征实例身份来源定位_;
    mutable std::mutex 关系类型登记锁_;
    std::optional<L2特征关系类型登记> 关系类型登记定位_;
    mutable std::mutex 值类型登记锁_;
    std::optional<L2特征值类型登记> 值类型登记定位_;
    mutable std::mutex 定义属性类型登记锁_;
    std::optional<L2特征定义属性类型登记> 定义属性类型登记定位_;
    std::optional<L2特征结构内部::特征定义派生结构定位> 派生结构定位_;
};

} // namespace 海中鱼巣
