export {
#include "L2特征结构.数据.h"
}

namespace 海中鱼巣::L2特征结构内部 {

inline constexpr std::uint32_t 特征定义节点本地键值 = 0x0203'0001U;
inline constexpr std::uint32_t 特征定义固定属性值本地键值 = 0x0203'0301U;
inline constexpr std::uint64_t 特征关系类型登记幂等域 = 0x1EULL;
inline constexpr std::uint32_t 特征宿主关系类型本地键值 = 0x0203'0101U;
inline constexpr std::uint32_t 特征定义关系类型本地键值 = 0x0203'0102U;
inline constexpr std::uint32_t 特征实例节点本地键值 = 0x0203'1001U;
inline constexpr std::uint32_t 特征实例宿主关系本地键值 = 0x0203'1101U;
inline constexpr std::uint32_t 特征实例定义关系本地键值 = 0x0203'1102U;
inline constexpr std::uint64_t 特征值类型登记幂等域 = 0x1FULL;
inline constexpr std::uint32_t 特征I64值类型本地键值 = 0x0203'0201U;
inline constexpr std::uint32_t 特征I64组值类型本地键值 = 0x0203'0202U;
inline constexpr std::uint32_t 特征U64组值类型本地键值 = 0x0203'0203U;
inline constexpr std::uint32_t 特征独立材料值类型本地键值 = 0x0203'0204U;
inline constexpr std::uint32_t 特征当前值本地键值 = 0x0203'1201U;
inline constexpr std::int64_t 特征实例端点角色值 = 1;

// 诊断责任：无适用错误分支；完整 64 位纯值映射不读取事实。
L1中性写集幂等键 映射特征定义幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2结构状态 映射特征定义写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return L2结构状态::已提交;
    case L1中性写入状态::精确重复: return L2结构状态::精确重复;
    case L1中性写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1中性写入状态::资源失败: return L2结构状态::资源失败;
    case L1中性写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部一致读取状态。
L2结构状态 映射特征定义一致读取失败状态(
    L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1中性一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1中性一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部读取项目状态。
L2结构状态 映射特征定义当前项目状态(
    L1中性一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1中性一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1中性一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1中性一致当前读取项目状态::属性未设置:
    case L1中性一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部历史读取状态。
L2结构状态 映射特征定义历史读取状态(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::成功: return L2结构状态::已读取;
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::未找到: return L2结构状态::未找到;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；只核对唯一特征定义本地键映射。
std::optional<稳定编码> 查找唯一特征定义编码映射(
    const L1中性写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    if (本地键.值 != 特征定义节点本地键值 || !有效(编码)) return std::nullopt;
    return 编码;
}

// 诊断责任：无适用错误分支；只把完整 L1 普通节点映射为 创建时空属性值式事实。
std::optional<L2特征定义事实> 形成创建特征定义事实(
    L1中性节点事实 节点, std::uint64_t 事实截止代次) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 事实截止代次)
        节点.退出事实代次.reset();
    节点.当前属性.clear();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 事实截止代次
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 事实截止代次))) {
        return std::nullopt;
    }
    L2特征定义事实 特征定义;
    特征定义.身份 = L2特征定义身份{节点.编码};
    特征定义.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    if (!L2特征定义事实完整(特征定义, 事实截止代次)) return std::nullopt;
    return 特征定义;
}

struct 特征定义预检结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 直接提交 = false;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

// 诊断责任：无适用错误分支；历史属性值组状态只映射为 E2 结构状态。
L2结构状态 映射特征定义历史属性值组失败状态(
    L1中性历史属性值组读取状态 状态) noexcept {
    switch (状态) {
    case L1中性历史属性值组读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性历史属性值组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1中性历史属性值组读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性历史属性值组读取状态::成功:
    case L1中性历史属性值组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；四类 L2 材料无损映射到 L1 中性材料。
L1中性原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1中性原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1中性独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；四类 L1 材料无损映射到 L2 类型化材料。
L2原始值材料 转换为L2材料(const L1中性原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1中性独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；把完整 L1 值事实投影到具名截止。
std::optional<L2属性事实> 形成截止属性事实(
    L1中性值事实 值, std::uint64_t 截止) {
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

// 诊断责任：无适用错误分支；普通特征定义节点骨架允许有序非空当前属性槽。
std::optional<L2特征定义事实> 形成截止特征定义节点骨架(
    L1中性节点事实 节点, std::uint64_t 截止) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 截止))) return std::nullopt;
    for (std::size_t 索引 = 0; 索引 < 节点.当前属性.size(); ++索引) {
        const auto& 槽 = 节点.当前属性[索引];
        if (!有效(槽.属性类型节点) || !有效(槽.当前值)
            || (索引 != 0
                && !(节点.当前属性[索引 - 1].属性类型节点 < 槽.属性类型节点)))
            return std::nullopt;
        for (std::size_t 前索引 = 0; 前索引 < 索引; ++前索引)
            if (节点.当前属性[前索引].当前值 == 槽.当前值) return std::nullopt;
    }
    L2特征定义事实 特征定义;
    特征定义.身份 = L2特征定义身份{节点.编码};
    特征定义.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return 特征定义;
}

// 诊断责任：无适用错误分支；核对一致投影顶层成功或精确失败形状。
特征定义预检结果 解释特征定义一致读取顶层(
    const L1中性一致当前读取结果& 读取, std::uint64_t 期望代次) noexcept {
    if (读取.状态 == L1中性一致当前读取状态::成功) {
        if (读取.合同版本 == L1中性一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次 && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1中性一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1中性一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1中性一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移, 读取.读取事实代次, true};
    return {映射特征定义一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；按查询编码查找唯一节点结果项。
const L1中性一致节点读取结果项* 查找唯一特征定义节点项(
    const L1中性一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1中性一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：向上送出；当前代次失败或漂移均形成结构化预检结果。
特征定义预检结果 检查特征定义当前代次(
    const L1事实基座服务& 第一层服务, 稳定编码 特征定义编码,
    std::uint64_t 期望代次) {
    L1中性一致当前读取请求 请求;
    请求.合同版本 = L1中性一致当前读取合同版本;
    请求.期望事实代次 = 期望代次;
    请求.节点 = {特征定义编码};
    const auto 读取 = 第一层服务.尝试读取中性一致当前投影(请求);
    const auto 结果 = 解释特征定义一致读取顶层(读取, 期望代次);
    if (!结果.成功()) return 结果;
    const bool 只有具名节点 = 读取.节点.size() == 1
        && 读取.关系.empty() && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const auto* 节点项 = 只有具名节点
        ? 查找唯一特征定义节点项(读取, 特征定义编码) : nullptr;
    const bool 节点项完整 = 节点项
        && ((节点项->状态 == L1中性一致当前读取项目状态::成功
                && 节点项->事实 && 节点项->事实->编码 == 特征定义编码)
            || ((节点项->状态 == L1中性一致当前读取项目状态::未找到
                    || 节点项->状态 == L1中性一致当前读取项目状态::已退出)
                && !节点项->事实));
    return 节点项完整 ? 结果
        : 特征定义预检结果{L2结构状态::内部不一致,
            读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；只形成完整特征定义读取的空载荷失败。
L2特征定义完整读取结果 形成完整特征定义读取失败(
    const L2特征定义完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt};
}

// 诊断责任：向上送出；两次同期一致投影形成完整当前特征定义。
L2特征定义完整读取结果 读取当前完整特征定义(
    L1事实基座服务& 第一层服务, const L2特征定义完整读取请求& 请求) {
    L1中性一致当前读取请求 首次请求;
    首次请求.合同版本 = L1中性一致当前读取合同版本;
    首次请求.期望事实代次 = 请求.请求头.期望事实代次;
    首次请求.节点 = {请求.特征定义.值};
    const auto 首次读取 = 第一层服务.尝试读取中性一致当前投影(首次请求);
    const auto 首次顶层 = 解释特征定义一致读取顶层(
        首次读取, 请求.请求头.期望事实代次);
    if (!首次顶层.成功()) return 形成完整特征定义读取失败(
        请求, 首次顶层.状态, 首次顶层.事实截止代次);
    if (首次读取.节点.size() != 1 || !首次读取.关系.empty()
        || !首次读取.值.empty() || !首次读取.属性值.empty()
        || !首次读取.源关系组.empty() || !首次读取.目标关系组.empty())
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
    const auto* 首次特征定义项 = 查找唯一特征定义节点项(首次读取, 请求.特征定义.值);
    if (!首次特征定义项) return 形成完整特征定义读取失败(
        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
    if (首次特征定义项->状态 != L1中性一致当前读取项目状态::成功) {
        if (首次特征定义项->事实) return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
        return 形成完整特征定义读取失败(请求,
            映射特征定义当前项目状态(首次特征定义项->状态), 首次顶层.事实截止代次);
    }
    if (!首次特征定义项->事实 || 首次特征定义项->事实->退出事实代次
        || !形成截止特征定义节点骨架(*首次特征定义项->事实,
            请求.请求头.期望事实代次))
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);

    L1中性一致当前读取请求 完整请求;
    完整请求.合同版本 = L1中性一致当前读取合同版本;
    完整请求.期望事实代次 = 请求.请求头.期望事实代次;
    完整请求.节点 = {请求.特征定义.值};
    for (const auto& 槽 : 首次特征定义项->事实->当前属性)
        完整请求.属性值.push_back({请求.特征定义.值, 槽.属性类型节点});
    const auto 完整读取 = 第一层服务.尝试读取中性一致当前投影(完整请求);
    const auto 完整顶层 = 解释特征定义一致读取顶层(
        完整读取, 请求.请求头.期望事实代次);
    if (!完整顶层.成功()) return 形成完整特征定义读取失败(
        请求, 完整顶层.状态, 完整顶层.事实截止代次);
    if (完整读取.节点.size() != 1 || !完整读取.关系.empty()
        || !完整读取.值.empty()
        || 完整读取.属性值.size() != 完整请求.属性值.size()
        || !完整读取.源关系组.empty() || !完整读取.目标关系组.empty())
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.事实截止代次);
    const auto* 完整特征定义项 = 查找唯一特征定义节点项(完整读取, 请求.特征定义.值);
    if (!完整特征定义项 || 完整特征定义项->状态 != L1中性一致当前读取项目状态::成功
        || !完整特征定义项->事实 || 完整特征定义项->事实->退出事实代次
        || 完整特征定义项->事实->当前属性 != 首次特征定义项->事实->当前属性)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.事实截止代次);
    auto 特征定义 = 形成截止特征定义节点骨架(
        *完整特征定义项->事实, 请求.请求头.期望事实代次);
    if (!特征定义 || 特征定义->身份 != 请求.特征定义)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.事实截止代次);
    for (const auto& 槽 : 完整特征定义项->事实->当前属性) {
        const L1中性一致属性值读取结果项* 找到 = nullptr;
        for (const auto& 项 : 完整读取.属性值) {
            if (项.节点 != 请求.特征定义.值 || 项.属性类型 != 槽.属性类型节点) continue;
            if (找到) return 形成完整特征定义读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.事实截止代次);
            找到 = &项;
        }
        if (!找到 || 找到->状态 != L1中性一致当前读取项目状态::成功
            || !找到->投影 || 找到->投影->属性槽 != 槽
            || 找到->投影->当前值事实.编码 != 槽.当前值
            || 找到->投影->当前值事实.所属节点 != 请求.特征定义.值
            || 找到->投影->当前值事实.属性类型节点 != 槽.属性类型节点
            || 找到->投影->当前值事实.退出事实代次)
            return 形成完整特征定义读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.事实截止代次);
        auto 属性 = 形成截止属性事实(
            找到->投影->当前值事实, 请求.请求头.期望事实代次);
        if (!属性 || 属性->退出事实代次)
            return 形成完整特征定义读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.事实截止代次);
        特征定义->固定属性.push_back(std::move(*属性));
    }
    std::sort(特征定义->固定属性.begin(), 特征定义->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    if (!L2特征定义事实完整(*特征定义, 请求.请求头.期望事实代次))
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.事实截止代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.请求头.期望事实代次, std::nullopt}, 请求.读取类别, 0,
        std::move(特征定义)};
}

// 诊断责任：向上送出；历史节点、属性组和前后代次矛盾均返回零部分特征定义。
L2特征定义完整读取结果 读取历史完整特征定义(
    L1事实基座服务& 第一层服务, const L2特征定义完整读取请求& 请求) {
    const auto 前代次 = 检查特征定义当前代次(
        第一层服务, 请求.特征定义.值, 请求.请求头.期望事实代次);
    if (!前代次.成功()) return 形成完整特征定义读取失败(请求,
        前代次.直接提交 ? L2结构状态::事实代次漂移 : 前代次.状态,
        前代次.事实截止代次);
    const auto 历史 = 第一层服务.读取中性历史事实(
        {L1中性CRUD合同版本, 请求.特征定义.值});
    if (历史.合同版本 != L1中性CRUD合同版本
        || 历史.查询编码 != 请求.特征定义.值)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (历史.状态 != L1中性读取状态::成功) {
        if (历史.事实) return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return 形成完整特征定义读取失败(
            请求, 映射特征定义历史读取状态(历史.状态), 请求.历史截止事实代次);
    }
    const auto* 节点 = 历史.事实
        ? std::get_if<L1中性节点事实>(&*历史.事实) : nullptr;
    if (!节点 || 节点->编码 != 请求.特征定义.值)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    if (节点->创建事实代次 > 请求.历史截止事实代次)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::未找到, 请求.历史截止事实代次);
    if (节点->退出事实代次
        && *节点->退出事实代次 <= 请求.历史截止事实代次)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::已退出, 请求.历史截止事实代次);
    auto 特征定义 = 形成截止特征定义节点骨架(*节点, 请求.历史截止事实代次);
    if (!特征定义 || 特征定义->身份 != 请求.特征定义)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    const auto 属性组 = 第一层服务.读取中性历史属性值组(
        {L1中性CRUD合同版本, 请求.特征定义.值, 请求.历史截止事实代次});
    if (属性组.合同版本 != L1中性CRUD合同版本
        || 属性组.所属节点 != 请求.特征定义.值
        || 属性组.历史截止事实代次 != 请求.历史截止事实代次)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 属性组.读取事实代次);
    if (属性组.状态 != L1中性历史属性值组读取状态::成功) {
        if (!属性组.属性值组.empty()) return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 属性组.读取事实代次);
        return 形成完整特征定义读取失败(请求,
            映射特征定义历史属性值组失败状态(属性组.状态), 属性组.读取事实代次);
    }
    if (属性组.读取事实代次 != 请求.请求头.期望事实代次)
        return 形成完整特征定义读取失败(
            请求, L2结构状态::事实代次漂移, 属性组.读取事实代次);
    std::vector<稳定编码> 属性类型组;
    for (const auto& 原属性 : 属性组.属性值组) {
        if (原属性.所属节点 != 请求.特征定义.值
            || 原属性.创建事实代次 == 0
            || 原属性.创建事实代次 > 请求.历史截止事实代次
            || (原属性.退出事实代次
                && *原属性.退出事实代次 <= 请求.历史截止事实代次)
            || std::find(属性类型组.begin(), 属性类型组.end(),
                原属性.属性类型节点) != 属性类型组.end())
            return 形成完整特征定义读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        auto 属性 = 形成截止属性事实(原属性, 请求.历史截止事实代次);
        if (!属性 || 属性->退出事实代次)
            return 形成完整特征定义读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        属性类型组.push_back(原属性.属性类型节点);
        特征定义->固定属性.push_back(std::move(*属性));
    }
    const auto 后代次 = 检查特征定义当前代次(
        第一层服务, 请求.特征定义.值, 请求.请求头.期望事实代次);
    if (!后代次.成功()) return 形成完整特征定义读取失败(请求,
        后代次.直接提交 ? L2结构状态::事实代次漂移 : 后代次.状态,
        后代次.事实截止代次);
    std::sort(特征定义->固定属性.begin(), 特征定义->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    if (!L2特征定义事实完整(*特征定义, 请求.历史截止事实代次))
        return 形成完整特征定义读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    return {{L2结构合同版本, L2结构状态::已读取,
        请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::move(特征定义)};
}

// 诊断责任：无适用错误分支；只形成固定属性写入空载荷失败。
L2特征定义固定属性写入结果 形成特征定义固定属性写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：向上送出；同期特征定义节点与具名属性槽前置均结构化返回。
特征定义预检结果 检查特征定义固定属性前置(
    const L1事实基座服务& 第一层服务, L2特征定义身份 特征定义, 稳定编码 属性类型,
    std::optional<稳定编码> 期望旧值, std::uint64_t 截止) {
    L1中性一致当前读取请求 请求;
    请求.合同版本 = L1中性一致当前读取合同版本;
    请求.期望事实代次 = 截止;
    请求.节点 = {特征定义.值};
    请求.属性值 = {{特征定义.值, 属性类型}};
    const auto 读取 = 第一层服务.尝试读取中性一致当前投影(请求);
    const auto 顶层 = 解释特征定义一致读取顶层(读取, 截止);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 1 || 读取.属性值.size() != 1
        || !读取.关系.empty() || !读取.值.empty()
        || !读取.源关系组.empty() || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 节点项 = 查找唯一特征定义节点项(读取, 特征定义.值);
    if (!节点项 || 节点项->状态 != L1中性一致当前读取项目状态::成功
        || !节点项->事实 || 节点项->事实->退出事实代次
        || !形成截止特征定义节点骨架(*节点项->事实, 截止)) {
        if (节点项 && !节点项->事实)
            return {映射特征定义当前项目状态(节点项->状态), 顶层.事实截止代次, false};
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    }
    const auto& 属性项 = 读取.属性值.front();
    if (属性项.节点 != 特征定义.值 || 属性项.属性类型 != 属性类型)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    if (属性项.状态 == L1中性一致当前读取项目状态::属性未设置) {
        if (属性项.投影)
            return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
        return 期望旧值
            ? 特征定义预检结果{L2结构状态::属性未设置,
                顶层.事实截止代次, false}
            : 特征定义预检结果{L2结构状态::已读取,
                顶层.事实截止代次, false};
    }
    if (属性项.状态 != L1中性一致当前读取项目状态::成功
        || !属性项.投影 || 属性项.投影->属性槽.属性类型节点 != 属性类型
        || 属性项.投影->属性槽.当前值 != 属性项.投影->当前值事实.编码
        || 属性项.投影->当前值事实.所属节点 != 特征定义.值
        || 属性项.投影->当前值事实.属性类型节点 != 属性类型
        || 属性项.投影->当前值事实.退出事实代次
        || !形成截止属性事实(属性项.投影->当前值事实, 截止))
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    if (!期望旧值 || 属性项.投影->当前值事实.编码 != *期望旧值)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：无适用错误分支；只核对新值本地键唯一映射。
std::optional<稳定编码> 查找唯一特征定义固定属性编码映射(
    const L1中性写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    return 本地键.值 == 特征定义固定属性值本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

// 诊断责任：向上送出；属性写集提交、首次映射和历史读回矛盾均结构化返回。
L2特征定义固定属性写入结果 提交并读回特征定义固定属性写集(
    L1事实基座服务& 第一层服务, const L1中性写集请求& 写集,
    L2特征定义身份 特征定义, const L2属性提交项& 新属性,
    std::optional<稳定编码> 旧值编码) {
    const auto 写入 = 第一层服务.提交中性写集(写集);
    if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 写集.幂等键)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射特征定义写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成特征定义固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成特征定义固定属性写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    const auto 新值编码 = 查找唯一特征定义固定属性编码映射(写入);
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !新值编码)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 属性组 = 第一层服务.读取中性历史属性值组(
        {L1中性CRUD合同版本, 特征定义.值, 写入.事实代次});
    if (属性组.状态 != L1中性历史属性值组读取状态::成功
        || 属性组.合同版本 != L1中性CRUD合同版本
        || 属性组.所属节点 != 特征定义.值
        || 属性组.历史截止事实代次 != 写入.事实代次
        || 属性组.读取事实代次 < 写入.事实代次)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const L1中性值事实* 新值 = nullptr;
    for (const auto& 值 : 属性组.属性值组) {
        if (值.编码 != *新值编码) continue;
        if (新值) return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新值 = &值;
    }
    if (!新值 || 新值->所属节点 != 特征定义.值
        || 新值->属性类型节点 != 新属性.属性类型身份
        || 新值->来源节点 != 新属性.来源稳定编码
        || 转换为L2材料(新值->材料) != 新属性.原始值材料
        || 新值->创建事实代次 != 写入.事实代次)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    auto 当前属性 = 形成截止属性事实(*新值, 写入.事实代次);
    if (!当前属性 || 当前属性->退出事实代次)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    L2特征定义固定属性写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(当前属性), std::nullopt};
    if (旧值编码) {
        const auto 旧读取 = 第一层服务.读取中性历史事实(
            {L1中性CRUD合同版本, *旧值编码});
        const auto* 旧值 = 旧读取.事实
            ? std::get_if<L1中性值事实>(&*旧读取.事实) : nullptr;
        if (旧读取.状态 != L1中性读取状态::成功
            || 旧读取.合同版本 != L1中性CRUD合同版本
            || 旧读取.查询编码 != *旧值编码 || !旧值
            || 旧值->编码 != *旧值编码 || 旧值->所属节点 != 特征定义.值
            || 旧值->属性类型节点 != 新属性.属性类型身份
            || 旧值->退出事实代次 != 写入.事实代次)
            return 形成特征定义固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        结果.已退出属性 = 形成截止属性事实(*旧值, 写入.事实代次);
        if (!结果.已退出属性
            || 结果.已退出属性->退出事实代次 != 写入.事实代次)
            return 形成特征定义固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成特征定义固定属性写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：无适用错误分支；只形成特征定义退出空载荷失败。
L2特征定义退出结果 形成特征定义退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

// 诊断责任：向上送出；特征定义退出提交与显式节点、属性历史读回矛盾均结构化返回。
L2特征定义退出结果 提交并读回特征定义退出写集(
    L1事实基座服务& 第一层服务, const L1中性写集请求& 写集,
    const L2特征定义退出请求& 请求) {
    const auto 写入 = 第一层服务.提交中性写集(写集);
    if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 写集.幂等键)
        return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射特征定义写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成特征定义退出失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || !写入.新编码映射.empty())
        return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 节点读取 = 第一层服务.读取中性历史事实(
        {L1中性CRUD合同版本, 请求.特征定义.值});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
    if (节点读取.状态 != L1中性读取状态::成功
        || 节点读取.合同版本 != L1中性CRUD合同版本
        || 节点读取.查询编码 != 请求.特征定义.值 || !节点
        || 节点->编码 != 请求.特征定义.值
        || 节点->退出事实代次 != 写入.事实代次)
        return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
    auto 特征定义 = 形成截止特征定义节点骨架(*节点, 写入.事实代次);
    if (!特征定义 || 特征定义->身份 != 请求.特征定义
        || 特征定义->生命周期.退出事实代次 != 写入.事实代次)
        return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
    for (const auto 编码 : 请求.当前固定属性值) {
        const auto 读取 = 第一层服务.读取中性历史事实(
            {L1中性CRUD合同版本, 编码});
        const auto* 值 = 读取.事实 ? std::get_if<L1中性值事实>(&*读取.事实) : nullptr;
        if (读取.状态 != L1中性读取状态::成功
            || 读取.合同版本 != L1中性CRUD合同版本 || 读取.查询编码 != 编码
            || !值 || 值->编码 != 编码 || 值->所属节点 != 请求.特征定义.值
            || 值->退出事实代次 != 写入.事实代次)
            return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
        auto 属性 = 形成截止属性事实(*值, 写入.事实代次);
        if (!属性 || 属性->退出事实代次 != 写入.事实代次)
            return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
        特征定义->固定属性.push_back(std::move(*属性));
    }
    if (节点->当前属性.size() != 特征定义->固定属性.size())
        return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
    for (const auto& 槽 : 节点->当前属性) {
        const auto 找到 = std::find_if(特征定义->固定属性.begin(), 特征定义->固定属性.end(),
            [&](const auto& 属性) noexcept {
                return 属性.属性类型身份 == 槽.属性类型节点
                    && 属性.值稳定编码 == 槽.当前值;
            });
        if (找到 == 特征定义->固定属性.end())
            return 形成特征定义退出失败(L2结构状态::内部不一致, 写入.事实代次);
    }
    std::sort(特征定义->固定属性.begin(), 特征定义->固定属性.end(),
        [](const auto& 左, const auto& 右) noexcept {
            return 左.属性类型身份 < 右.属性类型身份
                || (左.属性类型身份 == 右.属性类型身份
                    && 左.值稳定编码 < 右.值稳定编码);
        });
    L2特征定义退出结果 结果{{L2结构合同版本, 状态, 写入.事实代次,
        写入.事实代次}, std::move(特征定义)};
    return 结果.成功() ? 结果 : 形成特征定义退出失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：无适用错误分支；固定私有域纯值映射不读取事实。
L1中性写集幂等键 映射特征关系类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(特征关系类型登记幂等域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部登记写入状态。
L2特征关系类型登记状态 映射特征关系类型登记写入状态(
    L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return L2特征关系类型登记状态::已提交;
    case L1中性写入状态::精确重复:
        return L2特征关系类型登记状态::精确重复;
    case L1中性写入状态::入口拒绝: return L2特征关系类型登记状态::入口拒绝;
    case L1中性写入状态::事实代次漂移:
        return L2特征关系类型登记状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return L2特征关系类型登记状态::幂等冲突;
    case L1中性写入状态::资源失败: return L2特征关系类型登记状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::引用冲突:
    case L1中性写入状态::内部不一致:
        return L2特征关系类型登记状态::内部不一致;
    }
    return L2特征关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；一致读取失败状态映射为登记状态。
L2特征关系类型登记状态 映射特征关系类型登记读取失败状态(
    L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::入口拒绝:
        return L2特征关系类型登记状态::入口拒绝;
    case L1中性一致当前读取状态::许可拒绝:
        return L2特征关系类型登记状态::许可拒绝;
    case L1中性一致当前读取状态::事实代次漂移:
        return L2特征关系类型登记状态::事实代次漂移;
    case L1中性一致当前读取状态::资源失败:
        return L2特征关系类型登记状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::内部不一致:
        return L2特征关系类型登记状态::内部不一致;
    }
    return L2特征关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；登记失败必须保持空载荷。
L2特征关系类型登记结果 形成特征关系类型登记失败(
    L2特征关系类型登记状态 状态,
    std::uint64_t 事实截止代次 = 0) noexcept {
    return {状态, 事实截止代次, std::nullopt};
}

// 诊断责任：无适用错误分支；核对一致读取失败的空载荷形状。
bool 特征关系类型一致读取失败形状完整(
    const L1中性一致当前读取结果& 结果,
    std::uint64_t 期望代次) noexcept {
    if (结果.状态 == L1中性一致当前读取状态::成功
        || 结果.合同版本 != L1中性一致当前读取合同版本
        || 结果.期望事实代次 != 期望代次
        || !结果.节点.empty() || !结果.关系.empty() || !结果.值.empty()
        || !结果.属性值.empty() || !结果.源关系组.empty()
        || !结果.目标关系组.empty()) return false;
    return 结果.状态 == L1中性一致当前读取状态::事实代次漂移
        ? 结果.读取事实代次 != 0 && 结果.读取事实代次 != 期望代次
        : 结果.读取事实代次 == 0;
}

// 诊断责任：无适用错误分支；未找到或重复的本地键映射返回空值。
std::optional<稳定编码> 查找特征关系类型编码映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键.值 != 本地键值) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只核对两项登记编码映射一一对应。
bool 特征关系类型编码映射唯一(const L1中性写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 2) return false;
    const auto 宿主 = 查找特征关系类型编码映射(
        结果, 特征宿主关系类型本地键值);
    const auto 定义 = 查找特征关系类型编码映射(
        结果, 特征定义关系类型本地键值);
    return 宿主 && 定义 && 有效(*宿主) && 有效(*定义) && *宿主 != *定义;
}

// 诊断责任：无适用错误分支；登记失败精确收口为共同结构状态。
L2结构状态 映射登记失败为结构状态(
    L2特征关系类型登记状态 状态) noexcept {
    switch (状态) {
    case L2特征关系类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2特征关系类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2特征关系类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2特征关系类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2特征关系类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2特征关系类型登记状态::登记未加载:
    case L2特征关系类型登记状态::已提交:
    case L2特征关系类型登记状态::精确重复:
    case L2特征关系类型登记状态::已读取:
    case L2特征关系类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；值类型登记使用独立私有幂等域。
L1中性写集幂等键 映射特征值类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(特征值类型登记幂等域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；完整覆盖值类型登记写入状态。
L2特征值类型登记状态 映射特征值类型登记写入状态(
    L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return L2特征值类型登记状态::已提交;
    case L1中性写入状态::精确重复:
        return L2特征值类型登记状态::精确重复;
    case L1中性写入状态::入口拒绝: return L2特征值类型登记状态::入口拒绝;
    case L1中性写入状态::事实代次漂移:
        return L2特征值类型登记状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return L2特征值类型登记状态::幂等冲突;
    case L1中性写入状态::资源失败: return L2特征值类型登记状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::引用冲突:
    case L1中性写入状态::内部不一致:
        return L2特征值类型登记状态::内部不一致;
    }
    return L2特征值类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；完整覆盖值类型登记一致读取失败状态。
L2特征值类型登记状态 映射特征值类型登记读取失败状态(
    L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::入口拒绝:
        return L2特征值类型登记状态::入口拒绝;
    case L1中性一致当前读取状态::许可拒绝:
        return L2特征值类型登记状态::许可拒绝;
    case L1中性一致当前读取状态::事实代次漂移:
        return L2特征值类型登记状态::事实代次漂移;
    case L1中性一致当前读取状态::资源失败:
        return L2特征值类型登记状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::内部不一致:
        return L2特征值类型登记状态::内部不一致;
    }
    return L2特征值类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；登记失败保持空载荷。
L2特征值类型登记结果 形成特征值类型登记失败(
    L2特征值类型登记状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {状态, 截止, std::nullopt};
}

// 诊断责任：无适用错误分支；按本地键查找唯一非零编码。
std::optional<稳定编码> 查找特征值类型编码映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键.值 != 本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；四个登记编码须一一对应且互异。
bool 特征值类型编码映射唯一(const L1中性写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 4) return false;
    const auto I64 = 查找特征值类型编码映射(结果, 特征I64值类型本地键值);
    const auto I64组 = 查找特征值类型编码映射(结果, 特征I64组值类型本地键值);
    const auto U64组 = 查找特征值类型编码映射(结果, 特征U64组值类型本地键值);
    const auto 独立材料 = 查找特征值类型编码映射(
        结果, 特征独立材料值类型本地键值);
    return I64 && I64组 && U64组 && 独立材料
        && *I64 != *I64组 && *I64 != *U64组 && *I64 != *独立材料
        && *I64组 != *U64组 && *I64组 != *独立材料 && *U64组 != *独立材料;
}

// 诊断责任：无适用错误分支；值类型登记失败精确收口为共同状态。
L2结构状态 映射值类型登记失败为结构状态(
    L2特征值类型登记状态 状态) noexcept {
    switch (状态) {
    case L2特征值类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2特征值类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2特征值类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2特征值类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2特征值类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2特征值类型登记状态::登记未加载:
    case L2特征值类型登记状态::已提交:
    case L2特征值类型登记状态::精确重复:
    case L2特征值类型登记状态::已读取:
    case L2特征值类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；材料 variant 唯一选择登记类型编码。
稳定编码 选择特征值类型编码(const L2特征值类型登记& 登记,
    const L2原始值材料& 材料) noexcept {
    return std::visit([&](const auto& 值) noexcept -> 稳定编码 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, std::int64_t>)
            return 登记.I64值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>)
            return 登记.I64组值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>)
            return 登记.U64组值类型.值;
        else return 登记.独立材料值类型.值;
    }, 材料);
}

// 诊断责任：无适用错误分支；登记编码与材料表示必须逐项一致。
bool 特征值类型与材料一致(const L2特征值类型登记& 登记,
    稳定编码 类型编码, const L1中性原始值材料& 材料) {
    const auto L2材料 = 转换为L2材料(材料);
    return 选择特征值类型编码(登记, L2材料) == 类型编码;
}

// 诊断责任：无适用错误分支；只形成空实例写入失败。
L2特征实例写入结果 形成特征实例写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成空实例完整读取失败。
L2特征实例完整读取结果 形成完整特征实例读取失败(
    const L2特征实例完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成空枚举失败。
L2按存在当前特征读取结果 形成按存在特征读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, {}};
}

// 诊断责任：无适用错误分支；事实代次探测失败映射为结构状态。
L2结构状态 映射特征事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；历史关系组失败映射为结构状态。
L2结构状态 映射特征历史关系组失败状态(
    L1中性历史关系组读取状态 状态) noexcept {
    switch (状态) {
    case L1中性历史关系组读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性历史关系组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1中性历史关系组读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性历史关系组读取状态::成功:
    case L1中性历史关系组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；节点与两条关系形成同截止实例骨架。
std::optional<L2特征实例事实> 形成F2特征实例事实(
    L1中性节点事实 节点, const L1中性关系事实& 宿主关系,
    const L1中性关系事实& 定义关系,
    const L2特征关系类型登记& 登记, std::uint64_t 截止) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (宿主关系.退出事实代次 && *宿主关系.退出事实代次 <= 截止) return std::nullopt;
    if (定义关系.退出事实代次 && *定义关系.退出事实代次 <= 截止) return std::nullopt;
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示
        || 节点.创建事实代次 == 0 || 节点.创建事实代次 > 截止
        || (节点.退出事实代次 && *节点.退出事实代次 < 节点.创建事实代次)
        || !有效(宿主关系.编码) || !有效(定义关系.编码)
        || 宿主关系.编码 == 定义关系.编码
        || 宿主关系.源节点 != 节点.编码 || 定义关系.源节点 != 节点.编码
        || 宿主关系.关系类型节点 != 登记.宿主关系类型.值
        || 定义关系.关系类型节点 != 登记.定义关系类型.值
        || 宿主关系.角色或顺序 != 特征实例端点角色值
        || 定义关系.角色或顺序 != 特征实例端点角色值
        || 宿主关系.创建事实代次 != 节点.创建事实代次
        || 定义关系.创建事实代次 != 节点.创建事实代次)
        return std::nullopt;
    L2特征实例事实 实例;
    实例.身份 = L2特征实例身份{节点.编码};
    实例.宿主存在 = L2存在身份{宿主关系.目标节点};
    实例.特征定义 = L2特征定义身份{定义关系.目标节点};
    实例.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return L2特征实例事实完整(实例, 截止)
        ? std::optional<L2特征实例事实>{实例} : std::nullopt;
}

// 诊断责任：无适用错误分支；三个本地键必须映射到三个不同非零编码。
bool 特征实例编码映射完整(const L1中性写入结果& 写入,
    稳定编码& 实例编码, 稳定编码& 宿主关系编码,
    稳定编码& 定义关系编码) noexcept {
    if (写入.新编码映射.size() != 3) return false;
    auto 查找 = [&](std::uint32_t 键值) noexcept -> std::optional<稳定编码> {
        std::optional<稳定编码> 找到;
        for (const auto& [键, 编码] : 写入.新编码映射) {
            if (键.值 != 键值) continue;
            if (找到) return std::nullopt;
            找到 = 编码;
        }
        return 找到;
    };
    const auto 实例 = 查找(特征实例节点本地键值);
    const auto 宿主 = 查找(特征实例宿主关系本地键值);
    const auto 定义 = 查找(特征实例定义关系本地键值);
    if (!实例 || !宿主 || !定义 || !有效(*实例) || !有效(*宿主)
        || !有效(*定义) || *实例 == *宿主 || *实例 == *定义 || *宿主 == *定义)
        return false;
    实例编码 = *实例;
    宿主关系编码 = *宿主;
    定义关系编码 = *定义;
    return true;
}

// 诊断责任：无适用错误分支；L1 值事实按登记表示投影为完整特征值。
std::optional<L2特征值事实> 形成截止特征值事实(
    L1中性值事实 值, const L2特征值类型登记& 登记,
    std::uint64_t 截止, bool 保留完整生命周期 = false) {
    if (!保留完整生命周期 && 值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    if (!特征值类型与材料一致(登记, 值.属性类型节点, 值.材料))
        return std::nullopt;
    L2特征值事实 特征值{值.编码, L2特征实例身份{值.所属节点},
        转换为L2材料(值.材料), 值.来源节点,
        {值.创建事实代次, 值.退出事实代次}};
    return L2特征值事实截止投影完整(特征值, 截止)
        ? std::optional<L2特征值事实>{std::move(特征值)} : std::nullopt;
}

// 诊断责任：无适用错误分支；只形成空当前值写入失败。
L2特征当前值写入结果 形成特征当前值写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成具名历史值空载荷失败。
L2特征值历史读取结果 形成特征值历史读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成实例退出空载荷失败。
L2特征实例退出结果 形成特征实例退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；新值本地键必须唯一映射。
std::optional<稳定编码> 查找唯一特征当前值编码映射(
    const L1中性写入结果& 写入) noexcept {
    if (写入.新编码映射.size() != 1) return std::nullopt;
    const auto& [键, 编码] = 写入.新编码映射.front();
    return 键.值 == 特征当前值本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

// 诊断责任：向上送出；当前值提交按首次代次历史重建新旧值。
L2特征当前值写入结果 提交并读回特征当前值写集(
    L1事实基座服务& 第一层服务, const L1中性写集请求& 写集,
    const L2特征值类型登记& 登记, L2特征实例身份 实例,
    const L2原始值材料& 新材料, 稳定编码 来源,
    std::optional<稳定编码> 旧值编码) {
    const auto 写入 = 第一层服务.提交中性写集(写集);
    if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 写集.幂等键)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射特征定义写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成特征当前值写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成特征当前值写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    const auto 新值编码 = 查找唯一特征当前值编码映射(写入);
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !新值编码)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 属性组 = 第一层服务.读取中性历史属性值组(
        {L1中性CRUD合同版本, 实例.值, 写入.事实代次});
    if (属性组.状态 != L1中性历史属性值组读取状态::成功
        || 属性组.合同版本 != L1中性CRUD合同版本
        || 属性组.所属节点 != 实例.值
        || 属性组.历史截止事实代次 != 写入.事实代次
        || 属性组.读取事实代次 < 写入.事实代次)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    const L1中性值事实* 新值 = nullptr;
    for (const auto& 值 : 属性组.属性值组) {
        if (值.编码 != *新值编码) continue;
        if (新值) return 形成特征当前值写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新值 = &值;
    }
    const auto 类型编码 = 选择特征值类型编码(登记, 新材料);
    if (!新值 || 新值->所属节点 != 实例.值
        || 新值->属性类型节点 != 类型编码 || 新值->来源节点 != 来源
        || 转换为L2材料(新值->材料) != 新材料
        || 新值->创建事实代次 != 写入.事实代次 || 新值->退出事实代次)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    auto 当前值 = 形成截止特征值事实(*新值, 登记, 写入.事实代次);
    if (!当前值 || 当前值->生命周期.退出事实代次)
        return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    L2特征当前值写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(当前值), std::nullopt};
    if (旧值编码) {
        const auto 旧读取 = 第一层服务.读取中性历史事实(
            {L1中性CRUD合同版本, *旧值编码});
        const auto* 旧值 = 旧读取.事实
            ? std::get_if<L1中性值事实>(&*旧读取.事实) : nullptr;
        if (旧读取.状态 != L1中性读取状态::成功
            || 旧读取.合同版本 != L1中性CRUD合同版本
            || 旧读取.查询编码 != *旧值编码 || !旧值
            || 旧值->编码 != *旧值编码 || 旧值->所属节点 != 实例.值
            || 旧值->退出事实代次 != 写入.事实代次)
            return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
        结果.已退出值 = 形成截止特征值事实(
            *旧值, 登记, 写入.事实代次, true);
        if (!结果.已退出值
            || 结果.已退出值->生命周期.退出事实代次 != 写入.事实代次)
            return 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果
        : 形成特征当前值写入失败(L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：向上送出；显式实例闭包提交后逐项历史证明同代退出。
L2特征实例退出结果 提交并读回特征实例退出写集(
    L1事实基座服务& 第一层服务, const L1中性写集请求& 写集,
    const L2特征实例退出请求& 请求,
    const L2特征关系类型登记& 关系登记,
    const L2特征值类型登记& 值登记) {
    const auto 写入 = 第一层服务.提交中性写集(写集);
    if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 写集.幂等键)
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射特征定义写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
        return 形成特征实例退出失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || !写入.新编码映射.empty())
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 节点读取 = 第一层服务.读取中性历史事实(
        {L1中性CRUD合同版本, 请求.特征实例.值});
    const auto 宿主读取 = 第一层服务.读取中性历史事实(
        {L1中性CRUD合同版本, 请求.自有关系.宿主关系稳定编码});
    const auto 定义读取 = 第一层服务.读取中性历史事实(
        {L1中性CRUD合同版本, 请求.自有关系.定义关系稳定编码});
    const auto* 节点 = 节点读取.事实
        ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
    const auto* 宿主关系 = 宿主读取.事实
        ? std::get_if<L1中性关系事实>(&*宿主读取.事实) : nullptr;
    const auto* 定义关系 = 定义读取.事实
        ? std::get_if<L1中性关系事实>(&*定义读取.事实) : nullptr;
    if (节点读取.状态 != L1中性读取状态::成功
        || 宿主读取.状态 != L1中性读取状态::成功
        || 定义读取.状态 != L1中性读取状态::成功
        || 节点读取.合同版本 != L1中性CRUD合同版本
        || 宿主读取.合同版本 != L1中性CRUD合同版本
        || 定义读取.合同版本 != L1中性CRUD合同版本
        || !节点 || !宿主关系 || !定义关系
        || 节点->编码 != 请求.特征实例.值
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || 节点->退出事实代次 != 写入.事实代次
        || 宿主关系->编码 != 请求.自有关系.宿主关系稳定编码
        || 定义关系->编码 != 请求.自有关系.定义关系稳定编码
        || 宿主关系->源节点 != 请求.特征实例.值
        || 定义关系->源节点 != 请求.特征实例.值
        || 宿主关系->关系类型节点 != 关系登记.宿主关系类型.值
        || 定义关系->关系类型节点 != 关系登记.定义关系类型.值
        || 宿主关系->角色或顺序 != 特征实例端点角色值
        || 定义关系->角色或顺序 != 特征实例端点角色值
        || 宿主关系->退出事实代次 != 写入.事实代次
        || 定义关系->退出事实代次 != 写入.事实代次)
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    const auto 宿主节点读取 = 第一层服务.读取中性历史事实(
        {L1中性CRUD合同版本, 宿主关系->目标节点});
    const auto 定义节点读取 = 第一层服务.读取中性历史事实(
        {L1中性CRUD合同版本, 定义关系->目标节点});
    const auto* 宿主节点 = 宿主节点读取.事实
        ? std::get_if<L1中性节点事实>(&*宿主节点读取.事实) : nullptr;
    const auto* 定义节点 = 定义节点读取.事实
        ? std::get_if<L1中性节点事实>(&*定义节点读取.事实) : nullptr;
    const auto 端点在截止有效 = [&](const L1中性节点事实* 端点) noexcept {
        return 端点 && 端点->种类 == 节点种类::普通 && !端点->属性类型表示
            && 端点->创建事实代次 != 0 && 端点->创建事实代次 <= 写入.事实代次
            && (!端点->退出事实代次 || *端点->退出事实代次 > 写入.事实代次);
    };
    if (宿主节点读取.状态 != L1中性读取状态::成功
        || 定义节点读取.状态 != L1中性读取状态::成功
        || !端点在截止有效(宿主节点) || !端点在截止有效(定义节点))
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    L2特征实例事实 实例;
    实例.身份 = 请求.特征实例;
    实例.宿主存在 = L2存在身份{宿主关系->目标节点};
    实例.特征定义 = L2特征定义身份{定义关系->目标节点};
    实例.生命周期 = {节点->创建事实代次, 节点->退出事实代次};
    if (!有效(实例.宿主存在.值) || !有效(实例.特征定义.值)
        || !L2生命周期完整(实例.生命周期))
        return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    if (请求.当前值稳定编码) {
        const auto 值读取 = 第一层服务.读取中性历史事实(
            {L1中性CRUD合同版本, *请求.当前值稳定编码});
        const auto* 值 = 值读取.事实
            ? std::get_if<L1中性值事实>(&*值读取.事实) : nullptr;
        if (值读取.状态 != L1中性读取状态::成功
            || 值读取.合同版本 != L1中性CRUD合同版本 || !值
            || 值->编码 != *请求.当前值稳定编码
            || 值->所属节点 != 请求.特征实例.值
            || 值->退出事实代次 != 写入.事实代次)
            return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
        实例.当前值 = 形成截止特征值事实(
            *值, 值登记, 写入.事实代次, true);
        if (!实例.当前值
            || 实例.当前值->生命周期.退出事实代次 != 写入.事实代次)
            return 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
    }
    L2特征实例退出结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(实例), 请求.自有关系};
    return 结果.成功() ? 结果
        : 形成特征实例退出失败(L2结构状态::内部不一致, 写入.事实代次);
}

} // namespace 海中鱼巣::L2特征结构内部

export namespace 海中鱼巣 {

class L2特征结构服务 final {
public:
    // 诊断责任：无适用错误分支；只保存公开 L1 与存在服务引用。
    explicit L2特征结构服务(L1事实基座服务& 第一层服务,
        const L2存在结构服务& 存在服务) noexcept
        : 第一层服务_(第一层服务), 存在服务_(存在服务) {}
    L2特征结构服务(const L2特征结构服务&) = delete;
    L2特征结构服务& operator=(const L2特征结构服务&) = delete;

    // 诊断责任：向上送出；登记拒绝、漂移、冲突和读回矛盾均结构化返回。
    L2特征关系类型登记结果 建立特征关系类型登记(
        const L2特征关系类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(关系类型登记锁_);
            if (!L2特征关系类型登记请求有效(请求))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::入口拒绝);
            if (关系类型登记定位_) {
                if (!L2特征关系类型登记完整(*关系类型登记定位_))
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致);
                if (关系类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 关系类型登记定位_->规则版本 != 请求.规则版本
                    || 关系类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 关系类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::幂等冲突);
            }

            const auto 幂等键 =
                L2特征结构内部::映射特征关系类型登记幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {
                {{L2特征结构内部::特征宿主关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2特征结构内部::特征定义关系类型本地键值},
                    节点种类::普通, std::nullopt}};
            const auto 写入 = 第一层服务_.提交中性写集(写集);
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 幂等键)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 状态 =
                L2特征结构内部::映射特征关系类型登记写入状态(写入.状态);
            if (状态 != L2特征关系类型登记状态::已提交
                && 状态 != L2特征关系类型登记状态::精确重复) {
                const auto 截止 = 状态 == L2特征关系类型登记状态::事实代次漂移
                    || 状态 == L2特征关系类型登记状态::幂等冲突
                    ? 写入.事实代次 : 0;
                return L2特征结构内部::形成特征关系类型登记失败(状态, 截止);
            }
            const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2特征结构内部::特征关系类型编码映射唯一(写入))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 宿主编码 = L2特征结构内部::查找特征关系类型编码映射(
                写入, L2特征结构内部::特征宿主关系类型本地键值);
            const auto 定义编码 = L2特征结构内部::查找特征关系类型编码映射(
                写入, L2特征结构内部::特征定义关系类型本地键值);
            if (!宿主编码 || !定义编码 || *宿主编码 == *定义编码)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);

            L2特征关系类型登记 新定位;
            新定位.合同版本 = 请求.请求头.合同版本;
            新定位.规则版本 = 请求.规则版本;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            新定位.建立事实代次 = 写入.事实代次;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.宿主关系类型 = {*宿主编码};
            新定位.定义关系类型 = {*定义编码};
            if (!L2特征关系类型登记完整(新定位))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            auto 读回 = 按定位读取当前特征关系类型登记(新定位, 写入.事实代次);
            if (读回.状态 != L2特征关系类型登记状态::已读取
                || !读回.登记 || !读回.成功())
                return 读回.状态 == L2特征关系类型登记状态::已读取
                    ? L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致) : 读回;
            if (关系类型登记定位_ && *关系类型登记定位_ != 新定位)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            关系类型登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；定位在锁内复制，节点在锁外公开读取。
    L2特征关系类型登记结果 读取当前特征关系类型登记() const {
        try {
            std::optional<L2特征关系类型登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(关系类型登记锁_);
                定位 = 关系类型登记定位_;
            }
            if (!定位) return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::登记未加载);
            return 按定位读取当前特征关系类型登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；四种属性类型节点由一份固定登记写集建立。
    L2特征值类型登记结果 建立特征值类型登记(
        const L2特征值类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(值类型登记锁_);
            if (!L2特征值类型登记请求有效(请求))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::入口拒绝);
            if (值类型登记定位_) {
                if (!L2特征值类型登记完整(*值类型登记定位_))
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致);
                if (值类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 值类型登记定位_->规则版本 != 请求.规则版本
                    || 值类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 值类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::幂等冲突);
            }
            const auto 幂等键 =
                L2特征结构内部::映射特征值类型登记幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {
                {{L2特征结构内部::特征I64值类型本地键值},
                    节点种类::属性类型, L1中性值表示种类::I64},
                {{L2特征结构内部::特征I64组值类型本地键值},
                    节点种类::属性类型, L1中性值表示种类::I64组},
                {{L2特征结构内部::特征U64组值类型本地键值},
                    节点种类::属性类型, L1中性值表示种类::U64组},
                {{L2特征结构内部::特征独立材料值类型本地键值},
                    节点种类::属性类型, L1中性值表示种类::独立材料引用}};
            const auto 写入 = 第一层服务_.提交中性写集(写集);
            if (写入.合同版本 != L1中性CRUD合同版本 || 写入.幂等键 != 幂等键)
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            const auto 状态 =
                L2特征结构内部::映射特征值类型登记写入状态(写入.状态);
            if (状态 != L2特征值类型登记状态::已提交
                && 状态 != L2特征值类型登记状态::精确重复) {
                const auto 截止 = 状态 == L2特征值类型登记状态::事实代次漂移
                    || 状态 == L2特征值类型登记状态::幂等冲突
                    ? 写入.事实代次 : 0;
                return L2特征结构内部::形成特征值类型登记失败(状态, 截止);
            }
            const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2特征结构内部::特征值类型编码映射唯一(写入))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            const auto I64 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征I64值类型本地键值);
            const auto I64组 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征I64组值类型本地键值);
            const auto U64组 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征U64组值类型本地键值);
            const auto 独立材料 = L2特征结构内部::查找特征值类型编码映射(
                写入, L2特征结构内部::特征独立材料值类型本地键值);
            if (!I64 || !I64组 || !U64组 || !独立材料)
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            L2特征值类型登记 新定位;
            新定位.合同版本 = 请求.请求头.合同版本;
            新定位.规则版本 = 请求.规则版本;
            新定位.首次幂等身份 = 请求.幂等身份;
            新定位.首次期望事实代次 = 请求.请求头.期望事实代次;
            新定位.建立事实代次 = 写入.事实代次;
            新定位.事实截止代次 = 写入.事实代次;
            新定位.I64值类型 = {*I64};
            新定位.I64组值类型 = {*I64组};
            新定位.U64组值类型 = {*U64组};
            新定位.独立材料值类型 = {*独立材料};
            if (!L2特征值类型登记完整(新定位))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            auto 读回 = 按定位读取当前特征值类型登记(新定位, 写入.事实代次);
            if (读回.状态 != L2特征值类型登记状态::已读取
                || !读回.登记 || !读回.成功())
                return 读回.状态 == L2特征值类型登记状态::已读取
                    ? L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致) : 读回;
            if (值类型登记定位_ && *值类型登记定位_ != 新定位)
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            值类型登记定位_ = 新定位;
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；定位在锁内复制，四节点在锁外一致读取。
    L2特征值类型登记结果 读取当前特征值类型登记() const {
        try {
            std::optional<L2特征值类型登记> 定位;
            {
                std::lock_guard<std::mutex> 锁(值类型登记锁_);
                定位 = 值类型登记定位_;
            }
            if (!定位) return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::登记未加载);
            return 按定位读取当前特征值类型登记(*定位, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；所有异常、拒绝和读回矛盾均映射为结构化状态。
    L2特征定义写入结果 新增特征定义(const L2特征定义新增请求& 请求) {
        if (!L2特征定义新增请求有效(请求)) return {};
        try {
            const auto 幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{L2特征结构内部::特征定义节点本地键值},
                节点种类::普通, std::nullopt}};

            const auto 写入 = 第一层服务_.提交中性写集(写集);
            const auto 状态 = L2特征结构内部::映射特征定义写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                return {{L2结构合同版本, 状态, 写入.事实代次,
                    std::nullopt}, std::nullopt};
            }

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            const auto 编码 = L2特征结构内部::查找唯一特征定义编码映射(写入);
            if (写入.合同版本 != L1中性CRUD合同版本
                || 写入.幂等键 != 幂等键 || 写入.事实代次 == 0
                || (!首次成功完整 && !重复成功完整) || !编码) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }

            const auto 读回 = 第一层服务_.读取中性历史事实(
                {L1中性CRUD合同版本, *编码});
            const auto* 节点 = 读回.事实
                ? std::get_if<L1中性节点事实>(&*读回.事实) : nullptr;
            auto 特征定义 = 节点 ? L2特征结构内部::形成创建特征定义事实(
                *节点, 写入.事实代次) : std::nullopt;
            if (读回.状态 != L1中性读取状态::成功
                || 读回.合同版本 != L1中性CRUD合同版本
                || 读回.查询编码 != *编码 || 读回.读取事实代次 < 写入.事实代次
                || !节点 || 节点->编码 != *编码
                || 节点->创建事实代次 != 写入.事实代次 || !特征定义) {
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    写入.事实代次, std::nullopt}, std::nullopt};
            }
            return {{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(特征定义)};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (const std::length_error&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, std::nullopt};
        }
    }

    // 诊断责任：向上送出；初始属性由一份写集建值、设槽并按首次代次读回。
    L2特征定义固定属性写入结果 新增特征定义固定属性(
        const L2特征定义固定属性新增请求& 请求) {
        if (!L2特征定义固定属性新增请求有效(请求)) return {};
        try {
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征定义固定属性值本地键值},
                L1中性事实引用{请求.特征定义.值},
                L1中性事实引用{请求.新属性.属性类型身份},
                L2特征结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1中性事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1中性事实引用{请求.特征定义.值},
                L1中性事实引用{请求.新属性.属性类型身份},
                {L2特征结构内部::特征定义固定属性值本地键值}}};
            const auto 代次 = L2特征结构内部::检查特征定义当前代次(
                第一层服务_, 请求.特征定义.值, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2特征结构内部::检查特征定义固定属性前置(
                    第一层服务_, 请求.特征定义, 请求.新属性.属性类型身份,
                    std::nullopt, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2特征结构内部::形成特征定义固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2特征结构内部::提交并读回特征定义固定属性写集(
                第一层服务_, 写集, 请求.特征定义, 请求.新属性, std::nullopt);
            return 结果.成功() && !结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2特征结构内部::形成特征定义固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；换代在一份写集中建立新值、切槽并退出具名旧值。
    L2特征定义固定属性写入结果 换代特征定义固定属性(
        const L2特征定义固定属性换代请求& 请求) {
        if (!L2特征定义固定属性换代请求有效(请求)) return {};
        try {
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征定义固定属性值本地键值},
                L1中性事实引用{请求.特征定义.值},
                L1中性事实引用{请求.新属性.属性类型身份},
                L2特征结构内部::转换为L1材料(请求.新属性.原始值材料),
                L1中性事实引用{请求.新属性.来源稳定编码}}};
            写集.属性槽变更 = {{L1中性事实引用{请求.特征定义.值},
                L1中性事实引用{请求.新属性.属性类型身份},
                {L2特征结构内部::特征定义固定属性值本地键值}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 = L2特征结构内部::检查特征定义当前代次(
                第一层服务_, 请求.特征定义.值, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2特征结构内部::形成特征定义固定属性写入失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 前置 = L2特征结构内部::检查特征定义固定属性前置(
                    第一层服务_, 请求.特征定义, 请求.新属性.属性类型身份,
                    请求.旧值稳定编码, 代次.事实截止代次);
                if (!前置.成功() && !前置.直接提交)
                    return L2特征结构内部::形成特征定义固定属性写入失败(
                        前置.状态, 前置.事实截止代次);
            }
            auto 结果 = L2特征结构内部::提交并读回特征定义固定属性写集(
                第一层服务_, 写集, 请求.特征定义, 请求.新属性,
                请求.旧值稳定编码);
            return 结果.成功() && 结果.已退出属性
                ? 结果 : (结果.结果头.状态 == L2结构状态::已提交
                    || 结果.结果头.状态 == L2结构状态::精确重复)
                    ? L2特征结构内部::形成特征定义固定属性写入失败(
                        L2结构状态::内部不一致, 结果.结果头.事实截止代次)
                    : 结果;
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征定义固定属性写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史完整读取失败均不携带部分特征定义。
    L2特征定义完整读取结果 读取完整特征定义(
        const L2特征定义完整读取请求& 请求) const {
        if (!L2特征定义完整读取请求有效(请求)) return {};
        try {
            return 请求.读取类别 == L2读取类别::当前
                ? L2特征结构内部::读取当前完整特征定义(第一层服务_, 请求)
                : L2特征结构内部::读取历史完整特征定义(第一层服务_, 请求);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成完整特征定义读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成完整特征定义读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成完整特征定义读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；一个实例节点与两条具名端点关系由同一写集原子建立。
    L2特征实例写入结果 新增特征实例(const L2特征实例新增请求& 请求) {
        if (!L2特征实例新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征关系类型登记();
            if (登记结果.状态 != L2特征关系类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征实例写入失败(
                    L2特征结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;

            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.节点 = {{{L2特征结构内部::特征实例节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2特征结构内部::特征实例宿主关系本地键值},
                    L1中性写集本地键{L2特征结构内部::特征实例节点本地键值},
                    请求.宿主存在.值, 登记.宿主关系类型.值,
                    L2特征结构内部::特征实例端点角色值},
                {{L2特征结构内部::特征实例定义关系本地键值},
                    L1中性写集本地键{L2特征结构内部::特征实例节点本地键值},
                    请求.特征定义.值, 登记.定义关系类型.值,
                    L2特征结构内部::特征实例端点角色值}};

            const auto 代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成特征实例写入失败(
                    代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 宿主 = 存在服务_.读取完整存在({请求.请求头,
                    L2读取类别::当前, 请求.宿主存在, 0});
                if (宿主.结果头.状态 != L2结构状态::已读取 || !宿主.存在)
                    return L2特征结构内部::形成特征实例写入失败(
                        宿主.结果头.状态, 宿主.结果头.事实截止代次);
                if (宿主.结果头.事实截止代次 != 请求.请求头.期望事实代次
                    || 宿主.存在->身份 != 请求.宿主存在
                    || 宿主.存在->生命周期.退出事实代次)
                    return L2特征结构内部::形成特征实例写入失败(
                        L2结构状态::内部不一致, 宿主.结果头.事实截止代次);
                const auto 定义 = 读取完整特征定义({请求.请求头,
                    L2读取类别::当前, 请求.特征定义, 0});
                if (定义.结果头.状态 != L2结构状态::已读取 || !定义.特征定义)
                    return L2特征结构内部::形成特征实例写入失败(
                        定义.结果头.状态, 定义.结果头.事实截止代次);
                if (定义.结果头.事实截止代次 != 请求.请求头.期望事实代次
                    || 定义.特征定义->身份 != 请求.特征定义
                    || 定义.特征定义->生命周期.退出事实代次)
                    return L2特征结构内部::形成特征实例写入失败(
                        L2结构状态::内部不一致, 定义.结果头.事实截止代次);
            }

            const auto 写入 = 第一层服务_.提交中性写集(写集);
            if (写入.合同版本 != L1中性CRUD合同版本
                || 写入.幂等键 != 写集.幂等键)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2特征结构内部::映射特征定义写入状态(写入.状态);
            if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2特征结构内部::形成特征实例写入失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2特征结构内部::形成特征实例写入失败(
                    状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            稳定编码 实例编码, 宿主关系编码, 定义关系编码;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
                || !L2特征结构内部::特征实例编码映射完整(
                    写入, 实例编码, 宿主关系编码, 定义关系编码))
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);

            const auto 节点读取 = 第一层服务_.读取中性历史事实(
                {L1中性CRUD合同版本, 实例编码});
            const auto 宿主关系读取 = 第一层服务_.读取中性历史事实(
                {L1中性CRUD合同版本, 宿主关系编码});
            const auto 定义关系读取 = 第一层服务_.读取中性历史事实(
                {L1中性CRUD合同版本, 定义关系编码});
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
            const auto* 宿主关系 = 宿主关系读取.事实
                ? std::get_if<L1中性关系事实>(&*宿主关系读取.事实) : nullptr;
            const auto* 定义关系 = 定义关系读取.事实
                ? std::get_if<L1中性关系事实>(&*定义关系读取.事实) : nullptr;
            if (节点读取.状态 != L1中性读取状态::成功
                || 宿主关系读取.状态 != L1中性读取状态::成功
                || 定义关系读取.状态 != L1中性读取状态::成功
                || 节点读取.合同版本 != L1中性CRUD合同版本
                || 宿主关系读取.合同版本 != L1中性CRUD合同版本
                || 定义关系读取.合同版本 != L1中性CRUD合同版本
                || 节点读取.查询编码 != 实例编码
                || 宿主关系读取.查询编码 != 宿主关系编码
                || 定义关系读取.查询编码 != 定义关系编码
                || 节点读取.读取事实代次 < 写入.事实代次
                || 宿主关系读取.读取事实代次 < 写入.事实代次
                || 定义关系读取.读取事实代次 < 写入.事实代次
                || !节点 || !宿主关系 || !定义关系)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            auto 实例 = L2特征结构内部::形成F2特征实例事实(
                *节点, *宿主关系, *定义关系, 登记, 写入.事实代次);
            if (!实例 || !节点->当前属性.empty() || 实例->身份.值 != 实例编码
                || 实例->宿主存在 != 请求.宿主存在
                || 实例->特征定义 != 请求.特征定义
                || 实例->生命周期.创建事实代次 != 写入.事实代次)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);

            const auto 当前代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.合同版本 != L1中性CRUD合同版本
                || 当前代次.事实代次 < 写入.事实代次)
                return L2特征结构内部::形成特征实例写入失败(
                    当前代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(当前代次.状态)
                        : L2结构状态::内部不一致, 当前代次.事实代次);
            const L2结构请求头 历史头{L2结构合同版本, 当前代次.事实代次};
            const auto 宿主历史 = 存在服务_.读取完整存在({历史头,
                L2读取类别::历史, 请求.宿主存在, 写入.事实代次});
            const auto 定义历史 = 读取完整特征定义({历史头,
                L2读取类别::历史, 请求.特征定义, 写入.事实代次});
            if (宿主历史.结果头.状态 != L2结构状态::已读取
                || 定义历史.结果头.状态 != L2结构状态::已读取
                || !宿主历史.存在 || !定义历史.特征定义)
                return L2特征结构内部::形成特征实例写入失败(
                    宿主历史.结果头.状态 != L2结构状态::已读取
                        ? 宿主历史.结果头.状态 : 定义历史.结果头.状态,
                    宿主历史.结果头.状态 != L2结构状态::已读取
                        ? 宿主历史.结果头.事实截止代次
                        : 定义历史.结果头.事实截止代次);
            if (宿主历史.存在->身份 != 请求.宿主存在
                || 定义历史.特征定义->身份 != 请求.特征定义)
                return L2特征结构内部::形成特征实例写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return {{L2结构合同版本, 状态, 写入.事实代次,
                写入.事实代次}, std::move(实例)};
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征实例写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征实例写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征实例写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前或历史失败均返回空实例载荷。
    L2特征实例完整读取结果 读取完整特征实例(
        const L2特征实例完整读取请求& 请求) const {
        if (!L2特征实例完整读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征关系类型登记();
            if (登记结果.状态 != L2特征关系类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 值登记结果 = 读取当前特征值类型登记();
            if (值登记结果.状态 != L2特征值类型登记状态::已读取
                || !值登记结果.登记 || !值登记结果.成功())
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射值类型登记失败为结构状态(
                        值登记结果.状态), 值登记结果.事实截止代次);
            const auto& 值登记 = *值登记结果.登记;
            if (请求.读取类别 == L2读取类别::当前) {
                L1中性一致当前读取请求 首次请求;
                首次请求.合同版本 = L1中性一致当前读取合同版本;
                首次请求.期望事实代次 = 请求.请求头.期望事实代次;
                首次请求.节点 = {请求.特征实例.值};
                const auto 首次读取 =
                    第一层服务_.尝试读取中性一致当前投影(首次请求);
                const auto 首次顶层 = L2特征结构内部::解释特征定义一致读取顶层(
                    首次读取, 请求.请求头.期望事实代次);
                if (!首次顶层.成功())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, 首次顶层.状态, 首次顶层.事实截止代次);
                if (首次读取.节点.size() != 1 || !首次读取.关系.empty()
                    || !首次读取.值.empty() || !首次读取.属性值.empty()
                    || !首次读取.源关系组.empty() || !首次读取.目标关系组.empty())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                const auto& 首次节点项 = 首次读取.节点.front();
                if (首次节点项.查询编码 != 请求.特征实例.值) return
                    L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                if (首次节点项.状态 != L1中性一致当前读取项目状态::成功) {
                    if (首次节点项.事实) return
                        L2特征结构内部::形成完整特征实例读取失败(
                            请求, L2结构状态::内部不一致,
                            首次顶层.事实截止代次);
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2特征结构内部::映射特征定义当前项目状态(
                            首次节点项.状态), 首次顶层.事实截止代次);
                }
                if (!首次节点项.事实 || 首次节点项.事实->退出事实代次
                    || 首次节点项.事实->当前属性.size() > 1)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                const auto 是登记值类型 = [&](稳定编码 类型) noexcept {
                    return 类型 == 值登记.I64值类型.值
                        || 类型 == 值登记.I64组值类型.值
                        || 类型 == 值登记.U64组值类型.值
                        || 类型 == 值登记.独立材料值类型.值;
                };
                if (!首次节点项.事实->当前属性.empty()
                    && !是登记值类型(
                        首次节点项.事实->当前属性.front().属性类型节点))
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 首次顶层.事实截止代次);
                L1中性一致当前读取请求 完整请求;
                完整请求.合同版本 = L1中性一致当前读取合同版本;
                完整请求.期望事实代次 = 请求.请求头.期望事实代次;
                完整请求.节点 = {请求.特征实例.值};
                完整请求.源关系组 = {
                    {请求.特征实例.值, 登记.宿主关系类型.值},
                    {请求.特征实例.值, 登记.定义关系类型.值}};
                if (!首次节点项.事实->当前属性.empty())
                    完整请求.属性值 = {{请求.特征实例.值,
                        首次节点项.事实->当前属性.front().属性类型节点}};
                const auto 读取 = 第一层服务_.尝试读取中性一致当前投影(完整请求);
                const auto 顶层 = L2特征结构内部::解释特征定义一致读取顶层(
                    读取, 请求.请求头.期望事实代次);
                if (!顶层.成功()) return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 顶层.状态, 顶层.事实截止代次);
                if (读取.节点.size() != 1 || !读取.关系.empty()
                    || !读取.值.empty()
                    || 读取.属性值.size() != 完整请求.属性值.size()
                    || 读取.源关系组.size() != 2 || !读取.目标关系组.empty())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto& 节点项 = 读取.节点.front();
                if (节点项.查询编码 != 请求.特征实例.值
                    || 节点项.状态 != L1中性一致当前读取项目状态::成功
                    || !节点项.事实 || 节点项.事实->退出事实代次
                    || *节点项.事实 != *首次节点项.事实)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto 查找组 = [&](稳定编码 类型)
                    -> const L1中性一致源关系组读取结果项* {
                    const L1中性一致源关系组读取结果项* 找到 = nullptr;
                    for (const auto& 组 : 读取.源关系组) {
                        if (组.源节点 != 请求.特征实例.值
                            || 组.关系类型节点 != 类型) continue;
                        if (找到) return nullptr;
                        找到 = &组;
                    }
                    return 找到;
                };
                const auto* 宿主组 = 查找组(登记.宿主关系类型.值);
                const auto* 定义组 = 查找组(登记.定义关系类型.值);
                if (!宿主组 || !定义组 || 宿主组 == 定义组
                    || 宿主组->成员.size() != 1 || 定义组->成员.size() != 1)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto& 宿主投影 = 宿主组->成员.front();
                const auto& 定义投影 = 定义组->成员.front();
                auto 实例 = L2特征结构内部::形成F2特征实例事实(
                    *节点项.事实, 宿主投影.关系, 定义投影.关系,
                    登记, 顶层.事实截止代次);
                if (!实例 || 宿主投影.对端节点.编码 != 实例->宿主存在.值
                    || 定义投影.对端节点.编码 != 实例->特征定义.值
                    || 宿主投影.对端节点.退出事实代次
                    || 定义投影.对端节点.退出事实代次)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                if (!节点项.事实->当前属性.empty()) {
                    const auto& 槽 = 节点项.事实->当前属性.front();
                    const auto& 值项 = 读取.属性值.front();
                    if (值项.节点 != 请求.特征实例.值
                        || 值项.属性类型 != 槽.属性类型节点
                        || 值项.状态 != L1中性一致当前读取项目状态::成功
                        || !值项.投影 || 值项.投影->属性槽 != 槽
                        || 值项.投影->当前值事实.编码 != 槽.当前值
                        || 值项.投影->当前值事实.所属节点 != 请求.特征实例.值
                        || 值项.投影->当前值事实.属性类型节点
                            != 槽.属性类型节点
                        || 值项.投影->当前值事实.退出事实代次)
                        return L2特征结构内部::形成完整特征实例读取失败(
                            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                    实例->当前值 = L2特征结构内部::形成截止特征值事实(
                        值项.投影->当前值事实, 值登记, 顶层.事实截止代次);
                    if (!实例->当前值 || 实例->当前值->特征实例 != 实例->身份)
                        return L2特征结构内部::形成完整特征实例读取失败(
                            请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                }
                if (!L2特征实例事实完整(*实例, 顶层.事实截止代次))
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                const auto 宿主 = 存在服务_.读取完整存在({请求.请求头,
                    L2读取类别::当前, 实例->宿主存在, 0});
                const auto 定义 = 读取完整特征定义({请求.请求头,
                    L2读取类别::当前, 实例->特征定义, 0});
                if (宿主.结果头.状态 != L2结构状态::已读取
                    || 定义.结果头.状态 != L2结构状态::已读取
                    || !宿主.存在 || !定义.特征定义)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, 宿主.结果头.状态 != L2结构状态::已读取
                            ? 宿主.结果头.状态 : 定义.结果头.状态,
                        宿主.结果头.状态 != L2结构状态::已读取
                            ? 宿主.结果头.事实截止代次
                            : 定义.结果头.事实截止代次);
                if (宿主.存在->身份 != 实例->宿主存在
                    || 定义.特征定义->身份 != 实例->特征定义
                    || 宿主.结果头.事实截止代次 != 顶层.事实截止代次
                    || 定义.结果头.事实截止代次 != 顶层.事实截止代次)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 顶层.事实截止代次);
                return {{L2结构合同版本, L2结构状态::已读取,
                    顶层.事实截止代次, std::nullopt}, 请求.读取类别, 0,
                    std::move(实例), L2特征实例自有关系引用{
                        宿主投影.关系.编码, 定义投影.关系.编码}};
            }

            const auto 前代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (前代次.状态 != L1中性读取状态::成功
                || 前代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 前代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(前代次.状态)
                        : L2结构状态::内部不一致);
            if (前代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::事实代次漂移, 前代次.事实代次);
            const auto 节点读取 = 第一层服务_.读取中性历史事实(
                {L1中性CRUD合同版本, 请求.特征实例.值});
            const auto 宿主组 = 第一层服务_.读取中性历史关系组(
                {L1中性CRUD合同版本, L1中性关系端点方向::源,
                    请求.特征实例.值, 登记.宿主关系类型.值,
                    请求.历史截止事实代次});
            const auto 定义组 = 第一层服务_.读取中性历史关系组(
                {L1中性CRUD合同版本, L1中性关系端点方向::源,
                    请求.特征实例.值, 登记.定义关系类型.值,
                    请求.历史截止事实代次});
            const auto 属性组 = 第一层服务_.读取中性历史属性值组(
                {L1中性CRUD合同版本, 请求.特征实例.值,
                    请求.历史截止事实代次});
            if (节点读取.合同版本 != L1中性CRUD合同版本
                || 节点读取.查询编码 != 请求.特征实例.值)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (节点读取.状态 != L1中性读取状态::成功) {
                const auto 状态 = 节点读取.状态 == L1中性读取状态::未找到
                    ? L2结构状态::未找到
                    : L2特征结构内部::映射特征定义历史读取状态(节点读取.状态);
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 状态, 请求.历史截止事实代次);
            }
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
            if (!节点 || 节点->创建事实代次 > 请求.历史截止事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 节点 && 节点->创建事实代次 > 请求.历史截止事实代次
                        ? L2结构状态::未找到 : L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            if (节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::已退出, 请求.历史截止事实代次);
            const auto 组完整 = [&](const L1中性历史关系组读取结果& 组,
                L1中性关系端点方向 方向, 稳定编码 类型) noexcept {
                return 组.状态 == L1中性历史关系组读取状态::成功
                    && 组.合同版本 == L1中性CRUD合同版本 && 组.方向 == 方向
                    && 组.端点节点 == 请求.特征实例.值
                    && 组.关系类型节点 == 类型
                    && 组.历史截止事实代次 == 请求.历史截止事实代次
                    && 组.读取事实代次 == 请求.请求头.期望事实代次;
            };
            if (宿主组.状态 != L1中性历史关系组读取状态::成功
                || 定义组.状态 != L1中性历史关系组读取状态::成功) {
                const auto& 失败组 = 宿主组.状态
                    != L1中性历史关系组读取状态::成功 ? 宿主组 : 定义组;
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射特征历史关系组失败状态(
                        失败组.状态), 失败组.读取事实代次);
            }
            if (!组完整(宿主组, L1中性关系端点方向::源,
                    登记.宿主关系类型.值)
                || !组完整(定义组, L1中性关系端点方向::源,
                    登记.定义关系类型.值)
                || 宿主组.关系组.size() != 1 || 定义组.关系组.size() != 1)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (属性组.合同版本 != L1中性CRUD合同版本
                || 属性组.所属节点 != 请求.特征实例.值
                || 属性组.历史截止事实代次 != 请求.历史截止事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 属性组.读取事实代次);
            if (属性组.状态 != L1中性历史属性值组读取状态::成功) {
                if (!属性组.属性值组.empty())
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致, 属性组.读取事实代次);
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2特征结构内部::映射特征定义历史属性值组失败状态(
                        属性组.状态), 属性组.读取事实代次);
            }
            if (属性组.读取事实代次 != 请求.请求头.期望事实代次
                || 属性组.属性值组.size() > 1)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 属性组.读取事实代次 != 请求.请求头.期望事实代次
                        ? L2结构状态::事实代次漂移
                        : L2结构状态::内部不一致,
                    属性组.读取事实代次);
            auto 实例 = L2特征结构内部::形成F2特征实例事实(
                *节点, 宿主组.关系组.front(), 定义组.关系组.front(),
                登记, 请求.历史截止事实代次);
            if (!实例) return L2特征结构内部::形成完整特征实例读取失败(
                请求, 节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次
                    ? L2结构状态::已退出 : L2结构状态::内部不一致,
                请求.历史截止事实代次);
            if (!属性组.属性值组.empty()) {
                const auto& 原值 = 属性组.属性值组.front();
                if (原值.所属节点 != 请求.特征实例.值
                    || !L2特征结构内部::特征值类型与材料一致(
                        值登记, 原值.属性类型节点, 原值.材料))
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致,
                        请求.历史截止事实代次);
                实例->当前值 = L2特征结构内部::形成截止特征值事实(
                    原值, 值登记, 请求.历史截止事实代次);
                if (!实例->当前值 || 实例->当前值->特征实例 != 实例->身份
                    || 实例->当前值->生命周期.退出事实代次)
                    return L2特征结构内部::形成完整特征实例读取失败(
                        请求, L2结构状态::内部不一致,
                        请求.历史截止事实代次);
            }
            if (!L2特征实例事实完整(*实例, 请求.历史截止事实代次))
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致,
                    请求.历史截止事实代次);
            const auto 宿主 = 存在服务_.读取完整存在({请求.请求头,
                L2读取类别::历史, 实例->宿主存在, 请求.历史截止事实代次});
            const auto 定义 = 读取完整特征定义({请求.请求头,
                L2读取类别::历史, 实例->特征定义, 请求.历史截止事实代次});
            if (宿主.结果头.状态 != L2结构状态::已读取
                || 定义.结果头.状态 != L2结构状态::已读取
                || !宿主.存在 || !定义.特征定义)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 宿主.结果头.状态 != L2结构状态::已读取
                        ? 宿主.结果头.状态 : 定义.结果头.状态,
                    请求.历史截止事实代次);
            if (宿主.存在->身份 != 实例->宿主存在
                || 定义.特征定义->身份 != 实例->特征定义)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            const auto 后代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (后代次.状态 != L1中性读取状态::成功
                || 后代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, 后代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(后代次.状态)
                        : L2结构状态::内部不一致);
            if (后代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成完整特征实例读取失败(
                    请求, L2结构状态::事实代次漂移, 后代次.事实代次);
            return {{L2结构合同版本, L2结构状态::已读取,
                请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(实例),
                L2特征实例自有关系引用{宿主组.关系组.front().编码,
                    定义组.关系组.front().编码}};
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成完整特征实例读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成完整特征实例读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成完整特征实例读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；反向关系与逐项公开读取任一失败均清空整组。
    L2按存在当前特征读取结果 按存在读取全部当前特征(
        const L2按存在当前特征读取请求& 请求) const {
        if (!L2按存在当前特征读取请求有效(请求)) return {};
        try {
            const auto 存在 = 存在服务_.读取完整存在({请求.请求头,
                L2读取类别::当前, 请求.存在, 0});
            if (存在.结果头.状态 != L2结构状态::已读取 || !存在.存在)
                return L2特征结构内部::形成按存在特征读取失败(
                    存在.结果头.状态, 存在.结果头.事实截止代次);
            if (存在.存在->身份 != 请求.存在
                || 存在.结果头.事实截止代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 存在.结果头.事实截止代次);
            const auto 登记结果 = 读取当前特征关系类型登记();
            if (登记结果.状态 != L2特征关系类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成按存在特征读取失败(
                    L2特征结构内部::映射登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1中性一致当前读取请求 L1请求;
            L1请求.合同版本 = L1中性一致当前读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.节点 = {请求.存在.值};
            L1请求.目标关系组 = {{请求.存在.值, 登记.宿主关系类型.值}};
            const auto 读取 = 第一层服务_.尝试读取中性一致当前投影(L1请求);
            const auto 顶层 = L2特征结构内部::解释特征定义一致读取顶层(
                读取, 请求.请求头.期望事实代次);
            if (!顶层.成功()) return L2特征结构内部::形成按存在特征读取失败(
                顶层.状态, 顶层.事实截止代次);
            if (读取.节点.size() != 1 || !读取.关系.empty()
                || !读取.值.empty() || !读取.属性值.empty()
                || !读取.源关系组.empty() || 读取.目标关系组.size() != 1)
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            const auto& 节点项 = 读取.节点.front();
            const auto& 关系组 = 读取.目标关系组.front();
            if (节点项.查询编码 != 请求.存在.值
                || 节点项.状态 != L1中性一致当前读取项目状态::成功
                || !节点项.事实 || 节点项.事实->退出事实代次
                || 关系组.目标节点 != 请求.存在.值
                || 关系组.关系类型节点 != 登记.宿主关系类型.值)
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            std::vector<稳定编码> 实例编码组;
            for (const auto& 投影 : 关系组.成员) {
                if (投影.关系.目标节点 != 请求.存在.值
                    || 投影.关系.关系类型节点 != 登记.宿主关系类型.值
                    || 投影.关系.角色或顺序
                        != L2特征结构内部::特征实例端点角色值
                    || 投影.关系.退出事实代次 || !有效(投影.关系.源节点)
                    || 投影.对端节点.编码 != 投影.关系.源节点
                    || 投影.对端节点.种类 != 节点种类::普通
                    || 投影.对端节点.属性类型表示
                    || 投影.对端节点.退出事实代次)
                    return L2特征结构内部::形成按存在特征读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                实例编码组.push_back(投影.关系.源节点);
            }
            std::sort(实例编码组.begin(), 实例编码组.end());
            if (std::adjacent_find(实例编码组.begin(), 实例编码组.end())
                != 实例编码组.end())
                return L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
            L2按存在当前特征读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 顶层.事实截止代次, std::nullopt}, {}};
            for (const auto 编码 : 实例编码组) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, L2特征实例身份{编码}, 0});
                if (实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例)
                    return L2特征结构内部::形成按存在特征读取失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 顶层.事实截止代次
                    || 实例.特征实例->宿主存在 != 请求.存在)
                    return L2特征结构内部::形成按存在特征读取失败(
                        L2结构状态::内部不一致, 顶层.事实截止代次);
                结果.特征实例组.push_back(*实例.特征实例);
            }
            return 结果.成功() ? 结果
                : L2特征结构内部::形成按存在特征读取失败(
                    L2结构状态::内部不一致, 顶层.事实截止代次);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成按存在特征读取失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成按存在特征读取失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成按存在特征读取失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；空值实例以一份写集建立值并设置对应登记槽。
    L2特征当前值写入结果 新增特征当前值(
        const L2特征当前值新增请求& 请求) {
        if (!L2特征当前值新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征值类型登记();
            if (登记结果.状态 != L2特征值类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征当前值写入失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 类型编码 = L2特征结构内部::选择特征值类型编码(
                登记, 请求.新值材料);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征当前值本地键值},
                请求.特征实例.值, 类型编码,
                L2特征结构内部::转换为L1材料(请求.新值材料),
                请求.来源稳定编码}};
            写集.属性槽变更 = {{请求.特征实例.值, 类型编码,
                {L2特征结构内部::特征当前值本地键值}}};
            const auto 代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成特征当前值写入失败(
                    代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致, 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征当前值写入失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 代次.事实代次
                    || 实例.特征实例->身份 != 请求.特征实例)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::内部不一致, 代次.事实代次);
                if (实例.特征实例->当前值)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::引用冲突, 代次.事实代次);
            }
            return L2特征结构内部::提交并读回特征当前值写集(
                第一层服务_, 写集, 登记, 请求.特征实例,
                请求.新值材料, 请求.来源稳定编码, std::nullopt);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；新值、跨表示切槽和具名旧值退出同写集提交。
    L2特征当前值写入结果 换代特征当前值(
        const L2特征当前值换代请求& 请求) {
        if (!L2特征当前值换代请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征值类型登记();
            if (登记结果.状态 != L2特征值类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征当前值写入失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 类型编码 = L2特征结构内部::选择特征值类型编码(
                登记, 请求.新值材料);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.值 = {{{L2特征结构内部::特征当前值本地键值},
                请求.特征实例.值, 类型编码,
                L2特征结构内部::转换为L1材料(请求.新值材料),
                请求.来源稳定编码}};
            写集.属性槽变更 = {{请求.特征实例.值, 类型编码,
                {L2特征结构内部::特征当前值本地键值}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成特征当前值写入失败(
                    代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致, 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征当前值写入失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                if (实例.结果头.事实截止代次 != 代次.事实代次
                    || 实例.特征实例->身份 != 请求.特征实例)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::内部不一致, 代次.事实代次);
                if (!实例.特征实例->当前值)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::属性未设置, 代次.事实代次);
                if (实例.特征实例->当前值->值稳定编码 != 请求.旧值稳定编码)
                    return L2特征结构内部::形成特征当前值写入失败(
                        L2结构状态::引用冲突, 代次.事实代次);
            }
            return L2特征结构内部::提交并读回特征当前值写集(
                第一层服务_, 写集, 登记, 请求.特征实例,
                请求.新值材料, 请求.来源稳定编码, 请求.旧值稳定编码);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征当前值写入失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；具名值按前后代次夹取并保留完整生命周期。
    L2特征值历史读取结果 读取特征历史值(
        const L2特征值历史读取请求& 请求) const {
        if (!L2特征值历史读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前特征值类型登记();
            if (登记结果.状态 != L2特征值类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2特征结构内部::形成特征值历史读取失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        登记结果.状态), 登记结果.事实截止代次);
            const auto 读取代次 = [&]() {
                return 第一层服务_.读取中性当前事实代次(
                    {L1中性CRUD合同版本});
            };
            const auto 前代次 = 读取代次();
            if (前代次.状态 != L1中性读取状态::成功
                || 前代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成特征值历史读取失败(
                    前代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(前代次.状态)
                        : L2结构状态::内部不一致, 前代次.事实代次);
            if (前代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::事实代次漂移, 前代次.事实代次);
            const auto 读取 = 第一层服务_.读取中性历史事实(
                {L1中性CRUD合同版本, 请求.值稳定编码});
            if (读取.合同版本 != L1中性CRUD合同版本
                || 读取.查询编码 != 请求.值稳定编码)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
            if (读取.状态 != L1中性读取状态::成功) {
                if (读取.事实) return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
                const auto 状态 = 读取.状态 == L1中性读取状态::未找到
                    ? L2结构状态::未找到
                    : L2特征结构内部::映射特征定义历史读取状态(读取.状态);
                return L2特征结构内部::形成特征值历史读取失败(
                    状态, 前代次.事实代次);
            }
            const auto* 值 = 读取.事实
                ? std::get_if<L1中性值事实>(&*读取.事实) : nullptr;
            if (!值 || 值->编码 != 请求.值稳定编码
                || 值->所属节点 != 请求.特征实例.值)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
            auto 特征值 = L2特征结构内部::形成截止特征值事实(
                *值, *登记结果.登记, 前代次.事实代次, true);
            if (!特征值)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::内部不一致, 前代次.事实代次);
            const auto 后代次 = 读取代次();
            if (后代次.状态 != L1中性读取状态::成功
                || 后代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成特征值历史读取失败(
                    后代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(后代次.状态)
                        : L2结构状态::内部不一致, 后代次.事实代次);
            if (后代次.事实代次 != 请求.请求头.期望事实代次)
                return L2特征结构内部::形成特征值历史读取失败(
                    L2结构状态::事实代次漂移, 后代次.事实代次);
            return {{L2结构合同版本, L2结构状态::已读取,
                后代次.事实代次, std::nullopt}, std::move(特征值)};
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征值历史读取失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征值历史读取失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征值历史读取失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；显式闭包核对后实例、两关系与可选值同代退出。
    L2特征实例退出结果 退出特征实例(
        const L2特征实例退出请求& 请求) {
        if (!L2特征实例退出请求有效(请求)) return {};
        try {
            const auto 关系登记结果 = 读取当前特征关系类型登记();
            if (关系登记结果.状态 != L2特征关系类型登记状态::已读取
                || !关系登记结果.登记 || !关系登记结果.成功())
                return L2特征结构内部::形成特征实例退出失败(
                    L2特征结构内部::映射登记失败为结构状态(
                        关系登记结果.状态), 关系登记结果.事实截止代次);
            const auto 值登记结果 = 读取当前特征值类型登记();
            if (值登记结果.状态 != L2特征值类型登记状态::已读取
                || !值登记结果.登记 || !值登记结果.成功())
                return L2特征结构内部::形成特征实例退出失败(
                    L2特征结构内部::映射值类型登记失败为结构状态(
                        值登记结果.状态), 值登记结果.事实截止代次);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.退出事实 = {请求.特征实例.值,
                请求.自有关系.宿主关系稳定编码,
                请求.自有关系.定义关系稳定编码};
            if (请求.当前值稳定编码)
                写集.退出事实.push_back(*请求.当前值稳定编码);
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            if (std::adjacent_find(写集.退出事实.begin(), 写集.退出事实.end())
                != 写集.退出事实.end())
                return L2特征结构内部::形成特征实例退出失败(
                    L2结构状态::入口拒绝);
            const auto 代次 = 第一层服务_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本)
                return L2特征结构内部::形成特征实例退出失败(
                    代次.合同版本 == L1中性CRUD合同版本
                        ? L2特征结构内部::映射特征事实代次探测失败(代次.状态)
                        : L2结构状态::内部不一致, 代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 实例 = 读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例 || !实例.自有关系)
                    return L2特征结构内部::形成特征实例退出失败(
                        实例.结果头.状态, 实例.结果头.事实截止代次);
                const auto 当前值 = 实例.特征实例->当前值
                    ? std::optional<稳定编码>{实例.特征实例->当前值->值稳定编码}
                    : std::nullopt;
                if (*实例.自有关系 != 请求.自有关系
                    || 当前值 != 请求.当前值稳定编码)
                    return L2特征结构内部::形成特征实例退出失败(
                        L2结构状态::引用冲突, 实例.结果头.事实截止代次);
            }
            return L2特征结构内部::提交并读回特征实例退出写集(
                第一层服务_, 写集, 请求, *关系登记结果.登记,
                *值登记结果.登记);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征实例退出失败(
                L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征实例退出失败(
                L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征实例退出失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；显式属性闭包核对后由一份写集退出特征定义及其属性值。
    L2特征定义退出结果 退出特征定义(const L2特征定义退出请求& 请求) {
        if (!L2特征定义退出请求有效(请求)) return {};
        try {
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = L2特征结构内部::映射特征定义幂等键(请求.幂等身份);
            写集.退出事实 = {请求.特征定义.值};
            写集.退出事实.insert(写集.退出事实.end(),
                请求.当前固定属性值.begin(), 请求.当前固定属性值.end());
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            const auto 代次 = L2特征结构内部::检查特征定义当前代次(
                第一层服务_, 请求.特征定义.值, 请求.请求头.期望事实代次);
            if (!代次.成功() && !代次.直接提交)
                return L2特征结构内部::形成特征定义退出失败(
                    代次.状态, 代次.事实截止代次);
            if (代次.成功()) {
                const auto 快照 = 读取完整特征定义({请求.请求头,
                    L2读取类别::当前, 请求.特征定义, 0});
                if (快照.结果头.状态 != L2结构状态::已读取 || !快照.特征定义) {
                    if (快照.结果头.状态 != L2结构状态::事实代次漂移)
                        return L2特征结构内部::形成特征定义退出失败(
                            快照.结果头.状态, 快照.结果头.事实截止代次);
                } else {
                    std::vector<稳定编码> 当前属性值;
                    for (const auto& 属性 : 快照.特征定义->固定属性)
                        当前属性值.push_back(属性.值稳定编码);
                    std::sort(当前属性值.begin(), 当前属性值.end());
                    if (当前属性值 != 请求.当前固定属性值)
                        return L2特征结构内部::形成特征定义退出失败(
                            L2结构状态::引用冲突, 快照.结果头.事实截止代次);
                }
            }
            return L2特征结构内部::提交并读回特征定义退出写集(
                第一层服务_, 写集, 请求);
        } catch (const std::bad_alloc&) {
            return L2特征结构内部::形成特征定义退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2特征结构内部::形成特征定义退出失败(L2结构状态::资源失败);
        } catch (...) {
            return L2特征结构内部::形成特征定义退出失败(L2结构状态::内部不一致);
        }
    }

private:
    // 诊断责任：向上送出；许可、漂移和属性类型表示矛盾均结构化返回。
    L2特征值类型登记结果 按定位读取当前特征值类型登记(
        const L2特征值类型登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2特征值类型登记完整(定位))
            return L2特征结构内部::形成特征值类型登记失败(
                L2特征值类型登记状态::内部不一致);
        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试序号 = 0; 尝试序号 < 最大尝试次数; ++尝试序号) {
            L1中性一致当前读取请求 请求;
            请求.合同版本 = L1中性一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.节点 = {定位.I64值类型.值, 定位.I64组值类型.值,
                定位.U64组值类型.值, 定位.独立材料值类型.值};
            const auto 读取 = 第一层服务_.尝试读取中性一致当前投影(请求);
            if (读取.状态 == L1中性一致当前读取状态::事实代次漂移) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致);
                if (尝试序号 == 0) {
                    本轮期望代次 = 读取.读取事实代次;
                    continue;
                }
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::事实代次漂移, 读取.读取事实代次);
            }
            if (读取.状态 != L1中性一致当前读取状态::成功) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征值类型登记失败(
                        L2特征值类型登记状态::内部不一致);
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征结构内部::映射特征值类型登记读取失败状态(
                        读取.状态));
            }
            if (读取.合同版本 != L1中性一致当前读取合同版本
                || 读取.期望事实代次 != 本轮期望代次
                || 读取.读取事实代次 != 本轮期望代次
                || 读取.读取事实代次 == 0 || 读取.节点.size() != 4
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty())
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            const auto 查找节点 = [&](稳定编码 编码)
                -> const L1中性一致节点读取结果项* {
                const L1中性一致节点读取结果项* 找到 = nullptr;
                for (const auto& 项 : 读取.节点) {
                    if (项.查询编码 != 编码) continue;
                    if (找到) return nullptr;
                    找到 = &项;
                }
                return 找到;
            };
            const auto 节点完整 = [&](稳定编码 编码,
                L1中性值表示种类 表示) noexcept {
                const auto* 项 = 查找节点(编码);
                return 项 && 项->状态 == L1中性一致当前读取项目状态::成功
                    && 项->事实 && 项->事实->编码 == 编码
                    && 项->事实->种类 == 节点种类::属性类型
                    && 项->事实->属性类型表示 == 表示
                    && 项->事实->创建事实代次 == 定位.建立事实代次
                    && !项->事实->退出事实代次 && 项->事实->当前属性.empty()
                    && (!期望创建代次
                        || 项->事实->创建事实代次 == *期望创建代次);
            };
            if (!节点完整(定位.I64值类型.值, L1中性值表示种类::I64)
                || !节点完整(定位.I64组值类型.值, L1中性值表示种类::I64组)
                || !节点完整(定位.U64组值类型.值, L1中性值表示种类::U64组)
                || !节点完整(定位.独立材料值类型.值,
                    L1中性值表示种类::独立材料引用))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            auto 当前登记 = 定位;
            当前登记.事实截止代次 = 读取.读取事实代次;
            if (!L2特征值类型登记完整(当前登记))
                return L2特征结构内部::形成特征值类型登记失败(
                    L2特征值类型登记状态::内部不一致);
            return {L2特征值类型登记状态::已读取,
                当前登记.事实截止代次, std::move(当前登记)};
        }
        return L2特征结构内部::形成特征值类型登记失败(
            L2特征值类型登记状态::内部不一致);
    }

    // 诊断责任：向上送出；许可、漂移、资源失败和登记节点矛盾均结构化返回。
    L2特征关系类型登记结果 按定位读取当前特征关系类型登记(
        const L2特征关系类型登记& 定位,
        std::optional<std::uint64_t> 期望创建代次) const {
        if (!L2特征关系类型登记完整(定位))
            return L2特征结构内部::形成特征关系类型登记失败(
                L2特征关系类型登记状态::内部不一致);
        std::uint64_t 本轮期望代次 = 定位.事实截止代次;
        constexpr std::size_t 最大尝试次数 = 2;
        for (std::size_t 尝试序号 = 0; 尝试序号 < 最大尝试次数; ++尝试序号) {
            L1中性一致当前读取请求 请求;
            请求.合同版本 = L1中性一致当前读取合同版本;
            请求.期望事实代次 = 本轮期望代次;
            请求.节点 = {定位.宿主关系类型.值, 定位.定义关系类型.值};
            const auto 读取 = 第一层服务_.尝试读取中性一致当前投影(请求);
            if (读取.状态 == L1中性一致当前读取状态::事实代次漂移) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致);
                if (尝试序号 == 0) {
                    本轮期望代次 = 读取.读取事实代次;
                    continue;
                }
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::事实代次漂移,
                    读取.读取事实代次);
            }
            if (读取.状态 != L1中性一致当前读取状态::成功) {
                if (!L2特征结构内部::特征关系类型一致读取失败形状完整(
                        读取, 本轮期望代次))
                    return L2特征结构内部::形成特征关系类型登记失败(
                        L2特征关系类型登记状态::内部不一致);
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征结构内部::映射特征关系类型登记读取失败状态(
                        读取.状态));
            }
            if (读取.合同版本 != L1中性一致当前读取合同版本
                || 读取.期望事实代次 != 本轮期望代次
                || 读取.读取事实代次 != 本轮期望代次
                || 读取.读取事实代次 == 0 || 读取.节点.size() != 2
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty())
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 查找节点 = [&](稳定编码 编码)
                -> const L1中性一致节点读取结果项* {
                const L1中性一致节点读取结果项* 找到 = nullptr;
                for (const auto& 项 : 读取.节点) {
                    if (项.查询编码 != 编码) continue;
                    if (找到) return nullptr;
                    找到 = &项;
                }
                return 找到;
            };
            const auto* 宿主项 = 查找节点(定位.宿主关系类型.值);
            const auto* 定义项 = 查找节点(定位.定义关系类型.值);
            if (!宿主项 || !定义项 || 宿主项 == 定义项
                || 宿主项->状态 != L1中性一致当前读取项目状态::成功
                || 定义项->状态 != L1中性一致当前读取项目状态::成功
                || !宿主项->事实 || !定义项->事实)
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            const auto 节点完整 = [&](const L1中性节点事实& 节点,
                稳定编码 编码) noexcept {
                return 节点.编码 == 编码 && 节点.种类 == 节点种类::普通
                    && !节点.属性类型表示
                    && 节点.创建事实代次 == 定位.建立事实代次
                    && !节点.退出事实代次 && 节点.当前属性.empty()
                    && (!期望创建代次
                        || 节点.创建事实代次 == *期望创建代次);
            };
            if (!节点完整(*宿主项->事实, 定位.宿主关系类型.值)
                || !节点完整(*定义项->事实, 定位.定义关系类型.值))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            auto 当前登记 = 定位;
            当前登记.事实截止代次 = 读取.读取事实代次;
            if (!L2特征关系类型登记完整(当前登记))
                return L2特征结构内部::形成特征关系类型登记失败(
                    L2特征关系类型登记状态::内部不一致);
            return {L2特征关系类型登记状态::已读取,
                当前登记.事实截止代次, std::move(当前登记)};
        }
        return L2特征结构内部::形成特征关系类型登记失败(
            L2特征关系类型登记状态::内部不一致);
    }

    L1事实基座服务& 第一层服务_;
    const L2存在结构服务& 存在服务_;
    mutable std::mutex 关系类型登记锁_;
    std::optional<L2特征关系类型登记> 关系类型登记定位_;
    mutable std::mutex 值类型登记锁_;
    std::optional<L2特征值类型登记> 值类型登记定位_;
};

} // namespace 海中鱼巣
