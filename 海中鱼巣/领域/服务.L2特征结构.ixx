struct 特征身份来源定位 final {
    L2节点族 节点族 = L2节点族::特征定义;
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

struct 特征定义派生结构定位 final {
    L1结构所有者身份 所有者;
    稳定编码 实际阶次属性类型;
    稳定编码 派生规则见证属性类型;
    稳定编码 直接来源关系类型;
    std::uint64_t 建立事实代次 = 0;
};

struct 特征事实代次读取结果 final {
    L1所有者范围读取状态 状态 = L1所有者范围读取状态::入口拒绝;
    std::uint32_t 合同版本 = L1所有者范围CRUD合同版本;
    std::uint64_t 事实代次 = 0;
};

// 诊断责任：向上送出；构造期以特征定义 owner 原子登记阶次、规则和来源三种私有类型。
特征定义派生结构定位 初始化特征定义派生结构(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口,
    std::uint64_t 期望事实代次) {
    if (期望事实代次 == 0 || !写入端口.有效())
        throw std::invalid_argument("L2 feature derivation registration precondition is invalid");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 期望事实代次;
    写集.写入幂等身份 = 特征定义派生结构登记固定幂等身份;
    写集.节点 = {
        {{实际阶次属性类型本地键值}, 节点种类::属性类型,
            L1所有者范围值表示种类::I64},
        {{派生规则见证属性类型本地键值}, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组},
        {{直接来源关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 写入端口.所有者身份()
        || 写入.写入幂等身份 != 写集.写入幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 3)
        throw std::runtime_error("L2 feature derivation registration write failed");
    const auto 查找 = [&](std::uint32_t 键值) -> std::optional<稳定编码> {
        std::optional<稳定编码> 找到;
        for (const auto& [键, 编码] : 写入.新编码映射) {
            if (键.值 != 键值) continue;
            if (找到 || !有效(编码)) return std::nullopt;
            找到 = 编码;
        }
        return 找到;
    };
    const auto 阶次类型 = 查找(实际阶次属性类型本地键值);
    const auto 规则类型 = 查找(派生规则见证属性类型本地键值);
    const auto 来源类型 = 查找(直接来源关系类型本地键值);
    if (!阶次类型 || !规则类型 || !来源类型
        || *阶次类型 == *规则类型 || *阶次类型 == *来源类型
        || *规则类型 == *来源类型)
        throw std::runtime_error("L2 feature derivation registration mapping failed");
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 写入.事实代次;
    请求.节点 = {*阶次类型, *规则类型, *来源类型};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    if (读取.状态 != L1所有者范围一致当前读取状态::成功
        || 读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 写入.事实代次
        || 读取.读取事实代次 != 写入.事实代次 || 读取.节点.size() != 3
        || !读取.所有者.empty() || !读取.关系.empty() || !读取.值.empty()
        || !读取.属性值.empty() || !读取.源关系组.empty()
        || !读取.目标关系组.empty())
        throw std::runtime_error("L2 feature derivation registration readback failed");
    const auto 节点完整 = [&](稳定编码 编码, 节点种类 种类,
        std::optional<L1所有者范围值表示种类> 表示) noexcept {
        const L1所有者范围一致节点读取结果项* 找到 = nullptr;
        for (const auto& 项 : 读取.节点) {
            if (项.查询编码 != 编码) continue;
            if (找到) return false;
            找到 = &项;
        }
        return 找到 && 找到->状态 == L1所有者范围一致当前读取项目状态::成功
            && 找到->事实 && 找到->事实->编码 == 编码
            && 找到->事实->种类 == 种类 && 找到->事实->属性类型表示 == 表示
            && 找到->事实->写入所有者 == 写入端口.所有者身份()
            && 找到->事实->创建事实代次 == 写入.事实代次
            && !找到->事实->退出事实代次 && 找到->事实->当前属性.empty();
    };
    if (!节点完整(*阶次类型, 节点种类::属性类型,
            L1所有者范围值表示种类::I64)
        || !节点完整(*规则类型, 节点种类::属性类型,
            L1所有者范围值表示种类::U64组)
        || !节点完整(*来源类型, 节点种类::普通, std::nullopt))
        throw std::runtime_error("L2 feature derivation registration shape failed");
    return {写入端口.所有者身份(), *阶次类型, *规则类型,
        *来源类型, 写入.事实代次};
}

// 诊断责任：无适用错误分支；保留 v1 只读代次探测并映射到 owner 读取状态。
特征事实代次读取结果 读取特征事实代次(
    const L1事实基座服务& 第一层服务) noexcept {
    const auto 读取 = 第一层服务.读取中性当前事实代次({L1中性CRUD合同版本});
    L1所有者范围读取状态 状态 = L1所有者范围读取状态::内部不一致;
    switch (读取.状态) {
    case L1中性读取状态::成功: 状态 = L1所有者范围读取状态::成功; break;
    case L1中性读取状态::入口拒绝: 状态 = L1所有者范围读取状态::入口拒绝; break;
    case L1中性读取状态::未找到: 状态 = L1所有者范围读取状态::未找到; break;
    case L1中性读取状态::已退出: 状态 = L1所有者范围读取状态::已退出; break;
    case L1中性读取状态::属性未设置: 状态 = L1所有者范围读取状态::属性未设置; break;
    case L1中性读取状态::资源失败: 状态 = L1所有者范围读取状态::资源失败; break;
    case L1中性读取状态::内部不一致: break;
    }
    if (读取.合同版本 != L1中性CRUD合同版本)
        状态 = L1所有者范围读取状态::内部不一致;
    return {状态, L1所有者范围CRUD合同版本, 读取.事实代次};
}

// 诊断责任：无适用错误分支；完整 64 位纯值映射不读取事实。
L1所有者范围写入幂等身份 映射特征定义幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部中性写入状态。
L2结构状态 映射特征定义写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部一致读取状态。
L2结构状态 映射特征定义一致读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部读取项目状态。
L2结构状态 映射特征定义当前项目状态(
    L1所有者范围一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部历史读取状态。
L2结构状态 映射特征定义历史读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

struct 特征定义预检结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 事实截止代次 = 0;
    bool 直接提交 = false;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

// 诊断责任：无适用错误分支；历史属性值组状态只映射为 E2 结构状态。
L2结构状态 映射特征定义历史属性值组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；四类 L2 材料无损映射到 L1 中性材料。
L1所有者范围原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1所有者范围独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；四类 L1 材料无损映射到 L2 类型化材料。
L2原始值材料 转换为L2材料(const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1所有者范围独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

// 诊断责任：无适用错误分支；把完整 L1 值事实投影到具名截止。
std::optional<L2属性事实> 形成截止属性事实(
    L1所有者范围值事实 值, std::uint64_t 截止) {
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

// 诊断责任：无适用错误分支；普通特征定义节点骨架允许有序非空当前属性槽。
std::optional<L2统一特征定义事实> 形成截止特征定义节点骨架(
    L1所有者范围节点事实 节点, std::uint64_t 截止) noexcept {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || (节点.退出事实代次
            && (*节点.退出事实代次 < 节点.创建事实代次
                || *节点.退出事实代次 > 截止))) return std::nullopt;
    for (std::size_t 索引 = 0; 索引 < 节点.当前属性.size(); ++索引) {
        const auto& 槽 = 节点.当前属性[索引];
        if (!有效(槽.属性类型节点) || !有效(槽.当前值)
            || (索引 != 0
                && !(节点.当前属性[索引 - 1].属性类型节点 < 槽.属性类型节点)))
            return std::nullopt;
        for (std::size_t 前索引 = 0; 前索引 < 索引; ++前索引)
            if (节点.当前属性[前索引].当前值 == 槽.当前值) return std::nullopt;
    }
    L2统一特征定义事实 特征定义;
    特征定义.身份 = L2特征定义身份{节点.编码};
    特征定义.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return 特征定义;
}

// 诊断责任：无适用错误分支；核对一致投影顶层成功或精确失败形状。
特征定义预检结果 解释特征定义一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取, std::uint64_t 期望代次) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望代次
            && 读取.读取事实代次 == 期望代次 && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次, false};
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    }
    const bool 六组空 = 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望代次
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望代次 || !六组空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次, false};
    if (读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
        return {L2结构状态::事实代次漂移, 读取.读取事实代次, true};
    return {映射特征定义一致读取失败状态(读取.状态),
        读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；按查询编码查找唯一节点结果项。
const L1所有者范围一致节点读取结果项* 查找唯一特征定义节点项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：向上送出；当前代次失败或漂移均形成结构化预检结果。
特征定义预检结果 检查特征定义当前代次(
    const L1事实基座服务& 第一层服务, 稳定编码 特征定义编码,
    std::uint64_t 期望代次) {
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 期望代次;
    请求.节点 = {特征定义编码};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    const auto 结果 = 解释特征定义一致读取顶层(读取, 期望代次);
    if (!结果.成功()) return 结果;
    const bool 只有具名节点 = 读取.节点.size() == 1
        && 读取.关系.empty() && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const auto* 节点项 = 只有具名节点
        ? 查找唯一特征定义节点项(读取, 特征定义编码) : nullptr;
    const bool 节点项完整 = 节点项
        && ((节点项->状态 == L1所有者范围一致当前读取项目状态::成功
                && 节点项->事实 && 节点项->事实->编码 == 特征定义编码)
            || ((节点项->状态 == L1所有者范围一致当前读取项目状态::未找到
                    || 节点项->状态 == L1所有者范围一致当前读取项目状态::已退出)
                && !节点项->事实));
    return 节点项完整 ? 结果
        : 特征定义预检结果{L2结构状态::内部不一致,
            读取.读取事实代次, false};
}

// 诊断责任：无适用错误分支；只形成完整特征定义读取的空载荷失败。
L2统一特征定义完整读取结果 形成完整特征定义读取失败(
    const L2统一特征定义完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt};
}

// 诊断责任：无适用错误分支；只形成固定属性写入空载荷失败。
L2特征定义固定属性写入结果 形成特征定义固定属性写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：向上送出；同期特征定义节点与具名属性槽前置均结构化返回。
特征定义预检结果 检查特征定义固定属性前置(
    const L1事实基座服务& 第一层服务, L2特征定义身份 特征定义, 稳定编码 属性类型,
    std::optional<稳定编码> 期望旧值, std::uint64_t 截止) {
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 截止;
    请求.节点 = {特征定义.值};
    请求.属性值 = {{特征定义.值, 属性类型}};
    const auto 读取 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    const auto 顶层 = 解释特征定义一致读取顶层(读取, 截止);
    if (!顶层.成功()) return 顶层;
    if (读取.节点.size() != 1 || 读取.属性值.size() != 1
        || !读取.关系.empty() || !读取.值.empty()
        || !读取.源关系组.empty() || !读取.目标关系组.empty())
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    const auto* 节点项 = 查找唯一特征定义节点项(读取, 特征定义.值);
    if (!节点项 || 节点项->状态 != L1所有者范围一致当前读取项目状态::成功
        || !节点项->事实 || 节点项->事实->退出事实代次
        || !形成截止特征定义节点骨架(*节点项->事实, 截止)) {
        if (节点项 && !节点项->事实)
            return {映射特征定义当前项目状态(节点项->状态), 顶层.事实截止代次, false};
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    }
    const auto& 属性项 = 读取.属性值.front();
    if (属性项.节点 != 特征定义.值 || 属性项.属性类型 != 属性类型)
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    if (属性项.状态 == L1所有者范围一致当前读取项目状态::属性未设置) {
        if (属性项.投影)
            return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
        return 期望旧值
            ? 特征定义预检结果{L2结构状态::属性未设置,
                顶层.事实截止代次, false}
            : 特征定义预检结果{L2结构状态::已读取,
                顶层.事实截止代次, false};
    }
    if (属性项.状态 != L1所有者范围一致当前读取项目状态::成功
        || !属性项.投影 || 属性项.投影->属性槽.属性类型节点 != 属性类型
        || 属性项.投影->属性槽.当前值 != 属性项.投影->当前值事实.编码
        || 属性项.投影->当前值事实.所属节点 != 特征定义.值
        || 属性项.投影->当前值事实.属性类型节点 != 属性类型
        || 属性项.投影->当前值事实.退出事实代次
        || !形成截止属性事实(属性项.投影->当前值事实, 截止))
        return {L2结构状态::内部不一致, 顶层.事实截止代次, false};
    if (!期望旧值 || 属性项.投影->当前值事实.编码 != *期望旧值)
        return {L2结构状态::引用冲突, 顶层.事实截止代次, false};
    return {L2结构状态::已读取, 顶层.事实截止代次, false};
}

// 诊断责任：无适用错误分支；只核对新值本地键唯一映射。
std::optional<稳定编码> 查找唯一特征定义固定属性编码映射(
    const L1所有者范围写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 1) return std::nullopt;
    const auto& [本地键, 编码] = 结果.新编码映射.front();
    return 本地键.值 == 特征定义固定属性值本地键值 && 有效(编码)
        ? std::optional<稳定编码>{编码} : std::nullopt;
}

// 诊断责任：向上送出；属性写集提交、首次映射和历史读回矛盾均结构化返回。
L2特征定义固定属性写入结果 提交并读回特征定义固定属性写集(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口,
    const L1所有者范围写集请求& 写集,
    L2特征定义身份 特征定义, const L2属性提交项& 新属性,
    std::optional<稳定编码> 旧值编码) {
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    if (写入.合同版本 != L1所有者范围CRUD合同版本 || 写入.写入幂等身份 != 写集.写入幂等身份)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 状态 = 映射特征定义写入状态(写入.状态);
    if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
        if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
            return 形成特征定义固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        return 形成特征定义固定属性写入失败(状态, 写入.事实代次);
    }
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    const auto 新值编码 = 查找唯一特征定义固定属性编码映射(写入);
    if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !新值编码)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const auto 属性组 = 第一层服务.读取所有者范围历史属性值组(
        {L1所有者范围CRUD合同版本, 特征定义.值, 写入.事实代次});
    if (属性组.状态 != L1所有者范围读取状态::成功
        || 属性组.合同版本 != L1所有者范围CRUD合同版本
        || 属性组.所属节点 != 特征定义.值
        || 属性组.历史截止事实代次 != 写入.事实代次
        || 属性组.读取事实代次 < 写入.事实代次)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    const L1所有者范围值事实* 新值 = nullptr;
    for (const auto& 值 : 属性组.属性值组) {
        if (值.编码 != *新值编码) continue;
        if (新值) return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
        新值 = &值;
    }
    if (!新值 || 新值->所属节点 != 特征定义.值
        || 新值->属性类型节点 != 新属性.属性类型身份
        || 新值->来源节点 != 新属性.来源稳定编码
        || 转换为L2材料(新值->材料) != 新属性.原始值材料
        || 新值->创建事实代次 != 写入.事实代次)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    auto 当前属性 = 形成截止属性事实(*新值, 写入.事实代次);
    if (!当前属性 || 当前属性->退出事实代次)
        return 形成特征定义固定属性写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    L2特征定义固定属性写入结果 结果{{L2结构合同版本, 状态,
        写入.事实代次, 写入.事实代次}, std::move(当前属性), std::nullopt};
    if (旧值编码) {
        const auto 旧读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, *旧值编码});
        const auto* 旧值 = 旧读取.事实
            ? std::get_if<L1所有者范围值事实>(&*旧读取.事实) : nullptr;
        if (旧读取.状态 != L1所有者范围读取状态::成功
            || 旧读取.合同版本 != L1所有者范围CRUD合同版本
            || 旧读取.查询编码 != *旧值编码 || !旧值
            || 旧值->编码 != *旧值编码 || 旧值->所属节点 != 特征定义.值
            || 旧值->属性类型节点 != 新属性.属性类型身份
            || 旧值->退出事实代次 != 写入.事实代次)
            return 形成特征定义固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        结果.已退出属性 = 形成截止属性事实(*旧值, 写入.事实代次);
        if (!结果.已退出属性
            || 结果.已退出属性->退出事实代次 != 写入.事实代次)
            return 形成特征定义固定属性写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
    }
    return 结果.成功() ? 结果 : 形成特征定义固定属性写入失败(
        L2结构状态::内部不一致, 写入.事实代次);
}

// 诊断责任：无适用错误分支；固定私有域纯值映射不读取事实。
L1所有者范围写入幂等身份 映射特征关系类型登记幂等键(
    L2结构幂等身份) noexcept {
    return 特征关系类型登记固定幂等身份;
}

// 诊断责任：无适用错误分支；纯值枚举映射覆盖全部登记写入状态。
L2特征关系类型登记状态 映射特征关系类型登记写入状态(
    L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2特征关系类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2特征关系类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2特征关系类型登记状态::入口拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2特征关系类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2特征关系类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2特征关系类型登记状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::引用冲突:
    case L1所有者范围写入状态::内部不一致:
        return L2特征关系类型登记状态::内部不一致;
    }
    return L2特征关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；一致读取失败状态映射为登记状态。
L2特征关系类型登记状态 映射特征关系类型登记读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2特征关系类型登记状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2特征关系类型登记状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2特征关系类型登记状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2特征关系类型登记状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2特征关系类型登记状态::内部不一致;
    }
    return L2特征关系类型登记状态::内部不一致;
}

// 诊断责任：无适用错误分支；登记失败必须保持空载荷。
L2特征关系类型登记结果 形成特征关系类型登记失败(
    L2特征关系类型登记状态 状态,
    std::uint64_t 事实截止代次 = 0) noexcept {
    return {状态, 事实截止代次, std::nullopt};
}

// 诊断责任：无适用错误分支；核对一致读取失败的空载荷形状。
bool 特征关系类型一致读取失败形状完整(
    const L1所有者范围一致当前读取结果& 结果,
    std::uint64_t 期望代次) noexcept {
    if (结果.状态 == L1所有者范围一致当前读取状态::成功
        || 结果.合同版本 != L1所有者范围一致当前读取合同版本
        || 结果.期望事实代次 != 期望代次
        || !结果.节点.empty() || !结果.关系.empty() || !结果.值.empty()
        || !结果.属性值.empty() || !结果.源关系组.empty()
        || !结果.目标关系组.empty()) return false;
    return 结果.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 结果.读取事实代次 != 0 && 结果.读取事实代次 != 期望代次
        : 结果.读取事实代次 == 0;
}

// 诊断责任：无适用错误分支；未找到或重复的本地键映射返回空值。
std::optional<稳定编码> 查找特征关系类型编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [本地键, 编码] : 结果.新编码映射) {
        if (本地键.值 != 本地键值) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只核对两项登记编码映射一一对应。
bool 特征关系类型编码映射唯一(const L1所有者范围写入结果& 结果) noexcept {
    if (结果.新编码映射.size() != 2) return false;
    const auto 宿主 = 查找特征关系类型编码映射(
        结果, 特征宿主关系类型本地键值);
    const auto 定义 = 查找特征关系类型编码映射(
        结果, 特征定义关系类型本地键值);
    return 宿主 && 定义 && 有效(*宿主) && 有效(*定义) && *宿主 != *定义;
}

// 诊断责任：无适用错误分支；登记失败精确收口为共同结构状态。
L2结构状态 映射登记失败为结构状态(
    L2特征关系类型登记状态 状态) noexcept {
    switch (状态) {
    case L2特征关系类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2特征关系类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2特征关系类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2特征关系类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2特征关系类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2特征关系类型登记状态::登记未加载:
    case L2特征关系类型登记状态::已提交:
    case L2特征关系类型登记状态::精确重复:
    case L2特征关系类型登记状态::已读取:
    case L2特征关系类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

