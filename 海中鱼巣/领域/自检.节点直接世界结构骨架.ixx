// 文件规则：本模块只验证 P1A3F 七个安全未实现骨架及其零事实变化合同。
module;

#include "../核心/节点直接结构合同.数据.h"

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <string>
#include <tuple>
#include <type_traits>
#include <vector>

export module 海中鱼巣.领域.自检.节点直接世界结构骨架;

import 海中鱼巣.核心.仓库.节点直接身份;
import 海中鱼巣.核心.仓库.正式关系;
import 海中鱼巣.核心.仓库.可重建索引;
import 海中鱼巣.核心.仓库.节点直接类型合同;
import 海中鱼巣.核心.仓库.节点直接类型化值;
import 海中鱼巣.核心.仓库.节点直接事务幂等;
import 海中鱼巣.核心.执行器.节点直接身份结构写入;
import 海中鱼巣.核心.端口.节点直接持久证据;
import 海中鱼巣.核心.数据操作.节点直接类型化结构;
import 海中鱼巣.核心.服务.节点直接结构;
