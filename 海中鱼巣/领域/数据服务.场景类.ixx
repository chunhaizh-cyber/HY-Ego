export namespace 海中鱼巣 {

inline constexpr std::uint32_t 场景类数据合同版本 = 1;

enum class 场景类成员种类 : std::uint8_t {
    子场景 = 1,
    存在 = 2,
    状态 = 3,
    动态 = 4
};

enum class 场景类数据状态 : std::uint8_t {
    已创建 = 1,
    精确重复 = 2,
    已读取 = 3,
    已添加成员 = 4,
    已移除成员 = 5,
    已退出 = 6,
    入口拒绝 = 7,
    未找到 = 8,
    目标已退出 = 9,
    成员已存在 = 10,
    成员未找到 = 11,
    子场景读取失败 = 12,
    存在读取失败 = 13,
    状态读取失败 = 14,
    动态读取失败 = 15,
    结构类型未找到 = 16,
    结构类型已退出 = 17,
    事实代次漂移 = 18,
    幂等冲突 = 19,
    引用冲突 = 20,
    历史材料已清理 = 21,
    资源失败 = 22,
    内部不一致 = 23,
    已可能发布 = 24,
    已有父场景 = 25,
    形成场景环 = 26,
    非根场景 = 27,
    数量预算不足 = 28,
    根场景不可删除 = 29,
    非叶场景 = 30
};

