    static 场景类数据状态 映射读取状态(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::未找到:
            return 场景类数据状态::未找到;
        case L1所有者范围读取状态::已退出:
            return 场景类数据状态::目标已退出;
        case L1所有者范围读取状态::事实代次漂移:
            return 场景类数据状态::事实代次漂移;
        case L1所有者范围读取状态::历史材料已清理:
            return 场景类数据状态::历史材料已清理;
        case L1所有者范围读取状态::入口拒绝:
            return 场景类数据状态::入口拒绝;
        case L1所有者范围读取状态::资源失败:
            return 场景类数据状态::资源失败;
        default:
            return 场景类数据状态::内部不一致;
        }
    }

    static 场景类数据状态 映射写入状态(
        L1所有者范围写入状态 状态,
        场景类数据状态 成功状态) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功:
            return 成功状态;
        case L1所有者范围写入状态::精确重复:
            return 场景类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝:
            return 场景类数据状态::入口拒绝;
        case L1所有者范围写入状态::未找到:
            return 场景类数据状态::结构类型未找到;
        case L1所有者范围写入状态::已退出:
            return 场景类数据状态::结构类型已退出;
        case L1所有者范围写入状态::事实代次漂移:
            return 场景类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突:
            return 场景类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突:
            return 场景类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败:
            return 场景类数据状态::资源失败;
        default:
            return 场景类数据状态::内部不一致;
        }
    }

    const L1事实基座服务& 第一层服务_;
    const 存在类数据服务& 存在服务_;
    const 状态类数据服务& 状态服务_;
    const 动态类数据服务& 动态服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    稳定编码 子场景关系类型_{};
    稳定编码 存在关系类型_{};
    稳定编码 状态关系类型_{};
    稳定编码 动态关系类型_{};
    const 稳定编码 宿主存在关系类型_{};
};

} // namespace 海中鱼巣
