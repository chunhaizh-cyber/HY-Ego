module;

#include <utility>

export module 海中鱼巣.领域.数据服务.场景类;

export import 海中鱼巣.领域.合同.场景状态使用绑定;

export namespace 海中鱼巣 {

class 场景类数据服务 final : public 状态使用绑定只读提供者 {
public:
    场景类数据服务() = delete;
    场景类数据服务(const 场景类数据服务&) = delete;
    场景类数据服务& operator=(const 场景类数据服务&) = delete;
    场景类数据服务(场景类数据服务&&) = delete;
    场景类数据服务& operator=(场景类数据服务&&) = delete;

    场景类数据服务(const L1事实基座服务& 第一层服务,
        L1所有者范围写端口&& 写入端口,
        const 状态使用绑定结构交付& 结构交付,
        const 存在结构身份只读提供者& 存在身份提供者,
        const 状态类数据服务& 状态服务)
        : 第一层服务_(&第一层服务), 写入端口_(std::move(写入端口)),
          结构交付_(结构交付), 存在身份提供者_(&存在身份提供者),
          状态服务_(&状态服务) {}

    bool 绑定于(const L1事实基座服务& 服务) const noexcept override {
        return 第一层服务_ == &服务;
    }

    状态使用绑定创建结果 创建状态使用绑定(
        const 状态使用绑定创建请求&) {
        return 未实现创建结果();
    }

    状态使用绑定读取结果 读取当前状态使用绑定(
        const 状态使用绑定当前读取请求&) const override {
        return 未实现读取结果();
    }

    状态使用绑定读取结果 读取状态使用绑定历史(
        const 状态使用绑定历史读取请求&) const override {
        return 未实现读取结果();
    }

    状态使用绑定组查询结果 按发生场景查询当前状态使用绑定组(
        const 状态使用绑定按发生场景查询请求&) const {
        return 未实现组查询结果();
    }

    状态使用绑定组查询结果 按被描述存在查询当前状态使用绑定组(
        const 状态使用绑定按被描述存在查询请求&) const {
        return 未实现组查询结果();
    }

    状态使用绑定组查询结果 按状态查询当前状态使用绑定组(
        const 状态使用绑定按状态查询请求&) const {
        return 未实现组查询结果();
    }

    状态使用绑定退出结果 退出状态使用绑定(
        const 状态使用绑定退出请求&) {
        状态使用绑定退出结果 结果;
        结果.结果头.状态 = 状态使用绑定数据状态::未实现;
        return 结果;
    }

private:
    static 状态使用绑定创建结果 未实现创建结果() noexcept {
        状态使用绑定创建结果 结果;
        结果.结果头.状态 = 状态使用绑定数据状态::未实现;
        return 结果;
    }

    static 状态使用绑定读取结果 未实现读取结果() noexcept {
        状态使用绑定读取结果 结果;
        结果.结果头.状态 = 状态使用绑定数据状态::未实现;
        return 结果;
    }

    static 状态使用绑定组查询结果 未实现组查询结果() noexcept {
        状态使用绑定组查询结果 结果;
        结果.结果头.状态 = 状态使用绑定数据状态::未实现;
        return 结果;
    }

    const L1事实基座服务* 第一层服务_;
    L1所有者范围写端口 写入端口_;
    状态使用绑定结构交付 结构交付_;
    const 存在结构身份只读提供者* 存在身份提供者_;
    const 状态类数据服务* 状态服务_;
};

} // namespace 海中鱼巣
