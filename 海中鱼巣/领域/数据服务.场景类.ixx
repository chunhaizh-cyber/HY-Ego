struct 场景类结点结果 final {
    场景类数据状态 状态 = 场景类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<场景类结点> 场景结点;

    bool 成功() const noexcept {
        return (状态 == 场景类数据状态::已创建
                || 状态 == 场景类数据状态::精确重复
                || 状态 == 场景类数据状态::已读取
                || 状态 == 场景类数据状态::已添加成员
                || 状态 == 场景类数据状态::已移除成员
                || 状态 == 场景类数据状态::已退出)
            && 合同版本 == 场景类数据合同版本
            && 事实代次 != 0 && 场景结点.has_value();
    }
};

struct 场景类树结果 final {
    场景类数据状态 状态 = 场景类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 事实代次 = 0;
    稳定编码 根场景结点{};
    std::vector<场景类结点> 场景组;

    bool 成功() const noexcept {
        return 状态 == 场景类数据状态::已读取
            && 合同版本 == 场景类数据合同版本
            && 事实代次 != 0 && 有效(根场景结点)
            && !场景组.empty();
    }
};

inline constexpr std::uint32_t 场景类成员迁移合同版本 = 1;

