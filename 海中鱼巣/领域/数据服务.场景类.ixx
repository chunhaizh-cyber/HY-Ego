    原场景未找到 = 4,
    目标场景未找到 = 5,
    成员未找到 = 6,
    成员已在目标 = 7,
    成员多重归属 = 8,
    子场景读取失败 = 9,
    存在读取失败 = 10,
    形成场景环 = 11,
    数量预算不足 = 12,
    事实代次漂移 = 13,
    幂等冲突 = 14,
    引用冲突 = 15,
    历史材料已清理 = 16,
    资源失败 = 17,
    内部不一致 = 18,
    已可能发布 = 19
};

struct 场景类成员迁移请求 final {
    std::uint32_t 合同版本 = 场景类成员迁移合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 原场景{};
    稳定编码 目标场景{};
    场景类成员种类 成员种类 = 场景类成员种类::子场景;
    稳定编码 成员结点{};
    std::uint64_t 最大场景数量 = 0;
    friend bool operator==(const 场景类成员迁移请求&,
        const 场景类成员迁移请求&) = default;
};

struct 场景类成员迁移投影 final {
    稳定编码 原场景{};
    稳定编码 目标场景{};
    场景类成员种类 成员种类 = 场景类成员种类::子场景;
    稳定编码 成员结点{};
    稳定编码 旧成员关系{};
    稳定编码 新成员关系{};
    friend bool operator==(const 场景类成员迁移投影&,
        const 场景类成员迁移投影&) = default;
};

struct 场景类成员迁移结果 final {
    场景类成员迁移状态 状态 = 场景类成员迁移状态::入口拒绝;
    std::uint32_t 合同版本 = 场景类成员迁移合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<场景类成员迁移投影> 投影;

    bool 成功() const noexcept {
        if ((状态 != 场景类成员迁移状态::已迁移
                && 状态 != 场景类成员迁移状态::精确重复)
            || 合同版本 != 场景类成员迁移合同版本
            || 事实代次 == 0 || !投影)
            return false;
        return 有效(投影->原场景) && 有效(投影->目标场景)
            && 投影->原场景 != 投影->目标场景
            && 有效(投影->成员结点) && 有效(投影->旧成员关系)
            && 有效(投影->新成员关系)
            && 投影->旧成员关系 != 投影->新成员关系
            && (投影->成员种类 == 场景类成员种类::子场景
                || 投影->成员种类 == 场景类成员种类::存在);
    }
};

