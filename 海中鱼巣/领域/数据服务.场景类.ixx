        case L1所有者范围写入状态::已退出:
            return 场景类成员迁移状态::引用冲突;
        case L1所有者范围写入状态::事实代次漂移:
            return 场景类成员迁移状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突:
            return 场景类成员迁移状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突:
            return 场景类成员迁移状态::引用冲突;
        case L1所有者范围写入状态::资源失败:
            return 场景类成员迁移状态::资源失败;
        default:
            return 场景类成员迁移状态::内部不一致;
        }
    }

