module;

#include <algorithm>
#include <cstdint>
#include <exception>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.数据服务.场景类;

export import 海中鱼巣.领域.数据服务.存在类;

namespace 海中鱼巣::场景类数据内部 {

inline constexpr L1所有者范围写集本地键 场景结点本地键{1};
inline constexpr L1所有者范围写集本地键 成员关系本地键{2};

std::optional<稳定编码> 查找唯一编码(
    const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键 != 本地键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

} // namespace 海中鱼巣::场景类数据内部

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 场景类数据合同版本 = 1;

enum class 场景类成员种类 : std::uint8_t {
    子场景 = 1,
    存在 = 2,
    状态 = 3,
    动态 = 4
};

enum class 场景类数据状态 : std::uint8_t {
    已创建 = 1,
    精确重复 = 2,
    已读取 = 3,
    已添加成员 = 4,
    已移除成员 = 5,
    已退出 = 6,
    入口拒绝 = 7,
    未找到 = 8,
    目标已退出 = 9,
    成员已存在 = 10,
    成员未找到 = 11,
    子场景读取失败 = 12,
    存在读取失败 = 13,
    状态读取失败 = 14,
    动态读取失败 = 15,
    结构类型未找到 = 16,
    结构类型已退出 = 17,
    事实代次漂移 = 18,
    幂等冲突 = 19,
    引用冲突 = 20,
    历史材料已清理 = 21,
    资源失败 = 22,
    内部不一致 = 23,
    已可能发布 = 24,
    已有父场景 = 25,
    形成场景环 = 26,
    非根场景 = 27,
    数量预算不足 = 28,
    根场景不可删除 = 29,
    非叶场景 = 30
};

struct 场景类成员引用 final {
    稳定编码 成员关系{};
    稳定编码 目标结点{};
    friend bool operator==(const 场景类成员引用&,
        const 场景类成员引用&) = default;
};

// 本类只承载实例场景的结构数据；需求、任务和业务身份暂不进入本服务。
struct 场景类结点 final {
    稳定编码 结点{};
    std::optional<场景类成员引用> 父场景;
    std::vector<场景类成员引用> 子场景组;
    std::vector<场景类成员引用> 存在组;
    std::vector<场景类成员引用> 状态组;
    std::vector<场景类成员引用> 动态组;
    std::uint64_t 创建事实代次 = 0;
    std::optional<std::uint64_t> 退出事实代次;
    friend bool operator==(const 场景类结点&, const 场景类结点&) = default;
};

struct 场景类新增请求 final {
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    friend bool operator==(const 场景类新增请求&,
        const 场景类新增请求&) = default;
};

struct 场景类查询请求 final {
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 场景结点{};
    friend bool operator==(const 场景类查询请求&,
        const 场景类查询请求&) = default;
};

struct 场景类树查询请求 final {
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 根场景结点{};
    std::uint64_t 最大场景数量 = 0;
    friend bool operator==(const 场景类树查询请求&,
        const 场景类树查询请求&) = default;
};

struct 场景类成员新增请求 final {
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 场景结点{};
    场景类成员种类 成员种类 = 场景类成员种类::子场景;
    稳定编码 目标结点{};
    friend bool operator==(const 场景类成员新增请求&,
        const 场景类成员新增请求&) = default;
};

struct 场景类成员删除请求 final {
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 场景结点{};
    场景类成员种类 成员种类 = 场景类成员种类::子场景;
    稳定编码 目标结点{};
    friend bool operator==(const 场景类成员删除请求&,
        const 场景类成员删除请求&) = default;
};

struct 场景类删除请求 final {
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 场景结点{};
    friend bool operator==(const 场景类删除请求&,
        const 场景类删除请求&) = default;
};

struct 场景类结点结果 final {
    场景类数据状态 状态 = 场景类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<场景类结点> 场景结点;

    bool 成功() const noexcept {
        return (状态 == 场景类数据状态::已创建
                || 状态 == 场景类数据状态::精确重复
                || 状态 == 场景类数据状态::已读取
                || 状态 == 场景类数据状态::已添加成员
                || 状态 == 场景类数据状态::已移除成员
                || 状态 == 场景类数据状态::已退出)
            && 合同版本 == 场景类数据合同版本
            && 事实代次 != 0 && 场景结点.has_value();
    }
};

struct 场景类树结果 final {
    场景类数据状态 状态 = 场景类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 场景类数据合同版本;
    std::uint64_t 事实代次 = 0;
    稳定编码 根场景结点{};
    std::vector<场景类结点> 场景组;

    bool 成功() const noexcept {
        return 状态 == 场景类数据状态::已读取
            && 合同版本 == 场景类数据合同版本
            && 事实代次 != 0 && 有效(根场景结点)
            && !场景组.empty();
    }
};

class 场景类数据服务 final {
public:
    场景类数据服务() = delete;
    场景类数据服务(const 场景类数据服务&) = delete;
    场景类数据服务& operator=(const 场景类数据服务&) = delete;
    场景类数据服务(场景类数据服务&&) = delete;
    场景类数据服务& operator=(场景类数据服务&&) = delete;

    // 四类关系类型由同一场景 owner 预先建立；服务引用由装配层注入。
    // 待外部支撑：存在、状态、动态服务分别公开
    // bool 绑定于(const L1事实基座服务&) const noexcept；支撑实现后，
    // 本构造器必须同时拒绝任何不绑定于第一层服务_的依赖服务。
    场景类数据服务(const L1事实基座服务& 第一层服务,
        const 存在类数据服务& 存在服务,
        const 状态类数据服务& 状态服务,
        const 动态类数据服务& 动态服务,
        L1所有者范围写端口&& 写入端口,
        稳定编码 子场景关系类型,
        稳定编码 存在关系类型,
        稳定编码 状态关系类型,
        稳定编码 动态关系类型)
        : 第一层服务_(第一层服务), 存在服务_(存在服务),
          状态服务_(状态服务), 动态服务_(动态服务),
          写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()),
          子场景关系类型_(子场景关系类型),
          存在关系类型_(存在关系类型),
          状态关系类型_(状态关系类型),
          动态关系类型_(动态关系类型) {
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !有效(所有者_) || !关系类型组有效())
            throw std::invalid_argument("invalid scene data configuration");
        const auto 所有者读取 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者读取.状态 != L1所有者范围读取状态::成功
            || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
            || !所有者读取.所有者事实
            || 所有者读取.所有者事实->所有者 != 所有者_
            || 所有者读取.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 所有者读取.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid scene data owner");
        if (!关系类型有效(子场景关系类型_)
            || !关系类型有效(存在关系类型_)
            || !关系类型有效(状态关系类型_)
            || !关系类型有效(动态关系类型_))
            throw std::invalid_argument("invalid scene relation types");
    }

    场景类结点结果 新增场景(const 场景类新增请求& 请求) {
        if (!新增请求有效(请求)) return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放新增场景(请求)) return *重放;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.节点 = {{场景类数据内部::场景结点本地键,
                节点种类::普通, std::nullopt}};
            return 提交新增场景(写集, 请求.幂等身份,
                场景类数据状态::已创建);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类结点结果 查询场景(const 场景类查询请求& 请求) const {
        if (!查询请求有效(请求)) return 失败(场景类数据状态::入口拒绝);
        try {
            return 读取当前场景(请求.场景结点, 请求.期望事实代次, true);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类树结果 查询场景树(const 场景类树查询请求& 请求) const {
        if (请求.合同版本 != 场景类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.根场景结点)
            || 请求.最大场景数量 == 0)
            return 树失败(场景类数据状态::入口拒绝);
        try {
            const auto 根 = 读取当前场景(
                请求.根场景结点, 请求.期望事实代次, true);
            if (!根.成功() || 根.状态 != 场景类数据状态::已读取
                || !根.场景结点)
                return 树失败(根.状态, 根.事实代次,
                    请求.根场景结点);
            if (根.场景结点->父场景)
                return 树失败(场景类数据状态::非根场景,
                    根.事实代次, 请求.根场景结点);

            std::vector<稳定编码> 待读取{请求.根场景结点};
            std::vector<场景类结点> 场景组;
            for (std::size_t 索引 = 0; 索引 < 待读取.size(); ++索引) {
                if (场景组.size() >= 请求.最大场景数量)
                    return 树失败(场景类数据状态::数量预算不足,
                        请求.期望事实代次, 请求.根场景结点);
                const auto 当前 = 索引 == 0 ? 根 : 读取当前场景(
                    待读取[索引], 请求.期望事实代次, true);
                if (!当前.成功() || 当前.状态 != 场景类数据状态::已读取
                    || !当前.场景结点)
                    return 树失败(当前.状态, 当前.事实代次,
                        请求.根场景结点);
                if (std::any_of(场景组.begin(), 场景组.end(),
                        [&](const auto& 已有) noexcept {
                            return 已有.结点 == 当前.场景结点->结点;
                        }))
                    return 树失败(场景类数据状态::内部不一致,
                        请求.期望事实代次, 请求.根场景结点);
                for (const auto& 子 : 当前.场景结点->子场景组) {
                    if (std::find(待读取.begin(), 待读取.end(),
                            子.目标结点) != 待读取.end())
                        return 树失败(场景类数据状态::内部不一致,
                            请求.期望事实代次, 请求.根场景结点);
                    待读取.push_back(子.目标结点);
                }
                场景组.push_back(*当前.场景结点);
            }
            return {场景类数据状态::已读取, 场景类数据合同版本,
                请求.期望事实代次, 请求.根场景结点,
                std::move(场景组)};
        } catch (const std::bad_alloc&) {
            return 树失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 树失败(场景类数据状态::资源失败);
        } catch (...) {
            return 树失败(场景类数据状态::内部不一致);
        }
    }

    // 子场景关系组织场景树；其它三类关系组织场景成员列表。
    // 增删关系不换代场景身份，也不修改目标节点。
    场景类结点结果 新增成员关系(const 场景类成员新增请求& 请求) {
        if (!成员新增请求有效(请求))
            return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放新增成员(请求)) return *重放;
            const auto 本体 = 读取当前场景本体(
                请求.场景结点, 请求.期望事实代次);
            if (!本体.成功() || 本体.状态 != 场景类数据状态::已读取)
                return 本体;
            const auto 成员读取 = 读取当前源关系组(请求.场景结点,
                关系类型(请求.成员种类), 请求.期望事实代次);
            if (!成员读取.成功)
                return 失败(成员读取.状态, 成员读取.事实代次);
            if (std::any_of(成员读取.关系组.begin(), 成员读取.关系组.end(),
                    [&](const auto& 关系) noexcept {
                        return 关系.目标节点 == 请求.目标结点;
                    }))
                return 失败(场景类数据状态::成员已存在,
                    请求.期望事实代次);
            if (const auto 状态 = 验证成员目标(请求.成员种类,
                    请求.目标结点, 请求.期望事实代次))
                return 失败(*状态, 请求.期望事实代次);
            if (请求.成员种类 == 场景类成员种类::子场景) {
                const auto 父关系 = 读取当前父关系(
                    请求.目标结点, 请求.期望事实代次);
                if (!父关系.成功)
                    return 失败(父关系.状态, 父关系.事实代次);
                if (!父关系.关系组.empty())
                    return 失败(场景类数据状态::已有父场景,
                        父关系.事实代次);
                if (const auto 环状态 = 检查新增子场景是否形成环(
                        请求.场景结点, 请求.目标结点,
                        请求.期望事实代次))
                    return 失败(*环状态, 请求.期望事实代次);
            }
            const auto 写集 = 形成新增成员写集(请求);
            return 提交成员变更(写集, 请求.幂等身份,
                场景类数据状态::已添加成员,
                请求.场景结点, 请求.成员种类, 请求.目标结点, true);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类结点结果 删除成员关系(const 场景类成员删除请求& 请求) {
        if (!成员删除请求有效(请求))
            return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放删除成员(请求)) return *重放;
            const auto 本体 = 读取当前场景本体(
                请求.场景结点, 请求.期望事实代次);
            if (!本体.成功() || 本体.状态 != 场景类数据状态::已读取)
                return 本体;
            const auto 成员读取 = 读取当前源关系组(请求.场景结点,
                关系类型(请求.成员种类), 请求.期望事实代次);
            if (!成员读取.成功)
                return 失败(成员读取.状态, 成员读取.事实代次);
            const auto it = std::find_if(成员读取.关系组.begin(),
                成员读取.关系组.end(), [&](const auto& 关系) noexcept {
                    return 关系.目标节点 == 请求.目标结点;
                });
            if (it == 成员读取.关系组.end())
                return 失败(场景类数据状态::成员未找到,
                请求.期望事实代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.退出事实 = {it->编码};
            return 提交成员变更(写集, 请求.幂等身份,
                场景类数据状态::已移除成员,
                请求.场景结点, 请求.成员种类, 请求.目标结点, false);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类结点结果 删除场景(const 场景类删除请求& 请求) {
        if (!删除请求有效(请求)) return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放删除场景(请求)) return *重放;
            const auto 当前 = 读取当前场景(
                请求.场景结点, 请求.期望事实代次, false);
            if (!当前.成功() || 当前.状态 != 场景类数据状态::已读取)
                return 当前;
            if (!当前.场景结点->子场景组.empty())
                return 失败(场景类数据状态::非叶场景,
                    当前.事实代次);
            if (!当前.场景结点->父场景)
                return 失败(场景类数据状态::根场景不可删除,
                    当前.事实代次);
            auto 写集 = 形成删除场景写集(请求, *当前.场景结点);
            const auto 父关系 = 读取当前父关系(
                请求.场景结点, 请求.期望事实代次);
            if (!父关系.成功)
                return 失败(父关系.状态, 父关系.事实代次);
            for (const auto& 关系 : 父关系.关系组)
                写集.退出事实.push_back(关系.编码);
            std::sort(写集.退出事实.begin(), 写集.退出事实.end(),
                [](稳定编码 左, 稳定编码 右) noexcept { return 左.值 < 右.值; });
            写集.退出事实.erase(std::unique(写集.退出事实.begin(),
                写集.退出事实.end()), 写集.退出事实.end());
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(
                写入.状态, 场景类数据状态::已退出);
            if (状态 != 场景类数据状态::已退出
                && 状态 != 场景类数据状态::精确重复)
                return 失败(状态, 写入.事实代次);
            try {
                if (!写入结果头完整(写入, 请求.幂等身份))
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
                if (!写入.新编码映射.empty()
                    || !退出事实同代闭合(
                        写集.退出事实, 写入.事实代次))
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
                auto 读回 = 读取历史场景快照(请求.场景结点,
                    写入.事实代次 - 1, 写入.事实代次,
                    场景类数据状态::已退出, 写入.事实代次);
                if (!读回.成功())
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
                读回.状态 = 状态;
                return 读回;
            } catch (const std::bad_alloc&) {
                return 失败(场景类数据状态::已可能发布, 写入.事实代次);
            } catch (const std::length_error&) {
                return 失败(场景类数据状态::已可能发布, 写入.事实代次);
            } catch (...) {
                return 失败(场景类数据状态::已可能发布, 写入.事实代次);
            }
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

private:
    struct 关系组读取值 final {
        bool 成功 = false;
        场景类数据状态 状态 = 场景类数据状态::内部不一致;
        std::uint64_t 事实代次 = 0;
        std::vector<L1所有者范围关系事实> 关系组;
    };

    bool 关系类型组有效() const noexcept {
        const std::vector<稳定编码> 类型组{子场景关系类型_, 存在关系类型_,
            状态关系类型_, 动态关系类型_};
        for (std::size_t i = 0; i < 类型组.size(); ++i) {
            if (!有效(类型组[i])) return false;
            for (std::size_t j = 0; j < i; ++j)
                if (类型组[i] == 类型组[j]) return false;
        }
        return true;
    }

    bool 关系类型有效(稳定编码 编码) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 事实 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && !读取.物理清理事实代次
            && !读取.物理清理墓碑 && 事实 && 事实->编码 == 编码
            && 事实->写入所有者 == 所有者_
            && 事实->种类 == 节点种类::普通
            && !事实->属性类型表示 && 事实->创建事实代次 != 0
            && !事实->退出事实代次;
    }

    static bool 成员种类有效(场景类成员种类 种类) noexcept {
        return 种类 == 场景类成员种类::子场景
            || 种类 == 场景类成员种类::存在
            || 种类 == 场景类成员种类::状态
            || 种类 == 场景类成员种类::动态;
    }

    static bool 新增请求有效(const 场景类新增请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份);
    }

    static bool 查询请求有效(const 场景类查询请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.场景结点);
    }

    static bool 成员新增请求有效(
        const 场景类成员新增请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.场景结点) && 成员种类有效(请求.成员种类)
            && 有效(请求.目标结点)
            && (请求.成员种类 != 场景类成员种类::子场景
                || 请求.场景结点 != 请求.目标结点);
    }

    static bool 成员删除请求有效(
        const 场景类成员删除请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.场景结点) && 成员种类有效(请求.成员种类)
            && 有效(请求.目标结点);
    }

    static bool 删除请求有效(const 场景类删除请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.场景结点);
    }

    稳定编码 关系类型(场景类成员种类 种类) const noexcept {
        switch (种类) {
        case 场景类成员种类::子场景:
            return 子场景关系类型_;
        case 场景类成员种类::存在:
            return 存在关系类型_;
        case 场景类成员种类::状态:
            return 状态关系类型_;
        case 场景类成员种类::动态:
            return 动态关系类型_;
        }
        return {};
    }

    static const std::vector<场景类成员引用>& 选择成员组(
        const 场景类结点& 场景, 场景类成员种类 种类) noexcept {
        switch (种类) {
        case 场景类成员种类::子场景:
            return 场景.子场景组;
        case 场景类成员种类::存在:
            return 场景.存在组;
        case 场景类成员种类::状态:
            return 场景.状态组;
        case 场景类成员种类::动态:
            return 场景.动态组;
        }
        return 场景.子场景组;
    }

    static std::vector<场景类成员引用>& 选择成员组(
        场景类结点& 场景, 场景类成员种类 种类) noexcept {
        switch (种类) {
        case 场景类成员种类::子场景:
            return 场景.子场景组;
        case 场景类成员种类::存在:
            return 场景.存在组;
        case 场景类成员种类::状态:
            return 场景.状态组;
        case 场景类成员种类::动态:
            return 场景.动态组;
        }
        return 场景.子场景组;
    }

    static const 场景类成员引用* 查找成员(
        const std::vector<场景类成员引用>& 成员组,
        稳定编码 目标) noexcept {
        const auto it = std::find_if(成员组.begin(), 成员组.end(),
            [&](const auto& 成员) noexcept { return 成员.目标结点 == 目标; });
        return it == 成员组.end() ? nullptr : &*it;
    }

    std::optional<场景类数据状态> 验证成员目标(
        场景类成员种类 种类, 稳定编码 目标,
        std::uint64_t 期望事实代次) const {
        switch (种类) {
        case 场景类成员种类::子场景: {
            const auto 读取 = 读取当前场景本体(目标, 期望事实代次);
            if (读取.成功() && 读取.状态 == 场景类数据状态::已读取)
                return std::nullopt;
            if (读取.状态 == 场景类数据状态::事实代次漂移
                || 读取.状态 == 场景类数据状态::资源失败
                || 读取.状态 == 场景类数据状态::入口拒绝)
                return 读取.状态;
            return 场景类数据状态::子场景读取失败;
        }
        case 场景类成员种类::存在: {
            const auto 读取 = 存在服务_.查询存在(
                {存在类数据合同版本, 期望事实代次, 目标});
            if (读取.成功() && 读取.状态 == 存在类数据状态::已读取
                && 读取.事实代次 == 期望事实代次
                && 读取.存在结点 && 读取.存在结点->结点 == 目标)
                return std::nullopt;
            return 映射存在状态(读取.状态);
        }
        case 场景类成员种类::状态: {
            const auto 读取 = 状态服务_.查询状态(
                {状态类数据合同版本, 期望事实代次, 目标});
            if (读取.成功() && 读取.状态 == 状态类数据状态::已读取
                && 读取.事实代次 == 期望事实代次
                && 读取.状态结点 && 读取.状态结点->结点 == 目标)
                return std::nullopt;
            return 映射状态状态(读取.状态);
        }
        case 场景类成员种类::动态: {
            const auto 读取 = 动态服务_.查询动态(
                {动态类数据合同版本, 期望事实代次, 目标});
            if (读取.成功() && 读取.状态 == 动态类数据状态::已读取
                && 读取.事实代次 == 期望事实代次
                && 读取.动态结点 && 读取.动态结点->结点 == 目标)
                return std::nullopt;
            return 映射动态状态(读取.状态);
        }
        }
        return 场景类数据状态::入口拒绝;
    }

    场景类结点结果 读取当前场景本体(稳定编码 场景结点,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 场景结点});
        if (读取.读取事实代次 != 期望事实代次)
            return 失败(场景类数据状态::事实代次漂移,
                读取.读取事实代次);
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(读取.状态), 读取.读取事实代次);
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 场景结点 || 读取.物理清理事实代次
            || 读取.物理清理墓碑 || !节点 || 节点->编码 != 场景结点
            || 节点->写入所有者 != 所有者_
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 == 0 || 节点->退出事实代次
            || !节点->当前属性.empty())
            return 失败(场景类数据状态::内部不一致,
                读取.读取事实代次);
        场景类结点 结果;
        结果.结点 = 场景结点;
        结果.创建事实代次 = 节点->创建事实代次;
        return {场景类数据状态::已读取, 场景类数据合同版本,
            读取.读取事实代次, std::move(结果)};
    }

    关系组读取值 读取当前源关系组(稳定编码 场景结点,
        稳定编码 类型, std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 场景结点, 类型});
        if (读取.读取事实代次 != 期望事实代次)
            return {false, 场景类数据状态::事实代次漂移,
                读取.读取事实代次, {}};
        if (读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射读取状态(读取.状态),
                读取.读取事实代次, {}};
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.源节点 != 场景结点 || 读取.关系类型节点 != 类型)
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        auto 关系组 = 读取.关系组;
        if (!规范化关系组(关系组, 场景结点, 类型, std::nullopt,
                std::nullopt))
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        return {true, 场景类数据状态::已读取,
            读取.读取事实代次, std::move(关系组)};
    }

    场景类结点结果 读取当前场景(稳定编码 场景结点,
        std::uint64_t 期望事实代次, bool 验证目标) const {
        auto 本体 = 读取当前场景本体(场景结点, 期望事实代次);
        if (!本体.成功() || 本体.状态 != 场景类数据状态::已读取)
            return 本体;
        const std::vector<std::pair<场景类成员种类, 稳定编码>> 分类{
            {场景类成员种类::子场景, 子场景关系类型_},
            {场景类成员种类::存在, 存在关系类型_},
            {场景类成员种类::状态, 状态关系类型_},
            {场景类成员种类::动态, 动态关系类型_}};
        for (const auto& [种类, 类型] : 分类) {
            auto 读取 = 读取当前源关系组(场景结点, 类型,
                期望事实代次);
            if (!读取.成功) return 失败(读取.状态, 读取.事实代次);
            auto& 目标组 = 选择成员组(*本体.场景结点, 种类);
            for (const auto& 关系 : 读取.关系组) {
                if (验证目标) {
                    if (const auto 状态 = 验证成员目标(
                            种类, 关系.目标节点, 期望事实代次))
                        return 失败(*状态, 期望事实代次);
                }
                目标组.push_back({关系.编码, 关系.目标节点});
            }
        }
        const auto 父关系 = 读取当前父关系(
            场景结点, 期望事实代次);
        if (!父关系.成功)
            return 失败(父关系.状态, 父关系.事实代次);
        if (!父关系.关系组.empty()) {
            const auto& 关系 = 父关系.关系组.front();
            本体.场景结点->父场景 = 场景类成员引用{
                关系.编码, 关系.源节点};
        }
        return 本体;
    }

    L1所有者范围写集请求 形成新增成员写集(
        const 场景类成员新增请求& 请求) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.关系 = {{场景类数据内部::成员关系本地键,
            请求.场景结点, 请求.目标结点, 关系类型(请求.成员种类), 1}};
        return 写集;
    }

    L1所有者范围写集请求 形成删除场景写集(
        const 场景类删除请求& 请求, const 场景类结点& 当前) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.退出事实 = {请求.场景结点};
        const auto 加入 = [&](const auto& 成员组) {
            for (const auto& 成员 : 成员组)
                写集.退出事实.push_back(成员.成员关系);
        };
        加入(当前.子场景组);
        加入(当前.存在组);
        加入(当前.状态组);
        加入(当前.动态组);
        return 写集;
    }

    场景类结点结果 提交新增场景(
        const L1所有者范围写集请求& 写集,
        L1所有者范围写入幂等身份 幂等身份,
        场景类数据状态 成功状态) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射写入状态(写入.状态, 成功状态);
        if (状态 != 成功状态 && 状态 != 场景类数据状态::精确重复)
            return 失败(状态, 写入.事实代次);
        try {
            if (!写入结果头完整(写入, 幂等身份))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            if (写入.新编码映射.size() != 1)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            const auto 结点 = 场景类数据内部::查找唯一编码(
                写入, 场景类数据内部::场景结点本地键);
            if (!结点) return 失败(场景类数据状态::已可能发布,
                写入.事实代次);
            auto 读回 = 状态 == 场景类数据状态::精确重复
                ? 读取历史场景快照(*结点, 写入.事实代次,
                    写入.事实代次, 场景类数据状态::精确重复,
                    std::nullopt)
                : 读取当前场景(*结点, 写入.事实代次, true);
            if (!读回.成功() || !读回.场景结点
                || 读回.场景结点->结点 != *结点)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (...) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        }
    }

    场景类结点结果 提交成员变更(
        const L1所有者范围写集请求& 写集,
        L1所有者范围写入幂等身份 幂等身份,
        场景类数据状态 成功状态, 稳定编码 场景结点,
        场景类成员种类 种类, 稳定编码 目标, bool 添加) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射写入状态(写入.状态, 成功状态);
        if (状态 != 成功状态 && 状态 != 场景类数据状态::精确重复)
            return 失败(状态, 写入.事实代次);
        try {
            const std::size_t 期望映射数量 = 添加 ? 1U : 0U;
            if (!写入结果头完整(写入, 幂等身份))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            if (写入.新编码映射.size() != 期望映射数量)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            std::optional<稳定编码> 新关系;
            if (添加) {
                新关系 = 场景类数据内部::查找唯一编码(
                    写入, 场景类数据内部::成员关系本地键);
                if (!新关系)
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
            } else if (写集.退出事实.size() != 1
                || !退出事实同代闭合(
                    写集.退出事实, 写入.事实代次)) {
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            }
            auto 读回 = 读取历史场景快照(场景结点, 写入.事实代次,
                写入.事实代次, 状态, std::nullopt);
            if (!读回.成功() || !读回.场景结点)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            const auto* 成员 = 查找成员(
                选择成员组(*读回.场景结点, 种类), 目标);
            if ((添加 && (!成员 || 成员->成员关系 != *新关系))
                || (!添加 && 成员))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (...) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        }
    }

    std::optional<场景类结点结果> 尝试重放新增场景(
        const 场景类新增请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        L1所有者范围写集请求 期望;
        期望.合同版本 = L1所有者范围CRUD合同版本;
        期望.期望事实代次 = 请求.期望事实代次;
        期望.写入幂等身份 = 请求.幂等身份;
        期望.节点 = {{场景类数据内部::场景结点本地键,
            节点种类::普通, std::nullopt}};
        if (*首次->首次规范化写集 != 期望
            || 首次->首次写入结果->状态
                != L1所有者范围写入状态::成功)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        return 提交新增场景(期望, 请求.幂等身份,
            场景类数据状态::精确重复);
    }

    std::optional<场景类结点结果> 尝试重放新增成员(
        const 场景类成员新增请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        const auto 期望 = 形成新增成员写集(请求);
        if (*首次->首次规范化写集 != 期望
            || 首次->首次写入结果->状态
                != L1所有者范围写入状态::成功)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        return 提交成员变更(期望, 请求.幂等身份,
            场景类数据状态::精确重复, 请求.场景结点,
            请求.成员种类, 请求.目标结点, true);
    }

    std::optional<场景类结点结果> 尝试重放删除成员(
        const 场景类成员删除请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        const auto& 写集 = *首次->首次规范化写集;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.size() != 1
            || 首次->首次写入结果->状态
                != L1所有者范围写入状态::成功)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        const auto 历史 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 写集.退出事实.front()});
        const auto* 关系 = 历史.事实
            ? std::get_if<L1所有者范围关系事实>(&*历史.事实) : nullptr;
        if (历史.状态 != L1所有者范围读取状态::成功 || !关系
            || 关系->编码 != 写集.退出事实.front()
            || 关系->写入所有者 != 所有者_
            || 关系->源节点 != 请求.场景结点
            || 关系->目标节点 != 请求.目标结点
            || 关系->关系类型节点 != 关系类型(请求.成员种类)
            || 关系->退出事实代次
                != 首次->首次写入结果->事实代次)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        return 提交成员变更(写集, 请求.幂等身份,
            场景类数据状态::精确重复, 请求.场景结点,
            请求.成员种类, 请求.目标结点, false);
    }

    std::optional<场景类结点结果> 尝试重放删除场景(
        const 场景类删除请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        const auto& 写集 = *首次->首次规范化写集;
        const auto& 结果 = *首次->首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.empty()
            || std::count(写集.退出事实.begin(), 写集.退出事实.end(),
                请求.场景结点) != 1
            || 结果.状态 != L1所有者范围写入状态::成功
            || !删除场景写集闭合(写集, 请求.场景结点,
                结果.事实代次))
            return 失败(场景类数据状态::幂等冲突, 结果.事实代次);
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        if (写入.状态 != L1所有者范围写入状态::精确重复
            || !写入结果头完整(写入, 请求.幂等身份))
            return 失败(场景类数据状态::已可能发布,
                写入.事实代次);
        try {
            if (!写入.新编码映射.empty()
                || !退出事实同代闭合(
                    写集.退出事实, 写入.事实代次))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            auto 读回 = 读取历史场景快照(请求.场景结点,
                写入.事实代次 - 1, 写入.事实代次,
                场景类数据状态::精确重复, 写入.事实代次);
            if (!读回.成功())
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            读回.状态 = 场景类数据状态::精确重复;
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (...) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        }
    }

    std::optional<L1所有者范围首次写入读取结果> 读取首次写入(
        L1所有者范围写入幂等身份 幂等身份) const {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到)
            return std::nullopt;
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_
            || 首次.写入幂等身份 != 幂等身份)
            return L1所有者范围首次写入读取结果{};
        return 首次;
    }

    场景类结点结果 读取历史场景快照(稳定编码 场景结点,
        std::uint64_t 历史截止事实代次, std::uint64_t 结果事实代次,
        场景类数据状态 返回状态,
        std::optional<std::uint64_t> 要求退出事实代次) const {
        if (历史截止事实代次 == 0 || 结果事实代次 == 0)
            return 失败(场景类数据状态::内部不一致, 结果事实代次);
        const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 场景结点});
        if (节点读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(节点读取.状态),
                节点读取.读取事实代次);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 场景结点 || !节点
            || 节点->编码 != 场景结点 || 节点->写入所有者 != 所有者_
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 == 0
            || 节点->创建事实代次 > 历史截止事实代次
            || (节点->退出事实代次
                && *节点->退出事实代次 <= 历史截止事实代次)
            || (要求退出事实代次
                && 节点->退出事实代次 != 要求退出事实代次)
            || !节点->当前属性.empty())
            return 失败(场景类数据状态::内部不一致,
                节点读取.读取事实代次);
        场景类结点 结果;
        结果.结点 = 场景结点;
        结果.创建事实代次 = 节点->创建事实代次;
        结果.退出事实代次 = 要求退出事实代次;
        const std::vector<std::pair<场景类成员种类, 稳定编码>> 分类{
            {场景类成员种类::子场景, 子场景关系类型_},
            {场景类成员种类::存在, 存在关系类型_},
            {场景类成员种类::状态, 状态关系类型_},
            {场景类成员种类::动态, 动态关系类型_}};
        for (const auto& [种类, 类型] : 分类) {
            const auto 读取 = 第一层服务_.读取所有者范围历史关系组(
                {L1所有者范围CRUD合同版本,
                    L1所有者范围关系端点方向::源, 场景结点, 类型,
                    历史截止事实代次});
            if (读取.状态 != L1所有者范围读取状态::成功)
                return 失败(映射读取状态(读取.状态),
                    读取.读取事实代次);
            if (读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.方向 != L1所有者范围关系端点方向::源
                || 读取.端点节点 != 场景结点
                || 读取.关系类型节点 != 类型
                || 读取.历史截止事实代次 != 历史截止事实代次)
                return 失败(场景类数据状态::内部不一致,
                    读取.读取事实代次);
            auto 关系组 = 读取.关系组;
            if (!规范化关系组(关系组, 场景结点, 类型,
                    历史截止事实代次, 要求退出事实代次))
                return 失败(场景类数据状态::内部不一致,
                    读取.读取事实代次);
            auto& 成员组 = 选择成员组(结果, 种类);
            for (const auto& 关系 : 关系组)
                成员组.push_back({关系.编码, 关系.目标节点});
        }
        const auto 父读取 = 第一层服务_.读取所有者范围历史关系组(
            {L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::目标, 场景结点,
                子场景关系类型_, 历史截止事实代次});
        if (父读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(父读取.状态),
                父读取.读取事实代次);
        if (父读取.合同版本 != L1所有者范围CRUD合同版本
            || 父读取.方向 != L1所有者范围关系端点方向::目标
            || 父读取.端点节点 != 场景结点
            || 父读取.关系类型节点 != 子场景关系类型_
            || 父读取.历史截止事实代次 != 历史截止事实代次
            || 父读取.关系组.size() > 1)
            return 失败(场景类数据状态::内部不一致,
                父读取.读取事实代次);
        if (!父读取.关系组.empty()) {
            const auto& 关系 = 父读取.关系组.front();
            if (!有效(关系.编码) || !有效(关系.源节点)
                || 关系.目标节点 != 场景结点
                || 关系.关系类型节点 != 子场景关系类型_
                || 关系.写入所有者 != 所有者_
                || 关系.角色或顺序 != 1
                || 关系.创建事实代次 > 历史截止事实代次
                || (关系.退出事实代次
                    && *关系.退出事实代次 <= 历史截止事实代次)
                || (要求退出事实代次
                    && 关系.退出事实代次 != 要求退出事实代次))
                return 失败(场景类数据状态::内部不一致,
                    父读取.读取事实代次);
            结果.父场景 = 场景类成员引用{
                关系.编码, 关系.源节点};
        }
        return {返回状态, 场景类数据合同版本,
            结果事实代次, std::move(结果)};
    }

    关系组读取值 读取当前父关系(稳定编码 子场景,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
            {L1所有者范围CRUD合同版本, 子场景, 子场景关系类型_});
        if (读取.读取事实代次 != 期望事实代次)
            return {false, 场景类数据状态::事实代次漂移,
                读取.读取事实代次, {}};
        if (读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射读取状态(读取.状态),
                读取.读取事实代次, {}};
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.目标节点 != 子场景
            || 读取.关系类型节点 != 子场景关系类型_)
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        auto 关系组 = 读取.关系组;
        if (关系组.size() > 1)
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept {
            if (左.源节点 != 右.源节点) return 左.源节点.值 < 右.源节点.值;
            return 左.编码.值 < 右.编码.值;
        });
        for (std::size_t i = 0; i < 关系组.size(); ++i) {
            const auto& 关系 = 关系组[i];
            if (!有效(关系.编码) || !有效(关系.源节点)
                || 关系.目标节点 != 子场景
                || 关系.关系类型节点 != 子场景关系类型_
                || 关系.写入所有者 != 所有者_
                || 关系.角色或顺序 != 1 || 关系.退出事实代次)
                return {false, 场景类数据状态::内部不一致,
                    读取.读取事实代次, {}};
            if (i != 0 && 关系组[i - 1].源节点 == 关系.源节点)
                return {false, 场景类数据状态::内部不一致,
                    读取.读取事实代次, {}};
            const auto 父 = 读取当前场景本体(
                关系.源节点, 期望事实代次);
            if (!父.成功() || 父.状态 != 场景类数据状态::已读取)
                return {false, 场景类数据状态::子场景读取失败,
                    父.事实代次, {}};
        }
        return {true, 场景类数据状态::已读取,
            读取.读取事实代次, std::move(关系组)};
    }

    std::optional<场景类数据状态> 检查新增子场景是否形成环(
        稳定编码 父场景, 稳定编码 子场景,
        std::uint64_t 期望事实代次) const {
        std::vector<稳定编码> 已访问;
        稳定编码 当前 = 父场景;
        while (有效(当前)) {
            if (当前 == 子场景) return 场景类数据状态::形成场景环;
            if (std::find(已访问.begin(), 已访问.end(), 当前)
                != 已访问.end())
                return 场景类数据状态::内部不一致;
            已访问.push_back(当前);
            const auto 父关系 = 读取当前父关系(
                当前, 期望事实代次);
            if (!父关系.成功) return 父关系.状态;
            if (父关系.关系组.empty()) break;
            当前 = 父关系.关系组.front().源节点;
        }
        return std::nullopt;
    }

    bool 规范化关系组(std::vector<L1所有者范围关系事实>& 关系组,
        稳定编码 源, 稳定编码 类型,
        std::optional<std::uint64_t> 历史截止事实代次,
        std::optional<std::uint64_t> 要求退出事实代次) const {
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept {
            if (左.目标节点 != 右.目标节点)
                return 左.目标节点.值 < 右.目标节点.值;
            return 左.编码.值 < 右.编码.值;
        });
        for (std::size_t i = 0; i < 关系组.size(); ++i) {
            const auto& 关系 = 关系组[i];
            if (!有效(关系.编码) || 关系.源节点 != 源
                || !有效(关系.目标节点) || 关系.关系类型节点 != 类型
                || 关系.写入所有者 != 所有者_
                || 关系.角色或顺序 != 1
                || (!历史截止事实代次 && 关系.退出事实代次)
                || (历史截止事实代次
                    && (关系.创建事实代次 > *历史截止事实代次
                        || (关系.退出事实代次
                            && *关系.退出事实代次
                                <= *历史截止事实代次)))
                || (要求退出事实代次
                    && 关系.退出事实代次 != 要求退出事实代次))
                return false;
            if (i != 0 && 关系组[i - 1].目标节点 == 关系.目标节点)
                return false;
        }
        return true;
    }

    bool 退出事实同代闭合(const std::vector<稳定编码>& 编码组,
        std::uint64_t 退出事实代次) const {
        if (编码组.empty() || 退出事实代次 == 0) return false;
        for (const auto 编码 : 编码组) {
            const auto 读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.查询编码 != 编码 || !读取.事实)
                return false;
            bool 闭合 = false;
            if (const auto* 节点 = std::get_if<L1所有者范围节点事实>(
                    &*读取.事实))
                闭合 = 节点->编码 == 编码
                    && 节点->写入所有者 == 所有者_
                    && 节点->退出事实代次 == 退出事实代次;
            else if (const auto* 关系 = std::get_if<L1所有者范围关系事实>(
                         &*读取.事实))
                闭合 = 关系->编码 == 编码
                    && 关系->写入所有者 == 所有者_
                    && 关系->退出事实代次 == 退出事实代次;
            if (!闭合) return false;
        }
        return true;
    }

    bool 删除场景写集闭合(const L1所有者范围写集请求& 写集,
        稳定编码 场景结点, std::uint64_t 退出事实代次) const {
        bool 找到场景结点 = false;
        for (const auto 编码 : 写集.退出事实) {
            const auto 读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.查询编码 != 编码 || !读取.事实)
                return false;
            if (const auto* 节点 = std::get_if<L1所有者范围节点事实>(
                    &*读取.事实)) {
                if (编码 != 场景结点 || 找到场景结点
                    || 节点->编码 != 场景结点
                    || 节点->写入所有者 != 所有者_
                    || 节点->种类 != 节点种类::普通
                    || 节点->属性类型表示
                    || 节点->退出事实代次 != 退出事实代次)
                    return false;
                找到场景结点 = true;
                continue;
            }
            const auto* 关系 = std::get_if<L1所有者范围关系事实>(
                &*读取.事实);
            if (!关系 || 关系->编码 != 编码
                || 关系->写入所有者 != 所有者_
                || 关系->退出事实代次 != 退出事实代次)
                return false;
            const bool 是出边 = 关系->源节点 == 场景结点
                && (关系->关系类型节点 == 子场景关系类型_
                    || 关系->关系类型节点 == 存在关系类型_
                    || 关系->关系类型节点 == 状态关系类型_
                    || 关系->关系类型节点 == 动态关系类型_);
            const bool 是父边 = 关系->目标节点 == 场景结点
                && 关系->关系类型节点 == 子场景关系类型_;
            if ((!是出边 && !是父边) || 关系->角色或顺序 != 1)
                return false;
        }
        return 找到场景结点;
    }

    bool 写入结果头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等身份) const noexcept {
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态
                == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_
            && 写入.写入幂等身份 == 幂等身份
            && 写入.事实代次 != 0 && (首次完整 || 重复完整);
    }

    static 场景类结点结果 失败(场景类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 场景类数据合同版本, 事实代次, std::nullopt};
    }

    static 场景类树结果 树失败(场景类数据状态 状态,
        std::uint64_t 事实代次 = 0,
        稳定编码 根场景结点 = {}) noexcept {
        return {状态, 场景类数据合同版本, 事实代次,
            根场景结点, {}};
    }

    static 场景类数据状态 映射存在状态(
        存在类数据状态 状态) noexcept {
        switch (状态) {
        case 存在类数据状态::事实代次漂移:
            return 场景类数据状态::事实代次漂移;
        case 存在类数据状态::入口拒绝:
            return 场景类数据状态::入口拒绝;
        case 存在类数据状态::资源失败:
            return 场景类数据状态::资源失败;
        default:
            return 场景类数据状态::存在读取失败;
        }
    }

    static 场景类数据状态 映射状态状态(
        状态类数据状态 状态) noexcept {
        switch (状态) {
        case 状态类数据状态::事实代次漂移:
            return 场景类数据状态::事实代次漂移;
        case 状态类数据状态::入口拒绝:
            return 场景类数据状态::入口拒绝;
        case 状态类数据状态::历史材料已清理:
            return 场景类数据状态::历史材料已清理;
        case 状态类数据状态::资源失败:
            return 场景类数据状态::资源失败;
        default:
            return 场景类数据状态::状态读取失败;
        }
    }

    static 场景类数据状态 映射动态状态(
        动态类数据状态 状态) noexcept {
        switch (状态) {
        case 动态类数据状态::事实代次漂移:
            return 场景类数据状态::事实代次漂移;
        case 动态类数据状态::入口拒绝:
            return 场景类数据状态::入口拒绝;
        case 动态类数据状态::历史材料已清理:
            return 场景类数据状态::历史材料已清理;
        case 动态类数据状态::资源失败:
            return 场景类数据状态::资源失败;
        default:
            return 场景类数据状态::动态读取失败;
        }
    }

    static 场景类数据状态 映射读取状态(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::未找到:
            return 场景类数据状态::未找到;
        case L1所有者范围读取状态::已退出:
            return 场景类数据状态::目标已退出;
        case L1所有者范围读取状态::事实代次漂移:
            return 场景类数据状态::事实代次漂移;
        case L1所有者范围读取状态::历史材料已清理:
            return 场景类数据状态::历史材料已清理;
        case L1所有者范围读取状态::入口拒绝:
            return 场景类数据状态::入口拒绝;
        case L1所有者范围读取状态::资源失败:
            return 场景类数据状态::资源失败;
        default:
            return 场景类数据状态::内部不一致;
        }
    }

    static 场景类数据状态 映射写入状态(
        L1所有者范围写入状态 状态,
        场景类数据状态 成功状态) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功:
            return 成功状态;
        case L1所有者范围写入状态::精确重复:
            return 场景类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝:
            return 场景类数据状态::入口拒绝;
        case L1所有者范围写入状态::未找到:
            return 场景类数据状态::结构类型未找到;
        case L1所有者范围写入状态::已退出:
            return 场景类数据状态::结构类型已退出;
        case L1所有者范围写入状态::事实代次漂移:
            return 场景类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突:
            return 场景类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突:
            return 场景类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败:
            return 场景类数据状态::资源失败;
        default:
            return 场景类数据状态::内部不一致;
        }
    }

    const L1事实基座服务& 第一层服务_;
    const 存在类数据服务& 存在服务_;
    const 状态类数据服务& 状态服务_;
    const 动态类数据服务& 动态服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    稳定编码 子场景关系类型_{};
    稳定编码 存在关系类型_{};
    稳定编码 状态关系类型_{};
    稳定编码 动态关系类型_{};
};

} // namespace 海中鱼巣
