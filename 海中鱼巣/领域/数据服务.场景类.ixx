struct 场景类宿主存在结果 final {
    场景类宿主存在状态 状态 = 场景类宿主存在状态::入口拒绝;
    std::uint32_t 合同版本 = 场景类宿主存在合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<场景类宿主存在关系> 关系;

    bool 成功() const noexcept {
        if ((状态 != 场景类宿主存在状态::已建立
                && 状态 != 场景类宿主存在状态::精确重复
                && 状态 != 场景类宿主存在状态::已读取当前
                && 状态 != 场景类宿主存在状态::已读取历史
                && 状态 != 场景类宿主存在状态::已退出)
            || 合同版本 != 场景类宿主存在合同版本
            || 事实代次 == 0 || !关系 || !有效(关系->关系)
            || !有效(关系->场景) || !有效(关系->宿主存在)
            || 关系->创建事实代次 == 0
            || 关系->创建事实代次 > 事实代次)
            return false;
        if (关系->退出事实代次
            && *关系->退出事实代次 <= 关系->创建事实代次)
            return false;
        if ((状态 == 场景类宿主存在状态::已建立
                || 状态 == 场景类宿主存在状态::已读取当前)
            && 关系->退出事实代次)
            return false;
        return 状态 != 场景类宿主存在状态::已退出
            || (关系->退出事实代次
                && *关系->退出事实代次 <= 事实代次);
    }
};

class 场景类数据服务 final {
public:
    场景类数据服务() = delete;
    场景类数据服务(const 场景类数据服务&) = delete;
    场景类数据服务& operator=(const 场景类数据服务&) = delete;
    场景类数据服务(场景类数据服务&&) = delete;
    场景类数据服务& operator=(场景类数据服务&&) = delete;

    // 五类关系类型由同一场景 owner 预先建立；服务引用由装配层注入。
    // 待外部支撑：存在、状态、动态服务分别公开
    // bool 绑定于(const L1事实基座服务&) const noexcept；支撑实现后，
    // 本构造器必须同时拒绝任何不绑定于第一层服务_的依赖服务。
    场景类数据服务(const L1事实基座服务& 第一层服务,
        const 存在类数据服务& 存在服务,
        const 状态类数据服务& 状态服务,
        const 动态类数据服务& 动态服务,
        L1所有者范围写端口&& 写入端口,
        稳定编码 子场景关系类型,
        稳定编码 存在关系类型,
        稳定编码 状态关系类型,
        稳定编码 动态关系类型,
        稳定编码 宿主存在关系类型)
        : 第一层服务_(第一层服务), 存在服务_(存在服务),
          状态服务_(状态服务), 动态服务_(动态服务),
          写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()),
          子场景关系类型_(子场景关系类型),
          存在关系类型_(存在关系类型),
          状态关系类型_(状态关系类型),
          动态关系类型_(动态关系类型),
          宿主存在关系类型_(宿主存在关系类型) {
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !有效(所有者_) || !关系类型组有效())
            throw std::invalid_argument("invalid scene data configuration");
        const auto 所有者读取 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者读取.状态 != L1所有者范围读取状态::成功
            || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
            || !所有者读取.所有者事实
            || 所有者读取.所有者事实->所有者 != 所有者_
            || 所有者读取.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 所有者读取.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid scene data owner");
        if (!关系类型有效(子场景关系类型_)
            || !关系类型有效(存在关系类型_)
            || !关系类型有效(状态关系类型_)
            || !关系类型有效(动态关系类型_)
            || !关系类型有效(宿主存在关系类型_))
            throw std::invalid_argument("invalid scene relation types");
    }

    场景类结点结果 新增场景(const 场景类新增请求& 请求) {
        if (!新增请求有效(请求)) return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放新增场景(请求)) return *重放;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.节点 = {{场景类数据内部::场景结点本地键,
                节点种类::普通, std::nullopt}};
            return 提交新增场景(写集, 请求.幂等身份,
                场景类数据状态::已创建);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类结点结果 查询场景(const 场景类查询请求& 请求) const {
        if (!查询请求有效(请求)) return 失败(场景类数据状态::入口拒绝);
        try {
            return 读取当前场景(请求.场景结点, 请求.期望事实代次, true);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类树结果 查询场景树(const 场景类树查询请求& 请求) const {
        if (请求.合同版本 != 场景类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.根场景结点)
            || 请求.最大场景数量 == 0)
            return 树失败(场景类数据状态::入口拒绝);
        try {
            const auto 根 = 读取当前场景(
                请求.根场景结点, 请求.期望事实代次, true);
            if (!根.成功() || 根.状态 != 场景类数据状态::已读取
                || !根.场景结点)
                return 树失败(根.状态, 根.事实代次,
                    请求.根场景结点);
            if (根.场景结点->父场景)
                return 树失败(场景类数据状态::非根场景,
                    根.事实代次, 请求.根场景结点);

            std::vector<稳定编码> 待读取{请求.根场景结点};
            std::vector<场景类结点> 场景组;
            for (std::size_t 索引 = 0; 索引 < 待读取.size(); ++索引) {
                if (场景组.size() >= 请求.最大场景数量)
                    return 树失败(场景类数据状态::数量预算不足,
                        请求.期望事实代次, 请求.根场景结点);
                const auto 当前 = 索引 == 0 ? 根 : 读取当前场景(
                    待读取[索引], 请求.期望事实代次, true);
                if (!当前.成功() || 当前.状态 != 场景类数据状态::已读取
                    || !当前.场景结点)
                    return 树失败(当前.状态, 当前.事实代次,
                        请求.根场景结点);
                if (std::any_of(场景组.begin(), 场景组.end(),
                        [&](const auto& 已有) noexcept {
                            return 已有.结点 == 当前.场景结点->结点;
                        }))
                    return 树失败(场景类数据状态::内部不一致,
                        请求.期望事实代次, 请求.根场景结点);
                for (const auto& 子 : 当前.场景结点->子场景组) {
                    if (std::find(待读取.begin(), 待读取.end(),
                            子.目标结点) != 待读取.end())
                        return 树失败(场景类数据状态::内部不一致,
                            请求.期望事实代次, 请求.根场景结点);
                    待读取.push_back(子.目标结点);
                }
                场景组.push_back(*当前.场景结点);
            }
            return {场景类数据状态::已读取, 场景类数据合同版本,
                请求.期望事实代次, 请求.根场景结点,
                std::move(场景组)};
        } catch (const std::bad_alloc&) {
            return 树失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 树失败(场景类数据状态::资源失败);
        } catch (...) {
            return 树失败(场景类数据状态::内部不一致);
        }
    }

    场景类成员迁移结果 迁移成员关系(
        const 场景类成员迁移请求& 请求) {
        if (!成员迁移请求有效(请求))
            return 迁移失败(场景类成员迁移状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放成员迁移(请求)) return *重放;

            const auto 原场景 = 读取当前场景本体(
                请求.原场景, 请求.期望事实代次);
            if (!原场景.成功() || 原场景.状态 != 场景类数据状态::已读取)
                return 迁移失败(映射迁移场景读取状态(
                    原场景.状态, true), 原场景.事实代次);
            const auto 目标场景 = 读取当前场景本体(
                请求.目标场景, 请求.期望事实代次);
            if (!目标场景.成功()
                || 目标场景.状态 != 场景类数据状态::已读取)
                return 迁移失败(映射迁移场景读取状态(
                    目标场景.状态, false), 目标场景.事实代次);

            if (const auto 状态 = 验证迁移成员目标(请求))
                return 迁移失败(*状态, 请求.期望事实代次);

            const auto 类型 = 关系类型(请求.成员种类);
            const auto 归属 = 读取当前目标归属关系组(
                请求.成员结点, 类型, 请求.期望事实代次);
            if (!归属.成功)
                return 迁移失败(归属.状态, 归属.事实代次);
            if (归属.关系组.empty())
                return 迁移失败(场景类成员迁移状态::成员未找到,
                    请求.期望事实代次);
            if (std::any_of(归属.关系组.begin(), 归属.关系组.end(),
                    [&](const auto& 关系) noexcept {
                        return 关系.源节点 == 请求.目标场景;
                    }))
                return 迁移失败(场景类成员迁移状态::成员已在目标,
                    请求.期望事实代次);
            if (归属.关系组.size() != 1
                || 归属.关系组.front().源节点 != 请求.原场景)
                return 迁移失败(场景类成员迁移状态::成员多重归属,
                    请求.期望事实代次);

            if (请求.成员种类 == 场景类成员种类::子场景) {
                if (const auto 状态 = 检查迁移子场景是否形成环(请求))
                    return 迁移失败(*状态, 请求.期望事实代次);
            }

            const auto 写集 = 形成成员迁移写集(
                请求, 归属.关系组.front().编码);
            return 提交成员迁移(写集, 请求,
                归属.关系组.front().编码,
                场景类成员迁移状态::已迁移);
        } catch (const std::bad_alloc&) {
            return 迁移失败(场景类成员迁移状态::资源失败);
        } catch (const std::length_error&) {
            return 迁移失败(场景类成员迁移状态::资源失败);
        } catch (...) {
            return 迁移失败(场景类成员迁移状态::内部不一致);
        }
    }

    // 子场景关系组织场景树；其它三类关系组织场景成员列表。
    // 增删关系不换代场景身份，也不修改目标节点。
    场景类结点结果 新增成员关系(const 场景类成员新增请求& 请求) {
        if (!成员新增请求有效(请求))
            return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放新增成员(请求)) return *重放;
            const auto 本体 = 读取当前场景本体(
                请求.场景结点, 请求.期望事实代次);
            if (!本体.成功() || 本体.状态 != 场景类数据状态::已读取)
                return 本体;
            const auto 成员读取 = 读取当前源关系组(请求.场景结点,
                关系类型(请求.成员种类), 请求.期望事实代次);
            if (!成员读取.成功)
                return 失败(成员读取.状态, 成员读取.事实代次);
            if (std::any_of(成员读取.关系组.begin(), 成员读取.关系组.end(),
                    [&](const auto& 关系) noexcept {
                        return 关系.目标节点 == 请求.目标结点;
                    }))
                return 失败(场景类数据状态::成员已存在,
                    请求.期望事实代次);
            if (const auto 状态 = 验证成员目标(请求.成员种类,
                    请求.目标结点, 请求.期望事实代次))
                return 失败(*状态, 请求.期望事实代次);
            if (请求.成员种类 == 场景类成员种类::子场景) {
                const auto 父关系 = 读取当前父关系(
                    请求.目标结点, 请求.期望事实代次);
                if (!父关系.成功)
                    return 失败(父关系.状态, 父关系.事实代次);
                if (!父关系.关系组.empty())
                    return 失败(场景类数据状态::已有父场景,
                        父关系.事实代次);
                if (const auto 环状态 = 检查新增子场景是否形成环(
                        请求.场景结点, 请求.目标结点,
                        请求.期望事实代次))
                    return 失败(*环状态, 请求.期望事实代次);
            }
            const auto 写集 = 形成新增成员写集(请求);
            return 提交成员变更(写集, 请求.幂等身份,
                场景类数据状态::已添加成员,
                请求.场景结点, 请求.成员种类, 请求.目标结点, true);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类结点结果 删除成员关系(const 场景类成员删除请求& 请求) {
        if (!成员删除请求有效(请求))
            return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放删除成员(请求)) return *重放;
            const auto 本体 = 读取当前场景本体(
                请求.场景结点, 请求.期望事实代次);
            if (!本体.成功() || 本体.状态 != 场景类数据状态::已读取)
                return 本体;
            const auto 成员读取 = 读取当前源关系组(请求.场景结点,
                关系类型(请求.成员种类), 请求.期望事实代次);
            if (!成员读取.成功)
                return 失败(成员读取.状态, 成员读取.事实代次);
            const auto it = std::find_if(成员读取.关系组.begin(),
                成员读取.关系组.end(), [&](const auto& 关系) noexcept {
                    return 关系.目标节点 == 请求.目标结点;
                });
            if (it == 成员读取.关系组.end())
                return 失败(场景类数据状态::成员未找到,
                请求.期望事实代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.退出事实 = {it->编码};
            return 提交成员变更(写集, 请求.幂等身份,
                场景类数据状态::已移除成员,
                请求.场景结点, 请求.成员种类, 请求.目标结点, false);
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

    场景类宿主存在结果 建立场景宿主存在关系(
        const 场景类宿主存在写请求& 请求) {
        if (!宿主写请求有效(请求))
            return 宿主失败(场景类宿主存在状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放建立宿主关系(请求))
                return *重放;
            const auto 场景 = 读取当前场景本体(
                请求.场景, 请求.期望事实代次);
            if (!场景.成功() || 场景.状态 != 场景类数据状态::已读取)
                return 宿主失败(映射宿主场景状态(场景.状态), 场景.事实代次);
            const auto 存在 = 存在服务_.查询存在({存在类数据合同版本,
                请求.期望事实代次, 请求.宿主存在});
            if (!存在.成功() || 存在.状态 != 存在类数据状态::已读取)
                return 宿主失败(映射宿主存在状态(存在.状态), 存在.事实代次);
            const auto 源组 = 读取当前宿主源关系组(
                请求.场景, 请求.期望事实代次);
            if (!源组.成功) return 宿主失败(源组.状态, 源组.事实代次);
            if (源组.关系组.size() > 1)
                return 宿主失败(场景类宿主存在状态::关系复义, 源组.事实代次);
            if (!源组.关系组.empty())
                return 宿主失败(场景类宿主存在状态::场景已有宿主, 源组.事实代次);
            const auto 目标组 = 读取当前宿主目标关系组(
                请求.宿主存在, 请求.期望事实代次);
            if (!目标组.成功) return 宿主失败(目标组.状态, 目标组.事实代次);
            if (目标组.关系组.size() > 1)
                return 宿主失败(场景类宿主存在状态::关系复义, 目标组.事实代次);
            if (!目标组.关系组.empty())
                return 宿主失败(
                    场景类宿主存在状态::宿主已有内部世界场景, 目标组.事实代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.关系 = {{场景类数据内部::宿主存在关系本地键,
                请求.场景, 请求.宿主存在, 宿主存在关系类型_, 1}};
            return 提交建立宿主关系(写集, 请求);
        } catch (const std::bad_alloc&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (const std::length_error&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (...) {
            return 宿主失败(场景类宿主存在状态::内部不一致);
        }
    }

    场景类宿主存在结果 退出场景宿主存在关系(
        const 场景类宿主存在写请求& 请求) {
        if (!宿主写请求有效(请求))
            return 宿主失败(场景类宿主存在状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放退出宿主关系(请求))
                return *重放;
            const auto 当前 = 读取当前宿主关系(
                请求.场景, 请求.宿主存在, 请求.期望事实代次);
            if (!当前.成功()) return 当前;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.写入幂等身份 = 请求.幂等身份;
            写集.退出事实 = {当前.关系->关系};
            return 提交退出宿主关系(写集, 请求);
        } catch (const std::bad_alloc&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (const std::length_error&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (...) {
            return 宿主失败(场景类宿主存在状态::内部不一致);
        }
    }

    场景类宿主存在结果 查询当前场景宿主存在关系(
        const 场景类宿主存在当前查询请求& 请求) const {
        if (!宿主当前查询请求有效(请求))
            return 宿主失败(场景类宿主存在状态::入口拒绝);
        try {
            const auto 场景 = 读取当前场景本体(请求.场景, 请求.期望事实代次);
            if (!场景.成功() || 场景.状态 != 场景类数据状态::已读取)
                return 宿主失败(映射宿主场景状态(场景.状态), 场景.事实代次);
            const auto 源组 = 读取当前宿主源关系组(
                请求.场景, 请求.期望事实代次);
            if (!源组.成功) return 宿主失败(源组.状态, 源组.事实代次);
            if (源组.关系组.empty())
                return 宿主失败(场景类宿主存在状态::关系未找到, 源组.事实代次);
            if (源组.关系组.size() != 1)
                return 宿主失败(场景类宿主存在状态::关系复义, 源组.事实代次);
            return 读取当前宿主关系(请求.场景,
                源组.关系组.front().目标节点, 请求.期望事实代次);
        } catch (const std::bad_alloc&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (const std::length_error&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (...) {
            return 宿主失败(场景类宿主存在状态::内部不一致);
        }
    }

    场景类宿主存在结果 按宿主存在查询当前场景宿主关系(
        const 场景类宿主存在反向查询请求& 请求) const {
        if (!宿主反向查询请求有效(请求))
            return 宿主失败(场景类宿主存在状态::入口拒绝);
        try {
            const auto 存在 = 存在服务_.查询存在({存在类数据合同版本,
                请求.期望事实代次, 请求.宿主存在});
            if (!存在.成功() || 存在.状态 != 存在类数据状态::已读取)
                return 宿主失败(映射宿主存在状态(存在.状态), 存在.事实代次);
            const auto 目标组 = 读取当前宿主目标关系组(
                请求.宿主存在, 请求.期望事实代次);
            if (!目标组.成功) return 宿主失败(目标组.状态, 目标组.事实代次);
            if (目标组.关系组.empty())
                return 宿主失败(场景类宿主存在状态::关系未找到, 目标组.事实代次);
            if (目标组.关系组.size() != 1)
                return 宿主失败(场景类宿主存在状态::关系复义, 目标组.事实代次);
            return 读取当前宿主关系(目标组.关系组.front().源节点,
                请求.宿主存在, 请求.期望事实代次);
        } catch (const std::bad_alloc&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (const std::length_error&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (...) {
            return 宿主失败(场景类宿主存在状态::内部不一致);
        }
    }

    场景类宿主存在结果 查询历史场景宿主存在关系(
        const 场景类宿主存在历史查询请求& 请求) const {
        if (!宿主历史查询请求有效(请求))
            return 宿主失败(场景类宿主存在状态::入口拒绝);
        try {
            return 读取历史宿主关系(请求.关系, 请求.历史截止事实代次,
                请求.历史截止事实代次, 场景类宿主存在状态::已读取历史,
                std::nullopt);
        } catch (const std::bad_alloc&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (const std::length_error&) {
            return 宿主失败(场景类宿主存在状态::资源失败);
        } catch (...) {
            return 宿主失败(场景类宿主存在状态::内部不一致);
        }
    }

    场景类结点结果 删除场景(const 场景类删除请求& 请求) {
        if (!删除请求有效(请求)) return 失败(场景类数据状态::入口拒绝);
        try {
            if (const auto 重放 = 尝试重放删除场景(请求)) return *重放;
            const auto 当前 = 读取当前场景(
                请求.场景结点, 请求.期望事实代次, false);
            if (!当前.成功() || 当前.状态 != 场景类数据状态::已读取)
                return 当前;
            if (!当前.场景结点->子场景组.empty())
                return 失败(场景类数据状态::非叶场景,
                    当前.事实代次);
            if (!当前.场景结点->父场景)
                return 失败(场景类数据状态::根场景不可删除,
                    当前.事实代次);
            const auto 宿主关系组 = 读取当前宿主源关系组(
                请求.场景结点, 请求.期望事实代次);
            if (!宿主关系组.成功)
                return 失败(映射宿主到场景状态(宿主关系组.状态),
                    宿主关系组.事实代次);
            if (宿主关系组.关系组.size() > 1)
                return 失败(场景类数据状态::内部不一致,
                    宿主关系组.事实代次);
            auto 写集 = 形成删除场景写集(请求, *当前.场景结点);
            std::optional<稳定编码> 宿主关系;
            if (!宿主关系组.关系组.empty()) {
                宿主关系 = 宿主关系组.关系组.front().编码;
                写集.退出事实.push_back(*宿主关系);
            }
            const auto 父关系 = 读取当前父关系(
                请求.场景结点, 请求.期望事实代次);
            if (!父关系.成功)
                return 失败(父关系.状态, 父关系.事实代次);
            for (const auto& 关系 : 父关系.关系组)
                写集.退出事实.push_back(关系.编码);
            std::sort(写集.退出事实.begin(), 写集.退出事实.end(),
                [](稳定编码 左, 稳定编码 右) noexcept { return 左.值 < 右.值; });
            写集.退出事实.erase(std::unique(写集.退出事实.begin(),
                写集.退出事实.end()), 写集.退出事实.end());
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(
                写入.状态, 场景类数据状态::已退出);
            if (状态 != 场景类数据状态::已退出
                && 状态 != 场景类数据状态::精确重复)
                return 失败(状态, 写入.事实代次);
            try {
                if (!写入结果头完整(写入, 请求.幂等身份))
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
                if (!写入.新编码映射.empty()
                    || !退出事实同代闭合(
                        写集.退出事实, 写入.事实代次))
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
                auto 读回 = 读取历史场景快照(请求.场景结点,
                    写入.事实代次 - 1, 写入.事实代次,
                    场景类数据状态::已退出, 写入.事实代次);
                if (!读回.成功())
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
                if (宿主关系) {
                    const auto 宿主读回 = 读取历史宿主关系(*宿主关系,
                        写入.事实代次 - 1, 写入.事实代次,
                        场景类宿主存在状态::已退出, 写入.事实代次);
                    if (!宿主读回.成功())
                        return 失败(场景类数据状态::已可能发布,
                            写入.事实代次);
                }
                读回.状态 = 状态;
                return 读回;
            } catch (const std::bad_alloc&) {
                return 失败(场景类数据状态::已可能发布, 写入.事实代次);
            } catch (const std::length_error&) {
                return 失败(场景类数据状态::已可能发布, 写入.事实代次);
            } catch (...) {
                return 失败(场景类数据状态::已可能发布, 写入.事实代次);
            }
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::资源失败);
        } catch (...) {
            return 失败(场景类数据状态::内部不一致);
        }
    }

private:
    struct 关系组读取值 final {
        bool 成功 = false;
        场景类数据状态 状态 = 场景类数据状态::内部不一致;
        std::uint64_t 事实代次 = 0;
        std::vector<L1所有者范围关系事实> 关系组;
    };

    struct 迁移关系组读取值 final {
        bool 成功 = false;
        场景类成员迁移状态 状态 = 场景类成员迁移状态::内部不一致;
        std::uint64_t 事实代次 = 0;
        std::vector<L1所有者范围关系事实> 关系组;
    };

    struct 宿主关系组读取值 final {
        bool 成功 = false;
        场景类宿主存在状态 状态 = 场景类宿主存在状态::内部不一致;
        std::uint64_t 事实代次 = 0;
        std::vector<L1所有者范围关系事实> 关系组;
    };

    bool 关系类型组有效() const noexcept {
        const std::vector<稳定编码> 类型组{子场景关系类型_, 存在关系类型_,
            状态关系类型_, 动态关系类型_, 宿主存在关系类型_};
        for (std::size_t i = 0; i < 类型组.size(); ++i) {
            if (!有效(类型组[i])) return false;
            for (std::size_t j = 0; j < i; ++j)
                if (类型组[i] == 类型组[j]) return false;
        }
        return true;
    }

    bool 关系类型有效(稳定编码 编码) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 事实 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && !读取.物理清理事实代次
            && !读取.物理清理墓碑 && 事实 && 事实->编码 == 编码
            && 事实->写入所有者 == 所有者_
            && 事实->种类 == 节点种类::普通
            && !事实->属性类型表示 && 事实->创建事实代次 != 0
            && !事实->退出事实代次;
    }

    static bool 成员种类有效(场景类成员种类 种类) noexcept {
        return 种类 == 场景类成员种类::子场景
            || 种类 == 场景类成员种类::存在
            || 种类 == 场景类成员种类::状态
            || 种类 == 场景类成员种类::动态;
    }

    static bool 新增请求有效(const 场景类新增请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份);
    }

    static bool 查询请求有效(const 场景类查询请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.场景结点);
    }

    static bool 成员新增请求有效(
        const 场景类成员新增请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.场景结点) && 成员种类有效(请求.成员种类)
            && 有效(请求.目标结点)
            && (请求.成员种类 != 场景类成员种类::子场景
                || 请求.场景结点 != 请求.目标结点);
    }

    static bool 成员删除请求有效(
        const 场景类成员删除请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.场景结点) && 成员种类有效(请求.成员种类)
            && 有效(请求.目标结点);
    }

    static bool 成员迁移请求有效(
        const 场景类成员迁移请求& 请求) noexcept {
        return 请求.合同版本 == 场景类成员迁移合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.原场景) && 有效(请求.目标场景)
            && 请求.原场景 != 请求.目标场景
            && 有效(请求.成员结点) && 请求.最大场景数量 != 0
            && (请求.成员种类 == 场景类成员种类::子场景
                || 请求.成员种类 == 场景类成员种类::存在)
            && (请求.成员种类 != 场景类成员种类::子场景
                || 请求.目标场景 != 请求.成员结点);
    }

    static bool 删除请求有效(const 场景类删除请求& 请求) noexcept {
        return 请求.合同版本 == 场景类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.场景结点);
    }

    static bool 宿主写请求有效(
        const 场景类宿主存在写请求& 请求) noexcept {
        return 请求.合同版本 == 场景类宿主存在合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.场景) && 有效(请求.宿主存在);
    }

    static bool 宿主当前查询请求有效(
        const 场景类宿主存在当前查询请求& 请求) noexcept {
        return 请求.合同版本 == 场景类宿主存在合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.场景);
    }

    static bool 宿主反向查询请求有效(
        const 场景类宿主存在反向查询请求& 请求) noexcept {
        return 请求.合同版本 == 场景类宿主存在合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.宿主存在);
    }

    static bool 宿主历史查询请求有效(
        const 场景类宿主存在历史查询请求& 请求) noexcept {
        return 请求.合同版本 == 场景类宿主存在合同版本
            && 请求.历史截止事实代次 != 0 && 有效(请求.关系);
    }

    稳定编码 关系类型(场景类成员种类 种类) const noexcept {
        switch (种类) {
        case 场景类成员种类::子场景:
            return 子场景关系类型_;
        case 场景类成员种类::存在:
            return 存在关系类型_;
        case 场景类成员种类::状态:
            return 状态关系类型_;
        case 场景类成员种类::动态:
            return 动态关系类型_;
        }
        return {};
    }

    static const std::vector<场景类成员引用>& 选择成员组(
        const 场景类结点& 场景, 场景类成员种类 种类) noexcept {
        switch (种类) {
        case 场景类成员种类::子场景:
            return 场景.子场景组;
        case 场景类成员种类::存在:
            return 场景.存在组;
        case 场景类成员种类::状态:
            return 场景.状态组;
        case 场景类成员种类::动态:
            return 场景.动态组;
        }
        return 场景.子场景组;
    }

    static std::vector<场景类成员引用>& 选择成员组(
        场景类结点& 场景, 场景类成员种类 种类) noexcept {
        switch (种类) {
        case 场景类成员种类::子场景:
            return 场景.子场景组;
        case 场景类成员种类::存在:
            return 场景.存在组;
        case 场景类成员种类::状态:
            return 场景.状态组;
        case 场景类成员种类::动态:
            return 场景.动态组;
        }
        return 场景.子场景组;
    }

    static const 场景类成员引用* 查找成员(
        const std::vector<场景类成员引用>& 成员组,
        稳定编码 目标) noexcept {
        const auto it = std::find_if(成员组.begin(), 成员组.end(),
            [&](const auto& 成员) noexcept { return 成员.目标结点 == 目标; });
        return it == 成员组.end() ? nullptr : &*it;
    }

    std::optional<场景类数据状态> 验证成员目标(
        场景类成员种类 种类, 稳定编码 目标,
        std::uint64_t 期望事实代次) const {
        switch (种类) {
        case 场景类成员种类::子场景: {
            const auto 读取 = 读取当前场景本体(目标, 期望事实代次);
            if (读取.成功() && 读取.状态 == 场景类数据状态::已读取)
                return std::nullopt;
            if (读取.状态 == 场景类数据状态::事实代次漂移
                || 读取.状态 == 场景类数据状态::资源失败
                || 读取.状态 == 场景类数据状态::入口拒绝)
                return 读取.状态;
            return 场景类数据状态::子场景读取失败;
        }
        case 场景类成员种类::存在: {
            const auto 读取 = 存在服务_.查询存在(
                {存在类数据合同版本, 期望事实代次, 目标});
            if (读取.成功() && 读取.状态 == 存在类数据状态::已读取
                && 读取.事实代次 == 期望事实代次
                && 读取.存在结点 && 读取.存在结点->结点 == 目标)
                return std::nullopt;
            return 映射存在状态(读取.状态);
        }
        case 场景类成员种类::状态: {
            const auto 读取 = 状态服务_.查询状态(
                {状态类数据合同版本, 期望事实代次, 目标});
            if (读取.成功() && 读取.状态 == 状态类数据状态::已读取
                && 读取.事实代次 == 期望事实代次
                && 读取.状态结点 && 读取.状态结点->结点 == 目标)
                return std::nullopt;
            return 映射状态状态(读取.状态);
        }
        case 场景类成员种类::动态: {
            const auto 读取 = 动态服务_.查询动态(
                {动态类数据合同版本, 期望事实代次, 目标});
            if (读取.成功() && 读取.状态 == 动态类数据状态::已读取
                && 读取.事实代次 == 期望事实代次
                && 读取.动态结点 && 读取.动态结点->结点 == 目标)
                return std::nullopt;
            return 映射动态状态(读取.状态);
        }
        }
        return 场景类数据状态::入口拒绝;
    }

    std::optional<场景类成员迁移状态> 验证迁移成员目标(
        const 场景类成员迁移请求& 请求) const {
        if (请求.成员种类 == 场景类成员种类::子场景) {
            const auto 读取 = 读取当前场景本体(
                请求.成员结点, 请求.期望事实代次);
            if (读取.成功() && 读取.状态 == 场景类数据状态::已读取
                && 读取.事实代次 == 请求.期望事实代次
                && 读取.场景结点
                && 读取.场景结点->结点 == 请求.成员结点)
                return std::nullopt;
            switch (读取.状态) {
            case 场景类数据状态::事实代次漂移:
                return 场景类成员迁移状态::事实代次漂移;
            case 场景类数据状态::历史材料已清理:
                return 场景类成员迁移状态::历史材料已清理;
            case 场景类数据状态::资源失败:
                return 场景类成员迁移状态::资源失败;
            case 场景类数据状态::内部不一致:
                return 场景类成员迁移状态::内部不一致;
            default:
                return 场景类成员迁移状态::子场景读取失败;
            }
        }
        const auto 读取 = 存在服务_.查询存在(
            {存在类数据合同版本, 请求.期望事实代次, 请求.成员结点});
        if (读取.成功() && 读取.状态 == 存在类数据状态::已读取
            && 读取.事实代次 == 请求.期望事实代次
            && 读取.存在结点
            && 读取.存在结点->结点 == 请求.成员结点)
            return std::nullopt;
        switch (读取.状态) {
        case 存在类数据状态::事实代次漂移:
            return 场景类成员迁移状态::事实代次漂移;
        case 存在类数据状态::历史材料已清理:
            return 场景类成员迁移状态::历史材料已清理;
        case 存在类数据状态::资源失败:
            return 场景类成员迁移状态::资源失败;
        case 存在类数据状态::内部不一致:
            return 场景类成员迁移状态::内部不一致;
        default:
            return 场景类成员迁移状态::存在读取失败;
        }
    }

    迁移关系组读取值 读取当前目标归属关系组(
        稳定编码 成员结点, 稳定编码 类型,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
            {L1所有者范围CRUD合同版本, 成员结点, 类型});
        if (读取.读取事实代次 != 期望事实代次)
            return {false, 场景类成员迁移状态::事实代次漂移,
                读取.读取事实代次, {}};
        if (读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射迁移读取状态(读取.状态),
                读取.读取事实代次, {}};
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.目标节点 != 成员结点
            || 读取.关系类型节点 != 类型)
            return {false, 场景类成员迁移状态::内部不一致,
                读取.读取事实代次, {}};
        auto 关系组 = 读取.关系组;
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept {
            if (左.源节点 != 右.源节点)
                return 左.源节点.值 < 右.源节点.值;
            return 左.编码.值 < 右.编码.值;
        });
        for (std::size_t i = 0; i < 关系组.size(); ++i) {
            const auto& 关系 = 关系组[i];
            if (!有效(关系.编码) || !有效(关系.源节点)
                || 关系.目标节点 != 成员结点
                || 关系.关系类型节点 != 类型
                || 关系.写入所有者 != 所有者_
                || 关系.角色或顺序 != 1
                || 关系.创建事实代次 == 0
                || 关系.创建事实代次 > 期望事实代次
                || 关系.退出事实代次)
                return {false, 场景类成员迁移状态::内部不一致,
                    读取.读取事实代次, {}};
            if (i != 0 && 关系组[i - 1].编码 == 关系.编码)
                return {false, 场景类成员迁移状态::内部不一致,
                    读取.读取事实代次, {}};
        }
        return {true, 场景类成员迁移状态::已迁移,
            读取.读取事实代次, std::move(关系组)};
    }

    std::optional<场景类成员迁移状态> 检查迁移子场景是否形成环(
        const 场景类成员迁移请求& 请求) const {
        std::vector<稳定编码> 待读取{请求.成员结点};
        std::vector<稳定编码> 已读取;
        for (std::size_t 索引 = 0; 索引 < 待读取.size(); ++索引) {
            if (已读取.size() >= 请求.最大场景数量)
                return 场景类成员迁移状态::数量预算不足;
            const auto 当前 = 待读取[索引];
            if (当前 == 请求.目标场景)
                return 场景类成员迁移状态::形成场景环;
            if (std::find(已读取.begin(), 已读取.end(), 当前)
                != 已读取.end())
                return 场景类成员迁移状态::内部不一致;
            const auto 场景 = 读取当前场景本体(
                当前, 请求.期望事实代次);
            if (!场景.成功() || 场景.状态 != 场景类数据状态::已读取)
                return 映射迁移成员场景读取状态(场景.状态);
            const auto 子组 = 读取当前源关系组(
                当前, 子场景关系类型_, 请求.期望事实代次);
            if (!子组.成功)
                return 映射迁移成员场景读取状态(子组.状态);
            已读取.push_back(当前);
            for (const auto& 子 : 子组.关系组) {
                if (子.目标节点 == 请求.目标场景)
                    return 场景类成员迁移状态::形成场景环;
                if (std::find(已读取.begin(), 已读取.end(), 子.目标节点)
                        != 已读取.end()
                    || std::find(待读取.begin(), 待读取.end(), 子.目标节点)
                        != 待读取.end())
                    return 场景类成员迁移状态::内部不一致;
                待读取.push_back(子.目标节点);
            }
        }
        return std::nullopt;
    }

    场景类结点结果 读取当前场景本体(稳定编码 场景结点,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本, 场景结点});
        if (读取.读取事实代次 != 期望事实代次)
            return 失败(场景类数据状态::事实代次漂移,
                读取.读取事实代次);
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(读取.状态), 读取.读取事实代次);
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 场景结点 || 读取.物理清理事实代次
            || 读取.物理清理墓碑 || !节点 || 节点->编码 != 场景结点
            || 节点->写入所有者 != 所有者_
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 == 0 || 节点->退出事实代次
            || !节点->当前属性.empty())
            return 失败(场景类数据状态::内部不一致,
                读取.读取事实代次);
        场景类结点 结果;
        结果.结点 = 场景结点;
        结果.创建事实代次 = 节点->创建事实代次;
        return {场景类数据状态::已读取, 场景类数据合同版本,
            读取.读取事实代次, std::move(结果)};
    }

    关系组读取值 读取当前源关系组(稳定编码 场景结点,
        稳定编码 类型, std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 场景结点, 类型});
        if (读取.读取事实代次 != 期望事实代次)
            return {false, 场景类数据状态::事实代次漂移,
                读取.读取事实代次, {}};
        if (读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射读取状态(读取.状态),
                读取.读取事实代次, {}};
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.源节点 != 场景结点 || 读取.关系类型节点 != 类型)
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        auto 关系组 = 读取.关系组;
        if (!规范化关系组(关系组, 场景结点, 类型, std::nullopt,
                std::nullopt))
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        return {true, 场景类数据状态::已读取,
            读取.读取事实代次, std::move(关系组)};
    }

    宿主关系组读取值 读取当前宿主源关系组(稳定编码 场景,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前源关系组(
            {L1所有者范围CRUD合同版本, 场景, 宿主存在关系类型_});
        if (读取.读取事实代次 != 期望事实代次)
            return {false, 场景类宿主存在状态::事实代次漂移,
                读取.读取事实代次, {}};
        if (读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射宿主关系组读取状态(读取.状态),
                读取.读取事实代次, {}};
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.源节点 != 场景
            || 读取.关系类型节点 != 宿主存在关系类型_)
            return {false, 场景类宿主存在状态::内部不一致,
                读取.读取事实代次, {}};
        auto 关系组 = 读取.关系组;
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept { return 左.编码.值 < 右.编码.值; });
        for (const auto& 关系 : 关系组) {
            if (!宿主关系事实有效(关系, 场景, std::nullopt, false))
                return {false, 场景类宿主存在状态::内部不一致,
                    读取.读取事实代次, {}};
        }
        return {true, 场景类宿主存在状态::已读取当前,
            读取.读取事实代次, std::move(关系组)};
    }

    宿主关系组读取值 读取当前宿主目标关系组(稳定编码 宿主存在,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
            {L1所有者范围CRUD合同版本, 宿主存在, 宿主存在关系类型_});
        if (读取.读取事实代次 != 期望事实代次)
            return {false, 场景类宿主存在状态::事实代次漂移,
                读取.读取事实代次, {}};
        if (读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射宿主关系组读取状态(读取.状态),
                读取.读取事实代次, {}};
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.目标节点 != 宿主存在
            || 读取.关系类型节点 != 宿主存在关系类型_)
            return {false, 场景类宿主存在状态::内部不一致,
                读取.读取事实代次, {}};
        auto 关系组 = 读取.关系组;
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept { return 左.编码.值 < 右.编码.值; });
        for (const auto& 关系 : 关系组) {
            if (!宿主关系事实有效(
                    关系, std::nullopt, 宿主存在, false))
                return {false, 场景类宿主存在状态::内部不一致,
                    读取.读取事实代次, {}};
        }
        return {true, 场景类宿主存在状态::已读取当前,
            读取.读取事实代次, std::move(关系组)};
    }

    场景类宿主存在结果 读取当前宿主关系(稳定编码 场景,
        稳定编码 宿主存在, std::uint64_t 期望事实代次) const {
        const auto 场景读取 = 读取当前场景本体(场景, 期望事实代次);
        if (!场景读取.成功()
            || 场景读取.状态 != 场景类数据状态::已读取)
            return 宿主失败(映射宿主场景状态(场景读取.状态),
                场景读取.事实代次);
        const auto 存在读取 = 存在服务_.查询存在({存在类数据合同版本,
            期望事实代次, 宿主存在});
        if (!存在读取.成功()
            || 存在读取.状态 != 存在类数据状态::已读取)
            return 宿主失败(映射宿主存在状态(存在读取.状态),
                存在读取.事实代次);
        const auto 源组 = 读取当前宿主源关系组(场景, 期望事实代次);
        if (!源组.成功) return 宿主失败(源组.状态, 源组.事实代次);
        const auto 目标组 = 读取当前宿主目标关系组(
            宿主存在, 期望事实代次);
        if (!目标组.成功) return 宿主失败(目标组.状态, 目标组.事实代次);
        if (源组.关系组.empty() || 目标组.关系组.empty())
            return 宿主失败(场景类宿主存在状态::关系未找到,
                期望事实代次);
        if (源组.关系组.size() != 1 || 目标组.关系组.size() != 1)
            return 宿主失败(场景类宿主存在状态::关系复义,
                期望事实代次);
        const auto& 关系 = 源组.关系组.front();
        const auto& 反向关系 = 目标组.关系组.front();
        if (关系.编码 != 反向关系.编码 || 关系.源节点 != 场景
            || 关系.目标节点 != 宿主存在)
            return 宿主失败(场景类宿主存在状态::关系复义,
                期望事实代次);
        return {场景类宿主存在状态::已读取当前,
            场景类宿主存在合同版本, 期望事实代次,
            形成宿主关系投影(关系)};
    }

    场景类结点结果 读取当前场景(稳定编码 场景结点,
        std::uint64_t 期望事实代次, bool 验证目标) const {
        auto 本体 = 读取当前场景本体(场景结点, 期望事实代次);
        if (!本体.成功() || 本体.状态 != 场景类数据状态::已读取)
            return 本体;
        const std::vector<std::pair<场景类成员种类, 稳定编码>> 分类{
            {场景类成员种类::子场景, 子场景关系类型_},
            {场景类成员种类::存在, 存在关系类型_},
            {场景类成员种类::状态, 状态关系类型_},
            {场景类成员种类::动态, 动态关系类型_}};
        for (const auto& [种类, 类型] : 分类) {
            auto 读取 = 读取当前源关系组(场景结点, 类型,
                期望事实代次);
            if (!读取.成功) return 失败(读取.状态, 读取.事实代次);
            auto& 目标组 = 选择成员组(*本体.场景结点, 种类);
            for (const auto& 关系 : 读取.关系组) {
                if (验证目标) {
                    if (const auto 状态 = 验证成员目标(
                            种类, 关系.目标节点, 期望事实代次))
                        return 失败(*状态, 期望事实代次);
                }
                目标组.push_back({关系.编码, 关系.目标节点});
            }
        }
        const auto 父关系 = 读取当前父关系(
            场景结点, 期望事实代次);
        if (!父关系.成功)
            return 失败(父关系.状态, 父关系.事实代次);
        if (!父关系.关系组.empty()) {
            const auto& 关系 = 父关系.关系组.front();
            本体.场景结点->父场景 = 场景类成员引用{
                关系.编码, 关系.源节点};
        }
        return 本体;
    }

    L1所有者范围写集请求 形成新增成员写集(
        const 场景类成员新增请求& 请求) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.关系 = {{场景类数据内部::成员关系本地键,
            请求.场景结点, 请求.目标结点, 关系类型(请求.成员种类), 1}};
        return 写集;
    }

    L1所有者范围写集请求 形成成员迁移写集(
        const 场景类成员迁移请求& 请求,
        稳定编码 旧成员关系) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.关系 = {{场景类数据内部::成员关系本地键,
            请求.目标场景, 请求.成员结点,
            关系类型(请求.成员种类), 1}};
        写集.退出事实 = {旧成员关系};
        return 写集;
    }

    L1所有者范围写集请求 形成删除场景写集(
        const 场景类删除请求& 请求, const 场景类结点& 当前) const {
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.退出事实 = {请求.场景结点};
        const auto 加入 = [&](const auto& 成员组) {
            for (const auto& 成员 : 成员组)
                写集.退出事实.push_back(成员.成员关系);
        };
        加入(当前.子场景组);
        加入(当前.存在组);
        加入(当前.状态组);
        加入(当前.动态组);
        return 写集;
    }

    场景类结点结果 提交新增场景(
        const L1所有者范围写集请求& 写集,
        L1所有者范围写入幂等身份 幂等身份,
        场景类数据状态 成功状态) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射写入状态(写入.状态, 成功状态);
        if (状态 != 成功状态 && 状态 != 场景类数据状态::精确重复)
            return 失败(状态, 写入.事实代次);
        try {
            if (!写入结果头完整(写入, 幂等身份))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            if (写入.新编码映射.size() != 1)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            const auto 结点 = 场景类数据内部::查找唯一编码(
                写入, 场景类数据内部::场景结点本地键);
            if (!结点) return 失败(场景类数据状态::已可能发布,
                写入.事实代次);
            auto 读回 = 状态 == 场景类数据状态::精确重复
                ? 读取历史场景快照(*结点, 写入.事实代次,
                    写入.事实代次, 场景类数据状态::精确重复,
                    std::nullopt)
                : 读取当前场景(*结点, 写入.事实代次, true);
            if (!读回.成功() || !读回.场景结点
                || 读回.场景结点->结点 != *结点)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (...) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        }
    }

    场景类结点结果 提交成员变更(
        const L1所有者范围写集请求& 写集,
        L1所有者范围写入幂等身份 幂等身份,
        场景类数据状态 成功状态, 稳定编码 场景结点,
        场景类成员种类 种类, 稳定编码 目标, bool 添加) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射写入状态(写入.状态, 成功状态);
        if (状态 != 成功状态 && 状态 != 场景类数据状态::精确重复)
            return 失败(状态, 写入.事实代次);
        try {
            const std::size_t 期望映射数量 = 添加 ? 1U : 0U;
            if (!写入结果头完整(写入, 幂等身份))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            if (写入.新编码映射.size() != 期望映射数量)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            std::optional<稳定编码> 新关系;
            if (添加) {
                新关系 = 场景类数据内部::查找唯一编码(
                    写入, 场景类数据内部::成员关系本地键);
                if (!新关系)
                    return 失败(场景类数据状态::已可能发布,
                        写入.事实代次);
            } else if (写集.退出事实.size() != 1
                || !退出事实同代闭合(
                    写集.退出事实, 写入.事实代次)) {
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            }
            auto 读回 = 读取历史场景快照(场景结点, 写入.事实代次,
                写入.事实代次, 状态, std::nullopt);
            if (!读回.成功() || !读回.场景结点)
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            const auto* 成员 = 查找成员(
                选择成员组(*读回.场景结点, 种类), 目标);
            if ((添加 && (!成员 || 成员->成员关系 != *新关系))
                || (!添加 && 成员))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (...) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        }
    }

    struct 迁移投影读取值 final {
        bool 成功 = false;
        场景类成员迁移状态 状态 = 场景类成员迁移状态::内部不一致;
        场景类成员迁移投影 投影;
    };

    迁移投影读取值 读取迁移历史投影(
        const 场景类成员迁移请求& 请求, 稳定编码 旧关系,
        稳定编码 新关系, std::uint64_t 发布事实代次) const {
        const auto 旧读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 旧关系});
        if (旧读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射迁移历史读取状态(旧读取.状态), {}};
        const auto* 旧事实 = 旧读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*旧读取.事实) : nullptr;
        if (旧读取.合同版本 != L1所有者范围CRUD合同版本
            || 旧读取.查询编码 != 旧关系 || !旧事实
            || 旧事实->编码 != 旧关系
            || 旧事实->源节点 != 请求.原场景
            || 旧事实->目标节点 != 请求.成员结点
            || 旧事实->关系类型节点 != 关系类型(请求.成员种类)
            || 旧事实->角色或顺序 != 1
            || 旧事实->写入所有者 != 所有者_
            || 旧事实->创建事实代次 == 0
            || 旧事实->创建事实代次 > 请求.期望事实代次
            || 旧事实->退出事实代次 != 发布事实代次)
            return {false, 场景类成员迁移状态::幂等冲突, {}};

        const auto 新读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 新关系});
        if (新读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射迁移历史读取状态(新读取.状态), {}};
        const auto* 新事实 = 新读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*新读取.事实) : nullptr;
        if (新读取.合同版本 != L1所有者范围CRUD合同版本
            || 新读取.查询编码 != 新关系 || !新事实
            || 新事实->编码 != 新关系
            || 新事实->源节点 != 请求.目标场景
            || 新事实->目标节点 != 请求.成员结点
            || 新事实->关系类型节点 != 关系类型(请求.成员种类)
            || 新事实->角色或顺序 != 1
            || 新事实->写入所有者 != 所有者_
            || 新事实->创建事实代次 != 发布事实代次
            || (新事实->退出事实代次
                && *新事实->退出事实代次 <= 发布事实代次))
            return {false, 场景类成员迁移状态::幂等冲突, {}};
        return {true, 场景类成员迁移状态::精确重复,
            {请求.原场景, 请求.目标场景, 请求.成员种类,
                请求.成员结点, 旧关系, 新关系}};
    }

    bool 迁移当前读回完整(const 场景类成员迁移请求& 请求,
        稳定编码 旧关系, 稳定编码 新关系,
        std::uint64_t 发布事实代次) const {
        const auto 历史 = 读取迁移历史投影(
            请求, 旧关系, 新关系, 发布事实代次);
        if (!历史.成功) return false;
        const auto 原场景 = 读取当前场景本体(
            请求.原场景, 发布事实代次);
        const auto 目标场景 = 读取当前场景本体(
            请求.目标场景, 发布事实代次);
        if (!原场景.成功() || !目标场景.成功()
            || 原场景.状态 != 场景类数据状态::已读取
            || 目标场景.状态 != 场景类数据状态::已读取)
            return false;
        const auto 类型 = 关系类型(请求.成员种类);
        const auto 原组 = 读取当前源关系组(
            请求.原场景, 类型, 发布事实代次);
        const auto 目标组 = 读取当前源关系组(
            请求.目标场景, 类型, 发布事实代次);
        if (!原组.成功 || !目标组.成功
            || std::any_of(原组.关系组.begin(), 原组.关系组.end(),
                [&](const auto& 关系) noexcept {
                    return 关系.目标节点 == 请求.成员结点;
                }))
            return false;
        std::size_t 新边数量 = 0;
        for (const auto& 关系 : 目标组.关系组) {
            if (关系.目标节点 != 请求.成员结点) continue;
            ++新边数量;
            if (关系.编码 != 新关系) return false;
        }
        if (新边数量 != 1) return false;
        const auto 反向 = 读取当前目标归属关系组(
            请求.成员结点, 类型, 发布事实代次);
        return 反向.成功 && 反向.关系组.size() == 1
            && 反向.关系组.front().编码 == 新关系
            && 反向.关系组.front().源节点 == 请求.目标场景;
    }

    场景类成员迁移结果 提交成员迁移(
        const L1所有者范围写集请求& 写集,
        const 场景类成员迁移请求& 请求, 稳定编码 旧关系,
        场景类成员迁移状态 成功状态) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射迁移写入状态(写入.状态, 成功状态);
        if (状态 != 成功状态
            && 状态 != 场景类成员迁移状态::精确重复)
            return 迁移失败(状态, 写入.事实代次);
        if (成功状态 == 场景类成员迁移状态::精确重复
            && 写入.状态 != L1所有者范围写入状态::精确重复)
            return 迁移失败(场景类成员迁移状态::已可能发布,
                写入.事实代次);
        try {
            if (!写入结果头完整(写入, 请求.幂等身份)
                || 写入.新编码映射.size() != 1)
                return 迁移失败(场景类成员迁移状态::已可能发布,
                    写入.事实代次);
            const auto 新关系 = 场景类数据内部::查找唯一编码(
                写入, 场景类数据内部::成员关系本地键);
            if (!新关系)
                return 迁移失败(场景类成员迁移状态::已可能发布,
                    写入.事实代次);
            const auto 历史 = 读取迁移历史投影(
                请求, 旧关系, *新关系, 写入.事实代次);
            if (!历史.成功)
                return 迁移失败(场景类成员迁移状态::已可能发布,
                    写入.事实代次);
            if (写入.状态 == L1所有者范围写入状态::成功
                && !迁移当前读回完整(
                    请求, 旧关系, *新关系, 写入.事实代次))
                return 迁移失败(场景类成员迁移状态::已可能发布,
                    写入.事实代次);
            return {状态, 场景类成员迁移合同版本,
                写入.事实代次, 历史.投影};
        } catch (const std::bad_alloc&) {
            return 迁移失败(场景类成员迁移状态::已可能发布,
                写入.事实代次);
        } catch (const std::length_error&) {
            return 迁移失败(场景类成员迁移状态::已可能发布,
                写入.事实代次);
        } catch (...) {
            return 迁移失败(场景类成员迁移状态::已可能发布,
                写入.事实代次);
        }
    }

    std::optional<场景类成员迁移结果> 尝试重放成员迁移(
        const 场景类成员迁移请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功)
            return 迁移失败(映射迁移读取状态(首次->状态),
                首次->读取事实代次);
        if (!首次->首次规范化写集 || !首次->首次写入结果)
            return 迁移失败(场景类成员迁移状态::幂等冲突,
                首次->读取事实代次);
        const auto& 写集 = *首次->首次规范化写集;
        const auto& 首次结果 = *首次->首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || 写集.关系.size() != 1
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.size() != 1
            || 首次结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(首次结果, 请求.幂等身份)
            || 首次结果.新编码映射.size() != 1)
            return 迁移失败(场景类成员迁移状态::幂等冲突,
                首次结果.事实代次);
        const auto& 关系 = 写集.关系.front();
        const auto* 源 = std::get_if<稳定编码>(&关系.源节点);
        const auto* 目标 = std::get_if<稳定编码>(&关系.目标节点);
        const auto* 类型 = std::get_if<稳定编码>(&关系.关系类型节点);
        if (关系.本地键 != 场景类数据内部::成员关系本地键
            || !源 || *源 != 请求.目标场景
            || !目标 || *目标 != 请求.成员结点
            || !类型 || *类型 != 关系类型(请求.成员种类)
            || 关系.角色或顺序 != 1)
            return 迁移失败(场景类成员迁移状态::幂等冲突,
                首次结果.事实代次);
        const auto 新关系 = 场景类数据内部::查找唯一编码(
            首次结果, 场景类数据内部::成员关系本地键);
        if (!新关系)
            return 迁移失败(场景类成员迁移状态::幂等冲突,
                首次结果.事实代次);
        const auto 历史 = 读取迁移历史投影(请求,
            写集.退出事实.front(), *新关系, 首次结果.事实代次);
        if (!历史.成功)
            return 迁移失败(历史.状态, 首次结果.事实代次);
        return 提交成员迁移(写集, 请求,
            写集.退出事实.front(), 场景类成员迁移状态::精确重复);
    }

    std::optional<场景类结点结果> 尝试重放新增场景(
        const 场景类新增请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        L1所有者范围写集请求 期望;
        期望.合同版本 = L1所有者范围CRUD合同版本;
        期望.期望事实代次 = 请求.期望事实代次;
        期望.写入幂等身份 = 请求.幂等身份;
        期望.节点 = {{场景类数据内部::场景结点本地键,
            节点种类::普通, std::nullopt}};
        if (*首次->首次规范化写集 != 期望
            || 首次->首次写入结果->状态
                != L1所有者范围写入状态::成功)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        return 提交新增场景(期望, 请求.幂等身份,
            场景类数据状态::精确重复);
    }

    std::optional<场景类结点结果> 尝试重放新增成员(
        const 场景类成员新增请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        const auto 期望 = 形成新增成员写集(请求);
        if (*首次->首次规范化写集 != 期望
            || 首次->首次写入结果->状态
                != L1所有者范围写入状态::成功)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        return 提交成员变更(期望, 请求.幂等身份,
            场景类数据状态::精确重复, 请求.场景结点,
            请求.成员种类, 请求.目标结点, true);
    }

    std::optional<场景类结点结果> 尝试重放删除成员(
        const 场景类成员删除请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        const auto& 写集 = *首次->首次规范化写集;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.size() != 1
            || 首次->首次写入结果->状态
                != L1所有者范围写入状态::成功)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        const auto 历史 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 写集.退出事实.front()});
        const auto* 关系 = 历史.事实
            ? std::get_if<L1所有者范围关系事实>(&*历史.事实) : nullptr;
        if (历史.状态 != L1所有者范围读取状态::成功 || !关系
            || 关系->编码 != 写集.退出事实.front()
            || 关系->写入所有者 != 所有者_
            || 关系->源节点 != 请求.场景结点
            || 关系->目标节点 != 请求.目标结点
            || 关系->关系类型节点 != 关系类型(请求.成员种类)
            || 关系->退出事实代次
                != 首次->首次写入结果->事实代次)
            return 失败(场景类数据状态::幂等冲突,
                首次->首次写入结果->事实代次);
        return 提交成员变更(写集, 请求.幂等身份,
            场景类数据状态::精确重复, 请求.场景结点,
            请求.成员种类, 请求.目标结点, false);
    }

    场景类宿主存在结果 提交建立宿主关系(
        const L1所有者范围写集请求& 写集,
        const 场景类宿主存在写请求& 请求) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射宿主写入状态(
            写入.状态, 场景类宿主存在状态::已建立);
        if (状态 != 场景类宿主存在状态::已建立
            && 状态 != 场景类宿主存在状态::精确重复)
            return 宿主失败(状态, 写入.事实代次);
        try {
            if (!写入结果头完整(写入, 请求.幂等身份)
                || 写入.新编码映射.size() != 1)
                return 宿主失败(场景类宿主存在状态::已可能发布,
                    写入.事实代次);
            const auto 关系 = 场景类数据内部::查找唯一编码(
                写入, 场景类数据内部::宿主存在关系本地键);
            if (!关系)
                return 宿主失败(场景类宿主存在状态::已可能发布,
                    写入.事实代次);
            auto 读回 = 状态 == 场景类宿主存在状态::精确重复
                ? 读取历史宿主关系(*关系, 写入.事实代次,
                    写入.事实代次, 场景类宿主存在状态::精确重复,
                    std::nullopt)
                : 读取当前宿主关系(
                    请求.场景, 请求.宿主存在, 写入.事实代次);
            if (!读回.成功() || !读回.关系
                || 读回.关系->关系 != *关系
                || 读回.关系->场景 != 请求.场景
                || 读回.关系->宿主存在 != 请求.宿主存在
                || 读回.关系->创建事实代次 != 写入.事实代次)
                return 宿主失败(场景类宿主存在状态::已可能发布,
                    写入.事实代次);
            if (状态 == 场景类宿主存在状态::精确重复)
                读回.关系->退出事实代次.reset();
            读回.状态 = 状态;
            return 读回;
        } catch (...) {
            return 宿主失败(场景类宿主存在状态::已可能发布,
                写入.事实代次);
        }
    }

    场景类宿主存在结果 提交退出宿主关系(
        const L1所有者范围写集请求& 写集,
        const 场景类宿主存在写请求& 请求) {
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        const auto 状态 = 映射宿主写入状态(
            写入.状态, 场景类宿主存在状态::已退出);
        if (状态 != 场景类宿主存在状态::已退出
            && 状态 != 场景类宿主存在状态::精确重复)
            return 宿主失败(状态, 写入.事实代次);
        try {
            if (!写入结果头完整(写入, 请求.幂等身份)
                || !写入.新编码映射.empty()
                || 写集.退出事实.size() != 1
                || !退出事实同代闭合(写集.退出事实, 写入.事实代次))
                return 宿主失败(场景类宿主存在状态::已可能发布,
                    写入.事实代次);
            auto 历史 = 读取历史宿主关系(写集.退出事实.front(),
                写入.事实代次 - 1, 写入.事实代次,
                场景类宿主存在状态::已退出, 写入.事实代次);
            if (!历史.成功() || !历史.关系
                || 历史.关系->场景 != 请求.场景
                || 历史.关系->宿主存在 != 请求.宿主存在)
                return 宿主失败(场景类宿主存在状态::已可能发布,
                    写入.事实代次);
            if (状态 != 场景类宿主存在状态::精确重复) {
                const auto 场景 = 读取当前场景本体(
                    请求.场景, 写入.事实代次);
                const auto 存在 = 存在服务_.查询存在({存在类数据合同版本,
                    写入.事实代次, 请求.宿主存在});
                const auto 源组 = 读取当前宿主源关系组(
                    请求.场景, 写入.事实代次);
                const auto 目标组 = 读取当前宿主目标关系组(
                    请求.宿主存在, 写入.事实代次);
                if (!场景.成功()
                    || 场景.状态 != 场景类数据状态::已读取
                    || !存在.成功()
                    || 存在.状态 != 存在类数据状态::已读取
                    || !源组.成功 || !源组.关系组.empty()
                    || !目标组.成功 || !目标组.关系组.empty())
                    return 宿主失败(场景类宿主存在状态::已可能发布,
                        写入.事实代次);
            }
            历史.状态 = 状态;
            return 历史;
        } catch (...) {
            return 宿主失败(场景类宿主存在状态::已可能发布,
                写入.事实代次);
        }
    }

    std::optional<场景类宿主存在结果> 尝试重放建立宿主关系(
        const 场景类宿主存在写请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 宿主失败(映射宿主读取状态(首次->状态),
                首次->读取事实代次);
        L1所有者范围写集请求 预期;
        预期.合同版本 = L1所有者范围CRUD合同版本;
        预期.期望事实代次 = 请求.期望事实代次;
        预期.写入幂等身份 = 请求.幂等身份;
        预期.关系 = {{场景类数据内部::宿主存在关系本地键,
            请求.场景, 请求.宿主存在, 宿主存在关系类型_, 1}};
        if (*首次->首次规范化写集 != 预期
            || 首次->首次写入结果->状态
                != L1所有者范围写入状态::成功
            || !写入结果头完整(
                *首次->首次写入结果, 请求.幂等身份)
            || 首次->首次写入结果->新编码映射.size() != 1)
            return 宿主失败(场景类宿主存在状态::幂等冲突,
                首次->读取事实代次);
        return 提交建立宿主关系(预期, 请求);
    }

    std::optional<场景类宿主存在结果> 尝试重放退出宿主关系(
        const 场景类宿主存在写请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 宿主失败(映射宿主读取状态(首次->状态),
                首次->读取事实代次);
        const auto& 写集 = *首次->首次规范化写集;
        const auto& 结果 = *首次->首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.size() != 1
            || 结果.状态 != L1所有者范围写入状态::成功
            || !写入结果头完整(结果, 请求.幂等身份)
            || !结果.新编码映射.empty())
            return 宿主失败(场景类宿主存在状态::幂等冲突,
                结果.事实代次);
        const auto 历史 = 读取历史宿主关系(写集.退出事实.front(),
            结果.事实代次 - 1, 结果.事实代次,
            场景类宿主存在状态::已退出, 结果.事实代次);
        if (!历史.成功()) {
            if (历史.状态 == 场景类宿主存在状态::历史材料已清理
                || 历史.状态 == 场景类宿主存在状态::资源失败)
                return 历史;
            return 宿主失败(场景类宿主存在状态::幂等冲突,
                结果.事实代次);
        }
        if (!历史.关系 || 历史.关系->场景 != 请求.场景
            || 历史.关系->宿主存在 != 请求.宿主存在)
            return 宿主失败(场景类宿主存在状态::幂等冲突,
                结果.事实代次);
        return 提交退出宿主关系(写集, 请求);
    }

    std::optional<场景类结点结果> 尝试重放删除场景(
        const 场景类删除请求& 请求) {
        const auto 首次 = 读取首次写入(请求.幂等身份);
        if (!首次) return std::nullopt;
        if (首次->状态 != L1所有者范围读取状态::成功
            || !首次->首次规范化写集 || !首次->首次写入结果)
            return 失败(映射读取状态(首次->状态), 首次->读取事实代次);
        const auto& 写集 = *首次->首次规范化写集;
        const auto& 结果 = *首次->首次写入结果;
        if (写集.合同版本 != L1所有者范围CRUD合同版本
            || 写集.期望事实代次 != 请求.期望事实代次
            || 写集.写入幂等身份 != 请求.幂等身份
            || !写集.节点.empty() || !写集.关系.empty()
            || !写集.值.empty() || !写集.属性槽变更.empty()
            || 写集.退出事实.empty()
            || std::count(写集.退出事实.begin(), 写集.退出事实.end(),
                请求.场景结点) != 1
            || 结果.状态 != L1所有者范围写入状态::成功
            || !删除场景写集闭合(写集, 请求.场景结点,
                结果.事实代次))
            return 失败(场景类数据状态::幂等冲突, 结果.事实代次);
        const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
        if (写入.状态 != L1所有者范围写入状态::精确重复
            || !写入结果头完整(写入, 请求.幂等身份))
            return 失败(场景类数据状态::已可能发布,
                写入.事实代次);
        try {
            if (!写入.新编码映射.empty()
                || !退出事实同代闭合(
                    写集.退出事实, 写入.事实代次))
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            auto 读回 = 读取历史场景快照(请求.场景结点,
                写入.事实代次 - 1, 写入.事实代次,
                场景类数据状态::精确重复, 写入.事实代次);
            if (!读回.成功())
                return 失败(场景类数据状态::已可能发布,
                    写入.事实代次);
            读回.状态 = 场景类数据状态::精确重复;
            return 读回;
        } catch (const std::bad_alloc&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (const std::length_error&) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        } catch (...) {
            return 失败(场景类数据状态::已可能发布, 写入.事实代次);
        }
    }

    std::optional<L1所有者范围首次写入读取结果> 读取首次写入(
        L1所有者范围写入幂等身份 幂等身份) const {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到)
            return std::nullopt;
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_
            || 首次.写入幂等身份 != 幂等身份)
            return L1所有者范围首次写入读取结果{};
        return 首次;
    }

    场景类宿主存在结果 读取历史宿主关系(稳定编码 关系编码,
        std::uint64_t 历史截止事实代次, std::uint64_t 结果事实代次,
        场景类宿主存在状态 返回状态,
        std::optional<std::uint64_t> 要求退出事实代次) const {
        if (!有效(关系编码) || 历史截止事实代次 == 0
            || 结果事实代次 == 0)
            return 宿主失败(场景类宿主存在状态::内部不一致,
                结果事实代次);
        const auto 读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 关系编码});
        if (读取.状态 != L1所有者范围读取状态::成功)
            return 宿主失败(映射宿主读取状态(读取.状态),
                读取.读取事实代次);
        const auto* 关系 = 读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*读取.事实) : nullptr;
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.查询编码 != 关系编码 || !关系
            || !宿主关系事实有效(*关系, std::nullopt, std::nullopt, true)
            || (要求退出事实代次
                && 关系->退出事实代次 != 要求退出事实代次))
            return 宿主失败(场景类宿主存在状态::内部不一致,
                读取.读取事实代次);
        if (关系->创建事实代次 > 历史截止事实代次)
            return 宿主失败(场景类宿主存在状态::关系未找到,
                读取.读取事实代次);
        return {返回状态, 场景类宿主存在合同版本, 结果事实代次,
            形成宿主关系投影(*关系)};
    }

    bool 宿主关系事实有效(const L1所有者范围关系事实& 关系,
        std::optional<稳定编码> 场景,
        std::optional<稳定编码> 宿主存在, bool 允许退出) const noexcept {
        return 有效(关系.编码) && 有效(关系.源节点)
            && 有效(关系.目标节点)
            && (!场景 || 关系.源节点 == *场景)
            && (!宿主存在 || 关系.目标节点 == *宿主存在)
            && 关系.关系类型节点 == 宿主存在关系类型_
            && 关系.写入所有者 == 所有者_
            && 关系.角色或顺序 == 1 && 关系.创建事实代次 != 0
            && (允许退出 || !关系.退出事实代次)
            && (!关系.退出事实代次
                || *关系.退出事实代次 > 关系.创建事实代次);
    }

    static 场景类宿主存在关系 形成宿主关系投影(
        const L1所有者范围关系事实& 关系) noexcept {
        return {关系.编码, 关系.源节点, 关系.目标节点,
            关系.创建事实代次, 关系.退出事实代次};
    }

    场景类结点结果 读取历史场景快照(稳定编码 场景结点,
        std::uint64_t 历史截止事实代次, std::uint64_t 结果事实代次,
        场景类数据状态 返回状态,
        std::optional<std::uint64_t> 要求退出事实代次) const {
        if (历史截止事实代次 == 0 || 结果事实代次 == 0)
            return 失败(场景类数据状态::内部不一致, 结果事实代次);
        const auto 节点读取 = 第一层服务_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 场景结点});
        if (节点读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(节点读取.状态),
                节点读取.读取事实代次);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 场景结点 || !节点
            || 节点->编码 != 场景结点 || 节点->写入所有者 != 所有者_
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
            || 节点->创建事实代次 == 0
            || 节点->创建事实代次 > 历史截止事实代次
            || (节点->退出事实代次
                && *节点->退出事实代次 <= 历史截止事实代次)
            || (要求退出事实代次
                && 节点->退出事实代次 != 要求退出事实代次)
            || !节点->当前属性.empty())
            return 失败(场景类数据状态::内部不一致,
                节点读取.读取事实代次);
        场景类结点 结果;
        结果.结点 = 场景结点;
        结果.创建事实代次 = 节点->创建事实代次;
        结果.退出事实代次 = 要求退出事实代次;
        const std::vector<std::pair<场景类成员种类, 稳定编码>> 分类{
            {场景类成员种类::子场景, 子场景关系类型_},
            {场景类成员种类::存在, 存在关系类型_},
            {场景类成员种类::状态, 状态关系类型_},
            {场景类成员种类::动态, 动态关系类型_}};
        for (const auto& [种类, 类型] : 分类) {
            const auto 读取 = 第一层服务_.读取所有者范围历史关系组(
                {L1所有者范围CRUD合同版本,
                    L1所有者范围关系端点方向::源, 场景结点, 类型,
                    历史截止事实代次});
            if (读取.状态 != L1所有者范围读取状态::成功)
                return 失败(映射读取状态(读取.状态),
                    读取.读取事实代次);
            if (读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.方向 != L1所有者范围关系端点方向::源
                || 读取.端点节点 != 场景结点
                || 读取.关系类型节点 != 类型
                || 读取.历史截止事实代次 != 历史截止事实代次)
                return 失败(场景类数据状态::内部不一致,
                    读取.读取事实代次);
            auto 关系组 = 读取.关系组;
            if (!规范化关系组(关系组, 场景结点, 类型,
                    历史截止事实代次, 要求退出事实代次))
                return 失败(场景类数据状态::内部不一致,
                    读取.读取事实代次);
            auto& 成员组 = 选择成员组(结果, 种类);
            for (const auto& 关系 : 关系组)
                成员组.push_back({关系.编码, 关系.目标节点});
        }
        const auto 父读取 = 第一层服务_.读取所有者范围历史关系组(
            {L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::目标, 场景结点,
                子场景关系类型_, 历史截止事实代次});
        if (父读取.状态 != L1所有者范围读取状态::成功)
            return 失败(映射读取状态(父读取.状态),
                父读取.读取事实代次);
        if (父读取.合同版本 != L1所有者范围CRUD合同版本
            || 父读取.方向 != L1所有者范围关系端点方向::目标
            || 父读取.端点节点 != 场景结点
            || 父读取.关系类型节点 != 子场景关系类型_
            || 父读取.历史截止事实代次 != 历史截止事实代次
            || 父读取.关系组.size() > 1)
            return 失败(场景类数据状态::内部不一致,
                父读取.读取事实代次);
        if (!父读取.关系组.empty()) {
            const auto& 关系 = 父读取.关系组.front();
            if (!有效(关系.编码) || !有效(关系.源节点)
                || 关系.目标节点 != 场景结点
                || 关系.关系类型节点 != 子场景关系类型_
                || 关系.写入所有者 != 所有者_
                || 关系.角色或顺序 != 1
                || 关系.创建事实代次 > 历史截止事实代次
                || (关系.退出事实代次
                    && *关系.退出事实代次 <= 历史截止事实代次)
                || (要求退出事实代次
                    && 关系.退出事实代次 != 要求退出事实代次))
                return 失败(场景类数据状态::内部不一致,
                    父读取.读取事实代次);
            结果.父场景 = 场景类成员引用{
                关系.编码, 关系.源节点};
        }
        return {返回状态, 场景类数据合同版本,
            结果事实代次, std::move(结果)};
    }

    关系组读取值 读取当前父关系(稳定编码 子场景,
        std::uint64_t 期望事实代次) const {
        const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
            {L1所有者范围CRUD合同版本, 子场景, 子场景关系类型_});
        if (读取.读取事实代次 != 期望事实代次)
            return {false, 场景类数据状态::事实代次漂移,
                读取.读取事实代次, {}};
        if (读取.状态 != L1所有者范围读取状态::成功)
            return {false, 映射读取状态(读取.状态),
                读取.读取事实代次, {}};
        if (读取.合同版本 != L1所有者范围CRUD合同版本
            || 读取.目标节点 != 子场景
            || 读取.关系类型节点 != 子场景关系类型_)
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        auto 关系组 = 读取.关系组;
        if (关系组.size() > 1)
            return {false, 场景类数据状态::内部不一致,
                读取.读取事实代次, {}};
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept {
            if (左.源节点 != 右.源节点) return 左.源节点.值 < 右.源节点.值;
            return 左.编码.值 < 右.编码.值;
        });
        for (std::size_t i = 0; i < 关系组.size(); ++i) {
            const auto& 关系 = 关系组[i];
            if (!有效(关系.编码) || !有效(关系.源节点)
                || 关系.目标节点 != 子场景
                || 关系.关系类型节点 != 子场景关系类型_
                || 关系.写入所有者 != 所有者_
                || 关系.角色或顺序 != 1 || 关系.退出事实代次)
                return {false, 场景类数据状态::内部不一致,
                    读取.读取事实代次, {}};
            if (i != 0 && 关系组[i - 1].源节点 == 关系.源节点)
                return {false, 场景类数据状态::内部不一致,
                    读取.读取事实代次, {}};
            const auto 父 = 读取当前场景本体(
                关系.源节点, 期望事实代次);
            if (!父.成功() || 父.状态 != 场景类数据状态::已读取)
                return {false, 场景类数据状态::子场景读取失败,
                    父.事实代次, {}};
        }
        return {true, 场景类数据状态::已读取,
            读取.读取事实代次, std::move(关系组)};
    }

    std::optional<场景类数据状态> 检查新增子场景是否形成环(
        稳定编码 父场景, 稳定编码 子场景,
        std::uint64_t 期望事实代次) const {
        std::vector<稳定编码> 已访问;
        稳定编码 当前 = 父场景;
        while (有效(当前)) {
            if (当前 == 子场景) return 场景类数据状态::形成场景环;
            if (std::find(已访问.begin(), 已访问.end(), 当前)
                != 已访问.end())
                return 场景类数据状态::内部不一致;
            已访问.push_back(当前);
            const auto 父关系 = 读取当前父关系(
                当前, 期望事实代次);
            if (!父关系.成功) return 父关系.状态;
            if (父关系.关系组.empty()) break;
            当前 = 父关系.关系组.front().源节点;
        }
        return std::nullopt;
    }

    bool 规范化关系组(std::vector<L1所有者范围关系事实>& 关系组,
        稳定编码 源, 稳定编码 类型,
        std::optional<std::uint64_t> 历史截止事实代次,
        std::optional<std::uint64_t> 要求退出事实代次) const {
        std::sort(关系组.begin(), 关系组.end(), [](const auto& 左,
            const auto& 右) noexcept {
            if (左.目标节点 != 右.目标节点)
                return 左.目标节点.值 < 右.目标节点.值;
            return 左.编码.值 < 右.编码.值;
        });
        for (std::size_t i = 0; i < 关系组.size(); ++i) {
            const auto& 关系 = 关系组[i];
            if (!有效(关系.编码) || 关系.源节点 != 源
                || !有效(关系.目标节点) || 关系.关系类型节点 != 类型
                || 关系.写入所有者 != 所有者_
                || 关系.角色或顺序 != 1
                || (!历史截止事实代次 && 关系.退出事实代次)
                || (历史截止事实代次
                    && (关系.创建事实代次 > *历史截止事实代次
                        || (关系.退出事实代次
                            && *关系.退出事实代次
                                <= *历史截止事实代次)))
                || (要求退出事实代次
                    && 关系.退出事实代次 != 要求退出事实代次))
                return false;
            if (i != 0 && 关系组[i - 1].目标节点 == 关系.目标节点)
                return false;
        }
        return true;
    }

    bool 退出事实同代闭合(const std::vector<稳定编码>& 编码组,
        std::uint64_t 退出事实代次) const {
        if (编码组.empty() || 退出事实代次 == 0) return false;
        for (const auto 编码 : 编码组) {
            const auto 读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.查询编码 != 编码 || !读取.事实)
                return false;
            bool 闭合 = false;
            if (const auto* 节点 = std::get_if<L1所有者范围节点事实>(
                    &*读取.事实))
                闭合 = 节点->编码 == 编码
                    && 节点->写入所有者 == 所有者_
                    && 节点->退出事实代次 == 退出事实代次;
            else if (const auto* 关系 = std::get_if<L1所有者范围关系事实>(
                         &*读取.事实))
                闭合 = 关系->编码 == 编码
                    && 关系->写入所有者 == 所有者_
                    && 关系->退出事实代次 == 退出事实代次;
            if (!闭合) return false;
        }
        return true;
    }

    bool 删除场景写集闭合(const L1所有者范围写集请求& 写集,
        稳定编码 场景结点, std::uint64_t 退出事实代次) const {
        bool 找到场景结点 = false;
        std::size_t 宿主关系数量 = 0;
        for (const auto 编码 : 写集.退出事实) {
            const auto 读取 = 第一层服务_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || 读取.查询编码 != 编码 || !读取.事实)
                return false;
            if (const auto* 节点 = std::get_if<L1所有者范围节点事实>(
                    &*读取.事实)) {
                if (编码 != 场景结点 || 找到场景结点
                    || 节点->编码 != 场景结点
                    || 节点->写入所有者 != 所有者_
                    || 节点->种类 != 节点种类::普通
                    || 节点->属性类型表示
                    || 节点->退出事实代次 != 退出事实代次)
                    return false;
                找到场景结点 = true;
                continue;
            }
            const auto* 关系 = std::get_if<L1所有者范围关系事实>(
                &*读取.事实);
            if (!关系 || 关系->编码 != 编码
                || 关系->写入所有者 != 所有者_
                || 关系->退出事实代次 != 退出事实代次)
                return false;
            const bool 是出边 = 关系->源节点 == 场景结点
                && (关系->关系类型节点 == 子场景关系类型_
                    || 关系->关系类型节点 == 存在关系类型_
                    || 关系->关系类型节点 == 状态关系类型_
                    || 关系->关系类型节点 == 动态关系类型_
                    || 关系->关系类型节点 == 宿主存在关系类型_);
            const bool 是父边 = 关系->目标节点 == 场景结点
                && 关系->关系类型节点 == 子场景关系类型_;
            if ((!是出边 && !是父边) || 关系->角色或顺序 != 1)
                return false;
            if (关系->源节点 == 场景结点
                && 关系->关系类型节点 == 宿主存在关系类型_) {
                if (!宿主关系事实有效(
                        *关系, 场景结点, std::nullopt, true)
                    || ++宿主关系数量 > 1)
                    return false;
            }
        }
        return 找到场景结点;
    }

    bool 写入结果头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等身份) const noexcept {
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态
                == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_
            && 写入.写入幂等身份 == 幂等身份
            && 写入.事实代次 != 0 && (首次完整 || 重复完整);
    }

    static 场景类成员迁移结果 迁移失败(
        场景类成员迁移状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 场景类成员迁移合同版本,
            事实代次, std::nullopt};
    }

    static 场景类成员迁移状态 映射迁移场景读取状态(
        场景类数据状态 状态, bool 原场景) noexcept {
        switch (状态) {
        case 场景类数据状态::事实代次漂移:
            return 场景类成员迁移状态::事实代次漂移;
        case 场景类数据状态::历史材料已清理:
            return 场景类成员迁移状态::历史材料已清理;
        case 场景类数据状态::资源失败:
            return 场景类成员迁移状态::资源失败;
        case 场景类数据状态::内部不一致:
            return 场景类成员迁移状态::内部不一致;
        default:
            return 原场景 ? 场景类成员迁移状态::原场景未找到
                : 场景类成员迁移状态::目标场景未找到;
        }
    }

    static 场景类成员迁移状态 映射迁移成员场景读取状态(
        场景类数据状态 状态) noexcept {
        switch (状态) {
        case 场景类数据状态::事实代次漂移:
            return 场景类成员迁移状态::事实代次漂移;
        case 场景类数据状态::历史材料已清理:
            return 场景类成员迁移状态::历史材料已清理;
        case 场景类数据状态::资源失败:
            return 场景类成员迁移状态::资源失败;
        case 场景类数据状态::内部不一致:
            return 场景类成员迁移状态::内部不一致;
        default:
            return 场景类成员迁移状态::子场景读取失败;
        }
    }

    static 场景类成员迁移状态 映射迁移读取状态(
        L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::事实代次漂移:
