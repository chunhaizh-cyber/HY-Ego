    稳定编码 成员关系{};
    稳定编码 目标结点{};
    friend bool operator==(const 场景类成员引用&,
        const 场景类成员引用&) = default;
};

// 本类只承载实例场景的结构数据；需求、任务和业务身份暂不进入本服务。
struct 场景类结点 final {
    稳定编码 结点{};
    std::optional<场景类成员引用> 父场景;
    std::vector<场景类成员引用> 子场景组;
    std::vector<场景类成员引用> 存在组;
    std::vector<场景类成员引用> 状态组;
    std::vector<场景类成员引用> 动态组;
    std::uint64_t 创建事实代次 = 0;
    std::optional<std::uint64_t> 退出事实代次;
    friend bool operator==(const 场景类结点&, const 场景类结点&) = default;
};

