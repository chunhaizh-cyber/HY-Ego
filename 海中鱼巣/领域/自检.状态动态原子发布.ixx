export namespace 海中鱼巣 {

struct 状态动态原子发布自检报告 final {
    bool 总通过 = false;
    std::array<bool, 64> 验收{};
    std::size_t 失败数量 = 64;
    bool 未分类异常 = false;
};

namespace 状态动态原子发布自检内部 {

std::uint64_t 当前代次(L1事实基座服务& L1) {
    const auto 快照 = L1.读取完整快照({});
    return 快照.状态 == L1读取状态::成功 && 快照.快照 ? 快照.快照->事实代次 : 0;
}

std::size_t 键数量(const std::vector<std::pair<写集本地键, 稳定编码>>& 映射,
    std::uint32_t 首, std::uint32_t 末) noexcept {
    return static_cast<std::size_t>(std::count_if(映射.begin(), 映射.end(),
        [&](const auto& 项) { return 项.first.值 >= 首 && 项.first.值 <= 末; }));
}

bool 同一迁移动能读取请求(const 状态迁移动能读取请求& 左,
    const 状态迁移动能读取请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本
        && 左.规则版本 == 右.规则版本
        && 左.动态 == 右.动态
        && 左.动态资格值 == 右.动态资格值
        && 左.动态种类值 == 右.动态种类值
        && 左.聚合规则版本值 == 右.聚合规则版本值
        && 左.时间范围值 == 右.时间范围值
        && 左.迁移比较合同值 == 右.迁移比较合同值
        && 左.迁移差异值 == 右.迁移差异值
        && 左.比较输入引用值 == 右.比较输入引用值
        && 左.比较输入I64组值 == 右.比较输入I64组值
        && 左.主体关系 == 右.主体关系
        && 左.场景关系 == 右.场景关系
        && 左.被改变目标关系 == 右.被改变目标关系
        && 左.前状态关系 == 右.前状态关系
        && 左.后状态关系 == 右.后状态关系
        && 左.来源存在关系 == 右.来源存在关系;
}

bool 同一迁移动能事实(const 状态迁移动能事实& 左,
    const 状态迁移动能事实& 右) noexcept {
    return 左.合同版本 == 右.合同版本
        && 左.规则版本 == 右.规则版本
        && 左.读取事实截止代次 == 右.读取事实截止代次
        && 左.动态.编码 == 右.动态.编码
        && 左.动态.创建事实代次 == 右.动态.创建事实代次
        && 左.主体关系.编码 == 右.主体关系.编码
        && 左.场景关系.编码 == 右.场景关系.编码
        && 左.被改变目标关系.编码 == 右.被改变目标关系.编码
        && 左.前状态关系.编码 == 右.前状态关系.编码
        && 左.后状态关系.编码 == 右.后状态关系.编码
        && 左.来源存在关系.编码 == 右.来源存在关系.编码
        && 左.动态资格.编码 == 右.动态资格.编码
        && 左.动态种类值.编码 == 右.动态种类值.编码
        && 左.聚合规则版本值.编码 == 右.聚合规则版本值.编码
        && 左.时间范围值.编码 == 右.时间范围值.编码
        && 左.迁移比较合同值.编码 == 右.迁移比较合同值.编码
        && 左.迁移差异值.编码 == 右.迁移差异值.编码
        && 左.比较输入引用值.编码 == 右.比较输入引用值.编码
        && 左.比较输入I64组值.编码 == 右.比较输入I64组值.编码;
}

struct P16夹具 final {
    L1事实基座服务 L1;
    世界登记服务 世界{L1};
    L1场景结构服务 场景{L1, 世界};
    L1特征定义服务 定义{L1};
    L1实际存在服务 存在{L1};
    L1实际存在场景组合服务 存在组合{L1, 存在, 场景};
    L1实例特征服务 实例{L1, 场景, 定义, 存在组合};
    L1状态服务 状态{L1, 存在组合, 实例};
    特征比较服务 比较{L1, 状态, 实例};
    L1动态服务 动态{L1};
    实际存在I64实例特征读取请求 当前读取;
    std::optional<实际存在I64基准状态事实> 首态;

    bool 初始化() {
        世界登记建立请求 世界请求; 世界请求.幂等身份 = {0xC101};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        if (!世界结果.登记) return false;
        初始场景创建请求 场景请求; 场景请求.幂等身份 = {0xC102};
        场景请求.世界根 = {世界结果.登记->世界根场景, 节点种类::普通};
        场景请求.期望事实代次 = 当前代次(L1);
        const auto 场景结果 = 场景.创建初始场景(场景请求);
        if (!场景结果.事实) return false;
        初始场景读取请求 场景读取;
        场景读取.世界根 = 场景结果.事实->世界根;
        场景读取.初始场景 = 场景结果.事实->初始场景.编码;
        场景读取.场景标记值 = 场景结果.事实->场景标记.编码;
        场景读取.直接父关系 = 场景结果.事实->直接父关系.编码;

        特征定义登记请求 定义登记请求; 定义登记请求.幂等身份 = {0xC103};
        定义登记请求.期望事实代次 = 当前代次(L1);
        const auto 定义登记 = 定义.建立登记(定义登记请求);
        if (!定义登记.登记) return false;
        I64特征定义建立请求 定义请求; 定义请求.幂等身份 = {0xC104};
        定义请求.期望事实代次 = 当前代次(L1); 定义请求.下界 = -100; 定义请求.上界 = 100;
        const auto 定义结果 = 定义.建立I64特征定义(定义请求);
        if (!定义结果.事实) return false;
        I64特征定义读取请求 定义读取;
        定义读取.特征定义 = 定义结果.事实->特征定义;
        定义读取.定义标记值 = 定义结果.定义标记值;
        定义读取.下界值 = 定义结果.下界值;
        定义读取.上界值 = 定义结果.上界值;

        实例特征登记请求 实例登记请求; 实例登记请求.幂等身份 = {0xC105};
        实例登记请求.期望事实代次 = 当前代次(L1);
        const auto 实例登记 = 实例.建立登记(实例登记请求);
        if (!实例登记.登记) return false;
        实际存在登记请求 存在登记请求; 存在登记请求.幂等身份 = {0xC106};
        存在登记请求.期望事实代次 = 当前代次(L1);
        const auto 存在登记 = 存在.建立登记(存在登记请求);
        if (!存在登记.登记) return false;
        实际存在创建请求 存在请求; 存在请求.目标场景 = 场景读取;
        存在请求.幂等身份 = {0xC107}; 存在请求.期望事实代次 = 当前代次(L1);
        const auto 存在结果 = 存在组合.在初始场景创建实际存在(存在请求);
        if (!存在结果.事实) return false;
        实际存在读取请求 存在读取;
        存在读取.当前场景 = 场景读取;
        存在读取.存在 = 存在结果.事实->存在.编码;
        存在读取.资格值 = 存在结果.事实->资格.编码;
        存在读取.当前场景归属关系 = 存在结果.事实->当前场景归属关系.编码;

        实际存在I64实例特征建立请求 特征请求; 特征请求.幂等身份 = {0xC108};
        特征请求.期望事实代次 = 当前代次(L1); 特征请求.宿主 = 存在读取;
        特征请求.定义 = 定义读取; 特征请求.初始值 = -1;
        特征请求.来源节点 = 定义结果.事实->来源服务;
        const auto 特征结果 = 实例.建立实际存在I64实例特征(特征请求);
        if (!特征结果.事实) return false;
        当前读取.宿主 = 存在读取; 当前读取.定义 = 定义读取;
        当前读取.实例槽 = 特征结果.事实->实例槽;
        当前读取.宿主关系 = 特征结果.宿主关系;
        当前读取.定义关系 = 特征结果.定义关系;
        当前读取.当前值 = 特征结果.事实->当前值;
        当前读取.来源节点 = 特征结果.事实->来源节点;

        L1状态登记请求 状态请求; 状态请求.幂等身份 = {0xC109};
        状态请求.期望事实代次 = 当前代次(L1);
        if (!状态.建立登记(状态请求).登记) return false;
        特征比较登记请求 比较请求; 比较请求.幂等身份 = {0xC10A};
        比较请求.期望事实代次 = 当前代次(L1);
        if (!比较.建立登记(比较请求).登记) return false;
        I64状态迁移比较合同登记请求 合同请求;
        合同请求.幂等身份 = {0xC10B}; 合同请求.期望事实代次 = 当前代次(L1);
        合同请求.定义登记 = *定义登记.登记; 合同请求.特征定义 = 定义读取;
        合同请求.实例登记 = *实例登记.登记;
        if (!比较.登记I64状态迁移比较合同(合同请求).合同) return false;
        L1动态登记请求 动态请求; 动态请求.幂等身份 = {0xC10C};
        动态请求.期望事实代次 = 当前代次(L1);
        return 动态.建立登记(动态请求).登记.has_value();
    }

    状态动态原子发布请求 形成请求(std::uint64_t 业务身份,
        std::uint64_t 整理身份, std::uint64_t 时间) const {
        状态动态原子发布请求 请求;
        请求.整理幂等身份 = 整理身份;
        请求.后状态.业务请求身份 = 业务身份;
        请求.后状态.整理幂等身份 = 整理身份;
        请求.后状态.新状态发生时间 = 时间;
        请求.后状态.后当前 = 当前读取;
        return 请求;
    }

    bool 发布首态() {
        实际存在I64首个基准状态发布请求 请求;
        请求.幂等身份 = {0xC10D}; 请求.期望事实代次 = 当前代次(L1);
        请求.当前特征 = 当前读取; 请求.发生时间戳 = 100;
        const auto 结果 = 状态.发布实际存在I64首个基准状态(请求);
        首态 = 结果.事实;
        return 结果.状态 == L1基准状态状态::已提交 && 首态.has_value();
    }

    bool 换代(std::uint64_t 身份, std::int64_t 新值) {
        实际存在I64实例特征当前值换代请求 请求;
        请求.幂等身份 = {身份}; 请求.期望事实代次 = 当前代次(L1);
        请求.当前事实 = 当前读取; 请求.新值 = 新值;
        请求.新来源节点 = 当前读取.来源节点;
        const auto 结果 = 实例.换代实际存在I64实例特征当前值(请求);
        if (结果.状态 != 实例特征状态::已提交 || !结果.事实) return false;
        当前读取.当前值 = 结果.事实->当前值;
        当前读取.来源节点 = 结果.事实->来源节点;
        return true;
    }
};

bool 材料组正确(const L1执行证据材料& 材料, bool 含动态) noexcept {
    if (材料.执行证据模式 != L1执行证据模式::事实互证
        || 材料.业务操作标签 != 状态动态原子发布操作标签
        || 材料.共同事实截止代次 == 0 || 材料.写前事实见证组.empty()) return false;
    const std::size_t 期望提供者 = 含动态 ? 3 : 2;
    if (材料.提供者版本组.size() != 期望提供者) return false;
    bool 有L1 = false, 有P13 = false, 有P14 = !含动态;
    for (std::size_t i = 0; i < 材料.提供者版本组.size(); ++i) {
        const auto& 项 = 材料.提供者版本组[i];
        if (i && !(材料.提供者版本组[i - 1].提供者身份 < 项.提供者身份)) return false;
        有L1 = 有L1 || 项.提供者身份 == 稳定编码{0x4C31464200000001ULL};
        有P14 = 有P14 || 项.提供者身份 == 稳定编码{0x4C31445000000001ULL};
        有P13 = 有P13 || 项.提供者身份 == 稳定编码{0x4C31535000000001ULL};
        if (项.调用次数 != 1) return false;
    }
    for (std::size_t i = 0; i < 材料.写前事实见证组.size(); ++i) {
        const auto& 项 = 材料.写前事实见证组[i];
        if (项.观察事实代次 != 材料.共同事实截止代次 || !完整(项.事实摘要)) return false;
        if (i) {
            const auto& 前 = 材料.写前事实见证组[i - 1];
            if (前.对象种类 > 项.对象种类
                || (前.对象种类 == 项.对象种类 && !(前.身份 < 项.身份))) return false;
        }
    }
    return 有L1 && 有P13 && 有P14 && 完整(材料.规范化写集摘要) && 完整(材料.材料摘要);
}

} // namespace 状态动态原子发布自检内部

// P16-诊断责任：本地记录；最终责任边界为启动层顺序400观察边界。
状态动态原子发布自检报告 运行状态动态原子发布自检() {
    using namespace 状态动态原子发布自检内部;
    状态动态原子发布自检报告 报告;
    try {
        auto& 验收 = 报告.验收;
        P16夹具 夹具;
        验收[0] = 夹具.初始化();
        const auto 无前请求 = 夹具.形成请求(0xC201, 0xC202, 100);
        const auto 无前代次 = 当前代次(夹具.L1);
        const auto 无前 = 发布实际存在I64后继状态与迁移动能(
            夹具.L1, 夹具.实例, 夹具.状态, 夹具.比较, 夹具.动态, 无前请求);
        验收[1] = 无前.状态 == 状态动态原子发布状态::无前状态
            && !无前.首次证据 && !无前.后状态事实 && !无前.迁移动能事实;
        验收[2] = 当前代次(夹具.L1) == 无前代次;
        auto 坏请求 = 无前请求; 坏请求.整理幂等身份 = 0;
        验收[3] = 发布实际存在I64后继状态与迁移动能(
            夹具.L1, 夹具.实例, 夹具.状态, 夹具.比较, 夹具.动态, 坏请求).状态
            == 状态动态原子发布状态::入口拒绝;
        验收[4] = 当前代次(夹具.L1) == 无前代次;

        验收[5] = 夹具.发布首态();
        验收[6] = 夹具.换代(0xC10E, 18);
        const auto 增加请求 = 夹具.形成请求(0xC203, 0xC204, 200);
        const auto 增加前代次 = 当前代次(夹具.L1);
        const auto 增加 = 发布实际存在I64后继状态与迁移动能(
            夹具.L1, 夹具.实例, 夹具.状态, 夹具.比较, 夹具.动态, 增加请求);
        验收[7] = 增加.状态 == 状态动态原子发布状态::已发布后状态与迁移动能
            && 增加.首次证据 && 增加.后状态事实 && 增加.迁移动能事实;
        验收[8] = 增加.首次证据 && 增加.首次证据->形状
            == 状态动态原子发布形状::后状态与迁移动能;
        验收[9] = 增加.首次证据 && 增加.首次证据->发布事实代次 == 增加前代次 + 1
            && 当前代次(夹具.L1) == 增加前代次 + 1;
        验收[10] = 增加.首次证据 && 键数量(增加.首次证据->新编码映射,
            0x53000001U, 0x5300000CU) == 12;
        验收[11] = 增加.首次证据 && 键数量(增加.首次证据->新编码映射,
            0x44000001U, 0x4400000FU) == 15;
        验收[12] = 增加.首次证据 && 增加.首次证据->L1完整读回.项目组.size() == 40;
        验收[13] = 增加.首次证据 && 完整(增加.首次证据->请求意图摘要)
            && 完整(增加.首次证据->首次执行证据摘要)
            && 完整(增加.首次证据->L1确定性结果摘要);
        验收[14] = 增加.首次证据 && 增加.首次证据->P13确定性摘要 != 0
            && 增加.首次证据->P14确定性摘要.value_or(0) != 0;
        验收[15] = 增加.后状态事实 && 增加.首次证据
            && 增加.后状态事实->状态.创建事实代次 == 增加.首次证据->发布事实代次;
        验收[16] = 增加.迁移动能事实 && 增加.首次证据
            && 增加.迁移动能事实->动态.创建事实代次 == 增加.首次证据->发布事实代次;
        验收[17] = 增加.迁移动能事实 && 增加.后状态事实
            && 增加.迁移动能事实->后状态关系.目标节点 == 增加.后状态事实->状态.编码;
        验收[18] = 增加.迁移动能事实 && 夹具.首态
            && 增加.迁移动能事实->前状态关系.目标节点 == 夹具.首态->状态.编码;
        验收[19] = 增加.首次证据
            && 键数量(增加.首次证据->新编码映射, 0x44000001U, 0x4400000FU) == 15;

        const auto 审计 = 增加.首次证据 ? 夹具.L1.读取审计(
            {L1事实基座合同版本, {增加.首次证据->最终幂等键}}) : L1审计读取结果{};
        const auto* 成功审计 = 审计.记录组.empty() ? nullptr : &审计.记录组.back();
        验收[20] = 审计.状态 == L1读取状态::成功 && 成功审计
            && 成功审计->结果状态 == L1写入状态::成功;
        验收[21] = 成功审计 && 成功审计->首次执行证据材料
            && 材料组正确(*成功审计->首次执行证据材料, true);
        验收[22] = 成功审计 && 成功审计->首次执行证据摘要
            == 增加.首次证据->首次执行证据摘要;
        验收[23] = 成功审计 && 成功审计->确定性结果摘要
            == 增加.首次证据->L1确定性结果摘要;

        const auto 重复前代次 = 当前代次(夹具.L1);
        const auto 重复 = 发布实际存在I64后继状态与迁移动能(
            夹具.L1, 夹具.实例, 夹具.状态, 夹具.比较, 夹具.动态, 增加请求);
        验收[24] = 重复.状态 == 状态动态原子发布状态::幂等读回
            && 重复.来自精确重复 && 重复.首次证据;
        验收[25] = 当前代次(夹具.L1) == 重复前代次;
        验收[26] = 重复.首次证据 && 增加.首次证据
            && 重复.首次证据->请求意图摘要 == 增加.首次证据->请求意图摘要
            && 重复.首次证据->首次执行证据摘要 == 增加.首次证据->首次执行证据摘要
            && 重复.首次证据->L1确定性结果摘要 == 增加.首次证据->L1确定性结果摘要;
        验收[27] = 重复.后状态事实 && 增加.后状态事实
            && 重复.后状态事实->状态.编码 == 增加.后状态事实->状态.编码
            && 重复.迁移动能事实 && 增加.迁移动能事实
            && 同一迁移动能事实(*重复.迁移动能事实, *增加.迁移动能事实);
        auto 异义 = 增加请求; 异义.后状态.新状态发生时间 = 201;
        const auto 异义结果 = 发布实际存在I64后继状态与迁移动能(
            夹具.L1, 夹具.实例, 夹具.状态, 夹具.比较, 夹具.动态, 异义);
        验收[28] = 异义结果.状态 == 状态动态原子发布状态::冲突
            && !异义结果.首次证据 && !异义结果.后状态事实;
        验收[29] = 当前代次(夹具.L1) == 重复前代次;

        const bool 等价换代 = 夹具.换代(0xC10F, 18);
        const auto 等价请求 = 夹具.形成请求(0xC205, 0xC206, 300);
        const auto 等价前代次 = 当前代次(夹具.L1);
        const auto 等价 = 发布实际存在I64后继状态与迁移动能(
            夹具.L1, 夹具.实例, 夹具.状态, 夹具.比较, 夹具.动态, 等价请求);
        验收[30] = 等价换代 && 等价.状态 == 状态动态原子发布状态::已发布等价后状态
            && 等价.首次证据 && 等价.后状态事实 && !等价.迁移动能事实;
        验收[31] = 等价.首次证据 && 等价.首次证据->形状 == 状态动态原子发布形状::仅后状态;
        验收[32] = 等价.首次证据 && 等价.首次证据->发布事实代次 == 等价前代次 + 1;
        验收[33] = 等价.首次证据 && 等价.首次证据->新编码映射.size() == 12
            && 键数量(等价.首次证据->新编码映射, 0x44000001U, 0x4400000FU) == 0;
        验收[34] = 等价.首次证据 && 等价.首次证据->L1完整读回.项目组.size() == 17;
        验收[35] = 等价.首次证据 && 等价.首次证据->P13确定性摘要 != 0
            && !等价.首次证据->P14确定性摘要;
        const auto 等价审计 = 等价.首次证据 ? 夹具.L1.读取审计(
            {L1事实基座合同版本, {等价.首次证据->最终幂等键}}) : L1审计读取结果{};
        const auto* 等价成功 = 等价审计.记录组.empty() ? nullptr : &等价审计.记录组.back();
        验收[36] = 等价成功 && 等价成功->首次执行证据材料
            && 材料组正确(*等价成功->首次执行证据材料, false);

        const auto 映射状态 = 增加.首次证据
            ? 夹具.状态.从后继状态新编码映射形成读取请求(增加.首次证据->新编码映射)
            : 后继状态读回请求形成结果{};
        const auto 映射动态 = 增加.首次证据
            ? 夹具.动态.从迁移动能新编码映射形成读取请求(增加.首次证据->新编码映射)
            : 迁移动能读回请求形成结果{};
        验收[37] = 映射状态.状态 == 后继状态读回请求形成状态::已形成 && 映射状态.请求;
        验收[38] = 映射动态.状态 == 迁移动能读回请求形成状态::已形成 && 映射动态.请求;
        auto 缺映射 = 增加.首次证据 ? 增加.首次证据->新编码映射
            : std::vector<std::pair<写集本地键, 稳定编码>>{};
        std::erase_if(缺映射, [](const auto& 项) { return 项.first.值 == 0x4400000FU; });
        验收[39] = 夹具.动态.从迁移动能新编码映射形成读取请求(缺映射).状态
            == 迁移动能读回请求形成状态::内部不一致;
        auto 重复映射 = 增加.首次证据 ? 增加.首次证据->新编码映射
            : std::vector<std::pair<写集本地键, 稳定编码>>{};
        const auto 首状态 = std::find_if(重复映射.begin(), 重复映射.end(),
            [](const auto& 项) { return 项.first.值 == 0x53000001U; });
        if (首状态 != 重复映射.end()) 重复映射.push_back(*首状态);
        验收[40] = 夹具.状态.从后继状态新编码映射形成读取请求(重复映射).状态
            == 后继状态读回请求形成状态::内部不一致;

        验收[41] = 状态动态原子发布合同版本 == 1 && 状态动态原子发布规则版本 == 1;
        验收[42] = 状态动态原子发布意图组 == 7 && 状态动态原子发布入口变体 == 4;
        验收[43] = 状态动态原子发布操作标签 == 0x15000603U
            && 状态动态原子发布幂等域 == 0x10ULL;
        验收[44] = 增加.首次证据 && 增加.首次证据->最终幂等键
            == (0x10ULL << 56) + 增加请求.整理幂等身份;
        验收[45] = 等价.首次证据 && 等价.首次证据->最终幂等键
            == (0x10ULL << 56) + 等价请求.整理幂等身份;
        验收[46] = 增加.后状态事实 && 增加.迁移动能事实
            && 增加.后状态事实->状态.创建事实代次
                == 增加.迁移动能事实->动态.创建事实代次;
        验收[47] = 等价.后状态事实 && 等价.首次证据
            && 等价.后状态事实->状态.创建事实代次 == 等价.首次证据->发布事实代次;
        验收[48] = 重复.首次证据 && 增加.首次证据
            && 重复.首次证据->L1完整读回.状态 == 增加.首次证据->L1完整读回.状态
            && 重复.首次证据->L1完整读回.发布事实代次
                == 增加.首次证据->L1完整读回.发布事实代次
            && 重复.首次证据->L1完整读回.项目组.size()
                == 增加.首次证据->L1完整读回.项目组.size();
        验收[49] = 增加.首次证据 && 增加.首次证据->L1完整读回.状态
            == L1通用发布后读回状态::成功;
        验收[50] = 等价.首次证据 && 等价.首次证据->L1完整读回.状态
            == L1通用发布后读回状态::成功;
        验收[51] = !增加.L1失败见证 && !等价.L1失败见证 && !重复.L1失败见证;
        验收[52] = 增加.迁移动能事实 && 增加.迁移动能事实->动态种类值.材料
            == static_cast<std::int64_t>(动态种类::状态迁移);
        验收[53] = 增加.迁移动能事实 && 增加.迁移动能事实->聚合规则版本值.材料 == 0;
        验收[54] = 增加.迁移动能事实 && 增加.迁移动能事实->迁移差异值.材料 == 19;
        验收[55] = 增加.后状态事实 && 增加.后状态事实->采样I64值.材料 == 18;
        验收[56] = 等价.后状态事实 && 等价.后状态事实->采样I64值.材料 == 18;
        验收[57] = 增加.首次证据 && 增加.首次证据->后状态读取请求 == *映射状态.请求;
        验收[58] = 增加.首次证据 && 增加.首次证据->迁移动能读取请求
            && 映射动态.请求 && 同一迁移动能读取请求(
                *增加.首次证据->迁移动能读取请求, *映射动态.请求);
        验收[59] = 增加.首次证据 && 增加.首次证据->新编码映射.size() == 27;
        验收[60] = 等价.首次证据 && 等价.首次证据->新编码映射.size() == 12;
        验收[61] = 无前代次 != 0 && 增加前代次 != 0 && 等价前代次 != 0;
        验收[62] = !无前.来自精确重复 && !增加.来自精确重复 && !等价.来自精确重复;
        验收[63] = !报告.未分类异常;
    } catch (...) {
        报告.未分类异常 = true;
    }
    报告.失败数量 = static_cast<std::size_t>(std::count(
        报告.验收.begin(), 报告.验收.end(), false));
    报告.总通过 = 报告.失败数量 == 0 && !报告.未分类异常;
    return 报告;
}

} // namespace 海中鱼巣
