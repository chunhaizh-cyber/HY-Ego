inline constexpr L1所有者范围写集本地键 存在结点本地键{1};
inline constexpr L1所有者范围写集本地键 成员关系本地键{2};
inline constexpr L1所有者范围写集本地键 任务虚拟存在结点本地键{1};
inline constexpr L1所有者范围写集本地键 任务虚拟存在关系本地键{2};
