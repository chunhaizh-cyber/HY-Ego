module;

#include <array>
#include <atomic>
#include <cstdint>
#include <thread>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.自检.L1实际存在;

import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1场景结构;
import 海中鱼巣.领域.服务.L1实际存在;
import 海中鱼巣.领域.组合.L1实际存在场景;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

struct L1实际存在自检报告 final {
    bool 总通过 = false;
    std::array<bool, 24> 验收{};
    std::size_t 失败数量 = 0;
};

L1实际存在自检报告 运行L1实际存在自检() {
    L1实际存在自检报告 报告;
    try {
        L1事实基座服务 L1;
        世界登记服务 世界(L1);
        L1场景结构服务 场景(L1, 世界);
        L1实际存在服务 存在(L1);
        L1实际存在场景组合服务 组合(L1, 存在, 场景);

        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0x1001};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        初始场景创建请求 场景请求;
        场景请求.幂等身份 = {0x1002};
        if (世界结果.登记) {
            场景请求.世界根 = {世界结果.登记->世界根场景, 节点种类::普通};
            场景请求.期望事实代次 = 世界结果.登记->已验证事实代次;
        }
        const auto 场景结果 = 场景.创建初始场景(场景请求);
        报告.验收[0] = 世界结果.状态 == 世界登记状态::已提交
            && 世界结果.登记 && 场景结果.状态 == 世界结构状态::已提交
            && 场景结果.事实 && 场景结果.事实->事实截止代次 == 2;

        初始场景读取请求 场景读取;
        if (场景结果.事实) {
            场景读取.世界根 = 场景结果.事实->世界根;
            场景读取.初始场景 = 场景结果.事实->初始场景.编码;
            场景读取.场景标记值 = 场景结果.事实->场景标记.编码;
            场景读取.直接父关系 = 场景结果.事实->直接父关系.编码;
        }
        实际存在登记请求 登记请求;
        登记请求.幂等身份 = {0xA001};
        登记请求.期望事实代次 = 2;
        const auto 登记结果 = 存在.建立登记(登记请求);
        报告.验收[1] = 登记结果.状态 == 实际存在状态::已提交
            && 登记结果.登记 && 登记结果.登记->事实截止代次 == 3
            && 实际存在结构登记完整(*登记结果.登记);
        const auto 登记重复 = 存在.建立登记(登记请求);
        auto 登记冲突请求 = 登记请求; 登记冲突请求.幂等身份 = {0xA002};
        auto 错版本登记 = 登记请求; 错版本登记.合同版本 = 2;
        auto 零身份登记 = 登记请求; 零身份登记.幂等身份 = {};
        报告.验收[2] = 登记重复.状态 == 实际存在状态::幂等读回
            && 存在.建立登记(登记冲突请求).状态 == 实际存在状态::幂等冲突
            && 存在.建立登记(错版本登记).状态 == 实际存在状态::入口拒绝
            && 存在.建立登记(零身份登记).状态 == 实际存在状态::入口拒绝;

        const auto 登记快照 = L1.读取完整快照({});
        const auto 登记恢复材料 = L1.导出恢复材料({});
        bool 登记结果三副本 = false;
        bool 登记恢复拒绝矩阵 = false;
        if (登记恢复材料.材料 && 登记恢复材料.材料->领域结果见证记录组.size() == 1) {
            const auto& 记录 = 登记恢复材料.材料->领域结果见证记录组.front();
            const std::array<std::uint8_t, 32> 固定计划摘要{
                0xfa,0x14,0xf7,0xf0,0x64,0x09,0x1d,0xc6,
                0xd4,0xaa,0x39,0x9a,0x84,0x46,0x0a,0x4b,
                0xc1,0xdf,0x67,0x64,0x44,0xdd,0xb4,0x4c,
                0x63,0x41,0xd2,0x09,0x65,0xcd,0x88,0xcb};
            const std::array<std::uint8_t, 32> 固定结果见证摘要{
                0x65,0x66,0x16,0xd2,0x1f,0x50,0xbe,0x8c,
                0x84,0x06,0x2a,0xbc,0x5f,0xec,0x59,0xd6,
                0x99,0xe9,0xbb,0xd7,0x5e,0xb1,0xbd,0x2a,
                0x88,0x6b,0x02,0x69,0xf9,0x23,0x5e,0x29};
            auto 摘要等于 = [](const L1确定性摘要& 摘要,
                const std::array<std::uint8_t, 32>& 期望) noexcept {
                for (std::size_t i = 0; i < 期望.size(); ++i)
                    if (摘要.字节[i] != 期望[i]) return false;
                return true;
            };
            const L1领域结果见证计划 固定计划{L1领域结果计划格式版本, 0x15000301U,
                L1实际存在合同版本, L1实际存在规则版本, 1,
                {{1, {1}, 节点种类::普通, std::nullopt},
                 {2, {2}, 节点种类::属性类型, 值表示种类::I64}}};
            const auto 实际计划摘要 = 形成L1领域结果计划摘要(固定计划);
            const bool 固定向量成立 = 摘要等于(实际计划摘要, 固定计划摘要)
                && 记录.幂等键.值 == 0x0A0000000000A001ULL
                && 记录.发布事实代次 == 3
                && 记录.结果见证.字段组.size() == 2
                && 记录.结果见证.字段组[0].本次新编码.值 == 10
                && 记录.结果见证.字段组[1].本次新编码.值 == 11
                && 摘要等于(记录.结果见证摘要, 固定结果见证摘要);
            const auto 账 = std::find_if(登记恢复材料.材料->幂等账.begin(),
                登记恢复材料.材料->幂等账.end(), [&](const auto& 项) { return 项.幂等键 == 记录.幂等键; });
            const auto 审计 = std::find_if(登记恢复材料.材料->审计记录.begin(),
                登记恢复材料.材料->审计记录.end(), [&](const auto& 项) {
                    return 项.幂等键 == 记录.幂等键 && 项.事件 == L1审计事件::提交成功;
                });
            登记结果三副本 = 固定向量成立
                && 账 != 登记恢复材料.材料->幂等账.end()
                && 审计 != 登记恢复材料.材料->审计记录.end()
                && 账->确定性结果摘要版本 == L1确定性结果摘要版本E01
                && 审计->确定性结果摘要版本 == L1确定性结果摘要版本E01
                && 账->首次领域结果见证
                && *账->首次领域结果见证 == 记录.结果见证
                && 审计->首次领域结果见证
                && *审计->首次领域结果见证 == 记录.结果见证
                && 账->领域结果见证摘要 == 记录.结果见证摘要
                && 审计->领域结果见证摘要 == 记录.结果见证摘要;
            const auto 原材料 = *登记恢复材料.材料;
            const auto 正常候选 = L1.建立恢复候选({L1事实基座合同版本, 原材料, 3});
            const auto 正常撤销 = L1.撤销恢复候选({});
            auto 缺第三副本 = 原材料; 缺第三副本.领域结果见证记录组.clear();
            auto 重复第三副本 = 原材料;
            重复第三副本.领域结果见证记录组.push_back(重复第三副本.领域结果见证记录组.front());
            auto 错结果版本 = 原材料; 错结果版本.幂等账.back().确定性结果摘要版本 = 99;
            auto 错见证摘要 = 原材料; 错见证摘要.领域结果见证记录组.front().结果见证摘要.字节[0] ^= 0xff;
            auto 错结果摘要 = 原材料; 错结果摘要.幂等账.back().确定性结果摘要.字节[0] ^= 0xff;
            auto 缺账见证 = 原材料; 缺账见证.幂等账.back().首次领域结果见证.reset();
            auto 错审计见证 = 原材料;
            const auto 成功审计位置 = std::find_if(错审计见证.审计记录.begin(),
                错审计见证.审计记录.end(), [&](const auto& 项) {
                    return 项.幂等键 == 记录.幂等键 && 项.事件 == L1审计事件::提交成功;
                });
            if (成功审计位置 != 错审计见证.审计记录.end())
                成功审计位置->领域结果见证摘要.字节[0] ^= 0xff;
            auto 拒绝 = [&](const L1恢复材料& 材料) {
                return L1.建立恢复候选({L1事实基座合同版本, 材料, 3}).状态
                    == L1恢复状态::材料不完整;
            };
            登记恢复拒绝矩阵 = 正常候选.状态 == L1恢复状态::候选已建立
                && 正常撤销.状态 == L1恢复状态::候选已撤销
                && 拒绝(缺第三副本) && 拒绝(重复第三副本) && 拒绝(错结果版本)
                && 拒绝(错见证摘要) && 拒绝(错结果摘要) && 拒绝(缺账见证)
                && 拒绝(错审计见证);
        }
        std::size_t 登记普通 = 0, 登记属性 = 0;
        if (登记快照.快照) for (const auto& 节点 : 登记快照.快照->当前节点) {
            if (节点.创建事实代次 != 3) continue;
            if (节点.种类 == 节点种类::普通) ++登记普通;
            if (节点.种类 == 节点种类::属性类型
                && 节点.属性类型表示.has_value()
                && *节点.属性类型表示 == 值表示种类::I64) ++登记属性;
        }
        报告.验收[3] = 登记快照.快照 && 登记快照.快照->事实代次 == 3
            && 登记普通 == 1 && 登记属性 == 1
            && 登记恢复材料.状态 == L1恢复材料导出状态::成功
            && 登记结果三副本 && 登记恢复拒绝矩阵;

        const auto 存在规格 = 存在.形成实际存在写入规格({1, 1, 3});
        const auto 场景规格 = 场景.形成初始场景接纳规格({场景读取, 3});
        报告.验收[4] = 存在规格.状态 == 实际存在状态::已读取
            && 存在规格.规格 && 实际存在写入规格完整(*存在规格.规格)
            && 场景规格.状态 == 世界结构状态::已读取
            && 场景规格.规格 && 初始场景接纳规格完整(*场景规格.规格)
            && 存在规格.规格->事实截止代次 == 场景规格.规格->事实截止代次;

        实际存在创建请求 创建请求;
        创建请求.目标场景 = 场景读取;
        创建请求.幂等身份 = {0xB001};
        创建请求.期望事实代次 = 3;
        const auto 创建结果 = 组合.在初始场景创建实际存在(创建请求);
        报告.验收[5] = 创建结果.状态 == 实际存在状态::已提交
            && 创建结果.事实 && 创建结果.事实->事实截止代次 == 4
            && 实际存在事实完整(*创建结果.事实);

        const auto 创建快照 = L1.读取完整快照({});
        std::size_t 新节点 = 0, 新值 = 0, 新关系 = 0;
        if (创建快照.快照) {
            for (const auto& 节点 : 创建快照.快照->当前节点)
                if (节点.创建事实代次 == 4) ++新节点;
            for (const auto& 值 : 创建快照.快照->当前值)
                if (值.创建事实代次 == 4) ++新值;
            for (const auto& 关系 : 创建快照.快照->当前关系)
                if (关系.创建事实代次 == 4) ++新关系;
        }
        报告.验收[6] = 创建快照.快照 && 创建快照.快照->事实代次 == 4
            && 新节点 == 1 && 新值 == 1 && 新关系 == 1
            && 创建快照.快照->当前节点.size() == 9
            && 创建快照.快照->当前关系.size() == 2
            && 创建快照.快照->当前值.size() == 3
            && 创建快照.快照->永久占用编码.size() == 14;
        if (创建结果.事实 && 登记结果.登记 && 世界结果.登记) {
            报告.验收[7] = 创建结果.事实->资格.I64值 == 1
                && 创建结果.事实->资格.所属节点 == 创建结果.事实->存在
                && 创建结果.事实->资格.来源.编码 == 登记结果.登记->服务身份
                && 创建结果.事实->资格.属性类型.编码
                    == 登记结果.登记->实际存在资格属性类型;
            报告.验收[8] = 创建结果.事实->当前场景归属关系.源端
                    == 创建结果.事实->当前场景
                && 创建结果.事实->当前场景归属关系.目标端
                    == 创建结果.事实->存在
                && 创建结果.事实->当前场景归属关系.关系类型.编码
                    == 世界结果.登记->直接成员关系类型
                && 创建结果.事实->当前场景归属关系.角色或顺序 == 0;
        }
        实际存在读取请求 读取请求;
        if (创建结果.事实) {
            读取请求.当前场景 = 场景读取;
            读取请求.存在 = 创建结果.事实->存在.编码;
            读取请求.资格值 = 创建结果.事实->资格.编码;
            读取请求.当前场景归属关系 = 创建结果.事实->当前场景归属关系.编码;
        }
        const auto 正式读取 = 组合.读取实际存在(读取请求);
        报告.验收[9] = 正式读取.状态 == 实际存在状态::已读取
            && 正式读取.事实 && 正式读取.事实->事实截止代次 == 4
            && 正式读取.事实->存在 == 创建结果.事实->存在;

        const auto 重复前 = L1.读取完整快照({});
        const auto 创建重复 = 组合.在初始场景创建实际存在(创建请求);
        const auto 重复后 = L1.读取完整快照({});
        报告.验收[10] = 创建重复.状态 == 实际存在状态::幂等读回
            && 创建重复.事实 && 重复前.快照 && 重复后.快照
            && 重复前.快照->事实代次 == 重复后.快照->事实代次
            && 创建重复.事实->存在 == 创建结果.事实->存在;
        auto 同键异义 = 创建请求; 同键异义.期望事实代次 = 4;
        报告.验收[11] = 组合.在初始场景创建实际存在(同键异义).状态
            == 实际存在状态::幂等冲突;

        auto 错版本创建 = 创建请求; 错版本创建.合同版本 = 2;
        auto 零身份创建 = 创建请求; 零身份创建.幂等身份 = {};
        auto 错世界创建 = 创建请求; 错世界创建.幂等身份 = {0xB002};
        错世界创建.期望事实代次 = 4; 错世界创建.目标场景.世界根 = {};
        报告.验收[12] = 组合.在初始场景创建实际存在(错版本创建).状态
                == 实际存在状态::入口拒绝
            && 组合.在初始场景创建实际存在(零身份创建).状态
                == 实际存在状态::入口拒绝
            && 组合.在初始场景创建实际存在(错世界创建).状态
                == 实际存在状态::入口拒绝;
        L1实际存在服务 未登记存在(L1);
        报告.验收[13] = 未登记存在.读取当前登记().状态 == 实际存在状态::未找到
            && 未登记存在.形成实际存在写入规格({1, 1, 4}).状态
                == 实际存在状态::未找到;

        实际存在创建请求 第二请求 = 创建请求;
        第二请求.幂等身份 = {0xB003}; 第二请求.期望事实代次 = 4;
        const auto 第二结果 = 组合.在初始场景创建实际存在(第二请求);
        报告.验收[14] = 第二结果.状态 == 实际存在状态::已提交
            && 第二结果.事实 && 第二结果.事实->事实截止代次 == 5
            && 第二结果.事实->存在 != 创建结果.事实->存在;
        const auto 第一更新读取 = 组合.读取实际存在(读取请求);
        报告.验收[15] = 第一更新读取.状态 == 实际存在状态::已读取
            && 第一更新读取.事实 && 第一更新读取.事实->事实截止代次 == 5
            && 第一更新读取.事实->当前场景归属关系 == 创建结果.事实->当前场景归属关系;

        auto 错资格读取 = 读取请求;
        错资格读取.资格值 = 场景读取.场景标记值;
        auto 零存在读取 = 读取请求; 零存在读取.存在 = {};
        报告.验收[16] = 组合.读取实际存在(错资格读取).状态
                == 实际存在状态::内部不一致
            && 组合.读取实际存在(零存在读取).状态 == 实际存在状态::入口拒绝;

        L1写集请求 反向关系写集;
        反向关系写集.期望事实代次 = 5;
        反向关系写集.幂等键 = {0xEC00000000000001ULL};
        反向关系写集.关系 = {{{1}, 读取请求.存在,
            场景读取.初始场景, 世界结果.登记->直接成员关系类型, 0}};
        const auto 反向关系写入 = L1.提交写集(反向关系写集, 0x15000A01U);
        初始场景接纳读取请求 反向读取{场景读取, 读取请求.存在, {}};
        if (!反向关系写入.新编码映射.empty())
            反向读取.归属关系 = 反向关系写入.新编码映射.front().second;
        报告.验收[17] = 反向关系写入.状态 == L1写入状态::成功
            && 场景.读取初始场景接纳(反向读取).状态 == 世界结构状态::内部不一致;

        L1写集请求 双归属写集;
        双归属写集.期望事实代次 = 6;
        双归属写集.幂等键 = {0xEC00000000000002ULL};
        双归属写集.关系 = {{{1}, 场景读取.初始场景,
            读取请求.存在, 世界结果.登记->直接成员关系类型, 1}};
        const auto 双归属写入 = L1.提交写集(双归属写集, 0x15000A02U);
        报告.验收[18] = 双归属写入.状态 == L1写入状态::成功
            && 组合.读取实际存在(读取请求).状态 == 实际存在状态::内部不一致;

        L1事实基座服务 并发L1;
        世界登记服务 并发世界(并发L1);
        L1场景结构服务 并发场景(并发L1, 并发世界);
        L1实际存在服务 并发存在(并发L1);
        L1实际存在场景组合服务 并发组合(并发L1, 并发存在, 并发场景);
        世界登记建立请求 并发世界请求; 并发世界请求.幂等身份 = {0x1101};
        const auto 并发世界结果 = 并发世界.建立空世界(并发世界请求);
        初始场景创建请求 并发场景请求; 并发场景请求.幂等身份 = {0x1102};
        并发场景请求.世界根 = {并发世界结果.登记->世界根场景, 节点种类::普通};
        并发场景请求.期望事实代次 = 1;
        const auto 并发场景结果 = 并发场景.创建初始场景(并发场景请求);
        实际存在登记请求 并发登记; 并发登记.幂等身份 = {0xA101}; 并发登记.期望事实代次 = 2;
        const auto 并发登记结果 = 并发存在.建立登记(并发登记);
        初始场景读取请求 并发场景读取;
        并发场景读取.世界根 = 并发场景结果.事实->世界根;
        并发场景读取.初始场景 = 并发场景结果.事实->初始场景.编码;
        并发场景读取.场景标记值 = 并发场景结果.事实->场景标记.编码;
        并发场景读取.直接父关系 = 并发场景结果.事实->直接父关系.编码;
        实际存在创建请求 并发请求;
        并发请求.目标场景 = 并发场景读取; 并发请求.幂等身份 = {0xB101};
        并发请求.期望事实代次 = 3;
        std::atomic<std::uint32_t> 并发失败 = 0;
        std::vector<std::thread> 线程;
        for (int i = 0; i < 8; ++i) 线程.emplace_back([&] {
            const auto 结果 = 并发组合.在初始场景创建实际存在(并发请求);
            if ((结果.状态 != 实际存在状态::已提交
                    && 结果.状态 != 实际存在状态::幂等读回) || !结果.事实)
                ++并发失败;
        });
        for (auto& 项 : 线程) 项.join();
        const auto 并发快照 = 并发L1.读取完整快照({});
        std::size_t 并发存在节点 = 0, 并发资格值 = 0, 并发归属 = 0;
        if (并发快照.快照) {
            for (const auto& 节点 : 并发快照.快照->当前节点)
                if (节点.创建事实代次 == 4) ++并发存在节点;
            for (const auto& 值 : 并发快照.快照->当前值)
                if (值.创建事实代次 == 4) ++并发资格值;
            for (const auto& 关系 : 并发快照.快照->当前关系)
                if (关系.创建事实代次 == 4) ++并发归属;
        }
        报告.验收[19] = 并发登记结果.登记 && 并发失败 == 0
            && 并发快照.快照 && 并发快照.快照->事实代次 == 4
            && 并发存在节点 == 1 && 并发资格值 == 1 && 并发归属 == 1;

        const auto 最终快照 = 并发L1.读取完整快照({});
        报告.验收[20] = 最终快照.快照 && 最终快照.快照->当前节点.size() == 9
            && 最终快照.快照->当前关系.size() == 2
            && 最终快照.快照->当前值.size() == 3;
        报告.验收[21] = 创建结果.事实
            && 创建结果.事实->资格.创建事实代次 == 4
            && 创建结果.事实->当前场景归属关系.编码 != 创建结果.事实->资格.编码;
        报告.验收[22] = 登记结果.登记 && 世界结果.登记
            && 登记结果.登记->服务身份 != 世界结果.登记->服务身份
            && 登记结果.登记->实际存在资格属性类型
                != 世界结果.登记->场景标记属性类型;
        报告.验收[23] = 创建结果.事实 && 第二结果.事实
            && 创建结果.事实->世界根 == 第二结果.事实->世界根
            && 创建结果.事实->当前场景 == 第二结果.事实->当前场景;
    } catch (...) {
    }
    for (const bool 通过 : 报告.验收) if (!通过) ++报告.失败数量;
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
