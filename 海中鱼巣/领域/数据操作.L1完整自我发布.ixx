module;

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.数据操作.L1完整自我发布;

export import 海中鱼巣.领域.服务.L1完整自我场景准入;
import 海中鱼巣.核心.服务.L1事实基座;

namespace 海中鱼巣::L1完整自我发布内部 {

// 诊断责任：无适用错误分支；纯值幂等键映射。
L1中性写集幂等键 映射完整自我幂等键(完整自我操作幂等身份 身份) noexcept {
    return {(L1完整自我中性幂等域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；中性写入状态完整映射。
完整自我状态 映射中性写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 完整自我状态::已提交;
    case L1中性写入状态::精确重复: return 完整自我状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 完整自我状态::入口拒绝;
    case L1中性写入状态::事实代次漂移: return 完整自我状态::事实代次漂移;
    case L1中性写入状态::幂等冲突: return 完整自我状态::幂等冲突;
    case L1中性写入状态::资源失败: return 完整自我状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return 完整自我状态::内部不一致;
    }
    return 完整自我状态::内部不一致;
}

// 诊断责任：无适用错误分支；一致读取状态完整映射。
完整自我状态 映射一致读取状态(L1中性一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1中性一致当前读取状态::事实代次漂移:
        return 完整自我状态::事实代次漂移;
    case L1中性一致当前读取状态::许可拒绝:
        return 完整自我状态::许可拒绝;
    case L1中性一致当前读取状态::资源失败:
        return 完整自我状态::资源失败;
    case L1中性一致当前读取状态::成功:
    case L1中性一致当前读取状态::入口拒绝:
    case L1中性一致当前读取状态::内部不一致:
        return 完整自我状态::内部不一致;
    }
    return 完整自我状态::内部不一致;
}

// 诊断责任：向上送出；集中本数据操作唯一的L1中性提交调用点。
L1中性写入结果 提交规范化写集(L1事实基座服务& L1,
    const L1中性写集请求& 写集) {
    return L1.提交中性写集(写集);
}

// 诊断责任：无适用错误分支；未找到或重复均返回空值。
std::optional<稳定编码> 查找本地键映射(
    const L1中性写入结果& 结果, L1中性写集本地键 键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [候选键, 编码] : 结果.新编码映射) {
        if (候选键 != 键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值检查连续键和编码一一映射。
bool 映射完整(const L1中性写入结果& 结果, std::size_t 成员数) noexcept {
    const std::size_t 期望数 = 13 + 成员数;
    if (结果.新编码映射.size() != 期望数) return false;
    for (std::uint32_t 键值 = 1; 键值 <= 期望数; ++键值) {
        const auto 编码 = 查找本地键映射(结果, {键值});
        if (!编码 || !有效(*编码)) return false;
    }
    for (std::size_t i = 0; i < 结果.新编码映射.size(); ++i) {
        for (std::size_t j = i + 1; j < 结果.新编码映射.size(); ++j) {
            if (结果.新编码映射[i].first == 结果.新编码映射[j].first
                || 结果.新编码映射[i].second == 结果.新编码映射[j].second) return false;
        }
    }
    return true;
}

// 诊断责任：无适用错误分支；纯值互证两个领域批准规格。
bool 两域规格互证(const 完整自我存在准入规格& 存在,
    const 完整自我场景准入规格& 场景) noexcept {
    return 完整自我存在准入规格完整(存在) && 完整自我场景准入规格完整(场景)
        && 存在.合同版本 == 场景.合同版本 && 存在.规则版本 == 场景.规则版本
        && 存在.共同事实截止代次 == 场景.共同事实截止代次
        && 存在.世界根 == 场景.世界根
        && 存在.自我结构登记服务 == 场景.自我结构登记服务
        && 存在.自我结构关系类型 == 场景.自我结构关系类型
        && 存在.自我存在角色 == 场景.自我存在角色
        && 存在.自我内部世界场景角色 == 场景.自我内部世界场景角色
        && 存在.自我存在节点键 == 场景.自我存在节点键
        && 存在.自我内部世界场景节点键 == 场景.自我内部世界场景节点键;
}

// 诊断责任：向上送出；容器分配异常由公开提交根映射。
L1中性写集请求 形成完整自我中性写集(const 完整自我发布请求& 请求,
    const 完整自我存在准入规格& 存在,
    const 完整自我场景准入规格& 场景) {
    L1中性写集请求 写集;
    写集.期望事实代次 = 请求.期望事实代次;
    写集.幂等键 = 映射完整自我幂等键(请求.幂等身份);
    写集.节点 = {
        {{1}, 节点种类::普通, std::nullopt},
        {{2}, 节点种类::普通, std::nullopt},
        {{3}, 节点种类::普通, std::nullopt},
        {{4}, 节点种类::普通, std::nullopt}};
    写集.值 = {
        {{5}, L1中性写集本地键{1}, 场景.场景标记属性类型.编码,
            std::int64_t{1}, 场景.世界登记服务.编码},
        {{6}, L1中性写集本地键{2}, 场景.场景标记属性类型.编码,
            std::int64_t{1}, 场景.世界登记服务.编码},
        {{7}, L1中性写集本地键{4}, 场景.场景标记属性类型.编码,
            std::int64_t{1}, 场景.世界登记服务.编码},
        {{8}, L1中性写集本地键{3}, 存在.实际存在资格.资格属性类型.编码,
            std::int64_t{实际存在资格值}, 存在.实际存在资格.服务身份.编码}};
    写集.关系 = {
        {{9}, 场景.世界根.编码, L1中性写集本地键{1},
            场景.直接父场景关系类型.编码, 0},
        {{10}, L1中性写集本地键{1}, L1中性写集本地键{2},
            场景.直接父场景关系类型.编码, 0},
        {{11}, L1中性写集本地键{2}, L1中性写集本地键{3},
            场景.直接成员关系类型.编码, 0},
        {{12}, L1中性写集本地键{1}, L1中性写集本地键{4},
            场景.直接父场景关系类型.编码, 0},
        {{13}, L1中性写集本地键{3}, L1中性写集本地键{4},
            存在.自我结构关系类型.编码, 1}};
    写集.关系.reserve(5 + 场景.出生期成员资格组.size());
    for (std::size_t i = 0; i < 场景.出生期成员资格组.size(); ++i) {
        写集.关系.push_back({{static_cast<std::uint32_t>(14 + i)},
            L1中性写集本地键{4}, 场景.出生期成员资格组[i].存在.编码,
            场景.自我结构关系类型.编码, 2});
    }
    写集.属性槽变更 = {
        {L1中性写集本地键{1}, 场景.场景标记属性类型.编码, {5}},
        {L1中性写集本地键{2}, 场景.场景标记属性类型.编码, {6}},
        {L1中性写集本地键{4}, 场景.场景标记属性类型.编码, {7}},
        {L1中性写集本地键{3}, 存在.实际存在资格.资格属性类型.编码, {8}}};
    return 写集;
}

template<class 类型>
// 诊断责任：向上送出；排序分配异常由调用公开根结构化映射。
void 排序去重(std::vector<类型>& 组) {
    std::sort(组.begin(), 组.end());
    组.erase(std::unique(组.begin(), 组.end()), 组.end());
}

// 诊断责任：无适用错误分支；纯值形成属性选择稳定顺序。
bool 属性选择小于(const L1中性一致属性值选择项& 左,
    const L1中性一致属性值选择项& 右) noexcept {
    return 左.节点 < 右.节点 || (!(右.节点 < 左.节点) && 左.属性类型 < 右.属性类型);
}
// 诊断责任：无适用错误分支；纯值形成源关系组稳定顺序。
bool 源组选择小于(const L1中性一致源关系组选择项& 左,
    const L1中性一致源关系组选择项& 右) noexcept {
    return 左.源节点 < 右.源节点
        || (!(右.源节点 < 左.源节点) && 左.关系类型节点 < 右.关系类型节点);
}
// 诊断责任：无适用错误分支；纯值形成目标关系组稳定顺序。
bool 目标组选择小于(const L1中性一致目标关系组选择项& 左,
    const L1中性一致目标关系组选择项& 右) noexcept {
    return 左.目标节点 < 右.目标节点
        || (!(右.目标节点 < 左.目标节点) && 左.关系类型节点 < 右.关系类型节点);
}

// 诊断责任：向上送出；排序与容器分配异常由公开提交根映射。
L1中性一致当前读取请求 形成写前一致投影请求(
    const 完整自我存在准入规格& 存在,
    const 完整自我场景准入规格& 场景) {
    L1中性一致当前读取请求 请求;
    请求.期望事实代次 = 存在.共同事实截止代次;
    请求.节点 = {场景.世界根.编码, 场景.世界登记服务.编码,
        存在.实际存在资格.服务身份.编码, 场景.自我结构登记服务.编码,
        场景.场景标记属性类型.编码,
        存在.实际存在资格.资格属性类型.编码,
        场景.直接父场景关系类型.编码, 场景.直接成员关系类型.编码,
        场景.自我结构关系类型.编码};
    for (const auto& 成员 : 场景.出生期成员资格组) {
        请求.节点.push_back(成员.存在.编码);
        请求.值.push_back(成员.资格.编码);
        请求.属性值.push_back({成员.存在.编码,
            存在.实际存在资格.资格属性类型.编码});
        请求.源关系组.push_back({成员.存在.编码,
            场景.自我结构关系类型.编码});
        请求.目标关系组.push_back({成员.存在.编码,
            场景.自我结构关系类型.编码});
    }
    请求.属性值.push_back({场景.世界根.编码,
        场景.场景标记属性类型.编码});
    请求.源关系组.push_back({场景.世界根.编码,
        场景.自我结构关系类型.编码});
    请求.目标关系组.push_back({场景.世界根.编码,
        场景.自我结构关系类型.编码});
    排序去重(请求.节点);
    排序去重(请求.值);
    std::sort(请求.属性值.begin(), 请求.属性值.end(), 属性选择小于);
    请求.属性值.erase(std::unique(请求.属性值.begin(), 请求.属性值.end()),
        请求.属性值.end());
    std::sort(请求.源关系组.begin(), 请求.源关系组.end(), 源组选择小于);
    请求.源关系组.erase(std::unique(请求.源关系组.begin(), 请求.源关系组.end()),
        请求.源关系组.end());
    std::sort(请求.目标关系组.begin(), 请求.目标关系组.end(), 目标组选择小于);
    请求.目标关系组.erase(std::unique(请求.目标关系组.begin(), 请求.目标关系组.end()),
        请求.目标关系组.end());
    return 请求;
}

// 诊断责任：无适用错误分支；未找到或重复节点均返回空指针。
const L1中性一致节点读取结果项* 找节点(
    const L1中性一致当前读取结果& 结果, 稳定编码 编码) noexcept {
    const L1中性一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 结果.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}
// 诊断责任：无适用错误分支；未找到或重复关系均返回空指针。
const L1中性一致关系读取结果项* 找关系(
    const L1中性一致当前读取结果& 结果, 稳定编码 编码) noexcept {
    const L1中性一致关系读取结果项* 找到 = nullptr;
    for (const auto& 项 : 结果.关系) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}
// 诊断责任：无适用错误分支；未找到或重复值均返回空指针。
const L1中性一致值读取结果项* 找值(
    const L1中性一致当前读取结果& 结果, 稳定编码 编码) noexcept {
    const L1中性一致值读取结果项* 找到 = nullptr;
    for (const auto& 项 : 结果.值) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}
// 诊断责任：无适用错误分支；未找到或重复属性投影均返回空指针。
const L1中性一致属性值读取结果项* 找属性(
    const L1中性一致当前读取结果& 结果, 稳定编码 节点,
    稳定编码 属性类型) noexcept {
    const L1中性一致属性值读取结果项* 找到 = nullptr;
    for (const auto& 项 : 结果.属性值) {
        if (项.节点 != 节点 || 项.属性类型 != 属性类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值检查节点读取项目完整性。
bool 节点项完整(const L1中性一致节点读取结果项* 项,
    稳定编码 编码, 节点种类 种类) noexcept {
    return 项 && 项->状态 == L1中性一致当前读取项目状态::成功 && 项->事实
        && 项->查询编码 == 编码 && 项->事实->编码 == 编码 && 项->事实->种类 == 种类
        && 项->事实->创建事实代次 != 0 && !项->事实->退出事实代次.has_value()
        && (种类 == 节点种类::属性类型
            ? 项->事实->属性类型表示 == std::optional<L1中性值表示种类>{L1中性值表示种类::I64}
            : !项->事实->属性类型表示.has_value());
}

// 诊断责任：无适用错误分支；纯值互证中性值事实与正式见证。
bool 值事实匹配见证(const L1中性值事实& 事实,
    const 世界结构值见证& 见证) noexcept {
    return 事实.编码 == 见证.编码 && 事实.所属节点 == 见证.所属节点.编码
        && 事实.属性类型节点 == 见证.属性类型.编码
        && 事实.来源节点 == 见证.来源.编码
        && 事实.创建事实代次 == 见证.创建事实代次
        && !事实.退出事实代次.has_value()
        && std::holds_alternative<std::int64_t>(事实.材料)
        && std::get<std::int64_t>(事实.材料) == 见证.I64值;
}

// 诊断责任：无适用错误分支；纯值互证属性槽当前投影与正式见证。
bool 属性投影匹配见证(const L1中性一致属性值读取结果项* 项,
    const 世界结构值见证& 见证) noexcept {
    return 项 && 项->状态 == L1中性一致当前读取项目状态::成功 && 项->投影
        && 项->节点 == 见证.所属节点.编码
        && 项->属性类型 == 见证.属性类型.编码
        && 项->投影->属性槽.属性类型节点 == 见证.属性类型.编码
        && 项->投影->属性槽.当前值 == 见证.编码
        && 值事实匹配见证(项->投影->当前值事实, 见证);
}

// 诊断责任：无适用错误分支；纯值逐项复核写前一致投影。
bool 写前一致投影完整(const 完整自我存在准入规格& 存在,
    const 完整自我场景准入规格& 场景,
    const L1中性一致当前读取结果& 读取) noexcept {
    if (读取.状态 != L1中性一致当前读取状态::成功
        || 读取.合同版本 != L1中性一致当前读取合同版本
        || 读取.期望事实代次 != 存在.共同事实截止代次
        || 读取.读取事实代次 != 存在.共同事实截止代次
        || 读取.节点.size() != 9 + 场景.出生期成员资格组.size()
        || !读取.关系.empty()
        || 读取.值.size() != 场景.出生期成员资格组.size()
        || 读取.属性值.size() != 1 + 场景.出生期成员资格组.size()
        || 读取.源关系组.size() != 1 + 场景.出生期成员资格组.size()
        || 读取.目标关系组.size() != 1 + 场景.出生期成员资格组.size()) return false;
    const std::array<std::pair<稳定编码, 节点种类>, 9> 固定节点{{
        {场景.世界根.编码, 节点种类::普通},
        {场景.世界登记服务.编码, 节点种类::普通},
        {存在.实际存在资格.服务身份.编码, 节点种类::普通},
        {场景.自我结构登记服务.编码, 节点种类::普通},
        {场景.场景标记属性类型.编码, 节点种类::属性类型},
        {存在.实际存在资格.资格属性类型.编码, 节点种类::属性类型},
        {场景.直接父场景关系类型.编码, 节点种类::普通},
        {场景.直接成员关系类型.编码, 节点种类::普通},
        {场景.自我结构关系类型.编码, 节点种类::普通}}};
    for (const auto& [编码, 种类] : 固定节点)
        if (!节点项完整(找节点(读取, 编码), 编码, 种类)) return false;
    for (const auto& 成员 : 场景.出生期成员资格组) {
        if (!节点项完整(找节点(读取, 成员.存在.编码), 成员.存在.编码,
                节点种类::普通)) return false;
        const auto* 值项 = 找值(读取, 成员.资格.编码);
        if (!值项 || 值项->状态 != L1中性一致当前读取项目状态::成功
            || !值项->事实 || !值事实匹配见证(*值项->事实, 成员.资格)
            || !属性投影匹配见证(找属性(读取, 成员.存在.编码,
                存在.实际存在资格.资格属性类型.编码), 成员.资格)) return false;
    }
    const auto* 世界属性 = 找属性(读取, 场景.世界根.编码,
        场景.场景标记属性类型.编码);
    if (!世界属性 || 世界属性->状态 != L1中性一致当前读取项目状态::成功
        || !世界属性->投影 || 世界属性->投影->属性槽.当前值
            != 世界属性->投影->当前值事实.编码
        || 世界属性->投影->当前值事实.所属节点 != 场景.世界根.编码
        || 世界属性->投影->当前值事实.属性类型节点
            != 场景.场景标记属性类型.编码
        || 世界属性->投影->当前值事实.来源节点 != 场景.世界登记服务.编码
        || !std::holds_alternative<std::int64_t>(世界属性->投影->当前值事实.材料)
        || std::get<std::int64_t>(世界属性->投影->当前值事实.材料) != 1
        || 世界属性->投影->当前值事实.退出事实代次.has_value()) return false;
    for (const auto& 项 : 读取.源关系组) if (!项.成员.empty()) return false;
    for (const auto& 项 : 读取.目标关系组) if (!项.成员.empty()) return false;
    return true;
}

// 诊断责任：向上送出；映射或容器异常由公开根结构化返回。
L1中性一致当前读取请求 形成发布后一致投影请求(
    const 完整自我存在准入规格& 存在,
    const 完整自我场景准入规格& 场景,
    const L1中性写入结果& 写入) {
    L1中性一致当前读取请求 请求;
    请求.期望事实代次 = 写入.事实代次;
    请求.节点 = {场景.世界根.编码, 场景.世界登记服务.编码,
        存在.实际存在资格.服务身份.编码, 场景.自我结构登记服务.编码,
        场景.场景标记属性类型.编码,
        存在.实际存在资格.资格属性类型.编码,
        场景.直接父场景关系类型.编码, 场景.直接成员关系类型.编码,
        场景.自我结构关系类型.编码};
    for (std::uint32_t 键 = 1; 键 <= 4; ++键)
        请求.节点.push_back(*查找本地键映射(写入, {键}));
    for (const auto& 成员 : 场景.出生期成员资格组)
        请求.节点.push_back(成员.存在.编码);
    for (std::uint32_t 键 = 5; 键 <= 8; ++键)
        请求.值.push_back(*查找本地键映射(写入, {键}));
    for (std::uint32_t 键 = 9;
        键 <= static_cast<std::uint32_t>(13 + 场景.出生期成员资格组.size()); ++键)
        请求.关系.push_back(*查找本地键映射(写入, {键}));
    请求.属性值 = {
        {*查找本地键映射(写入, {1}), 场景.场景标记属性类型.编码},
        {*查找本地键映射(写入, {2}), 场景.场景标记属性类型.编码},
        {*查找本地键映射(写入, {4}), 场景.场景标记属性类型.编码},
        {*查找本地键映射(写入, {3}), 存在.实际存在资格.资格属性类型.编码}};
    for (const auto& 成员 : 场景.出生期成员资格组)
        请求.属性值.push_back({成员.存在.编码,
            存在.实际存在资格.资格属性类型.编码});
    排序去重(请求.节点);
    排序去重(请求.关系);
    排序去重(请求.值);
    std::sort(请求.属性值.begin(), 请求.属性值.end(), 属性选择小于);
    return 请求;
}

// 诊断责任：无适用错误分支；纯值转换已复核节点事实。
世界结构节点身份见证 形成节点见证(const L1中性节点事实& 事实) noexcept {
    return {事实.编码, 事实.种类};
}
// 诊断责任：无适用错误分支；纯值转换已复核I64值事实。
世界结构值见证 形成值见证(const L1中性值事实& 事实) noexcept {
    return {事实.编码, {事实.所属节点, 节点种类::普通},
        {事实.属性类型节点, 节点种类::属性类型},
        std::get<std::int64_t>(事实.材料),
        {事实.来源节点, 节点种类::普通}, 事实.创建事实代次};
}
// 诊断责任：无适用错误分支；纯值转换已复核关系事实。
世界结构关系身份见证 形成关系见证(const L1中性关系事实& 事实) noexcept {
    return {事实.编码, {事实.关系类型节点, 节点种类::普通},
        {事实.源节点, 节点种类::普通}, {事实.目标节点, 节点种类::普通},
        事实.角色或顺序};
}

// 诊断责任：无适用错误分支；纯值复核新关系的完整字段。
bool 关系事实匹配(const L1中性关系事实& 事实, 稳定编码 源,
    稳定编码 目标, 稳定编码 类型, std::int64_t 角色,
    std::uint64_t 创建代次) noexcept {
    return 事实.源节点 == 源 && 事实.目标节点 == 目标
        && 事实.关系类型节点 == 类型 && 事实.角色或顺序 == 角色
        && 事实.创建事实代次 == 创建代次 && !事实.退出事实代次.has_value();
}

// 诊断责任：无适用错误分支；纯值复核新I64值的完整字段。
bool 新值事实匹配(const L1中性值事实& 事实, 稳定编码 所属,
    稳定编码 属性类型, 稳定编码 来源, std::uint64_t 创建代次) noexcept {
    return 事实.所属节点 == 所属 && 事实.属性类型节点 == 属性类型
        && 事实.来源节点 == 来源 && 事实.创建事实代次 == 创建代次
        && !事实.退出事实代次.has_value()
        && std::holds_alternative<std::int64_t>(事实.材料)
        && std::get<std::int64_t>(事实.材料) == 1;
}

// 诊断责任：向上送出；坏投影返回空，成员复制异常向上送出。
std::optional<完整自我当前事实> 尝试形成完整自我当前事实(
    const 完整自我存在准入规格& 存在,
    const 完整自我场景准入规格& 场景,
    const L1中性写入结果& 写入,
    const L1中性一致当前读取结果& 读取) {
    if (读取.状态 != L1中性一致当前读取状态::成功
        || 读取.合同版本 != L1中性一致当前读取合同版本
        || 读取.期望事实代次 != 读取.读取事实代次
        || 读取.读取事实代次 < 写入.事实代次 || !读取.源关系组.empty()
        || !读取.目标关系组.empty()
        || 读取.节点.size() != 13 + 场景.出生期成员资格组.size()
        || 读取.关系.size() != 5 + 场景.出生期成员资格组.size()
        || 读取.值.size() != 4
        || 读取.属性值.size() != 4 + 场景.出生期成员资格组.size())
        return std::nullopt;
    const auto 编码 = [&](std::uint32_t 键) { return 查找本地键映射(写入, {键}); };
    for (std::uint32_t 键 = 1;
        键 <= static_cast<std::uint32_t>(13 + 场景.出生期成员资格组.size()); ++键)
        if (!编码(键)) return std::nullopt;
    const auto* 世界根项 = 找节点(读取, 场景.世界根.编码);
    const auto* 节点1 = 找节点(读取, *编码(1));
    const auto* 节点2 = 找节点(读取, *编码(2));
    const auto* 节点3 = 找节点(读取, *编码(3));
    const auto* 节点4 = 找节点(读取, *编码(4));
    if (!节点项完整(世界根项, 场景.世界根.编码, 节点种类::普通)
        || !节点项完整(节点1, *编码(1), 节点种类::普通)
        || !节点项完整(节点2, *编码(2), 节点种类::普通)
        || !节点项完整(节点3, *编码(3), 节点种类::普通)
        || !节点项完整(节点4, *编码(4), 节点种类::普通)) return std::nullopt;
    for (std::uint32_t 键 = 9;
        键 <= static_cast<std::uint32_t>(13 + 场景.出生期成员资格组.size()); ++键) {
        const auto* 项 = 找关系(读取, *编码(键));
        if (!项 || 项->状态 != L1中性一致当前读取项目状态::成功
            || !项->事实 || 项->事实->退出事实代次.has_value()
            || 项->事实->创建事实代次 != 写入.事实代次) return std::nullopt;
    }
    for (std::uint32_t 键 = 5; 键 <= 8; ++键) {
        const auto* 项 = 找值(读取, *编码(键));
        if (!项 || 项->状态 != L1中性一致当前读取项目状态::成功
            || !项->事实 || 项->事实->退出事实代次.has_value()
            || 项->事实->创建事实代次 != 写入.事实代次
            || !std::holds_alternative<std::int64_t>(项->事实->材料)
            || std::get<std::int64_t>(项->事实->材料) != 1) return std::nullopt;
    }
    const auto* 关系9 = 找关系(读取, *编码(9));
    const auto* 关系10 = 找关系(读取, *编码(10));
    const auto* 关系11 = 找关系(读取, *编码(11));
    const auto* 关系12 = 找关系(读取, *编码(12));
    const auto* 关系13 = 找关系(读取, *编码(13));
    if (!关系事实匹配(*关系9->事实, 场景.世界根.编码, *编码(1),
            场景.直接父场景关系类型.编码, 0, 写入.事实代次)
        || !关系事实匹配(*关系10->事实, *编码(1), *编码(2),
            场景.直接父场景关系类型.编码, 0, 写入.事实代次)
        || !关系事实匹配(*关系11->事实, *编码(2), *编码(3),
            场景.直接成员关系类型.编码, 0, 写入.事实代次)
        || !关系事实匹配(*关系12->事实, *编码(1), *编码(4),
            场景.直接父场景关系类型.编码, 0, 写入.事实代次)
        || !关系事实匹配(*关系13->事实, *编码(3), *编码(4),
            场景.自我结构关系类型.编码, 1, 写入.事实代次)) return std::nullopt;
    if (!新值事实匹配(*找值(读取, *编码(5))->事实, *编码(1),
            场景.场景标记属性类型.编码, 场景.世界登记服务.编码, 写入.事实代次)
        || !新值事实匹配(*找值(读取, *编码(6))->事实, *编码(2),
            场景.场景标记属性类型.编码, 场景.世界登记服务.编码, 写入.事实代次)
        || !新值事实匹配(*找值(读取, *编码(7))->事实, *编码(4),
            场景.场景标记属性类型.编码, 场景.世界登记服务.编码, 写入.事实代次)
        || !新值事实匹配(*找值(读取, *编码(8))->事实, *编码(3),
            存在.实际存在资格.资格属性类型.编码,
            存在.实际存在资格.服务身份.编码, 写入.事实代次)) return std::nullopt;

    完整自我当前事实 事实;
    事实.发布事实代次 = 写入.事实代次;
    事实.事实截止代次 = 读取.读取事实代次;
    事实.世界根 = 形成节点见证(*世界根项->事实);
    事实.世界根内部世界场景 = 形成节点见证(*节点1->事实);
    事实.自我所在场景 = 形成节点见证(*节点2->事实);
    事实.自我存在 = 形成节点见证(*节点3->事实);
    事实.自我内部世界场景 = 形成节点见证(*节点4->事实);
    事实.世界根内部世界关系 = 形成关系见证(*找关系(读取, *编码(9))->事实);
    事实.自我所在场景关系 = 形成关系见证(*找关系(读取, *编码(10))->事实);
    事实.自我所在场景成员关系 = 形成关系见证(*找关系(读取, *编码(11))->事实);
    事实.自我内部世界父关系 = 形成关系见证(*找关系(读取, *编码(12))->事实);
    事实.自我内部世界角色关系 = 形成关系见证(*找关系(读取, *编码(13))->事实);
    事实.世界根内部世界场景标记 = 形成值见证(*找值(读取, *编码(5))->事实);
    事实.自我所在场景标记 = 形成值见证(*找值(读取, *编码(6))->事实);
    事实.自我内部世界场景标记 = 形成值见证(*找值(读取, *编码(7))->事实);
    事实.自我存在资格 = 形成值见证(*找值(读取, *编码(8))->事实);
    事实.出生期成员组.reserve(场景.出生期成员资格组.size());
    for (std::size_t i = 0; i < 场景.出生期成员资格组.size(); ++i) {
        const auto& 成员 = 场景.出生期成员资格组[i];
        const auto* 节点项 = 找节点(读取, 成员.存在.编码);
        const auto* 属性项 = 找属性(读取, 成员.存在.编码,
            存在.实际存在资格.资格属性类型.编码);
        const auto* 关系项 = 找关系(读取, *编码(static_cast<std::uint32_t>(14 + i)));
        if (!节点项完整(节点项, 成员.存在.编码, 节点种类::普通)
            || !属性投影匹配见证(属性项, 成员.资格)
            || !关系项 || !关系项->事实) return std::nullopt;
        if (!关系事实匹配(*关系项->事实, *编码(4), 成员.存在.编码,
                场景.自我结构关系类型.编码, 2, 写入.事实代次)) return std::nullopt;
        事实.出生期成员组.push_back({形成节点见证(*节点项->事实),
            形成值见证(属性项->投影->当前值事实), 形成关系见证(*关系项->事实)});
    }
    return 完整自我当前事实完整(事实)
        ? std::optional<完整自我当前事实>{std::move(事实)} : std::nullopt;
}

// 诊断责任：无适用错误分支；纯值检查首次或精确重复写入形状。
bool 写入成功形状完整(const L1中性写入结果& 写入,
    const L1中性写集请求& 写集, std::size_t 成员数) noexcept {
    const bool 首次 = 写入.状态 == L1中性写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::不适用;
    const bool 重复 = 写入.状态 == L1中性写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
    return 写入.合同版本 == L1中性CRUD合同版本 && 写入.幂等键 == 写集.幂等键
        && 写入.事实代次 != 0 && (首次 || 重复) && 映射完整(写入, 成员数);
}

} // namespace 海中鱼巣::L1完整自我发布内部

export namespace 海中鱼巣 {

class L1完整自我发布数据操作 final {
public:
    explicit L1完整自我发布数据操作(L1事实基座服务& L1) noexcept : L1_(L1) {}
    L1完整自我发布数据操作() = delete;
    L1完整自我发布数据操作(const L1完整自我发布数据操作&) = delete;
    L1完整自我发布数据操作& operator=(const L1完整自我发布数据操作&) = delete;
    L1完整自我发布数据操作(L1完整自我发布数据操作&&) = delete;
    L1完整自我发布数据操作& operator=(L1完整自我发布数据操作&&) = delete;

    // 诊断责任：向上送出；只按首次原键收敛并保留发布后隔离边界。
    完整自我结果 尝试收敛已有完整自我(const 完整自我发布请求& 请求) {
        if (!首次请求_) return {完整自我状态::尚无完整自我};
        if (!(请求 == *首次请求_))
            return {完整自我状态::幂等冲突, 首次请求_->幂等身份,
                L1发布已存在_, std::nullopt};
        if (!首次存在规格_ || !首次场景规格_ || !首次写集_ || !首次写入_)
            return {完整自我状态::内部不一致, 请求.幂等身份,
                L1发布已存在_, std::nullopt};
        try {
            const auto 写入 = L1完整自我发布内部::提交规范化写集(
                L1_, *首次写集_);
            if (!L1完整自我发布内部::写入成功形状完整(
                    写入, *首次写集_, 首次场景规格_->出生期成员资格组.size())
                || 写入.状态 != L1中性写入状态::精确重复
                || 写入.新编码映射 != 首次写入_->新编码映射) {
                发布后隔离_ = true;
                return {L1完整自我发布内部::映射中性写入状态(写入.状态),
                    请求.幂等身份, L1发布已存在_, std::nullopt};
            }
            return 读取当前实现(完整自我状态::幂等读回);
        } catch (const std::bad_alloc&) {
            发布后隔离_ = true;
            return {完整自我状态::资源失败, 请求.幂等身份,
                L1发布已存在_, std::nullopt};
        } catch (...) {
            发布后隔离_ = true;
            return {完整自我状态::内部不一致, 请求.幂等身份,
                L1发布已存在_, std::nullopt};
        }
    }

    // 诊断责任：向上送出；写前拒绝、一次提交与发布后读回均结构化返回。
    完整自我结果 提交完整自我(const 完整自我发布请求& 请求,
        const 完整自我存在准入规格& 存在规格,
        const 完整自我场景准入规格& 场景规格) {
        if (!完整自我发布请求有效(请求)
            || !L1完整自我发布内部::两域规格互证(存在规格, 场景规格)
            || 请求.期望事实代次 != 存在规格.共同事实截止代次
            || 请求.出生期成员稳定编码组.size() != 场景规格.出生期成员资格组.size())
            return {完整自我状态::入口拒绝, 请求.幂等身份, false, std::nullopt};
        for (std::size_t i = 0; i < 请求.出生期成员稳定编码组.size(); ++i)
            if (请求.出生期成员稳定编码组[i]
                != 场景规格.出生期成员资格组[i].存在.编码)
                return {完整自我状态::内部不一致, 请求.幂等身份, false, std::nullopt};
        if (首次请求_) return {完整自我状态::幂等冲突,
            首次请求_->幂等身份, L1发布已存在_, std::nullopt};
        try {
            auto 写集 = L1完整自我发布内部::形成完整自我中性写集(
                请求, 存在规格, 场景规格);
            auto 已保存请求 = 请求;
            auto 已保存存在规格 = 存在规格;
            auto 已保存场景规格 = 场景规格;
            auto 已保存写集 = 写集;
            auto 写前请求 = L1完整自我发布内部::形成写前一致投影请求(
                存在规格, 场景规格);
            const auto 写前读取 = L1_.尝试读取中性一致当前投影(写前请求);
            if (写前读取.状态 != L1中性一致当前读取状态::成功) {
                return {L1完整自我发布内部::映射一致读取状态(写前读取.状态),
                    请求.幂等身份, false, std::nullopt};
            }
            if (!L1完整自我发布内部::写前一致投影完整(
                    存在规格, 场景规格, 写前读取)) {
                return {完整自我状态::内部不一致, 请求.幂等身份,
                    false, std::nullopt};
            }

            auto 写入 = L1完整自我发布内部::提交规范化写集(L1_, 写集);
            const auto 映射状态 = L1完整自我发布内部::映射中性写入状态(写入.状态);
            if (写入.状态 != L1中性写入状态::成功
                && 写入.状态 != L1中性写入状态::精确重复)
                return {映射状态, 请求.幂等身份, false, std::nullopt};

            L1发布已存在_ = true;
            if (!L1完整自我发布内部::写入成功形状完整(
                    写入, 写集, 场景规格.出生期成员资格组.size())) {
                发布后隔离_ = true;
                return {完整自我状态::内部不一致, 请求.幂等身份,
                    true, std::nullopt};
            }
            首次请求_.emplace(std::move(已保存请求));
            首次存在规格_.emplace(std::move(已保存存在规格));
            首次场景规格_.emplace(std::move(已保存场景规格));
            首次写集_.emplace(std::move(已保存写集));
            首次写入_.emplace(std::move(写入));
            return 读取当前实现(映射状态);
        } catch (const std::bad_alloc&) {
            if (L1发布已存在_) 发布后隔离_ = true;
            return {完整自我状态::资源失败, 请求.幂等身份,
                L1发布已存在_, std::nullopt};
        } catch (const std::length_error&) {
            if (L1发布已存在_) 发布后隔离_ = true;
            return {完整自我状态::资源失败, 请求.幂等身份,
                L1发布已存在_, std::nullopt};
        } catch (...) {
            if (L1发布已存在_) 发布后隔离_ = true;
            return {完整自我状态::内部不一致, 请求.幂等身份,
                L1发布已存在_, std::nullopt};
        }
    }

    // 诊断责任：向上送出；只按已保存定位执行正式当前读回。
    完整自我结果 读取当前完整自我() const {
        if (!首次请求_) return {完整自我状态::尚无完整自我};
        return 读取当前实现(完整自我状态::已读取);
    }

private:
    // 诊断责任：向上送出；只按已保存定位正式读回并固定发布后隔离。
    完整自我结果 读取当前实现(完整自我状态 成功状态) const {
        if (!首次请求_ || !首次存在规格_ || !首次场景规格_ || !首次写入_)
            return {完整自我状态::内部不一致, {}, L1发布已存在_, std::nullopt};
        try {
            auto 请求 = L1完整自我发布内部::形成发布后一致投影请求(
                *首次存在规格_, *首次场景规格_, *首次写入_);
            constexpr std::size_t 最大尝试次数 = 2;
            for (std::size_t 尝试 = 0; 尝试 < 最大尝试次数; ++尝试) {
                const auto 读取 = L1_.尝试读取中性一致当前投影(请求);
                if (读取.状态 == L1中性一致当前读取状态::事实代次漂移
                    && 尝试 == 0 && 读取.读取事实代次 != 0) {
                    请求 = L1完整自我发布内部::形成发布后一致投影请求(
                        *首次存在规格_, *首次场景规格_, *首次写入_);
                    请求.期望事实代次 = 读取.读取事实代次;
                    continue;
                }
                if (读取.状态 != L1中性一致当前读取状态::成功) {
                    发布后隔离_ = true;
                    return {L1完整自我发布内部::映射一致读取状态(读取.状态),
                        首次请求_->幂等身份, true, std::nullopt};
                }
                auto 事实 = L1完整自我发布内部::尝试形成完整自我当前事实(
                    *首次存在规格_, *首次场景规格_, *首次写入_, 读取);
                if (!事实) {
                    发布后隔离_ = true;
                    return {完整自我状态::内部不一致,
                        首次请求_->幂等身份, true, std::nullopt};
                }
                return {成功状态, 首次请求_->幂等身份, true, std::move(事实)};
            }
        } catch (const std::bad_alloc&) {
            发布后隔离_ = true;
            return {完整自我状态::资源失败, 首次请求_->幂等身份,
                true, std::nullopt};
        } catch (const std::length_error&) {
            发布后隔离_ = true;
            return {完整自我状态::资源失败, 首次请求_->幂等身份,
                true, std::nullopt};
        } catch (...) {
            发布后隔离_ = true;
            return {完整自我状态::内部不一致, 首次请求_->幂等身份,
                true, std::nullopt};
        }
        发布后隔离_ = true;
        return {完整自我状态::事实代次漂移, 首次请求_->幂等身份,
            true, std::nullopt};
    }

    L1事实基座服务& L1_;
    std::optional<完整自我发布请求> 首次请求_;
    std::optional<完整自我存在准入规格> 首次存在规格_;
    std::optional<完整自我场景准入规格> 首次场景规格_;
    std::optional<L1中性写集请求> 首次写集_;
    std::optional<L1中性写入结果> 首次写入_;
    bool L1发布已存在_ = false;
    mutable bool 发布后隔离_ = false;
};

} // namespace 海中鱼巣
