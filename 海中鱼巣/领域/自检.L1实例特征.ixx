module;

#include <array>
#include <cstdint>
#include <optional>
#include <variant>

export module 海中鱼巣.领域.自检.L1实例特征;

import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1场景结构;
import 海中鱼巣.领域.服务.L1特征定义;
import 海中鱼巣.领域.服务.L1实例特征;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

struct L1实例特征自检报告 final {
    bool 总通过 = false;
    std::array<bool, 27> 验收{};
    std::size_t 失败数量 = 0;
};

L1实例特征自检报告 运行L1实例特征自检() {
    L1实例特征自检报告 报告;
    try {
        L1事实基座服务 L1;
        世界登记服务 世界(L1);
        L1场景结构服务 场景(L1, 世界);
        L1特征定义服务 定义(L1);
        L1实例特征服务 实例(L1, 场景, 定义);

        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0x1001};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        报告.验收[0] = 世界结果.状态 == 世界登记状态::已提交 && 世界结果.登记.has_value();

        初始场景创建请求 场景请求;
        场景请求.幂等身份 = {0x1002};
        场景请求.世界根 = {世界结果.登记 ? 世界结果.登记->世界根场景 : 稳定编码{}, 节点种类::普通};
        场景请求.期望事实代次 = 世界结果.登记 ? 世界结果.登记->已验证事实代次 : 0;
        const auto 场景结果 = 场景.创建初始场景(场景请求);
        报告.验收[1] = 场景结果.状态 == 世界结构状态::已提交 && 场景结果.事实.has_value()
            && 场景结果.事实->事实截止代次 == 2;

        特征定义登记请求 定义登记请求;
        定义登记请求.幂等身份 = {0x3001};
        定义登记请求.期望事实代次 = 场景结果.事实 ? 场景结果.事实->事实截止代次 : 0;
        const auto 定义登记 = 定义.建立登记(定义登记请求);
        报告.验收[2] = 定义登记.状态 == 特征定义状态::已提交
            && 定义登记.登记.has_value() && 定义登记.登记->事实截止代次 == 3;

        I64特征定义建立请求 I64请求;
        I64请求.幂等身份 = {0x4001};
        I64请求.期望事实代次 = 定义登记.登记 ? 定义登记.登记->事实截止代次 : 0;
        I64请求.下界 = -10;
        I64请求.上界 = 10;
        const auto I64结果 = 定义.建立I64特征定义(I64请求);
        报告.验收[3] = I64结果.状态 == 特征定义状态::已提交
            && I64结果.事实.has_value() && I64结果.事实->事实截止代次 == 4;

        实例特征登记请求 实例登记请求;
        实例登记请求.幂等身份 = {0x5001};
        实例登记请求.期望事实代次 = I64结果.事实 ? I64结果.事实->事实截止代次 : 0;
        const auto 实例登记 = 实例.建立登记(实例登记请求);
        报告.验收[4] = 实例登记.状态 == 实例特征状态::已提交
            && 实例登记.登记.has_value() && 实例登记.登记->事实截止代次 == 5;

        初始场景读取请求 宿主读取;
        if (场景结果.事实) {
            宿主读取.世界根 = 场景结果.事实->世界根;
            宿主读取.初始场景 = 场景结果.事实->初始场景.编码;
            宿主读取.场景标记值 = 场景结果.事实->场景标记.编码;
            宿主读取.直接父关系 = 场景结果.事实->直接父关系.编码;
        }
        I64特征定义读取请求 定义读取;
        if (I64结果.事实) {
            定义读取.特征定义 = I64结果.事实->特征定义;
            定义读取.定义标记值 = I64结果.定义标记值;
            定义读取.下界值 = I64结果.下界值;
            定义读取.上界值 = I64结果.上界值;
        }
        初始场景I64实例特征建立请求 建立请求;
        建立请求.幂等身份 = {0x6001};
        建立请求.期望事实代次 = 实例登记.登记 ? 实例登记.登记->事实截止代次 : 0;
        建立请求.宿主 = 宿主读取;
        建立请求.定义 = 定义读取;
        建立请求.初始值 = 3;
        建立请求.来源节点 = I64结果.事实 ? I64结果.事实->来源服务 : 稳定编码{};
        const auto 建立结果 = 实例.建立初始场景I64实例特征(建立请求);
        报告.验收[5] = 建立结果.状态 == 实例特征状态::已提交
            && 建立结果.事实.has_value() && 建立结果.事实->事实截止代次 == 6
            && 建立结果.事实->I64值 == 3;

        const auto 重复 = 实例.建立初始场景I64实例特征(建立请求);
        报告.验收[6] = 重复.状态 == 实例特征状态::幂等读回 && 重复.事实.has_value()
            && 重复.事实->实例槽 == 建立结果.事实->实例槽;
        auto 冲突请求 = 建立请求;
        冲突请求.初始值 = 4;
        报告.验收[7] = 实例.建立初始场景I64实例特征(冲突请求).状态 == 实例特征状态::幂等冲突;

        I64实例特征读取请求 读取请求;
        读取请求.宿主 = 宿主读取;
        读取请求.定义 = 定义读取;
        if (建立结果.事实) {
            读取请求.实例槽 = 建立结果.事实->实例槽;
            读取请求.当前值 = 建立结果.事实->当前值;
            读取请求.来源节点 = 建立结果.事实->来源节点;
        }
        读取请求.宿主关系 = 建立结果.宿主关系;
        读取请求.定义关系 = 建立结果.定义关系;
        const auto 读取 = 实例.读取I64实例特征(读取请求);
        报告.验收[8] = 读取.状态 == 实例特征状态::已读取 && 读取.事实.has_value()
            && 读取.事实->I64值 == 3 && 读取.事实->事实截止代次 == 6;

        auto 错误读取 = 读取请求;
        错误读取.当前值 = {};
        报告.验收[9] = 实例.读取I64实例特征(错误读取).状态 == 实例特征状态::入口拒绝;

        I64实例特征当前值换代请求 换代请求;
        换代请求.幂等身份 = {0x7001};
        换代请求.期望事实代次 = 建立结果.事实
            ? 建立结果.事实->事实截止代次 : 0;
        换代请求.当前事实 = 读取请求;
        换代请求.新值 = 5;
        换代请求.新来源节点 = 建立请求.来源节点;
        const auto 换代结果 = 实例.换代I64实例特征当前值(换代请求);
        报告.验收[16] = 换代结果.状态 == 实例特征状态::已提交
            && 换代结果.事实.has_value() && 换代结果.事实->I64值 == 5
            && 换代结果.事实->事实截止代次 == 7;

        auto 新读取请求 = 读取请求;
        if (换代结果.事实) {
            新读取请求.当前值 = 换代结果.事实->当前值;
            新读取请求.来源节点 = 换代结果.事实->来源节点;
        }
        const auto 新读取 = 实例.读取I64实例特征(新读取请求);
        const auto 旧当前 = L1.读取当前值({L1事实基座合同版本,
            读取请求.当前值});
        const auto 旧历史 = L1.读取历史事实({L1事实基座合同版本,
            读取请求.当前值});
        const auto* 旧值 = 旧历史.历史.has_value()
            ? std::get_if<值事实>(&旧历史.历史->事实) : nullptr;
        报告.验收[17] = 新读取.状态 == 实例特征状态::已读取
            && 新读取.事实.has_value() && 新读取.事实->I64值 == 5
            && 新读取.事实->事实截止代次 == 7;
        报告.验收[18] = 旧当前.状态 == L1读取状态::已退出
            && !旧当前.事实.has_value() && 旧历史.状态 == L1读取状态::成功
            && 旧历史.历史.has_value() && !旧历史.历史->当前有效 && 旧值
            && 旧值->退出事实代次 == std::optional<std::uint64_t>{7}
            && std::holds_alternative<std::int64_t>(旧值->材料)
            && std::get<std::int64_t>(旧值->材料) == 3;
        const auto 当前槽 = L1.读取当前属性({L1事实基座合同版本,
            读取请求.实例槽, 实例登记.登记
                ? 实例登记.登记->当前I64值属性类型 : 稳定编码{}});
        报告.验收[19] = 当前槽.状态 == L1读取状态::成功
            && 当前槽.属性.has_value() && 当前槽.读取事实代次 == 7
            && 换代结果.事实.has_value()
            && 当前槽.属性->当前值 == 换代结果.事实->当前值;
        const auto 重复换代 = 实例.换代I64实例特征当前值(换代请求);
        报告.验收[20] = 重复换代.状态 == 实例特征状态::幂等读回
            && 重复换代.事实.has_value()
            && 重复换代.事实->事实截止代次 == 7;
        auto 同键异义 = 换代请求;
        同键异义.新值 = 6;
        报告.验收[21] = 实例.换代I64实例特征当前值(同键异义).状态
            == 实例特征状态::幂等冲突;
        const auto 换代后快照 = L1.读取完整快照({});
        auto 旧基线 = 换代请求;
        旧基线.幂等身份 = {0x7002};
        const auto 旧基线结果 = 实例.换代I64实例特征当前值(旧基线);
        const auto 旧基线后快照 = L1.读取完整快照({});
        报告.验收[22] = 旧基线结果.状态 != 实例特征状态::已提交
            && 旧基线结果.状态 != 实例特征状态::幂等读回
            && 换代后快照.快照.has_value() && 旧基线后快照.快照.has_value()
            && 换代后快照.快照->事实代次 == 旧基线后快照.快照->事实代次;
        auto 错误当前 = 换代请求;
        错误当前.幂等身份 = {0x7003};
        错误当前.当前事实.当前值 = {};
        报告.验收[23] = 实例.换代I64实例特征当前值(错误当前).状态
            == 实例特征状态::入口拒绝;
        auto 错误来源 = 换代请求;
        错误来源.幂等身份 = {0x7004};
        错误来源.期望事实代次 = 7;
        错误来源.当前事实 = 新读取请求;
        错误来源.新来源节点 = 实例登记.登记
            ? 实例登记.登记->当前I64值属性类型 : 稳定编码{};
        报告.验收[24] = 实例.换代I64实例特征当前值(错误来源).状态
            == 实例特征状态::入口拒绝;
        auto 越界换代 = 换代请求;
        越界换代.幂等身份 = {0x7005};
        越界换代.期望事实代次 = 7;
        越界换代.当前事实 = 新读取请求;
        越界换代.新值 = 11;
        报告.验收[25] = 实例.换代I64实例特征当前值(越界换代).状态
            == 实例特征状态::入口拒绝;
        L1实例特征服务 未登记实例(L1, 场景, 定义);
        auto 未登记 = 换代请求;
        未登记.幂等身份 = {0x7006};
        报告.验收[26] = 未登记实例.换代I64实例特征当前值(未登记).状态
            == 实例特征状态::登记未加载;

        auto 越界 = 建立请求;
        越界.幂等身份 = {0x6002};
        越界.初始值 = 11;
        越界.期望事实代次 = 8;
        L1实例特征服务 漂移实例(L1, 场景, 定义);
        实例特征登记请求 漂移登记请求;
        漂移登记请求.幂等身份 = {0x5002};
        漂移登记请求.期望事实代次 = 7;
        const auto 漂移登记 = 漂移实例.建立登记(漂移登记请求);
        const auto 越界结果 = 漂移实例.建立初始场景I64实例特征(越界);
        报告.验收[10] = 越界结果.状态 == 实例特征状态::入口拒绝;
        auto 旧代次 = 建立请求;
        旧代次.幂等身份 = {0x6003};
        旧代次.期望事实代次 = 5;
        const auto 漂移结果 = 漂移实例.建立初始场景I64实例特征(旧代次);
        报告.验收[11] = 漂移登记.状态 == 实例特征状态::已提交
            && 漂移结果.状态 == 实例特征状态::事实代次漂移;
        报告.验收[12] = L1.读取完整快照({}).快照.has_value()
            && L1.读取完整快照({}).快照->事实代次 == 8;
        const auto 第二次登记 = 实例.建立登记(实例登记请求);
        报告.验收[13] = 第二次登记.状态 == 实例特征状态::幂等读回;
        报告.验收[14] = 实例.读取当前登记().状态 == 实例特征状态::已读取;
        报告.验收[15] = 建立结果.宿主关系 != 稳定编码{}
            && 建立结果.定义关系 != 稳定编码{};
    } catch (...) {
    }
    for (const bool 通过 : 报告.验收) if (!通过) ++报告.失败数量;
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
