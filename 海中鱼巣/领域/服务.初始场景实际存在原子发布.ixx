module;

#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>

export module 海中鱼巣.领域.服务.初始场景实际存在原子发布;

export import 海中鱼巣.领域.服务.L1实际存在;
import 海中鱼巣.核心.服务.L1事实基座;

namespace 海中鱼巣::初始场景实际存在原子发布内部 {

inline constexpr std::uint64_t 创建幂等域 = 0x0BULL;

// 诊断责任：无适用错误分支；纯值技术幂等键映射不读取状态。
L1中性写集幂等键 映射幂等键(实际存在操作幂等身份 身份) noexcept {
    return {(创建幂等域 << 56) | 身份.值};
}

// 诊断责任：无适用错误分支；纯值中性写入状态映射完整覆盖枚举。
实际存在状态 映射写入状态(L1中性写入状态 状态) noexcept {
    switch (状态) {
    case L1中性写入状态::成功: return 实际存在状态::已提交;
    case L1中性写入状态::精确重复: return 实际存在状态::幂等读回;
    case L1中性写入状态::入口拒绝: return 实际存在状态::入口拒绝;
    case L1中性写入状态::事实代次漂移: return 实际存在状态::版本漂移;
    case L1中性写入状态::幂等冲突: return 实际存在状态::幂等冲突;
    case L1中性写入状态::资源失败: return 实际存在状态::资源失败;
    case L1中性写入状态::未找到:
    case L1中性写入状态::已退出:
    case L1中性写入状态::内部不一致:
        return 实际存在状态::内部不一致;
    }
    return 实际存在状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值场景状态映射按稳定同值语义逐项列举。
实际存在状态 映射场景状态(世界结构状态 状态) noexcept {
    switch (状态) {
    case 世界结构状态::已提交: return 实际存在状态::已提交;
    case 世界结构状态::幂等读回: return 实际存在状态::幂等读回;
    case 世界结构状态::已读取: return 实际存在状态::已读取;
    case 世界结构状态::未找到: return 实际存在状态::未找到;
    case 世界结构状态::入口拒绝: return 实际存在状态::入口拒绝;
    case 世界结构状态::幂等冲突: return 实际存在状态::幂等冲突;
    case 世界结构状态::版本漂移: return 实际存在状态::版本漂移;
    case 世界结构状态::许可拒绝: return 实际存在状态::许可拒绝;
    case 世界结构状态::资源失败: return 实际存在状态::资源失败;
    case 世界结构状态::内部不一致: return 实际存在状态::内部不一致;
    }
    return 实际存在状态::内部不一致;
}

// 诊断责任：无适用错误分支；创建后附加精确读的中性状态只保留可恢复资源失败。
实际存在状态 映射读取状态(L1中性读取状态 状态) noexcept {
    return 状态 == L1中性读取状态::资源失败
        ? 实际存在状态::资源失败
        : 实际存在状态::内部不一致;
}

// 诊断责任：无适用错误分支；缺失或重复本地键均收敛为空值。
std::optional<稳定编码> 查找映射(
    const L1中性写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；纯值映射唯一性判断不读取状态。
bool 映射唯一(const L1中性写入结果& 结果) noexcept {
    for (std::size_t i = 0; i < 结果.新编码映射.size(); ++i) {
        if (!有效(结果.新编码映射[i].first)
            || !有效(结果.新编码映射[i].second)) return false;
        for (std::size_t j = i + 1; j < 结果.新编码映射.size(); ++j) {
            if (结果.新编码映射[i].first == 结果.新编码映射[j].first
                || 结果.新编码映射[i].second == 结果.新编码映射[j].second)
                return false;
        }
    }
    return true;
}

} // namespace 海中鱼巣::初始场景实际存在原子发布内部

export namespace 海中鱼巣 {

class 初始场景实际存在原子发布服务 final {
public:
    // 诊断责任：无适用错误分支；构造只绑定同一运行期上下文中的既有服务引用。
    初始场景实际存在原子发布服务(L1事实基座服务& L1,
        L1实际存在服务& 存在, L1场景结构服务& 场景) noexcept
        : L1_(L1), 存在_(存在), 场景_(场景) {}
    初始场景实际存在原子发布服务(const 初始场景实际存在原子发布服务&) = delete;
    初始场景实际存在原子发布服务& operator=(
        const 初始场景实际存在原子发布服务&) = delete;

    // 诊断责任：向上送出；全部准入、写入和读回失败保留为结构化实际存在状态。
    实际存在结果 发布初始场景实际存在(const 实际存在创建请求& 请求) {
        try {
            if (!实际存在创建请求有效(请求)) return {};

            const auto 存在规格 = 存在_.形成实际存在写入规格(
                {请求.合同版本, 请求.规则版本, 请求.期望事实代次});
            if (存在规格.状态 != 实际存在状态::已读取 || !存在规格.规格)
                return {存在规格.规格 ? 存在规格.状态
                    : (存在规格.状态 == 实际存在状态::已读取
                        ? 实际存在状态::内部不一致 : 存在规格.状态), std::nullopt};
            if (!实际存在写入规格完整(*存在规格.规格))
                return {实际存在状态::内部不一致, std::nullopt};
            if (存在规格.规格->事实截止代次 != 请求.期望事实代次)
                return {实际存在状态::版本漂移, std::nullopt};

            const auto 场景规格 = 场景_.形成初始场景接纳规格(
                {请求.目标场景, 请求.期望事实代次});
            if (场景规格.状态 != 世界结构状态::已读取 || !场景规格.规格) {
                const auto 状态 = 初始场景实际存在原子发布内部::映射场景状态(
                    场景规格.状态);
                return {场景规格.规格 ? 状态
                    : (状态 == 实际存在状态::已读取
                        ? 实际存在状态::内部不一致 : 状态), std::nullopt};
            }
            if (!初始场景接纳规格完整(*场景规格.规格))
                return {实际存在状态::内部不一致, std::nullopt};
            if (场景规格.规格->事实截止代次 != 请求.期望事实代次
                || 场景规格.规格->事实截止代次
                    != 存在规格.规格->事实截止代次)
                return {实际存在状态::版本漂移, std::nullopt};

            const auto 幂等键 = 初始场景实际存在原子发布内部::映射幂等键(
                请求.幂等身份);
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = 幂等键;
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
            写集.值 = {{{2}, L1中性写集本地键{1},
                稳定编码{存在规格.规格->资格属性类型.编码},
                std::int64_t{存在规格.规格->资格值},
                稳定编码{存在规格.规格->服务身份.编码}}};
            写集.关系 = {{{3}, 稳定编码{场景规格.规格->场景.编码},
                L1中性写集本地键{1},
                稳定编码{场景规格.规格->直接成员关系类型.编码}, 0}};
            写集.属性槽变更 = {{L1中性写集本地键{1},
                稳定编码{存在规格.规格->资格属性类型.编码},
                L1中性写集本地键{2}}};

            const auto 写入 = L1_.提交中性写集(写集);
            const auto 状态 = 初始场景实际存在原子发布内部::映射写入状态(
                写入.状态);
            if (状态 != 实际存在状态::已提交
                && 状态 != 实际存在状态::幂等读回)
                return {状态, std::nullopt};

            const bool 首次成功完整 = 写入.状态 == L1中性写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::不适用;
            const bool 重复成功完整 = 写入.状态 == L1中性写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1中性重试边界::原幂等键读回收敛;
            if (写入.合同版本 != L1中性CRUD合同版本
                || !(写入.幂等键 == 幂等键) || 写入.事实代次 == 0
                || 写入.新编码映射.size() != 3
                || (!首次成功完整 && !重复成功完整)
                || !初始场景实际存在原子发布内部::映射唯一(写入))
                return {实际存在状态::内部不一致, std::nullopt};

            const auto 存在编码 = 初始场景实际存在原子发布内部::查找映射(写入, 1);
            const auto 资格编码 = 初始场景实际存在原子发布内部::查找映射(写入, 2);
            const auto 关系编码 = 初始场景实际存在原子发布内部::查找映射(写入, 3);
            if (!存在编码 || !资格编码 || !关系编码
                || *存在编码 == *资格编码 || *存在编码 == *关系编码
                || *资格编码 == *关系编码)
                return {实际存在状态::内部不一致, std::nullopt};

            实际存在读取请求 读取请求;
            读取请求.当前场景 = 请求.目标场景;
            读取请求.存在 = *存在编码;
            读取请求.资格值 = *资格编码;
            读取请求.当前场景归属关系 = *关系编码;
            if (!实际存在读取请求有效(读取请求))
                return {实际存在状态::内部不一致, std::nullopt};

            auto 读回 = 读取组合事实(读取请求, 写入.事实代次);
            if (读回.状态 != 实际存在状态::已读取 || !读回.事实)
                return {读回.状态, std::nullopt};
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) {
            return {实际存在状态::资源失败, std::nullopt};
        } catch (...) {
            return {实际存在状态::内部不一致, std::nullopt};
        }
    }

    // 诊断责任：向上送出；两个事实所有者的读取失败和互证矛盾均结构化返回。
    实际存在结果 读取初始场景实际存在(const 实际存在读取请求& 请求) const {
        try {
            if (!实际存在读取请求有效(请求)) return {};
            return 读取组合事实(请求, std::nullopt);
        } catch (const std::bad_alloc&) {
            return {实际存在状态::资源失败, std::nullopt};
        } catch (...) {
            return {实际存在状态::内部不一致, std::nullopt};
        }
    }

private:
    // 诊断责任：向上送出；同截止、字段互证和可选创建代次失败均收敛为结构化结果。
    实际存在结果 读取组合事实(const 实际存在读取请求& 请求,
        std::optional<std::uint64_t> 期望创建代次) const {
        const auto 资格 = 存在_.读取实际存在资格(
            {请求.合同版本, 请求.规则版本, 请求.存在, 请求.资格值});
        if (资格.状态 != 实际存在状态::已读取 || !资格.事实)
            return {资格.事实 ? 资格.状态
                : (资格.状态 == 实际存在状态::已读取
                    ? 实际存在状态::内部不一致 : 资格.状态), std::nullopt};

        const auto 接纳 = 场景_.读取初始场景接纳(
            {请求.当前场景, 请求.存在, 请求.当前场景归属关系});
        if (接纳.状态 != 世界结构状态::已读取 || !接纳.事实) {
            const auto 状态 = 初始场景实际存在原子发布内部::映射场景状态(
                接纳.状态);
            return {接纳.事实 ? 状态
                : (状态 == 实际存在状态::已读取
                    ? 实际存在状态::内部不一致 : 状态), std::nullopt};
        }
        if (!实际存在资格事实完整(*资格.事实)
            || !初始场景接纳事实完整(*接纳.事实)
            || 资格.事实->存在 != 接纳.事实->成员)
            return {实际存在状态::内部不一致, std::nullopt};
        if (资格.事实->事实截止代次 != 接纳.事实->事实截止代次)
            return {实际存在状态::版本漂移, std::nullopt};

        实际存在事实 事实;
        事实.事实截止代次 = 资格.事实->事实截止代次;
        事实.世界根 = 请求.当前场景.世界根;
        事实.存在 = 资格.事实->存在;
        事实.当前场景 = 接纳.事实->场景;
        事实.资格 = 资格.事实->资格;
        事实.当前场景归属关系 = 接纳.事实->归属关系;
        if (!实际存在事实完整(事实))
            return {实际存在状态::内部不一致, std::nullopt};

        if (期望创建代次) {
            const auto 节点 = L1_.读取中性当前节点(
                {L1中性CRUD合同版本, 请求.存在});
            const auto 关系 = L1_.读取中性当前关系(
                {L1中性CRUD合同版本, 请求.当前场景归属关系});
            if (节点.状态 != L1中性读取状态::成功)
                return {初始场景实际存在原子发布内部::映射读取状态(节点.状态),
                    std::nullopt};
            if (关系.状态 != L1中性读取状态::成功)
                return {初始场景实际存在原子发布内部::映射读取状态(关系.状态),
                    std::nullopt};
            if (!节点.事实 || !关系.事实
                || 节点.合同版本 != L1中性CRUD合同版本
                || 关系.合同版本 != L1中性CRUD合同版本
                || 节点.查询编码 != 请求.存在
                || 关系.查询编码 != 请求.当前场景归属关系
                || 节点.读取事实代次 != 事实.事实截止代次
                || 关系.读取事实代次 != 事实.事实截止代次
                || 节点.事实->编码 != 请求.存在
                || 关系.事实->编码 != 请求.当前场景归属关系
                || 节点.事实->创建事实代次 != *期望创建代次
                || 资格.事实->资格.创建事实代次 != *期望创建代次
                || 关系.事实->创建事实代次 != *期望创建代次
                || 节点.事实->退出事实代次.has_value()
                || 关系.事实->退出事实代次.has_value())
                return {实际存在状态::内部不一致, std::nullopt};
        }
        return {实际存在状态::已读取, 事实};
    }

    L1事实基座服务& L1_;
    L1实际存在服务& 存在_;
    L1场景结构服务& 场景_;
};

} // namespace 海中鱼巣
