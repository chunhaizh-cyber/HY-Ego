module;

#include <algorithm>
#include <cstdint>
#include <new>
#include <optional>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.组合.L1实际存在场景;

export import 海中鱼巣.领域.服务.初始场景实际存在原子发布;

namespace 海中鱼巣::L1实际存在场景组合内部 {

实际存在状态 映射场景状态(世界结构状态 状态) noexcept {
    switch (状态) {
    case 世界结构状态::已提交: return 实际存在状态::已提交;
    case 世界结构状态::幂等读回: return 实际存在状态::幂等读回;
    case 世界结构状态::已读取: return 实际存在状态::已读取;
    case 世界结构状态::未找到: return 实际存在状态::未找到;
    case 世界结构状态::入口拒绝: return 实际存在状态::入口拒绝;
    case 世界结构状态::幂等冲突: return 实际存在状态::幂等冲突;
    case 世界结构状态::版本漂移: return 实际存在状态::版本漂移;
    case 世界结构状态::许可拒绝: return 实际存在状态::许可拒绝;
    case 世界结构状态::资源失败: return 实际存在状态::资源失败;
    case 世界结构状态::内部不一致: return 实际存在状态::内部不一致;
    }
    return 实际存在状态::内部不一致;
}

世界结构状态 映射实际存在读取状态(实际存在状态 状态) noexcept {
    switch (状态) {
    case 实际存在状态::入口拒绝: return 世界结构状态::入口拒绝;
    case 实际存在状态::版本漂移: return 世界结构状态::版本漂移;
    case 实际存在状态::许可拒绝: return 世界结构状态::许可拒绝;
    case 实际存在状态::资源失败: return 世界结构状态::资源失败;
    case 实际存在状态::已读取:
    case 实际存在状态::未找到:
    case 实际存在状态::已提交:
    case 实际存在状态::幂等读回:
    case 实际存在状态::幂等冲突:
    case 实际存在状态::内部不一致:
        return 世界结构状态::内部不一致;
    }
    return 世界结构状态::内部不一致;
}

bool 写前事实匹配请求(const 实际存在事实& 事实,
    const 实际存在当前场景移除请求& 请求) noexcept {
    return 实际存在事实完整(事实)
        && 事实.合同版本 == 请求.合同版本
        && 事实.规则版本 == 请求.规则版本
        && 事实.事实截止代次 == 请求.期望事实代次
        && 事实.世界根 == 请求.当前事实.当前场景.世界根
        && 事实.当前场景.编码 == 请求.当前事实.当前场景.初始场景
        && 事实.存在.编码 == 请求.当前事实.存在
        && 事实.资格.编码 == 请求.当前事实.资格值
        && 事实.当前场景归属关系.编码
            == 请求.当前事实.当前场景归属关系;
}

} // namespace 海中鱼巣::L1实际存在场景组合内部

export namespace 海中鱼巣 {

struct 初始场景完整事实 final {
    std::uint32_t 合同版本 = L1实际存在合同版本;
    std::uint32_t 世界规则版本 = 初始场景完整结构事实{}.世界规则版本;
    std::uint64_t 事实截止代次 = 0;
    世界结构节点身份见证 世界根;
    初始场景完整结构事实 场景结构;
    std::vector<实际存在事实> 直接存在成员完整事实组;
    friend bool operator==(const 初始场景完整事实&,
        const 初始场景完整事实&) = default;
};

struct 初始场景完整事实结果 final {
    世界结构状态 状态 = 世界结构状态::入口拒绝;
    std::optional<初始场景完整事实> 事实;
    bool 成功() const noexcept;
    friend bool operator==(const 初始场景完整事实结果&,
        const 初始场景完整事实结果&) = default;
};

inline bool 初始场景完整事实完整(const 初始场景完整事实& 事实) noexcept {
    if (事实.合同版本 != L1实际存在合同版本
        || 事实.世界规则版本 != 事实.场景结构.世界规则版本
        || 事实.事实截止代次 == 0
        || !初始场景完整结构事实完整(事实.场景结构)
        || 事实.世界根 != 事实.场景结构.世界根
        || 事实.场景结构.事实截止代次 != 事实.事实截止代次
        || 事实.直接存在成员完整事实组.size()
            != 事实.场景结构.直接存在成员组.size())
        return false;
    std::uint64_t 前一存在 = 0;
    for (std::size_t i = 0; i < 事实.直接存在成员完整事实组.size(); ++i) {
        const auto& 成员结构 = 事实.场景结构.直接存在成员组[i];
        const auto& 成员事实 = 事实.直接存在成员完整事实组[i];
        if (!实际存在事实完整(成员事实)
            || 成员事实.合同版本 != 事实.合同版本
            || 成员事实.规则版本 != L1实际存在规则版本
            || 成员事实.事实截止代次 != 事实.事实截止代次
            || 成员事实.世界根 != 事实.世界根
            || 成员事实.当前场景 != 事实.场景结构.场景.初始场景
            || 成员事实.存在 != 成员结构.成员
            || 成员事实.当前场景归属关系 != 成员结构.归属关系
            || 成员事实.存在.编码.值 <= 前一存在)
            return false;
        前一存在 = 成员事实.存在.编码.值;
    }
    return true;
}

inline bool 初始场景完整事实结果::成功() const noexcept {
    return 状态 == 世界结构状态::已读取 && 事实.has_value()
        && 初始场景完整事实完整(*事实);
}

class L1实际存在场景组合服务 final {
public:
    // 诊断责任：无适用错误分支；构造只绑定唯一原子发布服务引用。
    explicit L1实际存在场景组合服务(
        初始场景实际存在原子发布服务& 发布服务,
        L1场景结构服务& 场景服务,
        L1实际存在服务& 实际存在服务) noexcept
        : 发布服务_(发布服务), 场景服务_(场景服务),
          实际存在服务_(实际存在服务) {}

    // 诊断责任：向上送出；原子发布服务的结构化结果不经解释原样返回。
    实际存在结果 在初始场景创建实际存在(const 实际存在创建请求& 请求) {
        return static_cast<const L1实际存在场景组合服务&>(*this)
            .在初始场景创建实际存在(请求);
    }

    // 诊断责任：向上送出；原子发布服务的结构化结果不经解释原样返回。
    实际存在结果 在初始场景创建实际存在(
        const 实际存在创建请求& 请求) const {
        return 发布服务_.发布初始场景实际存在(请求);
    }

    // 诊断责任：向上送出；原子发布服务的权威读回结果不经解释原样返回。
    实际存在结果 读取实际存在(const 实际存在读取请求& 请求) const {
        return 发布服务_.读取初始场景实际存在(请求);
    }

    // 诊断责任：向上送出；三个具名领域读取的非成功与互证矛盾均结构化返回。
    初始场景完整事实结果 读取初始场景完整事实(
        const 初始场景读取请求& 请求) const {
        try {
            const auto 场景结构结果 = 场景服务_.读取初始场景完整结构(请求);
            if (场景结构结果.状态 != 世界结构状态::已读取
                || !场景结构结果.事实)
                return {场景结构结果.状态 == 世界结构状态::已读取
                        ? 世界结构状态::内部不一致 : 场景结构结果.状态,
                    std::nullopt};
            if (!初始场景完整结构事实完整(*场景结构结果.事实))
                return {世界结构状态::内部不一致, std::nullopt};

            初始场景完整事实 事实;
            事实.事实截止代次 = 场景结构结果.事实->事实截止代次;
            事实.世界根 = 场景结构结果.事实->世界根;
            事实.场景结构 = *场景结构结果.事实;
            事实.直接存在成员完整事实组.reserve(
                事实.场景结构.直接存在成员组.size());
            for (const auto& 成员结构 : 事实.场景结构.直接存在成员组) {
                const 实际存在资格定位读取请求 资格请求{
                    L1实际存在合同版本, L1实际存在规则版本, 成员结构.成员.编码};
                const auto 资格结果 = 实际存在服务_.读取当前实际存在资格(资格请求);
                if (资格结果.状态 != 实际存在状态::已读取 || !资格结果.事实)
                    return {资格结果.状态 == 实际存在状态::未找到
                            || 资格结果.状态 == 实际存在状态::已读取
                        ? 世界结构状态::内部不一致
                        : L1实际存在场景组合内部::映射实际存在读取状态(资格结果.状态),
                        std::nullopt};
                if (!实际存在资格事实完整(*资格结果.事实)
                    || 资格结果.事实->存在 != 成员结构.成员)
                    return {世界结构状态::内部不一致, std::nullopt};
                if (资格结果.事实->事实截止代次 != 事实.事实截止代次)
                    return {世界结构状态::版本漂移, std::nullopt};

                实际存在读取请求 读取请求;
                读取请求.合同版本 = L1实际存在合同版本;
                读取请求.规则版本 = L1实际存在规则版本;
                读取请求.当前场景 = 请求;
                读取请求.存在 = 成员结构.成员.编码;
                读取请求.资格值 = 资格结果.事实->资格.编码;
                读取请求.当前场景归属关系 = 成员结构.归属关系.编码;
                if (!实际存在读取请求有效(读取请求))
                    return {世界结构状态::内部不一致, std::nullopt};
                const auto 成员结果 = 发布服务_.读取初始场景实际存在(读取请求);
                if (成员结果.状态 != 实际存在状态::已读取 || !成员结果.事实)
                    return {成员结果.状态 == 实际存在状态::未找到
                            || 成员结果.状态 == 实际存在状态::已读取
                        ? 世界结构状态::内部不一致
                        : L1实际存在场景组合内部::映射实际存在读取状态(成员结果.状态),
                        std::nullopt};
                const auto& 成员事实 = *成员结果.事实;
                if (!实际存在事实完整(成员事实)
                    || 成员事实.世界根 != 事实.世界根
                    || 成员事实.当前场景 != 事实.场景结构.场景.初始场景
                    || 成员事实.存在 != 成员结构.成员
                    || 成员事实.资格 != 资格结果.事实->资格
                    || 成员事实.当前场景归属关系 != 成员结构.归属关系)
                    return {成员事实.事实截止代次 == 事实.事实截止代次
                        ? 世界结构状态::内部不一致 : 世界结构状态::版本漂移,
                        std::nullopt};
                if (成员事实.事实截止代次 != 事实.事实截止代次)
                    return {世界结构状态::版本漂移, std::nullopt};
                事实.直接存在成员完整事实组.push_back(成员事实);
            }
            std::sort(事实.直接存在成员完整事实组.begin(),
                事实.直接存在成员完整事实组.end(),
                [](const auto& 左, const auto& 右) {
                    return 左.存在.编码.值 < 右.存在.编码.值;
                });
            return 初始场景完整事实完整(事实)
                ? 初始场景完整事实结果{世界结构状态::已读取, std::move(事实)}
                : 初始场景完整事实结果{世界结构状态::内部不一致, std::nullopt};
        } catch (const std::bad_alloc&) {
            return {世界结构状态::资源失败, std::nullopt};
        } catch (...) {
            return {世界结构状态::内部不一致, std::nullopt};
        }
    }

    // 诊断责任：向上送出；三个具名领域服务的非成功与互证矛盾均结构化返回。
    实际存在当前场景移除结果 移除实际存在当前场景(
        const 实际存在当前场景移除请求& 请求) const {
        try {
            if (!实际存在当前场景移除请求有效(请求)) return {};

            const auto 写前组合 = 发布服务_.读取初始场景实际存在(请求.当前事实);
            bool 已退出候选 = false;
            if (写前组合.状态 == 实际存在状态::已读取
                && 写前组合.事实.has_value()) {
                if (!L1实际存在场景组合内部::写前事实匹配请求(*写前组合.事实, 请求))
                    return {写前组合.事实->事实截止代次 == 请求.期望事实代次
                        ? 实际存在状态::内部不一致 : 实际存在状态::版本漂移,
                        std::nullopt};
            } else if (写前组合.状态 == 实际存在状态::未找到
                && !写前组合.事实.has_value()) {
                已退出候选 = true;
            } else {
                return {写前组合.状态 == 实际存在状态::已读取
                        ? 实际存在状态::内部不一致 : 写前组合.状态,
                    std::nullopt};
            }

            const 实际存在资格读取请求 资格请求{请求.合同版本, 请求.规则版本,
                请求.当前事实.存在, 请求.当前事实.资格值};
            const auto 写前资格 = 实际存在服务_.读取实际存在资格(资格请求);
            if (写前资格.状态 != 实际存在状态::已读取 || !写前资格.事实)
                return {写前资格.状态 == 实际存在状态::已读取
                        ? 实际存在状态::内部不一致 : 写前资格.状态,
                    std::nullopt};
            if (!实际存在资格事实完整(*写前资格.事实)
                || 写前资格.事实->存在.编码 != 请求.当前事实.存在
                || 写前资格.事实->资格.编码 != 请求.当前事实.资格值)
                return {实际存在状态::内部不一致, std::nullopt};
            if (已退出候选) {
                if (写前资格.事实->事实截止代次 < 请求.期望事实代次)
                    return {实际存在状态::版本漂移, std::nullopt};
            } else if (!写前组合.事实
                || 写前资格.事实->事实截止代次 != 请求.期望事实代次
                || 写前资格.事实->存在 != 写前组合.事实->存在
                || 写前资格.事实->资格 != 写前组合.事实->资格) {
                return {写前资格.事实->事实截止代次 == 请求.期望事实代次
                    ? 实际存在状态::内部不一致 : 实际存在状态::版本漂移,
                    std::nullopt};
            }

            初始场景直接存在成员退出请求 场景请求;
            场景请求.世界规则版本 = 请求.当前事实.当前场景.世界规则版本;
            场景请求.幂等身份 = {请求.幂等身份.值};
            场景请求.期望事实代次 = 请求.期望事实代次;
            场景请求.场景 = 请求.当前事实.当前场景;
            场景请求.存在 = 写前资格.事实->存在;
            场景请求.当前归属关系 = 请求.当前事实.当前场景归属关系;
            const auto 场景退出 = 场景服务_.退出初始场景直接存在成员关系(场景请求);
            const auto 场景状态 = L1实际存在场景组合内部::映射场景状态(场景退出.状态);
            if (!场景退出.成功() || !场景退出.事实)
                return {场景退出.事实 ? 实际存在状态::内部不一致 : 场景状态,
                    std::nullopt};
            if (已退出候选 && 场景退出.状态 != 世界结构状态::幂等读回)
                return {实际存在状态::内部不一致, std::nullopt};

            const auto 写后资格 = 实际存在服务_.读取实际存在资格(资格请求);
            if (写后资格.状态 != 实际存在状态::已读取 || !写后资格.事实)
                return {写后资格.状态 == 实际存在状态::已读取
                        ? 实际存在状态::内部不一致 : 写后资格.状态,
                    std::nullopt};
            if (!实际存在资格事实完整(*写后资格.事实)
                || 写后资格.事实->存在 != 写前资格.事实->存在
                || 写后资格.事实->资格 != 写前资格.事实->资格
                || 写后资格.事实->事实截止代次 != 场景退出.事实->事实截止代次)
                return {写后资格.事实->事实截止代次
                        == 场景退出.事实->事实截止代次
                    ? 实际存在状态::内部不一致 : 实际存在状态::版本漂移,
                    std::nullopt};

            const auto 写后组合 = 发布服务_.读取初始场景实际存在(请求.当前事实);
            if (写后组合.状态 != 实际存在状态::未找到
                || 写后组合.事实.has_value())
                return {实际存在状态::内部不一致, std::nullopt};

            实际存在当前场景移除事实 事实;
            事实.发布事实代次 = 场景退出.事实->发布事实代次;
            事实.事实截止代次 = 场景退出.事实->事实截止代次;
            事实.世界根 = 场景退出.事实->世界根;
            事实.存在 = 场景退出.事实->存在;
            事实.原场景 = 场景退出.事实->原场景;
            事实.资格 = 写后资格.事实->资格;
            事实.已退出归属关系 = {场景退出.事实->已退出归属关系.关系,
                场景退出.事实->已退出归属关系.创建事实代次,
                场景退出.事实->已退出归属关系.退出事实代次};
            if (!实际存在当前场景移除事实完整(事实))
                return {实际存在状态::内部不一致, std::nullopt};
            return {场景状态, 事实};
        } catch (const std::bad_alloc&) {
            return {实际存在状态::资源失败, std::nullopt};
        } catch (...) {
            return {实际存在状态::内部不一致, std::nullopt};
        }
    }

private:
    初始场景实际存在原子发布服务& 发布服务_;
    L1场景结构服务& 场景服务_;
    L1实际存在服务& 实际存在服务_;
};

} // namespace 海中鱼巣
