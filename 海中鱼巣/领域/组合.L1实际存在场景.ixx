module;

#include <cstdint>
#include <new>
#include <optional>
#include <mutex>
#include <vector>

export module 海中鱼巣.领域.组合.L1实际存在场景;

export import 海中鱼巣.领域.服务.L1实际存在;
import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.核心.服务.L1事实基座;

namespace 海中鱼巣::L1实际存在场景内部 {

inline constexpr std::uint64_t 创建幂等域 = 0x0BULL;

写集幂等键 映射幂等键(实际存在操作幂等身份 身份) noexcept {
    return {(创建幂等域 << 56) | 身份.值};
}

实际存在状态 映射写入状态(L1写入状态 状态) noexcept {
    switch (状态) {
    case L1写入状态::成功: return 实际存在状态::已提交;
    case L1写入状态::精确重复: return 实际存在状态::幂等读回;
    case L1写入状态::幂等冲突: return 实际存在状态::幂等冲突;
    case L1写入状态::事实代次漂移: return 实际存在状态::版本漂移;
    case L1写入状态::资源失败: return 实际存在状态::资源失败;
    case L1写入状态::内部不一致: return 实际存在状态::内部不一致;
    case L1写入状态::未找到:
    case L1写入状态::已退出: return 实际存在状态::未找到;
    default: return 实际存在状态::入口拒绝;
    }
}

实际存在状态 映射场景状态(世界结构状态 状态) noexcept {
    return static_cast<实际存在状态>(static_cast<std::uint8_t>(状态));
}

std::optional<稳定编码> 查找映射(const L1写入结果& 结果, std::uint32_t 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

bool 场景请求有效(const 初始场景读取请求& 请求) noexcept {
    return 请求.合同版本 == L1场景结构合同版本
        && 请求.世界规则版本 == 世界登记规则版本
        && 世界结构节点见证有效(请求.世界根)
        && 请求.世界根.类型 == 节点种类::普通
        && 有效(请求.初始场景) && 有效(请求.场景标记值)
        && 有效(请求.直接父关系);
}

} // namespace 海中鱼巣::L1实际存在场景内部

export namespace 海中鱼巣 {

class L1实际存在场景组合服务 final {
public:
    L1实际存在场景组合服务(L1事实基座服务& L1,
        L1实际存在服务& 存在, L1场景结构服务& 场景) noexcept
        : L1_(L1), 存在_(存在), 场景_(场景) {}

    实际存在结果 在初始场景创建实际存在(const 实际存在创建请求& 请求) {
        std::lock_guard<std::mutex> 锁(锁_);
        try {
            if (请求.合同版本 != L1实际存在合同版本
                || 请求.规则版本 != L1实际存在规则版本
                || !实际存在操作幂等身份有效(请求.幂等身份)
                || 请求.期望事实代次 == 0
                || !L1实际存在场景内部::场景请求有效(请求.目标场景)) return {};
            for (const auto& 记录 : 已提交_) {
                if (记录.请求.幂等身份 != 请求.幂等身份) continue;
                if (记录.请求 != 请求)
                    return {实际存在状态::幂等冲突, std::nullopt};
                const auto 重复写入 = L1_.提交写集(记录.写集);
                if (重复写入.状态 != L1写入状态::精确重复)
                    return {L1实际存在场景内部::映射写入状态(重复写入.状态), std::nullopt};
                auto 读回 = 读取实际存在(记录.读取请求);
                if (读回.状态 != 实际存在状态::已读取 || !读回.事实)
                    return {读回.状态, std::nullopt};
                if (读回.事实->事实截止代次 != 重复写入.事实代次)
                    return {实际存在状态::版本漂移, std::nullopt};
                读回.状态 = 实际存在状态::幂等读回;
                return 读回;
            }
            const auto 存在规格 = 存在_.形成实际存在写入规格(
                {请求.合同版本, 请求.规则版本, 请求.期望事实代次});
            if (存在规格.状态 != 实际存在状态::已读取 || !存在规格.规格)
                return {存在规格.状态, std::nullopt};
            const auto 场景规格 = 场景_.形成初始场景接纳规格(
                {请求.目标场景, 请求.期望事实代次});
            if (场景规格.状态 != 世界结构状态::已读取 || !场景规格.规格)
                return {L1实际存在场景内部::映射场景状态(场景规格.状态), std::nullopt};
            if (存在规格.规格->事实截止代次 != 请求.期望事实代次
                || 场景规格.规格->事实截止代次 != 请求.期望事实代次
                || !实际存在写入规格完整(*存在规格.规格)
                || !初始场景接纳规格完整(*场景规格.规格))
                return {实际存在状态::版本漂移, std::nullopt};
            L1写集请求 写集;
            写集.期望事实代次 = 请求.期望事实代次;
            写集.幂等键 = L1实际存在场景内部::映射幂等键(请求.幂等身份);
            写集.节点 = {{{1}, 节点种类::普通, std::nullopt}};
            写集.值 = {{{2}, 写集本地键{1},
                稳定编码{存在规格.规格->资格属性类型.编码},
                std::int64_t{存在规格.规格->资格值},
                稳定编码{存在规格.规格->服务身份.编码}}};
            写集.关系 = {{{3}, 稳定编码{场景规格.规格->场景.编码},
                写集本地键{1}, 稳定编码{场景规格.规格->直接成员关系类型.编码}, 0}};
            写集.属性槽变更 = {{写集本地键{1},
                稳定编码{存在规格.规格->资格属性类型.编码}, 写集本地键{2}}};
            已提交_.push_back({请求, 写集, {}});
            const auto 写入 = L1_.提交写集(写集);
            const auto 状态 = L1实际存在场景内部::映射写入状态(写入.状态);
            if (状态 != 实际存在状态::已提交 && 状态 != 实际存在状态::幂等读回) {
                已提交_.pop_back();
                return {状态, std::nullopt};
            }
            if (写入.事实代次 == 0 || 写入.新编码映射.size() != 3)
                return {实际存在状态::内部不一致, std::nullopt};
            const auto 存在编码 = L1实际存在场景内部::查找映射(写入, 1);
            const auto 资格编码 = L1实际存在场景内部::查找映射(写入, 2);
            const auto 关系编码 = L1实际存在场景内部::查找映射(写入, 3);
            if (!存在编码 || !资格编码 || !关系编码
                || *存在编码 == *资格编码 || *存在编码 == *关系编码
                || *资格编码 == *关系编码)
                return {实际存在状态::内部不一致, std::nullopt};
            实际存在读取请求 读取请求;
            读取请求.当前场景 = 请求.目标场景;
            读取请求.存在 = *存在编码;
            读取请求.资格值 = *资格编码;
            读取请求.当前场景归属关系 = *关系编码;
            已提交_.back().读取请求 = 读取请求;
            auto 读回 = 读取实际存在(读取请求);
            if (读回.状态 != 实际存在状态::已读取 || !读回.事实)
                return {读回.状态, std::nullopt};
            if (读回.事实->事实截止代次 != 写入.事实代次)
                return {实际存在状态::版本漂移, std::nullopt};
            读回.状态 = 状态;
            return 读回;
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

    实际存在结果 读取实际存在(const 实际存在读取请求& 请求) const {
        try {
            if (请求.合同版本 != L1实际存在合同版本
                || 请求.规则版本 != L1实际存在规则版本
                || !L1实际存在场景内部::场景请求有效(请求.当前场景)
                || !有效(请求.存在) || !有效(请求.资格值)
                || !有效(请求.当前场景归属关系)) return {};
            const auto 资格 = 存在_.读取实际存在资格(
                {请求.合同版本, 请求.规则版本, 请求.存在, 请求.资格值});
            if (资格.状态 != 实际存在状态::已读取 || !资格.事实)
                return {资格.状态, std::nullopt};
            const auto 接纳 = 场景_.读取初始场景接纳(
                {请求.当前场景, 请求.存在, 请求.当前场景归属关系});
            if (接纳.状态 != 世界结构状态::已读取 || !接纳.事实)
                return {L1实际存在场景内部::映射场景状态(接纳.状态), std::nullopt};
            if (资格.事实->事实截止代次 != 接纳.事实->事实截止代次)
                return {实际存在状态::版本漂移, std::nullopt};
            实际存在事实 事实;
            事实.事实截止代次 = 资格.事实->事实截止代次;
            事实.世界根 = 请求.当前场景.世界根;
            事实.存在 = 资格.事实->存在;
            事实.当前场景 = 接纳.事实->场景;
            事实.资格 = 资格.事实->资格;
            事实.当前场景归属关系 = 接纳.事实->归属关系;
            return 实际存在事实完整(事实)
                ? 实际存在结果{实际存在状态::已读取, 事实}
                : 实际存在结果{实际存在状态::内部不一致, std::nullopt};
        } catch (const std::bad_alloc&) { return {实际存在状态::资源失败, std::nullopt}; }
        catch (...) { return {实际存在状态::内部不一致, std::nullopt}; }
    }

private:
    struct 已提交记录 final {
        实际存在创建请求 请求;
        L1写集请求 写集;
        实际存在读取请求 读取请求;
    };
    L1事实基座服务& L1_;
    L1实际存在服务& 存在_;
    L1场景结构服务& 场景_;
    std::mutex 锁_;
    std::vector<已提交记录> 已提交_;
};

} // namespace 海中鱼巣
