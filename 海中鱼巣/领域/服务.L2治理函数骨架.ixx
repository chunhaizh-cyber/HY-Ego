module;

#include <cstdint>
#include <optional>

#define L2治理函数骨架_NO_INCLUDES
export module 海中鱼巣.领域.服务.L2治理函数骨架;
#undef L2治理函数骨架_NO_INCLUDES

export {
#include "L2治理函数骨架.数据.h"
