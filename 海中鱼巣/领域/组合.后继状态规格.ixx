module;

#include <cstdint>
#include <new>
#include <optional>
#include <utility>

export module 海中鱼巣.领域.组合.后继状态规格;

export import 海中鱼巣.领域.服务.特征比较;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

struct 实际存在I64后继状态规格请求 final {
    std::uint32_t 合同版本 = L1状态合同版本;
    std::uint32_t 规则版本 = L1状态规则版本;
    std::uint32_t 规格版本 = I64后继状态规格版本;
    std::uint64_t 业务请求身份 = 0;
    std::uint64_t 整理幂等身份 = 0;
    std::uint64_t 新状态发生时间 = 0;
    实际存在I64实例特征读取请求 后当前;
};

enum class I64后继状态规格状态 : std::uint8_t {
    已形成 = 1, 无前状态 = 2, 入口拒绝 = 3, 未找到 = 4,
    冲突 = 5, 不可比较 = 6, 版本漂移 = 7, 许可拒绝 = 8,
    资源失败 = 9, 内部不一致 = 10
};

struct 后继状态迁移纯值证据 final {
    I64相邻前状态选择证据 前态选择;
    特征比较结果 比较;
    bool 等价 = false;
    I64状态迁移完整输入见证 输入;
};

struct 实际存在I64后继状态规格结果 final {
    I64后继状态规格状态 状态 = I64后继状态规格状态::入口拒绝;
    std::optional<实际存在I64后继状态写入规格> 状态规格;
    std::optional<后继状态迁移纯值证据> 迁移证据;
};

namespace 后继状态规格内部 {

实际存在I64后继状态规格结果 失败(I64后继状态规格状态 状态) noexcept {
    return {状态, std::nullopt, std::nullopt};
}

I64后继状态规格状态 映射L1状态(L1读取状态 状态) noexcept {
    switch (状态) {
    case L1读取状态::未找到:
    case L1读取状态::已退出:
    case L1读取状态::属性未设置: return I64后继状态规格状态::未找到;
    case L1读取状态::事实代次漂移: return I64后继状态规格状态::版本漂移;
    case L1读取状态::资源失败: return I64后继状态规格状态::资源失败;
    case L1读取状态::入口拒绝: return I64后继状态规格状态::入口拒绝;
    default: return I64后继状态规格状态::内部不一致;
    }
}

I64后继状态规格状态 映射实例状态(实例特征状态 状态) noexcept {
    switch (状态) {
    case 实例特征状态::未找到:
    case 实例特征状态::登记未加载: return I64后继状态规格状态::未找到;
    case 实例特征状态::事实代次漂移: return I64后继状态规格状态::版本漂移;
    case 实例特征状态::资源失败: return I64后继状态规格状态::资源失败;
    case 实例特征状态::入口拒绝:
    case 实例特征状态::幂等冲突: return I64后继状态规格状态::入口拒绝;
    default: return I64后继状态规格状态::内部不一致;
    }
}

I64后继状态规格状态 映射P12状态(I64相邻前状态选择状态 状态) noexcept {
    switch (状态) {
    case I64相邻前状态选择状态::无前状态: return I64后继状态规格状态::无前状态;
    case I64相邻前状态选择状态::未找到: return I64后继状态规格状态::未找到;
    case I64相邻前状态选择状态::入口拒绝: return I64后继状态规格状态::入口拒绝;
    case I64相邻前状态选择状态::冲突: return I64后继状态规格状态::冲突;
    case I64相邻前状态选择状态::版本漂移: return I64后继状态规格状态::版本漂移;
    case I64相邻前状态选择状态::许可拒绝: return I64后继状态规格状态::许可拒绝;
    case I64相邻前状态选择状态::资源失败: return I64后继状态规格状态::资源失败;
    default: return I64后继状态规格状态::内部不一致;
    }
}

I64后继状态规格状态 映射比较状态(特征比较状态 状态) noexcept {
    switch (状态) {
    case 特征比较状态::未注册:
    case 特征比较状态::未实现: return I64后继状态规格状态::不可比较;
    case 特征比较状态::入口拒绝: return I64后继状态规格状态::不可比较;
    case 特征比较状态::版本漂移: return I64后继状态规格状态::版本漂移;
    case 特征比较状态::许可拒绝: return I64后继状态规格状态::许可拒绝;
    case 特征比较状态::资源失败: return I64后继状态规格状态::资源失败;
    default: return I64后继状态规格状态::内部不一致;
    }
}

实际存在I64基准状态读取请求 形成前状态读取请求(
    const 实际存在I64基准状态事实& 事实) noexcept {
    return {L1状态合同版本, L1状态规则版本, 事实.状态.编码,
        事实.特征值.编码, 事实.状态资格.编码, 事实.发生时间.编码,
        事实.特征值见证资格.编码, 事实.被采样P8值引用.编码,
        事实.采样I64值.编码, 事实.主体关系.编码, 事实.场景关系.编码,
        事实.特征关系.编码, 事实.值关系.编码, 事实.来源存在关系.编码};
}

bool 比较成功完整(const I64状态迁移比较结果& 结果) noexcept {
    if (结果.比较.状态 != 特征比较状态::已比较 || !结果.比较.排序三态
        || !结果.比较.具名关系 || !结果.比较.差异材料
        || !结果.等价 || !结果.输入 || !结果.比较.左输入回执
        || !结果.比较.右输入回执 || 结果.比较.事实截止代次 == 0
        || !有效(结果.比较.注册身份) || 结果.比较.算法版本 == 0)
        return false;
    const auto 关系 = *结果.比较.具名关系;
    const auto 排序 = *结果.比较.排序三态;
    const auto 差异 = 结果.比较.差异材料->值;
    return (*结果.等价 && 排序 == 0 && 差异 == 0
            && 关系 == 特征比较具名关系::状态迁移等价)
        || (!*结果.等价 && 排序 == -1 && 差异 > 0
            && 关系 == 特征比较具名关系::状态迁移增加)
        || (!*结果.等价 && 排序 == 1 && 差异 < 0
            && 关系 == 特征比较具名关系::状态迁移减少);
}

} // namespace 后继状态规格内部

实际存在I64后继状态规格结果 形成实际存在I64后继状态规格(
    L1事实基座服务& L1,
    L1实例特征服务& 实例特征,
    L1状态服务& 状态,
    特征比较服务& 比较,
    const 实际存在I64后继状态规格请求& 请求) {
    using namespace 后继状态规格内部;
    if (请求.合同版本 != L1状态合同版本 || 请求.规则版本 != L1状态规则版本
        || 请求.规格版本 != I64后继状态规格版本 || 请求.业务请求身份 == 0
        || 请求.整理幂等身份 == 0 || 请求.新状态发生时间 == 0
        || !实际存在I64实例特征读取请求有效(请求.后当前))
        return 失败(I64后继状态规格状态::入口拒绝);
    try {
        for (int 尝试 = 0; 尝试 < 2; ++尝试) {
            const auto G0 = L1.读取完整快照({});
            if (G0.状态 != L1读取状态::成功 || !G0.快照)
                return 失败(映射L1状态(G0.状态));
            const auto G = G0.快照->事实代次;
            if (G == 0) return 失败(I64后继状态规格状态::内部不一致);

            const auto 后当前 = 实例特征.读取实际存在I64实例特征(请求.后当前);
            if (后当前.状态 != 实例特征状态::已读取 || !后当前.事实) {
                const auto 状态 = 映射实例状态(后当前.状态);
                if (状态 == I64后继状态规格状态::版本漂移 && 尝试 == 0) continue;
                return 失败(状态);
            }
            if (!I64实例特征事实完整(*后当前.事实)
                || 后当前.事实->事实截止代次 != G) {
                if (尝试 == 0) continue;
                return 失败(I64后继状态规格状态::版本漂移);
            }

            I64相邻前状态选择请求 P12请求;
            P12请求.合同版本 = L1状态合同版本;
            P12请求.规则版本 = L1状态规则版本;
            P12请求.选择规则版本 = I64相邻前状态选择规则版本;
            P12请求.业务查询身份 = 请求.业务请求身份;
            P12请求.主体 = 后当前.事实->宿主;
            P12请求.实例槽 = 后当前.事实->实例槽;
            P12请求.拟发布后状态发生时间 = 请求.新状态发生时间;
            const auto P12 = 状态.选择实际存在I64相邻前状态(P12请求);
            if (P12.状态 == I64相邻前状态选择状态::无前状态)
                return 失败(I64后继状态规格状态::无前状态);
            if (P12.状态 != I64相邻前状态选择状态::已选择) {
                const auto 状态 = 映射P12状态(P12.状态);
                if (状态 == I64后继状态规格状态::版本漂移 && 尝试 == 0) continue;
                return 失败(状态);
            }
            if (!P12.前状态 || !P12.选择证据
                || P12.前状态->读取事实截止代次 != G
                || P12.选择证据->读取事实截止代次 != G) {
                if (尝试 == 0) continue;
                return 失败(I64后继状态规格状态::版本漂移);
            }

            I64状态迁移比较请求 比较请求;
            比较请求.请求身份 = 请求.业务请求身份;
            比较请求.预期事实截止代次 = G;
            比较请求.前状态 = 形成前状态读取请求(*P12.前状态);
            比较请求.后当前 = 请求.后当前;
            const auto 比较结果 = 比较.比较I64状态迁移(比较请求);
            if (比较结果.比较.状态 != 特征比较状态::已比较) {
                const auto 状态 = 映射比较状态(比较结果.比较.状态);
                if (状态 == I64后继状态规格状态::版本漂移 && 尝试 == 0) continue;
                return 失败(状态);
            }
            if (!比较成功完整(比较结果))
                return 失败(I64后继状态规格状态::内部不一致);

            const auto G1 = L1.读取完整快照({});
            if (G1.状态 != L1读取状态::成功 || !G1.快照)
                return 失败(映射L1状态(G1.状态));
            if (G1.快照->事实代次 != G) {
                if (尝试 == 0) continue;
                return 失败(I64后继状态规格状态::版本漂移);
            }

            const auto& 输入 = *比较结果.输入;
            const auto& 右 = 输入.后当前;
            if (输入.前状态.读取事实截止代次 != P12.前状态->读取事实截止代次
                || 输入.前状态.状态.编码 != P12.前状态->状态.编码
                || 输入.前状态.主体.编码 != P12.前状态->主体.编码
                || 输入.前状态.场景.编码 != P12.前状态->场景.编码
                || 输入.前状态.特征.编码 != P12.前状态->特征.编码
                || 输入.前状态.被采样P8值.编码 != P12.前状态->被采样P8值.编码
                || 输入.前状态.采样I64值.材料 != P12.前状态->采样I64值.材料
                || 右.事实截止代次 != G
                || 右.主体 != 后当前.事实->宿主
                || 右.当前场景 != 请求.后当前.宿主.当前场景.初始场景
                || 右.当前场景归属关系 != 请求.后当前.宿主.当前场景归属关系
                || 右.实例槽 != 后当前.事实->实例槽
                || 右.特征定义 != 后当前.事实->特征定义
                || 右.定义关系 != 后当前.定义关系
                || 右.当前值.编码 != 后当前.事实->当前值
                || 右.当前值.来源节点 != 后当前.事实->来源节点
                || 右.当前值.材料 != 后当前.事实->I64值)
                return 失败(I64后继状态规格状态::内部不一致);

            已校准实际存在I64后继状态材料 材料;
            材料.业务请求身份 = 请求.业务请求身份;
            材料.整理幂等身份 = 请求.整理幂等身份;
            材料.事实截止代次 = G;
            材料.新状态发生时间 = 请求.新状态发生时间;
            材料.前状态 = *P12.前状态;
            材料.前态选择 = *P12.选择证据;
            材料.主体 = 右.主体;
            材料.当前场景 = 右.当前场景;
            材料.当前场景归属关系 = 右.当前场景归属关系;
            材料.实例槽 = 右.实例槽;
            材料.特征定义 = 右.特征定义;
            材料.定义关系 = 右.定义关系;
            材料.新当前值 = 右.当前值.编码;
            材料.新当前值属性类型 = 右.当前值.属性类型;
            材料.新当前来源 = 右.当前值.来源节点;
            材料.新当前值创建代次 = 右.当前值.创建事实代次;
            材料.新当前I64 = 右.当前值.材料;
            材料.比较注册身份 = 比较结果.比较.注册身份;
            材料.比较算法版本 = 比较结果.比较.算法版本;
            材料.排序三态 = *比较结果.比较.排序三态;
            材料.迁移具名关系数值 = static_cast<std::uint8_t>(*比较结果.比较.具名关系);
            材料.等价 = *比较结果.等价;
            材料.差异 = 比较结果.比较.差异材料->值;
            const auto 形成 = 状态.形成已校准实际存在I64后继状态规格(材料);
            if (形成.状态 != I64后继状态规格形成状态::已形成 || !形成.规格) {
                switch (形成.状态) {
                case I64后继状态规格形成状态::入口拒绝:
                    return 失败(I64后继状态规格状态::入口拒绝);
                case I64后继状态规格形成状态::冲突:
                    return 失败(I64后继状态规格状态::冲突);
                case I64后继状态规格形成状态::资源失败:
                    return 失败(I64后继状态规格状态::资源失败);
                default:
                    return 失败(I64后继状态规格状态::内部不一致);
                }
            }
            后继状态迁移纯值证据 证据{*P12.选择证据,
                比较结果.比较, *比较结果.等价, 输入};
            return {I64后继状态规格状态::已形成,
                std::move(形成.规格), std::move(证据)};
        }
        return 失败(I64后继状态规格状态::版本漂移);
    } catch (const std::bad_alloc&) {
        return 失败(I64后继状态规格状态::资源失败);
    } catch (...) {
        return 失败(I64后继状态规格状态::内部不一致);
    }
}

} // namespace 海中鱼巣
