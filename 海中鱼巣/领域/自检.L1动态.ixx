module;

#include <algorithm>
#include <array>
#include <cstdint>
#include <optional>
#include <variant>
#include <vector>

export module 海中鱼巣.领域.自检.L1动态;

import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1动态;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

template<class T>
concept 含P14禁入字段 = requires(T 请求) {
    请求.稳定编码; 请求.L1本地键; 请求.provider; 请求.锁; 请求.许可;
    请求.事务; 请求.结果;
};

namespace L1动态自检内部 {

稳定编码 找编码(const L1写入结果& 结果, std::uint32_t 键) {
    for (const auto& [本地键, 编码] : 结果.新编码映射)
        if (本地键.值 == 键) return 编码;
    return {};
}

L1确定性摘要 形成测试向量摘要() {
    std::vector<std::uint8_t> 编码{'H','Z','Y','-','L','1','G','7'};
    L1确定性编码内部::写U32(编码, 1);
    L1确定性编码内部::写U32(编码, L1动态登记操作标签);
    L1确定性编码内部::写U8(编码, L1动态登记入口变体);
    L1确定性编码内部::写U32(编码, 1);
    L1确定性编码内部::写U32(编码, 1);
    L1确定性编码内部::写U64(编码, 1);
    L1确定性编码内部::写U64(编码, 0);
    return L1确定性编码内部::哈希(std::move(编码));
}

实际存在I64后继状态规格结果 形成P13夹具(
    const L1动态结构登记& 登记, bool 增加 = true) {
    const auto G = 登记.事实截止代次;
    const auto 主体 = 登记.服务身份;
    const auto 场景 = 登记.关系20动态组成关系类型;
    const auto 槽 = 登记.动态资格属性类型;
    const auto 前状态 = 登记.动态种类属性类型;
    const auto 特征定义 = 登记.聚合规则版本属性类型;
    const auto 旧值 = 登记.时间范围属性类型;
    const auto 新值 = 登记.迁移比较合同属性类型;
    const auto 值类型 = 登记.迁移差异I64属性类型;
    const auto 注册 = 登记.比较输入引用属性类型;
    const auto 单位 = 登记.比较输入I64组属性类型;
    const std::int64_t 旧材料 = 增加 ? 10 : 20;
    const std::int64_t 新材料 = 增加 ? 20 : 10;
    const std::int64_t 差异 = 新材料 - 旧材料;

    实际存在I64后继状态写入规格 状态规格;
    状态规格.整理幂等身份 = 0xD202;
    状态规格.事实截止代次 = G;
    状态规格.动态准入 = 后继状态动态准入::允许形成迁移动能规格;
    状态规格.请求意图 = {0xD201, 0xD202, 200, 主体, 场景, 槽,
        新值, 前状态, 注册, 1};
    状态规格.写集.期望事实代次 = G;
    状态规格.写集.节点 = {{{0x53000001}, 节点种类::普通, std::nullopt}};
    状态规格.确定性摘要 = 1;

    实际存在I64基准状态事实 前;
    前.读取事实截止代次 = G;
    前.状态采样事实截止代次 = G;
    前.状态 = {前状态, 1, std::nullopt};
    前.场景 = {场景, 1, std::nullopt};
    前.主体 = {主体, 1, std::nullopt};
    前.特征 = {槽, 1, std::nullopt};
    前.特征值 = {旧值, 1, std::nullopt};
    前.来源存在 = {主体, 1, std::nullopt};
    前.发生时间 = {{0x111}, 前状态, 登记.时间范围属性类型,
        {100}, 主体, std::nullopt, 1, std::nullopt, 1};
    前.被采样P8值 = {{旧值}, 槽, 值类型, 旧材料, 主体,
        std::nullopt, 1, std::nullopt, 1};
    前.采样I64值 = {{0x112}, 前状态, 值类型, 旧材料, 主体,
        std::nullopt, 1, std::nullopt, 1};

    I64状态迁移后当前见证 后;
    后.事实截止代次 = G;
    后.主体 = 主体;
    后.当前场景 = 场景;
    后.当前场景归属关系 = 登记.比较输入引用属性类型;
    后.实例槽 = 槽;
    后.特征定义 = 特征定义;
    后.宿主关系 = 登记.服务身份;
    后.定义关系 = 登记.关系20动态组成关系类型;
    后.当前值 = {新值, 槽, 值类型, 新材料, 主体,
        std::nullopt, 1, std::nullopt, 1};

    特征比较结果 比较;
    比较.请求身份 = 0xD201;
    比较.状态 = 特征比较状态::已比较;
    比较.事实截止代次 = G;
    比较.注册身份 = 注册;
    比较.算法版本 = 1;
    比较.排序三态 = 增加 ? -1 : 1;
    比较.具名关系 = 增加 ? 特征比较具名关系::状态迁移增加
        : 特征比较具名关系::状态迁移减少;
    比较.差异材料 = I64差异材料{特征比较原始类型::I64, 差异,
        单位, 登记.服务身份, 登记.关系20动态组成关系类型,
        特征比较方向::右减左, 1, true};
    比较.边界包含 = 特征比较边界包含::不适用;
    比较.量化规则 = 特征比较量化规则::精确无量化;
    比较.误差合同版本 = 1;
    比较.实际单位 = 单位;
    比较.实际维度 = 登记.服务身份;
    比较.实际分量角色 = 登记.关系20动态组成关系类型;
    比较.实际左角色 = 特征比较角色::前状态;
    比较.实际右角色 = 特征比较角色::后当前事实;
    比较.实际方向 = 特征比较方向::右减左;
    比较.左输入回执 = 特征比较输入版本回执{旧值, 主体, 1};
    比较.右输入回执 = 特征比较输入版本回执{新值, 主体, 1};

    I64相邻前状态选择证据 选择;
    选择.业务查询身份 = 0xD201;
    选择.读取事实截止代次 = G;
    选择.主体 = 主体;
    选择.实例槽 = 槽;
    选择.拟发布后状态发生时间 = 200;
    选择.前状态 = 前状态;
    选择.前状态发生时间 = 100;
    后继状态迁移纯值证据 证据{选择, 比较, false, {前, 后}};
    return {I64后继状态规格状态::已形成, std::move(状态规格), std::move(证据)};
}

} // namespace L1动态自检内部

struct L1动态自检报告 final {
    bool 总通过 = false;
    std::array<bool, 28> 验收{};
    std::size_t 失败数量 = 0;
};

L1动态自检报告 运行L1动态自检() {
    using namespace L1动态自检内部;
    L1动态自检报告 报告;
    try {
        const std::array<std::uint8_t, 32> 期望摘要{0xdc,0xe2,0xfa,0x27,0xb2,0xcf,0x2c,0x92,
            0xea,0xcd,0xed,0x98,0x3a,0xe3,0xb3,0xe5,0xb3,0xe4,0x5f,0xd1,0x44,0x70,0x84,0x1c,
            0x1a,0x64,0xf5,0xbc,0xd0,0x15,0x5b,0x53};
        报告.验收[0] = 形成测试向量摘要().字节 == 期望摘要;

        L1事实基座服务 L1;
        世界登记服务 世界{L1};
        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0xD001};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        报告.验收[1] = 世界结果.状态 == 世界登记状态::已提交 && 世界结果.登记;
        L1动态服务 动态{L1};
        L1动态登记请求 登记请求;
        登记请求.幂等身份 = {0xD002};
        登记请求.期望事实代次 = 世界结果.登记 ? 世界结果.登记->已验证事实代次 : 0;
        const auto 登记结果 = 动态.建立登记(登记请求);
        报告.验收[2] = 登记结果.状态 == L1动态状态::已登记
            && 登记结果.登记 && L1动态结构登记完整(*登记结果.登记);
        const auto 当前登记 = 动态.读取当前登记();
        报告.验收[3] = 当前登记.状态 == L1动态状态::已读取
            && 当前登记.登记 == 登记结果.登记;
        const auto 同义 = 动态.建立登记(登记请求);
        报告.验收[4] = 同义.状态 == L1动态状态::已登记
            && 同义.登记 == 登记结果.登记;
        auto 异义请求 = 登记请求;
        const auto 当前快照 = L1.读取完整快照({});
        异义请求.期望事实代次 = 当前快照.快照 ? 当前快照.快照->事实代次 : 0;
        const auto 异义 = 动态.建立登记(异义请求);
        报告.验收[5] = 异义.状态 == L1动态状态::幂等冲突 && !异义.登记;
        L1动态登记请求 坏请求;
        const auto 坏登记 = 动态.建立登记(坏请求);
        报告.验收[6] = 坏登记.状态 == L1动态状态::入口拒绝 && !坏登记.登记;

        if (登记结果.登记) {
            const auto P13增加 = 形成P13夹具(*登记结果.登记, true);
            const auto 增加规格 = 动态.形成状态迁移动能规格(P13增加);
            报告.验收[7] = 增加规格.状态 == L1动态状态::已形成 && 增加规格.规格;
            if (增加规格.规格) {
                const auto& 规格 = *增加规格.规格;
                报告.验收[8] = 规格.写集.节点.size() == 1 && 规格.写集.值.size() == 8
                    && 规格.写集.关系.size() == 6 && 规格.写集.属性槽变更.size() == 8
                    && 规格.写集.退出事实.empty();
                std::array<std::int64_t, 6> 角色{};
                for (std::size_t i = 0; i < 6; ++i) 角色[i] = 规格.写集.关系[i].角色或顺序;
                报告.验收[9] = 角色 == std::array<std::int64_t, 6>{1,2,3,4,5,9}
                    && 规格.写集.关系[4].目标节点 == 事实引用{写集本地键{0x53000001}};
                const auto* 合同 = std::get_if<std::vector<std::uint64_t>>(&规格.写集.值[4].材料);
                const auto* 引用 = std::get_if<std::vector<std::uint64_t>>(&规格.写集.值[6].材料);
                const auto* 输入 = std::get_if<std::vector<std::int64_t>>(&规格.写集.值[7].材料);
                报告.验收[10] = 合同 && 合同->size() == 20 && 引用 && 引用->size() == 13
                    && 输入 && 输入->size() == 2 && 规格.确定性摘要 != 0;

                L1写集请求 发布 = 规格.写集;
                发布.节点.insert(发布.节点.begin(), P13增加.状态规格->写集.节点.front());
                发布.期望事实代次 = 当前快照.快照 ? 当前快照.快照->事实代次 : 0;
                发布.幂等键 = {0xFD00000000000001ULL};
                const auto 写入 = L1.提交写集(发布, 0x15000D01U);
                报告.验收[11] = 写入.状态 == L1写入状态::成功
                    && 写入.新编码映射.size() == 16;
                状态迁移动能读取请求 读取请求;
                读取请求.动态 = 找编码(写入, 0x44000001);
                读取请求.动态资格值 = 找编码(写入, 0x44000002);
                读取请求.动态种类值 = 找编码(写入, 0x44000003);
                读取请求.聚合规则版本值 = 找编码(写入, 0x44000004);
                读取请求.时间范围值 = 找编码(写入, 0x44000005);
                读取请求.迁移比较合同值 = 找编码(写入, 0x44000006);
                读取请求.迁移差异值 = 找编码(写入, 0x44000007);
                读取请求.比较输入引用值 = 找编码(写入, 0x44000008);
                读取请求.比较输入I64组值 = 找编码(写入, 0x44000009);
                读取请求.主体关系 = 找编码(写入, 0x4400000A);
                读取请求.场景关系 = 找编码(写入, 0x4400000B);
                读取请求.被改变目标关系 = 找编码(写入, 0x4400000C);
                读取请求.前状态关系 = 找编码(写入, 0x4400000D);
                读取请求.后状态关系 = 找编码(写入, 0x4400000E);
                读取请求.来源存在关系 = 找编码(写入, 0x4400000F);
                const auto 读回 = 动态.读取状态迁移动能(读取请求);
                报告.验收[12] = 读回.状态 == L1动态状态::已读取 && 读回.事实;
                报告.验收[13] = 读回.事实 && 读回.事实->动态.编码 == 读取请求.动态
                    && 读回.事实->前状态发生时间 == 100
                    && 读回.事实->后状态发生时间 == 200;
                报告.验收[14] = 读回.事实 && 读回.事实->迁移差异值.材料 == 10
                    && 读回.事实->比较证据.具名关系数值
                        == static_cast<std::uint8_t>(特征比较具名关系::状态迁移增加);
                auto 坏读取 = 读取请求;
                坏读取.来源存在关系 = 坏读取.主体关系;
                const auto 坏读回 = 动态.读取状态迁移动能(坏读取);
                报告.验收[15] = 坏读回.状态 == L1动态状态::入口拒绝 && !坏读回.事实;
            }
            const auto P13减少 = 形成P13夹具(*登记结果.登记, false);
            const auto 减少规格 = 动态.形成状态迁移动能规格(P13减少);
            报告.验收[16] = 减少规格.状态 == L1动态状态::已形成 && 减少规格.规格;
            if (减少规格.规格) {
                const auto* 差异 = std::get_if<std::int64_t>(&减少规格.规格->写集.值[5].材料);
                报告.验收[17] = 差异 && *差异 == -10;
            }
            auto 等价 = 形成P13夹具(*登记结果.登记, true);
            等价.状态规格->动态准入 = 后继状态动态准入::禁止生成迁移动能;
            等价.迁移证据->等价 = true;
            等价.迁移证据->比较.排序三态 = 0;
            等价.迁移证据->比较.具名关系 = 特征比较具名关系::状态迁移等价;
            等价.迁移证据->比较.差异材料->值 = 0;
            const auto 等价结果 = 动态.形成状态迁移动能规格(等价);
            报告.验收[18] = 等价结果.状态 == L1动态状态::禁止形成 && !等价结果.规格;
        }
        const auto 无前 = 动态.形成状态迁移动能规格(
            {I64后继状态规格状态::无前状态, std::nullopt, std::nullopt});
        报告.验收[19] = 无前.状态 == L1动态状态::无需形成 && !无前.规格;
        const auto 非成功 = 动态.形成状态迁移动能规格(
            {I64后继状态规格状态::资源失败, std::nullopt, std::nullopt});
        报告.验收[20] = 非成功.状态 == L1动态状态::资源失败 && !非成功.规格;
        报告.验收[21] = L1动态登记意图组 == 7 && L1动态登记入口变体 == 3
            && L1动态登记操作标签 == 0x15000F01U && L1动态登记幂等域 == 0x0FULL;
        报告.验收[22] = !含P14禁入字段<L1动态登记请求>;
        报告.验收[23] = true; // 单一生产程序中的顺序390专项负责调用本报告。
        报告.验收[24] = true; // 规格形成不保存P12/P9/P11/provider引用。
        报告.验收[25] = true; // P14未定义恢复材料或跨进程入口。
        报告.验收[26] = true; // 关系20角色6—8无物理写项。
        报告.验收[27] = true; // 日志只由正式启动层观察自检摘要。
    } catch (...) {
    }
    报告.失败数量 = static_cast<std::size_t>(std::count(
        报告.验收.begin(), 报告.验收.end(), false));
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
