export module 海中鱼巣.领域.自检.L1动态;

import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1动态;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

template<class T>
concept 含P14禁入字段 = requires(T 请求) {
    请求.稳定编码; 请求.L1本地键; 请求.provider; 请求.锁; 请求.许可;
    请求.事务; 请求.结果;
};

namespace L1动态自检内部 {

// P14-诊断责任：无适用错误分支；最终责任边界：自检调用边。
稳定编码 找编码(const L1写入结果& 结果, std::uint32_t 键) {
    for (const auto& [本地键, 编码] : 结果.新编码映射)
        if (本地键.值 == 键) return 编码;
    return {};
}

// P14-诊断责任：向上送出；最终责任边界：自检报告。
L1确定性摘要 形成测试向量摘要() {
    std::vector<std::uint8_t> 编码{'H','Z','Y','-','L','1','G','7'};
    L1确定性编码内部::写U32(编码, 1);
    L1确定性编码内部::写U32(编码, L1动态登记操作标签);
    L1确定性编码内部::写U8(编码, L1动态登记入口变体);
    L1确定性编码内部::写U32(编码, 1);
    L1确定性编码内部::写U32(编码, 1);
    L1确定性编码内部::写U64(编码, 1);
    L1确定性编码内部::写U64(编码, 0);
    return L1确定性编码内部::哈希(std::move(编码));
}

// P14-诊断责任：向上送出；最终责任边界：自检报告。
实际存在I64后继状态规格结果 形成P13夹具(
    const L1动态结构登记& 登记, const L1完整快照& 快照,
    bool 增加 = true, bool 加入历史 = false) {
    const auto G = 登记.事实截止代次;
    const auto 主体 = 登记.服务身份;
    const auto 场景 = 登记.关系20动态组成关系类型;
    const auto 槽 = 登记.动态资格属性类型;
    const auto 前状态 = 登记.动态种类属性类型;
    const auto 特征定义 = 登记.聚合规则版本属性类型;
    const auto 旧值 = 登记.时间范围属性类型;
    const auto 新值 = 登记.迁移比较合同属性类型;
    const auto 值类型 = 登记.迁移差异I64属性类型;
    const auto 注册 = 登记.比较输入引用属性类型;
    const auto 单位 = 登记.比较输入I64组属性类型;
    const std::int64_t 旧材料 = 增加 ? 10 : 20;
    const std::int64_t 新材料 = 增加 ? 20 : 10;
    const std::int64_t 差异 = 新材料 - 旧材料;

    实际存在I64后继状态写入规格 状态规格;
    状态规格.整理幂等身份 = 0xD202;
    状态规格.事实截止代次 = G;
    状态规格.动态准入 = 后继状态动态准入::允许形成迁移动能规格;
    状态规格.请求意图 = {0xD201, 0xD202, 200, 主体, 场景, 槽,
        新值, 前状态, 注册, 1};
    状态规格.写集.期望事实代次 = G;
    状态规格.写集.节点 = {{{0x53000001}, 节点种类::普通, std::nullopt}};
    状态规格.确定性摘要 = 1;

    实际存在I64基准状态事实 前;
    前.读取事实截止代次 = G;
    前.状态采样事实截止代次 = G;
    前.状态 = {前状态, 1, std::nullopt};
    前.场景 = {场景, 1, std::nullopt};
    前.主体 = {主体, 1, std::nullopt};
    前.特征 = {槽, 1, std::nullopt};
    前.特征值 = {旧值, 1, std::nullopt};
    前.来源存在 = {主体, 1, std::nullopt};
    前.发生时间 = {{0x111}, 前状态, 登记.时间范围属性类型,
        {100}, 主体, std::nullopt, 1, std::nullopt, 1};
    前.被采样P8值 = {{旧值}, 槽, 值类型, 旧材料, 主体,
        std::nullopt, 1, std::nullopt, 1};
    前.采样I64值 = {{0x112}, 前状态, 值类型, 旧材料, 主体,
        std::nullopt, 1, std::nullopt, 1};

    I64状态迁移后当前见证 后;
    后.事实截止代次 = G;
    后.主体 = 主体;
    后.当前场景 = 场景;
    后.当前场景归属关系 = 登记.比较输入引用属性类型;
    后.实例槽 = 槽;
    后.特征定义 = 特征定义;
    后.宿主关系 = 登记.服务身份;
    后.定义关系 = 登记.关系20动态组成关系类型;
    后.当前值 = {新值, 槽, 值类型, 新材料, 主体,
        std::nullopt, 1, std::nullopt, 1};

    特征比较结果 比较;
    比较.请求身份 = 0xD201;
    比较.状态 = 特征比较状态::已比较;
    比较.事实截止代次 = G;
    比较.注册身份 = 注册;
    比较.算法版本 = 1;
    比较.排序三态 = 增加 ? -1 : 1;
    比较.具名关系 = 增加 ? 特征比较具名关系::状态迁移增加
        : 特征比较具名关系::状态迁移减少;
    比较.差异材料 = I64差异材料{特征比较原始类型::I64, 差异,
        单位, 登记.服务身份, 登记.关系20动态组成关系类型,
        特征比较方向::右减左, 1, true};
    比较.边界包含 = 特征比较边界包含::不适用;
    比较.量化规则 = 特征比较量化规则::精确无量化;
    比较.误差合同版本 = 1;
    比较.实际单位 = 单位;
    比较.实际维度 = 登记.服务身份;
    比较.实际分量角色 = 登记.关系20动态组成关系类型;
    比较.实际左角色 = 特征比较角色::前状态;
    比较.实际右角色 = 特征比较角色::后当前事实;
    比较.实际方向 = 特征比较方向::右减左;
    比较.左输入回执 = 特征比较输入版本回执{旧值, 主体, 1};
    比较.右输入回执 = 特征比较输入版本回执{新值, 主体, 1};

    I64相邻前状态选择证据 选择;
    选择.业务查询身份 = 0xD201;
    选择.读取事实截止代次 = G;
    选择.主体 = 主体;
    选择.实例槽 = 槽;
    选择.拟发布后状态发生时间 = 200;
    选择.前状态 = 前状态;
    选择.前状态发生时间 = 100;
    后继状态迁移纯值证据 证据{选择, 比较, false, {前, 后}};
    后继状态规格提供者证据凭证 提供者证据;
    提供者证据.共同事实截止代次 = G;
    提供者证据.状态登记 = {L1状态合同版本, L1状态规则版本, G,
        主体, 场景, 槽, 前状态, 特征定义, 旧值, 新值};
    提供者证据.后当前 = 后;
    提供者证据.前状态 = 前;
    提供者证据.前态选择 = 选择;
    提供者证据.比较 = 比较;
    std::vector<std::pair<后继状态规格写前事实身份, L1事实副本>> 事实组;
    for (const auto& 节点 : 快照.当前节点) {
        事实组.push_back({{后继状态规格写前事实种类::节点, 节点.编码, G,
            后继状态规格写前事实副本来源::最终G1当前事实}, L1事实副本{节点}});
    }
    for (const auto& 关系 : 快照.当前关系) {
        事实组.push_back({{后继状态规格写前事实种类::关系, 关系.编码, G,
            后继状态规格写前事实副本来源::最终G1当前事实}, L1事实副本{关系}});
    }
    for (const auto& 值 : 快照.当前值) {
        事实组.push_back({{后继状态规格写前事实种类::值, 值.编码, G,
            后继状态规格写前事实副本来源::最终G1当前事实}, L1事实副本{值}});
    }
    关系事实 传递关系;
    传递关系.编码 = {0x7D000002};
    传递关系.源节点 = 主体;
    传递关系.目标节点 = 场景;
    传递关系.关系类型节点 = 登记.关系20动态组成关系类型;
    传递关系.角色或顺序 = 1;
    传递关系.创建事实代次 = 1;
    事实组.push_back({{后继状态规格写前事实种类::关系, 传递关系.编码, G,
        后继状态规格写前事实副本来源::最终G1当前事实}, L1事实副本{传递关系}});
    值事实 传递值;
    传递值.编码 = {0x7D000003};
    传递值.所属节点 = 主体;
    传递值.属性类型节点 = 登记.动态资格属性类型;
    传递值.材料 = std::int64_t{1};
    传递值.来源节点 = 主体;
    传递值.创建事实代次 = 1;
    事实组.push_back({{后继状态规格写前事实种类::值, 传递值.编码, G,
        后继状态规格写前事实副本来源::最终G1当前事实}, L1事实副本{传递值}});
    if (加入历史) {
        节点事实 历史;
        历史.编码 = {0x7D000001};
        历史.创建事实代次 = 1;
        历史.退出事实代次 = G;
        事实组.push_back({{后继状态规格写前事实种类::节点, 历史.编码, G,
            后继状态规格写前事实副本来源::P12前状态历史事实}, L1事实副本{历史}});
    }
    std::sort(事实组.begin(), 事实组.end(), [](const auto& 左, const auto& 右) {
        const auto 左种类 = static_cast<std::uint8_t>(左.first.种类);
        const auto 右种类 = static_cast<std::uint8_t>(右.first.种类);
        return 左种类 != 右种类 ? 左种类 < 右种类 : 左.first.身份 < 右.first.身份;
    });
    for (auto& [身份, 副本] : 事实组) {
        提供者证据.写前事实身份组.push_back(身份);
        提供者证据.写前事实副本组.push_back(std::move(副本));
    }
    提供者证据.去重后写前事实见证数量 =
        static_cast<std::uint32_t>(提供者证据.写前事实身份组.size());
    return {I64后继状态规格状态::已形成, std::move(状态规格),
        std::move(证据), std::move(提供者证据)};
}

// PRE2-诊断责任：无适用错误分支；专项强类型凭证机械互证。
bool PRE2证据组有效(const 状态迁移动能规格提供者证据凭证& 证据) noexcept {
    if (证据.合同版本 != 状态迁移动能规格提供者证据合同版本
        || 证据.规则版本 != 状态迁移动能规格提供者证据规则版本
        || 证据.直接提供者.稳定身份 != 稳定编码{0x4C31445000000001ULL}
        || 证据.直接调用次数 != 1 || 证据.去重后提供者见证数量 != 1
        || 证据.共同事实截止代次 == 0 || !L1动态结构登记完整(证据.动态登记)
        || 证据.写前事实身份组.empty()
        || 证据.写前事实身份组.size() != 证据.写前事实副本组.size()
        || 证据.去重后写前事实见证数量 != 证据.写前事实身份组.size()) return false;
    for (std::size_t i = 0; i < 证据.写前事实身份组.size(); ++i) {
        const auto& 身份 = 证据.写前事实身份组[i];
        const auto& 副本 = 证据.写前事实副本组[i];
        const auto 副本身份 = std::visit([](const auto& 事实) { return 事实.编码; }, 副本);
        const auto 副本种类 = std::visit([](const auto& 事实) {
            using T = std::decay_t<decltype(事实)>;
            if constexpr (std::is_same_v<T, 节点事实>) return std::uint8_t{1};
            if constexpr (std::is_same_v<T, 关系事实>) return std::uint8_t{2};
            return std::uint8_t{3};
        }, 副本);
        if (身份.身份 != 副本身份 || static_cast<std::uint8_t>(身份.种类) != 副本种类
            || 身份.观察事实代次 != 证据.共同事实截止代次) return false;
        if (i != 0) {
            const auto& 前 = 证据.写前事实身份组[i - 1];
            const auto 前种类 = static_cast<std::uint8_t>(前.种类);
            const auto 当前种类 = static_cast<std::uint8_t>(身份.种类);
            if (前种类 > 当前种类 || (前种类 == 当前种类 && !(前.身份 < 身份.身份)))
                return false;
        }
    }
    return true;
}

} // namespace L1动态自检内部

struct L1动态自检报告 final {
    bool 总通过 = false;
    std::array<bool, 48> 验收{};
    std::size_t 失败数量 = 0;
    bool 未分类异常 = false;
};

// P14-诊断责任：向上送出；最终责任边界：运行L1动态专项自检。
L1动态自检报告 运行L1动态自检() {
    using namespace L1动态自检内部;
    L1动态自检报告 报告;
    try {
        const std::array<std::uint8_t, 32> 期望摘要{0xdc,0xe2,0xfa,0x27,0xb2,0xcf,0x2c,0x92,
            0xea,0xcd,0xed,0x98,0x3a,0xe3,0xb3,0xe5,0xb3,0xe4,0x5f,0xd1,0x44,0x70,0x84,0x1c,
            0x1a,0x64,0xf5,0xbc,0xd0,0x15,0x5b,0x53};
        报告.验收[0] = 形成测试向量摘要().字节 == 期望摘要;

        L1事实基座服务 L1;
        世界登记服务 世界{L1};
        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0xD001};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        报告.验收[1] = 世界结果.状态 == 世界登记状态::已提交 && 世界结果.登记;
        L1动态服务 动态{L1};
        L1动态登记请求 登记请求;
        登记请求.幂等身份 = {0xD002};
        登记请求.期望事实代次 = 世界结果.登记 ? 世界结果.登记->已验证事实代次 : 0;
        const auto 登记结果 = 动态.建立登记(登记请求);
        报告.验收[2] = 登记结果.状态 == L1动态状态::已登记
            && 登记结果.登记 && L1动态结构登记完整(*登记结果.登记);
        const auto 当前登记 = 动态.读取当前登记();
        报告.验收[3] = 当前登记.状态 == L1动态状态::已读取
            && 当前登记.登记 == 登记结果.登记;
        const auto 同义 = 动态.建立登记(登记请求);
        报告.验收[4] = 同义.状态 == L1动态状态::已登记
            && 同义.登记 == 登记结果.登记;
        auto 异义请求 = 登记请求;
        const auto 当前快照 = L1.读取完整快照({});
        异义请求.期望事实代次 = 当前快照.快照 ? 当前快照.快照->事实代次 : 0;
        const auto 异义 = 动态.建立登记(异义请求);
        报告.验收[5] = 异义.状态 == L1动态状态::幂等冲突 && !异义.登记;
        L1动态登记请求 坏请求;
        const auto 坏登记 = 动态.建立登记(坏请求);
        报告.验收[6] = 坏登记.状态 == L1动态状态::入口拒绝 && !坏登记.登记;

        if (登记结果.登记) {
            const auto P13增加 = 形成P13夹具(
                *登记结果.登记, *当前快照.快照, true);
            const auto 增加规格 = 动态.形成状态迁移动能规格(P13增加);
            报告.验收[7] = 增加规格.状态 == L1动态状态::已形成
                && 增加规格.规格 && 增加规格.提供者证据;
            const auto 提供者身份 = 动态.读取状态迁移动能规格提供者身份();
            报告.验收[28] = 提供者身份.稳定身份 == 稳定编码{0x4C31445000000001ULL}
                && 提供者身份.合同版本 == 1 && 提供者身份.规则版本 == 1;
            if (增加规格.提供者证据) {
                const auto& 凭证 = *增加规格.提供者证据;
                报告.验收[29] = PRE2证据组有效(凭证);
                报告.验收[30] = 凭证.共同事实截止代次 == 当前快照.快照->事实代次
                    && 凭证.动态登记 == *登记结果.登记;
                报告.验收[31] = 凭证.直接提供者 == 提供者身份
                    && 凭证.直接调用次数 == 1 && 凭证.去重后提供者见证数量 == 1;
                报告.验收[32] = std::any_of(凭证.写前事实身份组.begin(),
                    凭证.写前事实身份组.end(), [](const auto& 项) {
                        return 项.副本来源 ==
                            状态迁移动能规格写前事实副本来源::动态登记当前事实;
                    });
                报告.验收[33] = std::any_of(凭证.写前事实身份组.begin(),
                    凭证.写前事实身份组.end(), [](const auto& 项) {
                        return 项.副本来源 ==
                            状态迁移动能规格写前事实副本来源::P13传递当前事实;
                    });
                const auto 有种类 = [&](状态迁移动能规格写前事实种类 种类) {
                    return std::any_of(凭证.写前事实身份组.begin(),
                        凭证.写前事实身份组.end(), [&](const auto& 项) { return 项.种类 == 种类; });
                };
                报告.验收[34] = 有种类(状态迁移动能规格写前事实种类::节点)
                    && 有种类(状态迁移动能规格写前事实种类::关系)
                    && 有种类(状态迁移动能规格写前事实种类::值);
                const auto 当前事实数量 = 当前快照.快照->当前节点.size()
                    + 当前快照.快照->当前关系.size() + 当前快照.快照->当前值.size();
                报告.验收[35] = 凭证.去重后写前事实见证数量 == 当前事实数量 + 2;
                报告.验收[36] = 凭证.写前事实身份组.size()
                    < P13增加.提供者证据->写前事实身份组.size() + 10;
            }
            const auto P13历史 = 形成P13夹具(
                *登记结果.登记, *当前快照.快照, true, true);
            const auto 历史规格 = 动态.形成状态迁移动能规格(P13历史);
            报告.验收[37] = 历史规格.状态 == L1动态状态::已形成
                && 历史规格.规格 && 历史规格.提供者证据;
            报告.验收[38] = 历史规格.提供者证据
                && std::any_of(历史规格.提供者证据->写前事实身份组.begin(),
                    历史规格.提供者证据->写前事实身份组.end(), [](const auto& 项) {
                        return 项.副本来源 ==
                            状态迁移动能规格写前事实副本来源::P13传递历史事实;
                    });
            const auto 拒绝坏凭证 = [&](实际存在I64后继状态规格结果 坏) {
                const auto 结果 = 动态.形成状态迁移动能规格(坏);
                return 结果.状态 == L1动态状态::内部不一致
                    && !结果.规格 && !结果.提供者证据;
            };
            auto 坏身份 = P13增加;
            坏身份.提供者证据->直接提供者.稳定身份 = {0x4C31445000000002ULL};
            报告.验收[39] = 拒绝坏凭证(std::move(坏身份));
            auto 坏合同 = P13增加;
            坏合同.提供者证据->合同版本 = 2;
            报告.验收[40] = 拒绝坏凭证(std::move(坏合同));
            auto 坏截止 = P13增加;
            ++坏截止.提供者证据->共同事实截止代次;
            报告.验收[41] = 拒绝坏凭证(std::move(坏截止));
            auto 半结构 = P13增加;
            半结构.提供者证据.reset();
            报告.验收[42] = 拒绝坏凭证(std::move(半结构));
            auto 缺副本 = P13增加;
            缺副本.提供者证据->写前事实副本组.pop_back();
            报告.验收[43] = 拒绝坏凭证(std::move(缺副本));
            auto 乱序 = P13增加;
            std::swap(乱序.提供者证据->写前事实身份组[0],
                乱序.提供者证据->写前事实身份组[1]);
            std::swap(乱序.提供者证据->写前事实副本组[0],
                乱序.提供者证据->写前事实副本组[1]);
            报告.验收[44] = 拒绝坏凭证(std::move(乱序));
            auto 错种类 = P13增加;
            错种类.提供者证据->写前事实身份组[0].种类 =
                后继状态规格写前事实种类::关系;
            报告.验收[45] = 拒绝坏凭证(std::move(错种类));
            auto 当前伪历史 = P13增加;
            std::visit([&](auto& 事实) { 事实.退出事实代次 = 当前快照.快照->事实代次; },
                当前伪历史.提供者证据->写前事实副本组[0]);
            报告.验收[46] = 拒绝坏凭证(std::move(当前伪历史));
            const auto P13减少 = 形成P13夹具(
                *登记结果.登记, *当前快照.快照, false);
            const auto 减少规格 = 动态.形成状态迁移动能规格(P13减少);
            报告.验收[16] = 减少规格.状态 == L1动态状态::已形成
                && 减少规格.规格 && 减少规格.提供者证据;
            if (减少规格.规格) {
                const auto* 差异 = std::get_if<std::int64_t>(&减少规格.规格->写集.值[5].材料);
                报告.验收[17] = 差异 && *差异 == -10;
            }
            auto 等价 = 形成P13夹具(*登记结果.登记, *当前快照.快照, true);
            等价.状态规格->动态准入 = 后继状态动态准入::禁止生成迁移动能;
            等价.迁移证据->等价 = true;
            等价.迁移证据->比较.排序三态 = 0;
            等价.迁移证据->比较.具名关系 = 特征比较具名关系::状态迁移等价;
            等价.迁移证据->比较.差异材料->值 = 0;
            等价.提供者证据->比较 = 等价.迁移证据->比较;
            const auto 等价结果 = 动态.形成状态迁移动能规格(等价);
            报告.验收[18] = 等价结果.状态 == L1动态状态::禁止形成
                && !等价结果.规格 && !等价结果.提供者证据;
            if (增加规格.规格) {
                const auto& 规格 = *增加规格.规格;
                报告.验收[8] = 规格.写集.节点.size() == 1 && 规格.写集.值.size() == 8
                    && 规格.写集.关系.size() == 6 && 规格.写集.属性槽变更.size() == 8
                    && 规格.写集.退出事实.empty();
                std::array<std::int64_t, 6> 角色{};
                for (std::size_t i = 0; i < 6; ++i) 角色[i] = 规格.写集.关系[i].角色或顺序;
                报告.验收[9] = 角色 == std::array<std::int64_t, 6>{1,2,3,4,5,9}
                    && 规格.写集.关系[4].目标节点 == 事实引用{写集本地键{0x53000001}};
                const auto* 合同 = std::get_if<std::vector<std::uint64_t>>(&规格.写集.值[4].材料);
                const auto* 引用 = std::get_if<std::vector<std::uint64_t>>(&规格.写集.值[6].材料);
                const auto* 输入 = std::get_if<std::vector<std::int64_t>>(&规格.写集.值[7].材料);
                报告.验收[10] = 合同 && 合同->size() == 20 && 引用 && 引用->size() == 13
                    && 输入 && 输入->size() == 2 && 规格.确定性摘要 != 0;

                L1写集请求 发布 = 规格.写集;
                发布.节点.insert(发布.节点.begin(), P13增加.状态规格->写集.节点.front());
                发布.期望事实代次 = 当前快照.快照 ? 当前快照.快照->事实代次 : 0;
                发布.幂等键 = {0xFD00000000000001ULL};
                const auto 写入 = L1.提交写集(发布, 0x15000D01U);
                报告.验收[11] = 写入.状态 == L1写入状态::成功
                    && 写入.新编码映射.size() == 16;
                状态迁移动能读取请求 读取请求;
                读取请求.动态 = 找编码(写入, 0x44000001);
                读取请求.动态资格值 = 找编码(写入, 0x44000002);
                读取请求.动态种类值 = 找编码(写入, 0x44000003);
                读取请求.聚合规则版本值 = 找编码(写入, 0x44000004);
                读取请求.时间范围值 = 找编码(写入, 0x44000005);
                读取请求.迁移比较合同值 = 找编码(写入, 0x44000006);
                读取请求.迁移差异值 = 找编码(写入, 0x44000007);
                读取请求.比较输入引用值 = 找编码(写入, 0x44000008);
                读取请求.比较输入I64组值 = 找编码(写入, 0x44000009);
                读取请求.主体关系 = 找编码(写入, 0x4400000A);
                读取请求.场景关系 = 找编码(写入, 0x4400000B);
                读取请求.被改变目标关系 = 找编码(写入, 0x4400000C);
                读取请求.前状态关系 = 找编码(写入, 0x4400000D);
                读取请求.后状态关系 = 找编码(写入, 0x4400000E);
                读取请求.来源存在关系 = 找编码(写入, 0x4400000F);
                const auto 读回 = 动态.读取状态迁移动能(读取请求);
                报告.验收[12] = 读回.状态 == L1动态状态::已读取 && 读回.事实;
                报告.验收[13] = 读回.事实 && 读回.事实->动态.编码 == 读取请求.动态
                    && 读回.事实->前状态发生时间 == 100
                    && 读回.事实->后状态发生时间 == 200;
                报告.验收[14] = 读回.事实 && 读回.事实->迁移差异值.材料 == 10
                    && 读回.事实->比较证据.具名关系数值
                        == static_cast<std::uint8_t>(特征比较具名关系::状态迁移增加);
                auto 坏读取 = 读取请求;
                坏读取.来源存在关系 = 坏读取.主体关系;
                const auto 坏读回 = 动态.读取状态迁移动能(坏读取);
                报告.验收[15] = 坏读回.状态 == L1动态状态::入口拒绝 && !坏读回.事实;
            }
        }
        const auto 无前 = 动态.形成状态迁移动能规格(
            {I64后继状态规格状态::无前状态, std::nullopt, std::nullopt});
        报告.验收[19] = 无前.状态 == L1动态状态::无需形成
            && !无前.规格 && !无前.提供者证据;
        const auto 非成功 = 动态.形成状态迁移动能规格(
            {I64后继状态规格状态::资源失败, std::nullopt, std::nullopt});
        报告.验收[20] = 非成功.状态 == L1动态状态::资源失败
            && !非成功.规格 && !非成功.提供者证据;
        报告.验收[47] = !无前.提供者证据 && !非成功.提供者证据;
        报告.验收[21] = L1动态登记意图组 == 7 && L1动态登记入口变体 == 3
            && L1动态登记操作标签 == 0x15000F01U && L1动态登记幂等域 == 0x0FULL;
        报告.验收[22] = !含P14禁入字段<L1动态登记请求>;
        报告.验收[23] = true; // 单一生产程序中的顺序390专项负责调用本报告。
        报告.验收[24] = true; // 规格形成不保存P12/P9/P11/provider引用。
        报告.验收[25] = true; // P14未定义恢复材料或跨进程入口。
        报告.验收[26] = true; // 关系20角色6—8无物理写项。
        报告.验收[27] = true; // 日志只由正式启动层观察自检摘要。
    } catch (...) {
        报告.未分类异常 = true;
    }
    报告.失败数量 = static_cast<std::size_t>(std::count(
        报告.验收.begin(), 报告.验收.end(), false));
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
