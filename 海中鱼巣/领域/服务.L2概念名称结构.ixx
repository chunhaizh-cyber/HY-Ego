export namespace 海中鱼巣 {

inline constexpr L1所有者范围建立幂等身份 概念名称所有者建立身份{
    0x4C32'434E'414D'0001ULL};

class L2概念名称结构服务;

class L2概念名称所有者交付 final {
public:
    L2概念名称所有者交付() = delete;
    L2概念名称所有者交付(const L2概念名称所有者交付&) = delete;
    L2概念名称所有者交付& operator=(const L2概念名称所有者交付&) = delete;
    L2概念名称所有者交付(L2概念名称所有者交付&&) noexcept = default;
    L2概念名称所有者交付& operator=(L2概念名称所有者交付&&) = delete;

private:
    explicit L2概念名称所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2概念名称所有者交付> 尝试形成L2概念名称所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2概念名称结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2概念名称所有者交付> 尝试形成L2概念名称所有者交付(
    const L1事实基座服务&, L1所有者范围交付&&) noexcept;

}

namespace 海中鱼巣::L2概念名称结构内部 {

inline constexpr L1所有者范围写入幂等身份 概念名称结构登记幂等身份{
    0x4C32'434E'5247'0001ULL};
inline constexpr std::uint32_t 概念端点关系类型本地键值 = 0x0211'6001U;
inline constexpr std::uint32_t 词条端点关系类型本地键值 = 0x0211'6002U;
inline constexpr std::uint32_t 语言端点关系类型本地键值 = 0x0211'6003U;
inline constexpr std::uint32_t 来源端点关系类型本地键值 = 0x0211'6004U;
inline constexpr std::uint32_t 名称记录节点本地键值 = 0x0211'1001U;
inline constexpr std::uint32_t 概念端点关系本地键值 = 0x0211'1002U;
inline constexpr std::uint32_t 词条端点关系本地键值 = 0x0211'1003U;
inline constexpr std::uint32_t 语言端点关系本地键值 = 0x0211'1004U;
inline constexpr std::uint32_t 来源端点关系本地键值 = 0x0211'1005U;

struct 名称定位 final {
    L1结构所有者身份 所有者;
    L1结构所有者事实 所有者事实;
    稳定编码 概念端点关系类型;
    稳定编码 词条端点关系类型;
    稳定编码 语言端点关系类型;
    稳定编码 来源端点关系类型;
    std::uint64_t 登记事实代次 = 0;
};

struct 名称内部事实 final {
    L2概念名称事实 公开事实;
    稳定编码 记录编码;
    稳定编码 概念关系编码;
    稳定编码 词条关系编码;
    稳定编码 语言关系编码;
    稳定编码 来源关系编码;
};

struct 名称内部读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    std::optional<名称内部事实> 事实;
};

struct 名称组内部读取结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    std::vector<名称内部事实> 事实组;
};

struct 端点验证结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
};

// 诊断责任：无适用错误分支；完整 64 位幂等身份一对一映射。
L1所有者范围写入幂等身份 映射幂等身份(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

// 诊断责任：无适用错误分支；覆盖 L1 写入状态的公开结构映射。
L2结构状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::内部不一致;
    case L1所有者范围写入状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；覆盖 owner 普通读取状态。
L2结构状态 映射读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::许可拒绝: return L2结构状态::资源失败;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::已退出: return L2结构状态::已退出;
    case L1所有者范围读取状态::属性未设置:
        return L2结构状态::属性未设置;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

// 诊断责任：无适用错误分支；依赖服务结构状态保持到名称服务。
L2结构状态 映射依赖读取状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::未找到:
    case L2结构状态::已退出:
    case L2结构状态::事实代次漂移:
    case L2结构状态::资源失败:
        return 状态;
    case L2结构状态::许可拒绝:
        return L2结构状态::内部不一致;
    default:
        return L2结构状态::内部不一致;
    }
}

// 诊断责任：向上送出；读取当前事实代次异常由调用者结构化映射。
std::pair<L2结构状态, std::uint64_t> 读取当前事实代次(
    const L1事实基座服务& 第一层服务) {
    const auto 读取 = 第一层服务.读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (读取.合同版本 != L1中性CRUD合同版本)
        return {L2结构状态::内部不一致, 读取.事实代次};
    if (读取.状态 == L1中性读取状态::成功 && 读取.事实代次 != 0)
        return {L2结构状态::已读取, 读取.事实代次};
    if (读取.状态 == L1中性读取状态::许可拒绝)
        return {L2结构状态::资源失败, 读取.事实代次};
    if (读取.状态 == L1中性读取状态::资源失败)
        return {L2结构状态::资源失败, 读取.事实代次};
    return {L2结构状态::内部不一致, 读取.事实代次};
}

// 诊断责任：向上送出；固定登记恢复只复用 L1 首次请求的原 G0。
std::uint64_t 读取固定登记期望代次(const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 写入端口,
    L1所有者范围写入幂等身份 幂等身份) {
    const auto 首次 = 写入端口.读取首次写入材料(
        {L1所有者范围首次写入读取合同版本, 幂等身份});
    if (首次.状态 == L1所有者范围读取状态::成功) {
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 写入端口.所有者身份()
            || 首次.写入幂等身份 != 幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果
            || 首次.首次规范化写集->写入幂等身份 != 幂等身份
            || 首次.首次规范化写集->期望事实代次 == 0
            || 首次.首次写入结果->所有者 != 写入端口.所有者身份()
            || 首次.首次写入结果->写入幂等身份 != 幂等身份
            || 首次.首次写入结果->事实代次 == 0)
            throw std::runtime_error(
                "L2 concept name fixed registration first material invalid");
        return 首次.首次规范化写集->期望事实代次;
    }
    if (首次.状态 != L1所有者范围读取状态::未找到)
        throw std::runtime_error(
            "L2 concept name fixed registration first read failed");
    const auto [状态, 当前代次] = 读取当前事实代次(第一层服务);
    if (状态 != L2结构状态::已读取 || 当前代次 == 0)
        throw std::runtime_error(
            "L2 concept name fixed registration generation failed");
    return 当前代次;
}

// 诊断责任：向上送出；缺失、重复或零登记映射令服务构造失败。
稳定编码 取得唯一映射(const L1所有者范围写入结果& 写入,
    std::uint32_t 本地键) {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 写入.新编码映射) {
        if (键.值 != 本地键) continue;
        if (找到 || !有效(编码))
            throw std::runtime_error(
                "L2 concept name registration mapping is invalid");
        找到 = 编码;
    }
    if (!找到)
        throw std::runtime_error(
            "L2 concept name registration mapping is missing");
    return *找到;
}

// 诊断责任：向上送出；登记节点必须由同一 owner 在同一代次建立并保持活动。
L1所有者范围节点事实 读取名称登记节点(const L1事实基座服务& 第一层服务,
    const 名称定位& 定位, 稳定编码 编码, std::uint64_t 代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    if (读取.状态 != L1所有者范围读取状态::成功
        || 读取.合同版本 != L1所有者范围CRUD合同版本
        || 读取.查询编码 != 编码 || 读取.读取事实代次 < 代次
        || !节点 || 节点->编码 != 编码 || 节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || 节点->创建事实代次 != 代次 || 节点->退出事实代次
        || !节点->当前属性.empty())
        throw std::runtime_error(
            "L2 concept name registration readback is invalid");
    return *节点;
}

// 诊断责任：向上送出；固定四项登记只接受首次或精确重复的完整回显。
名称定位 初始化概念名称登记(const L1事实基座服务& 第一层服务,
    L1所有者范围写端口& 写入端口) {
    名称定位 定位;
    定位.所有者 = 写入端口.所有者身份();
    const auto 所有者 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 定位.所有者});
    if (所有者.状态 != L1所有者范围读取状态::成功
        || 所有者.合同版本 != L1所有者范围CRUD合同版本
        || !所有者.所有者事实
        || 所有者.所有者事实->所有者 != 定位.所有者
        || 所有者.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者.所有者事实->创建事实代次 == 0
        || 所有者.所有者事实->退出事实代次)
        throw std::runtime_error("L2 concept name owner fact is invalid");
    定位.所有者事实 = *所有者.所有者事实;
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 读取固定登记期望代次(
        第一层服务, 写入端口, 概念名称结构登记幂等身份);
    写集.写入幂等身份 = 概念名称结构登记幂等身份;
    写集.节点 = {
        {{概念端点关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{词条端点关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{语言端点关系类型本地键值}, 节点种类::普通, std::nullopt},
        {{来源端点关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界
            == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 定位.所有者
        || 写入.写入幂等身份 != 概念名称结构登记幂等身份
        || 写入.事实代次 == 0 || (!首次 && !重复)
        || 写入.新编码映射.size() != 4)
        throw std::runtime_error("L2 concept name registration failed");
    定位.概念端点关系类型 = 取得唯一映射(
        写入, 概念端点关系类型本地键值);
    定位.词条端点关系类型 = 取得唯一映射(
        写入, 词条端点关系类型本地键值);
    定位.语言端点关系类型 = 取得唯一映射(
        写入, 语言端点关系类型本地键值);
    定位.来源端点关系类型 = 取得唯一映射(
        写入, 来源端点关系类型本地键值);
    std::vector<std::uint64_t> 编码{定位.概念端点关系类型.值,
        定位.词条端点关系类型.值, 定位.语言端点关系类型.值,
        定位.来源端点关系类型.值};
    std::sort(编码.begin(), 编码.end());
    if (std::adjacent_find(编码.begin(), 编码.end()) != 编码.end())
        throw std::runtime_error(
            "L2 concept name registration aliases facts");
    定位.登记事实代次 = 写入.事实代次;
    (void)读取名称登记节点(
        第一层服务, 定位, 定位.概念端点关系类型, 写入.事实代次);
    (void)读取名称登记节点(
        第一层服务, 定位, 定位.词条端点关系类型, 写入.事实代次);
    (void)读取名称登记节点(
        第一层服务, 定位, 定位.语言端点关系类型, 写入.事实代次);
    (void)读取名称登记节点(
        第一层服务, 定位, 定位.来源端点关系类型, 写入.事实代次);
    return 定位;
}

// 诊断责任：无适用错误分支；把晚于截止的退出从历史值式投影移除。
L2生命周期 投影生命周期(std::uint64_t 创建,
    std::optional<std::uint64_t> 退出, std::uint64_t 截止) noexcept {
    if (退出 && *退出 > 截止) 退出.reset();
    return {创建, 退出};
}

// 诊断责任：向上送出；记录节点指定端点和类型在截止上必须形成唯一关系。
L1所有者范围关系事实 读取唯一名称历史关系(
    const L1事实基座服务& 第一层服务, const 名称定位& 定位,
    L1所有者范围关系端点方向 方向, 稳定编码 端点,
    稳定编码 类型, std::uint64_t 截止, std::uint64_t 观察代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, 方向, 端点, 类型, 截止});
    if (读取.状态 != L1所有者范围读取状态::成功
        || 读取.合同版本 != L1所有者范围CRUD合同版本
        || 读取.方向 != 方向 || 读取.端点节点 != 端点
        || 读取.关系类型节点 != 类型
        || 读取.历史截止事实代次 != 截止
        || 读取.读取事实代次 != 观察代次 || 读取.关系组.size() != 1)
        throw std::runtime_error(
            "L2 concept name relation projection is invalid");
    const auto& 关系 = 读取.关系组.front();
    if (关系.写入所有者 != 定位.所有者 || 关系.关系类型节点 != 类型)
        throw std::runtime_error(
            "L2 concept name relation owner is invalid");
    return 关系;
}

// 诊断责任：向上送出；记录节点与四端点关系在同一截止重建完整名称事实。
名称内部读取结果 读取历史名称核心(const L1事实基座服务& 第一层服务,
    const 名称定位& 定位, L2概念名称关系身份 身份, std::uint64_t 截止,
    std::uint64_t 观察代次, bool 要求当前活动) {
    const auto 节点读 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 身份.值});
    if (节点读.合同版本 != L1所有者范围CRUD合同版本
        || 节点读.查询编码 != 身份.值
        || 节点读.读取事实代次 != 观察代次)
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    if (节点读.状态 != L1所有者范围读取状态::成功)
        return {映射读取状态(节点读.状态), 截止, std::nullopt};
    const auto* 节点 = 节点读.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点读.事实) : nullptr;
    if (!节点 || 节点->编码 != 身份.值
        || 节点->写入所有者 != 定位.所有者
        || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
        || !节点->当前属性.empty())
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    if (节点->创建事实代次 > 截止)
        return {L2结构状态::未找到, 截止, std::nullopt};
    if (要求当前活动 && 节点->退出事实代次
        && *节点->退出事实代次 <= 截止)
        return {L2结构状态::已退出, 截止, std::nullopt};
    const std::uint64_t 关系截止 = 节点->退出事实代次
            && *节点->退出事实代次 <= 截止
        ? *节点->退出事实代次 - 1 : 截止;
    try {
        const auto 概念关系 = 读取唯一名称历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::目标, 身份.值,
            定位.概念端点关系类型, 关系截止, 观察代次);
        const auto 词条关系 = 读取唯一名称历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.词条端点关系类型, 关系截止, 观察代次);
        const auto 语言关系 = 读取唯一名称历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.语言端点关系类型, 关系截止, 观察代次);
        const auto 来源关系 = 读取唯一名称历史关系(第一层服务, 定位,
            L1所有者范围关系端点方向::源, 身份.值,
            定位.来源端点关系类型, 关系截止, 观察代次);
        if (概念关系.角色或顺序 < 1 || 概念关系.角色或顺序 > 3
            || 词条关系.角色或顺序 != 1 || 语言关系.角色或顺序 != 1
            || 来源关系.角色或顺序 != 1
            || !有效(概念关系.源节点) || !有效(词条关系.目标节点)
            || !有效(语言关系.目标节点) || !有效(来源关系.目标节点)
            || 概念关系.目标节点 != 身份.值
            || 词条关系.源节点 != 身份.值
            || 语言关系.源节点 != 身份.值
            || 来源关系.源节点 != 身份.值
            || 节点->创建事实代次 != 概念关系.创建事实代次
            || 节点->创建事实代次 != 词条关系.创建事实代次
            || 节点->创建事实代次 != 语言关系.创建事实代次
            || 节点->创建事实代次 != 来源关系.创建事实代次
            || 节点->退出事实代次 != 概念关系.退出事实代次
            || 节点->退出事实代次 != 词条关系.退出事实代次
            || 节点->退出事实代次 != 语言关系.退出事实代次
            || 节点->退出事实代次 != 来源关系.退出事实代次)
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        const auto 生命周期 = 投影生命周期(
            节点->创建事实代次, 节点->退出事实代次, 截止);
        L2概念名称事实 事实{L2概念名称关系身份{身份.值},
            L2概念身份{概念关系.源节点}, L2词条身份{词条关系.目标节点},
            static_cast<L2概念名称角色>(概念关系.角色或顺序),
            L2语言身份{语言关系.目标节点}, 来源关系.目标节点, 生命周期};
        if (!L2概念名称事实截止投影完整(事实, 截止))
            return {L2结构状态::内部不一致, 截止, std::nullopt};
        return {L2结构状态::已读取, 截止,
            名称内部事实{std::move(事实), 身份.值, 概念关系.编码,
                词条关系.编码, 语言关系.编码, 来源关系.编码}};
    } catch (const std::bad_alloc&) {
        return {L2结构状态::资源失败, 截止, std::nullopt};
    } catch (const std::length_error&) {
        return {L2结构状态::资源失败, 截止, std::nullopt};
    } catch (...) {
        return {L2结构状态::内部不一致, 截止, std::nullopt};
    }
}

// 诊断责任：向上送出；当前名称先消费 owner 一致投影再同代重建。
名称内部读取结果 读取当前名称核心(const L1事实基座服务& 第一层服务,
    const 名称定位& 定位, L2概念名称关系身份 身份, std::uint64_t 守卫) {
    L1所有者范围一致当前读取请求 请求;
    请求.合同版本 = L1所有者范围一致当前读取合同版本;
    请求.期望事实代次 = 守卫;
    请求.所有者 = {定位.所有者};
    请求.节点 = {身份.值};
    请求.源关系组 = {{身份.值, 定位.词条端点关系类型},
        {身份.值, 定位.语言端点关系类型},
        {身份.值, 定位.来源端点关系类型}};
    请求.目标关系组 = {{身份.值, 定位.概念端点关系类型}};
    const auto 一致 = 第一层服务.尝试读取所有者范围一致当前投影(请求);
    if (一致.合同版本 != L1所有者范围一致当前读取合同版本
        || 一致.期望事实代次 != 守卫)
        return {L2结构状态::内部不一致, 守卫, std::nullopt};
    if (一致.状态 != L1所有者范围一致当前读取状态::成功) {
        if (一致.状态 == L1所有者范围一致当前读取状态::事实代次漂移)
            return {L2结构状态::事实代次漂移, 一致.读取事实代次,
                std::nullopt};
        if (一致.状态 == L1所有者范围一致当前读取状态::资源失败)
            return {L2结构状态::资源失败, 一致.读取事实代次, std::nullopt};
        return {L2结构状态::内部不一致, 一致.读取事实代次, std::nullopt};
    }
    if (一致.读取事实代次 != 守卫 || 一致.所有者.size() != 1
        || 一致.节点.size() != 1 || 一致.源关系组.size() != 3
        || 一致.目标关系组.size() != 1)
        return {L2结构状态::内部不一致, 一致.读取事实代次, std::nullopt};
    return 读取历史名称核心(第一层服务, 定位, 身份, 守卫, 守卫, true);
}

// 诊断责任：向上送出；目标概念的当前名称组只经概念端点关系类型重建。
名称组内部读取结果 读取概念当前名称组(
    const L1事实基座服务& 第一层服务, const 名称定位& 定位,
    L2概念身份 概念, std::uint64_t 守卫) {
    const auto 关系组 = 第一层服务.读取所有者范围历史关系组(
        {L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
            概念.值, 定位.概念端点关系类型, 守卫});
    if (关系组.状态 != L1所有者范围读取状态::成功
        || 关系组.合同版本 != L1所有者范围CRUD合同版本
        || 关系组.读取事实代次 != 守卫
        || 关系组.历史截止事实代次 != 守卫)
        return {关系组.状态 == L1所有者范围读取状态::资源失败
                ? L2结构状态::资源失败 : 映射读取状态(关系组.状态),
            守卫, {}};
    std::vector<名称内部事实> 组;
    for (const auto& 关系 : 关系组.关系组) {
        if (关系.写入所有者 != 定位.所有者
            || 关系.源节点 != 概念.值
            || 关系.关系类型节点 != 定位.概念端点关系类型)
            return {L2结构状态::内部不一致, 守卫, {}};
        const auto 候选 = 读取历史名称核心(第一层服务, 定位,
            L2概念名称关系身份{关系.目标节点}, 守卫, 守卫, true);
        if (候选.状态 != L2结构状态::已读取 || !候选.事实
            || 候选.事实->概念关系编码 != 关系.编码
            || 候选.事实->公开事实.概念 != 概念)
            return {L2结构状态::内部不一致, 守卫, {}};
        组.push_back(*候选.事实);
    }
    return {L2结构状态::已读取, 守卫, std::move(组)};
}

// 诊断责任：向上送出；写前在请求守卫验证概念、词条、语言与来源端点。
端点验证结果 验证当前写入端点(const L1事实基座服务& 第一层服务,
    const L2概念结构服务& 概念服务, const L2语言结构服务& 语言服务,
    L2概念身份 概念, L2词条身份 词条, L2语言身份 适用语言,
    稳定编码 来源, std::uint64_t 守卫) {
    const auto 根组 = 概念服务.读取全部当前概念本体根(
        {{L2结构合同版本, 守卫}});
    if (!根组.成功())
        return {映射依赖读取状态(根组.结果头.状态),
            根组.结果头.事实截止代次};
    const bool 根命中 = std::any_of(根组.本体根.begin(),
        根组.本体根.end(), [&](const L2概念本体根事实& 根) noexcept {
            return 根.根概念 == 概念;
        });
    if (!根命中) {
        const auto 概念读 = 概念服务.读取普通概念(
            {{L2结构合同版本, 守卫}, L2普通概念结构合同版本,
                L2读取类别::当前, 概念, 0});
        if (!概念读.成功())
            return {映射依赖读取状态(概念读.结果头.状态),
                概念读.结果头.事实截止代次};
        if (!概念读.概念 || 概念读.概念->概念 != 概念)
            return {L2结构状态::内部不一致, 概念读.结果头.事实截止代次};
    }
    const auto 词条读 = 语言服务.读取词条({{L2结构合同版本, 守卫},
        L2词条结构合同版本, L2读取类别::当前, 词条, 0});
    if (!词条读.成功())
        return {映射依赖读取状态(词条读.结果头.状态),
            词条读.结果头.事实截止代次};
    if (!词条读.词条 || 词条读.词条->词条 != 词条)
        return {L2结构状态::内部不一致, 词条读.结果头.事实截止代次};
    const auto 语言读 = 语言服务.读取语言({{L2结构合同版本, 守卫},
        L2语言结构合同版本, L2读取类别::当前, 适用语言, 0});
    if (!语言读.成功())
        return {映射依赖读取状态(语言读.结果头.状态),
            语言读.结果头.事实截止代次};
    if (!语言读.语言 || 语言读.语言->语言 != 适用语言)
        return {L2结构状态::内部不一致, 语言读.结果头.事实截止代次};
    if (词条读.词条->规范化键.语言 != 适用语言
        || 词条读.词条->语言归属.语言 != 适用语言)
        return {L2结构状态::引用冲突, 词条读.结果头.事实截止代次};
    const auto 来源读 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 来源});
    if (来源读.合同版本 != L1所有者范围CRUD合同版本
        || 来源读.查询编码 != 来源)
        return {L2结构状态::内部不一致, 守卫};
    if (来源读.读取事实代次 != 守卫)
        return {L2结构状态::事实代次漂移, 来源读.读取事实代次};
    if (来源读.状态 == L1所有者范围读取状态::未找到)
        return {L2结构状态::未找到, 守卫};
    if (来源读.状态 == L1所有者范围读取状态::已退出)
        return {L2结构状态::已退出, 守卫};
    if (来源读.状态 != L1所有者范围读取状态::成功)
        return {映射读取状态(来源读.状态), 守卫};
    const auto* 节点 = 来源读.事实
        ? std::get_if<L1所有者范围节点事实>(&*来源读.事实) : nullptr;
    if (!节点 || 节点->编码 != 来源)
        return {L2结构状态::未找到, 守卫};
    if (节点->创建事实代次 > 守卫)
        return {L2结构状态::未找到, 守卫};
    if (节点->退出事实代次 && *节点->退出事实代次 <= 守卫)
        return {L2结构状态::已退出, 守卫};
    return {L2结构状态::已读取, 守卫};
}

// 诊断责任：向上送出；历史名称端点使用同一截止经公开历史读取互证。
L2结构状态 验证历史名称端点(const L1事实基座服务& 第一层服务,
    const L2概念结构服务& 概念服务, const L2语言结构服务& 语言服务,
    const L2概念名称事实& 事实, std::uint64_t 截止,
    std::uint64_t 观察代次) {
    (void)第一层服务;
    const auto 根组 = 概念服务.读取全部当前概念本体根(
        {{L2结构合同版本, 观察代次}});
    if (!根组.成功())
        return 映射依赖读取状态(根组.结果头.状态);
    const bool 根命中 = std::any_of(根组.本体根.begin(),
        根组.本体根.end(), [&](const L2概念本体根事实& 根) noexcept {
            return 根.根概念 == 事实.概念;
        });
    if (!根命中) {
        const auto 概念读 = 概念服务.读取普通概念(
            {{L2结构合同版本, 观察代次}, L2普通概念结构合同版本,
                L2读取类别::历史, 事实.概念, 截止});
        if (!概念读.成功())
            return 映射依赖读取状态(概念读.结果头.状态);
        if (!概念读.概念 || 概念读.概念->概念 != 事实.概念)
            return L2结构状态::内部不一致;
    }
    const auto 词条读 = 语言服务.读取词条({{L2结构合同版本, 观察代次},
        L2词条结构合同版本, L2读取类别::历史, 事实.词条, 截止});
    if (!词条读.成功())
        return 映射依赖读取状态(词条读.结果头.状态);
    if (!词条读.词条 || 词条读.词条->词条 != 事实.词条)
        return L2结构状态::内部不一致;
    const auto 语言读 = 语言服务.读取语言({{L2结构合同版本, 观察代次},
        L2语言结构合同版本, L2读取类别::历史, 事实.适用语言, 截止});
    if (!语言读.成功())
        return 映射依赖读取状态(语言读.结果头.状态);
    if (!语言读.语言 || 语言读.语言->语言 != 事实.适用语言)
        return L2结构状态::内部不一致;
    return L2结构状态::已读取;
}

// 诊断责任：无适用错误分支；形成写入空载荷失败。
L2概念名称写入结果 写入失败(L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

// 诊断责任：无适用错误分支；形成单项读取空载荷失败。
L2概念名称读取结果 读取失败(const L2概念名称读取请求& 请求,
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        请求.读取类别, 请求.历史截止事实代次, std::nullopt};
}

// 诊断责任：无适用错误分支；形成组读取空载荷失败。
L2概念名称组读取结果 组读取失败(L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, {}};
}

// 诊断责任：无适用错误分支；形成单名称记录与四端点关系原子新增写集。
L1所有者范围写集请求 形成名称新增写集(std::uint64_t 守卫,
    L1所有者范围写入幂等身份 幂等, const 名称定位& 定位,
    L2概念身份 概念, L2词条身份 词条, L2概念名称角色 角色,
    L2语言身份 适用语言, 稳定编码 来源) {
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 守卫;
    写集.写入幂等身份 = 幂等;
    写集.节点 = {{{名称记录节点本地键值}, 节点种类::普通, std::nullopt}};
    写集.关系 = {
        {{概念端点关系本地键值}, 概念.值,
            L1所有者范围写集本地键{名称记录节点本地键值},
            定位.概念端点关系类型,
            static_cast<std::int64_t>(角色)},
        {{词条端点关系本地键值},
            L1所有者范围写集本地键{名称记录节点本地键值}, 词条.值,
            定位.词条端点关系类型, 1},
        {{语言端点关系本地键值},
            L1所有者范围写集本地键{名称记录节点本地键值}, 适用语言.值,
            定位.语言端点关系类型, 1},
        {{来源端点关系本地键值},
            L1所有者范围写集本地键{名称记录节点本地键值}, 来源,
            定位.来源端点关系类型, 1}};
    return 写集;
}

// 诊断责任：无适用错误分支；五事实退出编码按稳定顺序加入写集。
void 加入名称退出写集(L1所有者范围写集请求& 写集,
    const 名称内部事实& 事实) {
    写集.退出事实 = {事实.记录编码, 事实.概念关系编码,
        事实.词条关系编码, 事实.语言关系编码, 事实.来源关系编码};
}

// 诊断责任：无适用错误分支；从写入结果取得唯一新名称记录编码。
std::optional<稳定编码> 取得新名称记录编码(
    const L1所有者范围写入结果& 结果) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 名称记录节点本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

// 诊断责任：无适用错误分支；只判断名称内容五元组是否与请求一致。
bool 名称内容匹配(const L2概念名称事实& 事实, L2概念身份 概念,
    L2词条身份 词条, L2概念名称角色 角色, L2语言身份 适用语言,
    稳定编码 来源) noexcept {
    return 事实.概念 == 概念 && 事实.词条 == 词条 && 事实.角色 == 角色
        && 事实.适用语言 == 适用语言 && 事实.来源稳定编码 == 来源;
}

// 诊断责任：无适用错误分支；只判断新增目标五元组是否违反唯一性。
bool 唯一性冲突(const std::vector<名称内部事实>& 已有,
    L2概念名称关系身份 排除身份, L2词条身份 词条, L2概念名称角色 角色,
    L2语言身份 适用语言) noexcept {
    for (const auto& 项 : 已有) {
        const auto& 事实 = 项.公开事实;
        if (事实.名称关系 == 排除身份) continue;
        if (事实.词条 == 词条 && 事实.角色 == 角色
            && 事实.适用语言 == 适用语言)
            return true;
        if (角色 == L2概念名称角色::首选名称
            && 事实.角色 == L2概念名称角色::首选名称
            && 事实.适用语言 == 适用语言)
            return true;
    }
    return false;
}

// 诊断责任：无适用错误分支；正向组按固定四元组严格升序比较。
bool 正向组序更小(const L2概念名称事实& 左,
    const L2概念名称事实& 右) noexcept {
    if (左.适用语言.值 != 右.适用语言.值)
        return 左.适用语言.值 < 右.适用语言.值;
    if (左.角色 != 右.角色)
        return static_cast<std::uint8_t>(左.角色)
            < static_cast<std::uint8_t>(右.角色);
    if (左.词条.值 != 右.词条.值) return 左.词条.值 < 右.词条.值;
    return 左.名称关系.值 < 右.名称关系.值;
}

// 诊断责任：无适用错误分支；反向组按固定四元组严格升序比较。
bool 反向组序更小(const L2概念名称事实& 左,
    const L2概念名称事实& 右) noexcept {
    if (左.概念.值 != 右.概念.值) return 左.概念.值 < 右.概念.值;
    if (左.适用语言.值 != 右.适用语言.值)
        return 左.适用语言.值 < 右.适用语言.值;
    if (左.角色 != 右.角色)
        return static_cast<std::uint8_t>(左.角色)
            < static_cast<std::uint8_t>(右.角色);
    return 左.名称关系.值 < 右.名称关系.值;
}

} // namespace 海中鱼巣::L2概念名称结构内部

export namespace 海中鱼巣 {

// 诊断责任：向上送出；交付或实例绑定不完整时只返回空 optional。
std::optional<L2概念名称所有者交付> 尝试形成L2概念名称所有者交付(
    const L1事实基座服务& 第一层服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界
                == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 概念名称所有者建立身份
            || 建立.事实代次 == 0 || (!首次 && !重复)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类
                != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份()
                != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层服务))
            return std::nullopt;
        const auto 当前 = 第一层服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2概念名称所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class L2概念名称结构服务 final {
public:
    // 诊断责任：向上送出；同 L1、固定登记失败时抛出。
    // 三服务同 L1 与 owner 两两不同由唯一装配运行包、交付形成函数对
    // 固定建立幂等身份的强制核对和 L1 建立单射性共同保证，不暴露端口。
    explicit L2概念名称结构服务(const L1事实基座服务& 第一层服务,
        const L2概念结构服务& 概念服务,
        const L2语言结构服务& 语言服务,
        L2概念名称所有者交付&& 名称所有者交付)
        : L2概念名称结构服务(第一层服务, 概念服务, 语言服务,
            验证并移动交付(第一层服务, 名称所有者交付)) {}

    L2概念名称结构服务() = delete;
    L2概念名称结构服务(const L2概念名称结构服务&) = delete;
    L2概念名称结构服务& operator=(const L2概念名称结构服务&) = delete;
    L2概念名称结构服务(L2概念名称结构服务&&) = delete;
    L2概念名称结构服务& operator=(L2概念名称结构服务&&) = delete;

    // 诊断责任：本地记录；异常映射不泄漏半载荷或伪造发布成功。
    L2概念名称写入结果 新增概念名称关系(
        const L2概念名称新增请求& 请求) {
        using namespace L2概念名称结构内部;
        if (!L2概念名称新增请求有效(请求)
            || 请求.幂等身份.值 == 概念名称结构登记幂等身份.值)
            return 写入失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放新增(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 写入失败(
                    映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 守卫 = 请求.请求头.期望事实代次;
            const auto 端点 = 验证当前写入端点(第一层服务_, 概念服务_,
                语言服务_, 请求.概念, 请求.词条, 请求.适用语言,
                请求.来源稳定编码, 守卫);
            if (端点.状态 != L2结构状态::已读取)
                return 写入失败(端点.状态, 端点.截止);
            const auto 已有 = 读取概念当前名称组(
                第一层服务_, 定位_, 请求.概念, 守卫);
            if (已有.状态 != L2结构状态::已读取)
                return 写入失败(已有.状态, 已有.截止);
            if (唯一性冲突(已有.事实组, L2概念名称关系身份{},
                请求.词条, 请求.角色, 请求.适用语言))
                return 写入失败(L2结构状态::引用冲突, 守卫);
            const auto 写集 = 形成名称新增写集(守卫, 幂等, 定位_,
                请求.概念, 请求.词条, 请求.角色, 请求.适用语言,
                请求.来源稳定编码);
            const auto 写入 =
                第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 写入失败(状态, 写入.事实代次);
            const auto 新编码 = 取得新名称记录编码(写入);
            if (!新编码 || 写入.事实代次 <= 守卫)
                return 写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 读回 = 读取历史名称核心(第一层服务_, 定位_,
                L2概念名称关系身份{*新编码}, 写入.事实代次,
                写入.事实代次, false);
            if (读回.状态 != L2结构状态::已读取 || !读回.事实
                || !名称内容匹配(读回.事实->公开事实, 请求.概念,
                    请求.词条, 请求.角色, 请求.适用语言,
                    请求.来源稳定编码))
                return 写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2概念名称写入结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次},
                std::move(读回.事实->公开事实), std::nullopt};
            return 结果.成功() ? 结果
                : 写入失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 写入失败(L2结构状态::资源失败);
        } catch (...) {
            return 写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；替换始终由一份退出旧五事实并新增五事实的写集完成。
    L2概念名称写入结果 替换概念名称关系(
        const L2概念名称替换请求& 请求) {
        using namespace L2概念名称结构内部;
        if (!L2概念名称替换请求有效(请求)
            || 请求.幂等身份.值 == 概念名称结构登记幂等身份.值)
            return 写入失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放替换(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 写入失败(
                    映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 守卫 = 请求.请求头.期望事实代次;
            const auto 旧读 = 读取当前名称核心(第一层服务_, 定位_,
                请求.旧关系.名称关系, 守卫);
            if (旧读.状态 != L2结构状态::已读取 || !旧读.事实)
                return 写入失败(旧读.状态, 旧读.截止);
            if (旧读.事实->公开事实 != 请求.旧关系)
                return 写入失败(L2结构状态::引用冲突, 旧读.截止);
            const auto 端点 = 验证当前写入端点(第一层服务_, 概念服务_,
                语言服务_, 请求.新概念, 请求.新词条, 请求.新适用语言,
                请求.新来源稳定编码, 守卫);
            if (端点.状态 != L2结构状态::已读取)
                return 写入失败(端点.状态, 端点.截止);
            const auto 已有 = 读取概念当前名称组(
                第一层服务_, 定位_, 请求.新概念, 守卫);
            if (已有.状态 != L2结构状态::已读取)
                return 写入失败(已有.状态, 已有.截止);
            if (唯一性冲突(已有.事实组, 请求.旧关系.名称关系,
                请求.新词条, 请求.新角色, 请求.新适用语言))
                return 写入失败(L2结构状态::引用冲突, 守卫);
            auto 写集 = 形成名称新增写集(守卫, 幂等, 定位_,
                请求.新概念, 请求.新词条, 请求.新角色,
                请求.新适用语言, 请求.新来源稳定编码);
            加入名称退出写集(写集, *旧读.事实);
            const auto 写入 =
                第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 写入失败(状态, 写入.事实代次);
            const auto 新编码 = 取得新名称记录编码(写入);
            if (!新编码 || *新编码 == 请求.旧关系.名称关系.值
                || 写入.事实代次 <= 守卫)
                return 写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 新读 = 读取历史名称核心(第一层服务_, 定位_,
                L2概念名称关系身份{*新编码}, 写入.事实代次,
                写入.事实代次, false);
            const auto 旧历史 = 读取历史名称核心(第一层服务_, 定位_,
                请求.旧关系.名称关系, 写入.事实代次,
                写入.事实代次, false);
            if (新读.状态 != L2结构状态::已读取 || !新读.事实
                || 旧历史.状态 != L2结构状态::已读取 || !旧历史.事实
                || !名称内容匹配(新读.事实->公开事实, 请求.新概念,
                    请求.新词条, 请求.新角色, 请求.新适用语言,
                    请求.新来源稳定编码)
                || !名称内容匹配(旧历史.事实->公开事实,
                    请求.旧关系.概念, 请求.旧关系.词条,
                    请求.旧关系.角色, 请求.旧关系.适用语言,
                    请求.旧关系.来源稳定编码))
                return 写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2概念名称写入结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次},
                std::move(新读.事实->公开事实),
                std::move(旧历史.事实->公开事实)};
            return 结果.成功() ? 结果
                : 写入失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 写入失败(L2结构状态::资源失败);
        } catch (...) {
            return 写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；L1 引用保护结果保持为结构化引用冲突。
    L2概念名称写入结果 退出概念名称关系(
        const L2概念名称退出请求& 请求) {
        using namespace L2概念名称结构内部;
        if (!L2概念名称退出请求有效(请求)
            || 请求.幂等身份.值 == 概念名称结构登记幂等身份.值)
            return 写入失败(L2结构状态::入口拒绝);
        try {
            std::lock_guard<std::mutex> 锁(写入锁_);
            const auto 幂等 = 映射幂等身份(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, 幂等});
            if (首次.状态 == L1所有者范围读取状态::成功)
                return 重放退出(请求, 首次);
            if (首次.状态 != L1所有者范围读取状态::未找到)
                return 写入失败(
                    映射读取状态(首次.状态), 首次.读取事实代次);
            const auto 守卫 = 请求.请求头.期望事实代次;
            const auto 当前 = 读取当前名称核心(第一层服务_, 定位_,
                请求.关系.名称关系, 守卫);
            if (当前.状态 != L2结构状态::已读取 || !当前.事实)
                return 写入失败(当前.状态, 当前.截止);
            if (当前.事实->公开事实 != 请求.关系)
                return 写入失败(L2结构状态::引用冲突, 当前.截止);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 守卫;
            写集.写入幂等身份 = 幂等;
            加入名称退出写集(写集, *当前.事实);
            const auto 写入 =
                第一层写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != L2结构状态::已提交
                && 状态 != L2结构状态::精确重复)
                return 写入失败(状态, 写入.事实代次);
            if (!写入.新编码映射.empty() || 写入.事实代次 <= 守卫)
                return 写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 历史 = 读取历史名称核心(第一层服务_, 定位_,
                请求.关系.名称关系, 写入.事实代次,
                写入.事实代次, false);
            if (历史.状态 != L2结构状态::已读取 || !历史.事实
                || !名称内容匹配(历史.事实->公开事实, 请求.关系.概念,
                    请求.关系.词条, 请求.关系.角色,
                    请求.关系.适用语言, 请求.关系.来源稳定编码))
                return 写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            L2概念名称写入结果 结果{{L2结构合同版本, 状态,
                写入.事实代次, 写入.事实代次}, std::nullopt,
                std::move(历史.事实->公开事实)};
            return 结果.成功() ? 结果
                : 写入失败(L2结构状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return 写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 写入失败(L2结构状态::资源失败);
        } catch (...) {
            return 写入失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；当前与历史均以前后同代守卫返回值式结果。
    L2概念名称读取结果 读取概念名称关系(
        const L2概念名称读取请求& 请求) const {
        using namespace L2概念名称结构内部;
        if (!L2概念名称读取请求有效(请求))
            return 读取失败(请求, L2结构状态::入口拒绝);
        try {
            const auto [前状态, 前代次] = 读取当前事实代次(第一层服务_);
            if (前状态 != L2结构状态::已读取)
                return 读取失败(请求, 前状态, 前代次);
            if (前代次 != 请求.请求头.期望事实代次)
                return 读取失败(请求, L2结构状态::事实代次漂移, 前代次);
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 核心 = 读取当前名称核心(第一层服务_, 定位_,
                    请求.名称关系, 前代次);
                if (核心.状态 != L2结构状态::已读取 || !核心.事实)
                    return 读取失败(请求, 核心.状态, 核心.截止);
                const auto [后状态, 后代次] =
                    读取当前事实代次(第一层服务_);
                if (后状态 != L2结构状态::已读取)
                    return 读取失败(请求, 后状态, 后代次);
                if (后代次 != 前代次)
                    return 读取失败(
                        请求, L2结构状态::事实代次漂移, 后代次);
                L2概念名称读取结果 结果{{L2结构合同版本,
                    L2结构状态::已读取, 前代次, std::nullopt},
                    请求.读取类别, 请求.历史截止事实代次,
                    std::move(核心.事实->公开事实)};
                return 结果.成功() ? 结果
                    : 读取失败(请求, L2结构状态::内部不一致, 前代次);
            }
            const auto 截止 = 请求.历史截止事实代次;
            const auto 核心 = 读取历史名称核心(第一层服务_, 定位_,
                请求.名称关系, 截止, 前代次, false);
            if (核心.状态 != L2结构状态::已读取 || !核心.事实)
                return 读取失败(请求, 核心.状态, 核心.截止);
            const std::uint64_t 有效截止 =
                核心.事实->公开事实.生命周期.退出事实代次
                        && *核心.事实->公开事实.生命周期.退出事实代次
                            <= 截止
                    ? *核心.事实->公开事实.生命周期.退出事实代次 - 1
                    : 截止;
            const auto 端点状态 = 验证历史名称端点(第一层服务_,
                概念服务_, 语言服务_, 核心.事实->公开事实,
                有效截止, 前代次);
            if (端点状态 != L2结构状态::已读取)
                return 读取失败(请求, 端点状态, 截止);
            const auto [后状态, 后代次] = 读取当前事实代次(第一层服务_);
            if (后状态 != L2结构状态::已读取)
                return 读取失败(请求, 后状态, 后代次);
            if (后代次 != 前代次)
                return 读取失败(
                    请求, L2结构状态::事实代次漂移, 后代次);
            L2概念名称读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次,
                std::move(核心.事实->公开事实)};
            return 结果.成功() ? 结果
                : 读取失败(请求, L2结构状态::内部不一致, 截止);
        } catch (const std::bad_alloc&) {
            return 读取失败(请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 读取失败(请求, L2结构状态::资源失败);
        } catch (...) {
            return 读取失败(请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；正向组只读概念端点当前源关系组并稳定排序。
    L2概念名称组读取结果 按概念读取名称关系组(
        const L2按概念名称组读取请求& 请求) const {
        using namespace L2概念名称结构内部;
        if (!L2按概念名称组读取请求有效(请求))
            return 组读取失败(L2结构状态::入口拒绝);
        try {
            const auto 守卫 = 请求.请求头.期望事实代次;
            const auto [前状态, 前代次] = 读取当前事实代次(第一层服务_);
            if (前状态 != L2结构状态::已读取)
                return 组读取失败(前状态, 前代次);
            if (前代次 != 守卫)
                return 组读取失败(L2结构状态::事实代次漂移, 前代次);
            const auto 关系组 = 第一层服务_.读取所有者范围历史关系组(
                {L1所有者范围CRUD合同版本,
                    L1所有者范围关系端点方向::源, 请求.概念.值,
                    定位_.概念端点关系类型, 守卫});
            if (关系组.状态 != L1所有者范围读取状态::成功
                || 关系组.合同版本 != L1所有者范围CRUD合同版本
                || 关系组.读取事实代次 != 守卫
                || 关系组.历史截止事实代次 != 守卫)
                return 组读取失败(
                    关系组.状态 == L1所有者范围读取状态::资源失败
                        ? L2结构状态::资源失败
                        : 映射读取状态(关系组.状态), 守卫);
            if (关系组.关系组.size() > 请求.数量预算)
                return 组读取失败(L2结构状态::数量预算不足, 守卫);
            std::vector<L2概念名称事实> 组;
            for (const auto& 关系 : 关系组.关系组) {
                if (关系.写入所有者 != 定位_.所有者
                    || 关系.源节点 != 请求.概念.值
                    || 关系.关系类型节点 != 定位_.概念端点关系类型)
                    return 组读取失败(L2结构状态::内部不一致, 守卫);
                const auto 候选 = 读取历史名称核心(第一层服务_, 定位_,
                    L2概念名称关系身份{关系.目标节点}, 守卫, 守卫, true);
                if (候选.状态 != L2结构状态::已读取 || !候选.事实
                    || 候选.事实->概念关系编码 != 关系.编码
                    || 候选.事实->公开事实.概念 != 请求.概念)
                    return 组读取失败(L2结构状态::内部不一致, 守卫);
                组.push_back(候选.事实->公开事实);
            }
            const auto [后状态, 后代次] = 读取当前事实代次(第一层服务_);
            if (后状态 != L2结构状态::已读取)
                return 组读取失败(后状态, 后代次);
            if (后代次 != 守卫)
                return 组读取失败(L2结构状态::事实代次漂移, 后代次);
            std::sort(组.begin(), 组.end(), 正向组序更小);
            for (std::size_t 序 = 1; 序 < 组.size(); ++序)
                if (!正向组序更小(组[序 - 1], 组[序]))
                    return 组读取失败(L2结构状态::内部不一致, 守卫);
            L2概念名称组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 守卫, std::nullopt}, std::move(组)};
            return 结果.成功() ? 结果
                : 组读取失败(L2结构状态::内部不一致, 守卫);
        } catch (const std::bad_alloc&) {
            return 组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return 组读取失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：本地记录；反向组完整未过滤，只按词条端点当前目标关系组。
    L2概念名称组读取结果 按词条读取概念名称候选组(
        const L2按词条概念名称候选组读取请求& 请求) const {
        using namespace L2概念名称结构内部;
        if (!L2按词条概念名称候选组读取请求有效(请求))
            return 组读取失败(L2结构状态::入口拒绝);
        try {
            const auto 守卫 = 请求.请求头.期望事实代次;
            const auto [前状态, 前代次] = 读取当前事实代次(第一层服务_);
            if (前状态 != L2结构状态::已读取)
                return 组读取失败(前状态, 前代次);
            if (前代次 != 守卫)
                return 组读取失败(L2结构状态::事实代次漂移, 前代次);
            const auto 关系组 = 第一层服务_.读取所有者范围历史关系组(
                {L1所有者范围CRUD合同版本,
                    L1所有者范围关系端点方向::目标, 请求.词条.值,
                    定位_.词条端点关系类型, 守卫});
            if (关系组.状态 != L1所有者范围读取状态::成功
                || 关系组.合同版本 != L1所有者范围CRUD合同版本
                || 关系组.读取事实代次 != 守卫
                || 关系组.历史截止事实代次 != 守卫)
                return 组读取失败(
                    关系组.状态 == L1所有者范围读取状态::资源失败
                        ? L2结构状态::资源失败
                        : 映射读取状态(关系组.状态), 守卫);
            if (关系组.关系组.size() > 请求.数量预算)
                return 组读取失败(L2结构状态::数量预算不足, 守卫);
            std::vector<L2概念名称事实> 组;
            for (const auto& 关系 : 关系组.关系组) {
                if (关系.写入所有者 != 定位_.所有者
                    || 关系.目标节点 != 请求.词条.值
                    || 关系.关系类型节点 != 定位_.词条端点关系类型)
                    return 组读取失败(L2结构状态::内部不一致, 守卫);
                const auto 候选 = 读取历史名称核心(第一层服务_, 定位_,
                    L2概念名称关系身份{关系.源节点}, 守卫, 守卫, true);
                if (候选.状态 != L2结构状态::已读取 || !候选.事实
                    || 候选.事实->词条关系编码 != 关系.编码
                    || 候选.事实->公开事实.词条 != 请求.词条)
                    return 组读取失败(L2结构状态::内部不一致, 守卫);
                组.push_back(候选.事实->公开事实);
            }
            const auto [后状态, 后代次] = 读取当前事实代次(第一层服务_);
            if (后状态 != L2结构状态::已读取)
                return 组读取失败(后状态, 后代次);
            if (后代次 != 守卫)
                return 组读取失败(L2结构状态::事实代次漂移, 后代次);
            std::sort(组.begin(), 组.end(), 反向组序更小);
            for (std::size_t 序 = 1; 序 < 组.size(); ++序)
                if (!反向组序更小(组[序 - 1], 组[序]))
                    return 组读取失败(L2结构状态::内部不一致, 守卫);
            L2概念名称组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 守卫, std::nullopt}, std::move(组)};
            return 结果.成功() ? 结果
                : 组读取失败(L2结构状态::内部不一致, 守卫);
        } catch (const std::bad_alloc&) {
            return 组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return 组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return 组读取失败(L2结构状态::内部不一致);
        }
    }

private:
    // 诊断责任：向上送出；名称登记失败由公开构造函数继续送出。
    L2概念名称结构服务(const L1事实基座服务& 第一层服务,
        const L2概念结构服务& 概念服务,
        const L2语言结构服务& 语言服务, L1所有者范围写端口&& 端口)
        : 第一层服务_(第一层服务), 概念服务_(概念服务),
          语言服务_(语言服务), 第一层写入端口_(std::move(端口)),
          定位_(L2概念名称结构内部::初始化概念名称登记(
              第一层服务_, 第一层写入端口_)) {}

    // 诊断责任：向上送出；交付必须有效且绑定同一 L1 实例。
    // owner 与语言、词条、概念 owner 两两不同由各自固定建立幂等身份
    // 经 L1 建立单射性保证；交付形成函数已强制核对建立身份与读回。
    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务, L2概念名称所有者交付& 交付) {
        if (!交付.写入端口_.有效()
            || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument(
                "L2 concept name owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    // 诊断责任：向上送出；首次新增材料唯一裁决原请求与原结果。
    L2概念名称写入结果 重放新增(const L2概念名称新增请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2概念名称结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果
            || 首次.写入幂等身份 != 映射幂等身份(请求.幂等身份))
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 期望 = 形成名称新增写集(
            请求.请求头.期望事实代次, 映射幂等身份(请求.幂等身份),
            定位_, 请求.概念, 请求.词条, 请求.角色, 请求.适用语言,
            请求.来源稳定编码);
        if (*首次.首次规范化写集 != 期望)
            return 写入失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 编码 = 取得新名称记录编码(首次结果);
        if (!编码 || 首次结果.事实代次 == 0)
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 读回 = 读取历史名称核心(第一层服务_, 定位_,
            L2概念名称关系身份{*编码}, 首次结果.事实代次,
            首次.读取事实代次, false);
        if (读回.状态 != L2结构状态::已读取 || !读回.事实
            || !名称内容匹配(读回.事实->公开事实, 请求.概念,
                请求.词条, 请求.角色, 请求.适用语言,
                请求.来源稳定编码))
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        L2概念名称写入结果 结果{{L2结构合同版本,
            L2结构状态::精确重复, 首次结果.事实代次,
            首次结果.事实代次}, std::move(读回.事实->公开事实),
            std::nullopt};
        return 结果.成功() ? 结果
            : 写入失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    // 诊断责任：向上送出；首次替换材料唯一裁决旧、新完整请求与原结果。
    L2概念名称写入结果 重放替换(const L2概念名称替换请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2概念名称结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果)
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 原旧 = 读取历史名称核心(第一层服务_, 定位_,
            请求.旧关系.名称关系, 请求.请求头.期望事实代次,
            首次.读取事实代次, true);
        if (原旧.状态 != L2结构状态::已读取 || !原旧.事实)
            return 写入失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        auto 期望 = 形成名称新增写集(请求.请求头.期望事实代次,
            映射幂等身份(请求.幂等身份), 定位_, 请求.新概念,
            请求.新词条, 请求.新角色, 请求.新适用语言,
            请求.新来源稳定编码);
        加入名称退出写集(期望, *原旧.事实);
        if (*首次.首次规范化写集 != 期望
            || 原旧.事实->公开事实 != 请求.旧关系)
            return 写入失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        const auto 新编码 = 取得新名称记录编码(首次结果);
        if (!新编码 || 首次结果.事实代次 == 0)
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 新读 = 读取历史名称核心(第一层服务_, 定位_,
            L2概念名称关系身份{*新编码}, 首次结果.事实代次,
            首次.读取事实代次, false);
        const auto 旧读 = 读取历史名称核心(第一层服务_, 定位_,
            请求.旧关系.名称关系, 首次结果.事实代次,
            首次.读取事实代次, false);
        if (新读.状态 != L2结构状态::已读取 || !新读.事实
            || 旧读.状态 != L2结构状态::已读取 || !旧读.事实
            || !名称内容匹配(新读.事实->公开事实, 请求.新概念,
                请求.新词条, 请求.新角色, 请求.新适用语言,
                请求.新来源稳定编码)
            || !名称内容匹配(旧读.事实->公开事实, 请求.旧关系.概念,
                请求.旧关系.词条, 请求.旧关系.角色,
                请求.旧关系.适用语言, 请求.旧关系.来源稳定编码))
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        L2概念名称写入结果 结果{{L2结构合同版本,
            L2结构状态::精确重复, 首次结果.事实代次,
            首次结果.事实代次}, std::move(新读.事实->公开事实),
            std::move(旧读.事实->公开事实)};
        return 结果.成功() ? 结果
            : 写入失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    // 诊断责任：向上送出；首次退出材料唯一裁决原请求与原退出投影。
    L2概念名称写入结果 重放退出(const L2概念名称退出请求& 请求,
        const L1所有者范围首次写入读取结果& 首次) const {
        using namespace L2概念名称结构内部;
        if (!首次.首次规范化写集 || !首次.首次写入结果)
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 原事实 = 读取历史名称核心(第一层服务_, 定位_,
            请求.关系.名称关系, 请求.请求头.期望事实代次,
            首次.读取事实代次, true);
        if (原事实.状态 != L2结构状态::已读取 || !原事实.事实)
            return 写入失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        L1所有者范围写集请求 期望;
        期望.合同版本 = L1所有者范围CRUD合同版本;
        期望.期望事实代次 = 请求.请求头.期望事实代次;
        期望.写入幂等身份 = 映射幂等身份(请求.幂等身份);
        加入名称退出写集(期望, *原事实.事实);
        if (*首次.首次规范化写集 != 期望
            || 原事实.事实->公开事实 != 请求.关系)
            return 写入失败(L2结构状态::幂等冲突, 首次.读取事实代次);
        const auto& 首次结果 = *首次.首次写入结果;
        if (!首次结果.新编码映射.empty() || 首次结果.事实代次 == 0)
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        const auto 读回 = 读取历史名称核心(第一层服务_, 定位_,
            请求.关系.名称关系, 首次结果.事实代次,
            首次.读取事实代次, false);
        if (读回.状态 != L2结构状态::已读取 || !读回.事实
            || !名称内容匹配(读回.事实->公开事实, 请求.关系.概念,
                请求.关系.词条, 请求.关系.角色, 请求.关系.适用语言,
                请求.关系.来源稳定编码))
            return 写入失败(
                L2结构状态::内部不一致, 首次.读取事实代次);
        L2概念名称写入结果 结果{{L2结构合同版本,
            L2结构状态::精确重复, 首次结果.事实代次,
            首次结果.事实代次}, std::nullopt,
            std::move(读回.事实->公开事实)};
        return 结果.成功() ? 结果
            : 写入失败(L2结构状态::内部不一致, 首次.读取事实代次);
    }

    const L1事实基座服务& 第一层服务_;
    const L2概念结构服务& 概念服务_;
    const L2语言结构服务& 语言服务_;
    L1所有者范围写端口 第一层写入端口_;
    L2概念名称结构内部::名称定位 定位_;
    std::mutex 写入锁_;
};

} // namespace 海中鱼巣
