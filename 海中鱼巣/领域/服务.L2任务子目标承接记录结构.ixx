module;

#include <algorithm>
#include <cstdint>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>

export module 海中鱼巣.领域.服务.L2任务子目标承接记录结构;

import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2动态结构;

export namespace 海中鱼巣 {

class L2任务子目标承接记录结构服务 final {
public:
    L2任务子目标承接记录结构服务(
        const L2任务结构服务& 任务服务,
        const L2需求结构服务& 需求服务,
        const L2方法结构服务& 方法服务,
        const L2状态结构服务& 状态服务,
        const L2特征结构服务& 特征服务,
        const L2动态结构服务& 动态服务,
        L2任务子目标承接记录写入端口&& 写入端口)
        : 任务服务_(任务服务), 需求服务_(需求服务), 方法服务_(方法服务),
          状态服务_(状态服务), 特征服务_(特征服务), 动态服务_(动态服务),
          写入端口_(验证并移动端口(写入端口)) {}

    L2任务子目标承接记录结构服务(
        const L2任务子目标承接记录结构服务&) = delete;
    L2任务子目标承接记录结构服务& operator=(
        const L2任务子目标承接记录结构服务&) = delete;
    L2任务子目标承接记录结构服务(
        L2任务子目标承接记录结构服务&&) = delete;
    L2任务子目标承接记录结构服务& operator=(
        L2任务子目标承接记录结构服务&&) = delete;

    L2任务子目标承接记录写入结果 新增任务子目标承接记录(
        L2新增任务子目标承接记录请求 请求) noexcept {
        if (!L2新增任务子目标承接记录请求有效(请求))
            return 失败写入(L2结构状态::入口拒绝);
        try {
            const auto 任务 = 任务服务_.读取任务(
                {请求.请求头, L2读取类别::当前, 请求.任务, 0});
            if (需要旧截止收敛(任务.结果头, 请求.请求头.期望事实代次))
                return 写入端口_.写入已验证新增记录(std::move(请求));
            if (!任务.成功() || !任务.任务)
                return 失败写入(映射外部非成功(任务.结果头),
                    任务.结果头.事实截止代次);
            const auto 虚拟存在 = 任务服务_.读取任务虚拟存在(
                {请求.请求头, L2读取类别::当前, 请求.任务, 0});
            if (需要旧截止收敛(虚拟存在.结果头, 请求.请求头.期望事实代次))
                return 写入端口_.写入已验证新增记录(std::move(请求));
            if (!虚拟存在.成功() || !虚拟存在.任务虚拟存在
                || 任务.任务->任务虚拟存在 != 请求.任务虚拟存在
                || 虚拟存在.任务虚拟存在->身份 != 请求.任务虚拟存在
                || 虚拟存在.任务虚拟存在->任务 != 请求.任务)
                return 失败写入(L2结构状态::引用冲突,
                    虚拟存在.结果头.事实截止代次);

            const auto 父成员 = 需求服务_.读取需求成员列表(
                {请求.请求头, L2读取类别::当前, 请求.父需求, 0});
            if (需要旧截止收敛(父成员.结果头, 请求.请求头.期望事实代次))
                return 写入端口_.写入已验证新增记录(std::move(请求));
            if (!父成员.成功() || !父成员.当前成员关系
                || 父成员.当前成员关系->需求 != 请求.父需求)
                return 失败写入(L2结构状态::引用冲突,
                    父成员.结果头.事实截止代次);
            const auto 父列表项 = 需求服务_.读取需求列表项完整(
                {请求.请求头, L2读取类别::当前,
                    父成员.当前成员关系->列表项, 0});
            const auto 父需求 = 需求服务_.读取需求完整(
                {请求.请求头, L2读取类别::当前, 请求.父需求, 0});
            if (需要旧截止收敛(父列表项.结果头, 请求.请求头.期望事实代次)
                || 需要旧截止收敛(父需求.结果头, 请求.请求头.期望事实代次))
                return 写入端口_.写入已验证新增记录(std::move(请求));
            if (!父列表项.成功() || !父列表项.列表项
                || !父需求.成功() || !父需求.需求
                || 父列表项.列表项->身份 != 任务.任务->需求列表项
                || 父成员.当前成员关系->列表项 != 父列表项.列表项->身份
                || 父需求.需求->所属存在 != 父列表项.列表项->所属存在)
                return 失败写入(L2结构状态::引用冲突,
                    请求.请求头.期望事实代次);

            const auto 方法 = 方法服务_.读取普通方法(
                {请求.请求头, L2普通方法结构合同版本,
                    L2读取类别::当前, 请求.来源.方法, 0});
            if (需要旧截止收敛(方法.结果头, 请求.请求头.期望事实代次))
                return 写入端口_.写入已验证新增记录(std::move(请求));
            if (!方法.成功() || !方法.方法
                || 方法.方法->内容版本 != 请求.来源.方法内容版本
                || 方法.方法->规格版本 != 请求.来源.方法规格版本)
                return 失败写入(L2结构状态::引用冲突,
                    方法.结果头.事实截止代次);
            const auto 条件位置 = std::find_if(方法.方法->条件.begin(),
                方法.方法->条件.end(), [&](const auto& 条件) {
                    return 条件.身份 == 请求.来源.条件;
                });
            const auto 结果位置 = std::find_if(方法.方法->结果.begin(),
                方法.方法->结果.end(), [&](const auto& 结果) {
                    return 结果.身份 == 请求.来源.主轴结果;
                });
            const auto 关系位置 = std::find_if(方法.方法->条件结果关系.begin(),
                方法.方法->条件结果关系.end(), [&](const auto& 关系) {
                    return 关系.条件 == 请求.来源.条件
                        && 关系.结果 == 请求.来源.主轴结果;
                });
            if (条件位置 == 方法.方法->条件.end()
                || 结果位置 == 方法.方法->结果.end()
                || 关系位置 == 方法.方法->条件结果关系.end()
                || 条件位置->作用对象角色 != 请求.来源.作用对象角色
                || 条件位置->场景 != 请求.子目标.条件场景
                || 条件位置->特征定义 != 请求.子目标.目标特征
                || 条件位置->条件状态合同 != 请求.子目标.目标状态合同
                || 条件位置->来源稳定编码 != 请求.来源.条件来源稳定编码
                || 结果位置->作用对象角色 != 请求.来源.作用对象角色
                || 结果位置->特征定义 != 请求.子目标.目标特征)
                return 失败写入(L2结构状态::引用冲突,
                    方法.结果头.事实截止代次);
            return 写入端口_.写入已验证新增记录(std::move(请求));
        } catch (const std::bad_alloc&) {
            return 失败写入(L2结构状态::资源失败);
        } catch (...) {
            return 失败写入(L2结构状态::内部不一致);
        }
    }

    L2任务子目标承接记录写入结果 绑定任务子目标承接记录子需求(
        L2绑定任务子目标承接记录子需求请求 请求) noexcept {
        if (!L2绑定任务子目标承接记录子需求请求有效(请求))
            return 失败写入(L2结构状态::入口拒绝);
        try {
            const auto 记录读取 = 读取任务子目标承接记录(
                {请求.请求头, L2读取类别::当前, 请求.记录, 0});
            if (需要旧截止收敛(记录读取.结果头, 请求.请求头.期望事实代次))
                return 写入端口_.写入已验证绑定子需求(std::move(请求));
            if (!记录读取.成功() || !记录读取.记录)
                return 失败写入(映射外部非成功(记录读取.结果头),
                    记录读取.结果头.事实截止代次);
            const auto 验证 = 验证子需求成员链(*记录读取.记录, 请求.子需求,
                请求.请求头);
            if (验证 != L2结构状态::已读取)
                return 失败写入(验证, 请求.请求头.期望事实代次);
            return 写入端口_.写入已验证绑定子需求(std::move(请求));
        } catch (const std::bad_alloc&) {
            return 失败写入(L2结构状态::资源失败);
        } catch (...) {
            return 失败写入(L2结构状态::内部不一致);
        }
    }

    L2任务子目标承接记录写入结果 登记任务子目标承接记录回流(
        L2登记任务子目标承接记录回流请求 请求) noexcept {
        if (!L2登记任务子目标承接记录回流请求有效(请求))
            return 失败写入(L2结构状态::入口拒绝);
        try {
            const auto 记录读取 = 读取任务子目标承接记录(
                {请求.请求头, L2读取类别::当前, 请求.记录, 0});
            if (需要旧截止收敛(记录读取.结果头, 请求.请求头.期望事实代次))
                return 写入端口_.写入已验证登记回流(std::move(请求));
            if (!记录读取.成功() || !记录读取.记录)
                return 失败写入(映射外部非成功(记录读取.结果头),
                    记录读取.结果头.事实截止代次);
            const auto 验证 = 验证子需求成员链(*记录读取.记录, 请求.子需求,
                请求.请求头);
            if (验证 != L2结构状态::已读取)
                return 失败写入(验证, 请求.请求头.期望事实代次);
            const auto 状态 = 状态服务_.读取完整状态(
                {请求.请求头, L2读取类别::当前, 请求.回流.实际状态, 0});
            if (!状态.状态 || 状态.结果头.状态 != L2结构状态::已读取
                || 状态.状态->主体存在 != 记录读取.记录->子目标.目标宿主)
                return 失败写入(L2结构状态::引用冲突,
                    状态.结果头.事实截止代次);
            const auto 特征 = 特征服务_.读取完整特征实例(
                {请求.请求头, L2读取类别::当前, 状态.状态->特征实例, 0});
            if (!特征.特征实例 || 特征.结果头.状态 != L2结构状态::已读取
                || 特征.特征实例->宿主存在 != 记录读取.记录->子目标.目标宿主
                || 特征.特征实例->特征定义 != 记录读取.记录->子目标.目标特征)
                return 失败写入(L2结构状态::引用冲突,
                    特征.结果头.事实截止代次);
            if (请求.回流.动态证据) {
                const auto 动态 = 动态服务_.读取完整动态(
                    {请求.请求头, L2读取类别::当前, *请求.回流.动态证据, 0});
                if (!动态.动态 || 动态.结果头.状态 != L2结构状态::已读取
                    || 动态.动态->主体存在 != 记录读取.记录->子目标.目标宿主
                    || 动态.动态->后状态 != 请求.回流.实际状态)
                    return 失败写入(L2结构状态::引用冲突,
                        动态.结果头.事实截止代次);
            }
            if (请求.回流.子需求承接任务) {
                const auto 子任务 = 任务服务_.读取任务({请求.请求头,
                    L2读取类别::当前, *请求.回流.子需求承接任务, 0});
                const auto 成员 = 需求服务_.读取需求成员列表({请求.请求头,
                    L2读取类别::当前, 请求.子需求, 0});
                if (!子任务.成功() || !子任务.任务 || !成员.当前成员关系
                    || 子任务.任务->需求列表项 != 成员.当前成员关系->列表项)
                    return 失败写入(L2结构状态::引用冲突,
                        请求.请求头.期望事实代次);
            }
            return 写入端口_.写入已验证登记回流(std::move(请求));
        } catch (const std::bad_alloc&) {
            return 失败写入(L2结构状态::资源失败);
        } catch (...) {
            return 失败写入(L2结构状态::内部不一致);
        }
    }

    L2任务子目标承接记录写入结果 退出任务子目标承接记录(
        L2退出任务子目标承接记录请求 请求) noexcept {
        if (!L2退出任务子目标承接记录请求有效(请求))
            return 失败写入(L2结构状态::入口拒绝);
        const auto 记录 = 读取任务子目标承接记录(
            {请求.请求头, L2读取类别::当前, 请求.记录, 0});
        if (需要旧截止收敛(记录.结果头, 请求.请求头.期望事实代次))
            return 写入端口_.写入已验证退出记录(std::move(请求));
        if (!记录.成功())
            return 失败写入(映射外部非成功(记录.结果头),
                记录.结果头.事实截止代次);
        return 写入端口_.写入已验证退出记录(std::move(请求));
    }

    L2任务子目标承接记录读取结果 读取任务子目标承接记录(
        L2任务子目标承接记录读取请求 请求) const noexcept {
        return 任务服务_.读取任务子目标承接记录已验证投影(std::move(请求));
    }

    L2按任务轮次读取子目标承接记录组结果
    按任务轮次读取子目标承接记录组(
        L2按任务轮次读取子目标承接记录组请求 请求) const noexcept {
        return 任务服务_.按任务轮次读取子目标承接记录组已验证投影(
            std::move(请求));
    }

private:
    static L2任务子目标承接记录写入端口&& 验证并移动端口(
        L2任务子目标承接记录写入端口& 端口) {
        if (!端口.有效())
            throw std::runtime_error("L2 task subgoal record port invalid");
        return std::move(端口);
    }

    static L2任务子目标承接记录写入结果 失败写入(
        L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
        L2任务子目标承接记录写入结果 结果;
        结果.结果头 = {L2结构合同版本, 状态, 截止, std::nullopt};
        return 结果;
    }

    static bool 需要旧截止收敛(
        const L2结构结果头& 结果头, std::uint64_t 期望截止) noexcept {
        return 结果头.状态 == L2结构状态::事实代次漂移
            || (结果头.状态 == L2结构状态::已读取
                && 结果头.事实截止代次 != 期望截止);
    }

    static L2结构状态 映射外部非成功(
        const L2结构结果头& 结果头) noexcept {
        if (结果头.状态 == L2结构状态::已读取)
            return L2结构状态::内部不一致;
        return 结果头.状态;
    }

    L2结构状态 验证子需求成员链(
        const L2任务子目标承接记录事实& 记录,
        L2需求身份 子需求, L2结构请求头 请求头) const {
        const auto 子完整 = 需求服务_.读取需求完整(
            {请求头, L2读取类别::当前, 子需求, 0});
        const auto 父完整 = 需求服务_.读取需求完整(
            {请求头, L2读取类别::当前, 记录.父需求, 0});
        const auto 父关系 = 需求服务_.按子需求读取当前父需求(
            {请求头, 子需求});
        if (!子完整.成功() || !子完整.需求 || !父完整.成功()
            || !父完整.需求 || !父关系.成功() || !父关系.当前父关系
            || 父关系.当前父关系->子需求 != 子需求
            || 父关系.当前父关系->父需求 != 记录.父需求)
            return L2结构状态::引用冲突;
        const auto 成员 = 需求服务_.读取需求成员列表(
            {请求头, L2读取类别::当前, 子需求, 0});
        if (!成员.成功() || !成员.当前成员关系
            || 成员.当前成员关系->需求 != 子需求
            || !有效(成员.当前成员关系->列表项.值))
            return L2结构状态::内部不一致;
        const auto 列表项 = 需求服务_.读取需求列表项完整(
            {请求头, L2读取类别::当前, 成员.当前成员关系->列表项, 0});
        if (!列表项.成功() || !列表项.列表项
            || 列表项.列表项->身份 != 成员.当前成员关系->列表项)
            return L2结构状态::内部不一致;
        const auto& 子 = *子完整.需求;
        const auto& 项 = *列表项.列表项;
        if (子.所属存在 != 项.所属存在
            || 子.目标宿主存在 != 项.目标宿主存在
            || 子.目标特征定义 != 项.目标特征定义
            || 子.目标状态合同 != 项.目标状态合同)
            return L2结构状态::内部不一致;
        if (子.所属存在 != 父完整.需求->所属存在
            || 子.目标宿主存在 != 记录.子目标.目标宿主
            || 子.目标特征定义 != 记录.子目标.目标特征
            || 子.目标状态合同 != 记录.子目标.目标状态合同)
            return L2结构状态::引用冲突;
        return L2结构状态::已读取;
    }

    const L2任务结构服务& 任务服务_;
    const L2需求结构服务& 需求服务_;
    const L2方法结构服务& 方法服务_;
    const L2状态结构服务& 状态服务_;
    const L2特征结构服务& 特征服务_;
    const L2动态结构服务& 动态服务_;
    L2任务子目标承接记录写入端口 写入端口_;
};

} // namespace 海中鱼巣
