inline constexpr std::uint32_t 状态上下文关系类型本地键值 = 0x0204'0501U;

struct 状态上下文关系类型定位 final {
    稳定编码 关系类型{};
    std::uint64_t 建立事实代次 = 0;
};

// 诊断责任：向上送出；固定登记恢复只复用 L1 首次请求的原 G0。
std::uint64_t 读取固定登记期望代次(const L1事实基座服务& L1,
    L1所有者范围写端口& 端口,
    L1所有者范围写入幂等身份 幂等身份) {
    const auto 首次 = 端口.读取首次写入材料(
        {L1所有者范围首次写入读取合同版本, 幂等身份});
    if (首次.状态 == L1所有者范围读取状态::成功) {
        if (!首次.首次规范化写集 || !首次.首次写入结果
            || 首次.所有者 != 端口.所有者身份()
            || 首次.写入幂等身份 != 幂等身份
            || 首次.首次规范化写集->写入幂等身份 != 幂等身份
            || 首次.首次规范化写集->期望事实代次 == 0
            || 首次.首次写入结果->所有者 != 端口.所有者身份()
            || 首次.首次写入结果->写入幂等身份 != 幂等身份
            || 首次.首次写入结果->事实代次 == 0)
            throw std::runtime_error("L2 state fixed registration first material invalid");
        return 首次.首次规范化写集->期望事实代次;
    }
    if (首次.状态 != L1所有者范围读取状态::未找到)
        throw std::runtime_error("L2 state fixed registration first read failed");
    const auto 代次 = L1.读取中性当前事实代次({L1中性CRUD合同版本});
    if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
        throw std::runtime_error("L2 state fixed registration generation failed");
    return 代次.事实代次;
}

状态上下文关系类型定位 初始化状态上下文关系类型(
    const L1事实基座服务& L1, L1所有者范围写端口& 端口) {
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 读取固定登记期望代次(
        L1, 端口, 状态上下文关系类型登记幂等身份);
    写集.写入幂等身份 = 状态上下文关系类型登记幂等身份;
    写集.节点 = {{{状态上下文关系类型本地键值},
        节点种类::普通, std::nullopt}};
    const auto 写入 = 端口.提交所有者范围中性写集(写集);
    if ((写入.状态 != L1所有者范围写入状态::成功
            && 写入.状态 != L1所有者范围写入状态::精确重复)
        || 写入.新编码映射.size() != 1
        || 写入.新编码映射.front().first.值
            != 状态上下文关系类型本地键值
        || !有效(写入.新编码映射.front().second)
        || 写入.事实代次 == 0)
        throw std::runtime_error("L2 state context relation registration failed");
    const auto 节点 = L1.读取所有者范围当前节点({
        L1所有者范围CRUD合同版本, 写入.新编码映射.front().second});
    const auto* 节点事实 = 节点.事实
        ? std::get_if<L1所有者范围节点事实>(&*节点.事实) : nullptr;
    if (节点.状态 != L1所有者范围读取状态::成功 || !节点事实
        || 节点事实->编码 != 写入.新编码映射.front().second
        || 节点事实->种类 != 节点种类::普通
        || 节点事实->退出事实代次)
        throw std::runtime_error("L2 state context relation readback failed");
    return {写入.新编码映射.front().second, 节点事实->创建事实代次};
}

struct 状态身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

L1所有者范围写入幂等身份 映射状态结构类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(状态结构类型登记幂等域 << 56) | 身份.值};
}

L1所有者范围写入幂等身份 映射状态当前选择关系类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(状态当前选择关系类型登记幂等域 << 56) | 身份.值};
}

L1所有者范围写入幂等身份 映射状态幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

L1所有者范围写入幂等身份 映射目标状态合同幂等键(
    L2结构幂等身份 身份) noexcept {
    return {身份.值 * 目标状态合同写入幂等乘数};
}

L1所有者范围原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1所有者范围独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2原始值材料 转换为L2材料(const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1所有者范围独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2结构状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::未找到: return L2结构状态::未找到;
    case L1所有者范围写入状态::已退出: return L2结构状态::已退出;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射一致读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射当前项目状态(
    L1所有者范围一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史关系组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史属性组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射来源值组读取失败状态(
    L1所有者范围来源当前值组读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围来源当前值组读取状态::入口拒绝:
        return L2结构状态::入口拒绝;
    case L1所有者范围来源当前值组读取状态::未找到:
        return L2结构状态::未找到;
    case L1所有者范围来源当前值组读取状态::已退出:
        return L2结构状态::已退出;
    case L1所有者范围来源当前值组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围来源当前值组读取状态::数量预算不足:
        return L2结构状态::数量预算不足;
    case L1所有者范围来源当前值组读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围来源当前值组读取状态::成功:
    case L1所有者范围来源当前值组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射属性类型值组读取失败状态(
    L1所有者范围属性类型当前值组读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围属性类型当前值组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围属性类型当前值组读取状态::数量预算不足:
        return L2结构状态::数量预算不足;
    case L1所有者范围属性类型当前值组读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围属性类型当前值组读取状态::成功:
    case L1所有者范围属性类型当前值组读取状态::入口拒绝:
    case L1所有者范围属性类型当前值组读取状态::未找到:
    case L1所有者范围属性类型当前值组读取状态::已退出:
    case L1所有者范围属性类型当前值组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2状态结构类型登记状态 映射登记写入状态(
    L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2状态结构类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2状态结构类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2状态结构类型登记状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2状态结构类型登记状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2状态结构类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2状态结构类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2状态结构类型登记状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::引用冲突:
    case L1所有者范围写入状态::内部不一致:
        return L2状态结构类型登记状态::内部不一致;
    }
    return L2状态结构类型登记状态::内部不一致;
}

L2状态结构类型登记状态 映射登记读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2状态结构类型登记状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2状态结构类型登记状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2状态结构类型登记状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2状态结构类型登记状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2状态结构类型登记状态::内部不一致;
    }
    return L2状态结构类型登记状态::内部不一致;
}

L2结构状态 映射登记失败为结构状态(
    L2状态结构类型登记状态 状态) noexcept {
    switch (状态) {
    case L2状态结构类型登记状态::登记未加载:
    case L2状态结构类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2状态结构类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2状态结构类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2状态结构类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2状态结构类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2状态结构类型登记状态::已提交:
    case L2状态结构类型登记状态::精确重复:
    case L2状态结构类型登记状态::已读取:
    case L2状态结构类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2状态结构类型登记结果 形成登记失败(
    L2状态结构类型登记状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {状态, 截止, std::nullopt};
}

L2状态写入结果 形成写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

L2状态首态操作状态_v2 映射首态操作状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::已提交: return L2状态首态操作状态_v2::已提交;
    case L2结构状态::精确重复: return L2状态首态操作状态_v2::精确重复;
    case L2结构状态::入口拒绝: return L2状态首态操作状态_v2::入口拒绝;
    case L2结构状态::许可拒绝: return L2状态首态操作状态_v2::许可拒绝;
    case L2结构状态::事实代次漂移:
        return L2状态首态操作状态_v2::事实代次漂移;
    case L2结构状态::幂等冲突: return L2状态首态操作状态_v2::幂等冲突;
    case L2结构状态::引用冲突: return L2状态首态操作状态_v2::引用冲突;
    case L2结构状态::资源失败: return L2状态首态操作状态_v2::资源失败;
    default: return L2状态首态操作状态_v2::内部不一致;
    }
}

L2状态首态结果_v2 形成首态失败_v2(
    L2结构状态 公共状态, L2状态首态操作状态_v2 操作状态,
    std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 公共状态, 截止, 变更},
        L2状态首态专属合同版本_v2, 操作状态,
        std::nullopt, std::nullopt, std::nullopt};
}

L2状态当前选择读取状态 映射当前选择读取状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::入口拒绝: return L2状态当前选择读取状态::入口拒绝;
    case L2结构状态::许可拒绝: return L2状态当前选择读取状态::许可拒绝;
    case L2结构状态::事实代次漂移:
        return L2状态当前选择读取状态::事实代次漂移;
    case L2结构状态::资源失败: return L2状态当前选择读取状态::资源失败;
    default: return L2状态当前选择读取状态::内部不一致;
    }
}

L2状态当前选择读取结果 形成当前选择读取失败(
    L2结构状态 公共状态, L2状态当前选择读取状态 读取状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 公共状态, 截止, std::nullopt},
        读取状态, std::nullopt, std::nullopt};
}

L2状态历史选择读取状态 映射历史选择读取状态(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::入口拒绝: return L2状态历史选择读取状态::入口拒绝;
    case L2结构状态::许可拒绝: return L2状态历史选择读取状态::许可拒绝;
    case L2结构状态::事实代次漂移:
        return L2状态历史选择读取状态::事实代次漂移;
    case L2结构状态::资源失败: return L2状态历史选择读取状态::资源失败;
    default: return L2状态历史选择读取状态::内部不一致;
    }
}

L2状态历史选择读取结果 形成历史选择读取失败(
    const L2状态历史选择读取请求& 请求, L2结构状态 公共状态,
    L2状态历史选择读取状态 读取状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 公共状态, 截止, std::nullopt}, 读取状态,
        请求.历史截止事实代次, std::nullopt, std::nullopt};
}

L2状态当前选择关系引用 形成当前选择关系引用(
    L1所有者范围关系事实 关系,
    L2状态当前选择关系类型身份 关系类型,
    std::uint64_t 截止) noexcept {
    if (关系.退出事实代次 && *关系.退出事实代次 > 截止)
        关系.退出事实代次.reset();
    return {关系.编码, L2特征实例身份{关系.源节点},
        L2状态身份{关系.目标节点}, 关系类型, 关系.角色或顺序,
        关系.写入所有者, {关系.创建事实代次, 关系.退出事实代次}};
}

L2状态完整读取结果 形成完整读取失败(
    const L2状态完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt, std::nullopt};
}

L2当前状态组读取结果 形成组读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, {}};
}

L2状态引用替换结果 形成引用替换失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt, std::nullopt};
}

L2状态值换代结果 形成值换代失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt, std::nullopt};
}

L2状态退出结果 形成状态退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt};
}

bool 写入成功边界完整(const L1所有者范围写入结果& 写入) noexcept {
    const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    return 写入.事实代次 != 0 && (首次 || 重复);
}

std::optional<L2状态关系退出事实> 形成关系退出事实(
    const L1所有者范围关系事实& 关系, std::uint64_t 退出代次) noexcept {
    L2状态关系退出事实 结果{关系.编码,
        {关系.创建事实代次, 关系.退出事实代次}};
    return L2状态关系退出事实完整(结果, 退出代次)
        ? std::optional<L2状态关系退出事实>{结果} : std::nullopt;
}

bool 历史关系匹配(const L1所有者范围关系事实& 关系,
    稳定编码 编码, 稳定编码 源, 稳定编码 目标, 稳定编码 类型,
    L1结构所有者身份 所有者, std::uint64_t 退出代次) noexcept {
    return 关系.编码 == 编码 && 关系.源节点 == 源 && 关系.目标节点 == 目标
        && 关系.关系类型节点 == 类型 && 关系.角色或顺序 == 状态端点角色值
        && 关系.写入所有者 == 所有者 && 关系.创建事实代次 != 0
        && 关系.创建事实代次 <= 退出代次
        && 关系.退出事实代次 == 退出代次;
}

bool 状态未改字段相同(const L2状态事实& 左, const L2状态事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.来源稳定编码 == 右.来源稳定编码
        && 左.生命周期 == 右.生命周期;
}

std::optional<稳定编码> 查找编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

std::array<稳定编码, 10> 基础登记编码组(
    const L2状态结构类型登记& 登记) noexcept {
    return {登记.主体关系类型.值, 登记.特征实例关系类型.值,
        登记.精确I64值类型.值, 登记.精确I64组值类型.值,
        登记.精确U64组值类型.值, 登记.精确独立材料值类型.值,
        登记.时间I64值类型.值, 登记.时间I64组值类型.值,
        登记.时间U64组值类型.值, 登记.时间独立材料值类型.值};
}

std::array<稳定编码, 11> 登记编码组(
    const L2状态结构类型登记& 登记) noexcept {
    return {登记.主体关系类型.值, 登记.特征实例关系类型.值,
        登记.当前选择关系类型.值, 登记.精确I64值类型.值,
        登记.精确I64组值类型.值, 登记.精确U64组值类型.值,
        登记.精确独立材料值类型.值, 登记.时间I64值类型.值,
        登记.时间I64组值类型.值, 登记.时间U64组值类型.值,
        登记.时间独立材料值类型.值};
}

std::optional<L2状态结构类型登记> 从写入形成登记(
    const L1所有者范围写入结果& 写入,
    const L1所有者范围写入结果& 当前选择写入,
    const L2状态结构类型登记请求& 请求) noexcept {
    if (写入.新编码映射.size() != 10
        || 当前选择写入.新编码映射.size() != 1) return std::nullopt;
    const auto 主体 = 查找编码映射(写入, 状态主体关系类型本地键值);
    const auto 实例 = 查找编码映射(写入, 状态特征实例关系类型本地键值);
    const auto 当前选择 = 查找编码映射(
        当前选择写入, 状态当前选择关系类型本地键值);
    const auto 精确I64 = 查找编码映射(写入, 状态精确I64值类型本地键值);
    const auto 精确I64组 = 查找编码映射(写入, 状态精确I64组值类型本地键值);
    const auto 精确U64组 = 查找编码映射(写入, 状态精确U64组值类型本地键值);
    const auto 精确独立 = 查找编码映射(写入, 状态精确独立材料值类型本地键值);
    const auto 时间I64 = 查找编码映射(写入, 状态时间I64值类型本地键值);
    const auto 时间I64组 = 查找编码映射(写入, 状态时间I64组值类型本地键值);
    const auto 时间U64组 = 查找编码映射(写入, 状态时间U64组值类型本地键值);
    const auto 时间独立 = 查找编码映射(写入, 状态时间独立材料值类型本地键值);
    if (!主体 || !实例 || !当前选择 || !精确I64 || !精确I64组 || !精确U64组
        || !精确独立 || !时间I64 || !时间I64组 || !时间U64组 || !时间独立)
        return std::nullopt;
    L2状态结构类型登记 登记;
    登记.首次期望事实代次 = 请求.请求头.期望事实代次;
    登记.建立事实代次 = 写入.事实代次;
    登记.事实截止代次 = 当前选择写入.事实代次;
    登记.主体关系类型 = L2状态主体关系类型身份{*主体};
    登记.特征实例关系类型 = L2状态特征实例关系类型身份{*实例};
    登记.当前选择关系类型 = L2状态当前选择关系类型身份{*当前选择};
    登记.精确I64值类型 = L2状态精确I64值类型身份{*精确I64};
    登记.精确I64组值类型 = L2状态精确I64组值类型身份{*精确I64组};
    登记.精确U64组值类型 = L2状态精确U64组值类型身份{*精确U64组};
    登记.精确独立材料值类型 = L2状态精确独立材料值类型身份{*精确独立};
    登记.时间I64值类型 = L2状态时间I64值类型身份{*时间I64};
    登记.时间I64组值类型 = L2状态时间I64组值类型身份{*时间I64组};
    登记.时间U64组值类型 = L2状态时间U64组值类型身份{*时间U64组};
    登记.时间独立材料值类型 = L2状态时间独立材料值类型身份{*时间独立};
    return L2状态结构类型登记完整(登记)
        ? std::optional<L2状态结构类型登记>{登记} : std::nullopt;
}

bool 登记节点历史完整(const L1事实基座服务& 第一层服务,
    稳定编码 编码, 节点种类 种类,
    std::optional<L1所有者范围值表示种类> 表示, std::uint64_t 建立代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    return 读取.状态 == L1所有者范围读取状态::成功
        && 读取.合同版本 == L1所有者范围CRUD合同版本
        && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
        && 节点->种类 == 种类 && 节点->属性类型表示 == 表示
        && 节点->创建事实代次 == 建立代次 && !节点->退出事实代次
        && 节点->当前属性.empty();
}

bool 登记历史完整(const L1事实基座服务& 第一层服务,
    const L2状态结构类型登记& 登记) {
    const auto 编码 = 基础登记编码组(登记);
    const std::array<std::optional<L1所有者范围值表示种类>, 10> 表示 = {
        std::nullopt, std::nullopt, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用};
    for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
        const auto 种类 = 索引 < 2 ? 节点种类::普通 : 节点种类::属性类型;
        if (!登记节点历史完整(
                第一层服务, 编码[索引], 种类, 表示[索引], 登记.建立事实代次))
            return false;
    }
    const auto 当前选择读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 登记.当前选择关系类型.值});
    const auto* 当前选择节点 = 当前选择读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*当前选择读取.事实) : nullptr;
    return 当前选择读取.状态 == L1所有者范围读取状态::成功
        && 当前选择节点
        && 当前选择节点->编码 == 登记.当前选择关系类型.值
        && 当前选择节点->种类 == 节点种类::普通
        && !当前选择节点->属性类型表示
        && 当前选择节点->创建事实代次 != 0
        && 当前选择节点->创建事实代次 <= 登记.事实截止代次
        && !当前选择节点->退出事实代次
        && 当前选择节点->当前属性.empty();
}

稳定编码 选择状态值类型编码(const L2状态结构类型登记& 登记,
    const L2原始值材料& 材料, bool 精确角色) noexcept {
    return std::visit([&](const auto& 值) noexcept -> 稳定编码 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, std::int64_t>)
            return 精确角色 ? 登记.精确I64值类型.值 : 登记.时间I64值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>)
            return 精确角色 ? 登记.精确I64组值类型.值 : 登记.时间I64组值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>)
            return 精确角色 ? 登记.精确U64组值类型.值 : 登记.时间U64组值类型.值;
        else return 精确角色 ? 登记.精确独立材料值类型.值
            : 登记.时间独立材料值类型.值;
    }, 材料);
}

bool 状态值类型与材料一致(const L2状态结构类型登记& 登记,
    稳定编码 类型编码, const L1所有者范围原始值材料& 材料, bool 精确角色) {
    return 选择状态值类型编码(登记, 转换为L2材料(材料), 精确角色)
        == 类型编码;
}

std::optional<L2属性事实> 形成截止属性事实(
    L1所有者范围值事实 值, const L2状态结构类型登记& 登记,
    std::uint64_t 截止, bool 精确角色) {
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    if (!状态值类型与材料一致(登记, 值.属性类型节点, 值.材料, 精确角色))
        return std::nullopt;
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

std::optional<L2状态事实> 形成状态事实(
    L1所有者范围节点事实 节点, L1所有者范围关系事实 主体关系,
    L1所有者范围关系事实 特征关系, L1所有者范围值事实 精确值,
    L1所有者范围值事实 时间值, const L2状态结构类型登记& 登记,
    std::uint64_t 截止) {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (主体关系.退出事实代次 && *主体关系.退出事实代次 > 截止)
        主体关系.退出事实代次.reset();
    if (特征关系.退出事实代次 && *特征关系.退出事实代次 > 截止)
        特征关系.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || !有效(主体关系.编码) || !有效(特征关系.编码)
        || 主体关系.编码 == 特征关系.编码
        || 主体关系.源节点 != 节点.编码 || 特征关系.源节点 != 节点.编码
        || 主体关系.关系类型节点 != 登记.主体关系类型.值
        || 特征关系.关系类型节点 != 登记.特征实例关系类型.值
        || 主体关系.角色或顺序 != 状态端点角色值
        || 特征关系.角色或顺序 != 状态端点角色值
        || 主体关系.创建事实代次 < 节点.创建事实代次
        || 特征关系.创建事实代次 < 节点.创建事实代次
        || 主体关系.创建事实代次 > 截止
        || 特征关系.创建事实代次 > 截止
        || 精确值.所属节点 != 节点.编码 || 时间值.所属节点 != 节点.编码
        || 精确值.创建事实代次 < 节点.创建事实代次
        || 时间值.创建事实代次 < 节点.创建事实代次
        || 精确值.创建事实代次 > 截止
        || 时间值.创建事实代次 > 截止)
        return std::nullopt;
    auto 精确属性 = 形成截止属性事实(精确值, 登记, 截止, true);
    auto 时间属性 = 形成截止属性事实(时间值, 登记, 截止, false);
    if (!精确属性 || !时间属性) return std::nullopt;
    L2状态事实 状态;
    状态.身份 = L2状态身份{节点.编码};
    状态.主体存在 = L2存在身份{主体关系.目标节点};
    状态.特征实例 = L2特征实例身份{特征关系.目标节点};
    状态.精确值 = std::move(*精确属性);
    状态.时间值 = std::move(*时间属性);
    状态.来源稳定编码 = 状态.精确值.来源稳定编码;
    状态.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return L2状态事实完整(状态, 登记, 截止)
        ? std::optional<L2状态事实>{std::move(状态)} : std::nullopt;
}

struct 一致读取顶层结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

一致读取顶层结果 解释一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取, std::uint64_t 期望) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望 && 读取.读取事实代次 == 期望
            && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次};
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    }
    const bool 空 = 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望 || !空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    return {映射一致读取失败状态(读取.状态), 读取.读取事实代次};
}

const L1所有者范围一致节点读取结果项* 查找唯一节点项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致源关系组读取结果项* 查找唯一源关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 源,
    稳定编码 类型) noexcept {
    const L1所有者范围一致源关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.源关系组) {
        if (项.源节点 != 源 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致目标关系组读取结果项* 查找唯一目标关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 目标,
    稳定编码 类型) noexcept {
    const L1所有者范围一致目标关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.目标关系组) {
        if (项.目标节点 != 目标 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致属性值读取结果项* 查找唯一属性项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 节点,
    稳定编码 类型) noexcept {
    const L1所有者范围一致属性值读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.属性值) {
        if (项.节点 != 节点 || 项.属性类型 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

bool 普通当前节点完整(const L1所有者范围节点事实& 节点,
    稳定编码 编码, std::uint64_t 截止) noexcept {
    return 节点.编码 == 编码 && 节点.种类 == 节点种类::普通
        && !节点.属性类型表示 && 节点.创建事实代次 != 0
        && 节点.创建事实代次 <= 截止 && !节点.退出事实代次;
}

L2结构状态 映射事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 检查端点结果头(const L2结构结果头& 结果头,
    std::uint64_t 期望) noexcept {
    if (结果头.状态 == L2结构状态::已读取) {
        return 结果头.事实截止代次 == 期望 && !结果头.变更事实代次
            ? L2结构状态::已读取 : L2结构状态::内部不一致;
    }
    if (结果头.变更事实代次) return L2结构状态::内部不一致;
    return 结果头.状态;
}

// 诊断责任：向上送出；来源登记任何结构化非成功都使服务构造失败。
状态身份来源定位 初始化状态身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 state owner fact is invalid");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读取.所有者事实->创建事实代次;
    写集.写入幂等身份 = 状态身份来源登记幂等身份;
    写集.节点 = {
        {{状态族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{状态族归属关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 状态身份来源登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 2)
        throw std::runtime_error("L2 state identity source initialization failed");
    稳定编码 锚点编码;
    稳定编码 类型编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) throw std::runtime_error("L2 state source mapping invalid");
        if (本地键.值 == 状态族锚点本地键值) 锚点编码 = 编码;
        else if (本地键.值 == 状态族归属关系类型本地键值) 类型编码 = 编码;
        else throw std::runtime_error("L2 state source mapping unknown");
    }
    if (!有效(锚点编码) || !有效(类型编码) || 锚点编码 == 类型编码)
        throw std::runtime_error("L2 state source mapping incomplete");
    const auto 核对节点 = [&](稳定编码 编码) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者 && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次 && !节点->退出事实代次;
    };
    if (!核对节点(锚点编码) || !核对节点(类型编码))
        throw std::runtime_error("L2 state source readback invalid");
    return {所有者, 锚点编码, 类型编码, 写入.事实代次};
}

L2目标状态合同结构类型登记状态 映射目标登记写入状态(
    L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功:
        return L2目标状态合同结构类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2目标状态合同结构类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝:
        return L2目标状态合同结构类型登记状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝:
        return L2目标状态合同结构类型登记状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2目标状态合同结构类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突:
        return L2目标状态合同结构类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败:
        return L2目标状态合同结构类型登记状态::资源失败;
    default: return L2目标状态合同结构类型登记状态::内部不一致;
    }
}

L2目标状态合同结构类型登记状态 映射目标登记读取状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2目标状态合同结构类型登记状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2目标状态合同结构类型登记状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2目标状态合同结构类型登记状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2目标状态合同结构类型登记状态::资源失败;
    default: return L2目标状态合同结构类型登记状态::内部不一致;
    }
}

L2结构状态 映射目标登记失败为结构状态(
    L2目标状态合同结构类型登记状态 状态) noexcept {
    switch (状态) {
    case L2目标状态合同结构类型登记状态::入口拒绝:
    case L2目标状态合同结构类型登记状态::登记未加载:
        return L2结构状态::入口拒绝;
    case L2目标状态合同结构类型登记状态::许可拒绝:
        return L2结构状态::许可拒绝;
    case L2目标状态合同结构类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2目标状态合同结构类型登记状态::幂等冲突:
        return L2结构状态::幂等冲突;
    case L2目标状态合同结构类型登记状态::资源失败:
        return L2结构状态::资源失败;
    default: return L2结构状态::内部不一致;
    }
}

L2目标状态合同结构类型登记结果 形成目标登记失败(
    L2目标状态合同结构类型登记状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {状态, 截止, std::nullopt};
}

L2目标状态合同新增结果 形成目标新增失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

L2目标状态合同替换结果 形成目标替换失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

L2目标状态合同退出结果 形成目标退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, std::nullopt};
}

L2目标状态合同完整读取结果 形成目标读取失败(
    const L2目标状态合同完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt};
}

std::array<稳定编码, 4> 目标登记编码组(
    const L2目标状态合同结构类型登记& 登记) noexcept {
    return {登记.特征定义关系类型.值, 登记.比较注册关系类型.值,
        登记.I64值类型.值, 登记.U64合同属性类型.值};
}

std::optional<L2目标状态合同结构类型登记> 从写入形成目标登记(
    const L1所有者范围写入结果& 写入,
    const L2目标状态合同结构类型登记请求& 请求) noexcept {
    L2目标状态合同结构类型登记 登记;
    登记.合同版本 = 请求.请求头.合同版本;
    登记.规则版本 = 请求.规则版本;
    登记.首次幂等身份 = 请求.幂等身份;
    登记.首次期望事实代次 = 请求.请求头.期望事实代次;
    登记.建立事实代次 = 写入.事实代次;
    登记.事实截止代次 = 写入.事实代次;
    for (const auto& [键, 编码] : 写入.新编码映射) {
        if (键.值 == 目标状态特征定义关系类型本地键值)
            登记.特征定义关系类型 = L2目标状态特征定义关系类型身份{编码};
        else if (键.值 == 目标状态比较注册关系类型本地键值)
            登记.比较注册关系类型 = L2目标状态比较注册关系类型身份{编码};
        else if (键.值 == 目标状态I64值类型本地键值)
            登记.I64值类型 = L2目标状态I64值类型身份{编码};
        else if (键.值 == 目标状态U64合同属性类型本地键值)
            登记.U64合同属性类型 = L2目标状态U64合同属性类型身份{编码};
        else return std::nullopt;
    }
    return L2目标状态合同结构类型登记完整(登记)
        ? std::optional<L2目标状态合同结构类型登记>{登记} : std::nullopt;
}

bool 目标登记历史完整(const L1事实基座服务& 第一层服务,
    const L2目标状态合同结构类型登记& 登记,
    L1结构所有者身份 所有者) {
    const auto 编码组 = 目标登记编码组(登记);
    for (std::size_t 索引 = 0; 索引 < 编码组.size(); ++索引) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码组[索引]});
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        const auto 表示 = 索引 < 2 ? std::optional<L1所有者范围值表示种类>{}
            : 索引 == 2
                ? std::optional<L1所有者范围值表示种类>{
                    L1所有者范围值表示种类::I64}
                : std::optional<L1所有者范围值表示种类>{
                    L1所有者范围值表示种类::U64组};
        const auto 种类 = 索引 < 2 ? 节点种类::普通 : 节点种类::属性类型;
        if (读取.状态 != L1所有者范围读取状态::成功 || !节点
            || 节点->编码 != 编码组[索引] || 节点->写入所有者 != 所有者
            || 节点->种类 != 种类 || 节点->属性类型表示 != 表示
            || 节点->创建事实代次 != 登记.建立事实代次
            || 节点->退出事实代次 || !节点->当前属性.empty()) return false;
    }
    return true;
}

std::vector<std::uint64_t> 编码目标状态合同材料(
    std::uint8_t 允许关系位, L2结构幂等身份 幂等身份,
    std::uint64_t 首次期望事实代次) {
    return {L2结构合同版本, L2目标状态合同规则版本,
        static_cast<std::uint64_t>(L2特征比较用途::目标判断),
        允许关系位, 幂等身份.值, 首次期望事实代次};
}

bool 目标判断比较注册符合合同(const L2特征比较注册事实& 注册,
    L2特征定义身份 特征定义, L2特征比较注册身份 比较注册) noexcept {
    const auto& 合同 = 注册.合同;
    const auto 具名关系位 = static_cast<std::uint8_t>(
        L2特征比较结果要求::具名关系);
    return 注册.身份 == 比较注册 && 注册.特征定义 == 特征定义
        && 合同.用途 == L2特征比较用途::目标判断
        && 合同.算法族 == L2特征比较算法族::标量有序比较与安全差异
        && 合同.原始类型 == L2特征比较原始类型::I64
        && 合同.左角色 == L2特征比较角色::当前事实
        && 合同.右角色 == L2特征比较角色::目标状态
        && 合同.差异方向 == L2特征比较方向::右减左
        && (合同.允许结果位 & 具名关系位) != 0;
}

std::optional<L2目标状态合同事实> 形成目标状态合同事实(
    const L1所有者范围节点事实& 合同节点,
    const L1所有者范围关系事实& 特征关系,
    const L1所有者范围关系事实& 比较关系,
    const L1所有者范围值事实& 目标值,
    const L1所有者范围值事实& 合同值,
    const L2目标状态合同结构类型登记& 类型,
    L1结构所有者身份 所有者, std::uint64_t 截止,
    bool 保留退出 = false) {
    const auto* I64 = std::get_if<std::int64_t>(&目标值.材料);
    const auto* U64 = std::get_if<std::vector<std::uint64_t>>(&合同值.材料);
    if (!I64 || !U64 || U64->size() != 6
        || (*U64)[0] != L2结构合同版本
        || (*U64)[1] != L2目标状态合同规则版本
        || (*U64)[2] != static_cast<std::uint64_t>(L2特征比较用途::目标判断)
        || (*U64)[3] > 0xffULL) return std::nullopt;
    if (!保留退出) {
        if (合同节点.退出事实代次 || 特征关系.退出事实代次
            || 比较关系.退出事实代次 || 目标值.退出事实代次
            || 合同值.退出事实代次) return std::nullopt;
    } else if (特征关系.退出事实代次 != 合同节点.退出事实代次
        || 比较关系.退出事实代次 != 合同节点.退出事实代次
        || 目标值.退出事实代次 != 合同节点.退出事实代次
        || 合同值.退出事实代次 != 合同节点.退出事实代次) return std::nullopt;
    if (合同节点.写入所有者 != 所有者 || 合同节点.种类 != 节点种类::普通
        || 合同节点.属性类型表示 || 特征关系.写入所有者 != 所有者
        || 比较关系.写入所有者 != 所有者 || 目标值.写入所有者 != 所有者
        || 合同值.写入所有者 != 所有者
        || 特征关系.源节点 != 合同节点.编码
        || 比较关系.源节点 != 合同节点.编码
        || 特征关系.关系类型节点 != 类型.特征定义关系类型.值
        || 比较关系.关系类型节点 != 类型.比较注册关系类型.值
        || 特征关系.角色或顺序 != 目标状态端点角色值
        || 比较关系.角色或顺序 != 目标状态端点角色值
        || 目标值.所属节点 != 合同节点.编码
        || 合同值.所属节点 != 合同节点.编码
        || 目标值.属性类型节点 != 类型.I64值类型.值
        || 合同值.属性类型节点 != 类型.U64合同属性类型.值
        || 目标值.来源节点 != 合同值.来源节点
        || 合同节点.创建事实代次 != 特征关系.创建事实代次
        || 合同节点.创建事实代次 != 比较关系.创建事实代次
        || 合同节点.创建事实代次 != 目标值.创建事实代次
        || 合同节点.创建事实代次 != 合同值.创建事实代次)
        return std::nullopt;
    auto 投影退出 = 合同节点.退出事实代次;
    if (投影退出 && *投影退出 > 截止) 投影退出.reset();
    L2目标状态合同事实 事实;
    事实.身份 = L2目标状态合同身份{合同节点.编码};
    事实.特征定义 = L2特征定义身份{特征关系.目标节点};
    事实.比较注册 = L2特征比较注册身份{比较关系.目标节点};
    事实.比较用途 = L2特征比较用途::目标判断;
    事实.目标I64 = *I64;
    事实.允许关系位 = static_cast<std::uint8_t>((*U64)[3]);
    事实.规则版本 = L2目标状态合同规则版本;
    事实.首次幂等身份 = L2结构幂等身份{(*U64)[4]};
    事实.首次期望事实代次 = (*U64)[5];
    事实.来源稳定编码 = 目标值.来源节点;
    事实.特征定义关系稳定编码 = 特征关系.编码;
    事实.比较注册关系稳定编码 = 比较关系.编码;
    事实.目标值稳定编码 = 目标值.编码;
    事实.合同值稳定编码 = 合同值.编码;
    事实.生命周期 = {合同节点.创建事实代次, 投影退出};
    return L2目标状态合同事实完整(事实, 截止)
        ? std::optional<L2目标状态合同事实>{事实} : std::nullopt;
}

} // namespace 海中鱼巣::L2状态结构内部

export namespace 海中鱼巣 {

std::optional<L2状态所有者交付> 尝试形成L2状态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 状态所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务)) return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2状态所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

bool L2中性状态上下文读取结果_v1::成功() const noexcept {
    if (结果头.合同版本 != L2中性状态动态合同版本_v1
        || 结果头.状态 != L2中性结构状态_v1::已读取
        || 结果头.事实截止代次 == 0 || 结果头.变更事实代次
        || !上下文 || !有效(上下文->状态.值)
        || !有效(上下文->主体存在.值) || !有效(上下文->共同场景.值)
        || !有效(上下文->特征实例.值) || !有效(上下文->来源存在.值)
        || !有效(上下文->主体关系稳定编码)
        || !有效(上下文->场景关系稳定编码)
        || !有效(上下文->特征实例关系稳定编码)
        || !有效(上下文->来源存在关系稳定编码)
        || 上下文->生命周期.创建事实代次 == 0
        || 上下文->生命周期.创建事实代次 > 结果头.事实截止代次)
        return false;
    if (读取类别 == L2读取类别::当前)
        return 历史截止事实代次 == 0
            && !上下文->生命周期.退出事实代次;
    return 读取类别 == L2读取类别::历史
        && 历史截止事实代次 != 0
        && 历史截止事实代次 <= 结果头.事实截止代次;
}

class L2状态结构服务 final {
public:
    explicit L2状态结构服务(const L1事实基座服务& L1,
        const L2存在结构服务& 存在服务,
        L2特征结构服务& 特征服务,
        L2状态所有者交付&& 状态所有者交付,
        L2中性实例材料保留策略_v1 保留策略 =
            L2中性实例材料默认保留策略_v1)
        : L1_(L1), 存在服务_(存在服务), 特征服务_(特征服务),
          第一层写入端口_(验证并移动交付(L1, 状态所有者交付)),
          状态身份来源定位_(L2状态结构内部::初始化状态身份来源(
              L1_, 第一层写入端口_)),
          中性状态提供者_(L1_, 第一层写入端口_, 状态身份来源定位_,
              结构类型登记定位_,
              状态上下文关系类型定位_, 保留策略) {
        const auto 状态类型幂等 =
            L2状态结构内部::映射状态结构类型登记幂等键({1});
        const auto 登记 = 建立状态结构类型登记(
            {{L2结构合同版本,
                L2状态结构内部::读取固定登记期望代次(
                    L1_, 第一层写入端口_, 状态类型幂等)},
                L2状态结构类型登记规则版本, L2结构幂等身份{1}});
        if (!登记.成功()) throw std::runtime_error("L2 state type registration failed");
        const auto 目标登记 = 建立目标状态合同结构类型登记(
            {{L2结构合同版本,
                L2状态结构内部::读取固定登记期望代次(
                    L1_, 第一层写入端口_,
                    L2状态结构内部::目标状态合同结构类型登记固定幂等身份)},
                L2目标状态合同结构类型登记规则版本, L2结构幂等身份{1}});
        if (!目标登记.成功())
            throw std::runtime_error("L2 target-state type registration failed");
        状态上下文关系类型定位_ =
            L2状态结构内部::初始化状态上下文关系类型(
                L1_, 第一层写入端口_);
    }
    L2状态结构服务(const L2状态结构服务&) = delete;
    L2状态结构服务& operator=(const L2状态结构服务&) = delete;

    std::optional<std::uint64_t> 读取中性当前事实代次_v1() const noexcept {
        const auto 读取 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (读取.状态 != L1中性读取状态::成功
            || 读取.合同版本 != L1中性CRUD合同版本
            || 读取.事实代次 == 0) return std::nullopt;
        return 读取.事实代次;
    }

    // 仅供 ARCH-L2 组合 provider 绑定非拥有参与者引用。
    L1所有者范围写端口& 取得组合发布写入端口() noexcept {
        return 第一层写入端口_;
    }

    const L1所有者范围写端口& 取得组合发布写入端口() const noexcept {
        return 第一层写入端口_;
    }

    struct 当前值记录状态参与者结果_v1 final {
        L2结构状态 状态 = L2结构状态::内部不一致;
        std::optional<L1三分区原子参与者写集_v2> 参与者{};
        L1所有者范围写集本地键 前状态本地键{};
        L1所有者范围写集本地键 后状态本地键{};
        L1所有者范围写集本地键 新选择本地键{};
        std::optional<L2中性状态引用事实_v1> 旧选择{};
        bool legacy基线兼容 = false;
    };

    bool 组合发布当前值状态材料就绪_v1() const noexcept {
        return 结构类型登记定位_.has_value()
            && 有效(状态上下文关系类型定位_.关系类型);
    }

#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
    void ARCH_注入首态提交后首次读回失败一次() noexcept {
        ARCH_首态提交后首次读回失败一次_ = true;
    }
#endif

    L2状态结构类型登记结果 建立状态结构类型登记(
        const L2状态结构类型登记请求& 请求) {
        try {
            if (!L2状态结构类型登记请求有效(请求))
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::入口拒绝);
            if (结构类型登记定位_) {
                if (!L2状态结构类型登记完整(*结构类型登记定位_))
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::内部不一致);
                if (结构类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 结构类型登记定位_->规则版本 != 请求.规则版本
                    || 结构类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 结构类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::幂等冲突);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态结构类型登记幂等键(
                请求.幂等身份);
            写集.节点 = {
                {{L2状态结构内部::状态主体关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2状态结构内部::状态特征实例关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2状态结构内部::状态精确I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2状态结构内部::状态精确I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2状态结构内部::状态精确U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2状态结构内部::状态精确独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用},
                {{L2状态结构内部::状态时间I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2状态结构内部::状态时间I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2状态结构内部::状态时间U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2状态结构内部::状态时间独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2状态结构内部::映射登记写入状态(写入.状态);
            if (状态 != L2状态结构类型登记状态::已提交
                && 状态 != L2状态结构类型登记状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成登记失败(状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整))
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致, 写入.事实代次);
            L1所有者范围写集请求 当前选择写集;
            当前选择写集.合同版本 = L1所有者范围CRUD合同版本;
            当前选择写集.写入幂等身份 =
                L2状态结构内部::映射状态当前选择关系类型登记幂等键(
                    请求.幂等身份);
            当前选择写集.期望事实代次 =
                L2状态结构内部::读取固定登记期望代次(
                    L1_, 第一层写入端口_, 当前选择写集.写入幂等身份);
            当前选择写集.节点 = {
                {{L2状态结构内部::状态当前选择关系类型本地键值},
                    节点种类::普通, std::nullopt}};
            const auto 当前选择写入 =
                第一层写入端口_.提交所有者范围中性写集(当前选择写集);
            if (当前选择写入.合同版本 != L1所有者范围CRUD合同版本
                || 当前选择写入.写入幂等身份 != 当前选择写集.写入幂等身份)
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致,
                    当前选择写入.事实代次);
            const auto 当前选择状态 = L2状态结构内部::映射登记写入状态(
                当前选择写入.状态);
            if (当前选择状态 != L2状态结构类型登记状态::已提交
                && 当前选择状态 != L2状态结构类型登记状态::精确重复) {
                if (!当前选择写入.新编码映射.empty()
                    || 当前选择写入.是否形成内存权威发布)
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::内部不一致,
                        当前选择写入.事实代次);
                return L2状态结构内部::形成登记失败(
                    当前选择状态, 当前选择写入.事实代次);
            }
            const bool 当前选择首次完整 =
                当前选择写入.状态 == L1所有者范围写入状态::成功
                && 当前选择写入.是否形成内存权威发布
                && 当前选择写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 当前选择重复完整 =
                当前选择写入.状态 == L1所有者范围写入状态::精确重复
                && !当前选择写入.是否形成内存权威发布
                && 当前选择写入.重试边界
                    == L1所有者范围重试边界::原幂等身份读回收敛;
            auto 登记 = L2状态结构内部::从写入形成登记(
                写入, 当前选择写入, 请求);
            if (当前选择写入.事实代次 == 0
                || (!当前选择首次完整 && !当前选择重复完整) || !登记
                || !L2状态结构内部::登记历史完整(L1_, *登记))
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致,
                    当前选择写入.事实代次);
            if (结构类型登记定位_ && *结构类型登记定位_ != *登记)
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致,
                    当前选择写入.事实代次);
            结构类型登记定位_ = *登记;
            const auto 最终状态 = 写入.状态 == L1所有者范围写入状态::成功
                    || 当前选择写入.状态 == L1所有者范围写入状态::成功
                ? L2状态结构类型登记状态::已提交
                : L2状态结构类型登记状态::精确重复;
            L2状态结构类型登记结果 结果{最终状态,
                当前选择写入.事实代次, std::move(登记)};
            return 结果.成功() ? 结果 : L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::内部不一致,
                当前选择写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::内部不一致);
        }
    }

    L2状态结构类型登记结果 读取当前状态结构类型登记() const {
        try {
            if (!结构类型登记定位_)
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::登记未加载);
            if (!L2状态结构类型登记完整(*结构类型登记定位_))
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致);
            auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成登记失败(
                    代次.状态 == L1中性读取状态::资源失败
                        ? L2状态结构类型登记状态::资源失败
                        : L2状态结构类型登记状态::内部不一致,
                    代次.事实代次);
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const auto 编码 = L2状态结构内部::登记编码组(*结构类型登记定位_);
                L1所有者范围一致当前读取请求 请求;
                请求.合同版本 = L1所有者范围一致当前读取合同版本;
                请求.期望事实代次 = 代次.事实代次;
                请求.节点.assign(编码.begin(), 编码.end());
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
                const auto 顶层 = L2状态结构内部::解释一致读取顶层(
                    读取, 请求.期望事实代次);
                if (!顶层.成功()) {
                    if (顶层.状态 == L2结构状态::事实代次漂移 && 尝试 == 0) {
                        代次.事实代次 = 顶层.截止;
                        continue;
                    }
                    const auto 登记状态 = 顶层.状态 == L2结构状态::入口拒绝
                        ? L2状态结构类型登记状态::入口拒绝
                        : 顶层.状态 == L2结构状态::许可拒绝
                            ? L2状态结构类型登记状态::许可拒绝
                        : 顶层.状态 == L2结构状态::事实代次漂移
                            ? L2状态结构类型登记状态::事实代次漂移
                        : 顶层.状态 == L2结构状态::资源失败
                            ? L2状态结构类型登记状态::资源失败
                            : L2状态结构类型登记状态::内部不一致;
                    return L2状态结构内部::形成登记失败(登记状态, 顶层.截止);
                }
                if (读取.节点.size() != 编码.size() || !读取.关系.empty()
                    || !读取.值.empty() || !读取.属性值.empty()
                    || !读取.源关系组.empty() || !读取.目标关系组.empty())
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::内部不一致, 顶层.截止);
                const std::array<std::optional<L1所有者范围值表示种类>, 11> 表示 = {
                    std::nullopt, std::nullopt, std::nullopt,
                    L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用};
                for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
                    const auto* 项 = L2状态结构内部::查找唯一节点项(读取, 编码[索引]);
                    const auto 种类 = 索引 < 3 ? 节点种类::普通 : 节点种类::属性类型;
                    if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                        || !项->事实 || 项->事实->编码 != 编码[索引]
                        || 项->事实->种类 != 种类
                        || 项->事实->属性类型表示 != 表示[索引]
                        || 项->事实->创建事实代次 == 0
                        || (索引 != 2 && 项->事实->创建事实代次
                            != 结构类型登记定位_->建立事实代次)
                        || (索引 == 2 && 项->事实->创建事实代次
                            > 顶层.截止)
                        || 项->事实->退出事实代次 || !项->事实->当前属性.empty())
                        return L2状态结构内部::形成登记失败(
                            L2状态结构类型登记状态::内部不一致, 顶层.截止);
                }
                auto 登记 = *结构类型登记定位_;
                登记.事实截止代次 = 顶层.截止;
                L2状态结构类型登记结果 结果{
                    L2状态结构类型登记状态::已读取, 顶层.截止, 登记};
                return 结果.成功() ? 结果 : L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致, 顶层.截止);
            }
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::事实代次漂移, 代次.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::内部不一致);
        }
    }

    L2目标状态合同结构类型登记结果 建立目标状态合同结构类型登记(
        const L2目标状态合同结构类型登记请求& 请求) {
        try {
            std::lock_guard<std::mutex> 锁(目标状态合同结构类型登记锁_);
            if (!L2目标状态合同结构类型登记请求有效(请求))
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::入口拒绝);
            if (目标状态合同结构类型登记定位_) {
                const auto& 已有 = *目标状态合同结构类型登记定位_;
                if (!L2目标状态合同结构类型登记完整(已有))
                    return L2状态结构内部::形成目标登记失败(
                        L2目标状态合同结构类型登记状态::内部不一致);
                if (已有.合同版本 != 请求.请求头.合同版本
                    || 已有.规则版本 != 请求.规则版本
                    || 已有.首次幂等身份 != 请求.幂等身份
                    || 已有.首次期望事实代次 != 请求.请求头.期望事实代次)
                    return L2状态结构内部::形成目标登记失败(
                        L2目标状态合同结构类型登记状态::幂等冲突);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2状态结构内部::目标状态合同结构类型登记固定幂等身份;
            写集.节点 = {
                {{L2状态结构内部::目标状态特征定义关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2状态结构内部::目标状态比较注册关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2状态结构内部::目标状态I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2状态结构内部::目标状态U64合同属性类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致,
                    写入.事实代次);
            const auto 状态 = L2状态结构内部::映射目标登记写入状态(写入.状态);
            if (状态 != L2目标状态合同结构类型登记状态::已提交
                && 状态 != L2目标状态合同结构类型登记状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成目标登记失败(
                        L2目标状态合同结构类型登记状态::内部不一致,
                        写入.事实代次);
                return L2状态结构内部::形成目标登记失败(状态, 写入.事实代次);
            }
            if (!L2状态结构内部::写入成功边界完整(写入)
                || 写入.新编码映射.size() != 4)
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致,
                    写入.事实代次);
            auto 登记 = L2状态结构内部::从写入形成目标登记(写入, 请求);
            if (!登记 || !L2状态结构内部::目标登记历史完整(
                    L1_, *登记, 第一层写入端口_.所有者身份()))
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致,
                    写入.事实代次);
            if (目标状态合同结构类型登记定位_
                && *目标状态合同结构类型登记定位_ != *登记)
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致,
                    写入.事实代次);
            目标状态合同结构类型登记定位_ = *登记;
            L2目标状态合同结构类型登记结果 结果{状态, 写入.事实代次,
                std::move(登记)};
            return 结果.成功() ? 结果
                : L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致,
                    写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成目标登记失败(
                L2目标状态合同结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成目标登记失败(
                L2目标状态合同结构类型登记状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成目标登记失败(
                L2目标状态合同结构类型登记状态::内部不一致);
        }
    }

    L2目标状态合同结构类型登记结果
    读取当前目标状态合同结构类型登记() const {
        try {
            std::lock_guard<std::mutex> 锁(目标状态合同结构类型登记锁_);
            if (!目标状态合同结构类型登记定位_)
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::登记未加载);
            if (!L2目标状态合同结构类型登记完整(
                    *目标状态合同结构类型登记定位_))
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致);
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.合同版本 != L1中性CRUD合同版本
                || 代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
                return L2状态结构内部::形成目标登记失败(
                    代次.状态 == L1中性读取状态::资源失败
                        ? L2目标状态合同结构类型登记状态::资源失败
                        : L2目标状态合同结构类型登记状态::内部不一致,
                    代次.事实代次);
            const auto 编码组 = L2状态结构内部::目标登记编码组(
                *目标状态合同结构类型登记定位_);
            L1所有者范围一致当前读取请求 请求;
            请求.合同版本 = L1所有者范围一致当前读取合同版本;
            请求.期望事实代次 = 代次.事实代次;
            请求.所有者 = {第一层写入端口_.所有者身份()};
            请求.节点.assign(编码组.begin(), 编码组.end());
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
            const auto 顶层 = L2状态结构内部::解释一致读取顶层(
                读取, 请求.期望事实代次);
            if (!顶层.成功()) return L2状态结构内部::形成目标登记失败(
                L2状态结构内部::映射目标登记读取状态(读取.状态), 顶层.截止);
            if (读取.所有者.size() != 1 || 读取.节点.size() != 编码组.size()
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || !读取.源关系组.empty()
                || !读取.目标关系组.empty())
                return L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致, 顶层.截止);
            for (std::size_t 索引 = 0; 索引 < 编码组.size(); ++索引) {
                const auto* 项 = L2状态结构内部::查找唯一节点项(读取, 编码组[索引]);
                const auto 种类 = 索引 < 2 ? 节点种类::普通 : 节点种类::属性类型;
                const auto 表示 = 索引 < 2
                    ? std::optional<L1所有者范围值表示种类>{}
                    : 索引 == 2
                        ? std::optional<L1所有者范围值表示种类>{
                            L1所有者范围值表示种类::I64}
                        : std::optional<L1所有者范围值表示种类>{
                            L1所有者范围值表示种类::U64组};
                if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                    || !项->事实 || 项->事实->编码 != 编码组[索引]
                    || 项->事实->写入所有者 != 第一层写入端口_.所有者身份()
                    || 项->事实->种类 != 种类 || 项->事实->属性类型表示 != 表示
                    || 项->事实->创建事实代次
                        != 目标状态合同结构类型登记定位_->建立事实代次
                    || 项->事实->退出事实代次 || !项->事实->当前属性.empty())
                    return L2状态结构内部::形成目标登记失败(
                        L2目标状态合同结构类型登记状态::内部不一致, 顶层.截止);
            }
            auto 登记 = *目标状态合同结构类型登记定位_;
            登记.事实截止代次 = 顶层.截止;
            L2目标状态合同结构类型登记结果 结果{
                L2目标状态合同结构类型登记状态::已读取, 顶层.截止, 登记};
            return 结果.成功() ? 结果
                : L2状态结构内部::形成目标登记失败(
                    L2目标状态合同结构类型登记状态::内部不一致, 顶层.截止);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成目标登记失败(
                L2目标状态合同结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成目标登记失败(
                L2目标状态合同结构类型登记状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成目标登记失败(
                L2目标状态合同结构类型登记状态::内部不一致);
        }
    }

    L2目标状态合同新增结果 新增目标状态合同(
        const L2目标状态合同新增请求& 请求) {
        if (!L2目标状态合同新增请求有效(请求))
            return L2状态结构内部::形成目标新增失败(L2结构状态::入口拒绝);
        try {
            const auto 首次 = 读取目标状态合同首次写集(请求.幂等身份);
            if (首次.状态 == L2结构状态::已读取 && 首次.写集) {
                const auto& 写集 = *首次.写集;
                if (写集.节点.size() != 1 || 写集.关系.size() != 2
                    || 写集.值.size() != 2 || 写集.属性槽变更.size() != 2
                    || !写集.退出事实.empty())
                    return L2状态结构内部::形成目标新增失败(
                        L2结构状态::幂等冲突, 首次.事实截止代次);
                auto 重复 = 提交并读回目标新增写集(写集);
                if (!重复.成功() || !重复.当前合同
                    || 重复.当前合同->特征定义 != 请求.特征定义
                    || 重复.当前合同->比较注册 != 请求.比较注册
                    || 重复.当前合同->目标I64 != 请求.目标I64
                    || 重复.当前合同->允许关系位 != 请求.允许关系位
                    || 重复.当前合同->规则版本 != 请求.规则版本
                    || 重复.当前合同->来源稳定编码 != 请求.来源稳定编码
                    || 重复.当前合同->首次幂等身份 != 请求.幂等身份
                    || 重复.当前合同->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2状态结构内部::形成目标新增失败(
                        L2结构状态::幂等冲突, 首次.事实截止代次);
                return 重复;
            }
            if (首次.状态 != L2结构状态::未找到)
                return L2状态结构内部::形成目标新增失败(
                    首次.状态, 首次.事实截止代次);
            const auto 类型结果 = 读取当前目标状态合同结构类型登记();
            if (!类型结果.成功() || !类型结果.登记)
                return L2状态结构内部::形成目标新增失败(
                    L2状态结构内部::映射目标登记失败为结构状态(类型结果.状态),
                    类型结果.事实截止代次);
            const auto 上下文 = 检查目标状态合同上下文(
                请求.请求头, 请求.特征定义, 请求.比较注册);
            if (上下文.状态 != L2结构状态::已读取)
                return L2状态结构内部::形成目标新增失败(
                    上下文.状态, 上下文.事实截止代次);
            const auto& 类型 = *类型结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2状态结构内部::映射目标状态合同幂等键(请求.幂等身份);
            写集.节点 = {{{L2状态结构内部::目标状态合同节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2状态结构内部::目标状态特征定义关系本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    请求.特征定义.值, 类型.特征定义关系类型.值,
                    L2状态结构内部::目标状态端点角色值},
                {{L2状态结构内部::目标状态比较注册关系本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    请求.比较注册.值, 类型.比较注册关系类型.值,
                    L2状态结构内部::目标状态端点角色值}};
            写集.值 = {
                {{L2状态结构内部::目标状态I64值本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    类型.I64值类型.值, 请求.目标I64, 请求.来源稳定编码},
                {{L2状态结构内部::目标状态U64合同值本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    类型.U64合同属性类型.值,
                    L2状态结构内部::编码目标状态合同材料(
                        请求.允许关系位, 请求.幂等身份,
                        请求.请求头.期望事实代次),
                    请求.来源稳定编码}};
            写集.属性槽变更 = {
                {L1所有者范围写集本地键{
                    L2状态结构内部::目标状态合同节点本地键值},
                    类型.I64值类型.值,
                    {L2状态结构内部::目标状态I64值本地键值}},
                {L1所有者范围写集本地键{
                    L2状态结构内部::目标状态合同节点本地键值},
                    类型.U64合同属性类型.值,
                    {L2状态结构内部::目标状态U64合同值本地键值}}};
            return 提交并读回目标新增写集(写集);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成目标新增失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成目标新增失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成目标新增失败(L2结构状态::内部不一致);
        }
    }

    L2目标状态合同替换结果 替换目标状态合同(
        const L2目标状态合同替换请求& 请求) {
        if (!L2目标状态合同替换请求有效(请求))
            return L2状态结构内部::形成目标替换失败(L2结构状态::入口拒绝);
        try {
            const auto 首次 = 读取目标状态合同首次写集(请求.幂等身份);
            if (首次.状态 == L2结构状态::已读取 && 首次.写集) {
                const auto& 写集 = *首次.写集;
                if (写集.节点.size() != 1 || 写集.关系.size() != 2
                    || 写集.值.size() != 2 || 写集.属性槽变更.size() != 2
                    || 写集.退出事实.size() != 5)
                    return L2状态结构内部::形成目标替换失败(
                        L2结构状态::幂等冲突, 首次.事实截止代次);
                auto 重复 = 提交并读回目标替换写集(写集, 请求.旧合同);
                if (!重复.成功() || !重复.当前合同 || !重复.已退出合同
                    || 重复.当前合同->特征定义 != 请求.特征定义
                    || 重复.当前合同->比较注册 != 请求.比较注册
                    || 重复.当前合同->目标I64 != 请求.新目标I64
                    || 重复.当前合同->允许关系位 != 请求.新允许关系位
                    || 重复.当前合同->规则版本 != 请求.新规则版本
                    || 重复.当前合同->来源稳定编码 != 请求.来源稳定编码
                    || 重复.当前合同->首次幂等身份 != 请求.幂等身份
                    || 重复.当前合同->首次期望事实代次
                        != 请求.请求头.期望事实代次
                    || 重复.已退出合同->身份 != 请求.旧合同)
                    return L2状态结构内部::形成目标替换失败(
                        L2结构状态::幂等冲突, 首次.事实截止代次);
                return 重复;
            }
            if (首次.状态 != L2结构状态::未找到)
                return L2状态结构内部::形成目标替换失败(
                    首次.状态, 首次.事实截止代次);
            const auto 旧 = 读取完整目标状态合同({请求.请求头,
                L2读取类别::当前, 请求.旧合同, 0});
            if (!旧.成功() || !旧.合同)
                return L2状态结构内部::形成目标替换失败(
                    旧.结果头.状态, 旧.结果头.事实截止代次);
            const auto 类型结果 = 读取当前目标状态合同结构类型登记();
            if (!类型结果.成功() || !类型结果.登记)
                return L2状态结构内部::形成目标替换失败(
                    L2状态结构内部::映射目标登记失败为结构状态(类型结果.状态),
                    类型结果.事实截止代次);
            const auto 上下文 = 检查目标状态合同上下文(
                请求.请求头, 请求.特征定义, 请求.比较注册);
            if (上下文.状态 != L2结构状态::已读取)
                return L2状态结构内部::形成目标替换失败(
                    上下文.状态, 上下文.事实截止代次);
            const auto& 类型 = *类型结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2状态结构内部::映射目标状态合同幂等键(请求.幂等身份);
            写集.节点 = {{{L2状态结构内部::目标状态合同节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2状态结构内部::目标状态特征定义关系本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    请求.特征定义.值, 类型.特征定义关系类型.值,
                    L2状态结构内部::目标状态端点角色值},
                {{L2状态结构内部::目标状态比较注册关系本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    请求.比较注册.值, 类型.比较注册关系类型.值,
                    L2状态结构内部::目标状态端点角色值}};
            写集.值 = {
                {{L2状态结构内部::目标状态I64值本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    类型.I64值类型.值, 请求.新目标I64, 请求.来源稳定编码},
                {{L2状态结构内部::目标状态U64合同值本地键值},
                    L1所有者范围写集本地键{
                        L2状态结构内部::目标状态合同节点本地键值},
                    类型.U64合同属性类型.值,
                    L2状态结构内部::编码目标状态合同材料(
                        请求.新允许关系位, 请求.幂等身份,
                        请求.请求头.期望事实代次),
                    请求.来源稳定编码}};
            写集.属性槽变更 = {
                {L1所有者范围写集本地键{
                    L2状态结构内部::目标状态合同节点本地键值},
                    类型.I64值类型.值,
                    {L2状态结构内部::目标状态I64值本地键值}},
                {L1所有者范围写集本地键{
                    L2状态结构内部::目标状态合同节点本地键值},
                    类型.U64合同属性类型.值,
                    {L2状态结构内部::目标状态U64合同值本地键值}}};
            写集.退出事实 = {旧.合同->身份.值,
                旧.合同->特征定义关系稳定编码,
                旧.合同->比较注册关系稳定编码,
                旧.合同->目标值稳定编码, 旧.合同->合同值稳定编码};
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            return 提交并读回目标替换写集(写集, 请求.旧合同);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成目标替换失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成目标替换失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成目标替换失败(L2结构状态::内部不一致);
        }
    }

    L2目标状态合同退出结果 退出目标状态合同(
        const L2目标状态合同退出请求& 请求) {
        if (!L2目标状态合同退出请求有效(请求))
            return L2状态结构内部::形成目标退出失败(L2结构状态::入口拒绝);
        try {
            const auto 首次 = 读取目标状态合同首次写集(请求.幂等身份);
            if (首次.状态 == L2结构状态::已读取 && 首次.写集) {
                const auto& 写集 = *首次.写集;
                if (!写集.节点.empty() || !写集.关系.empty() || !写集.值.empty()
                    || !写集.属性槽变更.empty() || 写集.退出事实.size() != 5)
                    return L2状态结构内部::形成目标退出失败(
                        L2结构状态::幂等冲突, 首次.事实截止代次);
                auto 重复 = 提交并读回目标退出写集(写集, 请求.合同);
                if (!重复.成功() || !重复.已退出合同
                    || 重复.已退出合同->身份 != 请求.合同
                    || 重复.已退出合同->特征定义关系稳定编码
                        != 请求.特征定义关系稳定编码
                    || 重复.已退出合同->比较注册关系稳定编码
                        != 请求.比较注册关系稳定编码
                    || 重复.已退出合同->目标值稳定编码
                        != 请求.目标值稳定编码
                    || 重复.已退出合同->合同值稳定编码
                        != 请求.合同值稳定编码)
                    return L2状态结构内部::形成目标退出失败(
                        L2结构状态::幂等冲突, 首次.事实截止代次);
                return 重复;
            }
            if (首次.状态 != L2结构状态::未找到)
                return L2状态结构内部::形成目标退出失败(
                    首次.状态, 首次.事实截止代次);
            const auto 当前 = 读取完整目标状态合同({请求.请求头,
                L2读取类别::当前, 请求.合同, 0});
            if (!当前.成功() || !当前.合同)
                return L2状态结构内部::形成目标退出失败(
                    当前.结果头.状态, 当前.结果头.事实截止代次);
            if (当前.合同->特征定义关系稳定编码
                    != 请求.特征定义关系稳定编码
                || 当前.合同->比较注册关系稳定编码
                    != 请求.比较注册关系稳定编码
                || 当前.合同->目标值稳定编码 != 请求.目标值稳定编码
                || 当前.合同->合同值稳定编码 != 请求.合同值稳定编码)
                return L2状态结构内部::形成目标退出失败(
                    L2结构状态::引用冲突, 当前.结果头.事实截止代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 =
                L2状态结构内部::映射目标状态合同幂等键(请求.幂等身份);
            写集.退出事实 = {请求.合同.值, 请求.特征定义关系稳定编码,
                请求.比较注册关系稳定编码, 请求.目标值稳定编码,
                请求.合同值稳定编码};
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            return 提交并读回目标退出写集(写集, 请求.合同);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成目标退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成目标退出失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成目标退出失败(L2结构状态::内部不一致);
        }
    }

    L2目标状态合同完整读取结果 读取完整目标状态合同(
        const L2目标状态合同完整读取请求& 请求) const {
        if (!L2目标状态合同完整读取请求有效(请求))
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::入口拒绝);
        try {
            const auto 类型结果 = 读取当前目标状态合同结构类型登记();
            if (!类型结果.成功() || !类型结果.登记)
                return L2状态结构内部::形成目标读取失败(请求,
                    L2状态结构内部::映射目标登记失败为结构状态(类型结果.状态),
                    类型结果.事实截止代次);
            return 请求.读取类别 == L2读取类别::当前
                ? 读取当前完整目标状态合同(请求, *类型结果.登记)
                : 读取历史完整目标状态合同(请求, *类型结果.登记);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    L2目标状态合同幂等首次完整读取结果_v1
    读取目标状态合同幂等首次完整事实_v1(
        const L2目标状态合同幂等首次完整读取请求_v1& 请求) const noexcept {
        using 状态 = L2目标状态合同幂等首次完整读取状态_v1;
        const auto 失败 = [](状态 值) {
            return L2目标状态合同幂等首次完整读取结果_v1{
                L2目标状态合同幂等首次完整读取合同版本_v1,
                值, std::nullopt, 0};
        };
        if (!L2目标状态合同幂等首次完整读取请求有效_v1(请求))
            return 失败(状态::入口拒绝);
        try {
            const auto G0 = 请求.请求头.期望事实代次;
            const auto 前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (前代次.状态 != L1中性读取状态::成功)
                return 失败(前代次.状态 == L1中性读取状态::资源失败
                    ? 状态::资源失败 : 状态::内部不一致);
            if (前代次.合同版本 != L1中性CRUD合同版本
                || 前代次.事实代次 == 0) return 失败(状态::内部不一致);
            if (前代次.事实代次 != G0) return 失败(状态::当前性漂移);

            const auto L1身份 =
                L2状态结构内部::映射目标状态合同幂等键(请求.幂等身份);
            const auto 首次 = 第一层写入端口_.读取首次写入材料(
                {L1所有者范围首次写入读取合同版本, L1身份});
            if (首次.状态 == L1所有者范围读取状态::未找到)
                return 失败(状态::未找到);
            if (首次.状态 != L1所有者范围读取状态::成功)
                return 失败(首次.状态 == L1所有者范围读取状态::资源失败
                    ? 状态::资源失败 : 状态::内部不一致);
            if (首次.读取事实代次 != G0) return 失败(状态::当前性漂移);
            if (首次.合同版本 != L1所有者范围首次写入读取合同版本
                || 首次.所有者 != 第一层写入端口_.所有者身份()
                || 首次.写入幂等身份 != L1身份
                || !首次.首次规范化写集 || !首次.首次写入结果)
                return 失败(状态::内部不一致);
            const auto& 写集 = *首次.首次规范化写集;
            const auto& 写入 = *首次.首次写入结果;
            if (写集.合同版本 != L1所有者范围CRUD合同版本
                || 写集.写入幂等身份 != L1身份
                || 写集.期望事实代次 == 0 || 写集.节点.size() != 1
                || 写集.关系.size() != 2 || 写集.值.size() != 2
                || 写集.属性槽变更.size() != 2 || !写集.退出事实.empty()
                || 写集.节点.front().本地键.值
                    != L2状态结构内部::目标状态合同节点本地键值
                || 写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.状态 != L1所有者范围写入状态::成功
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != L1身份 || 写入.事实代次 == 0
                || 写集.期望事实代次 >= 写入.事实代次
                || 写入.事实代次 > G0 || !写入.是否形成内存权威发布
                || 写入.重试边界 != L1所有者范围重试边界::不适用
                || 写入.新编码映射.size() != 5)
                return 失败(状态::引用冲突);
            const auto 合同编码 = L2状态结构内部::查找编码映射(
                写入, L2状态结构内部::目标状态合同节点本地键值);
            if (!合同编码) return 失败(状态::引用冲突);
            auto 当前 = 读取完整目标状态合同({请求.请求头,
                L2读取类别::当前, L2目标状态合同身份{*合同编码}, 0});
            if (!当前.成功() || !当前.合同) {
                if (当前.结果头.状态 == L2结构状态::事实代次漂移)
                    return 失败(状态::当前性漂移);
                if (当前.结果头.状态 == L2结构状态::资源失败)
                    return 失败(状态::资源失败);
                if (当前.结果头.状态 == L2结构状态::未找到
                    || 当前.结果头.状态 == L2结构状态::已退出) {
                    const auto 历史 = 读取完整目标状态合同({请求.请求头,
                        L2读取类别::历史, L2目标状态合同身份{*合同编码}, G0});
                    if (历史.成功() && 历史.合同
                        && 历史.合同->生命周期.退出事实代次
                        && *历史.合同->生命周期.退出事实代次 <= G0)
                        return 失败(状态::已退出);
                    return 失败(状态::内部不一致);
                }
                return 失败(当前.结果头.状态 == L2结构状态::引用冲突
                    ? 状态::引用冲突 : 状态::内部不一致);
            }
            if (当前.结果头.事实截止代次 != G0
                || 当前.合同->身份 != L2目标状态合同身份{*合同编码}
                || 当前.合同->首次幂等身份 != 请求.幂等身份
                || 当前.合同->首次期望事实代次 != 写集.期望事实代次
                || 当前.合同->生命周期.创建事实代次 != 写入.事实代次
                || 当前.合同->生命周期.退出事实代次
                || !L2目标状态合同事实完整(*当前.合同, G0))
                return 失败(状态::引用冲突);
            const auto 后代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (后代次.状态 != L1中性读取状态::成功)
                return 失败(后代次.状态 == L1中性读取状态::资源失败
                    ? 状态::资源失败 : 状态::内部不一致);
            if (后代次.合同版本 != L1中性CRUD合同版本
                || 后代次.事实代次 == 0) return 失败(状态::内部不一致);
            if (后代次.事实代次 != G0) return 失败(状态::当前性漂移);
            L2目标状态合同幂等首次完整读取结果_v1 结果{
                L2目标状态合同幂等首次完整读取合同版本_v1,
                状态::已读取, std::move(当前.合同), G0};
            return 结果.成功() ? 结果 : 失败(状态::内部不一致);
        } catch (const std::bad_alloc&) {
            return 失败(状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(状态::资源失败);
        } catch (...) {
            return 失败(状态::内部不一致);
        }
    }

    L2中性状态写入结果_v1 新增中性状态_v1(
        const L2中性状态新增请求_v1& 请求) noexcept {
        return 中性状态提供者_.新增状态(请求);
    }

    L2中性状态读取结果_v1 读取中性状态_v1(
        const L2中性状态读取请求_v1& 请求) const noexcept {
        return 中性状态提供者_.读取状态(请求);
    }

    L2中性状态退出结果_v1 退出中性状态_v1(
        const L2中性状态退出请求_v1& 请求) noexcept {
        return 中性状态提供者_.退出状态(请求);
    }

    L2中性状态引用写入结果_v1 建立中性状态普通引用_v1(
        const L2中性状态普通引用建立请求_v1& 请求) noexcept {
        return 中性状态提供者_.建立普通引用(请求);
    }

    L2中性状态引用写入结果_v1 设置中性状态当前选择_v1(
        const L2中性状态当前选择设置请求_v1& 请求) noexcept {
        return 中性状态提供者_.设置当前选择(请求);
    }

    L2中性状态引用写入结果_v1 退出中性状态引用_v1(
        const L2中性状态引用退出请求_v1& 请求) noexcept {
        return 中性状态提供者_.退出引用(请求);
    }

    L2中性状态引用读取结果_v1 读取中性状态引用_v1(
        const L2中性状态引用读取请求_v1& 请求) const noexcept {
        if (!L2中性状态引用读取请求有效_v1(请求)
            || !结构类型登记定位_)
            return {{L2中性状态动态合同版本_v1,
                    L2中性结构状态_v1::入口拒绝, 0, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次,
                std::nullopt, std::nullopt, std::nullopt};
        const auto 失败 = [&](L2中性结构状态_v1 状态,
            std::uint64_t 截止 = 0) {
            return L2中性状态引用读取结果_v1{{
                    L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次,
                std::nullopt, std::nullopt, std::nullopt};
        };
        try {
            const auto 前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (前.状态 != L1中性读取状态::成功 || 前.事实代次 == 0)
                return 失败(前.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误);
            if (前.事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2中性结构状态_v1::事实代次漂移, 前.事实代次);

            std::optional<L1中性关系事实> 关系式;
            bool 是关系式 = false;
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 读取 = L1_.读取中性当前关系(
                    {L1中性CRUD合同版本, 请求.引用.值});
                if (读取.状态 == L1中性读取状态::成功 && 读取.事实) {
                    关系式 = *读取.事实;
                    是关系式 = true;
                } else if (读取.状态 != L1中性读取状态::未找到
                    && 读取.状态 != L1中性读取状态::已退出) {
                    return 失败(读取.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                }
            } else {
                const auto 读取 = L1_.读取中性历史事实(
                    {L1中性CRUD合同版本, 请求.引用.值});
                if (读取.状态 == L1中性读取状态::成功 && 读取.事实) {
                    if (const auto* 关系 = std::get_if<L1中性关系事实>(
                            &*读取.事实)) {
                        关系式 = *关系;
                        是关系式 = true;
                    }
                } else if (读取.状态 != L1中性读取状态::未找到
                    && 读取.状态 != L1中性读取状态::历史材料已清理) {
                    return 失败(读取.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                }
            }
            if (!是关系式)
                return 中性状态提供者_.读取引用(请求);

            const auto& 关系 = *关系式;
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 前.事实代次 : 请求.历史截止事实代次;
            if (关系.编码 != 请求.引用.值
                || 关系.关系类型节点
                    != 结构类型登记定位_->当前选择关系类型.值
                || 关系.角色或顺序 <= 0
                || 关系.创建事实代次 == 0
                || 关系.创建事实代次 > 截止
                || (请求.读取类别 == L2读取类别::当前
                    && 关系.退出事实代次))
                return 失败(L2中性结构状态_v1::引用冲突, 前.事实代次);
            L2中性状态引用事实_v1 引用{{关系.编码},
                L2中性状态引用类别_v1::当前选择, 关系.源节点,
                稳定编码{static_cast<std::uint64_t>(关系.角色或顺序)},
                L2状态身份{关系.目标节点},
                {关系.创建事实代次, 关系.退出事实代次}};
            if (!L2中性状态引用事实完整_v1(引用))
                return 失败(L2中性结构状态_v1::内部错误, 前.事实代次);
            const auto 目标 = 读取中性状态_v1({请求.请求头,
                L2中性状态动态合同版本_v1, 请求.读取类别,
                引用.目标状态, 请求.历史截止事实代次});
            const auto 后 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (后.状态 != L1中性读取状态::成功
                || 后.事实代次 != 前.事实代次)
                return 失败(后.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::事实代次漂移,
                    后.事实代次);
            if (!目标.成功() || !目标.状态)
                return 失败(目标.结果头.状态, 前.事实代次);
            L2中性状态引用读取结果_v1 结果{{
                    L2中性状态动态合同版本_v1,
                    L2中性结构状态_v1::已读取, 前.事实代次,
                    std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(引用),
                *目标.状态, std::nullopt};
            return 结果.成功() ? 结果
                : 失败(L2中性结构状态_v1::内部错误, 前.事实代次);
        } catch (const std::bad_alloc&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (...) {
            return 失败(L2中性结构状态_v1::内部错误);
        }
    }

    L2中性状态引用读取结果_v1 读取中性状态当前选择_v1(
        const L2中性状态当前选择读取请求_v1& 请求) const noexcept {
        if (!L2中性状态当前选择读取请求有效_v1(请求)
            || !结构类型登记定位_)
            return {{L2中性状态动态合同版本_v1,
                    L2中性结构状态_v1::入口拒绝, 0, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次,
                std::nullopt, std::nullopt, std::nullopt};
        const auto 失败 = [&](L2中性结构状态_v1 状态,
            std::uint64_t 截止 = 0) {
            return L2中性状态引用读取结果_v1{{
                    L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次,
                std::nullopt, std::nullopt, std::nullopt};
        };
        try {
            const auto 前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (前.状态 != L1中性读取状态::成功 || 前.事实代次 == 0)
                return 失败(前.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误);
            if (前.事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2中性结构状态_v1::事实代次漂移, 前.事实代次);
            const auto legacy = 中性状态提供者_.读取当前选择(请求);
            const bool legacy找到 = legacy.成功();
            if (!legacy找到
                && legacy.结果头.状态 != L2中性结构状态_v1::未找到)
                return 失败(legacy.结果头.状态, 前.事实代次);

            std::vector<L1中性关系事实> 关系组;
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 读取 = L1_.读取中性当前源关系组({
                    L1中性CRUD合同版本, 请求.引用方,
                    结构类型登记定位_->当前选择关系类型.值});
                if (读取.状态 != L1中性读取状态::成功
                    && 读取.状态 != L1中性读取状态::未找到)
                    return 失败(读取.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                if (读取.读取事实代次 != 前.事实代次)
                    return 失败(L2中性结构状态_v1::事实代次漂移,
                        读取.读取事实代次);
                关系组 = 读取.关系组;
            } else {
                const auto 读取 = L1_.读取中性历史关系组({
                    L1中性CRUD合同版本, L1中性关系端点方向::源,
                    请求.引用方, 结构类型登记定位_->当前选择关系类型.值,
                    请求.历史截止事实代次});
                if (读取.状态 != L1中性历史关系组读取状态::成功)
                    return 失败(读取.状态
                            == L1中性历史关系组读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误, 前.事实代次);
                if (读取.读取事实代次 != 前.事实代次)
                    return 失败(L2中性结构状态_v1::事实代次漂移,
                        读取.读取事实代次);
                关系组 = 读取.关系组;
            }
            std::optional<L1中性关系事实> 关系式;
            const auto 角色 = static_cast<std::int64_t>(请求.引用角色.值);
            for (const auto& 关系 : 关系组) {
                if (关系.源节点 != 请求.引用方
                    || 关系.关系类型节点
                        != 结构类型登记定位_->当前选择关系类型.值
                    || 关系.角色或顺序 != 角色)
                    continue;
                if (关系式)
                    return 失败(L2中性结构状态_v1::引用冲突, 前.事实代次);
                关系式 = 关系;
            }
            if (legacy找到 && 关系式)
                return 失败(L2中性结构状态_v1::引用冲突, 前.事实代次);
            if (legacy找到) return legacy;
            if (!关系式)
                return 失败(L2中性结构状态_v1::未找到, 前.事实代次);
            return 读取中性状态引用_v1({请求.请求头,
                L2中性状态动态合同版本_v1, 请求.读取类别,
                L2中性状态引用身份_v1{关系式->编码},
                请求.历史截止事实代次});
        } catch (const std::bad_alloc&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (...) {
            return 失败(L2中性结构状态_v1::内部错误);
        }
    }

    L2中性状态上下文读取结果_v1 读取中性状态上下文_v1(
        const L2中性状态上下文读取请求_v1& 请求) const noexcept {
        const auto 失败 = [&](L2中性结构状态_v1 状态) {
            return L2中性状态上下文读取结果_v1{{
                L2中性状态动态合同版本_v1, 状态, 0, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        };
        if (请求.专属合同版本 != L2中性状态动态合同版本_v1
            || !L2结构请求头合同有效(请求.请求头)
            || 请求.请求头.期望事实代次 == 0 || !有效(请求.状态.值)
            || (请求.读取类别 == L2读取类别::当前
                && 请求.历史截止事实代次 != 0)
            || (请求.读取类别 == L2读取类别::历史
                && (请求.历史截止事实代次 == 0
                    || 请求.历史截止事实代次
                        > 请求.请求头.期望事实代次)))
            return 失败(L2中性结构状态_v1::入口拒绝);
        try {
            const auto 前 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (前.状态 != L1中性读取状态::成功 || 前.事实代次 == 0)
                return 失败(前.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误);
            if (前.事实代次 != 请求.请求头.期望事实代次)
                return 失败(L2中性结构状态_v1::事实代次漂移);
            const auto 截止 = 请求.读取类别 == L2读取类别::当前
                ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次;
            const auto 状态读取 = 读取中性状态_v1({请求.请求头,
                L2中性状态动态合同版本_v1, 请求.读取类别,
                请求.状态, 请求.历史截止事实代次});
            if (!状态读取.成功() || !状态读取.状态)
                return 失败(状态读取.结果头.状态);
            std::vector<L1中性关系事实> 关系组;
            if (请求.读取类别 == L2读取类别::当前) {
                const auto 读 = L1_.读取中性当前源关系组({
                    L1中性CRUD合同版本, 请求.状态.值,
                    状态上下文关系类型定位_.关系类型});
                if (读.状态 != L1中性读取状态::成功
                    || 读.读取事实代次 != 请求.请求头.期望事实代次)
                    return 失败(读.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误);
                关系组 = 读.关系组;
            } else {
                const auto 读 = L1_.读取中性历史关系组({
                    L1中性CRUD合同版本, L1中性关系端点方向::源,
                    请求.状态.值, 状态上下文关系类型定位_.关系类型,
                    请求.历史截止事实代次});
                if (读.状态 != L1中性历史关系组读取状态::成功
                    || 读.读取事实代次 != 请求.请求头.期望事实代次)
                    return 失败(读.状态
                            == L1中性历史关系组读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误);
                关系组 = 读.关系组;
            }
            if (关系组.size() != 4)
                return 失败(L2中性结构状态_v1::动态不闭合);
            L2中性状态上下文事实_v1 上下文;
            上下文.状态 = 请求.状态;
            上下文.生命周期 = {状态读取.状态->形成事实代次, std::nullopt};
            bool 角色[5]{};
            for (const auto& 关系 : 关系组) {
                if (关系.源节点 != 请求.状态.值
                    || 关系.关系类型节点
                        != 状态上下文关系类型定位_.关系类型
                    || 关系.退出事实代次 || 关系.角色或顺序 < 1
                    || 关系.角色或顺序 > 4
                    || 角色[关系.角色或顺序])
                    return 失败(L2中性结构状态_v1::动态不闭合);
                角色[关系.角色或顺序] = true;
                switch (关系.角色或顺序) {
                case 1:
                    上下文.主体存在 = L2存在身份{关系.目标节点};
                    上下文.主体关系稳定编码 = 关系.编码;
                    break;
                case 2:
                    上下文.共同场景 = L2场景身份{关系.目标节点};
                    上下文.场景关系稳定编码 = 关系.编码;
                    break;
                case 3:
                    上下文.特征实例 = L2特征实例身份{关系.目标节点};
                    上下文.特征实例关系稳定编码 = 关系.编码;
                    break;
                case 4:
                    上下文.来源存在 = L2存在身份{关系.目标节点};
                    上下文.来源存在关系稳定编码 = 关系.编码;
                    break;
                }
            }
            if (!有效(上下文.主体存在.值) || !有效(上下文.共同场景.值)
                || !有效(上下文.特征实例.值) || !有效(上下文.来源存在.值))
                return 失败(L2中性结构状态_v1::动态不闭合);
            const auto 后 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (后.状态 != L1中性读取状态::成功
                || 后.事实代次 != 请求.请求头.期望事实代次)
                return 失败(后.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::事实代次漂移);
            L2中性状态上下文读取结果_v1 结果{{
                L2中性状态动态合同版本_v1, L2中性结构状态_v1::已读取,
                请求.请求头.期望事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::move(上下文)};
            return 结果.成功() ? 结果 : 失败(L2中性结构状态_v1::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(L2中性结构状态_v1::资源失败);
        } catch (...) {
            return 失败(L2中性结构状态_v1::内部错误);
        }
    }

    L2状态写入结果 新增状态(const L2状态新增请求& 请求) {
        (void)请求;
        return L2状态结构内部::形成写入失败(L2结构状态::入口拒绝);
    }

    L2特征首值初始状态原子形成结果_v1 新增特征首值与初始状态_v1(
        const L2特征首值初始状态原子形成请求_v1& 请求) noexcept {
        using 状态 = L2特征首值初始状态原子形成状态_v1;
        const auto 失败 = [](状态 值) {
            return L2特征首值初始状态原子形成结果_v1{
                L2特征首值初始状态原子形成合同版本_v1,
                值, std::nullopt, std::nullopt, std::nullopt, 0};
        };
        const auto 映射公共失败 = [&](L2结构状态 值) {
            switch (值) {
            case L2结构状态::入口拒绝: return 失败(状态::入口拒绝);
            case L2结构状态::事实代次漂移: return 失败(状态::当前性漂移);
            case L2结构状态::幂等冲突: return 失败(状态::幂等冲突);
            case L2结构状态::引用冲突: return 失败(状态::引用冲突);
            case L2结构状态::未找到:
            case L2结构状态::已退出:
            case L2结构状态::属性未设置:
                return 失败(状态::材料未闭合);
            case L2结构状态::资源失败: return 失败(状态::资源失败);
            default: return 失败(状态::内部不一致);
            }
        };
        if (!L2特征首值初始状态原子形成请求有效_v1(请求))
            return 失败(状态::入口拒绝);
        try {
            const auto G0 = 请求.请求头.期望事实代次;
            const auto 前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (前代次.状态 != L1中性读取状态::成功)
                return 失败(前代次.状态 == L1中性读取状态::资源失败
                    ? 状态::资源失败 : 状态::内部不一致);
            if (前代次.合同版本 != L1中性CRUD合同版本
                || 前代次.事实代次 == 0) return 失败(状态::内部不一致);
            const bool 仅形成幂等重放候选 = 前代次.事实代次 != G0;

            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return 失败(登记结果.状态 == L2状态结构类型登记状态::资源失败
                    ? 状态::资源失败
                    : 登记结果.状态 == L2状态结构类型登记状态::许可拒绝
                        ? 状态::内部不一致 : 状态::材料未闭合);
            if (!仅形成幂等重放候选) {
                const auto 主体 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.主体存在, 0});
                const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (!主体.成功() || !主体.身份来源
                    || 实例.结果头.状态 != L2结构状态::已读取
                    || !实例.特征实例)
                    return 失败(主体.结果头.状态 == L2结构状态::资源失败
                        || 实例.结果头.状态 == L2结构状态::资源失败
                        ? 状态::资源失败 : 状态::材料未闭合);
                if (主体.结果头.事实截止代次 != G0
                    || 实例.结果头.事实截止代次 != G0
                    || 主体.身份来源->节点稳定编码 != 请求.主体存在.值
                    || 实例.特征实例->身份 != 请求.特征实例
                    || 实例.特征实例->生命周期.退出事实代次)
                    return 失败(状态::内部不一致);
                if (实例.特征实例->宿主存在 != 请求.主体存在
                    || 实例.特征实例->当前值)
                    return 失败(状态::引用冲突);
                const auto 当前选择 = 读取特征实例当前状态选择(
                    {请求.请求头, 请求.特征实例});
                const bool 无当前选择 =
                    当前选择.结果头.状态 == L2结构状态::入口拒绝
                    && 当前选择.读取状态 == L2状态当前选择读取状态::待迁移
                    && 当前选择.结果头.事实截止代次 == G0
                    && !当前选择.结果头.变更事实代次
                    && !当前选择.当前选择关系 && !当前选择.当前状态;
                if (!无当前选择) {
                    if (当前选择.成功()) return 失败(状态::引用冲突);
                    return 映射公共失败(当前选择.结果头.状态);
                }
            }

            const auto 特征参与者 = 特征服务_.形成首值原子参与者写集_v1(
                请求.请求头, 请求.首值幂等身份, 请求.特征实例,
                请求.初始值材料, 请求.来源稳定编码);
            if (特征参与者.状态 != L2结构状态::已读取 || !特征参与者.参与者)
                return 映射公共失败(特征参与者.状态);
            const auto& 登记 = *登记结果.登记;
            const auto 精确类型 = L2状态结构内部::选择状态值类型编码(
                登记, 请求.初始值材料, true);
            const L2原始值材料 时间材料{
                static_cast<std::int64_t>(请求.初始状态UTC纳秒)};
            const auto 时间类型 = L2状态结构内部::选择状态值类型编码(
                登记, 时间材料, false);
            if (!有效(精确类型) || !有效(时间类型))
                return 失败(状态::引用冲突);

            L1跨所有者原子写集请求 状态写集;
            状态写集.合同版本 = L1所有者范围CRUD合同版本;
            状态写集.期望事实代次 = G0;
            状态写集.写入幂等身份 =
                L2状态结构内部::映射状态幂等键(请求.首态幂等身份);
            const L1跨所有者原子事实引用值 状态节点{
                L1所有者范围写集本地键{
                    L2状态结构内部::状态节点本地键值}};
            状态写集.节点 = {{{L2状态结构内部::状态节点本地键值},
                节点种类::普通, std::nullopt}};
            状态写集.关系 = {
                {{L2状态结构内部::状态族归属关系本地键值}, 状态节点,
                    状态身份来源定位_.族锚点,
                    状态身份来源定位_.族归属关系类型,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态主体关系本地键值}, 状态节点,
                    请求.主体存在.值, 登记.主体关系类型.值,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态特征实例关系本地键值}, 状态节点,
                    请求.特征实例.值, 登记.特征实例关系类型.值,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态当前选择关系本地键值},
                    请求.特征实例.值, 状态节点,
                    登记.当前选择关系类型.值,
                    L2状态结构内部::状态端点角色值}};
            状态写集.值 = {
                {{L2状态结构内部::状态精确值本地键值}, 状态节点,
                    精确类型, L2状态结构内部::转换为L1材料(
                        请求.初始值材料), 请求.来源稳定编码},
                {{L2状态结构内部::状态时间值本地键值}, 状态节点,
                    时间类型, L2状态结构内部::转换为L1材料(时间材料),
                    请求.来源稳定编码}};
            状态写集.属性槽变更 = {
                {状态节点, 精确类型,
                    {L2状态结构内部::状态精确值本地键值}},
                {状态节点, 时间类型,
                    {L2状态结构内部::状态时间值本地键值}}};
            L1跨所有者原子参与者写集 状态参与者;
            状态参与者.参与者 = L1跨所有者原子事务参与者序号::状态;
            状态参与者.所有者 = 第一层写入端口_.所有者身份();
            状态参与者.写集 = std::move(状态写集);
            L1跨所有者原子事务请求 L1请求;
            L1请求.合同版本 = L1跨所有者原子事务合同版本;
            L1请求.共同期望事实代次 = G0;
            L1请求.组合写入幂等身份 = 请求.组合幂等身份;
            L1请求.状态写集 = std::move(状态参与者);
            L1请求.动态写集 = *特征参与者.参与者;
            const auto 写入 = 第一层写入端口_.提交跨所有者原子事务(
                L1请求, 特征服务_.取得组合发布写入端口());
            if (写入.合同版本 != L1跨所有者原子事务合同版本)
                return 写入.是否形成内存权威发布
                    ? 失败(状态::已可能发布) : 失败(状态::内部不一致);
            if (写入.状态 != L1跨所有者原子事务状态::已提交
                && 写入.状态 != L1跨所有者原子事务状态::精确重复) {
                if (写入.是否形成内存权威发布
                    || !写入.状态编码映射.empty()
                    || !写入.动态编码映射.empty())
                    return 失败(状态::已可能发布);
                switch (写入.状态) {
                case L1跨所有者原子事务状态::入口拒绝:
                    return 失败(状态::入口拒绝);
                case L1跨所有者原子事务状态::事实代次漂移:
                    return 失败(状态::当前性漂移);
                case L1跨所有者原子事务状态::幂等冲突:
                    return 失败(状态::幂等冲突);
                case L1跨所有者原子事务状态::引用冲突:
                    return 失败(状态::引用冲突);
                case L1跨所有者原子事务状态::未找到:
                case L1跨所有者原子事务状态::已退出:
                    return 失败(状态::材料未闭合);
                case L1跨所有者原子事务状态::资源失败:
                    return 失败(状态::资源失败);
                default:
                    return 失败(状态::内部不一致);
                }
            }
            const bool 首次完整 =
                写入.状态 == L1跨所有者原子事务状态::已提交
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 =
                写入.状态 == L1跨所有者原子事务状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界
                    == L1所有者范围重试边界::原幂等身份读回收敛;
            if (写入.共同事实代次 == 0 || (!首次完整 && !重复完整)
                || 写入.状态编码映射.size() != 7
                || 写入.动态编码映射.size() != 1)
                return 失败(状态::已可能发布);
            const auto 查找 = [](const auto& 映射, std::uint32_t 本地键)
                -> std::optional<稳定编码> {
                std::optional<稳定编码> 结果;
                for (const auto& [键, 编码] : 映射) {
                    if (!有效(编码)) return std::nullopt;
                    if (键.值 == 本地键) {
                        if (结果) return std::nullopt;
                        结果 = 编码;
                    }
                }
                return 结果;
            };
            const auto 状态编码 = 查找(写入.状态编码映射,
                L2状态结构内部::状态节点本地键值);
            const auto 当前选择编码 = 查找(写入.状态编码映射,
                L2状态结构内部::状态当前选择关系本地键值);
            const auto G1 = 写入.共同事实代次;
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (!状态编码 || !当前选择编码
                || 当前代次.合同版本 != L1中性CRUD合同版本
                || 当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < G1)
                return 失败(状态::已可能发布);
            const L2结构请求头 读回头{L2结构合同版本, 当前代次.事实代次};
            const auto 实例 = 特征服务_.读取完整特征实例({读回头,
                L2读取类别::历史, 请求.特征实例, G1});
            const auto 初态 = 读取完整状态({读回头, L2读取类别::历史,
                L2状态身份{*状态编码}, G1});
            const auto 选择 = 读取特征实例历史状态选择(
                {读回头, 请求.特征实例, G1});
            if (实例.结果头.状态 != L2结构状态::已读取
                || !实例.特征实例
                || !实例.特征实例->当前值
                || 初态.结果头.状态 != L2结构状态::已读取 || !初态.状态
                || !初态.自有关系 || !选择.成功() || !选择.当前选择关系
                || !选择.状态 || 实例.结果头.事实截止代次 != G1
                || 初态.结果头.事实截止代次 != G1
                || 选择.结果头.事实截止代次 != G1
                || 初态.状态->身份 != L2状态身份{*状态编码}
                || 选择.当前选择关系->关系稳定编码 != *当前选择编码
                || 选择.当前选择关系->状态 != 初态.状态->身份
                || 选择.状态->身份 != 初态.状态->身份
                || 初态.状态->主体存在 != 请求.主体存在
                || 初态.状态->特征实例 != 请求.特征实例
                || 初态.状态->精确值.类型化不可变材料 != 请求.初始值材料
                || 初态.状态->时间值.类型化不可变材料 != 时间材料
                || 初态.状态->来源稳定编码 != 请求.来源稳定编码
                || 实例.特征实例->当前值->特征实例 != 请求.特征实例
                || 实例.特征实例->当前值->类型化不可变材料
                    != 请求.初始值材料
                || 实例.特征实例->当前值->来源稳定编码
                    != 请求.来源稳定编码
                || !特征服务_.首值编码映射完整_v1(
                    写入, 实例.特征实例->当前值->值稳定编码))
                return 失败(状态::已可能发布);
            L2特征首值初始状态原子形成结果_v1 结果{
                L2特征首值初始状态原子形成合同版本_v1,
                写入.状态 == L1跨所有者原子事务状态::已提交
                    ? 状态::已提交 : 状态::精确重复,
                *实例.特征实例->当前值, *初态.状态,
                *选择.当前选择关系, G1};
            return 结果.成功() ? 结果 : 失败(状态::已可能发布);
        } catch (const std::bad_alloc&) {
            return 失败(状态::资源失败);
        } catch (const std::length_error&) {
            return 失败(状态::资源失败);
        } catch (...) {
            return 失败(状态::内部不一致);
        }
    }

    L2状态首态结果_v2 新增状态_v2(
        const L2状态首态请求_v2& 请求) noexcept {
        (void)请求;
        return L2状态结构内部::形成首态失败_v2(
            L2结构状态::入口拒绝, L2状态首态操作状态_v2::入口拒绝);
#if 0
        if (!L2状态首态请求有效_v2(请求))
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::入口拒绝, L2状态首态操作状态_v2::入口拒绝);
        const auto& 请求头 = 请求.请求头.公共请求头;
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (登记结果.状态 != L2状态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功()) {
                const auto 公共状态 = L2状态结构内部::映射登记失败为结构状态(
                    登记结果.状态);
                return L2状态结构内部::形成首态失败_v2(公共状态,
                    L2状态结构内部::映射首态操作状态(公共状态),
                    登记结果.事实截止代次);
            }
            const auto 当前选择 = 读取特征实例当前状态选择(
                {请求头, 请求.特征实例});
            if (当前选择.成功())
                return L2状态结构内部::形成首态失败_v2(
                    L2结构状态::引用冲突,
                    L2状态首态操作状态_v2::已有当前选择,
                    当前选择.结果头.事实截止代次);
            const bool 仅形成幂等重放候选 =
                当前选择.结果头.状态 == L2结构状态::事实代次漂移
                && 当前选择.读取状态
                    == L2状态当前选择读取状态::事实代次漂移;
            if (当前选择.读取状态 != L2状态当前选择读取状态::待迁移
                && !仅形成幂等重放候选)
                return L2状态结构内部::形成首态失败_v2(
                    当前选择.结果头.状态,
                    L2状态结构内部::映射首态操作状态(
                        当前选择.结果头.状态),
                    当前选择.结果头.事实截止代次);
            if (!仅形成幂等重放候选) {
                const auto 已有状态 = 按特征实例读取全部当前状态(
                    {请求头, 请求.特征实例, 1});
                if (已有状态.结果头.状态 == L2结构状态::数量预算不足
                    || (已有状态.成功() && !已有状态.状态.empty()))
                    return L2状态结构内部::形成首态失败_v2(
                        L2结构状态::入口拒绝,
                        L2状态首态操作状态_v2::待迁移,
                        已有状态.结果头.事实截止代次);
                if (!已有状态.成功())
                    return L2状态结构内部::形成首态失败_v2(
                        已有状态.结果头.状态,
                        L2状态结构内部::映射首态操作状态(
                            已有状态.结果头.状态),
                        已有状态.结果头.事实截止代次);
                const auto 主体 = 存在服务_.读取完整存在({请求头,
                    L2读取类别::当前, 请求.主体存在, 0});
                const auto 实例 = 特征服务_.读取完整特征实例({请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                const auto 主体状态 = L2状态结构内部::检查端点结果头(
                    主体.结果头, 请求头.期望事实代次);
                const auto 实例状态 = L2状态结构内部::检查端点结果头(
                    实例.结果头, 请求头.期望事实代次);
                if (主体状态 != L2结构状态::已读取 || !主体.存在
                    || 实例状态 != L2结构状态::已读取 || !实例.特征实例) {
                    const auto 公共状态 = 主体状态 != L2结构状态::已读取
                        ? 主体状态 : 实例状态 != L2结构状态::已读取
                            ? 实例状态 : L2结构状态::内部不一致;
                    return L2状态结构内部::形成首态失败_v2(公共状态,
                        L2状态结构内部::映射首态操作状态(公共状态),
                        std::max(主体.结果头.事实截止代次,
                            实例.结果头.事实截止代次));
                }
                if (主体.存在->身份 != 请求.主体存在
                    || 实例.特征实例->身份 != 请求.特征实例
                    || 主体.存在->生命周期.退出事实代次
                    || 实例.特征实例->生命周期.退出事实代次)
                    return L2状态结构内部::形成首态失败_v2(
                        L2结构状态::内部不一致,
                        L2状态首态操作状态_v2::内部不一致,
                        请求头.期望事实代次);
                if (实例.特征实例->宿主存在 != 请求.主体存在)
                    return L2状态结构内部::形成首态失败_v2(
                        L2结构状态::引用冲突,
                        L2状态首态操作状态_v2::引用冲突,
                        请求头.期望事实代次);
            }
            const auto& 登记 = *登记结果.登记;
            const auto 精确类型 = L2状态结构内部::选择状态值类型编码(
                登记, 请求.精确值材料, true);
            const auto 时间类型 = L2状态结构内部::选择状态值类型编码(
                登记, 请求.时间值材料, false);
            if (!有效(精确类型) || !有效(时间类型))
                return L2状态结构内部::形成首态失败_v2(
                    L2结构状态::引用冲突,
                    L2状态首态操作状态_v2::引用冲突,
                    请求头.期望事实代次);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(
                请求.幂等身份);
            const L1所有者范围写集本地键 状态节点{
                L2状态结构内部::状态节点本地键值};
            写集.节点 = {{状态节点, 节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2状态结构内部::状态族归属关系本地键值}, 状态节点,
                    状态身份来源定位_.族锚点,
                    状态身份来源定位_.族归属关系类型,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态主体关系本地键值}, 状态节点,
                    请求.主体存在.值, 登记.主体关系类型.值,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态特征实例关系本地键值}, 状态节点,
                    请求.特征实例.值, 登记.特征实例关系类型.值,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态当前选择关系本地键值},
                    请求.特征实例.值, 状态节点,
                    登记.当前选择关系类型.值,
                    L2状态结构内部::状态端点角色值}};
            写集.值 = {
                {{L2状态结构内部::状态精确值本地键值}, 状态节点,
                    精确类型, L2状态结构内部::转换为L1材料(
                        请求.精确值材料), 请求.来源稳定编码},
                {{L2状态结构内部::状态时间值本地键值}, 状态节点,
                    时间类型, L2状态结构内部::转换为L1材料(
                        请求.时间值材料), 请求.来源稳定编码}};
            写集.属性槽变更 = {
                {状态节点, 精确类型,
                    L1所有者范围写集本地键{
                        L2状态结构内部::状态精确值本地键值}},
                {状态节点, 时间类型,
                    L1所有者范围写集本地键{
                        L2状态结构内部::状态时间值本地键值}}};
            return 提交并读回新增首态_v2(写集, 请求, 登记);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::资源失败, L2状态首态操作状态_v2::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::资源失败, L2状态首态操作状态_v2::资源失败);
        } catch (...) {
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::内部不一致,
                L2状态首态操作状态_v2::内部不一致);
        }
#endif
    }

    L2状态当前选择读取结果 读取特征实例当前状态选择(
        const L2状态当前选择读取请求& 请求) const noexcept {
        if (!L2状态当前选择读取请求有效(请求))
            return L2状态结构内部::形成当前选择读取失败(
                L2结构状态::入口拒绝,
                L2状态当前选择读取状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记) {
                if (登记结果.状态 == L2状态结构类型登记状态::登记未加载)
                    return L2状态结构内部::形成当前选择读取失败(
                        L2结构状态::未找到,
                        L2状态当前选择读取状态::待迁移,
                        登记结果.事实截止代次);
                const auto 公共状态 = L2状态结构内部::映射登记失败为结构状态(
                    登记结果.状态);
                return L2状态结构内部::形成当前选择读取失败(公共状态,
                    L2状态结构内部::映射当前选择读取状态(公共状态),
                    登记结果.事实截止代次);
            }
            const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            const auto 实例状态 = L2状态结构内部::检查端点结果头(
                实例.结果头, 请求.请求头.期望事实代次);
            if (实例状态 != L2结构状态::已读取 || !实例.特征实例) {
                const auto 公共状态 = 实例状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 实例状态;
                return L2状态结构内部::形成当前选择读取失败(公共状态,
                    L2状态结构内部::映射当前选择读取状态(公共状态),
                    实例.结果头.事实截止代次);
            }
            if (实例.特征实例->身份 != 请求.特征实例
                || 实例.特征实例->生命周期.退出事实代次)
                return L2状态结构内部::形成当前选择读取失败(
                    L2结构状态::内部不一致,
                    L2状态当前选择读取状态::内部不一致,
                    请求.请求头.期望事实代次);
            const auto 关系类型 = 登记结果.登记->当前选择关系类型;
            L1所有者范围一致当前读取请求 L1请求;
            L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
            L1请求.期望事实代次 = 请求.请求头.期望事实代次;
            L1请求.所有者 = {第一层写入端口_.所有者身份()};
            L1请求.源关系组 = {{请求.特征实例.值, 关系类型.值}};
            const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
            const auto 顶层 = L2状态结构内部::解释一致读取顶层(
                读取, 请求.请求头.期望事实代次);
            if (!顶层.成功())
                return L2状态结构内部::形成当前选择读取失败(
                    顶层.状态,
                    L2状态结构内部::映射当前选择读取状态(顶层.状态),
                    顶层.截止);
            const auto* 关系组 = L2状态结构内部::查找唯一源关系组(
                读取, 请求.特征实例.值, 关系类型.值);
            if (读取.所有者.size() != 1 || !读取.节点.empty()
                || !读取.关系.empty() || !读取.值.empty()
                || !读取.属性值.empty() || 读取.源关系组.size() != 1
                || !读取.目标关系组.empty() || !关系组
                || 读取.所有者.front().状态
                    != L1所有者范围一致当前读取项目状态::成功
                || !读取.所有者.front().所有者事实)
                return L2状态结构内部::形成当前选择读取失败(
                    L2结构状态::内部不一致,
                    L2状态当前选择读取状态::内部不一致, 顶层.截止);
            if (关系组->成员.empty())
                return L2状态结构内部::形成当前选择读取失败(
                    L2结构状态::入口拒绝,
                    L2状态当前选择读取状态::待迁移, 顶层.截止);
            if (关系组->成员.size() != 1)
                return L2状态结构内部::形成当前选择读取失败(
                    L2结构状态::内部不一致,
                    L2状态当前选择读取状态::内部不一致, 顶层.截止);
            const auto& 成员 = 关系组->成员.front();
            const auto& 关系 = 成员.关系;
            if (关系.源节点 != 请求.特征实例.值
                || 关系.目标节点 != 成员.对端节点.编码
                || 关系.关系类型节点 != 关系类型.值
                || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                || 关系.写入所有者 != 第一层写入端口_.所有者身份()
                || 关系.退出事实代次
                || !L2状态结构内部::普通当前节点完整(
                    成员.对端节点, 关系.目标节点, 顶层.截止)
                || 成员.对端节点.写入所有者
                    != 第一层写入端口_.所有者身份())
                return L2状态结构内部::形成当前选择读取失败(
                    L2结构状态::内部不一致,
                    L2状态当前选择读取状态::内部不一致, 顶层.截止);
            const auto 状态 = 读取完整状态({请求.请求头, L2读取类别::当前,
                L2状态身份{关系.目标节点}, 0});
            if (状态.结果头.状态 != L2结构状态::已读取 || !状态.状态
                || 状态.结果头.事实截止代次 != 顶层.截止
                || 状态.状态->特征实例 != 请求.特征实例
                || 状态.状态->主体存在 != 实例.特征实例->宿主存在
                || 状态.状态->生命周期.退出事实代次
                || 状态.状态->生命周期.创建事实代次
                    != 关系.创建事实代次)
                return L2状态结构内部::形成当前选择读取失败(
                    状态.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 状态.结果头.状态,
                    L2状态当前选择读取状态::内部不一致,
                    状态.结果头.事实截止代次);
            auto 引用 = L2状态结构内部::形成当前选择关系引用(
                关系, 关系类型, 顶层.截止);
            L2状态当前选择读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 顶层.截止, std::nullopt},
                L2状态当前选择读取状态::已读取, std::move(引用), *状态.状态};
            return 结果.成功() ? 结果
                : L2状态结构内部::形成当前选择读取失败(
                    L2结构状态::内部不一致,
                    L2状态当前选择读取状态::内部不一致, 顶层.截止);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成当前选择读取失败(
                L2结构状态::资源失败,
                L2状态当前选择读取状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成当前选择读取失败(
                L2结构状态::资源失败,
                L2状态当前选择读取状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成当前选择读取失败(
                L2结构状态::内部不一致,
                L2状态当前选择读取状态::内部不一致);
        }
    }

    L2状态历史选择读取结果 读取特征实例历史状态选择(
        const L2状态历史选择读取请求& 请求) const noexcept {
        if (!L2状态历史选择读取请求有效(请求))
            return L2状态结构内部::形成历史选择读取失败(请求,
                L2结构状态::入口拒绝,
                L2状态历史选择读取状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记) {
                const auto 公共状态 = L2状态结构内部::映射登记失败为结构状态(
                    登记结果.状态);
                return L2状态结构内部::形成历史选择读取失败(请求,
                    公共状态,
                    L2状态结构内部::映射历史选择读取状态(公共状态),
                    登记结果.事实截止代次);
            }
            if (登记结果.事实截止代次 != 请求.请求头.期望事实代次)
                return L2状态结构内部::形成历史选择读取失败(请求,
                    L2结构状态::事实代次漂移,
                    L2状态历史选择读取状态::事实代次漂移,
                    登记结果.事实截止代次);
            const auto 实例来源 = 特征服务_.读取特征实例身份来源({
                请求.请求头, L2读取类别::当前, 请求.特征实例, 0});
            if (!实例来源.成功() || !实例来源.身份来源)
                return L2状态结构内部::形成历史选择读取失败(请求,
                    实例来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 实例来源.结果头.状态,
                    L2状态结构内部::映射历史选择读取状态(
                        实例来源.结果头.状态),
                    实例来源.结果头.事实截止代次);
            const auto 关系类型 = 登记结果.登记->当前选择关系类型;
            const auto 关系组 = L1_.读取所有者范围历史关系组({
                L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::源, 请求.特征实例.值,
                关系类型.值, 请求.历史截止事实代次});
            if (关系组.状态 != L1所有者范围读取状态::成功
                && 关系组.状态 != L1所有者范围读取状态::未找到) {
                const auto 公共状态 =
                    L2状态结构内部::映射历史关系组失败状态(关系组.状态);
                return L2状态结构内部::形成历史选择读取失败(请求,
                    公共状态,
                    L2状态结构内部::映射历史选择读取状态(公共状态),
                    关系组.读取事实代次);
            }
            if (关系组.读取事实代次 != 请求.请求头.期望事实代次)
                return L2状态结构内部::形成历史选择读取失败(请求,
                    L2结构状态::事实代次漂移,
                    L2状态历史选择读取状态::事实代次漂移,
                    关系组.读取事实代次);
            if (关系组.关系组.size() > 1)
                return L2状态结构内部::形成历史选择读取失败(请求,
                    L2结构状态::内部不一致,
                    L2状态历史选择读取状态::内部不一致,
                    请求.历史截止事实代次);
            if (关系组.关系组.empty()) {
                L2状态历史选择读取结果 结果{{L2结构合同版本,
                    L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
                    L2状态历史选择读取状态::已读取,
                    请求.历史截止事实代次, std::nullopt, std::nullopt};
                return 结果;
            }
            const auto& 关系 = 关系组.关系组.front();
            if (关系.源节点 != 请求.特征实例.值
                || 关系.关系类型节点 != 关系类型.值
                || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                || 关系.写入所有者 != 第一层写入端口_.所有者身份()
                || 关系.创建事实代次 == 0
                || 关系.创建事实代次 > 请求.历史截止事实代次
                || (关系.退出事实代次
                    && *关系.退出事实代次 <= 请求.历史截止事实代次))
                return L2状态结构内部::形成历史选择读取失败(请求,
                    L2结构状态::内部不一致,
                    L2状态历史选择读取状态::内部不一致,
                    请求.历史截止事实代次);
            const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                L2读取类别::历史, 请求.特征实例,
                请求.历史截止事实代次});
            const auto 状态 = 读取完整状态({请求.请求头, L2读取类别::历史,
                L2状态身份{关系.目标节点}, 请求.历史截止事实代次});
            if (实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例
                || 状态.结果头.状态 != L2结构状态::已读取 || !状态.状态
                || 实例.结果头.事实截止代次 != 请求.历史截止事实代次
                || 状态.结果头.事实截止代次 != 请求.历史截止事实代次
                || 状态.状态->身份.值 != 关系.目标节点
                || 状态.状态->特征实例 != 请求.特征实例
                || 状态.状态->主体存在 != 实例.特征实例->宿主存在
                || 状态.状态->生命周期.创建事实代次
                    != 关系.创建事实代次)
                return L2状态结构内部::形成历史选择读取失败(请求,
                    L2结构状态::内部不一致,
                    L2状态历史选择读取状态::内部不一致,
                    请求.历史截止事实代次);
            const auto 后代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (后代次.状态 != L1中性读取状态::成功
                || 后代次.事实代次 != 请求.请求头.期望事实代次) {
                const auto 公共状态 = 后代次.状态 == L1中性读取状态::成功
                    ? L2结构状态::事实代次漂移
                    : L2状态结构内部::映射事实代次探测失败(后代次.状态);
                return L2状态结构内部::形成历史选择读取失败(请求,
                    公共状态,
                    L2状态结构内部::映射历史选择读取状态(公共状态),
                    后代次.事实代次);
            }
            auto 引用 = L2状态结构内部::形成当前选择关系引用(
                关系, 关系类型, 请求.历史截止事实代次);
            L2状态历史选择读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
                L2状态历史选择读取状态::已读取,
                请求.历史截止事实代次, std::move(引用), *状态.状态};
            return 结果.成功() ? 结果
                : L2状态结构内部::形成历史选择读取失败(请求,
                    L2结构状态::内部不一致,
                    L2状态历史选择读取状态::内部不一致,
                    请求.历史截止事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成历史选择读取失败(请求,
                L2结构状态::资源失败,
                L2状态历史选择读取状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成历史选择读取失败(请求,
                L2结构状态::资源失败,
                L2状态历史选择读取状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成历史选择读取失败(请求,
                L2结构状态::内部不一致,
                L2状态历史选择读取状态::内部不一致);
        }
    }

    L2状态完整读取结果 读取完整状态(
        const L2状态完整读取请求& 请求) const {
        if (!L2状态完整读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (登记结果.状态 != L2状态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2状态结构内部::形成完整读取失败(请求,
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            return 请求.读取类别 == L2读取类别::当前
                ? 读取当前完整状态(请求, *登记结果.登记)
                : 读取历史完整状态(请求, *登记结果.登记);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前来源由 owner、锚点和唯一非自环归属同截止证明。
    L2状态身份来源读取结果 读取状态身份来源(
        const L2状态身份来源读取请求& 请求) const {
        if (!L2状态身份来源读取请求有效(请求)) return {};
        try {
            if (请求.状态.值 == 状态身份来源定位_.族锚点
                || 请求.状态.值 == 状态身份来源定位_.族归属关系类型)
                return {{L2结构合同版本, L2结构状态::入口拒绝,
                    请求.读取类别 == L2读取类别::当前
                        ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次,
                    std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (请求.读取类别 == L2读取类别::当前) {
                L1所有者范围一致当前读取请求 L1请求;
                L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
                L1请求.期望事实代次 = 请求.请求头.期望事实代次;
                L1请求.所有者 = {状态身份来源定位_.所有者};
                L1请求.节点 = {请求.状态.值, 状态身份来源定位_.族锚点,
                    状态身份来源定位_.族归属关系类型};
                L1请求.源关系组 = {{请求.状态.值,
                    状态身份来源定位_.族归属关系类型}};
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
                const auto 顶层 = L2状态结构内部::解释一致读取顶层(
                    读取, 请求.请求头.期望事实代次);
                if (!顶层.成功()) return {{L2结构合同版本, 顶层.状态,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (读取.所有者.size() != 1 || 读取.节点.size() != 3
                    || !读取.关系.empty() || !读取.值.empty()
                    || !读取.属性值.empty() || 读取.源关系组.size() != 1
                    || !读取.目标关系组.empty())
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto* 节点项 = L2状态结构内部::查找唯一节点项(
                    读取, 请求.状态.值);
                const auto* 锚点项 = L2状态结构内部::查找唯一节点项(
                    读取, 状态身份来源定位_.族锚点);
                const auto* 类型项 = L2状态结构内部::查找唯一节点项(
                    读取, 状态身份来源定位_.族归属关系类型);
                const auto* 关系组 = L2状态结构内部::查找唯一源关系组(
                    读取, 请求.状态.值, 状态身份来源定位_.族归属关系类型);
                if (!节点项 || !锚点项 || !类型项 || !关系组)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
                    const auto 状态 = 节点项->状态
                            == L1所有者范围一致当前读取项目状态::未找到
                        ? L2结构状态::未找到
                        : 节点项->状态
                            == L1所有者范围一致当前读取项目状态::已退出
                            ? L2结构状态::已退出 : L2结构状态::入口拒绝;
                    return {{L2结构合同版本, 节点项->事实
                            ? L2结构状态::内部不一致 : 状态,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                }
                if (!节点项->事实 || !锚点项->事实 || !类型项->事实
                    || 读取.所有者.front().状态
                        != L1所有者范围一致当前读取项目状态::成功
                    || !读取.所有者.front().所有者事实 || 关系组->成员.size() != 1)
                    return {{L2结构合同版本, 关系组->成员.empty()
                            ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 节点 = *节点项->事实;
                const auto& 锚点 = *锚点项->事实;
                const auto& 类型 = *类型项->事实;
                const auto& 关系 = 关系组->成员.front().关系;
                if (节点.写入所有者 != 状态身份来源定位_.所有者
                    || 节点.种类 != 节点种类::普通 || 节点.属性类型表示
                    || 节点.退出事实代次 || 锚点.编码 != 状态身份来源定位_.族锚点
                    || 类型.编码 != 状态身份来源定位_.族归属关系类型
                    || 锚点.写入所有者 != 状态身份来源定位_.所有者
                    || 类型.写入所有者 != 状态身份来源定位_.所有者
                    || 关系.写入所有者 != 状态身份来源定位_.所有者
                    || 关系.源节点 != 请求.状态.值
                    || 关系.目标节点 != 状态身份来源定位_.族锚点
                    || 关系.关系类型节点 != 状态身份来源定位_.族归属关系类型
                    || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                    || 关系.退出事实代次 || 关系.创建事实代次 != 节点.创建事实代次)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 所有者 = *读取.所有者.front().所有者事实;
                if (所有者.所有者 != 状态身份来源定位_.所有者
                    || 所有者.范围种类 != L1所有者范围种类::独占结构范围
                    || 所有者.退出事实代次)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                L2节点族身份来源事实 来源{L2节点族::状态, 节点.编码,
                    锚点.编码, 类型.编码, 关系.编码, 关系.角色或顺序,
                    {节点.创建事实代次, 节点.退出事实代次},
                    {锚点.创建事实代次, 锚点.退出事实代次},
                    {类型.创建事实代次, 类型.退出事实代次},
                    {关系.创建事实代次, 关系.退出事实代次}};
                L2状态身份来源读取结果 结果{{L2结构合同版本,
                    L2结构状态::已读取, 顶层.截止, std::nullopt},
                    请求.读取类别, 0, std::move(来源)};
                return 结果.成功() ? 结果 : L2状态身份来源读取结果{{
                    L2结构合同版本, L2结构状态::内部不一致,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
            }
            const auto 当前代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 != 请求.请求头.期望事实代次)
                return {{L2结构合同版本,
                    当前代次.状态 == L1中性读取状态::成功
                        ? L2结构状态::事实代次漂移
                        : L2状态结构内部::映射事实代次探测失败(当前代次.状态),
                    当前代次.事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 节点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.状态.值});
            const auto 所有者读取 = L1_.读取历史结构所有者(
                {L1所有者范围CRUD合同版本, 状态身份来源定位_.所有者});
            const auto 锚点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 状态身份来源定位_.族锚点});
            const auto 类型读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 状态身份来源定位_.族归属关系类型});
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
            const auto* 锚点 = 锚点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
            const auto* 类型 = 类型读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
            if (节点读取.状态 != L1所有者范围读取状态::成功)
                return {{L2结构合同版本,
                    L2状态结构内部::映射历史读取状态(节点读取.状态),
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (!节点 || !锚点 || !类型 || !所有者读取.所有者事实
                || 所有者读取.所有者事实->所有者 != 状态身份来源定位_.所有者
                || 所有者读取.所有者事实->范围种类
                    != L1所有者范围种类::独占结构范围
                || 节点->写入所有者 != 状态身份来源定位_.所有者
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 > 请求.历史截止事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const std::uint64_t 关系截止 = 节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次
                ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
            const auto 关系组 = L1_.读取所有者范围历史关系组({
                L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                请求.状态.值, 状态身份来源定位_.族归属关系类型, 关系截止});
            if (关系组.状态 != L1所有者范围读取状态::成功
                || 关系组.关系组.size() != 1)
                return {{L2结构合同版本, 关系组.关系组.empty()
                        ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto& 关系 = 关系组.关系组.front();
            if (关系.写入所有者 != 状态身份来源定位_.所有者
                || 关系.源节点 != 请求.状态.值
                || 关系.目标节点 != 状态身份来源定位_.族锚点
                || 关系.关系类型节点 != 状态身份来源定位_.族归属关系类型
                || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                || 关系.创建事实代次 != 节点->创建事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 投影生命周期 = [&](std::uint64_t 创建,
                std::optional<std::uint64_t> 退出) noexcept {
                if (退出 && *退出 > 请求.历史截止事实代次) 退出.reset();
                return L2生命周期{创建, 退出};
            };
            L2节点族身份来源事实 来源{L2节点族::状态, 节点->编码,
                锚点->编码, 类型->编码, 关系.编码,
                关系.角色或顺序,
                投影生命周期(节点->创建事实代次, 节点->退出事实代次),
                投影生命周期(锚点->创建事实代次, 锚点->退出事实代次),
                投影生命周期(类型->创建事实代次, 类型->退出事实代次),
                投影生命周期(关系.创建事实代次, 关系.退出事实代次)};
            L2状态身份来源读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::move(来源)};
            return 结果.成功() ? 结果 : L2状态身份来源读取结果{{
                L2结构合同版本, L2结构状态::内部不一致,
                请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        }
    }

    L2当前状态组读取结果 按主体读取全部当前状态(
        const L2按主体当前状态读取请求& 请求) const {
        if (!L2按主体当前状态读取请求有效(请求)) return {};
        try {
            const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                L2读取类别::当前, 请求.主体存在, 0});
            if (!主体来源.成功() || !主体来源.身份来源)
                return L2状态结构内部::形成组读取失败(
                    主体来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源.结果头.状态,
                    主体来源.结果头.事实截止代次);
            const auto 主体 = 存在服务_.读取完整存在({请求.请求头,
                L2读取类别::当前, 请求.主体存在, 0});
            const auto 主体状态 = L2状态结构内部::检查端点结果头(
                主体.结果头, 请求.请求头.期望事实代次);
            if (主体状态 != L2结构状态::已读取 || !主体.存在)
                return L2状态结构内部::形成组读取失败(
                    主体状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体状态,
                    主体.结果头.事实截止代次);
            if (主体.存在->身份 != 请求.主体存在
                || 主体.存在->生命周期.退出事实代次)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 请求.请求头.期望事实代次);
            return 按端点读取状态组(
                请求.请求头, 请求.主体存在.值, true, 请求.最大数量);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前状态组读取结果 按特征实例读取全部当前状态(
        const L2按特征实例当前状态读取请求& 请求) const {
        if (!L2按特征实例当前状态读取请求有效(请求)) return {};
        try {
            const auto 实例来源 = 特征服务_.读取特征实例身份来源({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            if (!实例来源.成功() || !实例来源.身份来源)
                return L2状态结构内部::形成组读取失败(
                    实例来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 实例来源.结果头.状态,
                    实例来源.结果头.事实截止代次);
            const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            const auto 实例状态 = L2状态结构内部::检查端点结果头(
                实例.结果头, 请求.请求头.期望事实代次);
            if (实例状态 != L2结构状态::已读取 || !实例.特征实例)
                return L2状态结构内部::形成组读取失败(
                    实例状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 实例状态,
                    实例.结果头.事实截止代次);
            if (实例.特征实例->身份 != 请求.特征实例
                || 实例.特征实例->生命周期.退出事实代次)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 请求.请求头.期望事实代次);
            return 按端点读取状态组(
                请求.请求头, 请求.特征实例.值, false, 请求.最大数量);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前状态组读取结果 按来源读取全部当前状态(
        const L2按来源当前状态读取请求& 请求) const {
        if (!L2按来源当前状态读取请求有效(请求))
            return L2状态结构内部::形成组读取失败(L2结构状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (登记结果.状态 != L2状态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2状态结构内部::形成组读取失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            constexpr auto 最大整数 = (std::numeric_limits<std::uint64_t>::max)();
            const auto 半最大整数 = 最大整数 / 2;
            const auto 第一层预算 = 请求.最大数量 >= 半最大整数
                ? 最大整数 : (请求.最大数量 + 1) * 2;
            const auto 候选上限 = 请求.最大数量 == 最大整数
                ? 最大整数 : 请求.最大数量 + 1;
            const auto 读取 = L1_.按来源读取所有者范围全部当前值({
                L1所有者范围来源当前值组读取合同版本,
                状态身份来源定位_.所有者, 请求.来源稳定编码,
                请求.请求头.期望事实代次, 第一层预算});
            if (读取.合同版本 != L1所有者范围来源当前值组读取合同版本
                || 读取.所有者 != 状态身份来源定位_.所有者
                || 读取.来源节点 != 请求.来源稳定编码
                || 读取.期望事实代次 != 请求.请求头.期望事实代次)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
            if (读取.状态 != L1所有者范围来源当前值组读取状态::成功) {
                if (!读取.当前值.empty())
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                return L2状态结构内部::形成组读取失败(
                    L2状态结构内部::映射来源值组读取失败状态(读取.状态),
                    读取.读取事实代次);
            }
            if (读取.读取事实代次 != 请求.请求头.期望事实代次
                || 读取.读取事实代次 == 0
                || 读取.当前值.size() > 第一层预算)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);

            struct 候选值角色 final {
                稳定编码 状态;
                std::uint8_t 角色 = 0;
            };
            std::vector<候选值角色> 候选值;
            候选值.reserve(读取.当前值.size());
            const auto 是精确类型 = [&](稳定编码 类型) noexcept {
                return 类型 == 登记.精确I64值类型.值
                    || 类型 == 登记.精确I64组值类型.值
                    || 类型 == 登记.精确U64组值类型.值
                    || 类型 == 登记.精确独立材料值类型.值;
            };
            const auto 是时间类型 = [&](稳定编码 类型) noexcept {
                return 类型 == 登记.时间I64值类型.值
                    || 类型 == 登记.时间I64组值类型.值
                    || 类型 == 登记.时间U64组值类型.值
                    || 类型 == 登记.时间独立材料值类型.值;
            };
            for (const auto& 值 : 读取.当前值) {
                const bool 精确 = 是精确类型(值.属性类型节点);
                const bool 时间 = 是时间类型(值.属性类型节点);
                if (!有效(值.编码) || !有效(值.所属节点)
                    || 值.来源节点 != 请求.来源稳定编码
                    || 值.写入所有者 != 状态身份来源定位_.所有者
                    || 值.创建事实代次 == 0
                    || 值.创建事实代次 > 读取.读取事实代次
                    || 值.退出事实代次 || 精确 == 时间)
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                候选值.push_back({值.所属节点,
                    static_cast<std::uint8_t>(精确 ? 1 : 2)});
            }
            std::sort(候选值.begin(), 候选值.end(),
                [](const 候选值角色& 左, const 候选值角色& 右) noexcept {
                    if (左.状态 != 右.状态) return 左.状态 < 右.状态;
                    return 左.角色 < 右.角色;
                });
            std::vector<稳定编码> 状态编码组;
            状态编码组.reserve(候选值.size() / 2);
            for (std::size_t 索引 = 0; 索引 < 候选值.size();) {
                if (索引 + 1 >= 候选值.size()
                    || 候选值[索引].角色 != 1
                    || 候选值[索引 + 1].角色 != 2
                    || 候选值[索引].状态 != 候选值[索引 + 1].状态)
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                状态编码组.push_back(候选值[索引].状态);
                索引 += 2;
            }
            if (状态编码组.size() > 候选上限)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);

            L2当前状态组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 读取.读取事实代次, std::nullopt}, {}};
            结果.状态.reserve(状态编码组.size());
            for (const auto 编码 : 状态编码组) {
                const auto 单项 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, L2状态身份{编码}, 0});
                if (单项.结果头.状态 != L2结构状态::已读取
                    || !单项.状态
                    || 单项.结果头.事实截止代次 != 读取.读取事实代次) {
                    const auto 状态 = 单项.结果头.状态
                            == L2结构状态::事实代次漂移
                        || 单项.结果头.状态 == L2结构状态::资源失败
                        ? 单项.结果头.状态 : L2结构状态::内部不一致;
                    return L2状态结构内部::形成组读取失败(
                        状态, 单项.结果头.事实截止代次);
                }
                if (单项.状态->身份 != L2状态身份{编码}
                    || 单项.状态->来源稳定编码 != 请求.来源稳定编码
                    || 单项.状态->生命周期.退出事实代次
                    || !L2状态事实完整(*单项.状态, 登记,
                        读取.读取事实代次))
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                结果.状态.push_back(*单项.状态);
            }
            if (结果.状态.size() > 请求.最大数量)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::数量预算不足, 读取.读取事实代次);
            return 结果.成功() ? 结果
                : L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成组读取失败(
                L2结构状态::内部不一致);
        }
    }

    L2当前状态组读取结果 按I64时间范围读取全部当前状态(
        const L2按I64时间范围当前状态读取请求& 请求) const {
        if (!L2按I64时间范围当前状态读取请求有效(请求))
            return L2状态结构内部::形成组读取失败(L2结构状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (登记结果.状态 != L2状态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2状态结构内部::形成组读取失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 读取 = L1_.按属性类型读取所有者范围全部当前值({
                L1所有者范围属性类型当前值组读取合同版本,
                状态身份来源定位_.所有者, 登记.时间I64值类型.值,
                请求.请求头.期望事实代次, 请求.最大候选数量});
            if (读取.合同版本
                    != L1所有者范围属性类型当前值组读取合同版本
                || 读取.所有者 != 状态身份来源定位_.所有者
                || 读取.属性类型节点 != 登记.时间I64值类型.值
                || 读取.期望事实代次 != 请求.请求头.期望事实代次)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
            if (读取.状态
                != L1所有者范围属性类型当前值组读取状态::成功) {
                if (!读取.当前值.empty())
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                return L2状态结构内部::形成组读取失败(
                    L2状态结构内部::映射属性类型值组读取失败状态(
                        读取.状态),
                    读取.读取事实代次);
            }
            if (读取.读取事实代次 != 请求.请求头.期望事实代次
                || 读取.读取事实代次 == 0
                || 读取.当前值.size() > 请求.最大候选数量)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);

            struct I64时间候选 final {
                稳定编码 状态;
                稳定编码 时间值;
                std::int64_t 时间I64 = 0;
            };
            std::vector<I64时间候选> 候选;
            候选.reserve(读取.当前值.size());
            std::uint64_t 前一值编码 = 0;
            for (const auto& 值 : 读取.当前值) {
                const auto 时间 = std::get_if<std::int64_t>(&值.材料);
                if (!有效(值.编码) || 值.编码.值 <= 前一值编码
                    || !有效(值.所属节点) || !有效(值.来源节点)
                    || 值.属性类型节点 != 登记.时间I64值类型.值
                    || 值.写入所有者 != 状态身份来源定位_.所有者
                    || 值.创建事实代次 == 0
                    || 值.创建事实代次 > 读取.读取事实代次
                    || 值.退出事实代次 || !时间)
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                前一值编码 = 值.编码.值;
                if (*时间 < 请求.最小时间I64
                    || *时间 > 请求.最大时间I64) continue;
                候选.push_back({值.所属节点, 值.编码, *时间});
            }
            if (候选.size() > 请求.最大返回数量)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::数量预算不足, 读取.读取事实代次);
            std::sort(候选.begin(), 候选.end(),
                [](const I64时间候选& 左,
                    const I64时间候选& 右) noexcept {
                    return 左.状态 < 右.状态;
                });
            for (std::size_t 索引 = 1; 索引 < 候选.size(); ++索引)
                if (!(候选[索引 - 1].状态 < 候选[索引].状态))
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);

            L2当前状态组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 读取.读取事实代次, std::nullopt}, {}};
            结果.状态.reserve(候选.size());
            for (const auto& 项 : 候选) {
                const auto 单项 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, L2状态身份{项.状态}, 0});
                if (单项.结果头.状态 != L2结构状态::已读取
                    || !单项.状态
                    || 单项.结果头.事实截止代次 != 读取.读取事实代次) {
                    const auto 状态 = 单项.结果头.状态
                            == L2结构状态::事实代次漂移
                        || 单项.结果头.状态 == L2结构状态::资源失败
                        ? 单项.结果头.状态 : L2结构状态::内部不一致;
                    return L2状态结构内部::形成组读取失败(
                        状态, 单项.结果头.事实截止代次);
                }
                const auto 时间 = std::get_if<std::int64_t>(
                    &单项.状态->时间值.类型化不可变材料);
                if (单项.状态->身份 != L2状态身份{项.状态}
                    || 单项.状态->生命周期.退出事实代次
                    || !L2状态事实完整(*单项.状态, 登记,
                        读取.读取事实代次)
                    || 单项.状态->时间值.属性类型身份
                        != 登记.时间I64值类型.值
                    || 单项.状态->时间值.值稳定编码 != 项.时间值
                    || !时间 || *时间 != 项.时间I64
                    || *时间 < 请求.最小时间I64
                    || *时间 > 请求.最大时间I64)
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                结果.状态.push_back(*单项.状态);
            }
            return 结果.成功() ? 结果
                : L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成组读取失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；主体与实例两条关系只在一份写集中原子替换。
    L2状态引用替换结果 替换状态引用(const L2状态引用替换请求& 请求) {
        if (!L2状态引用替换请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2状态结构内部::形成引用替换失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(请求.幂等身份);
            写集.关系 = {
                {{L2状态结构内部::状态主体关系本地键值}, 请求.状态.值,
                    请求.新主体存在.值, 登记.主体关系类型.值,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态特征实例关系本地键值}, 请求.状态.值,
                    请求.新特征实例.值, 登记.特征实例关系类型.值,
                    L2状态结构内部::状态端点角色值}};
            写集.退出事实 = {请求.旧引用.主体关系稳定编码,
                请求.旧引用.特征实例关系稳定编码};
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成引用替换失败(
                    L2状态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            std::optional<L2状态事实> 写前状态;
            std::optional<L2状态自有关系引用> 写前关系;
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.状态 || !当前.自有关系)
                    return L2状态结构内部::形成引用替换失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                if (当前.自有关系->主体关系稳定编码
                        != 请求.旧引用.主体关系稳定编码
                    || 当前.自有关系->特征实例关系稳定编码
                        != 请求.旧引用.特征实例关系稳定编码
                    || (当前.状态->主体存在 == 请求.新主体存在
                        && 当前.状态->特征实例 == 请求.新特征实例))
                    return L2状态结构内部::形成引用替换失败(
                        L2结构状态::引用冲突, 代次.事实代次);
                写前状态 = *当前.状态;
                写前关系 = *当前.自有关系;
                const auto 状态来源 = 读取状态身份来源({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.新主体存在, 0});
                const auto 实例来源 = 特征服务_.读取特征实例身份来源({请求.请求头,
                    L2读取类别::当前, 请求.新特征实例, 0});
                const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.新特征实例, 0});
                if (!状态来源.成功() || !主体来源.成功() || !实例来源.成功()
                    || 实例.结果头.状态 != L2结构状态::已读取
                    || !状态来源.身份来源 || !主体来源.身份来源
                    || !实例来源.身份来源
                    || !实例.特征实例)
                    return L2状态结构内部::形成引用替换失败(
                        !状态来源.成功() ? 状态来源.结果头.状态
                            : !主体来源.成功() ? 主体来源.结果头.状态
                            : !实例来源.成功() ? 实例来源.结果头.状态
                            : 实例.结果头.状态,
                        代次.事实代次);
                if (状态来源.结果头.事实截止代次 != 代次.事实代次
                    || 主体来源.结果头.事实截止代次 != 代次.事实代次
                    || 实例来源.结果头.事实截止代次 != 代次.事实代次
                    || 实例.结果头.事实截止代次 != 代次.事实代次
                    || 状态来源.身份来源->节点稳定编码 != 请求.状态.值
                    || 主体来源.身份来源->节点稳定编码 != 请求.新主体存在.值
                    || 实例来源.身份来源->节点稳定编码 != 请求.新特征实例.值
                    || 实例.特征实例->身份 != 请求.新特征实例
                    || 实例.特征实例->宿主存在 != 请求.新主体存在)
                    return L2状态结构内部::形成引用替换失败(
                        实例.特征实例->宿主存在 != 请求.新主体存在
                            ? L2结构状态::引用冲突 : L2结构状态::内部不一致,
                        代次.事实代次);
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
            if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成引用替换失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成引用替换失败(状态码, 写入.事实代次);
            }
            const auto 新主体关系 = L2状态结构内部::查找编码映射(
                写入, L2状态结构内部::状态主体关系本地键值);
            const auto 新实例关系 = L2状态结构内部::查找编码映射(
                写入, L2状态结构内部::状态特征实例关系本地键值);
            if (!L2状态结构内部::写入成功边界完整(写入)
                || 写入.新编码映射.size() != 2 || !新主体关系 || !新实例关系
                || *新主体关系 == *新实例关系)
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < 写入.事实代次)
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 首次状态 = 读取完整状态({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.状态, 写入.事实代次});
            const auto 读取旧关系 = [&](稳定编码 编码) {
                return L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 编码});
            };
            const auto 主体旧读取 = 读取旧关系(请求.旧引用.主体关系稳定编码);
            const auto 实例旧读取 = 读取旧关系(请求.旧引用.特征实例关系稳定编码);
            const auto* 主体旧 = 主体旧读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*主体旧读取.事实) : nullptr;
            const auto* 实例旧 = 实例旧读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*实例旧读取.事实) : nullptr;
            const auto 主体退出 = 主体旧
                ? L2状态结构内部::形成关系退出事实(*主体旧, 写入.事实代次) : std::nullopt;
            const auto 实例退出 = 实例旧
                ? L2状态结构内部::形成关系退出事实(*实例旧, 写入.事实代次) : std::nullopt;
            const auto 所有者 = 第一层写入端口_.所有者身份();
            if (首次状态.结果头.状态 != L2结构状态::已读取 || !首次状态.状态
                || !首次状态.自有关系 || !主体退出 || !实例退出
                || 首次状态.状态->主体存在 != 请求.新主体存在
                || 首次状态.状态->特征实例 != 请求.新特征实例
                || 首次状态.自有关系->主体关系稳定编码 != *新主体关系
                || 首次状态.自有关系->特征实例关系稳定编码 != *新实例关系
                || !L2状态结构内部::历史关系匹配(*主体旧,
                    请求.旧引用.主体关系稳定编码, 请求.状态.值,
                    写前状态 ? 写前状态->主体存在.值 : 主体旧->目标节点,
                    登记.主体关系类型.值, 所有者, 写入.事实代次)
                || !L2状态结构内部::历史关系匹配(*实例旧,
                    请求.旧引用.特征实例关系稳定编码, 请求.状态.值,
                    写前状态 ? 写前状态->特征实例.值 : 实例旧->目标节点,
                    登记.特征实例关系类型.值, 所有者, 写入.事实代次)
                || (写前状态 && (!L2状态结构内部::状态未改字段相同(
                        *写前状态, *首次状态.状态)
                    || 写前状态->精确值 != 首次状态.状态->精确值
                    || 写前状态->时间值 != 首次状态.状态->时间值))
                || (写前关系 && 首次状态.自有关系->族归属关系稳定编码
                    != 写前关系->族归属关系稳定编码))
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2状态引用替换结果 结果{{L2结构合同版本, 状态码,
                写入.事实代次, 写入.事实代次}, *首次状态.状态,
                *首次状态.自有关系, L2状态引用对关系退出投影{
                    *主体退出, *实例退出}};
            return 结果.成功() ? 结果 : L2状态结构内部::形成引用替换失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成引用替换失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成引用替换失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成引用替换失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；所选角色的新值、槽切换和旧值退出同代发布。
    L2状态值换代结果 换代状态值(const L2状态值换代请求& 请求) {
        if (!L2状态值换代请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2状态结构内部::形成值换代失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const bool 精确角色 = 请求.值角色 == L2状态值角色::精确值;
            const auto 类型 = L2状态结构内部::选择状态值类型编码(
                登记, 请求.新值材料, 精确角色);
            const auto 本地键 = 精确角色
                ? L2状态结构内部::状态精确值本地键值
                : L2状态结构内部::状态时间值本地键值;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(请求.幂等身份);
            写集.值 = {{{本地键}, 请求.状态.值, 类型,
                L2状态结构内部::转换为L1材料(请求.新值材料),
                请求.来源稳定编码}};
            写集.属性槽变更 = {{请求.状态.值, 类型, {本地键}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成值换代失败(
                    L2状态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            std::optional<L2状态事实> 写前状态;
            std::optional<L2状态自有关系引用> 写前关系;
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.状态 || !当前.自有关系)
                    return L2状态结构内部::形成值换代失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                const auto& 旧值 = 精确角色 ? 当前.状态->精确值 : 当前.状态->时间值;
                if (旧值.值稳定编码 != 请求.旧值稳定编码
                    || 当前.状态->来源稳定编码 != 请求.来源稳定编码
                    || 当前.状态->精确值.来源稳定编码 != 请求.来源稳定编码
                    || 当前.状态->时间值.来源稳定编码 != 请求.来源稳定编码)
                    return L2状态结构内部::形成值换代失败(
                        L2结构状态::引用冲突, 代次.事实代次);
                写前状态 = *当前.状态;
                写前关系 = *当前.自有关系;
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
            if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成值换代失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成值换代失败(状态码, 写入.事实代次);
            }
            const auto 新值编码 = L2状态结构内部::查找编码映射(写入, 本地键);
            if (!L2状态结构内部::写入成功边界完整(写入)
                || 写入.新编码映射.size() != 1 || !新值编码)
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < 写入.事实代次)
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 首次状态 = 读取完整状态({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.状态, 写入.事实代次});
            const auto 旧读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.旧值稳定编码});
            const auto* 旧值 = 旧读取.事实
                ? std::get_if<L1所有者范围值事实>(&*旧读取.事实) : nullptr;
            const auto 已退出值 = 旧值
                ? L2状态结构内部::形成截止属性事实(
                    *旧值, 登记, 写入.事实代次, 精确角色) : std::nullopt;
            const auto& 当前角色值 = 首次状态.状态
                ? (精确角色 ? 首次状态.状态->精确值 : 首次状态.状态->时间值)
                : L2属性事实{};
            const auto 预期旧类型 = 写前状态
                ? (精确角色 ? 写前状态->精确值.属性类型身份
                    : 写前状态->时间值.属性类型身份)
                : (旧值 ? 旧值->属性类型节点 : 稳定编码{});
            const auto& 另一角色值 = 首次状态.状态
                ? (精确角色 ? 首次状态.状态->时间值 : 首次状态.状态->精确值)
                : L2属性事实{};
            if (首次状态.结果头.状态 != L2结构状态::已读取
                || !首次状态.状态 || !首次状态.自有关系 || !已退出值
                || 当前角色值.值稳定编码 != *新值编码
                || 当前角色值.类型化不可变材料 != 请求.新值材料
                || 当前角色值.来源稳定编码 != 请求.来源稳定编码
                || 已退出值->值稳定编码 != 请求.旧值稳定编码
                || 已退出值->退出事实代次 != 写入.事实代次
                || !旧值 || 旧值->所属节点 != 请求.状态.值
                || 旧值->属性类型节点 != 预期旧类型
                || 旧值->来源节点 != 请求.来源稳定编码
                || 旧值->写入所有者 != 第一层写入端口_.所有者身份()
                || (写前状态 && (!L2状态结构内部::状态未改字段相同(
                        *写前状态, *首次状态.状态)
                    || 另一角色值 != (精确角色
                        ? 写前状态->时间值 : 写前状态->精确值)))
                || (写前关系 && *写前关系 != *首次状态.自有关系))
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2状态值换代结果 结果{{L2结构合同版本, 状态码,
                写入.事实代次, 写入.事实代次}, *首次状态.状态,
                *首次状态.自有关系, *已退出值};
            return 结果.成功() ? 结果 : L2状态结构内部::形成值换代失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成值换代失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成值换代失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成值换代失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；状态节点及五项自有事实由一份闭包写集退出。
    L2状态退出结果 退出状态(const L2状态退出请求& 请求) {
        if (!L2状态退出请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2状态结构内部::形成状态退出失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(请求.幂等身份);
            写集.退出事实 = {请求.状态.值,
                请求.自有事实闭包.自有关系.族归属关系稳定编码,
                请求.自有事实闭包.自有关系.主体关系稳定编码,
                请求.自有事实闭包.自有关系.特征实例关系稳定编码,
                请求.自有事实闭包.精确值稳定编码,
                请求.自有事实闭包.时间值稳定编码};
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成状态退出失败(
                    L2状态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.状态 || !当前.自有关系)
                    return L2状态结构内部::形成状态退出失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                if (*当前.自有关系 != 请求.自有事实闭包.自有关系
                    || 当前.状态->精确值.值稳定编码
                        != 请求.自有事实闭包.精确值稳定编码
                    || 当前.状态->时间值.值稳定编码
                        != 请求.自有事实闭包.时间值稳定编码)
                    return L2状态结构内部::形成状态退出失败(
                        L2结构状态::引用冲突, 代次.事实代次);
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
            if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成状态退出失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成状态退出失败(状态码, 写入.事实代次);
            }
            if (!L2状态结构内部::写入成功边界完整(写入)
                || !写入.新编码映射.empty())
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < 写入.事实代次)
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 历史 = 读取完整状态({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.状态, 写入.事实代次});
            const auto 读关系 = [&](稳定编码 编码) {
                return L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 编码});
            };
            const auto 族读取 = 读关系(请求.自有事实闭包.自有关系.族归属关系稳定编码);
            const auto 主体读取 = 读关系(请求.自有事实闭包.自有关系.主体关系稳定编码);
            const auto 实例读取 = 读关系(请求.自有事实闭包.自有关系.特征实例关系稳定编码);
            const auto* 族 = 族读取.事实 ? std::get_if<L1所有者范围关系事实>(&*族读取.事实) : nullptr;
            const auto* 主体 = 主体读取.事实 ? std::get_if<L1所有者范围关系事实>(&*主体读取.事实) : nullptr;
            const auto* 实例 = 实例读取.事实 ? std::get_if<L1所有者范围关系事实>(&*实例读取.事实) : nullptr;
            const auto 族退出 = 族 ? L2状态结构内部::形成关系退出事实(*族, 写入.事实代次) : std::nullopt;
            const auto 主体退出 = 主体 ? L2状态结构内部::形成关系退出事实(*主体, 写入.事实代次) : std::nullopt;
            const auto 实例退出 = 实例 ? L2状态结构内部::形成关系退出事实(*实例, 写入.事实代次) : std::nullopt;
            const auto 所有者 = 第一层写入端口_.所有者身份();
            const auto& 来源 = 历史.状态 ? 历史.状态->来源稳定编码 : 稳定编码{};
            if (历史.结果头.状态 != L2结构状态::已读取 || !历史.状态
                || !历史.自有关系 || !族退出 || !主体退出 || !实例退出
                || *历史.自有关系 != 请求.自有事实闭包.自有关系
                || 历史.状态->生命周期.退出事实代次 != 写入.事实代次
                || 历史.状态->精确值.退出事实代次 != 写入.事实代次
                || 历史.状态->时间值.退出事实代次 != 写入.事实代次
                || 历史.状态->精确值.来源稳定编码 != 来源
                || 历史.状态->时间值.来源稳定编码 != 来源
                || !L2状态结构内部::历史关系匹配(*族,
                    请求.自有事实闭包.自有关系.族归属关系稳定编码,
                    请求.状态.值, 状态身份来源定位_.族锚点,
                    状态身份来源定位_.族归属关系类型, 所有者, 写入.事实代次)
                || !L2状态结构内部::历史关系匹配(*主体,
                    请求.自有事实闭包.自有关系.主体关系稳定编码,
                    请求.状态.值, 历史.状态->主体存在.值,
                    登记.主体关系类型.值, 所有者, 写入.事实代次)
                || !L2状态结构内部::历史关系匹配(*实例,
                    请求.自有事实闭包.自有关系.特征实例关系稳定编码,
                    请求.状态.值, 历史.状态->特征实例.值,
                    登记.特征实例关系类型.值, 所有者, 写入.事实代次)
                || 历史.状态->精确值.值稳定编码
                    != 请求.自有事实闭包.精确值稳定编码
                || 历史.状态->时间值.值稳定编码
                    != 请求.自有事实闭包.时间值稳定编码)
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2状态退出结果 结果{{L2结构合同版本, 状态码,
                写入.事实代次, 写入.事实代次}, *历史.状态,
                L2状态自有关系退出投影{*族退出, *主体退出, *实例退出}};
            return 结果.成功() ? 结果 : L2状态结构内部::形成状态退出失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成状态退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成状态退出失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成状态退出失败(L2结构状态::内部不一致);
        }
    }

    L2状态原子参与者形成结果 形成状态原子参与者写集(
        const L2状态原子参与者请求& 请求) const noexcept {
        L2状态原子参与者形成结果 失败{L2结构状态::内部不一致,
            请求.共同期望事实代次, std::nullopt, {}, std::nullopt};
        if (请求.合同版本 != L2结构合同版本
            || 请求.共同期望事实代次 == 0
            || !有效(请求.组合写入幂等身份)
            || !有效(请求.主体存在.值)
            || !有效(请求.旧当前状态.值)
            || !有效(请求.新状态特征实例.值)
            || !有效(请求.来源方法稳定编码)
            || !L2状态当前选择关系引用完整(
                请求.旧当前选择, 请求.共同期望事实代次)
            || 请求.旧当前选择.特征实例 != 请求.新状态特征实例
            || 请求.旧当前选择.状态 != 请求.旧当前状态
            || 请求.旧当前选择.生命周期.退出事实代次) {
            失败.状态 = L2结构状态::入口拒绝;
            return 失败;
        }
        try {
            const auto 代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (代次.状态 != L1中性读取状态::成功)
                失败.状态 = L2状态结构内部::映射事实代次探测失败(代次.状态);
            else if (!登记结果.成功() || !登记结果.登记)
                失败.状态 = L2结构状态::内部不一致;
            else {
                const bool 仅形成幂等重放候选 =
                    代次.事实代次 != 请求.共同期望事实代次;
                bool 上下文有效 = true;
                bool 引用有效 = true;
                if (!仅形成幂等重放候选) {
                const auto 旧 = 读取完整状态({
                    {L2结构合同版本, 请求.共同期望事实代次},
                    L2读取类别::当前, 请求.旧当前状态, 0});
                const auto 当前选择 = 读取特征实例当前状态选择({
                    {L2结构合同版本, 请求.共同期望事实代次},
                    请求.新状态特征实例});
                const auto 主体来源 = 存在服务_.读取存在身份来源({
                    {L2结构合同版本, 请求.共同期望事实代次},
                    L2读取类别::当前, 请求.主体存在, 0});
                const auto 实例来源 = 特征服务_.读取特征实例身份来源({
                    {L2结构合同版本, 请求.共同期望事实代次},
                    L2读取类别::当前, 请求.新状态特征实例, 0});
                if (旧.结果头.状态 != L2结构状态::已读取 || !旧.状态
                    || !旧.自有关系 || 旧.状态->生命周期.退出事实代次
                    || !当前选择.成功() || !当前选择.当前选择关系
                    || *当前选择.当前选择关系 != 请求.旧当前选择
                    || !当前选择.当前状态
                    || 当前选择.当前状态->身份 != 请求.旧当前状态
                    || !主体来源.成功() || !主体来源.身份来源
                    || !实例来源.成功() || !实例来源.身份来源
                    || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值
                    || 实例来源.身份来源->节点稳定编码
                        != 请求.新状态特征实例.值)
                    上下文有效 = false;
                else if (旧.状态->主体存在 != 请求.主体存在)
                    引用有效 = false;
                }
                if (!上下文有效)
                    失败.状态 = L2结构状态::内部不一致;
                else if (!引用有效)
                    失败.状态 = L2结构状态::引用冲突;
                else {
                    const auto& 登记 = *登记结果.登记;
                    const auto 精确类型 = L2状态结构内部::选择状态值类型编码(
                        登记, 请求.新状态精确值材料, true);
                    const auto 时间类型 = L2状态结构内部::选择状态值类型编码(
                        登记, 请求.新状态时间值材料, false);
                    if (!有效(精确类型) || !有效(时间类型))
                        失败.状态 = L2结构状态::引用冲突;
                    else {
                        L1跨所有者原子写集请求 写集;
                        写集.合同版本 = L1所有者范围CRUD合同版本;
                        写集.期望事实代次 = 请求.共同期望事实代次;
                        写集.写入幂等身份 = 请求.组合写入幂等身份;
                        const L1跨所有者原子事实引用值 节点{
                            L1所有者范围写集本地键{0x02041001}};
                        写集.节点 = {{ {0x02041001}, 节点种类::普通, std::nullopt }};
                        写集.关系 = {
                            {{0x02042003}, 节点, 状态身份来源定位_.族锚点,
                                状态身份来源定位_.族归属关系类型, 1},
                            {{0x02041101}, 节点, 请求.主体存在.值,
                                登记.主体关系类型.值, 1},
                            {{0x02041102}, 节点, 请求.新状态特征实例.值,
                                登记.特征实例关系类型.值, 1},
                            {{0x02041103}, 请求.新状态特征实例.值, 节点,
                                登记.当前选择关系类型.值, 1}};
                        写集.值 = {
                            {{0x02041201}, 节点, 精确类型,
                                L2状态结构内部::转换为L1材料(
                                    请求.新状态精确值材料),
                                请求.来源方法稳定编码},
                            {{0x02041202}, 节点, 时间类型,
                                L2状态结构内部::转换为L1材料(
                                    请求.新状态时间值材料),
                                请求.来源方法稳定编码}};
                        写集.属性槽变更 = {
                            {节点, 精确类型, {0x02041201}},
                            {节点, 时间类型, {0x02041202}}};
                        写集.退出事实 = {请求.旧当前选择.关系稳定编码};
                        L1跨所有者原子参与者写集 参与者;
                        参与者.参与者 = L1跨所有者原子事务参与者序号::状态;
                        参与者.所有者 = 第一层写入端口_.所有者身份();
                        参与者.写集 = std::move(写集);
                        失败.状态 = L2结构状态::已读取;
                        失败.参与者 = std::move(参与者);
                        失败.旧当前选择 = 请求.旧当前选择;
                    }
                }
            }
        } catch (const std::bad_alloc&) {
            失败.状态 = L2结构状态::资源失败;
        } catch (...) {
            失败.状态 = L2结构状态::内部不一致;
        }
        return 失败;
    }

private:
    friend L2中性实例状态清理阶段结果_v1
    执行L2中性实例状态清理阶段_v1(
        L2状态结构服务& 服务,
        const L2中性实例状态清理阶段请求_v1& 请求) noexcept {
        return 服务.执行中性实例状态清理阶段_v1(请求);
    }

    L2中性实例状态清理阶段结果_v1 执行中性实例状态清理阶段_v1(
        const L2中性实例状态清理阶段请求_v1& 请求) noexcept {
        return 中性状态提供者_.执行实例状态清理(请求);
    }

    class 中性状态提供者 final {
    public:
        中性状态提供者(const L1事实基座服务& L1,
            L1所有者范围写端口& 所有者写入端口,
            const L2状态结构内部::状态身份来源定位& 定位,
            const std::optional<L2状态结构类型登记>& 类型登记,
            const L2状态结构内部::状态上下文关系类型定位& 上下文定位,
            L2中性实例材料保留策略_v1 保留策略) noexcept
            : L1_(L1), 所有者写入端口_(所有者写入端口),
              定位_(定位), 类型登记_(类型登记),
              上下文定位_(上下文定位), 保留策略_(保留策略) {}

        当前值记录状态参与者结果_v1 形成当前值记录状态参与者_v1(
            const L2结构请求头& 请求头, L2结构幂等身份 幂等身份,
            L2特征定义身份 特征类型, const L2原始值材料& 旧值,
            const L2原始值材料& 新值, std::int64_t 变化UTC纳秒,
            L2存在身份 主体存在, L2场景身份 共同场景,
            L2特征实例身份 特征实例, L2存在身份 来源存在,
            稳定编码 当前选择角色, 稳定编码 上下文关系类型,
            L2状态当前选择关系类型身份 当前选择关系类型,
            L1结构所有者身份 状态所有者,
            const std::optional<L2中性状态引用事实_v1>& 旧选择,
            bool legacy基线兼容) const noexcept {
            当前值记录状态参与者结果_v1 失败;
            失败.legacy基线兼容 = legacy基线兼容;
            失败.旧选择 = 旧选择;
            if (!L2结构请求头合同有效(请求头)
                || 请求头.期望事实代次 == 0
                || !L2结构幂等身份有效(幂等身份)
                || !有效(特征类型.值) || !L2中性原始值材料有效_v1(旧值)
                || !L2中性原始值材料有效_v1(新值)
                || 变化UTC纳秒 <= 0 || !有效(主体存在.值)
                || !有效(共同场景.值) || !有效(特征实例.值)
                || !有效(来源存在.值) || !有效(当前选择角色)
                || 当前选择角色.值 > static_cast<std::uint64_t>(
                    std::numeric_limits<std::int64_t>::max())
                || !有效(上下文关系类型)
                || !有效(当前选择关系类型.值) || !类型登记_
                || !有效(状态所有者)
                || (legacy基线兼容 && 旧选择)
                || (!legacy基线兼容 && !旧选择)) {
                失败.状态 = L2结构状态::入口拒绝;
                return 失败;
            }
            try {
                std::vector<稳定编码> 退出事实;
                if (旧选择) {
                    const auto 关系式 = L1_.读取中性当前关系({
                        L1中性CRUD合同版本, 旧选择->身份.值});
                    if (关系式.状态 == L1中性读取状态::成功
                        && 关系式.事实) {
                        const auto& 关系 = *关系式.事实;
                        if (关系.编码 != 旧选择->身份.值
                            || 关系.源节点 != 旧选择->引用方
                            || 关系.目标节点 != 旧选择->目标状态.值
                            || 关系.关系类型节点 != 当前选择关系类型.值
                            || 关系.角色或顺序
                                != static_cast<std::int64_t>(当前选择角色.值)
                            || 关系.退出事实代次) {
                            失败.状态 = L2结构状态::引用冲突;
                            return 失败;
                        }
                        退出事实.push_back(关系.编码);
                    } else if (关系式.状态 == L1中性读取状态::未找到
                        || 关系式.状态 == L1中性读取状态::已退出) {
                        const auto 历史事实 = L1_.读取中性历史事实({
                            L1中性CRUD合同版本, 旧选择->身份.值});
                        if (历史事实.状态 == L1中性读取状态::成功
                            && 历史事实.事实) {
                            if (const auto* 关系 = std::get_if<L1中性关系事实>(
                                    &*历史事实.事实)) {
                                if (关系->编码 != 旧选择->身份.值
                                    || 关系->源节点 != 旧选择->引用方
                                    || 关系->目标节点 != 旧选择->目标状态.值
                                    || 关系->关系类型节点
                                        != 当前选择关系类型.值
                                    || 关系->角色或顺序
                                        != static_cast<std::int64_t>(
                                            当前选择角色.值)
                                    || 关系->创建事实代次 == 0
                                    || 关系->创建事实代次
                                        > 请求头.期望事实代次
                                    || (关系->退出事实代次
                                        && *关系->退出事实代次
                                            <= 请求头.期望事实代次)) {
                                    失败.状态 = L2结构状态::引用冲突;
                                    return 失败;
                                }
                                退出事实.push_back(关系->编码);
                            } else {
                                const auto legacy = 读取历史引用闭包(
                                    旧选择->身份.值,
                                    请求头.期望事实代次,
                                    历史事实.读取事实代次);
                                if (!legacy.闭包
                                    || legacy.闭包->引用 != *旧选择) {
                                    失败.状态 = legacy.状态
                                            == L2中性结构状态_v1::资源失败
                                        ? L2结构状态::资源失败
                                        : L2结构状态::引用冲突;
                                    return 失败;
                                }
                                退出事实 = 引用退出事实组(*legacy.闭包);
                            }
                        } else {
                            失败.状态 = 历史事实.状态
                                    == L1中性读取状态::资源失败
                                ? L2结构状态::资源失败
                                : L2结构状态::引用冲突;
                            return 失败;
                        }
                    } else {
                        失败.状态 = 关系式.状态 == L1中性读取状态::资源失败
                            ? L2结构状态::资源失败
                            : L2结构状态::内部不一致;
                        return 失败;
                    }
                }

                constexpr std::uint32_t 基线根键 = 0x02F4'1101U;
                constexpr std::uint32_t 基线索引键 = 0x02F4'1102U;
                constexpr std::uint32_t 基线载荷键 = 0x02F4'1103U;
                constexpr std::uint32_t 新根键 = 0x02F4'1201U;
                constexpr std::uint32_t 新索引键 = 0x02F4'1202U;
                constexpr std::uint32_t 新载荷键 = 0x02F4'1203U;
                constexpr std::uint32_t 新选择键 = 0x02F4'1301U;
                L1三分区原子写集请求_v2 写集;
                写集.合同版本 = L1所有者范围CRUD合同版本;
                写集.期望事实代次 = 请求头.期望事实代次;
                写集.写入幂等身份 = {幂等身份.值};

                const auto 追加状态 = [&](std::uint32_t 根键,
                    std::uint32_t 索引键, std::uint32_t 载荷键,
                    std::uint32_t 上下文起始键,
                    const L2原始值材料& 值) {
                    const L1所有者范围写集本地键 根{根键};
                    L2中性状态新增请求_v1 材料{{请求头},
                        L2中性状态动态合同版本_v1, 幂等身份,
                        L2中性材料类别_v1::实例, 特征类型, 值,
                        {L2中性时间语义_v1::绝对UTC纳秒, 变化UTC纳秒}};
                    写集.节点.push_back({根, 节点种类::普通, std::nullopt});
                    写集.关系.push_back({{索引键}, 根, 定位_.族锚点,
                        定位_.族归属关系类型, 状态索引角色});
                    写集.值.push_back({{载荷键}, 根,
                        类型登记_->精确U64组值类型.值,
                        编码状态载荷(材料, 变化UTC纳秒), 根});
                    写集.属性槽变更.push_back({根,
                        类型登记_->精确U64组值类型.值, {载荷键}});
                    写集.关系.push_back({{上下文起始键}, 根,
                        主体存在.值, 上下文关系类型, 1});
                    写集.关系.push_back({{上下文起始键 + 1}, 根,
                        共同场景.值, 上下文关系类型, 2});
                    写集.关系.push_back({{上下文起始键 + 2}, 根,
                        特征实例.值, 上下文关系类型, 3});
                    写集.关系.push_back({{上下文起始键 + 3}, 根,
                        来源存在.值, 上下文关系类型, 4});
                };
                if (legacy基线兼容)
                    追加状态(基线根键, 基线索引键, 基线载荷键,
                        0x02F4'1111U, 旧值);
                追加状态(新根键, 新索引键, 新载荷键,
                    0x02F4'1211U, 新值);
                写集.关系.push_back({{新选择键}, 特征实例.值,
                    L1所有者范围写集本地键{新根键},
                    当前选择关系类型.值,
                    static_cast<std::int64_t>(当前选择角色.值)});
                写集.退出事实 = std::move(退出事实);
                std::sort(写集.退出事实.begin(), 写集.退出事实.end());

                L1三分区原子参与者写集_v2 参与者;
                参与者.参与者 = {2};
                参与者.所有者 = 状态所有者;
                参与者.写集 = std::move(写集);
                失败.状态 = L2结构状态::已读取;
                失败.参与者 = std::move(参与者);
                失败.前状态本地键 = {legacy基线兼容 ? 基线根键 : 0};
                失败.后状态本地键 = {新根键};
                失败.新选择本地键 = {新选择键};
                return 失败;
            } catch (const std::bad_alloc&) {
                失败.状态 = L2结构状态::资源失败;
            } catch (const std::length_error&) {
                失败.状态 = L2结构状态::资源失败;
            } catch (...) {
                失败.状态 = L2结构状态::内部不一致;
            }
            return 失败;
        }

        L2中性状态写入结果_v1 新增状态(
            const L2中性状态新增请求_v1& 请求) noexcept {
            if (!L2中性状态新增请求有效_v1(请求))
                return 状态写失败(L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_)
                || !类型登记_)
                return 状态写失败(L2中性结构状态_v1::内部错误);
            try {
                const auto 已有首次 = 读取首次状态材料(请求);
                if (已有首次.状态 == L2中性结构状态_v1::精确重复
                    && 已有首次.状态事实)
                    return {{L2中性状态动态合同版本_v1,
                            L2中性结构状态_v1::精确重复,
                            已有首次.本次正式读回截止,
                            已有首次.首次事实代次},
                        *已有首次.状态事实};
                if (已有首次.状态 != L2中性结构状态_v1::未找到)
                    return 状态写失败(已有首次.状态,
                        已有首次.本次正式读回截止);
                const auto 首次UTC = std::chrono::duration_cast<
                    std::chrono::nanoseconds>(std::chrono::system_clock::now()
                        .time_since_epoch()).count();
                if (首次UTC <= 0)
                    return 状态写失败(L2中性结构状态_v1::内部错误);
                auto 写集 = 形成状态新增写集(请求, 首次UTC);
                const auto 写入 = 提交写集(写集);
                const auto 状态 = 映射写入状态(写入.状态);
                if (写入.状态 == L1中性写入状态::精确重复
                    || 写入.状态 == L1中性写入状态::幂等冲突) {
                    const auto 竞争后首次 = 读取首次状态材料(请求);
                    if (竞争后首次.状态 == L2中性结构状态_v1::精确重复
                        && 竞争后首次.状态事实)
                        return {{L2中性状态动态合同版本_v1,
                                L2中性结构状态_v1::精确重复,
                                竞争后首次.本次正式读回截止,
                                竞争后首次.首次事实代次},
                            *竞争后首次.状态事实};
                    return 状态写失败(竞争后首次.状态,
                        竞争后首次.本次正式读回截止);
                }
                if (写入.状态 != L1中性写入状态::成功)
                    return 状态写失败(状态, 写入.事实代次);
                const auto 根 = 查找新编码(写入, 状态根本地键值);
                if (!根) return 状态写失败(
                    L2中性结构状态_v1::内部错误, 写入.事实代次);
                const auto 当前 = 当前代次();
                if (!当前 || *当前 == 0)
                    return 状态写失败(L2中性结构状态_v1::内部错误);
                const auto 读回 = 读取当前状态闭包(*根, *当前);
                if (读回.状态 != L2中性结构状态_v1::已读取 || !读回.闭包)
                    return 状态写失败(读回.状态, *当前);
                const auto 变更 = 读回.闭包->状态.形成事实代次;
                return {{L2中性状态动态合同版本_v1, 状态, *当前, 变更},
                    读回.闭包->状态};
            } catch (const std::bad_alloc&) {
                return 状态写失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 状态写失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 状态写失败(L2中性结构状态_v1::内部错误);
            }
        }

        L2中性状态读取结果_v1 读取状态(
            const L2中性状态读取请求_v1& 请求) const noexcept {
            if (!L2中性状态读取请求有效_v1(请求))
                return 状态读失败(请求, L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_) || !类型登记_)
                return 状态读失败(请求, L2中性结构状态_v1::内部错误);
            try {
                const auto 前 = 当前代次();
                if (!前) return 状态读失败(请求,
                    L2中性结构状态_v1::内部错误);
                if (*前 != 请求.请求头.期望事实代次)
                    return 状态读失败(请求,
                        L2中性结构状态_v1::事实代次漂移, *前);
                auto 读取 = 请求.读取类别 == L2读取类别::当前
                    ? 读取当前状态闭包(请求.状态.值, *前)
                    : 读取历史状态闭包(请求.状态.值,
                        请求.历史截止事实代次, *前);
                if (请求.读取类别 == L2读取类别::当前
                    && 读取.状态 == L2中性结构状态_v1::已退出)
                    读取 = 读取历史状态闭包(请求.状态.值, *前, *前);
                const auto 后 = 当前代次();
                if (!后 || *后 != *前)
                    return 状态读失败(请求,
                        L2中性结构状态_v1::事实代次漂移, 后.value_or(0));
                if (读取.闭包) return {{L2中性状态动态合同版本_v1,
                        读取.状态, *前, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, 读取.闭包->状态, std::nullopt};
                return 状态读失败(请求, 读取.状态, *前, 读取.墓碑);
            } catch (const std::bad_alloc&) {
                return 状态读失败(请求, L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 状态读失败(请求, L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 状态读失败(请求, L2中性结构状态_v1::内部错误);
            }
        }

        L2中性状态退出结果_v1 退出状态(
            const L2中性状态退出请求_v1& 请求) noexcept {
            if (!L2中性状态退出请求有效_v1(请求))
                return 状态退失败(L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_) || !类型登记_)
                return 状态退失败(L2中性结构状态_v1::内部错误);
            try {
                const auto 当前 = 当前代次();
                if (!当前) return 状态退失败(L2中性结构状态_v1::内部错误);
                状态闭包读取 读取 = *当前 == 请求.请求头.期望事实代次
                    ? 读取当前状态闭包(请求.状态.值, *当前)
                    : 读取历史状态闭包(请求.状态.值,
                        请求.请求头.期望事实代次, *当前);
                if (!读取.闭包) return 状态退失败(读取.状态, *当前);
                L1中性写集请求 写集;
                写集.合同版本 = L1中性CRUD合同版本;
                写集.期望事实代次 = 请求.请求头.期望事实代次;
                写集.幂等键 = 映射幂等键(退出状态幂等域, 请求.幂等身份);
                写集.退出事实 = 状态退出事实组(*读取.闭包);
                const auto 写入 = 读取.闭包->上下文关系.empty()
                    ? 提交写集(写集)
                    : 提交所有者写集(写集);
                const auto 映射 = 映射写入状态(写入.状态);
                if (写入.状态 != L1中性写入状态::成功
                    && 写入.状态 != L1中性写入状态::精确重复)
                    return 状态退失败(映射, 写入.事实代次);
                const auto 读回截止 = 当前代次();
                if (!读回截止 || 写入.事实代次 == 0)
                    return 状态退失败(L2中性结构状态_v1::内部错误);
                const auto 读回 = 读取历史状态闭包(请求.状态.值,
                    写入.事实代次 - 1, *读回截止);
                if (!读回.闭包) return 状态退失败(读回.状态, *读回截止);
                return {{L2中性状态动态合同版本_v1,
                        写入.状态 == L1中性写入状态::精确重复
                            ? L2中性结构状态_v1::精确重复
                            : L2中性结构状态_v1::已退出,
                        *读回截止, 写入.事实代次}, 读回.闭包->状态};
            } catch (const std::bad_alloc&) {
                return 状态退失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 状态退失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 状态退失败(L2中性结构状态_v1::内部错误);
            }
        }

        L2中性状态引用写入结果_v1 建立普通引用(
            const L2中性状态普通引用建立请求_v1& 请求) noexcept {
            if (!L2中性状态普通引用建立请求有效_v1(请求))
                return 引用写失败(L2中性结构状态_v1::入口拒绝);
            try {
                const auto 目标 = 读取当前状态闭包(
                    请求.目标状态.值, 请求.请求头.期望事实代次);
                if (!目标.闭包) return 引用写失败(目标.状态,
                    请求.请求头.期望事实代次);
                const L2中性状态引用事实_v1 材料{{},
                    L2中性状态引用类别_v1::普通, 请求.引用方,
                    请求.引用角色, 请求.目标状态, {0, std::nullopt}};
                return 提交引用新增(请求.请求头, 请求.幂等身份,
                    材料, std::nullopt);
            } catch (const std::bad_alloc&) {
                return 引用写失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 引用写失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 引用写失败(L2中性结构状态_v1::内部错误);
            }
        }

        L2中性状态引用写入结果_v1 设置当前选择(
            const L2中性状态当前选择设置请求_v1& 请求) noexcept {
            if (!L2中性状态当前选择设置请求有效_v1(请求))
                return 引用写失败(L2中性结构状态_v1::入口拒绝);
            try {
                const auto 当前 = 当前代次();
                if (!当前) return 引用写失败(L2中性结构状态_v1::内部错误);
                const auto 目标 = 读取当前状态闭包(请求.新当前状态.值, *当前);
                if (!目标.闭包) return 引用写失败(目标.状态, *当前);
                std::optional<引用物理闭包> 旧闭包;
                if (请求.预期旧当前选择) {
                    auto 旧 = *当前 == 请求.请求头.期望事实代次
                        ? 读取当前引用闭包(请求.预期旧当前选择->值, *当前)
                        : 读取历史引用闭包(请求.预期旧当前选择->值,
                            请求.请求头.期望事实代次, *当前);
                    if (!旧.闭包 || 旧.闭包->引用.类别
                            != L2中性状态引用类别_v1::当前选择
                        || 旧.闭包->引用.引用方 != 请求.引用方
                        || 旧.闭包->引用.引用角色 != 请求.引用角色)
                        return 引用写失败(L2中性结构状态_v1::引用冲突, *当前);
                    旧闭包 = *旧.闭包;
                }
                if (*当前 == 请求.请求头.期望事实代次) {
                    const auto 现有 = 查找当前选择(
                        请求.引用方, 请求.引用角色, *当前);
                    if (现有.状态 != L2中性结构状态_v1::已读取
                        && 现有.状态 != L2中性结构状态_v1::未找到)
                        return 引用写失败(现有.状态, *当前);
                    if ((现有.闭包.has_value()) != 请求.预期旧当前选择.has_value()
                        || (现有.闭包 && 现有.闭包->引用.身份
                            != *请求.预期旧当前选择))
                        return 引用写失败(L2中性结构状态_v1::引用冲突, *当前);
                }
                const L2中性状态引用事实_v1 材料{{},
                    L2中性状态引用类别_v1::当前选择, 请求.引用方,
                    请求.引用角色, 请求.新当前状态, {0, std::nullopt}};
                return 提交引用新增(请求.请求头, 请求.幂等身份,
                    材料, 旧闭包);
            } catch (const std::bad_alloc&) {
                return 引用写失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 引用写失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 引用写失败(L2中性结构状态_v1::内部错误);
            }
        }

        L2中性状态引用写入结果_v1 退出引用(
            const L2中性状态引用退出请求_v1& 请求) noexcept {
            if (!L2中性状态引用退出请求有效_v1(请求))
                return 引用写失败(L2中性结构状态_v1::入口拒绝);
            try {
                const auto 当前 = 当前代次();
                if (!当前) return 引用写失败(L2中性结构状态_v1::内部错误);
                auto 读取 = *当前 == 请求.请求头.期望事实代次
                    ? 读取当前引用闭包(请求.引用.值, *当前)
                    : 读取历史引用闭包(请求.引用.值,
                        请求.请求头.期望事实代次, *当前);
                if (!读取.闭包) return 引用写失败(读取.状态, *当前);
                L1中性写集请求 写集;
                写集.合同版本 = L1中性CRUD合同版本;
                写集.期望事实代次 = 请求.请求头.期望事实代次;
                写集.幂等键 = 映射幂等键(退出引用幂等域, 请求.幂等身份);
                写集.退出事实 = 引用退出事实组(*读取.闭包);
                const auto 写入 = 提交写集(写集);
                if (写入.状态 != L1中性写入状态::成功
                    && 写入.状态 != L1中性写入状态::精确重复)
                    return 引用写失败(映射写入状态(写入.状态), 写入.事实代次);
                const auto 截止 = 当前代次();
                if (!截止 || 写入.事实代次 == 0)
                    return 引用写失败(L2中性结构状态_v1::内部错误);
                auto 引用 = 读取.闭包->引用;
                引用.生命周期.退出事实代次 = 写入.事实代次;
                return {{L2中性状态动态合同版本_v1,
                        写入.状态 == L1中性写入状态::精确重复
                            ? L2中性结构状态_v1::精确重复
                            : L2中性结构状态_v1::已退出,
                        *截止, 写入.事实代次}, 引用, std::nullopt};
            } catch (const std::bad_alloc&) {
                return 引用写失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 引用写失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 引用写失败(L2中性结构状态_v1::内部错误);
            }
        }

        L2中性状态引用读取结果_v1 读取引用(
            const L2中性状态引用读取请求_v1& 请求) const noexcept {
            if (!L2中性状态引用读取请求有效_v1(请求))
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::入口拒绝);
            try {
                const auto 前 = 当前代次();
                if (!前) return 引用读失败(请求.读取类别,
                    请求.历史截止事实代次, L2中性结构状态_v1::内部错误);
                if (*前 != 请求.请求头.期望事实代次)
                    return 引用读失败(请求.读取类别,
                        请求.历史截止事实代次,
                        L2中性结构状态_v1::事实代次漂移, *前);
                const auto 读取 = 请求.读取类别 == L2读取类别::当前
                    ? 读取当前引用闭包(请求.引用.值, *前)
                    : 读取历史引用闭包(请求.引用.值,
                        请求.历史截止事实代次, *前);
                if (!读取.闭包) return 引用读失败(请求.读取类别,
                    请求.历史截止事实代次, 读取.状态, *前);
                const auto 目标请求 = L2中性状态读取请求_v1{
                    请求.请求头, L2中性状态动态合同版本_v1,
                    请求.读取类别, 读取.闭包->引用.目标状态,
                    请求.历史截止事实代次};
                const auto 目标 = 读取状态(目标请求);
                const auto 后 = 当前代次();
                if (!后 || *后 != *前)
                    return 引用读失败(请求.读取类别,
                        请求.历史截止事实代次,
                        L2中性结构状态_v1::事实代次漂移, 后.value_or(0));
                if (目标.成功()) return {{L2中性状态动态合同版本_v1,
                        L2中性结构状态_v1::已读取, *前, std::nullopt},
                    请求.读取类别, 请求.历史截止事实代次,
                    读取.闭包->引用, 目标.状态, std::nullopt};
                return {{L2中性状态动态合同版本_v1, 目标.结果头.状态,
                        *前, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, 读取.闭包->引用,
                    std::nullopt, 目标.墓碑};
            } catch (const std::bad_alloc&) {
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::内部错误);
            }
        }

        L2中性状态引用读取结果_v1 读取当前选择(
            const L2中性状态当前选择读取请求_v1& 请求) const noexcept {
            if (!L2中性状态当前选择读取请求有效_v1(请求))
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::入口拒绝);
            try {
                const auto 前 = 当前代次();
                if (!前) return 引用读失败(请求.读取类别,
                    请求.历史截止事实代次, L2中性结构状态_v1::内部错误);
                if (*前 != 请求.请求头.期望事实代次)
                    return 引用读失败(请求.读取类别,
                        请求.历史截止事实代次,
                        L2中性结构状态_v1::事实代次漂移, *前);
                const auto 找到 = 请求.读取类别 == L2读取类别::当前
                    ? 查找当前选择(请求.引用方, 请求.引用角色, *前)
                    : 查找历史当前选择(请求.引用方, 请求.引用角色,
                        请求.历史截止事实代次, *前);
                if (!找到.闭包) return 引用读失败(请求.读取类别,
                    请求.历史截止事实代次, 找到.状态, *前);
                return 读取引用({请求.请求头, L2中性状态动态合同版本_v1,
                    请求.读取类别, 找到.闭包->引用.身份,
                    请求.历史截止事实代次});
            } catch (const std::bad_alloc&) {
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 引用读失败(请求.读取类别, 请求.历史截止事实代次,
                    L2中性结构状态_v1::内部错误);
            }
        }

        L2中性实例状态清理阶段结果_v1 执行实例状态清理(
            const L2中性实例状态清理阶段请求_v1& 请求) noexcept {
            if (!L2中性实例状态清理阶段请求有效_v1(请求))
                return 清理失败(L2中性结构状态_v1::入口拒绝);
            if (!L2中性实例材料保留策略有效_v1(保留策略_)
                || !类型登记_)
                return 清理失败(L2中性结构状态_v1::内部错误);
            try {
                const auto 当前 = 当前代次();
                if (!当前) return 清理失败(L2中性结构状态_v1::内部错误);
                if (*当前 != 请求.请求头.期望事实代次)
                    return 清理失败(L2中性结构状态_v1::事实代次漂移, *当前);
                auto 状态组读取 = 枚举当前状态(*当前);
                if (状态组读取.状态 != L2中性结构状态_v1::已读取)
                    return 清理失败(状态组读取.状态, *当前);
                std::vector<状态物理闭包> 实例状态;
                for (const auto& 状态 : 状态组读取.状态组)
                    if (状态.状态.材料类别 == L2中性材料类别_v1::实例)
                        实例状态.push_back(状态);
                for (const auto& 身份 : 请求.完整活动动态成员状态身份规范组)
                    if (std::none_of(实例状态.begin(), 实例状态.end(),
                            [&](const auto& 项) { return 项.状态.身份 == 身份; }))
                        return 清理失败(L2中性结构状态_v1::动态不闭合, *当前);
                std::sort(实例状态.begin(), 实例状态.end(), [](const auto& 左,
                    const auto& 右) {
                    if (左.状态.时间.纳秒 != 右.状态.时间.纳秒)
                        return 左.状态.时间.纳秒 < 右.状态.时间.纳秒;
                    if (左.状态.形成事实代次 != 右.状态.形成事实代次)
                        return 左.状态.形成事实代次 < 右.状态.形成事实代次;
                    return 左.状态.身份.值 < 右.状态.身份.值;
                });
                const auto 受保护 = [&](const L2状态身份& 身份) {
                    return std::binary_search(
                        请求.完整活动动态成员状态身份规范组.begin(),
                        请求.完整活动动态成员状态身份规范组.end(), 身份,
                        [](const auto& 左, const auto& 右) { return 左.值 < 右.值; });
                };
                std::vector<状态物理闭包> 候选;
                for (const auto& 状态 : 实例状态) {
                    const bool 到期 = 请求.本次绝对UTC纳秒
                            >= 状态.状态.首次形成UTC纳秒
                        && static_cast<std::uint64_t>(请求.本次绝对UTC纳秒
                            - 状态.状态.首次形成UTC纳秒)
                            >= 保留策略_.实例状态TTL纳秒;
                    if (到期 && !受保护(状态.状态.身份)) 候选.push_back(状态);
                }
                std::uint64_t 保留数量 = 实例状态.size() - 候选.size();
                for (const auto& 状态 : 实例状态) {
                    if (保留数量 <= 保留策略_.实例状态总量上限) break;
                    if (受保护(状态.状态.身份)
                        || std::any_of(候选.begin(), 候选.end(), [&](const auto& 项) {
                            return 项.状态.身份 == 状态.状态.身份; })) continue;
                    候选.push_back(状态); --保留数量;
                }
                if (保留数量 > 保留策略_.实例状态总量上限)
                    return 清理失败(L2中性结构状态_v1::引用冲突, *当前,
                        实例状态.size(), 实例状态.size());
                if (候选.empty()) {
                    L2中性实例状态清理阶段结果_v1 结果{{
                        L2中性状态动态合同版本_v1,
                        L2中性结构状态_v1::无须清理, *当前, std::nullopt},
                        {}, {}, 实例状态.size(), 实例状态.size()};
                    return 结果;
                }
                const auto 引用组 = 枚举当前引用(*当前,
                    L2中性状态引用类别_v1::当前选择);
                if (引用组.状态 != L2中性结构状态_v1::已读取)
                    return 清理失败(引用组.状态, *当前);
                std::vector<引用物理闭包> 退出选择;
                for (const auto& 引用 : 引用组.引用组)
                    if (std::any_of(候选.begin(), 候选.end(), [&](const auto& 状态) {
                        return 状态.状态.身份 == 引用.引用.目标状态; }))
                        退出选择.push_back(引用);
                std::vector<L2中性状态引用事实_v1> 关系式选择;
                std::vector<L2中性状态引用事实_v1> 关系式退出选择;
                for (const auto& 状态 : 候选) {
                    if (状态.上下文关系.empty()) continue;
                    const auto 关系读取 = L1_.读取中性历史关系组({
                        L1中性CRUD合同版本,
                        L1中性关系端点方向::目标,
                        状态.状态.身份.值,
                        类型登记_->当前选择关系类型.值,
                        状态.状态.形成事实代次});
                    if (关系读取.状态
                            != L1中性历史关系组读取状态::成功)
                        return 清理失败(关系读取.状态
                                == L1中性历史关系组读取状态::资源失败
                            ? L2中性结构状态_v1::资源失败
                            : L2中性结构状态_v1::内部错误, *当前);
                    if (关系读取.读取事实代次 != *当前)
                        return 清理失败(
                            L2中性结构状态_v1::事实代次漂移, *当前);
                    if (关系读取.关系组.size() > 1)
                        return 清理失败(
                            L2中性结构状态_v1::引用冲突, *当前);
                    if (关系读取.关系组.empty()) continue;
                    for (const auto& 关系 : 关系读取.关系组) {
                        if (关系.目标节点 != 状态.状态.身份.值
                            || 关系.关系类型节点
                                != 类型登记_->当前选择关系类型.值
                            || 关系.角色或顺序 <= 0
                            || 关系.创建事实代次
                                != 状态.状态.形成事实代次
                            || (关系.退出事实代次
                                && *关系.退出事实代次 > *当前))
                            return 清理失败(
                                L2中性结构状态_v1::内部错误, *当前);
                        L2中性状态引用事实_v1 引用{{关系.编码},
                            L2中性状态引用类别_v1::当前选择,
                            关系.源节点,
                            稳定编码{static_cast<std::uint64_t>(
                                关系.角色或顺序)},
                            L2状态身份{关系.目标节点},
                            {关系.创建事实代次, 关系.退出事实代次}};
                        if (!L2中性状态引用事实完整_v1(引用))
                            return 清理失败(
                                L2中性结构状态_v1::内部错误, *当前);
                        关系式选择.push_back(引用);
                        if (!引用.生命周期.退出事实代次)
                            关系式退出选择.push_back(std::move(引用));
                    }
                }
                L1中性写集请求 旧式退出写集;
                旧式退出写集.合同版本 = L1中性CRUD合同版本;
                旧式退出写集.期望事实代次 = 请求.请求头.期望事实代次;
                旧式退出写集.幂等键 = 映射幂等键(清理逻辑退出幂等域,
                    请求.清理幂等身份);
                L1中性写集请求 关系式退出写集;
                关系式退出写集.合同版本 = L1中性CRUD合同版本;
                关系式退出写集.幂等键 = 映射幂等键(
                    清理关系式逻辑退出幂等域, 请求.清理幂等身份);
                for (const auto& 状态 : 候选) {
                    const auto 组 = 状态退出事实组(状态);
                    auto& 写集 = 状态.上下文关系.empty()
                        ? 旧式退出写集 : 关系式退出写集;
                    写集.退出事实.insert(写集.退出事实.end(),
                        组.begin(), 组.end());
                }
                for (const auto& 引用 : 退出选择) {
                    const auto 组 = 引用退出事实组(引用);
                    旧式退出写集.退出事实.insert(
                        旧式退出写集.退出事实.end(), 组.begin(), 组.end());
                }
                for (const auto& 引用 : 关系式退出选择)
                    关系式退出写集.退出事实.push_back(引用.身份.值);
                规范退出事实(旧式退出写集.退出事实);
                规范退出事实(关系式退出写集.退出事实);
                std::uint64_t 退出事实代次 = 请求.请求头.期望事实代次;
                if (!旧式退出写集.退出事实.empty()) {
                    const auto 退出 = 提交写集(旧式退出写集);
                    if (退出.状态 != L1中性写入状态::成功
                        && 退出.状态 != L1中性写入状态::精确重复)
                        return 清理失败(映射写入状态(退出.状态),
                            退出.事实代次, 实例状态.size(), 实例状态.size());
                    退出事实代次 = 退出.事实代次;
                }
                if (!关系式退出写集.退出事实.empty()) {
                    关系式退出写集.期望事实代次 = 退出事实代次;
                    const auto 退出 = 提交所有者写集(关系式退出写集);
                    if (退出.状态 != L1中性写入状态::成功
                        && 退出.状态 != L1中性写入状态::精确重复)
                        return 清理失败(映射写入状态(退出.状态),
                            退出.事实代次, 实例状态.size(), 实例状态.size());
                    退出事实代次 = 退出.事实代次;
                }
                L1物理清理请求 清理请求;
                清理请求.合同版本 = L1物理清理合同版本;
                清理请求.期望事实代次 = 退出事实代次;
                清理请求.幂等身份 = {物理清理幂等域 ^ 请求.清理幂等身份.值};
                for (const auto& 状态 : 候选) 追加物理闭包(清理请求, 状态);
                for (const auto& 引用 : 退出选择) 追加物理闭包(清理请求, 引用);
                for (const auto& 引用 : 关系式选择)
                    清理请求.待清理事实身份组.push_back({
                        L1物理清理事实种类::关系, 引用.身份.值});
                std::sort(清理请求.待清理事实身份组.begin(),
                    清理请求.待清理事实身份组.end());
                清理请求.待清理事实身份组.erase(std::unique(
                    清理请求.待清理事实身份组.begin(),
                    清理请求.待清理事实身份组.end()),
                    清理请求.待清理事实身份组.end());
                const auto 清理 = const_cast<L1事实基座服务&>(L1_)
                    .执行L1物理清理(清理请求);
                if (!清理.成功()) return 清理失败(映射清理状态(清理.状态),
                    清理.物理清理事实代次, 实例状态.size(),
                    实例状态.size() - 候选.size());
                L2中性实例状态清理阶段结果_v1 结果;
                结果.结果头 = {L2中性状态动态合同版本_v1,
                    清理.状态 == L1物理清理状态::精确重复
                        ? L2中性结构状态_v1::精确重复
                        : L2中性结构状态_v1::已清理,
                    清理.物理清理事实代次, 清理.物理清理事实代次};
                结果.清理前实例状态数量 = 实例状态.size();
                结果.清理后实例状态数量 = 实例状态.size() - 候选.size();
                for (const auto& 状态 : 候选) {
                    const auto 项 = std::find_if(清理.墓碑组.begin(), 清理.墓碑组.end(),
                        [&](const auto& 墓碑) { return 墓碑.事实种类
                            == L1物理清理事实种类::节点
                            && 墓碑.编码 == 状态.状态.身份.值; });
                    if (项 == 清理.墓碑组.end())
                        return 清理失败(L2中性结构状态_v1::内部错误,
                            清理.物理清理事实代次, 实例状态.size(),
                            结果.清理后实例状态数量);
                    结果.已清理状态.push_back({项->编码,
                        L2中性事实种类_v1::状态, {}, 项->创建事实代次,
                        项->退出事实代次, 项->物理清理事实代次});
                }
                for (const auto& 引用 : 退出选择)
                    结果.已退出当前选择.push_back(引用.引用.身份);
                for (const auto& 引用 : 关系式退出选择)
                    结果.已退出当前选择.push_back(引用.身份);
                std::sort(结果.已退出当前选择.begin(),
                    结果.已退出当前选择.end(), [](const auto& 左, const auto& 右) {
                        return 左.值 < 右.值;
                    });
                return 结果;
            } catch (const std::bad_alloc&) {
                return 清理失败(L2中性结构状态_v1::资源失败);
            } catch (const std::length_error&) {
                return 清理失败(L2中性结构状态_v1::资源失败);
            } catch (...) {
                return 清理失败(L2中性结构状态_v1::内部错误);
            }
        }

    private:
        static constexpr std::uint64_t 状态载荷魔数 = 0x4C32'4E53'5441'5431ULL;
        static constexpr std::uint64_t 引用载荷魔数 = 0x4C32'4E52'4546'3031ULL;
        static constexpr std::uint64_t 新增状态幂等域 = 0x31ULL;
        static constexpr std::uint64_t 退出状态幂等域 = 0x32ULL;
        static constexpr std::uint64_t 新增普通引用幂等域 = 0x33ULL;
        static constexpr std::uint64_t 设置当前选择幂等域 = 0x34ULL;
        static constexpr std::uint64_t 退出引用幂等域 = 0x35ULL;
        static constexpr std::uint64_t 清理逻辑退出幂等域 = 0x36ULL;
        static constexpr std::uint64_t 清理关系式逻辑退出幂等域 = 0x37ULL;
        static constexpr std::uint64_t 物理清理幂等域 = 0x4C32'5043'4C45'414EULL;
        static constexpr std::int64_t 状态索引角色 = 0x4E53'5431;
        static constexpr std::int64_t 普通引用索引角色 = 0x4E52'4631;
        static constexpr std::int64_t 当前选择索引角色 = 0x4E43'5331;
        static constexpr std::uint32_t 状态根本地键值 = 0x02F4'1001U;
        static constexpr std::uint32_t 索引关系本地键值 = 0x02F4'1002U;
        static constexpr std::uint32_t 载荷值本地键值 = 0x02F4'1003U;

        struct 状态物理闭包 final {
            L2中性状态事实_v1 状态{};
            稳定编码 索引关系{};
            稳定编码 载荷值{};
            std::vector<稳定编码> 上下文关系{};
        };
        struct 引用物理闭包 final {
            L2中性状态引用事实_v1 引用{};
            稳定编码 索引关系{};
            稳定编码 载荷值{};
        };
        struct 状态闭包读取 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::optional<状态物理闭包> 闭包{};
            std::optional<L2中性结构墓碑_v1> 墓碑{};
        };
        struct 引用闭包读取 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::optional<引用物理闭包> 闭包{};
        };
        struct 状态枚举结果 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::vector<状态物理闭包> 状态组{};
        };
        struct 引用枚举结果 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::vector<引用物理闭包> 引用组{};
        };
        struct 首次状态材料读取值 final {
            L2中性结构状态_v1 状态 = L2中性结构状态_v1::内部错误;
            std::uint64_t 本次正式读回截止 = 0;
            std::uint64_t 首次事实代次 = 0;
            std::optional<L2中性状态事实_v1> 状态事实{};
        };

        static L2中性状态写入结果_v1 状态写失败(
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                std::nullopt};
        }
        static L2中性状态退出结果_v1 状态退失败(
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                std::nullopt};
        }
        static L2中性状态读取结果_v1 状态读失败(
            const L2中性状态读取请求_v1& 请求,
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0,
            std::optional<L2中性结构墓碑_v1> 墓碑 = std::nullopt) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次,
                std::nullopt, std::move(墓碑)};
        }
        static L2中性状态引用写入结果_v1 引用写失败(
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                std::nullopt, std::nullopt};
        }
        static L2中性状态引用读取结果_v1 引用读失败(
            L2读取类别 类别, std::uint64_t 历史截止,
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                类别, 历史截止, std::nullopt, std::nullopt, std::nullopt};
        }
        static L2中性实例状态清理阶段结果_v1 清理失败(
            L2中性结构状态_v1 状态, std::uint64_t 截止 = 0,
            std::uint64_t 前 = 0, std::uint64_t 后 = 0) noexcept {
            return {{L2中性状态动态合同版本_v1, 状态, 截止, std::nullopt},
                {}, {}, 前, 后};
        }

        std::optional<std::uint64_t> 当前代次() const noexcept {
            const auto 读取 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (读取.状态 != L1中性读取状态::成功
                || 读取.合同版本 != L1中性CRUD合同版本
                || 读取.事实代次 == 0) return std::nullopt;
            return 读取.事实代次;
        }

        static L1中性写集幂等键 映射幂等键(
            std::uint64_t 域, L2结构幂等身份 身份) noexcept {
            return {(域 << 56) | 身份.值};
        }

        static L2中性结构状态_v1 映射写入状态(
            L1中性写入状态 状态) noexcept {
            switch (状态) {
            case L1中性写入状态::成功: return L2中性结构状态_v1::已提交;
            case L1中性写入状态::精确重复: return L2中性结构状态_v1::精确重复;
            case L1中性写入状态::事实代次漂移:
                return L2中性结构状态_v1::事实代次漂移;
            case L1中性写入状态::幂等冲突:
                return L2中性结构状态_v1::幂等冲突;
            case L1中性写入状态::引用冲突:
                return L2中性结构状态_v1::引用冲突;
            case L1中性写入状态::资源失败:
                return L2中性结构状态_v1::资源失败;
            default: return L2中性结构状态_v1::内部错误;
            }
        }

        static L2中性结构状态_v1 映射读取状态(
            L1中性读取状态 状态, bool 历史 = false) noexcept {
            switch (状态) {
            case L1中性读取状态::成功: return L2中性结构状态_v1::已读取;
            case L1中性读取状态::未找到: return L2中性结构状态_v1::未找到;
            case L1中性读取状态::已退出: return L2中性结构状态_v1::已退出;
            case L1中性读取状态::历史材料已清理:
                return 历史 ? L2中性结构状态_v1::历史材料已清理
                    : L2中性结构状态_v1::已清理;
            case L1中性读取状态::资源失败:
                return L2中性结构状态_v1::资源失败;
            default: return L2中性结构状态_v1::内部错误;
            }
        }

        static L2中性结构状态_v1 映射清理状态(
            L1物理清理状态 状态) noexcept {
            switch (状态) {
            case L1物理清理状态::事实代次漂移:
                return L2中性结构状态_v1::事实代次漂移;
            case L1物理清理状态::同键冲突:
                return L2中性结构状态_v1::幂等冲突;
            case L1物理清理状态::引用冲突:
                return L2中性结构状态_v1::引用冲突;
            case L1物理清理状态::资源失败:
                return L2中性结构状态_v1::资源失败;
            default: return L2中性结构状态_v1::内部错误;
            }
        }

        static std::optional<稳定编码> 查找新编码(
            const L1中性写入结果& 写入, std::uint32_t 本地键) noexcept {
            for (const auto& [键, 编码] : 写入.新编码映射)
                if (键.值 == 本地键) return 编码;
            return std::nullopt;
        }

        首次状态材料读取值 读取首次状态材料(
            const L2中性状态新增请求_v1& 请求) const {
            const auto 幂等键 = 映射幂等键(新增状态幂等域, 请求.幂等身份);
            const auto 首次 = L1_.读取中性写入首次结果({
                L1中性写入首次结果读取合同版本, 幂等键});
            if (首次.状态 == L1中性写入首次结果读取状态::未找到)
                return {L2中性结构状态_v1::未找到,
                    首次.读取事实代次, 0, std::nullopt};
            if (首次.状态 == L1中性写入首次结果读取状态::资源失败)
                return {L2中性结构状态_v1::资源失败,
                    首次.读取事实代次, 0, std::nullopt};
            if (!首次.成功() || 首次.合同版本
                    != L1中性写入首次结果读取合同版本
                || 首次.幂等键 != 幂等键 || !首次.首次规范请求等价材料
                || 首次.首次事实代次 == 0
                || 首次.首次稳定编码映射.size() != 3)
                return {L2中性结构状态_v1::内部错误,
                    首次.读取事实代次, 0, std::nullopt};
            const auto& 首次请求 = *首次.首次规范请求等价材料;
            if (首次请求.合同版本 != L1中性CRUD合同版本
                || 首次请求.期望事实代次 != 请求.请求头.期望事实代次
                || 首次请求.幂等键 != 幂等键)
                return {L2中性结构状态_v1::幂等冲突,
                    首次.读取事实代次, 首次.首次事实代次, std::nullopt};
            const auto 根 = 查找首次编码(首次.首次稳定编码映射,
                状态根本地键值);
            const L1中性值新建项* 载荷项 = nullptr;
            for (const auto& 项 : 首次请求.值)
                if (项.本地键.值 == 载荷值本地键值) {
                    if (载荷项) return {L2中性结构状态_v1::内部错误,
                        首次.读取事实代次, 首次.首次事实代次, std::nullopt};
                    载荷项 = &项;
                }
            const auto* 载荷 = 载荷项
                ? std::get_if<std::vector<std::uint64_t>>(&载荷项->材料) : nullptr;
            if (!根 || !载荷)
                return {L2中性结构状态_v1::内部错误,
                    首次.读取事实代次, 首次.首次事实代次, std::nullopt};
            const auto 首次状态 = 解码状态载荷(*根,
                首次.首次事实代次, *载荷);
            if (!首次状态 || 首次状态->材料类别 != 请求.材料类别
                || 首次状态->特征类型 != 请求.特征类型
                || 首次状态->特征值 != 请求.特征值
                || 首次状态->时间 != 请求.时间)
                return {L2中性结构状态_v1::幂等冲突,
                    首次.读取事实代次, 首次.首次事实代次, std::nullopt};
            if (形成状态新增写集(请求, 首次状态->首次形成UTC纳秒)
                    != 首次请求)
                return {L2中性结构状态_v1::幂等冲突,
                    首次.读取事实代次, 首次.首次事实代次, std::nullopt};
            auto 正式读回 = 读取当前状态闭包(*根, 首次.读取事实代次);
            if (!正式读回.闭包)
                正式读回 = 读取历史状态闭包(*根,
                    首次.首次事实代次, 首次.读取事实代次);
            if (!正式读回.闭包 || 正式读回.闭包->状态 != *首次状态)
                return {正式读回.状态 == L2中性结构状态_v1::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误,
                    首次.读取事实代次, 首次.首次事实代次, std::nullopt};
            return {L2中性结构状态_v1::精确重复,
                首次.读取事实代次, 首次.首次事实代次,
                正式读回.闭包->状态};
        }

        static std::optional<稳定编码> 查找首次编码(
            const std::vector<std::pair<L1中性写集本地键, 稳定编码>>& 映射,
            std::uint32_t 本地键) noexcept {
            for (const auto& [键, 编码] : 映射)
                if (键.值 == 本地键) return 编码;
            return std::nullopt;
        }

        static std::optional<L2中性结构墓碑_v1> 投影状态墓碑(
            稳定编码 查询身份,
            const std::optional<L1中性物理清理墓碑>& 墓碑) noexcept {
            if (!墓碑 || 墓碑->编码 != 查询身份
                || 墓碑->事实种类 != L1中性物理清理事实种类::节点
                || !有效(墓碑->内部结构分区)
                || 墓碑->创建事实代次 == 0 || 墓碑->退出事实代次 == 0
                || 墓碑->物理清理事实代次 == 0
                || 墓碑->创建事实代次 > 墓碑->退出事实代次
                || 墓碑->退出事实代次 > 墓碑->物理清理事实代次)
                return std::nullopt;
            return L2中性结构墓碑_v1{墓碑->编码,
                L2中性事实种类_v1::状态, 墓碑->内部结构分区,
                墓碑->创建事实代次, 墓碑->退出事实代次,
                墓碑->物理清理事实代次};
        }

        std::vector<std::uint64_t> 编码状态载荷(
            const L2中性状态新增请求_v1& 请求, std::int64_t 首次UTC) const {
            std::vector<std::uint64_t> 载荷{状态载荷魔数,
                L2中性状态动态合同版本_v1,
                static_cast<std::uint64_t>(请求.材料类别), 请求.特征类型.值.值,
                static_cast<std::uint64_t>(请求.时间.语义),
                std::bit_cast<std::uint64_t>(请求.时间.纳秒),
                std::bit_cast<std::uint64_t>(首次UTC), 请求.特征值.index(), 0};
            std::visit([&](const auto& 值) {
                using 类型 = std::decay_t<decltype(值)>;
                if constexpr (std::is_same_v<类型, std::int64_t>) {
                    载荷[8] = 1; 载荷.push_back(std::bit_cast<std::uint64_t>(值));
                } else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>) {
                    载荷[8] = 值.size();
                    for (const auto 项 : 值) 载荷.push_back(std::bit_cast<std::uint64_t>(项));
                } else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>) {
                    载荷[8] = 值.size(); 载荷.insert(载荷.end(), 值.begin(), 值.end());
                } else {
                    载荷[8] = 1; 载荷.push_back(值.编码.值);
                }
            }, 请求.特征值);
            return 载荷;
        }

        static std::optional<L2中性状态事实_v1> 解码状态载荷(
            稳定编码 身份, std::uint64_t 创建代次,
            const std::vector<std::uint64_t>& 载荷) {
            if (载荷.size() < 9 || 载荷[0] != 状态载荷魔数
                || 载荷[1] != L2中性状态动态合同版本_v1
                || 载荷.size() != 9 + 载荷[8]) return std::nullopt;
            L2原始值材料 值;
            switch (载荷[7]) {
            case 0:
                if (载荷[8] != 1) return std::nullopt;
                值 = std::bit_cast<std::int64_t>(载荷[9]); break;
            case 1: {
                std::vector<std::int64_t> 组; 组.reserve(载荷[8]);
                for (std::size_t i = 0; i < 载荷[8]; ++i)
                    组.push_back(std::bit_cast<std::int64_t>(载荷[9 + i]));
                值 = std::move(组); break;
            }
            case 2: {
                std::vector<std::uint64_t> 组(载荷.begin() + 9, 载荷.end());
                值 = std::move(组); break;
            }
            case 3:
                if (载荷[8] != 1) return std::nullopt;
                值 = L2独立材料引用{稳定编码{载荷[9]}}; break;
            default: return std::nullopt;
            }
            L2中性状态事实_v1 状态{L2状态身份{身份},
                static_cast<L2中性材料类别_v1>(载荷[2]),
                L2特征定义身份{稳定编码{载荷[3]}}, std::move(值),
                {static_cast<L2中性时间语义_v1>(载荷[4]),
                    std::bit_cast<std::int64_t>(载荷[5])},
                std::bit_cast<std::int64_t>(载荷[6]), 创建代次};
            return L2中性状态事实完整_v1(状态)
                ? std::optional<L2中性状态事实_v1>{std::move(状态)} : std::nullopt;
        }

        static std::vector<std::uint64_t> 编码引用载荷(
            const L2中性状态引用事实_v1& 引用) {
            return {引用载荷魔数, L2中性状态动态合同版本_v1,
                static_cast<std::uint64_t>(引用.类别), 引用.引用方.值,
                引用.引用角色.值, 引用.目标状态.值.值};
        }

        static std::optional<L2中性状态引用事实_v1> 解码引用载荷(
            稳定编码 身份, std::uint64_t 创建,
            std::optional<std::uint64_t> 退出,
            const std::vector<std::uint64_t>& 载荷) {
            if (载荷.size() != 6 || 载荷[0] != 引用载荷魔数
                || 载荷[1] != L2中性状态动态合同版本_v1) return std::nullopt;
            L2中性状态引用事实_v1 引用{{身份},
                static_cast<L2中性状态引用类别_v1>(载荷[2]),
                稳定编码{载荷[3]}, 稳定编码{载荷[4]},
                L2状态身份{稳定编码{载荷[5]}}, {创建, 退出}};
            return L2中性状态引用事实完整_v1(引用)
                ? std::optional<L2中性状态引用事实_v1>{std::move(引用)}
                : std::nullopt;
        }

        L1中性写集请求 形成状态新增写集(
            const L2中性状态新增请求_v1& 请求, std::int64_t 首次UTC) const {
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.幂等键 = 映射幂等键(新增状态幂等域, 请求.幂等身份);
            const L1中性写集本地键 根{状态根本地键值};
            const L1中性写集本地键 关系{索引关系本地键值};
            const L1中性写集本地键 值{载荷值本地键值};
            写集.节点 = {{根, 节点种类::普通, std::nullopt}};
            写集.关系 = {{关系, 根, 定位_.族锚点, 定位_.族归属关系类型,
                状态索引角色}};
            写集.值 = {{值, 根, 类型登记_->精确U64组值类型.值,
                编码状态载荷(请求, 首次UTC), 根}};
            写集.属性槽变更 = {{根, 类型登记_->精确U64组值类型.值, 值}};
            return 写集;
        }

        L1中性写入结果 提交写集(const L1中性写集请求& 写集) {
            return const_cast<L1事实基座服务&>(L1_).提交中性写集(写集);
        }
        L1中性写入结果 提交所有者写集(const L1中性写集请求& 写集) {
            L1中性写入结果 结果;
            结果.幂等键 = 写集.幂等键;
            if (!写集.节点.empty() || !写集.关系.empty()
                || !写集.值.empty() || !写集.属性槽变更.empty()
                || 写集.退出事实.empty())
                return 结果;
            L1所有者范围写集请求 所有者写集;
            所有者写集.期望事实代次 = 写集.期望事实代次;
            所有者写集.写入幂等身份 = {写集.幂等键.值};
            所有者写集.退出事实 = 写集.退出事实;
            const auto 写入 =
                所有者写入端口_.提交所有者范围中性写集(所有者写集);
            结果.状态 = 映射所有者写入状态(写入.状态);
            结果.事实代次 = 写入.事实代次;
            结果.是否形成内存权威发布 = 写入.是否形成内存权威发布;
            return 结果;
        }

        static L1中性写入状态 映射所有者写入状态(
            L1所有者范围写入状态 状态) noexcept {
            switch (状态) {
            case L1所有者范围写入状态::成功: return L1中性写入状态::成功;
            case L1所有者范围写入状态::精确重复:
                return L1中性写入状态::精确重复;
            case L1所有者范围写入状态::入口拒绝:
                return L1中性写入状态::入口拒绝;
            case L1所有者范围写入状态::未找到:
                return L1中性写入状态::未找到;
            case L1所有者范围写入状态::已退出:
                return L1中性写入状态::已退出;
            case L1所有者范围写入状态::事实代次漂移:
                return L1中性写入状态::事实代次漂移;
            case L1所有者范围写入状态::幂等冲突:
                return L1中性写入状态::幂等冲突;
            case L1所有者范围写入状态::引用冲突:
                return L1中性写入状态::引用冲突;
            case L1所有者范围写入状态::资源失败:
                return L1中性写入状态::资源失败;
            default: return L1中性写入状态::内部不一致;
            }
        }

        static void 规范退出事实(std::vector<稳定编码>& 退出事实) {
            std::sort(退出事实.begin(), 退出事实.end());
            退出事实.erase(std::unique(退出事实.begin(), 退出事实.end()),
                退出事实.end());
        }

        状态闭包读取 读取当前状态闭包(
            稳定编码 身份, std::uint64_t G) const {
            const auto 节点 = L1_.读取中性当前节点({L1中性CRUD合同版本, 身份});
            if (节点.状态 != L1中性读取状态::成功) {
                状态闭包读取 结果{映射读取状态(节点.状态), std::nullopt, std::nullopt};
                if (节点.状态 == L1中性读取状态::历史材料已清理) {
                    结果.墓碑 = 投影状态墓碑(身份, 节点.物理清理墓碑);
                    if (!结果.墓碑) 结果.状态 = L2中性结构状态_v1::内部错误;
                }
                return 结果;
            }
            if (!节点.事实 || 节点.读取事实代次 != G
                || 节点.事实->种类 != 节点种类::普通
                || 节点.事实->退出事实代次 || 节点.事实->当前属性.size() != 1)
                return {L2中性结构状态_v1::内部错误, std::nullopt, std::nullopt};
            const auto& 槽 = 节点.事实->当前属性.front();
            if (槽.属性类型节点 != 类型登记_->精确U64组值类型.值)
                return {L2中性结构状态_v1::内部错误, std::nullopt, std::nullopt};
            const auto 关系组 = L1_.读取中性当前源关系组({L1中性CRUD合同版本,
                身份, 定位_.族归属关系类型});
            const auto 值 = L1_.读取中性当前值({L1中性CRUD合同版本, 槽.当前值});
            if (关系组.状态 != L1中性读取状态::成功
                || 值.状态 != L1中性读取状态::成功
                || 关系组.读取事实代次 != G || 值.读取事实代次 != G
                || !值.事实 || 值.事实->所属节点 != 身份
                || 值.事实->属性类型节点 != 槽.属性类型节点
                || 值.事实->退出事实代次)
                return {关系组.状态 == L1中性读取状态::资源失败
                        || 值.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误, std::nullopt, std::nullopt};
            const L1中性关系事实* 索引 = nullptr;
            for (const auto& 关系 : 关系组.关系组)
                if (关系.角色或顺序 == 状态索引角色) {
                    if (索引) return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                    索引 = &关系;
                }
            const auto* 载荷 = std::get_if<std::vector<std::uint64_t>>(&值.事实->材料);
            if (!索引 || !载荷 || 索引->源节点 != 身份
                || 索引->目标节点 != 定位_.族锚点 || 索引->退出事实代次)
                return {L2中性结构状态_v1::内部错误, std::nullopt, std::nullopt};
            auto 状态 = 解码状态载荷(身份, 节点.事实->创建事实代次, *载荷);
            if (!状态) return {L2中性结构状态_v1::内部错误,
                std::nullopt, std::nullopt};
            std::vector<稳定编码> 上下文关系;
            const auto 上下文读取 = L1_.读取中性当前源关系组({
                L1中性CRUD合同版本, 身份, 上下文定位_.关系类型});
            if (上下文读取.状态 != L1中性读取状态::成功
                && 上下文读取.状态 != L1中性读取状态::未找到)
                return {上下文读取.状态 == L1中性读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            if (上下文读取.读取事实代次 != G)
                return {L2中性结构状态_v1::事实代次漂移,
                    std::nullopt, std::nullopt};
            bool 角色[5]{};
            for (const auto& 关系 : 上下文读取.关系组) {
                const auto 角色值 = 关系.角色或顺序;
                if (关系.源节点 != 身份
                    || 关系.关系类型节点 != 上下文定位_.关系类型
                    || 角色值 < 1 || 角色值 > 4 || 角色[角色值]
                    || 关系.退出事实代次)
                    return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                角色[角色值] = true;
                上下文关系.push_back(关系.编码);
            }
            if (!上下文关系.empty()
                && (!角色[1] || !角色[2] || !角色[3] || !角色[4]))
                return {L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            std::sort(上下文关系.begin(), 上下文关系.end());
            return {L2中性结构状态_v1::已读取,
                状态物理闭包{std::move(*状态), 索引->编码, 值.事实->编码,
                    std::move(上下文关系)},
                std::nullopt};
        }

        状态闭包读取 读取历史状态闭包(
            稳定编码 身份, std::uint64_t 截止, std::uint64_t G) const {
            const auto 节点读取 = L1_.读取中性历史事实({L1中性CRUD合同版本, 身份});
            if (节点读取.状态 != L1中性读取状态::成功) {
                状态闭包读取 结果{映射读取状态(节点读取.状态, true),
                    std::nullopt, std::nullopt};
                if (节点读取.状态 == L1中性读取状态::历史材料已清理) {
                    结果.墓碑 = 投影状态墓碑(
                        身份, 节点读取.物理清理墓碑);
                    if (!结果.墓碑) 结果.状态 = L2中性结构状态_v1::内部错误;
                }
                return 结果;
            }
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
            if (!节点 || 节点->创建事实代次 > 截止)
                return {节点 ? L2中性结构状态_v1::未找到
                    : L2中性结构状态_v1::内部错误, std::nullopt, std::nullopt};
            const bool 已退出 = 节点->退出事实代次 && *节点->退出事实代次 <= 截止;
            const auto 材料截止 = 已退出 ? *节点->退出事实代次 - 1 : 截止;
            if (材料截止 == 0) return {L2中性结构状态_v1::内部错误,
                std::nullopt, std::nullopt};
            const auto 关系组 = L1_.读取中性历史关系组({L1中性CRUD合同版本,
                L1中性关系端点方向::源, 身份, 定位_.族归属关系类型, 材料截止});
            const auto 值组 = L1_.读取中性历史属性值组({L1中性CRUD合同版本,
                身份, 材料截止});
            if (关系组.状态 != L1中性历史关系组读取状态::成功
                || 值组.状态 != L1中性历史属性值组读取状态::成功
                || 关系组.读取事实代次 != G || 值组.读取事实代次 != G)
                return {关系组.状态 == L1中性历史关系组读取状态::资源失败
                        || 值组.状态 == L1中性历史属性值组读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误, std::nullopt, std::nullopt};
            const L1中性关系事实* 索引 = nullptr;
            for (const auto& 关系 : 关系组.关系组)
                if (关系.角色或顺序 == 状态索引角色) {
                    if (索引) return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                    索引 = &关系;
                }
            const L1中性值事实* 值 = nullptr;
            for (const auto& 项 : 值组.属性值组)
                if (项.属性类型节点 == 类型登记_->精确U64组值类型.值) {
                    if (值) return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                    值 = &项;
                }
            const auto* 载荷 = 值
                ? std::get_if<std::vector<std::uint64_t>>(&值->材料) : nullptr;
            if (!索引 || !值 || !载荷) return {L2中性结构状态_v1::内部错误,
                std::nullopt, std::nullopt};
            auto 状态 = 解码状态载荷(身份, 节点->创建事实代次, *载荷);
            if (!状态) return {L2中性结构状态_v1::内部错误,
                std::nullopt, std::nullopt};
            std::vector<稳定编码> 上下文关系;
            const auto 上下文读取 = L1_.读取中性历史关系组({
                L1中性CRUD合同版本, L1中性关系端点方向::源,
                身份, 上下文定位_.关系类型, 材料截止});
            if (上下文读取.状态 != L1中性历史关系组读取状态::成功
                || 上下文读取.读取事实代次 != G)
                return {上下文读取.状态
                            == L1中性历史关系组读取状态::资源失败
                        ? L2中性结构状态_v1::资源失败
                        : L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            bool 角色[5]{};
            for (const auto& 关系 : 上下文读取.关系组) {
                const auto 角色值 = 关系.角色或顺序;
                if (关系.源节点 != 身份
                    || 关系.关系类型节点 != 上下文定位_.关系类型
                    || 角色值 < 1 || 角色值 > 4 || 角色[角色值]
                    || 关系.退出事实代次)
                    return {L2中性结构状态_v1::内部错误,
                        std::nullopt, std::nullopt};
                角色[角色值] = true;
                上下文关系.push_back(关系.编码);
            }
            if (!上下文关系.empty()
                && (!角色[1] || !角色[2] || !角色[3] || !角色[4]))
                return {L2中性结构状态_v1::内部错误,
                    std::nullopt, std::nullopt};
            std::sort(上下文关系.begin(), 上下文关系.end());
            return {已退出 ? L2中性结构状态_v1::已退出
                    : L2中性结构状态_v1::已读取,
                状态物理闭包{std::move(*状态), 索引->编码, 值->编码,
                    std::move(上下文关系)},
                std::nullopt};
        }

        L1中性写集请求 形成引用新增写集(const L2结构请求头& 请求头,
            L2结构幂等身份 幂等身份, const L2中性状态引用事实_v1& 引用,
            const std::optional<引用物理闭包>& 旧引用) const {
            L1中性写集请求 写集;
            写集.合同版本 = L1中性CRUD合同版本;
            写集.期望事实代次 = 请求头.期望事实代次;
            写集.幂等键 = 映射幂等键(引用.类别 == L2中性状态引用类别_v1::普通
                ? 新增普通引用幂等域 : 设置当前选择幂等域, 幂等身份);
            const L1中性写集本地键 根{状态根本地键值};
            const L1中性写集本地键 关系{索引关系本地键值};
            const L1中性写集本地键 值{载荷值本地键值};
            写集.节点 = {{根, 节点种类::普通, std::nullopt}};
            写集.关系 = {{关系, 根, 定位_.族锚点, 定位_.族归属关系类型,
                引用.类别 == L2中性状态引用类别_v1::普通
                    ? 普通引用索引角色 : 当前选择索引角色}};
            写集.值 = {{值, 根, 类型登记_->精确U64组值类型.值,
                编码引用载荷(引用), 根}};
            写集.属性槽变更 = {{根, 类型登记_->精确U64组值类型.值, 值}};
            if (旧引用) 写集.退出事实 = 引用退出事实组(*旧引用);
            return 写集;
        }

        L2中性状态引用写入结果_v1 提交引用新增(
            const L2结构请求头& 请求头, L2结构幂等身份 幂等身份,
            const L2中性状态引用事实_v1& 材料,
            const std::optional<引用物理闭包>& 旧引用) {
            const auto 写集 = 形成引用新增写集(请求头, 幂等身份, 材料, 旧引用);
            const auto 写入 = 提交写集(写集);
            if (写入.状态 != L1中性写入状态::成功
                && 写入.状态 != L1中性写入状态::精确重复)
                return 引用写失败(映射写入状态(写入.状态), 写入.事实代次);
            const auto 根 = 查找新编码(写入, 状态根本地键值);
            const auto 截止 = 当前代次();
            if (!根 || !截止) return 引用写失败(L2中性结构状态_v1::内部错误);
            auto 读回 = 读取当前引用闭包(*根, *截止);
            if (!读回.闭包) 读回 = 读取历史引用闭包(*根,
                写入.事实代次, *截止);
            if (!读回.闭包) return 引用写失败(读回.状态, *截止);
            std::optional<L2中性状态引用事实_v1> 已退出;
            if (旧引用) {
                已退出 = 旧引用->引用;
                已退出->生命周期.退出事实代次 = 写入.事实代次;
            }
            return {{L2中性状态动态合同版本_v1,
                    写入.状态 == L1中性写入状态::精确重复
                        ? L2中性结构状态_v1::精确重复
                        : L2中性结构状态_v1::已提交,
                    *截止, 读回.闭包->引用.生命周期.创建事实代次},
                读回.闭包->引用, std::move(已退出)};
        }

        引用闭包读取 读取当前引用闭包(
            稳定编码 身份, std::uint64_t G) const {
            const auto 节点 = L1_.读取中性当前节点({L1中性CRUD合同版本, 身份});
            if (节点.状态 != L1中性读取状态::成功)
                return {映射读取状态(节点.状态), std::nullopt};
            if (!节点.事实 || 节点.读取事实代次 != G
                || 节点.事实->退出事实代次 || 节点.事实->当前属性.size() != 1)
                return {L2中性结构状态_v1::内部错误, std::nullopt};
            const auto& 槽 = 节点.事实->当前属性.front();
            const auto 关系组 = L1_.读取中性当前源关系组({L1中性CRUD合同版本,
                身份, 定位_.族归属关系类型});
            const auto 值 = L1_.读取中性当前值({L1中性CRUD合同版本, 槽.当前值});
            if (关系组.状态 != L1中性读取状态::成功
                || 值.状态 != L1中性读取状态::成功
                || 关系组.读取事实代次 != G || 值.读取事实代次 != G || !值.事实)
                return {关系组.状态 == L1中性读取状态::资源失败
                        || 值.状态 == L1中性读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误, std::nullopt};
            const L1中性关系事实* 索引 = nullptr;
            for (const auto& 关系 : 关系组.关系组)
                if (关系.角色或顺序 == 普通引用索引角色
                    || 关系.角色或顺序 == 当前选择索引角色) {
                    if (索引) return {L2中性结构状态_v1::内部错误, std::nullopt};
                    索引 = &关系;
                }
            const auto* 载荷 = std::get_if<std::vector<std::uint64_t>>(&值.事实->材料);
            if (!索引 || !载荷) return {L2中性结构状态_v1::内部错误,
                std::nullopt};
            auto 引用 = 解码引用载荷(身份, 节点.事实->创建事实代次,
                std::nullopt, *载荷);
            if (!引用 || (引用->类别 == L2中性状态引用类别_v1::普通
                    ? 索引->角色或顺序 != 普通引用索引角色
                    : 索引->角色或顺序 != 当前选择索引角色))
                return {L2中性结构状态_v1::内部错误, std::nullopt};
            return {L2中性结构状态_v1::已读取,
                引用物理闭包{std::move(*引用), 索引->编码, 值.事实->编码}};
        }

        引用闭包读取 读取历史引用闭包(
            稳定编码 身份, std::uint64_t 截止, std::uint64_t G) const {
            const auto 节点读取 = L1_.读取中性历史事实({L1中性CRUD合同版本, 身份});
            if (节点读取.状态 != L1中性读取状态::成功)
                return {映射读取状态(节点读取.状态, true), std::nullopt};
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1中性节点事实>(&*节点读取.事实) : nullptr;
            if (!节点 || 节点->创建事实代次 > 截止)
                return {节点 ? L2中性结构状态_v1::未找到
                    : L2中性结构状态_v1::内部错误, std::nullopt};
            const bool 已退出 = 节点->退出事实代次 && *节点->退出事实代次 <= 截止;
            const auto 材料截止 = 已退出 ? *节点->退出事实代次 - 1 : 截止;
            const auto 关系组 = L1_.读取中性历史关系组({L1中性CRUD合同版本,
                L1中性关系端点方向::源, 身份, 定位_.族归属关系类型, 材料截止});
            const auto 值组 = L1_.读取中性历史属性值组({L1中性CRUD合同版本,
                身份, 材料截止});
            if (关系组.状态 != L1中性历史关系组读取状态::成功
                || 值组.状态 != L1中性历史属性值组读取状态::成功
                || 关系组.读取事实代次 != G || 值组.读取事实代次 != G)
                return {L2中性结构状态_v1::内部错误, std::nullopt};
            const L1中性关系事实* 索引 = nullptr;
            for (const auto& 关系 : 关系组.关系组)
                if (关系.角色或顺序 == 普通引用索引角色
                    || 关系.角色或顺序 == 当前选择索引角色) {
                    if (索引) return {L2中性结构状态_v1::内部错误, std::nullopt};
                    索引 = &关系;
                }
            const L1中性值事实* 值 = nullptr;
            for (const auto& 项 : 值组.属性值组)
                if (项.属性类型节点 == 类型登记_->精确U64组值类型.值) {
                    if (值) return {L2中性结构状态_v1::内部错误, std::nullopt};
                    值 = &项;
                }
            const auto* 载荷 = 值
                ? std::get_if<std::vector<std::uint64_t>>(&值->材料) : nullptr;
            if (!索引 || !值 || !载荷)
                return {L2中性结构状态_v1::内部错误, std::nullopt};
            auto 引用 = 解码引用载荷(身份, 节点->创建事实代次,
                已退出 ? 节点->退出事实代次 : std::nullopt, *载荷);
            if (!引用) return {L2中性结构状态_v1::内部错误, std::nullopt};
            return {已退出 ? L2中性结构状态_v1::已退出
                    : L2中性结构状态_v1::已读取,
                引用物理闭包{std::move(*引用), 索引->编码, 值->编码}};
        }

        状态枚举结果 枚举当前状态(std::uint64_t G) const {
            const auto 组 = L1_.读取中性当前目标关系组({L1中性CRUD合同版本,
                定位_.族锚点, 定位_.族归属关系类型});
            if (组.状态 != L1中性读取状态::成功
                && 组.状态 != L1中性读取状态::未找到)
                return {映射读取状态(组.状态), {}};
            if (组.读取事实代次 != G)
                return {L2中性结构状态_v1::事实代次漂移, {}};
            状态枚举结果 结果{L2中性结构状态_v1::已读取, {}};
            for (const auto& 关系 : 组.关系组) {
                if (关系.角色或顺序 != 状态索引角色) continue;
                const auto 读取 = 读取当前状态闭包(关系.源节点, G);
                if (!读取.闭包 || 读取.闭包->索引关系 != 关系.编码)
                    return {读取.闭包 ? L2中性结构状态_v1::内部错误
                        : 读取.状态, {}};
                结果.状态组.push_back(*读取.闭包);
            }
            std::sort(结果.状态组.begin(), 结果.状态组.end(), [](const auto& 左,
                const auto& 右) { return 左.状态.身份.值 < 右.状态.身份.值; });
            for (std::size_t i = 1; i < 结果.状态组.size(); ++i)
                if (结果.状态组[i - 1].状态.身份 == 结果.状态组[i].状态.身份)
                    return {L2中性结构状态_v1::内部错误, {}};
            return 结果;
        }

        引用枚举结果 枚举当前引用(
            std::uint64_t G, L2中性状态引用类别_v1 类别) const {
            const auto 组 = L1_.读取中性当前目标关系组({L1中性CRUD合同版本,
                定位_.族锚点, 定位_.族归属关系类型});
            if (组.状态 != L1中性读取状态::成功
                && 组.状态 != L1中性读取状态::未找到)
                return {映射读取状态(组.状态), {}};
            if (组.读取事实代次 != G)
                return {L2中性结构状态_v1::事实代次漂移, {}};
            const auto 角色 = 类别 == L2中性状态引用类别_v1::普通
                ? 普通引用索引角色 : 当前选择索引角色;
            引用枚举结果 结果{L2中性结构状态_v1::已读取, {}};
            for (const auto& 关系 : 组.关系组) {
                if (关系.角色或顺序 != 角色) continue;
                const auto 读取 = 读取当前引用闭包(关系.源节点, G);
                if (!读取.闭包 || 读取.闭包->索引关系 != 关系.编码
                    || 读取.闭包->引用.类别 != 类别)
                    return {读取.闭包 ? L2中性结构状态_v1::内部错误
                        : 读取.状态, {}};
                结果.引用组.push_back(*读取.闭包);
            }
            return 结果;
        }

        引用闭包读取 查找当前选择(
            稳定编码 引用方, 稳定编码 角色, std::uint64_t G) const {
            const auto 组 = 枚举当前引用(G, L2中性状态引用类别_v1::当前选择);
            if (组.状态 != L2中性结构状态_v1::已读取) return {组.状态, std::nullopt};
            std::optional<引用物理闭包> 找到;
            for (const auto& 引用 : 组.引用组)
                if (引用.引用.引用方 == 引用方 && 引用.引用.引用角色 == 角色) {
                    if (找到) return {L2中性结构状态_v1::引用冲突, std::nullopt};
                    找到 = 引用;
                }
            return {找到 ? L2中性结构状态_v1::已读取
                : L2中性结构状态_v1::未找到, std::move(找到)};
        }

        引用闭包读取 查找历史当前选择(稳定编码 引用方, 稳定编码 角色,
            std::uint64_t 截止, std::uint64_t G) const {
            const auto 组 = L1_.读取中性历史关系组({L1中性CRUD合同版本,
                L1中性关系端点方向::目标, 定位_.族锚点,
                定位_.族归属关系类型, 截止});
            if (组.状态 != L1中性历史关系组读取状态::成功
                || 组.读取事实代次 != G)
                return {组.状态 == L1中性历史关系组读取状态::资源失败
                    ? L2中性结构状态_v1::资源失败
                    : L2中性结构状态_v1::内部错误, std::nullopt};
            std::optional<引用物理闭包> 找到;
            for (const auto& 关系 : 组.关系组) {
                if (关系.角色或顺序 != 当前选择索引角色) continue;
                const auto 读取 = 读取历史引用闭包(关系.源节点, 截止, G);
                if (!读取.闭包) return 读取;
                if (读取.闭包->引用.引用方 == 引用方
                    && 读取.闭包->引用.引用角色 == 角色) {
                    if (找到) return {L2中性结构状态_v1::引用冲突, std::nullopt};
                    找到 = *读取.闭包;
                }
            }
            return {找到 ? L2中性结构状态_v1::已读取
                : L2中性结构状态_v1::未找到, std::move(找到)};
        }

        static std::vector<稳定编码> 状态退出事实组(const 状态物理闭包& 闭包) {
            std::vector<稳定编码> 组{闭包.状态.身份.值, 闭包.索引关系, 闭包.载荷值};
            组.insert(组.end(), 闭包.上下文关系.begin(), 闭包.上下文关系.end());
            std::sort(组.begin(), 组.end()); return 组;
        }
        static std::vector<稳定编码> 引用退出事实组(const 引用物理闭包& 闭包) {
            std::vector<稳定编码> 组{闭包.引用.身份.值, 闭包.索引关系, 闭包.载荷值};
            std::sort(组.begin(), 组.end()); return 组;
        }
        static void 追加物理闭包(L1物理清理请求& 请求,
            const 状态物理闭包& 闭包) {
            请求.待清理事实身份组.push_back({L1物理清理事实种类::节点,
                闭包.状态.身份.值});
            请求.待清理事实身份组.push_back({L1物理清理事实种类::关系,
                闭包.索引关系});
            请求.待清理事实身份组.push_back({L1物理清理事实种类::值,
                闭包.载荷值});
            for (const auto 关系 : 闭包.上下文关系)
                请求.待清理事实身份组.push_back({
                    L1物理清理事实种类::关系, 关系});
        }
        static void 追加物理闭包(L1物理清理请求& 请求,
            const 引用物理闭包& 闭包) {
            请求.待清理事实身份组.push_back({L1物理清理事实种类::节点,
                闭包.引用.身份.值});
            请求.待清理事实身份组.push_back({L1物理清理事实种类::关系,
                闭包.索引关系});
            请求.待清理事实身份组.push_back({L1物理清理事实种类::值,
                闭包.载荷值});
        }
        const L1事实基座服务& L1_;
        L1所有者范围写端口& 所有者写入端口_;
        const L2状态结构内部::状态身份来源定位& 定位_;
        const std::optional<L2状态结构类型登记>& 类型登记_;
        const L2状态结构内部::状态上下文关系类型定位& 上下文定位_;
        L2中性实例材料保留策略_v1 保留策略_{};
    };

public:
    当前值记录状态参与者结果_v1 形成组合发布当前值记录状态参与者_v1(
        const L2结构请求头& 请求头, L2结构幂等身份 幂等身份,
        L2特征定义身份 特征类型, const L2原始值材料& 旧值,
        const L2原始值材料& 新值, std::int64_t 变化UTC纳秒,
        L2存在身份 主体存在, L2场景身份 共同场景,
        L2特征实例身份 特征实例, L2存在身份 来源存在,
        稳定编码 当前选择角色,
        const std::optional<L2中性状态引用事实_v1>& 旧选择,
        bool legacy基线兼容) const noexcept {
        if (!组合发布当前值状态材料就绪_v1()) {
            当前值记录状态参与者结果_v1 失败;
            失败.状态 = L2结构状态::未找到;
            return 失败;
        }
        return 中性状态提供者_.形成当前值记录状态参与者_v1(
            请求头, 幂等身份, 特征类型, 旧值, 新值, 变化UTC纳秒,
            主体存在, 共同场景, 特征实例, 来源存在, 当前选择角色,
            状态上下文关系类型定位_.关系类型,
            结构类型登记定位_->当前选择关系类型,
            第一层写入端口_.所有者身份(), 旧选择, legacy基线兼容);
    }

private:

    struct 目标状态合同首次写集读取值 final {
        L2结构状态 状态 = L2结构状态::内部不一致;
        std::uint64_t 事实截止代次 = 0;
        std::optional<L1所有者范围写集请求> 写集;
    };

    目标状态合同首次写集读取值 读取目标状态合同首次写集(
        L2结构幂等身份 身份) const {
        const auto L1身份 = L2状态结构内部::映射目标状态合同幂等键(身份);
        const auto 读取 = 第一层写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, L1身份});
        if (读取.状态 == L1所有者范围读取状态::未找到)
            return {L2结构状态::未找到, 读取.读取事实代次, std::nullopt};
        if (读取.状态 != L1所有者范围读取状态::成功) {
            const auto 状态 = 读取.状态 == L1所有者范围读取状态::许可拒绝
                ? L2结构状态::许可拒绝
                : 读取.状态 == L1所有者范围读取状态::资源失败
                    ? L2结构状态::资源失败 : L2结构状态::内部不一致;
            return {状态, 读取.读取事实代次, std::nullopt};
        }
        if (读取.合同版本 != L1所有者范围首次写入读取合同版本
            || 读取.所有者 != 第一层写入端口_.所有者身份()
            || 读取.写入幂等身份 != L1身份 || 读取.读取事实代次 == 0
            || !读取.首次规范化写集 || !读取.首次写入结果
            || 读取.首次规范化写集->写入幂等身份 != L1身份
            || 读取.首次写入结果->写入幂等身份 != L1身份)
            return {L2结构状态::内部不一致, 读取.读取事实代次, std::nullopt};
        return {L2结构状态::已读取, 读取.读取事实代次,
            std::move(读取.首次规范化写集)};
    }

    L2结构结果头 检查目标状态合同上下文(
        const L2结构请求头& 请求头, L2特征定义身份 特征定义,
        L2特征比较注册身份 比较注册) const {
        const auto 定义 = 特征服务_.读取完整统一特征定义({请求头,
            L2读取类别::当前, 特征定义, 0});
        if (!定义.成功() || !定义.特征定义)
            return {L2结构合同版本,
                定义.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 定义.结果头.状态,
                定义.结果头.事实截止代次, std::nullopt};
        const auto 注册 = 特征服务_.读取当前特征比较注册(
            {请求头, 特征定义, L2特征比较用途::目标判断});
        if (!注册.成功() || !注册.注册)
            return {L2结构合同版本,
                注册.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 注册.结果头.状态,
                注册.结果头.事实截止代次, std::nullopt};
        if (定义.结果头.事实截止代次 != 请求头.期望事实代次
            || 注册.结果头.事实截止代次 != 请求头.期望事实代次
            || 定义.特征定义->身份 != 特征定义
            || !L2状态结构内部::目标判断比较注册符合合同(
                *注册.注册, 特征定义, 比较注册))
            return {L2结构合同版本,
                注册.注册->身份 != 比较注册
                    ? L2结构状态::引用冲突 : L2结构状态::内部不一致,
                std::max(定义.结果头.事实截止代次,
                    注册.结果头.事实截止代次), std::nullopt};
        return {L2结构合同版本, L2结构状态::已读取,
            请求头.期望事实代次, std::nullopt};
    }

    L2目标状态合同新增结果 提交并读回目标新增写集(
        const L1所有者范围写集请求& 写集) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.所有者 != 第一层写入端口_.所有者身份()
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2状态结构内部::形成目标新增失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 状态 = L2状态结构内部::映射写入状态(写入.状态);
        if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2状态结构内部::形成目标新增失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return L2状态结构内部::形成目标新增失败(状态, 写入.事实代次);
        }
        if (!L2状态结构内部::写入成功边界完整(写入)
            || 写入.新编码映射.size() != 5)
            return L2状态结构内部::形成目标新增失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 新身份 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::目标状态合同节点本地键值);
        if (!新身份) return L2状态结构内部::形成目标新增失败(
            L2结构状态::内部不一致, 写入.事实代次);
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.合同版本 != L1中性CRUD合同版本
            || 当前代次.状态 != L1中性读取状态::成功
            || 当前代次.事实代次 < 写入.事实代次)
            return L2状态结构内部::形成目标新增失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 历史 = 读取完整目标状态合同({
            {L2结构合同版本, 当前代次.事实代次}, L2读取类别::历史,
            L2目标状态合同身份{*新身份}, 写入.事实代次});
        if (!历史.成功() || !历史.合同 || 历史.合同->生命周期.退出事实代次)
            return L2状态结构内部::形成目标新增失败(
                L2结构状态::内部不一致, 写入.事实代次);
        L2目标状态合同新增结果 结果{{L2结构合同版本, 状态,
            写入.事实代次, 写入.事实代次}, *历史.合同};
        return 结果.成功() ? 结果 : L2状态结构内部::形成目标新增失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }

    L2目标状态合同替换结果 提交并读回目标替换写集(
        const L1所有者范围写集请求& 写集, L2目标状态合同身份 旧身份) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.所有者 != 第一层写入端口_.所有者身份()
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2状态结构内部::形成目标替换失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 状态 = L2状态结构内部::映射写入状态(写入.状态);
        if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2状态结构内部::形成目标替换失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return L2状态结构内部::形成目标替换失败(状态, 写入.事实代次);
        }
        if (!L2状态结构内部::写入成功边界完整(写入)
            || 写入.新编码映射.size() != 5)
            return L2状态结构内部::形成目标替换失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 新身份 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::目标状态合同节点本地键值);
        if (!新身份) return L2状态结构内部::形成目标替换失败(
            L2结构状态::内部不一致, 写入.事实代次);
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.合同版本 != L1中性CRUD合同版本
            || 当前代次.状态 != L1中性读取状态::成功
            || 当前代次.事实代次 < 写入.事实代次)
            return L2状态结构内部::形成目标替换失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const L2结构请求头 头{L2结构合同版本, 当前代次.事实代次};
        const auto 新合同 = 读取完整目标状态合同({头, L2读取类别::历史,
            L2目标状态合同身份{*新身份}, 写入.事实代次});
        const auto 旧合同 = 读取完整目标状态合同({头, L2读取类别::历史,
            旧身份, 写入.事实代次});
        if (!新合同.成功() || !新合同.合同
            || 新合同.合同->生命周期.退出事实代次
            || !旧合同.成功() || !旧合同.合同
            || 旧合同.合同->生命周期.退出事实代次 != 写入.事实代次)
            return L2状态结构内部::形成目标替换失败(
                L2结构状态::内部不一致, 写入.事实代次);
        L2目标状态合同替换结果 结果{{L2结构合同版本, 状态,
            写入.事实代次, 写入.事实代次}, *新合同.合同, *旧合同.合同};
        return 结果.成功() ? 结果 : L2状态结构内部::形成目标替换失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }

    L2目标状态合同退出结果 提交并读回目标退出写集(
        const L1所有者范围写集请求& 写集, L2目标状态合同身份 旧身份) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.所有者 != 第一层写入端口_.所有者身份()
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2状态结构内部::形成目标退出失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 状态 = L2状态结构内部::映射写入状态(写入.状态);
        if (状态 != L2结构状态::已提交 && 状态 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2状态结构内部::形成目标退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return L2状态结构内部::形成目标退出失败(状态, 写入.事实代次);
        }
        if (!L2状态结构内部::写入成功边界完整(写入)
            || !写入.新编码映射.empty())
            return L2状态结构内部::形成目标退出失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.合同版本 != L1中性CRUD合同版本
            || 当前代次.状态 != L1中性读取状态::成功
            || 当前代次.事实代次 < 写入.事实代次)
            return L2状态结构内部::形成目标退出失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 历史 = 读取完整目标状态合同({
            {L2结构合同版本, 当前代次.事实代次}, L2读取类别::历史,
            旧身份, 写入.事实代次});
        if (!历史.成功() || !历史.合同
            || 历史.合同->生命周期.退出事实代次 != 写入.事实代次)
            return L2状态结构内部::形成目标退出失败(
                L2结构状态::内部不一致, 写入.事实代次);
        L2目标状态合同退出结果 结果{{L2结构合同版本, 状态,
            写入.事实代次, 写入.事实代次}, *历史.合同};
        return 结果.成功() ? 结果 : L2状态结构内部::形成目标退出失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }

    L2目标状态合同完整读取结果 读取当前完整目标状态合同(
        const L2目标状态合同完整读取请求& 请求,
        const L2目标状态合同结构类型登记& 类型) const {
        L1所有者范围一致当前读取请求 L1请求;
        L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
        L1请求.期望事实代次 = 请求.请求头.期望事实代次;
        L1请求.所有者 = {第一层写入端口_.所有者身份()};
        L1请求.节点 = {请求.合同.值};
        L1请求.属性值 = {{请求.合同.值, 类型.I64值类型.值},
            {请求.合同.值, 类型.U64合同属性类型.值}};
        L1请求.源关系组 = {
            {请求.合同.值, 类型.特征定义关系类型.值},
            {请求.合同.值, 类型.比较注册关系类型.值},
            {请求.合同.值, 状态身份来源定位_.族归属关系类型},
            {请求.合同.值, 结构类型登记定位_->主体关系类型.值},
            {请求.合同.值, 结构类型登记定位_->特征实例关系类型.值}};
        const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
        const auto 顶层 = L2状态结构内部::解释一致读取顶层(
            读取, 请求.请求头.期望事实代次);
        if (!顶层.成功()) return L2状态结构内部::形成目标读取失败(
            请求, 顶层.状态, 顶层.截止);
        if (读取.所有者.size() != 1 || 读取.节点.size() != 1
            || !读取.关系.empty() || !读取.值.empty()
            || 读取.属性值.size() != 2 || 读取.源关系组.size() != 5
            || !读取.目标关系组.empty())
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 顶层.截止);
        const auto* 节点项 = L2状态结构内部::查找唯一节点项(读取, 请求.合同.值);
        if (!节点项) return L2状态结构内部::形成目标读取失败(
            请求, L2结构状态::内部不一致, 顶层.截止);
        if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
            if (节点项->事实) return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 顶层.截止);
            return L2状态结构内部::形成目标读取失败(请求,
                L2状态结构内部::映射当前项目状态(节点项->状态), 顶层.截止);
        }
        if (!节点项->事实 || 节点项->事实->写入所有者
                != 第一层写入端口_.所有者身份()
            || !L2状态结构内部::普通当前节点完整(
                *节点项->事实, 请求.合同.值, 顶层.截止)
            || 节点项->事实->当前属性.size() != 2)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 顶层.截止);
        const auto* 特征组 = L2状态结构内部::查找唯一源关系组(
            读取, 请求.合同.值, 类型.特征定义关系类型.值);
        const auto* 比较组 = L2状态结构内部::查找唯一源关系组(
            读取, 请求.合同.值, 类型.比较注册关系类型.值);
        const auto* 族组 = L2状态结构内部::查找唯一源关系组(
            读取, 请求.合同.值, 状态身份来源定位_.族归属关系类型);
        const auto* 主体组 = L2状态结构内部::查找唯一源关系组(
            读取, 请求.合同.值, 结构类型登记定位_->主体关系类型.值);
        const auto* 实例组 = L2状态结构内部::查找唯一源关系组(
            读取, 请求.合同.值, 结构类型登记定位_->特征实例关系类型.值);
        if (!特征组 || 特征组->成员.size() != 1
            || !比较组 || 比较组->成员.size() != 1
            || !族组 || !族组->成员.empty()
            || !主体组 || !主体组->成员.empty()
            || !实例组 || !实例组->成员.empty())
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 顶层.截止);
        const auto* 目标属性 = L2状态结构内部::查找唯一属性项(
            读取, 请求.合同.值, 类型.I64值类型.值);
        const auto* 合同属性 = L2状态结构内部::查找唯一属性项(
            读取, 请求.合同.值, 类型.U64合同属性类型.值);
        const auto 属性完整 = [&](const auto* 项, 稳定编码 类型编码) noexcept {
            return 项 && 项->状态 == L1所有者范围一致当前读取项目状态::成功
                && 项->投影 && 项->节点 == 请求.合同.值
                && 项->投影->属性槽.属性类型节点 == 类型编码
                && 项->投影->属性槽.当前值 == 项->投影->当前值事实.编码
                && !项->投影->当前值事实.退出事实代次;
        };
        if (!属性完整(目标属性, 类型.I64值类型.值)
            || !属性完整(合同属性, 类型.U64合同属性类型.值))
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 顶层.截止);
        const auto& 特征关系 = 特征组->成员.front().关系;
        const auto& 比较关系 = 比较组->成员.front().关系;
        if (!L2状态结构内部::普通当前节点完整(
                特征组->成员.front().对端节点, 特征关系.目标节点, 顶层.截止)
            || !L2状态结构内部::普通当前节点完整(
                比较组->成员.front().对端节点, 比较关系.目标节点, 顶层.截止))
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 顶层.截止);
        auto 事实 = L2状态结构内部::形成目标状态合同事实(
            *节点项->事实, 特征关系, 比较关系,
            目标属性->投影->当前值事实, 合同属性->投影->当前值事实,
            类型, 第一层写入端口_.所有者身份(), 顶层.截止);
        if (!事实 || 事实->身份 != 请求.合同)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 顶层.截止);
        const auto 上下文 = 检查目标状态合同上下文(
            请求.请求头, 事实->特征定义, 事实->比较注册);
        if (上下文.状态 != L2结构状态::已读取
            || 上下文.事实截止代次 != 顶层.截止)
            return L2状态结构内部::形成目标读取失败(
                请求, 上下文.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 上下文.状态,
                std::max(上下文.事实截止代次, 顶层.截止));
        L2目标状态合同完整读取结果 结果{{L2结构合同版本,
            L2结构状态::已读取, 顶层.截止, std::nullopt},
            L2读取类别::当前, 0, std::move(事实)};
        return 结果.成功() ? 结果 : L2状态结构内部::形成目标读取失败(
            请求, L2结构状态::内部不一致, 顶层.截止);
    }

    L2目标状态合同完整读取结果 读取历史完整目标状态合同(
        const L2目标状态合同完整读取请求& 请求,
        const L2目标状态合同结构类型登记& 类型) const {
        const auto 前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (前代次.合同版本 != L1中性CRUD合同版本
            || 前代次.状态 != L1中性读取状态::成功)
            return L2状态结构内部::形成目标读取失败(请求,
                L2状态结构内部::映射事实代次探测失败(前代次.状态),
                前代次.事实代次);
        if (前代次.事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::事实代次漂移, 前代次.事实代次);
        const auto 节点读取 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 请求.合同.值});
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 请求.合同.值
            || 节点读取.读取事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点读取.状态 != L1所有者范围读取状态::成功)
            return L2状态结构内部::形成目标读取失败(请求,
                L2状态结构内部::映射历史读取状态(节点读取.状态),
                请求.历史截止事实代次);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (!节点 || 节点->编码 != 请求.合同.值
            || 节点->写入所有者 != 第一层写入端口_.所有者身份()
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点->创建事实代次 > 请求.历史截止事实代次)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::未找到, 请求.历史截止事实代次);
        const std::uint64_t 结构截止 = 节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次
            ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
        if (结构截止 == 0) return L2状态结构内部::形成目标读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const auto 读关系 = [&](稳定编码 类型编码) {
            return L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
                L1所有者范围关系端点方向::源, 请求.合同.值, 类型编码,
                结构截止});
        };
        const auto 特征组 = 读关系(类型.特征定义关系类型.值);
        const auto 比较组 = 读关系(类型.比较注册关系类型.值);
        const auto 族组 = 读关系(状态身份来源定位_.族归属关系类型);
        const auto 主体组 = 读关系(结构类型登记定位_->主体关系类型.值);
        const auto 实例组 = 读关系(结构类型登记定位_->特征实例关系类型.值);
        const auto 属性组 = L1_.读取所有者范围历史属性值组({
            L1所有者范围CRUD合同版本, 请求.合同.值, 结构截止});
        const auto 关系失败状态 = [&](const auto& 组) noexcept {
            return 组.状态 == L1所有者范围读取状态::成功
                ? L2结构状态::已读取
                : L2状态结构内部::映射历史关系组失败状态(组.状态);
        };
        for (const auto* 组 : {&特征组, &比较组, &族组, &主体组, &实例组})
            if (组->状态 != L1所有者范围读取状态::成功)
                return L2状态结构内部::形成目标读取失败(
                    请求, 关系失败状态(*组), 组->读取事实代次);
        if (属性组.状态 != L1所有者范围读取状态::成功)
            return L2状态结构内部::形成目标读取失败(请求,
                L2状态结构内部::映射历史属性组失败状态(属性组.状态),
                属性组.读取事实代次);
        const auto 关系组完整 = [&](const auto& 组, 稳定编码 类型编码) noexcept {
            return 组.合同版本 == L1所有者范围CRUD合同版本
                && 组.方向 == L1所有者范围关系端点方向::源
                && 组.端点节点 == 请求.合同.值 && 组.关系类型节点 == 类型编码
                && 组.历史截止事实代次 == 结构截止
                && 组.读取事实代次 == 请求.请求头.期望事实代次;
        };
        if (!关系组完整(特征组, 类型.特征定义关系类型.值)
            || !关系组完整(比较组, 类型.比较注册关系类型.值)
            || !关系组完整(族组, 状态身份来源定位_.族归属关系类型)
            || !关系组完整(主体组, 结构类型登记定位_->主体关系类型.值)
            || !关系组完整(实例组, 结构类型登记定位_->特征实例关系类型.值)
            || 特征组.关系组.size() != 1 || 比较组.关系组.size() != 1
            || !族组.关系组.empty() || !主体组.关系组.empty()
            || !实例组.关系组.empty()
            || 属性组.合同版本 != L1所有者范围CRUD合同版本
            || 属性组.所属节点 != 请求.合同.值
            || 属性组.历史截止事实代次 != 结构截止
            || 属性组.读取事实代次 != 请求.请求头.期望事实代次
            || 属性组.属性值组.size() != 2)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const L1所有者范围值事实* 目标值 = nullptr;
        const L1所有者范围值事实* 合同值 = nullptr;
        for (const auto& 值 : 属性组.属性值组) {
            if (值.属性类型节点 == 类型.I64值类型.值) {
                if (目标值) return L2状态结构内部::形成目标读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
                目标值 = &值;
            } else if (值.属性类型节点 == 类型.U64合同属性类型.值) {
                if (合同值) return L2状态结构内部::形成目标读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
                合同值 = &值;
            } else return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        }
        if (!目标值 || !合同值) return L2状态结构内部::形成目标读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        auto 事实 = L2状态结构内部::形成目标状态合同事实(*节点,
            特征组.关系组.front(), 比较组.关系组.front(), *目标值, *合同值,
            类型, 第一层写入端口_.所有者身份(), 请求.历史截止事实代次, true);
        if (!事实 || 事实->身份 != 请求.合同)
            return L2状态结构内部::形成目标读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const auto 定义 = 特征服务_.读取完整统一特征定义({请求.请求头,
            L2读取类别::历史, 事实->特征定义, 请求.历史截止事实代次});
        const auto 注册 = 特征服务_.读取历史特征比较注册({请求.请求头,
            事实->比较注册, 请求.历史截止事实代次});
        if (!定义.成功() || !定义.特征定义 || !注册.成功() || !注册.注册
            || 定义.特征定义->身份 != 事实->特征定义
            || !L2状态结构内部::目标判断比较注册符合合同(
                *注册.注册, 事实->特征定义, 事实->比较注册))
            return L2状态结构内部::形成目标读取失败(请求,
                定义.结果头.状态 == L2结构状态::资源失败
                        || 定义.结果头.状态 == L2结构状态::许可拒绝
                        || 定义.结果头.状态 == L2结构状态::事实代次漂移
                    ? 定义.结果头.状态
                    : 注册.结果头.状态 == L2结构状态::资源失败
                            || 注册.结果头.状态 == L2结构状态::许可拒绝
                            || 注册.结果头.状态 == L2结构状态::事实代次漂移
                        ? 注册.结果头.状态 : L2结构状态::内部不一致,
                请求.历史截止事实代次);
        const auto 后代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (后代次.合同版本 != L1中性CRUD合同版本
            || 后代次.状态 != L1中性读取状态::成功
            || 后代次.事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成目标读取失败(请求,
                后代次.状态 == L1中性读取状态::成功
                    ? L2结构状态::事实代次漂移
                    : L2状态结构内部::映射事实代次探测失败(后代次.状态),
                后代次.事实代次);
        L2目标状态合同完整读取结果 结果{{L2结构合同版本,
            L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
            L2读取类别::历史, 请求.历史截止事实代次, std::move(事实)};
        return 结果.成功() ? 结果 : L2状态结构内部::形成目标读取失败(
            请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
    }

    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务,
        L2状态所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument("L2 state owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    L2状态首态结果_v2 提交并读回新增首态_v2(
        const L1所有者范围写集请求& 写集,
        const L2状态首态请求_v2& 请求,
        const L2状态结构类型登记& 登记) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.所有者 != 第一层写入端口_.所有者身份()
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::内部不一致,
                L2状态首态操作状态_v2::内部不一致,
                写入.事实代次);
        const auto 公共状态 = L2状态结构内部::映射写入状态(写入.状态);
        if (公共状态 != L2结构状态::已提交
            && 公共状态 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2状态结构内部::形成首态失败_v2(
                    L2结构状态::内部不一致,
                    L2状态首态操作状态_v2::内部不一致,
                    写入.事实代次);
            return L2状态结构内部::形成首态失败_v2(公共状态,
                L2状态结构内部::映射首态操作状态(公共状态),
                写入.事实代次);
        }
        if (!L2状态结构内部::写入成功边界完整(写入)
            || 写入.新编码映射.size() != 7)
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::内部不一致,
                L2状态首态操作状态_v2::已可能发布,
                写入.事实代次, 写入.事实代次);
        const auto 状态编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态节点本地键值);
        const auto 族归属关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态族归属关系本地键值);
        const auto 主体关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态主体关系本地键值);
        const auto 特征关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态特征实例关系本地键值);
        const auto 当前选择关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态当前选择关系本地键值);
        const auto 精确值编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态精确值本地键值);
        const auto 时间值编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态时间值本地键值);
        if (!状态编码 || !族归属关系编码 || !主体关系编码 || !特征关系编码
            || !当前选择关系编码 || !精确值编码 || !时间值编码)
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::内部不一致,
                L2状态首态操作状态_v2::已可能发布,
                写入.事实代次, 写入.事实代次);
        const auto G1 = 写入.事实代次;
        const auto 提交后失败 = [&]() noexcept {
            return L2状态结构内部::形成首态失败_v2(
                L2结构状态::内部不一致,
                L2状态首态操作状态_v2::已可能发布, G1, G1);
        };
        try {
            const auto 当前代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.合同版本 != L1中性CRUD合同版本
                || 当前代次.事实代次 < G1)
                return 提交后失败();
            const auto Gnow = 当前代次.事实代次;
            if (写入.状态 == L1所有者范围写入状态::成功) {
                if (Gnow != G1) return 提交后失败();
#if defined(ARCH_L1_L2_STATE_SELECTION_VALIDATION)
                if (ARCH_首态提交后首次读回失败一次_) {
                    ARCH_首态提交后首次读回失败一次_ = false;
                    return 提交后失败();
                }
#endif
                const auto 正式当前选择 = 读取特征实例当前状态选择(
                    {{L2结构合同版本, G1}, 请求.特征实例});
                if (!正式当前选择.成功() || !正式当前选择.当前选择关系
                    || !正式当前选择.当前状态
                    || 正式当前选择.结果头.事实截止代次 != G1
                    || 正式当前选择.当前选择关系->关系稳定编码
                        != *当前选择关系编码
                    || 正式当前选择.当前选择关系->状态.值 != *状态编码
                    || 正式当前选择.当前状态->身份.值 != *状态编码)
                    return 提交后失败();
            }
            const L2结构请求头 读回头{L2结构合同版本, Gnow};
            const auto 状态 = 读取完整状态({读回头, L2读取类别::历史,
                L2状态身份{*状态编码}, G1});
            const auto 当前选择 = 读取特征实例历史状态选择(
                {读回头, 请求.特征实例, G1});
            if (状态.结果头.状态 != L2结构状态::已读取 || !状态.状态
                || !状态.自有关系 || 状态.结果头.事实截止代次 != G1
                || !当前选择.成功() || !当前选择.当前选择关系
                || !当前选择.状态
                || 当前选择.结果头.事实截止代次 != G1
                || 当前选择.当前选择关系->关系稳定编码
                    != *当前选择关系编码
                || 当前选择.当前选择关系->关系类型 != 登记.当前选择关系类型
                || 当前选择.当前选择关系->状态.值 != *状态编码
                || 当前选择.状态->身份.值 != *状态编码
                || 当前选择.当前选择关系->生命周期.创建事实代次 != G1
                || 当前选择.当前选择关系->生命周期.退出事实代次
                || 状态.自有关系->族归属关系稳定编码 != *族归属关系编码
                || 状态.自有关系->主体关系稳定编码 != *主体关系编码
                || 状态.自有关系->特征实例关系稳定编码 != *特征关系编码
                || 状态.状态->精确值.值稳定编码 != *精确值编码
                || 状态.状态->时间值.值稳定编码 != *时间值编码
                || 状态.状态->生命周期.创建事实代次 != G1
                || 状态.状态->主体存在 != 请求.主体存在
                || 状态.状态->特征实例 != 请求.特征实例
                || 状态.状态->精确值.类型化不可变材料 != 请求.精确值材料
                || 状态.状态->时间值.类型化不可变材料 != 请求.时间值材料
                || 状态.状态->来源稳定编码 != 请求.来源稳定编码)
                return 提交后失败();
            const auto 操作状态 = 公共状态 == L2结构状态::已提交
                ? L2状态首态操作状态_v2::已提交
                : L2状态首态操作状态_v2::精确重复;
            L2状态首态结果_v2 结果{{L2结构合同版本, 公共状态,
                G1, G1}, L2状态首态专属合同版本_v2, 操作状态,
                *状态.状态, *状态.自有关系, *当前选择.当前选择关系};
            return 结果.成功() ? 结果 : 提交后失败();
        } catch (...) {
            return 提交后失败();
        }
    }

    L2状态写入结果 提交并读回新增状态(
        const L1所有者范围写集请求& 写集, const L2状态新增请求& 请求,
        const L2状态结构类型登记& 登记) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
        if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2状态结构内部::形成写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return L2状态结构内部::形成写入失败(状态码, 写入.事实代次);
        }
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
            || 写入.新编码映射.size() != 6)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 节点编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态节点本地键值);
        const auto 族归属关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态族归属关系本地键值);
        const auto 主体关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态主体关系本地键值);
        const auto 特征关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态特征实例关系本地键值);
        const auto 精确值编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态精确值本地键值);
        const auto 时间值编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态时间值本地键值);
        if (!节点编码 || !族归属关系编码 || !主体关系编码 || !特征关系编码
            || !精确值编码 || !时间值编码)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 读取事实 = [&](稳定编码 编码) {
            return L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
        };
        const auto 节点读取 = 读取事实(*节点编码);
        const auto 族归属关系读取 = 读取事实(*族归属关系编码);
        const auto 主体关系读取 = 读取事实(*主体关系编码);
        const auto 特征关系读取 = 读取事实(*特征关系编码);
        const auto 精确值读取 = 读取事实(*精确值编码);
        const auto 时间值读取 = 读取事实(*时间值编码);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        const auto* 族归属关系 = 族归属关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*族归属关系读取.事实) : nullptr;
        const auto* 主体关系 = 主体关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*主体关系读取.事实) : nullptr;
        const auto* 特征关系 = 特征关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*特征关系读取.事实) : nullptr;
        const auto* 精确值 = 精确值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*精确值读取.事实) : nullptr;
        const auto* 时间值 = 时间值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*时间值读取.事实) : nullptr;
        if (!节点 || !族归属关系 || !主体关系 || !特征关系 || !精确值 || !时间值
            || 族归属关系->源节点 != *节点编码
            || 族归属关系->目标节点 != 状态身份来源定位_.族锚点
            || 族归属关系->关系类型节点 != 状态身份来源定位_.族归属关系类型
            || 族归属关系->角色或顺序 != L2状态结构内部::状态端点角色值
            || 族归属关系->写入所有者 != 第一层写入端口_.所有者身份()
            || 族归属关系->创建事实代次 != 写入.事实代次
            || 族归属关系->退出事实代次)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        auto 状态 = L2状态结构内部::形成状态事实(*节点, *主体关系,
            *特征关系, *精确值, *时间值, 登记, 写入.事实代次);
        if (!状态 || 状态->主体存在 != 请求.主体存在
            || 状态->特征实例 != 请求.特征实例
            || 状态->精确值.类型化不可变材料 != 请求.精确值材料
            || 状态->时间值.类型化不可变材料 != 请求.时间值材料
            || 状态->来源稳定编码 != 请求.来源稳定编码)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.状态 != L1中性读取状态::成功
            || 当前代次.合同版本 != L1中性CRUD合同版本
            || 当前代次.事实代次 < 写入.事实代次)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const L2结构请求头 历史头{L2结构合同版本, 当前代次.事实代次};
        const auto 主体来源 = 存在服务_.读取存在身份来源({历史头,
            L2读取类别::历史, 请求.主体存在, 写入.事实代次});
        const auto 实例来源 = 特征服务_.读取特征实例身份来源({历史头,
            L2读取类别::历史, 请求.特征实例, 写入.事实代次});
        const auto 主体 = 存在服务_.读取完整存在({历史头,
            L2读取类别::历史, 请求.主体存在, 写入.事实代次});
        const auto 实例 = 特征服务_.读取完整特征实例({历史头,
            L2读取类别::历史, 请求.特征实例, 写入.事实代次});
        if (!主体来源.成功() || !主体来源.身份来源
            || !实例来源.成功() || !实例来源.身份来源
            || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值
            || 实例来源.身份来源->节点稳定编码 != 请求.特征实例.值
            || 主体.结果头.状态 != L2结构状态::已读取 || !主体.存在
            || 实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例
            || 主体.结果头.事实截止代次 != 写入.事实代次
            || 实例.结果头.事实截止代次 != 写入.事实代次
            || 主体.存在->身份 != 请求.主体存在
            || 实例.特征实例->身份 != 请求.特征实例
            || 实例.特征实例->宿主存在 != 请求.主体存在)
            return L2状态结构内部::形成写入失败(
                主体.结果头.状态 == L2结构状态::事实代次漂移
                    || 实例.结果头.状态 == L2结构状态::事实代次漂移
                    ? L2结构状态::事实代次漂移 : L2结构状态::内部不一致,
                当前代次.事实代次);
        L2状态写入结果 结果{{L2结构合同版本, 状态码,
            写入.事实代次, 写入.事实代次}, std::move(状态),
            L2状态自有关系引用{*族归属关系编码,
                *主体关系编码, *特征关系编码}};
        return 结果.成功() ? 结果 : L2状态结构内部::形成写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }

    L2状态完整读取结果 读取当前完整状态(
        const L2状态完整读取请求& 请求,
        const L2状态结构类型登记& 登记) const {
        const auto 状态来源 = 读取状态身份来源({请求.请求头,
            L2读取类别::当前, 请求.状态, 0});
        if (!状态来源.成功() || !状态来源.身份来源)
            return L2状态结构内部::形成完整读取失败(请求,
                状态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                状态来源.结果头.事实截止代次);
        L1所有者范围一致当前读取请求 首次请求;
        首次请求.合同版本 = L1所有者范围一致当前读取合同版本;
        首次请求.期望事实代次 = 请求.请求头.期望事实代次;
        首次请求.所有者 = {状态身份来源定位_.所有者};
        首次请求.节点 = {请求.状态.值};
        首次请求.源关系组 = {
            {请求.状态.值, 状态身份来源定位_.族归属关系类型},
            {请求.状态.值, 登记.主体关系类型.值},
            {请求.状态.值, 登记.特征实例关系类型.值}};
        const auto 首次读取 = L1_.尝试读取所有者范围一致当前投影(首次请求);
        const auto 首次顶层 = L2状态结构内部::解释一致读取顶层(
            首次读取, 请求.请求头.期望事实代次);
        if (!首次顶层.成功()) return L2状态结构内部::形成完整读取失败(
            请求, 首次顶层.状态, 首次顶层.截止);
        if (首次读取.所有者.size() != 1 || 首次读取.节点.size() != 1 || !首次读取.关系.empty()
            || !首次读取.值.empty() || !首次读取.属性值.empty()
            || 首次读取.源关系组.size() != 3 || !首次读取.目标关系组.empty())
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 节点项 = L2状态结构内部::查找唯一节点项(
            首次读取, 请求.状态.值);
        if (!节点项) return L2状态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 首次顶层.截止);
        if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
            if (节点项->事实) return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
            return L2状态结构内部::形成完整读取失败(请求,
                L2状态结构内部::映射当前项目状态(节点项->状态), 首次顶层.截止);
        }
        if (!节点项->事实 || !L2状态结构内部::普通当前节点完整(
                *节点项->事实, 请求.状态.值, 首次顶层.截止)
            || 节点项->事实->当前属性.size() != 2)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 主体组 = L2状态结构内部::查找唯一源关系组(
            首次读取, 请求.状态.值, 登记.主体关系类型.值);
        const auto* 特征组 = L2状态结构内部::查找唯一源关系组(
            首次读取, 请求.状态.值, 登记.特征实例关系类型.值);
        const auto* 族归属组 = L2状态结构内部::查找唯一源关系组(
            首次读取, 请求.状态.值, 状态身份来源定位_.族归属关系类型);
        if (!族归属组 || 族归属组->成员.size() != 1
            || !主体组 || !特征组 || 主体组->成员.size() != 1
            || 特征组->成员.size() != 1)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto& 主体关系 = 主体组->成员.front().关系;
        const auto& 特征关系 = 特征组->成员.front().关系;
        if (!L2状态结构内部::普通当前节点完整(
                主体组->成员.front().对端节点, 主体关系.目标节点, 首次顶层.截止)
            || !L2状态结构内部::普通当前节点完整(
                特征组->成员.front().对端节点, 特征关系.目标节点, 首次顶层.截止))
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto 主体 = 存在服务_.读取完整存在({请求.请求头,
            L2读取类别::当前, L2存在身份{主体关系.目标节点}, 0});
        const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
            L2读取类别::当前, L2特征实例身份{特征关系.目标节点}, 0});
        if (主体.结果头.状态 != L2结构状态::已读取 || !主体.存在
            || 实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例)
            return L2状态结构内部::形成完整读取失败(请求,
                主体.结果头.状态 != L2结构状态::已读取
                    ? 主体.结果头.状态 : 实例.结果头.状态,
                std::max(主体.结果头.事实截止代次, 实例.结果头.事实截止代次));
        if (主体.存在->身份.值 != 主体关系.目标节点
            || 实例.特征实例->身份.值 != 特征关系.目标节点
            || 实例.特征实例->宿主存在 != 主体.存在->身份)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        L1所有者范围一致当前读取请求 完整请求 = 首次请求;
        for (const auto& 槽 : 节点项->事实->当前属性)
            完整请求.属性值.push_back({请求.状态.值, 槽.属性类型节点});
        const auto 完整读取 = L1_.尝试读取所有者范围一致当前投影(完整请求);
        const auto 完整顶层 = L2状态结构内部::解释一致读取顶层(
            完整读取, 请求.请求头.期望事实代次);
        if (!完整顶层.成功()) return L2状态结构内部::形成完整读取失败(
            请求, 完整顶层.状态, 完整顶层.截止);
        const auto* 完整节点项 = L2状态结构内部::查找唯一节点项(
            完整读取, 请求.状态.值);
        const auto* 完整主体组 = L2状态结构内部::查找唯一源关系组(
            完整读取, 请求.状态.值, 登记.主体关系类型.值);
        const auto* 完整特征组 = L2状态结构内部::查找唯一源关系组(
            完整读取, 请求.状态.值, 登记.特征实例关系类型.值);
        if (完整读取.所有者.size() != 1 || 完整读取.节点.size() != 1 || !完整读取.关系.empty()
            || !完整读取.值.empty() || 完整读取.属性值.size() != 2
            || 完整读取.源关系组.size() != 3 || !完整读取.目标关系组.empty()
            || !完整节点项 || 完整节点项->状态
                != L1所有者范围一致当前读取项目状态::成功 || !完整节点项->事实
            || *完整节点项->事实 != *节点项->事实 || !完整主体组 || !完整特征组
            || *完整主体组 != *主体组 || *完整特征组 != *特征组)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const L1所有者范围值事实* 精确值 = nullptr;
        const L1所有者范围值事实* 时间值 = nullptr;
        for (const auto& 槽 : 完整节点项->事实->当前属性) {
            const auto* 项 = L2状态结构内部::查找唯一属性项(
                完整读取, 请求.状态.值, 槽.属性类型节点);
            if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !项->投影 || 项->投影->属性槽 != 槽
                || 项->投影->当前值事实.编码 != 槽.当前值
                || 项->投影->当前值事实.所属节点 != 请求.状态.值
                || 项->投影->当前值事实.退出事实代次)
                return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
            const auto& 值 = 项->投影->当前值事实;
            if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) {
                if (精确值) return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                精确值 = &值;
            } else if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) {
                if (时间值) return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                时间值 = &值;
            } else return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        }
        if (!精确值 || !时间值) return L2状态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.截止);
        auto 状态 = L2状态结构内部::形成状态事实(*完整节点项->事实,
            完整主体组->成员.front().关系, 完整特征组->成员.front().关系,
            *精确值, *时间值, 登记, 完整顶层.截止);
        if (!状态 || 状态->身份 != 请求.状态)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::当前, 状态->主体存在, 0});
        const auto 实例来源 = 特征服务_.读取特征实例身份来源({请求.请求头,
            L2读取类别::当前, 状态->特征实例, 0});
        if (!主体来源.成功() || !实例来源.成功())
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        return {{L2结构合同版本, L2结构状态::已读取, 完整顶层.截止,
            std::nullopt}, 请求.读取类别, 0, std::move(状态),
            L2状态自有关系引用{族归属组->成员.front().关系.编码,
                完整主体组->成员.front().关系.编码,
                完整特征组->成员.front().关系.编码}};
    }

    L2状态完整读取结果 读取历史完整状态(
        const L2状态完整读取请求& 请求,
        const L2状态结构类型登记& 登记) const {
        const auto 状态来源 = 读取状态身份来源({请求.请求头,
            L2读取类别::历史, 请求.状态, 请求.历史截止事实代次});
        if (!状态来源.成功() || !状态来源.身份来源)
            return L2状态结构内部::形成完整读取失败(请求,
                状态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                状态来源.结果头.事实截止代次);
        const auto 前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (前代次.状态 != L1中性读取状态::成功
            || 前代次.合同版本 != L1中性CRUD合同版本 || 前代次.事实代次 == 0)
            return L2状态结构内部::形成完整读取失败(请求,
                L2状态结构内部::映射事实代次探测失败(前代次.状态),
                前代次.事实代次);
        if (前代次.事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移, 前代次.事实代次);
        const auto 节点读取 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 请求.状态.值});
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 请求.状态.值)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点读取.状态 != L1所有者范围读取状态::成功) {
            if (节点读取.事实) return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            return L2状态结构内部::形成完整读取失败(请求,
                L2状态结构内部::映射历史读取状态(节点读取.状态),
                请求.历史截止事实代次);
        }
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (!节点 || 节点->编码 != 请求.状态.值
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点->创建事实代次 > 请求.历史截止事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::未找到, 请求.历史截止事实代次);
        const std::uint64_t 结构截止 = 节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次
            ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
        const auto 主体组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.状态.值, 登记.主体关系类型.值,
            结构截止});
        const auto 特征组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.状态.值, 登记.特征实例关系类型.值,
            结构截止});
        const auto 属性组 = L1_.读取所有者范围历史属性值组({L1所有者范围CRUD合同版本,
            请求.状态.值, 结构截止});
        if (主体组.状态 != L1所有者范围读取状态::成功
            || 特征组.状态 != L1所有者范围读取状态::成功
            || 属性组.状态 != L1所有者范围读取状态::成功) {
            const auto 状态 = 主体组.状态 != L1所有者范围读取状态::成功
                ? L2状态结构内部::映射历史关系组失败状态(主体组.状态)
                : 特征组.状态 != L1所有者范围读取状态::成功
                    ? L2状态结构内部::映射历史关系组失败状态(特征组.状态)
                    : L2状态结构内部::映射历史属性组失败状态(属性组.状态);
            return L2状态结构内部::形成完整读取失败(
                请求, 状态, std::max({主体组.读取事实代次,
                    特征组.读取事实代次, 属性组.读取事实代次}));
        }
        if (主体组.读取事实代次 != 请求.请求头.期望事实代次
            || 特征组.读取事实代次 != 请求.请求头.期望事实代次
            || 属性组.读取事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移,
                std::max({主体组.读取事实代次,
                    特征组.读取事实代次, 属性组.读取事实代次}));
        if (主体组.关系组.size() != 1 || 特征组.关系组.size() != 1
            || 属性组.属性值组.size() != 2)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const L1所有者范围值事实* 精确值 = nullptr;
        const L1所有者范围值事实* 时间值 = nullptr;
        for (const auto& 值 : 属性组.属性值组) {
            if (值.所属节点 != 请求.状态.值)
                return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) 精确值 = &值;
            else if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) 时间值 = &值;
            else return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        }
        if (!精确值 || !时间值)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const auto& 主体关系 = 主体组.关系组.front();
        const auto& 特征关系 = 特征组.关系组.front();
        const auto 主体 = 存在服务_.读取完整存在({请求.请求头,
            L2读取类别::历史, L2存在身份{主体关系.目标节点},
            请求.历史截止事实代次});
        const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
            L2读取类别::历史, L2特征实例身份{特征关系.目标节点},
            请求.历史截止事实代次});
        if (主体.结果头.状态 != L2结构状态::已读取 || !主体.存在
            || 实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例
            || 实例.特征实例->宿主存在 != 主体.存在->身份)
            return L2状态结构内部::形成完整读取失败(请求,
                主体.结果头.状态 != L2结构状态::已读取
                    ? 主体.结果头.状态 : 实例.结果头.状态,
                请求.历史截止事实代次);
        const auto 后代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (后代次.状态 != L1中性读取状态::成功
            || 后代次.合同版本 != L1中性CRUD合同版本
            || 后代次.事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, 后代次.状态 == L1中性读取状态::成功
                    ? L2结构状态::事实代次漂移
                    : L2状态结构内部::映射事实代次探测失败(后代次.状态),
                后代次.事实代次);
        auto 状态 = L2状态结构内部::形成状态事实(*节点, 主体关系,
            特征关系, *精确值, *时间值, 登记, 请求.历史截止事实代次);
        if (!状态 || 状态->身份 != 请求.状态)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return {{L2结构合同版本, L2结构状态::已读取,
            请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
            请求.历史截止事实代次, std::move(状态),
            L2状态自有关系引用{状态来源.身份来源->族归属关系稳定编码,
                主体关系.编码, 特征关系.编码}};
    }

    L2当前状态组读取结果 按端点读取状态组(
        const L2结构请求头& 请求头, 稳定编码 端点, bool 主体条件,
        std::uint64_t 最大数量) const {
        const auto 登记结果 = 读取当前状态结构类型登记();
        if (登记结果.状态 != L2状态结构类型登记状态::已读取
            || !登记结果.登记 || !登记结果.成功())
            return L2状态结构内部::形成组读取失败(
                L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                登记结果.事实截止代次);
        const auto 关系类型 = 主体条件 ? 登记结果.登记->主体关系类型.值
            : 登记结果.登记->特征实例关系类型.值;
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 请求头.期望事实代次;
        请求.所有者 = {状态身份来源定位_.所有者};
        请求.目标关系组 = {{端点, 关系类型}};
        const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
        const auto 顶层 = L2状态结构内部::解释一致读取顶层(
            读取, 请求头.期望事实代次);
        if (!顶层.成功()) return L2状态结构内部::形成组读取失败(
            顶层.状态, 顶层.截止);
        const auto* 关系组 = L2状态结构内部::查找唯一目标关系组(
            读取, 端点, 关系类型);
        if (读取.所有者.size() != 1 || !读取.节点.empty()
            || !读取.关系.empty() || !读取.值.empty()
            || !读取.属性值.empty() || !读取.源关系组.empty()
            || 读取.目标关系组.size() != 1 || !关系组
            || 读取.所有者.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实)
            return L2状态结构内部::形成组读取失败(
                L2结构状态::内部不一致, 顶层.截止);
        std::vector<稳定编码> 状态编码组;
        for (const auto& 成员 : 关系组->成员) {
            const auto& 关系 = 成员.关系;
            if (关系.目标节点 != 端点 || 关系.关系类型节点 != 关系类型
                || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                || 关系.退出事实代次
                || !L2状态结构内部::普通当前节点完整(
                    成员.对端节点, 关系.源节点, 顶层.截止)
                || 关系.写入所有者 != 状态身份来源定位_.所有者
                || 成员.对端节点.写入所有者 != 状态身份来源定位_.所有者
                || std::find(状态编码组.begin(), 状态编码组.end(),
                    关系.源节点) != 状态编码组.end())
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            状态编码组.push_back(关系.源节点);
        }
        std::sort(状态编码组.begin(), 状态编码组.end());
        if (状态编码组.size() > 最大数量)
            return L2状态结构内部::形成组读取失败(
                L2结构状态::数量预算不足, 顶层.截止);
        L2当前状态组读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
            顶层.截止, std::nullopt}, {}};
        结果.状态.reserve(状态编码组.size());
        for (const auto 编码 : 状态编码组) {
            const auto 单项 = 读取完整状态({请求头, L2读取类别::当前,
                L2状态身份{编码}, 0});
            if (单项.结果头.状态 != L2结构状态::已读取 || !单项.状态
                || 单项.结果头.事实截止代次 != 顶层.截止)
                return L2状态结构内部::形成组读取失败(
                    单项.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 单项.结果头.状态,
                    单项.结果头.事实截止代次);
            if ((主体条件 && 单项.状态->主体存在.值 != 端点)
                || (!主体条件 && 单项.状态->特征实例.值 != 端点))
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            结果.状态.push_back(*单项.状态);
        }
        return 结果.成功() ? 结果 : L2状态结构内部::形成组读取失败(
            L2结构状态::内部不一致, 顶层.截止);
    }

    const L1事实基座服务& L1_;
    const L2存在结构服务& 存在服务_;
