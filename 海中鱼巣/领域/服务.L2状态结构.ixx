inline constexpr L1所有者范围建立幂等身份 状态所有者建立身份{
    0x4C31'4F57'4E45'5234ULL};

class L2状态结构服务;

class L2状态所有者交付 final {
public:
    L2状态所有者交付() = delete;
    L2状态所有者交付(const L2状态所有者交付&) = delete;
    L2状态所有者交付& operator=(const L2状态所有者交付&) = delete;
    L2状态所有者交付(L2状态所有者交付&&) noexcept = default;
    L2状态所有者交付& operator=(L2状态所有者交付&&) = delete;

private:
    explicit L2状态所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2状态所有者交付> 尝试形成L2状态所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2状态结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2状态所有者交付> 尝试形成L2状态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept;

}

