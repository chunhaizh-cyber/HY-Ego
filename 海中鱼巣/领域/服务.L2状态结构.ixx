export namespace 海中鱼巣 {

inline constexpr L1所有者范围建立幂等身份 状态所有者建立身份{
    0x4C31'4F57'4E45'5234ULL};

class L2状态结构服务;

class L2状态所有者交付 final {
public:
    L2状态所有者交付() = delete;
    L2状态所有者交付(const L2状态所有者交付&) = delete;
    L2状态所有者交付& operator=(const L2状态所有者交付&) = delete;
    L2状态所有者交付(L2状态所有者交付&&) noexcept = default;
    L2状态所有者交付& operator=(L2状态所有者交付&&) = delete;

private:
    explicit L2状态所有者交付(L1所有者范围写端口&& 端口) noexcept
        : 写入端口_(std::move(端口)) {}
    friend std::optional<L2状态所有者交付> 尝试形成L2状态所有者交付(
        const L1事实基座服务&, L1所有者范围交付&&) noexcept;
    friend class L2状态结构服务;
    L1所有者范围写端口 写入端口_;
};

std::optional<L2状态所有者交付> 尝试形成L2状态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept;

}

namespace 海中鱼巣::L2状态结构内部 {

inline constexpr std::uint64_t 状态结构类型登记幂等域 = 0x20ULL;
inline constexpr std::uint32_t 状态主体关系类型本地键值 = 0x0204'0101U;
inline constexpr std::uint32_t 状态特征实例关系类型本地键值 = 0x0204'0102U;
inline constexpr std::uint32_t 状态精确I64值类型本地键值 = 0x0204'0201U;
inline constexpr std::uint32_t 状态精确I64组值类型本地键值 = 0x0204'0202U;
inline constexpr std::uint32_t 状态精确U64组值类型本地键值 = 0x0204'0203U;
inline constexpr std::uint32_t 状态精确独立材料值类型本地键值 = 0x0204'0204U;
inline constexpr std::uint32_t 状态时间I64值类型本地键值 = 0x0204'0301U;
inline constexpr std::uint32_t 状态时间I64组值类型本地键值 = 0x0204'0302U;
inline constexpr std::uint32_t 状态时间U64组值类型本地键值 = 0x0204'0303U;
inline constexpr std::uint32_t 状态时间独立材料值类型本地键值 = 0x0204'0304U;
inline constexpr std::uint32_t 状态节点本地键值 = 0x0204'1001U;
inline constexpr std::uint32_t 状态主体关系本地键值 = 0x0204'1101U;
inline constexpr std::uint32_t 状态特征实例关系本地键值 = 0x0204'1102U;
inline constexpr std::uint32_t 状态精确值本地键值 = 0x0204'1201U;
inline constexpr std::uint32_t 状态时间值本地键值 = 0x0204'1202U;
inline constexpr std::int64_t 状态端点角色值 = 1;
inline constexpr L1所有者范围写入幂等身份 状态身份来源登记幂等身份{
    0x4C32'4944'5352'4304ULL};
inline constexpr std::uint32_t 状态族锚点本地键值 = 0x0204'2001U;
inline constexpr std::uint32_t 状态族归属关系类型本地键值 = 0x0204'2002U;
inline constexpr std::uint32_t 状态族归属关系本地键值 = 0x0204'2003U;

struct 状态身份来源定位 final {
    L1结构所有者身份 所有者;
    稳定编码 族锚点;
    稳定编码 族归属关系类型;
    std::uint64_t 建立事实代次 = 0;
};

L1所有者范围写入幂等身份 映射状态结构类型登记幂等键(
    L2结构幂等身份 身份) noexcept {
    return {(状态结构类型登记幂等域 << 56) | 身份.值};
}

L1所有者范围写入幂等身份 映射状态幂等键(L2结构幂等身份 身份) noexcept {
    return {身份.值};
}

L1所有者范围原始值材料 转换为L1材料(const L2原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L1所有者范围原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L2独立材料引用>)
            return L1所有者范围独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2原始值材料 转换为L2材料(const L1所有者范围原始值材料& 材料) {
    return std::visit([](const auto& 值) -> L2原始值材料 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, L1所有者范围独立材料引用>)
            return L2独立材料引用{值.编码};
        else return 值;
    }, 材料);
}

L2结构状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2结构状态::已提交;
    case L1所有者范围写入状态::精确重复: return L2结构状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围写入状态::未找到: return L2结构状态::未找到;
    case L1所有者范围写入状态::已退出: return L2结构状态::已退出;
    case L1所有者范围写入状态::事实代次漂移: return L2结构状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2结构状态::幂等冲突;
    case L1所有者范围写入状态::引用冲突: return L2结构状态::引用冲突;
    case L1所有者范围写入状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围写入状态::内部不一致: return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射一致读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝: return L2结构状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射当前项目状态(
    L1所有者范围一致当前读取项目状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取项目状态::成功: return L2结构状态::已读取;
    case L1所有者范围一致当前读取项目状态::未找到: return L2结构状态::未找到;
    case L1所有者范围一致当前读取项目状态::已退出: return L2结构状态::已退出;
    case L1所有者范围一致当前读取项目状态::属性未设置:
    case L1所有者范围一致当前读取项目状态::种类不匹配:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史读取状态(L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::成功: return L2结构状态::已读取;
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::未找到: return L2结构状态::未找到;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::已退出:
    case L1所有者范围读取状态::属性未设置:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史关系组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射历史属性组失败状态(
    L1所有者范围读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1所有者范围读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围读取状态::资源失败: return L2结构状态::资源失败;
    case L1所有者范围读取状态::成功:
    case L1所有者范围读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 映射来源值组读取失败状态(
    L1所有者范围来源当前值组读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围来源当前值组读取状态::入口拒绝:
        return L2结构状态::入口拒绝;
    case L1所有者范围来源当前值组读取状态::未找到:
        return L2结构状态::未找到;
    case L1所有者范围来源当前值组读取状态::已退出:
        return L2结构状态::已退出;
    case L1所有者范围来源当前值组读取状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L1所有者范围来源当前值组读取状态::数量预算不足:
        return L2结构状态::数量预算不足;
    case L1所有者范围来源当前值组读取状态::资源失败:
        return L2结构状态::资源失败;
    case L1所有者范围来源当前值组读取状态::成功:
    case L1所有者范围来源当前值组读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2状态结构类型登记状态 映射登记写入状态(
    L1所有者范围写入状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围写入状态::成功: return L2状态结构类型登记状态::已提交;
    case L1所有者范围写入状态::精确重复:
        return L2状态结构类型登记状态::精确重复;
    case L1所有者范围写入状态::入口拒绝: return L2状态结构类型登记状态::入口拒绝;
    case L1所有者范围写入状态::许可拒绝: return L2状态结构类型登记状态::许可拒绝;
    case L1所有者范围写入状态::事实代次漂移:
        return L2状态结构类型登记状态::事实代次漂移;
    case L1所有者范围写入状态::幂等冲突: return L2状态结构类型登记状态::幂等冲突;
    case L1所有者范围写入状态::资源失败: return L2状态结构类型登记状态::资源失败;
    case L1所有者范围写入状态::未找到:
    case L1所有者范围写入状态::已退出:
    case L1所有者范围写入状态::引用冲突:
    case L1所有者范围写入状态::内部不一致:
        return L2状态结构类型登记状态::内部不一致;
    }
    return L2状态结构类型登记状态::内部不一致;
}

L2状态结构类型登记状态 映射登记读取失败状态(
    L1所有者范围一致当前读取状态 状态) noexcept {
    switch (状态) {
    case L1所有者范围一致当前读取状态::入口拒绝:
        return L2状态结构类型登记状态::入口拒绝;
    case L1所有者范围一致当前读取状态::许可拒绝:
        return L2状态结构类型登记状态::许可拒绝;
    case L1所有者范围一致当前读取状态::事实代次漂移:
        return L2状态结构类型登记状态::事实代次漂移;
    case L1所有者范围一致当前读取状态::资源失败:
        return L2状态结构类型登记状态::资源失败;
    case L1所有者范围一致当前读取状态::成功:
    case L1所有者范围一致当前读取状态::内部不一致:
        return L2状态结构类型登记状态::内部不一致;
    }
    return L2状态结构类型登记状态::内部不一致;
}

L2结构状态 映射登记失败为结构状态(
    L2状态结构类型登记状态 状态) noexcept {
    switch (状态) {
    case L2状态结构类型登记状态::登记未加载:
    case L2状态结构类型登记状态::入口拒绝: return L2结构状态::入口拒绝;
    case L2状态结构类型登记状态::许可拒绝: return L2结构状态::许可拒绝;
    case L2状态结构类型登记状态::事实代次漂移:
        return L2结构状态::事实代次漂移;
    case L2状态结构类型登记状态::幂等冲突: return L2结构状态::幂等冲突;
    case L2状态结构类型登记状态::资源失败: return L2结构状态::资源失败;
    case L2状态结构类型登记状态::已提交:
    case L2状态结构类型登记状态::精确重复:
    case L2状态结构类型登记状态::已读取:
    case L2状态结构类型登记状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2状态结构类型登记结果 形成登记失败(
    L2状态结构类型登记状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {状态, 截止, std::nullopt};
}

L2状态写入结果 形成写入失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt},
        std::nullopt, std::nullopt};
}

L2状态完整读取结果 形成完整读取失败(
    const L2状态完整读取请求& 请求, L2结构状态 状态,
    std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, 请求.读取类别,
        请求.历史截止事实代次, std::nullopt, std::nullopt};
}

L2当前状态组读取结果 形成组读取失败(
    L2结构状态 状态, std::uint64_t 截止 = 0) noexcept {
    return {{L2结构合同版本, 状态, 截止, std::nullopt}, {}};
}

L2状态引用替换结果 形成引用替换失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt, std::nullopt};
}

L2状态值换代结果 形成值换代失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt, std::nullopt};
}

L2状态退出结果 形成状态退出失败(
    L2结构状态 状态, std::uint64_t 截止 = 0,
    std::optional<std::uint64_t> 变更 = std::nullopt) noexcept {
    return {{L2结构合同版本, 状态, 截止, 变更},
        std::nullopt, std::nullopt};
}

bool 写入成功边界完整(const L1所有者范围写入结果& 写入) noexcept {
    const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    return 写入.事实代次 != 0 && (首次 || 重复);
}

std::optional<L2状态关系退出事实> 形成关系退出事实(
    const L1所有者范围关系事实& 关系, std::uint64_t 退出代次) noexcept {
    L2状态关系退出事实 结果{关系.编码,
        {关系.创建事实代次, 关系.退出事实代次}};
    return L2状态关系退出事实完整(结果, 退出代次)
        ? std::optional<L2状态关系退出事实>{结果} : std::nullopt;
}

bool 历史关系匹配(const L1所有者范围关系事实& 关系,
    稳定编码 编码, 稳定编码 源, 稳定编码 目标, 稳定编码 类型,
    L1结构所有者身份 所有者, std::uint64_t 退出代次) noexcept {
    return 关系.编码 == 编码 && 关系.源节点 == 源 && 关系.目标节点 == 目标
        && 关系.关系类型节点 == 类型 && 关系.角色或顺序 == 状态端点角色值
        && 关系.写入所有者 == 所有者 && 关系.创建事实代次 != 0
        && 关系.创建事实代次 <= 退出代次
        && 关系.退出事实代次 == 退出代次;
}

bool 状态未改字段相同(const L2状态事实& 左, const L2状态事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.来源稳定编码 == 右.来源稳定编码
        && 左.生命周期 == 右.生命周期;
}

std::optional<稳定编码> 查找编码映射(
    const L1所有者范围写入结果& 结果, std::uint32_t 本地键值) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键.值 != 本地键值) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

std::array<稳定编码, 10> 登记编码组(
    const L2状态结构类型登记& 登记) noexcept {
    return {登记.主体关系类型.值, 登记.特征实例关系类型.值,
        登记.精确I64值类型.值, 登记.精确I64组值类型.值,
        登记.精确U64组值类型.值, 登记.精确独立材料值类型.值,
        登记.时间I64值类型.值, 登记.时间I64组值类型.值,
        登记.时间U64组值类型.值, 登记.时间独立材料值类型.值};
}

std::optional<L2状态结构类型登记> 从写入形成登记(
    const L1所有者范围写入结果& 写入,
    const L2状态结构类型登记请求& 请求) noexcept {
    if (写入.新编码映射.size() != 10) return std::nullopt;
    const auto 主体 = 查找编码映射(写入, 状态主体关系类型本地键值);
    const auto 实例 = 查找编码映射(写入, 状态特征实例关系类型本地键值);
    const auto 精确I64 = 查找编码映射(写入, 状态精确I64值类型本地键值);
    const auto 精确I64组 = 查找编码映射(写入, 状态精确I64组值类型本地键值);
    const auto 精确U64组 = 查找编码映射(写入, 状态精确U64组值类型本地键值);
    const auto 精确独立 = 查找编码映射(写入, 状态精确独立材料值类型本地键值);
    const auto 时间I64 = 查找编码映射(写入, 状态时间I64值类型本地键值);
    const auto 时间I64组 = 查找编码映射(写入, 状态时间I64组值类型本地键值);
    const auto 时间U64组 = 查找编码映射(写入, 状态时间U64组值类型本地键值);
    const auto 时间独立 = 查找编码映射(写入, 状态时间独立材料值类型本地键值);
    if (!主体 || !实例 || !精确I64 || !精确I64组 || !精确U64组
        || !精确独立 || !时间I64 || !时间I64组 || !时间U64组 || !时间独立)
        return std::nullopt;
    L2状态结构类型登记 登记;
    登记.首次期望事实代次 = 请求.请求头.期望事实代次;
    登记.建立事实代次 = 写入.事实代次;
    登记.事实截止代次 = 写入.事实代次;
    登记.主体关系类型 = L2状态主体关系类型身份{*主体};
    登记.特征实例关系类型 = L2状态特征实例关系类型身份{*实例};
    登记.精确I64值类型 = L2状态精确I64值类型身份{*精确I64};
    登记.精确I64组值类型 = L2状态精确I64组值类型身份{*精确I64组};
    登记.精确U64组值类型 = L2状态精确U64组值类型身份{*精确U64组};
    登记.精确独立材料值类型 = L2状态精确独立材料值类型身份{*精确独立};
    登记.时间I64值类型 = L2状态时间I64值类型身份{*时间I64};
    登记.时间I64组值类型 = L2状态时间I64组值类型身份{*时间I64组};
    登记.时间U64组值类型 = L2状态时间U64组值类型身份{*时间U64组};
    登记.时间独立材料值类型 = L2状态时间独立材料值类型身份{*时间独立};
    return L2状态结构类型登记完整(登记)
        ? std::optional<L2状态结构类型登记>{登记} : std::nullopt;
}

bool 登记节点历史完整(const L1事实基座服务& 第一层服务,
    稳定编码 编码, 节点种类 种类,
    std::optional<L1所有者范围值表示种类> 表示, std::uint64_t 建立代次) {
    const auto 读取 = 第一层服务.读取所有者范围历史事实(
        {L1所有者范围CRUD合同版本, 编码});
    const auto* 节点 = 读取.事实
        ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
    return 读取.状态 == L1所有者范围读取状态::成功
        && 读取.合同版本 == L1所有者范围CRUD合同版本
        && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
        && 节点->种类 == 种类 && 节点->属性类型表示 == 表示
        && 节点->创建事实代次 == 建立代次 && !节点->退出事实代次
        && 节点->当前属性.empty();
}

bool 登记历史完整(const L1事实基座服务& 第一层服务,
    const L2状态结构类型登记& 登记) {
    const auto 编码 = 登记编码组(登记);
    const std::array<std::optional<L1所有者范围值表示种类>, 10> 表示 = {
        std::nullopt, std::nullopt, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
        L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
        L1所有者范围值表示种类::独立材料引用};
    for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
        const auto 种类 = 索引 < 2 ? 节点种类::普通 : 节点种类::属性类型;
        if (!登记节点历史完整(
                第一层服务, 编码[索引], 种类, 表示[索引], 登记.建立事实代次))
            return false;
    }
    return true;
}

稳定编码 选择状态值类型编码(const L2状态结构类型登记& 登记,
    const L2原始值材料& 材料, bool 精确角色) noexcept {
    return std::visit([&](const auto& 值) noexcept -> 稳定编码 {
        using 类型 = std::decay_t<decltype(值)>;
        if constexpr (std::is_same_v<类型, std::int64_t>)
            return 精确角色 ? 登记.精确I64值类型.值 : 登记.时间I64值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::int64_t>>)
            return 精确角色 ? 登记.精确I64组值类型.值 : 登记.时间I64组值类型.值;
        else if constexpr (std::is_same_v<类型, std::vector<std::uint64_t>>)
            return 精确角色 ? 登记.精确U64组值类型.值 : 登记.时间U64组值类型.值;
        else return 精确角色 ? 登记.精确独立材料值类型.值
            : 登记.时间独立材料值类型.值;
    }, 材料);
}

bool 状态值类型与材料一致(const L2状态结构类型登记& 登记,
    稳定编码 类型编码, const L1所有者范围原始值材料& 材料, bool 精确角色) {
    return 选择状态值类型编码(登记, 转换为L2材料(材料), 精确角色)
        == 类型编码;
}

std::optional<L2属性事实> 形成截止属性事实(
    L1所有者范围值事实 值, const L2状态结构类型登记& 登记,
    std::uint64_t 截止, bool 精确角色) {
    if (值.退出事实代次 && *值.退出事实代次 > 截止)
        值.退出事实代次.reset();
    if (!状态值类型与材料一致(登记, 值.属性类型节点, 值.材料, 精确角色))
        return std::nullopt;
    L2属性事实 属性{值.属性类型节点, 值.编码, 转换为L2材料(值.材料),
        值.来源节点, 值.创建事实代次, 值.退出事实代次};
    return L2属性事实截止投影完整(属性, 截止)
        ? std::optional<L2属性事实>{std::move(属性)} : std::nullopt;
}

std::optional<L2状态事实> 形成状态事实(
    L1所有者范围节点事实 节点, L1所有者范围关系事实 主体关系,
    L1所有者范围关系事实 特征关系, L1所有者范围值事实 精确值,
    L1所有者范围值事实 时间值, const L2状态结构类型登记& 登记,
    std::uint64_t 截止) {
    if (节点.退出事实代次 && *节点.退出事实代次 > 截止)
        节点.退出事实代次.reset();
    if (主体关系.退出事实代次 && *主体关系.退出事实代次 > 截止)
        主体关系.退出事实代次.reset();
    if (特征关系.退出事实代次 && *特征关系.退出事实代次 > 截止)
        特征关系.退出事实代次.reset();
    if (!有效(节点.编码) || 节点.种类 != 节点种类::普通
        || 节点.属性类型表示 || 节点.创建事实代次 == 0
        || 节点.创建事实代次 > 截止
        || !有效(主体关系.编码) || !有效(特征关系.编码)
        || 主体关系.编码 == 特征关系.编码
        || 主体关系.源节点 != 节点.编码 || 特征关系.源节点 != 节点.编码
        || 主体关系.关系类型节点 != 登记.主体关系类型.值
        || 特征关系.关系类型节点 != 登记.特征实例关系类型.值
        || 主体关系.角色或顺序 != 状态端点角色值
        || 特征关系.角色或顺序 != 状态端点角色值
        || 主体关系.创建事实代次 < 节点.创建事实代次
        || 特征关系.创建事实代次 < 节点.创建事实代次
        || 主体关系.创建事实代次 > 截止
        || 特征关系.创建事实代次 > 截止
        || 精确值.所属节点 != 节点.编码 || 时间值.所属节点 != 节点.编码
        || 精确值.创建事实代次 < 节点.创建事实代次
        || 时间值.创建事实代次 < 节点.创建事实代次
        || 精确值.创建事实代次 > 截止
        || 时间值.创建事实代次 > 截止)
        return std::nullopt;
    auto 精确属性 = 形成截止属性事实(精确值, 登记, 截止, true);
    auto 时间属性 = 形成截止属性事实(时间值, 登记, 截止, false);
    if (!精确属性 || !时间属性) return std::nullopt;
    L2状态事实 状态;
    状态.身份 = L2状态身份{节点.编码};
    状态.主体存在 = L2存在身份{主体关系.目标节点};
    状态.特征实例 = L2特征实例身份{特征关系.目标节点};
    状态.精确值 = std::move(*精确属性);
    状态.时间值 = std::move(*时间属性);
    状态.来源稳定编码 = 状态.精确值.来源稳定编码;
    状态.生命周期 = {节点.创建事实代次, 节点.退出事实代次};
    return L2状态事实完整(状态, 登记, 截止)
        ? std::optional<L2状态事实>{std::move(状态)} : std::nullopt;
}

struct 一致读取顶层结果 final {
    L2结构状态 状态 = L2结构状态::内部不一致;
    std::uint64_t 截止 = 0;
    bool 成功() const noexcept { return 状态 == L2结构状态::已读取; }
};

一致读取顶层结果 解释一致读取顶层(
    const L1所有者范围一致当前读取结果& 读取, std::uint64_t 期望) noexcept {
    if (读取.状态 == L1所有者范围一致当前读取状态::成功) {
        if (读取.合同版本 == L1所有者范围一致当前读取合同版本
            && 读取.期望事实代次 == 期望 && 读取.读取事实代次 == 期望
            && 读取.读取事实代次 != 0)
            return {L2结构状态::已读取, 读取.读取事实代次};
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    }
    const bool 空 = 读取.节点.empty() && 读取.关系.empty()
        && 读取.值.empty() && 读取.属性值.empty()
        && 读取.源关系组.empty() && 读取.目标关系组.empty();
    const bool 代次完整 = 读取.状态 == L1所有者范围一致当前读取状态::事实代次漂移
        ? 读取.读取事实代次 != 0 && 读取.读取事实代次 != 期望
        : 读取.读取事实代次 == 0;
    if (读取.合同版本 != L1所有者范围一致当前读取合同版本
        || 读取.期望事实代次 != 期望 || !空 || !代次完整)
        return {L2结构状态::内部不一致, 读取.读取事实代次};
    return {映射一致读取失败状态(读取.状态), 读取.读取事实代次};
}

const L1所有者范围一致节点读取结果项* 查找唯一节点项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 编码) noexcept {
    const L1所有者范围一致节点读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.节点) {
        if (项.查询编码 != 编码) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致源关系组读取结果项* 查找唯一源关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 源,
    稳定编码 类型) noexcept {
    const L1所有者范围一致源关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.源关系组) {
        if (项.源节点 != 源 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致目标关系组读取结果项* 查找唯一目标关系组(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 目标,
    稳定编码 类型) noexcept {
    const L1所有者范围一致目标关系组读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.目标关系组) {
        if (项.目标节点 != 目标 || 项.关系类型节点 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

const L1所有者范围一致属性值读取结果项* 查找唯一属性项(
    const L1所有者范围一致当前读取结果& 读取, 稳定编码 节点,
    稳定编码 类型) noexcept {
    const L1所有者范围一致属性值读取结果项* 找到 = nullptr;
    for (const auto& 项 : 读取.属性值) {
        if (项.节点 != 节点 || 项.属性类型 != 类型) continue;
        if (找到) return nullptr;
        找到 = &项;
    }
    return 找到;
}

bool 普通当前节点完整(const L1所有者范围节点事实& 节点,
    稳定编码 编码, std::uint64_t 截止) noexcept {
    return 节点.编码 == 编码 && 节点.种类 == 节点种类::普通
        && !节点.属性类型表示 && 节点.创建事实代次 != 0
        && 节点.创建事实代次 <= 截止 && !节点.退出事实代次;
}

L2结构状态 映射事实代次探测失败(L1中性读取状态 状态) noexcept {
    switch (状态) {
    case L1中性读取状态::入口拒绝: return L2结构状态::入口拒绝;
    case L1中性读取状态::资源失败: return L2结构状态::资源失败;
    case L1中性读取状态::成功:
    case L1中性读取状态::未找到:
    case L1中性读取状态::已退出:
    case L1中性读取状态::属性未设置:
    case L1中性读取状态::内部不一致:
        return L2结构状态::内部不一致;
    }
    return L2结构状态::内部不一致;
}

L2结构状态 检查端点结果头(const L2结构结果头& 结果头,
    std::uint64_t 期望) noexcept {
    if (结果头.状态 == L2结构状态::已读取) {
        return 结果头.事实截止代次 == 期望 && !结果头.变更事实代次
            ? L2结构状态::已读取 : L2结构状态::内部不一致;
    }
    if (结果头.变更事实代次) return L2结构状态::内部不一致;
    return 结果头.状态;
}

// 诊断责任：向上送出；来源登记任何结构化非成功都使服务构造失败。
状态身份来源定位 初始化状态身份来源(
    const L1事实基座服务& 第一层服务, L1所有者范围写端口& 写入端口) {
    const auto 所有者 = 写入端口.所有者身份();
    const auto 所有者读取 = 第一层服务.读取当前结构所有者(
        {L1所有者范围CRUD合同版本, 所有者});
    if (所有者读取.状态 != L1所有者范围读取状态::成功
        || 所有者读取.合同版本 != L1所有者范围CRUD合同版本
        || 所有者读取.查询所有者 != 所有者 || !所有者读取.所有者事实
        || 所有者读取.所有者事实->所有者 != 所有者
        || 所有者读取.所有者事实->范围种类
            != L1所有者范围种类::独占结构范围
        || 所有者读取.所有者事实->创建事实代次 == 0
        || 所有者读取.所有者事实->退出事实代次)
        throw std::runtime_error("L2 state owner fact is invalid");
    L1所有者范围写集请求 写集;
    写集.合同版本 = L1所有者范围CRUD合同版本;
    写集.期望事实代次 = 所有者读取.所有者事实->创建事实代次;
    写集.写入幂等身份 = 状态身份来源登记幂等身份;
    写集.节点 = {
        {{状态族锚点本地键值}, 节点种类::普通, std::nullopt},
        {{状态族归属关系类型本地键值}, 节点种类::普通, std::nullopt}};
    const auto 写入 = 写入端口.提交所有者范围中性写集(写集);
    const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
        && 写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::不适用;
    const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
        && !写入.是否形成内存权威发布
        && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
    if (写入.合同版本 != L1所有者范围CRUD合同版本
        || 写入.所有者 != 所有者
        || 写入.写入幂等身份 != 状态身份来源登记幂等身份
        || 写入.事实代次 == 0 || (!首次完整 && !重复完整)
        || 写入.新编码映射.size() != 2)
        throw std::runtime_error("L2 state identity source initialization failed");
    稳定编码 锚点编码;
    稳定编码 类型编码;
    for (const auto& [本地键, 编码] : 写入.新编码映射) {
        if (!有效(编码)) throw std::runtime_error("L2 state source mapping invalid");
        if (本地键.值 == 状态族锚点本地键值) 锚点编码 = 编码;
        else if (本地键.值 == 状态族归属关系类型本地键值) 类型编码 = 编码;
        else throw std::runtime_error("L2 state source mapping unknown");
    }
    if (!有效(锚点编码) || !有效(类型编码) || 锚点编码 == 类型编码)
        throw std::runtime_error("L2 state source mapping incomplete");
    const auto 核对节点 = [&](稳定编码 编码) {
        const auto 读取 = 第一层服务.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 编码});
        const auto* 节点 = 读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
        return 读取.状态 == L1所有者范围读取状态::成功
            && 读取.合同版本 == L1所有者范围CRUD合同版本
            && 读取.查询编码 == 编码 && 节点 && 节点->编码 == 编码
            && 节点->写入所有者 == 所有者 && 节点->种类 == 节点种类::普通
            && !节点->属性类型表示 && 节点->当前属性.empty()
            && 节点->创建事实代次 == 写入.事实代次 && !节点->退出事实代次;
    };
    if (!核对节点(锚点编码) || !核对节点(类型编码))
        throw std::runtime_error("L2 state source readback invalid");
    return {所有者, 锚点编码, 类型编码, 写入.事实代次};
}

} // namespace 海中鱼巣::L2状态结构内部

export namespace 海中鱼巣 {

std::optional<L2状态所有者交付> 尝试形成L2状态所有者交付(
    const L1事实基座服务& 第一层读取服务,
    L1所有者范围交付&& 原始交付) noexcept {
    try {
        const auto& 建立 = 原始交付.建立结果;
        const bool 首次完整 = 建立.状态 == L1所有者范围管理状态::成功
            && 建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 建立.状态 == L1所有者范围管理状态::精确重复
            && !建立.是否形成内存权威发布
            && 建立.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (建立.合同版本 != L1所有者范围CRUD合同版本
            || 建立.建立幂等身份 != 状态所有者建立身份
            || 建立.事实代次 == 0 || (!首次完整 && !重复完整)
            || !建立.所有者事实 || !原始交付.写入端口
            || 建立.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 建立.所有者事实->创建事实代次 == 0
            || 建立.所有者事实->退出事实代次
            || 原始交付.写入端口->所有者身份() != 建立.所有者事实->所有者
            || !原始交付.写入端口->有效()
            || !原始交付.写入端口->绑定于(第一层读取服务)) return std::nullopt;
        const auto 当前 = 第一层读取服务.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 建立.所有者事实->所有者});
        if (当前.状态 != L1所有者范围读取状态::成功
            || 当前.合同版本 != L1所有者范围CRUD合同版本
            || 当前.查询所有者 != 建立.所有者事实->所有者
            || !当前.所有者事实 || *当前.所有者事实 != *建立.所有者事实)
            return std::nullopt;
        return L2状态所有者交付{std::move(*原始交付.写入端口)};
    } catch (...) {
        return std::nullopt;
    }
}

class L2状态结构服务 final {
public:
    explicit L2状态结构服务(const L1事实基座服务& L1,
        const L2存在结构服务& 存在服务,
        const L2特征结构服务& 特征服务,
        L2状态所有者交付&& 状态所有者交付)
        : L1_(L1), 存在服务_(存在服务), 特征服务_(特征服务),
          第一层写入端口_(验证并移动交付(L1, 状态所有者交付)),
          状态身份来源定位_(L2状态结构内部::初始化状态身份来源(
              L1_, 第一层写入端口_)) {
        const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (代次.状态 != L1中性读取状态::成功 || 代次.事实代次 == 0)
            throw std::runtime_error("L2 state type registration baseline invalid");
        const auto 登记 = 建立状态结构类型登记(
            {{L2结构合同版本, 代次.事实代次},
                L2状态结构类型登记规则版本, L2结构幂等身份{1}});
        if (!登记.成功()) throw std::runtime_error("L2 state type registration failed");
    }
    L2状态结构服务(const L2状态结构服务&) = delete;
    L2状态结构服务& operator=(const L2状态结构服务&) = delete;

    L2状态结构类型登记结果 建立状态结构类型登记(
        const L2状态结构类型登记请求& 请求) {
        try {
            if (!L2状态结构类型登记请求有效(请求))
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::入口拒绝);
            if (结构类型登记定位_) {
                if (!L2状态结构类型登记完整(*结构类型登记定位_))
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::内部不一致);
                if (结构类型登记定位_->合同版本 != 请求.请求头.合同版本
                    || 结构类型登记定位_->规则版本 != 请求.规则版本
                    || 结构类型登记定位_->首次幂等身份 != 请求.幂等身份
                    || 结构类型登记定位_->首次期望事实代次
                        != 请求.请求头.期望事实代次)
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::幂等冲突);
            }
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态结构类型登记幂等键(
                请求.幂等身份);
            写集.节点 = {
                {{L2状态结构内部::状态主体关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2状态结构内部::状态特征实例关系类型本地键值},
                    节点种类::普通, std::nullopt},
                {{L2状态结构内部::状态精确I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2状态结构内部::状态精确I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2状态结构内部::状态精确U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2状态结构内部::状态精确独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用},
                {{L2状态结构内部::状态时间I64值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64},
                {{L2状态结构内部::状态时间I64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::I64组},
                {{L2状态结构内部::状态时间U64组值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::U64组},
                {{L2状态结构内部::状态时间独立材料值类型本地键值},
                    节点种类::属性类型, L1所有者范围值表示种类::独立材料引用}};
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致, 写入.事实代次);
            const auto 状态 = L2状态结构内部::映射登记写入状态(写入.状态);
            if (状态 != L2状态结构类型登记状态::已提交
                && 状态 != L2状态结构类型登记状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成登记失败(状态, 写入.事实代次);
            }
            const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
                && 写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::不适用;
            const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
                && !写入.是否形成内存权威发布
                && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
            auto 登记 = L2状态结构内部::从写入形成登记(写入, 请求);
            if (写入.事实代次 == 0 || (!首次完整 && !重复完整) || !登记
                || !L2状态结构内部::登记历史完整(L1_, *登记))
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致, 写入.事实代次);
            if (结构类型登记定位_ && *结构类型登记定位_ != *登记)
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致, 写入.事实代次);
            结构类型登记定位_ = *登记;
            L2状态结构类型登记结果 结果{状态, 写入.事实代次, std::move(登记)};
            return 结果.成功() ? 结果 : L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::内部不一致, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::内部不一致);
        }
    }

    L2状态结构类型登记结果 读取当前状态结构类型登记() const {
        try {
            if (!结构类型登记定位_)
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::登记未加载);
            if (!L2状态结构类型登记完整(*结构类型登记定位_))
                return L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致);
            auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成登记失败(
                    代次.状态 == L1中性读取状态::资源失败
                        ? L2状态结构类型登记状态::资源失败
                        : L2状态结构类型登记状态::内部不一致,
                    代次.事实代次);
            for (int 尝试 = 0; 尝试 < 2; ++尝试) {
                const auto 编码 = L2状态结构内部::登记编码组(*结构类型登记定位_);
                L1所有者范围一致当前读取请求 请求;
                请求.合同版本 = L1所有者范围一致当前读取合同版本;
                请求.期望事实代次 = 代次.事实代次;
                请求.节点.assign(编码.begin(), 编码.end());
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
                const auto 顶层 = L2状态结构内部::解释一致读取顶层(
                    读取, 请求.期望事实代次);
                if (!顶层.成功()) {
                    if (顶层.状态 == L2结构状态::事实代次漂移 && 尝试 == 0) {
                        代次.事实代次 = 顶层.截止;
                        continue;
                    }
                    const auto 登记状态 = 顶层.状态 == L2结构状态::入口拒绝
                        ? L2状态结构类型登记状态::入口拒绝
                        : 顶层.状态 == L2结构状态::许可拒绝
                            ? L2状态结构类型登记状态::许可拒绝
                        : 顶层.状态 == L2结构状态::事实代次漂移
                            ? L2状态结构类型登记状态::事实代次漂移
                        : 顶层.状态 == L2结构状态::资源失败
                            ? L2状态结构类型登记状态::资源失败
                            : L2状态结构类型登记状态::内部不一致;
                    return L2状态结构内部::形成登记失败(登记状态, 顶层.截止);
                }
                if (读取.节点.size() != 编码.size() || !读取.关系.empty()
                    || !读取.值.empty() || !读取.属性值.empty()
                    || !读取.源关系组.empty() || !读取.目标关系组.empty())
                    return L2状态结构内部::形成登记失败(
                        L2状态结构类型登记状态::内部不一致, 顶层.截止);
                const std::array<std::optional<L1所有者范围值表示种类>, 10> 表示 = {
                    std::nullopt, std::nullopt, L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用, L1所有者范围值表示种类::I64,
                    L1所有者范围值表示种类::I64组, L1所有者范围值表示种类::U64组,
                    L1所有者范围值表示种类::独立材料引用};
                for (std::size_t 索引 = 0; 索引 < 编码.size(); ++索引) {
                    const auto* 项 = L2状态结构内部::查找唯一节点项(读取, 编码[索引]);
                    const auto 种类 = 索引 < 2 ? 节点种类::普通 : 节点种类::属性类型;
                    if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                        || !项->事实 || 项->事实->编码 != 编码[索引]
                        || 项->事实->种类 != 种类
                        || 项->事实->属性类型表示 != 表示[索引]
                        || 项->事实->创建事实代次
                            != 结构类型登记定位_->建立事实代次
                        || 项->事实->退出事实代次 || !项->事实->当前属性.empty())
                        return L2状态结构内部::形成登记失败(
                            L2状态结构类型登记状态::内部不一致, 顶层.截止);
                }
                auto 登记 = *结构类型登记定位_;
                登记.事实截止代次 = 顶层.截止;
                L2状态结构类型登记结果 结果{
                    L2状态结构类型登记状态::已读取, 顶层.截止, 登记};
                return 结果.成功() ? 结果 : L2状态结构内部::形成登记失败(
                    L2状态结构类型登记状态::内部不一致, 顶层.截止);
            }
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::事实代次漂移, 代次.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成登记失败(
                L2状态结构类型登记状态::内部不一致);
        }
    }

    L2状态写入结果 新增状态(const L2状态新增请求& 请求) {
        if (!L2状态新增请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (登记结果.状态 != L2状态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2状态结构内部::形成写入失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const auto 精确类型 = L2状态结构内部::选择状态值类型编码(
                登记, 请求.精确值材料, true);
            const auto 时间类型 = L2状态结构内部::选择状态值类型编码(
                登记, 请求.时间值材料, false);
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(请求.幂等身份);
            写集.节点 = {{{L2状态结构内部::状态节点本地键值},
                节点种类::普通, std::nullopt}};
            写集.关系 = {
                {{L2状态结构内部::状态族归属关系本地键值},
                    L1所有者范围写集本地键{L2状态结构内部::状态节点本地键值},
                    状态身份来源定位_.族锚点,
                    状态身份来源定位_.族归属关系类型,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态主体关系本地键值},
                    L1所有者范围写集本地键{L2状态结构内部::状态节点本地键值},
                    请求.主体存在.值, 登记.主体关系类型.值,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态特征实例关系本地键值},
                    L1所有者范围写集本地键{L2状态结构内部::状态节点本地键值},
                    请求.特征实例.值, 登记.特征实例关系类型.值,
                    L2状态结构内部::状态端点角色值}};
            写集.值 = {
                {{L2状态结构内部::状态精确值本地键值},
                    L1所有者范围写集本地键{L2状态结构内部::状态节点本地键值},
                    精确类型, L2状态结构内部::转换为L1材料(请求.精确值材料),
                    请求.来源稳定编码},
                {{L2状态结构内部::状态时间值本地键值},
                    L1所有者范围写集本地键{L2状态结构内部::状态节点本地键值},
                    时间类型, L2状态结构内部::转换为L1材料(请求.时间值材料),
                    请求.来源稳定编码}};
            写集.属性槽变更 = {
                {L1所有者范围写集本地键{L2状态结构内部::状态节点本地键值},
                    精确类型,
                    L1所有者范围写集本地键{L2状态结构内部::状态精确值本地键值}},
                {L1所有者范围写集本地键{L2状态结构内部::状态节点本地键值},
                    时间类型,
                    L1所有者范围写集本地键{L2状态结构内部::状态时间值本地键值}}};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成写入失败(
                    L2状态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.主体存在, 0});
                if (!主体来源.成功() || !主体来源.身份来源
                    || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值)
                    return L2状态结构内部::形成写入失败(
                        主体来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 主体来源.结果头.状态,
                        主体来源.结果头.事实截止代次);
                const auto 实例来源 = 特征服务_.读取特征实例身份来源({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                if (!实例来源.成功() || !实例来源.身份来源
                    || 实例来源.身份来源->节点稳定编码 != 请求.特征实例.值)
                    return L2状态结构内部::形成写入失败(
                        实例来源.结果头.状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 实例来源.结果头.状态,
                        实例来源.结果头.事实截止代次);
                const auto 主体 = 存在服务_.读取完整存在({请求.请求头,
                    L2读取类别::当前, 请求.主体存在, 0});
                const auto 主体状态 = L2状态结构内部::检查端点结果头(
                    主体.结果头, 请求.请求头.期望事实代次);
                if (主体状态 != L2结构状态::已读取 || !主体.存在)
                    return L2状态结构内部::形成写入失败(
                        主体状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 主体状态,
                        主体.结果头.事实截止代次);
                const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.特征实例, 0});
                const auto 实例状态 = L2状态结构内部::检查端点结果头(
                    实例.结果头, 请求.请求头.期望事实代次);
                if (实例状态 != L2结构状态::已读取 || !实例.特征实例)
                    return L2状态结构内部::形成写入失败(
                        实例状态 == L2结构状态::已读取
                            ? L2结构状态::内部不一致 : 实例状态,
                        实例.结果头.事实截止代次);
                if (主体.存在->身份 != 请求.主体存在
                    || 主体.存在->生命周期.退出事实代次
                    || 实例.特征实例->身份 != 请求.特征实例
                    || 实例.特征实例->生命周期.退出事实代次)
                    return L2状态结构内部::形成写入失败(
                        L2结构状态::内部不一致, 请求.请求头.期望事实代次);
                if (实例.特征实例->宿主存在 != 请求.主体存在)
                    return L2状态结构内部::形成写入失败(
                        L2结构状态::引用冲突, 请求.请求头.期望事实代次);
            }
            return 提交并读回新增状态(写集, 请求, 登记);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成写入失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成写入失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成写入失败(L2结构状态::内部不一致);
        }
    }

    L2状态完整读取结果 读取完整状态(
        const L2状态完整读取请求& 请求) const {
        if (!L2状态完整读取请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (登记结果.状态 != L2状态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2状态结构内部::形成完整读取失败(请求,
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            return 请求.读取类别 == L2读取类别::当前
                ? 读取当前完整状态(请求, *登记结果.登记)
                : 读取历史完整状态(请求, *登记结果.登记);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；当前来源由 owner、锚点和唯一非自环归属同截止证明。
    L2状态身份来源读取结果 读取状态身份来源(
        const L2状态身份来源读取请求& 请求) const {
        if (!L2状态身份来源读取请求有效(请求)) return {};
        try {
            if (请求.状态.值 == 状态身份来源定位_.族锚点
                || 请求.状态.值 == 状态身份来源定位_.族归属关系类型)
                return {{L2结构合同版本, L2结构状态::入口拒绝,
                    请求.读取类别 == L2读取类别::当前
                        ? 请求.请求头.期望事实代次 : 请求.历史截止事实代次,
                    std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (请求.读取类别 == L2读取类别::当前) {
                L1所有者范围一致当前读取请求 L1请求;
                L1请求.合同版本 = L1所有者范围一致当前读取合同版本;
                L1请求.期望事实代次 = 请求.请求头.期望事实代次;
                L1请求.所有者 = {状态身份来源定位_.所有者};
                L1请求.节点 = {请求.状态.值, 状态身份来源定位_.族锚点,
                    状态身份来源定位_.族归属关系类型};
                L1请求.源关系组 = {{请求.状态.值,
                    状态身份来源定位_.族归属关系类型}};
                const auto 读取 = L1_.尝试读取所有者范围一致当前投影(L1请求);
                const auto 顶层 = L2状态结构内部::解释一致读取顶层(
                    读取, 请求.请求头.期望事实代次);
                if (!顶层.成功()) return {{L2结构合同版本, 顶层.状态,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (读取.所有者.size() != 1 || 读取.节点.size() != 3
                    || !读取.关系.empty() || !读取.值.empty()
                    || !读取.属性值.empty() || 读取.源关系组.size() != 1
                    || !读取.目标关系组.empty())
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto* 节点项 = L2状态结构内部::查找唯一节点项(
                    读取, 请求.状态.值);
                const auto* 锚点项 = L2状态结构内部::查找唯一节点项(
                    读取, 状态身份来源定位_.族锚点);
                const auto* 类型项 = L2状态结构内部::查找唯一节点项(
                    读取, 状态身份来源定位_.族归属关系类型);
                const auto* 关系组 = L2状态结构内部::查找唯一源关系组(
                    读取, 请求.状态.值, 状态身份来源定位_.族归属关系类型);
                if (!节点项 || !锚点项 || !类型项 || !关系组)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
                    const auto 状态 = 节点项->状态
                            == L1所有者范围一致当前读取项目状态::未找到
                        ? L2结构状态::未找到
                        : 节点项->状态
                            == L1所有者范围一致当前读取项目状态::已退出
                            ? L2结构状态::已退出 : L2结构状态::入口拒绝;
                    return {{L2结构合同版本, 节点项->事实
                            ? L2结构状态::内部不一致 : 状态,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                }
                if (!节点项->事实 || !锚点项->事实 || !类型项->事实
                    || 读取.所有者.front().状态
                        != L1所有者范围一致当前读取项目状态::成功
                    || !读取.所有者.front().所有者事实 || 关系组->成员.size() != 1)
                    return {{L2结构合同版本, 关系组->成员.empty()
                            ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 节点 = *节点项->事实;
                const auto& 锚点 = *锚点项->事实;
                const auto& 类型 = *类型项->事实;
                const auto& 关系 = 关系组->成员.front().关系;
                if (节点.写入所有者 != 状态身份来源定位_.所有者
                    || 节点.种类 != 节点种类::普通 || 节点.属性类型表示
                    || 节点.退出事实代次 || 锚点.编码 != 状态身份来源定位_.族锚点
                    || 类型.编码 != 状态身份来源定位_.族归属关系类型
                    || 锚点.写入所有者 != 状态身份来源定位_.所有者
                    || 类型.写入所有者 != 状态身份来源定位_.所有者
                    || 关系.写入所有者 != 状态身份来源定位_.所有者
                    || 关系.源节点 != 请求.状态.值
                    || 关系.目标节点 != 状态身份来源定位_.族锚点
                    || 关系.关系类型节点 != 状态身份来源定位_.族归属关系类型
                    || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                    || 关系.退出事实代次 || 关系.创建事实代次 != 节点.创建事实代次)
                    return {{L2结构合同版本, L2结构状态::内部不一致,
                        顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
                const auto& 所有者 = *读取.所有者.front().所有者事实;
                L2节点族身份来源事实 来源{L2节点族::状态, 节点.编码,
                    状态身份来源定位_.所有者, 锚点.编码, 类型.编码, 关系.编码,
                    关系.角色或顺序, {所有者.创建事实代次, 所有者.退出事实代次},
                    {节点.创建事实代次, 节点.退出事实代次},
                    {锚点.创建事实代次, 锚点.退出事实代次},
                    {类型.创建事实代次, 类型.退出事实代次},
                    {关系.创建事实代次, 关系.退出事实代次}};
                L2状态身份来源读取结果 结果{{L2结构合同版本,
                    L2结构状态::已读取, 顶层.截止, std::nullopt},
                    请求.读取类别, 0, std::move(来源)};
                return 结果.成功() ? 结果 : L2状态身份来源读取结果{{
                    L2结构合同版本, L2结构状态::内部不一致,
                    顶层.截止, std::nullopt}, 请求.读取类别, 0, std::nullopt};
            }
            const auto 当前代次 = L1_.读取中性当前事实代次(
                {L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 != 请求.请求头.期望事实代次)
                return {{L2结构合同版本,
                    当前代次.状态 == L1中性读取状态::成功
                        ? L2结构状态::事实代次漂移
                        : L2状态结构内部::映射事实代次探测失败(当前代次.状态),
                    当前代次.事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 节点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.状态.值});
            const auto 所有者读取 = L1_.读取历史结构所有者(
                {L1所有者范围CRUD合同版本, 状态身份来源定位_.所有者});
            const auto 锚点读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 状态身份来源定位_.族锚点});
            const auto 类型读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 状态身份来源定位_.族归属关系类型});
            const auto* 节点 = 节点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
            const auto* 锚点 = 锚点读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*锚点读取.事实) : nullptr;
            const auto* 类型 = 类型读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*类型读取.事实) : nullptr;
            if (节点读取.状态 != L1所有者范围读取状态::成功)
                return {{L2结构合同版本,
                    L2状态结构内部::映射历史读取状态(节点读取.状态),
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            if (!节点 || !锚点 || !类型 || !所有者读取.所有者事实
                || 节点->写入所有者 != 状态身份来源定位_.所有者
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->创建事实代次 > 请求.历史截止事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const std::uint64_t 关系截止 = 节点->退出事实代次
                    && *节点->退出事实代次 <= 请求.历史截止事实代次
                ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
            const auto 关系组 = L1_.读取所有者范围历史关系组({
                L1所有者范围CRUD合同版本, L1所有者范围关系端点方向::源,
                请求.状态.值, 状态身份来源定位_.族归属关系类型, 关系截止});
            if (关系组.状态 != L1所有者范围读取状态::成功
                || 关系组.关系组.size() != 1)
                return {{L2结构合同版本, 关系组.关系组.empty()
                        ? L2结构状态::入口拒绝 : L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto& 关系 = 关系组.关系组.front();
            if (关系.写入所有者 != 状态身份来源定位_.所有者
                || 关系.源节点 != 请求.状态.值
                || 关系.目标节点 != 状态身份来源定位_.族锚点
                || 关系.关系类型节点 != 状态身份来源定位_.族归属关系类型
                || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                || 关系.创建事实代次 != 节点->创建事实代次)
                return {{L2结构合同版本, L2结构状态::内部不一致,
                    请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                    请求.历史截止事实代次, std::nullopt};
            const auto 投影生命周期 = [&](std::uint64_t 创建,
                std::optional<std::uint64_t> 退出) noexcept {
                if (退出 && *退出 > 请求.历史截止事实代次) 退出.reset();
                return L2生命周期{创建, 退出};
            };
            L2节点族身份来源事实 来源{L2节点族::状态, 节点->编码,
                状态身份来源定位_.所有者, 锚点->编码, 类型->编码, 关系.编码,
                关系.角色或顺序,
                投影生命周期(所有者读取.所有者事实->创建事实代次,
                    所有者读取.所有者事实->退出事实代次),
                投影生命周期(节点->创建事实代次, 节点->退出事实代次),
                投影生命周期(锚点->创建事实代次, 锚点->退出事实代次),
                投影生命周期(类型->创建事实代次, 类型->退出事实代次),
                投影生命周期(关系.创建事实代次, 关系.退出事实代次)};
            L2状态身份来源读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 请求.历史截止事实代次, std::nullopt},
                请求.读取类别, 请求.历史截止事实代次, std::move(来源)};
            return 结果.成功() ? 结果 : L2状态身份来源读取结果{{
                L2结构合同版本, L2结构状态::内部不一致,
                请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
                请求.历史截止事实代次, std::nullopt};
        } catch (const std::bad_alloc&) {
            return {{L2结构合同版本, L2结构状态::资源失败, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        } catch (...) {
            return {{L2结构合同版本, L2结构状态::内部不一致, 0,
                std::nullopt}, 请求.读取类别, 请求.历史截止事实代次, std::nullopt};
        }
    }

    L2当前状态组读取结果 按主体读取全部当前状态(
        const L2按主体当前状态读取请求& 请求) const {
        if (!L2按主体当前状态读取请求有效(请求)) return {};
        try {
            const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                L2读取类别::当前, 请求.主体存在, 0});
            if (!主体来源.成功() || !主体来源.身份来源)
                return L2状态结构内部::形成组读取失败(
                    主体来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体来源.结果头.状态,
                    主体来源.结果头.事实截止代次);
            const auto 主体 = 存在服务_.读取完整存在({请求.请求头,
                L2读取类别::当前, 请求.主体存在, 0});
            const auto 主体状态 = L2状态结构内部::检查端点结果头(
                主体.结果头, 请求.请求头.期望事实代次);
            if (主体状态 != L2结构状态::已读取 || !主体.存在)
                return L2状态结构内部::形成组读取失败(
                    主体状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 主体状态,
                    主体.结果头.事实截止代次);
            if (主体.存在->身份 != 请求.主体存在
                || 主体.存在->生命周期.退出事实代次)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 请求.请求头.期望事实代次);
            return 按端点读取状态组(
                请求.请求头, 请求.主体存在.值, true, 请求.最大数量);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前状态组读取结果 按特征实例读取全部当前状态(
        const L2按特征实例当前状态读取请求& 请求) const {
        if (!L2按特征实例当前状态读取请求有效(请求)) return {};
        try {
            const auto 实例来源 = 特征服务_.读取特征实例身份来源({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            if (!实例来源.成功() || !实例来源.身份来源)
                return L2状态结构内部::形成组读取失败(
                    实例来源.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 实例来源.结果头.状态,
                    实例来源.结果头.事实截止代次);
            const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                L2读取类别::当前, 请求.特征实例, 0});
            const auto 实例状态 = L2状态结构内部::检查端点结果头(
                实例.结果头, 请求.请求头.期望事实代次);
            if (实例状态 != L2结构状态::已读取 || !实例.特征实例)
                return L2状态结构内部::形成组读取失败(
                    实例状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 实例状态,
                    实例.结果头.事实截止代次);
            if (实例.特征实例->身份 != 请求.特征实例
                || 实例.特征实例->生命周期.退出事实代次)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 请求.请求头.期望事实代次);
            return 按端点读取状态组(
                请求.请求头, 请求.特征实例.值, false, 请求.最大数量);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成组读取失败(L2结构状态::内部不一致);
        }
    }

    L2当前状态组读取结果 按来源读取全部当前状态(
        const L2按来源当前状态读取请求& 请求) const {
        if (!L2按来源当前状态读取请求有效(请求))
            return L2状态结构内部::形成组读取失败(L2结构状态::入口拒绝);
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (登记结果.状态 != L2状态结构类型登记状态::已读取
                || !登记结果.登记 || !登记结果.成功())
                return L2状态结构内部::形成组读取失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            constexpr auto 最大整数 = (std::numeric_limits<std::uint64_t>::max)();
            const auto 半最大整数 = 最大整数 / 2;
            const auto 第一层预算 = 请求.最大数量 >= 半最大整数
                ? 最大整数 : (请求.最大数量 + 1) * 2;
            const auto 候选上限 = 请求.最大数量 == 最大整数
                ? 最大整数 : 请求.最大数量 + 1;
            const auto 读取 = L1_.按来源读取所有者范围全部当前值({
                L1所有者范围来源当前值组读取合同版本,
                状态身份来源定位_.所有者, 请求.来源稳定编码,
                请求.请求头.期望事实代次, 第一层预算});
            if (读取.合同版本 != L1所有者范围来源当前值组读取合同版本
                || 读取.所有者 != 状态身份来源定位_.所有者
                || 读取.来源节点 != 请求.来源稳定编码
                || 读取.期望事实代次 != 请求.请求头.期望事实代次)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
            if (读取.状态 != L1所有者范围来源当前值组读取状态::成功) {
                if (!读取.当前值.empty())
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                return L2状态结构内部::形成组读取失败(
                    L2状态结构内部::映射来源值组读取失败状态(读取.状态),
                    读取.读取事实代次);
            }
            if (读取.读取事实代次 != 请求.请求头.期望事实代次
                || 读取.读取事实代次 == 0
                || 读取.当前值.size() > 第一层预算)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);

            struct 候选值角色 final {
                稳定编码 状态;
                std::uint8_t 角色 = 0;
            };
            std::vector<候选值角色> 候选值;
            候选值.reserve(读取.当前值.size());
            const auto 是精确类型 = [&](稳定编码 类型) noexcept {
                return 类型 == 登记.精确I64值类型.值
                    || 类型 == 登记.精确I64组值类型.值
                    || 类型 == 登记.精确U64组值类型.值
                    || 类型 == 登记.精确独立材料值类型.值;
            };
            const auto 是时间类型 = [&](稳定编码 类型) noexcept {
                return 类型 == 登记.时间I64值类型.值
                    || 类型 == 登记.时间I64组值类型.值
                    || 类型 == 登记.时间U64组值类型.值
                    || 类型 == 登记.时间独立材料值类型.值;
            };
            for (const auto& 值 : 读取.当前值) {
                const bool 精确 = 是精确类型(值.属性类型节点);
                const bool 时间 = 是时间类型(值.属性类型节点);
                if (!有效(值.编码) || !有效(值.所属节点)
                    || 值.来源节点 != 请求.来源稳定编码
                    || 值.写入所有者 != 状态身份来源定位_.所有者
                    || 值.创建事实代次 == 0
                    || 值.创建事实代次 > 读取.读取事实代次
                    || 值.退出事实代次 || 精确 == 时间)
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                候选值.push_back({值.所属节点,
                    static_cast<std::uint8_t>(精确 ? 1 : 2)});
            }
            std::sort(候选值.begin(), 候选值.end(),
                [](const 候选值角色& 左, const 候选值角色& 右) noexcept {
                    if (左.状态 != 右.状态) return 左.状态 < 右.状态;
                    return 左.角色 < 右.角色;
                });
            std::vector<稳定编码> 状态编码组;
            状态编码组.reserve(候选值.size() / 2);
            for (std::size_t 索引 = 0; 索引 < 候选值.size();) {
                if (索引 + 1 >= 候选值.size()
                    || 候选值[索引].角色 != 1
                    || 候选值[索引 + 1].角色 != 2
                    || 候选值[索引].状态 != 候选值[索引 + 1].状态)
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                状态编码组.push_back(候选值[索引].状态);
                索引 += 2;
            }
            if (状态编码组.size() > 候选上限)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);

            L2当前状态组读取结果 结果{{L2结构合同版本,
                L2结构状态::已读取, 读取.读取事实代次, std::nullopt}, {}};
            结果.状态.reserve(状态编码组.size());
            for (const auto 编码 : 状态编码组) {
                const auto 单项 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, L2状态身份{编码}, 0});
                if (单项.结果头.状态 != L2结构状态::已读取
                    || !单项.状态
                    || 单项.结果头.事实截止代次 != 读取.读取事实代次) {
                    const auto 状态 = 单项.结果头.状态
                            == L2结构状态::事实代次漂移
                        || 单项.结果头.状态 == L2结构状态::资源失败
                        ? 单项.结果头.状态 : L2结构状态::内部不一致;
                    return L2状态结构内部::形成组读取失败(
                        状态, 单项.结果头.事实截止代次);
                }
                if (单项.状态->身份 != L2状态身份{编码}
                    || 单项.状态->来源稳定编码 != 请求.来源稳定编码
                    || 单项.状态->生命周期.退出事实代次
                    || !L2状态事实完整(*单项.状态, 登记,
                        读取.读取事实代次))
                    return L2状态结构内部::形成组读取失败(
                        L2结构状态::内部不一致, 读取.读取事实代次);
                结果.状态.push_back(*单项.状态);
            }
            if (结果.状态.size() > 请求.最大数量)
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::数量预算不足, 读取.读取事实代次);
            return 结果.成功() ? 结果
                : L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 读取.读取事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成组读取失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成组读取失败(
                L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；主体与实例两条关系只在一份写集中原子替换。
    L2状态引用替换结果 替换状态引用(const L2状态引用替换请求& 请求) {
        if (!L2状态引用替换请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2状态结构内部::形成引用替换失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(请求.幂等身份);
            写集.关系 = {
                {{L2状态结构内部::状态主体关系本地键值}, 请求.状态.值,
                    请求.新主体存在.值, 登记.主体关系类型.值,
                    L2状态结构内部::状态端点角色值},
                {{L2状态结构内部::状态特征实例关系本地键值}, 请求.状态.值,
                    请求.新特征实例.值, 登记.特征实例关系类型.值,
                    L2状态结构内部::状态端点角色值}};
            写集.退出事实 = {请求.旧引用.主体关系稳定编码,
                请求.旧引用.特征实例关系稳定编码};
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成引用替换失败(
                    L2状态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            std::optional<L2状态事实> 写前状态;
            std::optional<L2状态自有关系引用> 写前关系;
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.状态 || !当前.自有关系)
                    return L2状态结构内部::形成引用替换失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                if (当前.自有关系->主体关系稳定编码
                        != 请求.旧引用.主体关系稳定编码
                    || 当前.自有关系->特征实例关系稳定编码
                        != 请求.旧引用.特征实例关系稳定编码
                    || (当前.状态->主体存在 == 请求.新主体存在
                        && 当前.状态->特征实例 == 请求.新特征实例))
                    return L2状态结构内部::形成引用替换失败(
                        L2结构状态::引用冲突, 代次.事实代次);
                写前状态 = *当前.状态;
                写前关系 = *当前.自有关系;
                const auto 状态来源 = 读取状态身份来源({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
                    L2读取类别::当前, 请求.新主体存在, 0});
                const auto 实例来源 = 特征服务_.读取特征实例身份来源({请求.请求头,
                    L2读取类别::当前, 请求.新特征实例, 0});
                const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
                    L2读取类别::当前, 请求.新特征实例, 0});
                if (!状态来源.成功() || !主体来源.成功() || !实例来源.成功()
                    || 实例.结果头.状态 != L2结构状态::已读取
                    || !状态来源.身份来源 || !主体来源.身份来源
                    || !实例来源.身份来源
                    || !实例.特征实例)
                    return L2状态结构内部::形成引用替换失败(
                        !状态来源.成功() ? 状态来源.结果头.状态
                            : !主体来源.成功() ? 主体来源.结果头.状态
                            : !实例来源.成功() ? 实例来源.结果头.状态
                            : 实例.结果头.状态,
                        代次.事实代次);
                if (状态来源.结果头.事实截止代次 != 代次.事实代次
                    || 主体来源.结果头.事实截止代次 != 代次.事实代次
                    || 实例来源.结果头.事实截止代次 != 代次.事实代次
                    || 实例.结果头.事实截止代次 != 代次.事实代次
                    || 状态来源.身份来源->节点稳定编码 != 请求.状态.值
                    || 主体来源.身份来源->节点稳定编码 != 请求.新主体存在.值
                    || 实例来源.身份来源->节点稳定编码 != 请求.新特征实例.值
                    || 实例.特征实例->身份 != 请求.新特征实例
                    || 实例.特征实例->宿主存在 != 请求.新主体存在)
                    return L2状态结构内部::形成引用替换失败(
                        实例.特征实例->宿主存在 != 请求.新主体存在
                            ? L2结构状态::引用冲突 : L2结构状态::内部不一致,
                        代次.事实代次);
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
            if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成引用替换失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成引用替换失败(状态码, 写入.事实代次);
            }
            const auto 新主体关系 = L2状态结构内部::查找编码映射(
                写入, L2状态结构内部::状态主体关系本地键值);
            const auto 新实例关系 = L2状态结构内部::查找编码映射(
                写入, L2状态结构内部::状态特征实例关系本地键值);
            if (!L2状态结构内部::写入成功边界完整(写入)
                || 写入.新编码映射.size() != 2 || !新主体关系 || !新实例关系
                || *新主体关系 == *新实例关系)
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < 写入.事实代次)
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 首次状态 = 读取完整状态({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.状态, 写入.事实代次});
            const auto 读取旧关系 = [&](稳定编码 编码) {
                return L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 编码});
            };
            const auto 主体旧读取 = 读取旧关系(请求.旧引用.主体关系稳定编码);
            const auto 实例旧读取 = 读取旧关系(请求.旧引用.特征实例关系稳定编码);
            const auto* 主体旧 = 主体旧读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*主体旧读取.事实) : nullptr;
            const auto* 实例旧 = 实例旧读取.事实
                ? std::get_if<L1所有者范围关系事实>(&*实例旧读取.事实) : nullptr;
            const auto 主体退出 = 主体旧
                ? L2状态结构内部::形成关系退出事实(*主体旧, 写入.事实代次) : std::nullopt;
            const auto 实例退出 = 实例旧
                ? L2状态结构内部::形成关系退出事实(*实例旧, 写入.事实代次) : std::nullopt;
            const auto 所有者 = 第一层写入端口_.所有者身份();
            if (首次状态.结果头.状态 != L2结构状态::已读取 || !首次状态.状态
                || !首次状态.自有关系 || !主体退出 || !实例退出
                || 首次状态.状态->主体存在 != 请求.新主体存在
                || 首次状态.状态->特征实例 != 请求.新特征实例
                || 首次状态.自有关系->主体关系稳定编码 != *新主体关系
                || 首次状态.自有关系->特征实例关系稳定编码 != *新实例关系
                || !L2状态结构内部::历史关系匹配(*主体旧,
                    请求.旧引用.主体关系稳定编码, 请求.状态.值,
                    写前状态 ? 写前状态->主体存在.值 : 主体旧->目标节点,
                    登记.主体关系类型.值, 所有者, 写入.事实代次)
                || !L2状态结构内部::历史关系匹配(*实例旧,
                    请求.旧引用.特征实例关系稳定编码, 请求.状态.值,
                    写前状态 ? 写前状态->特征实例.值 : 实例旧->目标节点,
                    登记.特征实例关系类型.值, 所有者, 写入.事实代次)
                || (写前状态 && (!L2状态结构内部::状态未改字段相同(
                        *写前状态, *首次状态.状态)
                    || 写前状态->精确值 != 首次状态.状态->精确值
                    || 写前状态->时间值 != 首次状态.状态->时间值))
                || (写前关系 && 首次状态.自有关系->族归属关系稳定编码
                    != 写前关系->族归属关系稳定编码))
                return L2状态结构内部::形成引用替换失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2状态引用替换结果 结果{{L2结构合同版本, 状态码,
                写入.事实代次, 写入.事实代次}, *首次状态.状态,
                *首次状态.自有关系, L2状态引用对关系退出投影{
                    *主体退出, *实例退出}};
            return 结果.成功() ? 结果 : L2状态结构内部::形成引用替换失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成引用替换失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成引用替换失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成引用替换失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；所选角色的新值、槽切换和旧值退出同代发布。
    L2状态值换代结果 换代状态值(const L2状态值换代请求& 请求) {
        if (!L2状态值换代请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2状态结构内部::形成值换代失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            const bool 精确角色 = 请求.值角色 == L2状态值角色::精确值;
            const auto 类型 = L2状态结构内部::选择状态值类型编码(
                登记, 请求.新值材料, 精确角色);
            const auto 本地键 = 精确角色
                ? L2状态结构内部::状态精确值本地键值
                : L2状态结构内部::状态时间值本地键值;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(请求.幂等身份);
            写集.值 = {{{本地键}, 请求.状态.值, 类型,
                L2状态结构内部::转换为L1材料(请求.新值材料),
                请求.来源稳定编码}};
            写集.属性槽变更 = {{请求.状态.值, 类型, {本地键}}};
            写集.退出事实 = {请求.旧值稳定编码};
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成值换代失败(
                    L2状态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            std::optional<L2状态事实> 写前状态;
            std::optional<L2状态自有关系引用> 写前关系;
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.状态 || !当前.自有关系)
                    return L2状态结构内部::形成值换代失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                const auto& 旧值 = 精确角色 ? 当前.状态->精确值 : 当前.状态->时间值;
                if (旧值.值稳定编码 != 请求.旧值稳定编码
                    || 当前.状态->来源稳定编码 != 请求.来源稳定编码
                    || 当前.状态->精确值.来源稳定编码 != 请求.来源稳定编码
                    || 当前.状态->时间值.来源稳定编码 != 请求.来源稳定编码)
                    return L2状态结构内部::形成值换代失败(
                        L2结构状态::引用冲突, 代次.事实代次);
                写前状态 = *当前.状态;
                写前关系 = *当前.自有关系;
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
            if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成值换代失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成值换代失败(状态码, 写入.事实代次);
            }
            const auto 新值编码 = L2状态结构内部::查找编码映射(写入, 本地键);
            if (!L2状态结构内部::写入成功边界完整(写入)
                || 写入.新编码映射.size() != 1 || !新值编码)
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < 写入.事实代次)
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 首次状态 = 读取完整状态({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.状态, 写入.事实代次});
            const auto 旧读取 = L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 请求.旧值稳定编码});
            const auto* 旧值 = 旧读取.事实
                ? std::get_if<L1所有者范围值事实>(&*旧读取.事实) : nullptr;
            const auto 已退出值 = 旧值
                ? L2状态结构内部::形成截止属性事实(
                    *旧值, 登记, 写入.事实代次, 精确角色) : std::nullopt;
            const auto& 当前角色值 = 首次状态.状态
                ? (精确角色 ? 首次状态.状态->精确值 : 首次状态.状态->时间值)
                : L2属性事实{};
            const auto 预期旧类型 = 写前状态
                ? (精确角色 ? 写前状态->精确值.属性类型身份
                    : 写前状态->时间值.属性类型身份)
                : (旧值 ? 旧值->属性类型节点 : 稳定编码{});
            const auto& 另一角色值 = 首次状态.状态
                ? (精确角色 ? 首次状态.状态->时间值 : 首次状态.状态->精确值)
                : L2属性事实{};
            if (首次状态.结果头.状态 != L2结构状态::已读取
                || !首次状态.状态 || !首次状态.自有关系 || !已退出值
                || 当前角色值.值稳定编码 != *新值编码
                || 当前角色值.类型化不可变材料 != 请求.新值材料
                || 当前角色值.来源稳定编码 != 请求.来源稳定编码
                || 已退出值->值稳定编码 != 请求.旧值稳定编码
                || 已退出值->退出事实代次 != 写入.事实代次
                || !旧值 || 旧值->所属节点 != 请求.状态.值
                || 旧值->属性类型节点 != 预期旧类型
                || 旧值->来源节点 != 请求.来源稳定编码
                || 旧值->写入所有者 != 第一层写入端口_.所有者身份()
                || (写前状态 && (!L2状态结构内部::状态未改字段相同(
                        *写前状态, *首次状态.状态)
                    || 另一角色值 != (精确角色
                        ? 写前状态->时间值 : 写前状态->精确值)))
                || (写前关系 && *写前关系 != *首次状态.自有关系))
                return L2状态结构内部::形成值换代失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2状态值换代结果 结果{{L2结构合同版本, 状态码,
                写入.事实代次, 写入.事实代次}, *首次状态.状态,
                *首次状态.自有关系, *已退出值};
            return 结果.成功() ? 结果 : L2状态结构内部::形成值换代失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成值换代失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成值换代失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成值换代失败(L2结构状态::内部不一致);
        }
    }

    // 诊断责任：向上送出；状态节点及五项自有事实由一份闭包写集退出。
    L2状态退出结果 退出状态(const L2状态退出请求& 请求) {
        if (!L2状态退出请求有效(请求)) return {};
        try {
            const auto 登记结果 = 读取当前状态结构类型登记();
            if (!登记结果.成功() || !登记结果.登记)
                return L2状态结构内部::形成状态退出失败(
                    L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                    登记结果.事实截止代次);
            const auto& 登记 = *登记结果.登记;
            L1所有者范围写集请求 写集;
            写集.合同版本 = L1所有者范围CRUD合同版本;
            写集.期望事实代次 = 请求.请求头.期望事实代次;
            写集.写入幂等身份 = L2状态结构内部::映射状态幂等键(请求.幂等身份);
            写集.退出事实 = {请求.状态.值,
                请求.自有事实闭包.自有关系.族归属关系稳定编码,
                请求.自有事实闭包.自有关系.主体关系稳定编码,
                请求.自有事实闭包.自有关系.特征实例关系稳定编码,
                请求.自有事实闭包.精确值稳定编码,
                请求.自有事实闭包.时间值稳定编码};
            std::sort(写集.退出事实.begin(), 写集.退出事实.end());
            const auto 代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (代次.状态 != L1中性读取状态::成功
                || 代次.合同版本 != L1中性CRUD合同版本 || 代次.事实代次 == 0)
                return L2状态结构内部::形成状态退出失败(
                    L2状态结构内部::映射事实代次探测失败(代次.状态),
                    代次.事实代次);
            if (代次.事实代次 == 请求.请求头.期望事实代次) {
                const auto 当前 = 读取完整状态({请求.请求头,
                    L2读取类别::当前, 请求.状态, 0});
                if (当前.结果头.状态 != L2结构状态::已读取
                    || !当前.状态 || !当前.自有关系)
                    return L2状态结构内部::形成状态退出失败(
                        当前.结果头.状态, 当前.结果头.事实截止代次);
                if (*当前.自有关系 != 请求.自有事实闭包.自有关系
                    || 当前.状态->精确值.值稳定编码
                        != 请求.自有事实闭包.精确值稳定编码
                    || 当前.状态->时间值.值稳定编码
                        != 请求.自有事实闭包.时间值稳定编码)
                    return L2状态结构内部::形成状态退出失败(
                        L2结构状态::引用冲突, 代次.事实代次);
            }
            const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
            if (写入.合同版本 != L1所有者范围CRUD合同版本
                || 写入.所有者 != 第一层写入端口_.所有者身份()
                || 写入.写入幂等身份 != 写集.写入幂等身份)
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
            if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
                if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                    return L2状态结构内部::形成状态退出失败(
                        L2结构状态::内部不一致, 写入.事实代次);
                return L2状态结构内部::形成状态退出失败(状态码, 写入.事实代次);
            }
            if (!L2状态结构内部::写入成功边界完整(写入)
                || !写入.新编码映射.empty())
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
            if (当前代次.状态 != L1中性读取状态::成功
                || 当前代次.事实代次 < 写入.事实代次)
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            const auto 历史 = 读取完整状态({{L2结构合同版本, 当前代次.事实代次},
                L2读取类别::历史, 请求.状态, 写入.事实代次});
            const auto 读关系 = [&](稳定编码 编码) {
                return L1_.读取所有者范围历史事实(
                    {L1所有者范围CRUD合同版本, 编码});
            };
            const auto 族读取 = 读关系(请求.自有事实闭包.自有关系.族归属关系稳定编码);
            const auto 主体读取 = 读关系(请求.自有事实闭包.自有关系.主体关系稳定编码);
            const auto 实例读取 = 读关系(请求.自有事实闭包.自有关系.特征实例关系稳定编码);
            const auto* 族 = 族读取.事实 ? std::get_if<L1所有者范围关系事实>(&*族读取.事实) : nullptr;
            const auto* 主体 = 主体读取.事实 ? std::get_if<L1所有者范围关系事实>(&*主体读取.事实) : nullptr;
            const auto* 实例 = 实例读取.事实 ? std::get_if<L1所有者范围关系事实>(&*实例读取.事实) : nullptr;
            const auto 族退出 = 族 ? L2状态结构内部::形成关系退出事实(*族, 写入.事实代次) : std::nullopt;
            const auto 主体退出 = 主体 ? L2状态结构内部::形成关系退出事实(*主体, 写入.事实代次) : std::nullopt;
            const auto 实例退出 = 实例 ? L2状态结构内部::形成关系退出事实(*实例, 写入.事实代次) : std::nullopt;
            const auto 所有者 = 第一层写入端口_.所有者身份();
            const auto& 来源 = 历史.状态 ? 历史.状态->来源稳定编码 : 稳定编码{};
            if (历史.结果头.状态 != L2结构状态::已读取 || !历史.状态
                || !历史.自有关系 || !族退出 || !主体退出 || !实例退出
                || *历史.自有关系 != 请求.自有事实闭包.自有关系
                || 历史.状态->生命周期.退出事实代次 != 写入.事实代次
                || 历史.状态->精确值.退出事实代次 != 写入.事实代次
                || 历史.状态->时间值.退出事实代次 != 写入.事实代次
                || 历史.状态->精确值.来源稳定编码 != 来源
                || 历史.状态->时间值.来源稳定编码 != 来源
                || !L2状态结构内部::历史关系匹配(*族,
                    请求.自有事实闭包.自有关系.族归属关系稳定编码,
                    请求.状态.值, 状态身份来源定位_.族锚点,
                    状态身份来源定位_.族归属关系类型, 所有者, 写入.事实代次)
                || !L2状态结构内部::历史关系匹配(*主体,
                    请求.自有事实闭包.自有关系.主体关系稳定编码,
                    请求.状态.值, 历史.状态->主体存在.值,
                    登记.主体关系类型.值, 所有者, 写入.事实代次)
                || !L2状态结构内部::历史关系匹配(*实例,
                    请求.自有事实闭包.自有关系.特征实例关系稳定编码,
                    请求.状态.值, 历史.状态->特征实例.值,
                    登记.特征实例关系类型.值, 所有者, 写入.事实代次)
                || 历史.状态->精确值.值稳定编码
                    != 请求.自有事实闭包.精确值稳定编码
                || 历史.状态->时间值.值稳定编码
                    != 请求.自有事实闭包.时间值稳定编码)
                return L2状态结构内部::形成状态退出失败(
                    L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
            L2状态退出结果 结果{{L2结构合同版本, 状态码,
                写入.事实代次, 写入.事实代次}, *历史.状态,
                L2状态自有关系退出投影{*族退出, *主体退出, *实例退出}};
            return 结果.成功() ? 结果 : L2状态结构内部::形成状态退出失败(
                L2结构状态::内部不一致, 写入.事实代次, 写入.事实代次);
        } catch (const std::bad_alloc&) {
            return L2状态结构内部::形成状态退出失败(L2结构状态::资源失败);
        } catch (const std::length_error&) {
            return L2状态结构内部::形成状态退出失败(L2结构状态::资源失败);
        } catch (...) {
            return L2状态结构内部::形成状态退出失败(L2结构状态::内部不一致);
        }
    }

private:
    static L1所有者范围写端口&& 验证并移动交付(
        const L1事实基座服务& 第一层服务,
        L2状态所有者交付& 交付) {
        if (!交付.写入端口_.有效() || !交付.写入端口_.绑定于(第一层服务))
            throw std::invalid_argument("L2 state owner delivery is invalid");
        return std::move(交付.写入端口_);
    }

    L2状态写入结果 提交并读回新增状态(
        const L1所有者范围写集请求& 写集, const L2状态新增请求& 请求,
        const L2状态结构类型登记& 登记) {
        const auto 写入 = 第一层写入端口_.提交所有者范围中性写集(写集);
        if (写入.合同版本 != L1所有者范围CRUD合同版本
            || 写入.写入幂等身份 != 写集.写入幂等身份)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 状态码 = L2状态结构内部::映射写入状态(写入.状态);
        if (状态码 != L2结构状态::已提交 && 状态码 != L2结构状态::精确重复) {
            if (!写入.新编码映射.empty() || 写入.是否形成内存权威发布)
                return L2状态结构内部::形成写入失败(
                    L2结构状态::内部不一致, 写入.事实代次);
            return L2状态结构内部::形成写入失败(状态码, 写入.事实代次);
        }
        const bool 首次完整 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复完整 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        if (写入.事实代次 == 0 || (!首次完整 && !重复完整)
            || 写入.新编码映射.size() != 6)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 节点编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态节点本地键值);
        const auto 族归属关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态族归属关系本地键值);
        const auto 主体关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态主体关系本地键值);
        const auto 特征关系编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态特征实例关系本地键值);
        const auto 精确值编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态精确值本地键值);
        const auto 时间值编码 = L2状态结构内部::查找编码映射(
            写入, L2状态结构内部::状态时间值本地键值);
        if (!节点编码 || !族归属关系编码 || !主体关系编码 || !特征关系编码
            || !精确值编码 || !时间值编码)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 读取事实 = [&](稳定编码 编码) {
            return L1_.读取所有者范围历史事实(
                {L1所有者范围CRUD合同版本, 编码});
        };
        const auto 节点读取 = 读取事实(*节点编码);
        const auto 族归属关系读取 = 读取事实(*族归属关系编码);
        const auto 主体关系读取 = 读取事实(*主体关系编码);
        const auto 特征关系读取 = 读取事实(*特征关系编码);
        const auto 精确值读取 = 读取事实(*精确值编码);
        const auto 时间值读取 = 读取事实(*时间值编码);
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        const auto* 族归属关系 = 族归属关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*族归属关系读取.事实) : nullptr;
        const auto* 主体关系 = 主体关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*主体关系读取.事实) : nullptr;
        const auto* 特征关系 = 特征关系读取.事实
            ? std::get_if<L1所有者范围关系事实>(&*特征关系读取.事实) : nullptr;
        const auto* 精确值 = 精确值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*精确值读取.事实) : nullptr;
        const auto* 时间值 = 时间值读取.事实
            ? std::get_if<L1所有者范围值事实>(&*时间值读取.事实) : nullptr;
        if (!节点 || !族归属关系 || !主体关系 || !特征关系 || !精确值 || !时间值
            || 族归属关系->源节点 != *节点编码
            || 族归属关系->目标节点 != 状态身份来源定位_.族锚点
            || 族归属关系->关系类型节点 != 状态身份来源定位_.族归属关系类型
            || 族归属关系->角色或顺序 != L2状态结构内部::状态端点角色值
            || 族归属关系->写入所有者 != 第一层写入端口_.所有者身份()
            || 族归属关系->创建事实代次 != 写入.事实代次
            || 族归属关系->退出事实代次)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        auto 状态 = L2状态结构内部::形成状态事实(*节点, *主体关系,
            *特征关系, *精确值, *时间值, 登记, 写入.事实代次);
        if (!状态 || 状态->主体存在 != 请求.主体存在
            || 状态->特征实例 != 请求.特征实例
            || 状态->精确值.类型化不可变材料 != 请求.精确值材料
            || 状态->时间值.类型化不可变材料 != 请求.时间值材料
            || 状态->来源稳定编码 != 请求.来源稳定编码)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const auto 当前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (当前代次.状态 != L1中性读取状态::成功
            || 当前代次.合同版本 != L1中性CRUD合同版本
            || 当前代次.事实代次 < 写入.事实代次)
            return L2状态结构内部::形成写入失败(
                L2结构状态::内部不一致, 写入.事实代次);
        const L2结构请求头 历史头{L2结构合同版本, 当前代次.事实代次};
        const auto 主体来源 = 存在服务_.读取存在身份来源({历史头,
            L2读取类别::历史, 请求.主体存在, 写入.事实代次});
        const auto 实例来源 = 特征服务_.读取特征实例身份来源({历史头,
            L2读取类别::历史, 请求.特征实例, 写入.事实代次});
        const auto 主体 = 存在服务_.读取完整存在({历史头,
            L2读取类别::历史, 请求.主体存在, 写入.事实代次});
        const auto 实例 = 特征服务_.读取完整特征实例({历史头,
            L2读取类别::历史, 请求.特征实例, 写入.事实代次});
        if (!主体来源.成功() || !主体来源.身份来源
            || !实例来源.成功() || !实例来源.身份来源
            || 主体来源.身份来源->节点稳定编码 != 请求.主体存在.值
            || 实例来源.身份来源->节点稳定编码 != 请求.特征实例.值
            || 主体.结果头.状态 != L2结构状态::已读取 || !主体.存在
            || 实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例
            || 主体.结果头.事实截止代次 != 写入.事实代次
            || 实例.结果头.事实截止代次 != 写入.事实代次
            || 主体.存在->身份 != 请求.主体存在
            || 实例.特征实例->身份 != 请求.特征实例
            || 实例.特征实例->宿主存在 != 请求.主体存在)
            return L2状态结构内部::形成写入失败(
                主体.结果头.状态 == L2结构状态::事实代次漂移
                    || 实例.结果头.状态 == L2结构状态::事实代次漂移
                    ? L2结构状态::事实代次漂移 : L2结构状态::内部不一致,
                当前代次.事实代次);
        L2状态写入结果 结果{{L2结构合同版本, 状态码,
            写入.事实代次, 写入.事实代次}, std::move(状态),
            L2状态自有关系引用{*族归属关系编码,
                *主体关系编码, *特征关系编码}};
        return 结果.成功() ? 结果 : L2状态结构内部::形成写入失败(
            L2结构状态::内部不一致, 写入.事实代次);
    }

    L2状态完整读取结果 读取当前完整状态(
        const L2状态完整读取请求& 请求,
        const L2状态结构类型登记& 登记) const {
        const auto 状态来源 = 读取状态身份来源({请求.请求头,
            L2读取类别::当前, 请求.状态, 0});
        if (!状态来源.成功() || !状态来源.身份来源)
            return L2状态结构内部::形成完整读取失败(请求,
                状态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                状态来源.结果头.事实截止代次);
        L1所有者范围一致当前读取请求 首次请求;
        首次请求.合同版本 = L1所有者范围一致当前读取合同版本;
        首次请求.期望事实代次 = 请求.请求头.期望事实代次;
        首次请求.所有者 = {状态身份来源定位_.所有者};
        首次请求.节点 = {请求.状态.值};
        首次请求.源关系组 = {
            {请求.状态.值, 状态身份来源定位_.族归属关系类型},
            {请求.状态.值, 登记.主体关系类型.值},
            {请求.状态.值, 登记.特征实例关系类型.值}};
        const auto 首次读取 = L1_.尝试读取所有者范围一致当前投影(首次请求);
        const auto 首次顶层 = L2状态结构内部::解释一致读取顶层(
            首次读取, 请求.请求头.期望事实代次);
        if (!首次顶层.成功()) return L2状态结构内部::形成完整读取失败(
            请求, 首次顶层.状态, 首次顶层.截止);
        if (首次读取.所有者.size() != 1 || 首次读取.节点.size() != 1 || !首次读取.关系.empty()
            || !首次读取.值.empty() || !首次读取.属性值.empty()
            || 首次读取.源关系组.size() != 3 || !首次读取.目标关系组.empty())
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 节点项 = L2状态结构内部::查找唯一节点项(
            首次读取, 请求.状态.值);
        if (!节点项) return L2状态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 首次顶层.截止);
        if (节点项->状态 != L1所有者范围一致当前读取项目状态::成功) {
            if (节点项->事实) return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
            return L2状态结构内部::形成完整读取失败(请求,
                L2状态结构内部::映射当前项目状态(节点项->状态), 首次顶层.截止);
        }
        if (!节点项->事实 || !L2状态结构内部::普通当前节点完整(
                *节点项->事实, 请求.状态.值, 首次顶层.截止)
            || 节点项->事实->当前属性.size() != 2)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto* 主体组 = L2状态结构内部::查找唯一源关系组(
            首次读取, 请求.状态.值, 登记.主体关系类型.值);
        const auto* 特征组 = L2状态结构内部::查找唯一源关系组(
            首次读取, 请求.状态.值, 登记.特征实例关系类型.值);
        const auto* 族归属组 = L2状态结构内部::查找唯一源关系组(
            首次读取, 请求.状态.值, 状态身份来源定位_.族归属关系类型);
        if (!族归属组 || 族归属组->成员.size() != 1
            || !主体组 || !特征组 || 主体组->成员.size() != 1
            || 特征组->成员.size() != 1)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto& 主体关系 = 主体组->成员.front().关系;
        const auto& 特征关系 = 特征组->成员.front().关系;
        if (!L2状态结构内部::普通当前节点完整(
                主体组->成员.front().对端节点, 主体关系.目标节点, 首次顶层.截止)
            || !L2状态结构内部::普通当前节点完整(
                特征组->成员.front().对端节点, 特征关系.目标节点, 首次顶层.截止))
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        const auto 主体 = 存在服务_.读取完整存在({请求.请求头,
            L2读取类别::当前, L2存在身份{主体关系.目标节点}, 0});
        const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
            L2读取类别::当前, L2特征实例身份{特征关系.目标节点}, 0});
        if (主体.结果头.状态 != L2结构状态::已读取 || !主体.存在
            || 实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例)
            return L2状态结构内部::形成完整读取失败(请求,
                主体.结果头.状态 != L2结构状态::已读取
                    ? 主体.结果头.状态 : 实例.结果头.状态,
                std::max(主体.结果头.事实截止代次, 实例.结果头.事实截止代次));
        if (主体.存在->身份.值 != 主体关系.目标节点
            || 实例.特征实例->身份.值 != 特征关系.目标节点
            || 实例.特征实例->宿主存在 != 主体.存在->身份)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 首次顶层.截止);
        L1所有者范围一致当前读取请求 完整请求 = 首次请求;
        for (const auto& 槽 : 节点项->事实->当前属性)
            完整请求.属性值.push_back({请求.状态.值, 槽.属性类型节点});
        const auto 完整读取 = L1_.尝试读取所有者范围一致当前投影(完整请求);
        const auto 完整顶层 = L2状态结构内部::解释一致读取顶层(
            完整读取, 请求.请求头.期望事实代次);
        if (!完整顶层.成功()) return L2状态结构内部::形成完整读取失败(
            请求, 完整顶层.状态, 完整顶层.截止);
        const auto* 完整节点项 = L2状态结构内部::查找唯一节点项(
            完整读取, 请求.状态.值);
        const auto* 完整主体组 = L2状态结构内部::查找唯一源关系组(
            完整读取, 请求.状态.值, 登记.主体关系类型.值);
        const auto* 完整特征组 = L2状态结构内部::查找唯一源关系组(
            完整读取, 请求.状态.值, 登记.特征实例关系类型.值);
        if (完整读取.所有者.size() != 1 || 完整读取.节点.size() != 1 || !完整读取.关系.empty()
            || !完整读取.值.empty() || 完整读取.属性值.size() != 2
            || 完整读取.源关系组.size() != 3 || !完整读取.目标关系组.empty()
            || !完整节点项 || 完整节点项->状态
                != L1所有者范围一致当前读取项目状态::成功 || !完整节点项->事实
            || *完整节点项->事实 != *节点项->事实 || !完整主体组 || !完整特征组
            || *完整主体组 != *主体组 || *完整特征组 != *特征组)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const L1所有者范围值事实* 精确值 = nullptr;
        const L1所有者范围值事实* 时间值 = nullptr;
        for (const auto& 槽 : 完整节点项->事实->当前属性) {
            const auto* 项 = L2状态结构内部::查找唯一属性项(
                完整读取, 请求.状态.值, 槽.属性类型节点);
            if (!项 || 项->状态 != L1所有者范围一致当前读取项目状态::成功
                || !项->投影 || 项->投影->属性槽 != 槽
                || 项->投影->当前值事实.编码 != 槽.当前值
                || 项->投影->当前值事实.所属节点 != 请求.状态.值
                || 项->投影->当前值事实.退出事实代次)
                return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
            const auto& 值 = 项->投影->当前值事实;
            if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) {
                if (精确值) return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                精确值 = &值;
            } else if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) {
                if (时间值) return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 完整顶层.截止);
                时间值 = &值;
            } else return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        }
        if (!精确值 || !时间值) return L2状态结构内部::形成完整读取失败(
            请求, L2结构状态::内部不一致, 完整顶层.截止);
        auto 状态 = L2状态结构内部::形成状态事实(*完整节点项->事实,
            完整主体组->成员.front().关系, 完整特征组->成员.front().关系,
            *精确值, *时间值, 登记, 完整顶层.截止);
        if (!状态 || 状态->身份 != 请求.状态)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        const auto 主体来源 = 存在服务_.读取存在身份来源({请求.请求头,
            L2读取类别::当前, 状态->主体存在, 0});
        const auto 实例来源 = 特征服务_.读取特征实例身份来源({请求.请求头,
            L2读取类别::当前, 状态->特征实例, 0});
        if (!主体来源.成功() || !实例来源.成功())
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 完整顶层.截止);
        return {{L2结构合同版本, L2结构状态::已读取, 完整顶层.截止,
            std::nullopt}, 请求.读取类别, 0, std::move(状态),
            L2状态自有关系引用{族归属组->成员.front().关系.编码,
                完整主体组->成员.front().关系.编码,
                完整特征组->成员.front().关系.编码}};
    }

    L2状态完整读取结果 读取历史完整状态(
        const L2状态完整读取请求& 请求,
        const L2状态结构类型登记& 登记) const {
        const auto 状态来源 = 读取状态身份来源({请求.请求头,
            L2读取类别::历史, 请求.状态, 请求.历史截止事实代次});
        if (!状态来源.成功() || !状态来源.身份来源)
            return L2状态结构内部::形成完整读取失败(请求,
                状态来源.结果头.状态 == L2结构状态::已读取
                    ? L2结构状态::内部不一致 : 状态来源.结果头.状态,
                状态来源.结果头.事实截止代次);
        const auto 前代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (前代次.状态 != L1中性读取状态::成功
            || 前代次.合同版本 != L1中性CRUD合同版本 || 前代次.事实代次 == 0)
            return L2状态结构内部::形成完整读取失败(请求,
                L2状态结构内部::映射事实代次探测失败(前代次.状态),
                前代次.事实代次);
        if (前代次.事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移, 前代次.事实代次);
        const auto 节点读取 = L1_.读取所有者范围历史事实(
            {L1所有者范围CRUD合同版本, 请求.状态.值});
        if (节点读取.合同版本 != L1所有者范围CRUD合同版本
            || 节点读取.查询编码 != 请求.状态.值)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点读取.状态 != L1所有者范围读取状态::成功) {
            if (节点读取.事实) return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            return L2状态结构内部::形成完整读取失败(请求,
                L2状态结构内部::映射历史读取状态(节点读取.状态),
                请求.历史截止事实代次);
        }
        const auto* 节点 = 节点读取.事实
            ? std::get_if<L1所有者范围节点事实>(&*节点读取.事实) : nullptr;
        if (!节点 || 节点->编码 != 请求.状态.值
            || 节点->种类 != 节点种类::普通 || 节点->属性类型表示)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        if (节点->创建事实代次 > 请求.历史截止事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::未找到, 请求.历史截止事实代次);
        const std::uint64_t 结构截止 = 节点->退出事实代次
                && *节点->退出事实代次 <= 请求.历史截止事实代次
            ? *节点->退出事实代次 - 1 : 请求.历史截止事实代次;
        const auto 主体组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.状态.值, 登记.主体关系类型.值,
            结构截止});
        const auto 特征组 = L1_.读取所有者范围历史关系组({L1所有者范围CRUD合同版本,
            L1所有者范围关系端点方向::源, 请求.状态.值, 登记.特征实例关系类型.值,
            结构截止});
        const auto 属性组 = L1_.读取所有者范围历史属性值组({L1所有者范围CRUD合同版本,
            请求.状态.值, 结构截止});
        if (主体组.状态 != L1所有者范围读取状态::成功
            || 特征组.状态 != L1所有者范围读取状态::成功
            || 属性组.状态 != L1所有者范围读取状态::成功) {
            const auto 状态 = 主体组.状态 != L1所有者范围读取状态::成功
                ? L2状态结构内部::映射历史关系组失败状态(主体组.状态)
                : 特征组.状态 != L1所有者范围读取状态::成功
                    ? L2状态结构内部::映射历史关系组失败状态(特征组.状态)
                    : L2状态结构内部::映射历史属性组失败状态(属性组.状态);
            return L2状态结构内部::形成完整读取失败(
                请求, 状态, std::max({主体组.读取事实代次,
                    特征组.读取事实代次, 属性组.读取事实代次}));
        }
        if (主体组.读取事实代次 != 请求.请求头.期望事实代次
            || 特征组.读取事实代次 != 请求.请求头.期望事实代次
            || 属性组.读取事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::事实代次漂移,
                std::max({主体组.读取事实代次,
                    特征组.读取事实代次, 属性组.读取事实代次}));
        if (主体组.关系组.size() != 1 || 特征组.关系组.size() != 1
            || 属性组.属性值组.size() != 2)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const L1所有者范围值事实* 精确值 = nullptr;
        const L1所有者范围值事实* 时间值 = nullptr;
        for (const auto& 值 : 属性组.属性值组) {
            if (值.所属节点 != 请求.状态.值)
                return L2状态结构内部::形成完整读取失败(
                    请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
            if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, true)) 精确值 = &值;
            else if (L2状态结构内部::状态值类型与材料一致(
                    登记, 值.属性类型节点, 值.材料, false)) 时间值 = &值;
            else return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        }
        if (!精确值 || !时间值)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        const auto& 主体关系 = 主体组.关系组.front();
        const auto& 特征关系 = 特征组.关系组.front();
        const auto 主体 = 存在服务_.读取完整存在({请求.请求头,
            L2读取类别::历史, L2存在身份{主体关系.目标节点},
            请求.历史截止事实代次});
        const auto 实例 = 特征服务_.读取完整特征实例({请求.请求头,
            L2读取类别::历史, L2特征实例身份{特征关系.目标节点},
            请求.历史截止事实代次});
        if (主体.结果头.状态 != L2结构状态::已读取 || !主体.存在
            || 实例.结果头.状态 != L2结构状态::已读取 || !实例.特征实例
            || 实例.特征实例->宿主存在 != 主体.存在->身份)
            return L2状态结构内部::形成完整读取失败(请求,
                主体.结果头.状态 != L2结构状态::已读取
                    ? 主体.结果头.状态 : 实例.结果头.状态,
                请求.历史截止事实代次);
        const auto 后代次 = L1_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (后代次.状态 != L1中性读取状态::成功
            || 后代次.合同版本 != L1中性CRUD合同版本
            || 后代次.事实代次 != 请求.请求头.期望事实代次)
            return L2状态结构内部::形成完整读取失败(
                请求, 后代次.状态 == L1中性读取状态::成功
                    ? L2结构状态::事实代次漂移
                    : L2状态结构内部::映射事实代次探测失败(后代次.状态),
                后代次.事实代次);
        auto 状态 = L2状态结构内部::形成状态事实(*节点, 主体关系,
            特征关系, *精确值, *时间值, 登记, 请求.历史截止事实代次);
        if (!状态 || 状态->身份 != 请求.状态)
            return L2状态结构内部::形成完整读取失败(
                请求, L2结构状态::内部不一致, 请求.历史截止事实代次);
        return {{L2结构合同版本, L2结构状态::已读取,
            请求.历史截止事实代次, std::nullopt}, 请求.读取类别,
            请求.历史截止事实代次, std::move(状态),
            L2状态自有关系引用{状态来源.身份来源->族归属关系稳定编码,
                主体关系.编码, 特征关系.编码}};
    }

    L2当前状态组读取结果 按端点读取状态组(
        const L2结构请求头& 请求头, 稳定编码 端点, bool 主体条件,
        std::uint64_t 最大数量) const {
        const auto 登记结果 = 读取当前状态结构类型登记();
        if (登记结果.状态 != L2状态结构类型登记状态::已读取
            || !登记结果.登记 || !登记结果.成功())
            return L2状态结构内部::形成组读取失败(
                L2状态结构内部::映射登记失败为结构状态(登记结果.状态),
                登记结果.事实截止代次);
        const auto 关系类型 = 主体条件 ? 登记结果.登记->主体关系类型.值
            : 登记结果.登记->特征实例关系类型.值;
        L1所有者范围一致当前读取请求 请求;
        请求.合同版本 = L1所有者范围一致当前读取合同版本;
        请求.期望事实代次 = 请求头.期望事实代次;
        请求.所有者 = {状态身份来源定位_.所有者};
        请求.目标关系组 = {{端点, 关系类型}};
        const auto 读取 = L1_.尝试读取所有者范围一致当前投影(请求);
        const auto 顶层 = L2状态结构内部::解释一致读取顶层(
            读取, 请求头.期望事实代次);
        if (!顶层.成功()) return L2状态结构内部::形成组读取失败(
            顶层.状态, 顶层.截止);
        const auto* 关系组 = L2状态结构内部::查找唯一目标关系组(
            读取, 端点, 关系类型);
        if (读取.所有者.size() != 1 || !读取.节点.empty()
            || !读取.关系.empty() || !读取.值.empty()
            || !读取.属性值.empty() || !读取.源关系组.empty()
            || 读取.目标关系组.size() != 1 || !关系组
            || 读取.所有者.front().状态
                != L1所有者范围一致当前读取项目状态::成功
            || !读取.所有者.front().所有者事实)
            return L2状态结构内部::形成组读取失败(
                L2结构状态::内部不一致, 顶层.截止);
        std::vector<稳定编码> 状态编码组;
        for (const auto& 成员 : 关系组->成员) {
            const auto& 关系 = 成员.关系;
            if (关系.目标节点 != 端点 || 关系.关系类型节点 != 关系类型
                || 关系.角色或顺序 != L2状态结构内部::状态端点角色值
                || 关系.退出事实代次
                || !L2状态结构内部::普通当前节点完整(
                    成员.对端节点, 关系.源节点, 顶层.截止)
                || 关系.写入所有者 != 状态身份来源定位_.所有者
                || 成员.对端节点.写入所有者 != 状态身份来源定位_.所有者
                || std::find(状态编码组.begin(), 状态编码组.end(),
                    关系.源节点) != 状态编码组.end())
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            状态编码组.push_back(关系.源节点);
        }
        std::sort(状态编码组.begin(), 状态编码组.end());
        if (状态编码组.size() > 最大数量)
            return L2状态结构内部::形成组读取失败(
                L2结构状态::数量预算不足, 顶层.截止);
        L2当前状态组读取结果 结果{{L2结构合同版本, L2结构状态::已读取,
            顶层.截止, std::nullopt}, {}};
        结果.状态.reserve(状态编码组.size());
        for (const auto 编码 : 状态编码组) {
            const auto 单项 = 读取完整状态({请求头, L2读取类别::当前,
                L2状态身份{编码}, 0});
            if (单项.结果头.状态 != L2结构状态::已读取 || !单项.状态
                || 单项.结果头.事实截止代次 != 顶层.截止)
                return L2状态结构内部::形成组读取失败(
                    单项.结果头.状态 == L2结构状态::已读取
                        ? L2结构状态::内部不一致 : 单项.结果头.状态,
                    单项.结果头.事实截止代次);
            if ((主体条件 && 单项.状态->主体存在.值 != 端点)
                || (!主体条件 && 单项.状态->特征实例.值 != 端点))
                return L2状态结构内部::形成组读取失败(
                    L2结构状态::内部不一致, 顶层.截止);
            结果.状态.push_back(*单项.状态);
        }
        return 结果.成功() ? 结果 : L2状态结构内部::形成组读取失败(
            L2结构状态::内部不一致, 顶层.截止);
    }

    const L1事实基座服务& L1_;
    const L2存在结构服务& 存在服务_;
    const L2特征结构服务& 特征服务_;
    L1所有者范围写端口 第一层写入端口_;
    L2状态结构内部::状态身份来源定位 状态身份来源定位_;
    std::optional<L2状态结构类型登记> 结构类型登记定位_;
};

} // namespace 海中鱼巣
