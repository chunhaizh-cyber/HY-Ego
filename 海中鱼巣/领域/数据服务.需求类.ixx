namespace 海中鱼巣::需求类数据内部 {

inline constexpr L1所有者范围写集本地键 记录本地键{1};
inline constexpr L1所有者范围写集本地键 所属存在关系本地键{2};
inline constexpr L1所有者范围写集本地键 目标宿主关系本地键{3};
inline constexpr L1所有者范围写集本地键 静态目标特征关系本地键{4};
inline constexpr L1所有者范围写集本地键 方向二次特征关系本地键{5};

std::optional<稳定编码> 查找唯一编码(const L1所有者范围写入结果& 结果,
    L1所有者范围写集本地键 本地键) noexcept {
    std::optional<稳定编码> 找到;
    for (const auto& [键, 编码] : 结果.新编码映射) {
        if (键 != 本地键) continue;
        if (找到 || !有效(编码)) return std::nullopt;
        找到 = 编码;
    }
    return 找到;
}

} // namespace 海中鱼巣::需求类数据内部

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 需求类数据合同版本 = 1;

enum class 需求类数据状态 : std::uint8_t {
    已创建=1, 精确重复=2, 已读取=3, 已计算=4, 入口拒绝=5,
    未找到=6, 所属存在未找到=7, 所属存在已退出=8,
    目标宿主未找到=9, 目标宿主已退出=10,
    静态目标特征未找到=11, 静态目标特征已退出=12,
    当前事实特征未找到=13, 当前事实特征已退出=14,
    目标特征不属于宿主=15, 当前特征不属于宿主=16,
    方向定义未找到=17, 方向定义已退出=18, 方向定义不匹配=19,
    目标不是一阶I64静态特征=20, 当前不是一阶I64特征=21,
    精确目标已存在=22, 数量预算不足=23, 事实代次漂移=24,
    幂等冲突=25, 引用冲突=26, 资源失败=27,
    内部不一致=28, 已可能发布=29, 方向格式不支持=30,
    方向来源不匹配=31, 方向比较失败=32, 方向历史材料不可用=33
};

struct 需求类结构类型 final {
    稳定编码 所属存在关系类型{};
    稳定编码 目标宿主关系类型{};
    稳定编码 静态目标特征关系类型{};
    稳定编码 方向二次特征关系类型{};
    friend bool operator==(const 需求类结构类型&,
        const 需求类结构类型&) = default;
};

struct 需求类记录身份 final {
    稳定编码 值{};
    friend bool operator==(const 需求类记录身份&,
        const 需求类记录身份&) = default;
};

struct 需求类记录 final {
    需求类记录身份 身份;
    稳定编码 所属存在{};
    稳定编码 目标宿主{};
    稳定编码 静态目标特征{};
    特征类定义身份 方向二次特征;
    稳定编码 所属存在关系{};
    稳定编码 目标宿主关系{};
    稳定编码 静态目标特征关系{};
    稳定编码 方向二次特征关系{};
    std::uint64_t 创建事实代次 = 0;
    friend bool operator==(const 需求类记录&, const 需求类记录&) = default;
};

struct 需求类新增请求 final {
    std::uint32_t 合同版本 = 需求类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    L1所有者范围写入幂等身份 幂等身份{};
    稳定编码 所属存在{};
    稳定编码 目标宿主{};
    稳定编码 静态目标特征{};
    特征类定义身份 方向二次特征;
    friend bool operator==(const 需求类新增请求&,
        const 需求类新增请求&) = default;
};

struct 需求类身份查询请求 final {
    std::uint32_t 合同版本 = 需求类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    需求类记录身份 需求;
    friend bool operator==(const 需求类身份查询请求&,
        const 需求类身份查询请求&) = default;
};

struct 需求类精确查询请求 final {
    std::uint32_t 合同版本 = 需求类数据合同版本;
    std::uint64_t 期望事实代次 = 0;
    稳定编码 所属存在{};
    稳定编码 目标宿主{};
    稳定编码 静态目标特征{};
    特征类定义身份 方向二次特征;
    std::uint64_t 最大候选数量 = 0;
    friend bool operator==(const 需求类精确查询请求&,
        const 需求类精确查询请求&) = default;
};

inline bool 需求类记录闭合(const 需求类记录& 记录) noexcept {
    return 有效(记录.身份.值) && 有效(记录.所属存在)
        && 有效(记录.目标宿主) && 有效(记录.静态目标特征)
        && 有效(记录.方向二次特征.结点) && 有效(记录.所属存在关系)
        && 有效(记录.目标宿主关系) && 有效(记录.静态目标特征关系)
        && 有效(记录.方向二次特征关系) && 记录.创建事实代次 != 0;
}

struct 需求类记录结果 final {
    需求类数据状态 状态 = 需求类数据状态::入口拒绝;
    std::uint32_t 合同版本 = 需求类数据合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<需求类记录> 记录;
    bool 成功() const noexcept {
        return (状态 == 需求类数据状态::已创建
                || 状态 == 需求类数据状态::精确重复
                || 状态 == 需求类数据状态::已读取)
            && 合同版本 == 需求类数据合同版本 && 事实代次 != 0
            && 记录 && 需求类记录闭合(*记录);
    }
    friend bool operator==(const 需求类记录结果&,
        const 需求类记录结果&) = default;
};

inline constexpr std::uint32_t 需求类标量方向合同版本 = 1;

struct 需求类标量方向读取请求 final {
    std::uint32_t 版本 = 需求类标量方向合同版本;
    std::uint64_t G = 0;
    std::uint64_t 请求身份 = 0;
    需求类记录身份 需求;
    稳定编码 当前F{};
    std::uint8_t 要求结果位 = 0;
    特征类派生读取预算 派生预算;
    friend bool operator==(const 需求类标量方向读取请求&,
        const 需求类标量方向读取请求&) = default;
};

struct 需求类标量方向读取结果 final {
    需求类数据状态 状态 = 需求类数据状态::入口拒绝;
    std::uint32_t 版本 = 需求类标量方向合同版本;
    std::uint64_t G = 0;
    需求类记录身份 需求;
    稳定编码 当前F{};
    稳定编码 目标F{};
    特征类定义身份 方向定义;
    std::optional<特征类标量比较结果> 比较;
    bool 成功() const noexcept {
        return 状态 == 需求类数据状态::已计算
            && 版本 == 需求类标量方向合同版本 && G != 0
            && 有效(需求.值) && 有效(当前F)
            && 有效(目标F) && 有效(方向定义.结点)
            && 比较 && 比较->成功() && 比较->G == G
            && 比较->根定义 == 方向定义;
    }
};

class 需求类数据服务 final {
public:
    需求类数据服务() = delete;
    需求类数据服务(const 需求类数据服务&) = delete;
    需求类数据服务& operator=(const 需求类数据服务&) = delete;
    需求类数据服务(需求类数据服务&&) = delete;
    需求类数据服务& operator=(需求类数据服务&&) = delete;

    需求类数据服务(const L1事实基座服务& 第一层服务,
        const 特征类数据服务& 特征服务,
        const 存在类数据服务& 存在服务,
        const 二次特征类数据服务& 二次特征服务,
        L1所有者范围写端口&& 写入端口,
        需求类结构类型 结构类型)
        : 第一层服务_(第一层服务), 特征服务_(特征服务),
          存在服务_(存在服务), 二次特征服务_(二次特征服务),
          写入端口_(std::move(写入端口)),
          所有者_(写入端口_.所有者身份()), 结构类型_(结构类型) {
        const std::vector<稳定编码> 类型组{结构类型_.所属存在关系类型,
            结构类型_.目标宿主关系类型, 结构类型_.静态目标特征关系类型,
            结构类型_.方向二次特征关系类型};
        if (!写入端口_.有效() || !写入端口_.绑定于(第一层服务_)
            || !特征服务_.绑定于(第一层服务_)
            || !存在服务_.绑定于(第一层服务_)
            || !有效(所有者_) || std::any_of(类型组.begin(), 类型组.end(),
                [](稳定编码 值) noexcept { return !有效(值); }))
            throw std::invalid_argument("invalid demand data configuration");
        auto 排序 = 类型组;
        std::sort(排序.begin(), 排序.end());
        if (std::adjacent_find(排序.begin(), 排序.end()) != 排序.end())
            throw std::invalid_argument("duplicate demand relation types");
        const auto 所有者 = 第一层服务_.读取当前结构所有者(
            {L1所有者范围CRUD合同版本, 所有者_});
        if (所有者.状态 != L1所有者范围读取状态::成功
            || 所有者.合同版本 != L1所有者范围CRUD合同版本
            || !所有者.所有者事实 || 所有者.所有者事实->所有者 != 所有者_
            || 所有者.所有者事实->范围种类 != L1所有者范围种类::独占结构范围
            || 所有者.所有者事实->退出事实代次)
            throw std::invalid_argument("invalid demand data owner");
        for (const auto 类型 : 类型组) {
            const auto 读取 = 第一层服务_.读取所有者范围当前节点(
                {L1所有者范围CRUD合同版本, 类型});
            const auto* 节点 = 读取.事实
                ? std::get_if<L1所有者范围节点事实>(&*读取.事实) : nullptr;
            if (读取.状态 != L1所有者范围读取状态::成功
                || 读取.合同版本 != L1所有者范围CRUD合同版本
                || !节点 || 节点->编码 != 类型 || 节点->写入所有者 != 所有者_
                || 节点->种类 != 节点种类::普通 || 节点->属性类型表示
                || 节点->退出事实代次 || !节点->当前属性.empty())
                throw std::invalid_argument("invalid demand relation type");
        }
    }

    需求类记录结果 新增需求记录(const 需求类新增请求& 请求) {
        if (!新增请求有效(请求)) return 记录失败(需求类数据状态::入口拒绝);
        try {
            const auto 当前代次 = 读取当前代次();
            if (!当前代次 || *当前代次 != 请求.期望事实代次)
                return 记录失败(需求类数据状态::事实代次漂移,
                    当前代次.value_or(0));
            const auto 写集 = 形成写集(请求);
            if (const auto 重放 = 尝试重放(请求, 写集)) return *重放;
            if (const auto 端点失败 = 验证端点(请求.期望事实代次,
                    请求.所属存在, 请求.目标宿主, 请求.静态目标特征,
                    请求.方向二次特征))
                return 记录失败(*端点失败, 请求.期望事实代次);
            const auto 已有 = 按所属存在和目标精确查询({需求类数据合同版本,
                请求.期望事实代次, 请求.所属存在, 请求.目标宿主,
                请求.静态目标特征, 请求.方向二次特征,
                std::numeric_limits<std::uint64_t>::max()});
            if (已有.成功()) return {需求类数据状态::精确目标已存在,
                需求类数据合同版本, 已有.事实代次, 已有.记录};
            if (已有.状态 != 需求类数据状态::未找到) return 已有;
            const auto 写入 = 写入端口_.提交所有者范围中性写集(写集);
            const auto 状态 = 映射写入状态(写入.状态);
            if (状态 != 需求类数据状态::已创建
                && 状态 != 需求类数据状态::精确重复)
                return 记录失败(状态, 写入.事实代次);
            if (!写入头完整(写入, 请求.幂等身份))
                return 记录失败(写入.是否形成内存权威发布
                    ? 需求类数据状态::已可能发布
                    : 需求类数据状态::内部不一致, 写入.事实代次);
            return 从写入读回(写入, 请求, 状态);
        } catch (const std::bad_alloc&) {
            return 记录失败(需求类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 记录失败(需求类数据状态::资源失败);
        } catch (...) {
            return 记录失败(需求类数据状态::内部不一致);
        }
    }

    需求类记录结果 查询需求记录(const 需求类身份查询请求& 请求) const {
        if (请求.合同版本 != 需求类数据合同版本
            || 请求.期望事实代次 == 0 || !有效(请求.需求.值))
            return 记录失败(需求类数据状态::入口拒绝);
        try {
            const auto 前代次 = 读取当前代次();
            if (!前代次 || *前代次 != 请求.期望事实代次)
                return 记录失败(需求类数据状态::事实代次漂移,
                    前代次.value_or(0));
            L1所有者范围一致当前读取请求 读取请求;
            读取请求.合同版本 = L1所有者范围一致当前读取合同版本;
            读取请求.期望事实代次 = 请求.期望事实代次;
            读取请求.所有者 = {所有者_};
            读取请求.节点 = {请求.需求.值};
            读取请求.源关系组 = {
                {请求.需求.值, 结构类型_.所属存在关系类型},
                {请求.需求.值, 结构类型_.目标宿主关系类型},
                {请求.需求.值, 结构类型_.静态目标特征关系类型},
                {请求.需求.值, 结构类型_.方向二次特征关系类型}};
            const auto 读取 = 第一层服务_.尝试读取所有者范围一致当前投影(读取请求);
            if (读取.状态 != L1所有者范围一致当前读取状态::成功)
                return 记录失败(映射一致读取状态(读取.状态), 读取.读取事实代次);
            if (读取.合同版本 != L1所有者范围一致当前读取合同版本
                || 读取.期望事实代次 != 请求.期望事实代次
                || 读取.读取事实代次 != 请求.期望事实代次
                || 读取.所有者.size() != 1 || 读取.节点.size() != 1
                || 读取.源关系组.size() != 4 || !读取.关系.empty()
                || !读取.值.empty() || !读取.属性值.empty()
                || !读取.目标关系组.empty()
                || 读取.所有者.front().状态
                    != L1所有者范围一致当前读取项目状态::成功
                || !读取.所有者.front().所有者事实
                || 读取.所有者.front().所有者事实->所有者 != 所有者_)
                return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
            const auto& 节点项 = 读取.节点.front();
            if (节点项.状态 == L1所有者范围一致当前读取项目状态::未找到
                || 节点项.状态 == L1所有者范围一致当前读取项目状态::已退出)
                return 记录失败(需求类数据状态::未找到, 读取.读取事实代次);
            if (节点项.状态 != L1所有者范围一致当前读取项目状态::成功
                || !节点项.事实)
                return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
            const auto& 节点 = *节点项.事实;
            if (节点.写入所有者 != 所有者_)
                return 记录失败(需求类数据状态::未找到, 读取.读取事实代次);
            if (节点.编码 != 请求.需求.值 || 节点.种类 != 节点种类::普通
                || 节点.属性类型表示 || 节点.退出事实代次
                || !节点.当前属性.empty() || 节点.创建事实代次 == 0)
                return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
            需求类记录 记录;
            记录.身份 = 请求.需求;
            记录.创建事实代次 = 节点.创建事实代次;
            if (std::any_of(读取.源关系组.begin(), 读取.源关系组.end(),
                    [&请求](const auto& 项) noexcept {
                        return 项.源节点 != 请求.需求.值;
                    }))
                return 记录失败(需求类数据状态::内部不一致,
                    读取.读取事实代次);
            if (!提取关系(读取.源关系组, 结构类型_.所属存在关系类型,
                    记录.所属存在, 记录.所属存在关系, 节点.创建事实代次)
                || !提取关系(读取.源关系组, 结构类型_.目标宿主关系类型,
                    记录.目标宿主, 记录.目标宿主关系, 节点.创建事实代次)
                || !提取关系(读取.源关系组, 结构类型_.静态目标特征关系类型,
                    记录.静态目标特征, 记录.静态目标特征关系, 节点.创建事实代次))
                return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
            稳定编码 方向{};
            if (!提取关系(读取.源关系组, 结构类型_.方向二次特征关系类型,
                    方向, 记录.方向二次特征关系, 节点.创建事实代次))
                return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
            记录.方向二次特征 = {方向};
            if (const auto 端点失败 = 验证端点(请求.期望事实代次,
                    记录.所属存在, 记录.目标宿主, 记录.静态目标特征,
                    记录.方向二次特征, true))
                return 记录失败(*端点失败, 请求.期望事实代次);
            const auto 后代次 = 读取当前代次();
            if (!后代次 || *后代次 != 请求.期望事实代次)
                return 记录失败(需求类数据状态::事实代次漂移,
                    后代次.value_or(0));
            return {需求类数据状态::已读取, 需求类数据合同版本,
                请求.期望事实代次, std::move(记录)};
        } catch (const std::bad_alloc&) {
            return 记录失败(需求类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 记录失败(需求类数据状态::资源失败);
        } catch (...) {
            return 记录失败(需求类数据状态::内部不一致);
        }
    }

    需求类记录结果 按所属存在和目标精确查询(
        const 需求类精确查询请求& 请求) const {
        if (!精确查询请求有效(请求)) return 记录失败(需求类数据状态::入口拒绝);
        try {
            const auto 当前代次 = 读取当前代次();
            if (!当前代次 || *当前代次 != 请求.期望事实代次)
                return 记录失败(需求类数据状态::事实代次漂移,
                    当前代次.value_or(0));
            if (const auto 端点失败 = 验证端点(请求.期望事实代次,
                    请求.所属存在, 请求.目标宿主, 请求.静态目标特征,
                    请求.方向二次特征, true))
                return 记录失败(*端点失败, 请求.期望事实代次);
            const std::vector<std::pair<稳定编码, 稳定编码>> 端点{
                {请求.所属存在, 结构类型_.所属存在关系类型},
                {请求.目标宿主, 结构类型_.目标宿主关系类型},
                {请求.静态目标特征, 结构类型_.静态目标特征关系类型},
                {请求.方向二次特征.结点, 结构类型_.方向二次特征关系类型}};
            std::optional<std::set<std::uint64_t>> 交集;
            for (const auto& [目标, 类型] : 端点) {
                const auto 读取 = 第一层服务_.读取所有者范围当前目标关系组(
                    {L1所有者范围CRUD合同版本, 目标, 类型});
                if (读取.读取事实代次 != 请求.期望事实代次)
                    return 记录失败(需求类数据状态::事实代次漂移, 读取.读取事实代次);
                if (读取.状态 != L1所有者范围读取状态::成功)
                    return 记录失败(映射L1读取状态(读取.状态), 读取.读取事实代次);
                if (读取.合同版本 != L1所有者范围CRUD合同版本
                    || 读取.目标节点 != 目标 || 读取.关系类型节点 != 类型)
                    return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
                if (读取.关系组.size() > 请求.最大候选数量)
                    return 记录失败(需求类数据状态::数量预算不足, 读取.读取事实代次);
                std::set<std::uint64_t> 当前组;
                for (const auto& 关系 : 读取.关系组) {
                    if (!关系有效(关系, 关系.源节点, 目标, 类型, std::nullopt))
                        return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
                    if (!当前组.insert(关系.源节点.值).second)
                        return 记录失败(需求类数据状态::内部不一致, 读取.读取事实代次);
                }
                if (!交集) 交集 = std::move(当前组);
                else {
                    std::set<std::uint64_t> 新交集;
                    std::set_intersection(交集->begin(), 交集->end(), 当前组.begin(),
                        当前组.end(), std::inserter(新交集, 新交集.end()));
                    交集 = std::move(新交集);
                }
            }
            if (!交集 || 交集->empty())
                return 记录失败(需求类数据状态::未找到, 请求.期望事实代次);
            if (交集->size() != 1)
                return 记录失败(需求类数据状态::内部不一致, 请求.期望事实代次);
            auto 结果 = 查询需求记录({需求类数据合同版本,
                请求.期望事实代次, {{*交集->begin()}}});
            if (!结果.成功() || !结果.记录) return 结果;
            if (结果.记录->所属存在 != 请求.所属存在
                || 结果.记录->目标宿主 != 请求.目标宿主
                || 结果.记录->静态目标特征 != 请求.静态目标特征
                || 结果.记录->方向二次特征 != 请求.方向二次特征)
                return 记录失败(需求类数据状态::内部不一致, 结果.事实代次);
            return 结果;
        } catch (const std::bad_alloc&) {
            return 记录失败(需求类数据状态::资源失败);
        } catch (const std::length_error&) {
            return 记录失败(需求类数据状态::资源失败);
        } catch (...) {
            return 记录失败(需求类数据状态::内部不一致);
        }
    }

    需求类标量方向读取结果 计算临时需求方向(
        const 需求类标量方向读取请求& 请求) const {
        if (请求.版本 != 需求类标量方向合同版本
            || 请求.G == 0 || 请求.请求身份 == 0
            || !有效(请求.需求.值) || !有效(请求.当前F)
            || 请求.要求结果位 == 0 || 请求.要求结果位 > 7
            || !请求.派生预算.有效())
            return 方向失败(需求类数据状态::入口拒绝, 请求);
        try {
            const auto 记录结果 = 查询需求记录({需求类数据合同版本,
                请求.G, 请求.需求});
            if (!记录结果.成功() || !记录结果.记录)
                return 方向失败(记录结果.状态, 请求, 记录结果.事实代次);
            const auto& 记录 = *记录结果.记录;
            const auto 宿主 = 查询存在(记录.目标宿主, 请求.G,
                需求类数据状态::目标宿主未找到,
                需求类数据状态::目标宿主已退出);
            if (!宿主.成功) return 方向失败(宿主.状态, 请求, 宿主.事实代次, &记录);
            const auto 当前 = 查询I64特征(请求.当前F, 请求.G, false);
            if (!当前.成功) return 方向失败(当前.状态, 请求, 当前.事实代次, &记录);
            const auto 目标 = 查询I64特征(记录.静态目标特征, 请求.G, true);
            if (!目标.成功) return 方向失败(目标.状态, 请求, 目标.事实代次, &记录);
            if (!宿主含唯一特征(*宿主.结点, 请求.当前F))
                return 方向失败(需求类数据状态::当前特征不属于宿主,
                    请求, 请求.G, &记录);
            const auto 采用 = 存在服务_.读取当前采用(
                {1, 请求.G, 请求.G, 记录.目标宿主, 当前.结点->信息.类型,
                    请求.派生预算.最大关系数});
            if (!采用.成功()) {
                const auto 状态 = 采用.状态 == 存在类数据状态::事实代次漂移
                    ? 需求类数据状态::事实代次漂移
                    : 采用.状态 == 存在类数据状态::资源失败
                    ? 需求类数据状态::资源失败 : 需求类数据状态::方向来源不匹配;
                return 方向失败(状态, 请求, 请求.G, &记录);
            }
            if (采用.状态 != 存在类数据状态::已读取 || 采用.Gread != 请求.G || 采用.H != 请求.G)
                return 方向失败(需求类数据状态::内部不一致, 请求, 请求.G, &记录);
            if (!采用.采用 || 采用.采用->E != 记录.目标宿主
                || 采用.采用->FT != 当前.结点->信息.类型 || 采用.采用->F.编码 != 请求.当前F)
                return 方向失败(需求类数据状态::方向来源不匹配, 请求, 请求.G, &记录);
            const auto 定义 = 查询方向定义(记录.方向二次特征, 请求.G,
                *宿主.结点, 记录.静态目标特征, 请求.派生预算);
            if (!定义.成功) return 方向失败(定义.状态, 请求, 定义.事实代次, &记录);
            const auto& 材料 = *定义.材料;
            if (std::find(材料.左叶组.begin(), 材料.左叶组.end(), 请求.当前F)
                    == 材料.左叶组.end())
                return 方向失败(需求类数据状态::方向来源不匹配, 请求, 请求.G, &记录);
            const auto& 合同 = 材料.定义事实->注册;
            二次标量特征计算请求 计算;
            计算.比较请求 = {标量派生合同版本, 请求.G, 请求.请求身份,
                记录.方向二次特征, 合同.用途, 合同.算法版本,
                请求.要求结果位, 请求.派生预算};
            auto 比较 = 二次特征服务_.计算二次特征(计算);
            if (!比较.成功())
                return 方向失败(映射标量状态(比较.状态), 请求, 比较.G, &记录);
            if (!比较互证(比较, 计算.比较请求, 材料))
                return 方向失败(需求类数据状态::内部不一致, 请求, 比较.G, &记录);
            const auto 后代次 = 读取当前代次();
            if (!后代次 || *后代次 != 请求.G)
                return 方向失败(需求类数据状态::事实代次漂移,
                    请求, 后代次.value_or(0), &记录);
            return {需求类数据状态::已计算, 需求类标量方向合同版本,
                请求.G, 请求.需求, 请求.当前F,
                记录.静态目标特征, 记录.方向二次特征, std::move(比较)};
        } catch (const std::bad_alloc&) {
            return 方向失败(需求类数据状态::资源失败, 请求);
        } catch (const std::length_error&) {
            return 方向失败(需求类数据状态::资源失败, 请求);
        } catch (...) {
            return 方向失败(需求类数据状态::内部不一致, 请求);
        }
    }

private:
    struct 存在读取值 { bool 成功=false; 需求类数据状态 状态=需求类数据状态::内部不一致;
        std::uint64_t 事实代次=0; std::optional<存在类结点> 结点; };
    struct 特征读取值 { bool 成功=false; 需求类数据状态 状态=需求类数据状态::内部不一致;
        std::uint64_t 事实代次=0; std::optional<准确特征读取事实> 结点;
        std::optional<std::int64_t> I64; };
    struct 方向读取值 { bool 成功=false; 需求类数据状态 状态=需求类数据状态::内部不一致;
        std::uint64_t 事实代次=0; std::optional<特征类标量派生读取结果> 材料; };

    std::optional<std::uint64_t> 读取当前代次() const noexcept {
        const auto 读取 = 第一层服务_.读取中性当前事实代次({L1中性CRUD合同版本});
        if (读取.状态 != L1中性读取状态::成功
            || 读取.合同版本 != L1中性CRUD合同版本 || 读取.事实代次 == 0)
            return std::nullopt;
        return 读取.事实代次;
    }

    static bool 新增请求有效(const 需求类新增请求& 请求) noexcept {
        return 请求.合同版本 == 需求类数据合同版本
            && 请求.期望事实代次 != 0 && 有效(请求.幂等身份)
            && 有效(请求.所属存在) && 有效(请求.目标宿主)
            && 有效(请求.静态目标特征) && 有效(请求.方向二次特征.结点);
    }

    static bool 精确查询请求有效(const 需求类精确查询请求& 请求) noexcept {
        return 请求.合同版本 == 需求类数据合同版本
            && 请求.期望事实代次 != 0 && 请求.最大候选数量 != 0
            && 有效(请求.所属存在) && 有效(请求.目标宿主)
            && 有效(请求.静态目标特征) && 有效(请求.方向二次特征.结点);
    }

    L1所有者范围写集请求 形成写集(const 需求类新增请求& 请求) const {
        using namespace 需求类数据内部;
        L1所有者范围写集请求 写集;
        写集.合同版本 = L1所有者范围CRUD合同版本;
        写集.期望事实代次 = 请求.期望事实代次;
        写集.写入幂等身份 = 请求.幂等身份;
        写集.节点 = {{记录本地键, 节点种类::普通, std::nullopt}};
        写集.关系 = {
            {所属存在关系本地键, 记录本地键, 请求.所属存在,
                结构类型_.所属存在关系类型, 0},
            {目标宿主关系本地键, 记录本地键, 请求.目标宿主,
                结构类型_.目标宿主关系类型, 0},
            {静态目标特征关系本地键, 记录本地键, 请求.静态目标特征,
                结构类型_.静态目标特征关系类型, 0},
            {方向二次特征关系本地键, 记录本地键, 请求.方向二次特征.结点,
                结构类型_.方向二次特征关系类型, 0}};
        return 写集;
    }

    std::optional<需求类记录结果> 尝试重放(const 需求类新增请求& 请求,
        const L1所有者范围写集请求& 写集) const {
        const auto 首次 = 写入端口_.读取首次写入材料(
            {L1所有者范围首次写入读取合同版本, 请求.幂等身份});
        if (首次.状态 == L1所有者范围读取状态::未找到) return std::nullopt;
        if (首次.状态 != L1所有者范围读取状态::成功)
            return 记录失败(映射L1读取状态(首次.状态), 首次.读取事实代次);
        if (首次.合同版本 != L1所有者范围首次写入读取合同版本
            || 首次.所有者 != 所有者_ || 首次.写入幂等身份 != 请求.幂等身份
            || !首次.首次规范化写集 || !首次.首次写入结果)
            return 记录失败(需求类数据状态::内部不一致, 首次.读取事实代次);
        if (*首次.首次规范化写集 != 写集)
            return 记录失败(需求类数据状态::幂等冲突, 首次.读取事实代次);
        if (!写入头完整(*首次.首次写入结果, 请求.幂等身份))
            return 记录失败(需求类数据状态::内部不一致, 首次.读取事实代次);
        return 从写入读回(*首次.首次写入结果, 请求,
            需求类数据状态::精确重复);
    }

    需求类记录结果 从写入读回(const L1所有者范围写入结果& 写入,
        const 需求类新增请求& 请求, 需求类数据状态 返回状态) const {
        using namespace 需求类数据内部;
        if (写入.新编码映射.size() != 5)
            return 记录失败(写入.是否形成内存权威发布
                ? 需求类数据状态::已可能发布
                : 需求类数据状态::内部不一致, 写入.事实代次);
        const auto 记录编码 = 查找唯一编码(写入, 记录本地键);
        const auto r2 = 查找唯一编码(写入, 所属存在关系本地键);
        const auto r3 = 查找唯一编码(写入, 目标宿主关系本地键);
        const auto r4 = 查找唯一编码(写入, 静态目标特征关系本地键);
        const auto r5 = 查找唯一编码(写入, 方向二次特征关系本地键);
        if (!记录编码 || !r2 || !r3 || !r4 || !r5)
            return 记录失败(写入.是否形成内存权威发布
                ? 需求类数据状态::已可能发布
                : 需求类数据状态::内部不一致, 写入.事实代次);
        auto 读回 = 查询需求记录({需求类数据合同版本,
            写入.事实代次, {*记录编码}});
        if (!读回.成功() || !读回.记录
            || 读回.记录->所属存在 != 请求.所属存在
            || 读回.记录->目标宿主 != 请求.目标宿主
            || 读回.记录->静态目标特征 != 请求.静态目标特征
            || 读回.记录->方向二次特征 != 请求.方向二次特征
            || 读回.记录->所属存在关系 != *r2
            || 读回.记录->目标宿主关系 != *r3
            || 读回.记录->静态目标特征关系 != *r4
            || 读回.记录->方向二次特征关系 != *r5
            || 读回.记录->创建事实代次 != 写入.事实代次)
            return 记录失败(写入.是否形成内存权威发布
                ? 需求类数据状态::已可能发布
                : 需求类数据状态::内部不一致, 写入.事实代次);
        读回.状态 = 返回状态;
        return 读回;
    }

    std::optional<需求类数据状态> 验证端点(std::uint64_t G0,
        稳定编码 所属存在, 稳定编码 目标宿主, 稳定编码 静态目标特征,
        特征类定义身份 方向, bool 允许旧治理 = false) const {
        const auto 所属 = 查询存在(所属存在, G0,
            需求类数据状态::所属存在未找到, 需求类数据状态::所属存在已退出);
        if (!所属.成功) return 所属.状态;
        const auto 宿主 = 查询存在(目标宿主, G0,
            需求类数据状态::目标宿主未找到, 需求类数据状态::目标宿主已退出);
        if (!宿主.成功) return 宿主.状态;
        const auto 目标 = 查询I64特征(静态目标特征, G0, true);
        if (!目标.成功) return 目标.状态;
        if (!宿主含唯一特征(*宿主.结点, 静态目标特征))
            return 需求类数据状态::目标特征不属于宿主;
        const auto 定义 = 查询方向定义(方向, G0, *宿主.结点,
            静态目标特征, 标量业务准入预算, 允许旧治理);
        if (!定义.成功) return 定义.状态;
        return std::nullopt;
    }

    存在读取值 查询存在(稳定编码 编码, std::uint64_t G0,
        需求类数据状态 未找到, 需求类数据状态 已退出) const {
        const auto 结果 = 存在服务_.查询存在({存在类数据合同版本, G0, 编码});
        if (结果.状态 == 存在类数据状态::未找到) return {false, 未找到, 结果.事实代次, {}};
        if (结果.状态 == 存在类数据状态::目标已退出) return {false, 已退出, 结果.事实代次, {}};
        if (结果.状态 == 存在类数据状态::事实代次漂移)
            return {false, 需求类数据状态::事实代次漂移, 结果.事实代次, {}};
        if (结果.状态 == 存在类数据状态::资源失败)
            return {false, 需求类数据状态::资源失败, 结果.事实代次, {}};
        if (结果.状态 != 存在类数据状态::已读取 || !结果.成功()
            || 结果.事实代次 != G0 || !结果.存在结点
            || 结果.存在结点->结点 != 编码 || 结果.存在结点->退出事实代次)
            return {false, 需求类数据状态::内部不一致, 结果.事实代次, {}};
        return {true, 需求类数据状态::已读取, 结果.事实代次, 结果.存在结点};
    }

    特征读取值 查询I64特征(稳定编码 编码, std::uint64_t G0, bool 是目标) const {
        const auto 读取 = 特征服务_.读取准确特征事实({1, G0, G0, {编码}});
        if (const auto* e = std::get_if<特征数据错误>(&读取)) {
            auto status = 需求类数据状态::内部不一致;
            switch (*e) {
            case 特征数据错误::未找到:
                status = 是目标 ? 需求类数据状态::静态目标特征未找到 : 需求类数据状态::当前事实特征未找到; break;
            case 特征数据错误::已退出:
                status = 是目标 ? 需求类数据状态::静态目标特征已退出 : 需求类数据状态::当前事实特征已退出; break;
            case 特征数据错误::并发变化: status = 需求类数据状态::事实代次漂移; break;
            case 特征数据错误::资源失败: status = 需求类数据状态::资源失败; break;
            case 特征数据错误::旧格式不支持:
            case 特征数据错误::能力未提供:
            case 特征数据错误::类型不相容:
                status = 是目标 ? 需求类数据状态::目标不是一阶I64静态特征 : 需求类数据状态::当前不是一阶I64特征; break;
            default: break;
            }
            return {false, status, G0, {}, {}};
        }
        const auto& f = std::get<准确特征读取事实>(读取);
        if (f.Gread != G0 || f.H != G0 || f.信息.身份.编码 != 编码 || !有效(f.信息.类型)
            || !f.创建G || f.创建G > G0 || (f.退出G && *f.退出G <= G0))
            return {false, 需求类数据状态::内部不一致, G0, {}, {}};
        const auto* I64 = std::get_if<std::int64_t>(&f.完整值);
        if (const auto* 引用 = std::get_if<特征值信息>(&f.完整值))
            I64 = std::get_if<std::int64_t>(&引用->值内容);
        if (!I64)
            return {false, 是目标 ? 需求类数据状态::目标不是一阶I64静态特征
                : 需求类数据状态::当前不是一阶I64特征, G0, f, {}};
        return {true, 需求类数据状态::已读取, G0, f, *I64};
    }

    方向读取值 查询方向定义(特征类定义身份 身份, std::uint64_t G0,
        const 存在类结点& 宿主, 稳定编码 目标F,
        const 特征类派生读取预算& 预算, bool 允许旧治理 = false) const {
        auto 读取 = 二次特征服务_.查询二次特征节点(
            {标量派生合同版本, G0, G0, 身份, 预算});
        if (读取.状态 == 特征类标量状态::格式不支持 && 允许旧治理) {
            // v1 仅供已持久业务记录治理；不会形成可执行标量材料。
            const auto 旧 = 特征服务_.读取旧派生治理事实(
                {标量派生合同版本, G0, G0, 身份, 预算});
            if (旧.状态 != 特征类标量状态::已读取)
                return {false, 映射标量状态(旧.状态), 旧.Gread, {}};
            if (!旧.成功() || 旧.版本 != 标量派生合同版本 || 旧.Gread != G0 || 旧.H != G0
                || !旧.事实 || 旧.事实->身份 != 身份 || 旧.事实->退出G)
                return {false, 需求类数据状态::内部不一致, 旧.Gread, {}};
            const auto& 合同 = *旧.事实;
            if (合同.用途 != 特征类比较用途::目标判断
                || 合同.左角色 != 特征类比较角色::当前事实
                || 合同.右角色 != 特征类比较角色::目标状态
                || (合同.宿主 && *合同.宿主 != 宿主.结点))
                return {false, 需求类数据状态::方向定义不匹配, G0, {}};
            return {true, 需求类数据状态::已读取, G0, {}};
        }
        if (读取.状态 != 特征类标量状态::已读取)
            return {false, 映射标量状态(读取.状态), 读取.Gread, {}};
        if (!读取.成功() || 读取.版本 != 标量派生合同版本
            || 读取.Gread != G0 || 读取.H != G0 || !读取.定义事实
            || 读取.定义事实->定义身份 != 身份)
            return {false, 需求类数据状态::内部不一致, 读取.Gread, {}};
        const auto& 定义 = *读取.定义事实;
        const auto& 合同 = 定义.注册;
        if (定义.真实阶次 <= 1 || 定义.退出G || 定义.创建G == 0
            || 定义.创建G > G0 || 定义.来源组.size() != 2
            || 定义.来源组[0].内容.顺序 != 1 || 定义.来源组[1].内容.顺序 != 2
            || 定义.来源组[0].内容.来源 == 定义.来源组[1].内容.来源
            || 定义.来源组[0].内容.输入角色 != 合同.左角色
            || 定义.来源组[1].内容.输入角色 != 合同.右角色
            || !有效(定义.派生规则.规则身份) || !有效(定义.注册身份.值)
            || !定义.宿主E || *定义.宿主E != 宿主.结点
            || !定义.宿主关系 || !有效(*定义.宿主关系)
            || 合同.用途 != 特征类比较用途::目标判断
            || 合同.左角色 != 特征类比较角色::当前事实
            || 合同.右角色 != 特征类比较角色::目标状态
            || 合同.算法版本 == 0 || 定义.派生规则.规则版本 != 合同.算法版本
            || 定义.输出组.empty() || 定义.输出组.size() != 合同.输出组.size())
            return {false, 需求类数据状态::方向定义不匹配, G0, {}};
        if (std::find(读取.右叶组.begin(), 读取.右叶组.end(), 目标F)
                == 读取.右叶组.end())
            return {false, 需求类数据状态::方向来源不匹配, G0, {}};
        for (const auto& 叶 : 读取.基础叶组) {
            if (!宿主含唯一特征(宿主, 叶.F))
                return {false, 需求类数据状态::目标特征不属于宿主, G0, {}};
            const auto 实际 = 查询I64特征(叶.F, G0, 叶.F == 目标F);
            if (!实际.成功) return {false, 实际.状态, 实际.事实代次, {}};
            if (叶.Gread != G0 || 叶.G != G0 || 实际.结点->信息.类型.编码 != 叶.FT
                || 实际.结点->准确值事实 != 叶.值事实 || *实际.I64 != 叶.值
                || 实际.结点->创建G != 叶.创建G
                || 实际.结点->退出G != 叶.退出G
                || 实际.结点->类型关系 != 叶.类型关系 || 实际.结点->完整值 != 叶.完整值)
                return {false, 需求类数据状态::方向来源不匹配, G0, {}};
        }
        return {true, 需求类数据状态::已读取, G0, std::move(读取)};
    }

    static bool 比较互证(const 特征类标量比较结果& 比较,
        const 特征类标量比较请求& 请求,
        const 特征类标量派生读取结果& 材料) noexcept {
        if (!比较.成功() || !材料.定义事实 || !比较.直接输入回执) return false;
        const auto& 定义 = *材料.定义事实;
        const auto& 合同 = 定义.注册;
        if (比较.版本 != 标量派生合同版本 || 比较.G != 请求.G
            || 比较.请求身份 != 请求.请求身份 || 比较.根定义 != 请求.根定义
            || 比较.注册身份 != 定义.注册身份 || 比较.算法版本 != 合同.算法版本
            || 比较.真实阶次 != 定义.真实阶次 || 比较.实际结果位 != 请求.要求结果位
            || 比较.输入量化 != 合同.输入量化 || 比较.误差合同版本 != 合同.误差合同版本
            || 比较.误差预算 != 合同.误差预算 || 比较.相等容差 != 合同.相等容差
            || 比较.基础叶回执组 != 材料.基础叶组)
            return false;
        for (std::size_t i = 0; i < 2; ++i) {
            const auto& 来源 = 定义.来源组[i].内容;
            const auto 角色 = i == 0 ? 合同.左角色 : 合同.右角色;
            if (const auto* 基础 = std::get_if<特征类标量基础来源>(&来源.来源)) {
                const auto* 输入 = std::get_if<特征类标量基础输入回执>(&(*比较.直接输入回执)[i]);
                if (!输入 || 输入->角色 != 角色 || 输入->叶.F != 基础->F.编码
                    || std::find(材料.基础叶组.begin(), 材料.基础叶组.end(), 输入->叶)
                        == 材料.基础叶组.end()) return false;
            } else {
                const auto& 上游 = std::get<特征类标量派生来源>(来源.来源);
                const auto* 输入 = std::get_if<特征类标量上游输入回执>(&(*比较.直接输入回执)[i]);
                if (!输入 || 输入->角色 != 角色 || 输入->定义 != 上游.定义
                    || 输入->输出角色 != 上游.上游输出角色
                    || !有效(输入->输出FT) || 输入->实际阶次 <= 1
                    || 输入->实际阶次 >= 定义.真实阶次) return false;
            }
        }
        for (const auto& 结果 : 比较.结果组) {
            const auto it = std::find_if(定义.输出组.begin(), 定义.输出组.end(),
                [&结果](const auto& 输出) noexcept { return 输出.声明.角色 == 结果.角色; });
            if (it == 定义.输出组.end() || 结果.输出FT != it->特征类型
                || 结果.量化 != it->声明.量化) return false;
        }
        return true;
    }

    static bool 宿主含唯一特征(const 存在类结点& 宿主, 稳定编码 特征) noexcept {
        return std::count_if(宿主.特征组.begin(), 宿主.特征组.end(),
            [特征](const 存在类成员引用& 成员) noexcept {
                return 成员.目标结点 == 特征 && 有效(成员.成员关系);
            }) == 1;
    }

    bool 提取关系(const std::vector<L1所有者范围一致源关系组读取结果项>& 组,
        稳定编码 类型, 稳定编码& 目标, 稳定编码& 关系编码,
        std::uint64_t 创建代次) const noexcept {
        const auto it = std::find_if(组.begin(), 组.end(), [类型](const auto& 项) {
            return 项.关系类型节点 == 类型;
        });
        if (it == 组.end() || it->成员.size() != 1) return false;
        const auto& 投影 = it->成员.front();
        const auto& 关系 = 投影.关系;
        if (!关系有效(关系, it->源节点, 关系.目标节点, 类型, 创建代次)
            || 投影.对端节点.编码 != 关系.目标节点
            || 投影.对端节点.退出事实代次) return false;
        目标 = 关系.目标节点;
        关系编码 = 关系.编码;
        return true;
    }

    bool 关系有效(const L1所有者范围关系事实& 关系, 稳定编码 源,
        稳定编码 目标, 稳定编码 类型,
        std::optional<std::uint64_t> 创建代次) const noexcept {
        return 有效(关系.编码) && 有效(源) && 有效(目标)
            && 关系.源节点 == 源 && 关系.目标节点 == 目标
            && 关系.关系类型节点 == 类型 && 关系.角色或顺序 == 0
            && 关系.写入所有者 == 所有者_ && !关系.退出事实代次
            && (!创建代次 || 关系.创建事实代次 == *创建代次);
    }

    bool 写入头完整(const L1所有者范围写入结果& 写入,
        L1所有者范围写入幂等身份 幂等) const noexcept {
        const bool 首次 = 写入.状态 == L1所有者范围写入状态::成功
            && 写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::不适用;
        const bool 重复 = 写入.状态 == L1所有者范围写入状态::精确重复
            && !写入.是否形成内存权威发布
            && 写入.重试边界 == L1所有者范围重试边界::原幂等身份读回收敛;
        return 写入.合同版本 == L1所有者范围CRUD合同版本
            && 写入.所有者 == 所有者_ && 写入.写入幂等身份 == 幂等
            && 写入.事实代次 != 0 && (首次 || 重复);
    }

    static 需求类数据状态 映射L1读取状态(L1所有者范围读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围读取状态::未找到: return 需求类数据状态::未找到;
        case L1所有者范围读取状态::事实代次漂移: return 需求类数据状态::事实代次漂移;
        case L1所有者范围读取状态::资源失败: return 需求类数据状态::资源失败;
        case L1所有者范围读取状态::入口拒绝: return 需求类数据状态::入口拒绝;
        default: return 需求类数据状态::内部不一致;
        }
    }

    static 需求类数据状态 映射一致读取状态(
        L1所有者范围一致当前读取状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围一致当前读取状态::事实代次漂移:
            return 需求类数据状态::事实代次漂移;
        case L1所有者范围一致当前读取状态::资源失败:
            return 需求类数据状态::资源失败;
        case L1所有者范围一致当前读取状态::入口拒绝:
            return 需求类数据状态::入口拒绝;
        default: return 需求类数据状态::内部不一致;
        }
    }

    static 需求类数据状态 映射写入状态(L1所有者范围写入状态 状态) noexcept {
        switch (状态) {
        case L1所有者范围写入状态::成功: return 需求类数据状态::已创建;
        case L1所有者范围写入状态::精确重复: return 需求类数据状态::精确重复;
        case L1所有者范围写入状态::入口拒绝: return 需求类数据状态::入口拒绝;
        case L1所有者范围写入状态::事实代次漂移: return 需求类数据状态::事实代次漂移;
        case L1所有者范围写入状态::幂等冲突: return 需求类数据状态::幂等冲突;
        case L1所有者范围写入状态::引用冲突: return 需求类数据状态::引用冲突;
        case L1所有者范围写入状态::资源失败: return 需求类数据状态::资源失败;
        default: return 需求类数据状态::内部不一致;
        }
    }

    static 需求类数据状态 映射标量状态(特征类标量状态 状态) noexcept {
        switch (状态) {
        case 特征类标量状态::未找到: return 需求类数据状态::方向定义未找到;
        case 特征类标量状态::已退出: return 需求类数据状态::方向定义已退出;
        case 特征类标量状态::格式不支持: return 需求类数据状态::方向格式不支持;
        case 特征类标量状态::来源不匹配: return 需求类数据状态::方向来源不匹配;
        case 特征类标量状态::预算不足: return 需求类数据状态::数量预算不足;
        case 特征类标量状态::历史材料不可用: return 需求类数据状态::方向历史材料不可用;
        case 特征类标量状态::事实代次漂移: return 需求类数据状态::事实代次漂移;
        case 特征类标量状态::资源失败: return 需求类数据状态::资源失败;
        case 特征类标量状态::入口拒绝: return 需求类数据状态::入口拒绝;
        case 特征类标量状态::算法不支持:
        case 特征类标量状态::类型不匹配:
        case 特征类标量状态::单位量化不匹配:
        case 特征类标量状态::结果范围不满足:
        case 特征类标量状态::运算溢出: return 需求类数据状态::方向比较失败;
        default: return 需求类数据状态::内部不一致;
        }
    }

    static 需求类记录结果 记录失败(需求类数据状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 需求类数据合同版本, 事实代次, std::nullopt};
    }

    static 需求类标量方向读取结果 方向失败(需求类数据状态 状态,
        const 需求类标量方向读取请求& 请求, std::uint64_t G = 0,
        const 需求类记录* 记录 = nullptr) noexcept {
        return {状态, 需求类标量方向合同版本, G, 请求.需求,
            请求.当前F, 记录 ? 记录->静态目标特征 : 稳定编码{},
            记录 ? 记录->方向二次特征 : 特征类定义身份{}, std::nullopt};
    }

    const L1事实基座服务& 第一层服务_;
    const 特征类数据服务& 特征服务_;
    const 存在类数据服务& 存在服务_;
    const 二次特征类数据服务& 二次特征服务_;
    L1所有者范围写端口 写入端口_;
    L1结构所有者身份 所有者_{};
    需求类结构类型 结构类型_{};
};

} // namespace 海中鱼巣
