// 文件规则：本模块只建立世界引导的最终公开合同和安全未实现骨架。
module;

#include "世界树事实.数据.h"

#include <cstdint>
#include <optional>
#include <utility>

export module 海中鱼巣.领域.服务.节点直接世界引导;

import 海中鱼巣.核心.服务.节点直接结构;
import 海中鱼巣.核心.服务.节点直接结构恢复;
import 海中鱼巣.核心.服务.节点直接类型化结构提交;
import 海中鱼巣.领域.服务.节点直接世界结构;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 节点直接世界引导合同版本 = 1;
enum class 节点直接世界引导状态 : std::uint8_t {
    已恢复 = 1, 已创建 = 2, 幂等读回 = 3, 无可验证历史 = 4,
    入口拒绝 = 5, 版本漂移 = 6, 许可拒绝 = 7, 资源失败 = 8,
    内部不一致 = 9, 已恢复治理空域 = 10, 未实现 = 11
};
struct 节点直接世界引导请求 {
    std::uint32_t 合同版本 = 节点直接世界引导合同版本;
    std::uint32_t 世界规则版本 = 世界树规则版本;
    世界树幂等身份 安装实例身份;
};
struct 节点直接世界引导读回 {
    世界树节点身份见证 世界根场景;
    世界树节点身份见证 初始场景;
    世界树关系身份见证 根到初始场景关系;
};
struct 节点直接世界引导结果 {
    节点直接世界引导状态 状态 = 节点直接世界引导状态::入口拒绝;
    std::uint64_t 发布代次 = 0;
    std::optional<节点直接世界引导读回> 读回;
};

class 节点直接世界引导服务 final {
public:
    节点直接世界引导服务(
        节点直接结构恢复服务& 恢复,
        节点直接类型化结构提交服务& 提交,
        节点直接结构查询服务& 结构,
        节点直接世界结构读取服务& 世界结构) noexcept
        : 恢复_(恢复), 提交_(提交), 结构_(结构), 世界结构_(世界结构) {}

    节点直接世界引导结果 确保现实世界已引导(
        const 节点直接世界引导请求&) const noexcept {
        return {节点直接世界引导状态::未实现, 0, std::nullopt};
    }

private:
    节点直接结构恢复服务& 恢复_;
    节点直接类型化结构提交服务& 提交_;
    节点直接结构查询服务& 结构_;
    节点直接世界结构读取服务& 世界结构_;
};

static_assert(noexcept(std::declval<const 节点直接世界引导服务&>()
    .确保现实世界已引导(std::declval<const 节点直接世界引导请求&>())));

} // namespace 海中鱼巣
