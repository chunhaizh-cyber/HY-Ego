module;

#include <array>
#include <cstdint>
#include <limits>
#include <optional>

export module 海中鱼巣.领域.自检.L1特征定义;

import 海中鱼巣.领域.服务.L1特征定义;
import 海中鱼巣.领域.服务.世界登记;
import 海中鱼巣.领域.服务.L1场景结构;
import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {

struct L1特征定义自检报告 final {
    bool 总通过 = false;
    std::array<bool, 20> 验收{};
    std::size_t 失败数量 = 0;
};

L1特征定义自检报告 运行L1特征定义自检() {
    L1特征定义自检报告 报告;
    try {
        L1事实基座服务 L1;
        L1特征定义服务 服务(L1);
        报告.验收[0] = 服务.读取当前登记().状态 == 特征定义状态::登记未加载;
        I64特征定义建立请求 未登记请求;
        未登记请求.幂等身份 = {0x0000'0400'0000'0000ULL + 1};
        报告.验收[1] = 服务.建立I64特征定义(未登记请求).状态 == 特征定义状态::登记未加载;

        特征定义登记请求 错误合同;
        错误合同.合同版本 = 2;
        错误合同.幂等身份 = {1};
        报告.验收[2] = 服务.建立登记(错误合同).状态 == 特征定义状态::入口拒绝;

        特征定义登记请求 登记请求;
        登记请求.幂等身份 = {0x0000'0300'0000'0001ULL};
        const auto 登记 = 服务.建立登记(登记请求);
        报告.验收[3] = 登记.状态 == 特征定义状态::已提交
            && 登记.登记.has_value() && 特征定义登记完整(*登记.登记);
        const auto 登记幂等 = 服务.建立登记(登记请求);
        报告.验收[4] = 登记幂等.状态 == 特征定义状态::幂等读回
            && 登记幂等.登记.has_value()
            && 登记幂等.登记->服务身份 == 登记.登记->服务身份;

        auto 登记冲突请求 = 登记请求;
        登记冲突请求.幂等身份.值++;
        报告.验收[5] = 服务.建立登记(登记冲突请求).状态 == 特征定义状态::幂等冲突;
        报告.验收[6] = 服务.读取当前登记().状态 == 特征定义状态::已读取;

        I64特征定义建立请求 定义请求;
        定义请求.幂等身份 = {0x0000'0400'0000'0001ULL};
        定义请求.期望事实代次 = 登记.登记.has_value()
            ? 登记.登记->事实截止代次 : std::numeric_limits<std::uint64_t>::max();
        定义请求.下界 = -10;
        定义请求.上界 = 10;
        const auto 定义 = 服务.建立I64特征定义(定义请求);
        报告.验收[7] = 定义.状态 == 特征定义状态::已提交
            && 定义.事实.has_value() && I64特征定义事实完整(*定义.事实)
            && 定义.事实->下界 == -10 && 定义.事实->上界 == 10;

        const auto 定义幂等 = 服务.建立I64特征定义(定义请求);
        报告.验收[8] = 定义幂等.状态 == 特征定义状态::幂等读回
            && 定义幂等.事实.has_value()
            && 定义幂等.事实->特征定义 == 定义.事实->特征定义;
        auto 定义冲突请求 = 定义请求;
        定义冲突请求.上界 = 11;
        const auto 定义冲突 = 服务.建立I64特征定义(定义冲突请求);
        报告.验收[9] = 定义冲突.状态 == 特征定义状态::幂等冲突;

        auto 反向请求 = 定义请求;
        反向请求.幂等身份 = {0x0000'0400'0000'0002ULL};
        反向请求.下界 = 2;
        反向请求.上界 = 1;
        const auto 反向 = 服务.建立I64特征定义(反向请求);
        报告.验收[10] = 反向.状态 == 特征定义状态::入口拒绝;

        I64特征定义读取请求 读取请求;
        读取请求.特征定义 = 定义.事实.has_value() ? 定义.事实->特征定义 : 稳定编码{};
        读取请求.定义标记值 = 定义.定义标记值;
        读取请求.下界值 = 定义.下界值;
        读取请求.上界值 = 定义.上界值;
        const auto 读取 = 服务.读取I64特征定义(读取请求);
        报告.验收[11] = 读取.状态 == 特征定义状态::已读取
            && 读取.事实.has_value() && 读取.事实->下界 == -10
            && 读取.事实->上界 == 10;

        auto 错误读取 = 读取请求;
        错误读取.定义标记值 = {};
        const auto 错误读取结果 = 服务.读取I64特征定义(错误读取);
        报告.验收[12] = 错误读取结果.状态 == 特征定义状态::入口拒绝;
        auto 错误版本读取 = 读取请求;
        错误版本读取.合同版本 = 2;
        报告.验收[13] = 服务.读取I64特征定义(错误版本读取).状态 == 特征定义状态::入口拒绝;

        L1事实基座服务 漂移L1;
        L1特征定义服务 漂移服务(漂移L1);
        auto 漂移登记请求 = 登记请求;
        漂移登记请求.幂等身份 = {0x0000'0300'0000'0002ULL};
        const auto 漂移登记 = 漂移服务.建立登记(漂移登记请求);
        auto 代次漂移 = 定义请求;
        代次漂移.幂等身份 = {0x0000'0400'0000'0003ULL};
        代次漂移.期望事实代次 = 漂移登记.登记.has_value()
            ? 漂移登记.登记->事实截止代次 + 1 : 1;
        报告.验收[14] = 漂移服务.建立I64特征定义(代次漂移).状态
            == 特征定义状态::事实代次漂移;

        L1事实基座服务 空L1;
        L1特征定义服务 空服务(空L1);
        const auto 空定义 = 空服务.建立I64特征定义(定义请求);
        报告.验收[15] = 空定义.状态 == 特征定义状态::登记未加载;

        L1事实基座服务 组合L1;
        世界登记服务 世界(组合L1);
        L1场景结构服务 场景(组合L1, 世界);
        L1特征定义服务 组合服务(组合L1);
        世界登记建立请求 世界请求;
        世界请求.幂等身份 = {0x3010};
        const auto 世界结果 = 世界.建立空世界(世界请求);
        初始场景创建请求 场景请求;
        场景请求.幂等身份 = {0x3020};
        场景请求.世界根 = {世界结果.登记 ? 世界结果.登记->世界根场景 : 稳定编码{}, 节点种类::普通};
        场景请求.期望事实代次 = 世界结果.登记 ? 世界结果.登记->已验证事实代次 : 0;
        const auto 场景结果 = 场景.创建初始场景(场景请求);
        特征定义登记请求 组合登记请求;
        组合登记请求.幂等身份 = {0x3030};
        组合登记请求.期望事实代次 = 场景结果.事实 ? 场景结果.事实->事实截止代次 : 0;
        const auto 组合登记 = 组合服务.建立登记(组合登记请求);
        报告.验收[16] = 世界结果.状态 == 世界登记状态::已提交
            && 场景结果.状态 == 世界结构状态::已提交
            && 组合登记.状态 == 特征定义状态::已提交
            && 组合登记.登记.has_value() && 组合登记.登记->事实截止代次 == 3;
        const auto 组合重复 = 组合服务.建立登记(组合登记请求);
        报告.验收[17] = 组合重复.状态 == 特征定义状态::幂等读回;
        auto 组合冲突请求 = 组合登记请求;
        组合冲突请求.幂等身份.值++;
        报告.验收[18] = 组合服务.建立登记(组合冲突请求).状态 == 特征定义状态::幂等冲突;
        报告.验收[19] = 组合L1.读取完整快照({}).快照.has_value()
            && 组合L1.读取完整快照({}).快照->事实代次 == 3;
    } catch (...) {
    }
    for (const bool 通过 : 报告.验收) if (!通过) ++报告.失败数量;
    报告.总通过 = 报告.失败数量 == 0;
    return 报告;
}

} // namespace 海中鱼巣
