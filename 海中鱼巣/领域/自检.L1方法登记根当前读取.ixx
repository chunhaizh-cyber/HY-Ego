module;

#include <cstddef>
#include <cstdint>
#include <iostream>
#include <optional>
#include <utility>
#include <vector>

export module 海中鱼巣.领域.自检.L1方法登记根当前读取;

import 海中鱼巣.领域.服务.L1方法登记根当前读取;
import 海中鱼巣.核心.服务.L1事实基座;

namespace 海中鱼巣::L1方法登记根当前读取自检内部 {

struct 建立选项 final {
    bool 建立根 = true;
    bool 建立类型 = true;
    bool 建立服务 = true;
    bool 建立值 = true;
    bool 建立槽 = true;
    节点种类 根种类 = 节点种类::普通;
    值表示种类 类型表示 = 值表示种类::I64;
    std::int64_t 角色 = 1;
    std::uint8_t 来源选择 = 3;
};

struct 建立结果 final {
    L1写入状态 状态 = L1写入状态::入口拒绝;
    std::uint64_t 事实代次 = 0;
    方法登记根当前读取请求 请求;
};

稳定编码 取编码(const L1写入结果& 结果, std::uint32_t 本地键) noexcept {
    for (const auto& [键, 编码] : 结果.新编码映射)
        if (键.值 == 本地键) return 编码;
    return {};
}

建立结果 建立结构(L1事实基座服务& L1, const 建立选项& 选项,
    std::uint64_t 幂等值) {
    L1写集请求 写集;
    写集.期望事实代次 = 0;
    写集.幂等键 = {幂等值};
    if (选项.建立根)
        写集.节点.push_back({{1}, 选项.根种类,
            选项.根种类 == 节点种类::属性类型
                ? std::optional<值表示种类>{值表示种类::I64} : std::nullopt});
    if (选项.建立类型)
        写集.节点.push_back({{2}, 节点种类::属性类型, 选项.类型表示});
    if (选项.建立服务)
        写集.节点.push_back({{3}, 节点种类::普通, std::nullopt});
    if (选项.建立值) {
        const 写集本地键 来源{选项.来源选择};
        const 原始值材料 材料 = 选项.类型表示 == 值表示种类::I64
            ? 原始值材料{std::int64_t{选项.角色}}
            : 原始值材料{std::vector<std::int64_t>{选项.角色}};
        写集.值.push_back({{4}, 写集本地键{1}, 写集本地键{2}, 材料, 来源});
    }
    if (选项.建立槽)
        写集.属性槽变更.push_back({写集本地键{1}, 写集本地键{2}, 写集本地键{4}});
    const auto 发布 = L1.提交写集(写集, 0x1501C001U);
    方法登记根当前读取请求 请求;
    请求.期望事实截止代次 = 发布.事实代次;
    请求.定位.登记根 = {取编码(发布, 1), 节点种类::普通, 发布.事实代次};
    请求.定位.系统角色属性类型 = {
        取编码(发布, 2), 节点种类::属性类型, 发布.事实代次};
    请求.定位.方法领域服务 = {
        取编码(发布, 3), 节点种类::普通, 发布.事实代次};
    return {发布.状态, 发布.事实代次, 请求};
}

方法登记根当前读取请求 不存在请求(std::uint64_t 截止) {
    方法登记根当前读取请求 请求;
    请求.期望事实截止代次 = 截止;
    请求.定位.登记根 = {{101}, 节点种类::普通, 截止};
    请求.定位.系统角色属性类型 = {{102}, 节点种类::属性类型, 截止};
    请求.定位.方法领域服务 = {{103}, 节点种类::普通, 截止};
    return 请求;
}

} // namespace 海中鱼巣::L1方法登记根当前读取自检内部

export namespace 海中鱼巣 {

struct L1方法登记根当前读取自检报告 final {
    std::vector<bool> 验收;
    std::size_t 失败数量 = 0;
    bool 总通过 = false;
};

L1方法登记根当前读取自检报告 运行L1方法登记根当前读取自检() {
    using namespace L1方法登记根当前读取自检内部;
    std::vector<bool> 验收;
    auto 记 = [&](bool 通过) { 验收.push_back(通过); };

    L1事实基座服务 空L1;
    L1方法登记根当前读取服务 空服务(空L1);
    记(空服务.读取当前方法登记根({}).状态 == 方法登记根当前读取状态::入口拒绝);
    auto 错合同 = 不存在请求(1);
    错合同.合同版本 = 2;
    记(空服务.读取当前方法登记根(错合同).状态 == 方法登记根当前读取状态::入口拒绝);
    auto 重复身份 = 不存在请求(1);
    重复身份.定位.方法领域服务.编码 = 重复身份.定位.登记根.编码;
    记(空服务.读取当前方法登记根(重复身份).状态 == 方法登记根当前读取状态::入口拒绝);
    记(空服务.读取当前方法登记根(不存在请求(1)).状态
        == 方法登记根当前读取状态::版本漂移);

    L1事实基座服务 无关L1;
    const auto 无关 = 建立结构(无关L1,
        {true, false, false, false, false}, 0x0690'5830'0000'0001ULL);
    L1方法登记根当前读取服务 无关服务(无关L1);
    记(无关.状态 == L1写入状态::成功
        && 无关服务.读取当前方法登记根(不存在请求(无关.事实代次)).状态
            == 方法登记根当前读取状态::未找到);

    L1事实基座服务 半结构L1;
    const auto 半结构 = 建立结构(半结构L1,
        {true, false, false, false, false}, 0x0690'5830'0000'0002ULL);
    auto 半结构请求 = 不存在请求(半结构.事实代次);
    半结构请求.定位.登记根 = 半结构.请求.定位.登记根;
    L1方法登记根当前读取服务 半结构服务(半结构L1);
    记(半结构服务.读取当前方法登记根(半结构请求).状态
        == 方法登记根当前读取状态::内部不一致);

    L1事实基座服务 正常L1;
    const auto 正常 = 建立结构(正常L1, {}, 0x0690'5830'0000'0003ULL);
    L1方法登记根当前读取服务 正常服务(正常L1);
    const auto 首次 = 正常服务.读取当前方法登记根(正常.请求);
    const auto 再次 = 正常服务.读取当前方法登记根(正常.请求);
    记(正常.状态 == L1写入状态::成功 && 首次.状态 == 方法登记根当前读取状态::已读取
        && 首次.事实 && 首次.事实截止代次 == 正常.事实代次
        && 首次.事实->定位 == 正常.请求.定位
        && 首次.事实->角色值.角色 == 方法固定系统角色::方法登记根);
    记(再次.状态 == 首次.状态 && 再次.事实截止代次 == 首次.事实截止代次
        && 再次.事实 == 首次.事实);
    auto 漂移 = 正常.请求;
    漂移.期望事实截止代次 += 1;
    记(正常服务.读取当前方法登记根(漂移).状态 == 方法登记根当前读取状态::版本漂移);
    auto 错见证 = 正常.请求;
    错见证.定位.登记根.创建事实代次 += 1;
    记(正常服务.读取当前方法登记根(错见证).状态 == 方法登记根当前读取状态::入口拒绝);

    L1事实基座服务 无槽L1;
    const auto 无槽 = 建立结构(无槽L1,
        {true, true, true, false, false}, 0x0690'5830'0000'0004ULL);
    L1方法登记根当前读取服务 无槽服务(无槽L1);
    记(无槽服务.读取当前方法登记根(无槽.请求).状态
        == 方法登记根当前读取状态::内部不一致);

    L1事实基座服务 旧角色L1;
    建立选项 旧角色选项;
    旧角色选项.角色 = 6;
    const auto 旧角色 = 建立结构(旧角色L1, 旧角色选项, 0x0690'5830'0000'0005ULL);
    L1方法登记根当前读取服务 旧角色服务(旧角色L1);
    记(旧角色服务.读取当前方法登记根(旧角色.请求).状态
        == 方法登记根当前读取状态::内部不一致);

    L1事实基座服务 错来源L1;
    建立选项 错来源选项;
    错来源选项.来源选择 = 1;
    const auto 错来源 = 建立结构(错来源L1, 错来源选项, 0x0690'5830'0000'0006ULL);
    L1方法登记根当前读取服务 错来源服务(错来源L1);
    记(错来源服务.读取当前方法登记根(错来源.请求).状态
        == 方法登记根当前读取状态::内部不一致);

    L1事实基座服务 错表示L1;
    建立选项 错表示选项;
    错表示选项.类型表示 = 值表示种类::I64组;
    const auto 错表示 = 建立结构(错表示L1, 错表示选项, 0x0690'5830'0000'0007ULL);
    L1方法登记根当前读取服务 错表示服务(错表示L1);
    记(错表示服务.读取当前方法登记根(错表示.请求).状态
        == 方法登记根当前读取状态::内部不一致);

    std::size_t 失败数量 = 0;
    for (const bool 通过 : 验收) if (!通过) ++失败数量;
    std::cout << "L1-SIMPLIFY-METHOD-ROOT-R1-S01 "
        << (失败数量 == 0 ? "通过" : "失败") << " checks=" << 验收.size()
        << " failed=" << 失败数量;
    for (std::size_t 索引 = 0; 索引 < 验收.size(); ++索引)
        if (!验收[索引]) std::cout << " failed#" << (索引 + 1);
    std::cout << '\n';
    return {std::move(验收), 失败数量, 失败数量 == 0};
}

} // namespace 海中鱼巣
