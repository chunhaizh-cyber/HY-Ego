// 文件规则：本模块只计算一个完整秒的服务值与生存安全根候选，不读取或写入任何事实。
module;

#include <algorithm>
#include <cstdint>
#include <limits>
#include <optional>
#include <stdexcept>
#include <utility>
#include <vector>

#define INSTINCT_SINGLE_COMPLETE_SECOND_MAINTENANCE_NO_INCLUDES

export module 海中鱼巣.领域.算法.本能单完整秒被动维护;

export {
#include "本能单完整秒被动维护.数据.h"
}

namespace 海中鱼巣::本能单完整秒被动维护内部 {

// 仅用于拒绝版本 1 请求异义；正式阈值权威仍来自安全根定义读回。
inline constexpr std::int64_t 安全根定义版本一低位阈值 =
    2'767'011'611'056'432'742;
inline constexpr std::int64_t 安全根定义版本一高位阈值 =
    7'378'697'629'483'820'645;

inline 本能单完整秒被动维护结果_v1 失败(
    本能单完整秒被动维护状态_v1 状态) noexcept {
    return {本能单完整秒被动维护合同版本_v1, 状态, std::nullopt};
}

inline bool 有效枚举(服务活动裁决_v1 值) noexcept {
    return 值 == 服务活动裁决_v1::不存在 || 值 == 服务活动裁决_v1::存在;
}
inline bool 有效枚举(同秒主动安全裁决_v1 值) noexcept {
    return 值 == 同秒主动安全裁决_v1::未改变A
        || 值 == 同秒主动安全裁决_v1::已改变A;
}
inline bool 有效枚举(安全低位回升门禁_v1 值) noexcept {
    return 值 == 安全低位回升门禁_v1::不适用
        || 值 == 安全低位回升门禁_v1::允许
        || 值 == 安全低位回升门禁_v1::禁止
        || 值 == 安全低位回升门禁_v1::材料不足;
}

inline bool 需求形状有效(const 本能单完整秒被动维护请求_v1& 请求) noexcept {
    switch (请求.需求裁决) {
    case 服务维护需求裁决_v1::无有效未满足且无到期事件:
        return 请求.有效未满足需求数量 == 0 && !请求.最长等待完整秒
            && 请求.本秒到期未满足事件数量 == 0;
    case 服务维护需求裁决_v1::存在未满观察窗需求:
        return 请求.有效未满足需求数量 != 0 && 请求.最长等待完整秒
            && *请求.最长等待完整秒 >= 0
            && *请求.最长等待完整秒 < 服务观察窗完整秒_v1
            && 请求.本秒到期未满足事件数量 == 0;
    case 服务维护需求裁决_v1::三十天门禁已成立: {
        const bool 需求形状 = 请求.有效未满足需求数量 == 0
            ? !请求.最长等待完整秒
            : 请求.最长等待完整秒 && *请求.最长等待完整秒 >= 0;
        const bool 门禁 = 请求.本秒到期未满足事件数量 != 0
            || (请求.最长等待完整秒
                && *请求.最长等待完整秒 >= 服务观察窗完整秒_v1);
        return 需求形状 && 门禁;
    }
    default: return false;
    }
}

inline bool 非负乘法(
    std::int64_t 左, std::int64_t 右, std::int64_t& 结果) noexcept {
    if (左 < 0 || 右 < 0 || (右 != 0 && 左 > 根值上界_v1 / 右)) return false;
    结果 = 左 * 右;
    return true;
}

inline bool 计算服务衰减(
    const 本能单完整秒被动维护请求_v1& 请求,
    std::int64_t& 后值,
    服务被动维护分支_v1& 分支) noexcept {
    if (请求.需求裁决 == 服务维护需求裁决_v1::三十天门禁已成立) {
        if (请求.活动裁决 == 服务活动裁决_v1::存在) {
            if (请求.服务值前值 == 0) {
                后值 = 0;
                分支 = 服务被动维护分支_v1::三十天门禁活动零保持;
            } else {
                后值 = 1;
                分支 = 服务被动维护分支_v1::三十天门禁最低一;
            }
        } else {
            后值 = 0;
            分支 = 服务被动维护分支_v1::三十天门禁归零;
        }
        return true;
    }
    std::int64_t 减少 = 1;
    if (请求.需求裁决 == 服务维护需求裁决_v1::存在未满观察窗需求) {
        std::int64_t 乘积 = 0;
        if (!请求.最长等待完整秒
            || !非负乘法(服务基础衰减_v1, *请求.最长等待完整秒, 乘积))
            return false;
        const auto 增量 = 乘积 / 服务观察窗完整秒_v1;
        if (服务基础衰减_v1 > 根值上界_v1 - 增量) return false;
        减少 = (std::max)(std::int64_t{1}, 服务基础衰减_v1 + 增量);
        分支 = 服务被动维护分支_v1::最长等待衰减;
    } else {
        分支 = 服务被动维护分支_v1::无需求每秒一;
    }
    const auto 饱和后 = 请求.服务值前值 <= 减少
        ? std::int64_t{0} : 请求.服务值前值 - 减少;
    后值 = 请求.活动裁决 == 服务活动裁决_v1::存在
            && 请求.服务值前值 > 0
        ? (std::max)(std::int64_t{1}, 饱和后) : 饱和后;
    return true;
}

inline std::int64_t 计算服务比例(std::int64_t 服务值) noexcept {
    return 服务值 == 0 ? 0
        : (std::min)(std::int64_t{99},
            std::int64_t{1} + 服务值 / 服务比例单位_v1);
}

inline 本能多完整秒被动维护结果_v1 批量失败(
    本能多完整秒被动维护状态_v1 状态) noexcept {
    return {本能多完整秒被动维护合同版本_v1, 状态, std::nullopt};
}

inline bool 有效枚举(本能批量维护需求来源形态_v1 值) noexcept {
    return 值 == 本能批量维护需求来源形态_v1::无有效未满足且无到期事件
        || 值 == 本能批量维护需求来源形态_v1::最长未满足合同
        || 值 == 本能批量维护需求来源形态_v1::同秒到期未满足事件;
}

inline bool 批量门禁材料有效(安全低位回升门禁_v1 值) noexcept {
    return 值 == 安全低位回升门禁_v1::允许
        || 值 == 安全低位回升门禁_v1::禁止
        || 值 == 安全低位回升门禁_v1::材料不足;
}

inline bool 事实段形状有效(const 本能被动维护有限事实段_v1& 段) noexcept {
    if (段.事实分段键 == 0 || 段.起始完整秒边界 < 0
        || 段.结束完整秒边界 < 段.起始完整秒边界
        || !有效枚举(段.需求来源形态) || !有效枚举(段.活动裁决)
        || 段.主动安全裁决 != 同秒主动安全裁决_v1::未改变A
        || !批量门禁材料有效(段.低位回升门禁材料))
        return false;
    switch (段.需求来源形态) {
    case 本能批量维护需求来源形态_v1::无有效未满足且无到期事件:
        return !段.最长需求提出完整秒边界
            && 段.同秒到期未满足事件数量 == 0;
    case 本能批量维护需求来源形态_v1::最长未满足合同:
        return 段.最长需求提出完整秒边界
            && *段.最长需求提出完整秒边界 >= 0
            && *段.最长需求提出完整秒边界 <= 段.起始完整秒边界
            && 段.同秒到期未满足事件数量 == 0;
    case 本能批量维护需求来源形态_v1::同秒到期未满足事件:
        return !段.最长需求提出完整秒边界
            && 段.同秒到期未满足事件数量 != 0
            && 段.起始完整秒边界 == 段.结束完整秒边界;
    default: return false;
    }
}

inline bool 相邻事实段可合并(const 本能被动维护有限事实段_v1& 左,
    const 本能被动维护有限事实段_v1& 右) noexcept {
    return 左.需求来源形态 == 右.需求来源形态
        && 左.最长需求提出完整秒边界 == 右.最长需求提出完整秒边界
        && 左.同秒到期未满足事件数量 == 右.同秒到期未满足事件数量
        && 左.活动裁决 == 右.活动裁决
        && 左.主动安全裁决 == 右.主动安全裁决
        && 左.低位回升门禁材料 == 右.低位回升门禁材料;
}

inline bool 安全加(std::uint64_t 左, std::uint64_t 右,
    std::uint64_t& 结果) noexcept {
    if (左 > (std::numeric_limits<std::uint64_t>::max)() - 右) return false;
    结果 = 左 + 右;
    return true;
}

inline bool 安全乘(std::uint64_t 左, std::uint64_t 右,
    std::uint64_t& 结果) noexcept {
    if (右 != 0 && 左 > (std::numeric_limits<std::uint64_t>::max)() / 右)
        return false;
    结果 = 左 * 右;
    return true;
}

// 返回 sum(i=0..n-1, floor((a*i+b)/m))。调用边界由 6170 v0.8 固定。
inline std::optional<std::uint64_t> 非负地板和(
    std::uint64_t n, std::uint64_t m, std::uint64_t a,
    std::uint64_t b) noexcept {
    if (m == 0) return std::nullopt;
    std::uint64_t 答案 = 0;
    for (;;) {
        if (a >= m) {
            const auto 商 = a / m;
            std::uint64_t 三角 = 0;
            if ((n & 1U) == 0) {
                if (!安全乘(n / 2, n == 0 ? 0 : n - 1, 三角))
                    return std::nullopt;
            } else if (!安全乘(n, (n - 1) / 2, 三角)) {
                return std::nullopt;
            }
            std::uint64_t 项 = 0;
            if (!安全乘(三角, 商, 项) || !安全加(答案, 项, 答案))
                return std::nullopt;
            a %= m;
        }
        if (b >= m) {
            std::uint64_t 项 = 0;
            if (!安全乘(n, b / m, 项) || !安全加(答案, 项, 答案))
                return std::nullopt;
            b %= m;
        }
        std::uint64_t an = 0;
        if (!安全乘(a, n, an)) return std::nullopt;
        std::uint64_t y = 0;
        if (!安全加(an, b, y)) return std::nullopt;
        if (y < m) break;
        n = y / m;
        b = y % m;
        const auto 旧m = m;
        m = a;
        a = 旧m;
        if (m == 0) return std::nullopt;
    }
    return 答案;
}

struct 累计减少_v1 final {
    std::int64_t 饱和值 = 0;
    bool 已饱和 = false;
};

inline std::optional<累计减少_v1> 计算累计请求减少(
    const 本能被动维护有限事实段_v1& 段,
    std::int64_t 起始秒, std::uint64_t 秒数) noexcept {
    if (秒数 == 0) return 累计减少_v1{};
    if (段.需求来源形态
        == 本能批量维护需求来源形态_v1::无有效未满足且无到期事件) {
        const bool 饱和 = 秒数 > static_cast<std::uint64_t>(根值上界_v1);
        return 累计减少_v1{饱和 ? 根值上界_v1
            : static_cast<std::int64_t>(秒数), 饱和};
    }
    if (段.需求来源形态
        != 本能批量维护需求来源形态_v1::最长未满足合同
        || !段.最长需求提出完整秒边界)
        return std::nullopt;
    const auto t0 = 起始秒 - *段.最长需求提出完整秒边界;
    if (t0 < 0 || t0 >= 服务观察窗完整秒_v1
        || 秒数 > static_cast<std::uint64_t>(
            服务观察窗完整秒_v1 - t0))
        return std::nullopt;
    const auto n = 秒数;
    const auto m = static_cast<std::uint64_t>(服务观察窗完整秒_v1);
    const auto a = static_cast<std::uint64_t>(服务基础衰减_v1);
    std::uint64_t b = 0;
    if (!安全乘(a, static_cast<std::uint64_t>(t0), b)) return std::nullopt;
    const auto 地板 = 非负地板和(n, m, a, b);
    if (!地板) return std::nullopt;
    std::uint64_t 基础 = 0, 总计 = 0;
    if (!安全乘(a, n, 基础) || !安全加(基础, *地板, 总计))
        return std::nullopt;
    const auto M = static_cast<std::uint64_t>(根值上界_v1);
    return 累计减少_v1{总计 > M ? 根值上界_v1
        : static_cast<std::int64_t>(总计), 总计 > M};
}

struct 服务推进_v1 final {
    std::int64_t 后值 = 0;
    累计减少_v1 请求减少{};
    std::int64_t 保护下界 = 0;
    服务被动维护分支_v1 分支 = 服务被动维护分支_v1::无需求每秒一;
};

inline std::optional<服务推进_v1> 计算服务推进(
    const 本能被动维护有限事实段_v1& 段,
    std::int64_t 起始秒, std::uint64_t 秒数,
    std::int64_t 前值) noexcept {
    if (秒数 == 0 || 前值 < 0 || 前值 > 根值上界_v1) return std::nullopt;
    服务推进_v1 结果;
    结果.保护下界 = 段.活动裁决 == 服务活动裁决_v1::存在 && 前值 > 0
        ? 1 : 0;
    const bool 三十天 = 段.需求来源形态
            == 本能批量维护需求来源形态_v1::同秒到期未满足事件
        || (段.需求来源形态 == 本能批量维护需求来源形态_v1::最长未满足合同
            && 段.最长需求提出完整秒边界
            && 起始秒 - *段.最长需求提出完整秒边界
                >= 服务观察窗完整秒_v1);
    if (三十天) {
        if (段.活动裁决 == 服务活动裁决_v1::存在) {
            if (前值 == 0) {
                结果.后值 = 0;
                结果.分支 = 服务被动维护分支_v1::三十天门禁活动零保持;
            } else {
                结果.后值 = 1;
                结果.分支 = 服务被动维护分支_v1::三十天门禁最低一;
            }
        } else {
            结果.后值 = 0;
            结果.分支 = 服务被动维护分支_v1::三十天门禁归零;
        }
        结果.请求减少 = {前值 - 结果.后值, false};
        return 结果;
    }
    const auto 请求减少 = 计算累计请求减少(段, 起始秒, 秒数);
    if (!请求减少) return std::nullopt;
    结果.请求减少 = *请求减少;
    结果.后值 = 请求减少->饱和值 >= 前值
        ? 0 : 前值 - 请求减少->饱和值;
    if (结果.保护下界 == 1 && 结果.后值 == 0) 结果.后值 = 1;
    结果.分支 = 段.需求来源形态
            == 本能批量维护需求来源形态_v1::无有效未满足且无到期事件
        ? 服务被动维护分支_v1::无需求每秒一
        : 服务被动维护分支_v1::最长等待衰减;
    return 结果;
}

inline std::uint64_t 同一需求分支剩余秒数(
    const 本能被动维护有限事实段_v1& 段,
    std::int64_t 当前秒, std::uint64_t 段剩余) noexcept {
    if (段.需求来源形态 != 本能批量维护需求来源形态_v1::最长未满足合同
        || !段.最长需求提出完整秒边界)
        return 段剩余;
    const auto t = 当前秒 - *段.最长需求提出完整秒边界;
    if (t >= 服务观察窗完整秒_v1) return 段剩余;
    const auto 到门禁 = static_cast<std::uint64_t>(服务观察窗完整秒_v1 - t);
    return (std::min)(段剩余, 到门禁);
}

inline 本能单完整秒被动维护请求_v1 形成单秒请求(
    const 本能多完整秒被动维护请求_v1& 批量,
    const 本能被动维护有限事实段_v1& 段,
    std::int64_t 当前秒, std::int64_t 服务前值,
    std::int64_t 安全前值) noexcept {
    本能单完整秒被动维护请求_v1 请求;
    请求.服务值前值 = 服务前值;
    请求.生存安全根前值 = 安全前值;
    请求.低位阈值 = 批量.低位阈值;
    请求.高位阈值 = 批量.高位阈值;
    请求.安全根定义版本 = 批量.安全根定义版本;
    请求.服务时间维护规则版本 = 批量.服务时间维护规则版本;
    请求.生存安全回归规则版本 = 批量.生存安全回归规则版本;
    请求.活动裁决 = 段.活动裁决;
    请求.主动安全裁决 = 同秒主动安全裁决_v1::未改变A;
    if (段.需求来源形态
        == 本能批量维护需求来源形态_v1::无有效未满足且无到期事件) {
        请求.需求裁决 = 服务维护需求裁决_v1::无有效未满足且无到期事件;
    } else if (段.需求来源形态
        == 本能批量维护需求来源形态_v1::同秒到期未满足事件) {
        请求.需求裁决 = 服务维护需求裁决_v1::三十天门禁已成立;
        请求.本秒到期未满足事件数量 = 段.同秒到期未满足事件数量;
    } else {
        const auto 等待 = 当前秒 - *段.最长需求提出完整秒边界;
        请求.有效未满足需求数量 = 1;
        请求.最长等待完整秒 = 等待;
        请求.需求裁决 = 等待 >= 服务观察窗完整秒_v1
            ? 服务维护需求裁决_v1::三十天门禁已成立
            : 服务维护需求裁决_v1::存在未满观察窗需求;
    }
    std::int64_t 服务后值 = 0;
    服务被动维护分支_v1 分支{};
    if (计算服务衰减(请求, 服务后值, 分支)
        && 安全前值 != 0 && 服务后值 > 0 && 安全前值 < 批量.低位阈值)
        请求.低位回升门禁 = 段.低位回升门禁材料;
    return 请求;
}

} // namespace 海中鱼巣::本能单完整秒被动维护内部

export namespace 海中鱼巣 {

本能单完整秒被动维护结果_v1 计算本能单完整秒被动维护候选_v1(
    const 本能单完整秒被动维护请求_v1& 请求) noexcept {
    using namespace 本能单完整秒被动维护内部;
    if (请求.合同版本 != 本能单完整秒被动维护合同版本_v1
        || 请求.服务值前值 < 0 || 请求.服务值前值 > 根值上界_v1
        || 请求.生存安全根前值 < 0 || 请求.生存安全根前值 > 根值上界_v1
        || !(1 < 请求.低位阈值 && 请求.低位阈值 < 请求.高位阈值
            && 请求.高位阈值 <= 根值上界_v1)
        || 请求.安全根定义版本 == 0 || !需求形状有效(请求)
        || !有效枚举(请求.活动裁决) || !有效枚举(请求.主动安全裁决)
        || !有效枚举(请求.低位回升门禁))
        return 失败(本能单完整秒被动维护状态_v1::入口拒绝);
    if (请求.服务时间维护规则版本 != 服务时间维护规则版本_v1
        || 请求.生存安全回归规则版本 != 生存安全回归规则版本_v1)
        return 失败(本能单完整秒被动维护状态_v1::版本漂移);

    std::int64_t 服务后值 = 0;
    服务被动维护分支_v1 服务分支{};
    if (!计算服务衰减(请求, 服务后值, 服务分支))
        return 失败(本能单完整秒被动维护状态_v1::算术拒绝);
    const auto 服务比例 = 计算服务比例(服务后值);
    std::int64_t 安全后值 = 请求.生存安全根前值;
    生存安全被动回归分支_v1 安全分支{};
    const bool 低位回升实际适用 = 请求.生存安全根前值 != 0
        && 请求.主动安全裁决 == 同秒主动安全裁决_v1::未改变A
        && 服务后值 > 0 && 请求.生存安全根前值 < 请求.低位阈值;
    if (低位回升实际适用) {
        if (请求.低位回升门禁 == 安全低位回升门禁_v1::不适用)
            return 失败(本能单完整秒被动维护状态_v1::入口拒绝);
    } else if (请求.低位回升门禁 != 安全低位回升门禁_v1::不适用) {
        return 失败(本能单完整秒被动维护状态_v1::入口拒绝);
    }

    if (请求.生存安全根前值 == 0) {
        安全后值 = 0;
        安全分支 = 生存安全被动回归分支_v1::终止保持;
    } else if (请求.主动安全裁决 == 同秒主动安全裁决_v1::已改变A) {
        安全分支 = 生存安全被动回归分支_v1::主动安全优先;
    } else if (服务后值 == 0) {
        安全后值 = 1;
        安全分支 = 生存安全被动回归分支_v1::服务为零收敛休眠;
    } else if (请求.生存安全根前值 < 请求.低位阈值) {
        if (请求.低位回升门禁 == 安全低位回升门禁_v1::材料不足)
            return 失败(本能单完整秒被动维护状态_v1::材料不足);
        if (请求.低位回升门禁 == 安全低位回升门禁_v1::禁止) {
            安全分支 = 生存安全被动回归分支_v1::低位禁止保持;
        } else {
            const auto 距离 = 请求.低位阈值 - 请求.生存安全根前值;
            const auto 基础 = 距离 / 100;
            if (服务比例 != 0 && 基础 > 根值上界_v1 / 服务比例)
                return 失败(本能单完整秒被动维护状态_v1::算术拒绝);
            const auto 步长 = (std::max)(std::int64_t{1}, 基础 * 服务比例);
            安全后值 = 步长 >= 距离
                ? 请求.低位阈值 : 请求.生存安全根前值 + 步长;
            安全分支 = 生存安全被动回归分支_v1::低位回升;
        }
    } else if (请求.生存安全根前值 <= 请求.高位阈值) {
        安全分支 = 生存安全被动回归分支_v1::闭区间保持;
    } else {
        const auto 距离 = 请求.生存安全根前值 - 请求.高位阈值;
        const auto 减少比例 = std::int64_t{100} - 服务比例;
        const auto 基础 = 距离 / 100;
        if (减少比例 != 0 && 基础 > 根值上界_v1 / 减少比例)
            return 失败(本能单完整秒被动维护状态_v1::算术拒绝);
        const auto 步长 = (std::max)(std::int64_t{1}, 基础 * 减少比例);
        安全后值 = 步长 >= 距离
            ? 请求.高位阈值 : 请求.生存安全根前值 - 步长;
        安全分支 = 生存安全被动回归分支_v1::高位回落;
    }

    本能单完整秒被动维护载荷_v1 载荷;
    载荷.服务值前值 = 请求.服务值前值;
    载荷.服务值后值 = 服务后值;
    载荷.服务实际减少 = 请求.服务值前值 - 服务后值;
    载荷.服务比例 = 服务比例;
    载荷.生存安全根前值 = 请求.生存安全根前值;
    载荷.生存安全根后值 = 安全后值;
    载荷.生存安全有符号变化 = 安全后值 - 请求.生存安全根前值;
    载荷.低位阈值 = 请求.低位阈值;
    载荷.高位阈值 = 请求.高位阈值;
    载荷.服务分支 = 服务分支;
    载荷.安全分支 = 安全分支;
    载荷.活动裁决 = 请求.活动裁决;
    载荷.主动安全裁决 = 请求.主动安全裁决;
    载荷.低位回升门禁 = 请求.低位回升门禁;
    载荷.安全根定义版本 = 请求.安全根定义版本;
    载荷.服务时间维护规则版本 = 请求.服务时间维护规则版本;
    载荷.生存安全回归规则版本 = 请求.生存安全回归规则版本;
    if (!本能单完整秒被动维护载荷完整_v1(载荷))
        return 失败(本能单完整秒被动维护状态_v1::内部错误);
    return {本能单完整秒被动维护合同版本_v1,
        本能单完整秒被动维护状态_v1::已形成, 载荷};
}

本能多完整秒被动维护结果_v1 计算本能多完整秒被动维护候选_v1(
    const 本能多完整秒被动维护请求_v1& 请求) noexcept {
    using namespace 本能单完整秒被动维护内部;
    try {
        if (请求.合同版本 != 本能多完整秒被动维护合同版本_v1
            || 请求.运行代次 == 0 || 请求.时间纪元身份 == 0
            || 请求.排除起始完整秒边界 < 0
            || 请求.包含结束完整秒边界 < 请求.排除起始完整秒边界
            || 请求.服务值前值 < 0 || 请求.服务值前值 > 根值上界_v1
            || 请求.生存安全根前值 < 0
            || 请求.生存安全根前值 > 根值上界_v1
            || !(1 < 请求.低位阈值 && 请求.低位阈值 < 请求.高位阈值
                && 请求.高位阈值 <= 根值上界_v1)
            || 请求.安全根定义版本 == 0 || 请求.时间规则版本 == 0
            || 请求.完整有序事实段组.size() > 本能批量最大输入事实段数_v1)
            return 批量失败(本能多完整秒被动维护状态_v1::入口拒绝);
        if (请求.主动安全结算规则版本 != 1
            || 请求.安全根定义版本 != 1
            || 请求.低位阈值 != 安全根定义版本一低位阈值
            || 请求.高位阈值 != 安全根定义版本一高位阈值
            || 请求.服务时间维护规则版本 != 服务时间维护规则版本_v1
            || 请求.生存安全回归规则版本 != 生存安全回归规则版本_v1)
            return 批量失败(本能多完整秒被动维护状态_v1::版本漂移);
        if (请求.排除起始完整秒边界 == 请求.包含结束完整秒边界) {
            if (!请求.完整有序事实段组.empty())
                return 批量失败(本能多完整秒被动维护状态_v1::分段不闭合);
            本能多完整秒被动维护载荷_v1 载荷{
                请求.服务值前值, 请求.服务值前值,
                请求.生存安全根前值, 请求.生存安全根前值,
                请求.排除起始完整秒边界, 请求.包含结束完整秒边界, {}};
            return 本能多完整秒被动维护载荷完整_v1(载荷)
                ? 本能多完整秒被动维护结果_v1{
                    本能多完整秒被动维护合同版本_v1,
                    本能多完整秒被动维护状态_v1::无完整秒, std::move(载荷)}
                : 批量失败(本能多完整秒被动维护状态_v1::内部错误);
        }
        if (请求.完整有序事实段组.empty())
            return 批量失败(本能多完整秒被动维护状态_v1::分段不闭合);
        if (请求.最大输出审计段数 == 0)
            return 批量失败(本能多完整秒被动维护状态_v1::输出预算不足);
        std::int64_t 期望起始 = 请求.排除起始完整秒边界 + 1;
        for (std::size_t i = 0; i < 请求.完整有序事实段组.size(); ++i) {
            const auto& 段 = 请求.完整有序事实段组[i];
            if (!事实段形状有效(段) || 段.起始完整秒边界 != 期望起始)
                return 批量失败(本能多完整秒被动维护状态_v1::分段不闭合);
            for (std::size_t j = 0; j < i; ++j)
                if (请求.完整有序事实段组[j].事实分段键 == 段.事实分段键)
                    return 批量失败(本能多完整秒被动维护状态_v1::分段不闭合);
            if (i != 0 && 相邻事实段可合并(请求.完整有序事实段组[i - 1], 段))
                return 批量失败(本能多完整秒被动维护状态_v1::分段不闭合);
            if (段.结束完整秒边界 == 根值上界_v1) {
                if (i + 1 != 请求.完整有序事实段组.size())
                    return 批量失败(本能多完整秒被动维护状态_v1::分段不闭合);
            } else {
                期望起始 = 段.结束完整秒边界 + 1;
            }
        }
        if (请求.完整有序事实段组.back().结束完整秒边界
            != 请求.包含结束完整秒边界)
            return 批量失败(本能多完整秒被动维护状态_v1::分段不闭合);

        本能多完整秒被动维护载荷_v1 载荷;
        载荷.服务值前值 = 请求.服务值前值;
        载荷.生存安全根前值 = 请求.生存安全根前值;
        载荷.排除起始完整秒边界 = 请求.排除起始完整秒边界;
        载荷.包含结束完整秒边界 = 请求.包含结束完整秒边界;
        载荷.规范审计段组.reserve(static_cast<std::size_t>((std::min)(
            请求.最大输出审计段数,
            static_cast<std::uint64_t>(本能批量最大输入事实段数_v1) * 100U)));
        std::int64_t 当前服务值 = 请求.服务值前值;
        std::int64_t 当前安全值 = 请求.生存安全根前值;

        for (const auto& 事实段 : 请求.完整有序事实段组) {
            std::int64_t 当前秒 = 事实段.起始完整秒边界;
            while (当前秒 <= 事实段.结束完整秒边界) {
                const auto 段剩余 = static_cast<std::uint64_t>(
                    事实段.结束完整秒边界 - 当前秒) + 1;
                const auto 分支剩余 = 同一需求分支剩余秒数(事实段, 当前秒, 段剩余);
                const auto 首秒服务 = 计算服务推进(事实段, 当前秒, 1, 当前服务值);
                if (!首秒服务)
                    return 批量失败(本能多完整秒被动维护状态_v1::算术拒绝);
                const auto 固定比例 = 计算服务比例(首秒服务->后值);
                std::uint64_t 左 = 1, 右 = 分支剩余;
                while (左 < 右) {
                    const auto 中 = 左 + (右 - 左 + 1) / 2;
                    const auto 推进 = 计算服务推进(事实段, 当前秒, 中, 当前服务值);
                    if (!推进)
                        return 批量失败(本能多完整秒被动维护状态_v1::算术拒绝);
                    if (计算服务比例(推进->后值) == 固定比例) 左 = 中;
                    else 右 = 中 - 1;
                }
                const auto 同比例最大秒数 = 左;

                const auto 首秒请求 = 形成单秒请求(
                    请求, 事实段, 当前秒, 当前服务值, 当前安全值);
                const auto 首秒结果 = 计算本能单完整秒被动维护候选_v1(首秒请求);
                if (!首秒结果.成功()) {
                    if (首秒结果.状态 == 本能单完整秒被动维护状态_v1::材料不足)
                        return 批量失败(本能多完整秒被动维护状态_v1::材料不足);
                    if (首秒结果.状态 == 本能单完整秒被动维护状态_v1::算术拒绝)
                        return 批量失败(本能多完整秒被动维护状态_v1::算术拒绝);
                    return 批量失败(本能多完整秒被动维护状态_v1::内部错误);
                }
                const auto 首载荷 = *首秒结果.载荷;
                std::uint64_t 本审计秒数 = 同比例最大秒数;
                std::int64_t 审计安全后值 = 当前安全值;
                const bool 安全分支恒定 =
                    首载荷.安全分支 == 生存安全被动回归分支_v1::终止保持
                    || 首载荷.安全分支 == 生存安全被动回归分支_v1::低位禁止保持
                    || 首载荷.安全分支 == 生存安全被动回归分支_v1::闭区间保持
                    || (首载荷.安全分支
                            == 生存安全被动回归分支_v1::服务为零收敛休眠
                        && 首载荷.生存安全根后值 == 当前安全值);
                if (安全分支恒定) {
                    审计安全后值 = 当前安全值;
                } else {
                    const auto 最大模拟 = (std::min)(同比例最大秒数,
                        static_cast<std::uint64_t>(
                            本能批量单比例安全收敛最大步数_v1));
                    std::int64_t 模拟服务 = 当前服务值;
                    std::int64_t 模拟安全 = 当前安全值;
                    本审计秒数 = 0;
                    for (std::uint64_t i = 0; i < 最大模拟; ++i) {
                        const auto 秒 = 当前秒 + static_cast<std::int64_t>(i);
                        const auto 单请求 = 形成单秒请求(
                            请求, 事实段, 秒, 模拟服务, 模拟安全);
                        const auto 单结果 = 计算本能单完整秒被动维护候选_v1(单请求);
                        if (!单结果.成功()) {
                            if (单结果.状态
                                == 本能单完整秒被动维护状态_v1::材料不足)
                                return 批量失败(
                                    本能多完整秒被动维护状态_v1::材料不足);
                            return 批量失败(
                                单结果.状态 == 本能单完整秒被动维护状态_v1::算术拒绝
                                    ? 本能多完整秒被动维护状态_v1::算术拒绝
                                    : 本能多完整秒被动维护状态_v1::内部错误);
                        }
                        const auto& 单载荷 = *单结果.载荷;
                        if (i != 0 && 单载荷.安全分支 != 首载荷.安全分支) break;
                        const auto 前一安全 = 模拟安全;
                        模拟服务 = 单载荷.服务值后值;
                        模拟安全 = 单载荷.生存安全根后值;
                        ++本审计秒数;
                        if ((前一安全 != 0 && 模拟安全 == 0)
                            || (前一安全 != 1 && 模拟安全 == 1)
                            || (前一安全 != 请求.低位阈值
                                && 模拟安全 == 请求.低位阈值)
                            || (前一安全 != 请求.高位阈值
                                && 模拟安全 == 请求.高位阈值))
                            break;
                    }
                    if (本审计秒数 == 0)
                        return 批量失败(本能多完整秒被动维护状态_v1::内部错误);
                    if (本审计秒数 == 最大模拟 && 最大模拟 < 同比例最大秒数
                        && 模拟安全 != 请求.低位阈值
                        && 模拟安全 != 请求.高位阈值
                        && 模拟安全 != 0 && 模拟安全 != 1)
                        return 批量失败(本能多完整秒被动维护状态_v1::内部错误);
                    审计安全后值 = 模拟安全;
                }

                const auto 审计服务 = 计算服务推进(
                    事实段, 当前秒, 本审计秒数, 当前服务值);
                if (!审计服务 || 计算服务比例(审计服务->后值) != 固定比例)
                    return 批量失败(本能多完整秒被动维护状态_v1::内部错误);
                if (载荷.规范审计段组.size() >= 请求.最大输出审计段数)
                    return 批量失败(本能多完整秒被动维护状态_v1::输出预算不足);
                const auto 审计结束 = 当前秒
                    + static_cast<std::int64_t>(本审计秒数 - 1);
                本能被动维护批量审计段_v1 审计;
                审计.事实分段键 = 事实段.事实分段键;
                审计.运行代次 = 请求.运行代次;
                审计.时间纪元身份 = 请求.时间纪元身份;
                审计.起始完整秒边界 = 当前秒;
                审计.结束完整秒边界 = 审计结束;
                审计.完整秒数量 = 本审计秒数;
                审计.需求来源形态 = 事实段.需求来源形态;
                审计.最长需求提出完整秒边界 = 事实段.最长需求提出完整秒边界;
                审计.同秒到期未满足事件数量 =
                    事实段.同秒到期未满足事件数量;
                审计.服务值前值 = 当前服务值;
                审计.服务值后值 = 审计服务->后值;
                审计.服务请求减少饱和值 = 审计服务->请求减少.饱和值;
                审计.服务请求减少已饱和 = 审计服务->请求减少.已饱和;
                审计.服务实际减少 = 当前服务值 - 审计服务->后值;
                审计.服务保护下界 = 审计服务->保护下界;
                审计.服务比例 = 固定比例;
                审计.生存安全根前值 = 当前安全值;
                审计.生存安全根后值 = 审计安全后值;
                审计.生存安全有符号变化 = 审计安全后值 - 当前安全值;
                审计.服务分支 = 首载荷.服务分支;
                审计.安全分支 = 首载荷.安全分支;
                审计.活动裁决 = 事实段.活动裁决;
                审计.主动安全裁决 = 同秒主动安全裁决_v1::未改变A;
                审计.低位回升门禁 = 首载荷.低位回升门禁;
                审计.安全根定义版本 = 请求.安全根定义版本;
                审计.服务时间维护规则版本 = 请求.服务时间维护规则版本;
                审计.生存安全回归规则版本 = 请求.生存安全回归规则版本;
                审计.时间规则版本 = 请求.时间规则版本;
                审计.跳跃等价证明版本 = 本能批量跳跃等价证明版本_v1;
                if (!本能被动维护批量审计段完整_v1(审计))
                    return 批量失败(本能多完整秒被动维护状态_v1::内部错误);
                载荷.规范审计段组.push_back(std::move(审计));
                当前服务值 = 审计服务->后值;
                当前安全值 = 审计安全后值;
                if (审计结束 == 根值上界_v1) break;
                当前秒 = 审计结束 + 1;
            }
        }
        载荷.服务值后值 = 当前服务值;
        载荷.生存安全根后值 = 当前安全值;
        if (!本能多完整秒被动维护载荷完整_v1(载荷))
            return 批量失败(本能多完整秒被动维护状态_v1::内部错误);
        return {本能多完整秒被动维护合同版本_v1,
            本能多完整秒被动维护状态_v1::已形成, std::move(载荷)};
    } catch (const std::bad_alloc&) {
        return 批量失败(本能多完整秒被动维护状态_v1::输出预算不足);
    } catch (const std::length_error&) {
        return 批量失败(本能多完整秒被动维护状态_v1::输出预算不足);
    } catch (...) {
        return 批量失败(本能多完整秒被动维护状态_v1::内部错误);
    }
}

} // namespace 海中鱼巣
