// 文件规则：本模块只计算一个完整秒的服务值与生存安全根候选，不读取或写入任何事实。
module;

#include <algorithm>
#include <cstdint>
#include <limits>
#include <optional>

#define INSTINCT_SINGLE_COMPLETE_SECOND_MAINTENANCE_NO_INCLUDES

export module 海中鱼巣.领域.算法.本能单完整秒被动维护;

export {
#include "本能单完整秒被动维护.数据.h"
}

namespace 海中鱼巣::本能单完整秒被动维护内部 {

inline 本能单完整秒被动维护结果_v1 失败(
    本能单完整秒被动维护状态_v1 状态) noexcept {
    return {本能单完整秒被动维护合同版本_v1, 状态, std::nullopt};
}

inline bool 有效枚举(服务活动裁决_v1 值) noexcept {
    return 值 == 服务活动裁决_v1::不存在 || 值 == 服务活动裁决_v1::存在;
}
inline bool 有效枚举(同秒主动安全裁决_v1 值) noexcept {
    return 值 == 同秒主动安全裁决_v1::未改变A
        || 值 == 同秒主动安全裁决_v1::已改变A;
}
inline bool 有效枚举(安全低位回升门禁_v1 值) noexcept {
    return 值 == 安全低位回升门禁_v1::不适用
        || 值 == 安全低位回升门禁_v1::允许
        || 值 == 安全低位回升门禁_v1::禁止
        || 值 == 安全低位回升门禁_v1::材料不足;
}

inline bool 需求形状有效(const 本能单完整秒被动维护请求_v1& 请求) noexcept {
    switch (请求.需求裁决) {
    case 服务维护需求裁决_v1::无有效未满足且无到期事件:
        return 请求.有效未满足需求数量 == 0 && !请求.最长等待完整秒
            && 请求.本秒到期未满足事件数量 == 0;
    case 服务维护需求裁决_v1::存在未满观察窗需求:
        return 请求.有效未满足需求数量 != 0 && 请求.最长等待完整秒
            && *请求.最长等待完整秒 >= 0
            && *请求.最长等待完整秒 < 服务观察窗完整秒_v1
            && 请求.本秒到期未满足事件数量 == 0;
    case 服务维护需求裁决_v1::三十天门禁已成立: {
        const bool 需求形状 = 请求.有效未满足需求数量 == 0
            ? !请求.最长等待完整秒
            : 请求.最长等待完整秒 && *请求.最长等待完整秒 >= 0;
        const bool 门禁 = 请求.本秒到期未满足事件数量 != 0
            || (请求.最长等待完整秒
                && *请求.最长等待完整秒 >= 服务观察窗完整秒_v1);
        return 需求形状 && 门禁;
    }
    default: return false;
    }
}

inline bool 非负乘法(
    std::int64_t 左, std::int64_t 右, std::int64_t& 结果) noexcept {
    if (左 < 0 || 右 < 0 || (右 != 0 && 左 > 根值上界_v1 / 右)) return false;
    结果 = 左 * 右;
    return true;
}

inline bool 计算服务衰减(
    const 本能单完整秒被动维护请求_v1& 请求,
    std::int64_t& 后值,
    服务被动维护分支_v1& 分支) noexcept {
    if (请求.需求裁决 == 服务维护需求裁决_v1::三十天门禁已成立) {
        if (请求.活动裁决 == 服务活动裁决_v1::存在) {
            if (请求.服务值前值 == 0) {
                后值 = 0;
                分支 = 服务被动维护分支_v1::三十天门禁活动零保持;
            } else {
                后值 = 1;
                分支 = 服务被动维护分支_v1::三十天门禁最低一;
            }
        } else {
            后值 = 0;
            分支 = 服务被动维护分支_v1::三十天门禁归零;
        }
        return true;
    }
    std::int64_t 减少 = 1;
    if (请求.需求裁决 == 服务维护需求裁决_v1::存在未满观察窗需求) {
        std::int64_t 乘积 = 0;
        if (!请求.最长等待完整秒
            || !非负乘法(服务基础衰减_v1, *请求.最长等待完整秒, 乘积))
            return false;
        const auto 增量 = 乘积 / 服务观察窗完整秒_v1;
        if (服务基础衰减_v1 > 根值上界_v1 - 增量) return false;
        减少 = (std::max)(std::int64_t{1}, 服务基础衰减_v1 + 增量);
        分支 = 服务被动维护分支_v1::最长等待衰减;
    } else {
        分支 = 服务被动维护分支_v1::无需求每秒一;
    }
    const auto 饱和后 = 请求.服务值前值 <= 减少
        ? std::int64_t{0} : 请求.服务值前值 - 减少;
    后值 = 请求.活动裁决 == 服务活动裁决_v1::存在
            && 请求.服务值前值 > 0
        ? (std::max)(std::int64_t{1}, 饱和后) : 饱和后;
    return true;
}

inline std::int64_t 计算服务比例(std::int64_t 服务值) noexcept {
    return 服务值 == 0 ? 0
        : (std::min)(std::int64_t{99},
            std::int64_t{1} + 服务值 / 服务比例单位_v1);
}

} // namespace 海中鱼巣::本能单完整秒被动维护内部

export namespace 海中鱼巣 {

本能单完整秒被动维护结果_v1 计算本能单完整秒被动维护候选_v1(
    const 本能单完整秒被动维护请求_v1& 请求) noexcept {
    using namespace 本能单完整秒被动维护内部;
    if (请求.合同版本 != 本能单完整秒被动维护合同版本_v1
        || 请求.服务值前值 < 0 || 请求.服务值前值 > 根值上界_v1
        || 请求.生存安全根前值 < 0 || 请求.生存安全根前值 > 根值上界_v1
        || !(1 < 请求.低位阈值 && 请求.低位阈值 < 请求.高位阈值
            && 请求.高位阈值 <= 根值上界_v1)
        || 请求.安全根定义版本 == 0 || !需求形状有效(请求)
        || !有效枚举(请求.活动裁决) || !有效枚举(请求.主动安全裁决)
        || !有效枚举(请求.低位回升门禁))
        return 失败(本能单完整秒被动维护状态_v1::入口拒绝);
    if (请求.服务时间维护规则版本 != 服务时间维护规则版本_v1
        || 请求.生存安全回归规则版本 != 生存安全回归规则版本_v1)
        return 失败(本能单完整秒被动维护状态_v1::版本漂移);

    std::int64_t 服务后值 = 0;
    服务被动维护分支_v1 服务分支{};
    if (!计算服务衰减(请求, 服务后值, 服务分支))
        return 失败(本能单完整秒被动维护状态_v1::算术拒绝);
    const auto 服务比例 = 计算服务比例(服务后值);
    std::int64_t 安全后值 = 请求.生存安全根前值;
    生存安全被动回归分支_v1 安全分支{};
    const bool 低位回升实际适用 = 请求.生存安全根前值 != 0
        && 请求.主动安全裁决 == 同秒主动安全裁决_v1::未改变A
        && 服务后值 > 0 && 请求.生存安全根前值 < 请求.低位阈值;
    if (低位回升实际适用) {
        if (请求.低位回升门禁 == 安全低位回升门禁_v1::不适用)
            return 失败(本能单完整秒被动维护状态_v1::入口拒绝);
    } else if (请求.低位回升门禁 != 安全低位回升门禁_v1::不适用) {
        return 失败(本能单完整秒被动维护状态_v1::入口拒绝);
    }

    if (请求.生存安全根前值 == 0) {
        安全后值 = 0;
        安全分支 = 生存安全被动回归分支_v1::终止保持;
    } else if (请求.主动安全裁决 == 同秒主动安全裁决_v1::已改变A) {
        安全分支 = 生存安全被动回归分支_v1::主动安全优先;
    } else if (服务后值 == 0) {
        安全后值 = 1;
        安全分支 = 生存安全被动回归分支_v1::服务为零收敛休眠;
    } else if (请求.生存安全根前值 < 请求.低位阈值) {
        if (请求.低位回升门禁 == 安全低位回升门禁_v1::材料不足)
            return 失败(本能单完整秒被动维护状态_v1::材料不足);
        if (请求.低位回升门禁 == 安全低位回升门禁_v1::禁止) {
            安全分支 = 生存安全被动回归分支_v1::低位禁止保持;
        } else {
            const auto 距离 = 请求.低位阈值 - 请求.生存安全根前值;
            const auto 基础 = 距离 / 100;
            if (服务比例 != 0 && 基础 > 根值上界_v1 / 服务比例)
                return 失败(本能单完整秒被动维护状态_v1::算术拒绝);
            const auto 步长 = (std::max)(std::int64_t{1}, 基础 * 服务比例);
            安全后值 = 步长 >= 距离
                ? 请求.低位阈值 : 请求.生存安全根前值 + 步长;
            安全分支 = 生存安全被动回归分支_v1::低位回升;
        }
    } else if (请求.生存安全根前值 <= 请求.高位阈值) {
        安全分支 = 生存安全被动回归分支_v1::闭区间保持;
    } else {
        const auto 距离 = 请求.生存安全根前值 - 请求.高位阈值;
        const auto 减少比例 = std::int64_t{100} - 服务比例;
        const auto 基础 = 距离 / 100;
        if (减少比例 != 0 && 基础 > 根值上界_v1 / 减少比例)
            return 失败(本能单完整秒被动维护状态_v1::算术拒绝);
        const auto 步长 = (std::max)(std::int64_t{1}, 基础 * 减少比例);
        安全后值 = 步长 >= 距离
            ? 请求.高位阈值 : 请求.生存安全根前值 - 步长;
        安全分支 = 生存安全被动回归分支_v1::高位回落;
    }

    本能单完整秒被动维护载荷_v1 载荷;
    载荷.服务值前值 = 请求.服务值前值;
    载荷.服务值后值 = 服务后值;
    载荷.服务实际减少 = 请求.服务值前值 - 服务后值;
    载荷.服务比例 = 服务比例;
    载荷.生存安全根前值 = 请求.生存安全根前值;
    载荷.生存安全根后值 = 安全后值;
    载荷.生存安全有符号变化 = 安全后值 - 请求.生存安全根前值;
    载荷.低位阈值 = 请求.低位阈值;
    载荷.高位阈值 = 请求.高位阈值;
    载荷.服务分支 = 服务分支;
    载荷.安全分支 = 安全分支;
    载荷.活动裁决 = 请求.活动裁决;
    载荷.主动安全裁决 = 请求.主动安全裁决;
    载荷.低位回升门禁 = 请求.低位回升门禁;
    载荷.安全根定义版本 = 请求.安全根定义版本;
    载荷.服务时间维护规则版本 = 请求.服务时间维护规则版本;
    载荷.生存安全回归规则版本 = 请求.生存安全回归规则版本;
    if (!本能单完整秒被动维护载荷完整_v1(载荷))
        return 失败(本能单完整秒被动维护状态_v1::内部错误);
    return {本能单完整秒被动维护合同版本_v1,
        本能单完整秒被动维护状态_v1::已形成, 载荷};
}

} // namespace 海中鱼巣
