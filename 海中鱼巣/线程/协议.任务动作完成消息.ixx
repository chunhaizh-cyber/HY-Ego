// 文件规则：本协议只声明任务动作完成消息及其异步收束值合同；不写任务或 L2 权威事实。
module;

#include <cstdint>
#include <optional>

export module 海中鱼巣.线程.协议.任务动作完成消息;

import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2方法结构;

export import 海中鱼巣.领域.内部治理.服务.任务执行派发门控;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 任务动作完成消息合同版本 = 2;

struct 任务动作完成消息 final {
    std::uint32_t 合同版本 = 任务动作完成消息合同版本;
    稳定编码 执行幂等身份;
    L2任务身份 任务;
    L2任务轮次身份 任务轮次;
    L2任务筹办轮次权威记录身份 筹办轮次;
    L2任务执行轮次身份 执行轮次;
    L2任务执行冻结身份 冻结;
    std::uint64_t 冻结版本 = 0;
    L2实例方法身份 实例方法;
    L2方法身份 方法;
    L2方法内容版本 方法内容版本;
    std::uint64_t 动作顺序 = 0;
    std::uint64_t 运行代次 = 0;
    L2方法动作入口身份 动作入口;
    L2方法稳定动作键 稳定动作键;
    稳定编码 预期结果材料;
    稳定编码 结果验证合同;
    稳定编码 动作归因合同;
    std::uint64_t 动作开始时间 = 0;
    std::uint64_t 动作结束时间 = 0;
    任务动作结果候选定位 结果候选;
    friend bool operator==(const 任务动作完成消息&,
        const 任务动作完成消息&) = default;
};

inline bool 任务动作完成消息有效(
    const 任务动作完成消息& 消息) noexcept {
    return 消息.合同版本 == 任务动作完成消息合同版本
        && 有效(消息.执行幂等身份) && 有效(消息.任务.值)
        && 有效(消息.任务轮次.值) && 有效(消息.筹办轮次.值)
        && 有效(消息.执行轮次.值) && 有效(消息.冻结.值)
        && 消息.冻结版本 != 0 && 有效(消息.实例方法.值)
        && 有效(消息.方法.值)
        && L2方法内容版本有效(消息.方法内容版本)
        && 消息.动作顺序 != 0 && 消息.运行代次 != 0
        && 有效(消息.动作入口.值)
        && L2方法稳定动作键有效(消息.稳定动作键)
        && 有效(消息.预期结果材料) && 有效(消息.结果验证合同)
        && 有效(消息.动作归因合同)
        && 消息.动作开始时间 != 0
        && 消息.动作结束时间 >= 消息.动作开始时间
        && 任务动作结果候选定位有效(消息.结果候选);
}

inline bool 任务动作完成消息完整(
    const 任务动作完成消息& 消息) noexcept {
    return 任务动作完成消息有效(消息);
}

enum class 任务动作完成消息状态 : std::uint8_t {
    已发布 = 1,
    精确重复 = 2,
    已独立读取 = 3,
    未找到 = 4,
    幂等冲突 = 5,
    入口拒绝 = 6,
    资源失败 = 7,
    内部错误 = 8
};

struct 任务动作完成消息结果 final {
    任务动作完成消息状态 状态 = 任务动作完成消息状态::入口拒绝;
    std::optional<任务动作完成消息> 消息;
    bool 成功() const noexcept {
        return (状态 == 任务动作完成消息状态::已发布
                || 状态 == 任务动作完成消息状态::精确重复
                || 状态 == 任务动作完成消息状态::已独立读取)
            && 消息.has_value() && 任务动作完成消息有效(*消息);
    }
};

class 任务动作完成消息端口 {
public:
    virtual ~任务动作完成消息端口() = default;
    virtual 任务动作完成消息结果 发布或读取动作完成消息(
        const 任务动作完成消息&) noexcept = 0;
    virtual 任务动作完成消息结果 读取动作完成消息(
        稳定编码 执行幂等身份,
        std::uint64_t 运行代次,
        std::uint64_t 动作顺序) const noexcept = 0;
};

enum class 任务动作归因缺口原因 : std::uint8_t {
    当前选择缺失 = 1,
    当前选择异义 = 2,
    状态缺失 = 3,
    动态缺失 = 4,
    主体缺失 = 5,
    场景缺失 = 6,
    状态主体不符 = 7,
    动态主体不符 = 8,
    动态后态不符 = 9,
    动态来源不符 = 10,
    验证合同不满足 = 11,
    归因合同不满足 = 12
};

struct 任务动作归因缺口定位 final {
    稳定编码 执行幂等身份;
    std::uint64_t 动作顺序 = 0;
    L2方法动作入口身份 动作入口;
    L2方法稳定动作键 稳定动作键;
    任务动作结果候选定位 候选;
    std::uint64_t 事实截止代次 = 0;
    任务动作归因缺口原因 原因 =
        任务动作归因缺口原因::当前选择缺失;
    friend bool operator==(const 任务动作归因缺口定位&,
        const 任务动作归因缺口定位&) = default;
};

struct 任务工作结果定位 final {
    std::uint32_t 合同版本 = 1;
    稳定编码 执行幂等身份;
    L2任务身份 任务;
    L2任务轮次身份 任务轮次;
    L2任务筹办轮次权威记录身份 筹办轮次;
    L2任务执行轮次身份 执行轮次;
    L2任务执行冻结身份 冻结;
    std::uint64_t 冻结版本 = 0;
    L2实例方法身份 实例方法;
    L2方法身份 方法;
    L2方法内容版本 方法内容版本;
    std::uint64_t 最后动作顺序 = 0;
    std::uint64_t worker观察截止 = 0;
    std::uint64_t 运行代次 = 0;
    friend bool operator==(const 任务工作结果定位&,
        const 任务工作结果定位&) = default;
};

inline bool 任务工作结果定位有效(
    const 任务工作结果定位& 定位) noexcept {
    return 定位.合同版本 == 1 && 有效(定位.执行幂等身份)
        && 有效(定位.任务.值) && 有效(定位.任务轮次.值)
        && 有效(定位.筹办轮次.值) && 有效(定位.执行轮次.值)
        && 有效(定位.冻结.值) && 定位.冻结版本 != 0
        && 有效(定位.实例方法.值) && 有效(定位.方法.值)
        && L2方法内容版本有效(定位.方法内容版本)
        && 定位.最后动作顺序 != 0 && 定位.worker观察截止 != 0
        && 定位.运行代次 != 0;
}

enum class 任务动作结果收束状态 : std::uint8_t {
    已形成 = 1,
    精确重复 = 2,
    动作消息等待 = 3,
    权威结果等待 = 4,
    归因不足 = 5,
    当前性漂移 = 6,
    引用冲突 = 7,
    入口拒绝 = 8,
    资源失败 = 9,
    内部错误 = 10
};

struct 任务动作结果收束结果 final {
    任务动作结果收束状态 状态 = 任务动作结果收束状态::入口拒绝;
    std::optional<任务工作结果定位> 工作结果定位;
    std::optional<任务动作归因缺口定位> 归因缺口;
    bool 成功() const noexcept {
        return (状态 == 任务动作结果收束状态::已形成
                || 状态 == 任务动作结果收束状态::精确重复)
            && 工作结果定位.has_value() && !归因缺口.has_value();
    }
};

enum class 任务工作结果槽状态 : std::uint8_t {
    已接收 = 1,
    精确重复 = 2,
    已取出 = 3,
    未找到 = 4,
    幂等冲突 = 5,
    入口拒绝 = 6,
    资源失败 = 7,
    内部错误 = 8
};

struct 任务工作结果槽结果 final {
    任务工作结果槽状态 状态 = 任务工作结果槽状态::入口拒绝;
    std::optional<任务工作结果定位> 工作结果定位;
    bool 成功() const noexcept {
        return (状态 == 任务工作结果槽状态::已接收
                || 状态 == 任务工作结果槽状态::精确重复
                || 状态 == 任务工作结果槽状态::已取出)
            && 工作结果定位.has_value();
    }
};

} // namespace 海中鱼巣
