export namespace 海中鱼巣 {

enum class 任务管理线程状态 : std::uint32_t {
    未启动 = 0,
    运行中 = 1,
    正在停止 = 2,
    已停止 = 3,
    启动失败 = 4
};

enum class 任务管理线程拒绝原因 : std::uint32_t {
    无 = 0,
    重复启动 = 1,
    队列容量为零 = 2,
    未启动 = 3,
    停止消息失败 = 4,
    非任务执行请求 = 5,
    请求入队失败 = 6,
    线程创建失败 = 7
};

struct 任务管理线程操作结果 {
    bool 成功 = false;
    bool 局部失败 = true;
    bool 写业务事实 = false;
    任务管理线程拒绝原因 拒绝原因 = 任务管理线程拒绝原因::无;
};

enum class 强类型任务执行请求队列状态 : std::uint8_t {
    已拒绝 = 0,
    已预留 = 1,
    已确认 = 2,
    已撤销 = 3,
    已取出 = 4,
    精确重复 = 5,
    无请求 = 6,
    内部不一致 = 7
};

enum class 强类型任务执行请求队列拒绝原因 : std::uint8_t {
    无 = 0,
    请求无效 = 1,
    管理线程未运行 = 2,
    队列已停止 = 3,
    容量为零 = 4,
    队列已满 = 5,
    请求已过期 = 6,
    请求编号冲突 = 7,
    幂等键冲突 = 8,
    任务序号倒退 = 9,
    任务序号冲突 = 10,
    候选能力无效 = 11,
    候选状态冲突 = 12
};

class 任务管理线程;

class 强类型任务执行请求候选 final {
public:
    强类型任务执行请求候选() = delete;
    强类型任务执行请求候选(const 强类型任务执行请求候选&) = delete;
    强类型任务执行请求候选& operator=(const 强类型任务执行请求候选&) = delete;

    强类型任务执行请求候选(强类型任务执行请求候选&& 其他) noexcept;
    强类型任务执行请求候选& operator=(强类型任务执行请求候选&& 其他) noexcept;
    ~强类型任务执行请求候选();

    bool 有效() const noexcept {
        return 所有者_ != nullptr && 请求编号_ != 0 && 预留代次_ != 0 && !已决定_;
    }

    std::uint64_t 读取请求编号() const noexcept { return 请求编号_; }
    std::uint64_t 读取预留代次() const noexcept { return 预留代次_; }

private:
    friend class 任务管理线程;

    强类型任务执行请求候选(
        任务管理线程* 所有者,
        std::uint64_t 请求编号,
        std::uint64_t 预留代次) noexcept
        : 所有者_(所有者), 请求编号_(请求编号), 预留代次_(预留代次) {
    }

    void 置为已决定() noexcept {
        所有者_ = nullptr;
        请求编号_ = 0;
        预留代次_ = 0;
        已决定_ = true;
    }

    任务管理线程* 所有者_ = nullptr;
    std::uint64_t 请求编号_ = 0;
    std::uint64_t 预留代次_ = 0;
    bool 已决定_ = false;
};

struct 强类型任务执行请求准备结果 {
    强类型任务执行请求队列状态 状态 = 强类型任务执行请求队列状态::已拒绝;
    强类型任务执行请求队列拒绝原因 拒绝原因 =
        强类型任务执行请求队列拒绝原因::无;
    std::optional<强类型任务执行请求候选> 候选;
};

struct 强类型任务执行请求操作结果 {
    强类型任务执行请求队列状态 状态 = 强类型任务执行请求队列状态::已拒绝;
    强类型任务执行请求队列拒绝原因 拒绝原因 =
        强类型任务执行请求队列拒绝原因::无;

    bool 成功() const noexcept {
        return 状态 == 强类型任务执行请求队列状态::已确认
            || 状态 == 强类型任务执行请求队列状态::已撤销;
    }
};

struct 强类型任务执行请求取出结果 {
    强类型任务执行请求队列状态 状态 = 强类型任务执行请求队列状态::无请求;
    bool 队列已停止 = false;
    std::optional<任务执行冻结请求> 请求;
};

struct 强类型任务执行请求队列快照 {
    std::uint64_t 容量 = 0;
    std::uint64_t 预留数量 = 0;
    std::uint64_t 可消费数量 = 0;
    std::uint64_t 已见请求数量 = 0;
    std::uint64_t 已见幂等键数量 = 0;
    std::uint64_t 同任务顺序数量 = 0;
    bool 已停止 = false;
};

enum class 任务结果回执提交状态 : std::uint8_t {
    已接收 = 1,
    精确重复 = 2,
    已拒绝 = 3,
    内部错误 = 4
};

enum class 任务结果回执提交拒绝原因 : std::uint8_t {
    无 = 0,
    结果上行未配置 = 1,
    管理线程未运行 = 2,
    结果上行已停止 = 3,
    回执协议拒绝 = 4,
    回执幂等冲突 = 5,
    来源任务序号拒绝 = 6,
    结果上行队列已满 = 7,
    内部状态冲突 = 8
};

struct 任务结果回执提交结果 final {
    任务结果回执提交状态 状态 = 任务结果回执提交状态::已拒绝;
    任务结果回执提交拒绝原因 拒绝原因 =
        任务结果回执提交拒绝原因::无;
    任务结果回执拒绝原因 协议拒绝原因 = 任务结果回执拒绝原因::无;

    bool 成功() const noexcept {
        return 状态 == 任务结果回执提交状态::已接收
            || 状态 == 任务结果回执提交状态::精确重复;
    }
};

enum class 任务结果上行槽阶段 : std::uint8_t {
    待发布正式结果 = 1,
    待独立读回 = 2,
    治理消息待提交 = 3,
    已提交 = 4,
    精确重复 = 5,
    合法等待 = 6,
    当前性漂移 = 7,
    引用冲突 = 8,
    入口拒绝 = 9,
    数量预算不足 = 10,
    资源等待 = 11,
    内部终止 = 12
};

struct 任务结果上行槽快照 final {
    任务结果上行槽阶段 阶段 = 任务结果上行槽阶段::待发布正式结果;
    std::uint64_t 回执幂等键 = 0;
    std::uint64_t 回执编号 = 0;
    std::uint64_t 来源任务序号 = 0;
    L2任务身份 任务;
    std::uint64_t 正式执行轮次 = 0;
    std::uint64_t 事实截止G1 = 0;
    std::uint64_t 结果发布尝试次数 = 0;
    std::uint64_t 独立读回尝试次数 = 0;
    std::uint64_t 邮箱提交尝试次数 = 0;
    std::optional<L2任务实际结果事实> 正式结果;
    std::optional<自我治理消息> 治理消息;
    std::uint64_t 复用槽幂等键 = 0;
};

enum class 任务重筹办处理槽阶段 : std::uint8_t {
    待处理 = 1,
    资源等待 = 2,
    合法等待 = 3,
    已形成 = 4,
    精确重复 = 5,
    当前性漂移 = 6,
    引用冲突 = 7,
    入口拒绝 = 8,
    内部终止 = 9,
    待当前就绪与执行冻结处理 = 10,
    非成功已收束 = 11,
    待执行冻结队列准备 = 12,
    队列容量等待 = 13,
    执行冻结已确认 = 14
};

struct 任务重筹办处理槽快照 final {
    任务重筹办处理槽阶段 阶段 = 任务重筹办处理槽阶段::待处理;
    std::uint64_t 意图幂等键 = 0;
    L2任务身份 任务;
    std::uint64_t 尝试次数 = 0;
    任务重筹办意图 意图;
    std::optional<任务重筹办触发结果> 提供者结果;
    std::optional<下一筹办工作包> 工作包;
    std::optional<任务筹办推进结果> 当前就绪与执行冻结结果;
    std::optional<任务执行冻结请求> 执行冻结请求;
    std::optional<任务筹办非成功承接材料> 非成功承接;
    std::uint64_t 当前就绪处理尝试次数 = 0;
    std::uint64_t 执行冻结队列准备尝试次数 = 0;
};

class 任务管理线程 : public 任务重筹办意图提交端口 {
public:
    explicit 任务管理线程(std::uint64_t 调度队列容量)
        : 任务管理线程(调度队列容量, 调度队列容量) {
    }

    任务管理线程(
        std::uint64_t 调度队列容量,
        std::uint64_t 强类型请求队列容量)
        : 任务调度队列(调度队列容量),
          强类型请求容量上限(强类型请求队列容量) {
    }

    任务管理线程(
        std::uint64_t 调度队列容量,
        std::uint64_t 强类型请求队列容量,
        std::uint64_t 结果上行容量,
        std::uint64_t 最大来源需求成员数,
        任务实际结果上行桥& 上行桥,
        自我线程& 自我治理目标,
        std::uint64_t 重筹办意图容量,
        任务目标未达成重筹办触发提供者& 重筹办提供者,
        任务筹办当前就绪与执行冻结提供者&
            当前就绪与执行冻结提供者) noexcept
        : 任务调度队列(调度队列容量),
          强类型请求容量上限(强类型请求队列容量),
          结果上行容量上限_(结果上行容量),
          最大来源需求成员数_(最大来源需求成员数),
          结果上行桥_(&上行桥),
          自我治理目标_(&自我治理目标),
          重筹办意图容量上限_(重筹办意图容量),
          重筹办提供者_(&重筹办提供者),
          当前就绪与执行冻结提供者_(&当前就绪与执行冻结提供者) {
    }

    ~任务管理线程() {
        {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            强类型请求停止锁存 = true;
        }
        {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            结果上行停止锁存_ = true;
            结果上行排空请求_ = true;
        }
        请求停止.store(true);
        结果上行条件_.notify_all();
        if (线程.joinable()) {
            线程.join();
        }
    }

    任务管理线程(const 任务管理线程&) = delete;
    任务管理线程& operator=(const 任务管理线程&) = delete;

    任务管理线程状态 当前状态() const {
        return 状态.load();
    }

    bool 线程已进入() const {
        return 已进入.load();
    }

    bool 线程可收口() const {
        return !线程.joinable();
    }

    const 有界运行消息队列& 只读任务调度队列() const {
        return 任务调度队列;
    }

    强类型任务执行请求准备结果 准备强类型任务执行请求(
        const 任务执行冻结请求& 请求);

    强类型任务执行请求操作结果 确认强类型任务执行请求(
        强类型任务执行请求候选& 候选);

    强类型任务执行请求操作结果 撤销强类型任务执行请求(
        强类型任务执行请求候选& 候选);

    强类型任务执行请求取出结果 取出强类型任务执行请求();

    强类型任务执行请求队列快照 读取强类型任务执行队列快照() const;

    任务结果回执提交结果 提交任务结果回执(
        const 任务结果回执材料& 回执,
        std::uint64_t 当前时间戳) noexcept {
        if (结果上行桥_ == nullptr || 自我治理目标_ == nullptr
            || 结果上行容量上限_ == 0 || 最大来源需求成员数_ == 0) {
            return {任务结果回执提交状态::已拒绝,
                任务结果回执提交拒绝原因::结果上行未配置};
        }
        if (状态.load() != 任务管理线程状态::运行中) {
            return {任务结果回执提交状态::已拒绝,
                任务结果回执提交拒绝原因::管理线程未运行};
        }
        try {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            if (结果上行停止锁存_) {
                return {任务结果回执提交状态::已拒绝,
                    任务结果回执提交拒绝原因::结果上行已停止};
            }
            任务结果回执准入上下文 上下文;
            上下文.当前时间戳 = 当前时间戳;
            const auto 既有位置 = 结果上行槽_.find(回执.幂等键);
            if (既有位置 != 结果上行槽_.end()) {
                上下文.同幂等键既有材料 = 既有位置->second.回执;
            }
            const auto 任务键 = 回执.身份组.目标任务.值.值;
            const auto 顺序位置 = 结果上行同任务最新序号_.find(任务键);
            if (顺序位置 != 结果上行同任务最新序号_.end()) {
                上下文.同任务目标 = 回执.身份组.目标任务;
                上下文.同任务最新序号 = 顺序位置->second;
            }
            const auto 复核 = 复核任务结果回执材料(回执, 上下文);
            if (复核.状态 == 任务结果回执准入状态::重复材料) {
                if (既有位置->second.快照.阶段 == 任务结果上行槽阶段::合法等待) {
                    既有位置->second.快照.阶段 =
                        任务结果上行槽阶段::待发布正式结果;
                    重新排队结果上行_已锁定(既有位置->second);
                    结果上行条件_.notify_one();
                }
                return {任务结果回执提交状态::精确重复,
                    任务结果回执提交拒绝原因::无,
                    任务结果回执拒绝原因::无};
            }
            if (复核.状态 == 任务结果回执准入状态::内部不一致) {
                return {任务结果回执提交状态::内部错误,
                    任务结果回执提交拒绝原因::内部状态冲突,
                    复核.拒绝原因};
            }
            if (复核.状态 != 任务结果回执准入状态::可准入) {
                return {任务结果回执提交状态::已拒绝,
                    复核.拒绝原因 == 任务结果回执拒绝原因::幂等键冲突
                        ? 任务结果回执提交拒绝原因::回执幂等冲突
                        : 复核.拒绝原因 == 任务结果回执拒绝原因::同一任务序号倒退
                            ? 任务结果回执提交拒绝原因::来源任务序号拒绝
                            : 任务结果回执提交拒绝原因::回执协议拒绝,
                    复核.拒绝原因};
            }
            const auto 编号位置 = 结果上行回执编号_.find(回执.回执编号);
            if (编号位置 != 结果上行回执编号_.end()
                && 编号位置->second != 回执.幂等键) {
                return {任务结果回执提交状态::已拒绝,
                    任务结果回执提交拒绝原因::回执幂等冲突};
            }
            if (结果上行槽_.size() >= 结果上行容量上限_) {
                return {任务结果回执提交状态::已拒绝,
                    任务结果回执提交拒绝原因::结果上行队列已满};
            }
            任务结果上行内部槽 新槽;
            新槽.回执 = 回执;
            新槽.快照.阶段 = 任务结果上行槽阶段::待发布正式结果;
            新槽.快照.回执幂等键 = 回执.幂等键;
            新槽.快照.回执编号 = 回执.回执编号;
            新槽.快照.来源任务序号 = 回执.来源任务序号;
            新槽.快照.任务 = 回执.身份组.目标任务;
            新槽.已排队 = true;
            结果上行槽_.emplace(回执.幂等键, std::move(新槽));
            结果上行回执编号_[回执.回执编号] = 回执.幂等键;
            结果上行同任务最新序号_[任务键] = 回执.来源任务序号;
            结果上行待处理_.push_back(回执.幂等键);
            结果上行条件_.notify_one();
            return {任务结果回执提交状态::已接收,
                任务结果回执提交拒绝原因::无,
                任务结果回执拒绝原因::无};
        } catch (...) {
            return {任务结果回执提交状态::内部错误,
                任务结果回执提交拒绝原因::内部状态冲突};
        }
    }

    std::optional<任务结果上行槽快照> 读取任务结果上行槽(
        std::uint64_t 回执幂等键) const noexcept {
        try {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            const auto 位置 = 结果上行槽_.find(回执幂等键);
            if (位置 == 结果上行槽_.end()) return std::nullopt;
            return 位置->second.快照;
        } catch (...) {
            return std::nullopt;
        }
    }

    任务重筹办意图提交结果 提交任务重筹办意图(
        const 任务重筹办意图& 意图) noexcept override {
        if (重筹办提供者_ == nullptr || 重筹办意图容量上限_ == 0) {
            return {任务重筹办意图提交状态::已拒绝,
                任务重筹办意图提交拒绝原因::端口未运行};
        }
        if (状态.load() != 任务管理线程状态::运行中) {
            return {任务重筹办意图提交状态::已拒绝,
                任务重筹办意图提交拒绝原因::端口未运行};
        }
        if (!任务重筹办意图完整(意图)) {
            return {任务重筹办意图提交状态::已拒绝,
                任务重筹办意图提交拒绝原因::协议拒绝};
        }
        try {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            if (结果上行停止锁存_) {
                return {任务重筹办意图提交状态::已拒绝,
                    任务重筹办意图提交拒绝原因::已停止};
            }
            const auto 既有 = 重筹办槽_.find(意图.意图幂等键);
            if (既有 != 重筹办槽_.end()) {
                return 任务重筹办意图相同(既有->second.快照.意图, 意图)
                    ? 任务重筹办意图提交结果{
                        任务重筹办意图提交状态::精确重复,
                        任务重筹办意图提交拒绝原因::无}
                    : 任务重筹办意图提交结果{
                        任务重筹办意图提交状态::已拒绝,
                        任务重筹办意图提交拒绝原因::幂等冲突};
            }
            if (重筹办槽_.size() >= 重筹办意图容量上限_) {
                return {任务重筹办意图提交状态::已拒绝,
                    任务重筹办意图提交拒绝原因::队列已满};
            }
            任务重筹办内部槽 新槽;
            新槽.快照.意图幂等键 = 意图.意图幂等键;
            新槽.快照.任务 = 意图.任务;
            新槽.快照.意图 = 意图;
            新槽.已排队 = true;
            重筹办槽_.emplace(意图.意图幂等键, std::move(新槽));
            重筹办待处理_.push_back(意图.意图幂等键);
            结果上行条件_.notify_one();
            return {任务重筹办意图提交状态::已接收,
                任务重筹办意图提交拒绝原因::无};
        } catch (...) {
            return {任务重筹办意图提交状态::内部错误,
                任务重筹办意图提交拒绝原因::内部状态冲突};
        }
    }

    std::optional<任务重筹办处理槽快照> 读取任务重筹办处理槽(
        std::uint64_t 意图幂等键) const noexcept {
        try {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            const auto 位置 = 重筹办槽_.find(意图幂等键);
            return 位置 == 重筹办槽_.end()
                ? std::nullopt : std::optional{位置->second.快照};
        } catch (...) {
            return std::nullopt;
        }
    }

    bool 请求重试任务重筹办处理槽(
        std::uint64_t 意图幂等键) noexcept {
        try {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            if (结果上行停止锁存_) return false;
            const auto 位置 = 重筹办槽_.find(意图幂等键);
            if (位置 == 重筹办槽_.end())
                return false;
            const auto 阶段 = 位置->second.快照.阶段;
            const bool 重试触发 = 阶段 == 任务重筹办处理槽阶段::合法等待;
            const bool 重试当前就绪 = 阶段 ==
                    任务重筹办处理槽阶段::非成功已收束
                && 位置->second.快照.当前就绪与执行冻结结果
                && 位置->second.快照.当前就绪与执行冻结结果->类别
                    == 任务筹办收束类别::合法等待
                && 位置->second.快照.工作包;
            if (!重试触发 && !重试当前就绪) return false;
            if (!位置->second.已排队) {
                位置->second.已排队 = true;
                位置->second.快照.阶段 = 重试触发
                    ? 任务重筹办处理槽阶段::待处理
                    : 任务重筹办处理槽阶段::待当前就绪与执行冻结处理;
                重筹办待处理_.push_back(意图幂等键);
                结果上行条件_.notify_one();
            }
            return true;
        } catch (...) {
            return false;
        }
    }

    任务管理线程操作结果 请求停止新派发() noexcept {
        if (状态.load() != 任务管理线程状态::运行中) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }
        std::lock_guard<std::mutex> 锁(强类型请求队列锁);
        强类型请求停止锁存 = true;
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 排空结果上行并停止() noexcept {
        if (状态.load() != 任务管理线程状态::运行中
            && 状态.load() != 任务管理线程状态::正在停止) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }
        {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            结果上行停止锁存_ = true;
            结果上行排空请求_ = true;
        }
        状态.store(任务管理线程状态::正在停止);
        结果上行条件_.notify_all();
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 启动() {
        if (状态.load() == 任务管理线程状态::运行中) {
            return 拒绝(任务管理线程拒绝原因::重复启动);
        }
        if (任务调度队列.容量() == 0) {
            状态.store(任务管理线程状态::启动失败);
            return 拒绝(任务管理线程拒绝原因::队列容量为零);
        }
        if ((结果上行桥_ == nullptr) != (自我治理目标_ == nullptr)
            || (结果上行桥_ != nullptr
                && (结果上行容量上限_ == 0 || 最大来源需求成员数_ == 0))
                || (重筹办提供者_ == nullptr) != (重筹办意图容量上限_ == 0)
                || (重筹办提供者_ == nullptr)
                    != (当前就绪与执行冻结提供者_ == nullptr)) {
            状态.store(任务管理线程状态::启动失败);
            return 拒绝(任务管理线程拒绝原因::队列容量为零);
        }

        {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            强类型请求停止锁存 = false;
        }
        {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            结果上行停止锁存_ = false;
            结果上行排空请求_ = false;
        }
        请求停止.store(false);
        已进入.store(false);
        状态.store(任务管理线程状态::运行中);
        try {
            线程 = std::thread([this]() {
                已进入.store(true);
                if (结果上行桥_ != nullptr && 自我治理目标_ != nullptr) {
                    运行结果上行循环();
                } else {
                    std::unique_lock<std::mutex> 锁(结果上行锁_);
                    结果上行条件_.wait(锁, [this]() noexcept {
                        return 请求停止.load();
                    });
                }
            });
        } catch (...) {
            状态.store(任务管理线程状态::启动失败);
            请求停止.store(true);
            return 拒绝(任务管理线程拒绝原因::线程创建失败);
        }
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 发送任务执行请求(const 运行消息& 请求消息) {
        if (状态.load() != 任务管理线程状态::运行中) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }
        if (请求消息.类型 != 运行消息类型::任务执行请求) {
            return 拒绝(任务管理线程拒绝原因::非任务执行请求);
        }
        const auto 入队 = 任务调度队列.入队(请求消息);
        if (!入队.已入队) {
            return 拒绝(任务管理线程拒绝原因::请求入队失败);
        }
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    出队结果 取出任务执行请求() {
        if (状态.load() != 任务管理线程状态::运行中) {
            return {};
        }
        return 任务调度队列.出队();
    }

    任务管理线程操作结果 请求停止并发送停止消息(
        std::uint64_t 停止消息编号, std::uint64_t 停止时间戳) {
        if (状态.load() == 任务管理线程状态::未启动) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }

        bool 原停止锁存 = false;
        {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            原停止锁存 = 强类型请求停止锁存;
            强类型请求停止锁存 = true;
        }

        运行消息 停止消息;
        停止消息.消息编号 = 停止消息编号;
        停止消息.类型 = 运行消息类型::停止;
        停止消息.来源角色 = 运行线程角色::运行宿主;
        停止消息.目标角色 = 运行线程角色::任务管理;
        停止消息.发生时间戳 = 停止时间戳;
        停止消息.优先级 = 运行消息优先级::停止;
        停止消息.幂等键 = 停止消息编号;
        停止消息.材料摘要 = 停止消息编号;
        停止消息.只读材料说明 = true;
        停止消息.承载机器事实 = false;

        const auto 入队 = 任务调度队列.入队(停止消息);
        if (!入队.已入队) {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            强类型请求停止锁存 = 原停止锁存;
            return 拒绝(任务管理线程拒绝原因::停止消息失败);
        }

        状态.store(任务管理线程状态::正在停止);
        请求停止.store(true);
        结果上行条件_.notify_all();
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 收口等待() {
        if (线程.joinable()) {
            线程.join();
        }
        if (状态.load() == 任务管理线程状态::正在停止
            || 状态.load() == 任务管理线程状态::运行中) {
            状态.store(任务管理线程状态::已停止);
        }
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

private:
    friend class 强类型任务执行请求候选;

    enum class 强类型请求内部状态 : std::uint8_t {
        已预留 = 1,
        已确认 = 2,
        已消费 = 3
    };

    struct 强类型请求内部记录 {
        任务执行冻结请求 请求;
        std::uint64_t 预留代次 = 0;
        强类型请求内部状态 状态 = 强类型请求内部状态::已预留;
    };

    struct 强类型任务身份哈希 {
        std::size_t operator()(const L2任务身份& 身份) const noexcept {
            return std::hash<std::uint64_t>{}(身份.值.值);
        }
    };

    struct 强类型任务身份相等 {
        bool operator()(const L2任务身份& 左, const L2任务身份& 右) const noexcept {
            return 左.值.值 == 右.值.值;
        }
    };

    struct 任务结果上行内部槽 {
        任务结果回执材料 回执;
        任务结果上行槽快照 快照;
        std::optional<L2实例方法事实> 实例方法;
        bool 已排队 = false;
    };

    struct 任务重筹办内部槽 {
        任务重筹办处理槽快照 快照;
        bool 已排队 = false;
    };

    有界运行消息队列 任务调度队列;
    std::uint64_t 强类型请求容量上限 = 0;
    mutable std::mutex 强类型请求队列锁;
    std::unordered_map<std::uint64_t, 强类型请求内部记录> 强类型请求记录;
    std::unordered_map<std::uint64_t, std::uint64_t> 强类型幂等请求编号;
    std::unordered_map<L2任务身份, std::uint64_t,
        强类型任务身份哈希, 强类型任务身份相等> 强类型同任务最新序号;
    std::deque<std::uint64_t> 强类型可消费请求;
    std::uint64_t 强类型预留代次 = 0;
    std::uint64_t 强类型活跃请求数量 = 0;
    bool 强类型请求停止锁存 = false;
    std::atomic<任务管理线程状态> 状态 = 任务管理线程状态::未启动;
    std::atomic<bool> 请求停止 = false;
    std::atomic<bool> 已进入 = false;
    std::thread 线程;
    std::uint64_t 结果上行容量上限_ = 0;
    std::uint64_t 最大来源需求成员数_ = 0;
    任务实际结果上行桥* 结果上行桥_ = nullptr;
    自我线程* 自我治理目标_ = nullptr;
    mutable std::mutex 结果上行锁_;
    std::condition_variable 结果上行条件_;
    std::unordered_map<std::uint64_t, 任务结果上行内部槽> 结果上行槽_;
    std::unordered_map<std::uint64_t, std::uint64_t> 结果上行回执编号_;
    std::unordered_map<std::uint64_t, std::uint64_t> 结果上行同任务最新序号_;
    std::unordered_map<std::uint64_t, std::uint64_t> 正式结果首次槽_;
    std::deque<std::uint64_t> 结果上行待处理_;
    bool 结果上行停止锁存_ = false;
    bool 结果上行排空请求_ = false;
    std::uint64_t 重筹办意图容量上限_ = 0;
    任务目标未达成重筹办触发提供者* 重筹办提供者_ = nullptr;
    任务筹办当前就绪与执行冻结提供者*
        当前就绪与执行冻结提供者_ = nullptr;
    std::unordered_map<std::uint64_t, 任务重筹办内部槽> 重筹办槽_;
    std::deque<std::uint64_t> 重筹办待处理_;
    bool 上次处理重筹办_ = false;

    任务管理线程操作结果 拒绝(任务管理线程拒绝原因 原因) const {
        return {false, true, false, 原因};
    }

    static 强类型任务执行请求准备结果 拒绝强类型请求准备(
        强类型任务执行请求队列拒绝原因 原因) {
        return {强类型任务执行请求队列状态::已拒绝, 原因, std::nullopt};
    }

    static 强类型任务执行请求操作结果 拒绝强类型请求操作(
        强类型任务执行请求队列拒绝原因 原因) noexcept {
        return {强类型任务执行请求队列状态::已拒绝, 原因};
    }

    bool 复核强类型请求重复_已锁定(
        const 任务执行冻结请求& 请求,
        强类型任务执行请求准备结果& 输出);

    bool 复核强类型任务顺序与容量_已锁定(
        const 任务执行冻结请求& 请求,
        强类型任务执行请求准备结果& 输出);

    强类型任务执行请求准备结果 预留强类型任务执行请求_已锁定(
        const 任务执行冻结请求& 请求);

    static bool 结果上行终态(任务结果上行槽阶段 阶段) noexcept {
        return 阶段 == 任务结果上行槽阶段::已提交
            || 阶段 == 任务结果上行槽阶段::精确重复
            || 阶段 == 任务结果上行槽阶段::合法等待
            || 阶段 == 任务结果上行槽阶段::当前性漂移
            || 阶段 == 任务结果上行槽阶段::引用冲突
            || 阶段 == 任务结果上行槽阶段::入口拒绝
            || 阶段 == 任务结果上行槽阶段::数量预算不足
            || 阶段 == 任务结果上行槽阶段::内部终止;
    }

    bool 全部结果上行可收口_已锁定() const noexcept {
        for (const auto& [幂等键, 槽] : 结果上行槽_) {
            (void)幂等键;
            if (!结果上行终态(槽.快照.阶段)) return false;
        }
        for (const auto& [幂等键, 槽] : 重筹办槽_) {
            (void)幂等键;
            const auto 阶段 = 槽.快照.阶段;
            if (阶段 == 任务重筹办处理槽阶段::待处理
                || 阶段 == 任务重筹办处理槽阶段::资源等待
                || 阶段
                    == 任务重筹办处理槽阶段::待当前就绪与执行冻结处理
                || 阶段 == 任务重筹办处理槽阶段::待执行冻结队列准备)
                return false;
        }
        return 结果上行待处理_.empty() && 重筹办待处理_.empty();
    }

    void 重新排队结果上行_已锁定(任务结果上行内部槽& 槽) {
        if (槽.已排队) return;
        槽.已排队 = true;
        结果上行待处理_.push_back(槽.回执.幂等键);
    }

    void 重新排队重筹办_已锁定(任务重筹办内部槽& 槽) {
        if (槽.已排队) return;
        槽.已排队 = true;
        重筹办待处理_.push_back(槽.快照.意图幂等键);
    }

    void 应用上行形成结果_已锁定(
        任务结果上行内部槽& 槽,
        const 任务结果上行形成结果& 形成结果) {
        if (形成结果.正式执行轮次 != 0) {
            槽.快照.正式执行轮次 = 形成结果.正式执行轮次;
        }
        if (形成结果.事实截止G1 != 0) {
            槽.快照.事实截止G1 = 形成结果.事实截止G1;
        }
        if (形成结果.实例方法) 槽.实例方法 = *形成结果.实例方法;
        if (形成结果.正式结果) 槽.快照.正式结果 = *形成结果.正式结果;

        switch (形成结果.状态) {
        case 任务结果上行形成状态::已形成: {
            if (!形成结果.正式结果 || !形成结果.治理消息) {
                槽.快照.阶段 = 任务结果上行槽阶段::内部终止;
                return;
            }
            const auto 结果键 = 形成结果.正式结果->身份.值.值;
            const auto 首次位置 = 正式结果首次槽_.find(结果键);
            if (首次位置 != 正式结果首次槽_.end()
                && 首次位置->second != 槽.回执.幂等键) {
                槽.快照.阶段 = 任务结果上行槽阶段::精确重复;
                槽.快照.复用槽幂等键 = 首次位置->second;
                return;
            }
            正式结果首次槽_[结果键] = 槽.回执.幂等键;
            槽.快照.治理消息 = *形成结果.治理消息;
            槽.快照.阶段 = 任务结果上行槽阶段::治理消息待提交;
            重新排队结果上行_已锁定(槽);
            return;
        }
        case 任务结果上行形成状态::合法等待:
            if (形成结果.正式结果 && 形成结果.事实截止G1 != 0) {
                槽.快照.阶段 = 任务结果上行槽阶段::待独立读回;
                重新排队结果上行_已锁定(槽);
            } else {
                槽.快照.阶段 = 任务结果上行槽阶段::合法等待;
            }
            return;
        case 任务结果上行形成状态::当前性漂移:
            槽.快照.阶段 = 任务结果上行槽阶段::当前性漂移;
            return;
        case 任务结果上行形成状态::引用冲突:
            槽.快照.阶段 = 任务结果上行槽阶段::引用冲突;
            return;
        case 任务结果上行形成状态::入口拒绝:
            槽.快照.阶段 = 任务结果上行槽阶段::入口拒绝;
            return;
        case 任务结果上行形成状态::数量预算不足:
            槽.快照.阶段 = 任务结果上行槽阶段::数量预算不足;
            return;
        case 任务结果上行形成状态::资源失败:
            槽.快照.阶段 = 形成结果.正式结果 && 形成结果.事实截止G1 != 0
                ? 任务结果上行槽阶段::待独立读回
                : 任务结果上行槽阶段::资源等待;
            重新排队结果上行_已锁定(槽);
            return;
        case 任务结果上行形成状态::内部错误:
            槽.快照.阶段 = 任务结果上行槽阶段::内部终止;
            return;
        }
        槽.快照.阶段 = 任务结果上行槽阶段::内部终止;
    }

    void 应用重筹办结果_已锁定(
        任务重筹办内部槽& 槽,
        const 任务重筹办触发结果& 结果) {
        槽.快照.提供者结果 = 结果;
        槽.快照.工作包 = 结果.工作包;
        switch (结果.状态) {
        case 任务重筹办触发状态::已形成:
            槽.快照.阶段 = 结果.成功()
                ? 任务重筹办处理槽阶段::待当前就绪与执行冻结处理
                : 任务重筹办处理槽阶段::内部终止;
            if (结果.成功()) 重新排队重筹办_已锁定(槽);
            return;
        case 任务重筹办触发状态::精确重复:
            槽.快照.阶段 = 结果.成功()
                ? 任务重筹办处理槽阶段::待当前就绪与执行冻结处理
                : 任务重筹办处理槽阶段::内部终止;
            if (结果.成功()) 重新排队重筹办_已锁定(槽);
            return;
        case 任务重筹办触发状态::合法等待:
            槽.快照.阶段 = 任务重筹办处理槽阶段::合法等待;
            return;
        case 任务重筹办触发状态::资源失败:
            槽.快照.阶段 = 任务重筹办处理槽阶段::资源等待;
            if (!槽.已排队) {
                槽.已排队 = true;
                重筹办待处理_.push_back(槽.快照.意图幂等键);
            }
            return;
        case 任务重筹办触发状态::当前性漂移:
            槽.快照.阶段 = 任务重筹办处理槽阶段::当前性漂移;
            return;
        case 任务重筹办触发状态::引用冲突:
            槽.快照.阶段 = 任务重筹办处理槽阶段::引用冲突;
            return;
        case 任务重筹办触发状态::入口拒绝:
            槽.快照.阶段 = 任务重筹办处理槽阶段::入口拒绝;
            return;
        case 任务重筹办触发状态::内部错误:
        default:
            槽.快照.阶段 = 任务重筹办处理槽阶段::内部终止;
            return;
        }
    }

    void 应用当前就绪与执行冻结结果_已锁定(
        任务重筹办内部槽& 槽,
        const 任务筹办推进结果& 结果) {
        槽.快照.当前就绪与执行冻结结果 = 结果;
        槽.快照.非成功承接 = 结果.非成功承接;
        if (!结果.成功()) {
            槽.快照.阶段 = 结果.非成功承接
                ? 任务重筹办处理槽阶段::非成功已收束
                : 任务重筹办处理槽阶段::内部终止;
            return;
        }
        const auto& 材料 = *结果.执行冻结材料;
        任务执行冻结请求 请求;
        请求.请求编号 = 材料.来源工作包.原重筹办意图幂等键;
        请求.幂等键 = 材料.来源工作包.原重筹办意图幂等键;
        请求.任务序号 = 材料.实例方法.执行轮次;
        请求.形成事实截止 = 材料.形成事实截止;
        请求.来源工作包 = 材料.来源工作包;
        请求.正式选择 = 材料.正式选择;
        请求.冻结材料 = 材料.冻结材料;
        请求.实例方法 = 材料.实例方法;
        if (!冻结任务执行请求完整(请求)) {
            槽.快照.阶段 = 任务重筹办处理槽阶段::内部终止;
            return;
        }
        槽.快照.执行冻结请求 = std::move(请求);
        槽.快照.阶段 = 任务重筹办处理槽阶段::待执行冻结队列准备;
        重新排队重筹办_已锁定(槽);
    }

    void 运行结果上行循环() noexcept {
        for (;;) {
            bool 处理重筹办 = false;
            std::uint64_t 重筹办键 = 0;
            任务重筹办意图 重筹办意图;
            任务重筹办处理槽阶段 重筹办阶段 =
                任务重筹办处理槽阶段::内部终止;
            std::optional<下一筹办工作包> 重筹办工作包;
            std::optional<任务执行冻结请求> 待准备执行冻结请求;
            std::uint64_t 当前幂等键 = 0;
            任务结果回执材料 回执;
            任务结果上行槽阶段 阶段 = 任务结果上行槽阶段::内部终止;
            std::optional<L2实例方法事实> 实例方法;
            std::optional<L2任务实际结果事实> 正式结果;
            std::optional<自我治理消息> 治理消息;
            std::uint64_t G1 = 0;
            {
                std::unique_lock<std::mutex> 锁(结果上行锁_);
                结果上行条件_.wait(锁, [this]() noexcept {
                    return 请求停止.load() || !结果上行待处理_.empty()
                        || !重筹办待处理_.empty()
                        || 结果上行排空请求_;
                });
                if (结果上行待处理_.empty() && 重筹办待处理_.empty()) {
                    if (请求停止.load()
                        || (结果上行排空请求_ && 全部结果上行可收口_已锁定())) {
                        break;
                    }
                    continue;
                }
                if (!重筹办待处理_.empty()
                    && (结果上行待处理_.empty() || !上次处理重筹办_)) {
                    处理重筹办 = true;
                    上次处理重筹办_ = true;
                    重筹办键 = 重筹办待处理_.front();
                    重筹办待处理_.pop_front();
                    const auto 位置 = 重筹办槽_.find(重筹办键);
                    if (位置 == 重筹办槽_.end()) continue;
                    位置->second.已排队 = false;
                    ++位置->second.快照.尝试次数;
                    重筹办意图 = 位置->second.快照.意图;
                    重筹办阶段 = 位置->second.快照.阶段;
                    重筹办工作包 = 位置->second.快照.工作包;
                    待准备执行冻结请求 = 位置->second.快照.执行冻结请求;
                    if (重筹办阶段 ==
                        任务重筹办处理槽阶段::待当前就绪与执行冻结处理)
                        ++位置->second.快照.当前就绪处理尝试次数;
                    else if (重筹办阶段 ==
                            任务重筹办处理槽阶段::待执行冻结队列准备
                        || 重筹办阶段 ==
                            任务重筹办处理槽阶段::队列容量等待)
                        ++位置->second.快照.执行冻结队列准备尝试次数;
                } else {
                    上次处理重筹办_ = false;
                }
                if (处理重筹办) {
                    // 离开锁后调用业务提供者。
                } else {
                当前幂等键 = 结果上行待处理_.front();
                结果上行待处理_.pop_front();
                const auto 位置 = 结果上行槽_.find(当前幂等键);
                if (位置 == 结果上行槽_.end()) continue;
                auto& 槽 = 位置->second;
                槽.已排队 = false;
                回执 = 槽.回执;
                阶段 = 槽.快照.阶段;
                实例方法 = 槽.实例方法;
                正式结果 = 槽.快照.正式结果;
                治理消息 = 槽.快照.治理消息;
                G1 = 槽.快照.事实截止G1;
                if (阶段 == 任务结果上行槽阶段::待发布正式结果
                    || 阶段 == 任务结果上行槽阶段::资源等待) {
                    ++槽.快照.结果发布尝试次数;
                } else if (阶段 == 任务结果上行槽阶段::待独立读回) {
                    ++槽.快照.独立读回尝试次数;
                } else if (阶段 == 任务结果上行槽阶段::治理消息待提交) {
                    ++槽.快照.邮箱提交尝试次数;
                }
                }
            }

            if (处理重筹办) {
                if (重筹办阶段 == 任务重筹办处理槽阶段::待处理
                    || 重筹办阶段 == 任务重筹办处理槽阶段::资源等待) {
                    const auto 结果 = 重筹办提供者_
                        ? 重筹办提供者_->形成待重筹办与下一筹办工作包(
                            重筹办意图)
                        : 任务重筹办触发结果{
                            任务重筹办触发状态::内部错误};
                    {
                        std::lock_guard<std::mutex> 锁(结果上行锁_);
                        const auto 位置 = 重筹办槽_.find(重筹办键);
                        if (位置 != 重筹办槽_.end())
                            应用重筹办结果_已锁定(位置->second, 结果);
                    }
                    if (结果.状态 == 任务重筹办触发状态::资源失败)
                        std::this_thread::sleep_for(std::chrono::milliseconds(1));
                } else if (重筹办阶段 ==
                    任务重筹办处理槽阶段::待当前就绪与执行冻结处理) {
                    任务筹办推进结果 结果;
                    if (当前就绪与执行冻结提供者_ != nullptr && 重筹办工作包) {
                        任务筹办推进请求 请求;
                        请求.请求头 = {
                            L2结构合同版本, 重筹办工作包->迁移后事实代次};
                        请求.工作包 = *重筹办工作包;
                        请求.最大扫描用途事实数 = 最大来源需求成员数_;
                        请求.最大粗召回方法数 = 最大来源需求成员数_;
                        请求.最大概念支持扫描事实数 = 最大来源需求成员数_;
                        请求.最大概念支持关系数 = 最大来源需求成员数_;
                        请求.最大概念祖先关系数 = 最大来源需求成员数_;
                        请求.最大主体状态数 = 最大来源需求成员数_;
                        请求.最大场景成员数 = 最大来源需求成员数_;
                        请求.最大方法条件数 = 最大来源需求成员数_;
                        请求.最大来源需求成员数 = 最大来源需求成员数_;
                        结果 = 当前就绪与执行冻结提供者_->推进下一筹办工作包(
                            请求);
                    }
                    {
                        std::lock_guard<std::mutex> 锁(结果上行锁_);
                        const auto 位置 = 重筹办槽_.find(重筹办键);
                        if (位置 != 重筹办槽_.end())
                            应用当前就绪与执行冻结结果_已锁定(
                                位置->second, 结果);
                    }
                } else if (重筹办阶段 ==
                        任务重筹办处理槽阶段::待执行冻结队列准备
                    || 重筹办阶段 ==
                        任务重筹办处理槽阶段::队列容量等待) {
                    auto 准备结果 = 待准备执行冻结请求
                        ? 准备强类型任务执行请求(*待准备执行冻结请求)
                        : 拒绝强类型请求准备(
                            强类型任务执行请求队列拒绝原因::请求无效);
                    bool 容量等待 = false;
                    bool 已确认 = 准备结果.状态
                        == 强类型任务执行请求队列状态::精确重复;
                    if (准备结果.状态 == 强类型任务执行请求队列状态::已预留
                        && 准备结果.候选) {
                        auto 候选 = std::move(*准备结果.候选);
                        const auto 确认结果 = 确认强类型任务执行请求(候选);
                        已确认 = 确认结果.状态
                            == 强类型任务执行请求队列状态::已确认;
                        if (!已确认 && 候选.有效())
                            (void)撤销强类型任务执行请求(候选);
                    } else if (准备结果.拒绝原因
                        == 强类型任务执行请求队列拒绝原因::队列已满) {
                        容量等待 = true;
                    }
                    {
                        std::lock_guard<std::mutex> 锁(结果上行锁_);
                        const auto 位置 = 重筹办槽_.find(重筹办键);
                        if (位置 != 重筹办槽_.end()) {
                            auto& 槽 = 位置->second;
                            if (已确认) {
                                槽.快照.阶段 =
                                    任务重筹办处理槽阶段::执行冻结已确认;
                            } else if (容量等待) {
                                槽.快照.阶段 =
                                    任务重筹办处理槽阶段::队列容量等待;
                                重新排队重筹办_已锁定(槽);
                            } else {
                                槽.快照.阶段 =
                                    任务重筹办处理槽阶段::内部终止;
                            }
                        }
                    }
                    if (容量等待)
                        std::this_thread::sleep_for(std::chrono::milliseconds(1));
                }
                结果上行条件_.notify_all();
                continue;
            }

            if (阶段 == 任务结果上行槽阶段::待发布正式结果
                || 阶段 == 任务结果上行槽阶段::资源等待) {
                const auto 形成结果 = 结果上行桥_->发布并形成治理消息(
                    回执, 最大来源需求成员数_);
                {
                    std::lock_guard<std::mutex> 锁(结果上行锁_);
                    const auto 位置 = 结果上行槽_.find(当前幂等键);
                    if (位置 != 结果上行槽_.end()) {
                        应用上行形成结果_已锁定(位置->second, 形成结果);
                    }
                }
                if (形成结果.状态 == 任务结果上行形成状态::资源失败) {
                    std::this_thread::sleep_for(std::chrono::milliseconds(1));
                }
                结果上行条件_.notify_all();
                continue;
            }

            if (阶段 == 任务结果上行槽阶段::待独立读回) {
                任务结果上行形成结果 形成结果{任务结果上行形成状态::内部错误};
                if (实例方法 && 正式结果 && G1 != 0) {
                    形成结果 = 结果上行桥_->继续独立读回并形成治理消息(
                        回执, *实例方法, *正式结果, G1,
                        最大来源需求成员数_);
                }
                {
                    std::lock_guard<std::mutex> 锁(结果上行锁_);
                    const auto 位置 = 结果上行槽_.find(当前幂等键);
                    if (位置 != 结果上行槽_.end()) {
                        应用上行形成结果_已锁定(位置->second, 形成结果);
                    }
                }
                if (形成结果.状态 == 任务结果上行形成状态::资源失败
                    || 形成结果.状态 == 任务结果上行形成状态::合法等待) {
                    std::this_thread::sleep_for(std::chrono::milliseconds(1));
                }
                结果上行条件_.notify_all();
                continue;
            }

            if (阶段 == 任务结果上行槽阶段::治理消息待提交) {
                if (!治理消息) {
                    std::lock_guard<std::mutex> 锁(结果上行锁_);
                    const auto 位置 = 结果上行槽_.find(当前幂等键);
                    if (位置 != 结果上行槽_.end()) {
                        位置->second.快照.阶段 = 任务结果上行槽阶段::内部终止;
                    }
                    continue;
                }
                const auto 提交 = 自我治理目标_->提交治理消息(
                    *治理消息, 治理消息->发生时间戳);
                bool 需要重试 = false;
                {
                    std::lock_guard<std::mutex> 锁(结果上行锁_);
                    const auto 位置 = 结果上行槽_.find(当前幂等键);
                    if (位置 == 结果上行槽_.end()) continue;
                    auto& 槽 = 位置->second;
                    if (提交.状态 == 自我治理提交状态::已提交) {
                        槽.快照.阶段 = 任务结果上行槽阶段::已提交;
                    } else if (提交.状态 == 自我治理提交状态::重复材料) {
                        槽.快照.阶段 = 任务结果上行槽阶段::精确重复;
                    } else if (提交.状态 == 自我治理提交状态::已拒绝
                        && 提交.拒绝原因 == 自我治理队列拒绝原因::队列已满) {
                        槽.快照.阶段 = 任务结果上行槽阶段::治理消息待提交;
                        重新排队结果上行_已锁定(槽);
                        需要重试 = true;
                    } else {
                        槽.快照.阶段 = 任务结果上行槽阶段::内部终止;
                    }
                }
                if (需要重试) {
                    std::this_thread::sleep_for(std::chrono::milliseconds(1));
                }
                结果上行条件_.notify_all();
                continue;
            }
        }
        请求停止.store(true);
    }

    bool 撤销强类型请求_已锁定(
        std::uint64_t 请求编号,
        std::uint64_t 预留代次);

    void 重新计算任务最新序号_已锁定(L2任务身份 任务);

    void 析构撤销强类型请求(
        std::uint64_t 请求编号,
        std::uint64_t 预留代次) noexcept {
        std::lock_guard<std::mutex> 锁(强类型请求队列锁);
        (void)撤销强类型请求_已锁定(请求编号, 预留代次);
    }
};

inline 强类型任务执行请求准备结果
任务管理线程::准备强类型任务执行请求(const 任务执行冻结请求& 请求) {
    if (!冻结任务执行请求完整(请求)) {
        return 拒绝强类型请求准备(强类型任务执行请求队列拒绝原因::请求无效);
    }
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    if (状态.load() != 任务管理线程状态::运行中) {
        return 拒绝强类型请求准备(
            强类型任务执行请求队列拒绝原因::管理线程未运行);
    }
    if (强类型请求停止锁存) {
        return 拒绝强类型请求准备(强类型任务执行请求队列拒绝原因::队列已停止);
    }
    if (强类型请求容量上限 == 0) {
        return 拒绝强类型请求准备(强类型任务执行请求队列拒绝原因::容量为零);
    }
    强类型任务执行请求准备结果 输出;
    if (复核强类型请求重复_已锁定(请求, 输出)
        || 复核强类型任务顺序与容量_已锁定(请求, 输出)) return 输出;
    return 预留强类型任务执行请求_已锁定(请求);
}

inline bool 任务管理线程::复核强类型请求重复_已锁定(
    const 任务执行冻结请求& 请求,
    强类型任务执行请求准备结果& 输出) {
    const auto 请求位置 = 强类型请求记录.find(请求.请求编号);
    if (请求位置 != 强类型请求记录.end()) {
        输出 = 冻结任务执行请求相同(请求位置->second.请求, 请求)
            ? 强类型任务执行请求准备结果{
                强类型任务执行请求队列状态::精确重复,
                强类型任务执行请求队列拒绝原因::无, std::nullopt}
            : 拒绝强类型请求准备(
                强类型任务执行请求队列拒绝原因::请求编号冲突);
        return true;
    }
    const auto 幂等位置 = 强类型幂等请求编号.find(请求.幂等键);
    if (幂等位置 == 强类型幂等请求编号.end()) return false;
    const auto 既有 = 强类型请求记录.find(幂等位置->second);
    if (既有 == 强类型请求记录.end()) {
        输出 = {强类型任务执行请求队列状态::内部不一致,
            强类型任务执行请求队列拒绝原因::候选状态冲突, std::nullopt};
        return true;
    }
    输出 = 冻结任务执行请求相同(既有->second.请求, 请求)
        ? 强类型任务执行请求准备结果{
            强类型任务执行请求队列状态::精确重复,
            强类型任务执行请求队列拒绝原因::无, std::nullopt}
        : 拒绝强类型请求准备(
            强类型任务执行请求队列拒绝原因::幂等键冲突);
    return true;
}

inline bool 任务管理线程::复核强类型任务顺序与容量_已锁定(
    const 任务执行冻结请求& 请求,
    强类型任务执行请求准备结果& 输出) {
    const auto 任务顺序键 = 请求.来源工作包.任务;
    const auto 顺序位置 = 强类型同任务最新序号.find(任务顺序键);
    if (顺序位置 != 强类型同任务最新序号.end()) {
        if (请求.任务序号 < 顺序位置->second) {
            输出 = 拒绝强类型请求准备(
                强类型任务执行请求队列拒绝原因::任务序号倒退);
            return true;
        }
        if (请求.任务序号 == 顺序位置->second) {
            输出 = 拒绝强类型请求准备(
                强类型任务执行请求队列拒绝原因::任务序号冲突);
            return true;
        }
    }
    if (强类型活跃请求数量 < 强类型请求容量上限) return false;
    输出 = 拒绝强类型请求准备(强类型任务执行请求队列拒绝原因::队列已满);
    return true;
}

inline 强类型任务执行请求准备结果
任务管理线程::预留强类型任务执行请求_已锁定(const 任务执行冻结请求& 请求) {
    ++强类型预留代次;
    if (强类型预留代次 == 0) ++强类型预留代次;
    强类型请求记录.emplace(
        请求.请求编号,
        强类型请求内部记录{
            请求, 强类型预留代次, 强类型请求内部状态::已预留});
    强类型幂等请求编号.emplace(请求.幂等键, 请求.请求编号);
    强类型同任务最新序号[请求.来源工作包.任务] = 请求.任务序号;
    ++强类型活跃请求数量;

    强类型任务执行请求准备结果 输出;
    输出.状态 = 强类型任务执行请求队列状态::已预留;
    输出.候选 = 强类型任务执行请求候选(
        this, 请求.请求编号, 强类型预留代次);
    return 输出;
}

inline 强类型任务执行请求操作结果
任务管理线程::确认强类型任务执行请求(强类型任务执行请求候选& 候选) {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    if (!候选.有效() || 候选.所有者_ != this) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选能力无效);
    }
    const auto 位置 = 强类型请求记录.find(候选.请求编号_);
    if (位置 == 强类型请求记录.end()
        || 位置->second.预留代次 != 候选.预留代次_
        || 位置->second.状态 != 强类型请求内部状态::已预留) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选状态冲突);
    }
    位置->second.状态 = 强类型请求内部状态::已确认;
    强类型可消费请求.push_back(候选.请求编号_);
    候选.置为已决定();
    return {强类型任务执行请求队列状态::已确认,
        强类型任务执行请求队列拒绝原因::无};
}

inline 强类型任务执行请求操作结果
任务管理线程::撤销强类型任务执行请求(强类型任务执行请求候选& 候选) {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    if (!候选.有效() || 候选.所有者_ != this) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选能力无效);
    }
    if (!撤销强类型请求_已锁定(候选.请求编号_, 候选.预留代次_)) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选状态冲突);
    }
    候选.置为已决定();
    return {强类型任务执行请求队列状态::已撤销,
        强类型任务执行请求队列拒绝原因::无};
}

inline 强类型任务执行请求取出结果 任务管理线程::取出强类型任务执行请求() {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    const bool 已停止 = 强类型请求停止锁存
        || 状态.load() == 任务管理线程状态::正在停止
        || 状态.load() == 任务管理线程状态::已停止;
    if (强类型可消费请求.empty()) {
        return {强类型任务执行请求队列状态::无请求, 已停止, std::nullopt};
    }
    const auto 请求编号 = 强类型可消费请求.front();
    强类型可消费请求.pop_front();
    const auto 位置 = 强类型请求记录.find(请求编号);
    if (位置 == 强类型请求记录.end()
        || 位置->second.状态 != 强类型请求内部状态::已确认
        || 强类型活跃请求数量 == 0) {
        return {强类型任务执行请求队列状态::内部不一致, 已停止, std::nullopt};
    }
    位置->second.状态 = 强类型请求内部状态::已消费;
    --强类型活跃请求数量;
    return {强类型任务执行请求队列状态::已取出, 已停止, 位置->second.请求};
}

inline 强类型任务执行请求队列快照
任务管理线程::读取强类型任务执行队列快照() const {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    std::uint64_t 预留数量 = 0;
    for (const auto& [编号, 记录] : 强类型请求记录) {
        (void)编号;
        if (记录.状态 == 强类型请求内部状态::已预留) ++预留数量;
    }
    return {
        强类型请求容量上限,
        预留数量,
        static_cast<std::uint64_t>(强类型可消费请求.size()),
        static_cast<std::uint64_t>(强类型请求记录.size()),
        static_cast<std::uint64_t>(强类型幂等请求编号.size()),
        static_cast<std::uint64_t>(强类型同任务最新序号.size()),
        强类型请求停止锁存
            || 状态.load() == 任务管理线程状态::正在停止
            || 状态.load() == 任务管理线程状态::已停止
    };
}

inline bool 任务管理线程::撤销强类型请求_已锁定(
    std::uint64_t 请求编号,
    std::uint64_t 预留代次) {
    const auto 位置 = 强类型请求记录.find(请求编号);
    if (位置 == 强类型请求记录.end()
        || 位置->second.预留代次 != 预留代次
        || 位置->second.状态 != 强类型请求内部状态::已预留
        || 强类型活跃请求数量 == 0) return false;
    const auto 任务 = 位置->second.请求.来源工作包.任务;
    const auto 幂等键 = 位置->second.请求.幂等键;
    强类型幂等请求编号.erase(幂等键);
    强类型请求记录.erase(位置);
    --强类型活跃请求数量;
    重新计算任务最新序号_已锁定(任务);
    return true;
}

inline void 任务管理线程::重新计算任务最新序号_已锁定(L2任务身份 任务) {
    std::uint64_t 最新序号 = 0;
    for (const auto& [编号, 记录] : 强类型请求记录) {
        (void)编号;
        if (记录.请求.来源工作包.任务 == 任务
            && 记录.请求.任务序号 > 最新序号) {
            最新序号 = 记录.请求.任务序号;
        }
    }
    if (最新序号 == 0) {
        强类型同任务最新序号.erase(任务);
    } else {
        强类型同任务最新序号[任务] = 最新序号;
    }
}

inline 强类型任务执行请求候选::强类型任务执行请求候选(
    强类型任务执行请求候选&& 其他) noexcept
    : 所有者_(其他.所有者_), 请求编号_(其他.请求编号_),
      预留代次_(其他.预留代次_), 已决定_(其他.已决定_) {
    其他.所有者_ = nullptr;
    其他.请求编号_ = 0;
    其他.预留代次_ = 0;
    其他.已决定_ = true;
}

inline 强类型任务执行请求候选& 强类型任务执行请求候选::operator=(
    强类型任务执行请求候选&& 其他) noexcept {
    if (this == &其他) return *this;
    if (有效()) 所有者_->析构撤销强类型请求(请求编号_, 预留代次_);
    所有者_ = 其他.所有者_;
    请求编号_ = 其他.请求编号_;
    预留代次_ = 其他.预留代次_;
    已决定_ = 其他.已决定_;
    其他.所有者_ = nullptr;
    其他.请求编号_ = 0;
    其他.预留代次_ = 0;
    其他.已决定_ = true;
    return *this;
}

inline 强类型任务执行请求候选::~强类型任务执行请求候选() {
    if (有效()) 所有者_->析构撤销强类型请求(请求编号_, 预留代次_);
}

}
