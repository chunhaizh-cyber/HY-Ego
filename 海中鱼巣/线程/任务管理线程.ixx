// 文件规则：任务管理线程管理任务请求、结果上行与主阶段治理工作项；
// 业务事实只经注入的正式 provider 形成，不在本线程复制领域写入逻辑。
module;

#include "../核心/句柄.h"

#include <atomic>
#include <chrono>
#include <cstddef>
#include <cstdint>
#include <condition_variable>
#include <deque>
#include <functional>
#include <mutex>
#include <new>
#include <optional>
#include <thread>
#include <unordered_map>
#include <utility>

export module 海中鱼巣.线程.任务管理线程;

import 海中鱼巣.线程.运行消息协议;
import 海中鱼巣.线程.有界运行消息队列;
import 海中鱼巣.线程.协议.任务执行请求;
import 海中鱼巣.线程.协议.任务动作完成消息;
import 海中鱼巣.线程.任务结果回执协议;
import 海中鱼巣.线程.上行桥.任务实际结果;
import 海中鱼巣.线程.自我治理消息协议;
import 海中鱼巣.线程.创建.自我线程;
import 海中鱼巣.领域.组合.任务动作权威结果读回;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.内部治理.服务.任务阶段结构消费端口;
import 海中鱼巣.领域.内部治理.服务.任务结果消费分配与轮次结算;
import 海中鱼巣.领域.内部治理.服务.任务主阶段治理;
import 海中鱼巣.领域.自我治理.服务.自我任务后继决议;

export namespace 海中鱼巣 {

enum class 任务管理线程状态 : std::uint32_t {
    未启动 = 0,
    运行中 = 1,
    正在停止 = 2,
    已停止 = 3,
    启动失败 = 4
};

enum class 任务管理线程拒绝原因 : std::uint32_t {
    无 = 0,
    重复启动 = 1,
    队列容量为零 = 2,
    未启动 = 3,
    停止消息失败 = 4,
    非任务执行请求 = 5,
    请求入队失败 = 6,
    线程创建失败 = 7
};

struct 任务管理线程操作结果 {
    bool 成功 = false;
    bool 局部失败 = true;
    bool 写业务事实 = false;
    任务管理线程拒绝原因 拒绝原因 = 任务管理线程拒绝原因::无;
};

enum class 强类型任务执行请求队列状态 : std::uint8_t {
    已拒绝 = 0,
    已预留 = 1,
    已确认 = 2,
    已撤销 = 3,
    已取出 = 4,
    精确重复 = 5,
    无请求 = 6,
    内部不一致 = 7
};

enum class 强类型任务执行请求队列拒绝原因 : std::uint8_t {
    无 = 0,
    请求无效 = 1,
    管理线程未运行 = 2,
    队列已停止 = 3,
    容量为零 = 4,
    队列已满 = 5,
    请求已过期 = 6,
    请求编号冲突 = 7,
    幂等键冲突 = 8,
    任务序号倒退 = 9,
    任务序号冲突 = 10,
    候选能力无效 = 11,
    候选状态冲突 = 12
};

class 任务管理线程;

class 强类型任务执行请求候选 final {
public:
    强类型任务执行请求候选() = delete;
    强类型任务执行请求候选(const 强类型任务执行请求候选&) = delete;
    强类型任务执行请求候选& operator=(const 强类型任务执行请求候选&) = delete;

    强类型任务执行请求候选(强类型任务执行请求候选&& 其他) noexcept;
    强类型任务执行请求候选& operator=(强类型任务执行请求候选&& 其他) noexcept;
    ~强类型任务执行请求候选();

    bool 有效() const noexcept {
        return 所有者_ != nullptr && 请求编号_ != 0 && 预留代次_ != 0 && !已决定_;
    }

    std::uint64_t 读取请求编号() const noexcept { return 请求编号_; }
    std::uint64_t 读取预留代次() const noexcept { return 预留代次_; }

private:
    friend class 任务管理线程;

    强类型任务执行请求候选(
        任务管理线程* 所有者,
        std::uint64_t 请求编号,
        std::uint64_t 预留代次) noexcept
        : 所有者_(所有者), 请求编号_(请求编号), 预留代次_(预留代次) {
    }

    void 置为已决定() noexcept {
        所有者_ = nullptr;
        请求编号_ = 0;
        预留代次_ = 0;
        已决定_ = true;
    }

    任务管理线程* 所有者_ = nullptr;
    std::uint64_t 请求编号_ = 0;
    std::uint64_t 预留代次_ = 0;
    bool 已决定_ = false;
};

struct 强类型任务执行请求准备结果 {
    强类型任务执行请求队列状态 状态 = 强类型任务执行请求队列状态::已拒绝;
    强类型任务执行请求队列拒绝原因 拒绝原因 =
        强类型任务执行请求队列拒绝原因::无;
    std::optional<强类型任务执行请求候选> 候选;
};

struct 强类型任务执行请求操作结果 {
    强类型任务执行请求队列状态 状态 = 强类型任务执行请求队列状态::已拒绝;
    强类型任务执行请求队列拒绝原因 拒绝原因 =
        强类型任务执行请求队列拒绝原因::无;

    bool 成功() const noexcept {
        return 状态 == 强类型任务执行请求队列状态::已确认
            || 状态 == 强类型任务执行请求队列状态::已撤销;
    }
};

struct 强类型任务执行请求取出结果 {
    强类型任务执行请求队列状态 状态 = 强类型任务执行请求队列状态::无请求;
    bool 队列已停止 = false;
    std::optional<任务强类型执行请求> 请求;
};

struct 强类型任务执行请求队列快照 {
    std::uint64_t 容量 = 0;
    std::uint64_t 预留数量 = 0;
    std::uint64_t 可消费数量 = 0;
    std::uint64_t 已见请求数量 = 0;
    std::uint64_t 已见幂等键数量 = 0;
    std::uint64_t 同任务顺序数量 = 0;
    bool 已停止 = false;
};

class 任务管理线程 : public 自我线程任务管理提交端口 {
public:
    explicit 任务管理线程(std::uint64_t 调度队列容量)
        : 任务管理线程(调度队列容量, 调度队列容量) {
    }

    任务管理线程(
        std::uint64_t 调度队列容量,
        std::uint64_t 强类型请求队列容量)
        : 任务调度队列(调度队列容量),
          强类型请求容量上限(强类型请求队列容量) {
    }

    任务管理线程(
        std::uint64_t 调度队列容量,
        std::uint64_t 强类型请求队列容量,
        std::uint64_t 结果上行容量,
        std::uint64_t 最大来源需求成员数,
        任务实际结果上行桥& 上行桥,
        任务动作完成消息端口& 完成消息端口,
        const 任务动作权威结果读回提供者& 权威结果读回,
        自我线程& 自我治理目标,
        任务主阶段治理提供者& 主阶段治理提供者,
        L2任务结构服务& 任务结构服务,
        任务阶段结构消费端口& 阶段端口,
        任务结果消费分配与轮次结算提供者& 任务结算提供者,
        自我任务后继决议提供者& 自我后继决议提供者) noexcept
        : 任务调度队列(调度队列容量),
          强类型请求容量上限(强类型请求队列容量),
          结果上行容量上限_(结果上行容量),
          最大来源需求成员数_(最大来源需求成员数),
          结果上行桥_(&上行桥),
          完成消息端口_(&完成消息端口),
          权威结果读回_(&权威结果读回),
          自我治理目标_(&自我治理目标),
          主阶段治理提供者_(&主阶段治理提供者),
          任务结构服务_(&任务结构服务),
          阶段端口_(&阶段端口),
          任务结算提供者_(&任务结算提供者),
          自我后继决议提供者_(&自我后继决议提供者) {
    }

    ~任务管理线程() {
        {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            强类型请求停止锁存 = true;
        }
        {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            结果上行停止锁存_ = true;
            结果上行排空请求_ = true;
        }
        请求停止.store(true);
        结果上行条件_.notify_all();
        if (线程.joinable()) {
            线程.join();
        }
    }

    任务管理线程(const 任务管理线程&) = delete;
    任务管理线程& operator=(const 任务管理线程&) = delete;

    // 预冻结 self -> manager 三入口。当前仅锁定 ABI；正式队列、独立读回
    // 和 task-owner 写入由后续任务管理线程切片实现。未实现期间只返回
    // 合法等待，绝不把空函数伪装成任务事实已经形成。
    自我线程治理端口结果 提交已确认子目标承接记录意图(
        const 自我线程治理端口请求& 请求) noexcept override {
        return 预冻结自我治理提交结果(请求);
    }

    自我线程治理端口结果 提交任务承接意图(
        const 自我线程治理端口请求& 请求) noexcept override {
        return 预冻结自我治理提交结果(请求);
    }

    自我线程治理端口结果 提交自我任务后继决议(
        const 自我线程治理端口请求& 请求) noexcept override {
        return 预冻结自我治理提交结果(请求);
    }

    任务管理线程状态 当前状态() const {
        return 状态.load();
    }

    bool 线程已进入() const {
        return 已进入.load();
    }

    bool 线程可收口() const {
        return !线程.joinable();
    }

    const 有界运行消息队列& 只读任务调度队列() const {
        return 任务调度队列;
    }

    强类型任务执行请求准备结果 准备强类型任务执行请求(
        const 任务强类型执行请求& 请求);

    强类型任务执行请求操作结果 确认强类型任务执行请求(
        强类型任务执行请求候选& 候选);

    强类型任务执行请求操作结果 撤销强类型任务执行请求(
        强类型任务执行请求候选& 候选);

    强类型任务执行请求取出结果 取出强类型任务执行请求();

    强类型任务执行请求队列快照 读取强类型任务执行队列快照() const;

    任务工作结果槽结果 提交任务工作结果定位(
        const 任务工作结果定位& 定位) noexcept {
        if (!任务工作结果定位有效(定位)
            || 状态.load() != 任务管理线程状态::运行中)
            return {任务工作结果槽状态::入口拒绝, std::nullopt};
        try {
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            const auto 键 = 定位.执行幂等身份.值;
            const auto 已有 = 工作结果定位槽_.find(键);
            if (已有 != 工作结果定位槽_.end()) {
                if (已有->second.定位 != 定位)
                    return {任务工作结果槽状态::幂等冲突, std::nullopt};
                if (!已有->second.已排队 && !已有->second.已完成) {
                    已有->second.已排队 = true;
                    工作结果定位待处理_.push_back(键);
                    结果上行条件_.notify_one();
                }
                return {任务工作结果槽状态::精确重复, 定位};
            }
            if (结果上行容量上限_ == 0
                || 工作结果定位槽_.size() >= 结果上行容量上限_)
                return {任务工作结果槽状态::资源失败, std::nullopt};
            任务工作结果定位内部槽 槽;
            槽.定位 = 定位;
            槽.已排队 = true;
            工作结果定位槽_.emplace(键, std::move(槽));
            工作结果定位待处理_.push_back(键);
            结果上行条件_.notify_one();
            return {任务工作结果槽状态::已接收, 定位};
        } catch (const std::bad_alloc&) {
            return {任务工作结果槽状态::资源失败, std::nullopt};
        } catch (...) {
            return {任务工作结果槽状态::内部错误, std::nullopt};
        }
    }

    任务管理线程操作结果 提交任务主阶段治理请求(
        const 任务主阶段治理请求& 请求) noexcept {
        if (状态.load() != 任务管理线程状态::运行中
            || 主阶段治理提供者_ == nullptr
            || !形成任务治理同截止材料(请求))
            return 拒绝(任务管理线程拒绝原因::请求入队失败);
        try {
            std::lock_guard<std::mutex> 锁(主阶段治理锁_);
            for (const auto& 待处理 : 主阶段治理待处理_)
                if (待处理.请求 == 请求)
                    return {true, false, false, 任务管理线程拒绝原因::无};
            if (结果上行容量上限_ == 0
                || 主阶段治理待处理_.size() >= 结果上行容量上限_)
                return 拒绝(任务管理线程拒绝原因::请求入队失败);
            主阶段治理待处理_.push_back({请求, 0});
            结果上行条件_.notify_one();
            return {true, false, false, 任务管理线程拒绝原因::无};
        } catch (...) {
            return 拒绝(任务管理线程拒绝原因::请求入队失败);
        }
    }

    任务工作结果槽结果 读取任务工作结果定位(
        稳定编码 执行幂等身份) const noexcept {
        if (!有效(执行幂等身份))
            return {任务工作结果槽状态::入口拒绝, std::nullopt};
        try {
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            const auto 位置 = 工作结果定位槽_.find(执行幂等身份.值);
            if (位置 == 工作结果定位槽_.end())
                return {任务工作结果槽状态::未找到, std::nullopt};
            return {位置->second.已取出
                    ? 任务工作结果槽状态::已取出
                    : 任务工作结果槽状态::已接收,
                位置->second.定位};
        } catch (const std::bad_alloc&) {
            return {任务工作结果槽状态::资源失败, std::nullopt};
        } catch (...) {
            return {任务工作结果槽状态::内部错误, std::nullopt};
        }
    }

    任务工作结果槽结果 取出任务工作结果定位() noexcept {
        try {
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            while (!工作结果定位待处理_.empty()) {
                const auto 键 = 工作结果定位待处理_.front();
                工作结果定位待处理_.pop_front();
                const auto 位置 = 工作结果定位槽_.find(键);
                if (位置 == 工作结果定位槽_.end()) continue;
                位置->second.已排队 = false;
                位置->second.已取出 = true;
                return {任务工作结果槽状态::已取出, 位置->second.定位};
            }
            return {任务工作结果槽状态::未找到, std::nullopt};
        } catch (const std::bad_alloc&) {
            return {任务工作结果槽状态::资源失败, std::nullopt};
        } catch (...) {
            return {任务工作结果槽状态::内部错误, std::nullopt};
        }
    }

    任务管理线程操作结果 请求停止新派发() noexcept {
        if (状态.load() != 任务管理线程状态::运行中) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }
        std::lock_guard<std::mutex> 锁(强类型请求队列锁);
        强类型请求停止锁存 = true;
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 排空结果上行并停止() noexcept {
        if (状态.load() != 任务管理线程状态::运行中
            && 状态.load() != 任务管理线程状态::正在停止) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }
        {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            结果上行停止锁存_ = true;
            结果上行排空请求_ = true;
        }
        状态.store(任务管理线程状态::正在停止);
        结果上行条件_.notify_all();
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 启动() {
        if (状态.load() == 任务管理线程状态::运行中) {
            return 拒绝(任务管理线程拒绝原因::重复启动);
        }
        if (任务调度队列.容量() == 0) {
            状态.store(任务管理线程状态::启动失败);
            return 拒绝(任务管理线程拒绝原因::队列容量为零);
        }
        const bool 配置结果链 = 结果上行桥_ != nullptr;
        if (配置结果链 != (自我治理目标_ != nullptr)
            || 配置结果链 != (完成消息端口_ != nullptr)
            || 配置结果链 != (权威结果读回_ != nullptr)
            || 配置结果链 != (主阶段治理提供者_ != nullptr)
            || (配置结果链
                && (结果上行容量上限_ == 0 || 最大来源需求成员数_ == 0))) {
            状态.store(任务管理线程状态::启动失败);
            return 拒绝(任务管理线程拒绝原因::队列容量为零);
        }

        {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            强类型请求停止锁存 = false;
        }
        {
            std::lock_guard<std::mutex> 锁(结果上行锁_);
            结果上行停止锁存_ = false;
            结果上行排空请求_ = false;
        }
        请求停止.store(false);
        已进入.store(false);
        状态.store(任务管理线程状态::运行中);
        try {
            线程 = std::thread([this]() {
                已进入.store(true);
                if (结果上行桥_ != nullptr && 自我治理目标_ != nullptr
                    && 完成消息端口_ != nullptr && 权威结果读回_ != nullptr) {
                    运行结果上行循环();
                } else {
                    std::unique_lock<std::mutex> 锁(结果上行锁_);
                    结果上行条件_.wait(锁, [this]() noexcept {
                        return 请求停止.load();
                    });
                }
            });
        } catch (...) {
            状态.store(任务管理线程状态::启动失败);
            请求停止.store(true);
            return 拒绝(任务管理线程拒绝原因::线程创建失败);
        }
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 发送任务执行请求(const 运行消息& 请求消息) {
        if (状态.load() != 任务管理线程状态::运行中) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }
        if (请求消息.类型 != 运行消息类型::任务执行请求) {
            return 拒绝(任务管理线程拒绝原因::非任务执行请求);
        }
        const auto 入队 = 任务调度队列.入队(请求消息);
        if (!入队.已入队) {
            return 拒绝(任务管理线程拒绝原因::请求入队失败);
        }
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    出队结果 取出任务执行请求() {
        if (状态.load() != 任务管理线程状态::运行中) {
            return {};
        }
        return 任务调度队列.出队();
    }

    任务管理线程操作结果 请求停止并发送停止消息(
        std::uint64_t 停止消息编号, std::uint64_t 停止时间戳) {
        if (状态.load() == 任务管理线程状态::未启动) {
            return 拒绝(任务管理线程拒绝原因::未启动);
        }

        bool 原停止锁存 = false;
        {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            原停止锁存 = 强类型请求停止锁存;
            强类型请求停止锁存 = true;
        }

        运行消息 停止消息;
        停止消息.消息编号 = 停止消息编号;
        停止消息.类型 = 运行消息类型::停止;
        停止消息.来源角色 = 运行线程角色::运行宿主;
        停止消息.目标角色 = 运行线程角色::任务管理;
        停止消息.发生时间戳 = 停止时间戳;
        停止消息.优先级 = 运行消息优先级::停止;
        停止消息.幂等键 = 停止消息编号;
        停止消息.材料摘要 = 停止消息编号;
        停止消息.只读材料说明 = true;
        停止消息.承载机器事实 = false;

        const auto 入队 = 任务调度队列.入队(停止消息);
        if (!入队.已入队) {
            std::lock_guard<std::mutex> 锁(强类型请求队列锁);
            强类型请求停止锁存 = 原停止锁存;
            return 拒绝(任务管理线程拒绝原因::停止消息失败);
        }

        状态.store(任务管理线程状态::正在停止);
        请求停止.store(true);
        结果上行条件_.notify_all();
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

    任务管理线程操作结果 收口等待() {
        if (线程.joinable()) {
            线程.join();
        }
        if (状态.load() == 任务管理线程状态::正在停止
            || 状态.load() == 任务管理线程状态::运行中) {
            状态.store(任务管理线程状态::已停止);
        }
        return {true, false, false, 任务管理线程拒绝原因::无};
    }

private:
    static 自我线程治理端口结果 预冻结自我治理提交结果(
        const 自我线程治理端口请求& 请求) noexcept {
        if (请求.合同版本 != 自我线程治理端口合同版本
            || 请求.运行代次 == 0 || 请求.共同事实截止G0 == 0)
            return {自我线程外部调用状态::入口拒绝, 0};
        return {自我线程外部调用状态::合法等待, 0};
    }

    friend class 强类型任务执行请求候选;

    enum class 强类型请求内部状态 : std::uint8_t {
        已预留 = 1,
        已确认 = 2,
        已消费 = 3
    };

    struct 强类型请求内部记录 {
        任务强类型执行请求 请求;
        std::uint64_t 预留代次 = 0;
        强类型请求内部状态 状态 = 强类型请求内部状态::已预留;
    };

    struct 任务工作结果定位内部槽 {
        任务工作结果定位 定位;
        std::optional<任务动作权威结果快照> fresh快照;
        std::optional<任务结果上行形成结果> 上行结果;
        bool 已排队 = false;
        bool 已取出 = false;
        bool 已完成 = false;
    };

    struct 任务主阶段治理内部槽 {
        任务主阶段治理请求 请求;
        std::uint8_t 重试次数 = 0;
    };

    有界运行消息队列 任务调度队列;
    std::uint64_t 强类型请求容量上限 = 0;
    mutable std::mutex 强类型请求队列锁;
    std::unordered_map<std::uint64_t, 强类型请求内部记录> 强类型请求记录;
    std::deque<std::uint64_t> 强类型可消费请求;
    std::uint64_t 强类型预留代次 = 0;
    std::uint64_t 强类型活跃请求数量 = 0;
    bool 强类型请求停止锁存 = false;
    std::atomic<任务管理线程状态> 状态 = 任务管理线程状态::未启动;
    std::atomic<bool> 请求停止 = false;
    std::atomic<bool> 已进入 = false;
    std::thread 线程;
    std::uint64_t 结果上行容量上限_ = 0;
    std::uint64_t 最大来源需求成员数_ = 0;
    任务实际结果上行桥* 结果上行桥_ = nullptr;
    任务动作完成消息端口* 完成消息端口_ = nullptr;
    const 任务动作权威结果读回提供者* 权威结果读回_ = nullptr;
    自我线程* 自我治理目标_ = nullptr;
    任务主阶段治理提供者* 主阶段治理提供者_ = nullptr;
    L2任务结构服务* 任务结构服务_ = nullptr;
    任务阶段结构消费端口* 阶段端口_ = nullptr;
    任务结果消费分配与轮次结算提供者* 任务结算提供者_ = nullptr;
    自我任务后继决议提供者* 自我后继决议提供者_ = nullptr;
    mutable std::mutex 工作结果定位锁_;
    std::unordered_map<std::uint64_t, 任务工作结果定位内部槽>
        工作结果定位槽_;
    std::deque<std::uint64_t> 工作结果定位待处理_;
    mutable std::mutex 主阶段治理锁_;
    std::deque<任务主阶段治理内部槽> 主阶段治理待处理_;
    mutable std::mutex 结果上行锁_;
    std::condition_variable 结果上行条件_;
    bool 结果上行停止锁存_ = false;
    bool 结果上行排空请求_ = false;
    任务管理线程操作结果 拒绝(任务管理线程拒绝原因 原因) const {
        return {false, true, false, 原因};
    }

    static 强类型任务执行请求准备结果 拒绝强类型请求准备(
        强类型任务执行请求队列拒绝原因 原因) {
        return {强类型任务执行请求队列状态::已拒绝, 原因, std::nullopt};
    }

    static 强类型任务执行请求操作结果 拒绝强类型请求操作(
        强类型任务执行请求队列拒绝原因 原因) noexcept {
        return {强类型任务执行请求队列状态::已拒绝, 原因};
    }

    std::optional<任务主阶段治理请求> 形成任务治理同截止材料(
        const 任务主阶段治理请求& 来源) const noexcept {
        if (任务结构服务_ == nullptr || 阶段端口_ == nullptr
            || 来源.合同版本 != 任务主阶段治理合同版本
            || !L2结构请求头合同有效(来源.请求头)
            || 来源.请求头.期望事实代次 == 0
            || !有效(来源.任务.值) || !有效(来源.当前任务轮次.值)
            || !有效(来源.任务正式存在.值)
            || !有效(来源.阶段特征实例.值)
            || !任务阶段值有效(来源.期望阶段))
            return std::nullopt;
        try {
            const auto G = 来源.请求头.期望事实代次;
            const auto 读前 = 任务结构服务_->按任务读取当前任务与轮次({
                L2按任务读取当前任务与轮次合同版本,
                {L2结构合同版本, G}, 来源.任务});
            if (!读前.成功() || !读前.任务 || !读前.当前任务轮次
                || 读前.本次正式读回截止 != G
                || 读前.任务->身份 != 来源.任务
                || 读前.当前任务轮次->身份 != 来源.当前任务轮次
                || 读前.当前任务轮次->任务 != 来源.任务)
                return std::nullopt;

            const auto 筹办 = 任务结构服务_->按任务读取筹办轮次分区({
                {L2结构合同版本, G}, L2读取类别::当前, 来源.任务, 0});
            if (!筹办.成功()
                || 筹办.结果头.事实截止代次 != G
                || 筹办.分区 != L2任务筹办轮次分区::统一轮次权威
                || !筹办.统一当前准备
                || !筹办.统一当前准备->轮次权威.任务轮次
                || !筹办.统一当前准备->轮次权威.正式存在
                || !筹办.统一当前准备->轮次权威.阶段特征实例
                || *筹办.统一当前准备->轮次权威.任务轮次
                    != 来源.当前任务轮次
                || *筹办.统一当前准备->轮次权威.正式存在
                    != 来源.任务正式存在
                || *筹办.统一当前准备->轮次权威.阶段特征实例
                    != 来源.阶段特征实例)
                return std::nullopt;

            const auto 阶段 = 阶段端口_->读取当前阶段({
                任务阶段结构消费合同版本,
                {L2结构合同版本, G}, 来源.任务正式存在,
                来源.阶段特征实例});
            if (!阶段.成功() || !阶段.当前状态 || !阶段.当前选择
                || 阶段.本次正式读回截止 != G
                || 阶段.当前选择->引用方 != 来源.任务正式存在.值
                || 阶段.当前选择->引用角色 != 来源.阶段特征实例.值
                || 阶段.当前选择->目标状态 != 阶段.当前状态->身份)
                return std::nullopt;

            const auto 读后 = 任务结构服务_->按任务读取当前任务与轮次({
                L2按任务读取当前任务与轮次合同版本,
                {L2结构合同版本, G}, 来源.任务});
            if (!读后.成功() || !读后.任务 || !读后.当前任务轮次
                || 读后.本次正式读回截止 != G
                || *读后.任务 != *读前.任务
                || *读后.当前任务轮次 != *读前.当前任务轮次)
                return std::nullopt;
            return 来源;
        } catch (...) {
            return std::nullopt;
        }
    }

    std::optional<自我治理消息> 形成已收束任务结果复核消息(
        const 任务工作结果定位& 定位,
        const 任务动作权威结果快照& 快照,
        const 任务结果上行形成结果& 上行结果,
        const 任务轮次收束结果& 收束结果) const noexcept {
        if (!任务工作结果定位有效(定位)
            || !任务动作权威结果快照有效(快照)
            || !上行结果.成功() || !上行结果.正式结果
            || !收束结果.成功() || !收束结果.轮次结算
            || !收束结果.阶段迁移证据
            || 收束结果.阶段正式读回截止 == 0)
            return std::nullopt;
        try {
            const auto& 正式结果 = *上行结果.正式结果;
            const auto& 结算 = *收束结果.轮次结算;
            const auto& 阶段证据 = *收束结果.阶段迁移证据;
            const auto 阶段载荷 =
                解码任务阶段中性状态_v2(阶段证据.新状态);
            const auto G阶段 = 收束结果.阶段正式读回截止;
            if (正式结果.任务 != 定位.任务
                || 正式结果.运行代次 != 定位.运行代次
                || 结算.任务 != 定位.任务
                || 结算.任务轮次 != 定位.任务轮次
                || !结算.实际结果
                || *结算.实际结果 != 正式结果.身份
                || 结算.来源共同事实截止 == 0
                || 结算.来源共同事实截止 > G阶段
                || 结算.结算规则版本 != L2任务轮次结算规则版本
                || 结算.生命周期.创建事实代次 == 0
                || 结算.生命周期.创建事实代次 > G阶段
                || 结算.生命周期.退出事实代次
                || !阶段载荷
                || 阶段证据.状态事实代次 == 0
                || 阶段证据.动态事实代次 == 0
                || 阶段证据.引用事实代次 == 0
                || 阶段证据.引用事实代次 > G阶段
                || 阶段载荷->来源
                    != 收束结果.轮次收束治理动作->身份.值)
                return std::nullopt;

            const auto 回执形成 = 形成任务结果回执(定位, 快照);
            if (!回执形成.成功() || !回执形成.回执)
                return std::nullopt;
            const auto& 回执 = *回执形成.回执;

            std::uint64_t 摘要 = 回执.非权威材料摘要;
            const auto 混合 = [&摘要](std::uint64_t 值) noexcept {
                摘要 ^= 值;
                摘要 *= 1099511628211ULL;
            };
            混合(正式结果.身份.值.值);
            混合(定位.任务轮次.值.值);
            混合(结算.身份.值.值);
            混合(G阶段);
            if (摘要 == 0) 摘要 = 1;

            自我治理消息 消息;
            消息.协议版本 = 自我治理协议版本;
            消息.治理消息编号 = 回执.回执编号;
            消息.类型 = 自我治理消息类型::任务结果复核请求;
            消息.来源角色 = 自我治理来源角色::任务管理上行桥;
            消息.来源服务 = 自我治理服务角色::任务桥边界;
            消息.目标服务 = 自我治理服务角色::任务;
            消息.发生时间戳 = 回执.发生时间戳;
            消息.优先级 = 自我治理消息优先级::普通;
            消息.幂等键 = 回执.幂等键;
            消息.来源任务序号 = 回执.来源任务序号;
            消息.来源材料版本 = 正式结果.来源材料版本;
            消息.批次编号 = 回执.批次编号;
            消息.非权威材料摘要 = 摘要;
            消息.材料类型 = 自我治理只读材料类型::任务结果材料;
            消息.材料性质 = 自我治理材料性质::非权威回执;
            消息.过期策略 = 自我治理过期策略::永不过期;
            消息.截止时间戳 = 0;
            消息.运行代次 = 正式结果.运行代次;
            消息.读取截止代次 = G阶段;
            消息.载荷 = 任务结果复核载荷{
                正式结果.任务, 定位.任务轮次, 结算.身份,
                正式结果.实际状态, 正式结果.动态证据,
                正式结果.方法, 正式结果.动作入口,
                正式结果.场景, 正式结果.主体,
                回执.任务治理首态写入幂等身份};

            自我治理准入上下文 上下文;
            上下文.当前时间戳 = 消息.发生时间戳;
            const auto 复核 = 复核自我治理消息(消息, 上下文);
            return 复核.状态 == 自我治理准入状态::可准入
                ? std::optional<自我治理消息>{std::move(消息)}
                : std::nullopt;
        } catch (...) {
            return std::nullopt;
        }
    }

    bool 复核强类型请求重复_已锁定(
        const 任务强类型执行请求& 请求,
        强类型任务执行请求准备结果& 输出);

    强类型任务执行请求准备结果 预留强类型任务执行请求_已锁定(
        const 任务强类型执行请求& 请求);

    bool 全部结果上行可收口_已锁定() const noexcept {
        try {
            {
                std::lock_guard<std::mutex> 治理锁(主阶段治理锁_);
                if (!主阶段治理待处理_.empty()) return false;
            }
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            if (!工作结果定位待处理_.empty()) return false;
            for (const auto& [执行键, 槽] : 工作结果定位槽_) {
                (void)执行键;
                if (!槽.已完成) return false;
            }
            return true;
        } catch (...) {
            return false;
        }
    }

    bool 有待处理工作定位() const noexcept {
        try {
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            return !工作结果定位待处理_.empty();
        } catch (...) {
            return false;
        }
    }

    bool 有待处理主阶段治理() const noexcept {
        try {
            std::lock_guard<std::mutex> 锁(主阶段治理锁_);
            return !主阶段治理待处理_.empty();
        } catch (...) {
            return false;
        }
    }

    void 排队下一主阶段正式读回(
        const 任务主阶段治理请求& 原请求,
        const 任务主阶段治理结果& 结果) noexcept {
        try {
            if (!结果.阶段迁移结果 || !结果.阶段迁移结果->迁移证据
                || 结果.阶段迁移结果->本次正式读回截止 == 0)
                return;
            const auto G = 结果.阶段迁移结果->本次正式读回截止;
            任务主阶段治理请求 下一请求 = 原请求;
            下一请求.请求头.期望事实代次 = G;
            下一请求.后继消费请求.reset();
            if (结果.状态 == 任务主阶段治理状态::筹办已冻结) {
                下一请求.期望阶段 = {
                    任务主阶段::筹办, 任务业务状态段::可执行已冻结};
                下一请求.筹办请求.reset();
                下一请求.转入筹办等待材料.reset();
                下一请求.转入可执行已冻结材料.reset();
            } else if (结果.状态 == 任务主阶段治理状态::筹办已等待) {
                下一请求.期望阶段 = {
                    任务主阶段::筹办, 任务业务状态段::筹办等待};
                下一请求.转入筹办等待材料.reset();
            } else {
                return;
            }
            const auto 同截止材料 = 形成任务治理同截止材料(下一请求);
            if (!同截止材料) return;
            下一请求 = *同截止材料;
            std::lock_guard<std::mutex> 锁(主阶段治理锁_);
            for (const auto& 待处理 : 主阶段治理待处理_)
                if (待处理.请求 == 下一请求) return;
            if (结果上行容量上限_ == 0
                || 主阶段治理待处理_.size() >= 结果上行容量上限_)
                return;
            主阶段治理待处理_.push_back({std::move(下一请求), 0});
            结果上行条件_.notify_one();
        } catch (...) {
        }
    }

    void 处理一个主阶段治理请求() noexcept {
        if (主阶段治理提供者_ == nullptr) return;
        std::optional<任务主阶段治理内部槽> 槽;
        try {
            {
                std::lock_guard<std::mutex> 锁(主阶段治理锁_);
                if (主阶段治理待处理_.empty()) return;
                槽 = std::move(主阶段治理待处理_.front());
                主阶段治理待处理_.pop_front();
            }
            const auto 结果 = 主阶段治理提供者_->治理当前任务阶段(槽->请求);
            switch (结果.状态) {
            case 任务主阶段治理状态::资源失败:
            case 任务主阶段治理状态::已可能发布:
                if (槽->重试次数 >= 3) return;
                ++槽->重试次数;
                {
                    std::lock_guard<std::mutex> 锁(主阶段治理锁_);
                    主阶段治理待处理_.push_back(std::move(*槽));
                    结果上行条件_.notify_one();
                }
                return;
            case 任务主阶段治理状态::筹办已冻结:
            case 任务主阶段治理状态::筹办已等待:
                排队下一主阶段正式读回(槽->请求, 结果);
                return;
            case 任务主阶段治理状态::已选择阶段:
            case 任务主阶段治理状态::后继已消费:
            case 任务主阶段治理状态::后继决议未找到:
            case 任务主阶段治理状态::后继决议不适用:
            case 任务主阶段治理状态::阶段待迁移:
            case 任务主阶段治理状态::入口拒绝:
            case 任务主阶段治理状态::许可拒绝:
            case 任务主阶段治理状态::当前性漂移:
            case 任务主阶段治理状态::幂等冲突:
            case 任务主阶段治理状态::引用冲突:
            case 任务主阶段治理状态::内部不一致:
            default:
                return;
            }
        } catch (...) {
        }
    }

    void 重新排队工作定位(std::uint64_t 键) noexcept {
        try {
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            const auto 位置 = 工作结果定位槽_.find(键);
            if (位置 == 工作结果定位槽_.end() || 位置->second.已完成
                || 位置->second.已排队)
                return;
            位置->second.已排队 = true;
            工作结果定位待处理_.push_back(键);
            结果上行条件_.notify_one();
        } catch (...) {
        }
    }

    void 处理一个工作定位() noexcept {
        const auto 取出 = 取出任务工作结果定位();
        if (!取出.成功() || !取出.工作结果定位) return;
        任务工作结果定位 定位 = *取出.工作结果定位;
        const auto 键 = 定位.执行幂等身份.值;
        std::optional<任务动作权威结果快照> 快照;
        std::optional<任务结果上行形成结果> 已形成;
        {
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            const auto 位置 = 工作结果定位槽_.find(键);
            if (位置 == 工作结果定位槽_.end()) return;
            快照 = 位置->second.fresh快照;
            已形成 = 位置->second.上行结果;
        }

        if (!快照) {
            const auto 消息 = 完成消息端口_->读取动作完成消息(
                定位.执行幂等身份, 定位.运行代次,
                定位.最后动作顺序);
            if (!消息.成功() || !消息.消息) {
                if (消息.状态 == 任务动作完成消息状态::未找到
                    || 消息.状态 == 任务动作完成消息状态::资源失败) {
                    重新排队工作定位(键);
                    return;
                }
                标记工作定位完成(键);
                return;
            }
            if (消息.消息->任务 != 定位.任务
                || 消息.消息->任务轮次 != 定位.任务轮次
                || 消息.消息->筹办轮次 != 定位.筹办轮次
                || 消息.消息->执行轮次 != 定位.执行轮次
                || 消息.消息->冻结 != 定位.冻结
                || 消息.消息->冻结版本 != 定位.冻结版本
                || 消息.消息->实例方法 != 定位.实例方法
                || 消息.消息->方法 != 定位.方法
                || 消息.消息->方法内容版本 != 定位.方法内容版本
                || 消息.消息->动作顺序 != 定位.最后动作顺序
                || 消息.消息->运行代次 != 定位.运行代次) {
                标记工作定位完成(键);
                return;
            }
            const auto 读回 = 权威结果读回_->读取动作后权威结果(
                {1, *消息.消息});
            if (!读回.成功() || !读回.快照) {
                if (读回.状态 == 任务动作权威结果读回状态::合法等待
                    || 读回.状态 == 任务动作权威结果读回状态::资源失败) {
                    重新排队工作定位(键);
                    return;
                }
                标记工作定位完成(键);
                return;
            }
            快照 = *读回.快照;
            {
                std::lock_guard<std::mutex> 锁(工作结果定位锁_);
                const auto 位置 = 工作结果定位槽_.find(键);
                if (位置 == 工作结果定位槽_.end()) return;
                位置->second.fresh快照 = 快照;
            }
        }

        if (!已形成) {
            auto 形成 = 结果上行桥_->发布并形成治理消息_v2(
                定位, *快照, 最大来源需求成员数_);
            if (形成.状态 == 任务结果上行形成状态::合法等待
                || 形成.状态 == 任务结果上行形成状态::资源失败) {
                重新排队工作定位(键);
                return;
            }
            if (!形成.成功()) {
                标记工作定位完成(键);
                return;
            }
            已形成 = std::move(形成);
            {
                std::lock_guard<std::mutex> 锁(工作结果定位锁_);
                const auto 位置 = 工作结果定位槽_.find(键);
                if (位置 == 工作结果定位槽_.end()) return;
                位置->second.上行结果 = 已形成;
            }
        }
        // 正式任务结果只进入结算编排。只有轮次结算和收束阶段均已
        // 正式读回后，才允许由形成已收束任务结果复核消息形成 self 载荷。
        标记工作定位完成(键);
    }

    void 标记工作定位完成(std::uint64_t 键) noexcept {
        try {
            std::lock_guard<std::mutex> 锁(工作结果定位锁_);
            const auto 位置 = 工作结果定位槽_.find(键);
            if (位置 != 工作结果定位槽_.end())
                位置->second.已完成 = true;
        } catch (...) {
        }
    }

    void 运行结果上行循环() noexcept {
        for (;;) {
            {
                std::unique_lock<std::mutex> 锁(结果上行锁_);
                结果上行条件_.wait(锁, [this]() noexcept {
                    return 请求停止.load()
                        || 有待处理工作定位()
                        || 有待处理主阶段治理()
                        || 结果上行排空请求_;
                });
                if (!有待处理工作定位() && !有待处理主阶段治理()) {
                    if ((请求停止.load() || 结果上行排空请求_)
                        && 全部结果上行可收口_已锁定()) {
                        break;
                    }
                    continue;
                }
            }
            if (有待处理主阶段治理()) 处理一个主阶段治理请求();
            else 处理一个工作定位();
        }
        请求停止.store(true);
    }

    bool 撤销强类型请求_已锁定(
        std::uint64_t 请求编号,
        std::uint64_t 预留代次);

    void 析构撤销强类型请求(
        std::uint64_t 请求编号,
        std::uint64_t 预留代次) noexcept {
        std::lock_guard<std::mutex> 锁(强类型请求队列锁);
        (void)撤销强类型请求_已锁定(请求编号, 预留代次);
    }
};

inline 强类型任务执行请求准备结果
任务管理线程::准备强类型任务执行请求(const 任务强类型执行请求& 请求) {
    if (!强类型任务执行请求完整(请求)) {
        return 拒绝强类型请求准备(强类型任务执行请求队列拒绝原因::请求无效);
    }
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    if (状态.load() != 任务管理线程状态::运行中) {
        return 拒绝强类型请求准备(
            强类型任务执行请求队列拒绝原因::管理线程未运行);
    }
    if (强类型请求停止锁存) {
        return 拒绝强类型请求准备(强类型任务执行请求队列拒绝原因::队列已停止);
    }
    if (强类型请求容量上限 == 0) {
        return 拒绝强类型请求准备(强类型任务执行请求队列拒绝原因::容量为零);
    }
    强类型任务执行请求准备结果 输出;
    if (复核强类型请求重复_已锁定(请求, 输出)) return 输出;
    if (强类型活跃请求数量 >= 强类型请求容量上限)
        return 拒绝强类型请求准备(
            强类型任务执行请求队列拒绝原因::队列已满);
    return 预留强类型任务执行请求_已锁定(请求);
}

inline bool 任务管理线程::复核强类型请求重复_已锁定(
    const 任务强类型执行请求& 请求,
    强类型任务执行请求准备结果& 输出) {
    const auto 请求编号 = 请求.执行幂等身份.值;
    const auto 请求位置 = 强类型请求记录.find(请求编号);
    if (请求位置 != 强类型请求记录.end()) {
        if (!强类型任务执行请求相同(请求位置->second.请求, 请求)) {
            输出 = 拒绝强类型请求准备(
                强类型任务执行请求队列拒绝原因::幂等键冲突);
        } else if (请求位置->second.状态 == 强类型请求内部状态::已预留) {
            输出 = 拒绝强类型请求准备(
                强类型任务执行请求队列拒绝原因::候选状态冲突);
        } else {
            输出 = {强类型任务执行请求队列状态::精确重复,
                强类型任务执行请求队列拒绝原因::无, std::nullopt};
        }
        return true;
    }
    return false;
}

inline 强类型任务执行请求准备结果
任务管理线程::预留强类型任务执行请求_已锁定(
    const 任务强类型执行请求& 请求) {
    ++强类型预留代次;
    if (强类型预留代次 == 0) ++强类型预留代次;
    const auto 请求编号 = 请求.执行幂等身份.值;
    强类型请求记录.emplace(
        请求编号,
        强类型请求内部记录{
            请求, 强类型预留代次, 强类型请求内部状态::已预留});
    ++强类型活跃请求数量;

    强类型任务执行请求准备结果 输出;
    输出.状态 = 强类型任务执行请求队列状态::已预留;
    输出.候选 = 强类型任务执行请求候选(
        this, 请求编号, 强类型预留代次);
    return 输出;
}

inline 强类型任务执行请求操作结果
任务管理线程::确认强类型任务执行请求(强类型任务执行请求候选& 候选) {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    if (!候选.有效() || 候选.所有者_ != this) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选能力无效);
    }
    const auto 位置 = 强类型请求记录.find(候选.请求编号_);
    if (位置 == 强类型请求记录.end()
        || 位置->second.预留代次 != 候选.预留代次_
        || 位置->second.状态 != 强类型请求内部状态::已预留) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选状态冲突);
    }
    位置->second.状态 = 强类型请求内部状态::已确认;
    强类型可消费请求.push_back(候选.请求编号_);
    候选.置为已决定();
    return {强类型任务执行请求队列状态::已确认,
        强类型任务执行请求队列拒绝原因::无};
}

inline 强类型任务执行请求操作结果
任务管理线程::撤销强类型任务执行请求(强类型任务执行请求候选& 候选) {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    if (!候选.有效() || 候选.所有者_ != this) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选能力无效);
    }
    if (!撤销强类型请求_已锁定(候选.请求编号_, 候选.预留代次_)) {
        return 拒绝强类型请求操作(强类型任务执行请求队列拒绝原因::候选状态冲突);
    }
    候选.置为已决定();
    return {强类型任务执行请求队列状态::已撤销,
        强类型任务执行请求队列拒绝原因::无};
}

inline 强类型任务执行请求取出结果 任务管理线程::取出强类型任务执行请求() {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    const bool 已停止 = 强类型请求停止锁存
        || 状态.load() == 任务管理线程状态::正在停止
        || 状态.load() == 任务管理线程状态::已停止;
    if (强类型可消费请求.empty()) {
        return {强类型任务执行请求队列状态::无请求, 已停止, std::nullopt};
    }
    const auto 请求编号 = 强类型可消费请求.front();
    强类型可消费请求.pop_front();
    const auto 位置 = 强类型请求记录.find(请求编号);
    if (位置 == 强类型请求记录.end()
        || 位置->second.状态 != 强类型请求内部状态::已确认
        || 强类型活跃请求数量 == 0) {
        return {强类型任务执行请求队列状态::内部不一致, 已停止, std::nullopt};
    }
    位置->second.状态 = 强类型请求内部状态::已消费;
    --强类型活跃请求数量;
    return {强类型任务执行请求队列状态::已取出, 已停止, 位置->second.请求};
}

inline 强类型任务执行请求队列快照
任务管理线程::读取强类型任务执行队列快照() const {
    std::lock_guard<std::mutex> 锁(强类型请求队列锁);
    std::uint64_t 预留数量 = 0;
    for (const auto& [编号, 记录] : 强类型请求记录) {
        (void)编号;
        if (记录.状态 == 强类型请求内部状态::已预留) ++预留数量;
    }
    return {
        强类型请求容量上限,
        预留数量,
        static_cast<std::uint64_t>(强类型可消费请求.size()),
        static_cast<std::uint64_t>(强类型请求记录.size()),
        static_cast<std::uint64_t>(强类型请求记录.size()),
        0,
        强类型请求停止锁存
            || 状态.load() == 任务管理线程状态::正在停止
            || 状态.load() == 任务管理线程状态::已停止
    };
}

inline bool 任务管理线程::撤销强类型请求_已锁定(
    std::uint64_t 请求编号,
    std::uint64_t 预留代次) {
    const auto 位置 = 强类型请求记录.find(请求编号);
    if (位置 == 强类型请求记录.end()
        || 位置->second.预留代次 != 预留代次
        || 位置->second.状态 != 强类型请求内部状态::已预留
        || 强类型活跃请求数量 == 0) return false;
    强类型请求记录.erase(位置);
    --强类型活跃请求数量;
    return true;
}

inline 强类型任务执行请求候选::强类型任务执行请求候选(
    强类型任务执行请求候选&& 其他) noexcept
    : 所有者_(其他.所有者_), 请求编号_(其他.请求编号_),
      预留代次_(其他.预留代次_), 已决定_(其他.已决定_) {
    其他.所有者_ = nullptr;
    其他.请求编号_ = 0;
    其他.预留代次_ = 0;
    其他.已决定_ = true;
}

inline 强类型任务执行请求候选& 强类型任务执行请求候选::operator=(
    强类型任务执行请求候选&& 其他) noexcept {
    if (this == &其他) return *this;
    if (有效()) 所有者_->析构撤销强类型请求(请求编号_, 预留代次_);
    所有者_ = 其他.所有者_;
    请求编号_ = 其他.请求编号_;
    预留代次_ = 其他.预留代次_;
    已决定_ = 其他.已决定_;
    其他.所有者_ = nullptr;
    其他.请求编号_ = 0;
    其他.预留代次_ = 0;
    其他.已决定_ = true;
    return *this;
}

inline 强类型任务执行请求候选::~强类型任务执行请求候选() {
    if (有效()) 所有者_->析构撤销强类型请求(请求编号_, 预留代次_);
}

}
