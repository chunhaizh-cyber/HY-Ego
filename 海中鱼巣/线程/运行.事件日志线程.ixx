export namespace 海中鱼巣 {

struct 事件日志线程启动结果;
struct 事件日志线程停止连接结果;

class 事件日志线程租约 final {
public:
  事件日志线程租约(事件日志线程租约 &&来源) noexcept;
  事件日志线程租约 &operator=(事件日志线程租约 &&) = delete;
  事件日志线程租约(const 事件日志线程租约 &) = delete;
  事件日志线程租约 &operator=(const 事件日志线程租约 &) = delete;
  ~事件日志线程租约();

  事件日志提交结果 提交(事件日志摘要 摘要) noexcept;
  事件日志停止接收结果 停止接收并取得截止() noexcept;
  事件日志处理位置 读取处理位置() const noexcept;
  事件日志完成等待结果 等待完成到截止(
      const 事件日志完成等待请求 &请求) const noexcept;
  事件日志未取出快照结果 冻结并读取未取出快照(
      const 事件日志未取出快照请求 &请求) noexcept;
  事件日志线程停止连接结果 停止并连接(
      const 事件日志线程停止连接请求 &请求) && noexcept;

private:
  friend 事件日志线程启动结果 启动事件日志线程(
      const 事件日志线程启动请求 &请求,
      线程生命周期发布端口 &生命周期端口) noexcept;

  事件日志线程租约(
      std::unique_ptr<事件日志线程内部::事件日志线程状态> 队列状态,
      std::unique_ptr<事件日志线程内部::事件日志生产写入适配器>
          写入适配器,
      std::unique_ptr<事件日志线程内部::事件日志线程入口> 线程入口,
      支持线程候选回收请求 析构回收请求,
      支持线程候选租约 &&支持候选租约) noexcept;

  std::unique_ptr<事件日志线程内部::事件日志线程状态> 队列状态_;
  std::unique_ptr<事件日志线程内部::事件日志生产写入适配器>
      写入适配器_;
  std::unique_ptr<事件日志线程内部::事件日志线程入口> 线程入口_;
  支持线程候选回收请求 析构回收请求_;
  std::optional<支持线程候选租约> 支持候选租约_;
};

struct 事件日志线程启动结果 final {
  事件日志线程启动状态 状态 = 事件日志线程启动状态::请求拒绝;
  支持线程候选见证 候选见证;
  std::optional<事件日志线程租约> 线程租约;
};

struct 事件日志线程停止连接结果 final {
  事件日志线程停止连接状态 状态 =
      事件日志线程停止连接状态::内部不一致;
  支持线程候选见证 最终见证;
  事件日志处理位置 最终位置;
};

事件日志线程启动结果 启动事件日志线程(
    const 事件日志线程启动请求 &请求,
    线程生命周期发布端口 &生命周期端口) noexcept;

} // namespace 海中鱼巣

namespace 海中鱼巣::事件日志线程内部 {

struct 事件日志线程状态 final {
  // 诊断责任：无适用错误分支；只保存启动时已校验的运行代次与容量。
  事件日志线程状态(std::uint64_t 运行代次值,
                     std::uint64_t 队列容量值) noexcept
      : 运行代次(运行代次值), 队列容量(队列容量值) {}

  std::uint64_t 运行代次 = 0;
  std::uint64_t 队列容量 = 0;
  mutable std::mutex 锁;
  std::condition_variable 条件;
  std::deque<事件日志排队项> 队列;
  std::uint64_t 接受位置 = 0;
  std::uint64_t 已完成位置 = 0;
  std::optional<std::uint64_t> 正在处理位置;
  std::optional<std::uint64_t> 停止接收截止;
  bool 已冻结取出 = false;
  bool 入口已完成 = false;
  bool 入口已故障 = false;
  std::uint64_t 写入未成功次数 = 0;
  std::optional<std::uint64_t> 已成功读取快照截止;
};

// 诊断责任：无适用错误分支；纯值枚举有效性判断。
inline bool 诊断分类有效(事件日志诊断分类 分类) noexcept {
  switch (分类) {
  case 事件日志诊断分类::运行观察:
  case 事件日志诊断分类::结构观察:
  case 事件日志诊断分类::生命周期观察:
  case 事件日志诊断分类::支持降级观察:
  case 事件日志诊断分类::审计观察:
    return true;
  }
  return false;
}

// 诊断责任：无适用错误分支；纯值摘要形状与运行代次判断。
inline bool 摘要有效(const 事件日志摘要 &摘要,
                     std::uint64_t 运行代次) noexcept {
  return 摘要.合同版本 == 事件日志线程合同版本 && 运行代次 != 0 &&
         摘要.运行代次 == 运行代次 && 摘要.摘要身份 != 0 &&
         摘要.事件发生时间毫秒 != 0 && !摘要.所属模块.empty() &&
         摘要.所属模块.size() <= 事件日志模块最大字符数 &&
         !摘要.入口或操作.empty() &&
         摘要.入口或操作.size() <= 事件日志操作最大字符数 &&
         诊断分类有效(摘要.诊断分类) &&
         (!摘要.稳定编码 || *摘要.稳定编码 != 0) &&
         (!摘要.来源请求摘要 ||
          (!摘要.来源请求摘要->empty() &&
           摘要.来源请求摘要->size() <= 事件日志来源摘要最大字符数)) &&
         !摘要.人读摘要.empty() &&
         摘要.人读摘要.size() <= 事件日志人读摘要最大字符数;
}

// 诊断责任：无适用错误分支；纯值等待上限判断。
inline bool 等待毫秒有效(std::uint64_t 毫秒) noexcept {
  return 毫秒 != 0 && 毫秒 <= 支持线程最大等待毫秒;
}

// 诊断责任：无适用错误分支；纯值启动请求形状判断。
inline bool 启动请求有效(const 事件日志线程启动请求 &请求) noexcept {
  return 请求.合同版本 == 事件日志线程合同版本 && 请求.运行代次 != 0 &&
         请求.线程身份.值 != 0 && 请求.队列容量 != 0 &&
         请求.队列容量 <= 事件日志摘要队列最大容量 &&
         等待毫秒有效(请求.进入等待毫秒) &&
         等待毫秒有效(请求.启动失败回收诊断等待毫秒);
}

// 诊断责任：无适用错误分支；纯值停止请求形状判断。
inline bool 停止请求有效(const 事件日志线程停止连接请求 &请求) noexcept {
  return 请求.合同版本 == 事件日志线程合同版本 &&
         等待毫秒有效(请求.诊断等待毫秒);
}

// 诊断责任：无适用错误分支；在调用者持锁时形成值式位置副本。
inline 事件日志处理位置 形成位置已锁(
    const 事件日志线程状态 &状态) noexcept {
  return {状态.接受位置,
          状态.已完成位置,
          static_cast<std::uint64_t>(状态.队列.size()),
          状态.正在处理位置,
          状态.写入未成功次数,
          状态.停止接收截止.has_value(),
          状态.已冻结取出,
          状态.入口已故障};
}

// 诊断责任：无适用错误分支；在调用者持锁时幂等锁存接受截止。
inline void 锁存停止接收已锁(事件日志线程状态 &状态) noexcept {
  if (!状态.停止接收截止)
    状态.停止接收截止 = 状态.接受位置;
}

// 诊断责任：无适用错误分支；纯值复核安全连接后的队列位置守恒。
inline bool 最终位置完整(const 事件日志处理位置 &位置) noexcept {
  return 位置.已停止接收 && !位置.正在处理位置 &&
         位置.已完成位置 <= 位置.接受位置 &&
         位置.未取出数量 == 位置.接受位置 - 位置.已完成位置;
}

class 事件日志生产写入适配器 final {
public:
  // 诊断责任：向上送出；只返回已写入或未写入，不重复记录失败。
  bool 写入(const 事件日志摘要 &摘要) noexcept {
    try {
      std::wostringstream 内容;
      内容 << L"分类=" << static_cast<std::uint32_t>(摘要.诊断分类)
           << L"; 摘要身份=" << 摘要.摘要身份
           << L"; 发生时间毫秒=" << 摘要.事件发生时间毫秒;
      if (摘要.稳定编码)
        内容 << L"; 稳定编码=" << *摘要.稳定编码;
      if (摘要.来源请求摘要)
        内容 << L"; 来源摘要=" << *摘要.来源请求摘要;
      内容 << L"; 内容=" << 摘要.人读摘要;
      return 记录事件日志(摘要.所属模块, 摘要.入口或操作, 内容.str());
    } catch (...) {
      return false;
    }
  }
};

class 事件日志线程入口 final : public 支持线程入口端口 {
public:
  // 诊断责任：无适用错误分支；只借用同一租约拥有的状态与适配器。
  事件日志线程入口(事件日志线程状态 &状态,
                     事件日志生产写入适配器 &写入适配器) noexcept
      : 状态_(状态), 写入适配器_(写入适配器) {}

  // 诊断责任：向上送出；向 SUPPORT 返回已响应停止或内部故障。
  支持线程入口结果 运行线程入口(
      std::stop_token 停止令牌) override {
    std::stop_callback 停止回调(停止令牌,
                                 [this]() noexcept { 状态_.条件.notify_all(); });
    try {
      for (;;) {
        std::optional<事件日志排队项> 当前项;
        {
          std::unique_lock<std::mutex> 锁(状态_.锁);
          状态_.条件.wait(锁, [this, &停止令牌]() {
            return 停止令牌.stop_requested() || 状态_.入口已故障 ||
                   状态_.已冻结取出 || !状态_.队列.empty();
          });
          if (状态_.入口已故障) {
            锁存停止接收已锁(状态_);
            状态_.入口已完成 = true;
            状态_.条件.notify_all();
            return {支持线程入口退出状态::内部故障,
                    支持线程原因_入口内部故障};
          }
          if (停止令牌.stop_requested()) {
            锁存停止接收已锁(状态_);
            状态_.入口已完成 = true;
            状态_.条件.notify_all();
            return {支持线程入口退出状态::已响应停止,
                    支持线程原因_请求停止};
          }
          if (状态_.已冻结取出) {
            状态_.条件.wait(锁, [this, &停止令牌]() {
              return 停止令牌.stop_requested() || 状态_.入口已故障;
            });
            continue;
          }
          if (状态_.队列.empty())
            continue;
          const auto 期望位置 = 状态_.已完成位置 + 1;
          if (状态_.正在处理位置 ||
              状态_.队列.front().接受位置 != 期望位置) {
            状态_.入口已故障 = true;
            锁存停止接收已锁(状态_);
            状态_.入口已完成 = true;
            状态_.条件.notify_all();
            return {支持线程入口退出状态::内部故障,
                    支持线程原因_入口内部故障};
          }
          当前项.emplace(std::move(状态_.队列.front()));
          状态_.队列.pop_front();
          状态_.正在处理位置 = 当前项->接受位置;
        }

        if (!摘要有效(当前项->摘要, 状态_.运行代次)) {
          std::lock_guard<std::mutex> 锁(状态_.锁);
          状态_.入口已故障 = true;
          锁存停止接收已锁(状态_);
          状态_.正在处理位置.reset();
          状态_.入口已完成 = true;
          状态_.条件.notify_all();
          return {支持线程入口退出状态::内部故障,
                  支持线程原因_入口内部故障};
        }

        const bool 已写入 = 写入适配器_.写入(当前项->摘要);
        {
          std::lock_guard<std::mutex> 锁(状态_.锁);
          if (!状态_.正在处理位置 ||
              *状态_.正在处理位置 != 当前项->接受位置 ||
              状态_.已完成位置 + 1 != 当前项->接受位置) {
            状态_.入口已故障 = true;
            锁存停止接收已锁(状态_);
            状态_.正在处理位置.reset();
            状态_.入口已完成 = true;
            状态_.条件.notify_all();
            return {支持线程入口退出状态::内部故障,
                    支持线程原因_入口内部故障};
          }
          状态_.已完成位置 = 当前项->接受位置;
          状态_.正在处理位置.reset();
          if (!已写入 &&
              状态_.写入未成功次数 !=
                  (std::numeric_limits<std::uint64_t>::max)())
            ++状态_.写入未成功次数;
          状态_.条件.notify_all();
        }
      }
    } catch (...) {
      try {
        std::lock_guard<std::mutex> 锁(状态_.锁);
        状态_.入口已故障 = true;
        锁存停止接收已锁(状态_);
        状态_.正在处理位置.reset();
        状态_.入口已完成 = true;
        状态_.条件.notify_all();
      } catch (...) {
      }
      return {支持线程入口退出状态::内部故障,
              支持线程原因_入口内部故障};
    }
  }

private:
  事件日志线程状态 &状态_;
  事件日志生产写入适配器 &写入适配器_;
};

// 诊断责任：无适用错误分支；纯值映射 SUPPORT 创建非成功状态。
inline 事件日志线程启动状态 映射创建状态(
    支持线程候选创建状态 状态) noexcept {
  switch (状态) {
  case 支持线程候选创建状态::请求拒绝:
    return 事件日志线程启动状态::请求拒绝;
  case 支持线程候选创建状态::身份已使用:
    return 事件日志线程启动状态::身份已使用;
  case 支持线程候选创建状态::线程创建失败:
    return 事件日志线程启动状态::线程创建失败;
  case 支持线程候选创建状态::资源失败:
    return 事件日志线程启动状态::资源失败;
  case 支持线程候选创建状态::已创建:
  case 支持线程候选创建状态::内部不一致:
    return 事件日志线程启动状态::内部不一致;
  }
  return 事件日志线程启动状态::内部不一致;
}

// 诊断责任：无适用错误分支；纯值映射等待与安全回收组合状态。
inline 事件日志线程启动状态 映射失败回收(
    支持线程进入等待状态 等待状态,
    const 支持线程候选回收结果 &回收) noexcept {
  switch (回收.状态) {
  case 支持线程候选回收状态::入口故障已安全连接:
    return 事件日志线程启动状态::入口故障已安全连接;
  case 支持线程候选回收状态::超过诊断预算后已安全连接:
    return 事件日志线程启动状态::超过诊断预算后已安全连接;
  case 支持线程候选回收状态::已安全连接:
    return 等待状态 == 支持线程进入等待状态::等待超时
               ? 事件日志线程启动状态::进入超时已安全连接
               : 事件日志线程启动状态::内部不一致;
  case 支持线程候选回收状态::请求拒绝但已安全连接:
  case 支持线程候选回收状态::内部不一致:
    return 事件日志线程启动状态::内部不一致;
  }
  return 事件日志线程启动状态::内部不一致;
}

} // namespace 海中鱼巣::事件日志线程内部

namespace 海中鱼巣 {

// 诊断责任：无适用错误分支；只按冻结顺序接收唯一拥有体。
事件日志线程租约::事件日志线程租约(
    std::unique_ptr<事件日志线程内部::事件日志线程状态> 队列状态,
    std::unique_ptr<事件日志线程内部::事件日志生产写入适配器>
        写入适配器,
    std::unique_ptr<事件日志线程内部::事件日志线程入口> 线程入口,
    支持线程候选回收请求 析构回收请求,
    支持线程候选租约 &&支持候选租约) noexcept
    : 队列状态_(std::move(队列状态)), 写入适配器_(std::move(写入适配器)),
      线程入口_(std::move(线程入口)), 析构回收请求_(析构回收请求),
      支持候选租约_(std::in_place, std::move(支持候选租约)) {}

// 诊断责任：无适用错误分支；只转移唯一拥有体并清空移动源租约。
事件日志线程租约::事件日志线程租约(事件日志线程租约 &&来源) noexcept
    : 队列状态_(std::move(来源.队列状态_)),
      写入适配器_(std::move(来源.写入适配器_)),
      线程入口_(std::move(来源.线程入口_)),
      析构回收请求_(来源.析构回收请求_),
      支持候选租约_(std::move(来源.支持候选租约_)) {
  来源.支持候选租约_.reset();
}

// 诊断责任：无适用错误分支；析构只执行不抛出的保守安全连接，异常即终止。
事件日志线程租约::~事件日志线程租约() {
  if (!支持候选租约_)
    return;
  try {
    if (队列状态_) {
      {
        std::lock_guard<std::mutex> 锁(队列状态_->锁);
        事件日志线程内部::锁存停止接收已锁(*队列状态_);
      }
      队列状态_->条件.notify_all();
    }
    支持线程候选租约 本地租约(std::move(*支持候选租约_));
    支持候选租约_.reset();
    (void)停止并连接支持线程启动候选(std::move(本地租约),
                                         析构回收请求_);
  } catch (...) {
    std::terminate();
  }
}

// 诊断责任：向上送出；请求、容量、停止和资源分支均由结构化结果携带。
事件日志提交结果 事件日志线程租约::提交(
    事件日志摘要 摘要) noexcept {
  using namespace 事件日志线程内部;
  if (!队列状态_ || !摘要有效(摘要, 队列状态_->运行代次))
    return {};
  try {
    std::uint64_t 新位置 = 0;
    {
      std::lock_guard<std::mutex> 锁(队列状态_->锁);
      if (队列状态_->停止接收截止 || 队列状态_->已冻结取出 ||
          队列状态_->入口已完成)
        return {事件日志提交状态::队列已停止, std::nullopt};
      if (队列状态_->队列.size() >= 队列状态_->队列容量)
        return {事件日志提交状态::队列已满, std::nullopt};
      if (队列状态_->接受位置 ==
          (std::numeric_limits<std::uint64_t>::max)())
        return {事件日志提交状态::内部不一致, std::nullopt};
      新位置 = 队列状态_->接受位置 + 1;
      队列状态_->队列.push_back({新位置, std::move(摘要)});
      队列状态_->接受位置 = 新位置;
    }
    队列状态_->条件.notify_one();
    return {事件日志提交状态::已接受, 新位置};
  } catch (const std::bad_alloc &) {
    return {事件日志提交状态::资源失败, std::nullopt};
  } catch (const std::length_error &) {
    return {事件日志提交状态::资源失败, std::nullopt};
  } catch (...) {
    return {事件日志提交状态::内部不一致, std::nullopt};
  }
}

// 诊断责任：向上送出；返回首次截止、精确重复或内部不一致。
事件日志停止接收结果
事件日志线程租约::停止接收并取得截止() noexcept {
  if (!队列状态_)
    return {};
  try {
    std::lock_guard<std::mutex> 锁(队列状态_->锁);
    if (队列状态_->停止接收截止)
      return {事件日志停止接收状态::精确重复,
              *队列状态_->停止接收截止};
    事件日志线程内部::锁存停止接收已锁(*队列状态_);
    队列状态_->条件.notify_all();
    return {事件日志停止接收状态::已停止并取得截止,
            *队列状态_->停止接收截止};
  } catch (...) {
    return {};
  }
}

// 诊断责任：无适用错误分支；异常防御返回入口故障的保守位置。
事件日志处理位置 事件日志线程租约::读取处理位置() const noexcept {
  if (!队列状态_)
    return {.入口已故障 = true};
  try {
    std::lock_guard<std::mutex> 锁(队列状态_->锁);
    return 事件日志线程内部::形成位置已锁(*队列状态_);
  } catch (...) {
    return {.入口已故障 = true};
  }
}

// 诊断责任：向上送出；超时、入口故障和完成未到达由结果分账。
事件日志完成等待结果 事件日志线程租约::等待完成到截止(
    const 事件日志完成等待请求 &请求) const noexcept {
  using namespace 事件日志线程内部;
  if (!队列状态_ || 请求.合同版本 != 事件日志线程合同版本 ||
      !等待毫秒有效(请求.最大等待毫秒))
    return {};
  try {
    std::unique_lock<std::mutex> 锁(队列状态_->锁);
    if (!队列状态_->停止接收截止 ||
        请求.接受截止 != *队列状态_->停止接收截止)
      return {事件日志完成等待状态::请求拒绝,
              形成位置已锁(*队列状态_)};
    if (队列状态_->入口已故障)
      return {事件日志完成等待状态::入口故障,
              形成位置已锁(*队列状态_)};
    if (请求.接受截止 == 0 && 队列状态_->已完成位置 == 0)
      return {事件日志完成等待状态::无需等待,
              形成位置已锁(*队列状态_)};
    if (队列状态_->已完成位置 >= 请求.接受截止)
      return {事件日志完成等待状态::已到达,
              形成位置已锁(*队列状态_)};
    const bool 已触发 = 队列状态_->条件.wait_for(
        锁, std::chrono::milliseconds(请求.最大等待毫秒),
        [this, &请求]() {
          return 队列状态_->已完成位置 >= 请求.接受截止 ||
                 队列状态_->入口已故障 || 队列状态_->入口已完成;
        });
    const auto 位置 = 形成位置已锁(*队列状态_);
    if (队列状态_->入口已故障)
      return {事件日志完成等待状态::入口故障, 位置};
    if (队列状态_->已完成位置 >= 请求.接受截止)
      return {事件日志完成等待状态::已到达, 位置};
    if (队列状态_->入口已完成)
      return {事件日志完成等待状态::已完成但未到达, 位置};
    if (!已触发)
      return {事件日志完成等待状态::等待超时, 位置};
    return {事件日志完成等待状态::内部不一致, 位置};
  } catch (...) {
    return {事件日志完成等待状态::内部不一致, 读取处理位置()};
  }
}

// 诊断责任：向上送出；资源失败保留冻结队列并允许同截止重试。
事件日志未取出快照结果
事件日志线程租约::冻结并读取未取出快照(
    const 事件日志未取出快照请求 &请求) noexcept {
  using namespace 事件日志线程内部;
  if (!队列状态_ || 请求.合同版本 != 事件日志线程合同版本)
    return {};
  try {
    std::lock_guard<std::mutex> 锁(队列状态_->锁);
    if (!队列状态_->停止接收截止 ||
        请求.接受截止 != *队列状态_->停止接收截止)
      return {事件日志未取出快照状态::请求拒绝, 请求.接受截止,
              std::nullopt, {}};
    const bool 精确重复 =
        队列状态_->已成功读取快照截止 == 请求.接受截止;
    队列状态_->已冻结取出 = true;
    队列状态_->条件.notify_all();
    std::vector<事件日志排队项> 未取出项(队列状态_->队列.begin(),
                                           队列状态_->队列.end());
    队列状态_->已成功读取快照截止 = 请求.接受截止;
    const auto 状态 = 精确重复
                          ? 事件日志未取出快照状态::精确重复
                          : (未取出项.empty()
                                 ? 事件日志未取出快照状态::无未取出项
                                 : 事件日志未取出快照状态::已冻结并读取);
    return {状态, 请求.接受截止, 队列状态_->正在处理位置,
            std::move(未取出项)};
  } catch (const std::bad_alloc &) {
    return {事件日志未取出快照状态::资源失败, 请求.接受截止,
            std::nullopt, {}};
  } catch (const std::length_error &) {
    return {事件日志未取出快照状态::资源失败, 请求.接受截止,
            std::nullopt, {}};
  } catch (...) {
    return {事件日志未取出快照状态::内部不一致, 请求.接受截止,
            std::nullopt, {}};
  }
}

// 诊断责任：向上送出；消费唯一 SUPPORT 租约并返回最终见证与位置。
事件日志线程停止连接结果 事件日志线程租约::停止并连接(
    const 事件日志线程停止连接请求 &请求) && noexcept {
  using namespace 事件日志线程内部;
  if (!支持候选租约_)
    return {事件日志线程停止连接状态::租约已消费, {},
            读取处理位置()};

  const bool 请求合法 = 停止请求有效(请求);
  bool 前置闭合 = false;
  try {
    if (队列状态_) {
      {
        std::lock_guard<std::mutex> 锁(队列状态_->锁);
        if (队列状态_->停止接收截止) {
          const auto 截止 = *队列状态_->停止接收截止;
          前置闭合 = 队列状态_->已完成位置 >= 截止 ||
                     队列状态_->已成功读取快照截止 == 截止;
        } else {
          锁存停止接收已锁(*队列状态_);
        }
      }
      队列状态_->条件.notify_all();
    }

    支持线程候选租约 本地租约(std::move(*支持候选租约_));
    支持候选租约_.reset();
    const auto 回收 = 停止并连接支持线程启动候选(
        std::move(本地租约), 请求合法
                                   ? 支持线程候选回收请求{
                                         支持线程候选合同版本,
                                         请求.诊断等待毫秒}
                                   : 析构回收请求_);
    const auto 最终位置 = 读取处理位置();
    const bool 安全见证 =
        回收.最终见证.已形成物理线程 && 回收.最终见证.已进入 &&
        回收.最终见证.已请求停止 && 回收.最终见证.已完成 &&
        回收.最终见证.已连接 && 回收.最终见证.系统线程身份 &&
        回收.最终见证.入口结果;
    const bool 入口故障 =
        回收.最终见证.入口结果 &&
        回收.最终见证.入口结果->状态 ==
            支持线程入口退出状态::内部故障;

    事件日志线程停止连接状态 状态 =
        事件日志线程停止连接状态::内部不一致;
    if (回收.状态 != 支持线程候选回收状态::内部不一致 && 安全见证 &&
        最终位置完整(最终位置)) {
      if (!请求合法)
        状态 = 事件日志线程停止连接状态::请求拒绝但已安全连接;
      else if (!前置闭合)
        状态 = 事件日志线程停止连接状态::前置未闭合但已安全连接;
      else if (入口故障 ||
               回收.状态 ==
                   支持线程候选回收状态::入口故障已安全连接)
        状态 = 事件日志线程停止连接状态::入口故障已安全连接;
      else if (回收.状态 ==
               支持线程候选回收状态::超过诊断预算后已安全连接)
        状态 =
            事件日志线程停止连接状态::超过诊断预算后已安全连接;
      else if (回收.状态 == 支持线程候选回收状态::已安全连接)
        状态 = 事件日志线程停止连接状态::已安全连接;
    }

    线程入口_.reset();
    写入适配器_.reset();
    队列状态_.reset();
    return {状态, 回收.最终见证, 最终位置};
  } catch (...) {
    return {事件日志线程停止连接状态::内部不一致, {},
            读取处理位置()};
  }
}

// 诊断责任：向上送出；机械映射请求、SUPPORT 创建、等待与回收结果。
事件日志线程启动结果 启动事件日志线程(
    const 事件日志线程启动请求 &请求,
    线程生命周期发布端口 &生命周期端口) noexcept {
  using namespace 事件日志线程内部;
  if (!启动请求有效(请求))
    return {};
  try {
    auto 队列状态 =
        std::make_unique<事件日志线程状态>(请求.运行代次, 请求.队列容量);
    auto 写入适配器 = std::make_unique<事件日志生产写入适配器>();
    auto 线程入口 =
        std::make_unique<事件日志线程入口>(*队列状态, *写入适配器);

    const 支持线程候选创建请求 创建请求{
        支持线程候选合同版本, 请求.运行代次, 请求.线程身份,
        项目线程类别::事件日志, 项目线程模块::事件日志};
    const 支持线程进入等待请求 进入请求{
        支持线程候选合同版本, 请求.进入等待毫秒};
    const 支持线程候选回收请求 回收请求{
        支持线程候选合同版本, 请求.启动失败回收诊断等待毫秒};

    auto 创建结果 = 创建支持线程候选(创建请求, *线程入口, 生命周期端口);
    if (创建结果.状态 != 支持线程候选创建状态::已创建 ||
        !创建结果.候选租约)
      return {映射创建状态(创建结果.状态), {}, std::nullopt};

    支持线程候选租约 支持租约(std::move(*创建结果.候选租约));
    创建结果.候选租约.reset();
    const auto 进入结果 = 等待支持线程进入见证(支持租约, 进入请求);
    const bool 进入完整 =
        进入结果.状态 == 支持线程进入等待状态::已进入 &&
        进入结果.见证.已形成物理线程 && 进入结果.见证.已进入 &&
        !进入结果.见证.已请求停止 && !进入结果.见证.已完成 &&
        进入结果.见证.系统线程身份 && !进入结果.见证.入口结果;
    if (进入完整) {
      事件日志线程租约 事件租约(
          std::move(队列状态), std::move(写入适配器),
          std::move(线程入口), 回收请求, std::move(支持租约));
      return {事件日志线程启动状态::已进入, 进入结果.见证,
              std::optional<事件日志线程租约>(std::move(事件租约))};
    }

    const auto 回收结果 =
        停止并连接支持线程启动候选(std::move(支持租约), 回收请求);
    return {映射失败回收(进入结果.状态, 回收结果),
            回收结果.最终见证, std::nullopt};
  } catch (const std::bad_alloc &) {
    return {事件日志线程启动状态::资源失败, {}, std::nullopt};
  } catch (const std::system_error &) {
    return {事件日志线程启动状态::资源失败, {}, std::nullopt};
  } catch (...) {
    return {事件日志线程启动状态::内部不一致, {}, std::nullopt};
  }
}

} // namespace 海中鱼巣
