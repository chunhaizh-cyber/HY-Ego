// 文件规则：任务结果回执协议只定义强类型非权威结果证据和值复核；不得调用领域入口、写机器结构或承载裁决结论。
module;

#include <cstdint>
#include <limits>
#include <optional>
#include <utility>

export module 海中鱼巣.线程.任务结果回执协议;

import 海中鱼巣.线程.自我治理消息协议;
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2动态结构;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 任务结果回执协议版本 = 4;

enum class 任务结果回执材料性质 : std::uint32_t {
    未知 = 0,
    非权威执行结果证据 = 1,
    权威事实声明 = 2,
    权限结论声明 = 3,
    非权威任务执行结果证据 = 4
};

enum class 任务结果回执过期策略 : std::uint32_t {
    未知 = 0,
    永不过期 = 1,
    截止时间 = 2
};

enum class 任务结果回执准入状态 : std::uint32_t {
    已拒绝 = 0,
    可准入 = 1,
    重复材料 = 2,
    内部不一致 = 3
};

enum class 任务结果回执拒绝原因 : std::uint32_t {
    无 = 0,
    协议版本不匹配 = 1,
    回执编号无效 = 2,
    发生时间戳无效 = 3,
    幂等键无效 = 4,
    任务序号无效 = 5,
    批次编号无效 = 6,
    材料摘要无效 = 7,
    材料性质无效 = 8,
    只读材料标记缺失 = 9,
    材料越权承载事实 = 10,
    过期策略无效 = 11,
    当前时间戳无效 = 12,
    截止时间缺失 = 13,
    材料已过期 = 14,
    运行代次缺失 = 15,
    必填身份缺失 = 16,
    幂等键冲突 = 17,
    同一任务序号倒退 = 18,
    准入上下文不一致 = 19,
    读取截止代次缺失 = 20,
    来源执行绑定缺失 = 21,
    来源执行绑定无效 = 22,
    来源执行绑定不一致 = 23,
    来源材料版本缺失 = 24,
    写入幂等身份缺失 = 25
};

struct 任务结果回执身份组 final {
    L2任务身份 目标任务;
    L2状态身份 实际结果状态;
    L2动态身份 动态证据;
    L2方法身份 目标方法;
    L2方法动作入口身份 目标动作入口;
    L2场景身份 场景;
    L2存在身份 主体;

    friend bool operator==(const 任务结果回执身份组&,
                           const 任务结果回执身份组&) = default;
};

// 这只是 v2 已知来源的值式绑定；它不是旧冻结请求，也不证明任务结果事实。
struct 任务结果回执来源执行绑定 final {
    std::uint64_t 请求编号 = 0;
    std::uint64_t 任务序号 = 0;
    std::uint64_t 批次编号 = 0;
    std::uint64_t 幂等键 = 0;
    L2任务身份 任务;
    L2方法身份 方法;
    L2方法动作入口身份 动作入口;

    friend bool operator==(const 任务结果回执来源执行绑定&,
                           const 任务结果回执来源执行绑定&) = default;
};

struct 任务结果回执材料 final {
    std::uint32_t 协议版本 = 任务结果回执协议版本;
    std::uint64_t 回执编号 = 0;
    std::uint64_t 发生时间戳 = 0;
    std::uint64_t 幂等键 = 0;
    std::uint64_t 来源任务序号 = 0;
    std::uint64_t 批次编号 = 0;
    std::uint64_t 非权威材料摘要 = 0;
    std::uint64_t 来源材料版本 = 0;
    L2结构幂等身份 任务实际结果写入幂等身份;
    L2结构幂等身份 任务治理首态写入幂等身份;
    L2结构幂等身份 任务重筹办迁移写入幂等身份;
    std::uint64_t 运行代次 = 0;
    std::uint64_t 读取截止代次 = 0;
    任务结果回执材料性质 材料性质 = 任务结果回执材料性质::未知;
    任务结果回执过期策略 过期策略 = 任务结果回执过期策略::未知;
    std::uint64_t 截止时间戳 = 0;
    bool 只读材料说明 = true;
    bool 承载机器事实 = false;
    任务结果回执身份组 身份组;
    std::optional<任务结果回执来源执行绑定> 来源执行绑定;
};

// 任务工作线程只消费已经形成的结果材料；本结构不承载任务成功或完成结论。
struct 任务工作结果材料 final {
    std::uint64_t 回执编号 = 0;
    std::uint64_t 发生时间戳 = 0;
    std::uint64_t 回执幂等键 = 0;
    std::uint64_t 来源任务序号 = 0;
    std::uint64_t 批次编号 = 0;
    std::uint64_t 非权威材料摘要 = 0;
    std::uint64_t 来源材料版本 = 0;
    L2结构幂等身份 任务实际结果写入幂等身份;
    L2结构幂等身份 任务治理首态写入幂等身份;
    L2结构幂等身份 任务重筹办迁移写入幂等身份;
    std::uint64_t 运行代次 = 0;
    std::uint64_t 读取截止G0 = 0;
    任务结果回执过期策略 过期策略 = 任务结果回执过期策略::未知;
    std::uint64_t 截止时间戳 = 0;
    任务结果回执身份组 身份组;
    任务结果回执来源执行绑定 来源执行绑定;

    friend bool operator==(const 任务工作结果材料&,
                           const 任务工作结果材料&) = default;
};

enum class 任务结果回执形成状态 : std::uint8_t {
    已形成 = 1,
    已拒绝 = 2,
    内部错误 = 3
};

struct 任务结果回执形成结果 final {
    任务结果回执形成状态 状态 = 任务结果回执形成状态::已拒绝;
    任务结果回执拒绝原因 拒绝原因 = 任务结果回执拒绝原因::无;
    std::optional<任务结果回执材料> 回执;

    bool 成功() const noexcept {
        return 状态 == 任务结果回执形成状态::已形成 && 回执.has_value();
    }
};

struct 任务结果回执准入上下文 final {
    std::uint64_t 当前时间戳 = 0;
    std::optional<任务结果回执材料> 同幂等键既有材料;
    std::optional<L2任务身份> 同任务目标;
    std::uint64_t 同任务最新序号 = 0;
};

struct 任务结果回执准入结果 final {
    任务结果回执准入状态 状态 = 任务结果回执准入状态::已拒绝;
    任务结果回执拒绝原因 拒绝原因 = 任务结果回执拒绝原因::无;
};

inline bool 任务结果回执身份组完整(
    const 任务结果回执身份组& 身份组) noexcept {
    return 自我治理身份有效(身份组.目标任务)
        && 自我治理身份有效(身份组.实际结果状态)
        && 自我治理身份有效(身份组.动态证据)
        && 自我治理身份有效(身份组.目标方法)
        && 自我治理身份有效(身份组.目标动作入口)
        && 自我治理身份有效(身份组.场景)
        && 自我治理身份有效(身份组.主体);
}

inline bool 任务结果回执来源执行绑定完整(
    const 任务结果回执来源执行绑定& 绑定) noexcept {
    return 绑定.请求编号 != 0
        && 绑定.任务序号 != 0
        && 绑定.批次编号 != 0
        && 绑定.幂等键 != 0
        && 自我治理身份有效(绑定.任务)
        && 自我治理身份有效(绑定.方法)
        && 自我治理身份有效(绑定.动作入口);
}

inline bool 任务结果回执材料相同(
    const 任务结果回执材料& 左,
    const 任务结果回执材料& 右) noexcept {
    return 左.协议版本 == 右.协议版本
        && 左.回执编号 == 右.回执编号
        && 左.发生时间戳 == 右.发生时间戳
        && 左.幂等键 == 右.幂等键
        && 左.来源任务序号 == 右.来源任务序号
        && 左.批次编号 == 右.批次编号
        && 左.非权威材料摘要 == 右.非权威材料摘要
        && 左.来源材料版本 == 右.来源材料版本
        && 左.任务实际结果写入幂等身份 == 右.任务实际结果写入幂等身份
        && 左.任务治理首态写入幂等身份 == 右.任务治理首态写入幂等身份
        && 左.任务重筹办迁移写入幂等身份 == 右.任务重筹办迁移写入幂等身份
        && 左.运行代次 == 右.运行代次
        && 左.读取截止代次 == 右.读取截止代次
        && 左.材料性质 == 右.材料性质
        && 左.过期策略 == 右.过期策略
        && 左.截止时间戳 == 右.截止时间戳
        && 左.只读材料说明 == 右.只读材料说明
        && 左.承载机器事实 == 右.承载机器事实
        && 左.身份组 == 右.身份组
        && 左.来源执行绑定 == 右.来源执行绑定;
}

inline 任务结果回执准入结果 拒绝任务结果回执材料(
    任务结果回执拒绝原因 原因) noexcept {
    return {任务结果回执准入状态::已拒绝, 原因};
}

inline 任务结果回执准入结果 标记任务结果回执内部不一致(
    任务结果回执拒绝原因 原因) noexcept {
    return {任务结果回执准入状态::内部不一致, 原因};
}

inline 任务结果回执准入结果 复核任务结果回执材料(
    const 任务结果回执材料& 材料,
    const 任务结果回执准入上下文& 上下文) noexcept {
    if (材料.协议版本 != 任务结果回执协议版本) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::协议版本不匹配);
    }
    if (材料.回执编号 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::回执编号无效);
    }
    if (材料.发生时间戳 == 0
        || 材料.发生时间戳 >
            static_cast<std::uint64_t>((std::numeric_limits<std::int64_t>::max)())) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::发生时间戳无效);
    }
    if (材料.幂等键 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::幂等键无效);
    }
    if (材料.来源任务序号 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::任务序号无效);
    }
    if (材料.批次编号 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::批次编号无效);
    }
    if (材料.非权威材料摘要 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::材料摘要无效);
    }
    if (材料.来源材料版本 == 0) {
        return 拒绝任务结果回执材料(
            任务结果回执拒绝原因::来源材料版本缺失);
    }
    if (!L2结构幂等身份有效(材料.任务实际结果写入幂等身份)) {
        return 拒绝任务结果回执材料(
            任务结果回执拒绝原因::写入幂等身份缺失);
    }
    if (!L2结构幂等身份有效(材料.任务治理首态写入幂等身份)
        || !L2结构幂等身份有效(材料.任务重筹办迁移写入幂等身份)
        || 材料.任务实际结果写入幂等身份 ==
            材料.任务治理首态写入幂等身份
        || 材料.任务实际结果写入幂等身份 ==
            材料.任务重筹办迁移写入幂等身份
        || 材料.任务治理首态写入幂等身份 ==
            材料.任务重筹办迁移写入幂等身份) {
        return 拒绝任务结果回执材料(
            任务结果回执拒绝原因::写入幂等身份缺失);
    }
    if (材料.运行代次 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::运行代次缺失);
    }
    if (材料.读取截止代次 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::读取截止代次缺失);
    }
    if (材料.材料性质 != 任务结果回执材料性质::非权威执行结果证据
        && 材料.材料性质 != 任务结果回执材料性质::非权威任务执行结果证据) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::材料性质无效);
    }
    if (!材料.只读材料说明) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::只读材料标记缺失);
    }
    if (材料.承载机器事实) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::材料越权承载事实);
    }
    if (材料.过期策略 != 任务结果回执过期策略::永不过期
        && 材料.过期策略 != 任务结果回执过期策略::截止时间) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::过期策略无效);
    }
    if (上下文.当前时间戳 == 0) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::当前时间戳无效);
    }
    if (材料.过期策略 == 任务结果回执过期策略::截止时间) {
        if (材料.截止时间戳 == 0) {
            return 拒绝任务结果回执材料(任务结果回执拒绝原因::截止时间缺失);
        }
        if (上下文.当前时间戳 > 材料.截止时间戳) {
            return 拒绝任务结果回执材料(任务结果回执拒绝原因::材料已过期);
        }
    }
    if (!任务结果回执身份组完整(材料.身份组)) {
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::必填身份缺失);
    }

    if (材料.材料性质 == 任务结果回执材料性质::非权威执行结果证据) {
        if (材料.来源执行绑定.has_value()) {
            return 拒绝任务结果回执材料(任务结果回执拒绝原因::来源执行绑定不一致);
        }
    } else {
        if (!材料.来源执行绑定.has_value()) {
            return 拒绝任务结果回执材料(任务结果回执拒绝原因::来源执行绑定缺失);
        }
        const auto& 绑定 = *材料.来源执行绑定;
        if (!任务结果回执来源执行绑定完整(绑定)) {
            return 拒绝任务结果回执材料(任务结果回执拒绝原因::来源执行绑定无效);
        }
        if (绑定.请求编号 != 材料.回执编号
            || 绑定.任务序号 != 材料.来源任务序号
            || 绑定.批次编号 != 材料.批次编号
            || 绑定.幂等键 != 材料.幂等键
            || 绑定.任务 != 材料.身份组.目标任务
            || 绑定.方法 != 材料.身份组.目标方法
            || 绑定.动作入口 != 材料.身份组.目标动作入口) {
            return 拒绝任务结果回执材料(任务结果回执拒绝原因::来源执行绑定不一致);
        }
    }

    if (上下文.同幂等键既有材料.has_value()) {
        const auto& 既有材料 = *上下文.同幂等键既有材料;
        if (既有材料.幂等键 != 材料.幂等键) {
            return 标记任务结果回执内部不一致(
                任务结果回执拒绝原因::准入上下文不一致);
        }
        if (任务结果回执材料相同(既有材料, 材料)) {
            return {任务结果回执准入状态::重复材料, 任务结果回执拒绝原因::无};
        }
        return 拒绝任务结果回执材料(任务结果回执拒绝原因::幂等键冲突);
    }

    if (上下文.同任务最新序号 != 0) {
        if (!上下文.同任务目标.has_value()
            || !自我治理身份有效(*上下文.同任务目标)
            || *上下文.同任务目标 != 材料.身份组.目标任务) {
            return 标记任务结果回执内部不一致(
                任务结果回执拒绝原因::准入上下文不一致);
        }
        if (材料.来源任务序号 < 上下文.同任务最新序号) {
            return 拒绝任务结果回执材料(任务结果回执拒绝原因::同一任务序号倒退);
        }
    } else if (上下文.同任务目标.has_value()) {
        return 标记任务结果回执内部不一致(
            任务结果回执拒绝原因::准入上下文不一致);
    }

    return {任务结果回执准入状态::可准入, 任务结果回执拒绝原因::无};
}

inline 任务结果回执形成结果 形成任务结果回执(
    const 任务工作结果材料& 材料) noexcept {
    try {
        任务结果回执材料 回执;
        回执.协议版本 = 任务结果回执协议版本;
        回执.回执编号 = 材料.回执编号;
        回执.发生时间戳 = 材料.发生时间戳;
        回执.幂等键 = 材料.回执幂等键;
        回执.来源任务序号 = 材料.来源任务序号;
        回执.批次编号 = 材料.批次编号;
        回执.非权威材料摘要 = 材料.非权威材料摘要;
        回执.来源材料版本 = 材料.来源材料版本;
        回执.任务实际结果写入幂等身份 = 材料.任务实际结果写入幂等身份;
        回执.任务治理首态写入幂等身份 = 材料.任务治理首态写入幂等身份;
        回执.任务重筹办迁移写入幂等身份 = 材料.任务重筹办迁移写入幂等身份;
        回执.运行代次 = 材料.运行代次;
        回执.读取截止代次 = 材料.读取截止G0;
        回执.材料性质 = 任务结果回执材料性质::非权威任务执行结果证据;
        回执.过期策略 = 材料.过期策略;
        回执.截止时间戳 = 材料.截止时间戳;
        回执.只读材料说明 = true;
        回执.承载机器事实 = false;
        回执.身份组 = 材料.身份组;
        回执.来源执行绑定 = 材料.来源执行绑定;

        任务结果回执准入上下文 上下文;
        上下文.当前时间戳 = 材料.发生时间戳;
        const auto 复核 = 复核任务结果回执材料(回执, 上下文);
        if (复核.状态 != 任务结果回执准入状态::可准入) {
            return {复核.状态 == 任务结果回执准入状态::内部不一致
                    ? 任务结果回执形成状态::内部错误
                    : 任务结果回执形成状态::已拒绝,
                复核.拒绝原因, std::nullopt};
        }
        return {任务结果回执形成状态::已形成,
            任务结果回执拒绝原因::无, std::move(回执)};
    } catch (...) {
        return {任务结果回执形成状态::内部错误,
            任务结果回执拒绝原因::准入上下文不一致, std::nullopt};
    }
}

} // namespace 海中鱼巣
