module;

#include <cstdint>
#include <mutex>
#include <optional>
#include <vector>

export module 海中鱼巣.线程.路由.自我治理批次;

import 海中鱼巣.领域.服务.完整秒时钟;
import 海中鱼巣.领域.组合.运行期事实版本;
import 海中鱼巣.线程.有界自我治理队列;

// 对齐 BIZ-L2-002-01 v0.2
// 自我治理批次路由：有状态、不可复制、不可移动的唯一组合路由
// 把邮箱冻结的消息批次与完整秒观察、共享事实截止组合为不可变治理批次
// 待完成槽跨调用保留已取出但未完成证据的批次
export namespace 海中鱼巣 {

class 自我治理批次路由 final {
public:
  自我治理批次路由(有界自我治理邮箱& 邮箱,
                   const 完整秒时钟服务& 完整秒服务,
                   const 运行期事实版本服务& 事实版本服务,
                   std::uint64_t 运行代次,
                   时间纪元身份 纪元身份,
                   std::uint32_t 时间源版本,
                   std::uint32_t 事实范围版本) noexcept
      : 邮箱_(邮箱), 完整秒服务_(完整秒服务),
        事实版本服务_(事实版本服务), 运行代次_(运行代次),
        纪元身份_(纪元身份), 时间源版本_(时间源版本),
        事实范围版本_(事实范围版本) {}

  自我治理批次路由(const 自我治理批次路由&) = delete;
  自我治理批次路由& operator=(const 自我治理批次路由&) = delete;
  自我治理批次路由(自我治理批次路由&&) = delete;
  自我治理批次路由& operator=(自我治理批次路由&&) = delete;

  // BIZ-L2-002-01: 冻结当前治理批次
  自我治理批次组合结果 冻结当前治理批次(
      const 治理批次组合请求& 请求) noexcept {
    自我治理批次组合结果 结果;

    // N01: 取得唯一组合路由锁
    std::lock_guard<std::mutex> 锁(路由锁_);

    // N02: 路由固定配置是否完整有效
    if (运行代次_ == 0 || 纪元身份_.值 == 0 ||
        时间源版本_ == 0 || 事实范围版本_ == 0) {
      结果.状态 = 治理批次状态::内部不一致;
      if (待完成槽_) 结果.重试见证 = 待完成槽_->见证;
      return 结果;
    }

    // N31: 请求合同、非零字段、非负等待和边界是否有效
    if (请求.合同版本 != 批次路由合同版本 ||
        请求.运行代次 == 0 || 请求.纪元身份.值 == 0 ||
        请求.最大等待毫秒 == 0 && !待完成槽_) {
      结果.状态 = 治理批次状态::请求拒绝;
      if (待完成槽_) 结果.重试见证 = 待完成槽_->见证;
      return 结果;
    }

    // N32: 请求运行/时间/范围配置是否与路由固定配置相等
    if (请求.运行代次 != 运行代次_ ||
        请求.纪元身份 != 纪元身份_ ||
        请求.期望时间源版本 != 时间源版本_ ||
        请求.事实范围版本 != 事实范围版本_) {
      结果.状态 = 治理批次状态::版本漂移;
      if (待完成槽_) 结果.重试见证 = 待完成槽_->见证;
      return 结果;
    }

    // N03: 是否已有待完成批次
    if (待完成槽_) {
      // N04: 请求绑定与待重试见证是否逐字段匹配
      if (!请求.重试见证 || *请求.重试见证 != 待完成槽_->见证) {
        结果.状态 = 治理批次状态::版本漂移;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      }
      // 待完成批次：跳过邮箱读取，直接补证
    } else {
      // N05: 请求无重试见证且上一批次等于路由最后已完成序号
      if (请求.重试见证 ||
          请求.上一已完成批次序号 != 最后已完成序号_) {
        结果.状态 = 治理批次状态::版本漂移;
        return 结果;
      }

      // N06: 等待并冻结下一批
      auto 邮箱结果 = 邮箱_.等待并冻结下一批(
          std::chrono::milliseconds(请求.最大等待毫秒));

      // N07: 邮箱状态、原因、序号和消息组是否形成正式合法配对
      switch (邮箱结果.状态) {
      case 自我治理冻结状态::等待超时:
        结果.状态 = 治理批次状态::等待超时;
        return 结果;
      case 自我治理冻结状态::已停止:
        结果.状态 = 治理批次状态::已停止;
        return 结果;
      case 自我治理冻结状态::内部不一致:
        结果.状态 = 治理批次状态::内部不一致;
        return 结果;
      case 自我治理冻结状态::已冻结:
        // N08: 接管完整邮箱结果并建立待完成槽
        待完成槽_.emplace();
        待完成槽_->见证 = 待重试见证{
            邮箱结果.批次.批次序号(), 请求.运行代次,
            请求.纪元身份, 请求.事实范围版本};
        // 复制消息身份组
        const auto& 消息组 = 邮箱结果.批次.读取消息组();
        待完成槽_->消息身份组.reserve(消息组.size());
        for (const auto& 消息 : 消息组) {
          待完成槽_->消息身份组.push_back(消息.治理消息编号);
        }
        break;
      }
    }

    // N10: 完整秒材料是否已经保存
    if (!待完成槽_->完整秒已保存) {
      // N11: 读取当前完整秒边界
      完整秒边界读取请求 完整秒请求;
      完整秒请求.合同版本 = 完整秒时钟合同版本;
      完整秒请求.运行代次 = 请求.运行代次;
      完整秒请求.纪元身份 = 请求.纪元身份;
      完整秒请求.上一已消费完整秒边界 = 请求.上一已消费完整秒边界;
      完整秒请求.期望时间源版本 = 请求.期望时间源版本;

      auto 完整秒结果 = 完整秒服务_.读取当前完整秒边界(完整秒请求);

      // N12: 完整秒状态与观察/区间形状
      if (完整秒结果.状态 == 完整秒状态::已读取 ||
          完整秒结果.状态 == 完整秒状态::无新完整秒) {
        // N13: 保存观察和可选区间
        待完成槽_->完整秒 = 完整秒结果.观察;
        待完成槽_->完整秒区间 = 完整秒结果.区间;
        待完成槽_->完整秒已保存 = true;
      } else if (完整秒结果.状态 == 完整秒状态::纪元错配 ||
                 完整秒结果.状态 == 完整秒状态::时间源版本漂移) {
        结果.状态 = 治理批次状态::版本漂移;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      } else if (完整秒结果.状态 == 完整秒状态::时间倒退 ||
                 完整秒结果.状态 == 完整秒状态::计数不可表示) {
        结果.状态 = 治理批次状态::时间证据缺口;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      } else {
        结果.状态 = 治理批次状态::内部不一致;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      }
    }

    // N14: 共享事实截止是否已经保存
    if (!待完成槽_->事实截止已保存) {
      // N15: 读取当前已发布共享事实截止
      共享事实截止读取请求 截止请求;
      截止请求.合同版本 = 事实版本服务合同版本;
      截止请求.运行代次 = 请求.运行代次;
      截止请求.事实范围版本 = 请求.事实范围版本;

      auto 截止结果 = 事实版本服务_.读取当前已发布共享事实截止(截止请求);

      // N16: 状态为已读取且截止非零
      if (截止结果.状态 == 共享事实截止状态::已读取 &&
          截止结果.共享事实截止 != 0) {
        // N17: 保存共享事实截止
        待完成槽_->共享事实截止 = 截止结果.共享事实截止;
        待完成槽_->事实截止已保存 = true;
      } else if (截止结果.状态 == 共享事实截止状态::资源失败) {
        结果.状态 = 治理批次状态::资源失败;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      } else {
        结果.状态 = 治理批次状态::内部不一致;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      }
    }

    // N18: 构造完整候选
    不可变治理批次 候选;
    候选.批次序号 = 待完成槽_->见证.批次序号;
    候选.消息身份组 = std::move(待完成槽_->消息身份组);
    候选.完整秒 = 待完成槽_->完整秒;
    候选.完整秒区间 = 待完成槽_->完整秒区间;
    候选.共享事实截止 = 待完成槽_->共享事实截止;

    // N37: 候选全部字段与待完成材料逐字段一致（已由保存顺序保证）

    // N38: 推进最后完成序号、清槽并移动候选
    最后已完成序号_ = 候选.批次序号;
    待完成槽_.reset();

    // N19: 返回已冻结
    结果.状态 = 治理批次状态::已冻结;
    结果.治理批次 = std::move(候选);
    return 结果;
  }

  std::uint64_t 最后已完成批次序号() const noexcept {
    return 最后已完成序号_;
  }

  bool 有待完成批次() const noexcept {
    return 待完成槽_.has_value();
  }

private:
  struct 待完成槽 {
    待重试见证 见证;
    std::vector<std::uint64_t> 消息身份组;
    完整秒观察 完整秒;
    std::optional<完整秒区间> 完整秒区间;
    std::uint64_t 共享事实截止 = 0;
    bool 完整秒已保存 = false;
    bool 事实截止已保存 = false;
  };

  有界自我治理邮箱& 邮箱_;
  const 完整秒时钟服务& 完整秒服务_;
  const 运行期事实版本服务& 事实版本服务_;
  std::uint64_t 运行代次_;
  时间纪元身份 纪元身份_;
  std::uint32_t 时间源版本_;
  std::uint32_t 事实范围版本_;
  std::uint64_t 最后已完成序号_ = 0;
  std::optional<待完成槽> 待完成槽_;
  mutable std::mutex 路由锁_;
};

} // namespace 海中鱼巣
