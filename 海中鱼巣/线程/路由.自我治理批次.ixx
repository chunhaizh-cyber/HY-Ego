module;

#include <cstdint>
#include <chrono>
#include <mutex>
#include <new>
#include <optional>
#include <stdexcept>
#include <utility>
#include <variant>
#include <vector>

export module 海中鱼巣.线程.路由.自我治理批次;

import 海中鱼巣.领域.服务.完整秒时钟;
import 海中鱼巣.领域.服务.L2治理函数骨架;
import 海中鱼巣.领域.组合.运行期事实版本;
import 海中鱼巣.线程.有界自我治理队列;
import 海中鱼巣.线程.自我治理消息协议;

// 对齐 BIZ-L2-002-01 v0.2
// 自我治理批次路由：有状态、不可复制、不可移动的唯一组合路由
// 把邮箱冻结的消息批次与完整秒观察、共享事实截止组合为不可变治理批次
// 待完成槽跨调用保留已取出但未完成证据的批次
export namespace 海中鱼巣 {

inline constexpr std::uint32_t 批次路由合同版本 = 1;

enum class 治理批次状态 : std::uint8_t {
  已冻结 = 1,
  等待超时 = 2,
  已停止 = 3,
  请求拒绝 = 4,
  版本漂移 = 5,
  资源失败 = 6,
  时间证据缺口 = 7,
  内部不一致 = 8
};

struct 待重试见证 final {
  std::uint64_t 批次序号 = 0;
  std::uint64_t 运行代次 = 0;
  std::uint64_t 时间纪元身份 = 0;
  std::uint32_t 事实范围版本 = 0;
  friend bool operator==(const 待重试见证&, const 待重试见证&) = default;
};

struct 治理批次组合请求 final {
  std::uint32_t 合同版本 = 批次路由合同版本;
  std::uint64_t 运行代次 = 0;
  std::uint64_t 时间纪元身份 = 0;
  std::uint32_t 期望时间源版本 = 0;
  std::uint64_t 最大等待毫秒 = 0;
  std::uint64_t 上一已完成批次序号 = 0;
  std::int64_t 上一已消费完整秒边界 = 0;
  std::uint32_t 事实范围版本 = 0;
  std::optional<待重试见证> 重试见证;
};

struct 不可变治理批次 final {
  std::uint64_t 批次序号 = 0;
  std::uint64_t 运行代次 = 0;
  自我治理冻结批次 消息批次;
  完整秒边界观察 完整秒;
  std::optional<完整秒区间> 完整秒区间;
  已发布共享事实截止 共享事实截止;
};

struct 自我治理批次组合结果 final {
  治理批次状态 状态 = 治理批次状态::内部不一致;
  std::optional<不可变治理批次> 治理批次;
  std::optional<待重试见证> 重试见证;
};

inline constexpr std::uint32_t 治理批次分类合同版本 = 1;

enum class 治理批次分类状态 : std::uint8_t {
  已分类 = 1,
  停止优先 = 3,
  存在时效拒绝 = 4,
  内部错误 = 5,
  入口拒绝 = 6
};

enum class 治理输入类别 : std::uint8_t {
  任务结果复核 = 1,
  派生需求 = 2,
  观察材料准入 = 3,
  执行前许可预判 = 4,
  自检缺口 = 5,
  缓存刷新 = 6,
  事件日志 = 7,
  停止 = 8,
  概念待命名 = 9
};

struct 治理输入项 final {
  治理输入类别 类别 = 治理输入类别::观察材料准入;
  自我治理消息 消息;
};

struct 治理输入诊断 final {
  std::uint64_t 消息编号 = 0;
  自我治理准入结果 准入结果;
};

struct 治理批次分类请求 final {
  std::uint32_t 合同版本 = 治理批次分类合同版本;
  const 不可变治理批次* 批次 = nullptr;
  std::uint64_t 当前单调时间 = 0;
  std::uint64_t 运行代次 = 0;
  std::uint32_t 协议版本 = 自我治理协议版本;
};

struct 治理批次分类结果 final {
  治理批次分类状态 状态 = 治理批次分类状态::入口拒绝;
  std::uint64_t 批次序号 = 0;
  std::vector<治理输入项> 有序治理输入组;
  std::vector<治理输入诊断> 逐项诊断;
};

// BIZ-L2-002-03 之后的唯一后继。该枚举只表达路由，不宣称任一后继
// provider 已实现或已经消费输入。
enum class 治理输入后继 : std::uint8_t {
  治理输入事实复核 = 1,
  生存控制裁决 = 2,
  派生需求准入 = 3,
  自检缺口准入 = 4,
  概念命名准入 = 5,
  缓存支持旁路 = 6,
  日志支持旁路 = 7,
  停止 = 8
};

enum class 治理输入路由状态 : std::uint8_t {
  已路由 = 1,
  合法等待 = 2,
  入口拒绝 = 3,
  内部错误 = 4
};

struct 治理输入路由项 final {
  治理输入项 输入;
  治理输入后继 后继 = 治理输入后继::治理输入事实复核;
  治理输入路由状态 状态 = 治理输入路由状态::入口拒绝;
};

struct 治理输入路由结果 final {
  治理批次分类状态 分类状态 = 治理批次分类状态::入口拒绝;
  std::uint64_t 批次序号 = 0;
  std::vector<治理输入路由项> 有序路由组;
  std::vector<治理输入诊断> 逐项诊断;
};

治理输入事实复核结果 复核任务结果治理输入绑定事实(
    const 治理输入路由项& 路由项,
    std::uint64_t 治理批次身份,
    std::uint64_t 最大需求成员数) noexcept {
  治理输入事实复核结果 拒绝;
  拒绝.状态 = 治理输入事实复核状态::入口拒绝;
  if (路由项.输入.类别 != 治理输入类别::任务结果复核
      || 路由项.后继 != 治理输入后继::治理输入事实复核
      || 路由项.状态 != 治理输入路由状态::合法等待
      || 路由项.输入.消息.类型 != 自我治理消息类型::任务结果复核请求
      || 治理批次身份 == 0 || 最大需求成员数 == 0) {
    return 拒绝;
  }
  const auto* 载荷 = std::get_if<任务结果复核载荷>(
      &路由项.输入.消息.载荷);
  if (!载荷) return 拒绝;

  const auto& 消息 = 路由项.输入.消息;
  治理输入事实复核请求 请求;
  请求.治理批次身份 = 治理批次身份;
  请求.共享事实截止G0 = 消息.读取截止代次;
  请求.最大需求成员数 = 最大需求成员数;
  请求.输入 = 任务结果治理输入事实{
      载荷->任务, 载荷->实际结果状态, 载荷->动态证据,
      载荷->方法, 载荷->动作入口, 载荷->场景, 载荷->主体,
      消息.来源材料版本, 消息.运行代次};
  return 复核治理输入绑定事实(请求);
}

class 自我治理批次路由 final {
public:
  自我治理批次路由(有界自我治理邮箱& 邮箱,
                   const 完整秒时钟服务& 完整秒服务,
                   const 运行期事实版本服务& 事实版本服务,
                   std::uint64_t 运行代次,
                   std::uint64_t 时间纪元身份,
                   std::uint32_t 时间源版本,
                   std::uint32_t 事实范围版本) noexcept
      : 邮箱_(邮箱), 完整秒服务_(完整秒服务),
        事实版本服务_(事实版本服务), 运行代次_(运行代次),
        时间纪元身份_(时间纪元身份), 时间源版本_(时间源版本),
        事实范围版本_(事实范围版本) {}

  自我治理批次路由(const 自我治理批次路由&) = delete;
  自我治理批次路由& operator=(const 自我治理批次路由&) = delete;
  自我治理批次路由(自我治理批次路由&&) = delete;
  自我治理批次路由& operator=(自我治理批次路由&&) = delete;

  // BIZ-L2-002-01: 冻结当前治理批次
  自我治理批次组合结果 冻结当前治理批次(
      const 治理批次组合请求& 请求) noexcept {
    自我治理批次组合结果 结果;

    // N01: 取得唯一组合路由锁
    std::lock_guard<std::mutex> 锁(路由锁_);

    // N02: 路由固定配置是否完整有效
    if (运行代次_ == 0 || 时间纪元身份_ == 0 ||
        时间源版本_ == 0 || 事实范围版本_ == 0) {
      结果.状态 = 治理批次状态::内部不一致;
      if (待完成槽_) 结果.重试见证 = 待完成槽_->见证;
      return 结果;
    }

    // N31: 请求合同、非零字段、非负等待和边界是否有效
    if (请求.合同版本 != 批次路由合同版本 ||
        请求.运行代次 == 0 || 请求.时间纪元身份 == 0 ||
        请求.最大等待毫秒 == 0 && !待完成槽_) {
      结果.状态 = 治理批次状态::请求拒绝;
      if (待完成槽_) 结果.重试见证 = 待完成槽_->见证;
      return 结果;
    }

    // N32: 请求运行/时间/范围配置是否与路由固定配置相等
    if (请求.运行代次 != 运行代次_ ||
        请求.时间纪元身份 != 时间纪元身份_ ||
        请求.期望时间源版本 != 时间源版本_ ||
        请求.事实范围版本 != 事实范围版本_) {
      结果.状态 = 治理批次状态::版本漂移;
      if (待完成槽_) 结果.重试见证 = 待完成槽_->见证;
      return 结果;
    }

    // N03: 是否已有待完成批次
    if (待完成槽_) {
      // N04: 请求绑定与待重试见证是否逐字段匹配
      if (!请求.重试见证 || *请求.重试见证 != 待完成槽_->见证) {
        结果.状态 = 治理批次状态::版本漂移;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      }
      // 待完成批次：跳过邮箱读取，直接补证
    } else {
      // N05: 请求无重试见证且上一批次等于路由最后已完成序号
      if (请求.重试见证 ||
          请求.上一已完成批次序号 != 最后已完成序号_) {
        结果.状态 = 治理批次状态::版本漂移;
        return 结果;
      }

      // N06: 等待并冻结下一批
      auto 邮箱结果 = 邮箱_.等待并冻结下一批(
          std::chrono::milliseconds(请求.最大等待毫秒));

      // N07: 邮箱状态、原因、序号和消息组是否形成正式合法配对
      switch (邮箱结果.状态) {
      case 自我治理冻结状态::等待超时:
        结果.状态 = 治理批次状态::等待超时;
        return 结果;
      case 自我治理冻结状态::已停止:
        结果.状态 = 治理批次状态::已停止;
        return 结果;
      case 自我治理冻结状态::内部不一致:
        结果.状态 = 治理批次状态::内部不一致;
        return 结果;
      case 自我治理冻结状态::已冻结:
        // N08: 接管完整邮箱结果并建立待完成槽
        待完成槽_.emplace();
        待完成槽_->见证 = 待重试见证{
            邮箱结果.批次.批次序号(), 请求.运行代次,
            请求.时间纪元身份, 请求.事实范围版本};
        // move 接管完整冻结批次；不复制消息、不建立第二消息入口。
        待完成槽_->消息批次 = std::move(邮箱结果.批次);
        break;
      }
    }

    // N10: 完整秒材料是否已经保存
    if (!待完成槽_->完整秒已保存) {
      // N11: 读取当前完整秒边界
      完整秒边界读取请求 完整秒请求;
      完整秒请求.合同版本 = 完整秒边界读取合同版本;
      完整秒请求.运行代次 = 请求.运行代次;
      完整秒请求.时间纪元身份 = 请求.时间纪元身份;
      完整秒请求.上一已消费完整秒边界 = 请求.上一已消费完整秒边界;
      完整秒请求.期望时间源版本 = 请求.期望时间源版本;

      auto 完整秒结果 = 完整秒服务_.读取当前完整秒边界(完整秒请求);

      // N12: 完整秒状态与观察/区间形状
      if ((完整秒结果.状态 == 完整秒边界读取状态::已读取 ||
           完整秒结果.状态 == 完整秒边界读取状态::无新完整秒) &&
          完整秒结果.观察 &&
          ((完整秒结果.状态 == 完整秒边界读取状态::已读取 &&
            完整秒结果.区间) ||
           (完整秒结果.状态 == 完整秒边界读取状态::无新完整秒 &&
            !完整秒结果.区间)) &&
          完整秒结果.观察->合同版本 == 完整秒边界读取合同版本 &&
          完整秒结果.观察->运行代次 == 请求.运行代次 &&
          完整秒结果.观察->时间纪元身份 == 请求.时间纪元身份 &&
          完整秒结果.观察->上一已消费完整秒边界 ==
              请求.上一已消费完整秒边界 &&
          完整秒结果.观察->时间源版本 == 请求.期望时间源版本) {
        // N13: 保存观察和可选区间
        待完成槽_->完整秒 = *完整秒结果.观察;
        待完成槽_->完整秒区间 = 完整秒结果.区间;
        待完成槽_->完整秒已保存 = true;
      } else if (完整秒结果.状态 == 完整秒边界读取状态::纪元错配 ||
                 完整秒结果.状态 == 完整秒边界读取状态::时间源版本漂移) {
        结果.状态 = 治理批次状态::版本漂移;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      } else if (完整秒结果.状态 == 完整秒边界读取状态::时间倒退 ||
                 完整秒结果.状态 == 完整秒边界读取状态::计数不可表示) {
        结果.状态 = 治理批次状态::时间证据缺口;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      } else {
        结果.状态 = 治理批次状态::内部不一致;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      }
    }

    // N14: 共享事实截止是否已经保存
    if (!待完成槽_->事实截止已保存) {
      // N15: 读取当前已发布共享事实截止
      共享事实截止读取请求 截止请求;
      截止请求.合同版本 = 共享事实截止读取合同版本;
      截止请求.运行代次 = 请求.运行代次;
      截止请求.事实范围版本 = 请求.事实范围版本;

      auto 截止结果 = 事实版本服务_.读取当前已发布共享事实截止(截止请求);

      // N16: 状态为已读取且截止非零
      if (截止结果.状态 == 共享事实截止读取状态::已读取 &&
          截止结果.截止 &&
          截止结果.截止->合同版本 == 共享事实截止读取合同版本 &&
          截止结果.截止->运行代次 == 请求.运行代次 &&
          截止结果.截止->事实范围版本 == 请求.事实范围版本 &&
          截止结果.截止->事实截止代次 != 0) {
        // N17: 保存共享事实截止
        待完成槽_->共享事实截止 = *截止结果.截止;
        待完成槽_->事实截止已保存 = true;
      } else if (截止结果.状态 == 共享事实截止读取状态::资源失败) {
        结果.状态 = 治理批次状态::资源失败;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      } else {
        结果.状态 = 治理批次状态::内部不一致;
        结果.重试见证 = 待完成槽_->见证;
        return 结果;
      }
    }

    // N18: 构造完整候选
    不可变治理批次 候选;
    候选.批次序号 = 待完成槽_->见证.批次序号;
    候选.运行代次 = 待完成槽_->见证.运行代次;
    候选.消息批次 = std::move(待完成槽_->消息批次);
    候选.完整秒 = 待完成槽_->完整秒;
    候选.完整秒区间 = 待完成槽_->完整秒区间;
    候选.共享事实截止 = 待完成槽_->共享事实截止;

    // N37: 候选全部字段与待完成材料逐字段一致（已由保存顺序保证）

    // N38: 推进最后完成序号、清槽并移动候选
    最后已完成序号_ = 候选.批次序号;
    待完成槽_.reset();

    // N19: 返回已冻结
    结果.状态 = 治理批次状态::已冻结;
    结果.治理批次 = std::move(候选);
    return 结果;
  }

  // BIZ-L2-002-03：只复核和分类冻结消息，不读取或写入领域事实。
  治理批次分类结果 复核并分类治理批次(
      const 治理批次分类请求& 请求) const noexcept {
    治理批次分类结果 结果;
    const auto 入口拒绝 = [&]() noexcept {
      结果 = {};
      结果.状态 = 治理批次分类状态::入口拒绝;
      return 结果;
    };
    if (请求.合同版本 != 治理批次分类合同版本 || !请求.批次
        || 请求.批次->批次序号 == 0 || 请求.当前单调时间 == 0
        || 请求.运行代次 == 0 || 请求.协议版本 != 自我治理协议版本
        || 请求.运行代次 != 运行代次_
        || 请求.批次->运行代次 != 运行代次_
        || 请求.批次->消息批次.批次序号() != 请求.批次->批次序号)
      return 入口拒绝();

    结果.批次序号 = 请求.批次->批次序号;
    const auto& 消息组 = 请求.批次->消息批次.读取消息组();
    if (消息组.empty()) {
      结果.状态 = 治理批次分类状态::内部错误;
      return 结果;
    }

    try {
      结果.有序治理输入组.reserve(消息组.size());
      结果.逐项诊断.reserve(消息组.size());

      const auto 映射类别 = [](自我治理消息类型 类型)
          -> std::optional<治理输入类别> {
        switch (类型) {
        case 自我治理消息类型::任务结果复核请求:
          return 治理输入类别::任务结果复核;
        case 自我治理消息类型::派生需求请求:
          return 治理输入类别::派生需求;
        case 自我治理消息类型::观察材料准入请求:
          return 治理输入类别::观察材料准入;
        case 自我治理消息类型::执行前许可预判请求:
          return 治理输入类别::执行前许可预判;
        case 自我治理消息类型::自检缺口候选:
          return 治理输入类别::自检缺口;
        case 自我治理消息类型::缓存刷新请求:
          return 治理输入类别::缓存刷新;
        case 自我治理消息类型::事件日志请求:
          return 治理输入类别::事件日志;
        case 自我治理消息类型::停止请求:
          return 治理输入类别::停止;
        case 自我治理消息类型::概念待命名请求:
          return 治理输入类别::概念待命名;
        default:
          return std::nullopt;
        }
      };

      for (const auto& 消息 : 消息组) {
        自我治理准入上下文 上下文;
        上下文.当前时间戳 = 请求.当前单调时间;

        auto 准入 = 复核自我治理消息(消息, 上下文);
        if (消息.发生时间戳 > 请求.当前单调时间) {
          准入 = {自我治理准入状态::已拒绝,
              自我治理拒绝原因::当前时间戳无效};
        }
        if (准入.状态 == 自我治理准入状态::已拒绝
            && (准入.拒绝原因 == 自我治理拒绝原因::材料已过期
                || (消息.发生时间戳 > 请求.当前单调时间
                    && 准入.拒绝原因
                        == 自我治理拒绝原因::当前时间戳无效))) {
          结果.逐项诊断.push_back({消息.治理消息编号, 准入});
          continue;
        }
        if (准入.状态 != 自我治理准入状态::可准入)
          return {治理批次分类状态::内部错误, 结果.批次序号, {}, {}};
        const auto 类别 = 映射类别(消息.类型);
        if (!类别)
          return {治理批次分类状态::内部错误, 结果.批次序号, {}, {}};
        结果.有序治理输入组.push_back({*类别, 消息});
        if (*类别 == 治理输入类别::停止) {
          结果.状态 = 治理批次分类状态::停止优先;
          return 结果;
        }
      }
      结果.状态 = !结果.逐项诊断.empty()
          ? 治理批次分类状态::存在时效拒绝
          : 治理批次分类状态::已分类;
      return 结果;
    } catch (const std::bad_alloc&) {
      return {治理批次分类状态::内部错误, 结果.批次序号, {}, {}};
    } catch (const std::length_error&) {
      return {治理批次分类状态::内部错误, 结果.批次序号, {}, {}};
    } catch (...) {
      return {治理批次分类状态::内部错误, 结果.批次序号, {}, {}};
    }
  }

  // 当前能力表尚未接线任一普通后继：每个合法输入保留其原值式消息、
  // 唯一后继和“合法等待”，让同批其它消息继续被路由。
  治理输入路由结果 复核分类并路由治理批次(
      const 治理批次分类请求& 请求) const noexcept {
    try {
      const auto 分类结果 = 复核并分类治理批次(请求);
      治理输入路由结果 结果;
      结果.分类状态 = 分类结果.状态;
      结果.批次序号 = 分类结果.批次序号;
      结果.逐项诊断 = 分类结果.逐项诊断;
      if (分类结果.状态 == 治理批次分类状态::入口拒绝) {
        return 结果;
      }
      if (分类结果.状态 == 治理批次分类状态::内部错误) {
        return 结果;
      }
      结果.有序路由组.reserve(分类结果.有序治理输入组.size());
      for (const auto& 输入 : 分类结果.有序治理输入组) {
        治理输入路由项 路由项;
        路由项.输入 = 输入;
        switch (输入.类别) {
        case 治理输入类别::任务结果复核:
        case 治理输入类别::观察材料准入:
          路由项.后继 = 治理输入后继::治理输入事实复核;
          路由项.状态 = 治理输入路由状态::合法等待;
          break;
        case 治理输入类别::派生需求:
          路由项.后继 = 治理输入后继::派生需求准入;
          路由项.状态 = 治理输入路由状态::合法等待;
          break;
        case 治理输入类别::执行前许可预判:
          路由项.后继 = 治理输入后继::生存控制裁决;
          路由项.状态 = 治理输入路由状态::合法等待;
          break;
        case 治理输入类别::自检缺口:
          路由项.后继 = 治理输入后继::自检缺口准入;
          路由项.状态 = 治理输入路由状态::合法等待;
          break;
        case 治理输入类别::缓存刷新:
          路由项.后继 = 治理输入后继::缓存支持旁路;
          路由项.状态 = 治理输入路由状态::合法等待;
          break;
        case 治理输入类别::事件日志:
          路由项.后继 = 治理输入后继::日志支持旁路;
          路由项.状态 = 治理输入路由状态::合法等待;
          break;
        case 治理输入类别::停止:
          路由项.后继 = 治理输入后继::停止;
          路由项.状态 = 治理输入路由状态::已路由;
          结果.有序路由组.push_back(std::move(路由项));
          return 结果;
        case 治理输入类别::概念待命名:
          路由项.后继 = 治理输入后继::概念命名准入;
          路由项.状态 = 治理输入路由状态::合法等待;
          break;
        default:
          结果.分类状态 = 治理批次分类状态::内部错误;
          结果.有序路由组.clear();
          return 结果;
        }
        结果.有序路由组.push_back(std::move(路由项));
      }
      return 结果;
    } catch (const std::bad_alloc&) {
      return {治理批次分类状态::内部错误};
    } catch (const std::length_error&) {
      return {治理批次分类状态::内部错误};
    } catch (...) {
      return {治理批次分类状态::内部错误};
    }
  }

  std::uint64_t 最后已完成批次序号() const noexcept {
    return 最后已完成序号_;
  }

  bool 有待完成批次() const noexcept {
    return 待完成槽_.has_value();
  }

private:
  struct 待完成槽 {
    待重试见证 见证;
    自我治理冻结批次 消息批次;
    完整秒边界观察 完整秒;
    std::optional<完整秒区间> 完整秒区间;
    已发布共享事实截止 共享事实截止;
    bool 完整秒已保存 = false;
    bool 事实截止已保存 = false;
  };

  有界自我治理邮箱& 邮箱_;
  const 完整秒时钟服务& 完整秒服务_;
  const 运行期事实版本服务& 事实版本服务_;
  std::uint64_t 运行代次_;
  std::uint64_t 时间纪元身份_;
  std::uint32_t 时间源版本_;
  std::uint32_t 事实范围版本_;
  std::uint64_t 最后已完成序号_ = 0;
  std::optional<待完成槽> 待完成槽_;
  mutable std::mutex 路由锁_;
};

} // namespace 海中鱼巣
