export {
#include "自我线程生产创建.数据.h"
}

namespace 海中鱼巣::自我线程生产创建内部 {

// 身份等同：只需确认两棵根消费材料指向同一棵树和同一个根场景。
// 不深比较 L2 场景树/场景事实结构体（其 =default operator== 在 MSVC 模块边界被删）。
inline bool 根消费材料相同(const 自我世界树根消费材料 &左,
                            const 自我世界树根消费材料 &右) noexcept {
  return 左.请求.树 == 右.请求.树 &&
         左.请求.根场景 == 右.请求.根场景;
}

inline bool 请求语义相同(const 自我线程生产创建请求 &左,
                          const 自我线程生产创建请求 &右) noexcept {
  return 左.合同版本 == 右.合同版本 &&
         左.创建幂等身份 == 右.创建幂等身份 &&
         左.线程逻辑身份 == 右.线程逻辑身份 &&
         左.运行代次 == 右.运行代次 &&
         根消费材料相同(左.根消费材料, 右.根消费材料) &&
         左.本能根锚点 == 右.本能根锚点 &&
         左.治理邮箱容量 == 右.治理邮箱容量 &&
         左.最大任务结果来源需求成员数 ==
             右.最大任务结果来源需求成员数;
}

inline bool 请求有效(const 自我线程生产创建请求 &请求) noexcept {
  return 请求.合同版本 == 自我线程生产创建合同版本 &&
         请求.创建幂等身份.值 != 0 && 请求.治理邮箱容量 != 0 &&
         请求.最大任务结果来源需求成员数 != 0 &&
         请求.线程逻辑身份.值 != 0 && 请求.运行代次 != 0 &&
         请求.入口停门等待毫秒 != 0 && 请求.失败回收诊断毫秒 != 0 &&
         请求.根消费材料.本次事实截止代次 != 0 &&
         请求.本能根锚点.完整() &&
         请求.本能根锚点.事实截止代次 <=
             请求.根消费材料.本次事实截止代次;
}

inline bool 停门见证完整(const 自我线程停门见证 &见证) noexcept {
  return 见证.线程逻辑身份.值 != 0 && 见证.运行代次 != 0 &&
         见证.入口见证序号 != 0 && 见证.停门见证序号 != 0 &&
         见证.停门见证序号 > 见证.入口见证序号 &&
         见证.运行门 == 自我线程治理运行门状态::关闭 &&
         见证.治理邮箱.已冻结批次数量 == 0 &&
         见证.治理邮箱.状态 == 自我治理邮箱状态::运行中;
}

inline 自我线程生产创建状态 合并启动失败与回收状态(
    自我线程生产创建状态 原失败,
    const 自我线程启动候选回收结果 &回收) noexcept {
  switch (回收.状态) {
  case 自我线程启动候选回收状态::已回收:
  case 自我线程启动候选回收状态::无候选:
    return 原失败;
  case 自我线程启动候选回收状态::等待完成超时:
    return 自我线程生产创建状态::启动候选回收超时;
  case 自我线程启动候选回收状态::内部不一致:
  default:
    return 自我线程生产创建状态::内部不一致;
  }
}

} // namespace 海中鱼巣::自我线程生产创建内部

export namespace 海中鱼巣 {

class 自我线程 final {
public:
  explicit 自我线程(
      线程生命周期发布端口 *生命周期发布端口,
      const L2结构聚合服务 *结构聚合服务 = nullptr,
      const L2任务结构服务 *任务结构服务 = nullptr,
      自我线程需求治理端口 *需求治理端口 = nullptr,
      自我线程任务管理提交端口 *任务管理提交端口 = nullptr,
      自我线程安全治理端口 *安全治理端口 = nullptr) noexcept
      : 生命周期发布端口_(生命周期发布端口),
        结构聚合服务_(结构聚合服务),
        任务结构服务_(任务结构服务),
        需求治理端口_(需求治理端口),
        任务管理提交端口_(任务管理提交端口),
        安全治理端口_(安全治理端口) {}

  ~自我线程() noexcept {
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      停止已锁存_ = true;
      if (治理邮箱_)
        治理邮箱_->请求停止并唤醒();
    }
    治理运行门条件_.notify_all();
    if (线程_.joinable())
      线程_.join();
  }

  自我线程(const 自我线程 &) = delete;
  自我线程 &operator=(const 自我线程 &) = delete;
  自我线程(自我线程 &&) = delete;
  自我线程 &operator=(自我线程 &&) = delete;

  自我线程生产创建结果 创建并使自我线程停在治理运行门(
      const 自我线程生产创建请求 &请求) noexcept {
    try {
      // 序列锁覆盖完整创建调用。状态条件等待仍只释放状态锁，因此同请求
      // 并发不会在首次调用停门等待期间误判为第二个 joinable 候选。
      std::lock_guard<std::mutex> 创建调用序列锁(创建调用锁_);
      std::unique_lock<std::mutex> 锁(状态锁_);
      自我线程生产创建结果 结果;
      if (!自我线程生产创建内部::请求有效(请求))
        return 结果;
      if (锁定请求_ &&
          !自我线程生产创建内部::请求语义相同(*锁定请求_, 请求)) {
        结果.状态 = 自我线程生产创建状态::已发布选择冲突;
        return 结果;
      }
      if (已发布停门见证_) {
        结果.状态 = 自我线程生产创建状态::精确重复;
        结果.停门见证 = 已发布停门见证_;
        return 结果;
      }
      if (线程_.joinable()) {
        结果.状态 = 自我线程生产创建状态::内部不一致;
        return 结果;
      }
      if (!锁定请求_)
        锁定请求_ = 请求;

      治理邮箱_ = std::make_unique<有界自我治理邮箱>(请求.治理邮箱容量);
      线程逻辑身份_ = 请求.线程逻辑身份;
      运行代次_ = 请求.运行代次;
      入口已进入_ = false;
      已停在关闭门_ = false;
      已完成_ = false;
      线程入口异常已锁存_ = false;
      停止已锁存_ = false;
      运行门已开放_ = false;
      入口见证序号_ = 0;
      停门见证序号_ = 0;
      治理初始化已完成_ = false;

      // ===== 装配阶段：三个 provider 实例化 =====
      // 装配条件：结构聚合服务指针非空。若为空，运行期 provider 不装配，
      // 治理循环进入时立即返回内部不一致（§骨架施工授权 §不授权范围 §3 仍生效）。
      // 临时固定配置：纪元身份 = 运行代次；时间源版本 = 1；事实范围版本 = 1。
      // 最终配置应由普通应用装配时传入，参见 §所有权与停止边界 §2。
      if (结构聚合服务_) {
        时间纪元身份_ = 请求.运行代次;
        时间源版本_ = 1;
        事实范围版本_ = 1;
        单调时钟适配器_ = std::make_unique<单调时钟适配器>(
            单调时钟适配器配置{请求.运行代次, 时间纪元身份_});
        完整秒服务_ = std::make_unique<完整秒时钟服务>(
            *单调时钟适配器_, 完整秒时钟服务配置{
                请求.运行代次, 时间纪元身份_, 时间源版本_});
        事实版本服务_ = std::make_unique<运行期事实版本服务>(
            *结构聚合服务_, 运行期事实版本服务配置{
                请求.运行代次, 事实范围版本_});
        批次路由_ = std::make_unique<自我治理批次路由>(
            *治理邮箱_, *完整秒服务_, *事实版本服务_,
            请求.运行代次, 时间纪元身份_, 时间源版本_, 事实范围版本_);
        最后成功批次序号_ = 0;
        最后完整秒边界_ = 0;
        当前待重试见证_.reset();
        当前任务结果治理处理槽_.reset();
        已发布任务结果治理处理槽快照_.reset();
        任务结果重试信号_ = 0;
      }

      锁.unlock();
      结果.创建投影 = 发布生命周期(
          线程生命周期投影::创建, std::nullopt, 0, std::nullopt);
      锁.lock();
      try {
        线程_ = std::thread([this]() noexcept { 线程入口(); });
      } catch (const std::system_error &) {
        结果.状态 = 自我线程生产创建状态::线程候选创建失败;
        return 结果;
      }
      锁.unlock();
      结果.入口投影 = 发布生命周期(
          线程生命周期投影::启动中,
          线程生命周期投影::创建, 0, std::nullopt);
      锁.lock();

      const auto 等待时限 =
          std::chrono::milliseconds(请求.入口停门等待毫秒);
      const bool 已到达 = 状态条件_.wait_for(锁, 等待时限, [this]() {
        return 已停在关闭门_ || 已完成_;
      });
      if (已到达 && 已停在关闭门_ && !已完成_ && 治理邮箱_) {
        自我线程停门见证 见证{
            线程逻辑身份_, 运行代次_, 入口见证序号_, 停门见证序号_,
            自我线程治理运行门状态::关闭, 治理邮箱_->读取快照()};
        if (!自我线程生产创建内部::停门见证完整(见证)) {
          锁.unlock();
          const auto 回收 =
              收口启动失败候选内部(请求.失败回收诊断毫秒);
          结果.状态 = 自我线程生产创建内部::合并启动失败与回收状态(
              自我线程生产创建状态::治理运行门停驻失败, 回收);
          return 结果;
        }
        已发布停门见证_ = 见证;
        结果.状态 = 自我线程生产创建状态::已创建并停门;
        结果.停门见证 = 见证;
        锁.unlock();
        结果.停门投影 = 发布生命周期(
            线程生命周期投影::等待,
            线程生命周期投影::启动中, 0, std::nullopt);
        return 结果;
      }

      const auto 失败状态 = 线程入口异常已锁存_.load()
          ? 自我线程生产创建状态::内部不一致
          : (!入口已进入_
                 ? 自我线程生产创建状态::线程入口未进入
                 : 自我线程生产创建状态::治理运行门停驻失败);
      锁.unlock();
      const auto 回收 =
          收口启动失败候选内部(请求.失败回收诊断毫秒);
      结果.状态 = 自我线程生产创建内部::合并启动失败与回收状态(
          失败状态, 回收);
      return 结果;
    } catch (const std::bad_alloc &) {
      const auto 回收 = 收口启动失败候选(请求.失败回收诊断毫秒);
      return {自我线程生产创建内部::合并启动失败与回收状态(
          自我线程生产创建状态::资源失败, 回收)};
    } catch (...) {
      const auto 回收 = 收口启动失败候选(请求.失败回收诊断毫秒);
      return {自我线程生产创建内部::合并启动失败与回收状态(
          自我线程生产创建状态::内部不一致, 回收)};
    }
  }

  自我线程启动候选回收结果 收口启动失败候选(
      std::uint64_t 完成等待毫秒) noexcept {
    try {
      std::lock_guard<std::mutex> 创建调用序列锁(创建调用锁_);
      {
        std::lock_guard<std::mutex> 锁(状态锁_);
        if (已发布停门见证_)
          return {自我线程启动候选回收状态::内部不一致};
      }
      return 收口启动失败候选内部(完成等待毫秒);
    } catch (...) {
      return {自我线程启动候选回收状态::内部不一致};
    }
  }

  std::optional<自我线程停门见证> 读取停门见证() const {
    std::lock_guard<std::mutex> 锁(状态锁_);
    return 已发布停门见证_;
  }

  // 诊断责任：无适用错误分支；开放治理运行门，唤醒停在关闭门的自我线程进入空转。
  void 开放治理运行门() noexcept {
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      运行门已开放_ = true;
    }
    治理运行门条件_.notify_all();
  }

  自我线程治理端口绑定结果 绑定治理端口(
      自我线程需求治理端口 *需求治理端口,
      自我线程任务管理提交端口 *任务管理提交端口,
      自我线程安全治理端口 *安全治理端口) noexcept {
    if (!需求治理端口 || !任务管理提交端口 || !安全治理端口)
      return {自我线程治理端口绑定状态::请求无效};
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      if (停止已锁存_ || 已完成_)
        return {自我线程治理端口绑定状态::已停止};
      const bool 已有任一端口 = 需求治理端口_ || 任务管理提交端口_ ||
                               安全治理端口_;
      if (已有任一端口) {
        if (需求治理端口_ == 需求治理端口 &&
            任务管理提交端口_ == 任务管理提交端口 &&
            安全治理端口_ == 安全治理端口)
          return {自我线程治理端口绑定状态::精确重复};
        return {自我线程治理端口绑定状态::选择冲突};
      }
      需求治理端口_ = 需求治理端口;
      任务管理提交端口_ = 任务管理提交端口;
      安全治理端口_ = 安全治理端口;
    }
    治理运行门条件_.notify_all();
    return {自我线程治理端口绑定状态::已绑定};
  }

  自我治理提交结果 提交治理消息(
      const 自我治理消息& 消息,
      std::uint64_t 当前时间戳) noexcept {
    try {
      std::lock_guard<std::mutex> 锁(状态锁_);
      if (!已发布停门见证_ || !治理邮箱_ || 已完成_) {
        return {自我治理提交状态::已拒绝,
                自我治理队列拒绝原因::队列已停止, {}};
      }
      auto 结果 = 治理邮箱_->提交(消息, 当前时间戳);
      if (结果.状态 == 自我治理提交状态::已提交 &&
          消息.类型 == 自我治理消息类型::停止请求)
        停止已锁存_ = true;
      if (结果.状态 == 自我治理提交状态::已提交 ||
          结果.状态 == 自我治理提交状态::重复材料)
        治理运行门条件_.notify_all();
      return 结果;
    } catch (...) {
      return {自我治理提交状态::内部不一致,
              自我治理队列拒绝原因::协议内部不一致, {}};
    }
  }

  std::optional<任务结果治理处理槽快照> 等待任务结果治理处理槽(
      std::uint64_t 最小复核次数,
      std::uint64_t 最大等待毫秒) const noexcept {
    if (最小复核次数 == 0 || 最大等待毫秒 == 0)
      return std::nullopt;
    try {
      std::unique_lock<std::mutex> 锁(状态锁_);
      const bool 已形成 = 状态条件_.wait_for(
          锁, std::chrono::milliseconds(最大等待毫秒), [this, 最小复核次数]() {
            return 已发布任务结果治理处理槽快照_ &&
                   (已发布任务结果治理处理槽快照_->复核次数 >= 最小复核次数 ||
                    已发布任务结果治理处理槽快照_->目标裁决次数 >= 最小复核次数) &&
                   已发布任务结果治理处理槽快照_->状态 !=
                       任务结果治理处理槽状态::待复核 &&
                   已发布任务结果治理处理槽快照_->状态 !=
                       任务结果治理处理槽状态::目标待裁决;
          });
      if (!已形成)
        return std::nullopt;
      return 已发布任务结果治理处理槽快照_;
    } catch (...) {
      return std::nullopt;
    }
  }

  bool 请求重试任务结果治理处理槽() noexcept {
    std::lock_guard<std::mutex> 锁(状态锁_);
    if (!已发布任务结果治理处理槽快照_ || 已完成_ ||
        !运行门已开放_ || 停止已锁存_)
      return false;
    const auto 状态 = 已发布任务结果治理处理槽快照_->状态;
    if (状态 != 任务结果治理处理槽状态::合法等待 &&
        状态 != 任务结果治理处理槽状态::资源等待)
      return false;
    if (任务结果重试信号_ == (std::numeric_limits<std::uint64_t>::max)())
      return false;
    ++任务结果重试信号_;
    治理运行门条件_.notify_all();
    return true;
  }

private:
  struct 当前任务结果治理处理槽内部 final {
    不可变治理批次 批次;
    治理输入路由结果 路由结果;
    std::size_t 路由下标 = 0;
    std::uint64_t 复核次数 = 0;
    std::uint64_t 目标裁决次数 = 0;
    std::optional<任务结果治理后继输入> 冻结后继;
    std::optional<任务目标达成裁决快照> 冻结裁决;
    std::uint64_t 已消费重试信号 = 0;
  };

  mutable std::mutex 创建调用锁_;
  mutable std::mutex 状态锁_;
  mutable std::condition_variable 状态条件_;
  std::condition_variable 治理运行门条件_;
  线程生命周期发布端口 *生命周期发布端口_ = nullptr;
  const L2结构聚合服务 *结构聚合服务_ = nullptr;
  const L2任务结构服务 *任务结构服务_ = nullptr;
  自我线程需求治理端口 *需求治理端口_ = nullptr;
  自我线程任务管理提交端口 *任务管理提交端口_ = nullptr;
  自我线程安全治理端口 *安全治理端口_ = nullptr;
  std::optional<自我线程生产创建请求> 锁定请求_;
  std::unique_ptr<有界自我治理邮箱> 治理邮箱_;
  std::thread 线程_;
  线程逻辑身份 线程逻辑身份_;
  std::uint64_t 运行代次_ = 0;
  std::atomic_uint64_t 生命周期事件序号_ = 0;
  std::uint64_t 见证序号_ = 0;
  std::uint64_t 入口见证序号_ = 0;
  std::uint64_t 停门见证序号_ = 0;
  bool 入口已进入_ = false;
  bool 已停在关闭门_ = false;
  bool 运行门已开放_ = false;
  bool 停止已锁存_ = false;
  bool 治理初始化已完成_ = false;
  std::atomic_bool 线程入口异常已锁存_ = false;
  std::atomic_bool 已完成_ = false;
  std::optional<自我线程停门见证> 已发布停门见证_;

  // ===== BIZ-L1-T02 §所有权与停止边界 §2 装配阶段 =====
  // 三个 provider 临时由自我线程持有。最终设计应：普通应用持有完整秒服务和
  // 运行期事实版本服务，自我线程只持有借用和唯一批次路由。当前为最小可运行装配。
  std::uint64_t 时间纪元身份_ = 0;
  std::uint32_t 时间源版本_ = 0;
  std::uint32_t 事实范围版本_ = 0;
  std::unique_ptr<单调时钟适配器> 单调时钟适配器_;
  std::unique_ptr<完整秒时钟服务> 完整秒服务_;
  std::unique_ptr<运行期事实版本服务> 事实版本服务_;
  std::unique_ptr<自我治理批次路由> 批次路由_;
  std::uint64_t 最后成功批次序号_ = 0;
  std::uint64_t 最后完整秒边界_ = 0;
  std::optional<待重试见证> 当前待重试见证_;
  std::optional<当前任务结果治理处理槽内部> 当前任务结果治理处理槽_;
  std::optional<任务结果治理处理槽快照> 已发布任务结果治理处理槽快照_;
  std::uint64_t 任务结果重试信号_ = 0;

  bool 治理端口已齐全_已锁定() const noexcept {
    return 需求治理端口_ != nullptr && 任务管理提交端口_ != nullptr &&
           安全治理端口_ != nullptr;
  }

  自我治理循环退出结果 等待明确停止() noexcept {
    std::unique_lock<std::mutex> 锁(状态锁_);
    治理运行门条件_.wait(锁, [this]() { return 停止已锁存_; });
    return 自我治理循环退出结果::邮箱已停止;
  }

  void 锁存停止并唤醒() noexcept {
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      停止已锁存_ = true;
      if (治理邮箱_)
        治理邮箱_->请求停止并唤醒();
    }
    治理运行门条件_.notify_all();
  }

  自我线程启动候选回收结果 收口启动失败候选内部(
      std::uint64_t 完成等待毫秒) noexcept {
    try {
      {
        std::unique_lock<std::mutex> 锁(状态锁_);
        if (!线程_.joinable())
          return {自我线程启动候选回收状态::无候选};
        停止已锁存_ = true;
        if (治理邮箱_)
          治理邮箱_->请求停止并唤醒();
        锁.unlock();
        治理运行门条件_.notify_all();
        发布生命周期(线程生命周期投影::停止请求中,
                       线程生命周期投影::等待, 0, std::nullopt);
        锁.lock();
        const bool 已完成 = 状态条件_.wait_for(
            锁, std::chrono::milliseconds(完成等待毫秒),
            [this]() -> bool { return 已完成_; });
        if (!已完成)
          return {自我线程启动候选回收状态::等待完成超时};
      }
      if (线程_.joinable())
        线程_.join();
      std::lock_guard<std::mutex> 锁(状态锁_);
      治理邮箱_.reset();
      已发布停门见证_.reset();
      return {自我线程启动候选回收状态::已回收};
    } catch (...) {
      return {自我线程启动候选回收状态::内部不一致};
    }
  }

  std::optional<线程生命周期发布结果> 发布生命周期(
      线程生命周期投影 当前,
      std::optional<线程生命周期投影> 前一,
      std::uint64_t 原因键,
      std::optional<std::uint64_t> 系统线程身份) noexcept {
    if (!生命周期发布端口_)
      return std::nullopt;
    const auto 当前毫秒 = std::chrono::duration_cast<std::chrono::milliseconds>(
                              std::chrono::system_clock::now()
                                  .time_since_epoch())
                              .count();
    if (当前毫秒 <= 0)
      return std::nullopt;
    const auto 事件序号 = 生命周期事件序号_.fetch_add(1) + 1;
    if (事件序号 == 0)
      return std::nullopt;
    return 生命周期发布端口_->发布(
        {线程生命周期投影合同版本,
         {运行代次_, 线程逻辑身份_, 事件序号},
         项目线程类别::自我,
         项目线程模块::自我治理,
         系统线程身份,
         当前,
         前一,
         static_cast<std::uint64_t>(当前毫秒),
         线程生命周期投影合同版本,
         原因键,
         std::nullopt});
  }

  // ===== BIZ-L1-T02: 自我线程治理循环（对齐 v0.2）=====
  // 从一个完整治理批次出发完成本轮业务编排，返回结构化退出结果
  // 装配阶段：三个 provider 已装配（若存在结构服务可用）。
  // 治理循环通过批次路由真实冻结批次；L2 骨架函数接受真实治理批次输入。
  // 002-02 真实业务逻辑（L3 子快照读取）仍属 §不授权范围 §2，返回材料缺失
  // 时治理循环在 N04 处合法终止（一致事实终止）。
  自我治理循环退出结果 运行治理循环() noexcept {
    if (!治理邮箱_) {
      return 等待明确停止();
    }
    // 批次基础依赖不是治理端口的一部分；缺失时保持线程常驻并等待明确停止。
    if (!批次路由_ || !完整秒服务_ || !事实版本服务_) {
      return 等待明确停止();
    }

    治理批次处理阶段 当前阶段 = 治理批次处理阶段::一致事实;

    // N01-N20: 外循环
    while (true) {
      // 自我初始化也是常驻循环的一部分。端口未装配时阻塞等待；绑定完成后
      // fresh 读取需求与安全快照，只有初始化完成才处理治理消息。
      自我线程需求治理端口 *需求端口 = nullptr;
      自我线程安全治理端口 *安全端口 = nullptr;
      {
        std::unique_lock<std::mutex> 锁(状态锁_);
        治理运行门条件_.wait(锁, [this]() {
          return 停止已锁存_ || 治理初始化已完成_ ||
                 治理端口已齐全_已锁定();
        });
        if (停止已锁存_)
          return 自我治理循环退出结果::邮箱已停止;
        需求端口 = 需求治理端口_;
        安全端口 = 安全治理端口_;
      }
      if (!治理初始化已完成_) {
        自我线程治理端口请求 初始化请求;
        初始化请求.运行代次 = 运行代次_;
        初始化请求.共同事实截止G0 =
            锁定请求_->根消费材料.本次事实截止代次;
        初始化请求.唯一自我 = 锁定请求_->本能根锚点.唯一自我;
        初始化请求.安全根特征定义 =
            锁定请求_->本能根锚点.安全根特征定义;
        初始化请求.服务根特征定义 =
            锁定请求_->本能根锚点.服务根特征定义;
        const auto 初始需求快照 =
            需求端口->读取需求治理当前快照(初始化请求);
        const auto 初始安全快照 =
            安全端口->读取安全治理当前快照(初始化请求);
        const bool 初始化成功 =
            初始需求快照.成功() && 初始安全快照.成功() &&
            初始需求快照.本次正式读回截止 ==
                初始化请求.共同事实截止G0 &&
            初始安全快照.本次正式读回截止 ==
                初始化请求.共同事实截止G0;
        if (初始化成功) {
          std::lock_guard<std::mutex> 锁(状态锁_);
          治理初始化已完成_ = true;
          continue;
        }
        const bool 可重试 =
            初始需求快照.状态 == 自我线程外部调用状态::合法等待 ||
            初始需求快照.状态 == 自我线程外部调用状态::资源失败 ||
            初始安全快照.状态 == 自我线程外部调用状态::合法等待 ||
            初始安全快照.状态 == 自我线程外部调用状态::资源失败;
        if (!可重试)
          return 等待明确停止();
        std::unique_lock<std::mutex> 锁(状态锁_);
        治理运行门条件_.wait_for(
            锁, std::chrono::seconds(1), [this]() { return 停止已锁存_; });
        if (停止已锁存_)
          return 自我治理循环退出结果::邮箱已停止;
        continue;
      }

      if (当前任务结果治理处理槽_) {
        auto& 处理槽 = *当前任务结果治理处理槽_;
        if (处理槽.路由下标 >= 处理槽.路由结果.有序路由组.size() ||
            处理槽.复核次数 == (std::numeric_limits<std::uint64_t>::max)() ||
            处理槽.目标裁决次数 == (std::numeric_limits<std::uint64_t>::max)()) {
          return 等待明确停止();
        }
        const auto& 路由项 = 处理槽.路由结果.有序路由组[处理槽.路由下标];
        const auto* 载荷 = std::get_if<任务结果复核载荷>(
            &路由项.输入.消息.载荷);
        if (!载荷) {
          return 等待明确停止();
        }
        const auto& 消息 = 路由项.输入.消息;
        bool 等待同槽重试 = false;
        自我治理循环退出结果 本次退出 = 自我治理循环退出结果::领域治理终止;
        任务结果治理处理槽快照 快照;
        快照.治理批次身份 = 处理槽.批次.批次序号;
        快照.治理消息编号 = 消息.治理消息编号;
        快照.治理输入幂等键 = 消息.幂等键;
        快照.任务 = 载荷->任务;
        快照.共享事实截止G0 = 消息.读取截止代次;
        快照.复核次数 = 处理槽.复核次数;
        快照.目标裁决次数 = 处理槽.目标裁决次数;
        快照.后继输入 = 处理槽.冻结后继;
        快照.目标裁决 = 处理槽.冻结裁决;

        if (处理槽.冻结裁决) {
          快照.复核状态 = 治理输入事实复核状态::已绑定;
          if (!处理槽.冻结后继) {
            快照.状态 = 任务结果治理处理槽状态::内部终止;
            {
              std::lock_guard<std::mutex> 锁(状态锁_);
              已发布任务结果治理处理槽快照_ = 快照;
              状态条件_.notify_all();
            }
            return 等待明确停止();
          }
          // 目标裁决只作为后继决议输入保留；轮次收束和正式 self 决议
          // 由任务管理端口承接。这里不直接写任务状态，也不把达成/未达成
          // 擅自映射为任务事实。
          快照.状态 = 任务结果治理处理槽状态::目标裁决已形成;
          {
            std::lock_guard<std::mutex> 锁(状态锁_);
            已发布任务结果治理处理槽快照_ = 快照;
            状态条件_.notify_all();
          }
          自我线程治理端口请求 后继提交请求;
          后继提交请求.运行代次 = 运行代次_;
          后继提交请求.治理批次 = 处理槽.批次.批次序号;
          后继提交请求.治理消息编号 = 消息.治理消息编号;
          后继提交请求.消息幂等键 = 消息.幂等键;
          后继提交请求.共同事实截止G0 = 消息.读取截止代次;
          后继提交请求.唯一自我 = 锁定请求_->本能根锚点.唯一自我;
          后继提交请求.安全根特征定义 =
              锁定请求_->本能根锚点.安全根特征定义;
          后继提交请求.服务根特征定义 =
              锁定请求_->本能根锚点.服务根特征定义;
          后继提交请求.来源消息 = 消息;
          const auto 提交结果 =
              任务管理提交端口_->提交自我任务后继决议(后继提交请求);
          if (提交结果.状态 == 自我线程外部调用状态::合法等待 ||
              提交结果.状态 == 自我线程外部调用状态::资源失败) {
            std::unique_lock<std::mutex> 锁(状态锁_);
            治理运行门条件_.wait(锁, [this, &处理槽]() {
              return 停止已锁存_ ||
                     任务结果重试信号_ > 处理槽.已消费重试信号;
            });
            if (停止已锁存_)
              return 自我治理循环退出结果::邮箱已停止;
            处理槽.已消费重试信号 = 任务结果重试信号_;
            continue;
          }
          if (!提交结果.成功())
            return 等待明确停止();
          const auto 已完成批次序号 = 处理槽.批次.批次序号;
          const auto 已完成完整秒 = static_cast<std::uint64_t>(
              处理槽.批次.完整秒.当前完整秒边界);
          当前任务结果治理处理槽_.reset();
          最后成功批次序号_ = 已完成批次序号;
          最后完整秒边界_ = 已完成完整秒;
          continue;
        }

        if (!处理槽.冻结后继) {
          ++处理槽.复核次数;
          快照.复核次数 = 处理槽.复核次数;
          快照.状态 = 任务结果治理处理槽状态::待复核;
          {
            std::lock_guard<std::mutex> 锁(状态锁_);
            已发布任务结果治理处理槽快照_ = 快照;
            状态条件_.notify_all();
          }
          std::optional<L2任务轮次结算读取结果> 结算读回;
          if (任务结构服务_ == nullptr) {
            快照.状态 = 任务结果治理处理槽状态::内部终止;
            快照.复核状态 = 治理输入事实复核状态::内部错误;
          } else {
            auto 读取 = 任务结构服务_->读取任务轮次结算({
                L2任务轮次结算合同版本, 载荷->轮次结算,
                载荷->任务, 载荷->任务轮次, 消息.读取截止代次});
            if (!读取.成功() || !读取.结算 || !读取.轮次收束治理动作
                || 读取.本次正式读回截止 != 消息.读取截止代次) {
              switch (读取.结果头.状态) {
              case L2结构状态::资源失败:
                快照.状态 = 任务结果治理处理槽状态::资源等待;
                快照.复核状态 = 治理输入事实复核状态::资源失败;
                等待同槽重试 = true;
                break;
              case L2结构状态::事实代次漂移:
                快照.状态 = 任务结果治理处理槽状态::当前性终止;
                快照.复核状态 = 治理输入事实复核状态::当前性漂移;
                break;
              case L2结构状态::入口拒绝:
              case L2结构状态::许可拒绝:
              case L2结构状态::未找到:
              case L2结构状态::引用冲突:
                快照.状态 = 任务结果治理处理槽状态::输入拒绝;
                快照.复核状态 = 治理输入事实复核状态::引用冲突;
                break;
              default:
                快照.状态 = 任务结果治理处理槽状态::内部终止;
                快照.复核状态 = 治理输入事实复核状态::内部错误;
                break;
              }
            } else {
              const auto& 结算 = *读取.结算;
              const auto& 动作 = *读取.轮次收束治理动作;
              if (结算.身份 != 载荷->轮次结算
                  || 结算.任务 != 载荷->任务
                  || 结算.任务轮次 != 载荷->任务轮次
                  || 结算.来源共同事实截止 == 0
                  || 结算.来源共同事实截止 > 消息.读取截止代次
                  || 结算.结算规则版本 != L2任务轮次结算规则版本
                  || 结算.生命周期.创建事实代次 == 0
                  || 结算.生命周期.创建事实代次 > 消息.读取截止代次
                  || 结算.生命周期.退出事实代次
                  || 动作.任务 != 载荷->任务
                  || 动作.任务轮次 != 载荷->任务轮次
                  || 动作.来源共同事实截止 != 结算.来源共同事实截止
                  || 动作.生命周期.创建事实代次 == 0
                  || 动作.生命周期.创建事实代次 > 消息.读取截止代次
                  || 动作.生命周期.退出事实代次) {
                快照.状态 = 任务结果治理处理槽状态::输入拒绝;
                快照.复核状态 = 治理输入事实复核状态::引用冲突;
              } else {
                结算读回 = std::move(读取);
              }
            }
          }
          if (结算读回) {
            const auto 复核结果 = 复核任务结果治理输入绑定事实(
                路由项, 处理槽.批次.批次序号,
                锁定请求_->最大任务结果来源需求成员数);
            快照.复核状态 = 复核结果.状态;
            switch (复核结果.状态) {
          case 治理输入事实复核状态::已绑定:
            if (!复核结果.绑定 ||
                处理槽.路由结果.批次序号 != 处理槽.批次.批次序号 ||
                处理槽.批次.共享事实截止.事实截止代次 != 消息.读取截止代次 ||
                复核结果.绑定->任务 != 载荷->任务 ||
                复核结果.绑定->事实截止代次 != 消息.读取截止代次 ||
                !结算读回->结算->实际结果 ||
                *结算读回->结算->实际结果 != 复核结果.绑定->实际结果 ||
                !有效(复核结果.绑定->实例方法.值) ||
                复核结果.绑定->执行轮次 == 0 ||
                !有效(复核结果.绑定->实际结果.值)) {
              快照.状态 = 任务结果治理处理槽状态::内部终止;
              快照.复核状态 = 治理输入事实复核状态::内部错误;
              break;
            }
            处理槽.冻结后继 = 任务结果治理后继输入{
                处理槽.批次.批次序号, 消息.治理消息编号, 消息.幂等键,
                载荷->任务, 复核结果.绑定->实例方法,
                复核结果.绑定->执行轮次, 复核结果.绑定->实际结果,
                载荷->任务治理首态写入幂等身份,
                消息.读取截止代次, 复核结果.状态};
            快照.后继输入 = 处理槽.冻结后继;
            break;
          case 治理输入事实复核状态::合法等待:
            快照.状态 = 任务结果治理处理槽状态::合法等待;
            等待同槽重试 = true;
            break;
          case 治理输入事实复核状态::当前性漂移:
            快照.状态 = 任务结果治理处理槽状态::当前性终止;
            break;
          case 治理输入事实复核状态::引用冲突:
          case 治理输入事实复核状态::入口拒绝:
            快照.状态 = 任务结果治理处理槽状态::输入拒绝;
            break;
          case 治理输入事实复核状态::数量预算不足:
            快照.状态 = 任务结果治理处理槽状态::数量预算不足;
            break;
          case 治理输入事实复核状态::资源失败:
            快照.状态 = 任务结果治理处理槽状态::资源等待;
            等待同槽重试 = true;
            break;
          case 治理输入事实复核状态::内部错误:
          default:
            快照.状态 = 任务结果治理处理槽状态::内部终止;
            break;
          }
          }
        }

        if (处理槽.冻结后继) {
          ++处理槽.目标裁决次数;
          快照.目标裁决次数 = 处理槽.目标裁决次数;
          快照.状态 = 任务结果治理处理槽状态::目标待裁决;
          快照.复核状态 = 治理输入事实复核状态::已绑定;
          快照.后继输入 = 处理槽.冻结后继;
          {
            std::lock_guard<std::mutex> 锁(状态锁_);
            已发布任务结果治理处理槽快照_ = 快照;
            状态条件_.notify_all();
          }
          const auto& 后继 = *处理槽.冻结后继;
          const auto 裁决结果 = 裁决任务结果治理后继目标({
              运行期只读查询合同版本, 后继.治理输入幂等键,
              后继.任务, 后继.实例方法, 后继.执行轮次,
              后继.任务实际结果, 后继.共享事实截止G0});
          switch (裁决结果.状态) {
          case 任务目标达成裁决状态::目标已达成:
          case 任务目标达成裁决状态::目标未达成:
            if (!裁决结果.裁决
                || 裁决结果.裁决->治理输入幂等键 != 后继.治理输入幂等键
                || 裁决结果.裁决->任务 != 后继.任务
                || 裁决结果.裁决->实例方法 != 后继.实例方法
                || 裁决结果.裁决->执行轮次 != 后继.执行轮次
                || 裁决结果.裁决->任务实际结果 != 后继.任务实际结果
                || 裁决结果.裁决->事实截止代次 != 后继.共享事实截止G0) {
              快照.状态 = 任务结果治理处理槽状态::内部终止;
              break;
            }
            处理槽.冻结裁决 = *裁决结果.裁决;
            快照.目标裁决 = 处理槽.冻结裁决;
            快照.状态 = 任务结果治理处理槽状态::目标裁决已形成;
            本次退出 = 自我治理循环退出结果::任务目标裁决已形成;
            break;
          case 任务目标达成裁决状态::合法等待:
            快照.状态 = 任务结果治理处理槽状态::合法等待;
            等待同槽重试 = true;
            break;
          case 任务目标达成裁决状态::资源失败:
            快照.状态 = 任务结果治理处理槽状态::资源等待;
            等待同槽重试 = true;
            break;
          case 任务目标达成裁决状态::当前性漂移:
            快照.状态 = 任务结果治理处理槽状态::当前性终止;
            break;
          case 任务目标达成裁决状态::引用冲突:
          case 任务目标达成裁决状态::入口拒绝:
            快照.状态 = 任务结果治理处理槽状态::输入拒绝;
            break;
          case 任务目标达成裁决状态::不可比较:
            快照.状态 = 任务结果治理处理槽状态::不可比较终止;
            break;
          case 任务目标达成裁决状态::内部错误:
          default:
            快照.状态 = 任务结果治理处理槽状态::内部终止;
            break;
          }
        }
        {
          std::lock_guard<std::mutex> 锁(状态锁_);
          已发布任务结果治理处理槽快照_ = 快照;
          状态条件_.notify_all();
        }
        if (!等待同槽重试) {
          if (本次退出 == 自我治理循环退出结果::任务目标裁决已形成)
            continue;
          return 等待明确停止();
        }

        std::unique_lock<std::mutex> 锁(状态锁_);
        治理运行门条件_.wait(锁, [this, &处理槽]() {
          return 停止已锁存_ ||
                 任务结果重试信号_ > 处理槽.已消费重试信号;
        });
        if (停止已锁存_)
          return 自我治理循环退出结果::邮箱已停止;
        处理槽.已消费重试信号 = 任务结果重试信号_;
        continue;
      }

      // N01: 形成组合请求（装配阶段：使用真实路由固定配置）
      治理批次组合请求 组合请求;
      组合请求.合同版本 = 批次路由合同版本;
      组合请求.运行代次 = 运行代次_;
      组合请求.时间纪元身份 = 时间纪元身份_;
      组合请求.期望时间源版本 = 时间源版本_;
      组合请求.事实范围版本 = 事实范围版本_;
      组合请求.最大等待毫秒 = 1000;
      组合请求.上一已完成批次序号 = 最后成功批次序号_;
      组合请求.上一已消费完整秒边界 = 最后完整秒边界_;
      组合请求.重试见证 = 当前待重试见证_;

      // N02: 冻结当前治理批次（装配阶段：通过批次路由真实冻结）
      auto 冻结结果 = 批次路由_->冻结当前治理批次(组合请求);

      switch (冻结结果.状态) {
      case 治理批次状态::等待超时:
        // N02: 等待超时 → 重试N01
        continue;
      case 治理批次状态::已停止:
        // N22: 邮箱已停止
        锁存停止并唤醒();
        return 自我治理循环退出结果::邮箱已停止;
      case 治理批次状态::版本漂移:
      case 治理批次状态::资源失败:
      case 治理批次状态::时间证据缺口:
        if (冻结结果.重试见证)
          当前待重试见证_ = 冻结结果.重试见证;
        {
          std::unique_lock<std::mutex> 锁(状态锁_);
          治理运行门条件_.wait_for(
              锁, std::chrono::seconds(1),
              [this]() { return 停止已锁存_; });
          if (停止已锁存_)
            return 自我治理循环退出结果::邮箱已停止;
        }
        continue;
      case 治理批次状态::请求拒绝:
      case 治理批次状态::内部不一致:
        if (冻结结果.重试见证)
          当前待重试见证_ = 冻结结果.重试见证;
        return 等待明确停止();
      case 治理批次状态::已冻结:
        // N02A: 已冻结完整批次 → 提交到处理槽
        // 清除待重试见证，批次已成功冻结
        当前待重试见证_.reset();
        break;
      }

      // 取出不可变治理批次（N02A: 接管到当前循环唯一值）
      auto 当前批次 = std::move(*冻结结果.治理批次);

      // 002-03 必须先于尚未完成的其它治理骨架，使任务结果窄路径能够
      // 独立消费；非任务结果继续复用同一分类结果进入既有路径。
      治理批次分类请求 分类请求;
      分类请求.批次 = std::addressof(当前批次);
      分类请求.当前单调时间 = static_cast<std::uint64_t>(
          当前批次.完整秒.当前经过纳秒);
      分类请求.运行代次 = 运行代次_;
      auto 路由结果 = 批次路由_->复核分类并路由治理批次(分类请求);
      if (路由结果.分类状态 == 治理批次分类状态::入口拒绝 ||
          路由结果.分类状态 == 治理批次分类状态::存在时效拒绝 ||
          路由结果.分类状态 == 治理批次分类状态::内部错误) {
        return 等待明确停止();
      }
      if (路由结果.分类状态 == 治理批次分类状态::停止优先) {
        锁存停止并唤醒();
        return 自我治理循环退出结果::邮箱已停止;
      }
      std::optional<std::size_t> 任务结果路由下标;
      for (std::size_t 下标 = 0; 下标 < 路由结果.有序路由组.size(); ++下标) {
        if (路由结果.有序路由组[下标].输入.类别 ==
            治理输入类别::任务结果复核) {
          任务结果路由下标 = 下标;
          break;
        }
      }
      if (任务结果路由下标) {
        当前任务结果治理处理槽_.emplace(
            当前任务结果治理处理槽内部{std::move(当前批次),
                std::move(路由结果), *任务结果路由下标, 0, 0,
                std::nullopt, std::nullopt,
                任务结果重试信号_});
        continue;
      }

      const auto 当前共享事实截止 = 当前批次.共享事实截止.事实截止代次;
      const auto 当前完整秒边界 = static_cast<std::uint64_t>(
          当前批次.完整秒.当前完整秒边界);
      auto 形成端口请求 = [&](const 自我治理消息* 消息) {
        自我线程治理端口请求 请求;
        请求.运行代次 = 运行代次_;
        请求.治理批次 = 当前批次.批次序号;
        请求.治理消息编号 = 消息 ? 消息->治理消息编号 : 0;
        请求.消息幂等键 = 消息 ? 消息->幂等键 : 当前批次.批次序号;
        请求.共同事实截止G0 = 当前共享事实截止;
        请求.唯一自我 = 锁定请求_->本能根锚点.唯一自我;
        请求.安全根特征定义 =
            锁定请求_->本能根锚点.安全根特征定义;
        请求.服务根特征定义 =
            锁定请求_->本能根锚点.服务根特征定义;
        if (消息) 请求.来源消息 = *消息;
        return 请求;
      };
      const auto 结果匹配截止 = [&](const 自我线程治理端口结果& 结果) {
        return 结果.成功() &&
               结果.本次正式读回截止 == 当前共享事实截止;
      };
      const auto 需要等待 = [](const 自我线程治理端口结果& 结果) {
        return 结果.状态 == 自我线程外部调用状态::合法等待 ||
               结果.状态 == 自我线程外部调用状态::资源失败;
      };

      bool 本批已完成 = false;
      while (!本批已完成) {
        {
          std::lock_guard<std::mutex> 锁(状态锁_);
          if (停止已锁存_)
            return 自我治理循环退出结果::邮箱已停止;
        }
        当前阶段 = 治理批次处理阶段::安全维护;
        const auto 批次请求 = 形成端口请求(nullptr);
        const auto 安全执行结果 =
            安全治理端口_->请求执行安全治理(批次请求);
        const auto 安全快照结果 =
            安全治理端口_->读取安全治理当前快照(批次请求);
        const auto 需求快照结果 =
            需求治理端口_->读取需求治理当前快照(批次请求);
        if (需要等待(安全执行结果) || 需要等待(安全快照结果) ||
            需要等待(需求快照结果)) {
          std::unique_lock<std::mutex> 锁(状态锁_);
          治理运行门条件_.wait_for(锁, std::chrono::seconds(1), [this]() {
            return 停止已锁存_;
          });
          continue;
        }
        if (!结果匹配截止(安全执行结果) ||
            !结果匹配截止(安全快照结果) ||
            !结果匹配截止(需求快照结果))
          return 等待明确停止();

        当前阶段 = 治理批次处理阶段::输入处理;
        bool 本轮需要等待 = false;
        for (const auto& 路由项 : 路由结果.有序路由组) {
          if (路由项.状态 != 治理输入路由状态::已路由)
            return 等待明确停止();
          const auto& 消息 = 路由项.输入.消息;
          auto 请求 = 形成端口请求(&消息);
          自我线程治理端口结果 处理结果{
              自我线程外部调用状态::已形成, 当前共享事实截止};
          switch (路由项.输入.类别) {
          case 治理输入类别::派生需求: {
            处理结果 = 需求治理端口_->确认后继目标(请求);
            if (!结果匹配截止(处理结果)) break;
            auto 记录结果 =
                任务管理提交端口_->提交已确认子目标承接记录意图(请求);
            if (!结果匹配截止(记录结果) || !记录结果.子目标承接记录) {
              处理结果 = std::move(记录结果);
              break;
            }
            请求.子目标承接记录 = 记录结果.子目标承接记录;
            处理结果 =
                需求治理端口_->发布或复用已承接需求(请求);
            if (结果匹配截止(处理结果) && 处理结果.具体需求) {
              请求.具体需求 = 处理结果.具体需求;
              处理结果 =
                  任务管理提交端口_->提交任务承接意图(请求);
            }
            break;
          }
          case 治理输入类别::观察材料准入:
          case 治理输入类别::自检缺口:
            if (需求快照结果.具体需求) {
              请求.具体需求 = 需求快照结果.具体需求;
              处理结果 =
                  任务管理提交端口_->提交任务承接意图(请求);
            }
            break;
          case 治理输入类别::执行前许可预判:
            处理结果 = 安全治理端口_->请求现实执行授权(请求);
            break;
          case 治理输入类别::缓存刷新:
          case 治理输入类别::事件日志:
          case 治理输入类别::概念待命名:
            break;
          case 治理输入类别::停止:
            锁存停止并唤醒();
            return 自我治理循环退出结果::邮箱已停止;
          case 治理输入类别::任务结果复核:
          default:
            return 等待明确停止();
          }
          if (需要等待(处理结果)) {
            本轮需要等待 = true;
            break;
          }
          if (!结果匹配截止(处理结果) &&
              处理结果.状态 != 自我线程外部调用状态::引用冲突 &&
              处理结果.状态 != 自我线程外部调用状态::不可比较 &&
              处理结果.状态 != 自我线程外部调用状态::入口拒绝)
            return 等待明确停止();
        }
        if (本轮需要等待) {
          std::unique_lock<std::mutex> 锁(状态锁_);
          治理运行门条件_.wait_for(锁, std::chrono::seconds(1), [this]() {
            return 停止已锁存_;
          });
          continue;
        }
        本批已完成 = true;
      }

      当前阶段 = 治理批次处理阶段::已完成;
      // N20: 推进本轮只读游标与最后成功见证，清槽
      最后成功批次序号_ = 当前批次.批次序号;
      最后完整秒边界_ = 当前完整秒边界;
      // 继续下一轮
    }
  }

  void 执行线程入口正文() {
    {
      std::unique_lock<std::mutex> 锁(状态锁_);
      入口已进入_ = true;
      入口见证序号_ = ++见证序号_;
      if (!运行门已开放_ && !停止已锁存_) {
        已停在关闭门_ = true;
        停门见证序号_ = ++见证序号_;
      }
      状态条件_.notify_all();
      治理运行门条件_.wait(锁, [this]() {
        return 运行门已开放_ || 停止已锁存_;
      });
      已停在关闭门_ = false;
      // 运行门开放后进入治理循环；治理循环自身负责批次冻结和停止信号处理
      // L2 函数调用仍为留桩，控制流骨架先行闭合以便编译和测试。
      if (运行门已开放_ && !停止已锁存_) {
        锁.unlock();
        const auto 退出结果 = 运行治理循环();
        (void)退出结果;
        锁.lock();
      }
    }
    发布生命周期(线程生命周期投影::退出前,
                   线程生命周期投影::等待, 0, std::nullopt);
    发布生命周期(线程生命周期投影::已退出,
                   线程生命周期投影::退出前, 0, std::nullopt);
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      已完成_ = true;
      状态条件_.notify_all();
    }
  }

  void 线程入口() noexcept {
    try {
      执行线程入口正文();
    } catch (...) {
      // 异常闭环不得再次依赖可能已经失败的状态锁；原子完成见证只让
      // 创建方进入阶段20回收，不把异常线程升级为停门成功。
      线程入口异常已锁存_.store(true);
      已完成_.store(true);
      状态条件_.notify_all();
    }
  }
};

bool 自我线程生产创建结果::成功() const noexcept {
  return (状态 == 自我线程生产创建状态::已创建并停门 ||
          状态 == 自我线程生产创建状态::精确重复) &&
         停门见证 &&
         自我线程生产创建内部::停门见证完整(*停门见证);
}

} // namespace 海中鱼巣
