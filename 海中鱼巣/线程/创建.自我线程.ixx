module;

#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <memory>
#include <mutex>
#include <new>
#include <optional>
#include <system_error>
#include <thread>
#include <utility>

export module 海中鱼巣.线程.创建.自我线程;

import 海中鱼巣.线程.有界自我治理队列;
import 海中鱼巣.线程.投影.线程生命周期;
// I2 值式材料当前由普通应用模块拥有；激活时按最终公开模块机械匹配。
import 海中鱼巣.装配.普通应用;
import 海中鱼巣.领域.服务.L2治理函数骨架;
import 海中鱼巣.适配.适配器.单调时钟;
import 海中鱼巣.领域.服务.完整秒时钟;
import 海中鱼巣.领域.组合.运行期事实版本;
import 海中鱼巣.线程.路由.自我治理批次;
import 海中鱼巣.领域.服务.L2结构聚合;

export {
#include "自我线程生产创建.数据.h"
}

namespace 海中鱼巣::自我线程生产创建内部 {

// 身份等同：只需确认两棵根消费材料指向同一棵树和同一个根场景。
// 不深比较 L2 场景树/场景事实结构体（其 =default operator== 在 MSVC 模块边界被删）。
inline bool 根消费材料相同(const 自我世界树根消费材料 &左,
                            const 自我世界树根消费材料 &右) noexcept {
  return 左.请求.树 == 右.请求.树 &&
         左.请求.根场景 == 右.请求.根场景;
}

inline bool 请求语义相同(const 自我线程生产创建请求 &左,
                          const 自我线程生产创建请求 &右) noexcept {
  return 左.合同版本 == 右.合同版本 &&
         左.创建幂等身份 == 右.创建幂等身份 &&
         左.线程逻辑身份 == 右.线程逻辑身份 &&
         左.运行代次 == 右.运行代次 &&
         根消费材料相同(左.根消费材料, 右.根消费材料) &&
         左.治理邮箱容量 == 右.治理邮箱容量;
}

inline bool 请求有效(const 自我线程生产创建请求 &请求) noexcept {
  return 请求.合同版本 == 自我线程生产创建合同版本 &&
         请求.创建幂等身份.值 != 0 && 请求.治理邮箱容量 != 0 &&
         请求.线程逻辑身份.值 != 0 && 请求.运行代次 != 0 &&
         请求.入口停门等待毫秒 != 0 && 请求.失败回收诊断毫秒 != 0 &&
         请求.根消费材料.本次事实截止代次 != 0;
}

inline bool 停门见证完整(const 自我线程停门见证 &见证) noexcept {
  return 见证.线程逻辑身份.值 != 0 && 见证.运行代次 != 0 &&
         见证.入口见证序号 != 0 && 见证.停门见证序号 != 0 &&
         见证.停门见证序号 > 见证.入口见证序号 &&
         见证.运行门 == 自我线程治理运行门状态::关闭 &&
         见证.治理邮箱.已冻结批次数量 == 0 &&
         见证.治理邮箱.状态 == 自我治理邮箱状态::运行中;
}

inline 自我线程生产创建状态 合并启动失败与回收状态(
    自我线程生产创建状态 原失败,
    const 自我线程启动候选回收结果 &回收) noexcept {
  switch (回收.状态) {
  case 自我线程启动候选回收状态::已回收:
  case 自我线程启动候选回收状态::无候选:
    return 原失败;
  case 自我线程启动候选回收状态::等待完成超时:
    return 自我线程生产创建状态::启动候选回收超时;
  case 自我线程启动候选回收状态::内部不一致:
  default:
    return 自我线程生产创建状态::内部不一致;
  }
}

} // namespace 海中鱼巣::自我线程生产创建内部

export namespace 海中鱼巣 {

class 自我线程 final {
public:
  explicit 自我线程(
      线程生命周期发布端口 *生命周期发布端口,
      const L2结构聚合服务 *结构聚合服务 = nullptr) noexcept
      : 生命周期发布端口_(生命周期发布端口),
        结构聚合服务_(结构聚合服务) {}

  ~自我线程() noexcept {
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      停止已锁存_ = true;
      治理运行门条件_.notify_all();
    }
    if (线程_.joinable())
      线程_.join();
  }

  自我线程(const 自我线程 &) = delete;
  自我线程 &operator=(const 自我线程 &) = delete;
  自我线程(自我线程 &&) = delete;
  自我线程 &operator=(自我线程 &&) = delete;

  自我线程生产创建结果 创建并使自我线程停在治理运行门(
      const 自我线程生产创建请求 &请求) noexcept {
    try {
      // 序列锁覆盖完整创建调用。状态条件等待仍只释放状态锁，因此同请求
      // 并发不会在首次调用停门等待期间误判为第二个 joinable 候选。
      std::lock_guard<std::mutex> 创建调用序列锁(创建调用锁_);
      std::unique_lock<std::mutex> 锁(状态锁_);
      自我线程生产创建结果 结果;
      if (!自我线程生产创建内部::请求有效(请求))
        return 结果;
      if (锁定请求_ &&
          !自我线程生产创建内部::请求语义相同(*锁定请求_, 请求)) {
        结果.状态 = 自我线程生产创建状态::已发布选择冲突;
        return 结果;
      }
      if (已发布停门见证_) {
        结果.状态 = 自我线程生产创建状态::精确重复;
        结果.停门见证 = 已发布停门见证_;
        return 结果;
      }
      if (线程_.joinable()) {
        结果.状态 = 自我线程生产创建状态::内部不一致;
        return 结果;
      }
      if (!锁定请求_)
        锁定请求_ = 请求;

      治理邮箱_ = std::make_unique<有界自我治理邮箱>(请求.治理邮箱容量);
      线程逻辑身份_ = 请求.线程逻辑身份;
      运行代次_ = 请求.运行代次;
      入口已进入_ = false;
      已停在关闭门_ = false;
      已完成_ = false;
      线程入口异常已锁存_ = false;
      停止已锁存_ = false;
      运行门已开放_ = false;
      入口见证序号_ = 0;
      停门见证序号_ = 0;

      // ===== 装配阶段：三个 provider 实例化 =====
      // 装配条件：结构聚合服务指针非空。若为空，运行期 provider 不装配，
      // 治理循环进入时立即返回内部不一致（§骨架施工授权 §不授权范围 §3 仍生效）。
      // 临时固定配置：纪元身份 = 运行代次；时间源版本 = 1；事实范围版本 = 1。
      // 最终配置应由普通应用装配时传入，参见 §所有权与停止边界 §2。
      if (结构聚合服务_) {
        时间纪元身份_ = 请求.运行代次;
        时间源版本_ = 1;
        事实范围版本_ = 1;
        单调时钟适配器_ = std::make_unique<单调时钟适配器>(
            单调时钟适配器配置{请求.运行代次, 时间纪元身份_});
        完整秒服务_ = std::make_unique<完整秒时钟服务>(
            *单调时钟适配器_, 完整秒时钟服务配置{
                请求.运行代次, 时间纪元身份_, 时间源版本_});
        事实版本服务_ = std::make_unique<运行期事实版本服务>(
            *结构聚合服务_, 运行期事实版本服务配置{
                请求.运行代次, 事实范围版本_});
        批次路由_ = std::make_unique<自我治理批次路由>(
            *治理邮箱_, *完整秒服务_, *事实版本服务_,
            请求.运行代次, 时间纪元身份_, 时间源版本_, 事实范围版本_);
        最后成功批次序号_ = 0;
        最后完整秒边界_ = 0;
        当前待重试见证_.reset();
      }

      锁.unlock();
      结果.创建投影 = 发布生命周期(
          线程生命周期投影::创建, std::nullopt, 0, std::nullopt);
      锁.lock();
      try {
        线程_ = std::thread([this]() noexcept { 线程入口(); });
      } catch (const std::system_error &) {
        结果.状态 = 自我线程生产创建状态::线程候选创建失败;
        return 结果;
      }
      锁.unlock();
      结果.入口投影 = 发布生命周期(
          线程生命周期投影::启动中,
          线程生命周期投影::创建, 0, std::nullopt);
      锁.lock();

      const auto 等待时限 =
          std::chrono::milliseconds(请求.入口停门等待毫秒);
      const bool 已到达 = 状态条件_.wait_for(锁, 等待时限, [this]() {
        return 已停在关闭门_ || 已完成_;
      });
      if (已到达 && 已停在关闭门_ && !已完成_ && 治理邮箱_) {
        自我线程停门见证 见证{
            线程逻辑身份_, 运行代次_, 入口见证序号_, 停门见证序号_,
            自我线程治理运行门状态::关闭, 治理邮箱_->读取快照()};
        if (!自我线程生产创建内部::停门见证完整(见证)) {
          锁.unlock();
          const auto 回收 =
              收口启动失败候选内部(请求.失败回收诊断毫秒);
          结果.状态 = 自我线程生产创建内部::合并启动失败与回收状态(
              自我线程生产创建状态::治理运行门停驻失败, 回收);
          return 结果;
        }
        已发布停门见证_ = 见证;
        结果.状态 = 自我线程生产创建状态::已创建并停门;
        结果.停门见证 = 见证;
        锁.unlock();
        结果.停门投影 = 发布生命周期(
            线程生命周期投影::等待,
            线程生命周期投影::启动中, 0, std::nullopt);
        return 结果;
      }

      const auto 失败状态 = 线程入口异常已锁存_.load()
          ? 自我线程生产创建状态::内部不一致
          : (!入口已进入_
                 ? 自我线程生产创建状态::线程入口未进入
                 : 自我线程生产创建状态::治理运行门停驻失败);
      锁.unlock();
      const auto 回收 =
          收口启动失败候选内部(请求.失败回收诊断毫秒);
      结果.状态 = 自我线程生产创建内部::合并启动失败与回收状态(
          失败状态, 回收);
      return 结果;
    } catch (const std::bad_alloc &) {
      const auto 回收 = 收口启动失败候选(请求.失败回收诊断毫秒);
      return {自我线程生产创建内部::合并启动失败与回收状态(
          自我线程生产创建状态::资源失败, 回收)};
    } catch (...) {
      const auto 回收 = 收口启动失败候选(请求.失败回收诊断毫秒);
      return {自我线程生产创建内部::合并启动失败与回收状态(
          自我线程生产创建状态::内部不一致, 回收)};
    }
  }

  自我线程启动候选回收结果 收口启动失败候选(
      std::uint64_t 完成等待毫秒) noexcept {
    try {
      std::lock_guard<std::mutex> 创建调用序列锁(创建调用锁_);
      {
        std::lock_guard<std::mutex> 锁(状态锁_);
        if (已发布停门见证_)
          return {自我线程启动候选回收状态::内部不一致};
      }
      return 收口启动失败候选内部(完成等待毫秒);
    } catch (...) {
      return {自我线程启动候选回收状态::内部不一致};
    }
  }

  std::optional<自我线程停门见证> 读取停门见证() const {
    std::lock_guard<std::mutex> 锁(状态锁_);
    return 已发布停门见证_;
  }

  // 诊断责任：无适用错误分支；开放治理运行门，唤醒停在关闭门的自我线程进入空转。
  void 开放治理运行门() noexcept {
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      运行门已开放_ = true;
    }
    治理运行门条件_.notify_all();
  }

private:
  mutable std::mutex 创建调用锁_;
  mutable std::mutex 状态锁_;
  std::condition_variable 状态条件_;
  std::condition_variable 治理运行门条件_;
  线程生命周期发布端口 *生命周期发布端口_ = nullptr;
  const L2结构聚合服务 *结构聚合服务_ = nullptr;
  std::optional<自我线程生产创建请求> 锁定请求_;
  std::unique_ptr<有界自我治理邮箱> 治理邮箱_;
  std::thread 线程_;
  线程逻辑身份 线程逻辑身份_;
  std::uint64_t 运行代次_ = 0;
  std::atomic_uint64_t 生命周期事件序号_ = 0;
  std::uint64_t 见证序号_ = 0;
  std::uint64_t 入口见证序号_ = 0;
  std::uint64_t 停门见证序号_ = 0;
  bool 入口已进入_ = false;
  bool 已停在关闭门_ = false;
  bool 运行门已开放_ = false;
  bool 停止已锁存_ = false;
  std::atomic_bool 线程入口异常已锁存_ = false;
  std::atomic_bool 已完成_ = false;
  std::optional<自我线程停门见证> 已发布停门见证_;

  // ===== BIZ-L1-T02 §所有权与停止边界 §2 装配阶段 =====
  // 三个 provider 临时由自我线程持有。最终设计应：普通应用持有完整秒服务和
  // 运行期事实版本服务，自我线程只持有借用和唯一批次路由。当前为最小可运行装配。
  std::uint64_t 时间纪元身份_ = 0;
  std::uint32_t 时间源版本_ = 0;
  std::uint32_t 事实范围版本_ = 0;
  std::unique_ptr<单调时钟适配器> 单调时钟适配器_;
  std::unique_ptr<完整秒时钟服务> 完整秒服务_;
  std::unique_ptr<运行期事实版本服务> 事实版本服务_;
  std::unique_ptr<自我治理批次路由> 批次路由_;
  std::uint64_t 最后成功批次序号_ = 0;
  std::uint64_t 最后完整秒边界_ = 0;
  std::optional<待重试见证> 当前待重试见证_;

  自我线程启动候选回收结果 收口启动失败候选内部(
      std::uint64_t 完成等待毫秒) noexcept {
    try {
      {
        std::unique_lock<std::mutex> 锁(状态锁_);
        if (!线程_.joinable())
          return {自我线程启动候选回收状态::无候选};
        停止已锁存_ = true;
        治理运行门条件_.notify_all();
        锁.unlock();
        发布生命周期(线程生命周期投影::停止请求中,
                       线程生命周期投影::等待, 0, std::nullopt);
        锁.lock();
        const bool 已完成 = 状态条件_.wait_for(
            锁, std::chrono::milliseconds(完成等待毫秒),
            [this]() -> bool { return 已完成_; });
        if (!已完成)
          return {自我线程启动候选回收状态::等待完成超时};
      }
      if (线程_.joinable())
        线程_.join();
      std::lock_guard<std::mutex> 锁(状态锁_);
      治理邮箱_.reset();
      已发布停门见证_.reset();
      return {自我线程启动候选回收状态::已回收};
    } catch (...) {
      return {自我线程启动候选回收状态::内部不一致};
    }
  }

  std::optional<线程生命周期发布结果> 发布生命周期(
      线程生命周期投影 当前,
      std::optional<线程生命周期投影> 前一,
      std::uint64_t 原因键,
      std::optional<std::uint64_t> 系统线程身份) noexcept {
    if (!生命周期发布端口_)
      return std::nullopt;
    const auto 当前毫秒 = std::chrono::duration_cast<std::chrono::milliseconds>(
                              std::chrono::system_clock::now()
                                  .time_since_epoch())
                              .count();
    if (当前毫秒 <= 0)
      return std::nullopt;
    const auto 事件序号 = 生命周期事件序号_.fetch_add(1) + 1;
    if (事件序号 == 0)
      return std::nullopt;
    return 生命周期发布端口_->发布(
        {线程生命周期投影合同版本,
         {运行代次_, 线程逻辑身份_, 事件序号},
         项目线程类别::自我,
         项目线程模块::自我治理,
         系统线程身份,
         当前,
         前一,
         static_cast<std::uint64_t>(当前毫秒),
         线程生命周期投影合同版本,
         原因键,
         std::nullopt});
  }

  // ===== BIZ-L1-T02: 自我线程治理循环（对齐 v0.2）=====
  // 从一个完整治理批次出发完成本轮业务编排，返回结构化退出结果
  // 装配阶段：三个 provider 已装配（若存在结构服务可用）。
  // 治理循环通过批次路由真实冻结批次；L2 骨架函数接受真实治理批次输入。
  // 002-02 真实业务逻辑（L3 子快照读取）仍属 §不授权范围 §2，返回材料缺失
  // 时治理循环在 N04 处合法终止（一致事实终止）。
  自我治理循环退出结果 运行治理循环() noexcept {
    if (!治理邮箱_) {
      return 自我治理循环退出结果::内部不一致;
    }
    // 装配阶段：三个 provider 未装配时返回内部不一致
    if (!批次路由_ || !完整秒服务_ || !事实版本服务_) {
      return 自我治理循环退出结果::内部不一致;
    }

    治理批次处理阶段 当前阶段 = 治理批次处理阶段::一致事实;

    // N01-N20: 外循环
    while (true) {
      // 检查停止信号
      {
        std::lock_guard<std::mutex> 锁(状态锁_);
        if (停止已锁存_) {
          return 自我治理循环退出结果::邮箱已停止;
        }
      }

      // N01: 形成组合请求（装配阶段：使用真实路由固定配置）
      治理批次组合请求 组合请求;
      组合请求.合同版本 = 批次路由合同版本;
      组合请求.运行代次 = 运行代次_;
      组合请求.时间纪元身份 = 时间纪元身份_;
      组合请求.期望时间源版本 = 时间源版本_;
      组合请求.事实范围版本 = 事实范围版本_;
      组合请求.最大等待毫秒 = 1000;
      组合请求.上一已完成批次序号 = 最后成功批次序号_;
      组合请求.上一已消费完整秒边界 = 最后完整秒边界_;
      组合请求.重试见证 = 当前待重试见证_;

      // N02: 冻结当前治理批次（装配阶段：通过批次路由真实冻结）
      auto 冻结结果 = 批次路由_->冻结当前治理批次(组合请求);

      switch (冻结结果.状态) {
      case 治理批次状态::等待超时:
        // N02: 等待超时 → 重试N01
        continue;
      case 治理批次状态::已停止:
        // N22: 邮箱已停止
        return 自我治理循环退出结果::邮箱已停止;
      case 治理批次状态::请求拒绝:
      case 治理批次状态::版本漂移:
      case 治理批次状态::资源失败:
      case 治理批次状态::时间证据缺口:
      case 治理批次状态::内部不一致:
        // N23: 请求拒绝、坏形状或不可继续 → 批次组合终止
        // 保存重试见证供下一轮使用
        if (冻结结果.重试见证) {
          当前待重试见证_ = 冻结结果.重试见证;
        }
        return 自我治理循环退出结果::批次组合终止;
      case 治理批次状态::已冻结:
        // N02A: 已冻结完整批次 → 提交到处理槽
        // 清除待重试见证，批次已成功冻结
        当前待重试见证_.reset();
        break;
      }

      // 取出不可变治理批次（N02A: 接管到处理槽）
      const auto& 当前批次 = *冻结结果.治理批次;

      // N04: 读取自我治理一致事实（BIZ-L2-002-02）
      // 装配阶段：传入真实治理批次身份、共享事实截止、完整秒边界、事实范围版本
      自我治理一致事实请求 一致事实请求;
      一致事实请求.运行代次 = 运行代次_;
      一致事实请求.治理批次身份 = 当前批次.批次序号;
      const auto 当前共享事实截止 = 当前批次.共享事实截止.事实截止代次;
      const auto 当前完整秒边界 = static_cast<std::uint64_t>(
          当前批次.完整秒.当前完整秒边界);
      一致事实请求.读取前共享事实截止 = 当前共享事实截止;
      一致事实请求.完整秒边界 = 当前完整秒边界;
      一致事实请求.事实范围版本 = 事实范围版本_;
      const auto 一致事实结果 = 读取自我治理一致事实(一致事实请求);
      当前阶段 = 治理批次处理阶段::安全维护;

      // N04 分支：002-02 真实业务逻辑（L3 子快照读取）仍属 §不授权范围 §2，
      // 返回材料缺失时治理循环在 N04 处合法终止（一致事实终止）。
      if (一致事实结果.状态 != 自我治理一致事实状态::已形成) {
        // N25: 保槽并返回一致事实终止
        return 自我治理循环退出结果::一致事实终止;
      }

      // N05: 评估并维护安全层（BIZ-L2-003-01）
      安全维护请求 安全请求;
      安全请求.事实截止版本 = 当前共享事实截止;
      auto 安全结果 = 评估并维护安全层(安全请求);
      当前阶段 = 治理批次处理阶段::服务维护;
      if (安全结果.状态 != 安全维护状态::已维护 &&
          安全结果.状态 != 安全维护状态::无变化 &&
          安全结果.状态 != 安全维护状态::精确重复) {
        // N26: 保槽并返回领域治理终止
        return 自我治理循环退出结果::领域治理终止;
      }

      // N06: 维护服务与生存安全（BIZ-L2-003-02）
      服务生存维护请求 服务请求;
      服务请求.运行代次 = 运行代次_;
      服务请求.完整秒区间 = 当前完整秒边界;
      auto 服务结果 = 维护服务与生存安全(服务请求);
      当前阶段 = 治理批次处理阶段::权限计算;
      if (服务结果.状态 != 服务生存维护状态::已结算完整秒) {
        return 自我治理循环退出结果::领域治理终止;
      }

      // N07: 计算任务执行权限（BIZ-L2-003-03）
      任务执行权限请求 权限请求;
      权限请求.事实截止版本 = 当前共享事实截止;
      auto 权限结果 = 计算任务执行权限(权限请求);
      当前阶段 = 治理批次处理阶段::输入分类;
      if (权限结果.状态 != 任务执行权限状态::已形成) {
        return 自我治理循环退出结果::领域治理终止;
      }

      // N08: 复核并分类治理批次（BIZ-L2-002-03）
      治理批次分类请求 分类请求;
      分类请求.批次 = std::addressof(当前批次);
      分类请求.当前单调时间 = static_cast<std::uint64_t>(
          当前批次.完整秒.当前经过纳秒);
      分类请求.运行代次 = 运行代次_;
      const auto 路由结果 =
          批次路由_->复核分类并路由治理批次(分类请求);
      当前阶段 = 治理批次处理阶段::输入处理;
      if (路由结果.分类状态 == 治理批次分类状态::入口拒绝 ||
          路由结果.分类状态 == 治理批次分类状态::存在时效拒绝 ||
          路由结果.分类状态 == 治理批次分类状态::内部错误) {
        return 自我治理循环退出结果::领域治理终止;
      }
      if (路由结果.分类状态 == 治理批次分类状态::停止优先) {
        return 自我治理循环退出结果::邮箱已停止;
      }

      // N09-N13：当前所有普通后继均未接线。合法等待保留该冻结批次的
      // 处理槽，不调用002-04/05，也不触发002-06或推进成功游标。
      bool 存在已消费输入 = false;
      for (const auto& 路由项 : 路由结果.有序路由组) {
        if (路由项.状态 == 治理输入路由状态::入口拒绝
            || 路由项.状态 == 治理输入路由状态::内部错误) {
          return 自我治理循环退出结果::领域治理终止;
        }
        if (路由项.状态 == 治理输入路由状态::已路由) {
          // 当前唯一可路由项是停止；上面已按分类状态截断，保留防御性收口。
          if (路由项.后继 == 治理输入后继::停止) {
            return 自我治理循环退出结果::邮箱已停止;
          }
          return 自我治理循环退出结果::领域治理终止;
        }
      }
      if (!存在已消费输入) {
        return 自我治理循环退出结果::领域治理终止;
      }

      // N15: 确认当前正差距（BIZ-L2-004-01）
      需求正差距请求 差距请求;
      auto 差距结果 = 确认当前正差距(差距请求);
      当前阶段 = 治理批次处理阶段::后继裁决;
      if (差距结果.状态 != 需求正差距状态::已满足 &&
          差距结果.状态 != 需求正差距状态::存在可处理正差距) {
        return 自我治理循环退出结果::领域治理终止;
      }

      // N16: 裁决主需求与生存控制后继（BIZ-L2-002-07）
      自我治理后继裁决请求 后继请求;
      后继请求.治理批次身份 = 当前批次.批次序号;
      后继请求.当前时间 = 当前完整秒边界;
      auto 后继结果 = 裁决主需求与生存控制后继(后继请求);
      当前阶段 = 治理批次处理阶段::消息提交;
      // N16 → 无下行消息 → N20；形成下行意图 → N17

      // N17-N18: 形成并提交任务治理消息组（BIZ-L2-002-08）
      if (后继结果.状态 == 自我治理后继裁决状态::任务治理意图) {
        任务治理消息组提交请求 提交请求;
        提交请求.治理批次身份 = 当前批次.批次序号;
        提交请求.运行代次 = 运行代次_;
        提交请求.当前时间 = 当前完整秒边界;
        auto 提交结果 = 提交任务治理消息组(提交请求);
        if (提交结果.状态 != 任务治理消息组提交状态::已提交 &&
            提交结果.状态 != 任务治理消息组提交状态::精确重复) {
          // N27: 保槽并返回下行提交终止
          return 自我治理循环退出结果::下行提交终止;
        }
      }

      当前阶段 = 治理批次处理阶段::已完成;
      // N20: 推进本轮只读游标与最后成功见证，清槽
      最后成功批次序号_ = 当前批次.批次序号;
      最后完整秒边界_ = 当前完整秒边界;
      // 继续下一轮
    }
  }

  void 执行线程入口正文() {
    {
      std::unique_lock<std::mutex> 锁(状态锁_);
      入口已进入_ = true;
      入口见证序号_ = ++见证序号_;
      if (!运行门已开放_ && !停止已锁存_) {
        已停在关闭门_ = true;
        停门见证序号_ = ++见证序号_;
      }
      状态条件_.notify_all();
      治理运行门条件_.wait(锁, [this]() {
        return 运行门已开放_ || 停止已锁存_;
      });
      已停在关闭门_ = false;
      // 运行门开放后进入治理循环；治理循环自身负责批次冻结和停止信号处理
      // L2 函数调用仍为留桩，控制流骨架先行闭合以便编译和测试。
      if (运行门已开放_ && !停止已锁存_) {
        锁.unlock();
        const auto 退出结果 = 运行治理循环();
        (void)退出结果;
        锁.lock();
      }
    }
    发布生命周期(线程生命周期投影::退出前,
                   线程生命周期投影::等待, 0, std::nullopt);
    发布生命周期(线程生命周期投影::已退出,
                   线程生命周期投影::退出前, 0, std::nullopt);
    {
      std::lock_guard<std::mutex> 锁(状态锁_);
      已完成_ = true;
      状态条件_.notify_all();
    }
  }

  void 线程入口() noexcept {
    try {
      执行线程入口正文();
    } catch (...) {
      // 异常闭环不得再次依赖可能已经失败的状态锁；原子完成见证只让
      // 创建方进入阶段20回收，不把异常线程升级为停门成功。
      线程入口异常已锁存_.store(true);
      已完成_.store(true);
      状态条件_.notify_all();
    }
  }
};

bool 自我线程生产创建结果::成功() const noexcept {
  return (状态 == 自我线程生产创建状态::已创建并停门 ||
          状态 == 自我线程生产创建状态::精确重复) &&
         停门见证 &&
         自我线程生产创建内部::停门见证完整(*停门见证);
}

} // namespace 海中鱼巣
