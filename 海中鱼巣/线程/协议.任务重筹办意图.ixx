// 文件规则：任务重筹办意图只承载不可变纯值协议、同义守卫和抽象提交端口。
module;

#include <cstdint>

export module 海中鱼巣.线程.协议.任务重筹办意图;

import 海中鱼巣.领域.服务.L2任务结构;
export import 海中鱼巣.领域.组合.运行期只读查询;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 任务重筹办意图协议版本 = 1;

struct 任务重筹办意图 final {
    std::uint32_t 协议版本 = 任务重筹办意图协议版本;
    std::uint64_t 意图幂等键 = 0;
    std::uint64_t 治理批次身份 = 0;
    std::uint64_t 治理消息编号 = 0;
    L2任务身份 任务;
    L2实例方法身份 旧实例方法;
    std::uint64_t 旧执行轮次 = 0;
    L2任务实际结果身份 旧任务实际结果;
    std::uint64_t 原共同事实截止 = 0;
    std::int64_t 生命周期发生时间 = 0;
    std::uint64_t 运行代次 = 0;
    L2结构幂等身份 裁决首态写入幂等身份;
    L2结构幂等身份 待重筹办迁移写入幂等身份;
    任务目标达成裁决状态 裁决状态 =
        任务目标达成裁决状态::入口拒绝;
    任务目标达成裁决快照 目标裁决;
    friend bool operator==(const 任务重筹办意图&,
        const 任务重筹办意图&) = default;
};

inline bool 任务重筹办意图基础完整(const 任务重筹办意图& 意图) noexcept {
    return 意图.协议版本 == 任务重筹办意图协议版本
        && 意图.意图幂等键 != 0 && 意图.治理批次身份 != 0
        && 意图.治理消息编号 != 0 && 有效(意图.任务.值)
        && 有效(意图.旧实例方法.值) && 意图.旧执行轮次 != 0
        && 有效(意图.旧任务实际结果.值);
}

inline bool 任务重筹办意图时序身份完整(const 任务重筹办意图& 意图) noexcept {
    return 意图.原共同事实截止 != 0 && 意图.生命周期发生时间 != 0
        && 意图.运行代次 != 0
        && L2结构幂等身份有效(意图.裁决首态写入幂等身份)
        && L2结构幂等身份有效(意图.待重筹办迁移写入幂等身份)
        && 意图.裁决首态写入幂等身份 != 意图.待重筹办迁移写入幂等身份;
}

inline bool 任务重筹办意图裁决绑定完整(const 任务重筹办意图& 意图) noexcept {
    return 意图.裁决状态 == 任务目标达成裁决状态::目标未达成
        && 意图.目标裁决.生命周期准备 ==
            任务生命周期后继准备::目标未达成待重筹办
        && 意图.目标裁决.治理输入幂等键 == 意图.意图幂等键
        && 意图.目标裁决.任务 == 意图.任务
        && 意图.目标裁决.实例方法 == 意图.旧实例方法
        && 意图.目标裁决.执行轮次 == 意图.旧执行轮次
        && 意图.目标裁决.任务实际结果 == 意图.旧任务实际结果
        && 意图.目标裁决.事实截止代次 == 意图.原共同事实截止;
}

bool 任务重筹办意图完整(const 任务重筹办意图& 意图) noexcept {
    return 任务重筹办意图基础完整(意图)
        && 任务重筹办意图时序身份完整(意图)
        && 任务重筹办意图裁决绑定完整(意图);
}

inline bool 目标裁决身份相同(
    const 任务目标达成裁决快照& 左,
    const 任务目标达成裁决快照& 右) noexcept {
    return 左.治理输入幂等键 == 右.治理输入幂等键
        && 左.任务 == 右.任务 && 左.实例方法 == 右.实例方法
        && 左.执行轮次 == 右.执行轮次
        && 左.任务实际结果 == 右.任务实际结果
        && 左.任务目标来源 == 右.任务目标来源;
}

inline bool 目标裁决目标材料相同(
    const 任务目标达成裁决快照& 左,
    const 任务目标达成裁决快照& 右) noexcept {
    return 左.目标宿主 == 右.目标宿主 && 左.目标特征 == 右.目标特征
        && 左.目标状态合同 == 右.目标状态合同
        && 左.实际状态 == 右.实际状态 && 左.动态证据 == 右.动态证据
        && 左.方法 == 右.方法 && 左.路径预期结果 == 右.路径预期结果;
}

inline bool 目标裁决比较材料相同(
    const 任务目标达成裁决快照& 左,
    const 任务目标达成裁决快照& 右) noexcept {
    return 左.路径验证合同 == 右.路径验证合同
        && 左.比较注册 == 右.比较注册
        && 左.比较算法版本 == 右.比较算法版本
        && 左.具名关系 == 右.具名关系
        && 左.允许关系位 == 右.允许关系位
        && 左.生命周期准备 == 右.生命周期准备
        && 左.事实截止代次 == 右.事实截止代次;
}

bool 任务重筹办意图相同(
    const 任务重筹办意图& 左,
    const 任务重筹办意图& 右) noexcept {
    const bool 协议与来源相同 = 左.协议版本 == 右.协议版本
        && 左.意图幂等键 == 右.意图幂等键
        && 左.治理批次身份 == 右.治理批次身份
        && 左.治理消息编号 == 右.治理消息编号
        && 左.任务 == 右.任务 && 左.旧实例方法 == 右.旧实例方法
        && 左.旧执行轮次 == 右.旧执行轮次
        && 左.旧任务实际结果 == 右.旧任务实际结果;
    const bool 时序与写入相同 = 左.原共同事实截止 == 右.原共同事实截止
        && 左.生命周期发生时间 == 右.生命周期发生时间
        && 左.运行代次 == 右.运行代次
        && 左.裁决首态写入幂等身份 == 右.裁决首态写入幂等身份
        && 左.待重筹办迁移写入幂等身份 == 右.待重筹办迁移写入幂等身份
        && 左.裁决状态 == 右.裁决状态;
    return 协议与来源相同 && 时序与写入相同
        && 目标裁决身份相同(左.目标裁决, 右.目标裁决)
        && 目标裁决目标材料相同(左.目标裁决, 右.目标裁决)
        && 目标裁决比较材料相同(左.目标裁决, 右.目标裁决);
}

enum class 任务重筹办意图提交状态 : std::uint8_t {
    已接收 = 1,
    精确重复 = 2,
    已拒绝 = 3,
    内部错误 = 4
};

enum class 任务重筹办意图提交拒绝原因 : std::uint8_t {
    无 = 0,
    端口未运行 = 1,
    已停止 = 2,
    协议拒绝 = 3,
    幂等冲突 = 4,
    队列已满 = 5,
    内部状态冲突 = 6
};

struct 任务重筹办意图提交结果 final {
    任务重筹办意图提交状态 状态 = 任务重筹办意图提交状态::已拒绝;
    任务重筹办意图提交拒绝原因 拒绝原因 =
        任务重筹办意图提交拒绝原因::无;
    bool 成功() const noexcept {
        return (状态 == 任务重筹办意图提交状态::已接收
                || 状态 == 任务重筹办意图提交状态::精确重复)
            && 拒绝原因 == 任务重筹办意图提交拒绝原因::无;
    }
};

class 任务重筹办意图提交端口 {
public:
    virtual ~任务重筹办意图提交端口() = default;
    virtual 任务重筹办意图提交结果 提交任务重筹办意图(
        const 任务重筹办意图& 意图) noexcept = 0;
};

} // namespace 海中鱼巣
