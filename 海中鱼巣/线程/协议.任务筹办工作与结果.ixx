// 文件规则：本模块只定义任务筹办工作包、唯一结果消息及其进程内提交端口；不得拥有队列、线程、锁、仓库或服务调用。
module;

#include <cstddef>
#include <cstdint>
#include <variant>
#include <vector>

export module 海中鱼巣.线程.协议.任务筹办工作与结果;

import 海中鱼巣.领域.内部治理.服务.任务筹办当前就绪与执行冻结;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2任务子目标承接记录结构;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 任务筹办工作与结果协议版本 = 1;

struct 任务筹办工作包身份 final {
    std::uint64_t 值 = 0;
    friend bool operator==(const 任务筹办工作包身份&,
        const 任务筹办工作包身份&) = default;
};

struct 任务筹办结果消息身份 final {
    std::uint64_t 值 = 0;
    friend bool operator==(const 任务筹办结果消息身份&,
        const 任务筹办结果消息身份&) = default;
};

struct 任务筹办工作包消息 final {
    std::uint32_t 协议版本 = 任务筹办工作与结果协议版本;
    任务筹办工作包身份 工作包身份;
    L2任务身份 任务;
    L2任务轮次身份 任务轮次;
    std::uint64_t 筹办轮次 = 0;
    std::uint64_t 来源事实截止G0 = 0;
    任务筹办推进请求 请求;
    friend bool operator==(const 任务筹办工作包消息&,
        const 任务筹办工作包消息&) = default;
};

using 任务筹办结果分支 = 任务筹办收束类别;

struct 任务筹办结果消息 final {
    std::uint32_t 协议版本 = 任务筹办工作与结果协议版本;
    任务筹办结果消息身份 消息身份;
    任务筹办工作包身份 来源工作包身份;
    L2任务身份 任务;
    L2任务轮次身份 任务轮次;
    std::uint64_t 筹办轮次 = 0;
    std::uint64_t 来源事实截止G0 = 0;
    std::uint64_t 结果事实截止G1 = 0;
    任务筹办结果分支 分支 = 任务筹办结果分支::结构化非成功;
    任务筹办结果载荷 载荷 = 任务筹办结构化非成功材料{};
};

inline bool 下一筹办工作包逐项相同(
    const 下一筹办工作包& 左, const 下一筹办工作包& 右) noexcept {
    return 左.任务.值 == 右.任务.值 && 左.旧路径.值 == 右.旧路径.值
        && 左.旧实例.值 == 右.旧实例.值 && 左.旧执行轮次 == 右.旧执行轮次
        && 左.旧实际结果.值 == 右.旧实际结果.值
        && 左.正式目标裁决证据.值 == 右.正式目标裁决证据.值
        && 左.正式待重筹办状态.值 == 右.正式待重筹办状态.值
        && 左.原共同事实截止 == 右.原共同事实截止
        && 左.迁移后事实代次 == 右.迁移后事实代次
        && 左.旧筹办轮次 == 右.旧筹办轮次
        && 左.新筹办轮次 == 右.新筹办轮次
        && 左.运行代次 == 右.运行代次
        && 左.原重筹办意图幂等键 == 右.原重筹办意图幂等键;
}

inline bool 任务筹办结果载荷逐项相同(
    const 任务筹办结果载荷& 左, const 任务筹办结果载荷& 右) noexcept {
    if (左.index() != 右.index() || 左.valueless_by_exception()
        || 右.valueless_by_exception()) return false;
    if (const auto* 左值 = std::get_if<任务筹办可执行冻结定位>(&左)) {
        const auto& 右值 = std::get<任务筹办可执行冻结定位>(右);
        return 左值->正式选择.值 == 右值.正式选择.值
            && 左值->路径.值 == 右值.路径.值
            && 左值->冻结材料.值 == 右值.冻结材料.值
            && 左值->实例方法.值 == 右值.实例方法.值;
    }
    if (const auto* 左值 = std::get_if<任务筹办子目标承接定位>(&左)) {
        const auto& 右值 = std::get<任务筹办子目标承接定位>(右);
        if (左值->记录身份组.size() != 右值.记录身份组.size()) return false;
        for (std::size_t 索引 = 0; 索引 < 左值->记录身份组.size(); ++索引)
            if (左值->记录身份组[索引].值 != 右值.记录身份组[索引].值)
                return false;
        return true;
    }
    if (const auto* 左值 = std::get_if<任务筹办合法等待定位>(&左)) {
        const auto& 右值 = std::get<任务筹办合法等待定位>(右);
        return 左值->等待合同.等待对象.值 == 右值.等待合同.等待对象.值
            && 左值->等待合同.合法生产者.值
                == 右值.等待合同.合法生产者.值
            && 左值->等待合同.重新触发条件.值
                == 右值.等待合同.重新触发条件.值
            && 下一筹办工作包逐项相同(
                左值->等待合同.原工作包, 右值.等待合同.原工作包);
    }
    if (const auto* 左值 = std::get_if<任务筹办目标已完成定位>(&左)) {
        return 左值->目标裁决证据.值
            == std::get<任务筹办目标已完成定位>(右).目标裁决证据.值;
    }
    const auto& 左值 = std::get<任务筹办结构化非成功材料>(左);
    const auto& 右值 = std::get<任务筹办结构化非成功材料>(右);
    return 左值.类别 == 右值.类别
        && 左值.失败事实截止 == 右值.失败事实截止;
}

inline bool 任务筹办结果消息相同(
    const 任务筹办结果消息& 左, const 任务筹办结果消息& 右) noexcept {
    return 左.协议版本 == 右.协议版本 && 左.消息身份 == 右.消息身份
        && 左.来源工作包身份 == 右.来源工作包身份 && 左.任务 == 右.任务
        && 左.任务轮次 == 右.任务轮次 && 左.筹办轮次 == 右.筹办轮次
        && 左.来源事实截止G0 == 右.来源事实截止G0
        && 左.结果事实截止G1 == 右.结果事实截止G1
        && 左.分支 == 右.分支 && 任务筹办结果载荷逐项相同(左.载荷, 右.载荷);
}

inline bool 任务筹办工作包消息完整(
    const 任务筹办工作包消息& 消息) noexcept {
    const auto& 请求 = 消息.请求;
    return 消息.协议版本 == 任务筹办工作与结果协议版本
        && 消息.工作包身份.值 != 0 && 有效(消息.任务.值)
        && 有效(消息.任务轮次.值) && 消息.筹办轮次 != 0
        && 消息.来源事实截止G0 != 0
        && 请求.合同版本 == 任务筹办当前就绪合同版本
        && 请求.请求头.合同版本 == L2结构合同版本
        && L2任务结构请求头合同有效(请求.请求头)
        && 下一筹办工作包完整(请求.工作包)
        && 消息.工作包身份.值 == 请求.工作包.原重筹办意图幂等键
        && 消息.任务 == 请求.工作包.任务
        && 消息.筹办轮次 == 请求.工作包.新筹办轮次
        && 消息.来源事实截止G0 == 请求.请求头.期望事实代次
        && 消息.来源事实截止G0 == 请求.工作包.迁移后事实代次;
}

inline bool 任务筹办结果载荷匹配且完整(
    const 任务筹办结果消息& 消息) noexcept {
    if (消息.载荷.valueless_by_exception()) return false;
    switch (消息.分支) {
    case 任务筹办结果分支::可执行冻结: {
        const auto* 值 = std::get_if<任务筹办可执行冻结定位>(&消息.载荷);
        return 值 && 有效(值->正式选择.值) && 有效(值->路径.值)
            && 有效(值->冻结材料.值) && 有效(值->实例方法.值);
    }
    case 任务筹办结果分支::子目标承接: {
        const auto* 值 = std::get_if<任务筹办子目标承接定位>(&消息.载荷);
        if (!值 || 值->记录身份组.empty()) return false;
        for (std::size_t 索引 = 0; 索引 < 值->记录身份组.size(); ++索引) {
            if (!有效(值->记录身份组[索引].值)) return false;
            for (std::size_t 前 = 0; 前 < 索引; ++前)
                if (值->记录身份组[前] == 值->记录身份组[索引]) return false;
        }
        return true;
    }
    case 任务筹办结果分支::合法等待: {
        const auto* 值 = std::get_if<任务筹办合法等待定位>(&消息.载荷);
        return 值 && 有效(值->等待合同.等待对象.值)
            && 有效(值->等待合同.合法生产者.值)
            && 有效(值->等待合同.重新触发条件.值)
            && 下一筹办工作包完整(值->等待合同.原工作包);
    }
    case 任务筹办结果分支::目标已完成: {
        const auto* 值 = std::get_if<任务筹办目标已完成定位>(&消息.载荷);
        return 值 && 有效(值->目标裁决证据.值);
    }
    case 任务筹办结果分支::结构化非成功: {
        const auto* 值 = std::get_if<任务筹办结构化非成功材料>(&消息.载荷);
        return 值 && 值->失败事实截止 == 消息.结果事实截止G1;
    }
    }
    return false;
}

inline bool 任务筹办结果消息完整(
    const 任务筹办结果消息& 消息) noexcept {
    return 消息.协议版本 == 任务筹办工作与结果协议版本
        && 消息.消息身份.值 != 0 && 消息.来源工作包身份.值 != 0
        && 消息.消息身份.值 == 消息.来源工作包身份.值
        && 有效(消息.任务.值) && 有效(消息.任务轮次.值)
        && 消息.筹办轮次 != 0 && 消息.来源事实截止G0 != 0
        && 消息.结果事实截止G1 != 0
        && 任务筹办结果载荷匹配且完整(消息);
}

inline bool 任务筹办结果消息匹配工作包(
    const 任务筹办结果消息& 消息,
    const 任务筹办工作包消息& 工作包) noexcept {
    return 任务筹办结果消息完整(消息)
        && 任务筹办工作包消息完整(工作包)
        && 消息.来源工作包身份 == 工作包.工作包身份
        && 消息.任务 == 工作包.任务 && 消息.任务轮次 == 工作包.任务轮次
        && 消息.筹办轮次 == 工作包.筹办轮次
        && 消息.来源事实截止G0 == 工作包.来源事实截止G0;
}

enum class 任务筹办提交状态 : std::uint8_t {
    已接收 = 1,
    精确重复 = 2,
    资源等待 = 3,
    已拒绝 = 4,
    内部错误 = 5
};

enum class 任务筹办提交拒绝原因 : std::uint8_t {
    无 = 0,
    端口未运行 = 1,
    已停止 = 2,
    协议拒绝 = 3,
    幂等冲突 = 4,
    队列已满 = 5,
    内部状态冲突 = 6
};

struct 任务筹办提交结果 final {
    任务筹办提交状态 状态 = 任务筹办提交状态::已拒绝;
    任务筹办提交拒绝原因 拒绝原因 = 任务筹办提交拒绝原因::无;
    bool 成功() const noexcept {
        return (状态 == 任务筹办提交状态::已接收
                || 状态 == 任务筹办提交状态::精确重复)
            && 拒绝原因 == 任务筹办提交拒绝原因::无;
    }
};

class 任务筹办工作包提交端口 {
public:
    virtual ~任务筹办工作包提交端口() = default;
    virtual 任务筹办提交结果 提交任务筹办工作包(
        const 任务筹办工作包消息&) noexcept = 0;
};

class 任务筹办结果提交端口 {
public:
    virtual ~任务筹办结果提交端口() = default;
    virtual 任务筹办提交结果 提交任务筹办结果(
        const 任务筹办结果消息&) noexcept = 0;
};

} // namespace 海中鱼巣
