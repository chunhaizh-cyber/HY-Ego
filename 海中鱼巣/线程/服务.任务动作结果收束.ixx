module;

#include <cstddef>
#include <cstdint>
#include <new>
#include <optional>

export module 海中鱼巣.线程.服务.任务动作结果收束;

import 海中鱼巣.线程.协议.任务动作完成消息;
import 海中鱼巣.领域.组合.任务动作权威结果读回;
import 海中鱼巣.领域.内部治理.服务.实例方法执行;

export namespace 海中鱼巣 {

class 任务动作结果收束提供者 final {
public:
    任务动作结果收束提供者(
        任务动作完成消息端口& 完成消息端口,
        const 任务动作权威结果读回提供者& 权威结果读回) noexcept
        : 完成消息端口_(完成消息端口), 权威结果读回_(权威结果读回) {}

    任务动作结果收束结果 收束待验证任务动作结果(
        const 任务动作待验证材料& 材料) noexcept {
        if (!任务动作待验证材料有效(材料))
            return 失败(任务动作结果收束状态::入口拒绝);
        try {
            bool 全部精确重复 = true;
            std::uint64_t 最后观察截止 = 0;
            for (std::size_t i = 0; i < 材料.动作键逐项返回.size(); ++i) {
                const auto& 返回 = 材料.动作键逐项返回[i];
                const auto& 预计 = 材料.预计动态组[i];
                if (!返回.结果候选)
                    return 失败(任务动作结果收束状态::入口拒绝);
                const 任务动作完成消息 消息{
                    任务动作完成消息合同版本,
                    材料.执行幂等身份,
                    材料.任务,
                    材料.任务轮次,
                    材料.筹办轮次,
                    材料.执行轮次,
                    材料.冻结,
                    材料.冻结版本,
                    材料.实例方法,
                    材料.方法,
                    材料.方法内容版本,
                    返回.顺序,
                    材料.运行代次,
                    返回.动作入口,
                    返回.稳定动作键,
                    预计.预期结果材料,
                    预计.结果验证合同,
                    预计.动作归因合同,
                    返回.动作开始时间,
                    返回.动作结束时间,
                    *返回.结果候选};
                const auto 发布 = 完成消息端口_.发布或读取动作完成消息(消息);
                if (!发布.成功() || !发布.消息)
                    return 失败(映射消息失败(发布.状态));
                全部精确重复 = 全部精确重复
                    && 发布.状态 == 任务动作完成消息状态::精确重复;

                const auto 独立读取 = 完成消息端口_.读取动作完成消息(
                    材料.执行幂等身份, 材料.运行代次, 返回.顺序);
                if (!独立读取.成功() || !独立读取.消息
                    || *独立读取.消息 != 消息)
                    return 失败(映射消息失败(独立读取.状态));

                const auto 权威 = 权威结果读回_.读取动作后权威结果(
                    {1, *独立读取.消息});
                if (!权威.成功() || !权威.快照) {
                    if (权威.归因缺口)
                        return {映射权威失败(权威.状态), std::nullopt,
                            权威.归因缺口};
                    return 失败(映射权威失败(权威.状态));
                }
                if (权威.快照->完成消息 != 消息
                    || 权威.快照->事实截止代次 == 0)
                    return 失败(任务动作结果收束状态::内部错误);
                最后观察截止 = 权威.快照->事实截止代次;
            }

            const auto& 最后 = 材料.动作键逐项返回.back();
            任务动作结果收束结果 结果;
            结果.状态 = 全部精确重复
                ? 任务动作结果收束状态::精确重复
                : 任务动作结果收束状态::已形成;
            结果.工作结果定位 = 任务工作结果定位{1,
                材料.执行幂等身份, 材料.任务, 材料.任务轮次,
                材料.筹办轮次, 材料.执行轮次, 材料.冻结,
                材料.冻结版本, 材料.实例方法, 材料.方法,
                材料.方法内容版本, 最后.顺序, 最后观察截止,
                材料.运行代次};
            return 结果.成功() ? 结果
                : 失败(任务动作结果收束状态::内部错误);
        } catch (const std::bad_alloc&) {
            return 失败(任务动作结果收束状态::资源失败);
        } catch (...) {
            return 失败(任务动作结果收束状态::内部错误);
        }
    }

private:
    任务动作完成消息端口& 完成消息端口_;
    const 任务动作权威结果读回提供者& 权威结果读回_;

    static 任务动作结果收束结果 失败(
        任务动作结果收束状态 状态) noexcept {
        return {状态, std::nullopt, std::nullopt};
    }

    static 任务动作结果收束状态 映射消息失败(
        任务动作完成消息状态 状态) noexcept {
        switch (状态) {
        case 任务动作完成消息状态::未找到:
            return 任务动作结果收束状态::动作消息等待;
        case 任务动作完成消息状态::幂等冲突:
            return 任务动作结果收束状态::引用冲突;
        case 任务动作完成消息状态::入口拒绝:
            return 任务动作结果收束状态::入口拒绝;
        case 任务动作完成消息状态::资源失败:
            return 任务动作结果收束状态::资源失败;
        default:
            return 任务动作结果收束状态::内部错误;
        }
    }

    static 任务动作结果收束状态 映射权威失败(
        任务动作权威结果读回状态 状态) noexcept {
        switch (状态) {
        case 任务动作权威结果读回状态::合法等待:
            return 任务动作结果收束状态::权威结果等待;
        case 任务动作权威结果读回状态::当前性漂移:
            return 任务动作结果收束状态::当前性漂移;
        case 任务动作权威结果读回状态::引用冲突:
            return 任务动作结果收束状态::引用冲突;
        case 任务动作权威结果读回状态::归因不足:
            return 任务动作结果收束状态::归因不足;
        case 任务动作权威结果读回状态::入口拒绝:
            return 任务动作结果收束状态::入口拒绝;
        case 任务动作权威结果读回状态::资源失败:
            return 任务动作结果收束状态::资源失败;
        default:
            return 任务动作结果收束状态::内部错误;
        }
    }
};

} // namespace 海中鱼巣
