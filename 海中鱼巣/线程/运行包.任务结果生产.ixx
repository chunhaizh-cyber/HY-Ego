// 文件规则：任务结果生产运行包只装配强请求管理、worker 最终复核/执行/收束与 manager 独立上行；不接收外部预形成任务结果或自动重筹办意图。
module;

#include <cstdint>
#include <optional>

export module 海中鱼巣.线程.运行包.任务结果生产;

import 海中鱼巣.线程.上行桥.任务实际结果;
import 海中鱼巣.线程.任务管理线程;
import 海中鱼巣.线程.任务工作线程;
import 海中鱼巣.线程.创建.自我线程;
import 海中鱼巣.线程.协议.任务动作完成消息;
import 海中鱼巣.线程.服务.任务动作结果收束;
import 海中鱼巣.领域.内部治理.服务.任务执行最终当前性复核;
import 海中鱼巣.领域.内部治理.服务.实例方法执行;
import 海中鱼巣.领域.内部治理.服务.任务主阶段治理;
import 海中鱼巣.领域.内部治理.服务.任务阶段结构消费端口;
import 海中鱼巣.领域.内部治理.服务.任务结果消费分配与轮次结算;
import 海中鱼巣.领域.组合.任务动作权威结果读回;
import 海中鱼巣.领域.自我治理.服务.自我任务后继决议;
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2动态结构;

export namespace 海中鱼巣 {

enum class 任务结果生产运行包状态 : std::uint8_t {
    未启动 = 1,
    运行中 = 2,
    正在收口 = 3,
    已停止 = 4,
    启动失败 = 5,
    收口失败 = 6
};

struct 任务结果生产运行包操作结果 final {
    bool 成功 = false;
    任务结果生产运行包状态 状态 = 任务结果生产运行包状态::未启动;
};

class 任务结果生产运行包 final {
public:
    任务结果生产运行包(
        L2需求结构服务& 需求服务,
        L2任务结构服务& 任务服务,
        L2状态结构服务& 状态服务,
        L2特征结构服务& 特征服务,
        L2存在结构服务& 存在服务,
        L2场景结构服务& 场景服务,
        L2动态结构服务& 动态服务,
        自我线程& 自我治理目标,
        任务动作完成消息端口& 完成消息端口,
        const 任务动作权威结果读回提供者& 权威结果读回,
        任务主阶段治理提供者& 主阶段治理提供者,
        任务阶段结构消费端口& 阶段端口,
        任务结果消费分配与轮次结算提供者& 任务结算提供者,
        自我任务后继决议提供者& 自我后继决议提供者,
        任务执行最终当前性复核提供者& 最终复核,
        实例方法执行提供者& 实例执行,
        任务动作结果收束提供者& 动作结果收束,
        std::uint64_t 调度队列容量,
        std::uint64_t 强类型请求容量,
        std::uint64_t 结果上行容量,
        std::uint64_t 最大来源需求成员数) noexcept
        : 上行桥_(需求服务, 任务服务, 状态服务, 特征服务,
              存在服务, 场景服务, 动态服务),
          管理线程_(调度队列容量, 强类型请求容量, 结果上行容量,
              最大来源需求成员数, 上行桥_, 完成消息端口,
              权威结果读回, 自我治理目标, 主阶段治理提供者,
              任务服务, 阶段端口, 任务结算提供者,
              自我后继决议提供者),
          工作线程_(管理线程_, 最终复核, 实例执行,
              动作结果收束) {
    }

    ~任务结果生产运行包() noexcept {
        if (状态_ == 任务结果生产运行包状态::运行中
            || 状态_ == 任务结果生产运行包状态::正在收口) {
            (void)请求停止新派发();
            (void)收口工作线程并排空结果上行();
        }
    }

    任务结果生产运行包(const 任务结果生产运行包&) = delete;
    任务结果生产运行包& operator=(const 任务结果生产运行包&) = delete;
    任务结果生产运行包(任务结果生产运行包&&) = delete;
    任务结果生产运行包& operator=(任务结果生产运行包&&) = delete;

    任务结果生产运行包操作结果 启动() noexcept {
        if (状态_ != 任务结果生产运行包状态::未启动) {
            return {false, 状态_};
        }
        const auto 管理启动 = 管理线程_.启动();
        if (!管理启动.成功) {
            状态_ = 任务结果生产运行包状态::启动失败;
            return {false, 状态_};
        }
        const auto 工作启动 = 工作线程_.启动();
        if (!工作启动.成功) {
            (void)管理线程_.请求停止新派发();
            (void)管理线程_.排空结果上行并停止();
            (void)管理线程_.收口等待();
            状态_ = 任务结果生产运行包状态::启动失败;
            return {false, 状态_};
        }
        状态_ = 任务结果生产运行包状态::运行中;
        return {true, 状态_};
    }

    强类型任务执行请求准备结果 准备强类型任务执行请求(
        const 任务强类型执行请求& 请求) {
        return 管理线程_.准备强类型任务执行请求(请求);
    }

    强类型任务执行请求操作结果 确认强类型任务执行请求(
        强类型任务执行请求候选& 候选) {
        return 管理线程_.确认强类型任务执行请求(候选);
    }

    强类型任务执行请求操作结果 撤销强类型任务执行请求(
        强类型任务执行请求候选& 候选) {
        return 管理线程_.撤销强类型任务执行请求(候选);
    }

    任务管理线程操作结果 提交任务主阶段治理请求(
        const 任务主阶段治理请求& 请求) noexcept {
        return 管理线程_.提交任务主阶段治理请求(请求);
    }

    任务结果生产运行包操作结果 请求停止新派发() noexcept {
        if (状态_ != 任务结果生产运行包状态::运行中) {
            return {false, 状态_};
        }
        const auto 结果 = 管理线程_.请求停止新派发();
        if (!结果.成功) {
            状态_ = 任务结果生产运行包状态::收口失败;
            return {false, 状态_};
        }
        状态_ = 任务结果生产运行包状态::正在收口;
        return {true, 状态_};
    }

    任务结果生产运行包操作结果 收口工作线程并排空结果上行() noexcept {
        if (状态_ == 任务结果生产运行包状态::运行中) {
            const auto 停派 = 请求停止新派发();
            if (!停派.成功) return 停派;
        }
        if (状态_ != 任务结果生产运行包状态::正在收口) {
            return {false, 状态_};
        }
        const auto 停止工作 = 工作线程_.停止接收并排空();
        const auto 连接工作 = 工作线程_.收口等待();
        if (!停止工作.成功 || !连接工作.成功) {
            状态_ = 任务结果生产运行包状态::收口失败;
            return {false, 状态_};
        }
        const auto 请求排空 = 管理线程_.排空结果上行并停止();
        const auto 连接管理 = 管理线程_.收口等待();
        if (!请求排空.成功 || !连接管理.成功) {
            状态_ = 任务结果生产运行包状态::收口失败;
            return {false, 状态_};
        }
        状态_ = 任务结果生产运行包状态::已停止;
        return {true, 状态_};
    }

    任务工作结果槽结果 读取任务工作结果定位(
        稳定编码 执行幂等身份) const noexcept {
        return 管理线程_.读取任务工作结果定位(执行幂等身份);
    }

    任务工作线程快照 读取任务工作收束状态() const noexcept {
        return 工作线程_.读取快照();
    }

    任务结果生产运行包状态 当前状态() const noexcept { return 状态_; }

private:
    任务实际结果上行桥 上行桥_;
    任务管理线程 管理线程_;
    任务工作线程 工作线程_;
    任务结果生产运行包状态 状态_ = 任务结果生产运行包状态::未启动;
};

} // namespace 海中鱼巣
