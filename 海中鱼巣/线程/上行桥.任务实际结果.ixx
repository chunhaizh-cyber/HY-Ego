// 文件规则：任务实际结果上行桥只编排正式执行轮次读取、任务结果唯一发布、独立读回和治理消息形成；不得执行方法、裁决任务完成或直接提交邮箱。
module;

#include <cstdint>
#include <new>
#include <optional>
#include <utility>

export module 海中鱼巣.线程.上行桥.任务实际结果;

import 海中鱼巣.线程.任务结果回执协议;
import 海中鱼巣.线程.自我治理消息协议;
import 海中鱼巣.领域.组合.运行期只读查询;
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2动态结构;

export namespace 海中鱼巣 {

enum class 任务结果上行形成状态 : std::uint8_t {
    已形成 = 1,
    合法等待 = 2,
    当前性漂移 = 3,
    引用冲突 = 4,
    入口拒绝 = 5,
    数量预算不足 = 6,
    资源失败 = 7,
    内部错误 = 8
};

struct 任务结果上行形成结果 final {
    任务结果上行形成状态 状态 = 任务结果上行形成状态::入口拒绝;
    std::uint64_t 正式执行轮次 = 0;
    std::uint64_t 事实截止G1 = 0;
    std::optional<L2实例方法事实> 实例方法;
    std::optional<L2任务实际结果事实> 正式结果;
    std::optional<自我治理消息> 治理消息;

    bool 成功() const noexcept {
        return 状态 == 任务结果上行形成状态::已形成
            && 正式执行轮次 != 0 && 事实截止G1 != 0
            && 实例方法.has_value() && 正式结果.has_value()
            && 治理消息.has_value();
    }
};

class 任务实际结果上行桥 final {
public:
    任务实际结果上行桥(
        L2需求结构服务& 需求服务,
        L2任务结构服务& 任务服务,
        L2状态结构服务& 状态服务,
        L2特征结构服务& 特征服务,
        L2存在结构服务& 存在服务,
        L2场景结构服务& 场景服务,
        L2动态结构服务& 动态服务) noexcept
        : 任务服务_(任务服务),
          只读组合器_(需求服务, 任务服务, 状态服务, 特征服务,
              存在服务, 场景服务, 动态服务) {
    }

    任务结果上行形成结果 发布并形成治理消息(
        const 任务结果回执材料& 回执,
        std::uint64_t 最大来源需求成员数) noexcept {
        try {
            任务结果回执准入上下文 回执上下文;
            回执上下文.当前时间戳 = 回执.发生时间戳;
            const auto 回执复核 = 复核任务结果回执材料(回执, 回执上下文);
            if (回执复核.状态 != 任务结果回执准入状态::可准入
                || 最大来源需求成员数 == 0) {
                return {任务结果上行形成状态::入口拒绝};
            }

            const auto G0 = 回执.读取截止代次;
            L2按任务读取当前实例方法请求 实例请求;
            实例请求.请求头 = {L2结构合同版本, G0};
            实例请求.读取类别 = L2读取类别::当前;
            实例请求.任务 = 回执.身份组.目标任务;
            const auto 实例读取 = 任务服务_.按任务读取当前实例方法(实例请求);
            if (实例读取.结果头.事实截止代次 != G0) {
                return {任务结果上行形成状态::当前性漂移};
            }
            if (实例读取.结果头.状态 == L2结构状态::资源失败) {
                return {任务结果上行形成状态::资源失败};
            }
            if (实例读取.结果头.状态 == L2结构状态::事实代次漂移) {
                return {任务结果上行形成状态::当前性漂移};
            }
            if (!实例读取.成功()) {
                return {实例读取.结果头.状态 == L2结构状态::未找到
                        ? 任务结果上行形成状态::合法等待
                        : 任务结果上行形成状态::入口拒绝};
            }
            if (!实例读取.当前实例方法) {
                return {任务结果上行形成状态::合法等待};
            }
            const auto& 实例 = *实例读取.当前实例方法;
            if (实例.任务 != 回执.身份组.目标任务
                || 实例.来源方法 != 回执.身份组.目标方法
                || 实例.执行轮次 == 0) {
                return {任务结果上行形成状态::引用冲突};
            }

            L2记录任务实际结果请求 记录请求;
            记录请求.请求头 = {L2结构合同版本, G0};
            记录请求.幂等身份 = 回执.任务实际结果写入幂等身份;
            记录请求.任务 = 回执.身份组.目标任务;
            记录请求.实例方法 = 实例.身份;
            记录请求.执行轮次 = 实例.执行轮次;
            记录请求.方法 = 回执.身份组.目标方法;
            记录请求.动作入口 = 回执.身份组.目标动作入口;
            记录请求.场景 = 回执.身份组.场景;
            记录请求.主体 = 回执.身份组.主体;
            记录请求.实际状态 = 回执.身份组.实际结果状态;
            记录请求.动态证据 = 回执.身份组.动态证据;
            记录请求.来源材料版本 = 回执.来源材料版本;
            记录请求.运行代次 = 回执.运行代次;
            const auto 记录结果 = 任务服务_.记录任务实际结果(记录请求);
            if (记录结果.结果头.状态 == L2结构状态::引用冲突
                || 记录结果.结果头.状态 == L2结构状态::幂等冲突) {
                return {任务结果上行形成状态::引用冲突,
                    实例.执行轮次, 0, 实例};
            }
            if (记录结果.结果头.状态 == L2结构状态::事实代次漂移) {
                return {任务结果上行形成状态::当前性漂移,
                    实例.执行轮次, 0, 实例};
            }
            if (记录结果.结果头.状态 == L2结构状态::资源失败) {
                return {任务结果上行形成状态::资源失败,
                    实例.执行轮次, 0, 实例};
            }
            if (!记录结果.成功() || !记录结果.实际结果) {
                return {记录结果.结果头.状态 == L2结构状态::入口拒绝
                        || 记录结果.结果头.状态 == L2结构状态::许可拒绝
                        ? 任务结果上行形成状态::入口拒绝
                        : 任务结果上行形成状态::内部错误,
                    实例.执行轮次, 0, 实例};
            }
            const auto G1 = 记录结果.结果头.事实截止代次;
            if (G1 == 0) {
                return {任务结果上行形成状态::内部错误,
                    实例.执行轮次, 0, 实例};
            }

            return 继续独立读回并形成治理消息(
                回执, 实例, *记录结果.实际结果, G1,
                最大来源需求成员数);
        } catch (const std::bad_alloc&) {
            return {任务结果上行形成状态::资源失败};
        } catch (...) {
            return {任务结果上行形成状态::内部错误};
        }
    }

    任务结果上行形成结果 继续独立读回并形成治理消息(
        const 任务结果回执材料& 回执,
        const L2实例方法事实& 实例,
        const L2任务实际结果事实& 已发布结果,
        std::uint64_t G1,
        std::uint64_t 最大来源需求成员数) noexcept {
        try {
            if (G1 == 0 || 最大来源需求成员数 == 0
                || 实例.执行轮次 == 0 || 已发布结果.实例方法 != 实例.身份
                || 已发布结果.执行轮次 != 实例.执行轮次) {
                return {任务结果上行形成状态::入口拒绝};
            }
            任务实际结果独立读回请求 读回请求;
            读回请求.合同版本 = 运行期只读查询合同版本;
            读回请求.任务 = 回执.身份组.目标任务;
            读回请求.执行轮次 = 实例.执行轮次;
            读回请求.方法 = 回执.身份组.目标方法;
            读回请求.动作入口 = 回执.身份组.目标动作入口;
            读回请求.场景 = 回执.身份组.场景;
            读回请求.主体 = 回执.身份组.主体;
            读回请求.实际状态 = 回执.身份组.实际结果状态;
            读回请求.动态证据 = 回执.身份组.动态证据;
            读回请求.来源材料版本 = 回执.来源材料版本;
            读回请求.运行代次 = 回执.运行代次;
            读回请求.共享事实截止G0 = G1;
            读回请求.最大需求成员数 = 最大来源需求成员数;
            const auto 读回结果 = 只读组合器_.读取任务本轮实际结果与独立读回(
                读回请求);
            if (读回结果.状态 == 任务实际结果独立读回状态::尚未形成) {
                return {任务结果上行形成状态::合法等待,
                    实例.执行轮次, G1, 实例, 已发布结果};
            }
            if (读回结果.状态 == 任务实际结果独立读回状态::当前性漂移) {
                return {任务结果上行形成状态::当前性漂移,
                    实例.执行轮次, G1, 实例, 已发布结果};
            }
            if (读回结果.状态 == 任务实际结果独立读回状态::引用冲突
                || 读回结果.状态 == 任务实际结果独立读回状态::轮次不匹配) {
                return {任务结果上行形成状态::引用冲突,
                    实例.执行轮次, G1, 实例, 已发布结果};
            }
            if (读回结果.状态 == 任务实际结果独立读回状态::数量预算不足) {
                return {任务结果上行形成状态::数量预算不足,
                    实例.执行轮次, G1, 实例, 已发布结果};
            }
            if (读回结果.状态 == 任务实际结果独立读回状态::资源失败) {
                return {任务结果上行形成状态::资源失败,
                    实例.执行轮次, G1, 实例, 已发布结果};
            }
            if (!读回结果.成功() || !读回结果.快照) {
                return {读回结果.状态 == 任务实际结果独立读回状态::请求拒绝
                        ? 任务结果上行形成状态::入口拒绝
                        : 任务结果上行形成状态::内部错误,
                    实例.执行轮次, G1, 实例, 已发布结果};
            }

            const auto& 正式快照 = *读回结果.快照;
            const auto& 正式结果 = 正式快照.结果;
            if (正式快照.事实截止代次 != G1
                || 正式结果 != 已发布结果
                || 正式快照.实例方法 != 实例) {
                return {任务结果上行形成状态::内部错误,
                    实例.执行轮次, G1, 实例, 正式结果};
            }

            自我治理消息 消息;
            消息.协议版本 = 自我治理协议版本;
            消息.治理消息编号 = 回执.回执编号;
            消息.类型 = 自我治理消息类型::任务结果复核请求;
            消息.来源角色 = 自我治理来源角色::任务管理上行桥;
            消息.来源服务 = 自我治理服务角色::任务桥边界;
            消息.目标服务 = 自我治理服务角色::任务;
            消息.发生时间戳 = 回执.发生时间戳;
            消息.优先级 = 自我治理消息优先级::普通;
            消息.幂等键 = 回执.幂等键;
            消息.来源任务序号 = 回执.来源任务序号;
            消息.来源材料版本 = 正式结果.来源材料版本;
            消息.批次编号 = 回执.批次编号;
            消息.非权威材料摘要 = 计算正式结果摘要(正式结果, G1);
            消息.材料类型 = 自我治理只读材料类型::任务结果材料;
            消息.材料性质 = 自我治理材料性质::非权威回执;
            消息.过期策略 = 自我治理过期策略::永不过期;
            消息.截止时间戳 = 0;
            消息.运行代次 = 正式结果.运行代次;
            消息.读取截止代次 = G1;
            消息.载荷 = 任务结果复核载荷{正式结果.任务,
                正式结果.实际状态, 正式结果.动态证据, 正式结果.方法,
                正式结果.动作入口, 正式结果.场景, 正式结果.主体};

            自我治理准入上下文 消息上下文;
            消息上下文.当前时间戳 = 消息.发生时间戳;
            const auto 消息复核 = 复核自我治理消息(消息, 消息上下文);
            if (消息复核.状态 != 自我治理准入状态::可准入) {
                return {任务结果上行形成状态::内部错误,
                    实例.执行轮次, G1, 实例, 正式结果};
            }
            return {任务结果上行形成状态::已形成,
                实例.执行轮次, G1, 实例, 正式结果, std::move(消息)};
        } catch (const std::bad_alloc&) {
            return {任务结果上行形成状态::资源失败,
                实例.执行轮次, G1, 实例, 已发布结果};
        } catch (...) {
            return {任务结果上行形成状态::内部错误,
                实例.执行轮次, G1, 实例, 已发布结果};
        }
    }

private:
    static std::uint64_t 计算正式结果摘要(
        const L2任务实际结果事实& 结果,
        std::uint64_t G1) noexcept {
        std::uint64_t 摘要 = 1469598103934665603ULL;
        const auto 混合 = [&摘要](std::uint64_t 值) noexcept {
            摘要 ^= 值;
            摘要 *= 1099511628211ULL;
        };
        混合(结果.身份.值.值);
        混合(结果.任务.值.值);
        混合(结果.实例方法.值.值);
        混合(结果.执行轮次);
        混合(结果.方法.值.值);
        混合(结果.动作入口.值.值);
        混合(结果.场景.值.值);
        混合(结果.主体.值.值);
        混合(结果.实际状态.值.值);
        混合(结果.动态证据.值.值);
        混合(结果.来源材料版本);
        混合(结果.运行代次);
        混合(G1);
        return 摘要 == 0 ? 1 : 摘要;
    }

    L2任务结构服务& 任务服务_;
    运行期只读查询组合器 只读组合器_;
};

} // namespace 海中鱼巣
