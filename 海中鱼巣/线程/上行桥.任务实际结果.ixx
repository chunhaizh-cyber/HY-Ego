// 文件规则：任务实际结果上行桥只编排正式执行轮次读取、任务结果唯一发布和独立读回；不得执行方法、裁决任务完成、形成结算前 self 消息或直接提交邮箱。
module;

#include <cstdint>
#include <new>
#include <optional>
#include <utility>

export module 海中鱼巣.线程.上行桥.任务实际结果;

import 海中鱼巣.领域.组合.任务动作权威结果读回;
import 海中鱼巣.领域.组合.运行期只读查询;
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2动态结构;
import 海中鱼巣.线程.任务结果回执协议;

export namespace 海中鱼巣 {

enum class 任务结果上行形成状态 : std::uint8_t {
    已形成 = 1,
    合法等待 = 2,
    当前性漂移 = 3,
    引用冲突 = 4,
    入口拒绝 = 5,
    数量预算不足 = 6,
    资源失败 = 7,
    内部错误 = 8
};

struct 任务结果上行形成结果 final {
    任务结果上行形成状态 状态 = 任务结果上行形成状态::入口拒绝;
    std::uint64_t 正式执行轮次 = 0;
    std::uint64_t 事实截止G1 = 0;
    std::optional<L2实例方法事实> 实例方法;
    std::optional<L2任务实际结果事实> 正式结果;

    bool 成功() const noexcept {
        return 状态 == 任务结果上行形成状态::已形成
            && 正式执行轮次 != 0 && 事实截止G1 != 0
            && 实例方法.has_value() && 正式结果.has_value();
    }
};

class 任务实际结果上行桥 final {
public:
    任务实际结果上行桥(
        L2需求结构服务& 需求服务,
        L2任务结构服务& 任务服务,
        L2状态结构服务& 状态服务,
        L2特征结构服务& 特征服务,
        L2存在结构服务& 存在服务,
        L2场景结构服务& 场景服务,
        L2动态结构服务& 动态服务) noexcept;

    任务结果上行形成结果 发布并形成治理消息_v2(
        const 任务工作结果定位& 定位,
        const 任务动作权威结果快照& 快照,
        std::uint64_t 最大来源需求成员数) noexcept;

private:
    任务结果上行形成结果 继续独立读回并形成治理消息_v2(
        const 任务工作结果定位& 定位,
        const 任务动作权威结果快照& 快照,
        const 任务结果回执材料& 回执,
        const L2实例方法事实& 实例,
        const L2任务实际结果事实& 已发布结果,
        std::uint64_t G1,
        std::uint64_t 最大来源需求成员数) noexcept;

    static std::uint64_t 计算正式结果摘要(
        const L2任务实际结果事实& 结果,
        std::uint64_t G1) noexcept;

    L2任务结构服务& 任务服务_;
    运行期只读查询组合器 只读组合器_;
};

} // namespace 海中鱼巣

module :private;

namespace 海中鱼巣 {

namespace 任务实际结果上行桥内部 {

bool 生命周期相同(const L2生命周期& 左, const L2生命周期& 右) noexcept {
    return 左.创建事实代次 == 右.创建事实代次
        && 左.退出事实代次.has_value() == 右.退出事实代次.has_value()
        && (!左.退出事实代次
            || *左.退出事实代次 == *右.退出事实代次);
}

bool 实例方法事实相同(
    const L2实例方法事实& 左, const L2实例方法事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.任务 == 右.任务
        && 左.当前选中路径 == 右.当前选中路径
        && 左.筹办轮次 == 右.筹办轮次 && 左.执行轮次 == 右.执行轮次
        && 左.来源方法 == 右.来源方法
        && 左.来源方法内容版本 == 右.来源方法内容版本
        && 生命周期相同(左.生命周期, 右.生命周期);
}

bool 任务实际结果事实相同(
    const L2任务实际结果事实& 左,
    const L2任务实际结果事实& 右) noexcept {
    return 左.身份 == 右.身份 && 左.任务 == 右.任务
        && 左.实例方法 == 右.实例方法 && 左.执行轮次 == 右.执行轮次
        && 左.方法 == 右.方法 && 左.动作入口 == 右.动作入口
        && 左.场景 == 右.场景 && 左.主体 == 右.主体
        && 左.实际状态 == 右.实际状态 && 左.动态证据 == 右.动态证据
        && 左.来源材料版本 == 右.来源材料版本
        && 左.运行代次 == 右.运行代次
        && 生命周期相同(左.生命周期, 右.生命周期);
}

bool 当前实例读取成功(
    const L2按任务读取当前实例方法结果& 结果) noexcept {
    return 结果.结果头.状态 == L2结构状态::已读取
        && 结果.结果头.事实截止代次 != 0
        && !结果.结果头.变更事实代次;
}

bool 实际结果写入成功(
    const L2记录任务实际结果结果_v2& 结果) noexcept {
    return (结果.状态 == L2记录任务实际结果状态_v2::已形成
            || 结果.状态 == L2记录任务实际结果状态_v2::精确重复)
        && 结果.实际结果
        && L2任务实际结果事实完整(*结果.实际结果)
        && 结果.提交见证
        && L2任务实际结果提交见证有效(*结果.提交见证)
        && 结果.本次正式读回截止 != 0;
}

template <class 读回结果类型>
bool 独立读回成功(const 读回结果类型& 结果) noexcept {
    return 结果.状态 == 任务实际结果独立读回状态::已形成
        && 结果.快照.has_value();
}

任务结果上行形成结果 形成结果(
    任务结果上行形成状态 状态,
    std::uint64_t 正式执行轮次 = 0,
    std::uint64_t 事实截止G1 = 0,
    const L2实例方法事实* 实例方法 = nullptr,
    const L2任务实际结果事实* 正式结果 = nullptr) {
    任务结果上行形成结果 结果;
    结果.状态 = 状态;
    结果.正式执行轮次 = 正式执行轮次;
    结果.事实截止G1 = 事实截止G1;
    if (实例方法) 结果.实例方法 = *实例方法;
    if (正式结果) 结果.正式结果 = *正式结果;
    return 结果;
}

std::uint64_t 计算正式结果摘要内部(
    const L2任务实际结果事实& 结果,
    std::uint64_t G1) noexcept {
    std::uint64_t 摘要 = 1469598103934665603ULL;
    const auto 混合 = [&摘要](std::uint64_t 值) noexcept {
        摘要 ^= 值;
        摘要 *= 1099511628211ULL;
    };
    混合(结果.身份.值.值);
    混合(结果.任务.值.值);
    混合(结果.实例方法.值.值);
    混合(结果.执行轮次);
    混合(结果.方法.值.值);
    混合(结果.动作入口.值.值);
    混合(结果.场景.值.值);
    混合(结果.主体.值.值);
    混合(结果.实际状态.值.值);
    混合(结果.动态证据.值.值);
    混合(结果.来源材料版本);
    混合(结果.运行代次);
    混合(G1);
    return 摘要 == 0 ? 1 : 摘要;
}

任务结果上行形成结果 继续独立读回并形成治理消息(
    运行期只读查询组合器& 只读组合器,
    const 任务工作结果定位& 定位,
    const 任务动作权威结果快照& 快照,
    const 任务结果回执材料& 回执,
    const L2实例方法事实& 实例,
    const L2任务实际结果事实& 已发布结果,
    std::uint64_t G1,
    std::uint64_t 最大来源需求成员数) noexcept;

任务结果上行形成结果 形成回执并继续独立读回(
    运行期只读查询组合器& 只读组合器,
    const 任务工作结果定位& 定位,
    const 任务动作权威结果快照& 快照,
    const L2实例方法事实& 实例,
    const L2任务实际结果事实& 已发布结果,
    std::uint64_t G1,
    std::uint64_t 最大来源需求成员数) noexcept {
    if (快照.完成消息.运行代次 != 定位.运行代次)
        return 形成结果(
            任务结果上行形成状态::入口拒绝, 实例.执行轮次, 0, &实例);
    auto 已互证定位 = 定位;
    已互证定位.运行代次 = 快照.完成消息.运行代次;
    const auto 回执形成 = 形成任务结果回执(已互证定位, 快照);
    if (!回执形成.成功() || !回执形成.回执) {
        const auto 失败状态 =
            回执形成.状态 == 任务结果回执形成状态::内部错误
                ? 任务结果上行形成状态::内部错误
                : 任务结果上行形成状态::入口拒绝;
        return 形成结果(失败状态, 实例.执行轮次, 0, &实例);
    }
    return 继续独立读回并形成治理消息(
        只读组合器, 已互证定位, 快照, *回执形成.回执, 实例,
        已发布结果, G1, 最大来源需求成员数);
}

} // namespace 任务实际结果上行桥内部

任务实际结果上行桥::任务实际结果上行桥(
    L2需求结构服务& 需求服务,
    L2任务结构服务& 任务服务,
    L2状态结构服务& 状态服务,
    L2特征结构服务& 特征服务,
    L2存在结构服务& 存在服务,
    L2场景结构服务& 场景服务,
    L2动态结构服务& 动态服务) noexcept
    : 任务服务_(任务服务),
      只读组合器_(需求服务, 任务服务, 状态服务, 特征服务,
          存在服务, 场景服务, 动态服务) {
}

任务结果上行形成结果 任务实际结果上行桥::发布并形成治理消息_v2(
    const 任务工作结果定位& 定位,
    const 任务动作权威结果快照& 快照,
    std::uint64_t 最大来源需求成员数) noexcept {
    try {
        if (!任务工作结果定位有效(定位)
            || !任务动作权威结果快照有效(快照)
            || 最大来源需求成员数 == 0
            || 快照.完成消息.执行幂等身份 != 定位.执行幂等身份
            || 快照.完成消息.任务 != 定位.任务
            || 快照.完成消息.任务轮次 != 定位.任务轮次
            || 快照.完成消息.筹办轮次 != 定位.筹办轮次
            || 快照.完成消息.执行轮次 != 定位.执行轮次
            || 快照.完成消息.冻结 != 定位.冻结
            || 快照.完成消息.冻结版本 != 定位.冻结版本
            || 快照.完成消息.实例方法 != 定位.实例方法
            || 快照.完成消息.方法 != 定位.方法
            || 快照.完成消息.方法内容版本 != 定位.方法内容版本
            || 快照.完成消息.动作顺序 != 定位.最后动作顺序
            || 快照.完成消息.运行代次 != 定位.运行代次)
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::入口拒绝);

        const auto G0 = 快照.事实截止代次;
        L2按任务读取当前实例方法请求 实例请求;
        实例请求.请求头 = {L2结构合同版本, G0};
        实例请求.读取类别 = L2读取类别::当前;
        实例请求.任务 = 定位.任务;
        const auto 实例读取 = 任务服务_.按任务读取当前实例方法(实例请求);
        if (实例读取.结果头.事实截止代次 != G0)
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::当前性漂移);
        if (实例读取.结果头.状态 == L2结构状态::资源失败)
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::资源失败);
        if (!任务实际结果上行桥内部::当前实例读取成功(实例读取)
            || !实例读取.当前实例方法) {
            const auto 失败状态 =
                实例读取.结果头.状态 == L2结构状态::事实代次漂移
                    ? 任务结果上行形成状态::当前性漂移
                    : 任务结果上行形成状态::合法等待;
            return 任务实际结果上行桥内部::形成结果(失败状态);
        }
        const auto& 实例 = *实例读取.当前实例方法;
        if (实例.身份 != 定位.实例方法 || 实例.任务 != 定位.任务
            || 实例.来源方法 != 定位.方法 || 实例.执行轮次 == 0)
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::引用冲突);

        L2记录任务实际结果请求_v2 请求;
        请求.请求头 = {L2结构合同版本, G0};
        请求.幂等身份 = L2结构幂等身份{定位.执行幂等身份.值};
        请求.任务 = 定位.任务;
        请求.实例方法 = 定位.实例方法;
        请求.执行轮次 = 实例.执行轮次;
        请求.方法 = 定位.方法;
        请求.动作入口 = 快照.完成消息.动作入口;
        请求.场景 = 快照.场景.身份;
        请求.主体 = 快照.主体.身份;
        请求.实际状态 = 快照.实际状态.身份;
        请求.动态证据 = 快照.动态证据.身份;
        请求.来源材料版本 = 任务动作完成消息合同版本;
        请求.运行代次 = 快照.完成消息.运行代次;

        auto 写入 = 任务服务_.记录任务实际结果_v2(请求);
        if (写入.状态 == L2记录任务实际结果状态_v2::已可能发布)
            写入 = 任务服务_.记录任务实际结果_v2(请求);
        if (写入.状态 == L2记录任务实际结果状态_v2::幂等冲突
            || 写入.状态 == L2记录任务实际结果状态_v2::引用冲突)
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::引用冲突,
                实例.执行轮次, 0, &实例);
        if (写入.状态 == L2记录任务实际结果状态_v2::当前性漂移)
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::当前性漂移,
                实例.执行轮次, 0, &实例);
        if (写入.状态 == L2记录任务实际结果状态_v2::资源失败)
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::资源失败,
                实例.执行轮次, 0, &实例);
        if (!任务实际结果上行桥内部::实际结果写入成功(写入)
            || !写入.实际结果) {
            auto 失败状态 = 任务结果上行形成状态::内部错误;
            if (写入.状态 == L2记录任务实际结果状态_v2::已可能发布) {
                失败状态 = 任务结果上行形成状态::合法等待;
            } else if (写入.状态 == L2记录任务实际结果状态_v2::入口拒绝
                || 写入.状态 == L2记录任务实际结果状态_v2::许可拒绝) {
                失败状态 = 任务结果上行形成状态::入口拒绝;
            }
            return 任务实际结果上行桥内部::形成结果(
                失败状态, 实例.执行轮次, 0, &实例);
        }

        return 任务实际结果上行桥内部::形成回执并继续独立读回(
            只读组合器_, 定位, 快照, 实例, *写入.实际结果,
            写入.本次正式读回截止, 最大来源需求成员数);
    } catch (const std::bad_alloc&) {
        return 任务实际结果上行桥内部::形成结果(
            任务结果上行形成状态::资源失败);
    } catch (...) {
        return 任务实际结果上行桥内部::形成结果(
            任务结果上行形成状态::内部错误);
    }
}

namespace 任务实际结果上行桥内部 {

template <class 正式快照类型>
任务结果上行形成结果 从正式读回快照形成治理结果(
    const 正式快照类型& 正式快照,
    const L2实例方法事实& 实例,
    const L2任务实际结果事实& 已发布结果,
    std::uint64_t G1) {
    const auto& 正式结果 = 正式快照.结果;
    if (正式快照.事实截止代次 != G1
        || !任务实际结果事实相同(正式结果, 已发布结果)
        || !实例方法事实相同(正式快照.实例方法, 实例)) {
        return 形成结果(任务结果上行形成状态::内部错误,
            实例.执行轮次, G1, &实例, &正式结果);
    }
    return 形成结果(任务结果上行形成状态::已形成,
        实例.执行轮次, G1, &实例, &正式结果);
}

bool 尝试映射独立读回非成功状态(
    任务实际结果独立读回状态 来源,
    任务结果上行形成状态& 目标) noexcept {
    switch (来源) {
    case 任务实际结果独立读回状态::已形成:
        return false;
    case 任务实际结果独立读回状态::尚未形成:
        目标 = 任务结果上行形成状态::合法等待;
        return true;
    case 任务实际结果独立读回状态::请求拒绝:
        目标 = 任务结果上行形成状态::入口拒绝;
        return true;
    case 任务实际结果独立读回状态::轮次不匹配:
    case 任务实际结果独立读回状态::引用冲突:
        目标 = 任务结果上行形成状态::引用冲突;
        return true;
    case 任务实际结果独立读回状态::当前性漂移:
        目标 = 任务结果上行形成状态::当前性漂移;
        return true;
    case 任务实际结果独立读回状态::数量预算不足:
        目标 = 任务结果上行形成状态::数量预算不足;
        return true;
    case 任务实际结果独立读回状态::资源失败:
        目标 = 任务结果上行形成状态::资源失败;
        return true;
    case 任务实际结果独立读回状态::内部不一致:
    default:
        目标 = 任务结果上行形成状态::内部错误;
        return true;
    }
}

template <class 读回结果类型>
任务结果上行形成结果 处理独立读回结果(
    const 读回结果类型& 读回结果,
    const 任务结果回执材料& 回执,
    const L2实例方法事实& 实例,
    const L2任务实际结果事实& 已发布结果,
    std::uint64_t G1) {
    任务结果上行形成状态 映射状态{};
    if (尝试映射独立读回非成功状态(读回结果.状态, 映射状态)) {
        return 形成结果(映射状态,
            实例.执行轮次, G1, &实例, &已发布结果);
    }
    if (!独立读回成功(读回结果) || !读回结果.快照) {
        return 形成结果(任务结果上行形成状态::内部错误,
            实例.执行轮次, G1, &实例, &已发布结果);
    }
    return 从正式读回快照形成治理结果(
        *读回结果.快照, 实例, 已发布结果, G1);
}

任务结果上行形成结果 继续独立读回并形成治理消息(
    运行期只读查询组合器& 只读组合器,
    const 任务工作结果定位& 定位,
    const 任务动作权威结果快照& 快照,
    const 任务结果回执材料& 回执,
    const L2实例方法事实& 实例,
    const L2任务实际结果事实& 已发布结果,
    std::uint64_t G1,
    std::uint64_t 最大来源需求成员数) noexcept {
    try {
        if (G1 == 0 || 最大来源需求成员数 == 0
            || 实例.执行轮次 == 0
            || 已发布结果.实例方法 != 实例.身份
            || 已发布结果.执行轮次 != 实例.执行轮次
            || 已发布结果.任务 != 定位.任务
            || 已发布结果.方法 != 定位.方法
            || 已发布结果.动作入口 != 快照.完成消息.动作入口
            || 已发布结果.场景 != 快照.场景.身份
            || 已发布结果.主体 != 快照.主体.身份
            || 已发布结果.实际状态 != 快照.实际状态.身份
            || 已发布结果.动态证据 != 快照.动态证据.身份
            || 已发布结果.来源材料版本 != 任务动作完成消息合同版本
            || 已发布结果.运行代次 != 快照.完成消息.运行代次
            || 快照.完成消息.运行代次 != 定位.运行代次) {
            return 任务实际结果上行桥内部::形成结果(
                任务结果上行形成状态::入口拒绝);
        }

        任务实际结果独立读回请求 基础读回请求;
        基础读回请求.合同版本 = 运行期只读查询合同版本;
        基础读回请求.任务 = 定位.任务;
        基础读回请求.执行轮次 = 实例.执行轮次;
        基础读回请求.方法 = 定位.方法;
        基础读回请求.动作入口 = 快照.完成消息.动作入口;
        基础读回请求.场景 = 快照.场景.身份;
        基础读回请求.主体 = 快照.主体.身份;
        基础读回请求.实际状态 = 快照.实际状态.身份;
        基础读回请求.动态证据 = 快照.动态证据.身份;
        基础读回请求.来源材料版本 = 任务动作完成消息合同版本;
        基础读回请求.运行代次 = 快照.完成消息.运行代次;
        基础读回请求.共享事实截止G0 = G1;
        基础读回请求.最大需求成员数 = 最大来源需求成员数;
        const auto 读回结果 =
            只读组合器.读取任务本轮实际结果与独立读回_v2({
                任务实际结果独立读回合同版本_v2, 基础读回请求});
        return 处理独立读回结果(
            读回结果, 回执, 实例, 已发布结果, G1);
    } catch (const std::bad_alloc&) {
        return 任务实际结果上行桥内部::形成结果(
            任务结果上行形成状态::资源失败,
            实例.执行轮次, G1, &实例, &已发布结果);
    } catch (...) {
        return 任务实际结果上行桥内部::形成结果(
            任务结果上行形成状态::内部错误,
            实例.执行轮次, G1, &实例, &已发布结果);
    }
}

} // namespace 任务实际结果上行桥内部

任务结果上行形成结果 任务实际结果上行桥::继续独立读回并形成治理消息_v2(
    const 任务工作结果定位& 定位,
    const 任务动作权威结果快照& 快照,
    const 任务结果回执材料& 回执,
    const L2实例方法事实& 实例,
    const L2任务实际结果事实& 已发布结果,
    std::uint64_t G1,
    std::uint64_t 最大来源需求成员数) noexcept {
    return 任务实际结果上行桥内部::继续独立读回并形成治理消息(
        只读组合器_, 定位, 快照, 回执, 实例, 已发布结果,
        G1, 最大来源需求成员数);
}

std::uint64_t 任务实际结果上行桥::计算正式结果摘要(
    const L2任务实际结果事实& 结果,
    std::uint64_t G1) noexcept {
    return 任务实际结果上行桥内部::计算正式结果摘要内部(结果, G1);
}

} // namespace 海中鱼巣
