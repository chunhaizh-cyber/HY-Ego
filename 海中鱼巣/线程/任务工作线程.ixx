// 文件规则：任务工作线程串行消费已形成任务结果和筹办工作包；每个筹办工作包只调用一次 provider，并在同一结果消息获确认前不得越过后项。
module;

#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <deque>
#include <mutex>
#include <optional>
#include <thread>
#include <utility>
#include <variant>

export module 海中鱼巣.线程.任务工作线程;

import 海中鱼巣.线程.任务结果回执协议;
import 海中鱼巣.线程.任务管理线程;
import 海中鱼巣.线程.协议.任务筹办工作与结果;
import 海中鱼巣.领域.内部治理.服务.任务筹办当前就绪与执行冻结;

export namespace 海中鱼巣 {

enum class 任务工作线程状态 : std::uint8_t {
    未启动 = 1,
    运行中 = 2,
    正在排空 = 3,
    已停止 = 4,
    内部错误 = 5
};

enum class 任务工作线程提交状态 : std::uint8_t {
    已接收 = 1,
    已拒绝 = 2,
    资源等待 = 3
};

struct 任务工作线程操作结果 final {
    bool 成功 = false;
    任务工作线程状态 状态 = 任务工作线程状态::未启动;
};

struct 任务工作线程提交结果 final {
    任务工作线程提交状态 状态 = 任务工作线程提交状态::已拒绝;
    std::uint64_t 待处理数量 = 0;
    bool 成功() const noexcept {
        return 状态 == 任务工作线程提交状态::已接收;
    }
};

struct 任务工作线程快照 final {
    任务工作线程状态 状态 = 任务工作线程状态::未启动;
    std::uint64_t 队列容量 = 0;
    std::uint64_t 待处理数量 = 0;
    std::uint64_t 已接收数量 = 0;
    std::uint64_t 已形成回执数量 = 0;
    std::uint64_t 已上交数量 = 0;
    std::uint64_t 已拒绝数量 = 0;
    std::uint64_t 已消费筹办工作包数量 = 0;
    std::uint64_t 筹办提供者调用数量 = 0;
    std::uint64_t 已确认筹办结果数量 = 0;
    std::optional<任务筹办工作包消息> 当前处理中工作包;
    std::optional<任务筹办结果消息> 待上交筹办结果;
    std::optional<任务结果回执形成结果> 最后形成结果;
    std::optional<任务结果回执提交结果> 最后上交结果;
    std::optional<任务筹办提交结果> 最后筹办上交结果;
};

using 任务工作线程队列项 = std::variant<
    任务工作结果材料,
    任务筹办工作包消息>;

class 任务工作线程 final : public 任务筹办工作包提交端口 {
public:
    任务工作线程(
        std::uint64_t 统一工作队列容量,
        任务管理线程& 任务结果上行目标,
        任务筹办结果提交端口& 筹办结果上行目标,
        任务筹办当前就绪与执行冻结提供者& 筹办提供者) noexcept
        : 工作队列容量_(统一工作队列容量),
          任务结果上行目标_(任务结果上行目标),
          筹办结果上行目标_(筹办结果上行目标),
          筹办提供者_(筹办提供者) {
    }

    ~任务工作线程() noexcept {
        (void)停止接收并排空();
        (void)收口等待();
    }

    任务工作线程(const 任务工作线程&) = delete;
    任务工作线程& operator=(const 任务工作线程&) = delete;
    任务工作线程(任务工作线程&&) = delete;
    任务工作线程& operator=(任务工作线程&&) = delete;

    任务工作线程操作结果 启动() noexcept {
        std::lock_guard<std::mutex> 锁(锁_);
        if (状态_ != 任务工作线程状态::未启动 || 工作队列容量_ == 0)
            return {false, 状态_};
        try {
            状态_ = 任务工作线程状态::运行中;
            停止接收_ = false;
            线程_ = std::thread([this]() noexcept { 运行工作循环(); });
            return {true, 状态_};
        } catch (...) {
            状态_ = 任务工作线程状态::内部错误;
            return {false, 状态_};
        }
    }

    任务工作线程提交结果 提交已形成任务工作结果(
        const 任务工作结果材料& 材料) noexcept {
        try {
            std::lock_guard<std::mutex> 锁(锁_);
            if (状态_ != 任务工作线程状态::运行中 || 停止接收_)
                return {任务工作线程提交状态::已拒绝,
                    static_cast<std::uint64_t>(待处理_.size())};
            if (待处理_.size() >= 工作队列容量_)
                return {任务工作线程提交状态::资源等待,
                    static_cast<std::uint64_t>(待处理_.size())};
            待处理_.emplace_back(材料);
            ++已接收数量_;
            条件_.notify_one();
            return {任务工作线程提交状态::已接收,
                static_cast<std::uint64_t>(待处理_.size())};
        } catch (...) {
            return {任务工作线程提交状态::已拒绝, 0};
        }
    }

    任务筹办提交结果 提交任务筹办工作包(
        const 任务筹办工作包消息& 工作包) noexcept override {
        if (!任务筹办工作包消息完整(工作包))
            return {任务筹办提交状态::已拒绝,
                任务筹办提交拒绝原因::协议拒绝};
        try {
            std::lock_guard<std::mutex> 锁(锁_);
            if (状态_ != 任务工作线程状态::运行中 || 停止接收_)
                return {任务筹办提交状态::已拒绝,
                    停止接收_ ? 任务筹办提交拒绝原因::已停止
                                : 任务筹办提交拒绝原因::端口未运行};
            for (const auto& 项 : 待处理_) {
                const auto* 既有 = std::get_if<任务筹办工作包消息>(&项);
                if (!既有 || 既有->工作包身份 != 工作包.工作包身份) continue;
                return *既有 == 工作包
                    ? 任务筹办提交结果{任务筹办提交状态::精确重复,
                        任务筹办提交拒绝原因::无}
                    : 任务筹办提交结果{任务筹办提交状态::已拒绝,
                        任务筹办提交拒绝原因::幂等冲突};
            }
            if (当前处理中工作包_
                && 当前处理中工作包_->工作包身份 == 工作包.工作包身份) {
                return *当前处理中工作包_ == 工作包
                    ? 任务筹办提交结果{任务筹办提交状态::精确重复,
                        任务筹办提交拒绝原因::无}
                    : 任务筹办提交结果{任务筹办提交状态::已拒绝,
                        任务筹办提交拒绝原因::幂等冲突};
            }
            if (待处理_.size() >= 工作队列容量_)
                return {任务筹办提交状态::资源等待,
                    任务筹办提交拒绝原因::队列已满};
            待处理_.emplace_back(工作包);
            ++已接收数量_;
            条件_.notify_one();
            return {任务筹办提交状态::已接收,
                任务筹办提交拒绝原因::无};
        } catch (...) {
            return {任务筹办提交状态::内部错误,
                任务筹办提交拒绝原因::内部状态冲突};
        }
    }

    任务工作线程操作结果 停止接收并排空() noexcept {
        std::lock_guard<std::mutex> 锁(锁_);
        if (状态_ == 任务工作线程状态::未启动
            || 状态_ == 任务工作线程状态::已停止)
            return {状态_ == 任务工作线程状态::已停止, 状态_};
        停止接收_ = true;
        if (状态_ != 任务工作线程状态::内部错误)
            状态_ = 任务工作线程状态::正在排空;
        条件_.notify_all();
        return {状态_ == 任务工作线程状态::正在排空, 状态_};
    }

    任务工作线程操作结果 收口等待() noexcept {
        if (线程_.joinable()) 线程_.join();
        std::lock_guard<std::mutex> 锁(锁_);
        if (状态_ != 任务工作线程状态::内部错误)
            状态_ = 任务工作线程状态::已停止;
        return {状态_ == 任务工作线程状态::已停止, 状态_};
    }

    任务工作线程快照 读取快照() const noexcept {
        try {
            std::lock_guard<std::mutex> 锁(锁_);
            任务工作线程快照 快照;
            快照.状态 = 状态_;
            快照.队列容量 = 工作队列容量_;
            快照.待处理数量 = static_cast<std::uint64_t>(待处理_.size());
            快照.已接收数量 = 已接收数量_;
            快照.已形成回执数量 = 已形成回执数量_;
            快照.已上交数量 = 已上交数量_;
            快照.已拒绝数量 = 已拒绝数量_;
            快照.已消费筹办工作包数量 = 已消费筹办工作包数量_;
            快照.筹办提供者调用数量 = 筹办提供者调用数量_;
            快照.已确认筹办结果数量 = 已确认筹办结果数量_;
            快照.当前处理中工作包 = 当前处理中工作包_;
            快照.待上交筹办结果 = 待上交筹办结果_;
            快照.最后形成结果 = 最后形成结果_;
            快照.最后上交结果 = 最后上交结果_;
            快照.最后筹办上交结果 = 最后筹办上交结果_;
            return 快照;
        } catch (...) {
            任务工作线程快照 快照;
            快照.状态 = 任务工作线程状态::内部错误;
            return 快照;
        }
    }

private:
    static 任务筹办结果消息 形成筹办结果消息(
        const 任务筹办工作包消息& 工作包,
        const 任务筹办推进结果& 结果) noexcept {
        任务筹办结果消息 消息;
        消息.消息身份 = {工作包.工作包身份.值};
        消息.来源工作包身份 = 工作包.工作包身份;
        消息.任务 = 工作包.任务;
        消息.任务轮次 = 工作包.任务轮次;
        消息.筹办轮次 = 工作包.筹办轮次;
        消息.来源事实截止G0 = 工作包.来源事实截止G0;
        消息.结果事实截止G1 = 结果.最终事实截止 != 0
            ? 结果.最终事实截止 : 工作包.来源事实截止G0;
        if (结果.完整()) {
            消息.分支 = 结果.类别;
            消息.载荷 = 结果.载荷;
        } else {
            消息.分支 = 任务筹办结果分支::结构化非成功;
            消息.载荷 = 任务筹办结构化非成功材料{
                任务筹办非成功类别::内部错误, 消息.结果事实截止G1};
        }
        return 消息;
    }

    void 处理任务结果(const 任务工作结果材料& 材料) noexcept {
        const auto 形成 = 形成任务结果回执(材料);
        std::optional<任务结果回执提交结果> 上交;
        if (形成.成功())
            上交 = 任务结果上行目标_.提交任务结果回执(
                *形成.回执, 材料.发生时间戳);
        std::lock_guard<std::mutex> 锁(锁_);
        最后形成结果_ = 形成;
        if (形成.成功()) ++已形成回执数量_;
        if (上交) {
            最后上交结果_ = *上交;
            if (上交->成功()) ++已上交数量_;
            else ++已拒绝数量_;
        } else {
            ++已拒绝数量_;
        }
    }

    bool 处理筹办工作包(const 任务筹办工作包消息& 工作包) noexcept {
        {
            std::lock_guard<std::mutex> 锁(锁_);
            当前处理中工作包_ = 工作包;
            ++已消费筹办工作包数量_;
            ++筹办提供者调用数量_;
        }
        const auto 提供者结果 = 筹办提供者_.推进下一筹办工作包(工作包.请求);
        const auto 消息 = 形成筹办结果消息(工作包, 提供者结果);
        {
            std::lock_guard<std::mutex> 锁(锁_);
            待上交筹办结果_ = 消息;
            当前处理中工作包_.reset();
            if (!任务筹办结果消息匹配工作包(消息, 工作包)) {
                ++已拒绝数量_;
                状态_ = 任务工作线程状态::内部错误;
                return false;
            }
        }
        for (;;) {
            const auto 提交 = 筹办结果上行目标_.提交任务筹办结果(消息);
            {
                std::lock_guard<std::mutex> 锁(锁_);
                最后筹办上交结果_ = 提交;
                if (提交.成功()) {
                    ++已确认筹办结果数量_;
                    待上交筹办结果_.reset();
                    return true;
                }
                if (提交.状态 != 任务筹办提交状态::资源等待
                    || 提交.拒绝原因 != 任务筹办提交拒绝原因::队列已满) {
                    ++已拒绝数量_;
                    状态_ = 任务工作线程状态::内部错误;
                    return false;
                }
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(1));
        }
    }

    void 运行工作循环() noexcept {
        for (;;) {
            任务工作线程队列项 项;
            {
                std::unique_lock<std::mutex> 锁(锁_);
                条件_.wait(锁, [this]() noexcept {
                    return 停止接收_ || !待处理_.empty();
                });
                if (待处理_.empty()) {
                    if (停止接收_) break;
                    continue;
                }
                项 = std::move(待处理_.front());
                待处理_.pop_front();
            }
            if (const auto* 材料 = std::get_if<任务工作结果材料>(&项))
                处理任务结果(*材料);
            else if (!处理筹办工作包(std::get<任务筹办工作包消息>(项)))
                break;
        }
    }

    std::uint64_t 工作队列容量_ = 0;
    任务管理线程& 任务结果上行目标_;
    任务筹办结果提交端口& 筹办结果上行目标_;
    任务筹办当前就绪与执行冻结提供者& 筹办提供者_;
    mutable std::mutex 锁_;
    std::condition_variable 条件_;
    std::deque<任务工作线程队列项> 待处理_;
    任务工作线程状态 状态_ = 任务工作线程状态::未启动;
    bool 停止接收_ = false;
    std::uint64_t 已接收数量_ = 0;
    std::uint64_t 已形成回执数量_ = 0;
    std::uint64_t 已上交数量_ = 0;
    std::uint64_t 已拒绝数量_ = 0;
    std::uint64_t 已消费筹办工作包数量_ = 0;
    std::uint64_t 筹办提供者调用数量_ = 0;
    std::uint64_t 已确认筹办结果数量_ = 0;
    std::optional<任务筹办工作包消息> 当前处理中工作包_;
    std::optional<任务筹办结果消息> 待上交筹办结果_;
    std::optional<任务结果回执形成结果> 最后形成结果_;
    std::optional<任务结果回执提交结果> 最后上交结果_;
    std::optional<任务筹办提交结果> 最后筹办上交结果_;
    std::thread 线程_;
};

} // namespace 海中鱼巣
