export module 海中鱼巣.装配.普通应用;

import 海中鱼巣.领域.初始化.世界树;
import 海中鱼巣.领域.初始化.语素;
import 海中鱼巣.领域.初始化.需求;
import 海中鱼巣.领域.初始化.概念图;
import 海中鱼巣.线程.自我线程;

export namespace 海中鱼巣 {

struct 普通应用配置 {
    std::uint64_t 方法登记根稳定键 = 0x4D45'5448'0000'0001ULL;
    自我根需求初始化参数 根需求参数{
        0x0001'0001'0000'0001ULL,
        0x0001'0001'0000'0002ULL,
        1, 10, 1, 10
    };
    bool 启用数据库审计 = true;

    bool 有效() const noexcept {
        return 方法登记根稳定键 != 0 && 根需求参数.有效();
    }
};

class 普通应用上下文 {
public:
    普通应用上下文()
        : 节点(主信息),
          关系(节点),
          索引(节点),
          存在(主信息, 节点, 关系),
          场景(主信息, 节点, 关系),
          状态(主信息, 节点, 关系),
          动态(主信息, 节点, 关系),
          二次特征(主信息, 节点, 关系),
          语素(主信息, 节点, 关系, 索引),
          特征值(主信息, 节点),
          因果(主信息, 节点),
          概念图(节点, 关系),
          概念图初始化(概念图, 存在, 动态, 二次特征, 因果, 状态, 语素),
          特征(主信息, 节点, 关系, 二次特征, 特征值),
          世界(主信息, 节点, 存在, 场景),
          世界树初始化(主信息, 节点, 关系, 世界, 场景, 存在),
          语素初始化(主信息, 节点, 关系, 世界, 语素),
          需求(主信息, 节点, 关系),
          需求初始化(特征, 语素, 需求, 状态),
          自我线程实例(语素初始化, 世界树初始化, 需求初始化),
          任务(主信息, 节点, 关系),
          方法(主信息, 节点, 关系),
          数据库(SQL数据库适配::从环境创建配置()) {
    }

    普通应用上下文(const 普通应用上下文&) = delete;
    普通应用上下文& operator=(const 普通应用上下文&) = delete;
    普通应用上下文(普通应用上下文&&) = delete;
    普通应用上下文& operator=(普通应用上下文&&) = delete;

    主信息仓库 主信息;
    节点仓库 节点;
    关系仓库 关系;
    索引仓库 索引;
    存在服务 存在;
    场景服务 场景;
    状态服务 状态;
    动态服务 动态;
    二次特征服务 二次特征;
    语素服务 语素;
    特征值服务 特征值;
    因果服务 因果;
    概念图服务 概念图;
    概念图初始化服务 概念图初始化;
    特征服务 特征;
    世界服务 世界;
    世界树初始化服务 世界树初始化;
    语素初始化服务 语素初始化;
    需求服务 需求;
    需求初始化服务 需求初始化;
    自我线程 自我线程实例;
    任务服务 任务;
    方法服务 方法;
    统计服务 统计;
    显示服务 显示;
    SQL数据库适配 数据库;
};

enum class 普通应用装配状态 : std::uint8_t {
    已装配 = 0,
    配置无效 = 1,
    构造失败 = 2
};

struct 普通应用装配结果 {
    普通应用装配状态 状态 = 普通应用装配状态::配置无效;
    std::unique_ptr<普通应用上下文> 上下文;

    bool 成功() const noexcept {
        return 状态 == 普通应用装配状态::已装配 && 上下文 != nullptr;
    }
};

普通应用装配结果 构造普通应用上下文(const 普通应用配置& 配置) {
    if (!配置.有效()) {
        return {};
    }
    try {
        return {普通应用装配状态::已装配, std::make_unique<普通应用上下文>()};
    } catch (...) {
        return {普通应用装配状态::构造失败, nullptr};
    }
}

}
