        }
        auto 场景原始交付 = 运行包.所有者范围签发器().建立所有者范围(
            {L1所有者范围CRUD合同版本, 场景所有者建立身份,
                L1所有者范围种类::独占结构范围});
        if ((场景原始交付.建立结果.状态 != L1所有者范围管理状态::成功
                && 场景原始交付.建立结果.状态
                    != L1所有者范围管理状态::精确重复)
            || !场景原始交付.建立结果.所有者事实 || !场景原始交付.写入端口)
            return {普通应用装配状态::场景所有者范围建立失败, nullptr};
        auto 场景交付 = 尝试形成L2场景所有者交付(
            运行包.读取服务(), std::move(场景原始交付));
        if (!场景交付)
            return {普通应用装配状态::场景所有者交付形成失败, nullptr};
        std::unique_ptr<L2场景结构服务> 场景服务;
        try {
            场景服务 = std::make_unique<L2场景结构服务>(
                运行包.读取服务(), *存在服务, std::move(*场景交付));
        } catch (...) {
            return {普通应用装配状态::场景服务构造失败, nullptr};
        }
        std::unique_ptr<L2结构聚合服务> 聚合服务;
        try {
            聚合服务 = std::make_unique<L2结构聚合服务>(
                *场景服务, *存在服务, *特征服务,
                *状态服务, *动态服务, *因果服务);
        } catch (...) {
            return {普通应用装配状态::L2结构聚合服务构造失败, nullptr};
        }
        std::optional<L1所有者范围交付> 概念原始交付;
        try {
            概念原始交付.emplace(
                运行包.所有者范围签发器().建立所有者范围(
                    {L1所有者范围CRUD合同版本, 概念所有者建立身份,
                        L1所有者范围种类::独占结构范围}));
        } catch (...) {
            return {普通应用装配状态::概念所有者范围建立失败, nullptr};
        }
        if ((概念原始交付->建立结果.状态 != L1所有者范围管理状态::成功
                && 概念原始交付->建立结果.状态
                    != L1所有者范围管理状态::精确重复)
            || !概念原始交付->建立结果.所有者事实
            || !概念原始交付->写入端口)
            return {普通应用装配状态::概念所有者范围建立失败, nullptr};
        auto 概念所有者交付 = 尝试形成L2概念所有者交付(
            运行包.读取服务(), std::move(*概念原始交付));
        if (!概念所有者交付)
            return {普通应用装配状态::概念所有者交付形成失败, nullptr};
        std::unique_ptr<L2概念结构服务> 概念服务;
        try {
            概念服务 = std::make_unique<L2概念结构服务>(
                运行包.读取服务(), *材料服务, *场景服务, *存在服务,
                *特征服务, *状态服务, *动态服务, *因果服务,
                std::move(*概念所有者交付));
        } catch (...) {
            return {普通应用装配状态::概念服务构造失败, nullptr};
        }
        std::unique_ptr<L2概念结构聚合服务> 概念聚合服务;
        try {
            概念聚合服务 =
                std::make_unique<L2概念结构聚合服务>(*概念服务);
        } catch (...) {
            return {普通应用装配状态::L2概念结构聚合服务构造失败, nullptr};
        }
        std::optional<L1所有者范围交付> 名称原始交付;
        try {
            名称原始交付.emplace(
                运行包.所有者范围签发器().建立所有者范围(
                    {L1所有者范围CRUD合同版本, 概念名称所有者建立身份,
                        L1所有者范围种类::独占结构范围}));
        } catch (...) {
            return {普通应用装配状态::概念名称所有者范围建立失败, nullptr};
        }
        if ((名称原始交付->建立结果.状态 != L1所有者范围管理状态::成功
                && 名称原始交付->建立结果.状态
                    != L1所有者范围管理状态::精确重复)
            || !名称原始交付->建立结果.所有者事实
            || !名称原始交付->写入端口)
            return {普通应用装配状态::概念名称所有者范围建立失败, nullptr};
        auto 名称所有者交付 = 尝试形成L2概念名称所有者交付(
            运行包.读取服务(), std::move(*名称原始交付));
        if (!名称所有者交付)
            return {普通应用装配状态::概念名称所有者交付形成失败, nullptr};
        std::unique_ptr<L2概念名称结构服务> 概念名称服务;
        try {
            概念名称服务 = std::make_unique<L2概念名称结构服务>(
                运行包.读取服务(), *概念服务, *语言服务,
                std::move(*名称所有者交付));
        } catch (...) {
            return {普通应用装配状态::概念名称服务构造失败, nullptr};
        }
        std::optional<L1所有者范围交付> 方法原始交付;
        try {
            方法原始交付.emplace(
                运行包.所有者范围签发器().建立所有者范围(
                    {L1所有者范围CRUD合同版本, 方法所有者建立身份,
                        L1所有者范围种类::独占结构范围}));
        } catch (...) {
            return {普通应用装配状态::方法所有者范围建立失败, nullptr};
        }
        if ((方法原始交付->建立结果.状态 != L1所有者范围管理状态::成功
                && 方法原始交付->建立结果.状态
                    != L1所有者范围管理状态::精确重复)
            || !方法原始交付->建立结果.所有者事实
            || !方法原始交付->写入端口)
            return {普通应用装配状态::方法所有者范围建立失败, nullptr};
        auto 方法所有者交付 = 尝试形成L2方法所有者交付(
            运行包.读取服务(), std::move(*方法原始交付));
        if (!方法所有者交付)
            return {普通应用装配状态::方法所有者交付形成失败, nullptr};
        std::unique_ptr<L2方法结构服务> 方法服务;
        try {
            方法服务 = std::make_unique<L2方法结构服务>(
                运行包.读取服务(), *场景服务, *特征服务, *状态服务,
                std::move(*方法所有者交付));
        } catch (...) {
            return {普通应用装配状态::方法服务构造失败, nullptr};
        }
        std::unique_ptr<L2方法结构聚合服务> 方法聚合服务;
        try {
            方法聚合服务 =
                std::make_unique<L2方法结构聚合服务>(*方法服务);
        } catch (...) {
            return {普通应用装配状态::L2方法结构聚合服务构造失败, nullptr};
        }
        return {普通应用装配状态::已装配,
            std::unique_ptr<普通应用上下文>(new 普通应用上下文(
                std::move(运行包), std::move(材料服务),
                std::move(语言服务), std::move(存在服务),
                std::move(特征服务), std::move(状态服务), std::move(动态服务),
                std::move(因果服务), std::move(场景服务), std::move(聚合服务),
                std::move(概念服务), std::move(概念聚合服务),
                std::move(概念名称服务),
                std::move(方法服务), std::move(方法聚合服务)))};
    } catch (...) {
        return {普通应用装配状态::构造失败, nullptr};
    }
}


bool 系统世界树根初始化结果::成功() const noexcept {
    if (!来源 || !根读回前登记读取 || !根读取 || !已发布根
        || !根读回前登记读取->成功() || !根读取->成功() || !根读取->树
        || !L2场景树事实完整(已发布根->正式树读回)
        || 已发布根->选择.合同版本 != 系统世界树根初始化合同版本
        || 已发布根->选择.根建立幂等身份
            != 海中鱼巣现实世界树根建立幂等身份
        || !L2场景树根建立请求有效(已发布根->首次建立请求)
        || 已发布根->首次建立请求.幂等身份
            != 已发布根->选择.根建立幂等身份
        || 已发布根->树.值 != 已发布根->根场景.值
        || !系统世界树根初始化内部::场景树事实相同(
            已发布根->正式树读回, *根读取->树)
        || 已发布根->事实截止代次 != 根读取->结果头.事实截止代次
        || 已发布根->事实截止代次 != 已发布根->正式树读回.事实截止代次)
        return false;
    const bool 首次 = 状态 == 系统世界树根初始化状态::已发布
        && *来源 == 系统世界树根发布来源::首次建立
        && 根建立前登记读取 && 根建立前登记读取->成功()
        && 根建立 && 根建立->成功()
        && 根建立->结果头.状态 == L2结构状态::已提交;
    const bool 收敛 = 状态 == 系统世界树根初始化状态::精确重复
        && *来源 == 系统世界树根发布来源::待收敛精确重复
        && !根建立前登记读取 && 根建立 && 根建立->成功()
        && 根建立->结果头.状态 == L2结构状态::精确重复;
    const bool 重复 = 状态 == 系统世界树根初始化状态::精确重复
        && *来源 == 系统世界树根发布来源::已发布重复消费
        && !根建立前登记读取 && !根建立;
    return 首次 || 收敛 || 重复;
}

系统世界树根初始化结果 初始化并发布系统世界树根(
    普通应用上下文& 上下文,
    const 系统世界树根初始化请求& 请求) noexcept {
    auto& 场景服务 =
        上下文.取得L2结构聚合服务().取得L2场景结构服务();
    return 系统世界树根初始化内部::编排系统世界树根初始化(
        上下文.系统世界树根发布锁_, 上下文.待收敛系统世界树根请求_,
        上下文.系统世界树根读回_, 请求, 场景服务);
}

bool 自我世界树根消费结果::成功() const noexcept {
    if (!来源 || !结构登记读取 || !根读取 || !已发布材料
        || !结构登记读取->成功() || !结构登记读取->登记
        || !根读取->成功() || !根读取->树
        || !自我世界树根消费内部::请求有效(已发布材料->请求)
        || !自我世界树根消费内部::读回一致(
            已发布材料->请求, *结构登记读取, *根读取)
        || 已发布材料->当前结构登记 != *结构登记读取->登记
        || 已发布材料->正式树读回 != *根读取->树
        || 已发布材料->本次事实截止代次
            != 结构登记读取->结果头.事实截止代次)
        return false;
    return (状态 == 自我世界树根消费状态::已发布
            && *来源 == 自我世界树根消费来源::首次消费)
        || (状态 == 自我世界树根消费状态::精确重复
            && *来源 == 自我世界树根消费来源::已发布重复消费);
}

自我世界树根消费结果 消费并发布自我世界树根(
    普通应用上下文& 上下文,
    const 自我世界树根消费请求& 请求) noexcept {
    auto 取得场景服务 = [&上下文]() noexcept -> L2场景结构服务& {
        return 上下文.取得L2结构聚合服务().取得L2场景结构服务();
    };
    return 自我世界树根消费内部::编排自我世界树根消费(
        上下文.自我世界树根消费发布锁_,
        上下文.自我世界树根消费材料_, 请求, 取得场景服务);
}

std::optional<自我世界树根消费材料>
读取自我世界树根消费材料(const 普通应用上下文& 上下文) {
    std::lock_guard<std::mutex> 锁(上下文.自我世界树根消费发布锁_);
    return 上下文.自我世界树根消费材料_;
}

}
