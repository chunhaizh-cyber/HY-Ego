        }
        auto 动态原始交付 = 运行包.所有者范围签发器().建立所有者范围(
            {L1所有者范围CRUD合同版本, 动态所有者建立身份,
                L1所有者范围种类::独占结构范围});
        if ((动态原始交付.建立结果.状态 != L1所有者范围管理状态::成功
                && 动态原始交付.建立结果.状态
                    != L1所有者范围管理状态::精确重复)
            || !动态原始交付.建立结果.所有者事实 || !动态原始交付.写入端口)
            return {普通应用装配状态::动态所有者范围建立失败, nullptr};
        auto 动态交付 = 尝试形成L2动态所有者交付(
