namespace 海中鱼巣::四本体根生产初始化内部 {

inline bool 请求有效(const 四本体根生产初始化请求 &请求) noexcept {
  const L2结构幂等身份 身份组[]{请求.存在根幂等身份, 请求.特征根幂等身份,
                                请求.动态根幂等身份, 请求.因果链根幂等身份};
  if (请求.合同版本 != 四本体根生产初始化合同版本)
    return false;
  for (const auto 身份 : 身份组)
    if (!L2结构幂等身份有效(身份))
      return false;
  for (std::size_t 左 = 0; 左 < std::size(身份组); ++左)
    for (std::size_t 右 = 左 + 1; 右 < std::size(身份组); ++右)
      if (身份组[左] == 身份组[右])
        return false;
  return true;
}

inline L2结构幂等身份 取得角色幂等身份(const 四本体根生产初始化请求 &请求,
                                       L2概念本体根角色 角色) noexcept {
  switch (角色) {
  case L2概念本体根角色::存在:
    return 请求.存在根幂等身份;
  case L2概念本体根角色::特征:
    return 请求.特征根幂等身份;
  case L2概念本体根角色::动态:
    return 请求.动态根幂等身份;
  case L2概念本体根角色::因果链:
    return 请求.因果链根幂等身份;
  default:
    return {};
  }
}

inline bool 根组形状完整(const L2当前概念本体根组读取结果 &结果) noexcept {
  if (!结果.成功() || 结果.结果头.状态 != L2结构状态::已读取 ||
      结果.结果头.事实截止代次 == 0 || 结果.结果头.变更事实代次 ||
      结果.本体根.size() > 4)
    return false;
  for (std::size_t 索引 = 0; 索引 < 结果.本体根.size(); ++索引) {
    const auto &根 = 结果.本体根[索引];
    if (!L2概念本体根事实完整(根, 结果.结果头.事实截止代次))
      return false;
    if (索引 != 0) {
      const auto &前根 = 结果.本体根[索引 - 1];
      if (static_cast<std::uint8_t>(前根.根角色.角色) >=
          static_cast<std::uint8_t>(根.根角色.角色))
        return false;
    }
    for (std::size_t 其它 = 0; 其它 < 索引; ++其它)
      if (结果.本体根[其它].根概念 == 根.根概念)
        return false;
  }
  return true;
}

inline const L2概念本体根事实 *
查找角色根(const L2当前概念本体根组读取结果 &结果,
           L2概念本体根角色 角色) noexcept {
  for (const auto &根 : 结果.本体根)
    if (根.根角色.角色 == 角色)
      return &根;
  return nullptr;
}

inline bool 单根读取形状完整(const L2当前概念本体根读取结果 &结果,
                             L2概念本体根角色 角色, L2结构幂等身份 首次幂等身份,
                             std::uint64_t 期望事实截止代次) noexcept {
  return 结果.成功() && 结果.结果头.状态 == L2结构状态::已读取 &&
         期望事实截止代次 != 0 &&
         结果.结果头.事实截止代次 == 期望事实截止代次 &&
         !结果.结果头.变更事实代次 && 结果.本体根 &&
         结果.本体根->根角色.角色 == 角色 &&
         结果.本体根->首次幂等身份 == 首次幂等身份 &&
         L2概念本体根事实完整(*结果.本体根, 结果.结果头.事实截止代次);
}

template <class 根组读取证据>
inline bool
零代次根组读取调用形状完整(const 根组读取证据 &证据,
                           std::uint64_t 最低事实截止代次) noexcept {
  return 证据.请求.请求头.合同版本 == L2结构合同版本 &&
         证据.请求.请求头.期望事实代次 == 0 && 根组形状完整(证据.结果) &&
         证据.结果.结果头.事实截止代次 >= 最低事实截止代次;
}

inline bool
非零根组读取调用形状完整(const 四本体根组读取调用证据 &证据) noexcept {
  return 证据.请求.请求头.合同版本 == L2结构合同版本 &&
         证据.请求.请求头.期望事实代次 != 0 && 根组形状完整(证据.结果) &&
         证据.结果.结果头.事实截止代次 == 证据.请求.请求头.期望事实代次;
}

inline bool 单根读取调用形状完整(const 四本体根单根读取调用证据 &证据,
                                 L2概念本体根角色 角色,
                                 L2结构幂等身份 首次幂等身份) noexcept {
  return 证据.请求.请求头.合同版本 == L2结构合同版本 &&
         证据.请求.请求头.期望事实代次 != 0 && 证据.请求.角色 == 角色 &&
         单根读取形状完整(证据.结果, 角色, 首次幂等身份,
                          证据.请求.请求头.期望事实代次);
}

inline bool 建立调用请求匹配(const 四本体根建立调用证据 &证据,
                             L2概念本体根角色 角色,
                             L2结构幂等身份 幂等身份) noexcept {
  return L2概念本体根建立请求有效(证据.请求) &&
         证据.请求.请求头.期望事实代次 != 0 && 证据.请求.角色 == 角色 &&
         证据.请求.幂等身份 == 幂等身份;
}

inline bool 根写入形状完整(const 四本体根建立调用证据 &证据,
                           L2概念本体根角色 角色,
                           L2结构幂等身份 首次幂等身份) noexcept {
  const auto &结果 = 证据.结果;
  const auto 状态 = 结果.结果头.状态;
  return 建立调用请求匹配(证据, 角色, 首次幂等身份) && 结果.成功() &&
         (状态 == L2结构状态::已提交 || 状态 == L2结构状态::精确重复) &&
         结果.结果头.事实截止代次 > 证据.请求.请求头.期望事实代次 &&
         结果.结果头.变更事实代次 &&
         *结果.结果头.变更事实代次 == 结果.结果头.事实截止代次 && 结果.本体根 &&
         结果.本体根->根角色.角色 == 角色 &&
         结果.本体根->首次幂等身份 == 首次幂等身份 &&
         结果.本体根->首次期望事实代次 == 证据.请求.请求头.期望事实代次 &&
         L2概念本体根事实完整(*结果.本体根, 结果.结果头.事实截止代次);
}

inline bool 是可重组漂移(const 四本体根建立调用证据 &证据,
                         L2概念本体根角色 角色,
                         L2结构幂等身份 幂等身份) noexcept {
  const auto &结果 = 证据.结果;
  return 建立调用请求匹配(证据, 角色, 幂等身份) && !结果.成功() &&
         结果.结果头.状态 == L2结构状态::事实代次漂移 &&
         !结果.结果头.变更事实代次 && !结果.本体根;
}

inline bool
组读取非成功形状完整(const L2当前概念本体根组读取结果 &结果) noexcept {
  return !结果.成功() && !结果.结果头.变更事实代次 && 结果.本体根.empty();
}

inline bool
单根读取非成功形状完整(const L2当前概念本体根读取结果 &结果) noexcept {
  return !结果.成功() && !结果.结果头.变更事实代次 && !结果.本体根;
}

inline bool 建立非成功形状完整(const L2概念本体根写入结果 &结果) noexcept {
  return !结果.成功() && !结果.结果头.变更事实代次 && !结果.本体根;
}

inline 四本体根生产初始化状态
映射组读取失败(const L2当前概念本体根组读取结果 &结果,
               四本体根生产初始化状态 普通失败,
               bool 允许事实代次竞争) noexcept {
  if (!组读取非成功形状完整(结果))
    return 四本体根生产初始化状态::内部不一致;
  switch (结果.结果头.状态) {
  case L2结构状态::事实代次漂移:
    return 允许事实代次竞争 ? 四本体根生产初始化状态::事实代次竞争
                            : 四本体根生产初始化状态::内部不一致;
  case L2结构状态::资源失败:
    return 四本体根生产初始化状态::资源失败;
  case L2结构状态::入口拒绝:
  case L2结构状态::许可拒绝:
    return 普通失败;
  default:
    return 四本体根生产初始化状态::内部不一致;
  }
}

inline 四本体根生产初始化状态
映射单根读取失败(const L2当前概念本体根读取结果 &结果) noexcept {
  if (!单根读取非成功形状完整(结果))
    return 四本体根生产初始化状态::内部不一致;
  switch (结果.结果头.状态) {
  case L2结构状态::事实代次漂移:
    return 四本体根生产初始化状态::事实代次竞争;
  case L2结构状态::资源失败:
    return 四本体根生产初始化状态::资源失败;
  case L2结构状态::入口拒绝:
  case L2结构状态::许可拒绝:
    return 四本体根生产初始化状态::单根正式读回失败;
  default:
    return 四本体根生产初始化状态::内部不一致;
  }
}

inline 四本体根生产初始化状态
映射建立失败(const 四本体根建立调用证据 &证据, L2概念本体根角色 角色,
             L2结构幂等身份 幂等身份,
             四本体根生产初始化状态 角色形成失败) noexcept {
  if (!建立调用请求匹配(证据, 角色, 幂等身份) || !建立非成功形状完整(证据.结果))
    return 四本体根生产初始化状态::内部不一致;
  switch (证据.结果.结果头.状态) {
  case L2结构状态::入口拒绝:
  case L2结构状态::许可拒绝:
  case L2结构状态::幂等冲突:
  case L2结构状态::引用冲突:
    return 角色形成失败;
  case L2结构状态::资源失败:
    return 四本体根生产初始化状态::资源失败;
  default:
    return 四本体根生产初始化状态::内部不一致;
  }
}

template <class 概念服务>
bool 处理一个根(概念服务 &服务, const 四本体根生产初始化请求 &选择,
                L2概念本体根角色 角色, std::uint64_t &当前事实截止代次,
                L2当前概念本体根组读取结果 &当前根组,
                std::optional<L2概念本体根建立请求> &保存请求, bool &请求待重放,
                std::optional<L2概念本体根建立请求> &进入时待重放请求证据,
                std::vector<四本体根建立调用证据> &建立证据,
                std::optional<四本体根单根读取调用证据> &读取证据,
                std::vector<四本体根漂移重读证据> &漂移重读证据,
                L2概念本体根事实 &根候选, 四本体根生产初始化状态 角色形成失败,
                四本体根生产初始化状态 &失败状态) {
  const auto 幂等身份 = 取得角色幂等身份(选择, 角色);
  if (!L2结构幂等身份有效(幂等身份)) {
    失败状态 = 四本体根生产初始化状态::内部不一致;
    return false;
  }

  const L2概念本体根事实 *已有根 = 查找角色根(当前根组, 角色);
  if (请求待重放) {
    if (!保存请求) {
      失败状态 = 四本体根生产初始化状态::内部不一致;
      return false;
    }
    进入时待重放请求证据 = *保存请求;
  }
  bool 本次已重组 = false;
  if (!已有根 || 请求待重放) {
    if (!保存请求)
      保存请求 = L2概念本体根建立请求{
          {L2结构合同版本, 当前事实截止代次}, 幂等身份, 角色};
    if (!L2概念本体根建立请求有效(*保存请求) ||
        保存请求->幂等身份 != 幂等身份 || 保存请求->角色 != 角色) {
      失败状态 = 四本体根生产初始化状态::内部不一致;
      return false;
    }

    for (;;) {
      const auto 本次请求 = *保存请求;
      请求待重放 = true;
      auto 本次结果 = 服务.建立概念本体根(本次请求);
      建立证据.push_back({本次请求, std::move(本次结果)});
      const auto &本次建立 = 建立证据.back();
      if (根写入形状完整(本次建立, 角色, 幂等身份)) {
        请求待重放 = false;
        if (本次建立.结果.结果头.事实截止代次 > 当前事实截止代次)
          当前事实截止代次 = 本次建立.结果.结果头.事实截止代次;
        break;
      }
      if (是可重组漂移(本次建立, 角色, 幂等身份)) {
        请求待重放 = false;
        if (本次已重组) {
          失败状态 = 四本体根生产初始化状态::事实代次竞争;
          return false;
        }
        const auto 重读前事实截止代次 = 当前事实截止代次;
        const L2当前概念本体根组读取请求 重读请求{{L2结构合同版本, 0}};
        auto 重读结果 = 服务.读取全部当前概念本体根(重读请求);
        漂移重读证据.push_back(
            {角色, 重读前事实截止代次, 重读请求, std::move(重读结果)});
        const auto &重读 = 漂移重读证据.back();
        if (!零代次根组读取调用形状完整(重读, 重读前事实截止代次)) {
          失败状态 = 映射组读取失败(
              重读.结果, 四本体根生产初始化状态::当前根组预读失败, false);
          return false;
        }
        当前根组 = 重读.结果;
        当前事实截止代次 = 当前根组.结果头.事实截止代次;
        已有根 = 查找角色根(当前根组, 角色);
        if (已有根)
          break;
        保存请求 = L2概念本体根建立请求{
            {L2结构合同版本, 当前事实截止代次}, 幂等身份, 角色};
        本次已重组 = true;
        continue;
      }
      失败状态 = 映射建立失败(本次建立, 角色, 幂等身份, 角色形成失败);
      if (建立非成功形状完整(本次建立.结果) &&
          (本次建立.结果.结果头.状态 == L2结构状态::入口拒绝 ||
           本次建立.结果.结果头.状态 == L2结构状态::许可拒绝 ||
           本次建立.结果.结果头.状态 == L2结构状态::幂等冲突 ||
           本次建立.结果.结果头.状态 == L2结构状态::引用冲突))
        请求待重放 = false;
      return false;
    }
  }

  const L2当前概念本体根读取请求 单根读取请求{
      {L2结构合同版本, 当前事实截止代次}, 角色};
  auto 单根读取结果 = 服务.按角色读取当前概念本体根(单根读取请求);
  读取证据 = 四本体根单根读取调用证据{单根读取请求, std::move(单根读取结果)};
  if (!单根读取调用形状完整(*读取证据, 角色, 幂等身份)) {
    失败状态 = 映射单根读取失败(读取证据->结果);
    return false;
  }
  if (!建立证据.empty() && 建立证据.back().结果.成功() &&
      *建立证据.back().结果.本体根 != *读取证据->结果.本体根) {
    失败状态 = 四本体根生产初始化状态::根读回不一致;
    return false;
  }
  当前事实截止代次 = 读取证据->结果.结果头.事实截止代次;
  根候选 = *读取证据->结果.本体根;
  return true;
}

inline bool 最终根组与候选一致(const L2当前概念本体根组读取结果 &最终根组,
                               const L2概念本体根事实 &存在根,
                               const L2概念本体根事实 &特征根,
                               const L2概念本体根事实 &动态根,
                               const L2概念本体根事实 &因果链根) noexcept {
  if (!根组形状完整(最终根组) || 最终根组.本体根.size() != 4)
    return false;
  const L2概念本体根事实 *候选组[]{&存在根, &特征根, &动态根, &因果链根};
  const L2概念本体根角色 角色组[]{
      L2概念本体根角色::存在, L2概念本体根角色::特征, L2概念本体根角色::动态,
      L2概念本体根角色::因果链};
  for (std::size_t 索引 = 0; 索引 < 4; ++索引) {
    const auto *最终根 = 查找角色根(最终根组, 角色组[索引]);
    if (!最终根 || *最终根 != *候选组[索引])
      return false;
  }
  return true;
}

template <class 概念服务访问器>
四本体根生产初始化结果 编排四本体根生产初始化(
    std::mutex &发布锁, std::optional<四本体根生产初始化请求> &锁定选择,
    std::optional<L2概念本体根建立请求> &存在保存请求, bool &存在请求待重放,
    std::optional<L2概念本体根建立请求> &特征保存请求, bool &特征请求待重放,
    std::optional<L2概念本体根建立请求> &动态保存请求, bool &动态请求待重放,
    std::optional<L2概念本体根建立请求> &因果链保存请求, bool &因果链请求待重放,
    std::optional<四本体根发布材料> &已发布材料,
    const 四本体根生产初始化请求 &请求,
    概念服务访问器 &&取得概念服务) noexcept {
  static_assert(noexcept(取得概念服务()));
  static_assert(std::is_lvalue_reference_v<decltype(取得概念服务())>);
  try {
    std::lock_guard<std::mutex> 锁(发布锁);
    四本体根生产初始化结果 结果;
    if (!请求有效(请求))
      return 结果;
    if (锁定选择 && *锁定选择 != 请求) {
      结果.状态 = 四本体根生产初始化状态::已发布选择冲突;
      return 结果;
    }
    if (!锁定选择)
      锁定选择 = 请求;

    auto &服务 = 取得概念服务();
    const L2当前概念本体根组读取请求 预读请求{{L2结构合同版本, 0}};
    auto 预读结果 = 服务.读取全部当前概念本体根(预读请求);
    结果.当前根组预读 = 四本体根组读取调用证据{预读请求, std::move(预读结果)};
    if (!零代次根组读取调用形状完整(*结果.当前根组预读, 0)) {
      结果.状态 =
          映射组读取失败(结果.当前根组预读->结果,
                         四本体根生产初始化状态::当前根组预读失败, false);
      return 结果;
    }

    L2当前概念本体根组读取结果 当前根组 = 结果.当前根组预读->结果;
    std::uint64_t 当前事实截止代次 = 当前根组.结果头.事实截止代次;
    L2概念本体根事实 存在根, 特征根, 动态根, 因果链根;
    四本体根生产初始化状态 失败状态 = 四本体根生产初始化状态::内部不一致;

    if (!处理一个根(服务, 请求, L2概念本体根角色::存在, 当前事实截止代次,
                    当前根组, 存在保存请求, 存在请求待重放,
                    结果.存在根进入时待重放请求, 结果.存在根建立,
                    结果.存在根读取, 结果.漂移根组重读, 存在根,
                    四本体根生产初始化状态::存在根形成失败, 失败状态) ||
        !处理一个根(服务, 请求, L2概念本体根角色::特征, 当前事实截止代次,
                    当前根组, 特征保存请求, 特征请求待重放,
                    结果.特征根进入时待重放请求, 结果.特征根建立,
                    结果.特征根读取, 结果.漂移根组重读, 特征根,
                    四本体根生产初始化状态::特征根形成失败, 失败状态) ||
        !处理一个根(服务, 请求, L2概念本体根角色::动态, 当前事实截止代次,
                    当前根组, 动态保存请求, 动态请求待重放,
                    结果.动态根进入时待重放请求, 结果.动态根建立,
                    结果.动态根读取, 结果.漂移根组重读, 动态根,
                    四本体根生产初始化状态::动态根形成失败, 失败状态) ||
        !处理一个根(服务, 请求, L2概念本体根角色::因果链, 当前事实截止代次,
                    当前根组, 因果链保存请求, 因果链请求待重放,
                    结果.因果链根进入时待重放请求, 结果.因果链根建立,
                    结果.因果链根读取, 结果.漂移根组重读, 因果链根,
                    四本体根生产初始化状态::因果链根形成失败, 失败状态)) {
      结果.状态 = 失败状态;
      return 结果;
    }

    const L2当前概念本体根组读取请求 最终读取请求{
        {L2结构合同版本, 当前事实截止代次}};
    auto 最终读取结果 = 服务.读取全部当前概念本体根(最终读取请求);
    结果.最终根组读取 =
        四本体根组读取调用证据{最终读取请求, std::move(最终读取结果)};
    if (!结果.最终根组读取->结果.成功()) {
      结果.状态 =
          映射组读取失败(结果.最终根组读取->结果,
                         四本体根生产初始化状态::最终根组读回失败, true);
      return 结果;
    }
    if (!非零根组读取调用形状完整(*结果.最终根组读取)) {
      结果.状态 = 四本体根生产初始化状态::内部不一致;
      return 结果;
    }
    if (!最终根组与候选一致(结果.最终根组读取->结果, 存在根, 特征根, 动态根,
                            因果链根)) {
      结果.状态 = 四本体根生产初始化状态::根读回不一致;
      return 结果;
    }

    四本体根发布材料 材料{
        请求,   存在根,   特征根,
        动态根, 因果链根, 结果.最终根组读取->结果.结果头.事实截止代次};
    const bool 已有同义发布 = 已发布材料.has_value();
    结果.状态 = 已有同义发布 ? 四本体根生产初始化状态::精确重复
                             : 四本体根生产初始化状态::已发布;
    结果.来源 = 已有同义发布 ? 四本体根生产初始化来源::已发布重复消费
                             : 四本体根生产初始化来源::首次形成;
    结果.已发布材料 = 材料;
    if (!结果.成功()) {
      四本体根生产初始化结果 失败;
      失败.状态 = 四本体根生产初始化状态::内部不一致;
      return 失败;
    }
    std::optional<四本体根发布材料> 待发布(std::move(材料));
    static_assert(noexcept(已发布材料.swap(待发布)));
    已发布材料.swap(待发布);
    return 结果;
  } catch (const std::bad_alloc &) {
    四本体根生产初始化结果 结果;
    结果.状态 = 四本体根生产初始化状态::资源失败;
    return 结果;
  } catch (...) {
    四本体根生产初始化结果 结果;
    结果.状态 = 四本体根生产初始化状态::内部不一致;
    return 结果;
  }
}

inline bool 结果证据完整(const 四本体根生产初始化结果 &结果) noexcept {
  if (!结果.来源 || !结果.当前根组预读 || !结果.最终根组读取 ||
      !结果.已发布材料 || !请求有效(结果.已发布材料->选择) ||
      !零代次根组读取调用形状完整(*结果.当前根组预读, 0) ||
      !非零根组读取调用形状完整(*结果.最终根组读取) ||
      结果.最终根组读取->结果.本体根.size() != 4 ||
      结果.已发布材料->最终事实截止代次 !=
          结果.最终根组读取->结果.结果头.事实截止代次 ||
      !最终根组与候选一致(结果.最终根组读取->结果, 结果.已发布材料->存在根,
                          结果.已发布材料->特征根, 结果.已发布材料->动态根,
                          结果.已发布材料->因果链根))
    return false;

  const bool 来源正确 = (结果.状态 == 四本体根生产初始化状态::已发布 &&
                         *结果.来源 == 四本体根生产初始化来源::首次形成) ||
                        (结果.状态 == 四本体根生产初始化状态::精确重复 &&
                         *结果.来源 == 四本体根生产初始化来源::已发布重复消费);
  if (!来源正确)
    return false;

  struct 角色证据 final {
    L2概念本体根角色 角色;
    L2结构幂等身份 幂等身份;
    const L2概念本体根事实 &材料根;
    const std::optional<L2概念本体根建立请求> &进入时待重放请求;
    const std::vector<四本体根建立调用证据> &建立;
    const std::optional<四本体根单根读取调用证据> &读取;
  };
  const 角色证据 证据组[]{
      {L2概念本体根角色::存在, 结果.已发布材料->选择.存在根幂等身份,
       结果.已发布材料->存在根, 结果.存在根进入时待重放请求, 结果.存在根建立,
       结果.存在根读取},
      {L2概念本体根角色::特征, 结果.已发布材料->选择.特征根幂等身份,
       结果.已发布材料->特征根, 结果.特征根进入时待重放请求, 结果.特征根建立,
       结果.特征根读取},
      {L2概念本体根角色::动态, 结果.已发布材料->选择.动态根幂等身份,
       结果.已发布材料->动态根, 结果.动态根进入时待重放请求, 结果.动态根建立,
       结果.动态根读取},
      {L2概念本体根角色::因果链, 结果.已发布材料->选择.因果链根幂等身份,
       结果.已发布材料->因果链根, 结果.因果链根进入时待重放请求,
       结果.因果链根建立, 结果.因果链根读取}};

  for (const auto &证据 : 证据组) {
    if (!证据.读取 ||
        !单根读取调用形状完整(*证据.读取, 证据.角色, 证据.幂等身份) ||
        *证据.读取->结果.本体根 != 证据.材料根 || 证据.建立.size() > 2)
      return false;
    if (证据.进入时待重放请求 &&
        (证据.建立.empty() || 证据.建立.front().请求 != *证据.进入时待重放请求))
      return false;

    bool 处理前已有根 = false;
    if (const auto *预读根 = 查找角色根(结果.当前根组预读->结果, 证据.角色)) {
      if (*预读根 != 证据.材料根)
        return false;
      处理前已有根 = true;
    }
    for (const auto &重读 : 结果.漂移根组重读) {
      if (static_cast<std::uint8_t>(重读.角色) >=
          static_cast<std::uint8_t>(证据.角色))
        continue;
      if (const auto *先前重读根 = 查找角色根(重读.结果, 证据.角色)) {
        if (*先前重读根 != 证据.材料根)
          return false;
        处理前已有根 = true;
      }
    }
    if (证据.建立.empty()) {
      if (!处理前已有根)
        return false;
    } else if (处理前已有根 && !证据.进入时待重放请求) {
      return false;
    }

    if (证据.建立.size() == 1) {
      const auto &建立 = 证据.建立.front();
      if (根写入形状完整(建立, 证据.角色, 证据.幂等身份)) {
        if (*建立.结果.本体根 != 证据.材料根)
          return false;
      } else if (是可重组漂移(建立, 证据.角色, 证据.幂等身份)) {
        const 四本体根漂移重读证据 *角色重读 = nullptr;
        for (const auto &重读 : 结果.漂移根组重读)
          if (重读.角色 == 证据.角色) {
            if (角色重读)
              return false;
            角色重读 = &重读;
          }
        const auto *重读根 =
            角色重读 ? 查找角色根(角色重读->结果, 证据.角色) : nullptr;
        if (!角色重读 ||
            !零代次根组读取调用形状完整(*角色重读,
                                        角色重读->调用前已知事实截止代次) ||
            !重读根 || *重读根 != 证据.材料根)
          return false;
      } else {
        return false;
      }
    } else if (证据.建立.size() == 2) {
      if (!是可重组漂移(证据.建立.front(), 证据.角色, 证据.幂等身份) ||
          !根写入形状完整(证据.建立.back(), 证据.角色, 证据.幂等身份) ||
          *证据.建立.back().结果.本体根 != 证据.材料根)
        return false;
      const 四本体根漂移重读证据 *角色重读 = nullptr;
      for (const auto &重读 : 结果.漂移根组重读)
        if (重读.角色 == 证据.角色) {
          if (角色重读)
            return false;
          角色重读 = &重读;
        }
      if (!角色重读 ||
          !零代次根组读取调用形状完整(*角色重读,
                                      角色重读->调用前已知事实截止代次) ||
          查找角色根(角色重读->结果, 证据.角色) ||
          证据.建立.back().请求.请求头.期望事实代次 !=
              角色重读->结果.结果头.事实截止代次)
        return false;
    }
  }

  std::size_t 预期漂移重读数量 = 0;
  for (const auto &证据 : 证据组)
    if (!证据.建立.empty() &&
        是可重组漂移(证据.建立.front(), 证据.角色, 证据.幂等身份))
      ++预期漂移重读数量;
  if (预期漂移重读数量 != 结果.漂移根组重读.size())
    return false;
  for (const auto &重读 : 结果.漂移根组重读)
    if (!零代次根组读取调用形状完整(重读, 重读.调用前已知事实截止代次))
      return false;
  return true;
}

} // namespace 海中鱼巣::四本体根生产初始化内部
