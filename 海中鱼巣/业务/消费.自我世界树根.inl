namespace 海中鱼巣::自我世界树根消费内部 {

inline bool 请求相同(const 自我世界树根消费请求& 左,
    const 自我世界树根消费请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本
        && 左.项目树选择.合同版本 == 右.项目树选择.合同版本
        && 左.项目树选择.根建立幂等身份 == 右.项目树选择.根建立幂等身份
        && 左.首次根建立请求 == 右.首次根建立请求
        && 左.树 == 右.树 && 左.根场景 == 右.根场景
        && 左.首次根标记 == 右.首次根标记;
}

inline bool 请求有效(const 自我世界树根消费请求& 请求) noexcept {
    const auto& 标记 = 请求.首次根标记;
    return 请求.合同版本 == 自我世界树根消费合同版本
        && 请求.项目树选择.合同版本 == 系统世界树根初始化合同版本
        && 请求.项目树选择.根建立幂等身份
            == 海中鱼巣现实世界树根建立幂等身份
        && L2场景树根建立请求有效(请求.首次根建立请求)
        && 请求.首次根建立请求.幂等身份
            == 请求.项目树选择.根建立幂等身份
        && 有效(请求.树.值) && 有效(请求.根场景.值)
        && 请求.树.值 == 请求.根场景.值
        && 有效(标记.树.值) && 有效(标记.场景.值)
        && 有效(标记.根场景.值)
        && 标记.类别 == L2场景树归属类别::根
        && 标记.树 == 请求.树 && 标记.场景 == 请求.根场景
        && 标记.根场景 == 请求.根场景
        && 有效(标记.关系稳定编码)
        && 有效(标记.物理目标稳定编码)
        && 标记.生命周期.创建事实代次 != 0
        && !标记.生命周期.退出事实代次;
}

inline bool 读回一致(const 自我世界树根消费请求& 请求,
    const L2场景树结构登记结果& 登记结果,
    const L2场景树读取结果& 根结果) noexcept {
    if (!登记结果.登记 || !根结果.树) return false;
    const auto 截止 = 登记结果.结果头.事实截止代次;
    const auto& 树 = *根结果.树;
    return 截止 != 0
        && 根结果.结果头.事实截止代次 == 截止
        && 树.事实截止代次 == 截止
        && 根结果.读取类别 == L2读取类别::当前
        && 根结果.历史截止事实代次 == 0
        && 树.结构登记 == *登记结果.登记
        && 树.树 == 请求.树 && 树.根场景 == 请求.根场景
        && 树.根标记 == 请求.首次根标记
        && 树.根标记.类别 == L2场景树归属类别::根
        && L2场景树事实完整(树)
        && L2场景树根建立请求有效(请求.首次根建立请求)
        && 请求.首次根建立请求.幂等身份
            == 请求.项目树选择.根建立幂等身份;
}

template<class 场景服务访问器>
自我世界树根消费结果 编排自我世界树根消费(
    std::mutex& 发布锁,
    std::optional<自我世界树根消费材料>& 已发布材料,
    const 自我世界树根消费请求& 请求,
    场景服务访问器&& 取得场景服务) noexcept {
    static_assert(noexcept(取得场景服务()));
    static_assert(std::is_lvalue_reference_v<decltype(取得场景服务())>);
    static_assert(std::is_nothrow_move_constructible_v<自我世界树根消费材料>);
    static_assert(std::is_nothrow_swappable_v<自我世界树根消费材料>);
    static_assert(std::is_nothrow_swappable_v<
        std::optional<自我世界树根消费材料>>);
    try {
        std::lock_guard<std::mutex> 锁(发布锁);
        if (!请求有效(请求)) return {};
        const bool 已有同请求 = 已发布材料.has_value();
        if (已有同请求 && !请求相同(已发布材料->请求, 请求)) {
            自我世界树根消费结果 结果;
            结果.状态 = 自我世界树根消费状态::已发布选择冲突;
            return 结果;
        }

        auto& 场景服务 = 取得场景服务();
        auto 登记 = 场景服务.读取当前场景树结构登记();
        if (!登记.成功() || !登记.登记) {
            自我世界树根消费结果 结果;
            结果.状态 = 自我世界树根消费状态::树结构登记读取失败;
            结果.结构登记读取 = std::move(登记);
            return 结果;
        }

        const L2场景树读取请求 读取请求{
            {L2结构合同版本, 登记.结果头.事实截止代次},
            L2读取类别::当前, 请求.树, 0};
        auto 根 = 场景服务.读取场景树(读取请求);
        if (!根.成功() || !根.树) {
            自我世界树根消费结果 结果;
            结果.状态 = 根.结果头.状态 == L2结构状态::已读取
                ? 自我世界树根消费状态::根读回不一致
                : 自我世界树根消费状态::根正式读回失败;
            结果.结构登记读取 = std::move(登记);
            结果.根读取 = std::move(根);
            return 结果;
        }
        if (!读回一致(请求, 登记, 根)) {
            自我世界树根消费结果 结果;
            结果.状态 = 自我世界树根消费状态::根读回不一致;
            结果.结构登记读取 = std::move(登记);
            结果.根读取 = std::move(根);
            return 结果;
        }

        自我世界树根消费材料 材料{
            请求, *登记.登记, *根.树, 登记.结果头.事实截止代次};
        自我世界树根消费结果 结果;
        结果.状态 = 已有同请求 ? 自我世界树根消费状态::精确重复
                                : 自我世界树根消费状态::已发布;
        结果.来源 = 已有同请求
            ? 自我世界树根消费来源::已发布重复消费
            : 自我世界树根消费来源::首次消费;
        结果.结构登记读取 = 登记;
        结果.根读取 = 根;
        结果.已发布材料 = 材料;
        std::optional<自我世界树根消费材料> 待发布(std::move(材料));
        已发布材料.swap(待发布);
        return 结果;
    } catch (const std::bad_alloc&) {
        自我世界树根消费结果 结果;
        结果.状态 = 自我世界树根消费状态::资源失败;
        return 结果;
    } catch (...) {
        自我世界树根消费结果 结果;
        结果.状态 = 自我世界树根消费状态::内部不一致;
        return 结果;
    }
}

}
