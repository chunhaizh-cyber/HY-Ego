namespace 海中鱼巣::本能根运行初始化内部 {

using 初始化状态 = 本能根运行初始化状态_v1;

struct 根幂等规格_v1 final {
    L2结构幂等身份 一阶特征定义;
    L2结构幂等身份 差值二次概念;
    L2结构幂等身份 特征实例;
    L2结构幂等身份 首值;
    L2结构幂等身份 首态;
    L1所有者范围写入幂等身份 双参与者组合;
    L2结构幂等身份 比较注册;
    L2结构幂等身份 目标合同;
    L2结构幂等身份 建需求并建立列表项;
    L2结构幂等身份 建需求并加入既有列表项;
};

inline constexpr 根幂等规格_v1 安全根幂等规格_v1{
    {0x494E'5354'0101'0001ULL},
    {0x494E'5354'0101'0002ULL},
    {0x494E'5354'0101'0003ULL},
    {0x494E'5354'0101'0004ULL},
    {0x494E'5354'0101'0005ULL},
    {0x494E'5354'0101'0006ULL},
    {0x494E'5354'0101'0007ULL},
    {0x494E'5354'0101'0008ULL},
    {0x494E'5354'0101'0009ULL},
    {0x494E'5354'0101'000AULL}};

inline constexpr 根幂等规格_v1 服务根幂等规格_v1{
    {0x494E'5354'0102'0001ULL},
    {0x494E'5354'0102'0002ULL},
    {0x494E'5354'0102'0003ULL},
    {0x494E'5354'0102'0004ULL},
    {0x494E'5354'0102'0005ULL},
    {0x494E'5354'0102'0006ULL},
    {0x494E'5354'0102'0007ULL},
    {0x494E'5354'0102'0008ULL},
    {0x494E'5354'0102'0009ULL},
    {0x494E'5354'0102'000AULL}};

inline constexpr L2特征派生规则身份 本能根差值派生规则身份_v1{
    稳定编码{0x494E'5354'0100'0031ULL}};
inline constexpr std::uint32_t 本能根差值派生规则版本_v1 = 1;
inline constexpr std::uint8_t 本能根目标允许关系位_v1 = 0b010;
inline constexpr std::uint64_t 根需求读取数量预算_v1 =
    0xffff'ffff'ffff'ffffULL;

struct 根材料_v1 final {
    L2特征定义身份 一阶特征定义;
    L2特征定义身份 差值二次概念;
    L2特征实例身份 特征实例;
    L2特征比较注册身份 比较注册;
    L2目标状态合同身份 目标合同;
    L2需求身份 根需求;
    L2需求列表项身份 列表项;
};

template<class T>
struct 阶段结果_v1 final {
    初始化状态 状态 = 初始化状态::内部不一致;
    std::optional<T> 值;
    bool 本次发布 = false;

    bool 成功() const noexcept { return 值.has_value(); }
};

inline 初始化状态 映射结构失败(L2结构状态 状态) noexcept {
    switch (状态) {
    case L2结构状态::事实代次漂移: return 初始化状态::当前性漂移;
    case L2结构状态::幂等冲突: return 初始化状态::幂等冲突;
    case L2结构状态::引用冲突: return 初始化状态::引用冲突;
    case L2结构状态::未找到:
    case L2结构状态::属性未设置:
    case L2结构状态::数量预算不足:
        return 初始化状态::材料未闭合;
    case L2结构状态::已退出: return 初始化状态::角色已退出;
    case L2结构状态::资源失败: return 初始化状态::资源失败;
    case L2结构状态::已提交:
    case L2结构状态::精确重复:
    case L2结构状态::已读取:
    case L2结构状态::未实现:
    case L2结构状态::入口拒绝:
    case L2结构状态::许可拒绝:
    case L2结构状态::内部不一致:
        return 初始化状态::内部不一致;
    }
    return 初始化状态::内部不一致;
}

inline 初始化状态 映射中性读取失败(
    L2中性结构状态_v1 状态) noexcept {
    switch (状态) {
    case L2中性结构状态_v1::事实代次漂移:
        return 初始化状态::当前性漂移;
    case L2中性结构状态_v1::引用冲突:
        return 初始化状态::引用冲突;
    case L2中性结构状态_v1::未找到:
    case L2中性结构状态_v1::动态不闭合:
    case L2中性结构状态_v1::历史材料已清理:
        return 初始化状态::材料未闭合;
    case L2中性结构状态_v1::资源失败:
        return 初始化状态::资源失败;
    default:
        return 初始化状态::内部不一致;
    }
}

inline bool 当前读取头完整(
    const L2结构结果头& 结果头, std::uint64_t 截止) noexcept {
    return 结果头.合同版本 == L2结构合同版本
        && 结果头.状态 == L2结构状态::已读取
        && 截止 != 0 && 结果头.事实截止代次 == 截止
        && !结果头.变更事实代次;
}

inline bool 写入成功状态(L2结构状态 状态) noexcept {
    return 状态 == L2结构状态::已提交
        || 状态 == L2结构状态::精确重复;
}

inline L2特征比较I64合同材料 形成比较合同材料(
    L2特征定义身份 特征定义) noexcept {
    L2特征比较I64合同材料 合同;
    合同.用途 = L2特征比较用途::目标判断;
    合同.算法族 = L2特征比较算法族::标量有序比较与安全差异;
    合同.算法版本 = 1;
    合同.原始类型 = L2特征比较原始类型::I64;
    合同.左角色 = L2特征比较角色::当前事实;
    合同.右角色 = L2特征比较角色::目标状态;
    合同.差异方向 = L2特征比较方向::右减左;
    合同.单位 = 特征定义.值;
    合同.维度 = 特征定义.值;
    合同.分量角色 = 特征定义.值;
    合同.允许结果位 = 本能根目标允许关系位_v1;
    合同.边界包含 = L2特征比较边界包含::不适用;
    合同.量化规则 = L2特征比较量化规则::精确无量化;
    合同.误差合同版本 = 1;
    合同.误差预算.reset();
    合同.相等容差 = 0;
    return 合同;
}

inline bool 定义符合规格(
    const L2统一特征定义事实& 定义, std::uint64_t 截止,
    std::uint32_t 阶次,
    std::optional<L2特征定义身份> 直接来源) noexcept {
    if (!L2统一特征定义事实完整(定义, 截止)
        || 定义.生命周期.退出事实代次) return false;
    const auto* 实际阶次 = std::get_if<std::int64_t>(
        &定义.实际阶次属性.类型化不可变材料);
    if (!实际阶次 || *实际阶次 != static_cast<std::int64_t>(阶次))
        return false;
    if (!直接来源)
        return 阶次 == 1 && 定义.直接来源.empty() && !定义.派生规则;
    if (阶次 != 2 || 定义.直接来源.size() != 1 || !定义.派生规则)
        return false;
    const auto& 来源 = 定义.直接来源.front();
    const auto* 规则材料 = std::get_if<std::vector<std::uint64_t>>(
        &定义.派生规则->规则见证属性.类型化不可变材料);
    return 来源.顺序 == 1 && 来源.输入角色 == 1
        && 来源.来源特征定义 == *直接来源
        && !来源.生命周期.退出事实代次
        && 规则材料 && 规则材料->size() == 2
        && (*规则材料)[0] == 本能根差值派生规则身份_v1.值.值
        && (*规则材料)[1] == 本能根差值派生规则版本_v1;
}

inline bool 实例符合规格(
    const L2特征实例事实& 实例, std::uint64_t 截止,
    L2存在身份 自我, L2特征定义身份 定义) noexcept {
    return L2特征实例事实完整(实例, 截止)
        && !实例.生命周期.退出事实代次
        && 实例.宿主存在 == 自我 && 实例.特征定义 == 定义;
}

inline bool 比较注册符合规格(
    const L2特征比较注册事实& 注册, std::uint64_t 截止,
    L2结构幂等身份 幂等身份, L2特征定义身份 定义) noexcept {
    return L2特征比较注册事实完整(注册, 截止)
        && !注册.生命周期.退出事实代次
        && 注册.首次幂等身份 == 幂等身份
        && 注册.特征定义 == 定义
        && 注册.合同 == 形成比较合同材料(定义);
}

inline bool 目标合同符合规格(
    const L2目标状态合同事实& 合同, std::uint64_t 截止,
    L2结构幂等身份 幂等身份, L2特征定义身份 定义,
    L2特征比较注册身份 比较注册) noexcept {
    return L2目标状态合同事实完整(合同, 截止)
        && !合同.生命周期.退出事实代次
        && 合同.首次幂等身份 == 幂等身份
        && 合同.特征定义 == 定义 && 合同.比较注册 == 比较注册
        && 合同.比较用途 == L2特征比较用途::目标判断
        && 合同.目标I64 == 本能根I64最大目标_v1
        && 合同.允许关系位 == 本能根目标允许关系位_v1
        && 合同.规则版本 == L2目标状态合同规则版本
        && 合同.来源稳定编码 == 比较注册.值;
}

inline bool 需求符合目标(
    const L2需求事实& 需求, std::uint64_t 截止,
    L2存在身份 自我, L2特征定义身份 定义,
    L2目标状态合同身份 合同) noexcept {
    return L2需求事实完整(需求, 截止)
        && !需求.生命周期.退出事实代次
        && 需求.所属存在 == 自我 && 需求.目标宿主存在 == 自我
        && 需求.目标特征定义 == 定义 && 需求.目标状态合同 == 合同;
}

inline bool 列表项符合目标(
    const L2需求列表项事实& 列表项, std::uint64_t 截止,
    L2存在身份 自我, L2特征定义身份 定义,
    L2目标状态合同身份 合同) noexcept {
    return L2需求列表项事实完整(列表项, 截止)
        && !列表项.生命周期.退出事实代次
        && 列表项.所属存在 == 自我 && 列表项.目标宿主存在 == 自我
        && 列表项.目标特征定义 == 定义
        && 列表项.目标状态合同 == 合同;
}

inline bool 当前根值符合规格(
    const L2特征值事实& 当前值, std::uint64_t 截止,
    L2特征实例身份 实例) noexcept {
    const auto* 值 = std::get_if<std::int64_t>(&当前值.类型化不可变材料);
    return L2特征值事实截止投影完整(当前值, 截止)
        && !当前值.生命周期.退出事实代次
        && 当前值.特征实例 == 实例
        && 值 && *值 >= 0 && *值 <= 本能根I64最大目标_v1;
}

inline bool 值态符合规格(
    const L2特征值事实& 当前值,
    const L2状态事实& 当前状态,
    const L2状态当前选择关系引用& 当前选择,
    std::uint64_t 截止, L2存在身份 自我,
    L2特征实例身份 实例, 稳定编码 来源) noexcept {
    const auto* 值 = std::get_if<std::int64_t>(&当前值.类型化不可变材料);
    const auto* 状态值 = std::get_if<std::int64_t>(
        &当前状态.精确值.类型化不可变材料);
    const auto* 时间 = std::get_if<std::int64_t>(
        &当前状态.时间值.类型化不可变材料);
    return L2特征值事实截止投影完整(当前值, 截止)
        && !当前值.生命周期.退出事实代次
        && 当前值.特征实例 == 实例 && 当前值.来源稳定编码 == 来源
        && 值 && *值 >= 0 && *值 <= 本能根I64最大目标_v1
        && 当前状态.生命周期.创建事实代次 != 0
        && 当前状态.生命周期.创建事实代次 <= 截止
        && !当前状态.生命周期.退出事实代次
        && 当前状态.主体存在 == 自我 && 当前状态.特征实例 == 实例
        && 当前状态.来源稳定编码 == 来源
        && 当前状态.精确值.来源稳定编码 == 来源
        && 当前状态.时间值.来源稳定编码 == 来源
        && 状态值 && *状态值 == *值 && 时间 && *时间 > 0
        && L2状态当前选择关系引用完整(当前选择, 截止)
        && !当前选择.生命周期.退出事实代次
        && 当前选择.特征实例 == 实例
        && 当前选择.状态 == 当前状态.身份;
}

inline bool 中性值态符合规格(
    const L2特征值事实& 当前值,
    const L2中性状态事实_v1& 当前状态,
    const L2中性状态引用事实_v1& 当前选择,
    const L2中性状态上下文事实_v1& 状态上下文,
    std::uint64_t 截止, L2存在身份 自我,
    L2特征实例身份 实例, L2特征定义身份 定义) noexcept {
    const auto* 值 = std::get_if<std::int64_t>(&当前值.类型化不可变材料);
    return L2特征值事实截止投影完整(当前值, 截止)
        && !当前值.生命周期.退出事实代次
        && 当前值.特征实例 == 实例 && 值 && *值 >= 0
        && *值 <= 本能根I64最大目标_v1
        && L2中性状态事实完整_v1(当前状态)
        && 当前状态.材料类别 == L2中性材料类别_v1::实例
        && 当前状态.特征类型 == 定义
        && 当前状态.特征值 == 当前值.类型化不可变材料
        && 当前状态.形成事实代次 <= 截止
        && L2中性状态引用事实完整_v1(当前选择)
        && 当前选择.类别 == L2中性状态引用类别_v1::当前选择
        && 当前选择.引用方 == 实例.值
        && 当前选择.引用角色 == L2特征当前值记录状态角色_v1
        && 当前选择.目标状态 == 当前状态.身份
        && !当前选择.生命周期.退出事实代次
        && 当前选择.生命周期.创建事实代次 <= 截止
        && 状态上下文.状态 == 当前状态.身份
        && 状态上下文.主体存在 == 自我
        && 有效(状态上下文.共同场景.值)
        && 状态上下文.特征实例 == 实例
        && 有效(状态上下文.来源存在.值)
        && 有效(状态上下文.主体关系稳定编码)
        && 有效(状态上下文.场景关系稳定编码)
        && 有效(状态上下文.特征实例关系稳定编码)
        && 有效(状态上下文.来源存在关系稳定编码)
        && L2生命周期完整(状态上下文.生命周期)
        && 状态上下文.生命周期.创建事实代次 <= 截止
        && !状态上下文.生命周期.退出事实代次;
}

} // namespace 海中鱼巣::本能根运行初始化内部

export namespace 海中鱼巣 {

namespace 内部 = 本能根运行初始化内部;

class 本能根运行初始化提供者 final {
public:
    本能根运行初始化提供者(
        const L2存在结构服务& 存在服务,
        L2特征结构服务& 特征服务,
        L2状态结构服务& 状态服务,
        L2需求结构服务& 需求服务) noexcept
        : 存在服务_(存在服务), 特征服务_(特征服务),
          状态服务_(状态服务), 需求服务_(需求服务) {}

    本能根运行初始化结果_v1 初始化并读取本能根运行锚点_v1(
        const 本能根运行初始化请求_v1& 请求) noexcept {
        if (请求.合同版本 != 本能根运行初始化合同版本_v1
            || !有效(请求.唯一自我.值) || 请求.本次启动UTC纳秒 == 0
            || 请求.本次启动UTC纳秒
                > static_cast<std::uint64_t>(本能根I64最大目标_v1))
            return 失败(本能根运行初始化状态_v1::入口拒绝);
        try {
            const auto 自我 = 读取并验证唯一自我(请求.唯一自我);
            if (!自我.成功()) return 失败(自我.状态);

            内部::根材料_v1 安全;
            内部::根材料_v1 服务;
            bool 本次发布 = false;

            auto 安全定义 = 确保定义(内部::安全根幂等规格_v1.一阶特征定义,
                1, std::nullopt);
            if (!安全定义.成功()) return 失败(安全定义.状态);
            安全.一阶特征定义 = *安全定义.值;
            本次发布 = 本次发布 || 安全定义.本次发布;

            auto 服务定义 = 确保定义(内部::服务根幂等规格_v1.一阶特征定义,
                1, std::nullopt);
            if (!服务定义.成功()) return 失败(服务定义.状态);
            服务.一阶特征定义 = *服务定义.值;
            本次发布 = 本次发布 || 服务定义.本次发布;

            auto 安全概念 = 确保定义(内部::安全根幂等规格_v1.差值二次概念,
                2, 安全.一阶特征定义);
            if (!安全概念.成功()) return 失败(安全概念.状态);
            安全.差值二次概念 = *安全概念.值;
            本次发布 = 本次发布 || 安全概念.本次发布;

            auto 服务概念 = 确保定义(内部::服务根幂等规格_v1.差值二次概念,
                2, 服务.一阶特征定义);
            if (!服务概念.成功()) return 失败(服务概念.状态);
            服务.差值二次概念 = *服务概念.值;
            本次发布 = 本次发布 || 服务概念.本次发布;

            auto 安全实例 = 确保实例(内部::安全根幂等规格_v1.特征实例,
                请求.唯一自我, 安全.一阶特征定义);
            if (!安全实例.成功()) return 失败(安全实例.状态);
            安全.特征实例 = *安全实例.值;
            本次发布 = 本次发布 || 安全实例.本次发布;

            auto 服务实例 = 确保实例(内部::服务根幂等规格_v1.特征实例,
                请求.唯一自我, 服务.一阶特征定义);
            if (!服务实例.成功()) return 失败(服务实例.状态);
            服务.特征实例 = *服务实例.值;
            本次发布 = 本次发布 || 服务实例.本次发布;

            auto 安全值态 = 确保首值首态(内部::安全根幂等规格_v1,
                请求, 安全);
            if (!安全值态.成功()) return 失败(安全值态.状态);
            本次发布 = 本次发布 || 安全值态.本次发布;

            auto 服务值态 = 确保首值首态(内部::服务根幂等规格_v1,
                请求, 服务);
            if (!服务值态.成功()) return 失败(服务值态.状态);
            本次发布 = 本次发布 || 服务值态.本次发布;

            auto 安全比较 = 确保比较注册(内部::安全根幂等规格_v1.比较注册,
                安全.一阶特征定义);
            if (!安全比较.成功()) return 失败(安全比较.状态);
            安全.比较注册 = *安全比较.值;
            本次发布 = 本次发布 || 安全比较.本次发布;

            auto 服务比较 = 确保比较注册(内部::服务根幂等规格_v1.比较注册,
                服务.一阶特征定义);
            if (!服务比较.成功()) return 失败(服务比较.状态);
            服务.比较注册 = *服务比较.值;
            本次发布 = 本次发布 || 服务比较.本次发布;

            auto 安全合同 = 确保目标合同(内部::安全根幂等规格_v1.目标合同,
                安全.一阶特征定义, 安全.比较注册);
            if (!安全合同.成功()) return 失败(安全合同.状态);
            安全.目标合同 = *安全合同.值;
            本次发布 = 本次发布 || 安全合同.本次发布;

            auto 服务合同 = 确保目标合同(内部::服务根幂等规格_v1.目标合同,
                服务.一阶特征定义, 服务.比较注册);
            if (!服务合同.成功()) return 失败(服务合同.状态);
            服务.目标合同 = *服务合同.值;
            本次发布 = 本次发布 || 服务合同.本次发布;

            auto 安全需求 = 确保根需求(内部::安全根幂等规格_v1,
                请求.唯一自我, 安全.一阶特征定义, 安全.目标合同);
            if (!安全需求.成功()) return 失败(安全需求.状态);
            安全.根需求 = 安全需求.值->根需求;
            安全.列表项 = 安全需求.值->列表项;
            本次发布 = 本次发布 || 安全需求.本次发布;

            auto 服务需求 = 确保根需求(内部::服务根幂等规格_v1,
                请求.唯一自我, 服务.一阶特征定义, 服务.目标合同);
            if (!服务需求.成功()) return 失败(服务需求.状态);
            服务.根需求 = 服务需求.值->根需求;
            服务.列表项 = 服务需求.值->列表项;
            本次发布 = 本次发布 || 服务需求.本次发布;

            const auto 最终代次 = 读取当前事实代次();
            if (!最终代次) return 失败(内部::初始化状态::内部不一致);
            auto 锚点 = 最终完整读回(
                *最终代次, 请求.唯一自我, 安全, 服务);
            if (!锚点.成功()) return 失败(锚点.状态);
            const auto 最终复核代次 = 读取当前事实代次();
            if (!最终复核代次 || *最终复核代次 != *最终代次)
                return 失败(内部::初始化状态::当前性漂移);

            return {本能根运行初始化合同版本_v1,
                本次发布 ? 本能根运行初始化状态_v1::已形成
                         : 本能根运行初始化状态_v1::已恢复,
                std::move(*锚点.值)};
        } catch (const std::bad_alloc&) {
            return 失败(本能根运行初始化状态_v1::资源失败);
        } catch (const std::length_error&) {
            return 失败(本能根运行初始化状态_v1::资源失败);
        } catch (...) {
            return 失败(本能根运行初始化状态_v1::内部不一致);
        }
    }

private:
    static 本能根运行初始化结果_v1 失败(
        本能根运行初始化状态_v1 状态) noexcept {
        return {本能根运行初始化合同版本_v1, 状态, std::nullopt};
    }

    std::optional<std::uint64_t> 读取当前事实代次() const noexcept {
        const auto 代次 = 状态服务_.读取中性当前事实代次_v1();
        return 代次 && *代次 != 0 ? 代次 : std::nullopt;
    }

    内部::阶段结果_v1<L2存在身份> 读取并验证唯一自我(
        L2存在身份 自我) const {
        const auto G0 = 读取当前事实代次();
        if (!G0) return {内部::初始化状态::内部不一致};
        const auto 读取 = 存在服务_.读取完整存在(
            {{L2结构合同版本, *G0}, L2读取类别::当前, 自我, 0});
        if (!内部::当前读取头完整(读取.结果头, *G0)
            || 读取.读取类别 != L2读取类别::当前
            || 读取.历史截止事实代次 != 0 || !读取.存在)
            return {内部::映射结构失败(读取.结果头.状态)};
        if (读取.存在->身份 != 自我
            || !L2存在事实完整(*读取.存在, *G0)
            || 读取.存在->生命周期.退出事实代次)
            return {内部::初始化状态::引用冲突};
        return {内部::初始化状态::已恢复, 自我, false};
    }

    内部::阶段结果_v1<L2特征定义身份> 确保定义(
        L2结构幂等身份 幂等身份, std::uint32_t 阶次,
        std::optional<L2特征定义身份> 直接来源) {
        const auto G0 = 读取当前事实代次();
        if (!G0) return {内部::初始化状态::内部不一致};
        const auto 首次 = 特征服务_.按幂等身份读取统一特征定义首次完整事实(
            {L2统一特征定义幂等首次完整读取合同版本,
                {L2结构合同版本, *G0}, 幂等身份});
        if (首次.成功()) {
            if (首次.本次正式读回截止 != *G0 || !首次.特征定义
                || !内部::定义符合规格(*首次.特征定义, *G0, 阶次, 直接来源))
                return {内部::初始化状态::引用冲突};
            return {内部::初始化状态::已恢复, 首次.特征定义->身份, false};
        }
        using 首次状态 = L2统一特征定义幂等首次完整读取状态;
        if (首次.状态 != 首次状态::未找到) {
            if (首次.状态 == 首次状态::当前性漂移)
                return {内部::初始化状态::当前性漂移};
            if (首次.状态 == 首次状态::资源失败)
                return {内部::初始化状态::资源失败};
            return {内部::初始化状态::内部不一致};
        }

        L2统一特征定义新增请求 请求;
        请求.请求头 = {L2结构合同版本, *G0};
        请求.幂等身份 = 幂等身份;
        请求.实际阶次 = 阶次;
        if (直接来源) {
            请求.直接来源 = {{1, 1, *直接来源}};
            请求.派生规则 = L2特征派生规则提交项{
                内部::本能根差值派生规则身份_v1,
                内部::本能根差值派生规则版本_v1};
        }
        const auto 写入 = 特征服务_.新增统一特征定义(请求);
        if (!写入.成功() || !写入.特征定义)
            return {内部::映射结构失败(写入.结果头.状态)};
        if (!内部::定义符合规格(*写入.特征定义,
                写入.结果头.事实截止代次, 阶次, 直接来源))
            return {内部::初始化状态::内部不一致};
        return {内部::初始化状态::已恢复, 写入.特征定义->身份,
            写入.结果头.状态 == L2结构状态::已提交};
    }

    内部::阶段结果_v1<L2特征实例身份> 确保实例(
        L2结构幂等身份 幂等身份, L2存在身份 自我,
        L2特征定义身份 定义) {
        const auto G0 = 读取当前事实代次();
        if (!G0) return {内部::初始化状态::内部不一致};
        const auto 首次 = 特征服务_.按幂等身份读取特征实例首次完整事实_v1({
            L2特征实例幂等首次完整读取合同版本_v1,
            {L2结构合同版本, *G0}, 幂等身份, 自我, 定义});
        using 首次状态 = L2特征实例幂等首次完整读取状态_v1;
        if (首次.成功()) {
            if (首次.状态 != 首次状态::已读取 || !首次.首次请求
                || !首次.特征实例 || !首次.自有关系
                || 首次.幂等身份 != 幂等身份
                || 首次.首次请求->宿主存在 != 自我
                || 首次.首次请求->特征定义 != 定义
                || 首次.特征实例->宿主存在 != 自我
                || 首次.特征实例->特征定义 != 定义
                || 首次.特征实例->生命周期.创建事实代次 != 首次.首次G1
                || 首次.本次正式读回截止 != *G0)
                return {内部::初始化状态::引用冲突};
            return {内部::初始化状态::已恢复,
                首次.特征实例->身份, false};
        }
        if (首次.状态 != 首次状态::未找到) {
            switch (首次.状态) {
            case 首次状态::入口拒绝:
                return {内部::初始化状态::内部不一致};
            case 首次状态::当前性漂移:
                return {内部::初始化状态::当前性漂移};
            case 首次状态::幂等冲突:
                return {内部::初始化状态::幂等冲突};
            case 首次状态::引用冲突:
                return {内部::初始化状态::引用冲突};
            case 首次状态::资源失败:
                return {内部::初始化状态::资源失败};
            case 首次状态::内部不一致:
            case 首次状态::已读取:
            case 首次状态::未找到:
                return {内部::初始化状态::内部不一致};
            }
        }
        const auto 写入 = 特征服务_.新增特征实例(
            {{L2结构合同版本, *G0}, 幂等身份, 自我, 定义});
        if (!内部::写入成功状态(写入.结果头.状态)
            || 写入.结果头.事实截止代次 == 0 || !写入.特征实例)
            return {内部::映射结构失败(写入.结果头.状态)};
        if (!内部::实例符合规格(*写入.特征实例,
                写入.结果头.事实截止代次, 自我, 定义))
            return {内部::初始化状态::引用冲突};
        return {内部::初始化状态::已恢复, 写入.特征实例->身份,
            写入.结果头.状态 == L2结构状态::已提交};
    }

    内部::初始化状态 验证已存在根值记录(
        std::uint64_t 截止, const 内部::根材料_v1& 根,
        const L2特征值事实& 当前值) const {
        return 内部::当前根值符合规格(当前值, 截止, 根.特征实例)
            ? 内部::初始化状态::已恢复
            : 内部::初始化状态::引用冲突;
    }

    内部::阶段结果_v1<bool> 确保首值首态(
        const 内部::根幂等规格_v1& 规格,
        const 本能根运行初始化请求_v1& 初始化请求,
        const 内部::根材料_v1& 根) {
        const auto G0 = 读取当前事实代次();
        if (!G0) return {内部::初始化状态::内部不一致};
        const auto 值读取 = 特征服务_.读取特征当前值(
            {{L2结构合同版本, *G0}, 根.特征实例});
        const bool 有值 = 值读取.成功()
            && 值读取.结果头.事实截止代次 == *G0 && 值读取.当前值;
        const bool 无值 = 值读取.结果头.合同版本 == L2结构合同版本
            && 值读取.结果头.状态 == L2结构状态::属性未设置
            && 值读取.结果头.事实截止代次 == *G0
            && !值读取.结果头.变更事实代次 && !值读取.当前值;
        if (!有值 && !无值)
            return {内部::映射结构失败(值读取.结果头.状态)};

        if (有值) {
            const auto 验证 = 验证已存在根值记录(
                *G0, 根, *值读取.当前值);
            if (验证 != 内部::初始化状态::已恢复)
                return {验证};
            return {内部::初始化状态::已恢复, true, false};
        }

        const auto 中性选择 = 状态服务_.读取中性状态当前选择_v1({
            {L2结构合同版本, *G0}, L2中性状态动态合同版本_v1,
            L2读取类别::当前, 根.特征实例.值,
            L2特征当前值记录状态角色_v1, 0});
        if (中性选择.结果头.状态 != L2中性结构状态_v1::未找到)
            return {中性选择.成功()
                ? 内部::初始化状态::材料未闭合
                : 内部::映射中性读取失败(中性选择.结果头.状态)};
        const auto legacy = 状态服务_.读取特征实例当前状态选择(
            {{L2结构合同版本, *G0}, 根.特征实例});
        const bool 无legacy = legacy.结果头.合同版本 == L2结构合同版本
            && legacy.结果头.状态 == L2结构状态::入口拒绝
            && legacy.读取状态 == L2状态当前选择读取状态::待迁移
            && legacy.结果头.事实截止代次 == *G0
            && !legacy.结果头.变更事实代次
            && !legacy.当前选择关系 && !legacy.当前状态;
        if (!无legacy)
            return {legacy.成功() ? 内部::初始化状态::材料未闭合
                                   : 内部::映射结构失败(legacy.结果头.状态)};

        L2特征首值初始状态原子形成请求_v1 请求;
        请求.合同版本 = L2特征首值初始状态原子形成合同版本_v1;
        请求.请求头 = {L2结构合同版本, *G0};
        请求.组合幂等身份 = 规格.双参与者组合;
        请求.首值幂等身份 = 规格.首值;
        请求.首态幂等身份 = 规格.首态;
        请求.主体存在 = 初始化请求.唯一自我;
        请求.特征实例 = 根.特征实例;
        请求.初始值材料 = L2原始值材料{本能根初始值_v1};
        请求.初始状态UTC纳秒 = 初始化请求.本次启动UTC纳秒;
        请求.来源稳定编码 = 根.一阶特征定义.值;
        const auto 写入 = 状态服务_.新增特征首值与初始状态_v1(请求);
        if (!写入.成功()) {
            using 状态 = L2特征首值初始状态原子形成状态_v1;
            switch (写入.状态) {
            case 状态::当前性漂移:
                return {内部::初始化状态::当前性漂移};
            case 状态::幂等冲突:
                return {内部::初始化状态::幂等冲突};
            case 状态::引用冲突:
                return {内部::初始化状态::引用冲突};
            case 状态::材料未闭合:
                return {内部::初始化状态::材料未闭合};
            case 状态::资源失败:
                return {内部::初始化状态::资源失败};
            case 状态::已可能发布:
                return {内部::初始化状态::已可能发布};
            default:
                return {内部::初始化状态::内部不一致};
            }
        }
        if (!写入.当前值 || !写入.初始状态 || !写入.当前状态选择
            || !内部::值态符合规格(*写入.当前值, *写入.初始状态,
                *写入.当前状态选择, 写入.共同事实代次,
                初始化请求.唯一自我, 根.特征实例,
                根.一阶特征定义.值))
            return {内部::初始化状态::内部不一致};
        const auto* 首值 = std::get_if<std::int64_t>(
            &写入.当前值->类型化不可变材料);
        const auto* 首态值 = std::get_if<std::int64_t>(
            &写入.初始状态->精确值.类型化不可变材料);
        const auto* 首态时间 = std::get_if<std::int64_t>(
            &写入.初始状态->时间值.类型化不可变材料);
        if (!首值 || !首态值 || !首态时间
            || *首值 != 本能根初始值_v1 || *首态值 != 本能根初始值_v1
            || *首态时间 != static_cast<std::int64_t>(
                初始化请求.本次启动UTC纳秒))
            return {内部::初始化状态::内部不一致};
        return {内部::初始化状态::已恢复, true,
            写入.状态 == L2特征首值初始状态原子形成状态_v1::已提交};
    }

    内部::阶段结果_v1<L2特征比较注册身份> 确保比较注册(
        L2结构幂等身份 幂等身份, L2特征定义身份 定义) {
        const auto G0 = 读取当前事实代次();
        if (!G0) return {内部::初始化状态::内部不一致};
        const auto 当前 = 特征服务_.读取当前特征比较注册(
            {{L2结构合同版本, *G0}, 定义, L2特征比较用途::目标判断});
        if (当前.成功()) {
            if (当前.结果头.事实截止代次 != *G0 || !当前.注册
                || !内部::比较注册符合规格(
                    *当前.注册, *G0, 幂等身份, 定义))
                return {内部::初始化状态::引用冲突};
            return {内部::初始化状态::已恢复, 当前.注册->身份, false};
        }
        if (当前.结果头.状态 != L2结构状态::未找到)
            return {内部::映射结构失败(当前.结果头.状态)};
        const auto 写入 = 特征服务_.新增特征比较注册(
            {{L2结构合同版本, *G0}, 幂等身份, 定义,
                内部::形成比较合同材料(定义)});
        if (!写入.成功() || !写入.当前注册)
            return {内部::映射结构失败(写入.结果头.状态)};
        if (!内部::比较注册符合规格(*写入.当前注册,
                写入.结果头.事实截止代次, 幂等身份, 定义))
            return {内部::初始化状态::内部不一致};
        return {内部::初始化状态::已恢复, 写入.当前注册->身份,
            写入.结果头.状态 == L2结构状态::已提交};
    }

    内部::阶段结果_v1<L2目标状态合同身份> 确保目标合同(
        L2结构幂等身份 幂等身份, L2特征定义身份 定义,
        L2特征比较注册身份 比较注册) {
        const auto G0 = 读取当前事实代次();
        if (!G0) return {内部::初始化状态::内部不一致};
        const auto 首次 = 状态服务_.读取目标状态合同幂等首次完整事实_v1(
            {L2目标状态合同幂等首次完整读取合同版本_v1,
                {L2结构合同版本, *G0}, 幂等身份});
        if (首次.成功()) {
            if (首次.本次正式读回截止 != *G0 || !首次.合同
                || !内部::目标合同符合规格(
                    *首次.合同, *G0, 幂等身份, 定义, 比较注册))
                return {内部::初始化状态::引用冲突};
            return {内部::初始化状态::已恢复, 首次.合同->身份, false};
        }
        using 首次状态 = L2目标状态合同幂等首次完整读取状态_v1;
        if (首次.状态 != 首次状态::未找到) {
            switch (首次.状态) {
            case 首次状态::已退出:
                return {内部::初始化状态::角色已退出};
            case 首次状态::当前性漂移:
                return {内部::初始化状态::当前性漂移};
            case 首次状态::引用冲突:
                return {内部::初始化状态::引用冲突};
            case 首次状态::资源失败:
                return {内部::初始化状态::资源失败};
            default:
                return {内部::初始化状态::内部不一致};
            }
        }
        L2目标状态合同新增请求 请求;
        请求.请求头 = {L2结构合同版本, *G0};
        请求.幂等身份 = 幂等身份;
        请求.特征定义 = 定义;
        请求.比较注册 = 比较注册;
        请求.目标I64 = 本能根I64最大目标_v1;
        请求.允许关系位 = 内部::本能根目标允许关系位_v1;
        请求.规则版本 = L2目标状态合同规则版本;
        请求.来源稳定编码 = 比较注册.值;
        const auto 写入 = 状态服务_.新增目标状态合同(请求);
        if (!写入.成功() || !写入.当前合同)
            return {内部::映射结构失败(写入.结果头.状态)};
        if (!内部::目标合同符合规格(*写入.当前合同,
                写入.结果头.事实截止代次, 幂等身份, 定义, 比较注册))
            return {内部::初始化状态::内部不一致};
        return {内部::初始化状态::已恢复, 写入.当前合同->身份,
            写入.结果头.状态 == L2结构状态::已提交};
    }

    内部::阶段结果_v1<内部::根材料_v1> 确保根需求(
        const 内部::根幂等规格_v1& 规格,
        L2存在身份 自我, L2特征定义身份 定义,
        L2目标状态合同身份 合同) {
        const auto G0 = 读取当前事实代次();
        if (!G0) return {内部::初始化状态::内部不一致};
        const auto 列表查询 = 需求服务_.按精确目标查询需求列表项(
            {{L2结构合同版本, *G0}, 自我, 自我, 定义, 合同});
        if (!列表查询.成功() || 列表查询.结果头.事实截止代次 != *G0)
            return {内部::映射结构失败(列表查询.结果头.状态)};
        const auto 根组 = 需求服务_.按所属存在读取当前根需求组(
            {{L2结构合同版本, *G0}, 自我,
                内部::根需求读取数量预算_v1});
        if (!根组.成功() || 根组.结果头.事实截止代次 != *G0)
            return {内部::映射结构失败(根组.结果头.状态)};

        const L2需求事实* 现有根 = nullptr;
        for (const auto& 候选 : 根组.根需求组) {
            if (候选.目标宿主存在 != 自我
                || 候选.目标特征定义 != 定义
                || 候选.目标状态合同 != 合同) continue;
            if (现有根) return {内部::初始化状态::引用冲突};
            现有根 = &候选;
        }
        const L2需求列表项事实* 现有列表 =
            列表查询.唯一结果() ? &列表查询.列表项组.front() : nullptr;
        if (现有列表 && !内部::列表项符合目标(
                *现有列表, *G0, 自我, 定义, 合同))
            return {内部::初始化状态::引用冲突};
        if (现有根 && !内部::需求符合目标(
                *现有根, *G0, 自我, 定义, 合同))
            return {内部::初始化状态::引用冲突};

        if (现有根 && 现有列表) {
            const auto 闭包 = 验证根需求闭包(
                *G0, *现有根, *现有列表, 自我, 定义, 合同);
            if (闭包 != 内部::初始化状态::已恢复)
                return {闭包};
            内部::根材料_v1 材料;
            材料.根需求 = 现有根->身份;
            材料.列表项 = 现有列表->身份;
            return {内部::初始化状态::已恢复, 材料, false};
        }
        if (现有根 && !现有列表)
            return {内部::初始化状态::材料未闭合};

        内部::根材料_v1 材料;
        if (!现有列表) {
            L2新增需求并建立列表项请求 请求;
            请求.请求头 = {L2结构合同版本, *G0};
            请求.幂等身份 = 规格.建需求并建立列表项;
            请求.所属存在 = 自我;
            请求.目标宿主存在 = 自我;
            请求.目标特征定义 = 定义;
            请求.目标状态合同 = 合同;
            请求.父需求.reset();
            请求.父子顺序 = 0;
            请求.来源稳定编码 = 合同.值;
            const auto 写入 = 需求服务_.新增需求并建立列表项(请求);
            if (!写入.成功() || !写入.新建列表项 || !写入.新建需求
                || !写入.当前成员关系 || 写入.当前父关系)
                return {内部::映射结构失败(写入.结果头.状态)};
            if (!内部::列表项符合目标(*写入.新建列表项,
                    写入.结果头.事实截止代次, 自我, 定义, 合同)
                || !内部::需求符合目标(*写入.新建需求,
                    写入.结果头.事实截止代次, 自我, 定义, 合同)
                || 写入.当前成员关系->列表项 != 写入.新建列表项->身份
                || 写入.当前成员关系->需求 != 写入.新建需求->身份)
            {
                return {内部::初始化状态::内部不一致};
            }
            材料.根需求 = 写入.新建需求->身份;
            材料.列表项 = 写入.新建列表项->身份;
            return {内部::初始化状态::已恢复, 材料,
                写入.结果头.状态 == L2结构状态::已提交};
        }

        L2新增需求并加入既有列表项请求 请求;
        请求.请求头 = {L2结构合同版本, *G0};
        请求.幂等身份 = 规格.建需求并加入既有列表项;
        请求.既有列表项 = 现有列表->身份;
        请求.父需求.reset();
        请求.父子顺序 = 0;
        请求.来源稳定编码 = 合同.值;
        const auto 写入 = 需求服务_.新增需求并加入既有列表项(请求);
        if (!写入.成功() || !写入.新建需求
            || !写入.当前成员关系 || 写入.当前父关系)
            return {内部::映射结构失败(写入.结果头.状态)};
        if (!内部::需求符合目标(*写入.新建需求,
                写入.结果头.事实截止代次, 自我, 定义, 合同)
            || 写入.当前成员关系->列表项 != 现有列表->身份
            || 写入.当前成员关系->需求 != 写入.新建需求->身份)
            return {内部::初始化状态::内部不一致};
        材料.根需求 = 写入.新建需求->身份;
        材料.列表项 = 现有列表->身份;
        return {内部::初始化状态::已恢复, 材料,
            写入.结果头.状态 == L2结构状态::已提交};
    }

    内部::初始化状态 验证根需求闭包(
        std::uint64_t 截止, const L2需求事实& 需求,
        const L2需求列表项事实& 列表项,
        L2存在身份 自我, L2特征定义身份 定义,
        L2目标状态合同身份 合同) const {
        const auto 父 = 需求服务_.按子需求读取当前父需求(
            {{L2结构合同版本, 截止}, 需求.身份});
        if (!父.成功() || 父.结果头.事实截止代次 != 截止)
            return 内部::映射结构失败(父.结果头.状态);
        if (父.当前父关系 || 父.父需求)
            return 内部::初始化状态::引用冲突;
        const auto 成员 = 需求服务_.读取需求列表成员(
            {{L2结构合同版本, 截止}, L2读取类别::当前, 列表项.身份, 0});
        if (!成员.成功() || 成员.结果头.事实截止代次 != 截止)
            return 内部::映射结构失败(成员.结果头.状态);
        std::size_t 匹配数 = 0;
        for (std::size_t 索引 = 0; 索引 < 成员.成员关系组.size(); ++索引) {
            const auto& 关系 = 成员.成员关系组[索引];
            if (关系.列表项 == 列表项.身份 && 关系.需求 == 需求.身份
                && 成员.成员需求组[索引].身份 == 需求.身份) {
                if (!L2需求列表成员关系事实截止投影完整(关系, 截止)
                    || 关系.生命周期.退出事实代次
                    || !内部::需求符合目标(
                        需求, 截止, 自我, 定义, 合同))
                    return 内部::初始化状态::材料未闭合;
                ++匹配数;
            }
        }
        return 匹配数 == 1 ? 内部::初始化状态::已恢复
                           : 内部::初始化状态::材料未闭合;
    }

    内部::阶段结果_v1<本能根运行锚点_v1> 最终完整读回(
        std::uint64_t Gfinal, L2存在身份 自我,
        const 内部::根材料_v1& 安全,
        const 内部::根材料_v1& 服务) const {
        const auto 自我读取 = 存在服务_.读取完整存在(
            {{L2结构合同版本, Gfinal}, L2读取类别::当前, 自我, 0});
        if (!内部::当前读取头完整(自我读取.结果头, Gfinal)
            || !自我读取.存在 || 自我读取.存在->身份 != 自我
            || !L2存在事实完整(*自我读取.存在, Gfinal)
            || 自我读取.存在->生命周期.退出事实代次)
            return {内部::映射结构失败(自我读取.结果头.状态)};

        const auto 安全状态 = 最终读回一根(
            Gfinal, 自我, 内部::安全根幂等规格_v1, 安全);
        if (安全状态 != 内部::初始化状态::已恢复)
            return {安全状态};
        const auto 服务状态 = 最终读回一根(
            Gfinal, 自我, 内部::服务根幂等规格_v1, 服务);
        if (服务状态 != 内部::初始化状态::已恢复)
            return {服务状态};
        if (安全.比较注册 == 服务.比较注册)
            return {内部::初始化状态::引用冲突};

        本能根运行锚点_v1 锚点;
        锚点.唯一自我 = 自我;
        锚点.安全根需求 = 安全.根需求;
        锚点.安全根列表项 = 安全.列表项;
        锚点.安全根特征定义 = 安全.一阶特征定义;
        锚点.安全根特征实例 = 安全.特征实例;
        锚点.安全根目标合同 = 安全.目标合同;
        锚点.安全差值二次特征概念 = 安全.差值二次概念;
        锚点.服务根需求 = 服务.根需求;
        锚点.服务根列表项 = 服务.列表项;
        锚点.服务根特征定义 = 服务.一阶特征定义;
        锚点.服务根特征实例 = 服务.特征实例;
        锚点.服务根目标合同 = 服务.目标合同;
        锚点.服务差值二次特征概念 = 服务.差值二次概念;
        锚点.事实截止代次 = Gfinal;
        if (!锚点.完整()) return {内部::初始化状态::引用冲突};
        return {内部::初始化状态::已恢复, std::move(锚点), false};
    }

    内部::初始化状态 最终读回一根(
        std::uint64_t 截止, L2存在身份 自我,
        const 内部::根幂等规格_v1& 规格,
        const 内部::根材料_v1& 根) const {
        const auto 读取定义 = [&](L2结构幂等身份 幂等身份,
            L2特征定义身份 期望身份, std::uint32_t 阶次,
            std::optional<L2特征定义身份> 来源) -> 内部::初始化状态 {
            const auto 读取 = 特征服务_.按幂等身份读取统一特征定义首次完整事实(
                {L2统一特征定义幂等首次完整读取合同版本,
                    {L2结构合同版本, 截止}, 幂等身份});
            if (!读取.成功()) {
                if (读取.状态
                    == L2统一特征定义幂等首次完整读取状态::当前性漂移)
                    return 内部::初始化状态::当前性漂移;
                if (读取.状态
                    == L2统一特征定义幂等首次完整读取状态::资源失败)
                    return 内部::初始化状态::资源失败;
                return 内部::初始化状态::材料未闭合;
            }
            return 读取.本次正式读回截止 == 截止 && 读取.特征定义
                && 读取.特征定义->身份 == 期望身份
                && 内部::定义符合规格(*读取.特征定义, 截止, 阶次, 来源)
                ? 内部::初始化状态::已恢复
                : 内部::初始化状态::引用冲突;
        };
        auto 状态 = 读取定义(规格.一阶特征定义,
            根.一阶特征定义, 1, std::nullopt);
        if (状态 != 内部::初始化状态::已恢复) return 状态;
        状态 = 读取定义(规格.差值二次概念,
            根.差值二次概念, 2, 根.一阶特征定义);
        if (状态 != 内部::初始化状态::已恢复) return 状态;

        const auto 实例 = 特征服务_.读取完整特征实例(
            {{L2结构合同版本, 截止}, L2读取类别::当前,
                根.特征实例, 0});
        if (!内部::当前读取头完整(实例.结果头, 截止)
            || !实例.特征实例 || 实例.特征实例->身份 != 根.特征实例
            || !内部::实例符合规格(
                *实例.特征实例, 截止, 自我, 根.一阶特征定义))
            return 内部::映射结构失败(实例.结果头.状态);

        const auto 值 = 特征服务_.读取特征当前值(
            {{L2结构合同版本, 截止}, 根.特征实例});
        if (!值.成功() || 值.结果头.事实截止代次 != 截止 || !值.当前值)
            return 内部::映射结构失败(值.结果头.状态);
        const auto 值记录 = 验证已存在根值记录(
            截止, 根, *值.当前值);
        if (值记录 != 内部::初始化状态::已恢复) return 值记录;

        const auto 比较 = 特征服务_.读取当前特征比较注册(
            {{L2结构合同版本, 截止}, 根.一阶特征定义,
                L2特征比较用途::目标判断});
        if (!比较.成功() || 比较.结果头.事实截止代次 != 截止
            || !比较.注册 || 比较.注册->身份 != 根.比较注册
            || !内部::比较注册符合规格(
                *比较.注册, 截止, 规格.比较注册, 根.一阶特征定义))
            return 内部::映射结构失败(比较.结果头.状态);

        const auto 合同 = 状态服务_.读取目标状态合同幂等首次完整事实_v1(
            {L2目标状态合同幂等首次完整读取合同版本_v1,
                {L2结构合同版本, 截止}, 规格.目标合同});
        if (!合同.成功() || 合同.本次正式读回截止 != 截止 || !合同.合同
            || 合同.合同->身份 != 根.目标合同
            || !内部::目标合同符合规格(*合同.合同, 截止,
                规格.目标合同, 根.一阶特征定义, 根.比较注册)) {
            if (合同.状态
                == L2目标状态合同幂等首次完整读取状态_v1::当前性漂移)
                return 内部::初始化状态::当前性漂移;
            if (合同.状态
                == L2目标状态合同幂等首次完整读取状态_v1::已退出)
                return 内部::初始化状态::角色已退出;
            if (合同.状态
                == L2目标状态合同幂等首次完整读取状态_v1::资源失败)
                return 内部::初始化状态::资源失败;
            return 内部::初始化状态::引用冲突;
        }

        const auto 需求 = 需求服务_.读取需求完整(
            {{L2结构合同版本, 截止}, L2读取类别::当前, 根.根需求, 0});
        const auto 列表 = 需求服务_.读取需求列表项完整(
            {{L2结构合同版本, 截止}, L2读取类别::当前, 根.列表项, 0});
        if (!需求.成功() || 需求.结果头.事实截止代次 != 截止 || !需求.需求)
            return 内部::映射结构失败(需求.结果头.状态);
        if (!列表.成功() || 列表.结果头.事实截止代次 != 截止 || !列表.列表项)
            return 内部::映射结构失败(列表.结果头.状态);
        if (!内部::需求符合目标(*需求.需求, 截止,
                自我, 根.一阶特征定义, 根.目标合同)
            || !内部::列表项符合目标(*列表.列表项, 截止,
                自我, 根.一阶特征定义, 根.目标合同))
            return 内部::初始化状态::引用冲突;

        const auto 精确列表 = 需求服务_.按精确目标查询需求列表项(
            {{L2结构合同版本, 截止}, 自我, 自我,
                根.一阶特征定义, 根.目标合同});
        if (!精确列表.成功() || 精确列表.结果头.事实截止代次 != 截止
            || !精确列表.唯一结果()
            || 精确列表.列表项组.front().身份 != 根.列表项)
            return 内部::映射结构失败(精确列表.结果头.状态);
        const auto 根组 = 需求服务_.按所属存在读取当前根需求组(
            {{L2结构合同版本, 截止}, 自我,
                内部::根需求读取数量预算_v1});
        if (!根组.成功() || 根组.结果头.事实截止代次 != 截止)
            return 内部::映射结构失败(根组.结果头.状态);
        std::size_t 匹配根数 = 0;
        for (const auto& 候选 : 根组.根需求组)
            if (候选.身份 == 根.根需求
                && 内部::需求符合目标(候选, 截止,
                    自我, 根.一阶特征定义, 根.目标合同))
                ++匹配根数;
        if (匹配根数 != 1) return 内部::初始化状态::材料未闭合;
        const auto 闭包 = 验证根需求闭包(截止, *需求.需求, *列表.列表项,
            自我, 根.一阶特征定义, 根.目标合同);
        return 闭包;
    }

    const L2存在结构服务& 存在服务_;
    L2特征结构服务& 特征服务_;
    L2状态结构服务& 状态服务_;
    L2需求结构服务& 需求服务_;
};

} // namespace 海中鱼巣
