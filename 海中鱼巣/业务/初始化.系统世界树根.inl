namespace 海中鱼巣::系统世界树根初始化内部 {

inline bool 请求有效(const 系统世界树根初始化请求& 请求) noexcept {
    return 请求.合同版本 == 系统世界树根初始化合同版本
        && 请求.根建立幂等身份 == 海中鱼巣现实世界树根建立幂等身份;
}

inline bool 请求相同(const 系统世界树根初始化请求& 左,
    const 系统世界树根初始化请求& 右) noexcept {
    return 左.合同版本 == 右.合同版本
        && 左.根建立幂等身份 == 右.根建立幂等身份;
}

inline bool 生命周期相同(const L2生命周期& 左,
    const L2生命周期& 右) noexcept {
    return 左.创建事实代次 == 右.创建事实代次
        && 左.退出事实代次 == 右.退出事实代次;
}

inline bool 父子关系事实相同(const L2场景父子关系事实& 左,
    const L2场景父子关系事实& 右) noexcept {
    return 左.关系稳定编码 == 右.关系稳定编码
        && 左.父场景 == 右.父场景 && 左.子场景 == 右.子场景
        && 左.顺序 == 右.顺序 && 生命周期相同(左.生命周期, 右.生命周期);
}

inline bool 成员关系事实相同(const L2场景成员关系事实& 左,
    const L2场景成员关系事实& 右) noexcept {
    return 左.关系稳定编码 == 右.关系稳定编码
        && 左.场景 == 右.场景 && 左.存在 == 右.存在
        && 左.顺序 == 右.顺序 && 生命周期相同(左.生命周期, 右.生命周期);
}

inline bool 原始材料相同(const L2原始值材料& 左,
    const L2原始值材料& 右) noexcept {
    return std::visit([](const auto& 左值, const auto& 右值) noexcept {
        using 左类型 = std::remove_cvref_t<decltype(左值)>;
        using 右类型 = std::remove_cvref_t<decltype(右值)>;
        if constexpr (!std::is_same_v<左类型, 右类型>) return false;
        else if constexpr (std::is_same_v<左类型, L2独立材料引用>)
            return 左值.编码 == 右值.编码;
        else if constexpr (std::is_same_v<左类型, std::vector<std::int64_t>>
            || std::is_same_v<左类型, std::vector<std::uint64_t>>) {
            if (左值.size() != 右值.size()) return false;
            for (std::size_t 索引 = 0; 索引 < 左值.size(); ++索引)
                if (左值[索引] != 右值[索引]) return false;
            return true;
        } else return 左值 == 右值;
    }, 左, 右);
}

inline bool 属性事实相同(const L2属性事实& 左,
    const L2属性事实& 右) noexcept {
    return 左.属性类型身份 == 右.属性类型身份
        && 左.值稳定编码 == 右.值稳定编码
        && 原始材料相同(左.类型化不可变材料, 右.类型化不可变材料)
        && 左.来源稳定编码 == 右.来源稳定编码
        && 左.创建事实代次 == 右.创建事实代次
        && 左.退出事实代次 == 右.退出事实代次;
}

inline bool 场景事实相同(const L2场景事实& 左,
    const L2场景事实& 右) noexcept {
    if (左.身份 != 右.身份 || !生命周期相同(左.生命周期, 右.生命周期)
        || 左.固定属性.size() != 右.固定属性.size()
        || 左.直接子场景.size() != 右.直接子场景.size()
        || 左.直接成员.size() != 右.直接成员.size()) return false;
    for (std::size_t 索引 = 0; 索引 < 左.固定属性.size(); ++索引)
        if (!属性事实相同(左.固定属性[索引], 右.固定属性[索引])) return false;
    for (std::size_t 索引 = 0; 索引 < 左.直接子场景.size(); ++索引)
        if (!父子关系事实相同(左.直接子场景[索引], 右.直接子场景[索引]))
            return false;
    for (std::size_t 索引 = 0; 索引 < 左.直接成员.size(); ++索引)
        if (!成员关系事实相同(左.直接成员[索引], 右.直接成员[索引]))
            return false;
    return true;
}

inline bool 身份来源事实相同(const L2节点族身份来源事实& 左,
    const L2节点族身份来源事实& 右) noexcept {
    return 左.节点族 == 右.节点族 && 左.节点稳定编码 == 右.节点稳定编码
        && 左.族锚点稳定编码 == 右.族锚点稳定编码
        && 左.族归属关系类型稳定编码 == 右.族归属关系类型稳定编码
        && 左.族归属关系稳定编码 == 右.族归属关系稳定编码
        && 左.角色或顺序 == 右.角色或顺序
        && 生命周期相同(左.节点生命周期, 右.节点生命周期)
        && 生命周期相同(左.族锚点生命周期, 右.族锚点生命周期)
        && 生命周期相同(左.关系类型生命周期, 右.关系类型生命周期)
        && 生命周期相同(左.归属关系生命周期, 右.归属关系生命周期);
}

inline bool 树归属事实相同(const L2场景树归属事实& 左,
    const L2场景树归属事实& 右) noexcept {
    return 左.树 == 右.树 && 左.场景 == 右.场景 && 左.根场景 == 右.根场景
        && 左.类别 == 右.类别 && 左.关系稳定编码 == 右.关系稳定编码
        && 左.物理目标稳定编码 == 右.物理目标稳定编码
        && 生命周期相同(左.生命周期, 右.生命周期);
}

inline bool 树节点事实相同(const L2场景树节点事实& 左,
    const L2场景树节点事实& 右) noexcept {
    return 场景事实相同(左.场景, 右.场景)
        && 身份来源事实相同(左.场景身份来源, 右.场景身份来源)
        && 树归属事实相同(左.树归属, 右.树归属);
}

inline bool 场景树事实相同(const L2场景树事实& 左,
    const L2场景树事实& 右) noexcept {
    if (左.树 != 右.树 || 左.根场景 != 右.根场景
        || 左.结构登记 != 右.结构登记 || 左.根标记 != 右.根标记
        || 左.事实截止代次 != 右.事实截止代次
        || 左.场景组.size() != 右.场景组.size()
        || 左.父子关系组.size() != 右.父子关系组.size()) return false;
    for (std::size_t 索引 = 0; 索引 < 左.场景组.size(); ++索引)
        if (!树节点事实相同(左.场景组[索引], 右.场景组[索引])) return false;
    for (std::size_t 索引 = 0; 索引 < 左.父子关系组.size(); ++索引)
        if (!父子关系事实相同(左.父子关系组[索引], 右.父子关系组[索引]))
            return false;
    return true;
}

inline bool 根写入反例(const L2场景树节点写入结果& 结果) noexcept {
    return !结果.树 || !结果.场景节点 || 结果.直接父关系
        || 结果.场景节点->树归属.类别 != L2场景树归属类别::根
        || 结果.场景节点->树归属.树 != *结果.树
        || 结果.场景节点->树归属.场景 != 结果.场景节点->场景.身份
        || 结果.场景节点->树归属.根场景 != 结果.场景节点->场景.身份
        || 结果.树->值 != 结果.场景节点->场景.身份.值
        || 结果.场景节点->场景.生命周期.创建事实代次
            != 结果.结果头.事实截止代次
        || 结果.场景节点->树归属.生命周期.创建事实代次
            != 结果.结果头.事实截止代次;
}

inline bool 根读回一致(const 系统世界树根初始化请求& 选择,
    const L2场景树根建立请求& 首次请求,
    const L2场景树节点写入结果* 根建立,
    const 系统世界树根读回* 既有发布,
    const L2场景树结构登记结果& 登记,
    const L2场景树读取结果& 读取) noexcept {
    if (!登记.成功() || !登记.登记 || !读取.成功() || !读取.树
        || 读取.读取类别 != L2读取类别::当前
        || 读取.历史截止事实代次 != 0
        || 读取.结果头.事实截止代次 != 登记.结果头.事实截止代次
        || 读取.结果头.事实截止代次 == 0
        || 读取.树->结构登记 != *登记.登记
        || !L2场景树事实完整(*读取.树)
        || 读取.树->树.值 != 读取.树->根场景.值
        || 读取.树->根标记.树 != 读取.树->树
        || 读取.树->根标记.场景 != 读取.树->根场景
        || 读取.树->根标记.根场景 != 读取.树->根场景
        || 读取.树->根标记.类别 != L2场景树归属类别::根) return false;
    const L2场景树节点事实* 根节点 = nullptr;
    for (const auto& 节点 : 读取.树->场景组)
        if (节点.场景.身份 == 读取.树->根场景) { 根节点 = &节点; break; }
    bool 根具有父关系 = false;
    for (const auto& 关系 : 读取.树->父子关系组)
        if (关系.子场景 == 读取.树->根场景) { 根具有父关系 = true; break; }
    if (!根节点 || 根节点->树归属 != 读取.树->根标记 || 根具有父关系)
        return false;
    if (根建立) return !根写入反例(*根建立)
        && 读取.树->树 == *根建立->树
        && 读取.树->根场景 == 根建立->场景节点->场景.身份
        && 读取.树->根标记 == 根建立->场景节点->树归属
        && 根节点->场景.身份 == 根建立->场景节点->场景.身份
        && 根节点->场景.生命周期 == 根建立->场景节点->场景.生命周期;
    return 既有发布 && 请求相同(既有发布->选择, 选择)
        && 既有发布->首次建立请求 == 首次请求
        && 既有发布->事实截止代次
            == 既有发布->正式树读回.事实截止代次
        && 既有发布->事实截止代次
            == 登记.结果头.事实截止代次
        && 既有发布->事实截止代次
            == 读取.结果头.事实截止代次
        && 读取.树->树 == 既有发布->树
        && 读取.树->根场景 == 既有发布->根场景
        && 读取.树->根标记 == 既有发布->正式树读回.根标记;
}

inline 系统世界树根初始化结果 形成自身失败(
    系统世界树根初始化状态 状态) noexcept {
    return {状态, std::nullopt, std::nullopt, std::nullopt,
        std::nullopt, std::nullopt, std::nullopt};
}

template<class 场景结构访问器>
系统世界树根初始化结果 编排系统世界树根初始化(
    std::mutex& 发布锁,
    std::optional<L2场景树根建立请求>& 待收敛请求,
    std::optional<系统世界树根读回>& 已发布读回,
    const 系统世界树根初始化请求& 请求,
    场景结构访问器& 场景访问) noexcept {
    if (!请求有效(请求))
        return 形成自身失败(系统世界树根初始化状态::请求无效);
    try {
        std::lock_guard<std::mutex> 锁(发布锁);
        if (已发布读回 && !请求相同(已发布读回->选择, 请求))
            return 形成自身失败(系统世界树根初始化状态::已发布选择冲突);
        if (待收敛请求 && 待收敛请求->幂等身份 != 请求.根建立幂等身份)
            return 形成自身失败(系统世界树根初始化状态::已发布选择冲突);
        const bool 已发布重复 = 已发布读回.has_value();
        const bool 待收敛 = !已发布重复 && 待收敛请求.has_value();
        std::optional<L2场景树结构登记结果> 建立前登记;
        std::optional<L2场景树节点写入结果> 根建立;
        L2场景树根建立请求 首次请求;
        if (已发布重复) 首次请求 = 已发布读回->首次建立请求;
        else if (待收敛) 首次请求 = *待收敛请求;
        else {
            建立前登记 = 场景访问.读取当前场景树结构登记();
            if (!建立前登记->成功() || !建立前登记->登记)
                return {系统世界树根初始化状态::树结构登记读取失败,
                    std::nullopt, std::move(建立前登记), std::nullopt,
                    std::nullopt, std::nullopt, std::nullopt};
            首次请求 = {{L2结构合同版本,
                建立前登记->结果头.事实截止代次}, 请求.根建立幂等身份};
            if (!L2场景树根建立请求有效(首次请求))
                return 形成自身失败(系统世界树根初始化状态::内部不一致);
            待收敛请求 = 首次请求;
        }
        if (!已发布重复) {
            根建立 = 场景访问.建立场景树根(首次请求);
            const auto 状态 = 根建立->结果头.状态;
            const bool 路径成功 = 根建立->成功()
                && ((!待收敛 && 状态 == L2结构状态::已提交)
                    || (待收敛 && 状态 == L2结构状态::精确重复));
            if (!路径成功) {
                if ((状态 == L2结构状态::已提交
                        || 状态 == L2结构状态::精确重复) || 根建立->成功())
                    return 形成自身失败(系统世界树根初始化状态::内部不一致);
                const bool 可重组 = 状态 == L2结构状态::事实代次漂移
                    && !根建立->结果头.变更事实代次 && !根建立->树
                    && !根建立->场景节点 && !根建立->直接父关系;
                if (可重组) 待收敛请求.reset();
                return {系统世界树根初始化状态::根建立失败,
                    std::nullopt, std::move(建立前登记), std::move(根建立),
                    std::nullopt, std::nullopt, std::nullopt};
            }
            if (根写入反例(*根建立))
                return 形成自身失败(系统世界树根初始化状态::内部不一致);
        }
        auto 读回前登记 = 场景访问.读取当前场景树结构登记();
        if (!读回前登记.成功() || !读回前登记.登记)
            return {系统世界树根初始化状态::树结构登记读取失败,
                std::nullopt, std::move(建立前登记), std::move(根建立),
                std::move(读回前登记), std::nullopt, std::nullopt};
        const auto 树 = 已发布重复 ? 已发布读回->树 : *根建立->树;
        auto 根读取 = 场景访问.读取场景树({
            {L2结构合同版本, 读回前登记.结果头.事实截止代次},
            L2读取类别::当前, 树, 0});
        if (!根读取.成功() || !根读取.树) {
            const auto 状态 = 根读取.结果头.状态 == L2结构状态::已读取
                ? 系统世界树根初始化状态::根读回不一致
                : 系统世界树根初始化状态::根正式读回失败;
            return {状态, std::nullopt, std::move(建立前登记),
                std::move(根建立), std::move(读回前登记),
                std::move(根读取), std::nullopt};
        }
        if (!根读回一致(请求, 首次请求, 根建立 ? &*根建立 : nullptr,
                已发布读回 ? &*已发布读回 : nullptr, 读回前登记, 根读取))
            return {系统世界树根初始化状态::根读回不一致,
                std::nullopt, std::move(建立前登记), std::move(根建立),
                std::move(读回前登记), std::move(根读取), std::nullopt};
        系统世界树根读回 新发布{请求, 首次请求, 根读取.树->树,
            根读取.树->根场景, *根读取.树, 根读取.结果头.事实截止代次};
        const auto 来源 = 已发布重复
            ? 系统世界树根发布来源::已发布重复消费
            : 待收敛 ? 系统世界树根发布来源::待收敛精确重复
                : 系统世界树根发布来源::首次建立;
        const auto 状态 = 来源 == 系统世界树根发布来源::首次建立
            ? 系统世界树根初始化状态::已发布
            : 系统世界树根初始化状态::精确重复;
        系统世界树根初始化结果 结果{状态, 来源,
            std::move(建立前登记), std::move(根建立),
            std::move(读回前登记), std::move(根读取), 新发布};
        if (!结果.成功())
            return 形成自身失败(系统世界树根初始化状态::内部不一致);
        std::optional<系统世界树根读回> 发布槽{std::move(新发布)};
        static_assert(noexcept(已发布读回.swap(发布槽)));
        已发布读回.swap(发布槽);
        待收敛请求.reset();
        return 结果;
    } catch (const std::bad_alloc&) {
        return 形成自身失败(系统世界树根初始化状态::资源失败);
    } catch (...) {
        return 形成自身失败(系统世界树根初始化状态::内部不一致);
    }
}

}
