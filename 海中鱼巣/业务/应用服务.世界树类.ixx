export module 海中鱼巣.业务.应用服务.世界树类;

import 海中鱼巣.领域.数据服务.场景类;

export namespace 海中鱼巣 {

inline constexpr std::uint32_t 世界树应用合同版本 = 1;

enum class 世界树成员种类 : std::uint8_t {
    场景 = 1,
    存在 = 2
};

enum class 世界树应用阶段 : std::uint8_t {
    无 = 0,
    现实树预读 = 1,
    场景成员原子迁移 = 2,
    现实树最终确认 = 3,
    场景创建接纳 = 4,
    现实树创建确认 = 5,
    存在创建 = 6,
    场景存在接纳 = 7,
    现实树存在确认 = 8
};

enum class 世界树应用状态 : std::uint8_t {
    已验证现实根 = 1,
    已读取成员位置 = 2,
    已移动 = 3,
    精确重复 = 4,
    入口拒绝 = 5,
    现实根未找到 = 6,
    现实根已退出 = 7,
    现实根不是结构根 = 8,
    世界结构预算不足 = 9,
    世界结构不一致 = 10,
    场景不在现实世界 = 11,
    存在不在现实世界 = 12,
    成员多重位置 = 13,
    现实根不可移动 = 14,
    原位置不匹配 = 15,
    目标位置相同 = 16,
    成员已在目标但非精确重放 = 17,
    形成场景环 = 18,
    事实代次漂移 = 19,
    幂等冲突 = 20,
    引用冲突 = 21,
    历史材料已清理 = 22,
    资源失败 = 23,
    内部不一致 = 24,
    已发布待复核 = 25,
    结果未知 = 26,
    既有迁移已被后继事实覆盖 = 27,
    已创建并纳入现实世界 = 28,
    既有创建已被后继事实覆盖 = 29,
    观察代次无法确认 = 30,
    已创建存在并纳入现实世界 = 31,
    存在已创建待接纳 = 32,
    既有存在接纳已被后继事实覆盖 = 33,
    存在已有场景 = 34,
    存在多重位置 = 35
};

struct 世界树结构读取请求 final {
    std::uint32_t 合同版本 = 世界树应用合同版本;
    std::uint64_t 读取事实代次 = 0;
    std::uint64_t 最大场景数量 = 0;
    friend bool operator==(const 世界树结构读取请求&,
        const 世界树结构读取请求&) = default;
};

struct 世界树存在位置读取请求 final {
    std::uint32_t 合同版本 = 世界树应用合同版本;
    std::uint64_t 读取事实代次 = 0;
    稳定编码 存在{};
    std::uint64_t 最大场景数量 = 0;
    friend bool operator==(const 世界树存在位置读取请求&,
        const 世界树存在位置读取请求&) = default;
};

struct 世界树成员移动请求 final {
    std::uint32_t 合同版本 = 世界树应用合同版本;
    std::uint64_t 读取事实代次 = 0;
    std::uint64_t 迁移期望事实代次 = 0;
    L1所有者范围写入幂等身份 迁移幂等身份{};
    稳定编码 原场景{};
    稳定编码 目标场景{};
    稳定编码 成员{};
    std::uint64_t 最大场景数量 = 0;
    friend bool operator==(const 世界树成员移动请求&,
        const 世界树成员移动请求&) = default;
};

struct 世界树场景创建请求 final {
    std::uint32_t 合同版本 = 世界树应用合同版本;
    std::uint64_t 创建期望事实代次 = 0;
    std::uint64_t 观察事实代次 = 0;
    L1所有者范围写入幂等身份 创建幂等身份{};
    稳定编码 父场景{};
    std::uint64_t 最大场景数量 = 0;
    friend bool operator==(const 世界树场景创建请求&,
        const 世界树场景创建请求&) = default;
};

struct 世界树场景创建重试材料 final {
    std::uint64_t 创建期望事实代次 = 0;
    L1所有者范围写入幂等身份 创建幂等身份{};
    稳定编码 父场景{};
    friend bool operator==(const 世界树场景创建重试材料&,
        const 世界树场景创建重试材料&) = default;
};

struct 世界树现实结构 final {
    稳定编码 现实根场景{};
    std::vector<场景类结点> 场景组;
    friend bool operator==(const 世界树现实结构&,
        const 世界树现实结构&) = default;
};

struct 世界树成员位置 final {
    世界树成员种类 成员种类 = 世界树成员种类::存在;
    稳定编码 成员{};
    稳定编码 所在场景{};
    稳定编码 成员关系{};
    friend bool operator==(const 世界树成员位置&,
        const 世界树成员位置&) = default;
};

struct 世界树成员移动投影 final {
    世界树成员种类 成员种类 = 世界树成员种类::存在;
    稳定编码 成员{};
    稳定编码 原场景{};
    稳定编码 目标场景{};
    稳定编码 旧成员关系{};
    稳定编码 新成员关系{};
    std::uint64_t 首次发布事实代次 = 0;
    std::uint64_t 确认事实代次 = 0;
    friend bool operator==(const 世界树成员移动投影&,
        const 世界树成员移动投影&) = default;
};

struct 世界树场景创建投影 final {
    稳定编码 现实根场景{};
    稳定编码 父场景{};
    稳定编码 新场景{};
    稳定编码 接纳关系{};
    std::uint64_t 首次发布事实代次 = 0;
    std::uint64_t 确认事实代次 = 0;
    friend bool operator==(const 世界树场景创建投影&,
        const 世界树场景创建投影&) = default;
};

struct 世界树现实根结果 final {
    世界树应用状态 状态 = 世界树应用状态::入口拒绝;
    std::uint32_t 合同版本 = 世界树应用合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<世界树现实结构> 现实结构;

    bool 成功() const noexcept {
        if (状态 != 世界树应用状态::已验证现实根
            || 合同版本 != 世界树应用合同版本
            || 事实代次 == 0 || !现实结构
            || !有效(现实结构->现实根场景)
            || 现实结构->场景组.empty())
            return false;
        return std::count_if(现实结构->场景组.begin(),
            现实结构->场景组.end(), [&](const auto& 场景) noexcept {
                return 场景.结点 == 现实结构->现实根场景;
            }) == 1;
    }
};

struct 世界树成员位置结果 final {
    世界树应用状态 状态 = 世界树应用状态::入口拒绝;
    std::uint32_t 合同版本 = 世界树应用合同版本;
    std::uint64_t 事实代次 = 0;
    std::optional<世界树成员位置> 位置;

    bool 成功() const noexcept {
        return 状态 == 世界树应用状态::已读取成员位置
            && 合同版本 == 世界树应用合同版本
            && 事实代次 != 0 && 位置
            && (位置->成员种类 == 世界树成员种类::场景
                || 位置->成员种类 == 世界树成员种类::存在)
            && 有效(位置->成员) && 有效(位置->所在场景)
            && 有效(位置->成员关系);
    }
};

struct 世界树移动结果 final {
    世界树应用状态 状态 = 世界树应用状态::入口拒绝;
    std::uint32_t 合同版本 = 世界树应用合同版本;
    世界树应用阶段 阶段 = 世界树应用阶段::无;
    std::uint64_t 观察事实代次 = 0;
    std::optional<std::uint64_t> 已发布事实代次;
    std::optional<世界树成员移动投影> 投影;

    bool 成功() const noexcept {
        if ((状态 != 世界树应用状态::已移动
                && 状态 != 世界树应用状态::精确重复)
            || 合同版本 != 世界树应用合同版本
            || 阶段 != 世界树应用阶段::现实树最终确认
            || 观察事实代次 == 0 || !已发布事实代次
            || !投影 || *已发布事实代次 == 0)
            return false;
        const auto& 完整投影 = *投影;
        return 完整投影.首次发布事实代次 == *已发布事实代次
            && 完整投影.确认事实代次 == 观察事实代次
            && (完整投影.成员种类 == 世界树成员种类::场景
                || 完整投影.成员种类 == 世界树成员种类::存在)
            && 有效(完整投影.成员) && 有效(完整投影.原场景)
            && 有效(完整投影.目标场景) && 完整投影.原场景 != 完整投影.目标场景
            && 有效(完整投影.旧成员关系) && 有效(完整投影.新成员关系)
            && 完整投影.旧成员关系 != 完整投影.新成员关系;
    }
};

struct 世界树场景创建结果 final {
    世界树应用状态 状态 = 世界树应用状态::入口拒绝;
    std::uint32_t 合同版本 = 世界树应用合同版本;
    世界树应用阶段 阶段 = 世界树应用阶段::无;
    std::uint64_t 请求观察事实代次 = 0;
    std::uint64_t 本次确认事实代次 = 0;
    std::optional<std::uint64_t> 已发布事实代次;
    std::optional<世界树场景创建重试材料> 重试材料;
    std::optional<世界树场景创建投影> 投影;

    bool 成功() const noexcept {
        if ((状态 != 世界树应用状态::已创建并纳入现实世界
                && 状态 != 世界树应用状态::精确重复)
            || 合同版本 != 世界树应用合同版本
            || 阶段 != 世界树应用阶段::现实树创建确认
            || 请求观察事实代次 == 0 || 本次确认事实代次 == 0
            || !已发布事实代次 || *已发布事实代次 == 0
            || !重试材料 || !投影)
            return false;
        return 投影->首次发布事实代次 == *已发布事实代次
            && 投影->确认事实代次 == 本次确认事实代次
            && 投影->确认事实代次 >= 投影->首次发布事实代次
            && 重试材料->创建期望事实代次 != 0
            && 请求观察事实代次 >= 重试材料->创建期望事实代次
            && *已发布事实代次 >= 重试材料->创建期望事实代次
            && 有效(重试材料->创建幂等身份)
            && 有效(重试材料->父场景)
            && 有效(投影->现实根场景) && 有效(投影->父场景)
            && 有效(投影->新场景) && 有效(投影->接纳关系)
            && 投影->父场景 == 重试材料->父场景
            && 投影->现实根场景 != 投影->新场景
            && 投影->现实根场景 != 投影->接纳关系
            && 投影->父场景 != 投影->新场景
            && 投影->父场景 != 投影->接纳关系
            && 投影->新场景 != 投影->接纳关系;
    }
};

struct 世界树存在创建请求 final {
    std::uint32_t 合同版本 = 世界树应用合同版本;
    std::uint64_t 存在创建期望事实代次 = 0;
    std::uint64_t 观察事实代次 = 0;
    L1所有者范围写入幂等身份 存在创建幂等身份{};
    L1所有者范围写入幂等身份 场景接纳幂等身份{};
    稳定编码 目标场景{};
    std::optional<std::uint64_t> 已固定接纳期望事实代次;
    std::uint64_t 最大场景数量 = 0;
    std::uint64_t 最大存在关系数量 = 0;
    friend bool operator==(const 世界树存在创建请求&,
        const 世界树存在创建请求&) = default;
};

struct 世界树存在创建重试材料 final {
    std::uint64_t 存在创建期望事实代次 = 0;
    L1所有者范围写入幂等身份 存在创建幂等身份{};
    L1所有者范围写入幂等身份 场景接纳幂等身份{};
    稳定编码 目标场景{};
    std::optional<std::uint64_t> 已固定接纳期望事实代次;
    friend bool operator==(const 世界树存在创建重试材料&,
        const 世界树存在创建重试材料&) = default;
};

struct 世界树存在创建进度 final {
    稳定编码 存在{};
    std::uint64_t 存在首次发布事实代次 = 0;
    std::optional<std::uint64_t> 接纳首次发布事实代次;
    std::optional<稳定编码> 接纳关系;
    friend bool operator==(const 世界树存在创建进度&,
        const 世界树存在创建进度&) = default;
};

struct 世界树存在创建投影 final {
    稳定编码 现实根场景{};
    稳定编码 目标场景{};
    稳定编码 存在{};
    稳定编码 接纳关系{};
    std::uint64_t 存在首次发布事实代次 = 0;
    std::uint64_t 接纳首次发布事实代次 = 0;
    std::uint64_t 确认事实代次 = 0;
    friend bool operator==(const 世界树存在创建投影&,
        const 世界树存在创建投影&) = default;
};

struct 世界树存在创建结果 final {
    世界树应用状态 状态 = 世界树应用状态::入口拒绝;
    std::uint32_t 合同版本 = 世界树应用合同版本;
    世界树应用阶段 阶段 = 世界树应用阶段::无;
    std::uint64_t 请求观察事实代次 = 0;
    std::uint64_t 本次确认事实代次 = 0;
    std::optional<世界树存在创建重试材料> 重试材料;
    std::optional<世界树存在创建进度> 进度;
    std::optional<世界树存在创建投影> 投影;

    bool 成功() const noexcept {
        if ((状态 != 世界树应用状态::已创建存在并纳入现实世界
                && 状态 != 世界树应用状态::精确重复)
            || 合同版本 != 世界树应用合同版本
            || 阶段 != 世界树应用阶段::现实树存在确认
            || 请求观察事实代次 == 0 || 本次确认事实代次 == 0
            || !重试材料 || !进度 || !投影)
            return false;
        return 有效(重试材料->存在创建幂等身份)
            && 有效(重试材料->场景接纳幂等身份)
            && 重试材料->存在创建幂等身份
                != 重试材料->场景接纳幂等身份
            && 有效(重试材料->目标场景)
            && 重试材料->存在创建期望事实代次 != 0
            && 请求观察事实代次
                >= 重试材料->存在创建期望事实代次
            && 重试材料->已固定接纳期望事实代次
            && *重试材料->已固定接纳期望事实代次 != 0
            && *重试材料->已固定接纳期望事实代次
                >= 重试材料->存在创建期望事实代次
            && 有效(进度->存在)
            && 进度->存在首次发布事实代次 != 0
            && 进度->存在首次发布事实代次
                >= 重试材料->存在创建期望事实代次
            && 进度->接纳首次发布事实代次
            && 进度->接纳关系
            && 有效(*进度->接纳关系)
            && *进度->接纳首次发布事实代次
                >= *重试材料->已固定接纳期望事实代次
            && *进度->接纳首次发布事实代次
                >= 进度->存在首次发布事实代次
            && 有效(投影->现实根场景)
            && 有效(投影->目标场景)
            && 有效(投影->存在)
            && 有效(投影->接纳关系)
            && 投影->现实根场景 != 投影->存在
            && 投影->现实根场景 != 投影->接纳关系
            && 投影->目标场景 != 投影->存在
            && 投影->目标场景 != 投影->接纳关系
            && 投影->存在 != 投影->接纳关系
            && 投影->目标场景 == 重试材料->目标场景
            && 投影->存在 == 进度->存在
            && 投影->接纳关系 == *进度->接纳关系
            && 投影->存在首次发布事实代次
                == 进度->存在首次发布事实代次
            && 投影->接纳首次发布事实代次
                == *进度->接纳首次发布事实代次
            && 投影->确认事实代次 == 本次确认事实代次
            && 本次确认事实代次 >= 投影->存在首次发布事实代次
            && 本次确认事实代次 >= 投影->接纳首次发布事实代次;
    }
};

class 世界树应用服务 final {
public:
    世界树应用服务() = delete;
    世界树应用服务(const 世界树应用服务&) = delete;
    世界树应用服务& operator=(const 世界树应用服务&) = delete;
    世界树应用服务(世界树应用服务&&) = delete;
    世界树应用服务& operator=(世界树应用服务&&) = delete;

    世界树应用服务(场景类数据服务& 场景服务,
        存在类数据服务& 存在服务, 稳定编码 现实世界根场景)
        : 场景服务_(场景服务), 存在服务_(存在服务),
          现实世界根场景_(现实世界根场景) {
        if (!有效(现实世界根场景_)
            || !场景服务_.使用存在服务(存在服务_))
            throw std::invalid_argument("invalid reality root scene");
    }

    世界树现实根结果 验证现实世界根(
        const 世界树结构读取请求& 请求) const noexcept {
        if (请求.合同版本 != 世界树应用合同版本
            || 请求.读取事实代次 == 0 || 请求.最大场景数量 == 0)
            return 现实根失败(世界树应用状态::入口拒绝);
        try {
            const auto 树 = 场景服务_.查询场景树({
                场景类数据合同版本, 请求.读取事实代次,
                现实世界根场景_, 请求.最大场景数量});
            if (!树.成功() || 树.状态 != 场景类数据状态::已读取)
                return 现实根失败(映射树读取状态(树.状态), 树.事实代次);
            if (树.合同版本 != 场景类数据合同版本
                || 树.事实代次 != 请求.读取事实代次
                || 树.根场景结点 != 现实世界根场景_
                || 树.场景组.empty() || !场景组形状有效(树.场景组)
                || std::count_if(树.场景组.begin(), 树.场景组.end(),
                    [&](const auto& 场景) noexcept {
                        return 场景.结点 == 现实世界根场景_;
                    }) != 1)
                return 现实根失败(世界树应用状态::世界结构不一致, 树.事实代次);
            return {世界树应用状态::已验证现实根,
                世界树应用合同版本, 树.事实代次,
                世界树现实结构{现实世界根场景_, 树.场景组}};
        } catch (const std::bad_alloc&) {
            return 现实根失败(世界树应用状态::资源失败);
        } catch (const std::length_error&) {
            return 现实根失败(世界树应用状态::资源失败);
        } catch (...) {
            return 现实根失败(世界树应用状态::内部不一致);
        }
    }

    世界树成员位置结果 读取现实世界存在位置(
        const 世界树存在位置读取请求& 请求) const noexcept {
        if (请求.合同版本 != 世界树应用合同版本
            || 请求.读取事实代次 == 0 || !有效(请求.存在)
            || 请求.最大场景数量 == 0)
            return 位置失败(世界树应用状态::入口拒绝);
        try {
            const auto 根 = 验证现实世界根({
                世界树应用合同版本, 请求.读取事实代次,
                请求.最大场景数量});
            if (!根.成功() || !根.现实结构)
                return 位置失败(根.状态, 根.事实代次);
            return 定位存在(*根.现实结构, 请求.存在, 根.事实代次);
        } catch (const std::bad_alloc&) {
            return 位置失败(世界树应用状态::资源失败);
        } catch (const std::length_error&) {
            return 位置失败(世界树应用状态::资源失败);
        } catch (...) {
            return 位置失败(世界树应用状态::内部不一致);
        }
    }

    世界树移动结果 移动现实世界存在(
        const 世界树成员移动请求& 请求) noexcept {
        return 移动现实世界成员(请求, 世界树成员种类::存在);
    }

    世界树移动结果 移动现实世界场景(
        const 世界树成员移动请求& 请求) noexcept {
        return 移动现实世界成员(请求, 世界树成员种类::场景);
    }

    世界树场景创建结果 创建场景并纳入现实世界(
        const 世界树场景创建请求& 请求) noexcept {
        return 执行现实世界场景创建(请求);
    }

    世界树存在创建结果 创建存在并纳入现实世界(
        const 世界树存在创建请求& 请求) noexcept {
        return 执行现实世界存在创建(请求);
    }

private:
    static bool 存在创建请求有效(
        const 世界树存在创建请求& 请求) noexcept {
        return 请求.合同版本 == 世界树应用合同版本
            && 请求.存在创建期望事实代次 != 0
            && 请求.观察事实代次 >= 请求.存在创建期望事实代次
            && 有效(请求.存在创建幂等身份)
            && 有效(请求.场景接纳幂等身份)
            && 请求.存在创建幂等身份 != 请求.场景接纳幂等身份
            && 有效(请求.目标场景)
            && 请求.最大场景数量 != 0
            && 请求.最大存在关系数量 != 0
            && (!请求.已固定接纳期望事实代次
                || (*请求.已固定接纳期望事实代次
                        >= 请求.存在创建期望事实代次
                    && *请求.已固定接纳期望事实代次
                        <= 请求.观察事实代次));
    }

    static 世界树存在创建重试材料 形成存在创建重试材料(
        const 世界树存在创建请求& 请求,
        std::optional<std::uint64_t> 固定代次) noexcept {
        return {请求.存在创建期望事实代次,
            请求.存在创建幂等身份, 请求.场景接纳幂等身份,
            请求.目标场景, 固定代次};
    }

    static 世界树存在创建结果 存在创建初始失败(
        世界树应用状态 状态,
        世界树应用阶段 阶段 = 世界树应用阶段::无,
        std::uint64_t 观察事实代次 = 0) noexcept {
        return {状态, 世界树应用合同版本, 阶段,
            观察事实代次, 0, std::nullopt,
            std::nullopt, std::nullopt};
    }

    static 世界树存在创建结果 存在创建未取得身份结果(
        世界树应用状态 状态, 世界树应用阶段 阶段,
        const 世界树存在创建请求& 请求) noexcept {
        return {状态, 世界树应用合同版本, 阶段,
            请求.观察事实代次, 0,
            形成存在创建重试材料(
                请求, 请求.已固定接纳期望事实代次),
            std::nullopt, std::nullopt};
    }

    static 世界树存在创建结果 存在创建已取得身份结果(
        世界树应用状态 状态, 世界树应用阶段 阶段,
        const 世界树存在创建请求& 请求,
        const 世界树存在创建进度& 进度,
        std::optional<std::uint64_t> 固定代次,
        std::uint64_t 确认代次 = 0,
        std::optional<世界树存在创建投影> 投影 = std::nullopt) noexcept {
        return {状态, 世界树应用合同版本, 阶段,
            请求.观察事实代次, 确认代次,
            形成存在创建重试材料(请求, 固定代次),
            进度, std::move(投影)};
    }

    static 世界树应用状态 映射存在创建状态(
        存在类数据状态 状态) noexcept {
        switch (状态) {
        case 存在类数据状态::入口拒绝:
            return 世界树应用状态::入口拒绝;
        case 存在类数据状态::事实代次漂移:
            return 世界树应用状态::事实代次漂移;
        case 存在类数据状态::幂等冲突:
            return 世界树应用状态::幂等冲突;
        case 存在类数据状态::引用冲突:
        case 存在类数据状态::结构类型未找到:
        case 存在类数据状态::结构类型已退出:
            return 世界树应用状态::引用冲突;
        case 存在类数据状态::历史材料已清理:
            return 世界树应用状态::历史材料已清理;
        case 存在类数据状态::资源失败:
            return 世界树应用状态::资源失败;
        case 存在类数据状态::已可能发布:
            return 世界树应用状态::结果未知;
        default:
            return 世界树应用状态::内部不一致;
        }
    }

    static 世界树应用状态 映射存在历史状态(
        特征引用读取状态 状态) noexcept {
        switch (状态) {
        case 特征引用读取状态::入口拒绝:
            return 世界树应用状态::入口拒绝;
        case 特征引用读取状态::未找到:
        case 特征引用读取状态::目标已退出:
            return 世界树应用状态::存在不在现实世界;
        case 特征引用读取状态::事实代次漂移:
            return 世界树应用状态::事实代次漂移;
        case 特征引用读取状态::数量预算不足:
            return 世界树应用状态::世界结构预算不足;
        case 特征引用读取状态::历史材料不可用:
            return 世界树应用状态::历史材料已清理;
        case 特征引用读取状态::引用冲突:
            return 世界树应用状态::引用冲突;
        case 特征引用读取状态::资源失败:
            return 世界树应用状态::资源失败;
        default:
            return 世界树应用状态::内部不一致;
        }
    }

    static 世界树应用状态 映射存在接纳状态(
        场景类存在接纳状态 状态) noexcept {
        switch (状态) {
        case 场景类存在接纳状态::入口拒绝:
            return 世界树应用状态::入口拒绝;
        case 场景类存在接纳状态::场景未找到:
        case 场景类存在接纳状态::场景已退出:
            return 世界树应用状态::场景不在现实世界;
        case 场景类存在接纳状态::存在未找到:
        case 场景类存在接纳状态::存在已退出:
            return 世界树应用状态::存在不在现实世界;
        case 场景类存在接纳状态::存在已有场景:
            return 世界树应用状态::存在已有场景;
        case 场景类存在接纳状态::存在多重归属:
            return 世界树应用状态::存在多重位置;
        case 场景类存在接纳状态::存在关系类型未找到:
        case 场景类存在接纳状态::存在关系类型已退出:
        case 场景类存在接纳状态::引用冲突:
            return 世界树应用状态::引用冲突;
        case 场景类存在接纳状态::事实代次漂移:
            return 世界树应用状态::事实代次漂移;
        case 场景类存在接纳状态::幂等冲突:
            return 世界树应用状态::幂等冲突;
        case 场景类存在接纳状态::历史材料已清理:
            return 世界树应用状态::历史材料已清理;
        case 场景类存在接纳状态::资源失败:
            return 世界树应用状态::资源失败;
        case 场景类存在接纳状态::已可能发布:
            return 世界树应用状态::结果未知;
        default:
            return 世界树应用状态::内部不一致;
        }
    }

    static std::size_t 统计存在位置(
        const 世界树现实结构& 结构, 稳定编码 存在,
        稳定编码 目标场景, 稳定编码 接纳关系,
        bool& 位于原目标) noexcept {
        std::size_t 数量 = 0;
        位于原目标 = false;
        for (const auto& 场景 : 结构.场景组) {
            for (const auto& 引用 : 场景.存在组) {
                if (引用.目标结点 != 存在) continue;
                ++数量;
                if (场景.结点 == 目标场景
                    && 引用.成员关系 == 接纳关系)
                    位于原目标 = true;
            }
        }
        return 数量;
    }

    世界树存在创建结果 执行现实世界存在创建(
        const 世界树存在创建请求& 请求) noexcept {
        if (!存在创建请求有效(请求))
            return 存在创建初始失败(世界树应用状态::入口拒绝);
        bool 已进入存在提供者 = false;
        bool 已取得身份 = false;
        世界树存在创建进度 进度;
        std::optional<世界树存在创建投影> 已知接纳投影;
        std::optional<std::uint64_t> 固定代次 =
            请求.已固定接纳期望事实代次;
        世界树应用阶段 当前阶段 = 世界树应用阶段::现实树预读;
        try {
            const auto 预读 = 验证现实世界根({世界树应用合同版本,
                请求.观察事实代次, 请求.最大场景数量});
            const bool 首次观察 = 请求.观察事实代次
                == 请求.存在创建期望事实代次;
            if (首次观察) {
                if (!预读.成功() || !预读.现实结构
                    || !观察代次已证明(预读, 请求.观察事实代次))
                    return 存在创建初始失败(
                        预读.状态 == 世界树应用状态::已验证现实根
                            ? 世界树应用状态::内部不一致 : 预读.状态,
                        世界树应用阶段::现实树预读,
                        请求.观察事实代次);
                if (!包含场景(*预读.现实结构, 请求.目标场景))
                    return 存在创建初始失败(
                        世界树应用状态::场景不在现实世界,
                        世界树应用阶段::现实树预读,
                        请求.观察事实代次);
            } else if (!观察代次已证明(预读, 请求.观察事实代次)) {
                return 存在创建未取得身份结果(
                    世界树应用状态::观察代次无法确认,
                    世界树应用阶段::现实树预读, 请求);
            }

            当前阶段 = 世界树应用阶段::存在创建;
            已进入存在提供者 = true;
            const auto 创建 = 存在服务_.新增存在({
                存在类数据合同版本, 请求.存在创建期望事实代次,
                请求.存在创建幂等身份});
            if (创建.状态 == 存在类数据状态::已可能发布)
                return 存在创建未取得身份结果(
                    世界树应用状态::结果未知, 当前阶段, 请求);
            if (创建.状态 != 存在类数据状态::已创建
                && 创建.状态 != 存在类数据状态::精确重复)
                return 存在创建未取得身份结果(
                    映射存在创建状态(创建.状态), 当前阶段, 请求);
            if (创建.合同版本 != 存在类数据合同版本
                || 创建.事实代次 == 0)
                return 存在创建未取得身份结果(
                    世界树应用状态::结果未知, 当前阶段, 请求);
            if (创建.事实代次 < 请求.存在创建期望事实代次
                || (创建.状态 == 存在类数据状态::精确重复
                    && 创建.事实代次 > 请求.观察事实代次))
                return 存在创建未取得身份结果(
                    世界树应用状态::结果未知, 当前阶段, 请求);
            if (!创建.成功() || !创建.存在结点
                || !有效(创建.存在结点->结点))
                return 存在创建未取得身份结果(
                    世界树应用状态::已发布待复核, 当前阶段, 请求);
            进度.存在 = 创建.存在结点->结点;
            进度.存在首次发布事实代次 = 创建.事实代次;
            已取得身份 = true;

            const std::uint64_t 历史读取代次 =
                创建.状态 == 存在类数据状态::已创建
                ? 创建.事实代次 : 请求.观察事实代次;
            const auto 历史 = 存在服务_.读取存在历史事实({1,
                历史读取代次, 创建.事实代次, 进度.存在,
                请求.最大存在关系数量});
            if (!历史.成功() || 历史.状态 != 特征引用读取状态::已读取)
                return 存在创建已取得身份结果(
                    映射存在历史状态(历史.状态), 当前阶段,
                    请求, 进度, 固定代次);
            if (历史.合同版本 != 1 || 历史.Gread != 历史读取代次
                || 历史.H != 创建.事实代次 || !历史.存在
                || 历史.存在->结点 != 进度.存在
                || 历史.存在->创建事实代次 != 创建.事实代次
                || 历史.存在->退出事实代次)
                return 存在创建已取得身份结果(
                    世界树应用状态::内部不一致, 当前阶段,
                    请求, 进度, 固定代次);

            if (!固定代次) {
                const std::uint64_t 候选代次 =
                    创建.状态 == 存在类数据状态::已创建
                    ? 创建.事实代次 : 请求.观察事实代次;
                const auto 新鲜根 = 验证现实世界根({世界树应用合同版本,
                    候选代次, 请求.最大场景数量});
                if (!新鲜根.成功() || !新鲜根.现实结构
                    || !包含场景(*新鲜根.现实结构, 请求.目标场景))
                    return 存在创建已取得身份结果(
                        世界树应用状态::存在已创建待接纳,
                        世界树应用阶段::现实树预读,
                        请求, 进度, std::nullopt);
                固定代次 = 候选代次;
            } else if (请求.观察事实代次 == *固定代次) {
                const auto 新鲜根 = 验证现实世界根({世界树应用合同版本,
                    *固定代次, 请求.最大场景数量});
                if (!新鲜根.成功() || !新鲜根.现实结构
                    || !包含场景(*新鲜根.现实结构, 请求.目标场景))
                    return 存在创建已取得身份结果(
                        世界树应用状态::存在已创建待接纳,
                        世界树应用阶段::现实树预读,
                        请求, 进度, 固定代次);
            }

            当前阶段 = 世界树应用阶段::场景存在接纳;
            const auto 接纳 = 场景服务_.接纳未归属存在({
                场景类存在接纳合同版本, *固定代次,
                请求.场景接纳幂等身份, 请求.目标场景, 进度.存在});
            if (接纳.状态 == 场景类存在接纳状态::事实代次漂移) {
                if (接纳.合同版本 == 场景类存在接纳合同版本
                    && 接纳.事实代次 > *固定代次 && !接纳.投影)
                    return 存在创建已取得身份结果(
                        世界树应用状态::存在已创建待接纳,
                        当前阶段, 请求, 进度, std::nullopt);
                return 存在创建已取得身份结果(
                    世界树应用状态::结果未知,
                    当前阶段, 请求, 进度, 固定代次);
            }
            if (接纳.状态 == 场景类存在接纳状态::已可能发布)
                return 存在创建已取得身份结果(
                    世界树应用状态::结果未知,
                    当前阶段, 请求, 进度, 固定代次);
            if (接纳.状态 != 场景类存在接纳状态::已接纳
                && 接纳.状态 != 场景类存在接纳状态::精确重复)
                return 存在创建已取得身份结果(
                    映射存在接纳状态(接纳.状态),
                    当前阶段, 请求, 进度, 固定代次);
            if (接纳.合同版本 != 场景类存在接纳合同版本
                || 接纳.事实代次 == 0 || !接纳.成功() || !接纳.投影
                || 接纳.投影->场景 != 请求.目标场景
                || 接纳.投影->存在 != 进度.存在)
                return 存在创建已取得身份结果(
                    世界树应用状态::已发布待复核,
                    当前阶段, 请求, 进度, 固定代次);
            进度.接纳首次发布事实代次 = 接纳.事实代次;
            进度.接纳关系 = 接纳.投影->接纳关系;

            当前阶段 = 世界树应用阶段::现实树存在确认;
            const std::uint64_t 确认代次 =
                接纳.状态 == 场景类存在接纳状态::已接纳
                ? 接纳.事实代次 : 请求.观察事实代次;
            const 世界树存在创建投影 投影{现实世界根场景_,
                请求.目标场景, 进度.存在, *进度.接纳关系,
                进度.存在首次发布事实代次,
                *进度.接纳首次发布事实代次, 确认代次};
            已知接纳投影 = 投影;
            const auto 最终根 = 验证现实世界根({世界树应用合同版本,
                确认代次, 请求.最大场景数量});
            const auto 最终存在 = 存在服务_.查询存在({
                存在类数据合同版本, 确认代次, 进度.存在});
            if (!最终根.成功() || !最终根.现实结构
                || !最终存在.成功()
                || 最终存在.状态 != 存在类数据状态::已读取
                || 最终存在.合同版本 != 存在类数据合同版本
                || 最终存在.事实代次 != 确认代次
                || !最终存在.存在结点
                || 最终存在.存在结点->结点 != 进度.存在
                || 确认代次 < 进度.存在首次发布事实代次
                || 确认代次 < *进度.接纳首次发布事实代次)
                return 存在创建已取得身份结果(
                    世界树应用状态::已发布待复核, 当前阶段,
                    请求, 进度, 固定代次, 0, 投影);
            bool 位于原目标 = false;
            const auto 位置数 = 统计存在位置(*最终根.现实结构,
                进度.存在, 请求.目标场景, *进度.接纳关系,
                位于原目标);
            if (位置数 != 1 || !位于原目标) {
                if (接纳.状态 == 场景类存在接纳状态::精确重复)
                    return 存在创建已取得身份结果(
                        世界树应用状态::既有存在接纳已被后继事实覆盖,
                        当前阶段, 请求, 进度, 固定代次,
                        确认代次, 投影);
                return 存在创建已取得身份结果(
                    世界树应用状态::已发布待复核, 当前阶段,
                    请求, 进度, 固定代次, 0, 投影);
            }
            return 存在创建已取得身份结果(
                接纳.状态 == 场景类存在接纳状态::已接纳
                    ? 世界树应用状态::已创建存在并纳入现实世界
                    : 世界树应用状态::精确重复,
                当前阶段, 请求, 进度, 固定代次,
                确认代次, 投影);
        } catch (const std::bad_alloc&) {
            if (已取得身份)
                return 存在创建已取得身份结果(
                    当前阶段 == 世界树应用阶段::现实树存在确认
                        ? 世界树应用状态::已发布待复核
                        : 世界树应用状态::结果未知,
                    当前阶段, 请求, 进度, 固定代次, 0,
                    已知接纳投影);
            return 已进入存在提供者
                ? 存在创建未取得身份结果(
                    世界树应用状态::结果未知, 当前阶段, 请求)
                : 存在创建初始失败(世界树应用状态::资源失败);
        } catch (const std::length_error&) {
            if (已取得身份)
                return 存在创建已取得身份结果(
                    当前阶段 == 世界树应用阶段::现实树存在确认
                        ? 世界树应用状态::已发布待复核
                        : 世界树应用状态::结果未知,
                    当前阶段, 请求, 进度, 固定代次, 0,
                    已知接纳投影);
            return 已进入存在提供者
                ? 存在创建未取得身份结果(
                    世界树应用状态::结果未知, 当前阶段, 请求)
                : 存在创建初始失败(世界树应用状态::资源失败);
        } catch (...) {
            if (已取得身份)
                return 存在创建已取得身份结果(
                    当前阶段 == 世界树应用阶段::现实树存在确认
                        ? 世界树应用状态::已发布待复核
                        : 世界树应用状态::结果未知,
                    当前阶段, 请求, 进度, 固定代次, 0,
                    已知接纳投影);
            return 已进入存在提供者
                ? 存在创建未取得身份结果(
                    世界树应用状态::结果未知, 当前阶段, 请求)
                : 存在创建初始失败(世界树应用状态::内部不一致);
        }
    }

    static bool 场景创建请求有效(
        const 世界树场景创建请求& 请求) noexcept {
        return 请求.合同版本 == 世界树应用合同版本
            && 请求.创建期望事实代次 != 0
            && 请求.观察事实代次 >= 请求.创建期望事实代次
            && 有效(请求.创建幂等身份) && 有效(请求.父场景)
            && 请求.最大场景数量 != 0;
    }

    static 世界树场景创建重试材料 形成场景创建重试材料(
        const 世界树场景创建请求& 请求) noexcept {
        return {请求.创建期望事实代次,
            请求.创建幂等身份, 请求.父场景};
    }

    bool 观察代次已证明(const 世界树现实根结果& 观察,
        std::uint64_t 观察事实代次) const noexcept {
        if (观察.合同版本 != 世界树应用合同版本
            || 观察.事实代次 != 观察事实代次)
            return false;
        if (观察.状态 == 世界树应用状态::已验证现实根)
            return 观察.成功() && 观察.现实结构
                && 观察.现实结构->现实根场景 == 现实世界根场景_;
        const bool 是确定失败 =
            观察.状态 == 世界树应用状态::现实根未找到
            || 观察.状态 == 世界树应用状态::现实根已退出
            || 观察.状态 == 世界树应用状态::现实根不是结构根
            || 观察.状态 == 世界树应用状态::世界结构预算不足;
        return 是确定失败 && !观察.成功() && !观察.现实结构;
    }

    static bool 创建投影匹配原意图(
        const 场景类创建接纳投影& 投影,
        const 世界树场景创建请求& 请求) noexcept {
        return 投影.父场景 == 请求.父场景
            && 有效(投影.新场景) && 有效(投影.接纳关系)
            && 投影.父场景 != 投影.新场景
            && 投影.父场景 != 投影.接纳关系
            && 投影.新场景 != 投影.接纳关系;
    }

    static bool 创建投影仍在原父场景(
        const 世界树现实结构& 结构,
        const 场景类创建接纳投影& 投影) noexcept {
        const auto 父 = std::find_if(结构.场景组.begin(),
            结构.场景组.end(), [&](const 场景类结点& 场景) noexcept {
                return 场景.结点 == 投影.父场景;
            });
        const auto 子 = std::find_if(结构.场景组.begin(),
            结构.场景组.end(), [&](const 场景类结点& 场景) noexcept {
                return 场景.结点 == 投影.新场景;
            });
        if (父 == 结构.场景组.end() || 子 == 结构.场景组.end()
            || !子->父场景
            || 子->父场景->成员关系 != 投影.接纳关系
            || 子->父场景->目标结点 != 投影.父场景)
            return false;
        return std::count_if(父->子场景组.begin(), 父->子场景组.end(),
            [&](const 场景类成员引用& 引用) noexcept {
                return 引用.成员关系 == 投影.接纳关系
                    && 引用.目标结点 == 投影.新场景;
            }) == 1;
    }

    static 世界树场景创建结果 场景创建失败(
        世界树应用状态 状态,
        世界树应用阶段 阶段 = 世界树应用阶段::无,
        std::uint64_t 请求观察事实代次 = 0) noexcept {
        return {状态, 世界树应用合同版本, 阶段,
            请求观察事实代次, 0, std::nullopt,
            std::nullopt, std::nullopt};
    }

    static 世界树场景创建结果 观察代次无法确认(
        const 世界树场景创建请求& 请求) noexcept {
        return {世界树应用状态::观察代次无法确认,
            世界树应用合同版本, 世界树应用阶段::现实树预读,
            请求.观察事实代次, 0, std::nullopt,
            形成场景创建重试材料(请求), std::nullopt};
    }

    static 世界树场景创建结果 场景创建结果未知(
        const 世界树场景创建请求& 请求,
        std::optional<std::uint64_t> 已发布事实代次 = std::nullopt) noexcept {
        return {世界树应用状态::结果未知, 世界树应用合同版本,
            世界树应用阶段::场景创建接纳, 请求.观察事实代次,
            0, 已发布事实代次, 形成场景创建重试材料(请求),
            std::nullopt};
    }

    世界树场景创建结果 已发布场景待复核(
        const 世界树场景创建请求& 请求,
        const 场景类创建接纳投影* 提供者投影,
        std::uint64_t 发布事实代次) const noexcept {
        std::optional<世界树场景创建投影> 投影;
        if (提供者投影 && 创建投影匹配原意图(*提供者投影, 请求)) {
            投影 = 世界树场景创建投影{现实世界根场景_,
                提供者投影->父场景, 提供者投影->新场景,
                提供者投影->接纳关系, 发布事实代次, 0};
        }
        return {世界树应用状态::已发布待复核, 世界树应用合同版本,
            世界树应用阶段::现实树创建确认,
            请求.观察事实代次, 0, 发布事实代次,
            形成场景创建重试材料(请求), std::move(投影)};
    }

    世界树场景创建结果 完成场景创建确认(
        世界树应用状态 状态, const 世界树场景创建请求& 请求,
        const 场景类创建接纳投影& 提供者投影,
        std::uint64_t 发布事实代次,
        std::uint64_t 确认事实代次) const noexcept {
        return {状态, 世界树应用合同版本,
            世界树应用阶段::现实树创建确认,
            请求.观察事实代次, 确认事实代次, 发布事实代次,
            形成场景创建重试材料(请求),
            世界树场景创建投影{现实世界根场景_,
                提供者投影.父场景, 提供者投影.新场景,
                提供者投影.接纳关系, 发布事实代次,
                确认事实代次}};
    }

    static 世界树应用状态 映射场景创建状态(
        场景类创建接纳状态 状态) noexcept {
        switch (状态) {
        case 场景类创建接纳状态::入口拒绝:
            return 世界树应用状态::入口拒绝;
        case 场景类创建接纳状态::父场景未找到:
        case 场景类创建接纳状态::父场景已退出:
            return 世界树应用状态::场景不在现实世界;
        case 场景类创建接纳状态::子场景关系类型未找到:
        case 场景类创建接纳状态::子场景关系类型已退出:
        case 场景类创建接纳状态::引用冲突:
            return 世界树应用状态::引用冲突;
        case 场景类创建接纳状态::事实代次漂移:
            return 世界树应用状态::事实代次漂移;
        case 场景类创建接纳状态::幂等冲突:
            return 世界树应用状态::幂等冲突;
        case 场景类创建接纳状态::历史材料已清理:
            return 世界树应用状态::历史材料已清理;
        case 场景类创建接纳状态::资源失败:
            return 世界树应用状态::资源失败;
        default:
            return 世界树应用状态::内部不一致;
        }
    }

    世界树场景创建结果 执行现实世界场景创建(
        const 世界树场景创建请求& 请求) noexcept {
        if (!场景创建请求有效(请求))
            return 场景创建失败(世界树应用状态::入口拒绝);
        bool 已进入提供者 = false;
        bool 已取得可信发布 = false;
        std::uint64_t 可信发布事实代次 = 0;
        try {
            const auto 预读 = 验证现实世界根({世界树应用合同版本,
                请求.观察事实代次, 请求.最大场景数量});
            const bool 首次分支 = 请求.观察事实代次
                == 请求.创建期望事实代次;
            if (首次分支) {
                if (!预读.成功() || !预读.现实结构
                    || !观察代次已证明(预读, 请求.观察事实代次))
                    return 场景创建失败(
                        预读.状态 == 世界树应用状态::已验证现实根
                            ? 世界树应用状态::内部不一致 : 预读.状态,
                        世界树应用阶段::现实树预读,
                        请求.观察事实代次);
                if (!包含场景(*预读.现实结构, 请求.父场景))
                    return 场景创建失败(
                        世界树应用状态::场景不在现实世界,
                        世界树应用阶段::现实树预读,
                        请求.观察事实代次);
                if (预读.现实结构->场景组.size()
                    >= 请求.最大场景数量)
                    return 场景创建失败(
                        世界树应用状态::世界结构预算不足,
                        世界树应用阶段::现实树预读,
                        请求.观察事实代次);
            } else if (!观察代次已证明(预读, 请求.观察事实代次)) {
                return 观察代次无法确认(请求);
            }

            已进入提供者 = true;
            const auto 创建 = 场景服务_.创建并接纳场景({
                场景类创建接纳合同版本, 请求.创建期望事实代次,
                请求.创建幂等身份, 请求.父场景});
            if (创建.状态 == 场景类创建接纳状态::已可能发布)
                return 场景创建结果未知(请求);
            if (创建.状态 != 场景类创建接纳状态::已创建并接纳
                && 创建.状态 != 场景类创建接纳状态::精确重复)
                return 场景创建失败(映射场景创建状态(创建.状态),
                    世界树应用阶段::场景创建接纳,
                    请求.观察事实代次);

            if (创建.合同版本 != 场景类创建接纳合同版本
                || 创建.事实代次 == 0)
                return 场景创建结果未知(请求);
            可信发布事实代次 = 创建.事实代次;
            if (!创建.成功() || !创建.投影
                || !创建投影匹配原意图(*创建.投影, 请求))
                return 已发布场景待复核(
                    请求, nullptr, 创建.事实代次);
            已取得可信发布 = true;

            if (!首次分支
                && 创建.状态 == 场景类创建接纳状态::已创建并接纳)
                return 场景创建结果未知(请求, 创建.事实代次);

            const std::uint64_t 确认代次 =
                创建.状态 == 场景类创建接纳状态::已创建并接纳
                ? 创建.事实代次 : 请求.观察事实代次;
            const auto 最终根 = 验证现实世界根({世界树应用合同版本,
                确认代次, 请求.最大场景数量});
            if (!最终根.成功() || !最终根.现实结构
                || !观察代次已证明(最终根, 确认代次)
                || 确认代次 < 创建.事实代次)
                return 已发布场景待复核(
                    请求, &*创建.投影, 创建.事实代次);
            const bool 仍在原父场景 = 创建投影仍在原父场景(
                *最终根.现实结构, *创建.投影);
            if (创建.状态 == 场景类创建接纳状态::已创建并接纳) {
                if (!仍在原父场景)
                    return 已发布场景待复核(
                        请求, &*创建.投影, 创建.事实代次);
                return 完成场景创建确认(
                    世界树应用状态::已创建并纳入现实世界,
                    请求, *创建.投影, 创建.事实代次,
                    最终根.事实代次);
            }
            return 完成场景创建确认(仍在原父场景
                    ? 世界树应用状态::精确重复
                    : 世界树应用状态::既有创建已被后继事实覆盖,
                请求, *创建.投影, 创建.事实代次,
                最终根.事实代次);
        } catch (const std::bad_alloc&) {
            if (已取得可信发布)
                return 已发布场景待复核(
                    请求, nullptr, 可信发布事实代次);
            return 已进入提供者 ? 场景创建结果未知(请求)
                : 场景创建失败(世界树应用状态::资源失败);
        } catch (const std::length_error&) {
            if (已取得可信发布)
                return 已发布场景待复核(
                    请求, nullptr, 可信发布事实代次);
            return 已进入提供者 ? 场景创建结果未知(请求)
                : 场景创建失败(世界树应用状态::资源失败);
        } catch (...) {
            if (已取得可信发布)
                return 已发布场景待复核(
                    请求, nullptr, 可信发布事实代次);
            return 已进入提供者 ? 场景创建结果未知(请求)
                : 场景创建失败(世界树应用状态::内部不一致);
        }
    }

    static bool 场景组形状有效(const std::vector<场景类结点>& 场景组) noexcept {
        for (auto 左 = 场景组.begin(); 左 != 场景组.end(); ++左) {
            if (!有效(左->结点)) return false;
            if (std::any_of(左 + 1, 场景组.end(), [&](const auto& 右) noexcept {
                    return 右.结点 == 左->结点;
                }))
                return false;
        }
        return true;
    }

    static 世界树应用状态 映射树读取状态(场景类数据状态 状态) noexcept {
        switch (状态) {
        case 场景类数据状态::未找到: return 世界树应用状态::现实根未找到;
        case 场景类数据状态::目标已退出: return 世界树应用状态::现实根已退出;
        case 场景类数据状态::非根场景: return 世界树应用状态::现实根不是结构根;
        case 场景类数据状态::数量预算不足: return 世界树应用状态::世界结构预算不足;
        case 场景类数据状态::事实代次漂移: return 世界树应用状态::事实代次漂移;
        case 场景类数据状态::历史材料已清理: return 世界树应用状态::历史材料已清理;
        case 场景类数据状态::资源失败: return 世界树应用状态::资源失败;
        case 场景类数据状态::入口拒绝:
        case 场景类数据状态::内部不一致:
            return 世界树应用状态::内部不一致;
        default: return 世界树应用状态::世界结构不一致;
        }
    }

    static 世界树现实根结果 现实根失败(世界树应用状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 世界树应用合同版本, 事实代次, std::nullopt};
    }

    static 世界树成员位置结果 位置失败(世界树应用状态 状态,
        std::uint64_t 事实代次 = 0) noexcept {
        return {状态, 世界树应用合同版本, 事实代次, std::nullopt};
    }

    static 世界树移动结果 移动失败(世界树应用状态 状态,
        世界树应用阶段 阶段 = 世界树应用阶段::无,
        std::uint64_t 观察事实代次 = 0) noexcept {
        return {状态, 世界树应用合同版本, 阶段, 观察事实代次,
            std::nullopt, std::nullopt};
    }

    static 世界树成员位置结果 定位存在(
        const 世界树现实结构& 结构, 稳定编码 存在,
        std::uint64_t 事实代次) noexcept {
        std::optional<世界树成员位置> 位置;
        for (const auto& 场景 : 结构.场景组) {
            for (const auto& 关系 : 场景.存在组) {
                if (关系.目标结点 != 存在) continue;
                if (!有效(关系.成员关系) || !有效(场景.结点))
                    return 位置失败(世界树应用状态::内部不一致, 事实代次);
                if (位置)
                    return 位置失败(世界树应用状态::成员多重位置, 事实代次);
                位置 = 世界树成员位置{世界树成员种类::存在,
                    存在, 场景.结点, 关系.成员关系};
            }
        }
        if (!位置)
            return 位置失败(世界树应用状态::存在不在现实世界, 事实代次);
        return {世界树应用状态::已读取成员位置,
            世界树应用合同版本, 事实代次, 位置};
    }

    static 世界树成员位置结果 定位场景(
        const 世界树现实结构& 结构, 稳定编码 成员,
        std::uint64_t 事实代次) noexcept {
        const auto 迭代 = std::find_if(结构.场景组.begin(), 结构.场景组.end(),
            [&](const auto& 场景) noexcept { return 场景.结点 == 成员; });
        if (迭代 == 结构.场景组.end())
            return 位置失败(世界树应用状态::场景不在现实世界, 事实代次);
        if (成员 == 结构.现实根场景)
            return 位置失败(世界树应用状态::现实根不可移动, 事实代次);
        if (!迭代->父场景 || !有效(迭代->父场景->成员关系)
            || !有效(迭代->父场景->目标结点))
            return 位置失败(世界树应用状态::内部不一致, 事实代次);
        return {世界树应用状态::已读取成员位置,
            世界树应用合同版本, 事实代次,
            世界树成员位置{世界树成员种类::场景, 成员,
                迭代->父场景->目标结点, 迭代->父场景->成员关系}};
    }

    static bool 移动请求有效(const 世界树成员移动请求& 请求) noexcept {
        return 请求.合同版本 == 世界树应用合同版本
            && 请求.读取事实代次 != 0 && 请求.迁移期望事实代次 != 0
            && 有效(请求.迁移幂等身份) && 有效(请求.原场景)
            && 有效(请求.目标场景) && 有效(请求.成员)
            && 请求.最大场景数量 != 0;
    }

    世界树移动结果 移动现实世界成员(
        const 世界树成员移动请求& 请求, 世界树成员种类 种类) noexcept {
        if (!移动请求有效(请求))
            return 移动失败(世界树应用状态::入口拒绝);
        if (请求.原场景 == 请求.目标场景)
            return 移动失败(世界树应用状态::目标位置相同);
        try {
            const auto 根 = 验证现实世界根({世界树应用合同版本,
                请求.读取事实代次, 请求.最大场景数量});
            if (!根.成功() || !根.现实结构)
                return 移动失败(根.状态, 世界树应用阶段::现实树预读,
                    根.事实代次);
            const auto& 结构 = *根.现实结构;
            if (!包含场景(结构, 请求.原场景)
                || !包含场景(结构, 请求.目标场景))
                return 移动失败(世界树应用状态::场景不在现实世界,
                    世界树应用阶段::现实树预读, 根.事实代次);
            const auto 位置 = 种类 == 世界树成员种类::存在
                ? 定位存在(结构, 请求.成员, 根.事实代次)
                : 定位场景(结构, 请求.成员, 根.事实代次);
            if (!位置.成功() || !位置.位置)
                return 移动失败(位置.状态, 世界树应用阶段::现实树预读,
                    位置.事实代次);
            const bool 预读在目标 = 位置.位置->所在场景 == 请求.目标场景;
            if (!预读在目标 && 位置.位置->所在场景 != 请求.原场景)
                return 移动失败(世界树应用状态::原位置不匹配,
                    世界树应用阶段::现实树预读, 根.事实代次);

            const auto 迁移 = 场景服务_.迁移成员关系({
                场景类成员迁移合同版本, 请求.迁移期望事实代次,
                请求.迁移幂等身份, 请求.原场景, 请求.目标场景,
                种类 == 世界树成员种类::场景 ? 场景类成员种类::子场景 : 场景类成员种类::存在,
                请求.成员, 请求.最大场景数量});
            return 收束迁移(请求, 种类, *位置.位置, 预读在目标, 迁移);
        } catch (const std::bad_alloc&) {
            return 移动失败(世界树应用状态::资源失败);
        } catch (const std::length_error&) {
            return 移动失败(世界树应用状态::资源失败);
        } catch (...) {
            return 移动失败(世界树应用状态::内部不一致);
        }
    }

    static bool 包含场景(const 世界树现实结构& 结构, 稳定编码 场景) noexcept {
        return std::any_of(结构.场景组.begin(), 结构.场景组.end(),
            [&](const auto& 项) noexcept { return 项.结点 == 场景; });
    }

    static bool 迁移投影匹配(const 场景类成员迁移投影& 投影,
        const 世界树成员移动请求& 请求, 世界树成员种类 种类) noexcept {
        return 投影.原场景 == 请求.原场景 && 投影.目标场景 == 请求.目标场景
            && 投影.成员结点 == 请求.成员 && 有效(投影.旧成员关系)
            && 有效(投影.新成员关系) && 投影.旧成员关系 != 投影.新成员关系
            && 投影.成员种类 == (种类 == 世界树成员种类::场景
                ? 场景类成员种类::子场景 : 场景类成员种类::存在);
    }

    世界树移动结果 收束迁移(const 世界树成员移动请求& 请求,
        世界树成员种类 种类, const 世界树成员位置& 预读位置,
        bool 预读在目标, const 场景类成员迁移结果& 迁移) noexcept {
        if (迁移.状态 == 场景类成员迁移状态::已可能发布)
            return 移动失败(世界树应用状态::结果未知,
                世界树应用阶段::场景成员原子迁移, 迁移.事实代次);
        if (迁移.状态 == 场景类成员迁移状态::精确重复) {
            if (!迁移.成功() || !迁移.投影
                || !迁移投影匹配(*迁移.投影, 请求, 种类)
                || 迁移.合同版本 != 场景类成员迁移合同版本
                || 迁移.事实代次 == 0)
                return 移动失败(世界树应用状态::内部不一致,
                    世界树应用阶段::现实树最终确认, 请求.读取事实代次);
            if (!预读在目标)
                return 移动失败(世界树应用状态::既有迁移已被后继事实覆盖,
                    世界树应用阶段::现实树最终确认, 请求.读取事实代次);
            if (预读位置.成员关系 != 迁移.投影->新成员关系)
                return 移动失败(世界树应用状态::内部不一致,
                    世界树应用阶段::现实树最终确认, 请求.读取事实代次);
            return 成功移动(世界树应用状态::精确重复, 请求, 种类,
                *迁移.投影, 迁移.事实代次, 请求.读取事实代次);
        }
        if (迁移.状态 != 场景类成员迁移状态::已迁移)
            return 移动失败(映射迁移状态(迁移.状态, 种类),
                世界树应用阶段::场景成员原子迁移, 迁移.事实代次);
        if (迁移.合同版本 != 场景类成员迁移合同版本
            || 迁移.事实代次 == 0)
            return 移动失败(世界树应用状态::内部不一致,
                世界树应用阶段::场景成员原子迁移, 迁移.事实代次);
        if (!迁移.成功() || !迁移.投影
            || !迁移投影匹配(*迁移.投影, 请求, 种类)
            || 迁移.投影->旧成员关系 != 预读位置.成员关系)
            return 已发布待复核(迁移.事实代次);

        const auto 最终根 = 验证现实世界根({世界树应用合同版本,
            迁移.事实代次, 请求.最大场景数量});
        if (!最终根.成功() || !最终根.现实结构)
            return 已发布待复核(迁移.事实代次);
        const auto 最终位置 = 种类 == 世界树成员种类::存在
            ? 定位存在(*最终根.现实结构, 请求.成员, 迁移.事实代次)
            : 定位场景(*最终根.现实结构, 请求.成员, 迁移.事实代次);
        if (!最终位置.成功() || !最终位置.位置
            || 最终位置.位置->所在场景 != 请求.目标场景
            || 最终位置.位置->成员关系 != 迁移.投影->新成员关系)
            return 已发布待复核(迁移.事实代次);
        return 成功移动(世界树应用状态::已移动, 请求, 种类,
            *迁移.投影, 迁移.事实代次, 最终根.事实代次);
    }

    static 世界树移动结果 已发布待复核(std::uint64_t 事实代次) noexcept {
        return {世界树应用状态::已发布待复核, 世界树应用合同版本,
            世界树应用阶段::现实树最终确认, 事实代次,
            事实代次 == 0 ? std::nullopt : std::optional<std::uint64_t>{事实代次}, std::nullopt};
    }

    static 世界树移动结果 成功移动(世界树应用状态 状态,
        const 世界树成员移动请求& 请求, 世界树成员种类 种类,
        const 场景类成员迁移投影& 投影, std::uint64_t 发布代次,
        std::uint64_t 确认代次) noexcept {
        return {状态, 世界树应用合同版本,
            世界树应用阶段::现实树最终确认, 确认代次, 发布代次,
            世界树成员移动投影{种类, 请求.成员, 请求.原场景, 请求.目标场景,
                投影.旧成员关系, 投影.新成员关系, 发布代次, 确认代次}};
    }

    static 世界树应用状态 映射迁移状态(场景类成员迁移状态 状态,
        世界树成员种类 种类) noexcept {
        switch (状态) {
        case 场景类成员迁移状态::原场景未找到:
        case 场景类成员迁移状态::目标场景未找到:
            return 世界树应用状态::场景不在现实世界;
        case 场景类成员迁移状态::成员未找到:
            return 种类 == 世界树成员种类::场景
                ? 世界树应用状态::场景不在现实世界
                : 世界树应用状态::存在不在现实世界;
        case 场景类成员迁移状态::成员已在目标:
            return 世界树应用状态::成员已在目标但非精确重放;
        case 场景类成员迁移状态::成员多重归属:
            return 世界树应用状态::成员多重位置;
        case 场景类成员迁移状态::形成场景环:
            return 世界树应用状态::形成场景环;
        case 场景类成员迁移状态::数量预算不足:
            return 世界树应用状态::世界结构预算不足;
        case 场景类成员迁移状态::事实代次漂移:
            return 世界树应用状态::事实代次漂移;
        case 场景类成员迁移状态::幂等冲突:
            return 世界树应用状态::幂等冲突;
        case 场景类成员迁移状态::引用冲突:
            return 世界树应用状态::引用冲突;
        case 场景类成员迁移状态::历史材料已清理:
            return 世界树应用状态::历史材料已清理;
        case 场景类成员迁移状态::资源失败:
            return 世界树应用状态::资源失败;
        default:
            return 世界树应用状态::内部不一致;
        }
    }

    场景类数据服务& 场景服务_;
    存在类数据服务& 存在服务_;
    稳定编码 现实世界根场景_{};
};

} // namespace 海中鱼巣
