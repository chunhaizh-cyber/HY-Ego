module;

#include <cstdint>
#include <cstdio>
#include <mutex>
#include <new>
#include <optional>
#include <utility>

export module 海中鱼巣.业务.提供者.真实自我形成;

// 预冻结导入：SELF-FORM 最终 ABI 须机械匹配 DATA 发布。
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2场景结构;
import 海中鱼巣.领域.服务.L2结构聚合;
import 海中鱼巣.装配.普通应用;

export {
#include "真实自我形成.数据.h"
}

export namespace 海中鱼巣 {

bool 真实自我形成结果::成功() const noexcept {
  if (已形成自我) {
    if (状态 == 真实自我形成状态::已形成 ||
        状态 == 真实自我形成状态::精确重复)
      return true;
  }
  return false;
}

class 真实自我形成提供者 final {
public:
  explicit 真实自我形成提供者(
      L2结构聚合服务 &聚合服务) noexcept
      : 聚合服务_(聚合服务) {}

  真实自我形成提供者() = delete;
  真实自我形成提供者(const 真实自我形成提供者 &) = delete;
  真实自我形成提供者 &
  operator=(const 真实自我形成提供者 &) = delete;
  真实自我形成提供者(真实自我形成提供者 &&) = delete;
  真实自我形成提供者 &
  operator=(真实自我形成提供者 &&) = delete;

  // BIZ-L3-001-03-08 N01—N13 五步状态机
  真实自我形成结果
  形成(const 真实自我形成请求 &请求) noexcept {
    try {
      // N01: 请求版本、I2材料和五个固定幂等身份是否有效
      if (请求.合同版本 != 真实自我形成合同版本)
        return {真实自我形成状态::请求无效};
      if (请求.根消费材料.本次事实截止代次 == 0)
        return {真实自我形成状态::请求无效};
      if (请求.根消费材料.请求.树.值.值 == 0)
        return {真实自我形成状态::请求无效};
      if (请求.自我存在幂等身份.值 == 0 ||
          请求.所在场景幂等身份.值 == 0 ||
          请求.所在场景成员幂等身份.值 == 0 ||
          请求.内部世界场景幂等身份.值 == 0 ||
          请求.内部世界宿主幂等身份.值 == 0)
        return {真实自我形成状态::请求无效};
      // 五个幂等身份互异
      if (请求.自我存在幂等身份 == 请求.所在场景幂等身份 ||
          请求.自我存在幂等身份 == 请求.所在场景成员幂等身份 ||
          请求.自我存在幂等身份 == 请求.内部世界场景幂等身份 ||
          请求.自我存在幂等身份 == 请求.内部世界宿主幂等身份 ||
          请求.所在场景幂等身份 == 请求.所在场景成员幂等身份 ||
          请求.所在场景幂等身份 == 请求.内部世界场景幂等身份 ||
          请求.所在场景幂等身份 == 请求.内部世界宿主幂等身份 ||
          请求.所在场景成员幂等身份 == 请求.内部世界场景幂等身份 ||
          请求.所在场景成员幂等身份 == 请求.内部世界宿主幂等身份 ||
          请求.内部世界场景幂等身份 == 请求.内部世界宿主幂等身份)
        return {真实自我形成状态::请求无效};

      // N02: 是否与本provider已锁定请求逐字段相同
      // MSVC 模块边界删除了含 vector 成员的 =default operator==，
      // 只比较合同版本、根树/根场景和五个幂等身份。
      {
        std::lock_guard<std::mutex> 锁(发布锁_);
        if (已锁定请求_) {
          const auto &锁请求 = *已锁定请求_;
          const bool 相同 =
              锁请求.合同版本 == 请求.合同版本 &&
              锁请求.根消费材料.请求.树 ==
                  请求.根消费材料.请求.树 &&
              锁请求.根消费材料.请求.根场景 ==
                  请求.根消费材料.请求.根场景 &&
              锁请求.根消费材料.本次事实截止代次 ==
                  请求.根消费材料.本次事实截止代次 &&
              锁请求.自我存在幂等身份 ==
                  请求.自我存在幂等身份 &&
              锁请求.所在场景幂等身份 ==
                  请求.所在场景幂等身份 &&
              锁请求.所在场景成员幂等身份 ==
                  请求.所在场景成员幂等身份 &&
              锁请求.内部世界场景幂等身份 ==
                  请求.内部世界场景幂等身份 &&
              锁请求.内部世界宿主幂等身份 ==
                  请求.内部世界宿主幂等身份;
          if (!相同)
            return {真实自我形成状态::已发布选择冲突};
        }
        if (!已锁定请求_)
          已锁定请求_ = 请求;
        if (已发布自我_)
          return {真实自我形成状态::精确重复, 已发布自我_};
      }

      // N03: 经A1同实例R1重读登记与整树 -> 当前根材料
      auto &场景服务 = 聚合服务_.取得L2场景结构服务();
      auto &存在服务 = 聚合服务_.取得L2存在结构服务();
      const auto 截止 = 请求.根消费材料.本次事实截止代次;
      const L2结构请求头 请求头{L2结构合同版本, 截止};
      const L2场景树读取请求 树请求{
          请求头, L2读取类别::当前,
          请求.根消费材料.请求.树, 0};
      const auto 树结果 = 场景服务.读取场景树(树请求);
      if (!树结果.树 ||
          树结果.结果头.状态 != L2结构状态::已读取)
        return {真实自我形成状态::根正式读回失败};
      const auto &树 = *树结果.树;
      if (树.树 != 请求.根消费材料.请求.树 ||
          树.根场景 != 请求.根消费材料.请求.根场景)
        return {真实自我形成状态::根正式读回失败};

      // N04D/N04/N05/N05R: 第一步 角色化存在建立
      std::uint64_t 写后截止 = 截止;
      const auto 自我存在事实 = 建立角色化存在(
          存在服务, 请求, 请求头, 写后截止);
      if (!自我存在事实)
        return {真实自我形成状态::自我存在形成失败};
      const auto 自我存在身份 = 自我存在事实->身份;
      L2结构请求头 步骤头{L2结构合同版本, 写后截止};

      // N06: 第二步 新增树内场景(根场景, 顺序1) -> 所在场景
      const auto 所在场景节点 = 建立所在场景(
          场景服务, 请求, 步骤头,
          请求.根消费材料.请求.根场景, 写后截止);
      if (!所在场景节点)
        return {真实自我形成状态::所在场景形成失败};
      const auto 所在场景身份 = 所在场景节点->场景.身份;
      步骤头.期望事实代次 = 写后截止;

      // N07: 第三步 新增场景成员关系(所在场景, 自我存在, 顺序1)
      const auto 成员关系 = 建立场景成员关系(
          场景服务, 请求, 步骤头,
          所在场景身份, 自我存在身份, 写后截止);
      if (!成员关系)
        return {真实自我形成状态::所在场景成员形成失败};
      步骤头.期望事实代次 = 写后截止;

      // N08: 第四步 新增树内场景(所在场景, 顺序1) -> 内部世界场景
      const auto 内部世界节点 = 建立内部世界场景(
          场景服务, 请求, 步骤头,
          所在场景身份, 写后截止);
      if (!内部世界节点)
        return {真实自我形成状态::内部世界形成失败};
      const auto 内部世界身份 = 内部世界节点->场景.身份;
      步骤头.期望事实代次 = 写后截止;

      // N09: 第五步 新增场景宿主存在关系(内部世界场景, 自我存在)
      const auto 宿主关系 = 建立内部世界宿主(
          场景服务, 请求, 步骤头,
          内部世界身份, 自我存在身份, 写后截止);
      if (!宿主关系)
        return {真实自我形成状态::内部世界宿主形成失败};

      // N10: 重新读取当前树、角色、存在、两场景、成员与双向宿主
      const auto 共同截止 = 宿主关系->生命周期.创建事实代次;
      if (共同截止 == 0)
        return {真实自我形成状态::完整读回失败};
      const L2结构请求头 共同头{L2结构合同版本, 共同截止};
      const auto 重读树 = 场景服务.读取场景树(
          {共同头, L2读取类别::当前,
           请求.根消费材料.请求.树, 0});
      if (!重读树.树 ||
          重读树.结果头.状态 != L2结构状态::已读取)
        return {真实自我形成状态::完整读回失败};
      const auto 重读角色 = 存在服务.读取存在单例角色(
          {共同头, L2读取类别::当前,
           海中鱼巣项目唯一自我角色, 0});
      if (!重读角色.角色关系 ||
          重读角色.结果头.状态 != L2结构状态::已读取)
        return {真实自我形成状态::完整读回失败};
      const auto 重读存在 = 存在服务.读取完整存在(
          {共同头, L2读取类别::当前,
           自我存在身份, 0});
      if (!重读存在.存在 ||
          重读存在.结果头.状态 != L2结构状态::已读取)
        return {真实自我形成状态::完整读回失败};

      // 从场景树查找所在场景和内部世界场景节点
      const L2场景树节点事实 *所在节点 = nullptr;
      const L2场景树节点事实 *内部节点 = nullptr;
      for (const auto &节点 : 重读树.树->场景组) {
        if (节点.场景.身份 == 所在场景身份) 所在节点 = &节点;
        if (节点.场景.身份 == 内部世界身份) 内部节点 = &节点;
      }
      if (!所在节点 || !内部节点)
        return {真实自我形成状态::完整读回失败};

      // 从所在场景的直接成员中查找自我成员关系
      const L2场景成员关系事实 *重读成员 = nullptr;
      for (const auto &成员 : 所在节点->场景.直接成员) {
        if (成员.存在 == 自我存在身份) {
          重读成员 = &成员;
          break;
        }
      }
      if (!重读成员)
        return {真实自我形成状态::完整读回失败};

      // 从内部世界场景的当前宿主关系中验证
      if (!内部节点->场景.当前宿主关系 ||
          内部节点->场景.当前宿主关系->宿主存在 !=
              自我存在身份)
        return {真实自我形成状态::完整读回失败};

      // 拓扑闭合验证：根/自我/两场景互异；自我不是内部世界成员
      if (所在场景身份 == 内部世界身份 ||
          所在场景身份 == 请求.根消费材料.请求.根场景 ||
          内部世界身份 ==
              请求.根消费材料.请求.根场景)
        return {真实自我形成状态::完整读回失败};

      // N11: 构造完整真实自我值式候选
      真实自我事实 候选;
      候选.现实世界树 = 重读树.树->树;
      候选.根场景 = 重读树.树->根场景;
      候选.自我角色 = *重读角色.角色关系;
      候选.自我存在 = *重读存在.存在;
      候选.自我所在场景 = *所在节点;
      候选.所在场景成员关系 = *重读成员;
      候选.自我内部世界场景 = *内部节点;
      候选.内部世界宿主关系 =
          *内部节点->场景.当前宿主关系;
      候选.事实截止代次 = 共同截止;

      // N12: 无抛出交换已发布自我
      {
        std::lock_guard<std::mutex> 锁(发布锁_);
        已发布自我_ = std::move(候选);
      }

      // N13: 返回已形成
      return {真实自我形成状态::已形成, 已发布自我_};
    } catch (const std::bad_alloc &) {
      return {真实自我形成状态::资源失败};
    } catch (...) {
      return {真实自我形成状态::内部不一致};
    }
  }

  std::optional<真实自我事实> 读取已发布自我() const {
    std::lock_guard<std::mutex> 锁(发布锁_);
    return 已发布自我_;
  }

private:
  // N04D/N04/N05/N05R: 角色化存在建立
  std::optional<L2存在事实> 建立角色化存在(
      L2存在结构服务 &服务,
      const 真实自我形成请求 &请求,
      const L2结构请求头 &请求头,
      std::uint64_t &写后截止) noexcept {
    // N04D: 判断第一步完整请求是否已保存
    if (!已保存角色请求_) {
      // N04: 读取存在单例角色(项目唯一自我角色, 当前截止)
      const L2存在单例角色读取请求 角色读取请求{
          请求头, L2读取类别::当前,
          海中鱼巣项目唯一自我角色, 0};
      const auto 角色结果 =
          服务.读取存在单例角色(角色读取请求);
      // 完整当前角色已绑定 -> 冲突
      if (角色结果.结果头.状态 == L2结构状态::已读取 &&
          角色结果.角色关系)
        return std::nullopt;
      // 其它结构化非成功（非未找到）-> 失败
      if (角色结果.结果头.状态 != L2结构状态::未找到)
        return std::nullopt;
      // 未找到 -> 保存完整请求
      已保存角色请求_.emplace(L2角色化存在新增请求{
          请求头, 请求.自我存在幂等身份,
          海中鱼巣项目唯一自我角色});
    }
    // N05: 原样重放已保存的新增角色化存在请求
    const auto 写入 = 服务.新增角色化存在(*已保存角色请求_);
    if (写入.结果头.状态 != L2结构状态::已提交 &&
        写入.结果头.状态 != L2结构状态::精确重复)
      return std::nullopt;
    if (!写入.存在 || !写入.当前角色关系)
      return std::nullopt;
    // N05R: 以写后截止读回角色互证
    写后截止 = 写入.结果头.事实截止代次;
    if (写后截止 == 0) return std::nullopt;
    const L2结构请求头 写后头{L2结构合同版本, 写后截止};
    const auto 写后角色 = 服务.读取存在单例角色(
        {写后头, L2读取类别::当前,
         海中鱼巣项目唯一自我角色, 0});
    if (!写后角色.角色关系 ||
        写后角色.结果头.状态 != L2结构状态::已读取)
      return std::nullopt;
    if (*写后角色.角色关系 != *写入.当前角色关系)
      return std::nullopt;
    return *写入.存在;
  }

  // N06: 新增树内场景(根场景, 顺序1) -> 所在场景
  std::optional<L2场景树节点事实> 建立所在场景(
      L2场景结构服务 &服务,
      const 真实自我形成请求 &请求,
      const L2结构请求头 &请求头,
      const L2场景身份 &根场景,
      std::uint64_t &写后截止) noexcept {
    if (!已保存所在场景请求_) {
      已保存所在场景请求_.emplace(L2树内场景新增请求{
          请求头, 请求.所在场景幂等身份,
          请求.根消费材料.请求.树,
          根场景, 1});
    }
    const auto 写入 = 服务.新增树内场景(*已保存所在场景请求_);
    if (写入.结果头.状态 != L2结构状态::已提交 &&
        写入.结果头.状态 != L2结构状态::精确重复)
      return std::nullopt;
    if (!写入.场景节点) return std::nullopt;
    写后截止 = 写入.结果头.事实截止代次;
    return *写入.场景节点;
  }

  // N07: 新增场景成员关系(所在场景, 自我存在, 顺序1)
  std::optional<L2场景成员关系事实> 建立场景成员关系(
      L2场景结构服务 &服务,
      const 真实自我形成请求 &请求,
      const L2结构请求头 &请求头,
      const L2场景身份 &场景,
      const L2存在身份 &存在,
      std::uint64_t &写后截止) noexcept {
    if (!已保存成员请求_) {
      已保存成员请求_.emplace(L2场景成员关系新增请求{
          请求头, 请求.所在场景成员幂等身份,
          场景, 存在, 1});
    }
    const auto 写入 = 服务.新增场景成员关系(*已保存成员请求_);
    if (写入.结果头.状态 != L2结构状态::已提交 &&
        写入.结果头.状态 != L2结构状态::精确重复)
      return std::nullopt;
    if (!写入.当前关系) return std::nullopt;
    写后截止 = 写入.结果头.事实截止代次;
    return *写入.当前关系;
  }

  // N08: 新增树内场景(所在场景, 顺序1) -> 内部世界场景
  std::optional<L2场景树节点事实> 建立内部世界场景(
      L2场景结构服务 &服务,
      const 真实自我形成请求 &请求,
      const L2结构请求头 &请求头,
      const L2场景身份 &所在场景,
      std::uint64_t &写后截止) noexcept {
    if (!已保存内部世界请求_) {
      已保存内部世界请求_.emplace(L2树内场景新增请求{
          请求头, 请求.内部世界场景幂等身份,
          请求.根消费材料.请求.树,
          所在场景, 1});
    }
    const auto 写入 = 服务.新增树内场景(*已保存内部世界请求_);
    if (写入.结果头.状态 != L2结构状态::已提交 &&
        写入.结果头.状态 != L2结构状态::精确重复)
      return std::nullopt;
    if (!写入.场景节点) return std::nullopt;
    写后截止 = 写入.结果头.事实截止代次;
    return *写入.场景节点;
  }

  // N09: 新增场景宿主存在关系(内部世界场景, 自我存在)
  std::optional<L2场景宿主存在关系事实> 建立内部世界宿主(
      L2场景结构服务 &服务,
      const 真实自我形成请求 &请求,
      const L2结构请求头 &请求头,
      const L2场景身份 &场景,
      const L2存在身份 &存在,
      std::uint64_t &写后截止) noexcept {
    if (!已保存宿主请求_) {
      已保存宿主请求_.emplace(L2场景宿主存在新增请求{
          请求头, 请求.内部世界宿主幂等身份,
          场景, 存在});
    }
    const auto 写入 = 服务.新增场景宿主存在关系(*已保存宿主请求_);
    if (写入.结果头.状态 != L2结构状态::已提交 &&
        写入.结果头.状态 != L2结构状态::精确重复)
      return std::nullopt;
    if (!写入.当前关系) return std::nullopt;
    写后截止 = 写入.结果头.事实截止代次;
    return *写入.当前关系;
  }

  L2结构聚合服务 &聚合服务_;
  mutable std::mutex 发布锁_;
  std::optional<真实自我事实> 已发布自我_;
  std::optional<真实自我形成请求> 已锁定请求_;
  std::optional<L2角色化存在新增请求> 已保存角色请求_;
  std::optional<L2树内场景新增请求> 已保存所在场景请求_;
  std::optional<L2场景成员关系新增请求> 已保存成员请求_;
  std::optional<L2树内场景新增请求> 已保存内部世界请求_;
  std::optional<L2场景宿主存在新增请求> 已保存宿主请求_;
};

} // namespace 海中鱼巣
