module;

#include <cstdint>
#include <mutex>
#include <new>
#include <optional>
#include <utility>
#include <vector>

export module 海中鱼巣.业务.提供者.方法登记根生产初始化;

// 预冻结导入名；DATA 最终发布后必须逐项机械匹配，当前候选不要求编译。
import 海中鱼巣.领域.服务.L2方法结构;
import 海中鱼巣.领域.服务.L2方法结构聚合;

export {
#include "方法登记根生产初始化.数据.h"
}

namespace 海中鱼巣::方法登记根生产初始化内部 {

inline bool 请求有效(const 方法登记根生产初始化请求 &请求) noexcept {
  return 请求.合同版本 == 方法登记根生产初始化合同版本 &&
         L2结构幂等身份有效(请求.根建立幂等身份);
}

inline const L2方法登记根事实 *
查找登记根(const L2当前方法登记根组读取结果 &结果) noexcept {
  for (const auto &根 : 结果.方法根)
    if (根.根角色.角色 == L2方法登记根角色::方法登记根)
      return &根;
  return nullptr;
}

inline bool 根组形状完整(const L2当前方法登记根组读取结果 &结果) noexcept {
  if (!结果.成功() || 结果.结果头.状态 != L2结构状态::已读取 ||
      结果.结果头.事实截止代次 == 0 || 结果.结果头.变更事实代次 ||
      结果.方法根.size() > 1)
    return false;
  if (结果.方法根.empty())
    return true;
  const auto &根 = 结果.方法根.front();
  return 根.根角色.角色 == L2方法登记根角色::方法登记根 &&
         L2方法登记根事实完整(根, 结果.结果头.事实截止代次);
}

inline bool 零代次根组读取调用形状完整(
    const 方法登记根组读取调用证据 &证据,
    std::uint64_t 最低事实截止代次) noexcept {
  return 证据.请求.请求头.合同版本 == L2结构合同版本 &&
         证据.请求.请求头.期望事实代次 == 0 && 根组形状完整(证据.结果) &&
         证据.结果.结果头.事实截止代次 >= 最低事实截止代次;
}

inline bool 零代次根组读取调用形状完整(
    const 方法登记根漂移重读证据 &证据,
    std::uint64_t 最低事实截止代次) noexcept {
  return 证据.请求.请求头.合同版本 == L2结构合同版本 &&
         证据.请求.请求头.期望事实代次 == 0 && 根组形状完整(证据.结果) &&
         证据.结果.结果头.事实截止代次 >= 最低事实截止代次;
}

inline bool 非零根组读取调用形状完整(
    const 方法登记根组读取调用证据 &证据) noexcept {
  return 证据.请求.请求头.合同版本 == L2结构合同版本 &&
         证据.请求.请求头.期望事实代次 != 0 && 根组形状完整(证据.结果) &&
         证据.结果.结果头.事实截止代次 ==
             证据.请求.请求头.期望事实代次;
}

inline bool 建立调用请求匹配(const 方法登记根建立调用证据 &证据,
                             L2结构幂等身份 幂等身份) noexcept {
  return L2方法登记根建立请求有效(证据.请求) &&
         证据.请求.请求头.期望事实代次 != 0 &&
         证据.请求.幂等身份 == 幂等身份 &&
         证据.请求.角色 == L2方法登记根角色::方法登记根;
}

inline bool 根写入形状完整(const 方法登记根建立调用证据 &证据,
                           L2结构幂等身份 首次幂等身份) noexcept {
  const auto &结果 = 证据.结果;
  const auto 状态 = 结果.结果头.状态;
  return 建立调用请求匹配(证据, 首次幂等身份) && 结果.成功() &&
         (状态 == L2结构状态::已提交 || 状态 == L2结构状态::精确重复) &&
         结果.结果头.事实截止代次 > 证据.请求.请求头.期望事实代次 &&
         结果.结果头.变更事实代次 &&
         *结果.结果头.变更事实代次 == 结果.结果头.事实截止代次 &&
         结果.方法根 &&
         结果.方法根->根角色.角色 == L2方法登记根角色::方法登记根 &&
         结果.方法根->首次幂等身份 == 首次幂等身份 &&
         结果.方法根->首次期望事实代次 ==
             证据.请求.请求头.期望事实代次 &&
         L2方法登记根事实完整(*结果.方法根,
                               结果.结果头.事实截止代次);
}

inline bool 是可重组漂移(const 方法登记根建立调用证据 &证据,
                         L2结构幂等身份 幂等身份) noexcept {
  const auto &结果 = 证据.结果;
  return 建立调用请求匹配(证据, 幂等身份) && !结果.成功() &&
         结果.结果头.状态 == L2结构状态::事实代次漂移 &&
         !结果.结果头.变更事实代次 && !结果.方法根;
}

inline bool 单根读取调用形状完整(
    const 方法登记根单根读取调用证据 &证据,
    L2结构幂等身份 首次幂等身份) noexcept {
  const auto &结果 = 证据.结果;
  return 证据.请求.请求头.合同版本 == L2结构合同版本 &&
         证据.请求.请求头.期望事实代次 != 0 &&
         证据.请求.角色 == L2方法登记根角色::方法登记根 && 结果.成功() &&
         结果.结果头.状态 == L2结构状态::已读取 &&
         结果.结果头.事实截止代次 ==
             证据.请求.请求头.期望事实代次 &&
         !结果.结果头.变更事实代次 && 结果.方法根 &&
         结果.方法根->根角色.角色 == L2方法登记根角色::方法登记根 &&
         结果.方法根->首次幂等身份 == 首次幂等身份 &&
         L2方法登记根事实完整(*结果.方法根,
                               结果.结果头.事实截止代次);
}

inline bool 组读取非成功形状完整(
    const L2当前方法登记根组读取结果 &结果) noexcept {
  return !结果.成功() && !结果.结果头.变更事实代次 && 结果.方法根.empty();
}

inline bool 单根读取非成功形状完整(
    const L2当前方法登记根读取结果 &结果) noexcept {
  return !结果.成功() && !结果.结果头.变更事实代次 && !结果.方法根;
}

inline bool 建立非成功形状完整(const L2方法登记根写入结果 &结果) noexcept {
  return !结果.成功() && !结果.结果头.变更事实代次 && !结果.方法根;
}

inline 方法登记根生产初始化状态
映射组读取失败(const L2当前方法登记根组读取结果 &结果,
               方法登记根生产初始化状态 普通失败,
               bool 允许事实代次竞争) noexcept {
  if (!组读取非成功形状完整(结果))
    return 方法登记根生产初始化状态::内部不一致;
  switch (结果.结果头.状态) {
  case L2结构状态::事实代次漂移:
    return 允许事实代次竞争 ? 方法登记根生产初始化状态::事实代次竞争
                            : 方法登记根生产初始化状态::内部不一致;
  case L2结构状态::资源失败:
    return 方法登记根生产初始化状态::资源失败;
  case L2结构状态::入口拒绝:
  case L2结构状态::许可拒绝:
    return 普通失败;
  default:
    return 方法登记根生产初始化状态::内部不一致;
  }
}

inline 方法登记根生产初始化状态
映射单根读取失败(const L2当前方法登记根读取结果 &结果) noexcept {
  if (!单根读取非成功形状完整(结果))
    return 方法登记根生产初始化状态::内部不一致;
  switch (结果.结果头.状态) {
  case L2结构状态::事实代次漂移:
    return 方法登记根生产初始化状态::事实代次竞争;
  case L2结构状态::资源失败:
    return 方法登记根生产初始化状态::资源失败;
  case L2结构状态::入口拒绝:
  case L2结构状态::许可拒绝:
    return 方法登记根生产初始化状态::单根正式读回失败;
  default:
    return 方法登记根生产初始化状态::内部不一致;
  }
}

inline 方法登记根生产初始化状态
映射建立失败(const 方法登记根建立调用证据 &证据) noexcept {
  if (!建立调用请求匹配(证据, 证据.请求.幂等身份) ||
      !建立非成功形状完整(证据.结果))
    return 方法登记根生产初始化状态::内部不一致;
  switch (证据.结果.结果头.状态) {
  case L2结构状态::入口拒绝:
  case L2结构状态::许可拒绝:
  case L2结构状态::幂等冲突:
  case L2结构状态::引用冲突:
    return 方法登记根生产初始化状态::方法登记根形成失败;
  case L2结构状态::资源失败:
    return 方法登记根生产初始化状态::资源失败;
  default:
    return 方法登记根生产初始化状态::内部不一致;
  }
}

方法登记根生产初始化结果 编排方法登记根生产初始化(
    std::mutex &发布锁,
    std::optional<方法登记根生产初始化请求> &锁定选择,
    std::optional<L2方法登记根建立请求> &保存建立请求,
    bool &请求待重放,
    std::optional<方法登记根发布材料> &已发布材料,
    const 方法登记根生产初始化请求 &请求,
    L2方法结构聚合服务 &聚合服务) noexcept {
  try {
    std::lock_guard<std::mutex> 锁(发布锁);
    方法登记根生产初始化结果 结果;
    if (!请求有效(请求))
      return 结果;
    if (锁定选择 && *锁定选择 != 请求) {
      结果.状态 = 方法登记根生产初始化状态::已发布选择冲突;
      return 结果;
    }
    if (!锁定选择)
      锁定选择 = 请求;

    auto &服务 = 聚合服务.取得L2方法结构服务();
    const L2当前方法登记根组读取请求 预读请求{{L2结构合同版本, 0}};
    auto 预读结果 = 服务.读取全部当前方法登记根(预读请求);
    结果.当前根组预读 = 方法登记根组读取调用证据{
        预读请求, std::move(预读结果)};
    if (!零代次根组读取调用形状完整(*结果.当前根组预读, 0)) {
      结果.状态 = 映射组读取失败(
          结果.当前根组预读->结果,
          方法登记根生产初始化状态::当前根组预读失败, false);
      return 结果;
    }

    L2当前方法登记根组读取结果 当前根组 = 结果.当前根组预读->结果;
    std::uint64_t 当前事实截止代次 = 当前根组.结果头.事实截止代次;
    const L2方法登记根事实 *已有根 = 查找登记根(当前根组);
    if (已发布材料 &&
        (请求待重放 || !已有根 ||
         *已有根 != 已发布材料->方法登记根)) {
      结果.状态 = 方法登记根生产初始化状态::根读回不一致;
      return 结果;
    }
    if (请求待重放) {
      if (!保存建立请求) {
        结果.状态 = 方法登记根生产初始化状态::内部不一致;
        return 结果;
      }
      结果.进入时待重放请求 = *保存建立请求;
    }

    bool 本次已重组 = false;
    if (!已有根 || 请求待重放) {
      if (!请求待重放)
        保存建立请求 = L2方法登记根建立请求{
            {L2结构合同版本, 当前事实截止代次}, 请求.根建立幂等身份,
            L2方法登记根角色::方法登记根};
      if (!L2方法登记根建立请求有效(*保存建立请求) ||
          保存建立请求->幂等身份 != 请求.根建立幂等身份 ||
          保存建立请求->角色 != L2方法登记根角色::方法登记根) {
        结果.状态 = 方法登记根生产初始化状态::内部不一致;
        return 结果;
      }

      for (;;) {
        const auto 本次请求 = *保存建立请求;
        请求待重放 = true;
        auto 本次写入结果 = 服务.建立方法登记根(本次请求);
        结果.根建立.push_back({本次请求, std::move(本次写入结果)});
        const auto &本次建立 = 结果.根建立.back();
        if (根写入形状完整(本次建立, 请求.根建立幂等身份)) {
          请求待重放 = false;
          if (本次建立.结果.结果头.事实截止代次 > 当前事实截止代次)
            当前事实截止代次 = 本次建立.结果.结果头.事实截止代次;
          break;
        }
        if (是可重组漂移(本次建立, 请求.根建立幂等身份)) {
          请求待重放 = false;
          if (本次已重组) {
            结果.状态 = 方法登记根生产初始化状态::事实代次竞争;
            return 结果;
          }
          const auto 重读前事实截止代次 = 当前事实截止代次;
          const L2当前方法登记根组读取请求 重读请求{{L2结构合同版本, 0}};
          auto 重读结果 = 服务.读取全部当前方法登记根(重读请求);
          结果.漂移根组重读 = 方法登记根漂移重读证据{
              重读前事实截止代次, 重读请求, std::move(重读结果)};
          if (!零代次根组读取调用形状完整(
                  *结果.漂移根组重读, 重读前事实截止代次)) {
            结果.状态 = 映射组读取失败(
                结果.漂移根组重读->结果,
                方法登记根生产初始化状态::当前根组预读失败, false);
            return 结果;
          }
          当前根组 = 结果.漂移根组重读->结果;
          当前事实截止代次 = 当前根组.结果头.事实截止代次;
          已有根 = 查找登记根(当前根组);
          if (已有根)
            break;
          保存建立请求 = L2方法登记根建立请求{
              {L2结构合同版本, 当前事实截止代次}, 请求.根建立幂等身份,
              L2方法登记根角色::方法登记根};
          本次已重组 = true;
          continue;
        }
        结果.状态 = 映射建立失败(本次建立);
        if (建立非成功形状完整(本次建立.结果) &&
            (本次建立.结果.结果头.状态 == L2结构状态::入口拒绝 ||
             本次建立.结果.结果头.状态 == L2结构状态::许可拒绝 ||
             本次建立.结果.结果头.状态 == L2结构状态::幂等冲突 ||
             本次建立.结果.结果头.状态 == L2结构状态::引用冲突))
          请求待重放 = false;
        return 结果;
      }
    }

    const L2当前方法登记根读取请求 单根请求{
        {L2结构合同版本, 当前事实截止代次},
        L2方法登记根角色::方法登记根};
    auto 单根结果 = 服务.按角色读取当前方法登记根(单根请求);
    结果.单根读取 = 方法登记根单根读取调用证据{
        单根请求, std::move(单根结果)};
    if (!单根读取调用形状完整(*结果.单根读取, 请求.根建立幂等身份)) {
      结果.状态 = 映射单根读取失败(结果.单根读取->结果);
      return 结果;
    }
    if (已有根 && *已有根 != *结果.单根读取->结果.方法根) {
      结果.状态 = 方法登记根生产初始化状态::根读回不一致;
      return 结果;
    }
    if (!结果.根建立.empty() && 结果.根建立.back().结果.成功() &&
        *结果.根建立.back().结果.方法根 != *结果.单根读取->结果.方法根) {
      结果.状态 = 方法登记根生产初始化状态::根读回不一致;
      return 结果;
    }
    当前事实截止代次 = 结果.单根读取->结果.结果头.事实截止代次;
    const L2方法登记根事实 根候选 = *结果.单根读取->结果.方法根;

    const L2当前方法登记根组读取请求 最终请求{
        {L2结构合同版本, 当前事实截止代次}};
    auto 最终结果 = 服务.读取全部当前方法登记根(最终请求);
    结果.最终根组读取 = 方法登记根组读取调用证据{
        最终请求, std::move(最终结果)};
    if (!结果.最终根组读取->结果.成功()) {
      结果.状态 = 映射组读取失败(
          结果.最终根组读取->结果,
          方法登记根生产初始化状态::最终根组读回失败, true);
      return 结果;
    }
    if (!非零根组读取调用形状完整(*结果.最终根组读取) ||
        结果.最终根组读取->结果.方法根.size() != 1) {
      结果.状态 = 方法登记根生产初始化状态::内部不一致;
      return 结果;
    }
    const auto *最终根 = 查找登记根(结果.最终根组读取->结果);
    if (!最终根 || *最终根 != 根候选) {
      结果.状态 = 方法登记根生产初始化状态::根读回不一致;
      return 结果;
    }

    方法登记根发布材料 材料{
        请求, 根候选, 结果.最终根组读取->结果.结果头.事实截止代次};
    const bool 已有同义发布 = 已发布材料.has_value();
    结果.状态 = 已有同义发布 ? 方法登记根生产初始化状态::精确重复
                             : 方法登记根生产初始化状态::已发布;
    结果.来源 = 已有同义发布
                    ? 方法登记根生产初始化来源::已发布重复消费
                    : 方法登记根生产初始化来源::首次形成;
    结果.已发布材料 = 材料;
    if (!结果.成功()) {
      方法登记根生产初始化结果 失败;
      失败.状态 = 方法登记根生产初始化状态::内部不一致;
      return 失败;
    }
    std::optional<方法登记根发布材料> 待发布(std::move(材料));
    static_assert(noexcept(已发布材料.swap(待发布)));
    已发布材料.swap(待发布);
    return 结果;
  } catch (const std::bad_alloc &) {
    方法登记根生产初始化结果 结果;
    结果.状态 = 方法登记根生产初始化状态::资源失败;
    return 结果;
  } catch (...) {
    方法登记根生产初始化结果 结果;
    结果.状态 = 方法登记根生产初始化状态::内部不一致;
    return 结果;
  }
}

inline bool 结果证据完整(const 方法登记根生产初始化结果 &结果) noexcept {
  if (!结果.来源 || !结果.当前根组预读 || !结果.单根读取 ||
      !结果.最终根组读取 || !结果.已发布材料 ||
      !请求有效(结果.已发布材料->选择) ||
      !零代次根组读取调用形状完整(*结果.当前根组预读, 0) ||
      !单根读取调用形状完整(
          *结果.单根读取, 结果.已发布材料->选择.根建立幂等身份) ||
      !非零根组读取调用形状完整(*结果.最终根组读取) ||
      结果.最终根组读取->结果.方法根.size() != 1 ||
      结果.已发布材料->最终事实截止代次 !=
          结果.最终根组读取->结果.结果头.事实截止代次 ||
      结果.最终根组读取->请求.请求头.期望事实代次 !=
          结果.单根读取->结果.结果头.事实截止代次 ||
      *结果.单根读取->结果.方法根 != 结果.已发布材料->方法登记根)
    return false;

  const auto *最终根 = 查找登记根(结果.最终根组读取->结果);
  if (!最终根 || *最终根 != 结果.已发布材料->方法登记根)
    return false;
  const bool 来源正确 =
      (结果.状态 == 方法登记根生产初始化状态::已发布 &&
       *结果.来源 == 方法登记根生产初始化来源::首次形成) ||
      (结果.状态 == 方法登记根生产初始化状态::精确重复 &&
       *结果.来源 == 方法登记根生产初始化来源::已发布重复消费);
  if (!来源正确 || 结果.根建立.size() > 2)
    return false;

  const auto *预读根 = 查找登记根(结果.当前根组预读->结果);
  if (预读根 && *预读根 != 结果.已发布材料->方法登记根)
    return false;
  if (结果.进入时待重放请求 &&
      (结果.根建立.empty() ||
       结果.根建立.front().请求 != *结果.进入时待重放请求))
    return false;
  if (结果.根建立.empty())
    return 预读根 != nullptr && !结果.进入时待重放请求 &&
           !结果.漂移根组重读 &&
           结果.单根读取->请求.请求头.期望事实代次 ==
               结果.当前根组预读->结果.结果头.事实截止代次;
  if (预读根 && !结果.进入时待重放请求)
    return false;

  const auto 初始事实截止代次 =
      结果.当前根组预读->结果.结果头.事实截止代次;
  if (!结果.进入时待重放请求 &&
      结果.根建立.front().请求.请求头.期望事实代次 != 初始事实截止代次)
    return false;

  const auto 幂等身份 = 结果.已发布材料->选择.根建立幂等身份;
  if (结果.根建立.size() == 1) {
    const auto &建立 = 结果.根建立.front();
    if (根写入形状完整(建立, 幂等身份))
      return !结果.漂移根组重读 &&
             结果.单根读取->请求.请求头.期望事实代次 ==
                 (建立.结果.结果头.事实截止代次 > 初始事实截止代次
                      ? 建立.结果.结果头.事实截止代次
                      : 初始事实截止代次) &&
             *建立.结果.方法根 == 结果.已发布材料->方法登记根;
    if (!是可重组漂移(建立, 幂等身份) || !结果.漂移根组重读 ||
        !零代次根组读取调用形状完整(
            *结果.漂移根组重读,
            结果.漂移根组重读->调用前已知事实截止代次) ||
        结果.漂移根组重读->调用前已知事实截止代次 !=
            初始事实截止代次 ||
        结果.单根读取->请求.请求头.期望事实代次 !=
            结果.漂移根组重读->结果.结果头.事实截止代次)
      return false;
    const auto *漂移根 = 查找登记根(结果.漂移根组重读->结果);
    return 漂移根 && *漂移根 == 结果.已发布材料->方法登记根;
  }

  if (!是可重组漂移(结果.根建立.front(), 幂等身份) ||
      !根写入形状完整(结果.根建立.back(), 幂等身份) ||
      !结果.漂移根组重读 ||
      !零代次根组读取调用形状完整(
          *结果.漂移根组重读,
          结果.漂移根组重读->调用前已知事实截止代次) ||
      结果.漂移根组重读->调用前已知事实截止代次 !=
          初始事实截止代次 ||
      查找登记根(结果.漂移根组重读->结果) ||
      结果.根建立.back().请求.请求头.期望事实代次 !=
          结果.漂移根组重读->结果.结果头.事实截止代次 ||
      结果.单根读取->请求.请求头.期望事实代次 !=
          结果.根建立.back().结果.结果头.事实截止代次)
    return false;
  return *结果.根建立.back().结果.方法根 ==
         结果.已发布材料->方法登记根;
}

} // namespace 海中鱼巣::方法登记根生产初始化内部


export namespace 海中鱼巣 {

bool 方法登记根生产初始化结果::成功() const noexcept {
  return 方法登记根生产初始化内部::结果证据完整(*this);
}

class 方法登记根生产初始化提供者 final {
public:
  explicit 方法登记根生产初始化提供者(L2方法结构聚合服务 &聚合服务) noexcept
      : 聚合服务_(聚合服务) {}

  方法登记根生产初始化提供者() = delete;
  方法登记根生产初始化提供者(const 方法登记根生产初始化提供者 &) = delete;
  方法登记根生产初始化提供者 &
  operator=(const 方法登记根生产初始化提供者 &) = delete;
  方法登记根生产初始化提供者(方法登记根生产初始化提供者 &&) = delete;
  方法登记根生产初始化提供者 &
  operator=(方法登记根生产初始化提供者 &&) = delete;

  方法登记根生产初始化结果
  初始化(const 方法登记根生产初始化请求 &请求) noexcept {
    return 方法登记根生产初始化内部::编排方法登记根生产初始化(
        发布锁_, 锁定选择_, 保存建立请求_, 请求待重放_, 已发布材料_, 请求,
        聚合服务_);
  }

  std::optional<方法登记根发布材料> 读取已发布材料() const {
    std::lock_guard<std::mutex> 锁(发布锁_);
    return 已发布材料_;
  }

private:
  L2方法结构聚合服务 &聚合服务_;
  mutable std::mutex 发布锁_;
  std::optional<方法登记根生产初始化请求> 锁定选择_;
  std::optional<L2方法登记根建立请求> 保存建立请求_;
  bool 请求待重放_ = false;
  std::optional<方法登记根发布材料> 已发布材料_;
};

} // namespace 海中鱼巣
