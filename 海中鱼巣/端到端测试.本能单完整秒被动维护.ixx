module;

#include <cstdint>
#include <iostream>
#include <optional>
#include <utility>
#include <vector>

export module 海中鱼巣.端到端测试.本能单完整秒被动维护;

import 海中鱼巣.领域.算法.本能单完整秒被动维护;

export namespace 海中鱼巣 {
int 运行本能单完整秒被动维护端到端测试() noexcept;
}

module :private;

namespace 海中鱼巣::本能单完整秒被动维护测试内部 {

inline constexpr std::int64_t L = 2'767'011'611'056'432'742;
inline constexpr std::int64_t H = 7'378'697'629'483'820'645;

int 失败(const char* 编号, const char* 步骤) noexcept {
    std::cout << "[INSTINCT-SINGLE-SECOND-MAINTENANCE][" << 编号
              << "] FAIL: " << 步骤 << '\n';
    return 1;
}
void 通过(const char* 编号, const char* 说明) {
    std::cout << "[INSTINCT-SINGLE-SECOND-MAINTENANCE][" << 编号
              << "] PASS: " << 说明 << '\n';
}
本能单完整秒被动维护请求_v1 基础请求() {
    本能单完整秒被动维护请求_v1 请求;
    请求.服务值前值 = 根值上界_v1 / 2;
    请求.生存安全根前值 = L;
    请求.低位阈值 = L;
    请求.高位阈值 = H;
    请求.安全根定义版本 = 1;
    return 请求;
}
bool 空失败(const 本能单完整秒被动维护结果_v1& 结果,
    本能单完整秒被动维护状态_v1 状态) {
    return 结果.状态 == 状态 && !结果.成功() && !结果.载荷;
}

本能多完整秒被动维护请求_v1 批量基础请求(
    std::int64_t 排除起始, std::int64_t 包含结束) {
    本能多完整秒被动维护请求_v1 请求;
    请求.运行代次 = 1;
    请求.时间纪元身份 = 1;
    请求.排除起始完整秒边界 = 排除起始;
    请求.包含结束完整秒边界 = 包含结束;
    请求.服务值前值 = 根值上界_v1 / 2;
    请求.生存安全根前值 = L;
    请求.低位阈值 = L;
    请求.高位阈值 = H;
    请求.安全根定义版本 = 1;
    请求.主动安全结算规则版本 = 1;
    请求.时间规则版本 = 1;
    请求.最大输出审计段数 = 1'000;
    return 请求;
}

本能被动维护有限事实段_v1 无需求段(
    std::uint64_t 键, std::int64_t 起始, std::int64_t 结束,
    服务活动裁决_v1 活动 = 服务活动裁决_v1::不存在,
    安全低位回升门禁_v1 门禁 = 安全低位回升门禁_v1::允许) {
    本能被动维护有限事实段_v1 段;
    段.事实分段键 = 键;
    段.起始完整秒边界 = 起始;
    段.结束完整秒边界 = 结束;
    段.活动裁决 = 活动;
    段.低位回升门禁材料 = 门禁;
    return 段;
}

本能单完整秒被动维护请求_v1 参考单秒请求(
    const 本能多完整秒被动维护请求_v1& 批量,
    const 本能被动维护有限事实段_v1& 段,
    std::int64_t 秒, std::int64_t V, std::int64_t A) {
    本能单完整秒被动维护请求_v1 请求;
    请求.服务值前值 = V;
    请求.生存安全根前值 = A;
    请求.低位阈值 = 批量.低位阈值;
    请求.高位阈值 = 批量.高位阈值;
    请求.安全根定义版本 = 批量.安全根定义版本;
    请求.服务时间维护规则版本 = 批量.服务时间维护规则版本;
    请求.生存安全回归规则版本 = 批量.生存安全回归规则版本;
    请求.活动裁决 = 段.活动裁决;
    if (段.需求来源形态
        == 本能批量维护需求来源形态_v1::同秒到期未满足事件) {
        请求.需求裁决 = 服务维护需求裁决_v1::三十天门禁已成立;
        请求.本秒到期未满足事件数量 = 段.同秒到期未满足事件数量;
    } else if (段.需求来源形态
        == 本能批量维护需求来源形态_v1::最长未满足合同) {
        const auto t = 秒 - *段.最长需求提出完整秒边界;
        请求.有效未满足需求数量 = 1;
        请求.最长等待完整秒 = t;
        请求.需求裁决 = t >= 服务观察窗完整秒_v1
            ? 服务维护需求裁决_v1::三十天门禁已成立
            : 服务维护需求裁决_v1::存在未满观察窗需求;
    }
    请求.低位回升门禁 = 安全低位回升门禁_v1::允许;
    const auto 探测 = 计算本能单完整秒被动维护候选_v1(请求);
    if (探测.成功() && 探测.载荷
        && 探测.载荷->安全分支 == 生存安全被动回归分支_v1::低位回升)
        请求.低位回升门禁 = 段.低位回升门禁材料;
    else
        请求.低位回升门禁 = 安全低位回升门禁_v1::不适用;
    return 请求;
}

bool 短区间逐秒等价(const 本能多完整秒被动维护请求_v1& 请求) {
    const auto 批量 = 计算本能多完整秒被动维护候选_v1(请求);
    if (!批量.成功() || !批量.载荷) return false;
    std::int64_t V = 请求.服务值前值;
    std::int64_t A = 请求.生存安全根前值;
    std::vector<服务被动维护分支_v1> 服务分支组;
    std::vector<生存安全被动回归分支_v1> 安全分支组;
    std::vector<std::int64_t> 服务比例组;
    std::vector<安全低位回升门禁_v1> 低位门禁组;
    for (const auto& 段 : 请求.完整有序事实段组) {
        for (auto 秒 = 段.起始完整秒边界; 秒 <= 段.结束完整秒边界; ++秒) {
            const auto 单 = 计算本能单完整秒被动维护候选_v1(
                参考单秒请求(请求, 段, 秒, V, A));
            if (!单.成功() || !单.载荷) return false;
            V = 单.载荷->服务值后值;
            A = 单.载荷->生存安全根后值;
            服务分支组.push_back(单.载荷->服务分支);
            安全分支组.push_back(单.载荷->安全分支);
            服务比例组.push_back(单.载荷->服务比例);
            低位门禁组.push_back(单.载荷->低位回升门禁);
            if (秒 == 段.结束完整秒边界) break;
        }
    }
    if (V != 批量.载荷->服务值后值 || A != 批量.载荷->生存安全根后值)
        return false;
    std::size_t i = 0;
    for (const auto& 审计 : 批量.载荷->规范审计段组)
        for (std::uint64_t n = 0; n < 审计.完整秒数量; ++n, ++i)
            if (i >= 服务分支组.size() || 审计.服务分支 != 服务分支组[i]
                || 审计.安全分支 != 安全分支组[i]
                || 审计.服务比例 != 服务比例组[i]
                || 审计.低位回升门禁 != 低位门禁组[i]) return false;
    return i == 服务分支组.size();
}

bool 批量空失败(const 本能多完整秒被动维护结果_v1& 结果,
    本能多完整秒被动维护状态_v1 状态) {
    return 结果.状态 == 状态 && !结果.成功() && !结果.载荷;
}

} // namespace 海中鱼巣::本能单完整秒被动维护测试内部

namespace 海中鱼巣 {

int 运行本能单完整秒被动维护端到端测试() noexcept {
    using namespace 本能单完整秒被动维护测试内部;
    try {
        auto 错合同 = 基础请求(); 错合同.合同版本 = 0;
        auto 错版本 = 基础请求(); 错版本.服务时间维护规则版本 = 2;
        auto 错阈值 = 基础请求(); 错阈值.高位阈值 = 错阈值.低位阈值;
        auto 错需求 = 基础请求();
        错需求.需求裁决 = 服务维护需求裁决_v1::存在未满观察窗需求;
        if (!空失败(计算本能单完整秒被动维护候选_v1(错合同),
                本能单完整秒被动维护状态_v1::入口拒绝)
            || !空失败(计算本能单完整秒被动维护候选_v1(错版本),
                本能单完整秒被动维护状态_v1::版本漂移)
            || !空失败(计算本能单完整秒被动维护候选_v1(错阈值),
                本能单完整秒被动维护状态_v1::入口拒绝)
            || !空失败(计算本能单完整秒被动维护候选_v1(错需求),
                本能单完整秒被动维护状态_v1::入口拒绝))
            return 失败("P00", "entry, version and demand-shape guards");
        通过("P00", "entry, version and demand shapes fail closed");

        for (const auto 前值 : {std::int64_t{0}, std::int64_t{1},
                 根值上界_v1 / 2, 根值上界_v1}) {
            auto 请求 = 基础请求(); 请求.服务值前值 = 前值;
            const auto 结果 = 计算本能单完整秒被动维护候选_v1(请求);
            const auto 期望 = 前值 == 0 ? 0 : 前值 - 1;
            if (!结果.成功() || 结果.载荷->服务值后值 != 期望
                || 结果.载荷->服务实际减少 != 前值 - 期望)
                return 失败("P01", "no-demand saturated decrement");
        }
        auto 活动保护 = 基础请求();
        活动保护.服务值前值 = 1;
        活动保护.活动裁决 = 服务活动裁决_v1::存在;
        const auto 活动保护结果 = 计算本能单完整秒被动维护候选_v1(活动保护);
        if (!活动保护结果.成功() || 活动保护结果.载荷->服务值后值 != 1)
            return 失败("P01", "positive activity floor");
        通过("P01", "no-demand decrement and activity floor are exact");

        auto 等待 = 基础请求();
        等待.需求裁决 = 服务维护需求裁决_v1::存在未满观察窗需求;
        等待.有效未满足需求数量 = 1;
        等待.最长等待完整秒 = 0;
        const auto 等待零 = 计算本能单完整秒被动维护候选_v1(等待);
        等待.最长等待完整秒 = 服务观察窗完整秒_v1 - 1;
        const auto 等待末 = 计算本能单完整秒被动维护候选_v1(等待);
        const auto 期望末 = 服务基础衰减_v1
            + (服务基础衰减_v1 * (服务观察窗完整秒_v1 - 1))
                / 服务观察窗完整秒_v1;
        if (!等待零.成功() || 等待零.载荷->服务实际减少 != 服务基础衰减_v1
            || !等待末.成功() || 等待末.载荷->服务实际减少 != 期望末)
            return 失败("P02", "longest-wait floor formula");
        通过("P02", "longest-wait floor formula is exact");

        auto 门禁 = 基础请求();
        门禁.需求裁决 = 服务维护需求裁决_v1::三十天门禁已成立;
        门禁.本秒到期未满足事件数量 = 1;
        const auto 归零 = 计算本能单完整秒被动维护候选_v1(门禁);
        门禁.活动裁决 = 服务活动裁决_v1::存在;
        const auto 最低一 = 计算本能单完整秒被动维护候选_v1(门禁);
        门禁.服务值前值 = 0;
        const auto 活动零 = 计算本能单完整秒被动维护候选_v1(门禁);
        if (!归零.成功() || 归零.载荷->服务值后值 != 0
            || !最低一.成功() || 最低一.载荷->服务值后值 != 1
            || !活动零.成功() || 活动零.载荷->服务值后值 != 0
            || 活动零.载荷->服务分支
                != 服务被动维护分支_v1::三十天门禁活动零保持)
            return 失败("P03", "30-day target");
        通过("P03", "30-day gate yields exact 0/1 targets");

        const auto 比例 = [](std::int64_t 后值, std::int64_t 期望) {
            auto 请求 = 基础请求(); 请求.服务值前值 = 后值 + 1;
            const auto 结果 = 计算本能单完整秒被动维护候选_v1(请求);
            return 结果.成功() && 结果.载荷->服务值后值 == 后值
                && 结果.载荷->服务比例 == 期望;
        };
        if (!比例(1, 1) || !比例(服务比例单位_v1 - 1, 1)
            || !比例(服务比例单位_v1, 2))
            return 失败("P04", "service ratio boundaries");
        auto 满值 = 基础请求(); 满值.服务值前值 = 根值上界_v1;
        满值.活动裁决 = 服务活动裁决_v1::存在;
        const auto 满值结果 = 计算本能单完整秒被动维护候选_v1(满值);
        if (!满值结果.成功() || 满值结果.载荷->服务比例 != 99)
            return 失败("P04", "M ratio");
        通过("P04", "service ratio is 1..99 at exact boundaries");

        auto 终止 = 基础请求(); 终止.生存安全根前值 = 0;
        const auto 终止结果 = 计算本能单完整秒被动维护候选_v1(终止);
        auto 主动 = 基础请求(); 主动.生存安全根前值 = H + 10;
        主动.主动安全裁决 = 同秒主动安全裁决_v1::已改变A;
        const auto 主动结果 = 计算本能单完整秒被动维护候选_v1(主动);
        auto 休眠 = 基础请求();
        休眠.需求裁决 = 服务维护需求裁决_v1::三十天门禁已成立;
        休眠.本秒到期未满足事件数量 = 1;
        const auto 休眠结果 = 计算本能单完整秒被动维护候选_v1(休眠);
        if (!终止结果.成功() || 终止结果.载荷->生存安全根后值 != 0
            || !主动结果.成功()
            || 主动结果.载荷->生存安全根后值 != 主动.生存安全根前值
            || !休眠结果.成功() || 休眠结果.载荷->生存安全根后值 != 1)
            return 失败("P05", "A branch ordering");
        通过("P05", "termination, active safety and sleep are ordered");

        auto 低位 = 基础请求(); 低位.生存安全根前值 = L - 1;
        低位.低位回升门禁 = 安全低位回升门禁_v1::允许;
        const auto 允许 = 计算本能单完整秒被动维护候选_v1(低位);
        低位.低位回升门禁 = 安全低位回升门禁_v1::禁止;
        const auto 禁止 = 计算本能单完整秒被动维护候选_v1(低位);
        低位.低位回升门禁 = 安全低位回升门禁_v1::材料不足;
        const auto 缺口 = 计算本能单完整秒被动维护候选_v1(低位);
        auto 高位 = 基础请求(); 高位.生存安全根前值 = H + 1;
        const auto 高位结果 = 计算本能单完整秒被动维护候选_v1(高位);
        if (!允许.成功() || 允许.载荷->生存安全根后值 != L
            || !禁止.成功() || 禁止.载荷->生存安全根后值 != L - 1
            || !空失败(缺口, 本能单完整秒被动维护状态_v1::材料不足)
            || !高位结果.成功() || 高位结果.载荷->生存安全根后值 != H)
            return 失败("P06", "threshold and gate branches");
        通过("P06", "threshold and low-gate branches are exact");

        const auto 请求 = 基础请求();
        const auto 一 = 计算本能单完整秒被动维护候选_v1(请求);
        const auto 二 = 计算本能单完整秒被动维护候选_v1(请求);
        if (!一.成功() || 一 != 二
            || !本能单完整秒被动维护载荷完整_v1(*一.载荷))
            return 失败("P07", "deterministic result");
        通过("P07", "same input yields the same complete result");

        auto 空区间 = 批量基础请求(7, 7);
        const auto 空区间结果 = 计算本能多完整秒被动维护候选_v1(空区间);
        auto 错批量合同 = 批量基础请求(0, 1);
        错批量合同.合同版本 = 0;
        auto 错安全版本 = 批量基础请求(0, 1);
        错安全版本.安全根定义版本 = 2;
        错安全版本.完整有序事实段组 = {无需求段(1, 1, 1)};
        auto 异义阈值 = 批量基础请求(0, 1);
        异义阈值.低位阈值 = L - 1;
        异义阈值.完整有序事实段组 = {无需求段(1, 1, 1)};
        auto 空事实 = 批量基础请求(0, 1);
        auto 缺口事实 = 批量基础请求(0, 2);
        缺口事实.完整有序事实段组 = {无需求段(2, 1, 1)};
        auto 重复键 = 批量基础请求(0, 2);
        重复键.完整有序事实段组 = {无需求段(3, 1, 1),
            无需求段(3, 2, 2, 服务活动裁决_v1::存在)};
        auto 可合并未合并 = 批量基础请求(0, 2);
        可合并未合并.完整有序事实段组 = {
            无需求段(4, 1, 1), 无需求段(5, 2, 2)};
        auto 非法到期段 = 批量基础请求(0, 2);
        auto 非法到期 = 无需求段(6, 1, 2);
        非法到期.需求来源形态 = 本能批量维护需求来源形态_v1::同秒到期未满足事件;
        非法到期.同秒到期未满足事件数量 = 1;
        非法到期段.完整有序事实段组 = {非法到期};
        if (!空区间结果.成功()
            || 空区间结果.状态 != 本能多完整秒被动维护状态_v1::无完整秒
            || !空区间结果.载荷 || !空区间结果.载荷->规范审计段组.empty()
            || !批量空失败(计算本能多完整秒被动维护候选_v1(错批量合同),
                本能多完整秒被动维护状态_v1::入口拒绝)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(错安全版本),
                本能多完整秒被动维护状态_v1::版本漂移)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(异义阈值),
                本能多完整秒被动维护状态_v1::版本漂移)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(空事实),
                本能多完整秒被动维护状态_v1::分段不闭合)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(缺口事实),
                本能多完整秒被动维护状态_v1::分段不闭合)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(重复键),
                本能多完整秒被动维护状态_v1::分段不闭合)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(可合并未合并),
                本能多完整秒被动维护状态_v1::分段不闭合)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(非法到期段),
                本能多完整秒被动维护状态_v1::分段不闭合))
            return 失败("B00", "N=0 and batch entry/version guards");
        通过("B00", "N=0 and entry/version/segmentation guards are exact");

        auto 无需求批量 = 批量基础请求(0, 16);
        无需求批量.完整有序事实段组 = {无需求段(1, 1, 16)};
        if (!短区间逐秒等价(无需求批量))
            return 失败("B01", "no-demand batch/reference equivalence");
        通过("B01", "no-demand batch equals the single-second reference");

        auto 最长等待批量 = 批量基础请求(100, 164);
        auto 最长等待段 = 无需求段(2, 101, 164);
        最长等待段.需求来源形态 = 本能批量维护需求来源形态_v1::最长未满足合同;
        最长等待段.最长需求提出完整秒边界 = 0;
        最长等待批量.完整有序事实段组 = {最长等待段};
        if (!短区间逐秒等价(最长等待批量))
            return 失败("B02", "longest-wait floor-sum equivalence");
        通过("B02", "longest-wait floor sum equals the reference");

        auto 跨门禁 = 批量基础请求(
            服务观察窗完整秒_v1 - 3, 服务观察窗完整秒_v1 + 1);
        auto 跨门禁段 = 无需求段(3, 服务观察窗完整秒_v1 - 2,
            服务观察窗完整秒_v1 + 1);
        跨门禁段.需求来源形态 = 本能批量维护需求来源形态_v1::最长未满足合同;
        跨门禁段.最长需求提出完整秒边界 = 0;
        跨门禁.完整有序事实段组 = {跨门禁段};
        auto 到期事件 = 批量基础请求(0, 1);
        auto 到期事件段 = 无需求段(4, 1, 1);
        到期事件段.需求来源形态 = 本能批量维护需求来源形态_v1::同秒到期未满足事件;
        到期事件段.同秒到期未满足事件数量 = 2;
        到期事件.完整有序事实段组 = {到期事件段};
        if (!短区间逐秒等价(跨门禁) || !短区间逐秒等价(到期事件))
            return 失败("B03", "30-day and same-second event boundaries");
        通过("B03", "30-day and same-second event boundaries are exact");

        auto 活动批量 = 批量基础请求(0, 8);
        活动批量.服务值前值 = 3;
        活动批量.完整有序事实段组 = {
            无需求段(5, 1, 8, 服务活动裁决_v1::存在)};
        const auto 活动批量结果 = 计算本能多完整秒被动维护候选_v1(活动批量);
        if (!短区间逐秒等价(活动批量) || !活动批量结果.成功()
            || 活动批量结果.载荷->服务值后值 != 1)
            return 失败("B04", "positive activity floor");
        通过("B04", "positive activity floor remains one across the batch");

        auto 低位批量 = 批量基础请求(0, 2);
        低位批量.服务值前值 = 根值上界_v1;
        低位批量.生存安全根前值 = L - 1'000;
        低位批量.完整有序事实段组 = {无需求段(6, 1, 2)};
        auto 低位禁止 = 低位批量;
        低位禁止.完整有序事实段组.front().低位回升门禁材料 =
            安全低位回升门禁_v1::禁止;
        auto 低位缺口 = 低位批量;
        低位缺口.完整有序事实段组.front().低位回升门禁材料 =
            安全低位回升门禁_v1::材料不足;
        auto 非低位缺口 = 批量基础请求(0, 1);
        非低位缺口.完整有序事实段组 = {
            无需求段(7, 1, 1, 服务活动裁决_v1::不存在,
                安全低位回升门禁_v1::材料不足)};
        if (!短区间逐秒等价(低位批量) || !短区间逐秒等价(低位禁止)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(低位缺口),
                本能多完整秒被动维护状态_v1::材料不足)
            || !计算本能多完整秒被动维护候选_v1(非低位缺口).成功())
            return 失败("B05", "low gate allowed/denied/missing applicability");
        通过("B05", "low gate material is consumed only by the low branch");

        auto 零预算 = 无需求批量;
        零预算.最大输出审计段数 = 0;
        auto 少一预算 = 批量基础请求(0, 3);
        少一预算.服务值前值 = 2;
        少一预算.完整有序事实段组 = {无需求段(8, 1, 3)};
        少一预算.最大输出审计段数 = 1;
        if (!批量空失败(计算本能多完整秒被动维护候选_v1(零预算),
                本能多完整秒被动维护状态_v1::输出预算不足)
            || !批量空失败(计算本能多完整秒被动维护候选_v1(少一预算),
                本能多完整秒被动维护状态_v1::输出预算不足))
            return 失败("B06", "output audit budget");
        通过("B06", "insufficient output budget returns an empty failure");

        auto 比例边界批量 = 批量基础请求(0, 4);
        比例边界批量.服务值前值 = 服务比例单位_v1 + 2;
        比例边界批量.完整有序事实段组 = {无需求段(9, 1, 4)};
        const auto 比例边界结果 = 计算本能多完整秒被动维护候选_v1(比例边界批量);
        if (!短区间逐秒等价(比例边界批量) || !比例边界结果.成功()
            || 比例边界结果.载荷->规范审计段组.size() < 2)
            return 失败("B07", "service-ratio boundary split");
        通过("B07", "service-ratio changes split canonical audit segments");

        for (const auto A : {std::int64_t{0}, std::int64_t{1}, L, H,
                 根值上界_v1}) {
            auto 边界 = 批量基础请求(0, 3);
            边界.服务值前值 = 根值上界_v1;
            边界.生存安全根前值 = A;
            边界.完整有序事实段组 = {无需求段(
                10 + static_cast<std::uint64_t>(A == 根值上界_v1), 1, 3)};
            if (!短区间逐秒等价(边界))
                return 失败("B08", "A=0/1/L/H/M boundaries");
        }
        通过("B08", "A=0/1/L/H/M all equal the reference");

        auto 大跨度 = 批量基础请求(0, 根值上界_v1);
        大跨度.服务值前值 = 0;
        大跨度.完整有序事实段组 = {无需求段(20, 1, 根值上界_v1)};
        大跨度.最大输出审计段数 = 8;
        const auto 大跨度结果 = 计算本能多完整秒被动维护候选_v1(大跨度);
        if (!大跨度结果.成功() || !大跨度结果.载荷
            || 大跨度结果.载荷->规范审计段组.size() > 2
            || 大跨度结果.载荷->服务值后值 != 0
            || 大跨度结果.载荷->生存安全根后值 != 1)
            return 失败("B09", "I64-scale bounded execution");
        通过("B09", "I64-scale span completes with at most two audit segments");

        std::uint64_t 随机态 = 0x9E37'79B9'7F4A'7C15ULL;
        for (std::uint64_t i = 0; i < 64; ++i) {
            随机态 = 随机态 * 6'364'136'223'846'793'005ULL + 1;
            const auto 秒数 = static_cast<std::int64_t>(1 + (随机态 % 32));
            auto 随机请求 = 批量基础请求(0, 秒数);
            随机请求.服务值前值 = static_cast<std::int64_t>(随机态 & 0x7FFF'FFFF'FFFF'FFFFULL);
            const auto A类 = (随机态 >> 5) % 5;
            随机请求.生存安全根前值 = A类 == 0 ? 0 : A类 == 1 ? 1
                : A类 == 2 ? L - 1 : A类 == 3 ? H : 根值上界_v1;
            auto 随机段 = 无需求段(100 + i, 1, 秒数,
                (随机态 & 1U) == 0 ? 服务活动裁决_v1::不存在
                                    : 服务活动裁决_v1::存在);
            if ((随机态 & 2U) != 0) {
                随机段.需求来源形态 = 本能批量维护需求来源形态_v1::最长未满足合同;
                随机段.最长需求提出完整秒边界 = 0;
            }
            随机请求.完整有序事实段组 = {随机段};
            if (!短区间逐秒等价(随机请求))
                return 失败("B10", "deterministic short randomized reference");
        }
        通过("B10", "64 deterministic short batches equal the reference");
        return 0;
    } catch (...) {
        return 失败("EX", "unhandled exception");
    }
}

} // namespace 海中鱼巣
