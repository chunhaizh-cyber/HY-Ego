}

export namespace 海中鱼巣 {

程序运行结果 运行海中鱼巣(const 启动选项& 选项) {
    switch (选项.模式) {
    case 启动模式::普通控制面板:
    case 启动模式::无窗口常驻:
        return 运行普通程序(选项.模式);
    case 启动模式::生产运行期:
        return 运行生产运行期模式();
    case 启动模式::完整自检:
        return 运行完整自检模式();
    case 启动模式::数据库专项:
        return 运行数据库专项();
    case 启动模式::关系仓库性能专项:
        return 运行关系仓库性能专项();
    case 启动模式::D455真实样本专项:
        return 运行D455真实样本专项();
    }
    return {选项.模式, 程序运行状态::内部不一致,
        程序失败阶段::无, std::nullopt};
}

}
