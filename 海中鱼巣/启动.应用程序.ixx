程序运行结果 运行完整自检模式() {
    自检运行器 运行器;
    if (!登记入口初始化自检单元(运行器, {})
        || !运行器.登记自检(150, "ENTRY-ONLY-F27", "入口端口合同",
            [] { return 运行入口端口合同自检(); })
        || !运行器.登记自检(160, "ENTRY-ONLY-F29", "入口隔离合同",
            [] { return 运行入口隔离合同自检(); })
        || !运行器.登记自检(170, "WORLD-TREE-P1A2-S01", "节点直接类型化结构事务合同",
            [] { return 运行节点直接类型化结构事务合同自检(); })
        || !运行器.登记自检(180, "WORLD-TREE-P1A3F-S01", "节点直接世界结构合同骨架",
            [] { return 运行节点直接世界结构骨架合同自检(); })
        || !运行器.登记自检(190, "WORLD-TREE-P1A2Q-S01", "节点直接精确索引查询",
            [] { return 运行节点直接精确索引查询合同自检(); })
        || !运行器.登记自检(225, "WORLD-TREE-CORE-FREEZE-DP-S01", "节点直接统一冻结安全骨架",
            [] { return 运行节点直接统一冻结骨架合同自检(); })
        || !运行器.登记自检(270, "L1-SIMPLIFY-P0-S01", "L1三类事实基座",
            [] { return 运行L1事实基座专项自检(); })) {
        return {启动模式::完整自检, 程序运行状态::自检失败,
            程序失败阶段::完整自检,
            程序专项摘要{程序专项类别::完整自检, 22, 1, true}};
    }
    const auto 批次 = 运行器.运行全部();
    const 程序专项摘要 摘要{
        程序专项类别::完整自检, 批次.执行数量, 批次.失败数量, true};
    return 批次.总通过 && 批次.登记数量 == 22 && 批次.执行数量 == 22
        ? 程序运行结果{启动模式::完整自检, 程序运行状态::已完成,
            程序失败阶段::无, 摘要}
        : 程序运行结果{启动模式::完整自检, 程序运行状态::自检失败,
            程序失败阶段::完整自检, 摘要};
}

程序运行结果 运行关系仓库性能专项() {
#ifdef HY_EGO_ENABLE_STRUCTURE_COMMIT_FAULT_SELF_TEST
    const auto 结果 = 运行关系仓库性能基线自检();
    const 程序专项摘要 摘要{
        程序专项类别::关系仓库性能, 结果.验收项数量,
        结果.失败项数量, true};
    海中鱼巣记录关系仓库性能专项调试日志(
        L"关系仓库性能", L"运行关系仓库性能专项",
        结果.总通过 ? L"关系仓库性能专项通过。" : L"关系仓库性能专项失败。");
    return 结果.总通过
        ? 程序运行结果{启动模式::关系仓库性能专项, 程序运行状态::已完成,
            程序失败阶段::无, 摘要}
        : 程序运行结果{启动模式::关系仓库性能专项, 程序运行状态::专项失败,
            程序失败阶段::关系仓库性能, 摘要};
#else
    return {启动模式::关系仓库性能专项, 程序运行状态::专项失败,
        程序失败阶段::关系仓库性能, std::nullopt};
#endif
}

