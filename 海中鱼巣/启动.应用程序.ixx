module;

#include "启动选项.数据.h"
#include "程序运行结果.数据.h"
#include "核心/日志系统.h"

#include <cstdint>
#include <string>

export module 海中鱼巣.启动.应用程序;

import 海中鱼巣.装配.普通应用;
import 海中鱼巣.领域.初始化.系统;
import 海中鱼巣.界面.投影.控制面板启动;
import 海中鱼巣.启动.程序运行宿主;

namespace 海中鱼巣 {

程序运行结果 运行普通程序(启动模式 模式) {
    if (模式 != 启动模式::普通控制面板 && 模式 != 启动模式::无窗口常驻) {
        return {模式, 程序运行状态::内部不一致, 程序失败阶段::无};
    }
    const 普通应用配置 配置;
    auto 装配 = 构造普通应用上下文(配置);
    if (!装配.成功()) {
        return {模式, 程序运行状态::装配失败, 程序失败阶段::普通应用装配};
    }
    auto& 上下文 = *装配.上下文;
    系统初始化端口 系统端口{
        [&](std::uint64_t 键) { return 上下文.方法.初始化方法登记根(键, 上下文.状态); },
        [&](const 自我根需求初始化参数& 参数) { return 上下文.自我线程实例.启动(参数); },
        [&](std::chrono::milliseconds 时限) { return 上下文.自我线程实例.等待初始化完成(时限); },
        [&]() { return 上下文.自我线程实例.读取初始化快照(); },
        [&]() { return 上下文.概念图初始化.初始化四个根(); },
        [&](节点句柄 实例) { return 上下文.概念图.确保存在实例根支持(实例); }
    };
    const auto 初始化 = 初始化普通系统(
        系统端口, {配置.方法登记根稳定键, 配置.根需求参数});
    if (!初始化.成功()) {
        const auto 失败阶段 = [&] {
            switch (初始化.状态) {
            case 系统初始化状态::方法登记根失败: return 程序失败阶段::方法登记根;
            case 系统初始化状态::自我线程启动失败: return 程序失败阶段::自我线程启动;
            case 系统初始化状态::自我线程初始化失败: return 程序失败阶段::自我线程初始化;
            case 系统初始化状态::概念图初始化失败: return 程序失败阶段::概念图初始化;
            case 系统初始化状态::自我存在根支持失败: return 程序失败阶段::自我存在根支持;
            default: return 程序失败阶段::普通应用装配;
            }
        }();
        return {模式, 程序运行状态::初始化失败,
            失败阶段};
    }
    const auto 结构统计命名空间 = 上下文.统计.定义缓存命名空间(
        缓存类型::结构统计, 来源结构类型::结构仓库集合,
        1, 1, 缓存值类型::结构数量, true, 缓存失效条件::权威结构变化);
    const auto 启动结构统计 = 上下文.统计.读取权威结构统计快照(
        结构统计命名空间, 上下文.节点, 上下文.关系, 上下文.索引);
    auto 信号 = 安装程序停止信号();
    if (!信号.成功()) {
        return {模式, 程序运行状态::宿主失败, 程序失败阶段::停止信号};
    }
    if (模式 == 启动模式::无窗口常驻) {
        return 运行无窗口宿主(*装配.上下文, *信号.租约);
    }
    const auto 投影 = 生成控制面板启动投影(*装配.上下文, 初始化);
    if (!投影.成功()) {
        return {模式, 程序运行状态::投影失败,
            程序失败阶段::控制面板投影};
    }
    return 运行控制面板宿主(
        *装配.上下文, 初始化, 投影, 启动结构统计, *信号.租约);
}

}

export namespace 海中鱼巣 {

程序运行结果 运行海中鱼巣(const 启动选项& 选项) {
    switch (选项.模式) {
    case 启动模式::普通控制面板:
    case 启动模式::无窗口常驻:
        return 运行普通程序(选项.模式);
    }
    return {选项.模式, 程序运行状态::内部不一致,
        程序失败阶段::无};
}

}
