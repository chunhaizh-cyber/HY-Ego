namespace 海中鱼巣 {

// 前置声明（对齐 BIZ-L1-T01 N09-N14, N18-N27, BIZ-L0 v0.4）
bool 启动支持线程组();
bool 启动外设线程组();
bool 开放自我线程治理循环();
bool 按模式启动控制面板线程(启动模式 模式);
void 收口并连接外设线程组();
void 刷新并连接支持线程组();
程序运行结果 运行生产运行期(const 启动选项& 选项);

std::optional<L2结构幂等身份> 分配中性实例材料维护幂等身份() noexcept {
    constexpr std::uint64_t 前缀 = 0x4E43'0000'0000'0000ULL;
    constexpr std::uint64_t 低位上限 = 0x0000'FFFF'FFFF'FFFFULL;
    static std::atomic<std::uint64_t> 下一低位{1};
    const auto 低位 = 下一低位.fetch_add(1, std::memory_order_relaxed);
    if (低位 == 0 || 低位 > 低位上限) return std::nullopt;
    return L2结构幂等身份{前缀 | 低位};
}

程序周期维护回调 形成中性实例材料维护回调(普通应用上下文& 上下文) {
    auto* const 状态服务 = &上下文.取得L2状态结构服务();
    auto* const 动态服务 = &上下文.取得L2动态结构服务();
    return [状态服务, 动态服务,
            待重试请求 = std::optional<L2中性实例材料清理请求_v1>{}]()
            mutable -> 程序周期维护状态 {
        const auto 形成新请求 = [&]() {
            const auto G0 = 状态服务->读取中性当前事实代次_v1();
            const auto 身份 = 分配中性实例材料维护幂等身份();
            if (!G0 || !身份) return false;
            L2中性实例材料清理请求_v1 请求;
            请求.请求头 = {L2结构合同版本, *G0};
            请求.专属合同版本 = L2中性状态动态合同版本_v1;
            请求.幂等身份 = *身份;
            请求.原因 = L2中性实例材料清理原因_v1::周期或总量;
            待重试请求 = std::move(请求);
            return true;
        };
        if (!待重试请求 && !形成新请求())
            return 程序周期维护状态::内部不一致;

        auto 结果 = 动态服务->执行中性实例材料清理_v1(*待重试请求);
        if (结果.成功()) {
            待重试请求.reset();
            return 程序周期维护状态::已完成;
        }
        if (结果.结果头.状态 == L2中性结构状态_v1::资源失败)
            return 程序周期维护状态::稍后重试;
        if (结果.结果头.状态 != L2中性结构状态_v1::事实代次漂移)
            return 程序周期维护状态::内部不一致;

        待重试请求.reset();
        if (!形成新请求()) return 程序周期维护状态::内部不一致;
        结果 = 动态服务->执行中性实例材料清理_v1(*待重试请求);
        if (结果.成功()) {
            待重试请求.reset();
            return 程序周期维护状态::已完成;
        }
        if (结果.结果头.状态 == L2中性结构状态_v1::资源失败)
            return 程序周期维护状态::稍后重试;
        if (结果.结果头.状态 == L2中性结构状态_v1::事实代次漂移) {
            待重试请求.reset();
            return 程序周期维护状态::稍后重试;
        }
        return 程序周期维护状态::内部不一致;
    };
}

程序运行结果 运行普通程序(启动模式 模式) {
    if (模式 != 启动模式::普通控制面板 && 模式 != 启动模式::无窗口常驻) {
        return {模式, 程序运行状态::内部不一致, 程序失败阶段::无};
    }
    auto 配置 = 形成普通应用生产配置();
    if (!配置.成功()) {
        return {模式, 程序运行状态::装配失败, 程序失败阶段::普通应用装配};
    }
    auto 装配 = 构造普通应用上下文(*配置.配置);
    if (!装配.成功()) {
        return {模式, 程序运行状态::装配失败, 程序失败阶段::普通应用装配};
    }
    const auto 系统世界树根 = 初始化并发布系统世界树根(
        *装配.上下文, 系统世界树根初始化请求{});
    if (!系统世界树根.成功() || !系统世界树根.已发布根) {
        return {模式, 程序运行状态::初始化失败,
            程序失败阶段::现实世界树根初始化};
    }
    const auto& 根 = *系统世界树根.已发布根;
    const 自我世界树根消费请求 消费请求{
        自我世界树根消费合同版本, 根.选择, 根.首次建立请求,
        根.树, 根.根场景, 根.正式树读回.根标记};
    const auto 自我世界树根 = 消费并发布自我世界树根(
        *装配.上下文, 消费请求);
    if (!自我世界树根.成功() || !自我世界树根.已发布材料) {
        return {模式, 程序运行状态::初始化失败,
            程序失败阶段::自我世界树根消费};
    }
    // 阶段 17：真实自我形成（SELF-FORM）。
    // BIZ-L3-001-03-08 五步状态机：角色化存在→所在场景→成员关系→内部世界场景→内部世界宿主。
    真实自我形成提供者 自我形成者(
        装配.上下文->取得L2结构聚合服务());
    真实自我形成请求 自我请求;
    自我请求.根消费材料 = *自我世界树根.已发布材料;
    const auto 自我形成 = 自我形成者.形成(自我请求);
    if (!自我形成.成功()) {
        std::fprintf(stderr, "[启动] 真实自我形成失败 状态=%u\n",
            static_cast<unsigned>(自我形成.状态));
        return {模式, 程序运行状态::初始化失败,
            程序失败阶段::真实自我形成};
    }
    // 阶段 18：四本体根生产初始化。
    四本体根生产初始化提供者 四本体根者(
        装配.上下文->取得L2概念结构聚合服务());
    const auto 四本体根 = 四本体根者.初始化(四本体根生产初始化请求{});
    if (!四本体根.成功() || !四本体根.已发布材料) {
        return {模式, 程序运行状态::初始化失败,
            程序失败阶段::四本体根生产初始化};
    }
    // 阶段 19：方法登记根生产初始化。
    方法登记根生产初始化提供者 方法登记根者(
        装配.上下文->取得L2方法结构聚合服务());
    const auto 方法登记根 = 方法登记根者.初始化(
        方法登记根生产初始化请求{});
    if (!方法登记根.成功() || !方法登记根.已发布材料) {
        return {模式, 程序运行状态::初始化失败,
            程序失败阶段::方法登记根生产初始化};
    }
    // 阶段 21：在自我线程创建前建立或恢复双根，并按同一截止读回值式锚点。
    const auto 本次启动UTC计数 =
        std::chrono::duration_cast<std::chrono::nanoseconds>(
            std::chrono::system_clock::now().time_since_epoch()).count();
    if (本次启动UTC计数 <= 0 || !自我形成.已形成自我) {
        return {模式, 程序运行状态::初始化失败,
            程序失败阶段::本能根运行初始化};
    }
    本能根运行初始化提供者 本能根者(
        装配.上下文->取得L2存在结构服务(),
        装配.上下文->取得L2特征结构服务(),
        装配.上下文->取得L2状态结构服务(),
        装配.上下文->取得L2需求结构服务());
    const auto 本能根 = 本能根者.初始化并读取本能根运行锚点_v1({
        本能根运行初始化合同版本_v1,
        自我形成.已形成自我->自我存在.身份,
        static_cast<std::uint64_t>(本次启动UTC计数)});
    if (!本能根.成功() || !本能根.锚点) {
        return {模式, 程序运行状态::初始化失败,
            程序失败阶段::本能根运行初始化};
    }
    // 阶段 20：自我线程创建并停在治理运行门。
    // 线程生命周期发布端口当前为 null（投影服务待实现），空转阶段不发布生命周期事件。
    // 装配阶段：传入同一 L2 结构聚合服务，使运行期时间、事实截止和
    // 批次路由在自我线程内形成单一 ABI 闭环。
    // 参见 BIZ-L1-T02 v0.2 §所有权与停止边界 §2。
    装配运行期只读查询组合器(
        装配.上下文->取得L2需求结构服务(),
        装配.上下文->取得L2任务结构服务(),
        装配.上下文->取得L2方法结构聚合服务().取得L2方法结构服务(),
        装配.上下文->取得L2状态结构服务(),
        装配.上下文->取得L2特征结构服务(),
        装配.上下文->取得L2存在结构服务(),
        装配.上下文->取得L2场景结构服务(),
        装配.上下文->取得L2动态结构服务());
    自我线程 自我线程实例(nullptr,
        &装配.上下文->取得L2结构聚合服务());
    {
        const 线程逻辑身份 自我线程逻辑身份{0x5345'4C46'0000'0001ULL};
        const std::uint64_t 自我线程运行代次 = 1;
        const std::uint64_t 治理邮箱容量 = 64;
        const std::uint64_t 入口停门等待毫秒 = 5000;
        const std::uint64_t 失败回收诊断毫秒 = 5000;
        自我线程生产创建请求 线程请求;
        线程请求.线程逻辑身份 = 自我线程逻辑身份;
        线程请求.运行代次 = 自我线程运行代次;
        线程请求.根消费材料 = *自我世界树根.已发布材料;
        线程请求.本能根锚点 = *本能根.锚点;
        线程请求.治理邮箱容量 = 治理邮箱容量;
        线程请求.最大任务结果来源需求成员数 = 64;
        线程请求.入口停门等待毫秒 = 入口停门等待毫秒;
        线程请求.失败回收诊断毫秒 = 失败回收诊断毫秒;
        const auto 线程创建 = 自我线程实例.创建并使自我线程停在治理运行门(
            线程请求);
        if (!线程创建.成功()) {
            return {模式, 程序运行状态::初始化失败,
                程序失败阶段::自我线程创建并停门};
        }
    }
    // 任务结果生产运行包晚于自我线程构造，因此退出当前作用域时先析构运行包；
    // 正常路径仍显式完成“停新派发、排空工作结果、排空结果上行”，随后才允许
    // 自我线程实例析构并停止唯一治理邮箱。
    任务结果生产运行包 任务结果运行包(
        装配.上下文->取得L2需求结构服务(),
        装配.上下文->取得L2任务结构服务(),
        装配.上下文->取得L2状态结构服务(),
        装配.上下文->取得L2特征结构服务(),
        装配.上下文->取得L2存在结构服务(),
        装配.上下文->取得L2场景结构服务(),
        装配.上下文->取得L2动态结构服务(),
        自我线程实例,
        装配.上下文->取得任务筹办当前就绪与执行冻结提供者(),
        64, 64, 64, 64, 64, 64);
    // L0-01：安装程序停止信号；普通控制面板和无窗口模式共同进入
    // 同一启动、运行、收口骨架，控制面板能力由后续生命周期空壳承接。
    auto 信号 = 安装程序停止信号();
    if (!信号.成功()) {
        return {模式, 程序运行状态::宿主失败, 程序失败阶段::停止信号};
    }
    // N09-N14：启动线程组（消费者先于生产者）
    bool 启动成功 = true;
    启动成功 = 启动成功 && 启动支持线程组();        // N09
    const auto 任务结果运行包启动 = 任务结果运行包.启动();
    启动成功 = 启动成功 && 任务结果运行包启动.成功; // N10-N11
    启动成功 = 启动成功 && 启动外设线程组();        // N12
    const bool 自我治理运行门可开放 =
        启动成功 && 开放自我线程治理循环();          // N13
    if (自我治理运行门可开放) {
        自我线程实例.开放治理运行门();
    }
    启动成功 = 自我治理运行门可开放;
    启动成功 = 启动成功 && 按模式启动控制面板线程(模式);  // N14

    程序运行结果 结果{模式, 程序运行状态::已完成, 程序失败阶段::无};

    // N15：全部必需线程和运行门是否已进入
    if (!启动成功) {
        // N32：锁存启动失败及已启动资源 → 进入逆序收口
        结果.状态 = 程序运行状态::初始化失败;
    } else {
        // N16：等待程序停止请求
        结果 = 运行无窗口宿主(*信号.租约,
            形成中性实例材料维护回调(*装配.上下文));
        结果.模式 = 模式;
    }

    // N17-N27：分阶段逆序收口（任一启动阶段失败都进入同一收口路径）
    // N18-N19：任务管理停止新派发；不存在旧自动重筹办意图生产端口。
    const auto 停止任务新派发 = 任务结果运行包.请求停止新派发();
    // N25：收口并连接外设线程组；任务工作线程由运行包按固定顺序排空
    收口并连接外设线程组();
    // N26：运行包先排空工作结果和结果上行；自我线程在当前作用域末尾才停止
    const auto 任务结果上行收口 =
        任务结果运行包.收口工作线程并排空结果上行();
    if ((!停止任务新派发.成功 || !任务结果上行收口.成功)
        && 结果.状态 == 程序运行状态::已完成) {
        结果.状态 = 程序运行状态::内部不一致;
        结果.失败阶段 = 程序失败阶段::自我线程启动;
    }
    // N27：刷新并连接支持线程组
    刷新并连接支持线程组();

    // N28-N29：按初始化、停止原因和各阶段结果构造程序运行结果
    return 结果;
}

// L0-01—L0-04：生产运行期会话生命周期空壳。
// 当前只复用进程停止信号和等待宿主形成真实的启动、运行、结束与退出码路径；
// 不建立普通线程拓扑，也不宣称生产运行期领域能力已经实现。
程序运行结果 运行生产运行期(const 启动选项& 选项) {
    if (选项.模式 != 启动模式::生产运行期) {
        return {选项.模式, 程序运行状态::内部不一致,
            程序失败阶段::启动模式拒绝};
    }
    auto 信号 = 安装程序停止信号();
    if (!信号.成功()) {
        return {选项.模式, 程序运行状态::宿主失败,
            程序失败阶段::停止信号};
    }
    auto 结果 = 运行无窗口宿主(*信号.租约);
    结果.模式 = 启动模式::生产运行期;
    return 结果;
}

// ===== N09-N14: 线程组启动骨架（对齐 BIZ-L1-T01 N09-N14）=====
// 每个函数留桩返回成功；实际启动待 BIZ-L2-001-04—09 下层实现
// 当前正式顺序：支持→任务管理→任务工作→外设→自我治理运行门→控制面板。
bool 启动支持线程组() { return true; }
bool 启动外设线程组() { return true; }
bool 开放自我线程治理循环() { return true; }
bool 按模式启动控制面板线程(启动模式 模式) {
    // 无窗口常驻模式不启动控制面板
    if (模式 == 启动模式::无窗口常驻) return true;
    // 普通控制面板模式：当前仅完成生命周期空壳接线；真实窗口和线程待 L1 实现。
    return 模式 == 启动模式::普通控制面板;
}

// ===== N18-N27: 分阶段收口骨架（对齐 BIZ-L1-T01 N18-N27）=====
// 任一启动阶段失败都进入同一逆序收口路径，禁止遗留已启动线程
void 收口并连接外设线程组() {}
void 刷新并连接支持线程组() {}

}

export namespace 海中鱼巣 {

// 三个正式生产模式路由（对齐 BIZ-L0 v0.4 的 L0-01）。
程序运行结果 运行海中鱼巣(const 启动选项& 选项) {
    switch (选项.模式) {
    case 启动模式::普通控制面板:
    case 启动模式::无窗口常驻:
        // N02 -> N06: 运行普通程序 -> 返回普通运行结果
        return 运行普通程序(选项.模式);
    case 启动模式::生产运行期:
        // N03 -> N07: 运行生产运行期 -> 返回生产运行期结果
        return 运行生产运行期(选项);
    }
    // N05: 未登记模式 -> 返回启动模式拒绝
    return {选项.模式, 程序运行状态::启动模式拒绝, 程序失败阶段::启动模式拒绝};
}

}
