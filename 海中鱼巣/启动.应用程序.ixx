module;

#include "启动选项.数据.h"
#include "程序运行结果.数据.h"

export module 海中鱼巣.启动.应用程序;

import 海中鱼巣.启动.程序运行宿主;

namespace 海中鱼巣 {

程序运行结果 运行普通程序(启动模式 模式) {
    return {模式, 程序运行状态::初始化失败, 程序失败阶段::普通应用装配};
}

程序运行结果 运行生产运行期(const 启动选项& 选项) {
    if (选项.模式 != 启动模式::生产运行期) {
        return {选项.模式, 程序运行状态::内部不一致,
            程序失败阶段::启动模式拒绝};
    }
    auto 信号 = 安装程序停止信号();
    if (!信号.成功()) {
        return {选项.模式, 程序运行状态::宿主失败,
            程序失败阶段::停止信号};
    }
    auto 结果 = 运行无窗口宿主(*信号.租约);
    结果.模式 = 启动模式::生产运行期;
    return 结果;
}

} // namespace 海中鱼巣

export namespace 海中鱼巣 {

程序运行结果 运行海中鱼巣(const 启动选项& 选项) {
    switch (选项.模式) {
    case 启动模式::普通控制面板:
    case 启动模式::无窗口常驻:
        return 运行普通程序(选项.模式);
    case 启动模式::生产运行期:
        return 运行生产运行期(选项);
    }
    return {选项.模式, 程序运行状态::启动模式拒绝,
        程序失败阶段::启动模式拒绝};
}

} // namespace 海中鱼巣
