// DATA-L1-N-PARTITION-ATOMIC-V3 专项：只通过公开签发器、写端口和读服务验证。
module;

#ifndef NOMINMAX
#define NOMINMAX
#endif
#include <windows.h>

#include <algorithm>
#include <cstdint>
#include <filesystem>
#include <iostream>
#include <memory>
#include <optional>
#include <string>
#include <system_error>
#include <utility>
#include <variant>
#include <vector>

export module 海中鱼巣.端到端测试.DATA_L1有限N分区原子事务;

import 海中鱼巣.核心.服务.L1事实基座;

export namespace 海中鱼巣 {
int 运行DATA_L1有限N分区原子事务端到端测试() noexcept;
}

module :private;

namespace 海中鱼巣::DATA_L1有限N分区原子事务测试内部 {

struct 隔离根清理 final {
    std::filesystem::path 根;
    ~隔离根清理() {
        std::error_code 错误;
        std::filesystem::remove_all(根, 错误);
    }
};

int 失败(const char* 编号, const char* 步骤) noexcept {
    std::cout << "[DATA-L1-N-ATOMIC][" << 编号 << "] 失败："
              << 步骤 << "\n";
    return 1;
}

void 通过(const char* 编号, const char* 说明) {
    std::cout << "[DATA-L1-N-ATOMIC][" << 编号 << "] PASS："
              << 说明 << "\n";
}

struct 参与者组 final {
    std::vector<L1所有者范围建立幂等身份> 建立身份组;
    std::vector<L1结构所有者身份> 所有者组;
    std::vector<L1所有者范围写端口> 端口组;
};

std::optional<std::uint64_t> 当前代次(const L1事实基座运行包& 运行包) {
    const auto 结果 = 运行包.读取服务().读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (结果.状态 != L1中性读取状态::成功) return std::nullopt;
    return 结果.事实代次;
}

std::optional<参与者组> 建立参与者(
    L1事实基座运行包& 运行包, std::size_t 数量, std::uint64_t 身份基数) {
    参与者组 结果;
    结果.建立身份组.reserve(数量);
    结果.所有者组.reserve(数量);
    结果.端口组.reserve(数量);
    for (std::size_t 序号 = 0; 序号 != 数量; ++序号) {
        const L1所有者范围建立幂等身份 建立身份{身份基数 + 序号 + 1};
        auto 交付 = 运行包.所有者范围签发器().建立所有者范围(
            {L1所有者范围CRUD合同版本, 建立身份,
                L1所有者范围种类::独占结构范围});
        if (交付.建立结果.状态 != L1所有者范围管理状态::成功
            || !交付.建立结果.所有者事实 || !交付.写入端口)
            return std::nullopt;
        结果.建立身份组.push_back(建立身份);
        结果.所有者组.push_back(交付.建立结果.所有者事实->所有者);
        结果.端口组.push_back(std::move(*交付.写入端口));
    }
    return 结果;
}

std::optional<std::vector<L1所有者范围写端口>> 重新签发参与者(
    L1事实基座运行包& 运行包,
    const std::vector<L1结构所有者身份>& 所有者组,
    const std::vector<L1所有者范围建立幂等身份>& 建立身份组) {
    if (所有者组.size() != 建立身份组.size()) return std::nullopt;
    std::vector<L1所有者范围写端口> 端口组;
    端口组.reserve(所有者组.size());
    for (std::size_t 序号 = 0; 序号 != 所有者组.size(); ++序号) {
        auto 交付 = 运行包.所有者范围签发器().重新签发所有者范围写端口(
            {L1所有者范围CRUD合同版本, 所有者组[序号], 建立身份组[序号]});
        if (交付.重入结果.状态 != L1所有者范围管理状态::成功
            || !交付.写入端口)
            return std::nullopt;
        端口组.push_back(std::move(*交付.写入端口));
    }
    return 端口组;
}

L1有限N分区原子事务请求_v3 形成节点请求(
    const 参与者组& 参与者, std::uint64_t G0,
    std::uint64_t 组合身份, std::uint64_t 内部身份基数) {
    L1有限N分区原子事务请求_v3 请求;
    请求.合同版本 = L1有限N分区原子事务合同版本_v3;
    请求.共同期望事实代次 = G0;
    请求.组合写入幂等身份 = {组合身份};
    请求.参与者写集组.reserve(参与者.所有者组.size());
    for (std::size_t 序号 = 0; 序号 != 参与者.所有者组.size(); ++序号) {
        L1有限N分区原子参与者写集_v3 项;
        项.参与者 = {static_cast<std::uint8_t>(序号 + 1)};
        项.所有者 = 参与者.所有者组[序号];
        项.写集.合同版本 = L1所有者范围CRUD合同版本;
        项.写集.期望事实代次 = G0;
        项.写集.写入幂等身份 = {内部身份基数 + 序号 + 1};
        项.写集.节点.push_back(
            {{1}, 节点种类::普通, std::nullopt});
        请求.参与者写集组.push_back(std::move(项));
    }
    return 请求;
}

std::vector<const L1所有者范围写端口*> 形成其余端口(
    const std::vector<L1所有者范围写端口>& 端口组) {
    std::vector<const L1所有者范围写端口*> 结果;
    if (端口组.size() < 2) return 结果;
    结果.reserve(端口组.size() - 1);
    for (std::size_t 序号 = 1; 序号 != 端口组.size(); ++序号)
        结果.push_back(&端口组[序号]);
    return 结果;
}

bool 正式读回全部节点(const L1事实基座运行包& 运行包,
    const L1有限N分区原子事务结果_v3& 写入) {
    for (const auto& 参与者 : 写入.参与者结果组) {
        const auto 节点映射 = std::find_if(参与者.新编码映射.begin(),
            参与者.新编码映射.end(), [](const auto& 项) {
                return 项.first == L1所有者范围写集本地键{1};
            });
        if (节点映射 == 参与者.新编码映射.end()) return false;
        const auto 读取 = 运行包.读取服务().读取所有者范围当前节点(
            {L1所有者范围CRUD合同版本,
                节点映射->second});
        if (读取.状态 != L1所有者范围读取状态::成功
            || 读取.读取事实代次 != 写入.共同事实代次 || !读取.事实)
            return false;
        const auto* 节点 = std::get_if<L1所有者范围节点事实>(&*读取.事实);
        if (!节点 || 节点->写入所有者 != 参与者.所有者
            || 节点->创建事实代次 != 写入.共同事实代次)
            return false;
    }
    return true;
}

bool 验证正常数量(std::size_t 数量, std::uint64_t 身份基数) {
    auto 运行包 = 建立L1事实基座运行包();
    auto 参与者 = 建立参与者(运行包, 数量, 身份基数);
    const auto G0 = 当前代次(运行包);
    if (!参与者 || !G0) return false;
    auto 请求 = 形成节点请求(*参与者, *G0,
        身份基数 + 0x10000, 身份基数 + 0x20000);
    const auto 其余端口 = 形成其余端口(参与者->端口组);
    const auto 结果 = 参与者->端口组.front().提交有限N分区原子事务_v3(
        请求, 其余端口);
    const auto G1 = 当前代次(运行包);
    return 结果.状态 == L1有限N分区原子事务状态_v3::已提交
        && 结果.合同版本 == L1有限N分区原子事务合同版本_v3
        && 结果.共同事实代次 == *G0 + 1
        && 结果.参与者结果组.size() == 数量
        && G1 && *G1 == 结果.共同事实代次
        && 正式读回全部节点(运行包, 结果);
}

bool 验证参与者普通写失败零泄漏(
    std::size_t 失败序号, std::uint64_t 身份基数) {
    auto 运行包 = 建立L1事实基座运行包();
    auto 参与者 = 建立参与者(运行包, 4, 身份基数);
    const auto G0 = 当前代次(运行包);
    if (!参与者 || !G0 || 失败序号 >= 参与者->所有者组.size())
        return false;
    auto 请求 = 形成节点请求(*参与者, *G0,
        身份基数 + 0x10000, 身份基数 + 0x20000);
    auto& 失败写集 = 请求.参与者写集组[失败序号].写集;
    失败写集.关系.push_back({{2}, L1所有者范围写集本地键{1},
        L1所有者范围写集本地键{1}, 稳定编码{身份基数 + 0x30000}, 1});
    const auto 其余端口 = 形成其余端口(参与者->端口组);
    const auto 失败结果 = 参与者->端口组.front().提交有限N分区原子事务_v3(
        请求, 其余端口);
    const auto 失败后G = 当前代次(运行包);
    if (失败结果.状态 != L1有限N分区原子事务状态_v3::内部不一致
        || !失败后G || *失败后G != *G0) {
        std::cerr << "V05 first failure index=" << 失败序号
            << " status=" << static_cast<unsigned>(失败结果.状态)
            << " G0=" << *G0
            << " Gafter=" << (失败后G ? *失败后G : 0) << '\n';
        return false;
    }

    失败写集.关系.front().关系类型节点 = L1所有者范围写集本地键{1};
    const auto 修正结果 = 参与者->端口组.front().提交有限N分区原子事务_v3(
        请求, 其余端口);
    const auto 已读回 = 正式读回全部节点(运行包, 修正结果);
    const auto 成功 = 修正结果.状态 == L1有限N分区原子事务状态_v3::已提交
        && 修正结果.共同事实代次 == *G0 + 1
        && 已读回;
    if (!成功)
        std::cerr << "V05 retry index=" << 失败序号
            << " status=" << static_cast<unsigned>(修正结果.状态)
            << " G1=" << 修正结果.共同事实代次
            << " expected=" << (*G0 + 1)
            << " participants=" << 修正结果.参与者结果组.size()
            << " readback=" << 已读回 << '\n';
    return 成功;
}

} // namespace 海中鱼巣::DATA_L1有限N分区原子事务测试内部

namespace 海中鱼巣 {

int 运行DATA_L1有限N分区原子事务端到端测试() noexcept {
    using namespace DATA_L1有限N分区原子事务测试内部;
    try {
        constexpr std::uint64_t 身份域 = 0x4E50'4152'5400'0000ULL;
        for (const auto 数量 : {std::size_t{2}, std::size_t{3},
                std::size_t{4}, std::size_t{8}, std::size_t{255}})
            if (!验证正常数量(数量, 身份域 + 数量 * 0x100000))
                return 失败("V01", "2/3/4/8/255 参与者共同 G1 与正式读回");
        通过("V01", "2/3/4/8/255 参与者共同 G1 与逐 owner 正式读回");

        auto 运行包 = 建立L1事实基座运行包();
        auto 参与者 = 建立参与者(运行包, 4, 身份域 + 0x10000000);
        auto G0 = 当前代次(运行包);
        if (!参与者 || !G0) return 失败("V02", "建立四参与者");
        auto 请求 = 形成节点请求(*参与者, *G0,
            身份域 + 0x11000000, 身份域 + 0x12000000);
        auto 其余端口 = 形成其余端口(参与者->端口组);
        const auto 首次 = 参与者->端口组.front().提交有限N分区原子事务_v3(
            请求, 其余端口);
        const auto 重复 = 参与者->端口组.front().提交有限N分区原子事务_v3(
            请求, 其余端口);
        const auto 重复后G = 当前代次(运行包);
        if (首次.状态 != L1有限N分区原子事务状态_v3::已提交
            || 重复.状态 != L1有限N分区原子事务状态_v3::精确重复
            || 重复.共同事实代次 != 首次.共同事实代次
            || 重复.参与者结果组 != 首次.参与者结果组
            || !重复后G || *重复后G != 首次.共同事实代次)
            return 失败("V02", "精确重复零新代次");
        auto 异义 = 请求;
        异义.参与者写集组.front().写集.节点.front().种类 = 节点种类::属性类型;
        const auto 异义结果 = 参与者->端口组.front().提交有限N分区原子事务_v3(
            异义, 其余端口);
        if (异义结果.状态 != L1有限N分区原子事务状态_v3::幂等冲突)
            return 失败("V02", "同组合键异义冲突");
        通过("V02", "精确重复与同键异义分账");

        L1有限N分区原子事务请求_v3 空请求;
        空请求.共同期望事实代次 = *重复后G;
        空请求.组合写入幂等身份 = {身份域 + 0x13000000};
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                空请求, {}).状态 != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "N=0");
        auto 单请求 = 形成节点请求(*参与者, *重复后G,
            身份域 + 0x13000001, 身份域 + 0x13010000);
        单请求.参与者写集组.resize(1);
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                单请求, {}).状态 != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "N=1");
        auto 超限请求 = 请求;
        超限请求.组合写入幂等身份 = {身份域 + 0x13000002};
        while (超限请求.参与者写集组.size() <= 255)
            超限请求.参与者写集组.push_back(
                超限请求.参与者写集组.back());
        std::vector<const L1所有者范围写端口*> 超限端口(255,
            &参与者->端口组.back());
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                超限请求, 超限端口).状态
                != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "N=256");
        auto 重复端口 = 其余端口;
        重复端口[1] = 重复端口[0];
        auto 新请求 = 形成节点请求(*参与者, *重复后G,
            身份域 + 0x13000003, 身份域 + 0x13020000);
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                新请求, 重复端口).状态
                != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "重复端口");
        auto 错序端口 = 其余端口;
        std::swap(错序端口[0], 错序端口[1]);
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                新请求, 错序端口).状态
                != L1有限N分区原子事务状态_v3::引用冲突)
            return 失败("V03", "owner 错配端口");
        auto 身份重复请求 = 新请求;
        身份重复请求.组合写入幂等身份 = {身份域 + 0x13000004};
        身份重复请求.参与者写集组[1].参与者 = {1};
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                身份重复请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "参与者身份重复并缺项");
        auto 身份不连续请求 = 新请求;
        身份不连续请求.组合写入幂等身份 = {身份域 + 0x13000005};
        身份不连续请求.参与者写集组.back().参与者 = {5};
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                身份不连续请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "参与者身份不连续");
        auto owner重复请求 = 新请求;
        owner重复请求.组合写入幂等身份 = {身份域 + 0x13000006};
        owner重复请求.参与者写集组[1].所有者 =
            owner重复请求.参与者写集组[0].所有者;
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                owner重复请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::引用冲突)
            return 失败("V03", "owner 重复");
        auto 幂等重复请求 = 新请求;
        幂等重复请求.组合写入幂等身份 = {身份域 + 0x13000007};
        幂等重复请求.参与者写集组[1].写集.写入幂等身份 =
            幂等重复请求.参与者写集组[0].写集.写入幂等身份;
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                幂等重复请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "内部幂等身份重复");
        auto 空端口 = 其余端口;
        空端口[1] = nullptr;
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                新请求, 空端口).状态
                != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V03", "空端口");
        auto 异实例包 = 建立L1事实基座运行包();
        auto 异实例参与者 = 建立参与者(
            异实例包, 1, 身份域 + 0x13100000);
        if (!异实例参与者) return 失败("V03", "异实例端口准备");
        auto 异实例端口 = 其余端口;
        异实例端口[1] = &异实例参与者->端口组.front();
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                新请求, 异实例端口).状态
                != L1有限N分区原子事务状态_v3::内部不一致)
            return 失败("V03", "跨实例端口");
        const auto 非法后G = 当前代次(运行包);
        if (!非法后G || *非法后G != *重复后G)
            return 失败("V03", "非法矩阵必须整笔零写");
        通过("V03", "非法 N、身份、owner、幂等和端口矩阵写前拒绝");

        auto 漂移请求 = 新请求;
        漂移请求.共同期望事实代次 = *G0;
        for (auto& 项 : 漂移请求.参与者写集组)
            项.写集.期望事实代次 = *G0;
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                漂移请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::事实代次漂移)
            return 失败("V04", "旧 G0 漂移");
        auto 前向引用请求 = 新请求;
        前向引用请求.组合写入幂等身份 = {身份域 + 0x14000000};
        auto& 第一写集 = 前向引用请求.参与者写集组[0].写集;
        第一写集.节点.push_back(
            {{2}, 节点种类::属性类型, L1所有者范围值表示种类::I64});
        第一写集.值.push_back({{3}, L1所有者范围写集本地键{1},
            L1所有者范围写集本地键{2}, L1所有者范围原始值材料{std::int64_t{1}},
            L1有限N分区原子事实引用_v3{{2}, {1}}});
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                前向引用请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::引用冲突)
            return 失败("V04", "前向跨参与者引用");
        auto 本地键重复请求 = 新请求;
        本地键重复请求.组合写入幂等身份 = {身份域 + 0x14000001};
        本地键重复请求.参与者写集组[1].写集.节点.push_back(
            {{1}, 节点种类::普通, std::nullopt});
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                本地键重复请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::入口拒绝)
            return 失败("V04", "参与者内本地键重复");
        auto 自跨引用请求 = 新请求;
        自跨引用请求.组合写入幂等身份 = {身份域 + 0x14000002};
        auto& 自跨写集 = 自跨引用请求.参与者写集组[0].写集;
        自跨写集.节点.push_back(
            {{2}, 节点种类::属性类型, L1所有者范围值表示种类::I64});
        自跨写集.值.push_back({{3}, L1所有者范围写集本地键{1},
            L1所有者范围写集本地键{2},
            L1所有者范围原始值材料{std::int64_t{1}},
            L1有限N分区原子事实引用_v3{{1}, {1}}});
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                自跨引用请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::引用冲突)
            return 失败("V04", "自跨参与者引用");
        auto 缺失跨引用请求 = 新请求;
        缺失跨引用请求.组合写入幂等身份 = {身份域 + 0x14000003};
        auto& 缺失写集 = 缺失跨引用请求.参与者写集组[1].写集;
        缺失写集.节点.push_back(
            {{2}, 节点种类::属性类型, L1所有者范围值表示种类::I64});
        缺失写集.值.push_back({{3}, L1所有者范围写集本地键{1},
            L1所有者范围写集本地键{2},
            L1所有者范围原始值材料{std::int64_t{1}},
            L1有限N分区原子事实引用_v3{{1}, {99}}});
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                缺失跨引用请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::引用冲突)
            return 失败("V04", "缺失跨参与者引用");
        auto 跨owner值请求 = 新请求;
        跨owner值请求.组合写入幂等身份 = {身份域 + 0x14000004};
        auto& 跨owner写集 = 跨owner值请求.参与者写集组[1].写集;
        跨owner写集.节点.push_back(
            {{2}, 节点种类::属性类型, L1所有者范围值表示种类::I64});
        跨owner写集.属性槽变更.push_back(
            {L1所有者范围写集本地键{1},
                L1所有者范围写集本地键{2}, {1}});
        if (参与者->端口组.front().提交有限N分区原子事务_v3(
                跨owner值请求, 其余端口).状态
                != L1有限N分区原子事务状态_v3::引用冲突)
            return 失败("V04", "属性槽不得使用其它 owner 的新值键");
        const auto 引用拒绝后G = 当前代次(运行包);
        if (!引用拒绝后G || *引用拒绝后G != *重复后G)
            return 失败("V04", "引用与键拒绝必须整笔零写");
        通过("V04", "G0、键、前向、自跨、缺失引用与属性槽边界零写");

        for (const auto [序号, 偏移] : {
                std::pair<std::size_t, std::uint64_t>{0, 0x15000000},
                {2, 0x16000000}, {3, 0x17000000}})
            if (!验证参与者普通写失败零泄漏(
                    序号, 身份域 + 偏移))
                return 失败("V05", "第1/中间/末参与者失败后首次账零泄漏");
        通过("V05", "第1/中间/末参与者失败后可用原键修正提交");

        auto v2运行包 = 建立L1事实基座运行包();
        auto v2参与者 = 建立参与者(v2运行包, 3, 身份域 + 0x20000000);
        const auto v2G0 = 当前代次(v2运行包);
        if (!v2参与者 || !v2G0) return 失败("V06", "v2 回归准备");
        auto v3形状 = 形成节点请求(*v2参与者, *v2G0,
            身份域 + 0x21000000, 身份域 + 0x22000000);
        L1三分区原子事务请求_v2 v2请求;
        v2请求.合同版本 = L1三分区原子事务合同版本_v2;
        v2请求.共同期望事实代次 = v3形状.共同期望事实代次;
        v2请求.组合写入幂等身份 = v3形状.组合写入幂等身份;
        v2请求.参与者写集组 = v3形状.参与者写集组;
        const auto v2结果 = v2参与者->端口组[0].提交三分区原子事务_v2(
            v2请求, v2参与者->端口组[1], v2参与者->端口组[2]);
        if (v2结果.状态 != L1三分区原子事务状态_v2::已提交)
            return 失败("V06", "既有 v2 三参与者回归");
        auto v1运行包 = 建立L1事实基座运行包();
        auto v1参与者 = 建立参与者(v1运行包, 2, 身份域 + 0x23000000);
        const auto v1G0 = 当前代次(v1运行包);
        if (!v1参与者 || !v1G0) return 失败("V06", "v1 回归准备");
        L1跨所有者原子事务请求 v1请求;
        v1请求.共同期望事实代次 = *v1G0;
        v1请求.组合写入幂等身份 = {身份域 + 0x24000000};
        v1请求.状态写集 = {L1跨所有者原子事务参与者序号::状态,
            v1参与者->所有者组[0],
            {L1所有者范围CRUD合同版本, *v1G0,
                {身份域 + 0x24000001},
                {{{1}, 节点种类::普通, std::nullopt}}, {}, {}, {}, {}}};
        v1请求.动态写集 = {L1跨所有者原子事务参与者序号::动态,
            v1参与者->所有者组[1],
            {L1所有者范围CRUD合同版本, *v1G0,
                {身份域 + 0x24000002},
                {{{1}, 节点种类::普通, std::nullopt}}, {}, {}, {}, {}}};
        const auto v1首次 = v1参与者->端口组[0].提交跨所有者原子事务(
            v1请求, v1参与者->端口组[1]);
        const auto v1重复 = v1参与者->端口组[0].提交跨所有者原子事务(
            v1请求, v1参与者->端口组[1]);
        if (v1首次.状态 != L1跨所有者原子事务状态::已提交
            || v1首次.共同事实代次 != *v1G0 + 1
            || v1首次.状态编码映射.size() != 1
            || v1首次.动态编码映射.size() != 1
            || v1重复.状态 != L1跨所有者原子事务状态::精确重复
            || v1重复.共同事实代次 != v1首次.共同事实代次)
            return 失败("V06", "既有 v1 双参与者回归");
        通过("V06", "既有 v1/v2 原子事务入口保持成功");

        const auto 隔离根 = std::filesystem::path{L"D:\\TEMP"}
            / L"海中鱼巣" / L"DATA-L1-N-PARTITION-ATOMIC-V3"
            / (std::to_wstring(GetCurrentProcessId()) + L"-"
                + std::to_wstring(GetTickCount64()));
        隔离根清理 清理{隔离根};
        const L1事实基座持久存储配置_v1 配置{
            L1事实基座持久恢复合同版本_v1, 隔离根};
        std::vector<L1结构所有者身份> 恢复所有者;
        std::vector<L1所有者范围建立幂等身份> 恢复建立身份;
        L1有限N分区原子事务请求_v3 恢复请求;
        std::uint64_t 首次恢复G1 = 0;
        {
            auto 首会话 = 建立L1事实基座持久运行包_v1(配置);
            if (!首会话.成功() || !首会话.运行包)
                return 失败("V07", "格式3空仓建立");
            auto 恢复参与者 = 建立参与者(
                *首会话.运行包, 4, 身份域 + 0x30000000);
            const auto 恢复G0 = 当前代次(*首会话.运行包);
            if (!恢复参与者 || !恢复G0)
                return 失败("V07", "格式3参与者建立");
            恢复所有者 = 恢复参与者->所有者组;
            恢复建立身份 = 恢复参与者->建立身份组;
            恢复请求 = 形成节点请求(*恢复参与者, *恢复G0,
                身份域 + 0x31000000, 身份域 + 0x32000000);
            const auto 恢复其余 = 形成其余端口(恢复参与者->端口组);
            const auto 写入 = 恢复参与者->端口组.front()
                .提交有限N分区原子事务_v3(恢复请求, 恢复其余);
            if (写入.状态 != L1有限N分区原子事务状态_v3::已提交
                || !正式读回全部节点(*首会话.运行包, 写入))
                return 失败("V07", "格式3首次提交");
            首次恢复G1 = 写入.共同事实代次;
        }
        {
            auto 后会话 = 建立L1事实基座持久运行包_v1(配置);
            if (!后会话.成功() || !后会话.运行包
                || 后会话.恢复.状态 != L1事实基座持久恢复状态_v1::已恢复)
                return 失败("V07", "格式3恢复");
            auto 恢复端口 = 重新签发参与者(
                *后会话.运行包, 恢复所有者, 恢复建立身份);
            if (!恢复端口) return 失败("V07", "恢复后端口重签发");
            const auto 恢复其余 = 形成其余端口(*恢复端口);
            const auto 重放 = 恢复端口->front().提交有限N分区原子事务_v3(
                恢复请求, 恢复其余);
            if (重放.状态 != L1有限N分区原子事务状态_v3::精确重复
                || 重放.共同事实代次 != 首次恢复G1)
                return 失败("V07", "格式3恢复后精确重放");
        }
        通过("V07", "格式3持久恢复后 v3 幂等账收敛");
        std::cout << "[DATA-L1-N-ATOMIC][V08] NOT_RUN：缺少独立合法格式1/2固定样本；"
                     "当前解码兼容分支已编译，未以伪造样本升级为运行证据\n";
        std::cout << "[DATA-L1-N-ATOMIC] 可运行矩阵全部通过\n";
        return 0;
    } catch (const std::exception& 异常) {
        std::cout << "[DATA-L1-N-ATOMIC] 未分类异常：" << 异常.what() << "\n";
        return 1;
    } catch (...) {
        return 失败("UNCLASSIFIED", "未知异常");
    }
}

} // namespace 海中鱼巣
