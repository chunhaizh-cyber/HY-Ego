module;

#include <cstdint>
#include <iostream>
#include <memory>
#include <optional>
#include <string_view>

export module 海中鱼巣.端到端测试.需求服务;

import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2需求结构;

export namespace 海中鱼巣 {

// 端到端测试：需求服务最小真实场景闭环。
// 流程：
//   1. 建立 L1 事实基座运行包
//   2. 建立 L2 存在/特征/状态结构服务
//   3. 建立 L2 需求结构服务
//   4. 新增角色化存在（作为目标宿主存在和所属存在）
//   5. 新增统一特征定义（作为目标特征定义）
//   6. 新增特征比较注册
//   7. 新增目标状态合同（作为目标状态合同）
//   8. 新增需求并建立列表项
//   9. 读取需求身份来源 / 读取需求完整 / 读取需求目标
//  10. 按精确目标查询需求列表项
//  11. 读取需求列表成员 / 读取成员列表
//  12. 退出需求
//  13. 读取退出后的需求身份（应返回已退出或未找到）
//
// 返回 0 表示全部通过；非 0 表示失败（输出失败步骤）。
int 运行需求服务端到端测试() noexcept {
    // ===== 1. 建立 L1 事实基座运行包 =====
    auto 运行包 = 建立L1事实基座运行包();
    std::cout << "[测试] L1 事实基座运行包已建立\n";

    // ===== 2. 建立 L2 存在结构服务 =====
    auto 存在原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 存在所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((存在原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 存在原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !存在原始交付.建立结果.所有者事实
        || !存在原始交付.写入端口) {
        std::cout << "[测试] 失败：存在所有者范围建立失败\n";
        return 1;
    }
    auto 存在所有者交付 = 尝试形成L2存在所有者交付(
        运行包.读取服务(), std::move(存在原始交付));
    if (!存在所有者交付) {
        std::cout << "[测试] 失败：存在所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2存在结构服务> 存在服务;
    try {
        存在服务 = std::make_unique<L2存在结构服务>(
            运行包.读取服务(), std::move(*存在所有者交付));
    } catch (...) {
        std::cout << "[测试] 失败：存在服务构造异常\n";
        return 1;
    }
    std::cout << "[测试] L2 存在结构服务已建立\n";

    // ===== 3. 建立 L2 特征结构服务 =====
    auto 定义原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 特征定义所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((定义原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 定义原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !定义原始交付.建立结果.所有者事实
        || !定义原始交付.写入端口) {
        std::cout << "[测试] 失败：特征定义所有者范围建立失败\n";
        return 1;
    }
    auto 定义交付 = 尝试形成L2特征定义所有者交付(
        运行包.读取服务(), std::move(定义原始交付));
    if (!定义交付) {
        std::cout << "[测试] 失败：特征定义所有者交付形成失败\n";
        return 1;
    }
    auto 实例原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 特征实例所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((实例原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 实例原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !实例原始交付.建立结果.所有者事实
        || !实例原始交付.写入端口) {
        std::cout << "[测试] 失败：特征实例所有者范围建立失败\n";
        return 1;
    }
    auto 实例交付 = 尝试形成L2特征实例所有者交付(
        运行包.读取服务(), std::move(实例原始交付));
    if (!实例交付) {
        std::cout << "[测试] 失败：特征实例所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2特征结构服务> 特征服务;
    try {
        特征服务 = std::make_unique<L2特征结构服务>(
            运行包.读取服务(), *存在服务,
            std::move(*定义交付), std::move(*实例交付));
    } catch (const std::exception& e) {
        std::cout << "[测试] 失败：特征服务构造异常："
            << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[测试] 失败：特征服务构造异常\n";
        return 1;
    }
    std::cout << "[测试] L2 特征结构服务已建立\n";

    // ===== 4. 建立 L2 状态结构服务 =====
    auto 状态原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 状态所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((状态原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 状态原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !状态原始交付.建立结果.所有者事实
        || !状态原始交付.写入端口) {
        std::cout << "[测试] 失败：状态所有者范围建立失败\n";
        return 1;
    }
    auto 状态交付 = 尝试形成L2状态所有者交付(
        运行包.读取服务(), std::move(状态原始交付));
    if (!状态交付) {
        std::cout << "[测试] 失败：状态所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2状态结构服务> 状态服务;
    try {
        状态服务 = std::make_unique<L2状态结构服务>(
            运行包.读取服务(), *存在服务, *特征服务,
            std::move(*状态交付));
    } catch (const std::exception& e) {
        std::cout << "[测试] 失败：状态服务构造异常："
            << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[测试] 失败：状态服务构造异常\n";
        return 1;
    }
    std::cout << "[测试] L2 状态结构服务已建立\n";

    // ===== 5. 建立 L2 需求结构服务 =====
    auto 需求原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 需求所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((需求原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 需求原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !需求原始交付.建立结果.所有者事实
        || !需求原始交付.写入端口) {
        std::cout << "[测试] 失败：需求所有者范围建立失败\n";
        return 1;
    }
    auto 需求交付 = 尝试形成L2需求所有者交付(
        运行包.读取服务(), std::move(需求原始交付));
    if (!需求交付) {
        std::cout << "[测试] 失败：需求所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2需求结构服务> 需求服务;
    try {
        需求服务 = std::make_unique<L2需求结构服务>(
            运行包.读取服务(), *存在服务, *特征服务,
            *状态服务, std::move(*需求交付));
    } catch (const std::exception& e) {
        std::cout << "[测试] 失败：需求服务构造异常："
            << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[测试] 失败：需求服务构造异常\n";
        return 1;
    }
    std::cout << "[测试] L2 需求结构服务已建立\n";

    // ===== 6. 读取当前事实代次作为后续请求的期望代次 =====
    const auto 代次读取 = 运行包.读取服务().读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (代次读取.状态 != L1中性读取状态::成功
        || 代次读取.事实代次 == 0) {
        std::cout << "[测试] 失败：当前事实代次读取失败\n";
        return 1;
    }
    auto 当前代次 = 代次读取.事实代次;
    std::cout << "[测试] 当前事实代次：" << 当前代次 << "\n";

    // ===== 7. 新增角色化存在（作为所属存在和目标宿主存在）=====
    L2结构请求头 头{L2结构合同版本, 当前代次};
    auto 存在新增 = 存在服务->新增角色化存在(
        {头, L2结构幂等身份{1001}, L2存在单例角色键{1}});
    if (!存在新增.成功() || !存在新增.存在) {
        std::cout << "[测试] 失败：新增角色化存在(1)失败，状态="
            << static_cast<unsigned>(存在新增.结果头.状态) << "\n";
        return 1;
    }
    auto 所属存在 = 存在新增.存在->身份;
    std::cout << "[测试] 角色化存在(1)已建立\n";
    当前代次 = 存在新增.结果头.事实截止代次;

    // 第二个角色化存在（作为目标宿主存在，必须与所属存在不同）
    L2结构请求头 头2{L2结构合同版本, 当前代次};
    auto 存在新增2 = 存在服务->新增角色化存在(
        {头2, L2结构幂等身份{1002}, L2存在单例角色键{2}});
    if (!存在新增2.成功() || !存在新增2.存在) {
        std::cout << "[测试] 失败：新增角色化存在(2)失败，状态="
            << static_cast<unsigned>(存在新增2.结果头.状态) << "\n";
        return 1;
    }
    auto 目标宿主存在 = 存在新增2.存在->身份;
    std::cout << "[测试] 角色化存在(2)已建立\n";
    当前代次 = 存在新增2.结果头.事实截止代次;

    // ===== 8. 新增统一特征定义（作为目标特征定义）=====
    L2结构请求头 定义头{L2结构合同版本, 当前代次};
    auto 特征定义新增 = 特征服务->新增统一特征定义(
        {定义头, L2结构幂等身份{2001}, 1, {}, {}});
    if (!特征定义新增.成功() || !特征定义新增.特征定义) {
        std::cout << "[测试] 失败：新增统一特征定义失败，状态="
            << static_cast<unsigned>(特征定义新增.结果头.状态) << "\n";
        return 1;
    }
    auto 目标特征 = 特征定义新增.特征定义->身份;
    std::cout << "[测试] 统一特征定义已建立\n";
    当前代次 = 特征定义新增.结果头.事实截止代次;

    // ===== 9. 新增特征比较注册 =====
    L2结构请求头 比较头{L2结构合同版本, 当前代次};
    L2特征比较I64合同材料 比较合同;
    // 单位/维度/分量角色必须引用有效的普通节点（非属性类型、未退出）。
    // 复用刚创建的特征定义节点作为最小可用引用。
    比较合同.单位 = 目标特征.值;
    比较合同.维度 = 目标特征.值;
    比较合同.分量角色 = 目标特征.值;
    比较合同.允许结果位 = 3; // 排序三态 | 具名关系
    auto 比较新增 = 特征服务->新增特征比较注册(
        {比较头, L2结构幂等身份{0x1BC4'0001}, 目标特征, 比较合同});
    if (!比较新增.成功() || !比较新增.当前注册) {
        std::cout << "[测试] 失败：新增特征比较注册失败，状态="
            << static_cast<unsigned>(比较新增.结果头.状态)
            << "，事实截止代次="
            << 比较新增.结果头.事实截止代次 << "\n";
        return 1;
    }
    auto 比较注册 = 比较新增.当前注册->身份;
    std::cout << "[测试] 特征比较注册已建立\n";
    当前代次 = 比较新增.结果头.事实截止代次;

    // ===== 10. 新增目标状态合同（作为目标状态合同）=====
    L2结构请求头 合同头{L2结构合同版本, 当前代次};
    auto 合同新增 = 状态服务->新增目标状态合同(
        {合同头, L2结构幂等身份{4001}, 目标特征,
         比较注册, 100, 1, L2目标状态合同规则版本, 目标特征.值});
    if (!合同新增.成功() || !合同新增.当前合同) {
        std::cout << "[测试] 失败：新增目标状态合同失败，状态="
            << static_cast<unsigned>(合同新增.结果头.状态) << "\n";
        return 1;
    }
    auto 目标合同 = 合同新增.当前合同->身份;
    std::cout << "[测试] 目标状态合同已建立\n";
    当前代次 = 合同新增.结果头.事实截止代次;

    // ===== 11. 新增需求并建立列表项（核心写入）=====
    L2结构请求头 需求头{L2结构合同版本, 当前代次};
    L2新增需求并建立列表项请求 需求请求;
    需求请求.请求头 = 需求头;
    需求请求.幂等身份 = L2结构幂等身份{5001};
    需求请求.所属存在 = 所属存在;
    需求请求.目标宿主存在 = 目标宿主存在;
    需求请求.目标特征定义 = 目标特征;
    需求请求.目标状态合同 = 目标合同;
    需求请求.来源稳定编码 = 目标特征.值;
    auto 需求新增 = 需求服务->新增需求并建立列表项(需求请求);
    if (!需求新增.成功() || !需求新增.新建需求
        || !需求新增.新建列表项) {
        std::cout << "[测试] 失败：新增需求并建立列表项失败，状态="
            << static_cast<unsigned>(需求新增.结果头.状态)
            << "，事实截止代次="
            << 需求新增.结果头.事实截止代次 << "\n";
        return 1;
    }
    auto 新建需求 = 需求新增.新建需求->身份;
    auto 新建列表项 = 需求新增.新建列表项->身份;
    std::cout << "[测试] 需求+列表项已建立\n";
    当前代次 = 需求新增.结果头.事实截止代次;

    // ===== 12. 读取需求身份来源 =====
    L2结构请求头 读取头{L2结构合同版本, 当前代次};
    auto 身份来源 = 需求服务->读取需求身份来源(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!身份来源.成功() || !身份来源.身份来源) {
        std::cout << "[测试] 失败：读取需求身份来源失败，状态="
            << static_cast<unsigned>(身份来源.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求身份来源已验证\n";

    // ===== 13. 读取需求完整 =====
    auto 完整读取 = 需求服务->读取需求完整(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!完整读取.成功() || !完整读取.需求) {
        std::cout << "[测试] 失败：读取需求完整失败，状态="
            << static_cast<unsigned>(完整读取.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求完整已读取\n";

    // ===== 14. 读取需求目标 =====
    auto 目标读取 = 需求服务->读取需求目标(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!目标读取.成功()) {
        std::cout << "[测试] 失败：读取需求目标失败，状态="
            << static_cast<unsigned>(目标读取.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求目标已读取\n";

    // ===== 15. 按精确目标查询需求列表项 =====
    L2按精确目标查询列表项请求 精确查询;
    精确查询.请求头 = 读取头;
    精确查询.所属存在 = 所属存在;
    精确查询.目标宿主存在 = 目标宿主存在;
    精确查询.目标特征定义 = 目标特征;
    精确查询.目标状态合同 = 目标合同;
    auto 精确结果 = 需求服务->按精确目标查询需求列表项(精确查询);
    if (!精确结果.成功()) {
        std::cout << "[测试] 失败：按精确目标查询失败，状态="
            << static_cast<unsigned>(精确结果.结果头.状态) << "\n";
        return 1;
    }
    if (精确结果.唯一结果()
        && 精确结果.列表项组.front().身份.值
            != 新建列表项.值) {
        std::cout << "[测试] 失败：精确查询返回的列表项不匹配\n";
        return 1;
    }
    std::cout << "[测试] 精确目标查询已验证\n";

    // ===== 16. 读取需求列表成员 =====
    auto 列表成员 = 需求服务->读取需求列表成员(
        {读取头, L2读取类别::当前, 新建列表项, 0});
    if (!列表成员.成功()) {
        std::cout << "[测试] 失败：读取需求列表成员失败，状态="
            << static_cast<unsigned>(列表成员.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求列表成员已读取\n";

    // ===== 17. 读取成员列表 =====
    auto 成员列表 = 需求服务->读取需求成员列表(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!成员列表.成功()) {
        std::cout << "[测试] 失败：读取成员列表失败，状态="
            << static_cast<unsigned>(成员列表.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 成员列表已读取\n";

    // ===== 18. 退出需求 =====
    L2需求退出请求 退出请求;
    退出请求.请求头 = L2结构请求头{L2结构合同版本, 当前代次};
    退出请求.幂等身份 = L2结构幂等身份{5002};
    退出请求.需求 = 新建需求;
    // 自有事实闭包来自完整读取
    if (!完整读取.自有关系) {
        std::cout << "[测试] 失败：完整读取缺少自有关系引用\n";
        return 1;
    }
    退出请求.自有事实闭包.自有关系 = *完整读取.自有关系;
    退出请求.自有事实闭包.当前列表成员关系稳定编码 =
        需求新增.当前成员关系
        ? 需求新增.当前成员关系->关系稳定编码
        : 稳定编码{};
    auto 退出结果 = 需求服务->退出需求(退出请求);
    if (!退出结果.成功()) {
        std::cout << "[测试] 失败：退出需求失败，状态="
            << static_cast<unsigned>(退出结果.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求已退出\n";

    // ===== 19. 读取退出后的需求身份（应返回已退出）=====
    L2需求身份读取请求 退出后请求;
    退出后请求.合同版本 = L2结构合同版本;
    退出后请求.需求 = 新建需求;
    auto 退出后读取 = 需求服务->读取需求身份(退出后请求);
    if (退出后读取.状态 != L2需求身份读取状态::已退出
        && 退出后读取.状态 != L2需求身份读取状态::未找到) {
        std::cout << "[测试] 失败：退出后读取应返回已退出或未找到，实际="
            << static_cast<unsigned>(退出后读取.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 退出后状态验证通过\n";

    std::cout << "[测试] 全部通过\n";
    return 0;
}

} // namespace 海中鱼巣
