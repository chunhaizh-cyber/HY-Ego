module;

#include <cstdint>
#include <iostream>
#include <memory>
#include <optional>
#include <string_view>

export module 海中鱼巣.端到端测试.需求服务;

import 海中鱼巣.核心.服务.L1事实基座;
import 海中鱼巣.领域.服务.L2存在结构;
import 海中鱼巣.领域.服务.L2特征结构;
import 海中鱼巣.领域.服务.L2状态结构;
import 海中鱼巣.领域.服务.L2需求结构;
import 海中鱼巣.领域.服务.L2任务结构;
import 海中鱼巣.装配.普通应用;

export namespace 海中鱼巣 {

// 端到端测试：需求服务最小真实场景闭环。
// 流程：
//   1. 建立 L1 事实基座运行包
//   2. 建立 L2 存在/特征/状态结构服务
//   3. 建立 L2 需求结构服务
//   4. 新增角色化存在（作为目标宿主存在和所属存在）
//   5. 新增统一特征定义（作为目标特征定义）
//   6. 新增特征比较注册
//   7. 新增目标状态合同（作为目标状态合同）
//   8. 新增需求并建立列表项
//   9. 读取需求身份来源 / 读取需求完整 / 读取需求目标
//  10. 按精确目标查询需求列表项
//  11. 读取需求列表成员 / 读取成员列表
//  12. 退出需求
//  13. 读取退出后的需求身份（应返回已退出或未找到）
//
// 返回 0 表示全部通过；非 0 表示失败（输出失败步骤）。
int 运行需求服务端到端测试() noexcept {
    // ===== 1. 经普通应用装配取得同一运行包中的领域结构服务 =====
    const auto 配置 = 形成普通应用生产配置();
    if (!配置.成功()) {
        std::cout << "[测试] 失败：普通应用生产配置形成失败，状态="
            << static_cast<unsigned>(配置.状态) << "\n";
        return 1;
    }
    auto 装配 = 构造普通应用上下文(*配置.配置);
    if (!装配.成功()) {
        std::cout << "[测试] 失败：普通应用上下文装配失败，状态="
            << static_cast<unsigned>(装配.状态) << "\n";
        return 1;
    }
    auto* 存在服务 = &装配.上下文->取得L2存在结构服务();
    auto* 特征服务 = &装配.上下文->取得L2特征结构服务();
    auto* 状态服务 = &装配.上下文->取得L2状态结构服务();
    auto* 需求服务 = &装配.上下文->取得L2需求结构服务();
    auto* 任务服务 = &装配.上下文->取得L2任务结构服务();
    if (需求服务 != &装配.上下文->取得L2需求结构服务()
        || 任务服务 != &装配.上下文->取得L2任务结构服务()) {
        std::cout << "[测试] 失败：需求或任务服务不是同实例入口\n";
        return 1;
    }
    std::cout << "[测试] 普通应用需求与任务结构服务已取得\n";

    // ===== 2. 经公开结构服务读取当前事实代次 =====
    const auto 代次读取 = 存在服务->读取当前事实代次();
    if (代次读取.状态 != L2结构状态::已读取
        || 代次读取.事实截止代次 == 0) {
        std::cout << "[测试] 失败：当前事实代次读取失败\n";
        return 1;
    }
    auto 当前代次 = 代次读取.事实截止代次;
    std::cout << "[测试] 当前事实代次：" << 当前代次 << "\n";

    // ===== 7. 新增角色化存在（作为所属存在和目标宿主存在）=====
    L2结构请求头 头{L2结构合同版本, 当前代次};
    auto 存在新增 = 存在服务->新增角色化存在(
        {头, L2结构幂等身份{1001}, L2存在单例角色键{1}});
    if (!存在新增.成功() || !存在新增.存在) {
        std::cout << "[测试] 失败：新增角色化存在(1)失败，状态="
            << static_cast<unsigned>(存在新增.结果头.状态) << "\n";
        return 1;
    }
    auto 所属存在 = 存在新增.存在->身份;
    std::cout << "[测试] 角色化存在(1)已建立\n";
    当前代次 = 存在新增.结果头.事实截止代次;

    // 第二个角色化存在（作为目标宿主存在，必须与所属存在不同）
    L2结构请求头 头2{L2结构合同版本, 当前代次};
    auto 存在新增2 = 存在服务->新增角色化存在(
        {头2, L2结构幂等身份{1002}, L2存在单例角色键{2}});
    if (!存在新增2.成功() || !存在新增2.存在) {
        std::cout << "[测试] 失败：新增角色化存在(2)失败，状态="
            << static_cast<unsigned>(存在新增2.结果头.状态) << "\n";
        return 1;
    }
    auto 目标宿主存在 = 存在新增2.存在->身份;
    std::cout << "[测试] 角色化存在(2)已建立\n";
    当前代次 = 存在新增2.结果头.事实截止代次;

    // ===== 8. 新增统一特征定义（作为目标特征定义）=====
    L2结构请求头 定义头{L2结构合同版本, 当前代次};
    auto 特征定义新增 = 特征服务->新增统一特征定义(
        {定义头, L2结构幂等身份{2001}, 1, {}, {}});
    if (!特征定义新增.成功() || !特征定义新增.特征定义) {
        std::cout << "[测试] 失败：新增统一特征定义失败，状态="
            << static_cast<unsigned>(特征定义新增.结果头.状态) << "\n";
        return 1;
    }
    auto 目标特征 = 特征定义新增.特征定义->身份;
    std::cout << "[测试] 统一特征定义已建立\n";
    当前代次 = 特征定义新增.结果头.事实截止代次;

    // ===== 9. 新增特征比较注册 =====
    L2结构请求头 比较头{L2结构合同版本, 当前代次};
    L2特征比较I64合同材料 比较合同;
    // 单位/维度/分量角色必须引用有效的普通节点（非属性类型、未退出）。
    // 复用刚创建的特征定义节点作为最小可用引用。
    比较合同.单位 = 目标特征.值;
    比较合同.维度 = 目标特征.值;
    比较合同.分量角色 = 目标特征.值;
    比较合同.允许结果位 = 3; // 排序三态 | 具名关系
    auto 比较新增 = 特征服务->新增特征比较注册(
        {比较头, L2结构幂等身份{0x1BC4'0001}, 目标特征, 比较合同});
    if (!比较新增.成功() || !比较新增.当前注册) {
        std::cout << "[测试] 失败：新增特征比较注册失败，状态="
            << static_cast<unsigned>(比较新增.结果头.状态)
            << "，事实截止代次="
            << 比较新增.结果头.事实截止代次 << "\n";
        return 1;
    }
    auto 比较注册 = 比较新增.当前注册->身份;
    std::cout << "[测试] 特征比较注册已建立\n";
    当前代次 = 比较新增.结果头.事实截止代次;

    // ===== 10. 新增目标状态合同（作为目标状态合同）=====
    L2结构请求头 合同头{L2结构合同版本, 当前代次};
    auto 合同新增 = 状态服务->新增目标状态合同(
        {合同头, L2结构幂等身份{4001}, 目标特征,
         比较注册, 100, 1, L2目标状态合同规则版本, 目标特征.值});
    if (!合同新增.成功() || !合同新增.当前合同) {
        std::cout << "[测试] 失败：新增目标状态合同失败，状态="
            << static_cast<unsigned>(合同新增.结果头.状态) << "\n";
        return 1;
    }
    auto 目标合同 = 合同新增.当前合同->身份;
    std::cout << "[测试] 目标状态合同已建立\n";
    当前代次 = 合同新增.结果头.事实截止代次;

    // ===== 11. 新增需求并建立列表项（核心写入）=====
    L2结构请求头 需求头{L2结构合同版本, 当前代次};
    L2新增需求并建立列表项请求 需求请求;
    需求请求.请求头 = 需求头;
    需求请求.幂等身份 = L2结构幂等身份{5001};
    需求请求.所属存在 = 所属存在;
    需求请求.目标宿主存在 = 目标宿主存在;
    需求请求.目标特征定义 = 目标特征;
    需求请求.目标状态合同 = 目标合同;
    需求请求.来源稳定编码 = 目标特征.值;
    auto 需求新增 = 需求服务->新增需求并建立列表项(需求请求);
    if (!需求新增.成功() || !需求新增.新建需求
        || !需求新增.新建列表项) {
        std::cout << "[测试] 失败：新增需求并建立列表项失败，状态="
            << static_cast<unsigned>(需求新增.结果头.状态)
            << "，事实截止代次="
            << 需求新增.结果头.事实截止代次 << "\n";
        return 1;
    }
    auto 新建需求 = 需求新增.新建需求->身份;
    auto 新建列表项 = 需求新增.新建列表项->身份;
    std::cout << "[测试] 需求+列表项已建立\n";
    当前代次 = 需求新增.结果头.事实截止代次;

    // ===== 12. 读取需求身份来源 =====
    L2结构请求头 读取头{L2结构合同版本, 当前代次};
    auto 身份来源 = 需求服务->读取需求身份来源(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!身份来源.成功() || !身份来源.身份来源) {
        std::cout << "[测试] 失败：读取需求身份来源失败，状态="
            << static_cast<unsigned>(身份来源.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求身份来源已验证\n";

    // ===== 13. 读取需求完整 =====
    auto 完整读取 = 需求服务->读取需求完整(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!完整读取.成功() || !完整读取.需求) {
        std::cout << "[测试] 失败：读取需求完整失败，状态="
            << static_cast<unsigned>(完整读取.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求完整已读取\n";

    // ===== 14. 读取需求目标 =====
    auto 目标读取 = 需求服务->读取需求目标(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!目标读取.成功()) {
        std::cout << "[测试] 失败：读取需求目标失败，状态="
            << static_cast<unsigned>(目标读取.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求目标已读取\n";

    // ===== 15. 按精确目标查询需求列表项 =====
    L2按精确目标查询列表项请求 精确查询;
    精确查询.请求头 = 读取头;
    精确查询.所属存在 = 所属存在;
    精确查询.目标宿主存在 = 目标宿主存在;
    精确查询.目标特征定义 = 目标特征;
    精确查询.目标状态合同 = 目标合同;
    auto 精确结果 = 需求服务->按精确目标查询需求列表项(精确查询);
    if (!精确结果.成功()) {
        std::cout << "[测试] 失败：按精确目标查询失败，状态="
            << static_cast<unsigned>(精确结果.结果头.状态) << "\n";
        return 1;
    }
    if (精确结果.唯一结果()
        && 精确结果.列表项组.front().身份.值
            != 新建列表项.值) {
        std::cout << "[测试] 失败：精确查询返回的列表项不匹配\n";
        return 1;
    }
    std::cout << "[测试] 精确目标查询已验证\n";

    // ===== 16. 读取需求列表成员 =====
    auto 列表成员 = 需求服务->读取需求列表成员(
        {读取头, L2读取类别::当前, 新建列表项, 0});
    if (!列表成员.成功()) {
        std::cout << "[测试] 失败：读取需求列表成员失败，状态="
            << static_cast<unsigned>(列表成员.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求列表成员已读取\n";

    // ===== 17. 读取成员列表 =====
    auto 成员列表 = 需求服务->读取需求成员列表(
        {读取头, L2读取类别::当前, 新建需求, 0});
    if (!成员列表.成功()) {
        std::cout << "[测试] 失败：读取成员列表失败，状态="
            << static_cast<unsigned>(成员列表.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 成员列表已读取\n";

    // ===== 18. 经普通应用任务服务新增任务 =====
    L2新增任务请求 任务请求;
    任务请求.请求头 = L2结构请求头{L2结构合同版本, 当前代次};
    任务请求.幂等身份 = L2结构幂等身份{6001};
    任务请求.需求列表项 = 新建列表项;
    auto 任务新增 = 任务服务->新增任务(任务请求);
    if (!任务新增.成功() || !任务新增.任务
        || 任务新增.任务->需求列表项 != 新建列表项) {
        std::cout << "[测试] 失败：新增任务失败，状态="
            << static_cast<unsigned>(任务新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 新建任务 = 任务新增.任务->身份;
    当前代次 = 任务新增.结果头.事实截止代次;
    std::cout << "[测试] 任务已建立\n";

    // ===== 19. 读取任务并核对任务核心 =====
    const L2结构请求头 任务读取头{L2结构合同版本, 当前代次};
    auto 任务读取 = 任务服务->读取任务(
        {任务读取头, L2读取类别::当前, 新建任务, 0});
    if (!任务读取.成功() || !任务读取.任务
        || 任务读取.任务->身份 != 新建任务
        || 任务读取.任务->需求列表项 != 新建列表项) {
        std::cout << "[测试] 失败：读取任务核心失败，状态="
            << static_cast<unsigned>(任务读取.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 任务核心已读取\n";

    // ===== 20. 按需求列表项反查同一当前任务 =====
    auto 任务反查 = 任务服务->按需求列表项读取当前任务(
        {任务读取头, 新建列表项});
    if (!任务反查.成功() || !任务反查.任务
        || 任务反查.任务->身份 != 新建任务) {
        std::cout << "[测试] 失败：按需求列表项反查任务失败，状态="
            << static_cast<unsigned>(任务反查.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求列表项任务反查已验证\n";

    // ===== 21. 退出任务并权威读回 =====
    auto 任务退出 = 任务服务->退出任务(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{6002}, 新建任务});
    if (!任务退出.成功()) {
        std::cout << "[测试] 失败：退出任务失败，状态="
            << static_cast<unsigned>(任务退出.结果头.状态) << "\n";
        return 1;
    }
    当前代次 = 任务退出.结果头.事实截止代次;
    auto 任务退出后读取 = 任务服务->读取任务(
        {{L2结构合同版本, 当前代次}, L2读取类别::当前, 新建任务, 0});
    if (任务退出后读取.成功()
        || (任务退出后读取.结果头.状态 != L2结构状态::已退出
            && 任务退出后读取.结果头.状态 != L2结构状态::未找到)) {
        std::cout << "[测试] 失败：任务退出后仍可当前读取，状态="
            << static_cast<unsigned>(任务退出后读取.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 任务退出后读回已验证\n";

    // ===== 22. 退出需求 =====
    L2需求退出请求 退出请求;
    退出请求.请求头 = L2结构请求头{L2结构合同版本, 当前代次};
    退出请求.幂等身份 = L2结构幂等身份{5002};
    退出请求.需求 = 新建需求;
    // 自有事实闭包来自完整读取
    if (!完整读取.自有关系) {
        std::cout << "[测试] 失败：完整读取缺少自有关系引用\n";
        return 1;
    }
    退出请求.自有事实闭包.自有关系 = *完整读取.自有关系;
    退出请求.自有事实闭包.当前列表成员关系稳定编码 =
        需求新增.当前成员关系
        ? 需求新增.当前成员关系->关系稳定编码
        : 稳定编码{};
    auto 退出结果 = 需求服务->退出需求(退出请求);
    if (!退出结果.成功()) {
        std::cout << "[测试] 失败：退出需求失败，状态="
            << static_cast<unsigned>(退出结果.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 需求已退出\n";

    // ===== 23. 读取退出后的需求身份（应返回已退出）=====
    L2需求身份读取请求 退出后请求;
    退出后请求.合同版本 = L2结构合同版本;
    退出后请求.需求 = 新建需求;
    auto 退出后读取 = 需求服务->读取需求身份(退出后请求);
    if (退出后读取.状态 != L2需求身份读取状态::已退出
        && 退出后读取.状态 != L2需求身份读取状态::未找到) {
        std::cout << "[测试] 失败：退出后读取应返回已退出或未找到，实际="
            << static_cast<unsigned>(退出后读取.状态) << "\n";
        return 1;
    }
    std::cout << "[测试] 退出后状态验证通过\n";

    std::cout << "[测试] 全部通过\n";
    return 0;
}

} // namespace 海中鱼巣
