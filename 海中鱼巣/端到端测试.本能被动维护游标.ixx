export namespace 海中鱼巣 {
int 运行本能被动维护游标端到端测试() noexcept;
}

module :private;

namespace 海中鱼巣::本能被动维护游标测试内部 {

struct 隔离根清理 final {
    std::filesystem::path 根;
    ~隔离根清理() {
        std::error_code 错误;
        std::filesystem::remove_all(根, 错误);
    }
};

int 失败(const char* 编号, const char* 步骤) noexcept {
    std::cout << "[INSTINCT-CURSOR][" << 编号 << "] 失败："
              << 步骤 << '\n';
    return 1;
}

void 通过(const char* 编号, const char* 说明) {
    std::cout << "[INSTINCT-CURSOR][" << 编号 << "] PASS："
              << 说明 << '\n';
}

struct 会话_v1 final {
    std::unique_ptr<普通应用上下文> 上下文;
    本能根运行锚点_v1 本能根;
};

std::optional<会话_v1> 建立或恢复会话(
    const 普通应用配置& 配置, std::uint64_t 根启动身份) {
    const auto 会话失败 = [](const char* 阶段) -> std::optional<会话_v1> {
        std::cout << "[INSTINCT-CURSOR][会话] " << 阶段 << '\n';
        return std::nullopt;
    };
    auto 装配 = 构造普通应用上下文(配置);
    if (!装配.成功()) {
        std::cout << "[INSTINCT-CURSOR][会话] 装配状态="
                  << static_cast<unsigned>(装配.状态) << '\n';
        return std::nullopt;
    }
    auto 上下文 = std::move(装配.上下文);
    const auto 世界根 = 初始化并发布系统世界树根(
        *上下文, 系统世界树根初始化请求{});
    if (!世界根.成功() || !世界根.已发布根) return 会话失败("世界根");
    const auto& 根 = *世界根.已发布根;
    const 自我世界树根消费请求 消费请求{
        自我世界树根消费合同版本, 根.选择, 根.首次建立请求,
        根.树, 根.根场景, 根.正式树读回.根标记};
    const auto 自我世界根 = 消费并发布自我世界树根(*上下文, 消费请求);
    if (!自我世界根.成功() || !自我世界根.已发布材料)
        return 会话失败("自我世界根");
    真实自我形成提供者 自我形成者(上下文->取得L2结构聚合服务());
    真实自我形成请求 自我请求;
    自我请求.根消费材料 = *自我世界根.已发布材料;
    const auto 自我 = 自我形成者.形成(自我请求);
    if (!自我.成功() || !自我.已形成自我) return 会话失败("真实自我");
    四本体根生产初始化提供者 四本体根者(
        上下文->取得L2概念结构聚合服务());
    const auto 四本体根 = 四本体根者.初始化(四本体根生产初始化请求{});
    if (!四本体根.成功() || !四本体根.已发布材料)
        return 会话失败("四本体根");
    方法登记根生产初始化提供者 方法登记根者(
        上下文->取得L2方法结构聚合服务());
    const auto 方法根 = 方法登记根者.初始化(方法登记根生产初始化请求{});
    if (!方法根.成功() || !方法根.已发布材料) return 会话失败("方法根");
    本能根运行初始化提供者 本能根者(
        上下文->取得L2存在结构服务(),
        上下文->取得L2特征结构服务(),
        上下文->取得L2状态结构服务(),
        上下文->取得L2需求结构服务());
    const auto 本能根 = 本能根者.初始化并读取本能根运行锚点_v1({
        本能根运行初始化合同版本_v1,
        自我.已形成自我->自我存在.身份, 根启动身份});
    if (!本能根.成功() || !本能根.锚点) {
        std::cout << "[INSTINCT-CURSOR][会话] 本能根状态="
                  << static_cast<unsigned>(本能根.状态) << '\n';
        return std::nullopt;
    }
    return 会话_v1{std::move(上下文), *本能根.锚点};
}

std::optional<std::uint64_t> 当前代次(const 会话_v1& 会话) {
    return 会话.上下文->取得L2状态结构服务().读取中性当前事实代次_v1();
}

std::optional<建立或恢复本能被动维护游标请求_v1> 形成请求(
    const 会话_v1& 会话, std::uint64_t 幂等身份,
    std::uint64_t 运行代次, std::uint64_t 纪元,
    std::int64_t 边界, std::uint32_t 时间源 = 1,
    std::uint32_t 规则 = 服务时间维护规则版本_v1) {
    const auto G0 = 当前代次(会话);
    if (!G0) return std::nullopt;
    return 建立或恢复本能被动维护游标请求_v1{
        本能被动维护游标合同版本_v1,
        {L2结构合同版本, *G0},
        L2结构幂等身份{幂等身份}, 会话.本能根,
        运行代次, 纪元, 边界, 时间源, 规则};
}

本能被动维护游标读取结果_v1 读取当前(const 会话_v1& 会话) {
    const auto G = 当前代次(会话);
    if (!G) return {};
    return 会话.上下文->取得本能被动维护游标服务()
        .读取当前本能被动维护游标_v1({
            本能被动维护游标合同版本_v1,
            {L2结构合同版本, *G}, 会话.本能根.唯一自我});
}

L2特征当前值变化账登记结果_v2 登记永久变化账(会话_v1& 会话) {
    const auto G0 = 当前代次(会话);
    if (!G0) return {};
    return 会话.上下文->取得L2状态动态原子发布服务()
        .确保特征当前值变化永久账登记_v2({
            L2特征当前值变化永久账合同版本_v2,
            {L2结构合同版本, *G0}});
}

服务维护历史覆盖起点读取结果_v1 读取服务历史覆盖起点(
    const 会话_v1& 会话) {
    const auto G0 = 当前代次(会话);
    if (!G0) return {};
    return 会话.上下文->取得服务合同事实权威服务()
        .读取服务维护历史事实账覆盖起点_v1({
            服务维护历史覆盖起点合同版本_v1,
            {L2结构合同版本, *G0}, 会话.本能根.唯一自我});
}

std::optional<建立或恢复本能被动维护游标请求_v3> 形成请求_v3(
    const 会话_v1& 会话, std::uint64_t 幂等身份,
    std::uint64_t 运行代次, std::uint64_t 纪元,
    std::int64_t 边界, std::uint64_t 主动安全水位,
    const L2特征当前值变化账登记结果_v2& 变化账登记,
    std::uint64_t 服务历史水位,
    const 服务维护历史覆盖起点读取结果_v1& 服务历史起点) {
    const auto G0 = 当前代次(会话);
    if (!G0) return std::nullopt;
    return 建立或恢复本能被动维护游标请求_v3{
        本能被动维护游标合同版本_v3,
        {L2结构合同版本, *G0}, L2结构幂等身份{幂等身份},
        会话.本能根, 运行代次, 纪元, 边界,
        主动安全水位, 变化账登记,
        服务历史水位, 服务历史起点,
        1, 服务时间维护规则版本_v1};
}

本能被动维护游标读取结果_v3 读取当前_v3(const 会话_v1& 会话) {
    const auto G = 当前代次(会话);
    if (!G) return {};
    return 会话.上下文->取得本能被动维护游标服务()
        .读取当前本能被动维护游标_v3({
            本能被动维护游标合同版本_v3,
            {L2结构合同版本, *G}, 会话.本能根.唯一自我});
}

服务维护历史边界读取结果_v2 读取服务历史v2同点边界(
    const 会话_v1& 会话) {
    const auto G0 = 当前代次(会话);
    if (!G0) return {};
    return 会话.上下文->取得服务合同事实权威服务()
        .按事实代次边界读取服务维护历史完整快照_v2({
            服务维护历史边界合同版本_v2,
            {L2结构合同版本, *G0}, 会话.本能根.唯一自我,
            *G0, 1024, 1024});
}

std::optional<显式激活或恢复本能被动维护纪元请求_v1> 形成激活请求_v1(
    会话_v1& 会话, std::uint64_t 幂等身份,
    std::uint64_t 运行代次, std::uint64_t 时间纪元,
    std::int64_t 完整秒 = 0) {
    const auto 主动安全 = 登记永久变化账(会话);
    const auto G0 = 当前代次(会话);
    if (!主动安全.成功() || !G0) return std::nullopt;
    const auto 服务历史 = 会话.上下文->取得服务合同事实权威服务()
        .按事实代次边界读取服务维护历史完整快照_v2({
            服务维护历史边界合同版本_v2,
            {L2结构合同版本, *G0}, 会话.本能根.唯一自我,
            *G0, 1024, 1024});
    if (!服务历史.成功() || !服务历史.快照
        || 服务历史.快照->左边界事实代次 != *G0
        || 服务历史.快照->包含结束事实代次 != *G0
        || 服务历史.本次正式读回截止 != *G0)
        return std::nullopt;
    return 显式激活或恢复本能被动维护纪元请求_v1{
        本能被动维护纪元激活合同版本_v1,
        {L2结构合同版本, *G0}, L2结构幂等身份{幂等身份},
        会话.本能根, 运行代次, 时间纪元, 完整秒,
        主动安全, 服务历史, 1, 服务时间维护规则版本_v1};
}

本能被动维护游标读取结果_v4 读取当前_v4(const 会话_v1& 会话) {
    const auto G = 当前代次(会话);
    if (!G) return {};
    return 会话.上下文->取得本能被动维护游标服务()
        .读取当前本能被动维护游标_v4({
            本能被动维护游标合同版本_v4,
            {L2结构合同版本, *G}, 会话.本能根.唯一自我});
}

普通应用配置 形成隔离配置(const std::filesystem::path& 根) {
    普通应用配置 配置;
    配置.L1事实基座持久存储 = {
        L1事实基座持久恢复合同版本_v1, 根 / L"l1"};
    配置.不可变材料存储 = {
        L2结构合同版本, {根 / L"material"}};
    return 配置;
}

int 运行Gseed显式激活专项(const std::filesystem::path& 总根) {
    constexpr std::uint64_t 根身份 = 0x4753'4545'4400'0001ULL;
    constexpr std::uint64_t 键 = 0x4753'4545'4401'0001ULL;
    const auto 配置 = 形成隔离配置(总根 / L"gseed-v4");
    auto 会话 = 建立或恢复会话(配置, 根身份);
    if (!会话) return 失败("G01", "建立 v4 会话");
    const auto 未建立 = 读取当前_v4(*会话);
    if (未建立.状态 != 本能被动维护游标读取状态_v4::未建立
        || 未建立.成功())
        return 失败("G01", "v4 初始未建立");
    auto 请求 = 形成激活请求_v1(*会话, 键, 701, 701, 7);
    if (!请求) return 失败("G01", "形成 G0/Gseed 激活请求");
    auto& 服务 = 会话->上下文->取得本能被动维护游标服务();
    const auto 激活 = 服务.显式激活或恢复本能被动维护纪元_v1(*请求);
    const auto 读回 = 读取当前_v4(*会话);
    if (!激活.成功() || 激活.状态 != 本能被动维护纪元激活状态_v1::已激活
        || !激活.提交游标 || !激活.激活见证
        || !读回.成功() || 读回.游标 != 激活.提交游标
        || 激活.提交游标->维护纪元身份 != 键
        || 激活.提交游标->上一已维护完整秒边界 != 7
        || 激活.提交游标->已消费主动安全变化事实代次
            != 请求->主动安全变化账登记见证.首次登记事实代次
        || 激活.提交游标->已消费服务维护历史事实代次
            != 请求->服务历史v2边界见证.快照->v2覆盖登记事实代次
        || 激活.提交游标->服务历史v2覆盖种子事实代次
            != 请求->服务历史v2边界见证.快照->v2覆盖登记事实代次
        || 激活.提交游标->成功维护提交序号 != 0
        || 激活.激活见证->Gseed前服务历史不补算结束边界
            != 激活.激活见证->Gseed)
        return 失败("G01", "A 激活与 v4 逐字段独立读回");
    const auto 首次事实代次 = 激活.提交游标->形成事实代次;
    通过("G01", "全新 A 形成维护纪元、Gseed 放弃边界和零成功序号");

    const auto 重复 = 服务.显式激活或恢复本能被动维护纪元_v1(*请求);
    auto 同键异义请求 = *请求;
    ++同键异义请求.当前完整秒边界;
    const auto 同键异义 =
        服务.显式激活或恢复本能被动维护纪元_v1(同键异义请求);
    auto 异键请求 = 形成激活请求_v1(*会话, 键 + 1, 701, 701, 7);
    const auto 异键恢复 = 异键请求
        ? 服务.显式激活或恢复本能被动维护纪元_v1(*异键请求)
        : 本能被动维护纪元激活结果_v1{};
    if (!重复.成功() || 重复.状态 != 本能被动维护纪元激活状态_v1::精确重复
        || !重复.提交游标 || 重复.提交游标->形成事实代次 != 首次事实代次
        || 同键异义.状态 != 本能被动维护纪元激活状态_v1::幂等冲突
        || 同键异义.成功() || !异键恢复.成功()
        || 异键恢复.状态 != 本能被动维护纪元激活状态_v1::已恢复
        || !异键恢复.提交游标
        || 异键恢复.提交游标->维护纪元身份 != 键
        || 异键恢复.提交游标->形成事实代次 != 首次事实代次)
        return 失败("G02", "精确重复、冲突与异键恢复");
    通过("G02", "同键重放、同键异义和异键同义恢复保持原维护纪元");

    const auto G投影 = 当前代次(*会话);
    const auto v1投影 = G投影 ? 服务.读取当前本能被动维护游标_v1({
        本能被动维护游标合同版本_v1, {L2结构合同版本, *G投影},
        会话->本能根.唯一自我}) : 本能被动维护游标读取结果_v1{};
    const auto v2投影 = G投影 ? 服务.读取当前本能被动维护游标_v2({
        本能被动维护游标合同版本_v2, {L2结构合同版本, *G投影},
        会话->本能根.唯一自我}) : 本能被动维护游标读取结果_v2{};
    const auto v3投影 = G投影 ? 服务.读取当前本能被动维护游标_v3({
        本能被动维护游标合同版本_v3, {L2结构合同版本, *G投影},
        会话->本能根.唯一自我}) : 本能被动维护游标读取结果_v3{};
    if (!v1投影.成功() || !v2投影.成功() || !v3投影.成功()
        || !v1投影.游标 || !v2投影.游标 || !v3投影.游标
        || v1投影.游标->上一已维护完整秒边界 != 7
        || v2投影.游标->已消费主动安全变化事实代次
            != 激活.提交游标->已消费主动安全变化事实代次
        || v3投影.游标->已消费服务维护历史事实代次
            != 激活.提交游标->已消费服务维护历史事实代次)
        return 失败("G03", "v4 对 v1/v2/v3 索引受限投影");
    通过("G03", "11 项 v4 对旧读取提供字段受限兼容投影");

    const auto 持久期望 = *激活.提交游标;
    const auto 锚点 = 会话->本能根;
    会话->上下文.reset();
    auto 重启装配 = 构造普通应用上下文(配置);
    if (!重启装配.成功() || !重启装配.上下文)
        return 失败("G04", "v4 重启装配");
    会话_v1 重启会话{std::move(重启装配.上下文), 锚点};
    const auto 重启读回 = 读取当前_v4(重启会话);
    if (!重启读回.成功() || !重启读回.游标
        || *重启读回.游标 != 持久期望)
        return 失败("G04", "v4 持久重启逐字段恢复");
    通过("G04", "维护纪元、Gseed、零成功序号与形成代次持久恢复");

    const auto 验证旧格式 = [&](const wchar_t* 子目录, int 版本) -> bool {
        auto 旧会话 = 建立或恢复会话(形成隔离配置(总根 / 子目录),
            根身份 + static_cast<std::uint64_t>(版本));
        if (!旧会话) return false;
        auto& 旧服务 = 旧会话->上下文->取得本能被动维护游标服务();
        bool 已建 = false;
        if (版本 == 1) {
            const auto r = 形成请求(*旧会话, 键 + 100 + 版本, 801, 801, 0);
            已建 = r && 旧服务.建立或恢复本能被动维护游标_v1(*r).成功();
        } else {
            const auto 变化账 = 登记永久变化账(*旧会话);
            const auto G = 当前代次(*旧会话);
            if (版本 == 2) {
                已建 = G && 变化账.成功()
                    && 旧服务.建立或恢复本能被动维护游标_v2({
                        本能被动维护游标合同版本_v2,
                        {L2结构合同版本, *G},
                        L2结构幂等身份{键 + 100 + static_cast<std::uint64_t>(版本)},
                        旧会话->本能根, 801, 801, 0,
                        变化账.首次登记事实代次, 变化账,
                        1, 服务时间维护规则版本_v1}).成功();
            } else {
                const auto 历史 = 读取服务历史覆盖起点(*旧会话);
                const auto v3请求 = 历史.成功() && 历史.快照
                    ? 形成请求_v3(*旧会话, 键 + 100 + 版本, 801, 801, 0,
                        变化账.首次登记事实代次, 变化账,
                        历史.快照->历史账登记事实代次, 历史)
                    : std::optional<建立或恢复本能被动维护游标请求_v3>{};
                已建 = v3请求
                    && 旧服务.建立或恢复本能被动维护游标_v3(*v3请求).成功();
            }
        }
        auto v4请求 = 已建
            ? 形成激活请求_v1(*旧会话, 键 + 200 + 版本, 801, 801, 0)
            : std::optional<显式激活或恢复本能被动维护纪元请求_v1>{};
        const auto G前 = 当前代次(*旧会话);
        const auto 结果 = v4请求
            ? 旧服务.显式激活或恢复本能被动维护纪元_v1(*v4请求)
            : 本能被动维护纪元激活结果_v1{};
        const auto G后 = 当前代次(*旧会话);
        return 结果.状态
                == 本能被动维护纪元激活状态_v1::旧格式成功维护历史不可证明
            && !结果.成功() && !结果.提交游标 && !结果.激活见证
            && G前 && G后 && *G前 == *G后;
    };
    if (!验证旧格式(L"legacy-v1", 1)
        || !验证旧格式(L"legacy-v2", 2)
        || !验证旧格式(L"legacy-v3", 3))
        return 失败("G05", "v1/v2/v3 U 分支与零写");
    通过("G05", "v1/v2/v3 均 fail-closed 为旧格式证明缺失且零写");
    return 0;
}

} // namespace 海中鱼巣::本能被动维护游标测试内部

namespace 海中鱼巣 {

int 运行本能被动维护游标端到端测试() noexcept {
    using namespace 本能被动维护游标测试内部;
    try {
        const auto 隔离根 = std::filesystem::path{L"D:\\TEMP"}
            / L"海中鱼巣" / L"INSTINCT-STAGE3-MAINTENANCE-CURSOR-FOUNDATION"
            / (std::to_wstring(GetCurrentProcessId()) + L"-"
                + std::to_wstring(GetTickCount64()));
        隔离根清理 清理{隔离根};
        std::error_code 错误;
        std::filesystem::create_directories(隔离根 / L"l1", 错误);
        if (错误) return 失败("S0", "建立 L1 隔离根");
        错误.clear();
        std::filesystem::create_directories(隔离根 / L"material", 错误);
        if (错误) return 失败("S0", "建立材料隔离根");
        普通应用配置 配置;
        配置.L1事实基座持久存储 = {
            L1事实基座持久恢复合同版本_v1, 隔离根 / L"l1"};
        配置.不可变材料存储 = {
            L2结构合同版本, {隔离根 / L"material"}};
        配置.等待合同登记 = 形成普通应用任务筹办等待合同登记();
        if (!配置.有效()) return 失败("S0", "隔离配置有效性");

        if (const auto Gseed结果 = 运行Gseed显式激活专项(隔离根);
            Gseed结果 != 0)
            return Gseed结果;

        constexpr std::uint64_t 根启动身份 = 0x4355'5253'4F52'0001ULL;
        constexpr std::uint64_t 键基数 = 0x4355'5253'0000'0000ULL;
        std::uint64_t 首次形成代次 = 0;
        std::optional<本能根运行锚点_v1> 重启前锚点;
        {
            auto 会话 = 建立或恢复会话(配置, 根启动身份);
            if (!会话) return 失败("C01", "建立首次会话");
            重启前锚点 = 会话->本能根;
            const auto 未建立 = 读取当前(*会话);
            if (未建立.状态 != 本能被动维护游标读取状态_v1::未建立
                || 未建立.成功())
                return 失败("C00", "初始未建立读取");
            通过("C00", "正式读取在游标形成前结构化返回未建立");
            auto 首次请求 = 形成请求(*会话, 键基数 + 1, 101, 101, 0);
            if (!首次请求) return 失败("C01", "形成首次请求");
            auto& 服务 = 会话->上下文->取得本能被动维护游标服务();
            const auto 首次 = 服务.建立或恢复本能被动维护游标_v1(*首次请求);
            if (!首次.成功()
                || 首次.状态 != 本能被动维护游标建立状态_v1::已建立
                || !首次.游标)
                return 失败("C01", "首次边界 0 建立");
            首次形成代次 = 首次.游标->形成事实代次;
            const auto 首次读回 = 读取当前(*会话);
            if (!首次读回.成功() || 首次读回.游标 != 首次.游标)
                return 失败("C01", "首次独立读回");
            通过("C01", "首次登记、边界 0 游标与独立读回");

            const auto 重放 = 服务.建立或恢复本能被动维护游标_v1(*首次请求);
            if (!重放.成功()
                || 重放.状态 != 本能被动维护游标建立状态_v1::已恢复
                || !重放.游标 || 重放.游标->形成事实代次 != 首次形成代次)
                return 失败("C02", "同键同义恢复");
            auto 同义请求 = 形成请求(*会话, 键基数 + 2, 101, 101, 0);
            if (!同义请求) return 失败("C02", "形成异键同义请求");
            const auto 同义 = 服务.建立或恢复本能被动维护游标_v1(*同义请求);
            if (!同义.成功()
                || 同义.状态 != 本能被动维护游标建立状态_v1::已恢复
                || !同义.游标 || 同义.游标->形成事实代次 != 首次形成代次)
                return 失败("C02", "异键同义零写恢复");
            通过("C02", "同键重放与异键同义均零写恢复");

            auto 同键异义 = *首次请求;
            同键异义.当前完整秒边界 = 1;
            const auto 同键冲突 =
                服务.建立或恢复本能被动维护游标_v1(同键异义);
            if (同键冲突.状态 != 本能被动维护游标建立状态_v1::幂等冲突
                || 同键冲突.成功())
                return 失败("C03", "同键异义拒绝");
            auto 同纪元推进 = 形成请求(*会话, 键基数 + 3, 101, 101, 1);
            if (!同纪元推进) return 失败("C03", "形成同纪元推进请求");
            const auto 推进拒绝 =
                服务.建立或恢复本能被动维护游标_v1(*同纪元推进);
            if (推进拒绝.状态 != 本能被动维护游标建立状态_v1::引用冲突
                || 推进拒绝.成功())
                return 失败("C03", "同纪元边界推进拒绝");
            通过("C03", "同键异义和同纪元推进均零写拒绝");

            for (const auto& [编号, 运行, 纪元, 时间源, 规则] : {
                    std::tuple{"C04-A", 102ULL, 101ULL, 1U, 1U},
                    std::tuple{"C04-B", 101ULL, 102ULL, 1U, 1U},
                    std::tuple{"C04-C", 101ULL, 101ULL, 2U, 1U},
                    std::tuple{"C04-D", 101ULL, 101ULL, 1U, 2U}}) {
                auto 请求 = 形成请求(*会话, 键基数 + 10 + 运行 + 纪元
                    + 时间源 + 规则, 运行, 纪元, 0, 时间源, 规则);
                if (!请求) return 失败("C04", 编号);
                const auto 结果 = 服务.建立或恢复本能被动维护游标_v1(*请求);
                if (结果.状态 != 本能被动维护游标建立状态_v1::引用冲突
                    || 结果.成功())
                    return 失败("C04", 编号);
            }
            通过("C04", "单边纪元变化及时间源/规则漂移拒绝");

            auto 漂移请求 = 形成请求(*会话, 键基数 + 19, 101, 101, 0);
            if (!漂移请求 || 漂移请求->请求头.期望事实代次 == 0)
                return 失败("C04-E", "形成当前性漂移请求");
            ++漂移请求->请求头.期望事实代次;
            const auto 漂移 = 服务.建立或恢复本能被动维护游标_v1(*漂移请求);
            if (漂移.状态 != 本能被动维护游标建立状态_v1::当前性漂移
                || 漂移.成功())
                return 失败("C04-E", "G0 漂移结构化拒绝");
            通过("C04-E", "G0 读前守卫漂移结构化拒绝");

            auto 新纪元请求 = 形成请求(*会话, 键基数 + 20, 202, 202, 7);
            if (!新纪元请求) return 失败("C05", "形成新纪元请求");
            const auto 新纪元 =
                服务.建立或恢复本能被动维护游标_v1(*新纪元请求);
            if (!新纪元.成功()
                || 新纪元.状态
                    != 本能被动维护游标建立状态_v1::已建立新纪元
                || !新纪元.游标
                || 新纪元.游标->形成事实代次 <= 首次形成代次)
                return 失败("C05", "建立新纪元");
            通过("C05", "运行代次与纪元共同变化建立新当前");
        }

        auto 恢复装配 = 构造普通应用上下文(配置);
        if (!恢复装配.成功() || !恢复装配.上下文 || !重启前锚点)
            return 失败("C06", "持久重启恢复装配");
        auto 恢复上下文 = std::move(恢复装配.上下文);
        本能根运行初始化提供者 恢复本能根者(
            恢复上下文->取得L2存在结构服务(),
            恢复上下文->取得L2特征结构服务(),
            恢复上下文->取得L2状态结构服务(),
            恢复上下文->取得L2需求结构服务());
        const auto 恢复本能根 =
            恢复本能根者.初始化并读取本能根运行锚点_v1({
                本能根运行初始化合同版本_v1,
                重启前锚点->唯一自我, 根启动身份 + 1});
        if (!恢复本能根.成功() || !恢复本能根.锚点
            || 恢复本能根.状态 != 本能根运行初始化状态_v1::已恢复)
            return 失败("C06", "持久重启恢复本能根锚点");
        会话_v1 恢复会话{std::move(恢复上下文), *恢复本能根.锚点};
        auto 恢复请求 = 形成请求(恢复会话, 键基数 + 30, 303, 303, 0);
        if (!恢复请求) return 失败("C06", "形成重启新纪元请求");
        auto& 恢复服务 = 恢复会话.上下文->取得本能被动维护游标服务();
        const auto 恢复建立 =
            恢复服务.建立或恢复本能被动维护游标_v1(*恢复请求);
        const auto 恢复读回 = 读取当前(恢复会话);
        if (!恢复建立.成功()
            || 恢复建立.状态
                != 本能被动维护游标建立状态_v1::已建立新纪元
            || !恢复读回.成功() || 恢复读回.游标 != 恢复建立.游标
            || !恢复建立.游标
            || 恢复建立.游标->形成事实代次 <= 首次形成代次)
            return 失败("C06", "持久重启新纪元与独立读回");
        通过("C06", "进程级持久恢复后新纪元建立并读回");

        const auto 变化账登记 = 登记永久变化账(恢复会话);
        const auto 服务历史起点 = 读取服务历史覆盖起点(恢复会话);
        if (!变化账登记.成功() || !服务历史起点.成功()
            || !服务历史起点.快照)
            return 失败("C07", "两个 owner 登记见证");
        auto v1迁移请求 = 形成请求_v3(恢复会话, 键基数 + 40,
            303, 303, 0, 变化账登记.首次登记事实代次, 变化账登记,
            服务历史起点.快照->历史账登记事实代次, 服务历史起点);
        if (!v1迁移请求) return 失败("C07", "形成 v1 到 v3 迁移请求");
        const auto v1迁移 = 恢复服务.建立或恢复本能被动维护游标_v3(
            *v1迁移请求);
        const auto v3读回 = 读取当前_v3(恢复会话);
        if (!v1迁移.成功()
            || v1迁移.状态 != 本能被动维护游标建立状态_v3::已迁移
            || !v1迁移.提交游标 || !v3读回.成功()
            || v3读回.游标 != v1迁移.提交游标
            || v3读回.游标->已消费主动安全变化事实代次
                != 变化账登记.首次登记事实代次
            || v3读回.游标->已消费服务维护历史事实代次
                != 服务历史起点.快照->历史账登记事实代次)
            return 失败("C07", "v1 到 v3 双登记水位迁移");
        const auto v1兼容投影 = 读取当前(恢复会话);
        const auto G兼容 = 当前代次(恢复会话);
        const auto v2兼容投影 = G兼容
            ? 恢复服务.读取当前本能被动维护游标_v2({
                本能被动维护游标合同版本_v2,
                {L2结构合同版本, *G兼容}, 恢复会话.本能根.唯一自我})
            : 本能被动维护游标读取结果_v2{};
        if (!v1兼容投影.成功() || !v2兼容投影.成功()
            || !v2兼容投影.游标
            || v2兼容投影.游标->已消费主动安全变化事实代次
                != 变化账登记.首次登记事实代次)
            return 失败("C07", "v3 对 v1/v2 兼容投影");
        通过("C07", "v1 迁移 v3 并保留 v1/v2 兼容读取投影");

        const auto 精确重复 = 恢复服务.建立或恢复本能被动维护游标_v3(
            *v1迁移请求);
        if (!精确重复.成功()
            || 精确重复.状态 != 本能被动维护游标建立状态_v3::精确重复
            || !精确重复.提交游标
            || 精确重复.提交游标->形成事实代次
                != v1迁移.提交游标->形成事实代次)
            return 失败("C08", "v3 精确重复");
        auto 同键异义_v3 = *v1迁移请求;
        ++同键异义_v3.目标已消费服务维护历史事实代次;
        const auto v3幂等冲突 = 恢复服务.建立或恢复本能被动维护游标_v3(
            同键异义_v3);
        if (v3幂等冲突.状态 != 本能被动维护游标建立状态_v3::幂等冲突
            || v3幂等冲突.成功())
            return 失败("C08", "v3 同键异义");
        auto 同义恢复请求 = 形成请求_v3(恢复会话, 键基数 + 41,
            303, 303, 0, 变化账登记.首次登记事实代次, 变化账登记,
            服务历史起点.快照->历史账登记事实代次, 服务历史起点);
        const auto 同义恢复 = 同义恢复请求
            ? 恢复服务.建立或恢复本能被动维护游标_v3(*同义恢复请求)
            : 本能被动维护游标建立结果_v3{};
        if (!同义恢复.成功()
            || 同义恢复.状态 != 本能被动维护游标建立状态_v3::已恢复
            || !同义恢复.提交游标
            || 同义恢复.提交游标->形成事实代次
                != v1迁移.提交游标->形成事实代次)
            return 失败("C08", "v3 异键同义恢复");
        通过("C08", "v3 精确重复、同键异义和异键同义分账");

        auto 新纪元_v3请求 = 形成请求_v3(恢复会话, 键基数 + 42,
            404, 404, 5, 变化账登记.首次登记事实代次, 变化账登记,
            服务历史起点.快照->历史账登记事实代次, 服务历史起点);
        const auto 新纪元_v3 = 新纪元_v3请求
            ? 恢复服务.建立或恢复本能被动维护游标_v3(*新纪元_v3请求)
            : 本能被动维护游标建立结果_v3{};
        if (!新纪元_v3.成功()
            || 新纪元_v3.状态
                != 本能被动维护游标建立状态_v3::已建立新纪元
            || !新纪元_v3.提交游标
            || 新纪元_v3.提交游标->已消费主动安全变化事实代次
                != 变化账登记.首次登记事实代次
            || 新纪元_v3.提交游标->已消费服务维护历史事实代次
                != 服务历史起点.快照->历史账登记事实代次)
            return 失败("C09", "v3 新纪元继承两个事实水位");
        auto 水位推进请求 = 形成请求_v3(恢复会话, 键基数 + 43,
            404, 404, 5, 变化账登记.首次登记事实代次, 变化账登记,
            服务历史起点.快照->历史账登记事实代次 + 1,
            服务历史起点);
        const auto 水位推进 = 水位推进请求
            ? 恢复服务.建立或恢复本能被动维护游标_v3(*水位推进请求)
            : 本能被动维护游标建立结果_v3{};
        if (水位推进.状态 != 本能被动维护游标建立状态_v3::引用冲突
            || 水位推进.成功())
            return 失败("C09", "建立恢复入口拒绝推进服务历史水位");
        通过("C09", "新纪元只继承两个 owner 水位且建立入口不推进水位");

        const auto v3持久期望 = *新纪元_v3.提交游标;
        恢复会话.上下文.reset();
        auto v3恢复装配 = 构造普通应用上下文(配置);
        if (!v3恢复装配.成功() || !v3恢复装配.上下文)
            return 失败("C10", "v3 持久恢复装配");
        会话_v1 v3恢复会话{std::move(v3恢复装配.上下文),
            恢复会话.本能根};
        const auto v3持久读回 = 读取当前_v3(v3恢复会话);
        if (!v3持久读回.成功() || !v3持久读回.游标
            || *v3持久读回.游标 != v3持久期望)
            return 失败("C10", "v3 持久恢复逐字段一致");
        通过("C10", "v3 三水位事实持久恢复逐字段一致");

        普通应用配置 v2配置;
        v2配置.L1事实基座持久存储 = {
            L1事实基座持久恢复合同版本_v1, 隔离根 / L"l1-v2"};
        v2配置.不可变材料存储 = {
            L2结构合同版本, {隔离根 / L"material-v2"}};
        auto v2会话 = 建立或恢复会话(v2配置, 根启动身份 + 100);
        if (!v2会话) return 失败("C11", "建立 v2 迁移会话");
        const auto v2变化账登记 = 登记永久变化账(*v2会话);
        const auto v2G0 = 当前代次(*v2会话);
        auto& v2服务 = v2会话->上下文->取得本能被动维护游标服务();
        const auto v2建立 = v2G0 && v2变化账登记.成功()
            ? v2服务.建立或恢复本能被动维护游标_v2({
                本能被动维护游标合同版本_v2,
                {L2结构合同版本, *v2G0}, L2结构幂等身份{键基数 + 50},
                v2会话->本能根, 505, 505, 0,
                v2变化账登记.首次登记事实代次, v2变化账登记,
                1, 服务时间维护规则版本_v1})
            : 本能被动维护游标建立结果_v2{};
        const auto v2历史起点 = 读取服务历史覆盖起点(*v2会话);
        auto v2迁移请求 = v2建立.成功() && v2建立.提交游标
                && v2历史起点.成功() && v2历史起点.快照
            ? 形成请求_v3(*v2会话, 键基数 + 51, 505, 505, 0,
                v2建立.提交游标->已消费主动安全变化事实代次,
                v2变化账登记,
                v2历史起点.快照->历史账登记事实代次, v2历史起点)
            : std::optional<建立或恢复本能被动维护游标请求_v3>{};
        const auto v2迁移 = v2迁移请求
            ? v2服务.建立或恢复本能被动维护游标_v3(*v2迁移请求)
            : 本能被动维护游标建立结果_v3{};
        if (!v2建立.成功() || !v2迁移.成功()
            || v2迁移.状态 != 本能被动维护游标建立状态_v3::已迁移
            || !v2迁移.提交游标
            || v2迁移.提交游标->已消费主动安全变化事实代次
                != v2建立.提交游标->已消费主动安全变化事实代次
            || v2迁移.提交游标->已消费服务维护历史事实代次
                != v2历史起点.快照->历史账登记事实代次)
            return 失败("C11", "v2 到 v3 保留主动安全水位并补服务水位");
        通过("C11", "v2 迁移保留主动安全水位并采用服务 owner 登记起点");
        return 0;
    } catch (...) {
        return 失败("EX", "未处理异常");
    }
}

} // namespace 海中鱼巣
