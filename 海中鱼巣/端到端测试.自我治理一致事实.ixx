自我治理消息 构造合法v3治理消息(
    自我治理消息类型 类型, std::uint64_t 编号) {
    自我治理消息 消息;
    消息.治理消息编号 = 编号;
    消息.类型 = 类型;
    消息.发生时间戳 = 1;
    消息.优先级 = 自我治理消息优先级::普通;
    消息.幂等键 = 编号;
    消息.批次编号 = 1;
    消息.非权威材料摘要 = 编号;
    消息.过期策略 = 自我治理过期策略::永不过期;
    消息.运行代次 = 1;
    消息.读取截止代次 = 1;
    const auto 身份 = [编号](std::uint64_t 偏移) {
        return 稳定编码{编号 * 100 + 偏移};
    };
    switch (类型) {
    case 自我治理消息类型::任务结果复核请求:
        消息.来源角色 = 自我治理来源角色::任务管理上行桥;
        消息.来源服务 = 自我治理服务角色::任务桥边界;
        消息.目标服务 = 自我治理服务角色::任务;
        消息.材料类型 = 自我治理只读材料类型::任务结果材料;
        消息.材料性质 = 自我治理材料性质::非权威回执;
        消息.来源任务序号 = 编号;
        消息.载荷 = 任务结果复核载荷{L2任务身份{身份(1)}, L2状态身份{身份(2)},
            L2动态身份{身份(3)}, L2方法身份{身份(4)}, L2方法动作入口身份{身份(5)},
            L2场景身份{身份(6)}, L2存在身份{身份(7)}};
        break;
    case 自我治理消息类型::派生需求请求:
        消息.来源角色 = 自我治理来源角色::任务需求分析入口;
        消息.来源服务 = 自我治理服务角色::需求分析边界;
        消息.目标服务 = 自我治理服务角色::需求;
        消息.材料类型 = 自我治理只读材料类型::需求派生材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.载荷 = 派生需求载荷{L2存在身份{身份(1)}, L2特征定义身份{身份(2)},
            L2特征实例身份{身份(3)}, L2状态身份{身份(4)}, L2状态身份{身份(5)}};
        break;
    case 自我治理消息类型::观察材料准入请求:
        消息.来源角色 = 自我治理来源角色::外部材料适配入口;
        消息.来源服务 = 自我治理服务角色::材料适配边界;
        消息.目标服务 = 自我治理服务角色::存在;
        消息.材料类型 = 自我治理只读材料类型::观察输入材料;
        消息.材料性质 = 自我治理材料性质::非权威观察;
        消息.载荷 = 观察材料准入载荷{L2存在身份{身份(1)}, L2场景身份{身份(2)},
            不可变材料身份{身份(3)}, L2任务身份{身份(4)},
            自我治理工作项身份{身份(5)}, 自我治理承接身份{身份(6)}};
        break;
    case 自我治理消息类型::执行前许可预判请求:
        消息.来源角色 = 自我治理来源角色::任务管理上行桥;
        消息.来源服务 = 自我治理服务角色::任务桥边界;
        消息.目标服务 = 自我治理服务角色::任务;
        消息.材料类型 = 自我治理只读材料类型::许可预判材料;
        消息.材料性质 = 自我治理材料性质::非权威请求;
        消息.来源任务序号 = 编号;
        消息.载荷 = 执行前许可预判载荷{L2任务身份{身份(1)},
            L2方法身份{身份(2)}, L2方法动作入口身份{身份(3)}};
        break;
    case 自我治理消息类型::自检缺口候选:
        消息.来源角色 = 自我治理来源角色::已确认自检入口;
        消息.来源服务 = 自我治理服务角色::自检边界;
        消息.目标服务 = 自我治理服务角色::治理边界;
        消息.材料类型 = 自我治理只读材料类型::自检缺口材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.载荷 = 自检缺口载荷{L2存在身份{身份(1)}, L2场景身份{身份(2)},
            不可变材料身份{身份(3)}};
        break;
    case 自我治理消息类型::缓存刷新请求:
        消息.来源角色 = 自我治理来源角色::领域落账观察桥;
        消息.来源服务 = 自我治理服务角色::领域观察边界;
        消息.目标服务 = 自我治理服务角色::统计;
        消息.材料类型 = 自我治理只读材料类型::缓存观察材料;
        消息.材料性质 = 自我治理材料性质::非权威观察;
        消息.载荷 = 缓存刷新载荷{L2需求身份{身份(1)}};
        break;
    case 自我治理消息类型::事件日志请求:
        消息.来源角色 = 自我治理来源角色::领域落账观察桥;
        消息.来源服务 = 自我治理服务角色::领域观察边界;
        消息.目标服务 = 自我治理服务角色::日志边界;
        消息.材料类型 = 自我治理只读材料类型::事件审计材料;
        消息.材料性质 = 自我治理材料性质::非权威观察;
        消息.载荷 = 事件日志载荷{L2动态身份{身份(1)}};
        break;
    case 自我治理消息类型::停止请求:
        消息.来源角色 = 自我治理来源角色::运行宿主;
        消息.来源服务 = 自我治理服务角色::运行边界;
        消息.目标服务 = 自我治理服务角色::治理边界;
        消息.优先级 = 自我治理消息优先级::停止;
        消息.材料类型 = 自我治理只读材料类型::停止信号材料;
        消息.材料性质 = 自我治理材料性质::生命周期信号;
        消息.读取截止代次 = 0;
        消息.载荷 = 停止载荷{};
        break;
    case 自我治理消息类型::概念待命名请求:
        消息.来源角色 = 自我治理来源角色::概念图观察入口;
        消息.来源服务 = 自我治理服务角色::概念图;
        消息.目标服务 = 自我治理服务角色::需求;
        消息.来源材料版本 = 1;
        消息.材料类型 = 自我治理只读材料类型::概念待命名材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.载荷 = 概念待命名载荷{L2概念身份{身份(1)}};
        break;
    default:
        break;
    }
    return 消息;
}

bool 验证运行期提供者闭环() {
    constexpr std::uint64_t 运行代次 = 1;
    constexpr std::uint64_t 时间纪元身份 = 1;
    constexpr std::uint32_t 事实范围版本 = 1;

    auto 配置 = 形成普通应用生产配置();
    if (!配置.成功()) {
        std::cout << "[治理测试] 失败：运行期提供者普通应用配置形成失败\n";
        return false;
    }
    auto 装配 = 构造普通应用上下文(*配置.配置);
    if (!装配.成功()) {
        std::cout << "[治理测试] 失败：运行期提供者普通应用装配失败\n";
        return false;
    }

    单调时钟适配器 时间适配器({运行代次, 时间纪元身份});
    const auto 坏时间结果 = 时间适配器.读取可信单调时间证据({0});
    if (坏时间结果.状态 != 单调时间证据读取状态::请求拒绝 ||
        坏时间结果.证据) {
        std::cout << "[治理测试] 失败：坏单调时间请求产生伪材料\n";
        return false;
    }
    const 单调时间证据读取请求 时间请求{
        单调时间证据合同版本, 运行代次, 时间纪元身份,
        稳态时钟时间源版本};
    const auto 首次时间 = 时间适配器.读取可信单调时间证据(时间请求);
    const auto 再次时间 = 时间适配器.读取可信单调时间证据(时间请求);
    if (首次时间.状态 != 单调时间证据读取状态::已读取 ||
        再次时间.状态 != 单调时间证据读取状态::已读取 ||
        !首次时间.证据 || !再次时间.证据 ||
        首次时间.证据->从纪元起点经过纳秒 < 0 ||
        再次时间.证据->从纪元起点经过纳秒 <
            首次时间.证据->从纪元起点经过纳秒) {
        std::cout << "[治理测试] 失败：单调时间证据不完整或发生倒退\n";
        return false;
    }

    完整秒时钟服务 完整秒服务(
        时间适配器, {运行代次, 时间纪元身份, 稳态时钟时间源版本});
    const auto 坏完整秒结果 = 完整秒服务.读取当前完整秒边界({0});
    if (坏完整秒结果.状态 != 完整秒边界读取状态::请求拒绝 ||
        坏完整秒结果.观察 || 坏完整秒结果.区间) {
        std::cout << "[治理测试] 失败：坏完整秒请求产生伪材料\n";
        return false;
    }
    完整秒边界读取请求 完整秒请求;
    完整秒请求.运行代次 = 运行代次;
    完整秒请求.时间纪元身份 = 时间纪元身份;
    完整秒请求.期望时间源版本 = 稳态时钟时间源版本;
    const auto 完整秒结果 = 完整秒服务.读取当前完整秒边界(完整秒请求);
    if (!完整秒结果.观察 ||
        (完整秒结果.状态 != 完整秒边界读取状态::已读取 &&
         完整秒结果.状态 != 完整秒边界读取状态::无新完整秒) ||
        (完整秒结果.状态 == 完整秒边界读取状态::已读取) !=
            完整秒结果.区间.has_value()) {
        std::cout << "[治理测试] 失败：完整秒结果形状不守恒\n";
        return false;
    }
    if (完整秒结果.区间 &&
        (完整秒结果.区间->首个未消费完整秒边界 != 1 ||
         完整秒结果.区间->最后完整秒边界 !=
             完整秒结果.观察->当前完整秒边界 ||
         完整秒结果.区间->完整秒数量 !=
             static_cast<std::uint64_t>(完整秒结果.观察->当前完整秒边界))) {
        std::cout << "[治理测试] 失败：完整秒区间不是 [上一+1, 当前]\n";
        return false;
    }

    运行期事实版本服务 事实版本服务(
        装配.上下文->取得L2结构聚合服务(),
        {运行代次, 事实范围版本});
    const auto 坏截止结果 = 事实版本服务.读取当前已发布共享事实截止({0});
    if (坏截止结果.状态 != 共享事实截止读取状态::请求拒绝 ||
        坏截止结果.截止) {
        std::cout << "[治理测试] 失败：坏事实截止请求产生伪材料\n";
        return false;
    }
    const auto 截止结果 = 事实版本服务.读取当前已发布共享事实截止(
        {共享事实截止读取合同版本, 运行代次, 事实范围版本});
    if (截止结果.状态 != 共享事实截止读取状态::已读取 ||
        !截止结果.截止 || 截止结果.截止->事实截止代次 == 0 ||
        截止结果.截止->运行代次 != 运行代次 ||
        截止结果.截止->事实范围版本 != 事实范围版本) {
        std::cout << "[治理测试] 失败：共享事实截止读回不完整\n";
        return false;
    }

    const auto 构造概念待命名消息 = [](std::uint64_t 消息编号,
                                      std::uint64_t 幂等键) {
        自我治理消息 消息;
        消息.治理消息编号 = 消息编号;
        消息.类型 = 自我治理消息类型::概念待命名请求;
        消息.来源角色 = 自我治理来源角色::概念图观察入口;
        消息.来源服务 = 自我治理服务角色::概念图;
        消息.目标服务 = 自我治理服务角色::需求;
        消息.发生时间戳 = 1;
        消息.优先级 = 自我治理消息优先级::普通;
        消息.幂等键 = 幂等键;
        消息.来源材料版本 = 1;
        消息.批次编号 = 1;
        消息.非权威材料摘要 = 消息编号;
        消息.材料类型 = 自我治理只读材料类型::概念待命名材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.过期策略 = 自我治理过期策略::永不过期;
        消息.运行代次 = 1;
        消息.读取截止代次 = 1;
        消息.载荷 = 概念待命名载荷{L2概念身份{稳定编码{消息编号}}};
        return 消息;
    };

    有界自我治理邮箱 邮箱(2);
    const auto 普通消息 = 构造概念待命名消息(2, 2);
    if (邮箱.提交(普通消息, 1).状态
        != 自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：停止前普通治理消息提交失败\n";
        return false;
    }
    自我治理消息 停止消息;
    停止消息.治理消息编号 = 1;
    停止消息.类型 = 自我治理消息类型::停止请求;
    停止消息.来源角色 = 自我治理来源角色::运行宿主;
    停止消息.来源服务 = 自我治理服务角色::运行边界;
    停止消息.目标服务 = 自我治理服务角色::治理边界;
    停止消息.发生时间戳 = 1;
    停止消息.优先级 = 自我治理消息优先级::停止;
    停止消息.幂等键 = 1;
    停止消息.批次编号 = 1;
    停止消息.非权威材料摘要 = 1;
    停止消息.材料类型 = 自我治理只读材料类型::停止信号材料;
    停止消息.材料性质 = 自我治理材料性质::生命周期信号;
    停止消息.过期策略 = 自我治理过期策略::永不过期;
    停止消息.运行代次 = 运行代次;
    停止消息.载荷 = 停止载荷{};
    const auto 提交结果 = 邮箱.提交(停止消息, 1);
    if (提交结果.状态 != 自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：治理路由合法消息提交失败\n";
        return false;
    }
    自我治理批次路由 路由(
        邮箱, 完整秒服务, 事实版本服务, 运行代次,
        时间纪元身份, 稳态时钟时间源版本, 事实范围版本);
    治理批次组合请求 批次请求;
    批次请求.运行代次 = 运行代次;
    批次请求.时间纪元身份 = 时间纪元身份;
    批次请求.期望时间源版本 = 稳态时钟时间源版本;
    批次请求.最大等待毫秒 = 1;
    批次请求.事实范围版本 = 事实范围版本;
    const auto 批次结果 = 路由.冻结当前治理批次(批次请求);
    if (批次结果.状态 != 治理批次状态::已冻结 ||
        !批次结果.治理批次 ||
        批次结果.治理批次->运行代次 != 运行代次 ||
        批次结果.治理批次->消息批次.数量() != 2 ||
        批次结果.治理批次->消息批次.读取消息组().front().治理消息编号 != 1 ||
        批次结果.治理批次->共享事实截止.事实截止代次 == 0 ||
        批次结果.治理批次->完整秒.运行代次 != 运行代次 ||
        批次结果.治理批次->完整秒.时间纪元身份 != 时间纪元身份) {
        std::cout << "[治理测试] 失败：治理批次未消费最终提供者材料\n";
        return false;
    }

    治理批次分类请求 分类请求;
    分类请求.批次 = std::addressof(*批次结果.治理批次);
    分类请求.当前单调时间 = 1;
    分类请求.运行代次 = 运行代次;
    const auto 分类结果 = 路由.复核并分类治理批次(分类请求);
    if (分类结果.状态 != 治理批次分类状态::停止优先
        || 分类结果.批次序号 != 批次结果.治理批次->批次序号
        || 分类结果.有序治理输入组.size() != 1
        || 分类结果.有序治理输入组.front().类别 != 治理输入类别::停止
        || 分类结果.有序治理输入组.front().消息.治理消息编号 != 1
        || !分类结果.逐项诊断.empty()) {
        std::cout << "[治理测试] 失败：停止治理批次未形成停止优先分类\n";
        return false;
    }
    const auto 停止路由结果 = 路由.复核分类并路由治理批次(分类请求);
    if (停止路由结果.分类状态 != 治理批次分类状态::停止优先
        || 停止路由结果.有序路由组.size() != 1
        || 停止路由结果.有序路由组.front().后继 != 治理输入后继::停止
        || 停止路由结果.有序路由组.front().状态 != 治理输入路由状态::已路由) {
        std::cout << "[治理测试] 失败：停止未形成唯一截断路由\n";
        return false;
    }

    有界自我治理邮箱 分类邮箱(3);
    const auto 第一普通消息 = 构造概念待命名消息(10, 10);
    auto 第二普通消息 = 构造概念待命名消息(11, 11);
    第二普通消息.类型 = 自我治理消息类型::观察材料准入请求;
    第二普通消息.来源角色 = 自我治理来源角色::外部材料适配入口;
    第二普通消息.来源服务 = 自我治理服务角色::材料适配边界;
    第二普通消息.目标服务 = 自我治理服务角色::存在;
    第二普通消息.材料类型 = 自我治理只读材料类型::观察输入材料;
    第二普通消息.材料性质 = 自我治理材料性质::非权威观察;
    第二普通消息.来源材料版本 = 0;
    第二普通消息.载荷 = 观察材料准入载荷{
        L2存在身份{稳定编码{101}}, L2场景身份{稳定编码{102}},
        不可变材料身份{稳定编码{103}}, {}, {}, {}};
    auto 过期消息 = 构造概念待命名消息(12, 12);
    过期消息.过期策略 = 自我治理过期策略::截止时间;
    过期消息.截止时间戳 = 1;
    if (分类邮箱.提交(第一普通消息, 1).状态
            != 自我治理提交状态::已提交
        || 分类邮箱.提交(第二普通消息, 1).状态
            != 自我治理提交状态::已提交
        || 分类邮箱.提交(过期消息, 1).状态
            != 自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：分类批次合法消息提交失败\n";
        return false;
    }
    自我治理批次路由 分类路由(
        分类邮箱, 完整秒服务, 事实版本服务, 运行代次,
        时间纪元身份, 稳态时钟时间源版本, 事实范围版本);
    const auto 待分类批次结果 = 分类路由.冻结当前治理批次(批次请求);
    if (待分类批次结果.状态 != 治理批次状态::已冻结
        || !待分类批次结果.治理批次) {
        std::cout << "[治理测试] 失败：普通治理分类批次冻结失败\n";
        return false;
    }
    治理批次分类请求 普通分类请求;
    普通分类请求.批次 =
        std::addressof(*待分类批次结果.治理批次);
    普通分类请求.当前单调时间 = 2;
    普通分类请求.运行代次 = 运行代次;
    const auto 普通分类结果 =
        分类路由.复核并分类治理批次(普通分类请求);
    if (普通分类结果.状态 != 治理批次分类状态::存在时效拒绝
        || 普通分类结果.有序治理输入组.size() != 2
        || 普通分类结果.有序治理输入组[0].消息.治理消息编号 != 10
        || 普通分类结果.有序治理输入组[0].类别
            != 治理输入类别::概念待命名
        || 普通分类结果.有序治理输入组[1].消息.治理消息编号 != 11
        || 普通分类结果.有序治理输入组[1].类别
            != 治理输入类别::观察材料准入
        || 普通分类结果.逐项诊断.size() != 1
        || 普通分类结果.逐项诊断.front().消息编号 != 12
        || 普通分类结果.逐项诊断.front().准入结果.拒绝原因
            != 自我治理拒绝原因::材料已过期) {
        std::cout << "[治理测试] 失败：稳定分类顺序或过期诊断不正确\n";
        return false;
    }

    auto 坏分类请求 = 普通分类请求;
    坏分类请求.合同版本 = 0;
    const auto 坏合同分类 = 分类路由.复核并分类治理批次(坏分类请求);
    坏分类请求 = 普通分类请求;
    坏分类请求.批次 = nullptr;
    const auto 空指针分类 = 分类路由.复核并分类治理批次(坏分类请求);
    坏分类请求 = 普通分类请求;
    坏分类请求.运行代次 = 2;
    const auto 坏代次分类 = 分类路由.复核并分类治理批次(坏分类请求);
    坏分类请求 = 普通分类请求;
    坏分类请求.协议版本 = 0;
    const auto 坏协议分类 = 分类路由.复核并分类治理批次(坏分类请求);
    if (坏合同分类.状态 != 治理批次分类状态::入口拒绝
        || 空指针分类.状态 != 治理批次分类状态::入口拒绝
        || 坏代次分类.状态 != 治理批次分类状态::入口拒绝
        || 坏协议分类.状态 != 治理批次分类状态::入口拒绝) {
        std::cout << "[治理测试] 失败：分类入口拒绝分账不正确\n";
        return false;
    }

    const auto 分类后截止结果 =
        事实版本服务.读取当前已发布共享事实截止(
            {共享事实截止读取合同版本, 运行代次, 事实范围版本});
    if (分类后截止结果.状态 != 共享事实截止读取状态::已读取
        || !分类后截止结果.截止
        || 分类后截止结果.截止->事实截止代次
            != 截止结果.截止->事实截止代次) {
        std::cout << "[治理测试] 失败：分类过程改写了共享事实截止\n";
        return false;
    }

    // v3 不接受旧版本、错 alternative、零身份、零运行代次或零 G0；停止是
    // 唯一允许零 G0 的类别。
    自我治理准入上下文 协议上下文;
    协议上下文.当前时间戳 = 1;
    auto 旧版本 = 构造合法v3治理消息(自我治理消息类型::概念待命名请求, 40);
    旧版本.协议版本 = 2;
    auto 错载荷 = 构造合法v3治理消息(自我治理消息类型::概念待命名请求, 41);
    错载荷.载荷 = 停止载荷{};
    auto 零身份 = 构造合法v3治理消息(自我治理消息类型::概念待命名请求, 42);
    零身份.载荷 = 概念待命名载荷{L2概念身份{稳定编码{}}};
    auto 零运行代次 = 构造合法v3治理消息(自我治理消息类型::概念待命名请求, 43);
    零运行代次.运行代次 = 0;
    auto 零G0 = 构造合法v3治理消息(自我治理消息类型::概念待命名请求, 44);
    零G0.读取截止代次 = 0;
    if (复核自我治理消息(旧版本, 协议上下文).拒绝原因 != 自我治理拒绝原因::协议版本不匹配
        || 复核自我治理消息(错载荷, 协议上下文).拒绝原因 != 自我治理拒绝原因::载荷与消息类型不匹配
        || 复核自我治理消息(零身份, 协议上下文).拒绝原因 != 自我治理拒绝原因::必填句柄缺失
        || 复核自我治理消息(零运行代次, 协议上下文).拒绝原因 != 自我治理拒绝原因::运行代次缺失
        || 复核自我治理消息(零G0, 协议上下文).拒绝原因 != 自我治理拒绝原因::读取截止代次缺失
        || 复核自我治理消息(构造合法v3治理消息(自我治理消息类型::停止请求, 45), 协议上下文).状态
            != 自我治理准入状态::可准入) {
        std::cout << "[治理测试] 失败：v3 协议拒绝边界不正确\n";
        return false;
    }

    const auto 构造合法任务结果回执 = [] {
        任务结果回执材料 回执;
        回执.回执编号 = 91;
        回执.发生时间戳 = 1;
        回执.幂等键 = 92;
        回执.来源任务序号 = 93;
        回执.批次编号 = 94;
        回执.非权威材料摘要 = 95;
        回执.来源材料版本 = 96;
        回执.任务实际结果写入幂等身份 = L2结构幂等身份{97};
        回执.运行代次 = 1;
        回执.读取截止代次 = 1;
        回执.材料性质 = 任务结果回执材料性质::非权威任务执行结果证据;
        回执.过期策略 = 任务结果回执过期策略::截止时间;
        回执.截止时间戳 = 2;
        回执.身份组 = {
            L2任务身份{稳定编码{101}}, L2状态身份{稳定编码{102}},
            L2动态身份{稳定编码{103}}, L2方法身份{稳定编码{104}},
            L2方法动作入口身份{稳定编码{105}}, L2场景身份{稳定编码{106}},
            L2存在身份{稳定编码{107}}};
        回执.来源执行绑定 = 任务结果回执来源执行绑定{
            回执.回执编号, 回执.来源任务序号, 回执.批次编号, 回执.幂等键,
            回执.身份组.目标任务, 回执.身份组.目标方法,
            回执.身份组.目标动作入口};
        return 回执;
    };
    const auto 合法回执 = 构造合法任务结果回执();
    任务结果回执准入上下文 回执上下文;
    回执上下文.当前时间戳 = 1;
    auto 过期回执上下文 = 回执上下文;
    过期回执上下文.当前时间戳 = 2;
    auto 过期回执 = 合法回执;
    过期回执.截止时间戳 = 1;
    auto 零运行代次回执 = 合法回执;
    零运行代次回执.运行代次 = 0;
    auto 零来源材料版本回执 = 合法回执;
    零来源材料版本回执.来源材料版本 = 0;
    auto 零写入幂等身份回执 = 合法回执;
    零写入幂等身份回执.任务实际结果写入幂等身份 = L2结构幂等身份{};
    auto 零G0回执 = 合法回执;
    零G0回执.读取截止代次 = 0;
    auto 零身份回执 = 合法回执;
    零身份回执.身份组.目标任务 = L2任务身份{稳定编码{}};
    auto 缺绑定回执 = 合法回执;
    缺绑定回执.来源执行绑定.reset();
    auto 重复上下文 = 回执上下文;
    重复上下文.同幂等键既有材料 = 合法回执;
    auto 冲突回执 = 合法回执;
    冲突回执.非权威材料摘要 = 96;
    auto 任务序号倒退上下文 = 回执上下文;
    任务序号倒退上下文.同任务目标 = 合法回执.身份组.目标任务;
    任务序号倒退上下文.同任务最新序号 = 合法回执.来源任务序号 + 1;
    auto 上下文不一致 = 回执上下文;
    上下文不一致.同任务目标 = 合法回执.身份组.目标任务;
    const auto 合法回执结果 = 复核任务结果回执材料(合法回执, 回执上下文);
    const auto 过期回执结果 = 复核任务结果回执材料(过期回执, 过期回执上下文);
    const auto 零运行代次回执结果 = 复核任务结果回执材料(零运行代次回执, 回执上下文);
    const auto 零来源材料版本回执结果 =
        复核任务结果回执材料(零来源材料版本回执, 回执上下文);
    const auto 零写入幂等身份回执结果 =
        复核任务结果回执材料(零写入幂等身份回执, 回执上下文);
    const auto 零G0回执结果 = 复核任务结果回执材料(零G0回执, 回执上下文);
    const auto 零身份回执结果 = 复核任务结果回执材料(零身份回执, 回执上下文);
    const auto 缺绑定回执结果 = 复核任务结果回执材料(缺绑定回执, 回执上下文);
    const auto 重复回执结果 = 复核任务结果回执材料(合法回执, 重复上下文);
    const auto 冲突回执结果 = 复核任务结果回执材料(冲突回执, 重复上下文);
    const auto 倒退回执结果 = 复核任务结果回执材料(合法回执, 任务序号倒退上下文);
    const auto 上下文不一致结果 = 复核任务结果回执材料(合法回执, 上下文不一致);
    if (合法回执结果.状态
            != 任务结果回执准入状态::可准入
        || 过期回执结果.拒绝原因
            != 任务结果回执拒绝原因::材料已过期
        || 零运行代次回执结果.拒绝原因
            != 任务结果回执拒绝原因::运行代次缺失
        || 零来源材料版本回执结果.拒绝原因
            != 任务结果回执拒绝原因::来源材料版本缺失
        || 零写入幂等身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::写入幂等身份缺失
        || 零G0回执结果.拒绝原因
            != 任务结果回执拒绝原因::读取截止代次缺失
        || 零身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::必填身份缺失
        || 缺绑定回执结果.拒绝原因
            != 任务结果回执拒绝原因::来源执行绑定缺失
        || 重复回执结果.状态
            != 任务结果回执准入状态::重复材料
        || 冲突回执结果.拒绝原因
            != 任务结果回执拒绝原因::幂等键冲突
        || 倒退回执结果.拒绝原因
            != 任务结果回执拒绝原因::同一任务序号倒退
        || 上下文不一致结果.状态
            != 任务结果回执准入状态::内部不一致) {
        std::cout << "[治理测试] 失败：任务结果回执 v3 准入分账不正确："
            << static_cast<unsigned>(合法回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(过期回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零运行代次回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零来源材料版本回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零写入幂等身份回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零G0回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零身份回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(缺绑定回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(重复回执结果.状态) << "/"
            << static_cast<unsigned>(冲突回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(倒退回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(上下文不一致结果.状态) << "\n";
        return false;
    }

    有界自我治理邮箱 九类邮箱(8);
    const std::vector<自我治理消息类型> 普通类型组{
        自我治理消息类型::任务结果复核请求,
        自我治理消息类型::派生需求请求,
        自我治理消息类型::观察材料准入请求,
        自我治理消息类型::执行前许可预判请求,
        自我治理消息类型::自检缺口候选,
        自我治理消息类型::缓存刷新请求,
        自我治理消息类型::事件日志请求,
        自我治理消息类型::概念待命名请求};
    std::uint64_t 消息编号 = 50;
    for (const auto 类型 : 普通类型组) {
        const auto 消息 = 构造合法v3治理消息(类型, 消息编号++);
        const auto 直接准入 = 复核自我治理消息(消息, 协议上下文);
        const auto 提交 = 九类邮箱.提交(消息, 1);
        if (提交.状态 != 自我治理提交状态::已提交) {
            std::cout << "[治理测试] 失败：合法 v3 普通消息未进入邮箱，类型="
                << static_cast<unsigned>(类型) << "，拒绝="
                << static_cast<unsigned>(提交.协议结果.拒绝原因)
                << "，消息类型=" << static_cast<unsigned>(消息.类型)
                << "，直接拒绝=" << static_cast<unsigned>(直接准入.拒绝原因) << "\n";
            return false;
        }
    }
    自我治理批次路由 九类路由(
        九类邮箱, 完整秒服务, 事实版本服务, 运行代次,
        时间纪元身份, 稳态时钟时间源版本, 事实范围版本);
    const auto 九类批次 = 九类路由.冻结当前治理批次(批次请求);
    if (九类批次.状态 != 治理批次状态::已冻结 || !九类批次.治理批次) {
        std::cout << "[治理测试] 失败：九类 v3 批次冻结失败\n";
        return false;
    }
    治理批次分类请求 九类请求;
    九类请求.批次 = std::addressof(*九类批次.治理批次);
    九类请求.当前单调时间 = 1;
    九类请求.运行代次 = 运行代次;
    const auto 九类结果 = 九类路由.复核分类并路由治理批次(九类请求);
    if (九类结果.分类状态 != 治理批次分类状态::已分类
        || 九类结果.有序路由组.size() != 普通类型组.size()
        || !九类结果.逐项诊断.empty()) {
        std::cout << "[治理测试] 失败：九类 v3 路由未完整形成\n";
        return false;
    }
    const std::vector<治理输入后继> 期望后继组{
        治理输入后继::治理输入事实复核, 治理输入后继::派生需求准入,
        治理输入后继::治理输入事实复核, 治理输入后继::生存控制裁决,
        治理输入后继::自检缺口准入, 治理输入后继::缓存支持旁路,
        治理输入后继::日志支持旁路, 治理输入后继::概念命名准入};
    for (std::size_t 下标 = 0; 下标 < 九类结果.有序路由组.size(); ++下标) {
        const auto& 路由项 = 九类结果.有序路由组[下标];
        if (路由项.输入.消息.类型 != 普通类型组[下标]
            || 路由项.后继 != 期望后继组[下标]
            || 路由项.状态 != 治理输入路由状态::合法等待) {
            std::cout << "[治理测试] 失败：普通输入未保留唯一合法等待路由\n";
            return false;
        }
    }

    std::cout << "[治理测试] 运行期时间与事实提供者闭环读回通过\n";
    return true;
}

} // namespace

} // namespace 海中鱼巣

export namespace 海中鱼巣 {

// 端到端测试：自我治理一致事实 headless 场景。
// 验证 BIZ-L3-002-02-02 生存安全快照真实读取路径。
// 流程：
//   1. 建立 L1 事实基座运行包
//   2. 建立六个 L2 服务（存在/特征/状态/需求/场景/任务）
//   3. 新增角色化存在（自我）
//   4. 新增安全根特征定义 + 特征实例 + 特征值（I64{A=2, L=5, H=10}）
//   5. 新增服务值特征定义 + 特征实例 + 特征值（I64{100}）
//   6. 读取当前事实代次作为 G0
//   7. 装配运行期只读查询组合器
//   8. 调用 读取自我治理一致事实()
//   9. 验证：状态 == 已形成，生存安全快照有效
//
// 返回 0 表示全部通过；非 0 表示失败。
int 运行自我治理一致事实端到端测试() noexcept {
    if (!验证运行期提供者闭环()) {
        return 1;
    }
    // ===== 1. 建立 L1 事实基座运行包 =====
    auto 运行包 = 建立L1事实基座运行包();
    std::cout << "[治理测试] L1 事实基座运行包已建立\n";

    // ===== 2. 建立 L2 存在结构服务 =====
    auto 存在原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 存在所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((存在原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 存在原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !存在原始交付.建立结果.所有者事实
        || !存在原始交付.写入端口) {
        std::cout << "[治理测试] 失败：存在所有者范围建立失败\n";
        return 1;
    }
    auto 存在所有者交付 = 尝试形成L2存在所有者交付(
        运行包.读取服务(), std::move(存在原始交付));
    if (!存在所有者交付) {
        std::cout << "[治理测试] 失败：存在所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2存在结构服务> 存在服务;
    try {
        存在服务 = std::make_unique<L2存在结构服务>(
            运行包.读取服务(), std::move(*存在所有者交付));
    } catch (...) {
        std::cout << "[治理测试] 失败：存在服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 存在结构服务已建立\n";

    // ===== 3. 建立 L2 特征结构服务 =====
    auto 定义原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 特征定义所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((定义原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 定义原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !定义原始交付.建立结果.所有者事实
        || !定义原始交付.写入端口) {
        std::cout << "[治理测试] 失败：特征定义所有者范围建立失败\n";
        return 1;
    }
    auto 定义交付 = 尝试形成L2特征定义所有者交付(
        运行包.读取服务(), std::move(定义原始交付));
    if (!定义交付) {
        std::cout << "[治理测试] 失败：特征定义所有者交付形成失败\n";
        return 1;
    }
    auto 实例原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 特征实例所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((实例原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 实例原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !实例原始交付.建立结果.所有者事实
        || !实例原始交付.写入端口) {
        std::cout << "[治理测试] 失败：特征实例所有者范围建立失败\n";
        return 1;
    }
    auto 实例交付 = 尝试形成L2特征实例所有者交付(
        运行包.读取服务(), std::move(实例原始交付));
    if (!实例交付) {
        std::cout << "[治理测试] 失败：特征实例所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2特征结构服务> 特征服务;
    try {
        特征服务 = std::make_unique<L2特征结构服务>(
            运行包.读取服务(), *存在服务,
            std::move(*定义交付), std::move(*实例交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：特征服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：特征服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 特征结构服务已建立\n";

    // ===== 4. 建立 L2 状态结构服务 =====
    auto 状态原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 状态所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((状态原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 状态原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !状态原始交付.建立结果.所有者事实
        || !状态原始交付.写入端口) {
        std::cout << "[治理测试] 失败：状态所有者范围建立失败\n";
        return 1;
    }
    auto 状态交付 = 尝试形成L2状态所有者交付(
        运行包.读取服务(), std::move(状态原始交付));
    if (!状态交付) {
        std::cout << "[治理测试] 失败：状态所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2状态结构服务> 状态服务;
    try {
        状态服务 = std::make_unique<L2状态结构服务>(
            运行包.读取服务(), *存在服务, *特征服务,
            std::move(*状态交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：状态服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：状态服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 状态结构服务已建立\n";

    // ===== 4A. 建立 L2 动态结构服务 =====
    auto 动态原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 动态所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((动态原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 动态原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !动态原始交付.建立结果.所有者事实
        || !动态原始交付.写入端口) {
        std::cout << "[治理测试] 失败：动态所有者范围建立失败\n";
        return 1;
    }
    auto 动态交付 = 尝试形成L2动态所有者交付(
        运行包.读取服务(), std::move(动态原始交付));
    if (!动态交付) {
        std::cout << "[治理测试] 失败：动态所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2动态结构服务> 动态服务;
    try {
        动态服务 = std::make_unique<L2动态结构服务>(
            运行包.读取服务(), *存在服务, *状态服务,
            std::move(*动态交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：动态服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：动态服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 动态结构服务已建立\n";

    // 自我线程生产入口要求与当前测试运行包同实例的完整 L2 结构聚合；
    // 因果服务只补齐聚合所有权，不参与本叶任务结果绑定语义。
    auto 因果原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 因果所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((因果原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 因果原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !因果原始交付.建立结果.所有者事实
        || !因果原始交付.写入端口) {
        std::cout << "[治理测试] 失败：因果所有者范围建立失败\n";
        return 1;
    }
    auto 因果交付 = 尝试形成L2因果所有者交付(
        运行包.读取服务(), std::move(因果原始交付));
    if (!因果交付) {
        std::cout << "[治理测试] 失败：因果所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2因果结构服务> 因果服务;
    try {
        因果服务 = std::make_unique<L2因果结构服务>(
            运行包.读取服务(), *状态服务, std::move(*因果交付));
    } catch (...) {
        std::cout << "[治理测试] 失败：因果服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 因果结构服务已建立\n";

    // ===== 5. 建立 L2 需求结构服务 =====
    auto 需求原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 需求所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((需求原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 需求原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !需求原始交付.建立结果.所有者事实
        || !需求原始交付.写入端口) {
        std::cout << "[治理测试] 失败：需求所有者范围建立失败\n";
        return 1;
    }
    auto 需求交付 = 尝试形成L2需求所有者交付(
        运行包.读取服务(), std::move(需求原始交付));
    if (!需求交付) {
        std::cout << "[治理测试] 失败：需求所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2需求结构服务> 需求服务;
    try {
        需求服务 = std::make_unique<L2需求结构服务>(
            运行包.读取服务(), *存在服务, *特征服务,
            *状态服务, std::move(*需求交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：需求服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：需求服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 需求结构服务已建立\n";

    // ===== 6. 建立 L2 场景结构服务 =====
    auto 场景原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 场景所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((场景原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 场景原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !场景原始交付.建立结果.所有者事实
        || !场景原始交付.写入端口) {
        std::cout << "[治理测试] 失败：场景所有者范围建立失败\n";
        return 1;
    }
    auto 场景交付 = 尝试形成L2场景所有者交付(
        运行包.读取服务(), std::move(场景原始交付));
    if (!场景交付) {
        std::cout << "[治理测试] 失败：场景所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2场景结构服务> 场景服务;
    try {
        场景服务 = std::make_unique<L2场景结构服务>(
            运行包.读取服务(), *存在服务, std::move(*场景交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：场景服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：场景服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 场景结构服务已建立\n";

    // ===== 7. 建立 L2 任务结构服务 =====
    auto 任务原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 任务所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((任务原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 任务原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !任务原始交付.建立结果.所有者事实
        || !任务原始交付.写入端口) {
        std::cout << "[治理测试] 失败：任务所有者范围建立失败\n";
        return 1;
    }
    auto 任务交付 = 尝试形成L2任务所有者交付(
        运行包.读取服务(), std::move(任务原始交付));
    if (!任务交付) {
        std::cout << "[治理测试] 失败：任务所有者交付形成失败\n";
        return 1;
    }
    auto 路径写入能力 = 任务交付->提取任务方法路径写入能力交付();
    if (!路径写入能力) {
        std::cout << "[治理测试] 失败：任务方法路径能力提取失败\n";
        return 1;
    }
    std::unique_ptr<L2任务结构服务> 任务服务;
    try {
        任务服务 = std::make_unique<L2任务结构服务>(
            运行包.读取服务(), *需求服务, std::move(*任务交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：任务服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：任务服务构造异常\n";
        return 1;
    }
    auto 路径写入端口 = 尝试形成L2任务方法路径写入端口(
        *任务服务, std::move(*路径写入能力));
    if (!路径写入端口 || !路径写入端口->有效()) {
        std::cout << "[治理测试] 失败：任务方法路径写入端口形成失败\n";
        return 1;
    }
    std::cout << "[治理测试] L2 任务结构服务已建立\n";

    L2结构聚合服务 结构聚合服务(
        *场景服务, *存在服务, *特征服务, *状态服务,
        *动态服务, *因果服务);

    // ===== 8. 读取当前事实代次 =====
    const auto 代次读取 = 运行包.读取服务().读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (代次读取.状态 != L1中性读取状态::成功 || 代次读取.事实代次 == 0) {
        std::cout << "[治理测试] 失败：当前事实代次读取失败\n";
        return 1;
    }
    auto 当前代次 = 代次读取.事实代次;
    std::cout << "[治理测试] 当前事实代次：" << 当前代次 << "\n";

    // ===== 9. 新增角色化存在（自我） =====
    L2结构请求头 头{L2结构合同版本, 当前代次};
    auto 存在新增 = 存在服务->新增角色化存在(
        {头, L2结构幂等身份{7001}, L2存在单例角色键{1}});
    if (!存在新增.成功() || !存在新增.存在) {
        std::cout << "[治理测试] 失败：新增角色化存在失败，状态="
            << static_cast<unsigned>(存在新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 自我存在 = 存在新增.存在->身份;
    std::cout << "[治理测试] 角色化存在（自我）已建立\n";
    当前代次 = 存在新增.结果头.事实截止代次;

    L2结构请求头 目标存在头{L2结构合同版本, 当前代次};
    const auto 目标存在新增 = 存在服务->新增角色化存在(
        {目标存在头, L2结构幂等身份{7002}, L2存在单例角色键{2}});
    if (!目标存在新增.成功() || !目标存在新增.存在) {
        std::cout << "[治理测试] 失败：目标宿主存在建立失败\n";
        return 1;
    }
    const auto 目标宿主存在 = 目标存在新增.存在->身份;
    当前代次 = 目标存在新增.结果头.事实截止代次;

    // ===== 10. 新增安全根特征定义 =====
    L2结构请求头 定义头{L2结构合同版本, 当前代次};
    auto 安全根定义新增 = 特征服务->新增统一特征定义(
        {定义头, L2结构幂等身份{7101}, 1, {}, {}});
    if (!安全根定义新增.成功() || !安全根定义新增.特征定义) {
        std::cout << "[治理测试] 失败：新增安全根特征定义失败，状态="
            << static_cast<unsigned>(安全根定义新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 安全根特征定义 = 安全根定义新增.特征定义->身份;
    std::cout << "[治理测试] 安全根特征定义已建立\n";
    当前代次 = 安全根定义新增.结果头.事实截止代次;

    // ===== 11. 新增服务值特征定义 =====
    L2结构请求头 定义头2{L2结构合同版本, 当前代次};
    auto 服务值定义新增 = 特征服务->新增统一特征定义(
        {定义头2, L2结构幂等身份{7102}, 1, {}, {}});
    if (!服务值定义新增.成功() || !服务值定义新增.特征定义) {
        std::cout << "[治理测试] 失败：新增服务值特征定义失败，状态="
            << static_cast<unsigned>(服务值定义新增.结果头.状态) << "\n";
        return 1;
