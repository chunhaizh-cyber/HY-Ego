class 可控任务重筹办提交端口 final : public 任务重筹办意图提交端口 {
public:
    explicit 可控任务重筹办提交端口(bool 允许接收) noexcept
        : 允许接收_(允许接收) {}

    任务重筹办意图提交结果 提交任务重筹办意图(
        const 任务重筹办意图& 意图) noexcept override {
        try {
            std::lock_guard<std::mutex> 锁(锁_);
            ++调用次数_;
            if (!任务重筹办意图完整(意图)) {
                return {任务重筹办意图提交状态::已拒绝,
                    任务重筹办意图提交拒绝原因::协议拒绝};
            }
            if (!首次意图_) {
                首次意图_ = 意图;
            } else if (!任务重筹办意图相同(*首次意图_, 意图)) {
                return {任务重筹办意图提交状态::已拒绝,
                    任务重筹办意图提交拒绝原因::幂等冲突};
            }
            return 允许接收_
                ? 任务重筹办意图提交结果{
                    任务重筹办意图提交状态::已接收,
                    任务重筹办意图提交拒绝原因::无}
                : 任务重筹办意图提交结果{
                    任务重筹办意图提交状态::已拒绝,
                    任务重筹办意图提交拒绝原因::队列已满};
        } catch (...) {
            return {任务重筹办意图提交状态::内部错误,
                任务重筹办意图提交拒绝原因::内部状态冲突};
        }
    }

    void 允许接收() noexcept {
        std::lock_guard<std::mutex> 锁(锁_);
        允许接收_ = true;
    }

    std::uint64_t 调用次数() const noexcept {
        std::lock_guard<std::mutex> 锁(锁_);
        return 调用次数_;
    }

    std::optional<任务重筹办意图> 读取首次意图() const noexcept {
        std::lock_guard<std::mutex> 锁(锁_);
        return 首次意图_;
    }

private:
    mutable std::mutex 锁_;
    bool 允许接收_ = false;
    std::uint64_t 调用次数_ = 0;
    std::optional<任务重筹办意图> 首次意图_;
};

自我治理消息 构造合法治理消息(
    自我治理消息类型 类型, std::uint64_t 编号) {
    自我治理消息 消息;
    消息.治理消息编号 = 编号;
    消息.类型 = 类型;
    消息.发生时间戳 = 1;
    消息.优先级 = 自我治理消息优先级::普通;
    消息.幂等键 = 编号;
    消息.批次编号 = 1;
    消息.非权威材料摘要 = 编号;
    消息.过期策略 = 自我治理过期策略::永不过期;
    消息.运行代次 = 1;
    消息.读取截止代次 = 1;
    const auto 身份 = [编号](std::uint64_t 偏移) {
        return 稳定编码{编号 * 100 + 偏移};
    };
    switch (类型) {
    case 自我治理消息类型::任务结果复核请求:
        消息.来源角色 = 自我治理来源角色::任务管理上行桥;
        消息.来源服务 = 自我治理服务角色::任务桥边界;
        消息.目标服务 = 自我治理服务角色::任务;
        消息.材料类型 = 自我治理只读材料类型::任务结果材料;
        消息.材料性质 = 自我治理材料性质::非权威回执;
        消息.来源任务序号 = 编号;
        消息.载荷 = 任务结果复核载荷{L2任务身份{身份(1)}, L2状态身份{身份(2)},
            L2动态身份{身份(3)}, L2方法身份{身份(4)}, L2方法动作入口身份{身份(5)},
            L2场景身份{身份(6)}, L2存在身份{身份(7)},
            L2结构幂等身份{编号 * 100 + 8},
            L2结构幂等身份{编号 * 100 + 9}};
        break;
    case 自我治理消息类型::派生需求请求:
        消息.来源角色 = 自我治理来源角色::任务需求分析入口;
        消息.来源服务 = 自我治理服务角色::需求分析边界;
        消息.目标服务 = 自我治理服务角色::需求;
        消息.材料类型 = 自我治理只读材料类型::需求派生材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.载荷 = 派生需求载荷{L2存在身份{身份(1)}, L2特征定义身份{身份(2)},
            L2特征实例身份{身份(3)}, L2状态身份{身份(4)}, L2状态身份{身份(5)}};
        break;
    case 自我治理消息类型::观察材料准入请求:
        消息.来源角色 = 自我治理来源角色::外部材料适配入口;
        消息.来源服务 = 自我治理服务角色::材料适配边界;
        消息.目标服务 = 自我治理服务角色::存在;
        消息.材料类型 = 自我治理只读材料类型::观察输入材料;
        消息.材料性质 = 自我治理材料性质::非权威观察;
        消息.载荷 = 观察材料准入载荷{L2存在身份{身份(1)}, L2场景身份{身份(2)},
            不可变材料身份{身份(3)}, L2任务身份{身份(4)},
            自我治理工作项身份{身份(5)}, 自我治理承接身份{身份(6)}};
        break;
    case 自我治理消息类型::执行前许可预判请求:
        消息.来源角色 = 自我治理来源角色::任务管理上行桥;
        消息.来源服务 = 自我治理服务角色::任务桥边界;
        消息.目标服务 = 自我治理服务角色::任务;
        消息.材料类型 = 自我治理只读材料类型::许可预判材料;
        消息.材料性质 = 自我治理材料性质::非权威请求;
        消息.来源任务序号 = 编号;
        消息.载荷 = 执行前许可预判载荷{L2任务身份{身份(1)},
            L2方法身份{身份(2)}, L2方法动作入口身份{身份(3)}};
        break;
    case 自我治理消息类型::自检缺口候选:
        消息.来源角色 = 自我治理来源角色::已确认自检入口;
        消息.来源服务 = 自我治理服务角色::自检边界;
        消息.目标服务 = 自我治理服务角色::治理边界;
        消息.材料类型 = 自我治理只读材料类型::自检缺口材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.载荷 = 自检缺口载荷{L2存在身份{身份(1)}, L2场景身份{身份(2)},
            不可变材料身份{身份(3)}};
        break;
    case 自我治理消息类型::缓存刷新请求:
        消息.来源角色 = 自我治理来源角色::领域落账观察桥;
        消息.来源服务 = 自我治理服务角色::领域观察边界;
        消息.目标服务 = 自我治理服务角色::统计;
        消息.材料类型 = 自我治理只读材料类型::缓存观察材料;
        消息.材料性质 = 自我治理材料性质::非权威观察;
        消息.载荷 = 缓存刷新载荷{L2需求身份{身份(1)}};
        break;
    case 自我治理消息类型::事件日志请求:
        消息.来源角色 = 自我治理来源角色::领域落账观察桥;
        消息.来源服务 = 自我治理服务角色::领域观察边界;
        消息.目标服务 = 自我治理服务角色::日志边界;
        消息.材料类型 = 自我治理只读材料类型::事件审计材料;
        消息.材料性质 = 自我治理材料性质::非权威观察;
        消息.载荷 = 事件日志载荷{L2动态身份{身份(1)}};
        break;
    case 自我治理消息类型::停止请求:
        消息.来源角色 = 自我治理来源角色::运行宿主;
        消息.来源服务 = 自我治理服务角色::运行边界;
        消息.目标服务 = 自我治理服务角色::治理边界;
        消息.优先级 = 自我治理消息优先级::停止;
        消息.材料类型 = 自我治理只读材料类型::停止信号材料;
        消息.材料性质 = 自我治理材料性质::生命周期信号;
        消息.读取截止代次 = 0;
        消息.载荷 = 停止载荷{};
        break;
    case 自我治理消息类型::概念待命名请求:
        消息.来源角色 = 自我治理来源角色::概念图观察入口;
        消息.来源服务 = 自我治理服务角色::概念图;
        消息.目标服务 = 自我治理服务角色::需求;
        消息.来源材料版本 = 1;
        消息.材料类型 = 自我治理只读材料类型::概念待命名材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.载荷 = 概念待命名载荷{L2概念身份{身份(1)}};
        break;
    default:
        break;
    }
    return 消息;
}

struct 任务特征方法查找真实链基础 final {
    std::uint64_t 事实代次 = 0;
    L2场景身份 场景;
    L2存在身份 目标存在;
    L2需求事实 需求;
    L2需求列表项事实 列表项;
    L2任务事实 任务;
    L2状态事实 当前状态;
    L2动态事实 动态;
    L2普通方法事实 方法;
};

enum class 任务特征方法查找真实场景 : std::uint8_t {
    对象概念待形成 = 1,
    基准缺失条件 = 2,
    方法能力缺失 = 3,
    方向不兼容 = 4,
    用途结果角色冲突 = 5,
    多适用候选 = 6,
    无需条件提议 = 7,
    输入限制待绑定 = 8,
    高于目标 = 9,
    达到且仅允许低于 = 10,
    达到且仅允许高于 = 11,
    达到且允许双向 = 12,
    条件满足 = 13,
    条件不满足 = 14,
    条件同特征多状态 = 15,
    条件场景不满足 = 16,
    条件角色未绑定 = 17,
    场景成员超限 = 18,
    普通对象概念 = 19,
    多对象概念 = 20,
    错根对象概念 = 21,
    对象概念长祖先链 = 22,
    对象类型不兼容 = 23,
    动态结果类型不兼容 = 24,
    目标状态合同不相同 = 25,
    多已绑定条件 = 26
};

std::optional<任务特征方法查找真实链基础> 建立任务特征方法查找真实链基础(
    普通应用上下文& 上下文,
    const std::optional<不可变材料身份> 概念支持材料 = std::nullopt,
    任务特征方法查找真实场景 场景类型 =
        任务特征方法查找真实场景::基准缺失条件) {
    const auto 失败 = [](const std::string_view 步骤)
        -> std::optional<任务特征方法查找真实链基础> {
        std::cout << "[治理测试] 失败：方法查找真实链基础步骤=" << 步骤 << "\n";
        return std::nullopt;
    };
    // 受测 provider 必须消费同一普通应用上下文中的真实工作包和权威事实。
    auto& 存在服务 = 上下文.取得L2存在结构服务();
    auto& 特征服务 = 上下文.取得L2特征结构服务();
    auto& 状态服务 = 上下文.取得L2状态结构服务();
    auto& 需求服务 = 上下文.取得L2需求结构服务();
    auto& 任务服务 = 上下文.取得L2任务结构服务();
    auto& 动态服务 = 上下文.取得L2动态结构服务();
    auto& 场景服务 = 上下文.取得L2场景结构服务();
    auto& 概念服务 = 上下文.取得L2概念结构聚合服务()
        .取得L2概念结构服务();
    auto& 方法服务 = 上下文.取得L2方法结构聚合服务()
        .取得L2方法结构服务();
    auto& 路径服务 = 上下文.取得L2任务方法路径结构服务();
    const auto 世界根 = 初始化并发布系统世界树根(
        上下文, 系统世界树根初始化请求{});
    if (!世界根.成功() || !世界根.已发布根) {
        std::cout << "[治理测试] 失败：方法查找真实链系统根初始化失败\n";
        return std::nullopt;
    }
    auto 当前代次读取 = 存在服务.读取当前事实代次();
    if (当前代次读取.状态 != L2结构状态::已读取) return 失败("读取当前代次");
    auto 方法查找代次 = 当前代次读取.事实截止代次;
    std::optional<L2概念身份> 方法查找存在根;
    std::optional<L2概念身份> 方法查找动态根;
    for (const auto 角色 : {L2概念本体根角色::存在,
            L2概念本体根角色::特征, L2概念本体根角色::动态,
            L2概念本体根角色::因果链}) {
        const auto 根写入 = 概念服务.建立概念本体根({
            {L2结构合同版本, 方法查找代次},
            L2结构幂等身份{0x7D00U + static_cast<std::uint64_t>(角色)}, 角色});
        if (!根写入.成功() || !根写入.本体根) return 失败("建立存在本体根");
        方法查找代次 = 根写入.结果头.事实截止代次;
        if (角色 == L2概念本体根角色::存在)
            方法查找存在根 = 根写入.本体根->根概念;
        if (角色 == L2概念本体根角色::动态)
            方法查找动态根 = 根写入.本体根->根概念;
    }
    if (!方法查找存在根 || !方法查找动态根)
        return 失败("取得概念本体根");
    const auto 所属存在写入 = 存在服务.新增角色化存在({
        {L2结构合同版本, 方法查找代次}, L2结构幂等身份{0x7D10},
        L2存在单例角色键{0x7D10}});
    if (!所属存在写入.成功() || !所属存在写入.存在) return 失败("建立所属存在");
    方法查找代次 = 所属存在写入.结果头.事实截止代次;
    const auto 目标存在写入 = 存在服务.新增角色化存在({
        {L2结构合同版本, 方法查找代次}, L2结构幂等身份{0x7D11},
        L2存在单例角色键{0x7D11}});
    if (!目标存在写入.成功() || !目标存在写入.存在) return 失败("建立目标存在");
    方法查找代次 = 目标存在写入.结果头.事实截止代次;
    std::optional<L2概念身份> 方法替代对象类型;
    if (概念支持材料) {
        const bool 需要普通概念 = 场景类型 ==
                任务特征方法查找真实场景::普通对象概念
            || 场景类型 == 任务特征方法查找真实场景::多对象概念
            || 场景类型 == 任务特征方法查找真实场景::错根对象概念
            || 场景类型 == 任务特征方法查找真实场景::对象概念长祖先链;
        std::optional<L2普通概念事实> 普通概念;
        auto 普通概念直接上位 = 场景类型 ==
            任务特征方法查找真实场景::错根对象概念
            ? *方法查找动态根 : *方法查找存在根;
        if (场景类型 == 任务特征方法查找真实场景::对象概念长祖先链) {
            const auto 中间概念写入 = 概念服务.建立普通概念({
                {L2结构合同版本, 方法查找代次}, L2普通概念结构合同版本,
                L2结构幂等身份{0x7D40}, *方法查找存在根,
                *概念支持材料, {{1, 1, std::int64_t{1}}}, {}, {},
                {*方法查找存在根},
                {*概念支持材料}});
            if (!中间概念写入.成功() || !中间概念写入.概念)
                return 失败("建立中间普通概念");
            方法查找代次 = 中间概念写入.结果头.事实截止代次;
            普通概念直接上位 = 中间概念写入.概念->概念;
        }
        if (需要普通概念) {
            const auto 本体根 = 场景类型 ==
                任务特征方法查找真实场景::错根对象概念
                ? *方法查找动态根 : *方法查找存在根;
