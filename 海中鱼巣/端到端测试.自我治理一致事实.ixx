        if (!预算装配.成功()) return false;
        const auto 候选路径 = 配置.配置->不可变材料存储.受控根.绝对路径
            / L"候选" / 文件名;
        const auto 材料 = 写入任务特征方法查找概念支持材料(
            *预算装配.上下文, 候选路径);
        if (!材料) return false;
        auto 请求 = 形成任务特征方法查找真实请求(
            *预算装配.上下文, 材料, 场景类型);
        if (!请求) return false;
        修改请求(*请求);
        return 验证任务特征方法查找失败请求(
            *预算装配.上下文, *请求, 期望状态);
    };
    {
