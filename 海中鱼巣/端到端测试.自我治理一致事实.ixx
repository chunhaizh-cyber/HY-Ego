        return false;
    }
    完整秒边界读取请求 完整秒请求;
    完整秒请求.运行代次 = 运行代次;
    完整秒请求.时间纪元身份 = 时间纪元身份;
    完整秒请求.期望时间源版本 = 稳态时钟时间源版本;
    const auto 完整秒结果 = 完整秒服务.读取当前完整秒边界(完整秒请求);
    if (!完整秒结果.观察 ||
