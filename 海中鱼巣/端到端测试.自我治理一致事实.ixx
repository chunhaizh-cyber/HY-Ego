    值请求.请求头 = 值头;
    值请求.幂等身份 = L2结构幂等身份{7301};
    值请求.特征实例 = 安全根实例;
    值请求.新值材料 = std::vector<std::int64_t>{2, 5, 10};
    值请求.来源稳定编码 = 安全根特征定义.值;
    auto 安全根值新增 = 特征服务->新增特征当前值(值请求);
    if (!安全根值新增.成功() || !安全根值新增.当前值) {
        std::cout << "[治理测试] 失败：新增安全根特征值失败，状态="
