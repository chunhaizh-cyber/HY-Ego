    const auto 构造概念待命名消息 = [](std::uint64_t 消息编号,
                                      std::uint64_t 幂等键) {
        自我治理消息 消息;
        消息.治理消息编号 = 消息编号;
        消息.类型 = 自我治理消息类型::概念待命名请求;
        消息.来源角色 = 自我治理来源角色::概念图观察入口;
        消息.来源服务 = 自我治理服务角色::概念图;
        消息.目标服务 = 自我治理服务角色::需求;
        消息.发生时间戳 = 1;
        消息.优先级 = 自我治理消息优先级::普通;
        消息.幂等键 = 幂等键;
        消息.来源材料版本 = 1;
        消息.批次编号 = 1;
        消息.非权威材料摘要 = 消息编号;
        消息.材料类型 = 自我治理只读材料类型::概念待命名材料;
        消息.材料性质 = 自我治理材料性质::非权威候选;
        消息.过期策略 = 自我治理过期策略::永不过期;
        消息.运行代次 = 1;
        消息.读取截止代次 = 1;
        消息.载荷 = 概念待命名载荷{L2概念身份{稳定编码{消息编号}}};
        return 消息;
    };

    有界自我治理邮箱 邮箱(2);
    const auto 普通消息 = 构造概念待命名消息(2, 2);
    if (邮箱.提交(普通消息, 1).状态
        != 自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：停止前普通治理消息提交失败\n";
        return false;
    }
    自我治理消息 停止消息;
    停止消息.治理消息编号 = 1;
    停止消息.类型 = 自我治理消息类型::停止请求;
    停止消息.来源角色 = 自我治理来源角色::运行宿主;
    停止消息.来源服务 = 自我治理服务角色::运行边界;
    停止消息.目标服务 = 自我治理服务角色::治理边界;
    停止消息.发生时间戳 = 1;
    停止消息.优先级 = 自我治理消息优先级::停止;
    停止消息.幂等键 = 1;
    停止消息.批次编号 = 1;
    停止消息.非权威材料摘要 = 1;
    停止消息.材料类型 = 自我治理只读材料类型::停止信号材料;
    停止消息.材料性质 = 自我治理材料性质::生命周期信号;
    停止消息.过期策略 = 自我治理过期策略::永不过期;
    停止消息.运行代次 = 运行代次;
    停止消息.载荷 = 停止载荷{};
    const auto 提交结果 = 邮箱.提交(停止消息, 1);
    if (提交结果.状态 != 自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：治理路由合法消息提交失败\n";
        return false;
    }
    自我治理批次路由 路由(
        邮箱, 完整秒服务, 事实版本服务, 运行代次,
        时间纪元身份, 稳态时钟时间源版本, 事实范围版本);
    治理批次组合请求 批次请求;
    批次请求.运行代次 = 运行代次;
    批次请求.时间纪元身份 = 时间纪元身份;
    批次请求.期望时间源版本 = 稳态时钟时间源版本;
    批次请求.最大等待毫秒 = 1;
    批次请求.事实范围版本 = 事实范围版本;
    const auto 批次结果 = 路由.冻结当前治理批次(批次请求);
    if (批次结果.状态 != 治理批次状态::已冻结 ||
        !批次结果.治理批次 ||
        批次结果.治理批次->运行代次 != 运行代次 ||
        批次结果.治理批次->消息批次.数量() != 2 ||
        批次结果.治理批次->消息批次.读取消息组().front().治理消息编号 != 1 ||
        批次结果.治理批次->共享事实截止.事实截止代次 == 0 ||
        批次结果.治理批次->完整秒.运行代次 != 运行代次 ||
        批次结果.治理批次->完整秒.时间纪元身份 != 时间纪元身份) {
        std::cout << "[治理测试] 失败：治理批次未消费最终提供者材料\n";
        return false;
    }

    治理批次分类请求 分类请求;
    分类请求.批次 = std::addressof(*批次结果.治理批次);
    分类请求.当前单调时间 = 1;
    分类请求.运行代次 = 运行代次;
    const auto 分类结果 = 路由.复核并分类治理批次(分类请求);
    if (分类结果.状态 != 治理批次分类状态::停止优先
        || 分类结果.批次序号 != 批次结果.治理批次->批次序号
        || 分类结果.有序治理输入组.size() != 1
        || 分类结果.有序治理输入组.front().类别 != 治理输入类别::停止
        || 分类结果.有序治理输入组.front().消息.治理消息编号 != 1
        || !分类结果.逐项诊断.empty()) {
        std::cout << "[治理测试] 失败：停止治理批次未形成停止优先分类\n";
        return false;
    }
    const auto 停止路由结果 = 路由.复核分类并路由治理批次(分类请求);
    if (停止路由结果.分类状态 != 治理批次分类状态::停止优先
        || 停止路由结果.有序路由组.size() != 1
        || 停止路由结果.有序路由组.front().后继 != 治理输入后继::停止
        || 停止路由结果.有序路由组.front().状态 != 治理输入路由状态::已路由) {
        std::cout << "[治理测试] 失败：停止未形成唯一截断路由\n";
        return false;
    }

    有界自我治理邮箱 分类邮箱(3);
    const auto 第一普通消息 = 构造概念待命名消息(10, 10);
    auto 第二普通消息 = 构造概念待命名消息(11, 11);
    第二普通消息.类型 = 自我治理消息类型::观察材料准入请求;
    第二普通消息.来源角色 = 自我治理来源角色::外部材料适配入口;
    第二普通消息.来源服务 = 自我治理服务角色::材料适配边界;
    第二普通消息.目标服务 = 自我治理服务角色::存在;
    第二普通消息.材料类型 = 自我治理只读材料类型::观察输入材料;
    第二普通消息.材料性质 = 自我治理材料性质::非权威观察;
    第二普通消息.来源材料版本 = 0;
    第二普通消息.载荷 = 观察材料准入载荷{
        L2存在身份{稳定编码{101}}, L2场景身份{稳定编码{102}},
        不可变材料身份{稳定编码{103}}, {}, {}, {}};
    auto 过期消息 = 构造概念待命名消息(12, 12);
    过期消息.过期策略 = 自我治理过期策略::截止时间;
    过期消息.截止时间戳 = 1;
    if (分类邮箱.提交(第一普通消息, 1).状态
            != 自我治理提交状态::已提交
        || 分类邮箱.提交(第二普通消息, 1).状态
            != 自我治理提交状态::已提交
        || 分类邮箱.提交(过期消息, 1).状态
            != 自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：分类批次合法消息提交失败\n";
        return false;
    }
    自我治理批次路由 分类路由(
        分类邮箱, 完整秒服务, 事实版本服务, 运行代次,
        时间纪元身份, 稳态时钟时间源版本, 事实范围版本);
    const auto 待分类批次结果 = 分类路由.冻结当前治理批次(批次请求);
    if (待分类批次结果.状态 != 治理批次状态::已冻结
        || !待分类批次结果.治理批次) {
        std::cout << "[治理测试] 失败：普通治理分类批次冻结失败\n";
        return false;
    }
    治理批次分类请求 普通分类请求;
    普通分类请求.批次 =
        std::addressof(*待分类批次结果.治理批次);
    普通分类请求.当前单调时间 = 2;
    普通分类请求.运行代次 = 运行代次;
    const auto 普通分类结果 =
        分类路由.复核并分类治理批次(普通分类请求);
    if (普通分类结果.状态 != 治理批次分类状态::存在时效拒绝
        || 普通分类结果.有序治理输入组.size() != 2
        || 普通分类结果.有序治理输入组[0].消息.治理消息编号 != 10
        || 普通分类结果.有序治理输入组[0].类别
            != 治理输入类别::概念待命名
        || 普通分类结果.有序治理输入组[1].消息.治理消息编号 != 11
        || 普通分类结果.有序治理输入组[1].类别
            != 治理输入类别::观察材料准入
        || 普通分类结果.逐项诊断.size() != 1
        || 普通分类结果.逐项诊断.front().消息编号 != 12
        || 普通分类结果.逐项诊断.front().准入结果.拒绝原因
            != 自我治理拒绝原因::材料已过期) {
        std::cout << "[治理测试] 失败：稳定分类顺序或过期诊断不正确\n";
        return false;
    }

    auto 坏分类请求 = 普通分类请求;
    坏分类请求.合同版本 = 0;
    const auto 坏合同分类 = 分类路由.复核并分类治理批次(坏分类请求);
    坏分类请求 = 普通分类请求;
    坏分类请求.批次 = nullptr;
    const auto 空指针分类 = 分类路由.复核并分类治理批次(坏分类请求);
    坏分类请求 = 普通分类请求;
    坏分类请求.运行代次 = 2;
    const auto 坏代次分类 = 分类路由.复核并分类治理批次(坏分类请求);
    坏分类请求 = 普通分类请求;
    坏分类请求.协议版本 = 0;
    const auto 坏协议分类 = 分类路由.复核并分类治理批次(坏分类请求);
    if (坏合同分类.状态 != 治理批次分类状态::入口拒绝
        || 空指针分类.状态 != 治理批次分类状态::入口拒绝
        || 坏代次分类.状态 != 治理批次分类状态::入口拒绝
        || 坏协议分类.状态 != 治理批次分类状态::入口拒绝) {
        std::cout << "[治理测试] 失败：分类入口拒绝分账不正确\n";
        return false;
    }

    const auto 分类后截止结果 =
        事实版本服务.读取当前已发布共享事实截止(
            {共享事实截止读取合同版本, 运行代次, 事实范围版本});
    if (分类后截止结果.状态 != 共享事实截止读取状态::已读取
        || !分类后截止结果.截止
        || 分类后截止结果.截止->事实截止代次
            != 截止结果.截止->事实截止代次) {
        std::cout << "[治理测试] 失败：分类过程改写了共享事实截止\n";
        return false;
    }

    // 当前协议不接受旧版本、错 alternative、零身份、零运行代次或零 G0；停止是
    // 唯一允许零 G0 的类别。
    自我治理准入上下文 协议上下文;
    协议上下文.当前时间戳 = 1;
    auto 旧版本 = 构造合法治理消息(自我治理消息类型::概念待命名请求, 40);
    旧版本.协议版本 = 2;
    auto 错载荷 = 构造合法治理消息(自我治理消息类型::概念待命名请求, 41);
    错载荷.载荷 = 停止载荷{};
    auto 零身份 = 构造合法治理消息(自我治理消息类型::概念待命名请求, 42);
    零身份.载荷 = 概念待命名载荷{L2概念身份{稳定编码{}}};
    auto 零运行代次 = 构造合法治理消息(自我治理消息类型::概念待命名请求, 43);
    零运行代次.运行代次 = 0;
    auto 零G0 = 构造合法治理消息(自我治理消息类型::概念待命名请求, 44);
    零G0.读取截止代次 = 0;
    if (复核自我治理消息(旧版本, 协议上下文).拒绝原因 != 自我治理拒绝原因::协议版本不匹配
        || 复核自我治理消息(错载荷, 协议上下文).拒绝原因 != 自我治理拒绝原因::载荷与消息类型不匹配
        || 复核自我治理消息(零身份, 协议上下文).拒绝原因 != 自我治理拒绝原因::必填句柄缺失
        || 复核自我治理消息(零运行代次, 协议上下文).拒绝原因 != 自我治理拒绝原因::运行代次缺失
        || 复核自我治理消息(零G0, 协议上下文).拒绝原因 != 自我治理拒绝原因::读取截止代次缺失
        || 复核自我治理消息(构造合法治理消息(自我治理消息类型::停止请求, 45), 协议上下文).状态
            != 自我治理准入状态::可准入) {
        std::cout << "[治理测试] 失败：当前协议拒绝边界不正确\n";
        return false;
    }

    const auto 构造合法任务结果回执 = [] {
        任务结果回执材料 回执;
        回执.回执编号 = 91;
        回执.发生时间戳 = 1;
        回执.幂等键 = 92;
        回执.来源任务序号 = 93;
        回执.批次编号 = 94;
        回执.非权威材料摘要 = 95;
        回执.来源材料版本 = 96;
        回执.任务实际结果写入幂等身份 = L2结构幂等身份{97};
        回执.任务治理首态写入幂等身份 = L2结构幂等身份{98};
        回执.任务重筹办迁移写入幂等身份 = L2结构幂等身份{99};
        回执.运行代次 = 1;
        回执.读取截止代次 = 1;
        回执.材料性质 = 任务结果回执材料性质::非权威任务执行结果证据;
        回执.过期策略 = 任务结果回执过期策略::截止时间;
        回执.截止时间戳 = 2;
        回执.身份组 = {
            L2任务身份{稳定编码{101}}, L2状态身份{稳定编码{102}},
            L2动态身份{稳定编码{103}}, L2方法身份{稳定编码{104}},
            L2方法动作入口身份{稳定编码{105}}, L2场景身份{稳定编码{106}},
            L2存在身份{稳定编码{107}}};
        回执.来源执行绑定 = 任务结果回执来源执行绑定{
            回执.回执编号, 回执.来源任务序号, 回执.批次编号, 回执.幂等键,
            回执.身份组.目标任务, 回执.身份组.目标方法,
            回执.身份组.目标动作入口};
        return 回执;
    };
    const auto 合法回执 = 构造合法任务结果回执();
    任务结果回执准入上下文 回执上下文;
    回执上下文.当前时间戳 = 1;
    auto 过期回执上下文 = 回执上下文;
    过期回执上下文.当前时间戳 = 2;
    auto 过期回执 = 合法回执;
    过期回执.截止时间戳 = 1;
    auto 零运行代次回执 = 合法回执;
    零运行代次回执.运行代次 = 0;
    auto 零来源材料版本回执 = 合法回执;
    零来源材料版本回执.来源材料版本 = 0;
    auto 零写入幂等身份回执 = 合法回执;
    零写入幂等身份回执.任务实际结果写入幂等身份 = L2结构幂等身份{};
    auto 零首态写入幂等身份回执 = 合法回执;
    零首态写入幂等身份回执.任务治理首态写入幂等身份 =
        L2结构幂等身份{};
    auto 零迁移写入幂等身份回执 = 合法回执;
    零迁移写入幂等身份回执.任务重筹办迁移写入幂等身份 =
        L2结构幂等身份{};
    auto 重复首态写入幂等身份回执 = 合法回执;
    重复首态写入幂等身份回执.任务治理首态写入幂等身份 =
        合法回执.任务实际结果写入幂等身份;
    auto 重复迁移写入幂等身份回执 = 合法回执;
    重复迁移写入幂等身份回执.任务重筹办迁移写入幂等身份 =
        合法回执.任务治理首态写入幂等身份;
    auto 零G0回执 = 合法回执;
    零G0回执.读取截止代次 = 0;
    auto 零身份回执 = 合法回执;
    零身份回执.身份组.目标任务 = L2任务身份{稳定编码{}};
    auto 缺绑定回执 = 合法回执;
    缺绑定回执.来源执行绑定.reset();
    auto 重复上下文 = 回执上下文;
    重复上下文.同幂等键既有材料 = 合法回执;
    auto 冲突回执 = 合法回执;
    冲突回执.非权威材料摘要 = 96;
    auto 任务序号倒退上下文 = 回执上下文;
    任务序号倒退上下文.同任务目标 = 合法回执.身份组.目标任务;
    任务序号倒退上下文.同任务最新序号 = 合法回执.来源任务序号 + 1;
    auto 上下文不一致 = 回执上下文;
    上下文不一致.同任务目标 = 合法回执.身份组.目标任务;
    const auto 合法回执结果 = 复核任务结果回执材料(合法回执, 回执上下文);
    const auto 过期回执结果 = 复核任务结果回执材料(过期回执, 过期回执上下文);
    const auto 零运行代次回执结果 = 复核任务结果回执材料(零运行代次回执, 回执上下文);
    const auto 零来源材料版本回执结果 =
        复核任务结果回执材料(零来源材料版本回执, 回执上下文);
    const auto 零写入幂等身份回执结果 =
        复核任务结果回执材料(零写入幂等身份回执, 回执上下文);
    const auto 零首态写入幂等身份回执结果 =
        复核任务结果回执材料(零首态写入幂等身份回执, 回执上下文);
    const auto 零迁移写入幂等身份回执结果 =
        复核任务结果回执材料(零迁移写入幂等身份回执, 回执上下文);
    const auto 重复首态写入幂等身份回执结果 =
        复核任务结果回执材料(重复首态写入幂等身份回执, 回执上下文);
    const auto 重复迁移写入幂等身份回执结果 =
        复核任务结果回执材料(重复迁移写入幂等身份回执, 回执上下文);
    const auto 零G0回执结果 = 复核任务结果回执材料(零G0回执, 回执上下文);
    const auto 零身份回执结果 = 复核任务结果回执材料(零身份回执, 回执上下文);
    const auto 缺绑定回执结果 = 复核任务结果回执材料(缺绑定回执, 回执上下文);
    const auto 重复回执结果 = 复核任务结果回执材料(合法回执, 重复上下文);
    const auto 冲突回执结果 = 复核任务结果回执材料(冲突回执, 重复上下文);
    const auto 倒退回执结果 = 复核任务结果回执材料(合法回执, 任务序号倒退上下文);
    const auto 上下文不一致结果 = 复核任务结果回执材料(合法回执, 上下文不一致);
    if (合法回执结果.状态
            != 任务结果回执准入状态::可准入
        || 过期回执结果.拒绝原因
            != 任务结果回执拒绝原因::材料已过期
        || 零运行代次回执结果.拒绝原因
            != 任务结果回执拒绝原因::运行代次缺失
        || 零来源材料版本回执结果.拒绝原因
            != 任务结果回执拒绝原因::来源材料版本缺失
        || 零写入幂等身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::写入幂等身份缺失
        || 零首态写入幂等身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::写入幂等身份缺失
        || 零迁移写入幂等身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::写入幂等身份缺失
        || 重复首态写入幂等身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::写入幂等身份缺失
        || 重复迁移写入幂等身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::写入幂等身份缺失
        || 零G0回执结果.拒绝原因
            != 任务结果回执拒绝原因::读取截止代次缺失
        || 零身份回执结果.拒绝原因
            != 任务结果回执拒绝原因::必填身份缺失
        || 缺绑定回执结果.拒绝原因
            != 任务结果回执拒绝原因::来源执行绑定缺失
        || 重复回执结果.状态
            != 任务结果回执准入状态::重复材料
        || 冲突回执结果.拒绝原因
            != 任务结果回执拒绝原因::幂等键冲突
        || 倒退回执结果.拒绝原因
            != 任务结果回执拒绝原因::同一任务序号倒退
        || 上下文不一致结果.状态
            != 任务结果回执准入状态::内部不一致) {
        std::cout << "[治理测试] 失败：任务结果回执准入分账不正确："
            << static_cast<unsigned>(合法回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(过期回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零运行代次回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零来源材料版本回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零写入幂等身份回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零G0回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(零身份回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(缺绑定回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(重复回执结果.状态) << "/"
            << static_cast<unsigned>(冲突回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(倒退回执结果.拒绝原因) << "/"
            << static_cast<unsigned>(上下文不一致结果.状态) << "\n";
        return false;
    }

    有界自我治理邮箱 九类邮箱(8);
    const std::vector<自我治理消息类型> 普通类型组{
        自我治理消息类型::任务结果复核请求,
        自我治理消息类型::派生需求请求,
        自我治理消息类型::观察材料准入请求,
        自我治理消息类型::执行前许可预判请求,
        自我治理消息类型::自检缺口候选,
        自我治理消息类型::缓存刷新请求,
        自我治理消息类型::事件日志请求,
        自我治理消息类型::概念待命名请求};
    std::uint64_t 消息编号 = 50;
    for (const auto 类型 : 普通类型组) {
        const auto 消息 = 构造合法治理消息(类型, 消息编号++);
        const auto 直接准入 = 复核自我治理消息(消息, 协议上下文);
        const auto 提交 = 九类邮箱.提交(消息, 1);
        if (提交.状态 != 自我治理提交状态::已提交) {
            std::cout << "[治理测试] 失败：合法普通消息未进入邮箱，类型="
                << static_cast<unsigned>(类型) << "，拒绝="
                << static_cast<unsigned>(提交.协议结果.拒绝原因)
                << "，消息类型=" << static_cast<unsigned>(消息.类型)
                << "，直接拒绝=" << static_cast<unsigned>(直接准入.拒绝原因) << "\n";
            return false;
        }
    }
    自我治理批次路由 九类路由(
        九类邮箱, 完整秒服务, 事实版本服务, 运行代次,
        时间纪元身份, 稳态时钟时间源版本, 事实范围版本);
    const auto 九类批次 = 九类路由.冻结当前治理批次(批次请求);
    if (九类批次.状态 != 治理批次状态::已冻结 || !九类批次.治理批次) {
        std::cout << "[治理测试] 失败：九类当前协议批次冻结失败\n";
        return false;
    }
    治理批次分类请求 九类请求;
    九类请求.批次 = std::addressof(*九类批次.治理批次);
    九类请求.当前单调时间 = 1;
    九类请求.运行代次 = 运行代次;
    const auto 九类结果 = 九类路由.复核分类并路由治理批次(九类请求);
    if (九类结果.分类状态 != 治理批次分类状态::已分类
        || 九类结果.有序路由组.size() != 普通类型组.size()
        || !九类结果.逐项诊断.empty()) {
        std::cout << "[治理测试] 失败：九类当前协议路由未完整形成\n";
        return false;
    }
    const std::vector<治理输入后继> 期望后继组{
        治理输入后继::治理输入事实复核, 治理输入后继::派生需求准入,
        治理输入后继::治理输入事实复核, 治理输入后继::生存控制裁决,
        治理输入后继::自检缺口准入, 治理输入后继::缓存支持旁路,
        治理输入后继::日志支持旁路, 治理输入后继::概念命名准入};
    for (std::size_t 下标 = 0; 下标 < 九类结果.有序路由组.size(); ++下标) {
        const auto& 路由项 = 九类结果.有序路由组[下标];
        if (路由项.输入.消息.类型 != 普通类型组[下标]
            || 路由项.后继 != 期望后继组[下标]
            || 路由项.状态 != 治理输入路由状态::合法等待) {
            std::cout << "[治理测试] 失败：普通输入未保留唯一合法等待路由\n";
            return false;
        }
    }

    std::cout << "[治理测试] 运行期时间与事实提供者闭环读回通过\n";
    return true;
}

bool 验证需求当前满足实时裁决() {
    const auto 失败 = [](std::string_view 步骤) {
        std::cout << "[治理测试] 失败：需求当前满足实时裁决步骤="
            << 步骤 << "\n";
        return false;
    };
    const auto 配置 = 形成普通应用生产配置();
    if (!配置.成功()) return 失败("形成普通应用配置");
    auto 装配 = 构造普通应用上下文(*配置.配置);
    if (!装配.成功()) return 失败("构造普通应用上下文");
    auto& 上下文 = *装配.上下文;
    auto& 存在服务 = 上下文.取得L2存在结构服务();
    auto& 需求服务 = 上下文.取得L2需求结构服务();
    auto& 任务服务 = 上下文.取得L2任务结构服务();
    auto& 方法服务 = 上下文.取得L2方法结构聚合服务()
        .取得L2方法结构服务();
    auto& 状态服务 = 上下文.取得L2状态结构服务();
    auto& 特征服务 = 上下文.取得L2特征结构服务();
    auto& 场景服务 = 上下文.取得L2场景结构服务();
    auto& 动态服务 = 上下文.取得L2动态结构服务();

    const auto 基础结果 = 建立任务特征方法查找真实链基础(上下文);
    if (!基础结果) return 失败("建立需求目标公开事实基础");
    const auto& 基础 = *基础结果;
    auto 当前代次 = 基础.事实代次;
    const auto 目标特征 = 基础.需求.目标特征定义;
    const auto 目标宿主 = 基础.需求.目标宿主存在;
    const auto 所属存在 = 基础.需求.所属存在;
    const auto 目标实例 = 基础.当前状态.特征实例;

    const auto 当前值写入 = 特征服务.新增特征当前值({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA0},
        目标实例, L2原始值材料{std::int64_t{50}}, 目标特征.值});
    if (!当前值写入.成功() || !当前值写入.当前值)
        return 失败("建立目标宿主当前特征值");
    当前代次 = 当前值写入.结果头.事实截止代次;

    const auto 注册读取 = 特征服务.读取当前特征比较注册({
        {L2结构合同版本, 当前代次}, 目标特征,
        L2特征比较用途::目标判断});
    if (!注册读取.成功() || !注册读取.注册)
        return 失败("读取目标判断比较注册");
    const auto 比较注册 = *注册读取.注册;
    const auto 基础合同读取 = 状态服务.读取完整目标状态合同({
        {L2结构合同版本, 当前代次}, L2读取类别::当前,
        基础.需求.目标状态合同, 0});
    if (!基础合同读取.成功() || !基础合同读取.合同)
        return 失败("读取基础目标合同");
    const auto 基础合同 = *基础合同读取.合同;

    const auto 相等合同写入 = 状态服务.新增目标状态合同({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA1},
        目标特征, 比较注册.身份, 50, 0x02,
        L2目标状态合同规则版本, 目标特征.值});
    if (!相等合同写入.成功() || !相等合同写入.当前合同)
        return 失败("建立相等目标合同");
    const auto 相等合同 = *相等合同写入.当前合同;
    当前代次 = 相等合同写入.结果头.事实截止代次;
    const auto 低于允许合同写入 = 状态服务.新增目标状态合同({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA2},
        目标特征, 比较注册.身份, 100, 0x01,
        L2目标状态合同规则版本, 目标特征.值});
    if (!低于允许合同写入.成功() || !低于允许合同写入.当前合同)
        return 失败("建立允许低于目标合同");
    const auto 低于允许合同 = *低于允许合同写入.当前合同;
    当前代次 = 低于允许合同写入.结果头.事实截止代次;

    const auto 未满足需求写入 = 需求服务.新增需求并建立列表项({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA3},
        所属存在, 目标宿主, 目标特征, 基础合同.身份,
        std::nullopt, 0, 目标特征.值});
    if (!未满足需求写入.成功() || !未满足需求写入.新建需求
        || !未满足需求写入.新建列表项
        || !未满足需求写入.当前成员关系)
        return 失败("建立无任务未满足需求");
    当前代次 = 未满足需求写入.结果头.事实截止代次;
    const auto 第二成员写入 = 需求服务.新增需求并加入既有列表项({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA4},
        未满足需求写入.新建列表项->身份,
        未满足需求写入.新建需求->身份, 1, 目标特征.值});
    if (!第二成员写入.成功() || !第二成员写入.新建需求
        || !第二成员写入.当前成员关系)
        return 失败("建立同列表第二需求成员");
    当前代次 = 第二成员写入.结果头.事实截止代次;
    const auto 已满足需求写入 = 需求服务.新增需求并建立列表项({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA5},
        所属存在, 目标宿主, 目标特征, 相等合同.身份,
        std::nullopt, 0, 目标特征.值});
    if (!已满足需求写入.成功() || !已满足需求写入.新建需求)
        return 失败("建立相等已满足需求");
    当前代次 = 已满足需求写入.结果头.事实截止代次;
    const auto 允许低于需求写入 = 需求服务.新增需求并建立列表项({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA6},
        所属存在, 目标宿主, 目标特征, 低于允许合同.身份,
        std::nullopt, 0, 目标特征.值});
    if (!允许低于需求写入.成功() || !允许低于需求写入.新建需求)
        return 失败("建立允许低于需求");
    当前代次 = 允许低于需求写入.结果头.事实截止代次;

    const auto 无实例宿主写入 = 存在服务.新增角色化存在({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA70},
        L2存在单例角色键{0x7FA70}});
    if (!无实例宿主写入.成功() || !无实例宿主写入.存在)
        return 失败("建立无实例目标宿主");
    当前代次 = 无实例宿主写入.结果头.事实截止代次;
    const auto 无实例场景成员写入 = 场景服务.新增场景成员关系({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA71},
        基础.场景, 无实例宿主写入.存在->身份, 2});
    if (!无实例场景成员写入.成功())
        return 失败("建立无实例宿主场景成员关系");
    当前代次 = 无实例场景成员写入.结果头.事实截止代次;
    const auto 无实例需求写入 = 需求服务.新增需求并建立列表项({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA7},
        所属存在, 无实例宿主写入.存在->身份, 目标特征, 基础合同.身份,
        std::nullopt, 0, 目标特征.值});
    if (!无实例需求写入.成功() || !无实例需求写入.新建需求)
        return 失败("建立无当前实例需求");
    当前代次 = 无实例需求写入.结果头.事实截止代次;

    const auto 向量宿主写入 = 存在服务.新增角色化存在({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA8},
        L2存在单例角色键{0x7FA8}});
    if (!向量宿主写入.成功() || !向量宿主写入.存在)
        return 失败("建立向量值目标宿主");
    当前代次 = 向量宿主写入.结果头.事实截止代次;
    const auto 向量实例写入 = 特征服务.新增特征实例({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FA9},
        向量宿主写入.存在->身份, 目标特征});
    if (向量实例写入.结果头.状态 != L2结构状态::已提交
        || !向量实例写入.特征实例)
        return 失败("建立向量值特征实例");
    当前代次 = 向量实例写入.结果头.事实截止代次;
    const auto 向量值写入 = 特征服务.新增特征当前值({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FAA},
        向量实例写入.特征实例->身份,
        L2原始值材料{std::vector<std::int64_t>{50}}, 目标特征.值});
    if (!向量值写入.成功()) return 失败("建立不可比较向量当前值");
    当前代次 = 向量值写入.结果头.事实截止代次;
    const auto 向量需求写入 = 需求服务.新增需求并建立列表项({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FAB},
        所属存在, 向量宿主写入.存在->身份, 目标特征, 相等合同.身份,
        std::nullopt, 0, 目标特征.值});
    if (!向量需求写入.成功() || !向量需求写入.新建需求)
        return 失败("建立不可比较向量需求");
    当前代次 = 向量需求写入.结果头.事实截止代次;

    运行期只读查询组合器 组合器(需求服务, 任务服务, 方法服务,
        状态服务, 特征服务, 存在服务, 场景服务, 动态服务);
    const auto 形成请求 = [&](std::uint64_t 身份值, L2需求身份 需求) {
        return 需求当前满足裁决请求{运行期只读查询合同版本,
            身份值, 需求, 当前代次};
    };
    auto 无效版本 = 形成请求(0x7FAC, 已满足需求写入.新建需求->身份);
    无效版本.合同版本 = 0;
    auto 零请求身份 = 形成请求(0, 已满足需求写入.新建需求->身份);
    auto 零需求 = 形成请求(0x7FAD, L2需求身份{稳定编码{0}});
    auto 零截止 = 形成请求(0x7FAE, 已满足需求写入.新建需求->身份);
    零截止.共享事实截止G0 = 0;
    for (const auto& 坏请求 : {无效版本, 零请求身份, 零需求, 零截止}) {
        const auto 结果 = 组合器.裁决需求当前满足(坏请求);
        if (结果.状态 != 需求当前满足裁决状态::入口拒绝 || 结果.裁决)
            return 失败("V01 无效请求未零裁决拒绝");
    }

    const auto 裁决前代次 = 存在服务.读取当前事实代次();
    if (裁决前代次.状态 != L2结构状态::已读取)
        return 失败("V19 裁决前代次读取");
    const auto 已满足请求 = 形成请求(0x7FB0,
        已满足需求写入.新建需求->身份);
    const auto 已满足 = 组合器.裁决需求当前满足(已满足请求);
    if (已满足.状态 != 需求当前满足裁决状态::已满足
        || !已满足.成功() || !已满足.裁决
        || 已满足.裁决->需求事实.身份 != 已满足请求.需求
        || 已满足.裁决->当前成员关系.需求 != 已满足请求.需求
        || 已满足.裁决->当前成员关系.列表项
            != 已满足.裁决->所属列表项.身份
        || 已满足.裁决->所属列表项.所属存在
            != 已满足.裁决->需求事实.所属存在
        || 已满足.裁决->所属列表项.目标宿主存在
            != 已满足.裁决->需求事实.目标宿主存在
        || 已满足.裁决->所属列表项.目标特征定义
            != 已满足.裁决->需求事实.目标特征定义
        || 已满足.裁决->所属列表项.目标状态合同
            != 已满足.裁决->需求事实.目标状态合同
        || !L2需求列表项事实完整(
            已满足.裁决->所属列表项, 当前代次)
        || 已满足.裁决->所属列表项.生命周期.退出事实代次
        || 已满足.裁决->当前特征实例.身份 != 目标实例
        || 已满足.裁决->当前特征值 != *当前值写入.当前值
        || 已满足.裁决->目标合同 != 相等合同
        || 已满足.裁决->具名关系
            != L2特征比较具名关系::当前达到目标
        || 已满足.裁决->事实截止代次 != 当前代次) {
        std::cout << "[治理测试] V02 诊断：状态="
            << static_cast<unsigned>(已满足.状态)
            << "，载荷=" << static_cast<bool>(已满足.裁决)
            << "，G=" << 当前代次;
        const L2结构请求头 诊断头{L2结构合同版本, 当前代次};
        const auto 诊断需求 = 需求服务.读取需求完整({诊断头,
            L2读取类别::当前, 已满足请求.需求, 0});
        const auto 诊断成员 = 需求服务.读取需求成员列表({诊断头,
            L2读取类别::当前, 已满足请求.需求, 0});
        const auto 诊断列表项身份 = 诊断成员.当前成员关系
            ? 诊断成员.当前成员关系->列表项 : L2需求列表项身份{};
        const auto 诊断列表项读取 = 需求服务.读取需求列表项完整({诊断头,
            L2读取类别::当前, 诊断列表项身份, 0});
        const auto 诊断特征 = 特征服务.按存在读取全部当前特征(
            {诊断头, 目标宿主});
        const auto 诊断合同 = 状态服务.读取完整目标状态合同({诊断头,
            L2读取类别::当前, 相等合同.身份, 0});
        const auto 诊断注册 = 特征服务.读取当前特征比较注册({诊断头,
            目标特征, L2特征比较用途::目标判断});
        L2特征比较请求 诊断比较请求;
        诊断比较请求.请求头 = 诊断头;
        诊断比较请求.请求身份 = 已满足请求.裁决请求身份;
        诊断比较请求.特征定义 = 目标特征;
        诊断比较请求.用途 = L2特征比较用途::目标判断;
        诊断比较请求.预期算法族 = 比较注册.合同.算法族;
        诊断比较请求.预期算法版本 = 比较注册.合同.算法版本;
        诊断比较请求.左 = {当前值写入.当前值->值稳定编码,
            当前值写入.当前值->类型化不可变材料,
            当前值写入.当前值->来源稳定编码,
            当前值写入.当前值->生命周期.创建事实代次,
            当前值写入.当前值->生命周期,
            L2特征比较原始类型::I64, 比较注册.合同.单位,
            比较注册.合同.维度, 比较注册.合同.分量角色,
            L2特征比较角色::当前事实};
        诊断比较请求.右 = {相等合同.目标值稳定编码,
            L2原始值材料{相等合同.目标I64}, 相等合同.来源稳定编码,
            相等合同.生命周期.创建事实代次, 相等合同.生命周期,
            L2特征比较原始类型::I64, 比较注册.合同.单位,
            比较注册.合同.维度, 比较注册.合同.分量角色,
            L2特征比较角色::目标状态};
        诊断比较请求.要求结果位 =
            static_cast<std::uint8_t>(L2特征比较结果要求::具名关系);
        const auto 诊断比较 = 特征服务.比较特征(诊断比较请求);
        std::cout << "，需求/成员/列表项/特征/合同/注册状态="
            << static_cast<unsigned>(诊断需求.结果头.状态) << "/"
            << static_cast<unsigned>(诊断成员.结果头.状态) << "/"
            << static_cast<unsigned>(诊断列表项读取.结果头.状态) << "/"
            << static_cast<unsigned>(诊断特征.结果头.状态) << "/"
            << static_cast<unsigned>(诊断合同.结果头.状态) << "/"
            << static_cast<unsigned>(诊断注册.结果头.状态)
            << "，截止=" << 诊断需求.结果头.事实截止代次 << "/"
            << 诊断成员.结果头.事实截止代次 << "/"
            << 诊断列表项读取.结果头.事实截止代次 << "/"
            << 诊断特征.结果头.事实截止代次 << "/"
            << 诊断合同.结果头.事实截止代次 << "/"
            << 诊断注册.结果头.事实截止代次
            << "，左右完整="
            << L2特征比较输入材料完整(诊断比较请求.左, 当前代次) << "/"
            << L2特征比较输入材料完整(诊断比较请求.右, 当前代次)
            << "，比较状态/原因/截止="
            << static_cast<unsigned>(诊断比较.状态) << "/"
            << static_cast<unsigned>(诊断比较.拒绝原因) << "/"
            << 诊断比较.事实截止代次;
        if (诊断需求.需求 && 诊断列表项读取.列表项
            && 诊断成员.当前成员关系 && 诊断合同.合同
            && 诊断注册.注册 && !诊断特征.特征实例组.empty()) {
            const auto& 诊断需求事实 = *诊断需求.需求;
            const auto& 诊断列表项 = *诊断列表项读取.列表项;
            const auto& 诊断实例 = 诊断特征.特征实例组.front();
            std::cout << "，引用等价="
                << (诊断成员.当前成员关系->需求 == 已满足请求.需求)
                << (诊断成员.当前成员关系->列表项 == 诊断列表项.身份)
                << (诊断需求事实.所属存在 == 诊断列表项.所属存在)
                << (诊断需求事实.目标宿主存在 == 诊断列表项.目标宿主存在)
                << (诊断需求事实.目标特征定义 == 诊断列表项.目标特征定义)
                << (诊断需求事实.目标状态合同 == 诊断列表项.目标状态合同)
                << (诊断实例.当前值
                    && 诊断实例.当前值->特征实例 == 诊断实例.身份)
                << (诊断合同.合同->身份 == 诊断需求事实.目标状态合同)
                << (诊断合同.合同->比较注册 == 诊断注册.注册->身份)
                << (诊断注册.注册->特征定义 == 诊断需求事实.目标特征定义);
        }
        std::cout << "\n";
        return 失败("V02 相等目标已满足完整快照");
    }
    const auto 未满足请求 = 形成请求(0x7FB1,
        未满足需求写入.新建需求->身份);
    const auto 未满足 = 组合器.裁决需求当前满足(未满足请求);
    if (未满足.状态 != 需求当前满足裁决状态::未满足
        || !未满足.成功() || !未满足.裁决
        || 未满足.裁决->具名关系
            != L2特征比较具名关系::当前低于目标
        || 未满足.裁决->允许关系位 != 0x02)
        return 失败("V03 当前值低于且不在允许位");
    const auto 允许低于 = 组合器.裁决需求当前满足(形成请求(
        0x7FB2, 允许低于需求写入.新建需求->身份));
    if (允许低于.状态 != 需求当前满足裁决状态::已满足
        || !允许低于.裁决
        || 允许低于.裁决->具名关系
            != L2特征比较具名关系::当前低于目标
        || 允许低于.裁决->允许关系位 != 0x01)
        return 失败("V04 允许非相等关系已满足");
    const auto 不存在需求 = 组合器.裁决需求当前满足(形成请求(
        0x7FB3, L2需求身份{稳定编码{0x7FFF'0001}}));
    if (不存在需求.状态 != 需求当前满足裁决状态::证据不足
        || 不存在需求.裁决)
        return 失败("V05 当前需求不存在");
    const auto 无实例 = 组合器.裁决需求当前满足(形成请求(
        0x7FB4, 无实例需求写入.新建需求->身份));
    if (无实例.状态 != 需求当前满足裁决状态::证据不足 || 无实例.裁决)
        return 失败("V08 目标宿主没有匹配实例");
    const auto 向量不可比较 = 组合器.裁决需求当前满足(形成请求(
        0x7FB5, 向量需求写入.新建需求->身份));
    if (向量不可比较.状态 != 需求当前满足裁决状态::不可比较
        || 向量不可比较.裁决)
        return 失败("V12 非 I64 当前值不可比较");
    const auto 无任务裁决 = 组合器.裁决需求当前满足(未满足请求);
    if (无任务裁决 != 未满足)
        return 失败("V15/V16 重复只读且无当前任务仍可裁决");
    const auto 第二成员裁决 = 组合器.裁决需求当前满足(形成请求(
        0x7FB6, 第二成员写入.新建需求->身份));
    if (第二成员裁决.状态 != 需求当前满足裁决状态::未满足
        || !第二成员裁决.裁决
        || 第二成员裁决.裁决->需求事实.身份
            != 第二成员写入.新建需求->身份
        || 第二成员裁决.裁决->当前成员关系
            != *第二成员写入.当前成员关系
        || 第二成员裁决.裁决->所属列表项.身份
            != 未满足需求写入.新建列表项->身份)
        return 失败("V17 同列表多成员独立保留需求身份");
    const auto 裁决后代次 = 存在服务.读取当前事实代次();
    if (裁决后代次.状态 != L2结构状态::已读取
        || 裁决后代次.事实截止代次 != 裁决前代次.事实截止代次)
        return 失败("V19 只读裁决改变事实代次");

    const auto 退出基础合同 = 状态服务.退出目标状态合同({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FB7},
        基础合同.身份, 基础合同.特征定义关系稳定编码,
        基础合同.比较注册关系稳定编码, 基础合同.目标值稳定编码,
        基础合同.合同值稳定编码});
    if (退出基础合同.成功()
        || 退出基础合同.结果头.状态 != L2结构状态::引用冲突)
        return 失败("V10 当前需求引用合同却被合法退出");
    const auto 漂移证据写入 = 存在服务.新增角色化存在({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FB70},
        L2存在单例角色键{0x7FB70}});
    if (!漂移证据写入.成功()) return 失败("V13 建立代次漂移证据");
    当前代次 = 漂移证据写入.结果头.事实截止代次;
    const auto 旧截止 = 组合器.裁决需求当前满足(未满足请求);
    if (旧截止.状态 != 需求当前满足裁决状态::当前性漂移
        || 旧截止.裁决)
        return 失败("V13 旧 G0 当前性漂移");

    const auto 退出注册 = 特征服务.退出特征比较注册({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FB9},
        比较注册.身份, 比较注册.归属关系稳定编码,
        比较注册.U64合同值稳定编码, 比较注册.I64合同值稳定编码});
    if (退出注册.成功()
        || 退出注册.结果头.状态 != L2结构状态::引用冲突)
        return 失败("V11 当前合同引用注册却被合法退出");

    const auto 重复实例写入 = 特征服务.新增特征实例({
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7FBB},
        目标宿主, 目标特征});
    if (重复实例写入.结果头.状态 != L2结构状态::已提交
        || !重复实例写入.特征实例)
        return 失败("V09 建立第二当前实例证据");
    当前代次 = 重复实例写入.结果头.事实截止代次;
    const auto 多实例 = 组合器.裁决需求当前满足(形成请求(
        0x7FBC, 已满足需求写入.新建需求->身份));
    if (多实例.状态 != 需求当前满足裁决状态::内部错误 || 多实例.裁决)
        return 失败("V09 多匹配实例未拒绝任选");

    std::cout << "[治理测试] 需求当前满足实时裁决 "
                 "V01-V05、V08-V09、V12-V13、V15-V17、V19 动态通过；"
                 "V06-V07、V10-V11、V12A、V14、V18 按公开 API 不可合法注入和源码守恒 NOT_RUN；"
                 "V20 由既有任务目标达成回归矩阵继续覆盖\n";
    return true;
}


} // namespace

} // namespace 海中鱼巣

namespace 海中鱼巣::任务特征方法查找专项 {

enum class 九结论验证状态 : std::uint8_t {
    通过 = 0,
    必需载荷不守恒 = 1,
    禁止载荷未拒绝 = 2
};

struct 九结论验证夹具 final {
    std::uint64_t 共同事实截止 = 0;
    下一筹办工作包 工作包;
    任务筹办目标三元组 任务目标;
    L2状态事实 当前实际状态;
    L2概念身份 对象概念;
    L2方法特征粗召回项 粗召回项;
    任务方法适用候选 适用项;
    任务方法适用候选 第二适用项;
    任务方法不兼容证据 不兼容证据;
    任务方法结构缺口项 结构缺口;
    任务缺失条件草案 缺失条件草案;
    任务未绑定输入限制证据 未绑定证据;
};

九结论验证状态 验证九结论载荷守恒(
    const 九结论验证夹具& 夹具) {
    const auto 形成共同结果 = [&] {
        任务特征方法查找结果 结果;
        结果.状态 = 任务特征方法查找状态::已评估;
        结果.共同事实截止 = 夹具.共同事实截止;
        结果.已互证工作包 = 夹具.工作包;
        结果.任务目标 = 夹具.任务目标;
        return 结果;
    };
    const auto 形成已比较结果 = [&] {
        auto 结果 = 形成共同结果();
        结果.当前实际状态 = 夹具.当前实际状态;
        结果.目标比较具名关系 = L2特征比较具名关系::当前低于目标;
        结果.允许关系位 = 0x02;
        return 结果;
    };
    const auto 形成方法侧结果 = [&] {
        auto 结果 = 形成已比较结果();
        结果.所需方向 = L2方法变化方向::正方向;
        结果.当前对象概念 = {夹具.对象概念};
        结果.对象概念祖先闭包 = {{夹具.对象概念, 夹具.对象概念}};
        return 结果;
    };

    auto 方向不唯一结果 = 形成共同结果();
    方向不唯一结果.结论 = 任务特征方法查找结论::所需方向不唯一;
    方向不唯一结果.当前实际状态 = 夹具.当前实际状态;
    方向不唯一结果.目标比较具名关系 = L2特征比较具名关系::当前达到目标;
    方向不唯一结果.允许关系位 = 0x05;
    auto 对象概念待形成结果 = 形成已比较结果();
    对象概念待形成结果.结论 = 任务特征方法查找结论::对象概念待形成;
    对象概念待形成结果.所需方向 = L2方法变化方向::正方向;
    auto 方法能力缺失结果 = 形成方法侧结果();
    方法能力缺失结果.结论 = 任务特征方法查找结论::方法能力缺失;
    方法能力缺失结果.完整粗召回 = std::vector<L2方法特征粗召回项>{};
    auto 当前无适用结果 = 形成方法侧结果();
    当前无适用结果.结论 = 任务特征方法查找结论::当前无适用方法;
    当前无适用结果.完整粗召回 = std::vector{夹具.粗召回项};
    当前无适用结果.不兼容证据 = {夹具.不兼容证据};
    auto 方法结构待补齐结果 = 形成方法侧结果();
    方法结构待补齐结果.结论 = 任务特征方法查找结论::方法结构待补齐;
    方法结构待补齐结果.完整粗召回 = std::vector{夹具.粗召回项};
    方法结构待补齐结果.结构缺口 = {夹具.结构缺口};
    auto 多候选结果 = 形成方法侧结果();
    多候选结果.结论 = 任务特征方法查找结论::多候选待选择证据;
    多候选结果.完整粗召回 = std::vector{夹具.粗召回项};
    多候选结果.适用候选 = {夹具.适用项, 夹具.第二适用项};
    auto 无条件提议结果 = 形成方法侧结果();
    无条件提议结果.结论 = 任务特征方法查找结论::已采用且无需条件提议;
    无条件提议结果.完整粗召回 = std::vector{夹具.粗召回项};
    无条件提议结果.适用候选 = {夹具.适用项};
    无条件提议结果.采用方案 = 夹具.适用项;
    auto 有缺失条件结果 = 无条件提议结果;
    有缺失条件结果.结论 = 任务特征方法查找结论::已采用且存在缺失条件;
    有缺失条件结果.缺失条件草案 = {夹具.缺失条件草案};
    auto 输入限制待绑定结果 = 无条件提议结果;
    输入限制待绑定结果.结论 =
        任务特征方法查找结论::已采用且输入限制待绑定;
    输入限制待绑定结果.未绑定输入限制 = {夹具.未绑定证据};

    const std::vector<const 任务特征方法查找结果*> 九结论{
        &方法能力缺失结果, &当前无适用结果,
        &对象概念待形成结果, &方向不唯一结果, &方法结构待补齐结果,
        &多候选结果, &无条件提议结果, &有缺失条件结果,
        &输入限制待绑定结果};
    if (std::any_of(九结论.begin(), 九结论.end(),
            [](const auto* 结果) { return !结果->成功(); })) {
        return 九结论验证状态::必需载荷不守恒;
    }
    auto 禁止载荷污染 = 方向不唯一结果;
    禁止载荷污染.完整粗召回 = std::vector{夹具.粗召回项};
    auto 非成功污染 = 任务特征方法查找结果{};
    非成功污染.共同事实截止 = 夹具.共同事实截止;
    if (禁止载荷污染.成功() || 非成功污染.成功()) {
        return 九结论验证状态::禁止载荷未拒绝;
    }
    return 九结论验证状态::通过;
}

} // namespace 海中鱼巣::任务特征方法查找专项

export namespace 海中鱼巣 {

// 端到端测试：自我治理一致事实 headless 场景。
// 验证 BIZ-L3-002-02-02 生存安全快照真实读取路径。
// 流程：
//   1. 建立 L1 事实基座运行包
//   2. 建立六个 L2 服务（存在/特征/状态/需求/场景/任务）
//   3. 新增角色化存在（自我）
//   4. 新增安全根特征定义 + 特征实例 + 特征值（I64{A=2, L=5, H=10}）
//   5. 新增服务值特征定义 + 特征实例 + 特征值（I64{100}）
//   6. 读取当前事实代次作为 G0
//   7. 装配运行期只读查询组合器
//   8. 调用 读取自我治理一致事实()
//   9. 验证：状态 == 已形成，生存安全快照有效
//
// 返回 0 表示全部通过；非 0 表示失败。
} // namespace 海中鱼巣

namespace 海中鱼巣::任务治理状态专项 {

L2任务目标裁决结构材料 映射目标裁决材料(
    const 任务目标达成裁决快照& 快照,
    L2任务目标达成状态 达成状态) {
    L2任务目标裁决结构材料 材料;
    材料.治理输入幂等键 = 快照.治理输入幂等键;
    材料.任务 = 快照.任务;
    材料.实例方法 = 快照.实例方法;
    材料.执行轮次 = 快照.执行轮次;
    材料.任务实际结果 = 快照.任务实际结果;
    材料.任务目标来源 = 快照.任务目标来源;
    材料.目标宿主 = 快照.目标宿主;
    材料.目标特征 = 快照.目标特征;
    材料.目标状态合同 = 快照.目标状态合同;
    材料.实际状态 = 快照.实际状态;
    材料.动态证据 = 快照.动态证据;
    材料.方法 = 快照.方法;
    材料.路径预期结果 = 快照.路径预期结果;
    材料.路径验证合同 = 快照.路径验证合同;
    材料.比较注册 = 快照.比较注册;
    材料.比较算法版本 = 快照.比较算法版本;
    材料.具名关系 = 快照.具名关系;
    材料.允许关系位 = 快照.允许关系位;
    材料.目标达成状态 = 达成状态;
    材料.后继准备 = 快照.生命周期准备 ==
            任务生命周期后继准备::待验证后完成
        ? L2任务目标裁决后继准备::待验证后完成
        : L2任务目标裁决后继准备::目标未达成待重筹办;
    材料.来源共同事实截止 = 快照.事实截止代次;
    return 材料;
}

bool 目标裁决材料逐字段一致(
    const L2任务目标裁决结构材料& 左,
    const L2任务目标裁决结构材料& 右) {
    return 左.治理输入幂等键 == 右.治理输入幂等键
        && 左.任务 == 右.任务
        && 左.实例方法 == 右.实例方法
        && 左.执行轮次 == 右.执行轮次
        && 左.任务实际结果 == 右.任务实际结果
        && 左.任务目标来源 == 右.任务目标来源
        && 左.目标宿主 == 右.目标宿主
        && 左.目标特征 == 右.目标特征
        && 左.目标状态合同 == 右.目标状态合同
        && 左.实际状态 == 右.实际状态
        && 左.动态证据 == 右.动态证据
        && 左.方法 == 右.方法
        && 左.路径预期结果 == 右.路径预期结果
        && 左.路径验证合同 == 右.路径验证合同
        && 左.比较注册 == 右.比较注册
        && 左.比较算法版本 == 右.比较算法版本
        && 左.具名关系 == 右.具名关系
        && 左.允许关系位 == 右.允许关系位
        && 左.目标达成状态 == 右.目标达成状态
        && 左.后继准备 == 右.后继准备
        && 左.来源共同事实截止 == 右.来源共同事实截止;
}

struct 未达成首态专项上下文 final {
    L2任务治理状态事实 状态;
    L2任务目标裁决证据事实 证据;
    std::uint64_t Gs = 0;
};

bool 验证目标未达成首态重复与冲突(
    L2任务结构服务* 任务服务,
    const L2新增执行结果待验证状态请求& 未达成首态请求,
    const L2新增执行结果待验证状态结果& 未达成首态,
    std::uint64_t 未达成Gs) {
    const auto 未达成首态重复 = 任务服务->新增执行结果待验证状态(
        未达成首态请求);
    auto 未达成首态异义请求 = 未达成首态请求;
    ++未达成首态异义请求.生命周期发生时间;
    const auto 未达成首态异义 = 任务服务->新增执行结果待验证状态(
        未达成首态异义请求);
    auto 已有当前状态请求 = 未达成首态请求;
    已有当前状态请求.请求头.期望事实代次 = 未达成Gs;
    已有当前状态请求.幂等身份 = L2结构幂等身份{0x7B0D};
    已有当前状态请求.目标裁决.来源共同事实截止 = 未达成Gs;
    const auto 已有当前状态拒绝 = 任务服务->新增执行结果待验证状态(
        已有当前状态请求);
    if (!未达成首态重复.成功()
        || 未达成首态重复.结果头.状态 != L2结构状态::精确重复
        || 未达成首态重复.结果头.事实截止代次 != 未达成Gs
        || 未达成首态异义.结果头.状态 != L2结构状态::幂等冲突
        || 已有当前状态拒绝.结果头.状态 != L2结构状态::引用冲突) {
        std::cout << "[治理测试] 失败：M01 首态重复、异义或已有当前状态分账错误\n";
        return false;
    }
    return true;
}


bool 验证目标未达成首态(
    L2任务结构服务* 任务服务,
    const 任务目标达成裁决结果& 未达成裁决,
    const L2新增任务结果& 未达成任务新增,
    const L2新增任务方法路径结果& 未达成路径新增,
    const L2创建实例方法结果& 未达成实例新增,
    const L2记录任务实际结果结果& 未达成结果新增,
    std::uint64_t 未达成G0,
    未达成首态专项上下文& 输出) {
    L2新增执行结果待验证状态请求 未达成首态请求;
    未达成首态请求.请求头 = {L2结构合同版本, 未达成G0};
    未达成首态请求.幂等身份 = L2结构幂等身份{0x7B0C};
    未达成首态请求.任务 = 未达成任务新增.任务->身份;
    未达成首态请求.任务虚拟存在 =
        未达成任务新增.任务->任务虚拟存在;
    未达成首态请求.生命周期发生时间 = 500;
    未达成首态请求.来源方法路径 = 未达成路径新增.路径->身份;
    未达成首态请求.来源实例方法 = 未达成实例新增.实例方法->身份;
    未达成首态请求.来源任务实际结果 = 未达成结果新增.实际结果->身份;
    未达成首态请求.目标裁决 = 映射目标裁决材料(
        *未达成裁决.裁决, L2任务目标达成状态::未达成);
    const auto 未达成首态 = 任务服务->新增执行结果待验证状态(
        未达成首态请求);
    if (!未达成首态.成功() || !未达成首态.已登记状态
        || !未达成首态.目标裁决证据
        || 未达成首态.结果头.状态 != L2结构状态::已提交
        || 未达成首态.已登记状态->生命周期版本 != 1
        || 未达成首态.已登记状态->业务状态段 !=
            L2任务业务状态段::执行结果待验证
        || 未达成首态.已登记状态->来源共同事实截止 != 未达成G0
        || !目标裁决材料逐字段一致(
            未达成首态.目标裁决证据->材料,
            未达成首态请求.目标裁决)) {
        std::cout << "[治理测试] 失败：M00 未达成首态与正式裁决证据未闭合\n";
        return false;
    }
    const auto 未达成Gs = 未达成首态.结果头.事实截止代次;
    if (!验证目标未达成首态重复与冲突(
        任务服务, 未达成首态请求, 未达成首态, 未达成Gs))
        return false;
    输出 = {*未达成首态.已登记状态,
        *未达成首态.目标裁决证据, 未达成Gs};
    return true;
}

bool 验证目标未达成迁移错误零写(
    L2任务结构服务* 任务服务,
    const L2提交目标未达成待重筹办迁移请求& 合法请求,
    std::uint64_t 未达成Gs) {
    auto 错前态请求 = 合法请求;
    错前态请求.幂等身份 = L2结构幂等身份{0x7B0F};
    错前态请求.前一治理状态.值.值 =
        (std::numeric_limits<std::uint64_t>::max)();
    const auto 错前态 = 任务服务->提交目标未达成待重筹办迁移(错前态请求);
    auto 错裁决请求 = 合法请求;
    错裁决请求.幂等身份 = L2结构幂等身份{0x7B10};
    错裁决请求.目标裁决证据.值.值 =
        (std::numeric_limits<std::uint64_t>::max)();
    const auto 错裁决 = 任务服务->提交目标未达成待重筹办迁移(错裁决请求);
    auto 错时间请求 = 合法请求;
    错时间请求.幂等身份 = L2结构幂等身份{0x7B11};
    --错时间请求.生命周期发生时间;
    const auto 错时间 = 任务服务->提交目标未达成待重筹办迁移(错时间请求);
    const auto 当前状态 = 任务服务->读取任务当前治理状态(
        {{L2结构合同版本, 未达成Gs}, 合法请求.任务});
    if (错前态.结果头.状态 != L2结构状态::未找到
        || 错裁决.结果头.状态 != L2结构状态::引用冲突
        || 错时间.结果头.状态 != L2结构状态::引用冲突
        || !当前状态.成功() || !当前状态.当前状态
        || 当前状态.当前状态->身份 != 合法请求.前一治理状态) {
        std::cout << "[治理测试] 失败：M04 端点或字段冲突未保持零写\n";
        return false;
    }
    return true;
}

std::optional<std::uint64_t> 验证目标未达成迁移(
    L2任务结构服务* 任务服务,
    const 未达成首态专项上下文& 上下文,
    const L2新增任务结果& 未达成任务新增,
    std::uint64_t 未达成G0) {
    const auto 未达成Gs = 上下文.Gs;
    L2提交目标未达成待重筹办迁移请求 未达成迁移请求;
    未达成迁移请求.请求头 = {L2结构合同版本, 未达成Gs};
    未达成迁移请求.幂等身份 = L2结构幂等身份{0x7B0E};
    未达成迁移请求.任务 = 上下文.状态.任务;
    未达成迁移请求.任务虚拟存在 =
        上下文.状态.任务虚拟存在;
    未达成迁移请求.生命周期发生时间 = 501;
    未达成迁移请求.前一治理状态 = 上下文.状态.身份;
    未达成迁移请求.目标裁决证据 = 上下文.证据.身份;
    未达成迁移请求.旧当前路径 = 上下文.状态.来源方法路径;
    未达成迁移请求.旧当前实例 = 上下文.状态.来源实例方法;
    if (!验证目标未达成迁移错误零写(
        任务服务, 未达成迁移请求, 未达成Gs)) return std::nullopt;
    const auto 未达成迁移 = 任务服务->提交目标未达成待重筹办迁移(
        未达成迁移请求);
    if (!未达成迁移.成功() || !未达成迁移.目标状态
        || !未达成迁移.前驱状态 || !未达成迁移.目标裁决证据
        || 未达成迁移.目标状态->业务状态段 !=
            L2任务业务状态段::目标未达成待重筹办
        || 未达成迁移.目标状态->生命周期版本 != 2
        || 未达成迁移.目标状态->前一治理状态 !=
            上下文.状态.身份
        || 未达成迁移.目标裁决证据->身份 !=
            上下文.证据.身份
        || 未达成迁移.目标裁决证据->材料.来源共同事实截止 != 未达成G0) {
        std::cout << "[治理测试] 失败：M02 合法未达成迁移未闭合\n";
        return std::nullopt;
    }
    const auto 未达成Gr = 未达成迁移.结果头.事实截止代次;
    const auto 未达成迁移重复 = 任务服务->提交目标未达成待重筹办迁移(
        未达成迁移请求);
    auto 未达成迁移异义请求 = 未达成迁移请求;
    ++未达成迁移异义请求.生命周期发生时间;
    const auto 未达成迁移异义 = 任务服务->提交目标未达成待重筹办迁移(
        未达成迁移异义请求);
    if (!未达成迁移重复.成功()
        || 未达成迁移重复.结果头.状态 != L2结构状态::精确重复
        || 未达成迁移重复.结果头.事实截止代次 != 未达成Gr
        || 未达成迁移异义.结果头.状态 != L2结构状态::幂等冲突) {
        std::cout << "[治理测试] 失败：M03/M04 迁移重复或异义分账错误\n";
        return std::nullopt;
    }
    const auto 当前治理状态 = 任务服务->读取任务当前治理状态(
        {{L2结构合同版本, 未达成Gr}, 未达成任务新增.任务->身份});
    const auto 首态历史 = 任务服务->读取任务治理状态(
        {{L2结构合同版本, 未达成Gr}, L2读取类别::历史,
            上下文.状态.身份, 未达成Gs});
    const auto 路径读回 = 任务服务->读取任务方法路径(
        {{L2结构合同版本, 未达成Gr}, L2读取类别::当前,
            上下文.状态.来源方法路径, 0});
    const auto 实例读回 = 任务服务->读取实例方法(
        {{L2结构合同版本, 未达成Gr}, L2读取类别::当前,
            上下文.状态.来源实例方法, 0});
    const auto 结果读回 = 任务服务->按任务与执行轮次读取实际结果(
        {{L2结构合同版本, 未达成Gr}, L2读取类别::当前,
            上下文.状态.任务, 上下文.状态.来源执行轮次, 0});
    if (!当前治理状态.成功() || !当前治理状态.当前状态
        || 当前治理状态.当前状态->身份 != 未达成迁移.目标状态->身份
        || !首态历史.成功() || !首态历史.状态
        || 首态历史.状态->身份 != 上下文.状态.身份
        || !首态历史.目标裁决证据
        || 首态历史.目标裁决证据->材料.来源共同事实截止 != 未达成G0
        || !路径读回.成功() || !路径读回.路径
        || 路径读回.路径->身份 != 上下文.状态.来源方法路径
        || !实例读回.成功() || !实例读回.实例方法
        || 实例读回.实例方法->身份 != 上下文.状态.来源实例方法
        || !结果读回.成功() || !结果读回.实际结果
        || 结果读回.实际结果->身份 != 上下文.状态.来源任务实际结果) {
        std::cout << "[治理测试] 失败：M05/M06 截止分账或历史读回错误\n";
        return std::nullopt;
    }

    return 未达成Gr;
}

std::optional<std::uint64_t> 验证目标未达成首态与迁移(
    L2任务结构服务* 任务服务,
    const 任务目标达成裁决结果& 未达成裁决,
    const L2新增任务结果& 未达成任务新增,
    const L2新增任务方法路径结果& 未达成路径新增,
    const L2创建实例方法结果& 未达成实例新增,
    const L2记录任务实际结果结果& 未达成结果新增,
    std::uint64_t 未达成G0) {
    未达成首态专项上下文 首态;
    if (!验证目标未达成首态(任务服务, 未达成裁决,
        未达成任务新增, 未达成路径新增, 未达成实例新增,
        未达成结果新增, 未达成G0, 首态)) return std::nullopt;
    return 验证目标未达成迁移(任务服务, 首态, 未达成任务新增, 未达成G0);
}


std::optional<std::uint64_t> 验证已达成分支停在待验证首态(
    L2任务结构服务* 任务服务,
    运行期只读查询组合器& 需求组合器,
    std::uint64_t 写前代次,
    const L2记录任务实际结果请求& 记录请求,
    const L2记录任务实际结果结果& 记录结果,
    const L2新增任务结果& 任务新增,
    const L2新增任务方法路径结果& 路径新增,
    const L2创建实例方法结果& 实例新增) {
    // 已达成分支只允许形成待验证首态；本叶不执行路径验证或任务完成。
    const 任务目标达成裁决请求 已达成重读请求{
        运行期只读查询合同版本, 0x7B20, 记录请求.任务,
        记录请求.实例方法, 记录请求.执行轮次,
        记录结果.实际结果->身份, 写前代次};
    const auto 已达成重读 = 需求组合器.裁决任务目标达成(已达成重读请求);
    if (已达成重读.状态 != 任务目标达成裁决状态::目标已达成
        || !已达成重读.裁决)
        return std::nullopt;
    L2新增执行结果待验证状态请求 已达成首态请求;
    已达成首态请求.请求头 = {L2结构合同版本, 写前代次};
    已达成首态请求.幂等身份 = L2结构幂等身份{0x7B21};
    已达成首态请求.任务 = 任务新增.任务->身份;
    已达成首态请求.任务虚拟存在 = 任务新增.任务->任务虚拟存在;
    已达成首态请求.生命周期发生时间 = 600;
    已达成首态请求.来源方法路径 = 路径新增.路径->身份;
    已达成首态请求.来源实例方法 = 实例新增.实例方法->身份;
    已达成首态请求.来源任务实际结果 = 记录结果.实际结果->身份;
    已达成首态请求.目标裁决 = 映射目标裁决材料(
        *已达成重读.裁决, L2任务目标达成状态::已达成);
    const auto 已达成首态 = 任务服务->新增执行结果待验证状态(已达成首态请求);
    if (!已达成首态.成功() || !已达成首态.已登记状态
        || 已达成首态.已登记状态->业务状态段 !=
            L2任务业务状态段::执行结果待验证
        || 已达成首态.已登记状态->目标达成状态 !=
            L2任务目标达成状态::已达成) {
        std::cout << "[治理测试] 失败：M07 已达成分支未停在待验证首态\n";
        return std::nullopt;
    }
    L2提交目标未达成待重筹办迁移请求 错分支迁移请求{
        {L2结构合同版本, 已达成首态.结果头.事实截止代次},
        L2结构幂等身份{0x7B22}, 任务新增.任务->身份,
        任务新增.任务->任务虚拟存在, 601,
        已达成首态.已登记状态->身份, 已达成首态.目标裁决证据->身份,
        路径新增.路径->身份, 实例新增.实例方法->身份};
    const auto 错分支迁移 = 任务服务->提交目标未达成待重筹办迁移(
        错分支迁移请求);
    if (错分支迁移.结果头.状态 != L2结构状态::引用冲突) {
        std::cout << "[治理测试] 失败：M07 已达成分支错误进入未达成迁移\n";
        return std::nullopt;
    }
    std::cout << "[治理测试] 任务裁决证据与目标未达成迁移 M00-M07 通过\n";
    return 已达成首态.结果头.事实截止代次;
}

std::optional<std::uint64_t> 验证任务裁决证据与目标未达成迁移(
    L2任务结构服务* 任务服务,
    运行期只读查询组合器& 需求组合器,
    const 任务目标达成裁决结果& 未达成裁决,
    const L2新增任务结果& 未达成任务新增,
    const L2新增任务方法路径结果& 未达成路径新增,
    const L2创建实例方法结果& 未达成实例新增,
    const L2记录任务实际结果结果& 未达成结果新增,
    std::uint64_t 未达成G0,
    const L2记录任务实际结果请求& 记录请求,
    const L2记录任务实际结果结果& 记录结果,
    const L2新增任务结果& 任务新增,
    const L2新增任务方法路径结果& 路径新增,
    const L2创建实例方法结果& 实例新增) {
    const auto 未达成Gr = 验证目标未达成首态与迁移(
        任务服务, 未达成裁决, 未达成任务新增, 未达成路径新增,
        未达成实例新增, 未达成结果新增, 未达成G0);
    if (!未达成Gr) return std::nullopt;
    return 验证已达成分支停在待验证首态(任务服务, 需求组合器,
        *未达成Gr, 记录请求, 记录结果, 任务新增, 路径新增, 实例新增);
}

} // namespace 海中鱼巣::任务治理状态专项

export namespace 海中鱼巣 {

int 运行自我治理一致事实端到端测试() noexcept {
    if (!验证需求当前满足实时裁决()) {
        return 1;
    }
    if (!验证需求消费任务子目标承接记录闭环()) {
        return 1;
    }
    if (!验证任务子目标承接记录普通应用闭环()) {
        return 1;
    }
    if (!验证运行期提供者闭环()) {
        return 1;
    }
    // ===== 1. 建立 L1 事实基座运行包 =====
    auto 运行包 = 建立L1事实基座运行包();
    std::cout << "[治理测试] L1 事实基座运行包已建立\n";

    const auto 材料配置 = 形成普通应用生产配置();
    if (!材料配置.成功()) {
        std::cout << "[治理测试] 失败：不可变材料测试配置形成失败\n";
        return 1;
    }
    auto 材料原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 不可变材料所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((材料原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 材料原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !材料原始交付.建立结果.所有者事实
        || !材料原始交付.写入端口) {
        std::cout << "[治理测试] 失败：不可变材料所有者范围建立失败\n";
        return 1;
    }
    不可变材料服务构造输入 材料输入;
    材料输入.存储配置 = 材料配置.配置->不可变材料存储;
    材料输入.所有者交付 = std::move(材料原始交付);
    auto 材料构造 = 构造不可变材料服务(
        运行包.读取服务(), std::move(材料输入));
    if (!材料构造.成功()) {
        std::cout << "[治理测试] 失败：不可变材料服务构造失败\n";
        return 1;
    }
    auto 材料服务 = std::move(材料构造.服务);
    std::cout << "[治理测试] 不可变材料服务已建立\n";

    // ===== 2. 建立 L2 存在结构服务 =====
    auto 存在原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 存在所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((存在原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 存在原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !存在原始交付.建立结果.所有者事实
        || !存在原始交付.写入端口) {
        std::cout << "[治理测试] 失败：存在所有者范围建立失败\n";
        return 1;
    }
    auto 存在所有者交付 = 尝试形成L2存在所有者交付(
        运行包.读取服务(), std::move(存在原始交付));
    if (!存在所有者交付) {
        std::cout << "[治理测试] 失败：存在所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2存在结构服务> 存在服务;
    try {
        存在服务 = std::make_unique<L2存在结构服务>(
            运行包.读取服务(), std::move(*存在所有者交付));
    } catch (...) {
        std::cout << "[治理测试] 失败：存在服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 存在结构服务已建立\n";

    // ===== 3. 建立 L2 特征结构服务 =====
    auto 定义原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 特征定义所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((定义原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 定义原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !定义原始交付.建立结果.所有者事实
        || !定义原始交付.写入端口) {
        std::cout << "[治理测试] 失败：特征定义所有者范围建立失败\n";
        return 1;
    }
    auto 定义交付 = 尝试形成L2特征定义所有者交付(
        运行包.读取服务(), std::move(定义原始交付));
    if (!定义交付) {
        std::cout << "[治理测试] 失败：特征定义所有者交付形成失败\n";
        return 1;
    }
    auto 实例原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 特征实例所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((实例原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 实例原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !实例原始交付.建立结果.所有者事实
        || !实例原始交付.写入端口) {
        std::cout << "[治理测试] 失败：特征实例所有者范围建立失败\n";
        return 1;
    }
    auto 实例交付 = 尝试形成L2特征实例所有者交付(
        运行包.读取服务(), std::move(实例原始交付));
    if (!实例交付) {
        std::cout << "[治理测试] 失败：特征实例所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2特征结构服务> 特征服务;
    try {
        特征服务 = std::make_unique<L2特征结构服务>(
            运行包.读取服务(), *存在服务,
            std::move(*定义交付), std::move(*实例交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：特征服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：特征服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 特征结构服务已建立\n";

    // ===== 4. 建立 L2 状态结构服务 =====
    auto 状态原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 状态所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((状态原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 状态原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !状态原始交付.建立结果.所有者事实
        || !状态原始交付.写入端口) {
        std::cout << "[治理测试] 失败：状态所有者范围建立失败\n";
        return 1;
    }
    auto 状态交付 = 尝试形成L2状态所有者交付(
        运行包.读取服务(), std::move(状态原始交付));
    if (!状态交付) {
        std::cout << "[治理测试] 失败：状态所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2状态结构服务> 状态服务;
    try {
        状态服务 = std::make_unique<L2状态结构服务>(
            运行包.读取服务(), *存在服务, *特征服务,
            std::move(*状态交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：状态服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：状态服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 状态结构服务已建立\n";

    // ===== 4A. 建立 L2 动态结构服务 =====
    auto 动态原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 动态所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((动态原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 动态原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !动态原始交付.建立结果.所有者事实
        || !动态原始交付.写入端口) {
        std::cout << "[治理测试] 失败：动态所有者范围建立失败\n";
        return 1;
    }
    auto 动态交付 = 尝试形成L2动态所有者交付(
        运行包.读取服务(), std::move(动态原始交付));
    if (!动态交付) {
        std::cout << "[治理测试] 失败：动态所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2动态结构服务> 动态服务;
    try {
        动态服务 = std::make_unique<L2动态结构服务>(
            运行包.读取服务(), *存在服务, *状态服务,
            std::move(*动态交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：动态服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：动态服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 动态结构服务已建立\n";

    // 自我线程生产入口要求与当前测试运行包同实例的完整 L2 结构聚合；
    // 因果服务只补齐聚合所有权，不参与本叶任务结果绑定语义。
    auto 因果原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 因果所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((因果原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 因果原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !因果原始交付.建立结果.所有者事实
        || !因果原始交付.写入端口) {
        std::cout << "[治理测试] 失败：因果所有者范围建立失败\n";
        return 1;
    }
    auto 因果交付 = 尝试形成L2因果所有者交付(
        运行包.读取服务(), std::move(因果原始交付));
    if (!因果交付) {
        std::cout << "[治理测试] 失败：因果所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2因果结构服务> 因果服务;
    try {
        因果服务 = std::make_unique<L2因果结构服务>(
            运行包.读取服务(), *状态服务, std::move(*因果交付));
    } catch (...) {
        std::cout << "[治理测试] 失败：因果服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 因果结构服务已建立\n";

    // ===== 5. 建立 L2 需求结构服务 =====
    auto 需求原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 需求所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((需求原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 需求原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !需求原始交付.建立结果.所有者事实
        || !需求原始交付.写入端口) {
        std::cout << "[治理测试] 失败：需求所有者范围建立失败\n";
        return 1;
    }
    auto 需求交付 = 尝试形成L2需求所有者交付(
        运行包.读取服务(), std::move(需求原始交付));
    if (!需求交付) {
        std::cout << "[治理测试] 失败：需求所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2需求结构服务> 需求服务;
    try {
        需求服务 = std::make_unique<L2需求结构服务>(
            运行包.读取服务(), *存在服务, *特征服务,
            *状态服务, std::move(*需求交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：需求服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：需求服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 需求结构服务已建立\n";

    // ===== 6. 建立 L2 场景结构服务 =====
    auto 场景原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 场景所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((场景原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 场景原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !场景原始交付.建立结果.所有者事实
        || !场景原始交付.写入端口) {
        std::cout << "[治理测试] 失败：场景所有者范围建立失败\n";
        return 1;
    }
    auto 场景交付 = 尝试形成L2场景所有者交付(
        运行包.读取服务(), std::move(场景原始交付));
    if (!场景交付) {
        std::cout << "[治理测试] 失败：场景所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2场景结构服务> 场景服务;
    try {
        场景服务 = std::make_unique<L2场景结构服务>(
            运行包.读取服务(), *存在服务, std::move(*场景交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：场景服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：场景服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 场景结构服务已建立\n";

    auto 概念原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 概念所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((概念原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 概念原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !概念原始交付.建立结果.所有者事实
        || !概念原始交付.写入端口) {
        std::cout << "[治理测试] 失败：概念所有者范围建立失败\n";
        return 1;
    }
    auto 概念交付 = 尝试形成L2概念所有者交付(
        运行包.读取服务(), std::move(概念原始交付));
    if (!概念交付) {
        std::cout << "[治理测试] 失败：概念所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2概念结构服务> 概念服务;
    try {
        概念服务 = std::make_unique<L2概念结构服务>(
            运行包.读取服务(), *材料服务, *场景服务, *存在服务,
            *特征服务, *状态服务, *动态服务, *因果服务,
            std::move(*概念交付));
    } catch (...) {
        std::cout << "[治理测试] 失败：概念服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 概念结构服务已建立\n";

    // ===== 6A. 建立 L2 方法结构服务 =====
    auto 方法原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 方法所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((方法原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 方法原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !方法原始交付.建立结果.所有者事实
        || !方法原始交付.写入端口) {
        std::cout << "[治理测试] 失败：方法所有者范围建立失败\n";
        return 1;
    }
    auto 方法交付 = 尝试形成L2方法所有者交付(
        运行包.读取服务(), std::move(方法原始交付));
    if (!方法交付) {
        std::cout << "[治理测试] 失败：方法所有者交付形成失败\n";
        return 1;
    }
    std::unique_ptr<L2方法结构服务> 方法服务;
    try {
        方法服务 = std::make_unique<L2方法结构服务>(
            运行包.读取服务(), *场景服务, *特征服务, *状态服务,
            *概念服务, std::move(*方法交付));
    } catch (...) {
        std::cout << "[治理测试] 失败：方法服务构造异常\n";
        return 1;
    }
    std::cout << "[治理测试] L2 方法结构服务已建立\n";

    // ===== 7. 建立 L2 任务结构服务 =====
    auto 任务原始交付 = 运行包.所有者范围签发器().建立所有者范围(
        {L1所有者范围CRUD合同版本, 任务所有者建立身份,
            L1所有者范围种类::独占结构范围});
    if ((任务原始交付.建立结果.状态
            != L1所有者范围管理状态::成功
        && 任务原始交付.建立结果.状态
            != L1所有者范围管理状态::精确重复)
        || !任务原始交付.建立结果.所有者事实
        || !任务原始交付.写入端口) {
        std::cout << "[治理测试] 失败：任务所有者范围建立失败\n";
        return 1;
    }
    auto 任务交付 = 尝试形成L2任务所有者交付(
        运行包.读取服务(), std::move(任务原始交付));
    if (!任务交付) {
        std::cout << "[治理测试] 失败：任务所有者交付形成失败\n";
        return 1;
    }
    auto 路径写入能力 = 任务交付->提取任务方法路径写入能力交付();
    if (!路径写入能力) {
        std::cout << "[治理测试] 失败：任务方法路径能力提取失败\n";
        return 1;
    }
    std::unique_ptr<L2任务结构服务> 任务服务;
    try {
        任务服务 = std::make_unique<L2任务结构服务>(
            运行包.读取服务(), *需求服务, std::move(*任务交付));
    } catch (const std::exception& e) {
        std::cout << "[治理测试] 失败：任务服务构造异常：" << e.what() << "\n";
        return 1;
    } catch (...) {
        std::cout << "[治理测试] 失败：任务服务构造异常\n";
        return 1;
    }
    auto 路径写入端口 = 尝试形成L2任务方法路径写入端口(
        *任务服务, std::move(*路径写入能力));
    if (!路径写入端口 || !路径写入端口->有效()) {
        std::cout << "[治理测试] 失败：任务方法路径写入端口形成失败\n";
        return 1;
    }
    std::cout << "[治理测试] L2 任务结构服务已建立\n";

    L2结构聚合服务 结构聚合服务(
        *场景服务, *存在服务, *特征服务, *状态服务,
        *动态服务, *因果服务);

    // ===== 8. 读取当前事实代次 =====
    const auto 代次读取 = 运行包.读取服务().读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (代次读取.状态 != L1中性读取状态::成功 || 代次读取.事实代次 == 0) {
        std::cout << "[治理测试] 失败：当前事实代次读取失败\n";
        return 1;
    }
    auto 当前代次 = 代次读取.事实代次;
    std::cout << "[治理测试] 当前事实代次：" << 当前代次 << "\n";

    std::optional<L2概念身份> 存在本体根;
    std::optional<L2概念身份> 动态本体根;
    for (const auto 角色 : {L2概念本体根角色::存在,
            L2概念本体根角色::特征, L2概念本体根角色::动态,
            L2概念本体根角色::因果链}) {
        const auto 根写入 = 概念服务->建立概念本体根({
            {L2结构合同版本, 当前代次},
            L2结构幂等身份{0x7A500ULL
                + static_cast<std::uint64_t>(角色)}, 角色});
        if (!根写入.成功() || !根写入.本体根) {
            std::cout << "[治理测试] 失败：方法测试所需概念本体根建立失败\n";
            return 1;
        }
        当前代次 = 根写入.结果头.事实截止代次;
        if (角色 == L2概念本体根角色::存在)
            存在本体根 = 根写入.本体根->根概念;
        if (角色 == L2概念本体根角色::动态)
            动态本体根 = 根写入.本体根->根概念;
    }
    if (!存在本体根 || !动态本体根) {
        std::cout << "[治理测试] 失败：方法测试概念根读回不完整\n";
        return 1;
    }

    // ===== 9. 新增角色化存在（自我） =====
    L2结构请求头 头{L2结构合同版本, 当前代次};
    auto 存在新增 = 存在服务->新增角色化存在(
        {头, L2结构幂等身份{7001}, L2存在单例角色键{1}});
    if (!存在新增.成功() || !存在新增.存在) {
        std::cout << "[治理测试] 失败：新增角色化存在失败，状态="
            << static_cast<unsigned>(存在新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 自我存在 = 存在新增.存在->身份;
    std::cout << "[治理测试] 角色化存在（自我）已建立\n";
    当前代次 = 存在新增.结果头.事实截止代次;

    L2结构请求头 目标存在头{L2结构合同版本, 当前代次};
    const auto 目标存在新增 = 存在服务->新增角色化存在(
        {目标存在头, L2结构幂等身份{7002}, L2存在单例角色键{2}});
    if (!目标存在新增.成功() || !目标存在新增.存在) {
        std::cout << "[治理测试] 失败：目标宿主存在建立失败\n";
        return 1;
    }
    const auto 目标宿主存在 = 目标存在新增.存在->身份;
    当前代次 = 目标存在新增.结果头.事实截止代次;

    // ===== 10. 新增安全根特征定义 =====
    L2结构请求头 定义头{L2结构合同版本, 当前代次};
    auto 安全根定义新增 = 特征服务->新增统一特征定义(
        {定义头, L2结构幂等身份{7101}, 1, {}, {}});
    if (!安全根定义新增.成功() || !安全根定义新增.特征定义) {
        std::cout << "[治理测试] 失败：新增安全根特征定义失败，状态="
            << static_cast<unsigned>(安全根定义新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 安全根特征定义 = 安全根定义新增.特征定义->身份;
    std::cout << "[治理测试] 安全根特征定义已建立\n";
    当前代次 = 安全根定义新增.结果头.事实截止代次;

    // ===== 11. 新增服务值特征定义 =====
    L2结构请求头 定义头2{L2结构合同版本, 当前代次};
    auto 服务值定义新增 = 特征服务->新增统一特征定义(
        {定义头2, L2结构幂等身份{7102}, 1, {}, {}});
    if (!服务值定义新增.成功() || !服务值定义新增.特征定义) {
        std::cout << "[治理测试] 失败：新增服务值特征定义失败，状态="
            << static_cast<unsigned>(服务值定义新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 服务值特征定义 = 服务值定义新增.特征定义->身份;
    std::cout << "[治理测试] 服务值特征定义已建立\n";
    当前代次 = 服务值定义新增.结果头.事实截止代次;

    // ===== 12. 新增安全根特征实例 =====
    L2结构请求头 实例头{L2结构合同版本, 当前代次};
    auto 安全根实例新增 = 特征服务->新增特征实例(
        {实例头, L2结构幂等身份{7201}, 自我存在, 安全根特征定义});
    if (安全根实例新增.结果头.状态 != L2结构状态::已提交
        || !安全根实例新增.特征实例) {
        std::cout << "[治理测试] 失败：新增安全根特征实例失败，状态="
            << static_cast<unsigned>(安全根实例新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 安全根实例 = 安全根实例新增.特征实例->身份;
    std::cout << "[治理测试] 安全根特征实例已建立\n";
    当前代次 = 安全根实例新增.结果头.事实截止代次;

    // ===== 13. 新增安全根特征值（I64 向量 {A=2, L=5, H=10}） =====
    L2结构请求头 值头{L2结构合同版本, 当前代次};
    L2特征当前值新增请求 值请求;
    值请求.请求头 = 值头;
    值请求.幂等身份 = L2结构幂等身份{7301};
    值请求.特征实例 = 安全根实例;
    值请求.新值材料 = std::vector<std::int64_t>{2, 5, 10};
    值请求.来源稳定编码 = 安全根特征定义.值;
    auto 安全根值新增 = 特征服务->新增特征当前值(值请求);
    if (!安全根值新增.成功() || !安全根值新增.当前值) {
        std::cout << "[治理测试] 失败：新增安全根特征值失败，状态="
            << static_cast<unsigned>(安全根值新增.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[治理测试] 安全根特征值已建立（A=2, L=5, H=10）\n";
    当前代次 = 安全根值新增.结果头.事实截止代次;

    // ===== 14. 新增服务值特征实例 =====
    L2结构请求头 实例头2{L2结构合同版本, 当前代次};
    auto 服务值实例新增 = 特征服务->新增特征实例(
        {实例头2, L2结构幂等身份{7202}, 自我存在, 服务值特征定义});
    if (服务值实例新增.结果头.状态 != L2结构状态::已提交
        || !服务值实例新增.特征实例) {
        std::cout << "[治理测试] 失败：新增服务值特征实例失败，状态="
            << static_cast<unsigned>(服务值实例新增.结果头.状态) << "\n";
        return 1;
    }
    const auto 服务值实例 = 服务值实例新增.特征实例->身份;
    std::cout << "[治理测试] 服务值特征实例已建立\n";
    当前代次 = 服务值实例新增.结果头.事实截止代次;

    // ===== 15. 新增服务值特征值（I64 向量 {100}） =====
    L2结构请求头 值头2{L2结构合同版本, 当前代次};
    L2特征当前值新增请求 服务值请求;
    服务值请求.请求头 = 值头2;
    服务值请求.幂等身份 = L2结构幂等身份{7302};
    服务值请求.特征实例 = 服务值实例;
    服务值请求.新值材料 = std::vector<std::int64_t>{100};
    服务值请求.来源稳定编码 = 服务值特征定义.值;
    auto 服务值新增 = 特征服务->新增特征当前值(服务值请求);
    if (!服务值新增.成功() || !服务值新增.当前值) {
        std::cout << "[治理测试] 失败：新增服务值特征值失败，状态="
            << static_cast<unsigned>(服务值新增.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[治理测试] 服务值特征值已建立（服务值=100）\n";
    当前代次 = 服务值新增.结果头.事实截止代次;

    const auto 目标特征实例新增 = 特征服务->新增特征实例(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{7303},
            目标宿主存在, 安全根特征定义});
    if (目标特征实例新增.结果头.状态 != L2结构状态::已提交
        || !目标特征实例新增.特征实例) {
        std::cout << "[治理测试] 失败：目标宿主特征实例建立失败\n";
        return 1;
    }
    const auto 目标特征实例 = 目标特征实例新增.特征实例->身份;
    当前代次 = 目标特征实例新增.结果头.事实截止代次;

    // ===== 16. 建立需求目标合同与单根无任务需求 =====
    L2结构请求头 比较头{L2结构合同版本, 当前代次};
    L2特征比较I64合同材料 比较合同;
    比较合同.单位 = 安全根特征定义.值;
    比较合同.维度 = 安全根特征定义.值;
    比较合同.分量角色 = 安全根特征定义.值;
    比较合同.允许结果位 = 3;
    const auto 比较新增 = 特征服务->新增特征比较注册(
        {比较头, L2结构幂等身份{0x7A01}, 安全根特征定义, 比较合同});
    if (!比较新增.成功() || !比较新增.当前注册) {
        std::cout << "[治理测试] 失败：建立需求比较注册失败\n";
        return 1;
    }
    当前代次 = 比较新增.结果头.事实截止代次;
    const auto 合同新增 = 状态服务->新增目标状态合同(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A02},
         安全根特征定义, 比较新增.当前注册->身份, 2, 2,
         L2目标状态合同规则版本, 安全根特征定义.值});
    if (!合同新增.成功() || !合同新增.当前合同) {
        std::cout << "[治理测试] 失败：建立需求目标状态合同失败\n";
        return 1;
    }
    当前代次 = 合同新增.结果头.事实截止代次;
    L2新增需求并建立列表项请求 根需求请求;
    根需求请求.请求头 = {L2结构合同版本, 当前代次};
    根需求请求.幂等身份 = L2结构幂等身份{0x7A03};
    根需求请求.所属存在 = 自我存在;
    根需求请求.目标宿主存在 = 目标宿主存在;
    根需求请求.目标特征定义 = 安全根特征定义;
    根需求请求.目标状态合同 = 合同新增.当前合同->身份;
    根需求请求.来源稳定编码 = 安全根特征定义.值;
    const auto 根需求新增 = 需求服务->新增需求并建立列表项(根需求请求);
    if (!根需求新增.成功() || !根需求新增.新建需求
        || !根需求新增.新建列表项) {
        std::cout << "[治理测试] 失败：建立单根无任务需求失败，状态="
            << static_cast<unsigned>(根需求新增.结果头.状态) << "\n";
        return 1;
    }
    当前代次 = 根需求新增.结果头.事实截止代次;

    const auto 第二需求新增 = 需求服务->新增需求并加入既有列表项(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A031},
            根需求新增.新建列表项->身份, 根需求新增.新建需求->身份,
            1, 安全根特征定义.值});
    if (!第二需求新增.成功() || !第二需求新增.新建需求) {
        std::cout << "[治理测试] 失败：第二来源需求成员建立失败\n";
        return 1;
    }
    当前代次 = 第二需求新增.结果头.事实截止代次;

    // ===== 17. 读取单根无任务 G0 =====
    const auto G0读取 = 运行包.读取服务().读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (G0读取.状态 != L1中性读取状态::成功 || G0读取.事实代次 == 0) {
        std::cout << "[治理测试] 失败：最终事实代次读取失败\n";
        return 1;
    }
    auto G0 = G0读取.事实代次;
    std::cout << "[治理测试] 最终事实代次（G0）：" << G0 << "\n";

    // ===== 18. 装配运行期只读查询组合器 =====
    装配运行期只读查询组合器(
        *需求服务, *任务服务, *方法服务, *状态服务,
        *特征服务, *存在服务, *场景服务, *动态服务);
    std::cout << "[治理测试] 运行期只读查询组合器已装配\n";

    运行期只读查询组合器 需求组合器(
        *需求服务, *任务服务, *方法服务, *状态服务,
        *特征服务, *存在服务, *场景服务, *动态服务);
    需求任务快照请求 空需求请求;
    空需求请求.合同版本 = 运行期只读查询合同版本;
    空需求请求.运行代次 = 1;
    空需求请求.事实范围版本 = 1;
    空需求请求.唯一自我 = 自我存在;
    空需求请求.共享事实截止G0 = G0;
    空需求请求.最大根需求数 = 64;
    空需求请求.最大需求节点数 = 256;
    空需求请求.最大需求结构深度 = 16;
    const auto 空需求结果 = 需求组合器.读取需求结构与任务后继快照(
        空需求请求);
    if (!空需求结果.成功() || !空需求结果.快照
        || 空需求结果.快照->事实截止代次 != G0
        || 空需求结果.快照->根需求组.size() != 1
        || 空需求结果.快照->当前需求结构组.size() != 2
        || 空需求结果.快照->列表任务后继组.size() != 1
        || 空需求结果.快照->列表任务后继组.front().当前任务) {
        std::cout << "[治理测试] 失败：公开组合器未形成单根无任务快照\n";
        return 1;
    }
    auto 坏需求请求 = 空需求请求;
    坏需求请求.最大根需求数 = 0;
    const auto 坏需求结果 = 需求组合器.读取需求结构与任务后继快照(
        坏需求请求);
    if (坏需求结果.状态 != 需求任务快照状态::请求拒绝
        || 坏需求结果.快照) {
        std::cout << "[治理测试] 失败：需求快照零预算未被公开入口拒绝\n";
        return 1;
    }

    const auto 任务新增 = 任务服务->新增任务(
        {{L2结构合同版本, G0}, L2结构幂等身份{0x7A04},
            根需求新增.新建列表项->身份});
    if (!任务新增.成功() || !任务新增.任务) {
        std::cout << "[治理测试] 失败：建立单根当前任务失败\n";
        return 1;
    }
    const auto 旧G0结果 = 需求组合器.读取需求结构与任务后继快照(
        空需求请求);
    if (旧G0结果.状态 != 需求任务快照状态::当前性漂移
        || 旧G0结果.快照) {
        std::cout << "[治理测试] 失败：旧 G0 未返回零快照当前性漂移\n";
        return 1;
    }
    G0 = 任务新增.结果头.事实截止代次;
    空需求请求.共享事实截止G0 = G0;
    const auto 有任务结果 = 需求组合器.读取需求结构与任务后继快照(
        空需求请求);
    if (!有任务结果.成功() || !有任务结果.快照
        || 有任务结果.快照->列表任务后继组.size() != 1
        || !有任务结果.快照->列表任务后继组.front().当前任务
        || 有任务结果.快照->列表任务后继组.front().当前任务->需求列表项
            != 根需求新增.新建列表项->身份) {
        std::cout << "[治理测试] 失败：单根有任务快照未公开读回\n";
        return 1;
    }

    // ===== 18A. 任务实际结果 provider：全部输入仅走公开 L2 服务 =====
    当前代次 = G0;
    const L2场景树根建立请求 场景根建立请求{
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A10}};
    const auto 场景根新增 = 场景服务->建立场景树根(场景根建立请求);
    if (!场景根新增.成功() || !场景根新增.场景节点) {
        std::cout << "[治理测试] 失败：结果场景建立失败\n";
        return 1;
    }
    const auto 结果场景 = 场景根新增.场景节点->场景.身份;
    当前代次 = 场景根新增.结果头.事实截止代次;
    const auto 场景成员新增 = 场景服务->新增场景成员关系(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A11},
            结果场景, 目标宿主存在, 1});
    if (!场景成员新增.成功() || !场景成员新增.当前关系) {
        std::cout << "[治理测试] 失败：结果主体场景成员关系建立失败\n";
        return 1;
    }
    当前代次 = 场景成员新增.结果头.事实截止代次;

    const auto 前状态新增 = 状态服务->新增状态(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A12},
            目标宿主存在, 目标特征实例, std::int64_t{1}, std::int64_t{100},
            安全根特征定义.值});
    if (!前状态新增.成功() || !前状态新增.状态) {
        std::cout << "[治理测试] 失败：动态前状态建立失败\n";
        return 1;
    }
    当前代次 = 前状态新增.结果头.事实截止代次;
    const auto 后状态新增 = 状态服务->新增状态(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A13},
            目标宿主存在, 目标特征实例, std::int64_t{2}, std::int64_t{101},
            安全根特征定义.值});
    if (!后状态新增.成功() || !后状态新增.状态) {
        std::cout << "[治理测试] 失败：任务实际状态建立失败\n";
        return 1;
    }
    当前代次 = 后状态新增.结果头.事实截止代次;
    const auto 动态新增 = 动态服务->新增动态(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A14},
            目标宿主存在, 前状态新增.状态->身份, 后状态新增.状态->身份,
            std::int64_t{100}, std::int64_t{101}, 安全根特征定义.值});
    if (!动态新增.成功() || !动态新增.动态) {
        std::cout << "[治理测试] 失败：任务动态证据建立失败\n";
        return 1;
    }
    当前代次 = 动态新增.结果头.事实截止代次;

    L2普通方法新增请求 方法请求;
    方法请求.请求头 = {L2结构合同版本, 当前代次};
    方法请求.幂等身份 = L2结构幂等身份{0x7A15};
    方法请求.方法.内容版本 = L2方法内容版本{1};
    方法请求.方法.规格版本 = L2方法规格版本{1};
    方法请求.方法.生命周期版本 = L2方法生命周期版本{1};
    方法请求.方法.生命周期发生时间 = 1;
    方法请求.方法.生命周期来源稳定编码 = 安全根特征定义.值;
    方法请求.方法.用途 = {{1, 1, *存在本体根, 安全根特征定义,
        L2方法变化方向::正方向,
        L2方法结果类型引用{合同新增.当前合同->身份},
        安全根特征定义.值}};
    方法请求.方法.条件 = {
        {1, 1, *存在本体根, 结果场景, 安全根特征定义,
            合同新增.当前合同->身份,
            安全根特征定义.值}};
    方法请求.方法.结果 = {
        {1, 1, *存在本体根, 安全根特征定义,
            L2方法变化方向::正方向,
            L2方法结果类型引用{合同新增.当前合同->身份},
            后状态新增.状态->身份.值}};
    方法请求.方法.条件结果关系 = {
        {1, 1, 1, 安全根特征定义.值}};
    方法请求.方法.输入规格 = {
        {1, std::nullopt, 1, 1, {1, 1, std::int64_t{1}},
            安全根特征定义.值}};
    方法请求.方法.动作入口 = {
        结果场景, 结果场景, L2方法稳定动作键{1}, 安全根特征定义.值};
    const auto 方法新增 = 方法服务->新增普通方法(方法请求);
    if (!方法新增.成功() || !方法新增.方法) {
        std::cout << "[治理测试] 失败：目标裁决普通方法建立失败\n";
        return 1;
    }
    当前代次 = 方法新增.结果头.事实截止代次;
    const L2方法身份 来源方法 = 方法新增.方法->方法;
    const L2方法动作入口身份 动作入口 = 方法新增.方法->动作入口.身份;


    L2完整路径材料 路径材料{根需求新增.新建需求->身份.值,
        根需求新增.新建列表项->身份.值, 任务新增.任务->身份.值,
        动作入口.值, 后状态新增.状态->身份.值,
        后状态新增.状态->身份.值, 动态新增.动态->身份.值};
    const auto 路径前任务读取 = 任务服务->读取任务(
        {{L2结构合同版本, 当前代次}, L2读取类别::当前,
            任务新增.任务->身份});
    if (!路径前任务读取.成功()) {
        std::cout << "[治理测试] 失败：路径写入前任务读回失败，状态="
            << static_cast<unsigned>(路径前任务读取.结果头.状态) << "\n";
        return 1;
    }
    const auto 路径新增 = 路径写入端口->写入已验证任务方法路径(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A28},
            任务新增.任务->身份, 1, 来源方法, 稳定编码{1}, 路径材料});
    if (!路径新增.成功() || !路径新增.路径) {
        std::cout << "[治理测试] 失败：任务方法路径建立失败，状态="
            << static_cast<unsigned>(路径新增.结果头.状态) << "，截止="
            << 路径新增.结果头.事实截止代次 << "，写前=" << 当前代次 << "\n";
        return 1;
    }
    当前代次 = 路径新增.结果头.事实截止代次;
    const auto 路径发布 = 任务服务->发布当前选中路径(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A29},
            任务新增.任务->身份, 路径新增.路径->身份});
    if (!路径发布.成功() || !路径发布.新当前选中路径) {
        std::cout << "[治理测试] 失败：当前选中路径发布失败\n";
        return 1;
    }
    当前代次 = 路径发布.结果头.事实截止代次;
    const auto 实例新增 = 任务服务->创建实例方法(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A2A},
            任务新增.任务->身份, 路径新增.路径->身份, 1, 1,
            来源方法, 稳定编码{1}});
    if (!实例新增.成功() || !实例新增.实例方法) {
        std::cout << "[治理测试] 失败：实例方法建立失败\n";
        return 1;
    }
    当前代次 = 实例新增.结果头.事实截止代次;

    constexpr auto 任务结果来源材料版本 =
        (std::numeric_limits<std::uint64_t>::max)() - 1;
    constexpr auto 任务结果运行代次 =
        (std::numeric_limits<std::uint64_t>::max)() - 2;
    auto 任务结果消息 = 构造合法治理消息(
        自我治理消息类型::任务结果复核请求, 0x7A30);
    任务结果消息.来源材料版本 = 任务结果来源材料版本;
    任务结果消息.运行代次 = 任务结果运行代次;
    任务结果消息.读取截止代次 = 当前代次;
    任务结果消息.载荷 = 任务结果复核载荷{
        任务新增.任务->身份, 后状态新增.状态->身份,
        动态新增.动态->身份, 来源方法, 动作入口,
        结果场景, 目标宿主存在,
        L2结构幂等身份{0x7A2D}, L2结构幂等身份{0x7A2E}};
    治理输入路由项 任务结果路由项;
    任务结果路由项.输入 = {治理输入类别::任务结果复核, 任务结果消息};
    任务结果路由项.后继 = 治理输入后继::治理输入事实复核;
    任务结果路由项.状态 = 治理输入路由状态::合法等待;
    const auto 结果尚未形成绑定 = 复核任务结果治理输入绑定事实(
        任务结果路由项, 0x7A31, 2);
    if (结果尚未形成绑定.状态 != 治理输入事实复核状态::合法等待
        || 结果尚未形成绑定.绑定) {
        std::cout << "[治理测试] 失败：当前实例已形成但任务结果未形成时未合法等待\n";
        return 1;
    }

    L2记录任务实际结果请求 记录请求;
    记录请求.请求头 = {L2结构合同版本, 当前代次};
    记录请求.幂等身份 = L2结构幂等身份{0x7A2B};
    记录请求.任务 = 任务新增.任务->身份;
    记录请求.实例方法 = 实例新增.实例方法->身份;
    记录请求.执行轮次 = 1;
    记录请求.方法 = 来源方法;
    记录请求.动作入口 = 动作入口;
    记录请求.场景 = 结果场景;
    记录请求.主体 = 目标宿主存在;
    记录请求.实际状态 = 后状态新增.状态->身份;
    记录请求.动态证据 = 动态新增.动态->身份;
    记录请求.来源材料版本 = 任务结果来源材料版本;
    记录请求.运行代次 = 任务结果运行代次;

    // ===== 18A-生产接线. 真实任务工作线程 -> 管理线程 -> 上行桥 -> 自我线程 =====
    // 首次任务实际结果必须由生产运行包发布；下面对领域入口的调用只复核
    // 已经由生产链形成的精确重复、冲突和历史读回。
    const auto 上行树登记 = 场景服务->读取当前场景树结构登记();
    const auto 上行树读取 = 场景服务->读取场景树(
        {{L2结构合同版本, 当前代次}, L2读取类别::当前,
            *场景根新增.树, 0});
    if (!上行树登记.成功() || !上行树登记.登记
        || !上行树读取.成功() || !上行树读取.树
        || 上行树读取.树->事实截止代次 != 当前代次) {
        std::cout << "[治理测试] 失败：生产接线上游的正式树材料读回失败\n";
        return 1;
    }
    自我世界树根消费材料 上行根消费材料;
    上行根消费材料.请求.项目树选择.根建立幂等身份 =
        场景根建立请求.幂等身份;
    上行根消费材料.请求.首次根建立请求 = 场景根建立请求;
    上行根消费材料.请求.树 = *场景根新增.树;
    上行根消费材料.请求.根场景 = 结果场景;
    上行根消费材料.请求.首次根标记 = 场景根新增.场景节点->树归属;
    上行根消费材料.当前结构登记 = *上行树登记.登记;
    上行根消费材料.正式树读回 = *上行树读取.树;
    上行根消费材料.本次事实截止代次 = 当前代次;

    自我线程 上行生产自我线程(nullptr, &结构聚合服务);
    自我线程生产创建请求 上行线程请求;
    上行线程请求.线程逻辑身份 = 线程逻辑身份{0x5345'4C46'0000'2001ULL};
    上行线程请求.运行代次 = 任务结果运行代次;
    上行线程请求.根消费材料 = 上行根消费材料;
    上行线程请求.治理邮箱容量 = 8;
    上行线程请求.最大任务结果来源需求成员数 = 64;
    上行线程请求.入口停门等待毫秒 = 5000;
    上行线程请求.失败回收诊断毫秒 = 5000;
    const auto 上行线程创建 =
        上行生产自我线程.创建并使自我线程停在治理运行门(上行线程请求);
    if (!上行线程创建.成功() || !上行线程创建.停门见证) {
        std::cout << "[治理测试] 失败：生产接线自我线程未停在治理运行门\n";
        return 1;
    }

    任务结果生产运行包 上行生产运行包(
        *需求服务, *任务服务, *状态服务, *特征服务,
        *存在服务, *场景服务, *动态服务, 上行生产自我线程,
        8, 8, 8, 8, 8, 64);
    const auto 上行运行包启动 = 上行生产运行包.启动();
    if (!上行运行包启动.成功) {
        std::cout << "[治理测试] 失败：任务结果生产运行包启动失败\n";
        return 1;
    }

    任务工作结果材料 首次工作结果;
    首次工作结果.回执编号 = 0x7A40;
    首次工作结果.发生时间戳 = 1;
    首次工作结果.回执幂等键 = 0x7A40;
    首次工作结果.来源任务序号 = 0x7A40;
    首次工作结果.批次编号 = 0x7A41;
    首次工作结果.非权威材料摘要 = 0x7A42;
    首次工作结果.来源材料版本 = 任务结果来源材料版本;
    首次工作结果.任务实际结果写入幂等身份 = 记录请求.幂等身份;
    首次工作结果.任务治理首态写入幂等身份 =
        L2结构幂等身份{0x7A2D};
    首次工作结果.任务重筹办迁移写入幂等身份 =
        L2结构幂等身份{0x7A2E};
    首次工作结果.运行代次 = 任务结果运行代次;
    首次工作结果.读取截止G0 = 当前代次;
    首次工作结果.过期策略 = 任务结果回执过期策略::永不过期;
    首次工作结果.身份组 = {
        记录请求.任务, 记录请求.实际状态, 记录请求.动态证据,
        记录请求.方法, 记录请求.动作入口, 记录请求.场景,
        记录请求.主体};
    首次工作结果.来源执行绑定 = {
        首次工作结果.回执编号, 首次工作结果.来源任务序号,
        首次工作结果.批次编号, 首次工作结果.回执幂等键,
        记录请求.任务, 记录请求.方法, 记录请求.动作入口};

    auto 不同来源序号工作结果 = 首次工作结果;
    不同来源序号工作结果.回执编号 = 0x7A43;
    不同来源序号工作结果.回执幂等键 = 0x7A43;
    不同来源序号工作结果.来源任务序号 = 0x7A43;
    不同来源序号工作结果.非权威材料摘要 = 0x7A43;
    不同来源序号工作结果.来源执行绑定.请求编号 = 0x7A43;
    不同来源序号工作结果.来源执行绑定.任务序号 = 0x7A43;
    不同来源序号工作结果.来源执行绑定.幂等键 = 0x7A43;

    auto 同轮异义工作结果 = 首次工作结果;
    同轮异义工作结果.回执编号 = 0x7A44;
    同轮异义工作结果.回执幂等键 = 0x7A44;
    同轮异义工作结果.来源任务序号 = 0x7A44;
    同轮异义工作结果.非权威材料摘要 = 0x7A44;
    同轮异义工作结果.来源材料版本 = 任务结果来源材料版本 - 1;
    同轮异义工作结果.任务实际结果写入幂等身份 =
        L2结构幂等身份{0x7A2C};
    同轮异义工作结果.来源执行绑定.请求编号 = 0x7A44;
    同轮异义工作结果.来源执行绑定.任务序号 = 0x7A44;
    同轮异义工作结果.来源执行绑定.幂等键 = 0x7A44;

    auto 当前性漂移工作结果 = 首次工作结果;
    当前性漂移工作结果.回执编号 = 0x7A45;
    当前性漂移工作结果.回执幂等键 = 0x7A45;
    当前性漂移工作结果.来源任务序号 = 0x7A45;
    当前性漂移工作结果.非权威材料摘要 = 0x7A45;
    当前性漂移工作结果.来源执行绑定.请求编号 = 0x7A45;
    当前性漂移工作结果.来源执行绑定.任务序号 = 0x7A45;
    当前性漂移工作结果.来源执行绑定.幂等键 = 0x7A45;

    auto 协议拒绝工作结果 = 首次工作结果;
    协议拒绝工作结果.回执编号 = 0x7A46;
    协议拒绝工作结果.回执幂等键 = 0x7A46;
    协议拒绝工作结果.来源任务序号 = 0x7A46;
    协议拒绝工作结果.非权威材料摘要 = 0x7A46;
    协议拒绝工作结果.来源材料版本 = 0;
    协议拒绝工作结果.来源执行绑定.请求编号 = 0x7A46;
    协议拒绝工作结果.来源执行绑定.任务序号 = 0x7A46;
    协议拒绝工作结果.来源执行绑定.幂等键 = 0x7A46;

    const auto 首次上交 =
        上行生产运行包.提交已形成任务工作结果(首次工作结果);
    const auto 精确重复上交 =
        上行生产运行包.提交已形成任务工作结果(首次工作结果);
    if (!首次上交.成功() || !精确重复上交.成功()) {
        std::cout << "[治理测试] 失败：首次或精确重复工作结果未进入真实工作线程\n";
        return 1;
    }

    std::optional<任务结果上行槽快照> 首次发布完成槽;
    for (std::uint64_t 次数 = 0; 次数 < 5000; ++次数) {
        首次发布完成槽 = 上行生产运行包.读取任务结果上行槽(
            首次工作结果.回执幂等键);
        if (首次发布完成槽
            && (首次发布完成槽->阶段 == 任务结果上行槽阶段::已提交
                || 首次发布完成槽->阶段 == 任务结果上行槽阶段::精确重复)) {
            break;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }
    if (!首次发布完成槽 || 首次发布完成槽->事实截止G1 == 0) {
        std::cout << "[治理测试] 失败：首次工作结果未形成正式结果与 G1\n";
        return 1;
    }
    // 新回执在正式结果已经发布后取得新的当前截止；来源任务序号仍不能
    // 替代实例方法中冻结的正式执行轮次。
    不同来源序号工作结果.读取截止G0 = 首次发布完成槽->事实截止G1;
    同轮异义工作结果.读取截止G0 = 首次发布完成槽->事实截止G1;
    const auto 不同序号上交 =
        上行生产运行包.提交已形成任务工作结果(不同来源序号工作结果);
    const auto 异义上交 =
        上行生产运行包.提交已形成任务工作结果(同轮异义工作结果);
    const auto 漂移上交 =
        上行生产运行包.提交已形成任务工作结果(当前性漂移工作结果);
    const auto 协议拒绝上交 =
        上行生产运行包.提交已形成任务工作结果(协议拒绝工作结果);
    if (!不同序号上交.成功() || !异义上交.成功()
        || !漂移上交.成功() || !协议拒绝上交.成功()) {
        std::cout << "[治理测试] 失败：重复、异义、漂移或协议拒绝材料未进入真实工作线程\n";
        return 1;
    }
    上行生产自我线程.开放治理运行门();
    const auto 上行停派 = 上行生产运行包.请求停止新派发();
    const auto 上行收口 = 上行生产运行包.收口工作线程并排空结果上行();
    if (!上行停派.成功 || !上行收口.成功) {
        std::cout << "[治理测试] 失败：生产运行包未按固定顺序排空收口\n";
        return 1;
    }

    const auto 首次上行槽 =
        上行生产运行包.读取任务结果上行槽(首次工作结果.回执幂等键);
    const auto 不同序号槽 = 上行生产运行包.读取任务结果上行槽(
        不同来源序号工作结果.回执幂等键);
    const auto 异义槽 = 上行生产运行包.读取任务结果上行槽(
        同轮异义工作结果.回执幂等键);
    const auto 漂移槽 = 上行生产运行包.读取任务结果上行槽(
        当前性漂移工作结果.回执幂等键);
    const auto 协议拒绝槽 = 上行生产运行包.读取任务结果上行槽(
        协议拒绝工作结果.回执幂等键);
    const auto 上行工作快照 = 上行生产运行包.读取任务工作线程快照();
    const auto 上行后继槽 =
        上行生产自我线程.等待任务结果治理处理槽(1, 5000);
    if (!首次上行槽 || !首次上行槽->正式结果 || !首次上行槽->治理消息
        || 首次上行槽->阶段 != 任务结果上行槽阶段::已提交
        || 首次上行槽->结果发布尝试次数 != 1
        || 首次上行槽->正式执行轮次 != 记录请求.执行轮次
        || !不同序号槽 || 不同序号槽->阶段 != 任务结果上行槽阶段::精确重复
        || 不同序号槽->正式执行轮次 != 记录请求.执行轮次
        || 不同序号槽->复用槽幂等键 != 首次工作结果.回执幂等键
        || 不同序号槽->治理消息
        || !异义槽 || 异义槽->阶段 != 任务结果上行槽阶段::引用冲突
        || 异义槽->治理消息
        || !漂移槽 || 漂移槽->阶段 != 任务结果上行槽阶段::当前性漂移
        || 漂移槽->治理消息 || 协议拒绝槽
        || 上行工作快照.已接收数量 != 6
        || 上行工作快照.已形成回执数量 != 5
        || 上行工作快照.已上交数量 != 5
        || 上行工作快照.已拒绝数量 != 1
        || !上行工作快照.最后形成结果
        || 上行工作快照.最后形成结果->状态 != 任务结果回执形成状态::已拒绝
        || 上行工作快照.最后形成结果->拒绝原因 !=
            任务结果回执拒绝原因::来源材料版本缺失
        || !上行后继槽
        || 上行后继槽->状态 != 任务结果治理处理槽状态::目标裁决已形成
        || !上行后继槽->后继输入
        || !上行后继槽->目标裁决
        || 上行后继槽->目标裁决次数 != 1
        || 上行后继槽->目标裁决->生命周期准备 !=
            任务生命周期后继准备::待验证后完成
        || 上行后继槽->目标裁决->具名关系 !=
            L2特征比较具名关系::当前达到目标
        || 上行后继槽->后继输入->执行轮次 != 记录请求.执行轮次
        || 上行后继槽->后继输入->任务实际结果 != 首次上行槽->正式结果->身份
        || 上行后继槽->后继输入->共享事实截止G0 != 首次上行槽->事实截止G1) {
        std::cout << "[治理测试] 失败：任务结果上行生产链的唯一结果、重复或冲突分账不正确，"
            << "首次=" << (首次上行槽 ? static_cast<unsigned>(首次上行槽->阶段) : 0)
            << "/" << (首次上行槽 ? 首次上行槽->结果发布尝试次数 : 0)
            << "，不同序号=" << (不同序号槽 ? static_cast<unsigned>(不同序号槽->阶段) : 0)
            << "/" << (不同序号槽 ? 不同序号槽->复用槽幂等键 : 0)
            << "，异义=" << (异义槽 ? static_cast<unsigned>(异义槽->阶段) : 0)
            << "，漂移=" << (漂移槽 ? static_cast<unsigned>(漂移槽->阶段) : 0)
            << "，工作=" << 上行工作快照.已接收数量 << "/"
            << 上行工作快照.已形成回执数量 << "/"
            << 上行工作快照.已上交数量 << "/"
            << 上行工作快照.已拒绝数量
            << "，后继=" << (上行后继槽 ? static_cast<unsigned>(上行后继槽->状态) : 0)
            << "\n";
        return 1;
    }
    const auto 结果后G0 = 首次上行槽->事实截止G1;
    记录请求.请求头.期望事实代次 = 结果后G0;
    const auto 记录结果 = 任务服务->记录任务实际结果(记录请求);
    if (记录结果.结果头.状态 != L2结构状态::精确重复
        || !记录结果.实际结果
        || 记录结果.结果头.事实截止代次 != 结果后G0) {
        std::cout << "[治理测试] 失败：生产链正式结果未被领域入口精确重复读回\n";
        return 1;
    }
    const auto 重复结果 = 任务服务->记录任务实际结果(记录请求);
    if (重复结果.结果头.状态 != L2结构状态::精确重复
        || !重复结果.实际结果
        || 重复结果.结果头.事实截止代次 != 结果后G0) {
        std::cout << "[治理测试] 失败：任务实际结果精确重复推进了代次\n";
        return 1;
    }
    auto 冲突请求 = 记录请求;
    冲突请求.幂等身份 = L2结构幂等身份{0x7A2C};
    --冲突请求.来源材料版本;
    const auto 冲突结果 = 任务服务->记录任务实际结果(冲突请求);
    if (冲突结果.结果头.状态 != L2结构状态::引用冲突
        || 冲突结果.实际结果) {
        std::cout << "[治理测试] 失败：同轮异义结果未零写冲突\n";
        return 1;
    }
    const auto 结果前历史读取 = 任务服务->按任务与执行轮次读取实际结果(
        {{L2结构合同版本, 结果后G0}, L2读取类别::历史,
            记录请求.任务, 记录请求.执行轮次, 当前代次});
    if (!结果前历史读取.成功() || 结果前历史读取.实际结果) {
        std::cout << "[治理测试] 失败：结果发布前的历史截止看见了后续结果\n";
        return 1;
    }

    任务实际结果独立读回请求 读回请求;
    读回请求.任务 = 记录请求.任务;
    读回请求.执行轮次 = 1;
    读回请求.方法 = 来源方法;
    读回请求.动作入口 = 动作入口;
    读回请求.场景 = 结果场景;
    读回请求.主体 = 目标宿主存在;
    读回请求.实际状态 = 后状态新增.状态->身份;
    读回请求.动态证据 = 动态新增.动态->身份;
    读回请求.来源材料版本 = 记录请求.来源材料版本;
    读回请求.运行代次 = 记录请求.运行代次;
    读回请求.共享事实截止G0 = 结果后G0;
    读回请求.最大需求成员数 = 2;
    const auto 公开读回 = 需求组合器.读取任务本轮实际结果与独立读回(读回请求);
    if (!公开读回.成功() || !公开读回.快照
        || 公开读回.快照->来源需求组.size() != 2
        || !(公开读回.快照->来源需求组[0].身份.值
            < 公开读回.快照->来源需求组[1].身份.值)
        || 公开读回.快照->事实截止代次 != 结果后G0) {
        std::cout << "[治理测试] 失败：任务实际结果公开同 G0 读回不完整，状态="
            << static_cast<unsigned>(公开读回.状态) << "，需求数="
            << (公开读回.快照 ? 公开读回.快照->来源需求组.size() : 0) << "\n";
        const L2结构请求头 诊断头{L2结构合同版本, 结果后G0};
        const auto 诊断实例 = 任务服务->读取实例方法(
            {诊断头, L2读取类别::当前, 实例新增.实例方法->身份});
        const auto 诊断路径 = 任务服务->读取任务方法路径(
            {诊断头, L2读取类别::当前, 路径新增.路径->身份});
        const auto 诊断列表 = 需求服务->读取需求列表项完整(
            {诊断头, L2读取类别::当前, 根需求新增.新建列表项->身份, 0});
        const auto 诊断成员 = 需求服务->读取需求列表成员(
            {诊断头, L2读取类别::当前, 根需求新增.新建列表项->身份, 0});
        const auto 诊断结果 = 任务服务->按任务与执行轮次读取实际结果(
            {诊断头, L2读取类别::当前, 任务新增.任务->身份, 1, 0});
        const auto 诊断状态 = 状态服务->读取完整状态(
            {诊断头, L2读取类别::当前, 后状态新增.状态->身份, 0});
        const auto 诊断动态 = 动态服务->读取完整动态(
            {诊断头, L2读取类别::当前, 动态新增.动态->身份, 0});
        const auto 诊断场景 = 场景服务->读取完整场景(
            {诊断头, L2读取类别::当前, 结果场景, 0});
        const auto 诊断主体 = 存在服务->读取完整存在(
            {诊断头, L2读取类别::当前, 目标宿主存在, 0});
        const auto 诊断成员引用 = 场景服务->读取存在当前场景成员引用(
            {诊断头, 目标宿主存在});
        std::cout << "[治理测试] 诊断：实例="
            << static_cast<unsigned>(诊断实例.结果头.状态) << "，路径="
            << static_cast<unsigned>(诊断路径.结果头.状态) << "，列表="
            << static_cast<unsigned>(诊断列表.结果头.状态) << "，成员="
            << static_cast<unsigned>(诊断成员.结果头.状态) << "/"
            << 诊断成员.成员关系组.size() << "/" << 诊断成员.成员需求组.size()
            << "，结果=" << static_cast<unsigned>(诊断结果.结果头.状态)
            << "，状态=" << static_cast<unsigned>(诊断状态.结果头.状态)
            << "，动态=" << static_cast<unsigned>(诊断动态.结果头.状态)
            << "，场景=" << static_cast<unsigned>(诊断场景.结果头.状态)
            << "，主体=" << static_cast<unsigned>(诊断主体.结果头.状态)
            << "，成员引用=" << static_cast<unsigned>(诊断成员引用.结果头.状态)
            << "/" << 诊断成员引用.引用.size() << "\n";
        if (诊断结果.实际结果 && 诊断实例.实例方法 && 诊断路径.路径
            && 诊断状态.状态 && 诊断动态.动态 && 诊断场景.场景
            && 诊断主体.存在 && 诊断列表.列表项) {
            std::cout << "[治理测试] 诊断矩阵：结果="
                << (*诊断结果.实际结果 == *记录结果.实际结果)
                << "，实例任务=" << (诊断实例.实例方法->任务 == 记录请求.任务)
                << "，实例轮次=" << (诊断实例.实例方法->执行轮次 == 1)
                << "，路径方法=" << (诊断路径.路径->来源方法 == 来源方法)
                << "，路径动作=" << (诊断路径.路径->完整路径材料.动作入口 == 动作入口.值)
                << "，状态主体=" << (诊断状态.状态->主体存在 == 目标宿主存在)
                << "，动态主体=" << (诊断动态.动态->主体存在 == 目标宿主存在)
                << "，动态后态=" << (诊断动态.动态->后状态 == 后状态新增.状态->身份)
                << "，场景=" << (诊断场景.场景->身份 == 结果场景)
                << "，主体=" << (诊断主体.存在->身份 == 目标宿主存在)
                << "，列表=" << (诊断列表.列表项->身份 == 根需求新增.新建列表项->身份)
                << "\n";
        }
        for (const auto& 需求 : 诊断成员.成员需求组) {
            const auto 完整 = 需求服务->读取需求完整(
                {诊断头, L2读取类别::当前, 需求.身份, 0});
            std::cout << "[治理测试] 诊断需求 " << 需求.身份.值.值
                << "：状态=" << static_cast<unsigned>(完整.结果头.状态)
                << "，相等=" << (完整.需求 && *完整.需求 == 需求) << "\n";
        }
        return 1;
    }
    auto 下一轮请求 = 读回请求;
    下一轮请求.执行轮次 = 2;
    if (需求组合器.读取任务本轮实际结果与独立读回(下一轮请求).状态
            != 任务实际结果独立读回状态::尚未形成) {
        std::cout << "[治理测试] 失败：下一执行轮次未返回尚未形成\n";
        return 1;
    }
    auto 预算请求 = 读回请求;
    预算请求.最大需求成员数 = 1;
    if (需求组合器.读取任务本轮实际结果与独立读回(预算请求).状态
            != 任务实际结果独立读回状态::数量预算不足) {
        std::cout << "[治理测试] 失败：需求成员预算不足未拒绝截断\n";
        return 1;
    }
    auto 旧截止请求 = 读回请求;
    旧截止请求.共享事实截止G0 = 当前代次;
    if (需求组合器.读取任务本轮实际结果与独立读回(旧截止请求).状态
            != 任务实际结果独立读回状态::当前性漂移) {
        std::cout << "[治理测试] 失败：旧 G0 未阻断任务实际结果快照\n";
        return 1;
    }
    const auto 校验字段不配 = [&](const 任务实际结果独立读回请求& 请求,
                                   const char* 字段) {
        const auto 结果 = 需求组合器.读取任务本轮实际结果与独立读回(请求);
        if (结果.状态 == 任务实际结果独立读回状态::引用冲突
            && !结果.快照) return true;
        std::cout << "[治理测试] 失败：任务实际结果" << 字段
            << "不配未零快照拒绝，状态=" << static_cast<unsigned>(结果.状态) << "\n";
        return false;
    };
    auto 方法不配请求 = 读回请求;
    ++方法不配请求.方法.值.值;
    if (!校验字段不配(方法不配请求, "方法")) return 1;
    auto 动作入口不配请求 = 读回请求;
    ++动作入口不配请求.动作入口.值.值;
    if (!校验字段不配(动作入口不配请求, "动作入口")) return 1;
    auto 场景不配请求 = 读回请求;
    ++场景不配请求.场景.值.值;
    if (!校验字段不配(场景不配请求, "场景")) return 1;
    auto 主体不配请求 = 读回请求;
    ++主体不配请求.主体.值.值;
    if (!校验字段不配(主体不配请求, "主体")) return 1;
    auto 状态不配请求 = 读回请求;
    ++状态不配请求.实际状态.值.值;
    if (!校验字段不配(状态不配请求, "实际状态")) return 1;
    auto 动态不配请求 = 读回请求;
    ++动态不配请求.动态证据.值.值;
    if (!校验字段不配(动态不配请求, "动态证据")) return 1;
    auto 材料版本不配请求 = 读回请求;
    --材料版本不配请求.来源材料版本;
    if (!校验字段不配(材料版本不配请求, "来源材料版本")) return 1;
    auto 运行代次不配请求 = 读回请求;
    ++运行代次不配请求.运行代次;
    if (!校验字段不配(运行代次不配请求, "运行代次")) return 1;
    G0 = 结果后G0;
    空需求请求.共享事实截止G0 = G0;
    std::cout << "[治理测试] 任务实际结果 provider 公开矩阵通过\n";

    // ===== 18A-资源分账. 邮箱满时只重试已冻结治理消息 =====
    // 直接提交只用于预置一个会进入合法等待的占位消息以制造容量压力；
    // 受测任务结果仍只从任务结果生产运行包入口进入，不能借此直调上行桥、
    // 任务结果服务或绑定复核入口。
    自我线程 资源分账自我线程(nullptr, &结构聚合服务);
    自我线程生产创建请求 资源线程请求;
    资源线程请求.线程逻辑身份 = 线程逻辑身份{0x5345'4C46'0000'2002ULL};
    资源线程请求.运行代次 = 任务结果运行代次;
    资源线程请求.根消费材料 = 上行根消费材料;
    资源线程请求.治理邮箱容量 = 1;
    资源线程请求.最大任务结果来源需求成员数 = 64;
    资源线程请求.入口停门等待毫秒 = 5000;
    资源线程请求.失败回收诊断毫秒 = 5000;
    const auto 资源线程创建 =
        资源分账自我线程.创建并使自我线程停在治理运行门(资源线程请求);
    if (!资源线程创建.成功()) {
        std::cout << "[治理测试] 失败：邮箱资源分账自我线程创建失败\n";
        return 1;
    }
    auto 容量占位消息 = 任务结果消息;
    容量占位消息.治理消息编号 = 0x7A50;
    容量占位消息.幂等键 = 0x7A50;
    容量占位消息.来源任务序号 = 0x7A50;
    容量占位消息.非权威材料摘要 = 0x7A50;
    容量占位消息.读取截止代次 = 结果后G0;
    ++std::get<任务结果复核载荷>(容量占位消息.载荷).任务.值.值;
    if (资源分账自我线程.提交治理消息(容量占位消息, 1).状态 !=
        自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：邮箱容量压力夹具未进入唯一邮箱\n";
        return 1;
    }

    任务结果生产运行包 资源分账运行包(
        *需求服务, *任务服务, *状态服务, *特征服务,
        *存在服务, *场景服务, *动态服务, 资源分账自我线程,
        8, 8, 8, 8, 8, 64);
    if (!资源分账运行包.启动().成功) {
        std::cout << "[治理测试] 失败：邮箱资源分账运行包启动失败\n";
        return 1;
    }
    auto 资源重试工作结果 = 首次工作结果;
    资源重试工作结果.回执编号 = 0x7A51;
    资源重试工作结果.回执幂等键 = 0x7A51;
    资源重试工作结果.来源任务序号 = 0x7A51;
    资源重试工作结果.非权威材料摘要 = 0x7A51;
    资源重试工作结果.读取截止G0 = 结果后G0;
    资源重试工作结果.来源执行绑定.请求编号 = 0x7A51;
    资源重试工作结果.来源执行绑定.任务序号 = 0x7A51;
    资源重试工作结果.来源执行绑定.幂等键 = 0x7A51;
    if (!资源分账运行包.提交已形成任务工作结果(资源重试工作结果).成功()) {
        std::cout << "[治理测试] 失败：邮箱资源重试材料未进入真实工作线程\n";
        return 1;
    }

    std::optional<任务结果上行槽快照> 邮箱满槽;
    for (std::uint64_t 次数 = 0; 次数 < 5000; ++次数) {
        邮箱满槽 = 资源分账运行包.读取任务结果上行槽(
            资源重试工作结果.回执幂等键);
        if (邮箱满槽
            && 邮箱满槽->阶段 == 任务结果上行槽阶段::治理消息待提交
            && 邮箱满槽->邮箱提交尝试次数 != 0) {
            break;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }
    if (!邮箱满槽 || !邮箱满槽->正式结果 || !邮箱满槽->治理消息
        || 邮箱满槽->阶段 != 任务结果上行槽阶段::治理消息待提交
        || 邮箱满槽->结果发布尝试次数 != 1
        || 邮箱满槽->邮箱提交尝试次数 == 0) {
        std::cout << "[治理测试] 失败：邮箱满未保留同一正式结果和治理消息\n";
        return 1;
    }

    资源分账自我线程.开放治理运行门();
    const auto 占位等待槽 =
        资源分账自我线程.等待任务结果治理处理槽(1, 5000);
    if (!占位等待槽
        || 占位等待槽->状态 != 任务结果治理处理槽状态::合法等待) {
        std::cout << "[治理测试] 失败：邮箱容量压力夹具未释放容量并保持合法等待\n";
        return 1;
    }
    std::optional<任务结果上行槽快照> 邮箱恢复槽;
    for (std::uint64_t 次数 = 0; 次数 < 5000; ++次数) {
        邮箱恢复槽 = 资源分账运行包.读取任务结果上行槽(
            资源重试工作结果.回执幂等键);
        if (邮箱恢复槽
            && (邮箱恢复槽->阶段 == 任务结果上行槽阶段::已提交
                || 邮箱恢复槽->阶段 == 任务结果上行槽阶段::精确重复)) {
            break;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }
    const auto 资源停派 = 资源分账运行包.请求停止新派发();
    const auto 资源收口 = 资源分账运行包.收口工作线程并排空结果上行();
    if (!资源停派.成功 || !资源收口.成功
        || !邮箱恢复槽 || !邮箱恢复槽->正式结果 || !邮箱恢复槽->治理消息
        || 邮箱恢复槽->阶段 != 任务结果上行槽阶段::已提交
        || 邮箱恢复槽->结果发布尝试次数 != 1
        || 邮箱恢复槽->邮箱提交尝试次数 <= 邮箱满槽->邮箱提交尝试次数
        || 邮箱恢复槽->正式结果->身份 != 邮箱满槽->正式结果->身份
        || 邮箱恢复槽->事实截止G1 != 邮箱满槽->事实截止G1
        || !自我治理消息相同(*邮箱恢复槽->治理消息, *邮箱满槽->治理消息)) {
        std::cout << "[治理测试] 失败：邮箱恢复后重复发布结果或改变冻结消息\n";
        return 1;
    }
    std::cout << "[治理测试] 邮箱满与同消息恢复重试分账通过\n";

    // ===== 18B. 002-04 治理输入到任务实际结果身份绑定 =====
    任务结果路由项.输入.消息.读取截止代次 = 结果后G0;
    const auto 绑定结果 = 复核任务结果治理输入绑定事实(
        任务结果路由项, 0x7A31, 2);
    if (绑定结果.状态 != 治理输入事实复核状态::已绑定
        || !绑定结果.绑定
        || 绑定结果.绑定->任务 != 记录请求.任务
        || 绑定结果.绑定->实例方法 != 记录请求.实例方法
        || 绑定结果.绑定->执行轮次 != 1
        || 绑定结果.绑定->实际结果 != 记录结果.实际结果->身份
        || 绑定结果.绑定->事实截止代次 != 结果后G0) {
        std::cout << "[治理测试] 失败：真实任务结果治理输入未绑定正式实际结果身份\n";
        return 1;
    }

    auto 不同来源序号路由项 = 任务结果路由项;
    ++不同来源序号路由项.输入.消息.来源任务序号;
    const auto 不同来源序号绑定 = 复核任务结果治理输入绑定事实(
        不同来源序号路由项, 0x7A31, 2);
    if (不同来源序号绑定.状态 != 治理输入事实复核状态::已绑定
        || !不同来源序号绑定.绑定
        || 不同来源序号绑定.绑定->任务 != 绑定结果.绑定->任务
        || 不同来源序号绑定.绑定->实例方法 != 绑定结果.绑定->实例方法
        || 不同来源序号绑定.绑定->执行轮次 != 绑定结果.绑定->执行轮次
        || 不同来源序号绑定.绑定->实际结果 != 绑定结果.绑定->实际结果
        || 不同来源序号绑定.绑定->事实截止代次
            != 绑定结果.绑定->事实截止代次) {
        std::cout << "[治理测试] 失败：来源任务序号改变了正式执行轮次定位\n";
        return 1;
    }

    auto 未知任务路由项 = 任务结果路由项;
    ++std::get<任务结果复核载荷>(未知任务路由项.输入.消息.载荷).任务.值.值;
    const auto 未知任务绑定 = 复核任务结果治理输入绑定事实(
        未知任务路由项, 0x7A31, 2);
    if (未知任务绑定.状态 != 治理输入事实复核状态::合法等待
        || 未知任务绑定.绑定) {
        std::cout << "[治理测试] 失败：未知任务未返回零绑定合法等待\n";
        return 1;
    }

    auto 旧G0路由项 = 任务结果路由项;
    旧G0路由项.输入.消息.读取截止代次 = 当前代次;
    const auto 旧G0绑定 = 复核任务结果治理输入绑定事实(
        旧G0路由项, 0x7A31, 2);
    if (旧G0绑定.状态 != 治理输入事实复核状态::当前性漂移
        || 旧G0绑定.绑定) {
        std::cout << "[治理测试] 失败：旧 G0 未返回零绑定当前性漂移\n";
        return 1;
    }

    const auto 校验绑定引用冲突 = [&](const 治理输入路由项& 路由项,
                                         const char* 字段) {
        const auto 结果 = 复核任务结果治理输入绑定事实(路由项, 0x7A31, 2);
        if (结果.状态 == 治理输入事实复核状态::引用冲突 && !结果.绑定) {
            return true;
        }
        std::cout << "[治理测试] 失败：治理输入" << 字段
            << "不配未返回零绑定引用冲突，状态="
            << static_cast<unsigned>(结果.状态) << "\n";
        return false;
    };
    auto 方法不配路由项 = 任务结果路由项;
    ++std::get<任务结果复核载荷>(方法不配路由项.输入.消息.载荷).方法.值.值;
    if (!校验绑定引用冲突(方法不配路由项, "方法")) return 1;
    auto 动作入口不配路由项 = 任务结果路由项;
    ++std::get<任务结果复核载荷>(动作入口不配路由项.输入.消息.载荷).动作入口.值.值;
    if (!校验绑定引用冲突(动作入口不配路由项, "动作入口")) return 1;
    auto 状态不配路由项 = 任务结果路由项;
    ++std::get<任务结果复核载荷>(状态不配路由项.输入.消息.载荷).实际结果状态.值.值;
    if (!校验绑定引用冲突(状态不配路由项, "实际状态")) return 1;
    auto 动态不配路由项 = 任务结果路由项;
    ++std::get<任务结果复核载荷>(动态不配路由项.输入.消息.载荷).动态证据.值.值;
    if (!校验绑定引用冲突(动态不配路由项, "动态证据")) return 1;
    auto 场景不配路由项 = 任务结果路由项;
    ++std::get<任务结果复核载荷>(场景不配路由项.输入.消息.载荷).场景.值.值;
    if (!校验绑定引用冲突(场景不配路由项, "场景")) return 1;
    auto 主体不配路由项 = 任务结果路由项;
    ++std::get<任务结果复核载荷>(主体不配路由项.输入.消息.载荷).主体.值.值;
    if (!校验绑定引用冲突(主体不配路由项, "主体")) return 1;
    auto 材料版本不配路由项 = 任务结果路由项;
    --材料版本不配路由项.输入.消息.来源材料版本;
    if (!校验绑定引用冲突(材料版本不配路由项, "来源材料版本")) return 1;
    auto 运行代次不配路由项 = 任务结果路由项;
    ++运行代次不配路由项.输入.消息.运行代次;
    if (!校验绑定引用冲突(运行代次不配路由项, "运行代次")) return 1;

    const auto 预算不足绑定 = 复核任务结果治理输入绑定事实(
        任务结果路由项, 0x7A31, 1);
    if (预算不足绑定.状态 != 治理输入事实复核状态::数量预算不足
        || 预算不足绑定.绑定) {
        std::cout << "[治理测试] 失败：需求成员预算不足未返回零绑定\n";
        return 1;
    }

    const auto 校验入口拒绝 = [&](const 治理输入路由项& 路由项,
                                     std::uint64_t 批次身份,
                                     std::uint64_t 预算,
                                     const char* 形状) {
        const auto 结果 = 复核任务结果治理输入绑定事实(
            路由项, 批次身份, 预算);
        if (结果.状态 == 治理输入事实复核状态::入口拒绝 && !结果.绑定) {
            return true;
        }
        std::cout << "[治理测试] 失败：" << 形状
            << "未返回零绑定入口拒绝\n";
        return false;
    };
    auto 错类别路由项 = 任务结果路由项;
    错类别路由项.输入.类别 = 治理输入类别::观察材料准入;
    if (!校验入口拒绝(错类别路由项, 0x7A31, 2, "非任务结果类别")) return 1;
    auto 错后继路由项 = 任务结果路由项;
    错后继路由项.后继 = 治理输入后继::生存控制裁决;
    if (!校验入口拒绝(错后继路由项, 0x7A31, 2, "错误后继")) return 1;
    auto 错状态路由项 = 任务结果路由项;
    错状态路由项.状态 = 治理输入路由状态::已路由;
    if (!校验入口拒绝(错状态路由项, 0x7A31, 2, "错误路由状态")) return 1;
    auto 错载荷路由项 = 任务结果路由项;
    错载荷路由项.输入.消息.载荷 = 停止载荷{};
    if (!校验入口拒绝(错载荷路由项, 0x7A31, 2, "错误载荷 alternative")) return 1;
    if (!校验入口拒绝(任务结果路由项, 0, 2, "零治理批次")) return 1;
    if (!校验入口拒绝(任务结果路由项, 0x7A31, 0, "零需求成员预算")) return 1;
    std::cout << "[治理测试] 治理输入到任务实际结果身份绑定矩阵通过\n";

    // ===== 18C. 002-04 自我线程生产消费闭环 =====
    // 根消费材料必须来自同一测试运行包的正式场景树读回，不能以默认值
    // 或手工伪造树材料绕过自我线程创建门禁。
    const auto 生产树登记 = 场景服务->读取当前场景树结构登记();
    const auto 生产树读取 = 场景服务->读取场景树(
        {{L2结构合同版本, 结果后G0}, L2读取类别::当前,
            *场景根新增.树, 0});
    if (!生产树登记.成功() || !生产树登记.登记
        || !生产树读取.成功() || !生产树读取.树
        || 生产树读取.树->树 != *场景根新增.树
        || 生产树读取.树->根场景 != 结果场景
        || 生产树读取.树->事实截止代次 != 结果后G0) {
        std::cout << "[治理测试] 失败：自我线程根消费材料正式读回失败\n";
        return 1;
    }
    自我世界树根消费材料 生产根消费材料;
    生产根消费材料.请求.项目树选择.根建立幂等身份 =
        场景根建立请求.幂等身份;
    生产根消费材料.请求.首次根建立请求 = 场景根建立请求;
    生产根消费材料.请求.树 = *场景根新增.树;
    生产根消费材料.请求.根场景 = 结果场景;
    生产根消费材料.请求.首次根标记 =
        场景根新增.场景节点->树归属;
    生产根消费材料.当前结构登记 = *生产树登记.登记;
    生产根消费材料.正式树读回 = *生产树读取.树;
    生产根消费材料.本次事实截止代次 = 结果后G0;

    const auto 构造生产线程请求 = [&](std::uint64_t 线程身份值) {
        自我线程生产创建请求 请求;
        请求.线程逻辑身份 = 线程逻辑身份{线程身份值};
        请求.运行代次 = 任务结果运行代次;
        请求.根消费材料 = 生产根消费材料;
        请求.治理邮箱容量 = 8;
        请求.最大任务结果来源需求成员数 = 64;
        请求.入口停门等待毫秒 = 5000;
        请求.失败回收诊断毫秒 = 5000;
        return 请求;
    };
    const auto 校验线程创建 = [](const 自我线程生产创建结果& 结果,
                                   const char* 场景) {
        if (结果.成功() && 结果.停门见证
            && 结果.停门见证->运行门 ==
                自我线程治理运行门状态::关闭) {
            return true;
        }
        std::cout << "[治理测试] 失败：" << 场景
            << "自我线程未创建并停在治理运行门，状态="
            << static_cast<unsigned>(结果.状态) << "\n";
        return false;
    };

    std::optional<任务结果治理处理槽快照> 成功槽;
    {
        可控任务重筹办提交端口 已达成端口(true);
        自我线程 生产成功线程(nullptr, &结构聚合服务);
        const auto 创建结果 = 生产成功线程.创建并使自我线程停在治理运行门(
            构造生产线程请求(0x5345'4C46'0000'1001ULL));
        if (!校验线程创建(创建结果, "成功链")) return 1;
        if (!生产成功线程.绑定任务重筹办意图提交端口(已达成端口)) {
            std::cout << "[治理测试] 失败：已达成分支端口绑定失败\n";
            return 1;
        }

        auto 成功消息 = 任务结果消息;
        成功消息.读取截止代次 = 结果后G0;
        const auto 首次提交 = 生产成功线程.提交治理消息(成功消息, 1);
        const auto 重复提交 = 生产成功线程.提交治理消息(成功消息, 1);
        if (首次提交.状态 != 自我治理提交状态::已提交
            || 重复提交.状态 != 自我治理提交状态::重复材料
            || 重复提交.拒绝原因 != 自我治理队列拒绝原因::重复材料
            || 生产成功线程.等待任务结果治理处理槽(1, 1)
            || 生产成功线程.请求重试任务结果治理处理槽()) {
            std::cout << "[治理测试] 失败：真实邮箱提交、精确重复或停门边界不正确\n";
            return 1;
        }

        生产成功线程.开放治理运行门();
        成功槽 = 生产成功线程.等待任务结果治理处理槽(1, 5000);
        if (!成功槽
            || 成功槽->状态 != 任务结果治理处理槽状态::目标裁决已形成
            || 成功槽->治理批次身份 == 0
            || 成功槽->治理消息编号 != 成功消息.治理消息编号
            || 成功槽->治理输入幂等键 != 成功消息.幂等键
            || 成功槽->任务 != 记录请求.任务
            || 成功槽->共享事实截止G0 != 结果后G0
            || 成功槽->复核次数 != 1
            || 成功槽->目标裁决次数 != 1
            || 成功槽->复核状态 != 治理输入事实复核状态::已绑定
            || !成功槽->后继输入
            || 成功槽->后继输入->治理批次身份 != 成功槽->治理批次身份
            || 成功槽->后继输入->治理消息编号 != 成功消息.治理消息编号
            || 成功槽->后继输入->治理输入幂等键 != 成功消息.幂等键
            || 成功槽->后继输入->任务 != 记录请求.任务
            || 成功槽->后继输入->实例方法 != 记录请求.实例方法
            || 成功槽->后继输入->执行轮次 != 记录请求.执行轮次
            || 成功槽->后继输入->任务实际结果 !=
                记录结果.实际结果->身份
            || 成功槽->后继输入->共享事实截止G0 != 结果后G0
            || 成功槽->后继输入->复核状态 !=
                治理输入事实复核状态::已绑定
            || !成功槽->目标裁决
            || 成功槽->目标裁决->治理输入幂等键 != 成功消息.幂等键
            || 成功槽->目标裁决->任务 != 记录请求.任务
            || 成功槽->目标裁决->实例方法 != 记录请求.实例方法
            || 成功槽->目标裁决->执行轮次 != 记录请求.执行轮次
            || 成功槽->目标裁决->任务实际结果 != 记录结果.实际结果->身份
            || 成功槽->目标裁决->目标宿主 != 目标宿主存在
            || 成功槽->目标裁决->目标特征 != 安全根特征定义
            || 成功槽->目标裁决->目标状态合同 != 合同新增.当前合同->身份
            || 成功槽->目标裁决->具名关系 !=
                L2特征比较具名关系::当前达到目标
            || 成功槽->目标裁决->生命周期准备 !=
                任务生命周期后继准备::待验证后完成
            || 成功槽->目标裁决->事实截止代次 != 结果后G0
            || 生产成功线程.等待任务结果治理处理槽(2, 10)
            || 生产成功线程.请求重试任务结果治理处理槽()
            || 已达成端口.调用次数() != 0
            || !生产成功线程.停止任务重筹办意图生产并解除端口(
                已达成端口)) {
            std::cout << "[治理测试] 失败：自我线程成功链未冻结唯一完整后继\n";
            return 1;
        }
    }

    std::optional<任务结果治理处理槽快照> 等待首槽;
    std::optional<任务结果治理处理槽快照> 等待重试槽;
    {
        自我线程 合法等待线程(nullptr, &结构聚合服务);
        const auto 创建结果 = 合法等待线程.创建并使自我线程停在治理运行门(
            构造生产线程请求(0x5345'4C46'0000'1002ULL));
        if (!校验线程创建(创建结果, "合法等待链")) return 1;

        auto 未知任务消息 = 任务结果消息;
        未知任务消息.治理消息编号 = 0x7A32;
        未知任务消息.幂等键 = 0x7A32;
        未知任务消息.来源任务序号 = 0x7A32;
        未知任务消息.非权威材料摘要 = 0x7A32;
        未知任务消息.读取截止代次 = 结果后G0;
        ++std::get<任务结果复核载荷>(未知任务消息.载荷).任务.值.值;
        if (合法等待线程.提交治理消息(未知任务消息, 1).状态 !=
            自我治理提交状态::已提交) {
            std::cout << "[治理测试] 失败：未知任务消息未进入真实邮箱\n";
            return 1;
        }
        合法等待线程.开放治理运行门();
        等待首槽 = 合法等待线程.等待任务结果治理处理槽(1, 5000);
        if (!等待首槽
            || 等待首槽->状态 != 任务结果治理处理槽状态::合法等待
            || 等待首槽->复核状态 != 治理输入事实复核状态::合法等待
            || 等待首槽->复核次数 != 1 || 等待首槽->后继输入
            || !合法等待线程.请求重试任务结果治理处理槽()) {
            std::cout << "[治理测试] 失败：未知任务未形成可重试同槽等待\n";
            return 1;
        }
        等待重试槽 = 合法等待线程.等待任务结果治理处理槽(2, 5000);
        if (!等待重试槽
            || 等待重试槽->状态 != 任务结果治理处理槽状态::合法等待
            || 等待重试槽->复核状态 != 治理输入事实复核状态::合法等待
            || 等待重试槽->复核次数 <= 等待首槽->复核次数
            || 等待重试槽->治理批次身份 != 等待首槽->治理批次身份
            || 等待重试槽->治理消息编号 != 等待首槽->治理消息编号
            || 等待重试槽->治理输入幂等键 != 等待首槽->治理输入幂等键
            || 等待重试槽->任务 != 等待首槽->任务
            || 等待重试槽->共享事实截止G0 != 等待首槽->共享事实截止G0
            || 等待重试槽->后继输入) {
            std::cout << "[治理测试] 失败：合法等待重试重新取信或改变冻结材料\n";
            return 1;
        }
        // 离开作用域会锁存停止并唤醒仍等待同槽重试的物理线程；槽中保持零后继。
    }

    std::optional<任务结果治理处理槽快照> 当前性槽;
    {
        自我线程 当前性终止线程(nullptr, &结构聚合服务);
        const auto 创建结果 = 当前性终止线程.创建并使自我线程停在治理运行门(
            构造生产线程请求(0x5345'4C46'0000'1003ULL));
        if (!校验线程创建(创建结果, "当前性终止链")) return 1;

        auto 旧截止消息 = 任务结果消息;
        旧截止消息.治理消息编号 = 0x7A33;
        旧截止消息.幂等键 = 0x7A33;
        旧截止消息.来源任务序号 = 0x7A33;
        旧截止消息.非权威材料摘要 = 0x7A33;
        旧截止消息.读取截止代次 = 当前代次;
        if (当前性终止线程.提交治理消息(旧截止消息, 1).状态 !=
            自我治理提交状态::已提交) {
            std::cout << "[治理测试] 失败：旧截止消息未进入真实邮箱\n";
            return 1;
        }
        当前性终止线程.开放治理运行门();
        当前性槽 = 当前性终止线程.等待任务结果治理处理槽(1, 5000);
        if (!当前性槽
            || 当前性槽->状态 != 任务结果治理处理槽状态::当前性终止
            || 当前性槽->复核状态 != 治理输入事实复核状态::当前性漂移
            || 当前性槽->共享事实截止G0 != 当前代次
            || 当前性槽->后继输入
            || 当前性终止线程.请求重试任务结果治理处理槽()) {
            std::cout << "[治理测试] 失败：旧 G0 未形成结构化当前性终止\n";
            return 1;
        }
    }

    const auto 后继数量 = static_cast<unsigned>(成功槽->后继输入.has_value())
        + static_cast<unsigned>(等待首槽->后继输入.has_value())
        + static_cast<unsigned>(等待重试槽->后继输入.has_value())
        + static_cast<unsigned>(当前性槽->后继输入.has_value());
    if (后继数量 != 1) {
        std::cout << "[治理测试] 失败：任务结果处理槽后继零/一守恒被破坏\n";
        return 1;
    }
    const auto 裁决数量 = static_cast<unsigned>(成功槽->目标裁决.has_value())
        + static_cast<unsigned>(等待首槽->目标裁决.has_value())
        + static_cast<unsigned>(等待重试槽->目标裁决.has_value())
        + static_cast<unsigned>(当前性槽->目标裁决.has_value());
    if (裁决数量 != 1) {
        std::cout << "[治理测试] 失败：任务结果处理槽裁决零/一守恒被破坏\n";
        return 1;
    }
    std::cout << "[治理测试] 自我线程任务结果生产消费闭环通过\n";

    // ===== 19. 调用 读取自我治理一致事实() =====
    自我治理一致事实请求 治理请求;
    治理请求.合同版本 = L2治理函数骨架合同版本;
    治理请求.运行代次 = 1;
    治理请求.治理批次身份 = 1;
    治理请求.读取前共享事实截止 = G0;
    治理请求.完整秒边界 = 1000;
    治理请求.事实范围版本 = 1;
    治理请求.唯一自我 = 自我存在;
    治理请求.安全根特征定义 = 安全根特征定义;
    治理请求.服务值特征定义 = 服务值特征定义;
    治理请求.最大合同数 = 64;
    治理请求.最大准备数 = 64;
    治理请求.最大进展数 = 64;
    治理请求.最大到期事件数 = 64;
    治理请求.最大根需求数 = 64;
    治理请求.最大需求节点数 = 256;
    治理请求.最大需求结构深度 = 16;

    const auto 治理结果 = 读取自我治理一致事实(治理请求);

    // ===== 19. 验证结果 =====
    if (治理结果.状态 != 自我治理一致事实状态::已形成) {
        std::cout << "[治理测试] 失败：一致事实状态不是已形成，实际="
            << static_cast<unsigned>(治理结果.状态) << "\n";
        return 1;
    }
    std::cout << "[治理测试] 一致事实状态：已形成\n";

    if (治理结果.一致事实截止代次 != G0) {
        std::cout << "[治理测试] 失败：一致事实截止代次不匹配，预期="
            << G0 << "，实际=" << 治理结果.一致事实截止代次 << "\n";
        return 1;
    }
    std::cout << "[治理测试] 一致事实截止代次匹配\n";

    // 验证生存安全快照
    if (!治理结果.生存安全快照) {
        std::cout << "[治理测试] 失败：生存安全快照缺失\n";
        return 1;
    }
    const auto& 生存快照 = *治理结果.生存安全快照;

    if (生存快照.安全根.A != 2) {
        std::cout << "[治理测试] 失败：安全根 A 不匹配，预期=2，实际="
            << 生存快照.安全根.A << "\n";
        return 1;
    }
    if (生存快照.安全根.L != 5) {
        std::cout << "[治理测试] 失败：安全根 L 不匹配，预期=5，实际="
            << 生存快照.安全根.L << "\n";
        return 1;
    }
    if (生存快照.安全根.H != 10) {
        std::cout << "[治理测试] 失败：安全根 H 不匹配，预期=10，实际="
            << 生存快照.安全根.H << "\n";
        return 1;
    }
    std::cout << "[治理测试] 安全根值验证通过（A=2, L=5, H=10）\n";

    if (生存快照.安全根.控制态 != 生存安全控制态::主动运行) {
        std::cout << "[治理测试] 失败：控制态不匹配，预期=主动运行，实际="
            << static_cast<unsigned>(生存快照.安全根.控制态) << "\n";
        return 1;
    }
    std::cout << "[治理测试] 控制态验证通过（主动运行）\n";

    if (生存快照.服务游标.服务值 != 100) {
        std::cout << "[治理测试] 失败：服务值不匹配，预期=100，实际="
            << 生存快照.服务游标.服务值 << "\n";
        return 1;
    }
    std::cout << "[治理测试] 服务值验证通过（100）\n";

    if (生存快照.事实截止代次 != G0) {
        std::cout << "[治理测试] 失败：生存快照截止代次不匹配，预期="
            << G0 << "，实际=" << 生存快照.事实截止代次 << "\n";
        return 1;
    }
    std::cout << "[治理测试] 生存快照截止代次匹配\n";

    // 父 N04 机械消费新结构快照，不能再以旧 DATA-EXT-12 缺失掩盖。
    if (!治理结果.需求结构任务快照
        || 治理结果.需求结构任务快照->事实截止代次 != G0
        || 治理结果.需求结构任务快照->根需求组.size() != 1
        || 治理结果.需求结构任务快照->当前需求结构组.size() != 2
        || 治理结果.需求结构任务快照->列表任务后继组.size() != 1
        || !治理结果.需求结构任务快照->列表任务后继组.front().当前任务) {
        std::cout << "[治理测试] 失败：父需求结构任务快照未按同一 G0 形成\n";
        return 1;
    }
    std::cout << "[治理测试] 双成员需求结构任务快照已按 G0 形成\n";

    // ===== 20. 目标未达成与非成功分账 =====
    auto 第二当前代次 = 结果后G0;
    const auto 未达成合同新增 = 状态服务->新增目标状态合同(
        {{L2结构合同版本, 第二当前代次}, L2结构幂等身份{0x7B01},
            安全根特征定义, 比较新增.当前注册->身份, 100, 2,
            L2目标状态合同规则版本, 安全根特征定义.值});
    if (!未达成合同新增.成功() || !未达成合同新增.当前合同) {
        std::cout << "[治理测试] 失败：未达成目标合同建立失败\n";
        return 1;
    }
    第二当前代次 = 未达成合同新增.结果头.事实截止代次;
    L2新增需求并建立列表项请求 未达成需求请求;
    未达成需求请求.请求头 = {L2结构合同版本, 第二当前代次};
    未达成需求请求.幂等身份 = L2结构幂等身份{0x7B02};
    未达成需求请求.所属存在 = 自我存在;
    未达成需求请求.目标宿主存在 = 目标宿主存在;
    未达成需求请求.目标特征定义 = 安全根特征定义;
    未达成需求请求.目标状态合同 = 未达成合同新增.当前合同->身份;
    未达成需求请求.来源稳定编码 = 安全根特征定义.值;
    const auto 未达成需求新增 = 需求服务->新增需求并建立列表项(未达成需求请求);
    if (!未达成需求新增.成功() || !未达成需求新增.新建列表项) {
        std::cout << "[治理测试] 失败：未达成任务目标来源建立失败\n";
        return 1;
    }
    第二当前代次 = 未达成需求新增.结果头.事实截止代次;
    const auto 未达成任务新增 = 任务服务->新增任务(
        {{L2结构合同版本, 第二当前代次}, L2结构幂等身份{0x7B03},
            未达成需求新增.新建列表项->身份});
    if (!未达成任务新增.成功() || !未达成任务新增.任务) {
        std::cout << "[治理测试] 失败：未达成任务建立失败\n";
        return 1;
    }
    第二当前代次 = 未达成任务新增.结果头.事实截止代次;
    L2普通方法新增请求 未达成方法请求;
    未达成方法请求.请求头 = {L2结构合同版本, 第二当前代次};
    未达成方法请求.幂等身份 = L2结构幂等身份{0x7B04};
    未达成方法请求.方法.内容版本 = L2方法内容版本{1};
    未达成方法请求.方法.规格版本 = L2方法规格版本{1};
    未达成方法请求.方法.生命周期版本 = L2方法生命周期版本{1};
    未达成方法请求.方法.生命周期发生时间 = 2;
    未达成方法请求.方法.生命周期来源稳定编码 = 安全根特征定义.值;
    未达成方法请求.方法.用途 = {{1, 1, *存在本体根,
        安全根特征定义, L2方法变化方向::正方向,
        L2方法结果类型引用{未达成合同新增.当前合同->身份},
        安全根特征定义.值}};
    未达成方法请求.方法.条件 = {
        {1, 1, *存在本体根, 结果场景, 安全根特征定义,
            未达成合同新增.当前合同->身份,
            安全根特征定义.值}};
    未达成方法请求.方法.结果 = {
        {1, 1, *存在本体根, 安全根特征定义,
            L2方法变化方向::正方向,
            L2方法结果类型引用{未达成合同新增.当前合同->身份},
            服务值特征定义.值}};
    未达成方法请求.方法.条件结果关系 = {
        {1, 1, 1, 服务值特征定义.值}};
    未达成方法请求.方法.输入规格 = {
        {1, std::nullopt, 1, 1, {1, 1, std::int64_t{1}},
            安全根特征定义.值}};
    未达成方法请求.方法.动作入口 = {
        结果场景, 结果场景, L2方法稳定动作键{2}, 服务值特征定义.值};
    const auto 未达成方法新增 = 方法服务->新增普通方法(未达成方法请求);
    if (!未达成方法新增.成功() || !未达成方法新增.方法) {
        std::cout << "[治理测试] 失败：未达成普通方法建立失败\n";
        return 1;
    }
    第二当前代次 = 未达成方法新增.结果头.事实截止代次;
    L2完整路径材料 未达成路径材料{
        未达成需求新增.新建需求->身份.值,
        未达成需求新增.新建列表项->身份.值,
        未达成任务新增.任务->身份.值,
        未达成方法新增.方法->动作入口.身份.值,
        服务值特征定义.值,
        后状态新增.状态->身份.值,
        动态新增.动态->身份.值};
    const auto 未达成路径新增 = 路径写入端口->写入已验证任务方法路径(
        {{L2结构合同版本, 第二当前代次}, L2结构幂等身份{0x7B05},
            未达成任务新增.任务->身份, 1, 未达成方法新增.方法->方法,
            稳定编码{1}, 未达成路径材料});
    if (!未达成路径新增.成功() || !未达成路径新增.路径) {
        std::cout << "[治理测试] 失败：未达成任务路径建立失败\n";
        return 1;
    }
    第二当前代次 = 未达成路径新增.结果头.事实截止代次;
    const auto 未达成路径发布 = 任务服务->发布当前选中路径(
        {{L2结构合同版本, 第二当前代次}, L2结构幂等身份{0x7B06},
            未达成任务新增.任务->身份, 未达成路径新增.路径->身份});
    if (!未达成路径发布.成功()) {
        std::cout << "[治理测试] 失败：未达成当前路径发布失败\n";
        return 1;
    }
    第二当前代次 = 未达成路径发布.结果头.事实截止代次;
    const auto 未达成实例新增 = 任务服务->创建实例方法(
        {{L2结构合同版本, 第二当前代次}, L2结构幂等身份{0x7B07},
            未达成任务新增.任务->身份, 未达成路径新增.路径->身份,
            1, 1, 未达成方法新增.方法->方法, 稳定编码{1}});
    if (!未达成实例新增.成功() || !未达成实例新增.实例方法) {
        std::cout << "[治理测试] 失败：未达成实例方法建立失败\n";
        return 1;
    }
    第二当前代次 = 未达成实例新增.结果头.事实截止代次;
    const auto 未达成结果新增 = 任务服务->记录任务实际结果(
        {{L2结构合同版本, 第二当前代次}, L2结构幂等身份{0x7B08},
            未达成任务新增.任务->身份, 未达成实例新增.实例方法->身份,
            1, 未达成方法新增.方法->方法,
            未达成方法新增.方法->动作入口.身份, 结果场景,
            目标宿主存在, 后状态新增.状态->身份, 动态新增.动态->身份,
            0x7B09, 0x7B0A});
    if (!未达成结果新增.成功() || !未达成结果新增.实际结果) {
        std::cout << "[治理测试] 失败：未达成正式任务结果建立失败\n";
        return 1;
    }
    const auto 未达成G0 = 未达成结果新增.结果头.事实截止代次;
    const 任务目标达成裁决请求 未达成裁决请求{
        运行期只读查询合同版本, 0x7B0B,
        未达成任务新增.任务->身份, 未达成实例新增.实例方法->身份,
        1, 未达成结果新增.实际结果->身份, 未达成G0};
    const auto 未达成裁决 = 需求组合器.裁决任务目标达成(未达成裁决请求);
    if (未达成裁决.状态 != 任务目标达成裁决状态::目标未达成
        || !未达成裁决.裁决
        || 未达成裁决.裁决->具名关系 != L2特征比较具名关系::当前低于目标
        || 未达成裁决.裁决->允许关系位 != 0x02
        || 未达成裁决.裁决->生命周期准备 !=
            任务生命周期后继准备::目标未达成待重筹办) {
        std::cout << "[治理测试] 失败：目标未达成未形成待重筹办准备\n";
        return 1;
    }
    auto 旧截止裁决请求 = 未达成裁决请求;
    旧截止裁决请求.共享事实截止G0 = 未达成G0 - 1;
    auto 错任务裁决请求 = 未达成裁决请求;
    错任务裁决请求.任务 = 任务新增.任务->身份;
    auto 尚无结果裁决请求 = 未达成裁决请求;
    尚无结果裁决请求.任务实际结果.值.值 =
        (std::numeric_limits<std::uint64_t>::max)();
    运行期只读查询组合器 七服务组合器(
        *需求服务, *任务服务, *状态服务, *特征服务,
        *存在服务, *场景服务, *动态服务);
    const auto 旧截止裁决 = 需求组合器.裁决任务目标达成(旧截止裁决请求);
    const auto 错任务裁决 = 需求组合器.裁决任务目标达成(错任务裁决请求);
    const auto 尚无结果裁决 = 需求组合器.裁决任务目标达成(尚无结果裁决请求);
    const auto 七服务裁决 = 七服务组合器.裁决任务目标达成(未达成裁决请求);
    if (旧截止裁决.状态 != 任务目标达成裁决状态::当前性漂移
        || 错任务裁决.状态 != 任务目标达成裁决状态::引用冲突
        || 尚无结果裁决.状态 != 任务目标达成裁决状态::合法等待
        || 七服务裁决.状态 != 任务目标达成裁决状态::入口拒绝) {
        std::cout << "[治理测试] 失败：目标裁决等待、漂移、冲突或七服务拒绝分账错误，实际="
            << static_cast<unsigned>(旧截止裁决.状态) << ","
            << static_cast<unsigned>(错任务裁决.状态) << ","
            << static_cast<unsigned>(尚无结果裁决.状态) << ","
            << static_cast<unsigned>(七服务裁决.状态) << "\n";
        return 1;
    }

    // ===== 20A. 真实生产线程目标未达成重筹办触发 =====
    // 正式任务实际结果已经由上游 DATA 入口形成；本叶从真实工作结果回执
    // 精确重复读回该结果，再经过唯一治理邮箱、自我线程、任务管理线程和
    // DATA 外提供者首次形成裁决首态、待重筹办迁移与下一筹办工作包。
    auto 未达成根消费材料 = 生产根消费材料;
    const auto 未达成树读取 = 场景服务->读取场景树(
        {{L2结构合同版本, 未达成G0}, L2读取类别::当前,
            *场景根新增.树, 0});
    if (!未达成树读取.成功() || !未达成树读取.树) {
        std::cout << "[治理测试] 失败：未达成生产链根材料读回失败\n";
        return 1;
    }
    未达成根消费材料.正式树读回 = *未达成树读取.树;
    未达成根消费材料.本次事实截止代次 = 未达成G0;

    自我线程 未达成生产自我线程(nullptr, &结构聚合服务);
    自我线程生产创建请求 未达成线程请求;
    未达成线程请求.线程逻辑身份 =
        线程逻辑身份{0x5345'4C46'0000'3001ULL};
    未达成线程请求.运行代次 = 0x7B0A;
    未达成线程请求.根消费材料 = 未达成根消费材料;
    未达成线程请求.治理邮箱容量 = 8;
    未达成线程请求.最大任务结果来源需求成员数 = 64;
    未达成线程请求.入口停门等待毫秒 = 5000;
    未达成线程请求.失败回收诊断毫秒 = 5000;
    if (!未达成生产自我线程.创建并使自我线程停在治理运行门(
            未达成线程请求).成功()) {
        std::cout << "[治理测试] 失败：未达成生产自我线程未停门\n";
        return 1;
    }

    任务结果生产运行包 未达成生产运行包(
        *需求服务, *任务服务, *状态服务, *特征服务,
        *存在服务, *场景服务, *动态服务, 未达成生产自我线程,
        8, 8, 8, 8, 8, 64);
    if (!未达成生产运行包.启动().成功) {
        std::cout << "[治理测试] 失败：未达成生产运行包启动失败\n";
        return 1;
    }

    任务工作结果材料 未达成工作结果;
    未达成工作结果.回执编号 = 0x7B40;
    未达成工作结果.发生时间戳 = 500;
    未达成工作结果.回执幂等键 = 0x7B40;
    未达成工作结果.来源任务序号 = 0x7B41;
    未达成工作结果.批次编号 = 0x7B42;
    未达成工作结果.非权威材料摘要 = 0x7B43;
    未达成工作结果.来源材料版本 = 0x7B09;
    未达成工作结果.任务实际结果写入幂等身份 =
        L2结构幂等身份{0x7B08};
    未达成工作结果.任务治理首态写入幂等身份 =
        L2结构幂等身份{0x7B30};
    未达成工作结果.任务重筹办迁移写入幂等身份 =
        L2结构幂等身份{0x7B31};
    未达成工作结果.运行代次 = 0x7B0A;
    未达成工作结果.读取截止G0 = 未达成G0;
    未达成工作结果.过期策略 = 任务结果回执过期策略::永不过期;
    未达成工作结果.身份组 = {
        未达成任务新增.任务->身份,
        后状态新增.状态->身份,
        动态新增.动态->身份,
        未达成方法新增.方法->方法,
        未达成方法新增.方法->动作入口.身份,
        结果场景,
        目标宿主存在};
    未达成工作结果.来源执行绑定 = {
        未达成工作结果.回执编号, 未达成工作结果.来源任务序号,
        未达成工作结果.批次编号, 未达成工作结果.回执幂等键,
        未达成任务新增.任务->身份,
        未达成方法新增.方法->方法,
        未达成方法新增.方法->动作入口.身份};

    // 队列满只验证自我线程的端口分支：首次拒绝后必须缓存同一不可变意图，
    // 显式重试不得重新取邮箱、重新裁决或生成第二组写入身份。
    auto 队列满治理消息 = 构造合法治理消息(
        自我治理消息类型::任务结果复核请求, 0x7B40);
    队列满治理消息.发生时间戳 = 未达成工作结果.发生时间戳;
    队列满治理消息.来源任务序号 = 未达成工作结果.来源任务序号;
    队列满治理消息.来源材料版本 = 未达成工作结果.来源材料版本;
    队列满治理消息.运行代次 = 未达成工作结果.运行代次;
    队列满治理消息.读取截止代次 = 未达成G0;
    队列满治理消息.载荷 = 任务结果复核载荷{
        未达成任务新增.任务->身份,
        后状态新增.状态->身份,
        动态新增.动态->身份,
        未达成方法新增.方法->方法,
        未达成方法新增.方法->动作入口.身份,
        结果场景,
        目标宿主存在,
        未达成工作结果.任务治理首态写入幂等身份,
        未达成工作结果.任务重筹办迁移写入幂等身份};
    可控任务重筹办提交端口 队列满端口(false);
    自我线程 队列满重试线程(nullptr, &结构聚合服务);
    auto 队列满线程请求 = 未达成线程请求;
    队列满线程请求.线程逻辑身份 =
        线程逻辑身份{0x5345'4C46'0000'3002ULL};
    if (!队列满重试线程.创建并使自我线程停在治理运行门(
            队列满线程请求).成功()
        || !队列满重试线程.绑定任务重筹办意图提交端口(队列满端口)
        || 队列满重试线程.提交治理消息(
                队列满治理消息, 500).状态 !=
            自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：队列满重试夹具未进入真实自我线程\n";
        return 1;
    }
    队列满重试线程.开放治理运行门();
    std::optional<任务结果治理处理槽快照> 队列满首槽;
    for (std::uint64_t 次数 = 0; 次数 < 5000; ++次数) {
        const auto 当前槽 = 队列满重试线程.等待任务结果治理处理槽(1, 1);
        if (当前槽) 队列满首槽 = 当前槽;
        if (队列满首槽 && 队列满首槽->状态 ==
                任务结果治理处理槽状态::重筹办意图待提交) {
            break;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }
    const auto 首次冻结意图 = 队列满端口.读取首次意图();
    if (!队列满首槽 || !队列满首槽->重筹办意图
        || !队列满首槽->重筹办提交结果
        || 队列满首槽->重筹办提交结果->拒绝原因 !=
            任务重筹办意图提交拒绝原因::队列已满
        || !首次冻结意图 || 队列满端口.调用次数() != 1) {
        std::cout << "[治理测试] 失败：队列满未冻结唯一重筹办意图\n";
        return 1;
    }
    队列满端口.允许接收();
    if (!队列满重试线程.请求重试任务结果治理处理槽()) {
        std::cout << "[治理测试] 失败：队列满同槽未接受显式重试\n";
        return 1;
    }
    std::optional<任务结果治理处理槽快照> 队列满重试槽;
    for (std::uint64_t 次数 = 0; 次数 < 5000; ++次数) {
        const auto 当前槽 = 队列满重试线程.等待任务结果治理处理槽(1, 1);
        if (当前槽) 队列满重试槽 = 当前槽;
        if (队列满重试槽 && 队列满重试槽->状态 ==
                任务结果治理处理槽状态::重筹办意图已提交) {
            break;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }
    if (!队列满重试槽 || !队列满重试槽->重筹办意图
        || !队列满重试槽->重筹办提交结果
        || !队列满重试槽->重筹办提交结果->成功()
        || !任务重筹办意图相同(
            *队列满首槽->重筹办意图, *队列满重试槽->重筹办意图)
        || !任务重筹办意图相同(
            *首次冻结意图, *队列满重试槽->重筹办意图)
        || 队列满端口.调用次数() != 2
        || !队列满重试线程.停止任务重筹办意图生产并解除端口(
            队列满端口)
        || !队列满重试线程.停止任务重筹办意图生产并解除端口(
            队列满端口)) {
        std::cout << "[治理测试] 失败：队列满重试改变意图或端口解除不幂等\n";
        return 1;
    }

    const auto 未达成首次上交 =
        未达成生产运行包.提交已形成任务工作结果(未达成工作结果);
    const auto 未达成重复上交 =
        未达成生产运行包.提交已形成任务工作结果(未达成工作结果);
    if (!未达成首次上交.成功() || !未达成重复上交.成功()) {
        std::cout << "[治理测试] 失败：未达成工作结果未进入真实工作线程\n";
        return 1;
    }
    未达成生产自我线程.开放治理运行门();

    std::optional<任务结果上行槽快照> 未达成上行槽;
    std::optional<任务结果治理处理槽快照> 未达成治理槽;
    std::optional<任务重筹办处理槽快照> 未达成重筹办槽;
    for (std::uint64_t 次数 = 0; 次数 < 5000; ++次数) {
        未达成上行槽 = 未达成生产运行包.读取任务结果上行槽(
            未达成工作结果.回执幂等键);
        const auto 当前治理槽 =
            未达成生产自我线程.等待任务结果治理处理槽(1, 1);
        if (当前治理槽) 未达成治理槽 = 当前治理槽;
        未达成重筹办槽 = 未达成生产运行包.读取任务重筹办处理槽(
            未达成工作结果.回执幂等键);
        if (未达成上行槽 && 未达成上行槽->正式结果
            && 未达成治理槽
            && 未达成治理槽->状态 ==
                任务结果治理处理槽状态::重筹办意图已提交
            && 未达成重筹办槽
            && (未达成重筹办槽->阶段 == 任务重筹办处理槽阶段::已形成
                || 未达成重筹办槽->阶段 ==
                    任务重筹办处理槽阶段::精确重复)) {
            break;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }

    if (!未达成上行槽 || !未达成上行槽->正式结果
        || 未达成上行槽->正式结果->身份 !=
            未达成结果新增.实际结果->身份
        || 未达成上行槽->正式执行轮次 != 1
        || !未达成治理槽
        || 未达成治理槽->状态 !=
            任务结果治理处理槽状态::重筹办意图已提交
        || !未达成治理槽->重筹办意图
        || !未达成治理槽->重筹办提交结果
        || !未达成治理槽->重筹办提交结果->成功()
        || 未达成治理槽->重筹办意图->生命周期发生时间 != 500
        || 未达成治理槽->重筹办意图->原共同事实截止 != 未达成G0
        || 未达成治理槽->重筹办意图->旧执行轮次 != 1
        || !未达成重筹办槽 || !未达成重筹办槽->工作包
        || !未达成重筹办槽->提供者结果
        || !未达成重筹办槽->提供者结果->成功()
        || 未达成重筹办槽->工作包->任务 !=
            未达成任务新增.任务->身份
        || 未达成重筹办槽->工作包->旧路径 !=
            未达成路径新增.路径->身份
        || 未达成重筹办槽->工作包->旧实例 !=
            未达成实例新增.实例方法->身份
        || 未达成重筹办槽->工作包->旧实际结果 !=
            未达成结果新增.实际结果->身份
        || 未达成重筹办槽->工作包->原共同事实截止 != 未达成G0
        || 未达成重筹办槽->工作包->旧执行轮次 != 1
        || 未达成重筹办槽->工作包->新筹办轮次 != 2
        || 未达成重筹办槽->工作包->原重筹办意图幂等键 != 0x7B40) {
        std::cout << "[治理测试] 失败：目标未达成生产链未形成唯一工作包，上行="
            << (未达成上行槽
                    ? static_cast<unsigned>(未达成上行槽->阶段) : 0)
            << "，治理="
            << (未达成治理槽
                    ? static_cast<unsigned>(未达成治理槽->状态) : 0)
            << "，重筹办="
            << (未达成重筹办槽
                    ? static_cast<unsigned>(未达成重筹办槽->阶段) : 0)
            << "，提交="
            << (未达成治理槽 && 未达成治理槽->重筹办提交结果
                    ? static_cast<unsigned>(
                        未达成治理槽->重筹办提交结果->状态) : 0)
            << "/"
            << (未达成治理槽 && 未达成治理槽->重筹办提交结果
                    ? static_cast<unsigned>(
                        未达成治理槽->重筹办提交结果->拒绝原因) : 0)
            << "\n";
        return 1;
    }

    const auto 治理状态专项后代次 =
        未达成重筹办槽->工作包->迁移后事实代次;
    const auto 未达成当前状态 = 任务服务->读取任务当前治理状态(
        {{L2结构合同版本, 治理状态专项后代次},
            未达成任务新增.任务->身份});
    const auto 未达成当前路径 = 任务服务->读取当前选中路径({
        {L2结构合同版本, 治理状态专项后代次}, L2读取类别::当前,
        未达成任务新增.任务->身份, 0});
    const auto 未达成当前实例 = 任务服务->按任务读取当前实例方法({
        {L2结构合同版本, 治理状态专项后代次}, L2读取类别::当前,
        未达成任务新增.任务->身份, 0});
    if (!未达成当前状态.成功() || !未达成当前状态.当前状态
        || 未达成当前状态.当前状态->业务状态段 !=
            L2任务业务状态段::目标未达成待重筹办
        || !未达成当前路径.成功() || 未达成当前路径.当前选中路径
        || !未达成当前实例.成功() || 未达成当前实例.当前实例方法) {
        std::cout << "[治理测试] 失败：迁移后当前状态、路径或实例未闭合\n";
        return 1;
    }

    // ===== 20B. 任务特征方法查找结果九结论载荷守恒 =====
    const auto& 方法事实 = *未达成方法新增.方法;
    const L2方法特征粗召回项 粗召回项{方法事实.方法,
        方法事实.用途.front()};
    L2方法六项静态能力签名 能力签名;
    能力签名.目标对象类型 = *存在本体根;
    能力签名.可改变特征类型 = 安全根特征定义;
    能力签名.变化方向 = L2方法变化方向::正方向;
    能力签名.结果类型 = 未达成合同新增.当前合同->身份;
    const 任务方法适用候选 适用项{方法事实.方法,
        方法事实.内容版本, 方法事实.规格版本,
        方法事实.结果.front().身份, 方法事实.用途.front().身份, 能力签名};
    auto 第二适用项 = 适用项;
    第二适用项.方法 = 来源方法;
    const 任务方法不兼容证据 不兼容证据{方法事实.方法,
        方法事实.内容版本, 方法事实.规格版本, 方法事实.结果.front().身份,
        方法事实.用途.front().身份,
        {任务方法不兼容原因::所需方向不兼容}};
    const 任务方法结构缺口项 结构缺口{方法事实.方法,
        {L2方法结构缺口{L2方法结构缺口类型::条件结果关系缺失,
            方法事实.方法, std::nullopt, 方法事实.结果.front().身份}}};
    const 任务缺失条件草案 缺失条件草案{
        未达成任务新增.任务->身份, 方法事实.方法, 方法事实.内容版本,
        方法事实.规格版本, 方法事实.结果.front().身份,
        方法事实.条件.front().身份, 方法事实.条件.front().作用对象角色,
        目标宿主存在, 方法事实.条件.front().场景,
        方法事实.条件.front().特征定义,
        方法事实.条件.front().条件状态合同,
        方法事实.条件.front().来源稳定编码, 治理状态专项后代次};
    const 任务未绑定输入限制证据 未绑定证据{
        任务未绑定材料类别::输入规格, 2, std::nullopt,
        方法事实.输入规格.front().身份, std::nullopt};
    const 任务特征方法查找专项::九结论验证夹具 九结论夹具{
        治理状态专项后代次, *未达成重筹办槽->工作包,
        {目标宿主存在, 安全根特征定义, 未达成合同新增.当前合同->身份},
        *后状态新增.状态, *存在本体根, 粗召回项, 适用项, 第二适用项,
        不兼容证据, 结构缺口, 缺失条件草案, 未绑定证据};
    const auto 九结论状态 =
        任务特征方法查找专项::验证九结论载荷守恒(九结论夹具);
    if (九结论状态 ==
        任务特征方法查找专项::九结论验证状态::必需载荷不守恒) {
        std::cout << "[治理测试] 失败：任务特征方法查找九结论必需载荷不守恒\n";
        return 1;
    }
    if (九结论状态 ==
        任务特征方法查找专项::九结论验证状态::禁止载荷未拒绝) {
        std::cout << "[治理测试] 失败：任务特征方法查找禁止载荷未被拒绝\n";
        return 1;
    }
    std::cout << "[治理测试] 任务特征方法查找九结论载荷守恒通过\n";

    const auto 未达成停派 = 未达成生产运行包.请求停止新派发();
    const auto 未达成收口 =
        未达成生产运行包.收口工作线程并排空结果上行();
    if (!未达成停派.成功 || !未达成收口.成功) {
        std::cout << "[治理测试] 失败：未达成生产运行包未排空收口\n";
        return 1;
    }

    std::cout << "[治理测试] 目标未达成重筹办真实生产链通过\n";

    // 合法事实链使用非 I64 精确状态材料，必须先完成 002-04 绑定，
    // 再由目标裁决返回不可比较；不得把它降级成目标未达成。
    auto 不可比较代次 = 治理状态专项后代次;
    const auto 不可比较前状态 = 状态服务->新增状态(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C01},
            目标宿主存在, 目标特征实例, std::vector<std::uint64_t>{1},
            std::int64_t{400}, 安全根特征定义.值});
    if (!不可比较前状态.成功() || !不可比较前状态.状态) {
        std::cout << "[治理测试] 失败：不可比较前状态建立失败\n";
        return 1;
    }
    不可比较代次 = 不可比较前状态.结果头.事实截止代次;
    const auto 不可比较后状态 = 状态服务->新增状态(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C02},
            目标宿主存在, 目标特征实例, std::vector<std::uint64_t>{2},
            std::int64_t{401}, 安全根特征定义.值});
    if (!不可比较后状态.成功() || !不可比较后状态.状态) {
        std::cout << "[治理测试] 失败：不可比较实际状态建立失败\n";
        return 1;
    }
    不可比较代次 = 不可比较后状态.结果头.事实截止代次;
    const auto 不可比较动态 = 动态服务->新增动态(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C03},
            目标宿主存在, 不可比较前状态.状态->身份,
            不可比较后状态.状态->身份, std::vector<std::uint64_t>{1},
            std::vector<std::uint64_t>{2}, 安全根特征定义.值});
    if (!不可比较动态.成功() || !不可比较动态.动态) {
        std::cout << "[治理测试] 失败：不可比较动态证据建立失败\n";
        return 1;
    }
    不可比较代次 = 不可比较动态.结果头.事实截止代次;
    L2新增需求并建立列表项请求 不可比较需求请求;
    不可比较需求请求.请求头 = {L2结构合同版本, 不可比较代次};
    不可比较需求请求.幂等身份 = L2结构幂等身份{0x7C04};
    不可比较需求请求.所属存在 = 自我存在;
    不可比较需求请求.目标宿主存在 = 目标宿主存在;
    不可比较需求请求.目标特征定义 = 安全根特征定义;
    不可比较需求请求.目标状态合同 = 未达成合同新增.当前合同->身份;
    不可比较需求请求.来源稳定编码 = 安全根特征定义.值;
    const auto 不可比较需求 = 需求服务->新增需求并建立列表项(不可比较需求请求);
    if (!不可比较需求.成功() || !不可比较需求.新建需求
        || !不可比较需求.新建列表项) {
        std::cout << "[治理测试] 失败：不可比较任务目标来源建立失败\n";
        return 1;
    }
    不可比较代次 = 不可比较需求.结果头.事实截止代次;
    const auto 不可比较任务 = 任务服务->新增任务(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C05},
            不可比较需求.新建列表项->身份});
    if (!不可比较任务.成功() || !不可比较任务.任务) {
        std::cout << "[治理测试] 失败：不可比较任务建立失败\n";
        return 1;
    }
    不可比较代次 = 不可比较任务.结果头.事实截止代次;
    L2完整路径材料 不可比较路径材料{
        不可比较需求.新建需求->身份.值,
        不可比较需求.新建列表项->身份.值,
        不可比较任务.任务->身份.值,
        未达成方法新增.方法->动作入口.身份.值,
        服务值特征定义.值,
        不可比较后状态.状态->身份.值,
        不可比较动态.动态->身份.值};
    const auto 不可比较路径 = 路径写入端口->写入已验证任务方法路径(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C06},
            不可比较任务.任务->身份, 1, 未达成方法新增.方法->方法,
            稳定编码{1}, 不可比较路径材料});
    if (!不可比较路径.成功() || !不可比较路径.路径) {
        std::cout << "[治理测试] 失败：不可比较任务路径建立失败\n";
        return 1;
    }
    不可比较代次 = 不可比较路径.结果头.事实截止代次;
    const auto 不可比较路径发布 = 任务服务->发布当前选中路径(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C07},
            不可比较任务.任务->身份, 不可比较路径.路径->身份});
    if (!不可比较路径发布.成功()) {
        std::cout << "[治理测试] 失败：不可比较当前路径发布失败\n";
        return 1;
    }
    不可比较代次 = 不可比较路径发布.结果头.事实截止代次;
    const auto 不可比较实例 = 任务服务->创建实例方法(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C08},
            不可比较任务.任务->身份, 不可比较路径.路径->身份,
            1, 1, 未达成方法新增.方法->方法, 稳定编码{1}});
    if (!不可比较实例.成功() || !不可比较实例.实例方法) {
        std::cout << "[治理测试] 失败：不可比较实例方法建立失败\n";
        return 1;
    }
    不可比较代次 = 不可比较实例.结果头.事实截止代次;
    const auto 不可比较结果 = 任务服务->记录任务实际结果(
        {{L2结构合同版本, 不可比较代次}, L2结构幂等身份{0x7C09},
            不可比较任务.任务->身份, 不可比较实例.实例方法->身份,
            1, 未达成方法新增.方法->方法,
            未达成方法新增.方法->动作入口.身份, 结果场景,
            目标宿主存在, 不可比较后状态.状态->身份,
            不可比较动态.动态->身份, 0x7C0B, 0x7C0C});
    if (!不可比较结果.成功() || !不可比较结果.实际结果) {
        std::cout << "[治理测试] 失败：不可比较正式任务结果建立失败\n";
        return 1;
    }
    const auto 不可比较G0 = 不可比较结果.结果头.事实截止代次;
    const auto 不可比较裁决 = 需求组合器.裁决任务目标达成({
        运行期只读查询合同版本, 0x7C0A,
        不可比较任务.任务->身份, 不可比较实例.实例方法->身份,
        1, 不可比较结果.实际结果->身份, 不可比较G0});
    const auto 不可比较裁决后代次 =
        运行包.读取服务().读取中性当前事实代次({L1中性CRUD合同版本});
    if (不可比较裁决.状态 != 任务目标达成裁决状态::不可比较
        || 不可比较裁决.裁决
        || 不可比较裁决后代次.状态 != L1中性读取状态::成功
        || 不可比较裁决后代次.事实代次 != 不可比较G0) {
        std::cout << "[治理测试] 失败：非 I64 实际结果未零写形成不可比较\n";
        return 1;
    }

    自我线程 不可比较线程(nullptr, &结构聚合服务);
    const auto 不可比较线程创建 = 不可比较线程.创建并使自我线程停在治理运行门(
        构造生产线程请求(0x5345'4C46'0000'1004ULL));
    if (!校验线程创建(不可比较线程创建, "不可比较链")) return 1;
    auto 不可比较消息 = 任务结果消息;
    不可比较消息.治理消息编号 = 0x7C0D;
    不可比较消息.幂等键 = 0x7C0D;
    不可比较消息.来源任务序号 = 0x7C0D;
    不可比较消息.非权威材料摘要 = 0x7C0D;
    不可比较消息.来源材料版本 = 0x7C0B;
    不可比较消息.运行代次 = 0x7C0C;
    不可比较消息.读取截止代次 = 不可比较G0;
    不可比较消息.载荷 = 任务结果复核载荷{
        不可比较任务.任务->身份, 不可比较后状态.状态->身份,
        不可比较动态.动态->身份, 未达成方法新增.方法->方法,
        未达成方法新增.方法->动作入口.身份, 结果场景, 目标宿主存在,
        L2结构幂等身份{0x7C0E}, L2结构幂等身份{0x7C0F}};
    if (不可比较线程.提交治理消息(不可比较消息, 1).状态 !=
        自我治理提交状态::已提交) {
        std::cout << "[治理测试] 失败：不可比较消息未进入真实邮箱\n";
        return 1;
    }
    不可比较线程.开放治理运行门();
    const auto 不可比较槽 = 不可比较线程.等待任务结果治理处理槽(1, 5000);
    if (!不可比较槽
        || 不可比较槽->状态 != 任务结果治理处理槽状态::不可比较终止
        || 不可比较槽->复核状态 != 治理输入事实复核状态::已绑定
        || 不可比较槽->复核次数 != 1
        || 不可比较槽->目标裁决次数 != 1
        || !不可比较槽->后继输入 || 不可比较槽->目标裁决
        || 不可比较线程.请求重试任务结果治理处理槽()) {
        std::cout << "[治理测试] 失败：不可比较结果未在绑定后结构化终止\n";
        return 1;
    }
    std::cout << "[治理测试] 任务目标已达成、未达成及非成功分账通过\n";

    std::cout << "[治理测试] 全部通过\n";
    return 0;
}

} // namespace 海中鱼巣
