    std::cout << "[治理测试] 一致事实状态：已形成\n";

    if (治理结果.一致事实截止代次 != G0) {
        std::cout << "[治理测试] 失败：一致事实截止代次不匹配，预期="
            << G0 << "，实际=" << 治理结果.一致事实截止代次 << "\n";
        return 1;
    }
    std::cout << "[治理测试] 一致事实截止代次匹配\n";

    // 验证生存安全快照
    if (!治理结果.生存安全快照) {
        std::cout << "[治理测试] 失败：生存安全快照缺失\n";
        return 1;
    }
    const auto& 生存快照 = *治理结果.生存安全快照;

    if (生存快照.安全根.A != 2) {
        std::cout << "[治理测试] 失败：安全根 A 不匹配，预期=2，实际="
            << 生存快照.安全根.A << "\n";
        return 1;
    }
    if (生存快照.安全根.L != 5) {
        std::cout << "[治理测试] 失败：安全根 L 不匹配，预期=5，实际="
            << 生存快照.安全根.L << "\n";
        return 1;
    }
    if (生存快照.安全根.H != 10) {
        std::cout << "[治理测试] 失败：安全根 H 不匹配，预期=10，实际="
            << 生存快照.安全根.H << "\n";
        return 1;
    }
    std::cout << "[治理测试] 安全根值验证通过（A=2, L=5, H=10）\n";

    if (生存快照.安全根.控制态 != 生存安全控制态::主动运行) {
        std::cout << "[治理测试] 失败：控制态不匹配，预期=主动运行，实际="
            << static_cast<unsigned>(生存快照.安全根.控制态) << "\n";
        return 1;
    }
    std::cout << "[治理测试] 控制态验证通过（主动运行）\n";

    if (生存快照.服务游标.服务值 != 100) {
        std::cout << "[治理测试] 失败：服务值不匹配，预期=100，实际="
            << 生存快照.服务游标.服务值 << "\n";
        return 1;
    }
    std::cout << "[治理测试] 服务值验证通过（100）\n";

    if (生存快照.事实截止代次 != G0) {
        std::cout << "[治理测试] 失败：生存快照截止代次不匹配，预期="
            << G0 << "，实际=" << 生存快照.事实截止代次 << "\n";
        return 1;
    }
    std::cout << "[治理测试] 生存快照截止代次匹配\n";

    // 需求活动快照：当前 DATA-EXT-12 未就绪，预期材料缺失
    if (治理结果.需求活动快照) {
        std::cout << "[治理测试] 注意：需求活动快照非空（DATA-EXT-12 可能已就绪）\n";
    } else {
        std::cout << "[治理测试] 需求活动快照：材料缺失（符合 DATA-EXT-12 未就绪预期）\n";
    }

    std::cout << "[治理测试] 全部通过\n";
    return 0;
}

} // namespace 海中鱼巣
