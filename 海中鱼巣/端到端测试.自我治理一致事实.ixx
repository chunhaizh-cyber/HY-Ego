    }
    std::cout << "[治理测试] 安全根特征值已建立（A=2, L=5, H=10）\n";
    当前代次 = 安全根值新增.结果头.事实截止代次;

    // ===== 14. 新增服务值特征实例 =====
    L2结构请求头 实例头2{L2结构合同版本, 当前代次};
    auto 服务值实例新增 = 特征服务->新增特征实例(
        {实例头2, L2结构幂等身份{7202}, 自我存在, 服务值特征定义});
    if (服务值实例新增.结果头.状态 != L2结构状态::已提交
        || !服务值实例新增.特征实例) {
