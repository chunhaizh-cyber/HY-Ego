    const auto 坏完整秒结果 = 完整秒服务.读取当前完整秒边界({0});
    if (坏完整秒结果.状态 != 完整秒边界读取状态::请求拒绝 ||
        坏完整秒结果.观察 || 坏完整秒结果.区间) {
