        return 1;
    }
    const auto 服务值实例 = 服务值实例新增.特征实例->身份;
    std::cout << "[治理测试] 服务值特征实例已建立\n";
    当前代次 = 服务值实例新增.结果头.事实截止代次;

    // ===== 15. 新增服务值特征值（I64 向量 {100}） =====
    L2结构请求头 值头2{L2结构合同版本, 当前代次};
    L2特征当前值新增请求 服务值请求;
    服务值请求.请求头 = 值头2;
    服务值请求.幂等身份 = L2结构幂等身份{7302};
    服务值请求.特征实例 = 服务值实例;
    服务值请求.新值材料 = std::vector<std::int64_t>{100};
    服务值请求.来源稳定编码 = 服务值特征定义.值;
    auto 服务值新增 = 特征服务->新增特征当前值(服务值请求);
    if (!服务值新增.成功() || !服务值新增.当前值) {
        std::cout << "[治理测试] 失败：新增服务值特征值失败，状态="
            << static_cast<unsigned>(服务值新增.结果头.状态) << "\n";
        return 1;
    }
    std::cout << "[治理测试] 服务值特征值已建立（服务值=100）\n";
    当前代次 = 服务值新增.结果头.事实截止代次;

    // ===== 16. 建立需求目标合同与单根无任务需求 =====
    L2结构请求头 比较头{L2结构合同版本, 当前代次};
    L2特征比较I64合同材料 比较合同;
    比较合同.单位 = 安全根特征定义.值;
    比较合同.维度 = 安全根特征定义.值;
    比较合同.分量角色 = 安全根特征定义.值;
    比较合同.允许结果位 = 3;
    const auto 比较新增 = 特征服务->新增特征比较注册(
        {比较头, L2结构幂等身份{0x7A01}, 安全根特征定义, 比较合同});
    if (!比较新增.成功() || !比较新增.当前注册) {
        std::cout << "[治理测试] 失败：建立需求比较注册失败\n";
        return 1;
    }
    当前代次 = 比较新增.结果头.事实截止代次;
    const auto 合同新增 = 状态服务->新增目标状态合同(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A02},
         安全根特征定义, 比较新增.当前注册->身份, 100, 1,
         L2目标状态合同规则版本, 安全根特征定义.值});
    if (!合同新增.成功() || !合同新增.当前合同) {
        std::cout << "[治理测试] 失败：建立需求目标状态合同失败\n";
        return 1;
    }
    当前代次 = 合同新增.结果头.事实截止代次;
    L2新增需求并建立列表项请求 根需求请求;
    根需求请求.请求头 = {L2结构合同版本, 当前代次};
    根需求请求.幂等身份 = L2结构幂等身份{0x7A03};
    根需求请求.所属存在 = 自我存在;
    根需求请求.目标宿主存在 = 目标宿主存在;
    根需求请求.目标特征定义 = 安全根特征定义;
    根需求请求.目标状态合同 = 合同新增.当前合同->身份;
    根需求请求.来源稳定编码 = 安全根特征定义.值;
    const auto 根需求新增 = 需求服务->新增需求并建立列表项(根需求请求);
    if (!根需求新增.成功() || !根需求新增.新建需求
        || !根需求新增.新建列表项) {
        std::cout << "[治理测试] 失败：建立单根无任务需求失败，状态="
            << static_cast<unsigned>(根需求新增.结果头.状态) << "\n";
        return 1;
    }
    当前代次 = 根需求新增.结果头.事实截止代次;

    const auto 第二需求新增 = 需求服务->新增需求并加入既有列表项(
        {{L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A031},
            根需求新增.新建列表项->身份, 根需求新增.新建需求->身份,
            1, 安全根特征定义.值});
    if (!第二需求新增.成功() || !第二需求新增.新建需求) {
        std::cout << "[治理测试] 失败：第二来源需求成员建立失败\n";
        return 1;
    }
    当前代次 = 第二需求新增.结果头.事实截止代次;

    // ===== 17. 读取单根无任务 G0 =====
    const auto G0读取 = 运行包.读取服务().读取中性当前事实代次(
        {L1中性CRUD合同版本});
    if (G0读取.状态 != L1中性读取状态::成功 || G0读取.事实代次 == 0) {
        std::cout << "[治理测试] 失败：最终事实代次读取失败\n";
        return 1;
    }
    auto G0 = G0读取.事实代次;
    std::cout << "[治理测试] 最终事实代次（G0）：" << G0 << "\n";

    // ===== 18. 装配运行期只读查询组合器 =====
    装配运行期只读查询组合器(
        *需求服务, *任务服务, *状态服务,
        *特征服务, *存在服务, *场景服务, *动态服务);
    std::cout << "[治理测试] 运行期只读查询组合器已装配\n";

    运行期只读查询组合器 需求组合器(
        *需求服务, *任务服务, *状态服务,
        *特征服务, *存在服务, *场景服务, *动态服务);
    需求任务快照请求 空需求请求;
    空需求请求.合同版本 = 运行期只读查询合同版本;
    空需求请求.运行代次 = 1;
    空需求请求.事实范围版本 = 1;
    空需求请求.唯一自我 = 自我存在;
    空需求请求.共享事实截止G0 = G0;
    空需求请求.最大根需求数 = 64;
    空需求请求.最大需求节点数 = 256;
    空需求请求.最大需求结构深度 = 16;
    const auto 空需求结果 = 需求组合器.读取需求结构与任务后继快照(
        空需求请求);
    if (!空需求结果.成功() || !空需求结果.快照
        || 空需求结果.快照->事实截止代次 != G0
        || 空需求结果.快照->根需求组.size() != 1
        || 空需求结果.快照->当前需求结构组.size() != 2
        || 空需求结果.快照->列表任务后继组.size() != 1
        || 空需求结果.快照->列表任务后继组.front().当前任务) {
        std::cout << "[治理测试] 失败：公开组合器未形成单根无任务快照\n";
        return 1;
    }
    auto 坏需求请求 = 空需求请求;
    坏需求请求.最大根需求数 = 0;
    const auto 坏需求结果 = 需求组合器.读取需求结构与任务后继快照(
        坏需求请求);
    if (坏需求结果.状态 != 需求任务快照状态::请求拒绝
        || 坏需求结果.快照) {
        std::cout << "[治理测试] 失败：需求快照零预算未被公开入口拒绝\n";
        return 1;
    }

    const auto 任务新增 = 任务服务->新增任务(
        {{L2结构合同版本, G0}, L2结构幂等身份{0x7A04},
            根需求新增.新建列表项->身份});
    if (!任务新增.成功() || !任务新增.任务) {
        std::cout << "[治理测试] 失败：建立单根当前任务失败\n";
        return 1;
    }
    const auto 旧G0结果 = 需求组合器.读取需求结构与任务后继快照(
        空需求请求);
    if (旧G0结果.状态 != 需求任务快照状态::当前性漂移
        || 旧G0结果.快照) {
        std::cout << "[治理测试] 失败：旧 G0 未返回零快照当前性漂移\n";
        return 1;
    }
    G0 = 任务新增.结果头.事实截止代次;
    空需求请求.共享事实截止G0 = G0;
    const auto 有任务结果 = 需求组合器.读取需求结构与任务后继快照(
        空需求请求);
    if (!有任务结果.成功() || !有任务结果.快照
        || 有任务结果.快照->列表任务后继组.size() != 1
        || !有任务结果.快照->列表任务后继组.front().当前任务
        || 有任务结果.快照->列表任务后继组.front().当前任务->需求列表项
            != 根需求新增.新建列表项->身份) {
        std::cout << "[治理测试] 失败：单根有任务快照未公开读回\n";
        return 1;
    }

    // ===== 18A. 任务实际结果 provider：全部输入仅走公开 L2 服务 =====
    当前代次 = G0;
    const L2场景树根建立请求 场景根建立请求{
        {L2结构合同版本, 当前代次}, L2结构幂等身份{0x7A10}};
    const auto 场景根新增 = 场景服务->建立场景树根(场景根建立请求);
    if (!场景根新增.成功() || !场景根新增.场景节点) {
