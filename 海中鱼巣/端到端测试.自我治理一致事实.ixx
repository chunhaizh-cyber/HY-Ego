    治理请求.最大进展数 = 64;
    治理请求.最大到期事件数 = 64;
    治理请求.最大根需求数 = 64;
    治理请求.最大活动路径深度 = 16;

    const auto 治理结果 = 读取自我治理一致事实(治理请求);

