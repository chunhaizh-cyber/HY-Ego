module;

#include "../核心/节点仓库.h"
#include "../核心/关系仓库.h"
#include "../领域/控制面板服务.h"

#include <algorithm>
#include <array>
#include <cstdint>
#include <optional>
#include <string>
#include <utility>
#include <vector>

export module 海中鱼巣.界面.投影.控制面板启动;

import 海中鱼巣.装配.普通应用;
import 海中鱼巣.领域.初始化.系统;
import 海中鱼巣.领域.初始化.世界树;
import 海中鱼巣.领域.初始化.语素;
import 海中鱼巣.领域.初始化.概念图;

namespace 海中鱼巣 {

世界树名称语素角色 读取世界树节点名称角色(
    节点句柄 节点值,
    const 世界树初始化结果& 初始化结果) noexcept {
    if (节点值 == 初始化结果.世界树根节点) {
        return 世界树名称语素角色::世界;
    }
    if (节点值 == 初始化结果.自我所在场景) {
        return 世界树名称语素角色::场景;
    }
    if (节点值 == 初始化结果.自我存在节点) {
        return 世界树名称语素角色::自我;
    }
    return 世界树名称语素角色::通用节点;
}

std::optional<语素节点显示语义材料> 读取世界树节点显示语义(
    节点句柄 节点值,
    节点类型 类型,
    const 世界树初始化结果& 初始化结果,
    const 语素初始化结果& 语素初始化读数) {
    if (!语素初始化读数.成功()) {
        return std::nullopt;
    }
    语素节点显示语义材料 材料{
        语素初始化读数.读取世界树名称(读取世界树节点名称角色(节点值, 初始化结果)),
        语素初始化读数.读取节点类型名称(类型)
    };
    return 材料.成功() ? std::optional<语素节点显示语义材料>{材料} : std::nullopt;
}

std::wstring 生成世界树节点显示名称(
    节点句柄 节点值,
    const 语素节点显示语义材料& 显示语义,
    const std::optional<世界树相对坐标>& 自我相对坐标) {
    std::wstring 名称 = 显示语义.名称.文本 + L" | " + 显示语义.类型.文本
        + L" #" + std::to_wstring(节点值.节点编号);
    if (自我相对坐标.has_value()) {
        名称 += L" | 相对坐标=("
            + std::to_wstring(static_cast<int>(自我相对坐标->横向)) + L".0,"
            + std::to_wstring(static_cast<int>(自我相对坐标->纵向)) + L".0,"
            + std::to_wstring(static_cast<int>(自我相对坐标->垂向)) + L".0)";
    }
    return 名称;
}

std::optional<控制面板树节点材料> 生成控制面板世界树节点材料(
    const 节点仓库& 节点,
    const 关系仓库& 关系,
    节点句柄 当前节点,
    const 世界树初始化结果& 初始化结果,
    const 语素初始化结果& 语素初始化读数,
    const std::optional<世界树相对坐标>& 自我相对坐标,
    std::vector<节点句柄>& 当前父链) {
    if (!句柄有效(当前节点) || 当前父链.size() > 4096
        || std::find(当前父链.begin(), 当前父链.end(), 当前节点) != 当前父链.end()) {
        return std::nullopt;
    }
    const auto 记录 = 节点.读取节点(当前节点);
    if (!记录.has_value()) {
        return std::nullopt;
    }
    const auto 显示语义 =
        读取世界树节点显示语义(当前节点, 记录->类型, 初始化结果, 语素初始化读数);
    if (!显示语义.has_value()) {
        return std::nullopt;
    }

    控制面板树节点材料 材料;
    材料.节点 = 当前节点;
    材料.类型 = 记录->类型;
    材料.关系角色 = 当前父链.empty()
        ? 控制面板树关系角色::真实根
        : 控制面板树关系角色::普通父子;
    材料.名称基础信息 = 显示语义->名称.基础信息;
    材料.类型基础信息 = 显示语义->类型.基础信息;
    材料.名称语素入口 = 显示语义->名称.语素入口结果.语素入口;
    材料.类型语素入口 = 显示语义->类型.语素入口结果.语素入口;
    材料.名称语素入口组 = {材料.名称语素入口, 材料.类型语素入口};
    材料.显示名称 = 生成世界树节点显示名称(
        当前节点,
        显示语义.value(),
        当前节点 == 初始化结果.自我存在节点
            ? 自我相对坐标
            : std::optional<世界树相对坐标>{});

    当前父链.push_back(当前节点);
    auto 子节点组 = 关系.获取子节点(当前节点);
    std::sort(子节点组.begin(), 子节点组.end(), [](const auto& 左, const auto& 右) {
        return 左.节点编号 < 右.节点编号;
    });
    for (const auto& 子节点 : 子节点组) {
        auto 子材料 = 生成控制面板世界树节点材料(
            节点, 关系, 子节点, 初始化结果, 语素初始化读数, 自我相对坐标, 当前父链);
        if (!子材料.has_value()) {
            当前父链.pop_back();
            return std::nullopt;
        }
        材料.子节点组.push_back(std::move(子材料.value()));
    }
    当前父链.pop_back();
    return 材料;
}

控制面板树结构材料 生成控制面板世界树结构材料(
    const 节点仓库& 节点,
    const 关系仓库& 关系,
    const 世界树初始化结果& 初始化结果,
    const 语素初始化结果& 语素初始化读数,
    const std::optional<世界树相对坐标>& 自我相对坐标) {
    控制面板树结构材料 结构材料;
    if (!初始化结果.成功() || !语素初始化读数.成功()) {
        return 结构材料;
    }
    std::vector<节点句柄> 当前父链;
    auto 根材料 = 生成控制面板世界树节点材料(
        节点, 关系, 初始化结果.世界树根节点,
        初始化结果, 语素初始化读数, 自我相对坐标, 当前父链);
    if (!根材料.has_value()) {
        return 结构材料;
    }
    结构材料.状态 = 控制面板请求状态::可展示;
    结构材料.分类 = 控制面板树分类::世界树;
    结构材料.可展示 = true;
    结构材料.只读快照 = true;
    结构材料.来源版本 = 1;
    结构材料.根节点组.push_back(std::move(根材料.value()));
    return 结构材料;
}

控制面板树节点材料 生成语素树显示节点材料(
    const 语素初始化显示项& 显示项,
    const 语素初始化显示项& 类型项) {
    控制面板树节点材料 材料;
    材料.节点 = 显示项.语素入口结果.语素入口;
    材料.类型 = 节点类型::语素;
    材料.关系角色 = 控制面板树关系角色::语素成员;
    材料.名称基础信息 = 显示项.基础信息;
    材料.类型基础信息 = 类型项.基础信息;
    材料.名称语素入口 = 显示项.语素入口结果.语素入口;
    材料.类型语素入口 = 类型项.语素入口结果.语素入口;
    材料.名称语素入口组 = {材料.名称语素入口, 材料.类型语素入口};
    材料.显示名称 = 显示项.文本 + L" | " + 类型项.文本
        + L" #" + std::to_wstring(材料.节点.节点编号);
    return 材料;
}

控制面板树节点材料 生成概念名称语素树显示节点材料(
    const 概念根初始化项& 概念根,
    const 语素初始化显示项& 类型项) {
    控制面板树节点材料 材料;
    材料.节点 = 概念根.名称语素入口.语素入口;
    材料.类型 = 节点类型::语素;
    材料.关系角色 = 控制面板树关系角色::语素成员;
    材料.名称语素入口 = 概念根.名称语素入口.语素入口;
    材料.类型基础信息 = 类型项.基础信息;
    材料.类型语素入口 = 类型项.语素入口结果.语素入口;
    材料.名称语素入口组 = {材料.名称语素入口, 材料.类型语素入口};
    材料.显示名称 = 概念根.预置名称 + L" | " + 类型项.文本
        + L" #" + std::to_wstring(材料.节点.节点编号);
    return 材料;
}

控制面板树结构材料 生成控制面板语素树结构材料(
    const 语素初始化结果& 语素初始化读数,
    const 概念图初始化结果& 概念图初始化读数) {
    控制面板树结构材料 结构材料;
    结构材料.分类 = 控制面板树分类::语素树;
    if (!语素初始化读数.成功() || !概念图初始化读数.成功()) {
        return 结构材料;
    }
    auto 根材料 =
        生成语素树显示节点材料(语素初始化读数.语素类型, 语素初始化读数.语素类型);
    根材料.关系角色 = 控制面板树关系角色::真实根;
    const std::array<const 语素初始化显示项*, 17> 子项组{
        &语素初始化读数.通用节点名称, &语素初始化读数.世界名称,
        &语素初始化读数.场景名称, &语素初始化读数.自我名称,
        &语素初始化读数.未知类型, &语素初始化读数.基础信息类型,
        &语素初始化读数.存在类型, &语素初始化读数.场景类型,
        &语素初始化读数.特征类型, &语素初始化读数.值类型,
        &语素初始化读数.需求类型, &语素初始化读数.任务类型,
        &语素初始化读数.方法类型, &语素初始化读数.动态类型,
        &语素初始化读数.因果引用类型, &语素初始化读数.状态类型,
        &语素初始化读数.二次类型
    };
    for (const auto* 子项 : 子项组) {
        if (子项 == nullptr || !子项->成功()) {
            return {};
        }
        根材料.子节点组.push_back(
            生成语素树显示节点材料(*子项, 语素初始化读数.语素类型));
    }
    const std::array<const 概念根初始化项*, 4> 概念组{
        &概念图初始化读数.存在根, &概念图初始化读数.动态根,
        &概念图初始化读数.关系根, &概念图初始化读数.因果根
    };
    for (const auto* 概念 : 概念组) {
        if (概念 == nullptr || !概念->成功()) {
            return {};
        }
        根材料.子节点组.push_back(
            生成概念名称语素树显示节点材料(*概念, 语素初始化读数.语素类型));
    }
    结构材料.状态 = 控制面板请求状态::可展示;
    结构材料.可展示 = true;
    结构材料.只读快照 = true;
    结构材料.来源版本 = 1;
    结构材料.根节点组.push_back(std::move(根材料));
    return 结构材料;
}

}

export namespace 海中鱼巣 {

enum class 控制面板投影状态 : std::uint8_t {
    已形成 = 0,
    初始化材料缺失 = 1,
    世界树失败 = 2,
    语素树失败 = 3
};

struct 控制面板启动投影结果 {
    控制面板投影状态 状态 = 控制面板投影状态::初始化材料缺失;
    控制面板树结构材料 世界树;
    控制面板树结构材料 语素树;

    bool 成功() const noexcept {
        return 状态 == 控制面板投影状态::已形成
            && 世界树.可展示 && 世界树.只读快照
            && 语素树.可展示 && 语素树.只读快照;
    }
};

控制面板启动投影结果 生成控制面板启动投影(
    const 普通应用上下文& 上下文,
    const 系统初始化结果& 初始化) {
    控制面板启动投影结果 结果;
    if (!初始化.成功()) {
        return 结果;
    }
    const auto& 快照 = 初始化.自我初始化.value();
    const auto 坐标 =
        上下文.世界树初始化.读取自我相对坐标(快照.世界树.自我存在节点);
    结果.世界树 = 生成控制面板世界树结构材料(
        上下文.节点, 上下文.关系, 快照.世界树, 快照.语素, 坐标);
    if (!结果.世界树.可展示 || !结果.世界树.只读快照) {
        结果.状态 = 控制面板投影状态::世界树失败;
        return 结果;
    }
    结果.语素树 = 生成控制面板语素树结构材料(快照.语素, 初始化.概念图);
    if (!结果.语素树.可展示 || !结果.语素树.只读快照) {
        结果.状态 = 控制面板投影状态::语素树失败;
        return 结果;
    }
    结果.状态 = 控制面板投影状态::已形成;
    return 结果;
}

}
